<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.moses.code.night-watchman</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/moses/code/bin/night-watchman</string>
        <string>--once</string>
    </array>

    <!-- every 5 minutes + once at load -->
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>

    <!-- launchd appends to these (they also receive the script's stdout/stderr;
         the script writes its own timestamped lines to the same file) -->
    <key>StandardOutPath</key>
    <string>/Users/moses/code/_bmad-output/watchman.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/moses/code/_bmad-output/watchman.log</string>

    <!-- launchd default PATH is /usr/bin:/bin:... — herdr lives in Homebrew -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
