#!/usr/bin/env python3
"""check-pr-ready — the merge gate: is this job's PR ready to merge?

Reads the orchestrator job ledger for a job, inspects its PR on GitHub, and
BLOCKS the close-out/merge unless:
  - the job is in `in-review` (or `done` with a verdict) and has a `pr`;
  - one validated host/owner/repo/PR identity resolves across the ledger
    row, the repo_root origin remote and (when present) the PR URL —
    conflicts are rejected, bare numbers never inherit an ambient repo;
  - the PR is OPEN, mergeable, not a draft — strict schema: sparse/missing
    evidence is never affirmative proof;
  - CI is green: BOTH the CheckRun {status,conclusion} and StatusContext
    {state} schemas are classified (pass/pending/fail/unknown); failing,
    pending (without --allow-pending) and unknown outcomes cannot return
    READY; the required-gate set is established from branch
    protection/rulesets when readable (otherwise conservative UNKNOWN);
  - a REVIEW VERDICT is on record, bound to the CURRENT head
    (headRefOid): no outstanding CHANGES_REQUESTED, at least one APPROVED
    review at the exact current head with a known actor. pr_review=1 (or
    --require-perkins) requires the canonical `perkins-review[bot]` actor
    EXACTLY — never a substring lookalike. The head is re-read before
    READY so a moving target yields STALE/UNKNOWN, never READY.

This is the control that turns "everyone remembers to review" into a check
that blocks close-out. Decision logic lives in bin/pr_ready_core.py (pure,
unit-tested); this file only collects evidence (bounded subprocesses,
documented overrides) and prints.

Exit codes:
  0  READY (with --allow-pending: READY *qualified* — pending checks were
     explicitly tolerated and CI green is NOT established)
  1  NOT READY (blockers: reason codes CI_FAILED, CI_PENDING, REVIEW_*,
     IDENTITY_MISMATCH, DRAFT, CONFLICTED, STATE_INVALID, JOB_INVALID, …)
  2  UNKNOWN (evidence/tool gaps: TOOL_ERROR, EVIDENCE_MISSING, CI_UNKNOWN)

Usage:
  check-pr-ready <job-id>
  check-pr-ready <job-id> --ledger <bin/ledger>     # default ~/code/bin/ledger
  check-pr-ready <job-id> --require-perkins --allow-pending

Env overrides (documented; flag > env > default): LEDGER_BIN (absolute
ledger CLI), GH (gh path).
"""
import argparse
import json
import os
import shutil
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import pr_ready_core as core  # noqa: E402

DEFAULT_LEDGER = os.path.expanduser("~/code/bin/ledger")

TIMEOUT_LEDGER_S = 30
TIMEOUT_GH_S = 30
TIMEOUT_GIT_S = 10


class ToolError(Exception):
    def __init__(self, reason: str, message: str):
        super().__init__(message)
        self.reason = reason
        self.message = message


def run(cmd, cwd=None, timeout=None):
    """Bounded subprocess run. Raises ToolError on timeout/missing binary —
    never an uncaught traceback, never a false success."""
    try:
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise ToolError("TOOL_ERROR", f"{cmd[0]} timed out after {timeout}s: {' '.join(cmd[:4])}…")
    except FileNotFoundError:
        raise ToolError("TOOL_ERROR", f"tool not found: {cmd[0]}")
    except UnicodeDecodeError as e:
        raise ToolError("TOOL_ERROR", f"{cmd[0]} output is not valid UTF-8 text: {e}")
    except OSError as e:
        raise ToolError("TOOL_ERROR", f"{cmd[0]} failed to run: {e}")
    return p.returncode, p.stdout.strip(), p.stderr.strip()


class Collector:
    def __init__(self, ledger_bin: str, gh_bin: str):
        self.ledger_bin = ledger_bin
        self.gh_bin = gh_bin

    def jobs(self):
        rc, out, err = run([self.ledger_bin, "json", "all"], timeout=TIMEOUT_LEDGER_S)
        if rc != 0:
            raise ToolError("TOOL_ERROR", f"ledger 'json all' errored: {err or out}")
        try:
            parsed = json.loads(out)
        except json.JSONDecodeError as e:
            raise ToolError("TOOL_ERROR", f"ledger 'json all' returned non-JSON: {e}")
        if not isinstance(parsed, list):
            raise ToolError("TOOL_ERROR", "ledger 'json all' returned non-list JSON (schema)")
        return parsed

    def remote_url(self, repo_root):
        if not repo_root:
            return None
        rc, out, _ = run(["git", "-C", repo_root, "remote", "get-url", "origin"],
                         timeout=TIMEOUT_GIT_S)
        return out if rc == 0 and out else None

    def gh_json(self, args):
        rc, out, err = run([self.gh_bin, *args], timeout=TIMEOUT_GH_S)
        if rc != 0:
            return None, f"gh {args[0]} failed: {err or out}"
        try:
            return json.loads(out), None
        except json.JSONDecodeError as e:
            return None, f"gh {args[0]} non-JSON: {e}"

    def establish_required_checks(self, slug: str, base_ref: str | None):
        """Required-gate names from branch protection + rulesets.

        Returns [] (positively none configured), or None (cannot establish —
        unreadable protection). 404 = none configured; 403/parse/network
        failure on EVERY readable channel = cannot establish."""
        if not base_ref:
            return None
        owner_repo = slug
        channels = [
            (f"repos/{owner_repo}/branches/{base_ref}/protection", "protection"),
            (f"repos/{owner_repo}/rules/branches/{base_ref}", "rulesets"),
        ]
        any_readable = False
        required: list[str] = []

        def gh_api(path):
            rc, out, err = run([self.gh_bin, "api", path], timeout=TIMEOUT_GH_S)
            if rc != 0:
                # gh prints "Not Found" (404) or "Forbidden" (403) on stderr
                label = "not-found" if "Not Found" in (err or out) else (
                    "forbidden" if ("Forbidden" in (err or out) or "403" in (err or out)) else "error"
                )
                return label, None, (err or out)
            try:
                return "ok", json.loads(out), None
            except json.JSONDecodeError as e:
                return "non-json", None, str(e)

        status, doc, _err = gh_api(channels[0][0])
        if status == "ok":
            any_readable = True
            rsc = doc.get("required_status_checks") if isinstance(doc, dict) else None
            if isinstance(rsc, dict) and isinstance(rsc.get("contexts"), list):
                required.extend(str(c) for c in rsc["contexts"] if c)
        elif status == "not-found":
            any_readable = True  # no classic protection configured on the branch
        # forbidden/error/non-json on classic protection alone is not
        # disqualifying — rulesets may still be readable

        status, doc, _err = gh_api(channels[1][0])
        if status == "ok":
            any_readable = True
            if isinstance(doc, list):
                for rule in doc:
                    if not isinstance(rule, dict):
                        continue
                    if rule.get("type") != "required_status_checks":
                        continue
                    params = rule.get("parameters") or {}
                    for ctx in params.get("required_status_checks") or []:
                        if isinstance(ctx, dict) and ctx.get("context"):
                            required.append(str(ctx["context"]))
        elif status == "not-found":
            any_readable = True  # no branch ruleset configured

        if not any_readable:
            return None
        # de-dup, preserve order
        seen: set[str] = set()
        return [c for c in required if not (c in seen or seen.add(c))]


VIEW_FIELDS = "state,mergeable,isDraft,reviewDecision,headRefOid,baseRefName,statusCheckRollup"
REREAD_FIELDS = "state,mergeable,headRefOid,statusCheckRollup"

EXIT_EPILOG = """\
exit codes:
  0  READY (with --allow-pending: READY *qualified* — pending checks were
     explicitly tolerated and CI green is NOT established)
  1  NOT READY (blockers: CI_FAILED, CI_PENDING, REVIEW_*, IDENTITY_MISMATCH,
     DRAFT, CONFLICTED, STATE_INVALID, JOB_INVALID, EVIDENCE_MISSING-as-blocker)
  2  UNKNOWN (evidence/tool gaps: TOOL_ERROR, EVIDENCE_MISSING, CI_UNKNOWN)
"""


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="check-pr-ready",
        description="Advisory merge-readiness gate",
        epilog=EXIT_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("job_id")
    ap.add_argument("--ledger", default=os.environ.get("LEDGER_BIN", DEFAULT_LEDGER))
    ap.add_argument("--require-perkins", action="store_true",
                    help="the approval must come from perkins-review[bot] (exact canonical actor)")
    ap.add_argument("--allow-pending", action="store_true",
                    help="tolerate pending CI checks — READY becomes explicitly QUALIFIED, never 'CI green'")
    args = ap.parse_args()

    ledger_bin = args.ledger
    gh_bin = os.environ.get("GH", "gh")
    if shutil.which(gh_bin) is None:
        # GH env override or PATH gh — missing is a clean tool error (exit 2)
        print(f"FAIL  gh tool not found: {gh_bin!r} (GH env / PATH)")
        return 2

    col = Collector(ledger_bin, gh_bin)

    # 1. job + remote (bounded, validated)
    try:
        jobs = col.jobs()
    except ToolError as e:
        print(f"FAIL  {e.message}")
        return 2
    job = next((j for j in jobs if j.get("id") == args.job_id), None)

    print(f"== check-pr-ready: {args.job_id} ==")
    if job is None:
        print(f"  ✘  job '{args.job_id}' not found in ledger")
        return 1
    repo_root = job.get("repo_root") or job.get("worktree")
    print(f"  job: status={job.get('status')}  pr={job.get('pr')}  "
          f"pr_review={job.get('pr_review')}  repo_root={repo_root}")
    try:
        remote_url = col.remote_url(repo_root)
    except ToolError as e:
        remote_url = None
        print(f"  !  origin remote lookup failed: {e.message}")

    # 2. identity (pure core) — only meaningful when a pr is recorded; a
    #    missing pr is a job-row blocker, handled by the evaluator below
    ref = None
    if job.get("pr"):
        ref, id_problems, id_info = core.resolve_identity(job, remote_url)
        for line in id_info:
            print(f"  ·  {line}")
        if id_problems:
            for _reason, msg in id_problems:
                print(f"  ✘  {msg}")
            print(f"\n== UNKNOWN — identity could not be validated ({len(id_problems)} problem(s)) ==")
            return 2
        print(f"  repo slug: {ref['slug']}   pr arg: {str(job.get('pr'))}")

    # 3. collect PR + reviews (bounded, validated)
    view = reviews_payload = None
    if ref is not None:
        view_args = ["pr", "view", str(job.get("pr")), "--json", VIEW_FIELDS]
        reviews_args = ["pr", "view", str(job.get("pr")), "--json", "reviews"]
        if ref["kind"] == "number":
            view_args += ["--repo", ref["slug"]]
            reviews_args += ["--repo", ref["slug"]]
        try:
            view, err = col.gh_json(view_args)
            reviews_payload, rerr = col.gh_json(reviews_args)
        except ToolError as e:
            print(f"  ✘  {e.message}")
            print("\n== UNKNOWN — tool error ==")
            return 2
        if view is None:
            print(f"  ✘  PR lookup: {err}")
        if reviews_payload is None:
            print(f"  ✘  reviews lookup: {rerr}")

    # 4. phase-1 evaluation (pure)
    result = core.evaluate(
        job, view, reviews_payload, remote_url, None,
        allow_pending=args.allow_pending,
        require_perkins=args.require_perkins,
    )

    # 5. lazily establish required gates when they are the only CI gap
    if (
        result.needs_required_gates
        and not result.blockers
        and view is not None
        and all(r == "CI_UNKNOWN" for r, _m in result.unknowns)
    ):
        try:
            required = col.establish_required_checks(ref["slug"], view.get("baseRefName"))
        except ToolError:
            required = None
        if required is not None:
            result = core.evaluate(
                job, view, reviews_payload, remote_url, required,
                allow_pending=args.allow_pending,
                require_perkins=args.require_perkins,
            )

    # 6. head re-read before READY (R02): a moving target is STALE, never READY
    if result.status == core.READY:
        try:
            reread, err = col.gh_json(["pr", "view", str(job.get("pr")), "--json", REREAD_FIELDS]
                                      + (["--repo", ref["slug"]] if ref and ref["kind"] == "number" else []))
        except ToolError as e:
            reread, err = None, e.message
        if reread is None:
            print(f"  ✘  head re-verification failed: {err}")
            print("\n== UNKNOWN — could not re-verify PR head before READY ==")
            return 2
        head1 = view.get("headRefOid") if isinstance(view, dict) else None
        head2 = reread.get("headRefOid") if isinstance(reread, dict) else None
        # The re-read must be held to the SAME evidence standard as the
        # read it verifies: a degraded/partial re-read payload (no rollup,
        # null rollup, mergeability unestablished, or a check flipping to
        # pending/failing at the same head) is STALE/UNKNOWN — never READY.
        rr_rollup = reread.get("statusCheckRollup") if isinstance(reread, dict) else None
        degraded = (
            not isinstance(reread, dict)
            or "statusCheckRollup" not in reread
            or rr_rollup is None
            or reread.get("mergeable") in (None, "UNKNOWN")
        )
        _p, reread_pend, reread_fails, reread_unknowns, _s = core.classify_rollup(rr_rollup)
        pending_appeared = reread_pend and not args.allow_pending
        if (
            reread.get("state") != "OPEN"
            or head2 != head1
            or reread.get("mergeable") in (False, "CONFLICTING")
        ):
            print(f"  ✘  PR moved during evaluation (head {str(head1)[:7]} → {str(head2)[:7]}, "
                  f"state {reread.get('state')}, mergeable {reread.get('mergeable')}) — STALE, never READY")
            print("\n== UNKNOWN — PR head/state moved during evaluation ==")
            return 2
        if degraded or reread_fails or reread_unknowns or pending_appeared:
            print("  ✘  evidence degraded or changed during evaluation (re-read rollup/mergeability "
                  "incomplete, failing/unknown/pending check appeared at the same head) — STALE, never READY")
            print("\n== UNKNOWN — CI evidence moved or degraded during evaluation ==")
            return 2

    # 7. report
    print()
    for w in result.warns:
        print(f"  !  {w}")
    for i in result.info:
        print(f"  ·  {i}")
    for reason, msg in result.blockers:
        print(f"  ✘  [{reason}] {msg}")
    for reason, msg in result.unknowns:
        print(f"  ?  [{reason}] {msg}")
    print()
    if result.status == core.NOT_READY:
        print(f"== NOT READY — {len(result.blockers)} blocker(s): "
              f"{', '.join(sorted({r for r, _ in result.blockers}))} ==")
        return 1
    if result.status == core.UNKNOWN:
        print(f"== UNKNOWN — evidence gap(s): "
              f"{', '.join(sorted({r for r, _ in result.unknowns}))} ==")
        return 2
    suffix = " (QUALIFIED — pending tolerated via --allow-pending; CI green NOT established)" if result.qualified else ""
    print(f"== READY to merge ({len(result.warns)} warning(s)){suffix} ==")
    return 0


if __name__ == "__main__":
    sys.exit(main())
