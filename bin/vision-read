#!/usr/bin/env bash
# vision-read — read an image with native GPT vision (Astra default for 3D; Sol explicit for non-3D)
#
# KYLE doctrine (2026-09-07 GPT-chain ruling; KYLE is a role, not a provider):
#   vision is EXPLICIT — never faked, never delegated to a blind text model.
#   Two modes:
#     quick-read            = THIS tool (headless pi + @file attachment)
#     visual-verification   = a full KYLE mega-minion spawned in the summoning
#                             repo/worktree cwd with tools (read/grep/bash) —
#                             reads render code/goldens/tests and answers with
#                             evidence (see the AGENTS.md block for the recipe)
#
# Usage:
#   vision-read <image-path> ["prompt"]
#   vision-read --local <image-path> ["prompt"]         # LOCAL fallback: lmstudio/zai-org/glm-4.6v-flash (quality; user-installed 2026-08-22 — survives ZAI caps)
#   vision-read --fast <image-path> ["prompt"]          # LOCAL last resort: lmstudio/google/gemma-4-e2b (coarse)
#   vision-read --model <provider/model-id> <image> ...  # explicit model (must declare image input)
#
# Model resolution (first match wins):
#   1. VISION_MODEL env var            (swap without editing anything)
#   2. --model <provider/model-id>     (per-call)
#   3. --fast                          (lmstudio/google/gemma-4-e2b — LOCAL last resort, coarse; explicit only)
#   4. --local                         (lmstudio/zai-org/glm-4.6v-flash — LOCAL quality fallback; explicit only)
#   5. default                         (openai-codex/gpt-6-astra — native GPT vision, xhigh; 3D-safe)
#
# Use --model openai-codex/gpt-5.6-sol --thinking xhigh for non-3D helper
# reads. KYLE remains a visual-verification role; its provider is selected by
# the current model policy, not hard-coded to a legacy GLM model. Legacy visual
# models are explicit fallbacks only, never the default.
#
# Mechanism: pi headless with an @file attachment. pi's `@<path>` argument
# attaches the image to the request (auto-resized to 2000x2000); the model
# MUST declare image input in the models registry ("input": ["text","image"])
# or pi bounces it with "Current model does not support images". Swap targets
# therefore need that declaration added to their registry entry too.
#
# Patience: Astra and Sol are native multimodal GPT models; the policy pins
# both to xhigh. An empty stdout mid-reasoning is NOT a failure; the final
# answer lands when the reasoning block closes. Callers: use a generous
# timeout (600s+). Probe the selected remote model before a new route; if it
# is DOWN, stop and escalate rather than silently routing to a legacy model.

set -euo pipefail

MODEL=""
FAST=0
LOCAL=0
ARGS=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --fast) FAST=1; shift ;;
    --local) LOCAL=1; shift ;;
    --model) MODEL="$2"; shift 2 ;;
    --model=*) MODEL="${1#--model=}"; shift ;;
    --help|-h) sed -n '1,20p' "$0" | sed 's/^#//;s/^ //'; exit 0 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done

if [ "${#ARGS[@]}" -lt 1 ]; then
  echo "usage: vision-read <image-path> [\"prompt\"] [--fast|--model <provider/model-id>]" >&2
  exit 2
fi

IMG="${ARGS[0]}"
PROMPT="${ARGS[1]:-Describe EXACTLY what this image shows: visible terminal panes or windows, any text you can read verbatim (titles, prompts, errors, status bars), and anything unusual. Be literal and complete — forensic read.}"

# Absolute path required (pi resolves @files against cwd).
case "$IMG" in
  /*) ;;
  *) IMG="$(pwd)/$IMG" ;;
esac
if [ ! -f "$IMG" ]; then
  echo "image not found: $IMG" >&2
  exit 1
fi

# Model resolution: VISION_MODEL env > --model flag > --fast/--local > native GPT default.
if [ -n "${VISION_MODEL:-}" ]; then
  MODEL="$VISION_MODEL"
elif [ -n "$MODEL" ]; then
  : # already set via --model
elif [ "$FAST" = "1" ]; then
  MODEL="lmstudio/google/gemma-4-e2b"
elif [ "$LOCAL" = "1" ]; then
  # LOCAL quality fallback (explicit only; not the GPT policy default).
  # It remains available when an authorized remote vision route is down.
  MODEL="lmstudio/zai-org/glm-4.6v-flash"
else
  # Default: openai-codex/gpt-6-astra — native multimodal GPT, xhigh.
  # Astra is the safe default for 3D/Blender evidence; non-3D callers select
  # openai-codex/gpt-5.6-sol explicitly. KYLE is a role, not a legacy default.
  MODEL="openai-codex/gpt-6-astra"
fi

# Env-cleared pi probe pattern (PI_* vars would override the launch).
THINKING="${VISION_THINKING:-xhigh}"
env $(env | grep '^PI_' | sed 's/=.*//;s/^/-u /' | tr '\n' ' ') \
  pi --print --no-session --no-tools --thinking "$THINKING" --model "$MODEL" "@$IMG" "$PROMPT"
