#!/bin/bash
# quota-probe — env-cleared probe of provider(s)/model(s) through pi (the 08-13 probe
# one-liner, scripted + recorded). Silas runs this BEFORE every Perkins-round /
# dream dispatch and HOURLY under heavy use (the P1 quota-regime practice).
#
# Usage:
#   bin/quota-probe [provider/model ...]     (default: openai-codex/gpt-6-astra — the reasoning tier)
#   bin/quota-probe --deferred               (Improvement #6, user-approved 2026-08-18:
#                                             probe every provider referenced by a
#                                             deferred:<tag> ledger row; used by the
#                                             nefario-watch hourly tick to surface
#                                             LIFTED deferred verdicts)
#   bin/quota-probe --paths                   resolution report (pi=<abs>, timeout=<abs|none>);
#                                             used by the night-watchman self-test + startup
#                                             log. Exits 2 when pi is unresolvable.
# Writes: _bmad-output/memory/quota-regime.json  { provider, model, ok, error, ts }
# Prints: OK <model> | DOWN <model> (<first-40 chars of the error>) per model.

OUT=/Users/moses/code/_bmad-output/memory/quota-regime.json
mkdir -p "$(dirname "$OUT")"

# ── binary resolution (launchd-safe) ─────────────────────────────────────
# The probe runs under launchd's minimal PATH (plist:
# /opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin) where
# `pi` — an fnm-global binary — is NOT resolvable. Live exposure
# 2026-08-21 23:38Z: the probe died with `env: pi: No such file or
# directory` BEFORE reaching the provider and the night-watchman's gate
# misread that as ALL reasoning providers DOWN (real Gru death → no
# auto-relaunch; Silas relaunched manually). Resolution chain:
#   $PI_BIN (plist EnvironmentVariables) → fnm well-known paths
#   (~/.local/share/fnm/aliases/default/bin — the current node — then
#   node-versions/*/installation/bin, newest version first) → `command -v`
#   (interactive shells keep working unchanged).
# An unresolvable pi is a HARD failure (exit 2, NO regime write) — a
# PATH error must never be recorded as a provider verdict.

resolve_bin() { # $1=name $2=preferred-abs (may be empty)
  local name="$1" pref="$2" p sortcmd
  if [ -n "$pref" ] && [ -x "$pref" ]; then printf '%s\n' "$pref"; return 0; fi
  if [ -x "$HOME/.local/share/fnm/aliases/default/bin/$name" ]; then
    printf '%s\n' "$HOME/.local/share/fnm/aliases/default/bin/$name"
    return 0
  fi
  # version globs expand alphabetically (v16 before v22) — newest first.
  if printf 'a\nb\n' | sort -Vr >/dev/null 2>&1; then sortcmd="sort -Vr"; else sortcmd="sort -r"; fi
  for p in $(printf '%s\n' "$HOME"/.local/share/fnm/node-versions/*/installation/bin/"$name" 2>/dev/null | $sortcmd); do
    [ -x "$p" ] && { printf '%s\n' "$p"; return 0; }
  done
  command -v "$name" 2>/dev/null || return 1
}

PI_BIN="${PI_BIN:-}"
PI_BIN="$(resolve_bin pi "$PI_BIN" || true)"
[ -n "$PI_BIN" ] && export PI_BIN
TIMEOUT_BIN="${TIMEOUT_BIN:-}"
TIMEOUT_BIN="$(resolve_bin timeout "$TIMEOUT_BIN" || true)"

if [ -z "$PI_BIN" ]; then
  echo "quota-probe: FATAL — pi binary unresolvable (set PI_BIN or check the fnm install); no provider verdict, no regime write" >&2
  exit 2
fi

MODELS=("$@")
if [ ${#MODELS[@]} -eq 0 ]; then
  # Default probe = the reasoning model (openai-codex/gpt-6-astra, user ruling 2026-09-07).
  MODELS=(openai-codex/gpt-6-astra)
fi

if [ "${MODELS[0]}" = "--paths" ]; then
  # launchd-friendly resolution report (night-watchman self-test + startup log).
  echo "pi=$PI_BIN"
  echo "timeout=${TIMEOUT_BIN:-none}"
  exit 0
fi

if [ "${MODELS[0]}" = "--deferred" ]; then
  # Resolve the providers behind deferred:<tag> ledger rows (tag map lives here,
  # single source — bin/ledger queue mirrors it for display only).
  MODELS=($(python3 - <<'PY'
import json, subprocess
try:
    rows = json.loads(subprocess.run(
        ["/Users/moses/code/bin/ledger", "json"], capture_output=True, text=True, check=True).stdout)
except Exception:
    rows = []
tag_provider = {
    # Legacy deferred tags resolve to the old providers for historical rows;
    # new deferred tags on the GPT chain use astra/sol/luna below.
    "glm": "zai-coding-cn/glm-5.3", "zai": "zai-coding-cn/glm-5.3", "glm-5.3": "zai-coding-cn/glm-5.3",
    "kimi": "kimi-coding/k3", "k3": "kimi-coding/k3",
    "flash": "deepseek/deepseek-v4-flash",
    # GPT chain (user ruling 2026-09-07): astra = reasoning/3D, sol = minions, luna = COO.
    "astra": "openai-codex/gpt-6-astra", "sol": "openai-codex/gpt-5.6-sol", "luna": "openai-codex/gpt-5.6-luna",
    "gpt": "openai-codex/gpt-6-astra",
}
provs = set()
for r in rows:
    t = (r.get("deferred") or "").strip().lower()
    if t and r.get("status") != "done" and t in tag_provider:
        provs.add(tag_provider[t])
print(" ".join(sorted(provs)))
PY
))
  if [ ${#MODELS[@]} -eq 0 ]; then
    echo "no deferred rows to probe"
    exit 0
  fi
fi

for MODEL in "${MODELS[@]}"; do
  # U3 arg-guard (user-approved 2026-08-19): a '-'-prefixed arg is a swallowed
  # CLI flag (the '--help' phantom-regime-row class, 08-19) — refuse it.
  if [[ "$MODEL" == -* ]]; then
    echo "bad model arg: $MODEL (flag-like args are rejected; use --deferred or a provider/model path)" >&2
    exit 2
  fi
  UNSET_ENV="$(env | grep '^PI_' | sed 's/=.*//;s/^/-u /' | tr '\n' ' ')"
  if [ -n "$TIMEOUT_BIN" ]; then
    RESP=$(cd /tmp && "$TIMEOUT_BIN" 60 env $UNSET_ENV "$PI_BIN" --model "$MODEL" -p --no-session -nt "Reply OK" 2>&1 | tail -2)
  else
    RESP=$(cd /tmp && env $UNSET_ENV "$PI_BIN" --model "$MODEL" -p --no-session -nt "Reply OK" 2>&1 | tail -2)
  fi

  if echo "$RESP" | grep -q "^OK$"; then
    STATUS=ok; ERR=""
  else
    STATUS=down
    ERR=$(echo "$RESP" | tr '\n' ' ' | cut -c1-160)
  fi

  TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  python3 - "$OUT" "$MODEL" "$STATUS" "$ERR" "$TS" <<'PY'
import json, sys
out, model, status, err, ts = sys.argv[1:]
regime = {}
try:
    regime = json.load(open(out))
except Exception:
    pass
regime[model] = {"ok": status == "ok", "error": err, "ts": ts}
json.dump(regime, open(out, "w"), indent=1)
print("written", out)
PY

  if [ "$STATUS" = "ok" ]; then
    echo "OK $MODEL"
  else
    echo "DOWN $MODEL ($ERR)"
  fi
done
exit 0
