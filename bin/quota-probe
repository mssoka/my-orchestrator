#!/bin/bash
# quota-probe — env-cleared probe of a provider/model through pi (the 08-13 probe
# one-liner, scripted + recorded). Silas runs this BEFORE every Perkins-round /
# dream dispatch and HOURLY under heavy use (the P1 quota-regime practice).
#
# Usage: bin/quota-probe [provider/model]   (default: kimi-coding/k3 — the reasoning primary)
# Writes: _bmad-output/memory/quota-regime.json  { provider, model, ok, error, ts }
# Prints: OK <model> | DOWN <model> (<first-40 chars of the error>)

MODEL="${1:-kimi-coding/k3}"
OUT=/Users/moses/code/_bmad-output/memory/quota-regime.json
mkdir -p "$(dirname "$OUT")"

RESP=$(cd /tmp && timeout 60 env $(env|grep '^PI_'|sed 's/=.*//;s/^/-u /'|tr '\n' ' ') pi --model "$MODEL" -p --no-session -nt "Reply OK" 2>&1 | tail -2)

if echo "$RESP" | grep -q "^OK$"; then
  STATUS=ok; ERR=""
else
  STATUS=down
  ERR=$(echo "$RESP" | tr '\n' ' ' | cut -c1-160)
fi

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
python3 - "$OUT" "$MODEL" "$STATUS" "$ERR" "$TS" <<'PY'
import json, sys
out, model, status, err, ts = sys.argv[1:]
regime = {}
try:
    regime = json.load(open(out))
except Exception:
    pass
regime[model] = {"ok": status == "ok", "error": err, "ts": ts}
json.dump(regime, open(out, "w"), indent=1)
print("written", out)
PY

if [ "$STATUS" = "ok" ]; then
  echo "OK $MODEL"
else
  echo "DOWN $MODEL ($ERR)"
fi
exit 0
