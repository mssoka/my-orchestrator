+// W9 — post-cap surge-lands (Perkins r1 W9 + r2 W6 pin): on a known seed,
+// era 3 + growth on + the streaming-surge window — the window's streaming
+// spawn count is >= the re-tuned expected volume × 0.95 (10/tick × the
+// window), every terminal's spawns stay <= cap × window + burst allowance,
+// and every terminal's credit stays <= MAX_CREDIT (never silently zeroed).
+// The re-tuned trio (era-3 demand 1+1, surge ×10, growth interval 40) is
+// RE-VALIDATED TOGETHER here: the surge must land as an aggregation event —
+// spread across the growth-born content_hosts (silent non-landing is a fail).
+@(test)
+test_w9_surge_lands_under_caps :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	// the E22 backstop is not under test (like the director pins above):
+	// W9 counts CONSTRUCTED spawns; raise the pool so the backstop can't bite.
+	cat.balance.pool_max_packets = 100000
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 4243, cat.hash, TEST_LOGIC_HZ)
+	s.era = 3
+	// the mesh: one player-placed router (growth proceeds outward from it).
+	res_idx, _ := node_type_index(cat, "residential")
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	host_idx, _ := node_type_index(cat, "content_host")
+	topology_spawn_node(&s.topology, res_idx, {20, 15}, cat) // the start map's one residential
+	topology_spawn_node(&s.topology, rt_idx, {20, 17}, cat)
+	topology_spawn_node(&s.topology, host_idx, {20, 13}, cat) // the start map's one host
+	s.growth_enabled = true
+
+	SURGE_START :: u64(1200)
+	SURGE_END :: u64(3000)
+	WINDOW := SURGE_END - SURGE_START
+	EXPECTED := 10 * WINDOW // the re-tuned surge: ×10 the era-3 streaming base (1/tick)
+	MIN_LAND := EXPECTED * 95 / 100
+
+	hosts := 0
+	credit_ok := true
+	burst_ok := true
+	stream_spawned: u64 = 0
+	per_host_spawns := make(map[u32]u64, 64) // outlives the tick loop (run arena)
+	defer delete(per_host_spawns)
+	for tick in u64(1)..=SURGE_END {
+		batch := make([dynamic]Command, 0, 4, context.temp_allocator)
+		for cmd in s.action_log {
+			if cmd.apply_tick == tick {
+				append(&batch, cmd)
+			}
+		}
+		step(&s, tick, batch[:], cat)
+		// the in-window per-tick per-host burst ceiling (ceil_cap = 2)
+		per_tick_host_burst := make(map[u32]u32, 16, context.temp_allocator)
+		for p in s.flow.packets {
+			if p.class == 1 && p.spawn_tick == tick {
+				stream_spawned += 1
+				per_tick_host_burst[p.src] += 1
+				per_host_spawns[p.src] += 1
+			}
+		}
+		for src, n in per_tick_host_burst {
+			if n > 2 { burst_ok = false }
+		}
+		delete(per_tick_host_burst)
+		free_all(context.temp_allocator)
+	}
+	// count the growth-born hosts + the seed fixture host
+	for ns in 0..<len(s.topology.node_alive) {
+		if !s.topology.node_alive[ns] { continue }
+		if s.topology.node_kind[ns] == .Terminal && s.topology.node_role[ns] == .Content_Host {
+			hosts += 1
+		}
+	}
+	// per-terminal window spawns + credit bounds (the W9 envelope)
+	for ns in 0..<len(s.topology.node_alive) {
+		if !s.topology.node_alive[ns] { continue }
+		if s.topology.node_role[ns] != .Content_Host { continue }
+		if int(s.topology.node_type[ns]) >= len(cat.node_types) { continue }
+		accrue := u64(spawn_credit_accrue_milli(cat, s.topology.node_type[ns]))
+		max_credit := u64(spawn_credit_max_milli(cat, s.topology.node_type[ns]))
+		if u64(s.flow.spawn_credit_milli[ns]) > max_credit { credit_ok = false }
+		// spawns <= floor((MAX + W×accrue)/1000) = ceil_cap + floor(W×cap)
+		ceil_cap := (accrue + 999) / 1000
+		bound := ceil_cap + accrue * WINDOW / 1000
+		if per_host_spawns[s.topology.node_id[ns]] > bound { credit_ok = false }
+	}
+	testing.expectf(t, hosts >= 8, "growth must place >= 8 content_hosts by the surge window (got %d) — the aggregation crowd", hosts)
+	testing.expectf(t, stream_spawned >= MIN_LAND,
+		"W9 FAIL: the surge must LAND — streaming window spawns %d < %d (expected × 0.95); the capped map cannot source the surge", stream_spawned, MIN_LAND)
+	testing.expectf(t, burst_ok, "no per-tick burst beyond the ceiling (2 = ceil_cap) may occur")
+	testing.expectf(t, credit_ok, "every terminal's credit must stay <= MAX_CREDIT and its window spawns <= cap×W + burst")
+}
+
+// W10 — one-subscriber-at-cap zero-drop (r2 W6/W5 pin): on a known seed, over
+// a W-tick window: every terminal's spawns <= ceil(cap × W) + burst allowance
+// and credit <= MAX_CREDIT; a single residential sourcing at its cap shows
+// ZERO drops at its own access lane + no E9 shed at its endpoint, and
+// end-to-end transit <= the class latency tolerance (the W5 burst-latency
+// guard: residential ceiling 1 → no burst-2 through the access).
+@(test)
+test_w10_residential_at_cap_zero_drop :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	cat.balance.pool_max_packets = 100000
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 4243, cat.hash, TEST_LOGIC_HZ)
+	s.era = 3
+	res_idx, _ := node_type_index(cat, "residential")
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	// TWO residentials: the sourcing one (id 0, at its cap) + the sink (id 3)
+	// — the res->res spec needs a real sink set (dst != src). The access legs
+	// are STANDARD (15 u/s — 2 ticks/hop: a narrow 5 u/s would serialize the
+	// 2nd hop in 12 ticks = 600 ms > email's 500 ms tolerance, the exact W5
+	// burst-latency guard).
+	r0 := topology_spawn_node(&s.topology, res_idx, {8, 15}, cat)
+	topology_spawn_node(&s.topology, rt_idx, {20, 15}, cat)
+	r2 := topology_spawn_node(&s.topology, res_idx, {32, 15}, cat) // the sink (id 2)
+	sla_draw(&s, cat, r0, 1, "standard", 1)
+	sla_draw(&s, cat, 1, r2, "standard", 1)
+
+	W :: u64(600)
+	drops_at_access: u64 = 0
+	drops: u64 = 0
+	per_term := make(map[u32]u64, 16) // outlives the tick loop (run arena)
+	defer delete(per_term)
+	for tick in u64(1)..=W {
+		before := len(s.events)
+		batch := make([dynamic]Command, 0, 4, context.temp_allocator)
+		for cmd in s.action_log {
+			if cmd.apply_tick == tick {
+				append(&batch, cmd)
+			}
+		}
+		step(&s, tick, batch[:], cat)
+		for e in s.events[before:] {
+			if e.tag == EVENT_TAG_PACKET_DROPPED {
+				drops += 1
+				// the access lane is bundle 0 (the r0<->router pair): a drop
+				// AT the sourcing residential's own access would target it
+				if e.target == 0 { drops_at_access += 1 }
+			}
+		}
+		for p in s.flow.packets {
+			if p.class == 0 && p.spawn_tick == tick {
+				per_term[p.src] += 1
+			}
+		}
+		clear(&s.events)
+		free_all(context.temp_allocator)
+	}
+	// every terminal's window spawns <= ceil(cap×W) + burst (res: 600×83/1000
+	// = 49.8 → ceil 50, + 1 burst = 51) and credit <= MAX_CREDIT (1000)
+	for src, n in per_term {
+		if n > 51 {
+			testing.expectf(t, false, "res %d sourced %d over the window (bound 51 = ceil(0.083×600) + 1)", src, n)
+		}
+	}
+	rs0, _ := node_slot(&s.topology, r0)
+	testing.expectf(t, s.flow.spawn_credit_milli[rs0] <= 1000, "sourcing res credit %d > MAX_CREDIT 1000", s.flow.spawn_credit_milli[rs0])
+	testing.expectf(t, drops == 0, "W10 FAIL: %d drops on the at-cap two-res path (want 0 — the access never congests)", drops)
+	testing.expectf(t, drops_at_access == 0, "no drop may target the sourcing res's own access bundle")
+	testing.expectf(t, !s.replay_error, "no draw may be rejected (the fixture must be fully wired — a rejected draw would make the transit pin vacuous)")
+	// end-to-end transit <= the class latency tolerance (W5): the SLA average
+	// is the contract metric (latency_tol_ms — the breach key); the avg cannot
+	// exceed the tolerance on an at-cap residential (1 spawn per ~12 ticks
+	// through 2 standard hops = 4 ticks = 200 ms). NON-VACUOUS: the emails
+	// must actually deliver (delivered > 0 — the route exists).
+	testing.expectf(t, s.flow.sla[0].delivered > 0, "the at-cap path must deliver emails (the W5 transit guard must be non-vacuous), got 0 delivered")
+	if s.flow.sla[0].delivered > 0 {
+		avg_ms := s.flow.sla[0].total_latency_ms / s.flow.sla[0].delivered
+		testing.expectf(t, avg_ms <= 500, "end-to-end email avg transit %d ms > the 500 ms latency tolerance (W5)", avg_ms)
+	}
+	// the sourcing res actually sourced at its cap (the scenario is live)
+	testing.expectf(t, per_term[r0] >= 40, "the sourcing res must source ~50 emails (cap 0.083 × 600), got %d — the scenario is dead", per_term[r0])
+}
