diff --git a/core/sla_test.odin b/core/sla_test.odin
index f98f469..a4222d1 100644
--- a/core/sla_test.odin
+++ b/core/sla_test.odin
@@ -478,3 +478,57 @@ test_sla_serialize_absent_when_empty :: proc(t: ^testing.T) {
 	testing.expect_value(t, len(s.flow.sla), 0)
 	testing.expect_value(t, len(s.flow.sla_breach), 0)
 }
+
+// 5.9 (the N1 seam — pinned at the sla_check_invariant home): a CREDIT-GATED
+// skip is NOT a demand event (it never reaches sla_count_demand) while a
+// POOL-DROPPED arrival IS (it counts demand then drops) — the pinned
+// invariant demand_seen == delivered + dropped + live (E24) holds under both
+// paths, asserted per tick by sla_record_run/sla_check_invariant. Construction:
+// era 3 + the ×10 surge on ONE content_host — the surge demand (10/tick)
+// exceeds the host's cap (1.33/tick), so ~87% of the streaming volume is
+// credit-gated; a small pool (no pipes — the pile fills it) makes the
+// admitted arrivals pool-drop. Both paths exercise in one run.
+@(test)
+test_sla_credit_gated_skip_not_demand_e24 :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	cat.balance.pool_max_packets = 8 // the E22 backstop engages fast (no pipes)
+	// shrink the surge window for test speed
+	surge := &cat.demand.eras[2].set_pieces[0]
+	surge.start_tick = 20
+	surge.duration_ticks = 100
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 7, cat.hash, TEST_LOGIC_HZ)
+	s.era = 3
+	_, _, _ = qa_fixture(&s, cat) // 3 residentials + 1 host — NO pipes (the pile)
+	_, evs := sla_record_run(&s, 300, cat, t)
+	defer delete(evs)
+
+	stream := u16(1)
+	acc := &s.flow.sla[stream]
+	// the attempted volume: base 1/tick × 300 + surge (10−1)/tick × 100 =
+	// 300 + 900 = 1200 spawn attempts. The demand_seen must be FAR below it
+	// (the credit-gated skips are not demand) — the admitted arrivals are
+	// bounded by the host's cap: ~1.33/tick × 300 = ~400, of which the pool
+	// drops the excess (dropped > 0 — the pool path IS demand).
+	testing.expectf(t, acc.demand_seen < 500,
+		"credit-gated skips must NOT count as demand: demand_seen %d (attempted ~1200)", acc.demand_seen)
+	testing.expectf(t, acc.dropped > 0,
+		"the pool-dropped arrivals must count as demand + drops (E22 path), got %d dropped", acc.dropped)
+	// the invariant held per tick (sla_record_run asserted it); the final
+	// state satisfies it explicitly too
+	testing.expectf(t, acc.delivered + acc.dropped + sla_live(&s, stream) == acc.demand_seen,
+		"E24: demand_seen %d != delivered %d + dropped %d + live %d",
+		acc.demand_seen, acc.delivered, acc.dropped, sla_live(&s, stream))
+	// the email class: 1/tick demand vs 3 res × 0.083 cap — the skips are
+	// likewise uncounted (demand_seen ≈ 0.25/tick × 300 = ~75 max)
+	email := &s.flow.sla[0]
+	testing.expectf(t, email.demand_seen < 200,
+		"email credit-gated skips must not count as demand: %d (attempted 300)", email.demand_seen)
+	testing.expectf(t, email.delivered + email.dropped + sla_live(&s, 0) == email.demand_seen,
+		"E24 (email): demand_seen %d != delivered %d + dropped %d + live %d",
+		email.demand_seen, email.delivered, email.dropped, sla_live(&s, 0))
+}
