+#!/usr/bin/env python3
+"""AR-RC13 affordance-derivation lint (#607 item 5, #610 r1 W3/N1).
+
+The RC4.2-r1 and RC4.3-r1 blockers were the same bug class: the client
+panel re-derived affordance LEGALITY from the status (a client-side
+terminality list omitting v2 `completed`; an overflow menu that derived
+take-over/substitute from status arms) instead of consuming the
+server-computed `hooks` object. The fixed panel gates every hook-governed
+action on `case call.hooks.can_*`.
+
+RULE: in the panel, a LIST CONSTRUCTION of the hook-governed actions
+(`RefcheckTakeOver`, `RefcheckSubstitute`) must sit inside a
+`case call.hooks.can_take_over` / `case call.hooks.can_substitute_referee`
+block - at ANY nesting depth (a helper `case` nested inside the hooks gate
+is still gated, so legal refactors pass; N1).
+
+Detection is token-based (comments/strings stripped), so construction shape
+is irrelevant: single-line (`[RefcheckTakeOver]`), multiline, or non-final
+list position (`[RefcheckTakeOver, RefcheckSubstitute]`) are all caught
+(W3). Exempt by shape:
+
+- Pattern-match arms (`RefcheckTakeOver -> ...` in the confirm/edit render
+  switches) - they consume an already-decided action, they do not decide
+  legality.
+- Call arguments (`UserChoseRefcheckAction(..., RefcheckSubstitute)`) -
+  message-payload construction inside the hook-gated surface fns; the
+  panel tests pin those surfaces (N7).
+- The shared import block.
+
+`can_record_manual` terminality is guarded separately: the shared
+`is_terminal_status` is the single terminality truth, consumed by the
+server's hooks (and now by trigger.gleam's slot-liveness, #610 r1 W2) and
+the client fixture - the client has no list to drift.
+
+Exit 1 on any violation. Wired into .github/workflows/test.yml.
+"""
+
+import pathlib
+import re
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parent.parent
+PANEL = ROOT / "client/src/components/reference_panel.gleam"
+
+# action constructor -> the hook gate that may contain it
+HOOK_FOR = {
+    "RefcheckTakeOver": "can_take_over",
+    "RefcheckSubstitute": "can_substitute_referee",
+}
+
+TOKEN_RE = re.compile(r"->|[{}()[\],|]|[A-Za-z_][A-Za-z0-9_.]*")
+
+
+def tokens_of(text: str) -> list:
+    """(line, token) pairs, comments and string literals stripped."""
+    tokens = []
+    i, line, n = 0, 1, len(text)
+    in_str = False
+    while i < n:
+        c = text[i]
+        if in_str:
+            if c == "\\":
+                i += 2
+                continue
+            if c == '"':
+                in_str = False
+            elif c == "\n":
+                line += 1
+            i += 1
+            continue
+        if c == "/" and i + 1 < n and text[i + 1] == "/":
+            while i < n and text[i] != "\n":
+                i += 1
+            continue
+        if c == '"':
+            in_str = True
+            i += 1
+            continue
+        if c == "\n":
+            line += 1
+            i += 1
+            continue
+        m = TOKEN_RE.match(text, i)
+        if m:
+            tokens.append((line, m.group(0)))
+            i = m.end()
+            continue
+        i += 1
+    return tokens
+
+
+def main() -> int:
+    text = PANEL.read_text(encoding="utf-8")
+    tokens = tokens_of(text)
+
+    stack = []  # (bracket, line, gate_name_or_None)
+    pending_case = None  # IDENTs accumulated since `case`, awaiting `{`
+    violations = []
+
+    for idx, (line, tok) in enumerate(tokens):
+        if tok == "case":
+            pending_case = []
+            continue
+        if tok in ("{", "[", "("):
+            gate = None
+            if tok == "{" and pending_case is not None:
+                seq = pending_case
+                if seq == ["call.hooks.can_take_over"]:
+                    gate = "can_take_over"
+                elif seq == ["call.hooks.can_substitute_referee"]:
+                    gate = "can_substitute_referee"
+            stack.append((tok, line, gate))
+            pending_case = None
+            continue
+        if tok in ("}", "]", ")"):
+            if stack:
+                stack.pop()
+            pending_case = None
+            continue
+        if tok == "->":
+            pending_case = None
+            continue
+        if tok in ("|", ",", ":"):
+            pending_case = None
+            continue
+        # identifier
+        if pending_case is not None:
+            pending_case.append(tok)
+        if tok in HOOK_FOR:
+            # pattern-match arm? exempt
+            nxt = tokens[idx + 1][1] if idx + 1 < len(tokens) else ""
+            if nxt == "->":
+                continue
+            inner = stack[-1][0] if stack else ""
+            if inner == "[":
+                # list construction: must have an enclosing gate of the
+                # matching hook name at ANY depth
+                wanted = HOOK_FOR[tok]
+                if not any(b == "{" and g == wanted for (b, _, g) in stack):
+                    violations.append(
+                        f"{PANEL.relative_to(ROOT)}:{line}: {text.splitlines()[line-1].strip()[:120]}"
+                    )
+            # `(` call arg / `{` import / top-level: exempt by shape
+    if violations:
+        print("AR-RC13 violation: hook-governed affordance constructed outside its hooks gate:")
+        for v in violations:
+            print(f"  {v}")
+        print("\nThe panel may only CONSTRUCT take-over/substitute actions inside")
+        print("`case call.hooks.can_take_over` / `case call.hooks.can_substitute_referee`")
+        print("blocks (at any nesting depth) - the server hooks are the single source of")
+        print("truth (AR-RC13).")
+        return 1
+    print(f"refcheck hooks-derivation lint clean ({PANEL.name})")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
