+    for path in iter_files():
+        try:
+            raw_lines = path.read_text(encoding="utf-8").splitlines()
+        except UnicodeDecodeError:
+            continue
+        # comment-stripped code per line, joined with offsets for
+        # region-based scanning (multiline log calls span lines)
+        code_lines = [strip_comment(line) for line in raw_lines]
+        code = "\n".join(code_lines)
+        offsets = []
+        off = 0
+        for cl in code_lines:
+            offsets.append(off)
+            off += len(cl) + 1
+        log_regions = log_call_regions(code)
