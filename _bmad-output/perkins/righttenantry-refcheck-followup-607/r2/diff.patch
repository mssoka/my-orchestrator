+def strip_comment(line: str) -> str:
+    """Return the line minus a trailing // comment (escape-aware)."""
+    out = []
+    in_str = False
+    i = 0
+    while i < len(line):
+        c = line[i]
+        if in_str:
+            out.append(c)
+            if c == "\\" and i + 1 < len(line):
+                out.append(line[i + 1])
+                i += 2
+                continue
+            if c == '"':
+                in_str = False
+            i += 1
+            continue
+        if c == '"':
+            in_str = True
+            out.append(c)
+            i += 1
+            continue
+        if c == "/" and i + 1 < len(line) and line[i + 1] == "/":
+            break
+        out.append(c)
+        i += 1
+    return "".join(out)
+
+
+def string_spans(code: str) -> list:
+    """(start, end) spans of double-quoted string literals (escape-aware)."""
+    spans = []
+    i, n = 0, len(code)
+    while i < n:
+        c = code[i]
+        if c == '"':
+            j = i + 1
+            while j < n:
+                if code[j] == "\\":
+                    j += 2
+                    continue
+                if code[j] == '"':
+                    break
+                j += 1
+            if j < n:
+                spans.append((i, j + 1))
+                i = j + 1
+                continue
+            i = j
+            continue
+        i += 1
+    return spans
+
+
+def log_call_regions(code: str) -> list:
+    """(start, end) spans of developer-facing log/telemetry call arguments
+    (from the call's opening paren to its matching close paren, respecting
+    nested strings and parens, spanning lines). Em-dashes inside these
+    regions are exempt: they are log lines, not landlord-facing copy."""
+    regions = []
+    for m in LOG_CALL_RE.finditer(code):
+        i = m.end()  # just past the opening paren
+        depth = 1
+        n = len(code)
+        in_str = False
+        while i < n and depth > 0:
+            c = code[i]
+            if in_str:
+                if c == "\\":
+                    i += 2
+                    continue
+                if c == '"':
+                    in_str = False
+            elif c == '"':
+                in_str = True
+            elif c == "(":
+                depth += 1
+            elif c == ")":
+                depth -= 1
+            i += 1
+        regions.append((m.end(), i))
+    return regions
+
+
+def iter_files() -> list:
+    files = []
+    for p in sorted(ROOT.glob(CLIENT_GLOB)):
+        files.append(p)
+    for pattern in SERVER_INCLUDE:
+        files.extend(sorted(ROOT.glob(pattern)))
