+            for start, end in string_spans(cl):
+                literal = cl[start:end]
+                if EM_DASH not in literal:
+                    continue
+                abs_start = base + start
+                if any(rs <= abs_start < re for (rs, re) in log_regions):
+                    continue  # developer-facing log argument
+                if owner in SPEC_VERBATIM_OWNERS:
+                    continue
+                violations.append(
+                    f"{path.relative_to(ROOT)}:{lineno}: {raw.strip()[:120]}"
+                )
+    if violations:
+        print("Em-dash (U+2014) found in user-facing string literal(s):")
+        for v in violations:
+            print(f"  {v}")
+        print("\nThe RT-wide em-dash ban applies to landlord/applicant-facing copy.")
+        print("Make the string dash-free, or - only for spec-verbatim copy - add")
+        print("its owner to SPEC_VERBATIM_OWNERS in scripts/lint_em_dash.py with a")
+        print("provenance note.")
+        return 1
+    print(f"em-dash lint clean ({len(iter_files())} files scanned)")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
