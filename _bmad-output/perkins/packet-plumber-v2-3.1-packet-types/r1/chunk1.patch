index 0000000..2d5b681
--- /dev/null
+++ b/core/demand_test.odin
@@ -0,0 +1,238 @@
+package core
+
+// demand_test.odin — pins the 3.1 demand director (ODN-7, v1 §3):
+//   (a) weighted_pick is seeded + distribution-correct (v1 §3.3: the dst pick
+//       follows the sink demand_weights — here all 1, so UNIFORM over the
+//       sink set at the data level, and [1,2,3] at the unit level);
+//   (b) flow_step spawns per-spec: right class, right typed src/sink roles,
+//       dst != src (no self-loop), per-tick volume, and the set-piece
+//       multiplier (the Streaming Surge x10) amplifies ONLY its class;
+//   (c) era 0 (legacy runs) spawns nothing from the director AND draws no rng
+//       (legacy demos' rng stream stays at its post-seed value — the
+//       briefing's "keep both" decision);
+//   (d) same seed => byte-identical director spawn sequence (the replay spine
+//       holds for the director's rng draws).
+//
+// qa_fixture spawns EXTRA terminals (the §3.3 rule needs multiple sinks);
+// test_catalog mirrors data/*.json exactly (era 1/2 email-only, era 3 email +
+// streaming + the streaming_surge set-piece).
+
+import "core:testing"
+
+// qa_fixture — the §3.3 topology: residentials at node ids 0, 1, 3 (all
+// demand_weight 1), router at 2, content host at 4. No pipes (spawns don't
+// need them; routing/ECMP are not under test). Returns the three residential
+// node ids in spawn order.
+qa_fixture :: proc(state: ^Run_State, cat: ^Catalogs) -> (u32, u32, u32) {
+	res_idx, _ := node_type_index(cat, "residential")
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	host_idx, _ := node_type_index(cat, "content_host")
+	a := topology_spawn_node(&state.topology, res_idx, {6, 15}, cat)
+	b := topology_spawn_node(&state.topology, res_idx, {12, 15}, cat)
+	topology_spawn_node(&state.topology, rt_idx, {20, 15}, cat)
+	c := topology_spawn_node(&state.topology, res_idx, {26, 15}, cat)
+	topology_spawn_node(&state.topology, host_idx, {34, 15}, cat)
+	return a, b, c
+}
+
+// spawn_histogram — the spawned-packet fingerprint: per-class counts, per-class
+// (dst, src) histograms, and self-loop count. Deterministic; the whole
+// histogram is compared byte-wise for the same-seed reproducibility pin.
+// Node ids are small in tests (< 64) so fixed arrays suffice.
+spawn_histogram :: proc(f: ^Flow_State) -> (by_class: [8]u64, dst_hist: [8][64]u64, src_hist: [8][64]u64, self_loops: u64) {
+	for p in f.packets {
+		by_class[p.class] += 1
+		dst_hist[p.class][p.dst] += 1
+		src_hist[p.class][p.src] += 1
+		if p.src == p.dst { self_loops += 1 }
+	}
+	return
+}
+
+// tick_class_count — how many packets of `class` spawned at exactly `tick`
+// (pins per-tick volume — the surge window boundaries).
+tick_class_count :: proc(f: ^Flow_State, tick: u64, class: u16) -> u64 {
+	n: u64
+	for p in f.packets {
+		if p.spawn_tick == tick && p.class == class { n += 1 }
+	}
+	return n
+}
+
+@(test)
+test_weighted_pick_distribution :: proc(t: ^testing.T) {
+	weights := []i32{1, 2, 3}
+	DRAWS :: 18000
+
+	// (a) determinism: same seed -> identical pick sequence, draw by draw
+	r1: Rng; rng_seed(&r1, 1337)
+	r2: Rng; rng_seed(&r2, 1337)
+	c1: [3]u64; c2: [3]u64
+	for i in 0..<DRAWS {
+		p1, ok1 := weighted_pick(&r1, weights)
+		p2, ok2 := weighted_pick(&r2, weights)
+		testing.expect(t, ok1 && ok2, "weighted_pick must succeed on positive weights")
+		testing.expect(t, p1 == p2, "weighted_pick must be deterministic for a fixed seed")
+		c1[p1] += 1
+		c2[p2] += 1
+	}
+	total := c1[0] + c1[1] + c1[2]
+	testing.expectf(t, total == DRAWS, "total picks: got %d, want %d", total, DRAWS)
+	// ratio ~ 1:2:3 (3000/6000/9000); 3-sigma over the binomial (sigma ~50/63)
+	// — a >3-sigma miss means the weights are not driving the pick
+	testing.expectf(t, c1[0] >= 3000-170 && c1[0] <= 3000+170, "bucket 0: got %d, want ~3000 (weight 1)", c1[0])
+	testing.expectf(t, c1[1] >= 6000-210 && c1[1] <= 6000+210, "bucket 1: got %d, want ~6000 (weight 2)", c1[1])
+	testing.expectf(t, c1[2] >= 9000-210 && c1[2] <= 9000+210, "bucket 2: got %d, want ~9000 (weight 3)", c1[2])
+
+	// zero-weight is never picked (but counts toward nothing)
+	z: Rng; rng_seed(&z, 7)
+	zc: [2]u64
+	for i in 0..<1000 {
+		p, ok := weighted_pick(&z, []i32{0, 5})
+		testing.expect(t, ok, "nonzero total must succeed")
+		zc[p] += 1
+	}
+	testing.expectf(t, zc[0] == 0, "zero-weight bucket must never be picked, got %d", zc[0])
+	testing.expectf(t, zc[1] == 1000, "all picks must land in the nonzero bucket, got %d", zc[1])
+
+	// all-zero weights -> no pick (callers skip the spec)
+	a: Rng; rng_seed(&a, 8)
+	_, ok := weighted_pick(&a, []i32{0, 0})
+	testing.expect(t, !ok, "all-zero weights must fail the pick")
+}
+
+@(test)
+test_set_piece_active_window :: proc(t: ^testing.T) {
+	sp := Set_Piece{class = 1, multiplier = 10, start_tick = 1200, duration_ticks = 1800}
+	testing.expect(t, !set_piece_active(&sp, 1199), "before the window must be inactive")
+	testing.expect(t, set_piece_active(&sp, 1200), "window start must be active")
+	testing.expect(t, set_piece_active(&sp, 2999), "window end-1 must be active")
+	testing.expect(t, !set_piece_active(&sp, 3000), "window end must be inactive")
+
+	// effective_volume multiplies ONLY the matching class
+	plan := Pressure_Plan{tick = 1500, era_sp = []Set_Piece{sp}}
+	plan.active_sp = make([dynamic]u16, 0, 2, context.temp_allocator)
+	defer pressure_plan_destroy(&plan)
+	append(&plan.active_sp, 0)
+	testing.expectf(t, effective_volume(&plan, 1, 2) == 20, "surge class volume: got %d, want 20", effective_volume(&plan, 1, 2))
+	testing.expectf(t, effective_volume(&plan, 0, 2) == 2, "other class must be unamplified: got %d", effective_volume(&plan, 0, 2))
+}
+
+@(test)
+test_director_spawns_by_spec :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	email_idx, _ := class_index(cat, "email")
+	stream_idx, _ := class_index(cat, "streaming")
+	testing.expectf(t, email_idx == 0 && stream_idx == 1, "test catalog class order: email=%d streaming=%d (want 0,1)", email_idx, stream_idx)
+
+	TICKS :: 600 // era 1 = email 2/tick -> 1200 email packets
+
+	state: Run_State
+	defer run_destroy(&state)
+	run_init(&state, 42, cat.hash, TEST_LOGIC_HZ)
+	state.era = 1
+	_, _, _ = qa_fixture(&state, cat)
+	for tick in u64(1)..=TICKS {
+		step(&state, tick, {}, cat)
+	}
+
+	by_class, dst_hist, src_hist, self_loops := spawn_histogram(&state.flow)
+	testing.expectf(t, by_class[0] == 2*TICKS, "email volume: got %d, want %d", by_class[0], 2*TICKS)
+	testing.expectf(t, by_class[1] == 0, "era 1 must spawn no streaming, got %d", by_class[1])
+
+	// §3.3: the dst distribution matches the sink demand_weights (all 1 ->
+	// uniform over the 3 residentials; sigma ~16 -> 3-sigma ~49, use +-60)
+	email := by_class[0]
+	res := dst_hist[0][0] + dst_hist[0][1] + dst_hist[0][3]
+	testing.expectf(t, res == email, "every email must land on a residential sink: %d/%d", res, email)
+	for i in u32(0)..<4 {
+		want := email / 3
+		if i != 2 { // ids 0,1,3 are the residentials
+			got := dst_hist[0][i]
+			testing.expectf(t, got >= want-60 && got <= want+60,
+				"email dst distribution: sink %d got %d, want ~%d (uniform)", i, got, want)
+		}
+	}
+	testing.expectf(t, dst_hist[0][2] == 0 && dst_hist[0][4] == 0,
+		"email dst must never be the router or host (role selector): router=%d host=%d", dst_hist[0][2], dst_hist[0][4])
+	// the src selector: email originates from residentials only
+	testing.expectf(t, src_hist[0][0] + src_hist[0][1] + src_hist[0][3] == email,
+		"every email must originate from a residential (role selector)")
+	testing.expectf(t, self_loops == 0, "no packet may be its own dst (self-loop), got %d", self_loops)
+
+	// (d) same seed -> byte-identical spawn sequence (histograms compare equal)
+	state2: Run_State
+	defer run_destroy(&state2)
+	run_init(&state2, 42, cat.hash, TEST_LOGIC_HZ)
+	state2.era = 1
+	_, _, _ = qa_fixture(&state2, cat)
+	for tick in u64(1)..=TICKS {
+		step(&state2, tick, {}, cat)
+	}
+	by2, d2, s2, sl2 := spawn_histogram(&state2.flow)
+	testing.expect(t, by2 == by_class, "same seed must reproduce per-class spawn counts")
+	testing.expect(t, d2 == dst_hist, "same seed must reproduce dst picks")
+	testing.expect(t, s2 == src_hist, "same seed must reproduce src picks")
+	testing.expect(t, sl2 == self_loops, "same seed must reproduce the self-loop count")
+}
+
+@(test)
+test_director_surge_amplifies_class :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	// shrink the streaming surge window to [400, 600) for test speed (semantics
+	// identical to the data file's [1200, 3000) window)
+	surge := &cat.demand.eras[2].set_pieces[0]
+	surge.start_tick = 400
+	surge.duration_ticks = 200
+
+	state: Run_State
+	defer run_destroy(&state)
+	run_init(&state, 7, cat.hash, TEST_LOGIC_HZ)
+	state.era = 3
+	_, _, _ = qa_fixture(&state, cat)
+	for tick in u64(1)..=800 {
+		step(&state, tick, {}, cat)
+	}
+
+	by_class, _, _, _ := spawn_histogram(&state.flow)
+	// email: 4/tick x 800 (era 3 base volume; the surge targets streaming only)
+	testing.expectf(t, by_class[0] == 4*800, "email volume under surge: got %d, want %d", by_class[0], 4*800)
+	// streaming: 2/tick x 399 before [1,400) + 20/tick x 200 during [400,600)
+	// + 2/tick x 201 after (600,800]
+	want_stream := u64(2*399 + 20*200 + 2*201)
+	testing.expectf(t, by_class[1] == want_stream, "streaming volume (surge x10): got %d, want %d", by_class[1], want_stream)
+
+	// exact window boundaries (set_piece_active semantics through the director)
+	testing.expectf(t, tick_class_count(&state.flow, 399, 1) == 2, "surge must NOT be active at tick 399, got %d", tick_class_count(&state.flow, 399, 1))
+	testing.expectf(t, tick_class_count(&state.flow, 400, 1) == 20, "surge must be active at tick 400, got %d", tick_class_count(&state.flow, 400, 1))
+	testing.expectf(t, tick_class_count(&state.flow, 599, 1) == 20, "surge must be active at tick 599, got %d", tick_class_count(&state.flow, 599, 1))
+	testing.expectf(t, tick_class_count(&state.flow, 600, 1) == 2, "surge must end at tick 600, got %d", tick_class_count(&state.flow, 600, 1))
+}
+
+@(test)
+test_era0_legacy_no_rng_draws :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	state: Run_State
+	defer run_destroy(&state)
+	run_init(&state, 42, cat.hash, TEST_LOGIC_HZ)
+	// era stays 0 (run_init default) — the director's plan is empty
+	_, _, _ = qa_fixture(&state, cat)
+	// legacy path: one trivial request (the slice-1 flow_seed_demand)
+	flow_seed_demand(&state.flow, 3, 0, 1, 0)
+
+	rng_snapshot := state.rng
+	for tick in u64(1)..=10 {
+		step(&state, tick, {}, cat)
+	}
+	testing.expectf(t, len(state.flow.packets) == 1, "era 0 must spawn only the legacy request, got %d packets", len(state.flow.packets))
+	testing.expect(t, state.rng == rng_snapshot,
+		"era 0 must not draw rng (director inactive; legacy demos' rng stream stays put)")
+}
