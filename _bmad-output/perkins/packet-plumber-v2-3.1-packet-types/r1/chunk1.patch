+
+// flow_spawn — the single packet-construction path (legacy + director both
+// route through it). A freshly-spawned packet is resident at its source,
+// ready to forward next tick.
+flow_spawn :: proc(f: ^Flow_State, class: u16, src, dst: u32, tick: u64) {
+	f.next_packet_id += 1
+	append(&f.packets, Packet{
+		id = f.next_packet_id,
+		class = class,
+		src = src,
+		dst = dst,
+		on_edge = false,
+		at_node = src,
+		spawn_tick = tick,
+	})
+}
+
+// weighted_pick — seeded weighted-random index into weights[:], proportional
+// to weights[i] (Lemire draw over the cumulative sum, ONE rng draw per pick).
+// Array-order walk (no map-iter — ODN-10). A zero/negative weight is never
+// picked but still counts toward the total; total <= 0 -> ok=false. The ONE
+// draw per pick is what makes the (class, src, dst) spawn sequence byte-
+// identical across runs for a fixed seed [E10, v1 §3.3].
+weighted_pick :: proc(rng: ^Rng, weights: []i32) -> (u32, bool) {
+	total: u64 = 0
+	for w in weights {
+		if w > 0 { total += u64(w) }
+	}
+	if total == 0 { return 0, false }
+	draw := (u64(rng_next(rng)) * total) >> 32
+	acc: u64 = 0
+	for i in 0..<len(weights) {
+		if weights[i] <= 0 { continue }
+		acc += u64(weights[i])
