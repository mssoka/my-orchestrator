diff --git a/core/demand.odin b/core/demand.odin
new file mode 100644
index 0000000..a246a23
--- /dev/null
+++ b/core/demand.odin
@@ -0,0 +1,87 @@
+package core
+
+// demand.odin — the scripted demand director (ODN-7, v1 §3). The director owns
+// the demand timeline UPSTREAM of the flow; it takes a READ-ONLY catalog view
+// (era + tick) and emits a PressurePlan. It never receives a handle to
+// Run_State — the "[ODN-7] read-only on topology" rule is STRUCTURAL here, not
+// discipline: scripted_plan_pressure mutates nothing.
+//
+// The plan carries the active era's DemandSpecs (base, always-on demand) as a
+// read-only slice into the catalog + the indices of any set-piece ACTIVE this
+// tick. flow_step (flow.odin) consumes the plan: for each DemandSpec it
+// resolves the typed source/sink selectors against the LIVE topology, picks
+// src+dst via seeded weighted-random, and spawns `effective_volume` packets.
+//
+// Determinism (the spine lesson): the plan is a pure function of (catalog, era,
+// tick). flow_step computes it every tick INSIDE step — both live + replay run
+// the same step, so the rng-weighted dst picks are byte-identical across runs
+// for a fixed seed [E10]. No run-setup threading is needed for the director
+// (unlike flow_seed_demand spawns): the era (which the plan depends on) rides
+// the log header + the T1 hash, threaded through BOTH run_demo + replay_hashes.
+//
+// The full ODN-7 seam (a plan_pressure proc field on a Run_Config, swappable
+// for the V2 AI auditor) is [LATER] — 3.1 binds the scripted impl directly.
+// PROTO note carried: the scripted plan consumes NO rng (the dst picks that DO
+// draw rng happen downstream in flow_step, inside the deterministic stream).
+
+// Pressure_Plan — one tick's demand. `entries` is a READ-ONLY slice into the
+// catalog's era entries (the director owns no packet state); `era_sp` is the
+// read-only slice of that era's set-pieces; `active_sp` are the indices (within
+// era_sp) of set-pieces active this tick. All scratch-owned except the two
+// catalog slices (which alias the catalog — valid for the catalog's lifetime).
+Pressure_Plan :: struct {
+	tick:      u64,
+	entries:   []Demand_Entry,  // read-only alias into cat.demand.eras[era-1].entries (empty if era absent)
+	era_sp:    []Set_Piece,     // read-only alias into cat.demand.eras[era-1].set_pieces
+	active_sp: [dynamic]u16,    // indices into era_sp active this tick (scratch-owned)
+}
+
+// scripted_plan_pressure — the PROTO director: return this tick's plan for the
+// given era. Pure w.r.t. sim state (reads the catalog only). An era of 0, or an
+// era beyond the catalog, yields an empty plan (no demand) — so legacy era-0
+// runs (the slice-1 demos using flow_seed_demand) spawn nothing from the
+// director and their rng stream is untouched.
+scripted_plan_pressure :: proc(cat: ^Catalogs, era: u8, tick: u64,
+                               scratch := context.temp_allocator) -> Pressure_Plan {
+	plan: Pressure_Plan
+	plan.tick = tick
+	plan.active_sp = make([dynamic]u16, 0, 4, scratch)
+	if era == 0 || int(era) > len(cat.demand.eras) {
+		return plan // empty — no demand content for this era
+	}
+	de := &cat.demand.eras[era-1]
+	plan.entries = de.entries[:]
+	plan.era_sp = de.set_pieces[:]
+	for i in 0..<len(de.set_pieces) {
+		sp := &de.set_pieces[i]
+		if set_piece_active(sp, tick) {
+			append(&plan.active_sp, u16(i))
+		}
+	}
+	return plan
+}
+
+// set_piece_active — a set-piece is active on [start_tick, start_tick+duration).
+set_piece_active :: proc(sp: ^Set_Piece, tick: u64) -> bool {
+	return tick >= sp.start_tick && tick < sp.start_tick + sp.duration_ticks
+}
+
+// effective_volume — a DemandSpec's spawn volume this tick, multiplied by every
+// active set-piece that targets its class (the Surge = streaming x10). base is
+// the spec's catalog volume; the product is the packets to spawn this tick.
+effective_volume :: proc(plan: ^Pressure_Plan, class: u16, base: i32) -> i32 {
+	v := base
+	for idx in plan.active_sp {
+		sp := &plan.era_sp[idx]
+		if sp.class == class {
+			v *= sp.multiplier
+		}
+	}
+	return v
+}
+
+// pressure_plan_destroy — free the plan's scratch-owned active_sp slice (the
+// entries/era_sp slices ALIAS the catalog and are NOT freed here).
+pressure_plan_destroy :: proc(plan: ^Pressure_Plan) {
+	delete(plan.active_sp)
+}
