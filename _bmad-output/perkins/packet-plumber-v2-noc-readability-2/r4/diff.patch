+@(test)
+upgrade_preview_anchor_follows_the_playfield :: proc(t: ^testing.T) {
+	// Perkins r2 W2': the preview re-anchor decision is pure + pinned — rail
+	// off keeps the card below the weather report (byte-identical); rail on
+	// re-anchors into the playfield (right edge at play_w, below the top
+	// band) so the armed card never occludes the rail.
+	v := hud_test_view(1.0)
+	v.win_w = 1280
+	v.win_h = 720
+	v.play_w = v.win_w
+	px, py := upgrade_preview_anchor(&v, 1040, 230, 10, 120)
+	testing.expect(t, px == 1040 && py == 120, "rail off: the preview stays below the weather report")
+	view_set_rail(&v, true)
+	px, py = upgrade_preview_anchor(&v, 1040, 230, 10, 120)
+	testing.expect(t, px == v.play_w - 230 - 10, "rail on: the preview's top-left puts its right edge at play_w")
+	testing.expect(t, py == NOC_CONTENT_Y + hud(&v, 6), "rail on: the preview sits below the top band")
+	testing.expect(t, px + 230 + 10 <= v.play_w, "rail on: the preview card stays LEFT of the rail")
+}
+
+@(test)
+camera_fit_respects_the_rail :: proc(t: ^testing.T) {
+	// fit-to-rail (the DOCK-RIGHT ruling): camera_fit reads v.play_w — the
+	// playfield width — so the world fits LEFT of the rail while D is on, and
+	// play_w == win_w (overlay off) keeps every path byte-identical. The
+	// world is 1040×780; at 1280×720 the fit is height-bound; with the rail
+	// (play_w = 756) it becomes width-bound — the whole map stays visible.
+	v := View{}
+	v.win_w = 1280
+	v.win_h = 720
+	v.world_w = 1040
+	v.world_h = 780
+	v.play_w = v.win_w
+	off := camera_fit(&v)
+	testing.expect(t, abs(off - 720.0 / 780.0) < 0.0001, "overlay off: the fit is the full-window fit (byte-identical)")
+	view_set_rail(&v, true)
+	on := camera_fit(&v)
+	testing.expect(t, v.play_w == v.win_w - NOC_RAIL_W, "the rail shrinks the playfield by NOC_RAIL_W")
+	testing.expect(t, on < off, "rail on: the fit respects the narrower playfield")
+	testing.expect(t, on <= f32(v.play_w) / v.world_w + 0.0001, "rail on: the world fits LEFT of the rail (width-bound)")
+	view_set_rail(&v, false)
+	testing.expect(t, v.play_w == v.win_w, "rail off: play_w returns to win_w (zero drift when D is up)")
+	// W3' (Perkins r2): the resize re-apply sequence — view_compute RESETS
+	// play_w to win_w (the app then re-applies the rail via view_set_rail;
+	// both legs pinned here as the render-layer contract).
+	bal := pp.Balance{tile_px = 26, map_w_tiles = 40, map_h_tiles = 30}
+	view_set_rail(&v, true)
+	view_compute(&v, 1280, 720, &bal)
+	testing.expect(t, v.play_w == v.win_w, "view_compute resets play_w to win_w (the resize reset)")
+	view_set_rail(&v, true)
+	testing.expect(t, v.play_w == v.win_w - NOC_RAIL_W, "re-applying the rail after a resize restores the shrink")
+}
