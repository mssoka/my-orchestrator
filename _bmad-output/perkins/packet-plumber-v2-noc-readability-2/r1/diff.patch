diff --git a/app/render/noc_overlay_test.odin b/app/render/noc_overlay_test.odin
index 5aa0ac4..17e6f48 100644
--- a/app/render/noc_overlay_test.odin
+++ b/app/render/noc_overlay_test.odin
@@ -220,3 +220,64 @@ noc_level_uses_the_canon_ladder :: proc(t: ^testing.T) {
 	testing.expect(t, noc_level(1000, 70, -1) == .Amber, "red disabled: amber still trips at 100%")
 	testing.expect(t, noc_level(1000, -1, -1) == .Normal, "both disabled: nothing trips")
 }
+
+@(test)
+noc_ladder_is_the_tunable_triplet :: proc(t: ^testing.T) {
+	// the 2026-08-23 THIRD-STRIKE ruling: the readability ladder is a tunable
+	// triplet (20/18/15), every rung AT-OR-ABOVE the 14px floor (the 08-15
+	// font-resize minimum) and ordered title >= body >= label — the panel's
+	// hierarchy contract. A regression below the floor fails here (the exact
+	// failure the user called out: labels sat under the game's own minimum).
+	testing.expect(t, NOC_SIZE_TITLE == 20, "title rung = 20px (the ruling ladder)")
+	testing.expect(t, NOC_SIZE_BODY == 18, "body/counters rung = 18px (the ruling ladder)")
+	testing.expect(t, NOC_SIZE_LABEL == 15, "label rung = 15px (the ruling ladder)")
+	testing.expect(t, NOC_SIZE_LABEL >= 14, "the SMALLEST rung is at-or-above the 14px floor")
+	testing.expect(t, NOC_SIZE_TITLE >= NOC_SIZE_BODY && NOC_SIZE_BODY >= NOC_SIZE_LABEL, "title >= body >= label (the hierarchy order)")
+}
+
+@(test)
+noc_panel_width_scale_pins_504 :: proc(t: ^testing.T) {
+	// the DOCK-RIGHT ruling: the panel scales with the ladder — width +~40%
+	// (360 × NOC_PANEL_W_SCALE = 504) so the 18px tabular columns fit; the
+	// row height seats the 18px body (>= body + breathing).
+	testing.expect(t, NOC_PANEL_W == 504, "the rail width = 360 x 1.4 = 504")
+	testing.expect(t, NOC_ROW_H >= NOC_SIZE_BODY + 4, "the row height seats the 18px body with breathing")
+}
+
+@(test)
+noc_visible_rows_math_at_720 :: proc(t: ^testing.T) {
+	// the row-density ruling: fewer visible rows at bigger text is CORRECT —
+	// the wheel scrolls the rest (the ring buffer 256 is unchanged). The
+	// visible-row math is the scroll clamp's viewport: (win_h - content top -
+	// bottom inset) / row height, pinned at the 1280x720 window.
+	v := View{}
+	v.win_w = 1280
+	v.win_h = 720
+	visible := i32((v.win_h - NOC_CONTENT_Y - NOC_CONTENT_BOTTOM) / NOC_ROW_H)
+	testing.expect(t, visible == 24, "24 visible rows at 1280x720 (594px / 24px rows)")
+	testing.expect(t, NOC_CONTENT_Y >= 110, "the content starts below the top band (health 74 + forecast ~104)")
+}
+
+@(test)
+camera_fit_respects_the_rail :: proc(t: ^testing.T) {
+	// fit-to-rail (the DOCK-RIGHT ruling): camera_fit reads v.play_w — the
+	// playfield width — so the world fits LEFT of the rail while D is on, and
+	// play_w == win_w (overlay off) keeps every path byte-identical. The
+	// world is 1040×780; at 1280×720 the fit is height-bound; with the rail
+	// (play_w = 756) it becomes width-bound — the whole map stays visible.
+	v := View{}
+	v.win_w = 1280
+	v.win_h = 720
+	v.world_w = 1040
+	v.world_h = 780
+	v.play_w = v.win_w
+	off := camera_fit(&v)
+	testing.expect(t, abs(off - 720.0 / 780.0) < 0.0001, "overlay off: the fit is the full-window fit (byte-identical)")
+	view_set_rail(&v, true)
+	on := camera_fit(&v)
+	testing.expect(t, v.play_w == v.win_w - NOC_RAIL_W, "the rail shrinks the playfield by NOC_RAIL_W")
+	testing.expect(t, on < off, "rail on: the fit respects the narrower playfield")
