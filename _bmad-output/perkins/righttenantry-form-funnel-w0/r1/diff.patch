+/// Series restart after a COMPLETED series: an enquirer who had both stages,
+/// then re-enquired and got a fresh stage 1, becomes stage-2 eligible again
+/// once the new stamp ages — the old stage-2 belongs to the previous cycle.
+pub fn followup_rearms_after_series_restart_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  // Completed series from a week ago.
+  seed_inbound_reminded_days_ago(db, vacancy_id, "veteran@example.com", 7)
+  let assert Ok(vacancy_uuid) = uuid.from_string(vacancy_id)
+  let assert Ok(_) =
