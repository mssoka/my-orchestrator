+//// Unit tests for the awaiting-section reminder button label matrix. The
+//// two-stage reminder series makes the button's copy load-bearing: the
+//// landlord must see which stages a click will send (stage-1 reminders,
+//// stage-2 follow-ups, or both) before they click it.
+
+import components/awaiting_section
+import gleeunit/should
+
+pub fn label_pending_test() {
+  awaiting_section.reminder_button_label(
+    pending: True,
+    remindable: 3,
+    followup: 2,
+  )
+  |> should.equal("Sending…")
+}
+
+pub fn label_nobody_left_test() {
+  awaiting_section.reminder_button_label(
+    pending: False,
+    remindable: 0,
+    followup: 0,
+  )
+  |> should.equal("Everyone reminded")
+}
+
+pub fn label_stage1_only_test() {
+  awaiting_section.reminder_button_label(
+    pending: False,
+    remindable: 1,
+    followup: 0,
+  )
+  |> should.equal("Send reminder to 1")
+}
+
+pub fn label_stage1_several_test() {
+  awaiting_section.reminder_button_label(
+    pending: False,
+    remindable: 4,
+    followup: 0,
+  )
+  |> should.equal("Send reminder to 4")
+}
+
+pub fn label_followup_only_test() {
+  awaiting_section.reminder_button_label(
+    pending: False,
+    remindable: 0,
+    followup: 2,
+  )
+  |> should.equal("Send follow-up to 2")
+}
+
+pub fn label_mixed_pool_names_both_stages_test() {
+  awaiting_section.reminder_button_label(
+    pending: False,
+    remindable: 3,
+    followup: 5,
+  )
+  |> should.equal("Send 3 reminders + 5 follow-ups")
+}
