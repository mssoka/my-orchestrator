+
+// -- Two-stage reminder series -------------------------------------------------
+//
+// Stage 2 (the deadline follow-up) goes only to enquirers whose stage-1 stamp
+// is at least 2 days old, who haven't had stage 2, and who still haven't
+// applied. The 2-day gate is mirrored in count_awaiting_for_vacancy
+// (followup_count) — these tests pin both sides of the coupling.
+
+/// Seed an enquirer whose stage-1 reminder went out `days` ago.
+fn seed_inbound_reminded_days_ago(
+  db: pog.Connection,
+  vacancy_id: String,
+  sender_email: String,
+  days: Int,
+) -> Nil {
+  let assert Ok(_) =
+    pog.query(
+      "INSERT INTO inbound_email (vacancy_id, sender_email, sender_name, auto_reply_sent, reminder_sent_at)
+       VALUES ($1::uuid, $2, 'Test Enquirer', true, now() - make_interval(days => $3))",
+    )
+    |> pog.parameter(pog.text(vacancy_id))
+    |> pog.parameter(pog.text(sender_email))
+    |> pog.parameter(pog.int(days))
+    |> pog.execute(db)
+  Nil
+}
+
+pub fn followup_mark_respects_the_two_day_gate_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  seed_inbound_reminded_days_ago(db, vacancy_id, "due@example.com", 3)
+  seed_inbound_reminded_days_ago(db, vacancy_id, "too-soon@example.com", 1)
+  seed_inbound(db, vacancy_id, "never-reminded@example.com")
+
+  let assert Ok(vacancy_uuid) = uuid.from_string(vacancy_id)
+
+  // Counts BEFORE any stamp: the 3-day-old enquirer is follow-up eligible,
+  // the never-reminded one is in the stage-1 pool, the 1-day-old is in
+  // neither (stage-1 stamp too fresh).
+  let assert Ok(pog.Returned(_, [count_row])) =
+    vacancy_sql.count_awaiting_for_vacancy(db, vacancy_uuid)
+  count_row.awaiting_count |> should.equal(3)
+  count_row.remindable_count |> should.equal(1)
+  count_row.followup_count |> should.equal(1)
+
+  // The mark query agrees with the count query (gate coupling)…
+  let assert Ok(pog.Returned(_, marked)) =
+    inbound_sql.mark_followup_reminders_for_vacancy(db, vacancy_uuid)
+  list.length(marked) |> should.equal(1)
+
+  // …and stamping consumes eligibility: nobody is due any more.
+  let assert Ok(pog.Returned(_, [after])) =
+    vacancy_sql.count_awaiting_for_vacancy(db, vacancy_uuid)
+  after.followup_count |> should.equal(0)
+}
