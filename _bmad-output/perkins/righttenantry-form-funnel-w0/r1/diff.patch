+//// Tests for vacancy_api response decoders — the rollback/cached-bundle
+//// windows they claim to tolerate.
+
+import api/vacancy_api
+import gleam/json
+import gleeunit/should
+
+pub fn remind_response_decodes_both_stage_counts_test() {
+  "{\"data\":{\"reminded\":3,\"followup\":5}}"
+  |> json.parse(vacancy_api.remind_response_decoder())
+  |> should.be_ok
+  |> should.equal(#(3, 5))
+}
+
+/// A prior-revision server has no stage-2 key — the landlord's remind click
+/// must still decode (and simply label zero follow-ups) rather than surface
+/// an error toast. This is the exact rollback window the decoder exists for.
+pub fn remind_response_defaults_missing_followup_test() {
+  "{\"data\":{\"reminded\":3}}"
+  |> json.parse(vacancy_api.remind_response_decoder())
+  |> should.be_ok
+  |> should.equal(#(3, 0))
+}
