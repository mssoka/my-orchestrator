+  <> "<li style=\""
+  <> item_style
+  <> "\">About 15 minutes, once you have the documents.</li>"
+  <> "</ul>"
+  <> "<p style=\"font-family: "
+  <> brand_font
+  <> "; font-size: 14px; color: #64748B; line-height: 1.6; margin: 0 0 16px 0;\">"
