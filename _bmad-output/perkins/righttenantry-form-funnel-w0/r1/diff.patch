+  // Stage-2 stamp lands on one of them (set directly — the mark query's
+  // one-shot behaviour is pinned by its own tests).
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE inbound_email SET second_reminder_sent_at = now() WHERE lower(sender_email) = 'due@example.com'",
+    )
+    |> pog.execute(db)
+
+  let assert Ok(pog.Returned(_, rows)) =
+    vacancy_sql.list_awaiting_for_vacancy(db, vacancy_uuid)
+  let due = list.filter(rows, fn(r) { r.followed_up })
+  let stage1_only = list.filter(rows, fn(r) { r.reminded && !r.followed_up })
+  list.length(due) |> should.equal(1)
+  list.length(stage1_only) |> should.equal(1)
