+/// The "Before you start" preparation block — the on-form half of the
+/// honest-expectation copy pack (2026-07 completion session, F2). It leads
+/// with the two third-party reference letters UP FRONT so the document wall
+/// is never a mid-form surprise, sets the real time expectation (~15 minutes
+/// with documents in hand), and states the one-visit rule.
+///
+/// F3-SEAM (save-resume follow-up job): when drafts ship, replace the
+/// "one visit" line with the save-and-continue promise — do NOT add that
+/// promise before F3 is live (it would be the same class of lie this block
+/// exists to remove).
+fn view_prep_block() -> element.Element(a) {
+  html.aside(
+    [
+      attribute.class("prep-block"),
+      attribute("data-testid", "apply-prep-block"),
+    ],
+    [
+      html.h2([attribute.class("prep-heading")], [html.text("Before you start")]),
+      html.p([attribute.class("prep-intro")], [
+        html.text("Have these ready — the form asks for all of them:"),
+      ]),
+      html.ul([attribute.class("prep-list")], [
+        html.li([], [
+          html.text(
+            "A written reference from your current or previous landlord (a photo, scan or PDF is fine). First time renting? A character reference from someone who knows you works instead.",
+          ),
+        ]),
+        html.li([], [
+          html.text(
+            "A written reference from your employer, if you\u{2019}re employed or self-employed.",
+          ),
+        ]),
+        html.li([], [
+          html.text("A name, phone number and email address for each referee."),
+        ]),
+        html.li([], [
+          html.text("About 15 minutes, once you have the documents."),
+        ]),
+      ]),
+      html.p([attribute.class("prep-note")], [
+        html.text(
+          "Complete applications are reviewed first. The form is completed in one visit — it doesn\u{2019}t save your progress — so gather everything before you begin.",
+        ),
+      ]),
+    ],
+  )
+}
