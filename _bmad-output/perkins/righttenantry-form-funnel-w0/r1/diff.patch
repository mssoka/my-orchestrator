+-- Track the second ("follow-up") application reminder a landlord may send to
+-- a Daft enquirer who was invited, already had the first reminder, and still
+-- hasn't finished the form. NULL means the follow-up hasn't been sent. The
+-- vacancy-detail "Awaiting" funnel offers one stage-1 and one stage-2 reminder
+-- per person; the background sender clears this back to NULL if the stage-2
+-- send fails so the enquirer stays follow-up-able (self-healing), matching the
+-- stage-1 column's behaviour.
+--
+-- No separate retention wiring: this column rides the existing inbound_email
+-- sweep (delete_expired_inbound_emails, 30 days after the vacancy closes).
+ALTER TABLE inbound_email
+  ADD COLUMN IF NOT EXISTS second_reminder_sent_at TIMESTAMPTZ;
diff --git a/supabase/migrations/20260731213000_add_inbound_email_sender_state_view.sql b/supabase/migrations/20260731213000_add_inbound_email_sender_state_view.sql
