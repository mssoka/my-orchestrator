diff --git a/scripts/js-tests/apply_analytics.test.js b/scripts/js-tests/apply_analytics.test.js
new file mode 100644
index 00000000..71a8a87b
--- /dev/null
+++ b/scripts/js-tests/apply_analytics.test.js
@@ -0,0 +1,376 @@
+// Unit tests for server/priv/static/apply_analytics.js — run with
+// `node --test scripts/js-tests/` (wired into `make test` as test-js).
+//
+// Covers the W0 acceptance surface: consent-gated queue semantics, the
+// submit/error/reload page-outcome disambiguation, and the section
+// completion rules (visible-required, radio groups, hidden conditionals).
+
+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+
+const analytics = require("../../server/priv/static/apply_analytics.js");
+
+// ---------- Stubs ----------
+
+function fakePosthog({ loaded = true, optedIn = false } = {}) {
+  return {
+    __loaded: loaded,
+    _optedIn: optedIn,
+    captured: [],
+    capture(name, props) {
+      this.captured.push([name, props]);
+    },
+    has_opted_in_capturing() {
+      return this._optedIn;
+    },
+  };
+}
+
+function consentEmitter() {
+  const cbs = [];
+  return {
+    onConsentChange: (cb) => cbs.push(cb),
+    fire(granted) {
+      cbs.forEach((cb) => cb(granted));
+    },
+  };
+}
+
+// ---------- Consent-gated capture queue ----------
+
+test("queues events while the SDK is not ready, flushes on consent grant", () => {
+  const ph = fakePosthog({ loaded: true, optedIn: false });
+  const consent = consentEmitter();
+  const t = analytics.createCapture({
+    posthog: () => ph,
+    onConsentChange: consent.onConsentChange,
+  });
+  t.capture("application_confirmation_viewed", { vacancy_short_code: "abc" });
+  assert.equal(ph.captured.length, 0, "nothing sent pre-consent");
+  ph._optedIn = true;
+  consent.fire(true);
+  assert.equal(ph.captured.length, 1);
+  assert.equal(ph.captured[0][0], "application_confirmation_viewed");
+  assert.deepEqual(ph.captured[0][1], { vacancy_short_code: "abc" });
+});
+
+test("drops the queue on consent rejection — pre-consent events never send", () => {
+  const ph = fakePosthog({ loaded: true, optedIn: false });
+  const consent = consentEmitter();
+  const t = analytics.createCapture({
+    posthog: () => ph,
+    onConsentChange: consent.onConsentChange,
+  });
+  t.capture("application_form_section_entered", { section_id: "about_you" });
+  consent.fire(false);
+  ph._optedIn = true; // even if the SDK later becomes ready
+  t.flush();
+  assert.equal(ph.captured.length, 0);
+});
+
+test("captures immediately when the SDK is loaded and opted in", () => {
+  const ph = fakePosthog({ loaded: true, optedIn: true });
+  const t = analytics.createCapture({
+    posthog: () => ph,
+    onConsentChange: () => {},
+  });
+  t.capture("application_duplicate_viewed", {});
+  assert.equal(ph.captured.length, 1);
+});
+
+test("stub SDK (pre-array.js: no has_opted_in_capturing) is never ready", () => {
+  const stub = { __loaded: false, capture() { this.called = true; } };
+  const t = analytics.createCapture({
+    posthog: () => stub,
+    onConsentChange: () => {},
+  });
+  t.capture("x", {});
+  assert.equal(stub.called, undefined, "stub capture must not be called");
+});
+
+test("queue is capped — oldest event dropped first", () => {
+  const ph = fakePosthog({ loaded: true, optedIn: false });
+  const t = analytics.createCapture({
+    posthog: () => ph,
+    onConsentChange: () => {},
+  });
+  for (let i = 0; i < 150; i++) t.capture("e" + i, { i });
+  assert.equal(t._queue.length, 100);
+  assert.equal(t._queue[0][0], "e50");
+});
+
+// ---------- Page-outcome disambiguation ----------
+
+test("outcomeEvent disambiguates submit vs error vs reload vs spam", () => {
+  const E = analytics.EVENTS;
+  assert.equal(analytics.outcomeEvent("confirmation"), E.confirmation);
+  assert.equal(analytics.outcomeEvent("duplicate"), E.duplicate);
+  assert.equal(analytics.outcomeEvent("form-errors"), E.submitFailed);
+  assert.equal(
+    analytics.outcomeEvent("form"),
+    null,
+    "pristine form tracks sections, not a page outcome",
+  );
+  assert.equal(
+    analytics.outcomeEvent("spam-confirmation"),
+    null,
+    "spam fake-confirmation must never fire the confirmation event",
+  );
+  assert.equal(analytics.outcomeEvent(""), null);
+  assert.equal(analytics.outcomeEvent(null), null);
+});
+
+// ---------- Minimal DOM for section rules ----------
+
+let idSeq = 0;
+function el(tag, attrs = {}, children = []) {
+  const node = {
+    _id: ++idSeq,
+    tag,
+    children: [],
+    parentElement: null,
+    hidden: false,
+    disabled: false,
+    ...attrs,
+  };
+  children.forEach((c) => {
+    c.parentElement = node;
+    node.children.push(c);
+  });
+  node.querySelectorAll = (selector) => {
+    const out = [];
+    const walk = (n) => {
+      n.children.forEach((c) => {
+        if (matches(c, selector)) out.push(c);
+        walk(c);
+      });
+    };
+    walk(node);
+    return out;
+  };
+  node.contains = (target) => {
+    let n = target;
+    while (n) {
+      if (n === node) return true;
+      n = n.parentElement;
+    }
+    return false;
+  };
+  return node;
+}
+
+function matches(node, selector) {
+  if (selector === "[required]") return !!node.required;
+  const m = selector.match(/^input\[type="radio"\]\[name="(.*)"\]$/);
+  if (m) return node.tag === "input" && node.type === "radio" && node.name === m[1];
+  return false;
+}
+
+function section(children) {
+  return el("fieldset", {}, children);
+}
+
+function textInput(value, extra = {}) {
+  return el("input", { type: "text", value, required: true, ...extra });
+}
+
+// ---------- Section completion rules ----------
+
+test("section completes when every visible required control is filled", () => {
+  const s = section([textInput("Jane"), textInput("Doe")]);
+  assert.equal(analytics.hasVisibleRequired(s), true);
+  assert.equal(analytics.sectionComplete(s), true);
+});
+
+test("section is incomplete while any visible required control is empty", () => {
+  const s = section([textInput("Jane"), textInput("")]);
+  assert.equal(analytics.sectionComplete(s), false);
+});
+
+test("whitespace-only values do not count as filled", () => {
+  const s = section([textInput("   ")]);
+  assert.equal(analytics.sectionComplete(s), false);
+});
+
+test("controls hidden by a data-condition wrapper are excluded", () => {
+  const hiddenWrap = el("div", { hidden: true }, [textInput("")]);
+  const s = section([textInput("Jane"), hiddenWrap]);
+  assert.equal(analytics.sectionComplete(s), true);
+});
+
+test("a hidden section's own controls do not count", () => {
+  const s = section([textInput("")]);
+  s.hidden = true;
+  assert.equal(analytics.hasVisibleRequired(s), false);
+});
+
+test("disabled controls do not block completion", () => {
+  const s = section([textInput("", { disabled: true })]);
+  assert.equal(analytics.sectionComplete(s), false, "no visible required → not auto-complete");
+  assert.equal(analytics.hasVisibleRequired(s), false);
+});
+
+test("radio groups count once per name and need a single checked member", () => {
+  const group = [
+    el("input", { type: "radio", name: "has_pets", value: "yes", required: true, checked: false }),
+    el("input", { type: "radio", name: "has_pets", value: "no", required: true, checked: false }),
+  ];
+  const s = section(group);
+  assert.equal(analytics.sectionComplete(s), false);
+  group[1].checked = true;
+  assert.equal(analytics.sectionComplete(s), true);
+});
+
+test("checkboxes must be checked", () => {
+  const box = el("input", { type: "checkbox", required: true, checked: false });
+  const s = section([box]);
+  assert.equal(analytics.sectionComplete(s), false);
+  box.checked = true;
+  assert.equal(analytics.sectionComplete(s), true);
+});
+
+test("file inputs accept a selected file", () => {
+  const file = el("input", { type: "file", required: true, value: "", files: [] });
+  const s = section([file]);
+  assert.equal(analytics.sectionComplete(s), false);
+  file.files = [{ name: "ref.pdf" }];
+  assert.equal(analytics.sectionComplete(s), true);
+});
+
+test("sections with no required fields are not auto-completable", () => {
+  const s = section([el("textarea", { value: "hello" })]);
+  assert.equal(analytics.hasVisibleRequired(s), false);
+  assert.equal(analytics.sectionComplete(s), false);
+});
+
+// ---------- Abandon candidate selection (deferred semantics) ----------
+
+test("pickDeepestIncomplete returns the deepest entered-incomplete section", () => {
+  const state = [
+    { id: "about_you", entered: true, completed: true },
+    { id: "references", entered: true, completed: false },
+    { id: "documents", entered: true, completed: false },
+    { id: "review_consent", entered: false, completed: false },
+  ];
+  assert.equal(analytics.pickDeepestIncomplete(state).id, "documents");
+});
+
+test("pickDeepestIncomplete is null when everything entered is completed", () => {
+  const state = [
+    { id: "about_you", entered: true, completed: true },
+    { id: "documents", entered: false, completed: false },
+  ];
+  assert.equal(analytics.pickDeepestIncomplete(state), null);
+});
+
+// ---------- Abandon flow state machine ----------
+
+function flowFixture(state) {
+  const captured = [];
+  const flow = analytics.createAbandonFlow({
+    state,
+    sectionProps: (s) => ({ section_id: s.id }),
+    now: () => 1000,
+    capture: (props) => captured.push(props),
+  });
+  return { flow, captured };
+}
+
+test("hidden records, return clears — no event for doc-gathering app-switchers", () => {
+  const state = [{ id: "documents", entered: true, completed: false }];
+  const { flow, captured } = flowFixture(state);
+  flow.onHidden();
+  flow.onVisible(); // applicant returns with their letter
+  flow.onPagehide({});
+  assert.equal(captured.length, 0);
+});
+
+test("hidden then true unload fires one abandoned event", () => {
+  const state = [{ id: "documents", entered: true, completed: false }];
+  const { flow, captured } = flowFixture(state);
+  flow.onHidden();
+  flow.onPagehide({});
+  assert.equal(captured.length, 1);
+  assert.equal(captured[0].section_id, "documents");
+  assert.equal(captured[0].sections_completed, 0);
+  assert.equal(captured[0].ms_on_page, 0);
+});
+
+test("bfcache park (persisted pagehide) is not abandonment", () => {
+  const state = [{ id: "documents", entered: true, completed: false }];
+  const { flow, captured } = flowFixture(state);
+  flow.onHidden();
+  flow.onPagehide({ persisted: true });
+  assert.equal(captured.length, 0);
+});
+
+test("section completed while backgrounded suppresses the pending record", () => {
+  const state = [{ id: "documents", entered: true, completed: false }];
+  const { flow, captured } = flowFixture(state);
+  flow.onHidden();
+  state[0].completed = true; // debounced recheck ran while hidden
+  flow.onPagehide({});
+  assert.equal(captured.length, 0);
+});
+
+test("submit latch suppresses abandonment; bfcache restore re-arms it", () => {
+  const state = [{ id: "documents", entered: true, completed: false }];
+  const { flow, captured } = flowFixture(state);
+  flow.setSubmitted(true);
+  flow.onHidden();
+  flow.onPagehide({});
+  assert.equal(captured.length, 0);
+  flow.setSubmitted(false); // pageshow persisted
+  flow.onHidden();
+  flow.onPagehide({});
+  assert.equal(captured.length, 1);
+});
+
+// ---------- Flush resilience ----------
+
+test("a throwing capture re-queues its event and preserves the rest", () => {
+  let calls = 0;
+  const ph = {
+    __loaded: true,
+    _optedIn: true,
+    captured: [],
+    capture(name) {
+      calls++;
+      if (name === "bad") throw new Error("boom");
+      this.captured.push(name);
+    },
+    has_opted_in_capturing() {
+      return this._optedIn;
+    },
+  };
+  const t = analytics.createCapture({
+    posthog: () => ph,
+    onConsentChange: () => {},
+  });
+  t.capture("ok1", {});
+  t.capture("bad", {});
+  t.capture("ok2", {});
+  t.flush();
+  assert.deepEqual(ph.captured, ["ok1", "ok2"]);
+  assert.equal(t._queue.length, 1, "failed event re-queued for next flush");
+  assert.equal(t._queue[0][0], "bad");
+});
+
+// ---------- Radio visibility edge ----------
+
+test("a checked radio inside a hidden wrapper does not satisfy the group", () => {
+  const hiddenWrap = el("div", { hidden: true }, [
+    el("input", { type: "radio", name: "g", value: "yes", required: true, checked: true }),
+  ]);
+  const visibleUnchecked = el("input", {
+    type: "radio",
+    name: "g",
+    value: "no",
+    required: true,
+    checked: false,
+  });
+  const s = section([hiddenWrap, visibleUnchecked]);
+  assert.equal(analytics.sectionComplete(s), false);
+  visibleUnchecked.checked = true;
+  assert.equal(analytics.sectionComplete(s), true);
+});
diff --git a/server/priv/static/apply_analytics.js b/server/priv/static/apply_analytics.js
new file mode 100644
index 00000000..475f1369
--- /dev/null
+++ b/server/priv/static/apply_analytics.js
@@ -0,0 +1,490 @@
+// apply_analytics.js — apply-funnel instrumentation for the public /apply/*
+// pages (W0 of the 2026-07 application-completion problem-solving session).
+//
+// What fires, driven by the server-rendered `data-apply-page` body marker —
+// the POST-response-without-redirect pattern makes raw pageview counts
+// ambiguous between a fresh visit, a validation-error re-render and a
+// successful submit; the marker is not:
+//
+//   marker "confirmation" → application_confirmation_viewed (genuine success
+//                           ONLY — the spam fake-confirmation page is marked
+//                           "spam-confirmation" and loads no analytics)
