+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  seed_inbound_reminded_days_ago(db, vacancy_id, "due@example.com", 4)
+  // Force the vacancy past close (the lifecycle sweep hasn't run yet).
+  let assert Ok(_) =
