+/// Format a closing date for applicant-facing copy: "13 August 2026".
+/// Accepts either the `to_char(..., 'YYYY-MM-DD')` date the invite/reminder
+/// queries hand over, or a raw `closes_at` timestamptz cast to text (e.g.
+/// "2026-08-13 17:00:00+00") — anything shorter than 10 chars or
+/// unrecognised falls back to the raw string: a slightly ugly date in an
+/// email beats a crashed send.
+pub fn format_close_date(closes_at: String) -> String {
+  case string.length(closes_at) >= 10 {
+    False -> closes_at
+    True ->
+      case string.split(string.slice(closes_at, 0, 10), "-") {
+        [year, month, day] ->
+          case int.parse(year), int.parse(month), int.parse(day) {
+            Ok(y), Ok(m), Ok(d) ->
+              case month_name(m) {
+                "" -> closes_at
+                name ->
+                  int.to_string(d) <> " " <> name <> " " <> int.to_string(y)
+              }
+            _, _, _ -> closes_at
+          }
+        _ -> closes_at
+      }
+  }
+}
+
+fn month_name(month: Int) -> String {
+  case month {
+    1 -> "January"
+    2 -> "February"
+    3 -> "March"
+    4 -> "April"
+    5 -> "May"
+    6 -> "June"
+    7 -> "July"
+    8 -> "August"
+    9 -> "September"
+    10 -> "October"
+    11 -> "November"
+    12 -> "December"
+    _ -> ""
+  }
+}
