+
+/// Handler wiring, zero-recipient case: both pools empty → no sends are
+/// spawned (safe without a Resend key) and the response carries per-stage
+/// counts in the shape the SPA decoder expects.
+pub fn remind_response_carries_per_stage_counts_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+
+  let req =
+    simulate.request(
+      http.Post,
+      "/api/v1/vacancies/" <> vacancy_id <> "/remind-applicants",
+    )
+  let resp =
+    inbound_handler.handle_remind_applicants(
+      req,
+      test_server_config(db),
+      landlord_id,
+      vacancy_id,
+    )
+  resp.status |> should.equal(200)
+  let body = simulate.read_body(resp)
+  body |> string.contains("\"reminded\":0") |> should.be_true
+  body |> string.contains("\"followup\":0") |> should.be_true
+}
+
+/// One email, two rows: reminded 5 days ago, then re-enquired yesterday (fresh
+/// un-reminded row). The re-enquiry restarts the series — stage 2 must NOT
+/// fire for them in the same click that sends their new stage 1.
+pub fn followup_skips_re_enquired_enquirer_until_fresh_stage1_ages_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  seed_inbound_reminded_days_ago(db, vacancy_id, "returning@example.com", 5)
+  seed_inbound(db, vacancy_id, "returning@example.com")
+
+  let assert Ok(vacancy_uuid) = uuid.from_string(vacancy_id)
+
+  // Before any click: follow-up NOT due (fresh un-reminded row exists)…
+  let assert Ok(pog.Returned(_, [count_row])) =
+    vacancy_sql.count_awaiting_for_vacancy(db, vacancy_uuid)
+  count_row.remindable_count |> should.equal(1)
+  count_row.followup_count |> should.equal(0)
+
+  // …stage 1 goes out (one-shot re-arms on the new enquiry)…
+  let assert Ok(pog.Returned(_, stage1)) =
+    inbound_sql.mark_reminders_for_vacancy(db, vacancy_uuid)
+  list.length(stage1) |> should.equal(1)
+
+  // …and stage 2 still must not fire — the fresh stage-1 just went out.
+  let assert Ok(pog.Returned(_, stage2)) =
+    inbound_sql.mark_followup_reminders_for_vacancy(db, vacancy_uuid)
+  list.length(stage2) |> should.equal(0)
+}
+
+/// Stage-2 stamps EVERY row of an eligible email, so the DISTINCT-ON-latest
+/// awaiting list always shows the flag even when the eligibility came from an
+/// older enquiry.
+pub fn followup_stamp_lands_on_the_displayed_latest_row_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  // Two rows for one email, both reminded long enough ago.
+  seed_inbound_reminded_days_ago(db, vacancy_id, "dup@example.com", 6)
+  seed_inbound_reminded_days_ago(db, vacancy_id, "dup@example.com", 4)
+
+  let assert Ok(vacancy_uuid) = uuid.from_string(vacancy_id)
+  let assert Ok(pog.Returned(_, marked)) =
+    inbound_sql.mark_followup_reminders_for_vacancy(db, vacancy_uuid)
