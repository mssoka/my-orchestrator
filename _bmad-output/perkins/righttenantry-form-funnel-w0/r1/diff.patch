index 00000000..32202235
--- /dev/null
+++ b/supabase/migrations/20260731213000_add_inbound_email_sender_state_view.sql
@@ -0,0 +1,36 @@
+-- Per-sender reminder-series state for the awaiting funnel: one row per
+-- (vacancy, case-folded sender email) aggregating that enquirer's reminder
+-- stamps across ALL their inbound rows (a re-enquiry must restart the
+-- series, not fork it). This view is the SINGLE home of the stage-2
+-- eligibility rule's inputs — before it existed, the gate was mirrored
+-- (and drift-prone) across mark/count/list SQL. Non-completers only:
+-- enquirers who applied drop out of every funnel surface, so the exclusion
+-- lives here once.
+--
+-- Eligibility semantics shared by all consumers:
+--   stage-1 due  : has_unreminded (any row never stamped)
+--   stage-2 due  : NOT has_unreminded
+--                  AND last_stage1_at older than the cadence gate (2 days)
+--                  AND (last_stage2_at IS NULL OR last_stage2_at <= last_stage1_at)
+--   The last clause is the series-restart rule: a stage-2 stamp older than
+--   the latest stage-1 belongs to a PREVIOUS enquiry cycle and must not
+--   block a fresh follow-up; a stage-2 newer than the latest stage-1 is the
+--   consumed one-shot.
+--
+-- No RLS surface change: the server role reads base tables directly today;
+-- the view is used by the same role with the same posture.
+CREATE OR REPLACE VIEW inbound_email_sender_state AS
+SELECT
+  vacancy_id,
+  lower(sender_email) AS sender_email_lc,
+  bool_or(reminder_sent_at IS NULL) AS has_unreminded,
+  max(reminder_sent_at) AS last_stage1_at,
+  max(second_reminder_sent_at) AS last_stage2_at
+FROM inbound_email
+WHERE sender_email IS NOT NULL
+  AND sender_email <> ''
+  AND lower(sender_email) NOT IN (
+    SELECT lower(email) FROM application a
+    WHERE a.vacancy_id = inbound_email.vacancy_id
+  )
+GROUP BY vacancy_id, lower(sender_email);
