+  // Guard the simulation itself: the field must have been there to remove.
+  { legacy != encoded } |> should.be_true
+  let assert Ok(decoded) = json.parse(legacy, vacancy.detail_decoder())
+  decoded.followup_count |> should.equal(0)
+}
+
+pub fn awaiting_decoder_defaults_missing_followed_up_test() {
+  let applicant =
+    vacancy.AwaitingApplicant(
+      email: "enquirer@example.com",
+      name: option.Some("Pat"),
+      invited_at: "2026-07-21T10:00:00Z",
+      reminded: True,
+      followed_up: True,
+      followup_due: True,
+    )
+  // Roundtrip carries the new flag…
+  applicant
+  |> vacancy.encode_awaiting
+  |> json.to_string
+  |> json.parse(vacancy.awaiting_decoder())
+  |> should.be_ok
+  |> should.equal(applicant)
+  // …and a prior-revision payload (no followed_up) decodes to False.
+  "{\"email\":\"enquirer@example.com\",\"name\":\"Pat\",\"invited_at\":\"2026-07-21T10:00:00Z\",\"reminded\":true}"
+  |> json.parse(vacancy.awaiting_decoder())
+  |> should.be_ok
+  |> fn(a) { a.followed_up }
+  |> should.equal(False)
+}
