@@ -0,0 +1,29 @@
+// PP_HashTests.cpp — FNV-1a-64 conformance (ODN-11), UE automation side.
+#include "Misc/AutomationTest.h"
+
+#include "PacketPlumberCore/PP_Hash.h"
+
+#if WITH_DEV_AUTOMATION_TESTS
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPHashFnv1a64, "PacketPlumber.Determinism.Fnv1a64Conformance",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPHashFnv1a64::RunTest(const FString &Parameters)
+{
+	TestEqual(TEXT("fnv1a64(empty) must equal the offset basis"), PP::Fnv1a64(nullptr, 0), PP::FNV64_OFFSET);
+
+	// Published FNV-1a-64 test vector (the FNV reference): "a" -> 0xaf63dc4c8601ec8c.
+	const uint8_t A[1] = {'a'};
+	TestEqual(TEXT("fnv1a64(\"a\") must equal the published vector"), PP::Fnv1a64(A, 1),
+			  static_cast<uint64_t>(0xaf63dc4c8601ec8cull));
+
+	const uint8_t PP[2] = {'p', 'p'};
+	TestTrue(TEXT("fnv1a64(pp) must be nonzero"), PP::Fnv1a64(PP, 2) != 0);
+
+	const uint8_t AB[2] = {'a', 'b'};
+	const uint8_t BA[2] = {'b', 'a'};
+	TestTrue(TEXT("fnv1a64 must be order-sensitive"), PP::Fnv1a64(AB, 2) != PP::Fnv1a64(BA, 2));
+	return true;
+}
+
+#endif // WITH_DEV_AUTOMATION_TESTS
diff --git a/Source/PacketPlumberCoreTests/PP_RngTests.cpp b/Source/PacketPlumberCoreTests/PP_RngTests.cpp
new file mode 100644
