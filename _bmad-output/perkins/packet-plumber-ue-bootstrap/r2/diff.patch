@@ -0,0 +1,126 @@
+#!/usr/bin/env bash
+# scripts/local-ci.sh — the Packet-Plumber-UE local CI loop.
+#
+#   scripts/local-ci.sh          # full suite (engine-gated gates SKIP if UE is absent)
+#   scripts/local-ci.sh --fast   # gates 1-3 only (the pre-engine loop: format, spine, static)
+#   scripts/local-ci.sh --bless  # re-record the golden probe from the engine's PPProbe
+#
+# The gate list mirrors what the future GH CI workflow will run — the
+# workflow becomes the spec; keep this file's order + names in sync with it.
+#
+# TIMING EXPECTATIONS (UE builds are heavy — plan accordingly):
+#   gate 1  format check            seconds (no engine needed)
+#   gate 2  spine-check (standalone) <1 s  (no engine needed — compiles the
+#           SAME headers the engine module uses; the pre-engine determinism gate)
+#   gate 3  project static checks   seconds (no engine needed)
+#   gate 4  UBT build (Editor Dev)  FIRST build 30-60+ min (module compile +
+#           shader/toolchain warmup); incremental 5-15 min; no-op rebuild ~1 min
+#   gate 5  headless automation     ~2-5 min after build (editor boot dominates)
+#   gate 6  PPProbe commandlet      ~1-3 min after build (also writes
+#           docs/goldens/.engine-probe.json via --json-out for gate 7)
+#   gate 7  golden compare          seconds (compares PPProbe vs standalone vs
+#           docs/goldens/)
+#
+# Every gate appends its wall time to docs/timings.md (one line per run).
+set -uo pipefail
+
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+cd "$ROOT"
+
+FAST=0
+BLESS=0
+case "${1:-}" in
+  --fast) FAST=1 ;;
+  --bless) BLESS=1 ;;
+  -h|--help)
+    sed -n '2,14p' "$0"
+    exit 0
+    ;;
+  "") ;;
+  *) echo "unknown option: $1" >&2; exit 2 ;;
+esac
+
+# ------------------------------------------------------------ engine discovery
+# Shared find_engine (UE_EDITOR_PATH -> UE_ROOT -> standard Epic locations)
+# lives in scripts/lib/engine.sh — the single source of truth for all scripts.
+source "$ROOT/scripts/lib/engine.sh"
+
+ENGINE_CMD="$(find_engine || true)"
+[ -n "$ENGINE_CMD" ] && ENGINE_PRESENT=1 || ENGINE_PRESENT=0
+
+# ------------------------------------------------------------------ the gates
+# label|command — engine-gated commands self-skip when $ENGINE_PRESENT=0 by
+# naming that in the label; the runner treats a leading "ENGINE:" label
+# prefix as gated (SKIP with reason when the engine is absent — never a
+# silent PASS, never a false FAIL). The format gate is NOT engine-gated:
+# format-check.sh self-skips only when no clang-format >= 14 exists.
+GATES=(
+  "Format (clang-format --dry-run on Source/)|scripts/format-check.sh"
+  "Spine standalone check (ODN-9/11 conformance, no engine)|mkdir -p tests/build && g++ -std=c++17 -O2 -Wall -Wextra -I Source/PacketPlumberCore/Public tests/spine_check.cpp -o tests/build/spine-check && tests/build/spine-check"
+  "Project static checks (uproject JSON, module/target presence, script syntax)|python3 scripts/static-check.py"
+  "ENGINE:UBT build (Development Editor)|scripts/run-tests-headless.sh --build-only"
+  "ENGINE:Headless automation tests (PacketPlumber.* filter)|scripts/run-tests-headless.sh --tests"
+  "ENGINE:PPProbe commandlet (headless spine probe)|scripts/run-tests-headless.sh --probe --json-out docs/goldens/.engine-probe.json"
+  "ENGINE:Golden compare (PPProbe vs standalone vs docs/goldens/)|scripts/compare-golden.sh"
+)
+
+# run_gates <count> — first <count> gates, stop-on-fail, summarize.
+run_gates() {
+  local n="$1" results=() rc=0 i=0 label cmd entry status
+  for entry in "${GATES[@]:0:$n}"; do
+    i=$((i + 1))
+    label="${entry%%|*}"
+    cmd="${entry#*|}"
+    status="PASS"
+    echo ""
+    echo "── gate $i/$n — $label"
+    local t0
+    t0=$(date +%s)
+    if [[ "$label" == ENGINE:* ]] && [ "$ENGINE_PRESENT" -eq 0 ]; then
+      echo "   ⏭️  SKIP (no Unreal Engine found — see scripts/install-engine.sh)"
+      status="SKIP"
+      results+=("⏭️   gate $i  $label  (skipped: no engine)")
+    elif bash -c "$cmd"; then
+      echo "   ✅ PASS"
+      results+=("✅  gate $i  $label")
+    else
+      rc=$?
+      echo "   ❌ FAIL (exit $rc)"
+      results+=("❌  gate $i  $label")
+      echo ""
+      echo "gate $i failed — stopping (same failure semantics as CI)."
+      status="FAIL"
+    fi
+    local t1 dt
+    t1=$(date +%s)
+    dt=$((t1 - t0))
+    [ "$status" != "SKIP" ] && echo "   ⏱  ${dt}s"
+    printf '%s\tgate %d\t%s\t%s\t%ds\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$i" "$label" "$status" "$dt" >> docs/timings.md
+    [ "$status" = "FAIL" ] && break
+  done
+  echo ""
+  echo "═══════════════════════════════════════════════════════════"
+  echo "  LOCAL CI SUMMARY — $( [ "$FAST" -eq 1 ] && echo "fast (gates 1-$n)" || echo "full suite" ) — engine $([ "$ENGINE_PRESENT" -eq 1 ] && echo "PRESENT" || echo "ABSENT (engine gates skipped)")"
+  for r in "${results[@]}"; do echo "  $r"; done
+  if [ "$rc" -ne 0 ] && [ "${#results[@]}" -lt "$n" ]; then
+    echo "  ⏭  gates $(( ${#results[@]} + 1 ))-$n not run (stop-on-fail)"
+  fi
+  echo "═══════════════════════════════════════════════════════════"
+  return "$rc"
+}
+
+if [ "$BLESS" -eq 1 ]; then
+  # Re-record the golden from the engine's PPProbe (deliberate, proven re-bless).
+  if [ "$ENGINE_PRESENT" -eq 0 ]; then
+    echo "cannot --bless without the engine" >&2
+    exit 1
+  fi
+  scripts/run-tests-headless.sh --probe --json-out docs/goldens/probe-seed42-ticks100.json
+  exit $?
+fi
+
+if [ "$FAST" -eq 1 ]; then
+  run_gates 3
+else
+  run_gates "${#GATES[@]}"
+fi
