+#!/usr/bin/env bash
+# scripts/compare-golden.sh — the golden gate: committed golden vs the
+# standalone spine-check's recorded JSON, plus (when gate 6 ran with the
+# engine) the engine PPProbe's .engine-probe.json. Same seed/ticks ->
+# identical state_hash is the cross-runner determinism contract (ODN-11).
+set -uo pipefail
+
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+cd "$ROOT"
+
+GOLDEN="docs/goldens/probe-seed42-ticks100.json"
+ENGINE_PROBE="docs/goldens/.engine-probe.json"
+TMP="$(mktemp -d)"
+trap 'rm -rf "$TMP"' EXIT
+
+if [ ! -f "$GOLDEN" ]; then
+  echo "golden missing: $GOLDEN — run scripts/local-ci.sh --bless after the first engine build" >&2
+  exit 1
+fi
+
+# The standalone runner IS the reference (runs on any machine).
+./tests/build/spine-check --json > "$TMP/standalone.json"
+rc=$?
+[ $rc -ne 0 ] && exit $rc
+
+# The committed golden is ALWAYS asserted (engine-free); the engine probe is
+# compared additionally when gate 6 produced it. Every key carried by the
+# golden is enforced — including rng_first4 (drawn before the re-seed, so
+# state_hash alone would not cover it).
+if python3 - "$GOLDEN" "$TMP/standalone.json" "committed golden vs standalone spine-check" <<'PY'
+import json, sys
+KEYS = ("seed", "ticks", "tick_nonce", "state_hash", "save_magic", "save_version", "rng_first4")
+a = json.load(open(sys.argv[1]))
+b = json.load(open(sys.argv[2]))
+bad = [k for k in KEYS if a.get(k) != b.get(k)]
+if bad:
+    print("GOLDEN MISMATCH:", ", ".join(f"{k}: {a.get(k)} vs {b.get(k)}" for k in bad))
+    sys.exit(1)
+print(f"golden OK ({sys.argv[3]}): state_hash={a['state_hash']}")
+PY
+then
+  :
+else
+  exit 1
+fi
+
+if [ -f "$ENGINE_PROBE" ]; then
+  python3 - "$ENGINE_PROBE" "$TMP/standalone.json" "engine PPProbe vs standalone spine-check" <<'PY'
+import json, sys
+KEYS = ("seed", "ticks", "tick_nonce", "state_hash", "save_magic", "save_version", "rng_first4")
+a = json.load(open(sys.argv[1]))
+b = json.load(open(sys.argv[2]))
+bad = [k for k in KEYS if a.get(k) != b.get(k)]
+if bad:
+    print("ENGINE PROBE MISMATCH:", ", ".join(f"{k}: {a.get(k)} vs {b.get(k)}" for k in bad))
+    sys.exit(1)
+print(f"engine probe OK ({sys.argv[3]}): state_hash={a['state_hash']}")
+PY
+else
+  echo "no engine probe at $ENGINE_PROBE — engine leg not run this session (committed golden still asserted)"
+fi
+
+exit 0
