diff --git a/Source/PacketPlumberCoreTests/PP_DeterminismTests.cpp b/Source/PacketPlumberCoreTests/PP_DeterminismTests.cpp
new file mode 100644
index 0000000..bba0163
--- /dev/null
+++ b/Source/PacketPlumberCoreTests/PP_DeterminismTests.cpp
@@ -0,0 +1,112 @@
+// PP_DeterminismTests.cpp — the replay-equality contract (ODN-11), UE side.
+// Same (seed, tick sequence) -> byte-identical serialized state -> identical
+// state hash. A different seed must diverge. Mirrors tests/spine_check.cpp.
+#include "Misc/AutomationTest.h"
+
+#include "PacketPlumberCore/PP_Sim.h"
+
+#if WITH_DEV_AUTOMATION_TESTS
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPReplayEquality, "PacketPlumber.Determinism.ReplayEquality",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPReplayEquality::RunTest(const FString &Parameters)
+{
+	// Run A and B: same seed, same 100-tick sequence -> identical hash.
+	PP::FSimState A;
+	A.Initialize(42);
+	PP::FSimState B;
+	B.Initialize(42);
+	for (int32 I = 0; I < 100; ++I)
+	{
+		PP::Step(A, static_cast<uint64_t>(I + 1));
+		PP::Step(B, static_cast<uint64_t>(I + 1));
+	}
+	const uint64_t HashA = PP::StateHash(A);
+	const uint64_t HashB = PP::StateHash(B);
+	TestEqual(TEXT("same seed + same ticks must replay identical"), HashA, HashB);
+	TestEqual(TEXT("tick nonce must match on replay"), A.TickNonce, B.TickNonce);
+
+	// Run C: different seed -> must diverge.
+	PP::FSimState C;
+	C.Initialize(43);
+	for (int32 I = 0; I < 100; ++I)
+	{
+		PP::Step(C, static_cast<uint64_t>(I + 1));
+	}
+	TestTrue(TEXT("different seed must diverge"), PP::StateHash(C) != HashA);
+
+	// The heartbeat is non-vacuous: stepping actually changes the state.
+	PP::FSimState D;
+	D.Initialize(42);
+	const uint64_t HashD0 = PP::StateHash(D);
+	PP::Step(D, 1);
+	TestTrue(TEXT("a step must change the state hash (non-vacuous heartbeat)"), PP::StateHash(D) != HashD0);
+	return true;
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPStateSerializeVersioned, "PacketPlumber.Determinism.SerializeVersioned",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPStateSerializeVersioned::RunTest(const FString &Parameters)
+{
+	PP::FSimState S;
+	S.Initialize(7);
+	PP::Step(S, 1);
+
+	uint8_t Buffer[64];
+	const size_t N = PP::SerializeState(S, Buffer, sizeof(Buffer));
+	TestEqual(TEXT("serialized size must be the versioned header + fields (45)"), N, static_cast<size_t>(45));
+
+	// Wire format (ODN-11, documented): the versioned header is a u32 magic
+	// whose LITTLE-ENDIAN bytes spell "PPUE" (0x50 0x50 0x55 0x45 = 'P','P','U','E')
+	// followed by u32 save_version=1, then seed/tick/tick_nonce/rng/terminal,
+	// every field little-endian. SAVE_MAGIC (0x45555050) is the byte-swapped
+	// ASCII so the LE serializer emits exactly "PPUE".
+	TestEqual(TEXT("magic byte 0"), Buffer[0], uint8_t('P'));
+	TestEqual(TEXT("magic byte 1"), Buffer[1], uint8_t('P'));
+	TestEqual(TEXT("magic byte 2"), Buffer[2], uint8_t('U'));
+	TestEqual(TEXT("magic byte 3"), Buffer[3], uint8_t('E'));
+	TestEqual(TEXT("save version"), Buffer[4], uint8_t(1));
+
+	// Capacity guard: an undersized buffer must fail (0) without writing.
+	uint8_t Small[44];
+	TestEqual(TEXT("undersized buffer must return 0"), PP::SerializeState(S, Small, sizeof(Small)),
+			  static_cast<size_t>(0));
+
+	// Round-trip stability: serializing twice yields identical bytes.
+	uint8_t Buffer2[64];
+	const size_t N2 = PP::SerializeState(S, Buffer2, sizeof(Buffer2));
+	TestEqual(TEXT("serialize length must be stable"), N, N2);
+	TestTrue(TEXT("serialize bytes must be stable"), FMemory::Memcmp(Buffer, Buffer2, N) == 0);
+	return true;
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPStepGuards, "PacketPlumber.Determinism.StepGuards",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPStepGuards::RunTest(const FString &Parameters)
+{
+	// Backward tick is ignored (ODN-2): Tick/TickNonce stay put.
+	PP::FSimState S;
+	S.Initialize(9);
+	PP::Step(S, 5);
+	const uint32_t Nonce5 = S.TickNonce;
+	PP::Step(S, 3);
+	TestEqual(TEXT("backward tick must be ignored (tick stays)"), S.Tick, static_cast<uint64_t>(5));
+	TestEqual(TEXT("backward tick must be ignored (nonce stays)"), S.TickNonce, Nonce5);
+	PP::Step(S, 6);
+	TestEqual(TEXT("a later tick must still advance after a swallowed one"), S.Tick, static_cast<uint64_t>(6));
+	TestTrue(TEXT("a later tick must redraw the nonce"), S.TickNonce != Nonce5);
+
+	// Terminal barrier (E17): once terminal, the run is frozen.
+	S.bTerminal = true;
+	const uint64_t TickBefore = S.Tick;
+	const uint32_t NonceBefore = S.TickNonce;
+	PP::Step(S, 999);
+	TestEqual(TEXT("terminal state must freeze the tick"), S.Tick, TickBefore);
+	TestEqual(TEXT("terminal state must freeze the nonce"), S.TickNonce, NonceBefore);
+	return true;
+}
+
+#endif // WITH_DEV_AUTOMATION_TESTS
diff --git a/Source/PacketPlumberCoreTests/PP_HashTests.cpp b/Source/PacketPlumberCoreTests/PP_HashTests.cpp
