+// PPProbeCommandlet.cpp — the headless spine probe.
+#include "PPProbeCommandlet.h"
+
+// Module-local log category (UE 5.8 log categories are not exported across
+// module boundaries by default; the commandlet is the only user, so a
+// file-static category is the idiomatic choice — see LogCategory.h).
+DEFINE_LOG_CATEGORY_STATIC(LogPPProbe, Log, All);
+
+#include "PacketPlumberCore/PP_Rng.h"
+#include "PacketPlumberCore/PP_Sim.h"
+#include "Misc/FileHelper.h"
+#include "Misc/Paths.h"
+
+UPPProbeCommandlet::UPPProbeCommandlet()
+{
+	IsClient = false;
+	IsEditor = true;
+	LogToConsole = true;
+}
+
+int32 UPPProbeCommandlet::Main(const FString &Params)
+{
+	// --- parse -seed= / -ticks= / -json= (loose; defaults keep it runnable).
+	// Command-line switches arrive dash-stripped in the Switches array
+	// ("seed=42", not "-seed=42"); garbage values fail loudly (never
+	// silently fall back to defaults mid-run).
+	uint64_t Seed = 42;
+	int32 Ticks = 100;
+	FString JsonPath;
+
+	TArray<FString> Tokens;
+	TArray<FString> Switches;
+	ParseCommandLine(*Params, Tokens, Switches);
+
+	for (const FString &Switch : Switches)
+	{
+		if (Switch.StartsWith(TEXT("seed=")))
+		{
+			const TCHAR *Str = *Switch + 5;
+			TCHAR *End = nullptr;
+			const uint64_t V = FCString::Strtoui64(Str, &End, 10);
+			if (End == Str || *End != TEXT('\0'))
+			{
+				UE_LOG(LogPPProbe, Error, TEXT("PPProbe: bad -seed value '%s' (must be a decimal u64)"), *Switch);
+				return 1;
+			}
+			Seed = V;
+		}
+		else if (Switch.StartsWith(TEXT("ticks=")))
+		{
+			const int32 V = FCString::Atoi(*Switch + 6);
+			if (V < 1)
+			{
+				UE_LOG(LogPPProbe, Error, TEXT("PPProbe: bad -ticks value '%s' (must be >= 1)"), *Switch);
+				return 1;
+			}
+			Ticks = V;
+		}
+		else if (Switch.StartsWith(TEXT("json=")))
+		{
+			JsonPath = Switch.RightChop(5);
+		}
+	}
+
+	// --- run the spine (identical code path the automation tests exercise)
+	PP::FSimState State;
+	State.Initialize(Seed);
+
+	uint32_t FirstOutputs[4] = {0, 0, 0, 0};
+	for (int32 I = 0; I < 4; ++I)
+	{
+		FirstOutputs[I] = PP::RngNext(State.Rng);
+	}
+
+	// Re-seed so the heartbeat stream is untouched by the vector probe above.
+	State.Initialize(Seed);
+	for (int32 I = 0; I < Ticks; ++I)
+	{
+		PP::Step(State, static_cast<uint64_t>(I + 1));
+	}
+
+	const uint64_t Hash = PP::StateHash(State);
+
+	// --- optional JSON artifact FIRST (CI golden surface). Written (or
+	// failed loudly) BEFORE RESULT=OK so a log-grep can never pass a probe
+	// whose artifact write failed.
+	if (!JsonPath.IsEmpty())
+	{
+		const FString Json = FString::Printf(
+			TEXT("{\"seed\":%llu,\"ticks\":%d,\"tick_nonce\":%u,\"state_hash\":\"%016llx\",\"rng_first4\":[%u,%u,%u,%u]"
+				 ",\"save_magic\":\"PPUE\",\"save_version\":1}\n"),
+			Seed, Ticks, State.TickNonce, Hash, FirstOutputs[0], FirstOutputs[1], FirstOutputs[2], FirstOutputs[3]);
+
+		if (!FFileHelper::SaveStringToFile(Json, *FPaths::ConvertRelativePathToFull(JsonPath)))
+		{
+			UE_LOG(LogPPProbe, Error, TEXT("PPProbe failed to write %s"), *JsonPath);
+			return 1;
+		}
+		UE_LOG(LogPPProbe, Display, TEXT("PPProbe wrote %s"), *JsonPath);
+	}
+
+	// --- report
+	const FString Report = FString::Printf(
+		TEXT("PPProbe seed=%llu ticks=%d tick_nonce=%u state_hash=%016llx rng0=[%u %u %u %u]"), Seed, Ticks,
+		State.TickNonce, Hash, FirstOutputs[0], FirstOutputs[1], FirstOutputs[2], FirstOutputs[3]);
+
+	UE_LOG(LogPPProbe, Display, TEXT("%s"), *Report);
+	UE_LOG(LogPPProbe, Display, TEXT("PPProbe RESULT=OK"));
+
+	return 0;
+}
