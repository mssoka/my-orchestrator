@@ -0,0 +1,87 @@
+// PP_Rng.h — the owned PRNG (ODN-9 port, Packet-Plumber-UE).
+//
+// Exact port of the Odin v2 core/rng.odin: PCG32 XSH-RR (64-bit state,
+// 32-bit output) with splitmix64 seed expansion. Constants are pinned in
+// source (the canonical pcg-random.org PCG32 XSH-RR). NOT FMath::Rand /
+// FRandomStream — the engine's implementation may drift between versions and
+// the determinism guarantee must not depend on the engine's internals.
+//
+// This file is intentionally free of UE headers so the SAME source compiles
+// in the engine module (Source/PacketPlumberCore) and in the standalone
+// spine-check runner (tests/spine_check.cpp) — the cross-language
+// determinism conformance test (ODN-9, arch REVIEW m6).
+//
+// Conformance: seed 0's first 8 outputs and seed 42's first 4 outputs are
+// pinned in PP_RngTests.cpp and tests/spine_check.cpp. Any future port must
+// reproduce them.
+#pragma once
+
+#include <cstdint>
+
+namespace PP
+{
+
+struct FRng
+{
+	uint64_t State = 0;
+	uint64_t Inc = 0; // odd (the PCG stream selector)
+};
+
+// PCG32 constants (pcg-random.org, pinned in source).
+inline constexpr uint64_t PCG32_MULT = 6364136223846793005ull;
+
+// splitmix64 constants (SplitMix64 / David Stafford's Mix13), pinned.
+inline constexpr uint64_t SPLITMIX_DELTA = 0x9E3779B97F4A7C15ull;
+inline constexpr uint64_t SPLITMIX_GAMMA1 = 0xBF58476D1CE4E5B9ull;
+inline constexpr uint64_t SPLITMIX_GAMMA2 = 0x94D049BB133111EBull;
+
+// splitmix64 — advances S by the golden-ratio delta, returns the mixed value.
+inline uint64_t SplitMix64(uint64_t &S)
+{
+	S += SPLITMIX_DELTA;
+	uint64_t Z = S;
+	Z = (Z ^ (Z >> 30)) * SPLITMIX_GAMMA1;
+	Z = (Z ^ (Z >> 27)) * SPLITMIX_GAMMA2;
+	return Z ^ (Z >> 31);
+}
+
+// pcg32 XSH-RR: the output is a function of the OLD state, then the state
+// advances. Constants + shift counts pinned to the canonical reference.
+inline uint32_t RngNext(FRng &R)
+{
+	const uint64_t Old = R.State;
+	R.State = Old * PCG32_MULT + R.Inc;
+	const uint32_t Xorshifted = static_cast<uint32_t>(((Old >> 18) ^ Old) >> 27);
+	const uint32_t Rot = static_cast<uint32_t>(Old >> 59);
+	return (Xorshifted >> Rot) | (Xorshifted << ((-Rot) & 31));
+}
+
+// Seed the PRNG from a single u64. splitmix64 expands the seed into the PCG
+// state + an odd stream selector; two PCG advances mix the state before the
+// first output. Same seed -> identical stream (the determinism keystone).
+inline void RngSeed(FRng &R, uint64_t Seed)
+{
+	uint64_t S = Seed;
+	R.State = SplitMix64(S);
+	R.Inc = (SplitMix64(S) | 1); // inc must be odd
+	RngNext(R);					 // first mix advance
+	R.State += SplitMix64(S);
+	RngNext(R); // second mix advance
+}
+
+// Bounded draw in [Lo, Hi] INCLUSIVE. Multiply-shift (Lemire) instead of
+// modulo: bias is < 2^-32 and the draw is a single multiply. Callers pass
+// span-ordered (Lo <= Hi) bounds; a degenerate span returns Lo.
+// The span is computed in int64 (NOT int32) so spans > INT32_MAX don't
+// overflow (ODN-10: integer math must be well-defined on every target).
+inline int32_t RngRange(FRng &R, int32_t Lo, int32_t Hi)
+{
+	if (Hi <= Lo)
+	{
+		return Lo;
+	}
+	const uint64_t Span = static_cast<uint64_t>(static_cast<int64_t>(Hi) - static_cast<int64_t>(Lo)) + 1;
+	return Lo + static_cast<int32_t>((static_cast<uint64_t>(RngNext(R)) * Span) >> 32);
+}
+
+} // namespace PP
diff --git a/Source/PacketPlumberCore/Public/PacketPlumberCore/PP_Sim.h b/Source/PacketPlumberCore/Public/PacketPlumberCore/PP_Sim.h
new file mode 100644
index 0000000..bddd56d
--- /dev/null
+++ b/Source/PacketPlumberCore/Public/PacketPlumberCore/PP_Sim.h
@@ -0,0 +1,82 @@
+// PP_Sim.h — the ONLY entry point that advances the simulation (ODN-1 port,
+// Packet-Plumber-UE).
+//
+// Slice-1 spine: step advances the tick and folds one owned-RNG draw into
+// TickNonce (the v2 spine's rng-heartbeat — it ties the RNG into the step
+// path so replay-equality is non-vacuous). The tick-sequence guard and the
+// terminal barrier (E17) are carried from the Odin step.
+//
+// Nothing here reads a clock, a file, or a device (ODN-1); all math is
+// integer (ODN-10). Serialization is explicit little-endian field-by-field
+// (ODN-11 mechanism) — never raw struct memcpy (padding is not portable).
+#pragma once
+
+#include <cstdint>
+
+#include "PacketPlumberCore/PP_Hash.h"
+#include "PacketPlumberCore/PP_SimState.h"
+
+namespace PP
+{
+
+// Advance the sim to Tick. Guards:
+//  - backward tick -> ignored, silently: Tick/TickNonce stay put (observable
+//    via the state; the Odin spine latches replay_error instead — the latch
+//    arrives with real commands)
+//  - terminal barrier (E17): once terminal, the run is frozen.
+inline void Step(FSimState &State, uint64_t Tick)
+{
+	if (Tick < State.Tick || State.bTerminal)
+	{
+		return;
+	}
+	State.Tick = Tick;
+	State.TickNonce = RngNext(State.Rng); // heartbeat draw (ODN-9 owned stream)
+}
+
+// Serialize the run state as little-endian bytes with a versioned header
+// (ODN-11 mechanism). Returns the byte count written to Out.
+inline size_t SerializeState(const FSimState &State, uint8_t *Out, size_t OutCapacity)
+{
+	const size_t Needed = 4 + 4 + 8 + 8 + 4 + 8 + 8 + 1;
+	if (OutCapacity < Needed)
+	{
+		return 0;
+	}
+
+	auto PutU32 = [&Out](uint32_t V)
+	{
+		*Out++ = static_cast<uint8_t>(V & 0xFF);
+		*Out++ = static_cast<uint8_t>((V >> 8) & 0xFF);
+		*Out++ = static_cast<uint8_t>((V >> 16) & 0xFF);
+		*Out++ = static_cast<uint8_t>((V >> 24) & 0xFF);
+	};
+	auto PutU64 = [&Out](uint64_t V)
+	{
+		for (int I = 0; I < 8; ++I)
+		{
+			*Out++ = static_cast<uint8_t>((V >> (8 * I)) & 0xFF);
+		}
+	};
+
+	PutU32(SAVE_MAGIC);
+	PutU32(SAVE_VERSION);
+	PutU64(State.Seed);
+	PutU64(State.Tick);
+	PutU32(State.TickNonce);
+	PutU64(State.Rng.State);
+	PutU64(State.Rng.Inc);
+	*Out++ = State.bTerminal ? 1 : 0;
+	return Needed;
+}
+
+// The state hash (ODN-11): FNV-1a-64 over the canonical serialized bytes.
+// Same (seed, tick sequence) -> identical hash on every platform.
+inline uint64_t StateHash(const FSimState &State)
+{
+	uint8_t Buffer[64];
+	const size_t N = SerializeState(State, Buffer, sizeof(Buffer));
+	return Fnv1a64(Buffer, N);
+}
+
+} // namespace PP
diff --git a/Source/PacketPlumberCore/Public/PacketPlumberCore/PP_SimState.h b/Source/PacketPlumberCore/Public/PacketPlumberCore/PP_SimState.h
new file mode 100644
index 0000000..8a74499
--- /dev/null
+++ b/Source/PacketPlumberCore/Public/PacketPlumberCore/PP_SimState.h
@@ -0,0 +1,44 @@
+// PP_SimState.h — the minimal run state for the determinism spine
+// (ODN-1/ODN-11 ports, Packet-Plumber-UE).
+//
+// Slice-1 equivalent of the v2 walking skeleton: seed + tick + owned-RNG
+// heartbeat (tick_nonce). The full sim state (topology, packet pools, QoS)
+// lands with slice-1 stories; the spine contract is already pinned here:
+// same (seed, action log) -> byte-identical serialized state -> identical
+// state hash (ODN-11 replay-equality).
+#pragma once
+
+#include <cstdint>
+
+#include "PacketPlumberCore/PP_Rng.h"
+
+namespace PP
+{
+
+// Save-format version (ODN-11: versioned header, little-endian binary).
+// SAVE_MAGIC is the u32 whose LITTLE-ENDIAN bytes spell "PPUE":
+//   0x50 0x50 0x55 0x45 -> 'P' 'P' 'U' 'E' on the wire
+// (0x50505545 would serialize to 'E' 'U' 'P' 'P' — a byte-order bug; the
+// wire format is explicitly LE, so the constant is the byte-swapped ASCII.)
+inline constexpr uint32_t SAVE_MAGIC = 0x45555050u; // LE bytes = "PPUE"
+inline constexpr uint32_t SAVE_VERSION = 1;
+
+struct FSimState
+{
+	uint64_t Seed = 0;
+	uint64_t Tick = 0;
+	uint32_t TickNonce = 0; // the heartbeat: one owned-RNG draw per step
+	FRng Rng;
+	bool bTerminal = false; // E17 terminal barrier placeholder
+
+	void Initialize(uint64_t InSeed)
+	{
+		Seed = InSeed;
+		Tick = 0;
+		TickNonce = 0;
+		bTerminal = false;
+		RngSeed(Rng, Seed);
+	}
+};
+
+} // namespace PP
