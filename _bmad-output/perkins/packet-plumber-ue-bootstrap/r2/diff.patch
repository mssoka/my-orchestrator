+#!/usr/bin/env bash
+# scripts/run-tests-headless.sh — headless UE gates (build / tests / probe).
+#
+# Requires a UE 5.8.x install (see scripts/install-engine.sh). The Cmd binary
+# runs the editor WITHOUT the GUI: -unattended -nopause -nullrhi -nosound
+# -nosplash. All output goes to Saved/Logs/headless-<gate>.log.
+#
+#   scripts/run-tests-headless.sh --build-only   # UBT Development Editor build
+#   scripts/run-tests-headless.sh --tests        # Automation RunTests PacketPlumber
+#   scripts/run-tests-headless.sh --probe        # PPProbe commandlet (default seed 42, 100 ticks)
+#   scripts/run-tests-headless.sh --probe --json-out <path>
+set -uo pipefail
+
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+cd "$ROOT"
+
+UPROJECT="$(pwd)/PacketPlumberUE.uproject"
+
+# Shared find_engine (UE_EDITOR_PATH -> UE_ROOT -> standard Epic locations).
+source "$ROOT/scripts/lib/engine.sh"
+
+ENGINE_CMD="$(find_engine || true)"
+if [ -z "$ENGINE_CMD" ]; then
+  echo "Unreal Engine 5.8 not found. Run scripts/install-engine.sh for the manual step." >&2
+  exit 127
+fi
+
+ENGINE_ROOT="$(cd "$(dirname "$ENGINE_CMD")/../../.." && pwd)"
+mkdir -p Saved/Logs
+
+case "${1:-}" in
+  --build-only)
+    # UBT build of the editor target (Development). First build 30-60+ min.
+    "$ENGINE_ROOT/Engine/Build/BatchFiles/Mac/Build.sh" PacketPlumberEditor Mac Development \
+      -project="$UPROJECT" -waitmutex 2>&1 | tee Saved/Logs/headless-build.log
+    exit ${PIPESTATUS[0]}
+    ;;
+  --tests)
+    # The determinism automation suite, headless. -TestExit quits when the
+    # queue drains; the log's "Test Completed. Result=" lines carry the truth.
+    # The -log path MUST be absolute: UE 5.8 joins -log= values onto the
+    # user log root (~/Library/Logs/Unreal Engine/<Project>Editor/), silently
+    # writing elsewhere and leaving the grep truth-check staring at nothing.
+    # -abslog= is the absolute-path variant (GenericPlatformOutputDevices.cpp).
+    "$ENGINE_CMD" "$UPROJECT" \
+      -unattended -nopause -nullrhi -nosound -nosplash \
+      -ExecCmds="Automation RunTests PacketPlumber" \
+      -TestExit="Automation Test Queue Empty" \
+      -abslog="$ROOT/Saved/Logs/headless-tests.log"
+    rc=$?
+    # Truth is in the log, not the exit code. UE 5.8 writes
+    # "Test Completed. Result={Success}" (braced); match both forms.
+    if ! grep -qE "Result=\{?Success\}?" Saved/Logs/headless-tests.log; then
+      echo "no successful test result in the log — treat as failure" >&2
+      exit 1
+    fi
+    if grep -qE "Result=\{?Fail(ed|ure)?\}?" Saved/Logs/headless-tests.log; then
+      echo "FAILING tests detected in Saved/Logs/headless-tests.log" >&2
+      exit 1
+    fi
+    exit $rc
+    ;;
+  --probe)
+    shift
+    JSON_OUT=""
+    if [ "${1:-}" = "--json-out" ]; then
+      JSON_OUT="${2:-}"
+      shift 2
+    fi
+    ARGS=""
+    [ -n "$JSON_OUT" ] && ARGS="-json=$(cd "$ROOT" && pwd)/$JSON_OUT"
+    "$ENGINE_CMD" "$UPROJECT" \
+      -unattended -nopause -nullrhi -nosound -nosplash \
+      -run=PPProbe -seed=42 -ticks=100 $ARGS \
+      -abslog="$ROOT/Saved/Logs/headless-probe.log"
+    rc=$?
+    # Truth is in the artifact, not the exit code: the commandlet writes the
+    # JSON BEFORE logging RESULT=OK, so a failed write never leaves an OK in
+    # the log. When an artifact was requested it must exist AND parse.
+    if ! grep -q "PPProbe RESULT=OK" Saved/Logs/headless-probe.log; then
+      echo "PPProbe did not report OK — treat as failure" >&2
+      exit 1
+    fi
+    if [ -n "$JSON_OUT" ]; then
+      if [ ! -f "$JSON_OUT" ]; then
+        echo "PPProbe RESULT=OK but JSON artifact missing: $JSON_OUT — treat as failure" >&2
+        exit 1
+      fi
+      if ! python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$JSON_OUT" 2>/dev/null; then
+        echo "PPProbe JSON artifact does not parse as JSON: $JSON_OUT — treat as failure" >&2
+        exit 1
+      fi
+      echo "probe JSON written + verified: $JSON_OUT"
+    fi
+    exit $rc
+    ;;
+  *)
+    echo "usage: run-tests-headless.sh [--build-only|--tests|--probe]" >&2
+    exit 2
+    ;;
+esac
diff --git a/scripts/static-check.py b/scripts/static-check.py
new file mode 100755
index 0000000..f431b79
--- /dev/null
+++ b/scripts/static-check.py
@@ -0,0 +1,95 @@
+#!/usr/bin/env python3
+"""scripts/static-check.py — project static checks (gate 3, no engine).
+
+Verifies what CAN be verified without the engine, so the pre-engine CI loop
+catches real breakage instead of false greens:
+  1. PacketPlumberUE.uproject is valid JSON with the expected modules/plugins.
+  2. Every .uproject module name has a Build.cs + a module cpp under Source/.
+  3. Both .Target.cs files reference existing modules.
+  4. Scripts in scripts/ pass bash -n (syntax).
+  5. No CRLF in tracked text files (.gitattributes says eol=lf).
+  6. Config/DefaultEngine.ini pins the fixed 20 Hz sim tick (ODN-2).
+Exit 0 = all pass.
+"""
+import json
+import pathlib
+import subprocess
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parent.parent
+FAIL = []
+
+
+def check(cond: bool, msg: str) -> None:
+    if not cond:
+        FAIL.append(msg)
+        print(f"FAIL: {msg}")
+
+
+def main() -> int:
+    # 1. uproject JSON + expected shape
+    uproj = json.loads((ROOT / "PacketPlumberUE.uproject").read_text())
+    modules = {m["Name"] for m in uproj.get("Modules", [])}
+    expected_modules = {"PacketPlumberCore", "PacketPlumber", "PacketPlumberCoreTests", "PacketPlumberEditor"}
+    check(expected_modules <= modules, f"uproject missing modules: {expected_modules - modules}")
+    plugins = {p["Name"]: p.get("Enabled") for p in uproj.get("Plugins", [])}
+    check(plugins.get("ModelContextProtocol") is True, "ModelContextProtocol plugin must be enabled")
+    check(plugins.get("PythonScriptPlugin") is True, "PythonScriptPlugin plugin must be enabled")
+
+    # 2. each module has Build.cs + a source cpp
+    for name in modules:
+        check((ROOT / "Source" / name / f"{name}.Build.cs").is_file(), f"{name}.Build.cs missing")
+        cpps = list((ROOT / "Source" / name).glob("*.cpp"))
+        check(len(cpps) > 0, f"no .cpp in Source/{name}")
+
+    # 3. targets reference existing modules
+    for t in ["PacketPlumber.Target.cs", "PacketPlumberEditor.Target.cs"]:
+        text = (ROOT / "Source" / t).read_text()
+        for m in ["PacketPlumber", "PacketPlumberEditor", "PacketPlumberCoreTests"]:
+            if m in text:
+                check(m in modules, f"{t} references {m} but it is not in the uproject")
+
+    # 4. script syntax
+    for sh in sorted((ROOT / "scripts").glob("*.sh")):
+        r = subprocess.run(["bash", "-n", str(sh)], capture_output=True, text=True)
+        check(r.returncode == 0, f"bash -n failed on {sh.name}: {r.stderr.strip()}")
+
+    # 5. CRLF scan on tracked text files (best-effort: git tracked only)
+    r = subprocess.run(["git", "ls-files"], capture_output=True, text=True, cwd=ROOT)
+    check(r.returncode == 0, f"git ls-files failed: {r.stderr.strip()}")
+    for rel in r.stdout.splitlines():
+        if not rel.endswith((".h", ".cpp", ".cs", ".ini", ".json", ".md", ".sh")):
+            continue
+        data = (ROOT / rel).read_bytes()
+        if b"\r\n" in data:
+            check(False, f"CRLF in {rel}")
+
+    # 6. ODN-2 fixed 20 Hz tick pinned in DefaultEngine.ini (engine-free
+    #    assertion of the sim-rate pin; the presentation side is engine-gated).
+    ini = (ROOT / "Config" / "DefaultEngine.ini").read_text()
+    section = None
+    ini_kv = {}
+    for line in ini.splitlines():
+        line = line.strip()
+        if not line or line.startswith(";") or line.startswith("#"):
+            continue
+        if line.startswith("[") and line.endswith("]"):
+            section = line[1:-1]
+            continue
+        if section is None or "=" not in line:
+            continue
+        ini_kv[f"{section}.{line.split('=', 1)[0].strip()}"] = line.split("=", 1)[1].strip()
+    check(ini_kv.get("/Script/Engine.Engine.bUseFixedFrameRate", "").lower() == "true",
+        "bUseFixedFrameRate must be True (ODN-2 fixed tick)")
+    check(ini_kv.get("/Script/Engine.Engine.FixedFrameRate", "") == "20.000000",
+        "FixedFrameRate must be 20.000000 (ODN-2 fixed tick)")
+
+    if FAIL:
+        print(f"\nstatic-check: {len(FAIL)} failure(s)")
+        return 1
+    print("static-check: all checks passed")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/spine_check.cpp b/tests/spine_check.cpp
new file mode 100644
index 0000000..93007c1
--- /dev/null
+++ b/tests/spine_check.cpp
@@ -0,0 +1,277 @@
+// spine_check.cpp — the STANDALONE determinism spine runner.
+//
+// Compiles the SAME headers the engine module uses (PP_Rng.h, PP_Hash.h,
+// PP_Sim.h — deliberately UE-header-free) with a plain C++17 compiler, and
+// asserts the pinned conformance vectors + replay-equality contract. This is
+// the local-CI gate that runs BEFORE the engine exists on the machine, and
+// the cross-language conformance test for any future port (server validator,
+// wasm, other engines).
+//
+// Build:  mkdir -p tests/build && g++ -std=c++17 -O2 \
+//             -I Source/PacketPlumberCore/Public \
+//             tests/spine_check.cpp -o tests/build/spine-check
+// Run:    tests/build/spine-check          # exit 0 = all green
+//         tests/build/spine-check --json   # print the PPProbe-equivalent JSON
+//
+// The assertion count is counted at runtime (CHECK increments Executions) —
+// never hardcoded, so the printed "ALL GREEN (N checks)" is always true.
+// The pinned golden values below MUST match docs/goldens/probe-seed42-ticks100.json;
+// re-blessing the golden means updating BOTH (deliberate + proven, per the
+// golden discipline — see AGENTS.md).
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+#include "PacketPlumberCore/PP_Hash.h"
+#include "PacketPlumberCore/PP_Rng.h"
+#include "PacketPlumberCore/PP_Sim.h"
+
+static int Failures = 0;
+static int Executions = 0;
+
+#define CHECK(cond, msg)                                            \
+	do                                                              \
+	{                                                               \
+		++Executions;                                               \
+		if (!(cond))                                                \
+		{                                                           \
+			std::fprintf(stderr, "FAIL: %s (%s:%d)\n", msg, __FILE__, __LINE__); \
+			++Failures;                                             \
+		}                                                           \
+	} while (0)
+
+int main(int argc, char** argv)
+{
+	// --- ODN-9 pinned vectors (cross-language conformance; core/rng_test.odin)
+	{
+		PP::FRng R;
+		PP::RngSeed(R, 0);
+		const uint32_t Expected0[8] = {2196338726u, 1832588393u, 3253730937u, 2647056997u,
+		                               2191141068u, 1480505347u, 3030956019u, 209995402u};
+		for (int I = 0; I < 8; ++I)
+		{
+			const uint32_t Got = PP::RngNext(R);
+			CHECK(Got == Expected0[I], "seed 0 pinned vector mismatch");
+			if (Got != Expected0[I])
+			{
+				std::fprintf(stderr, "  seed 0 output %d: got %u want %u\n", I, Got, Expected0[I]);
+			}
+		}
+	}
+	{
+		PP::FRng R;
+		PP::RngSeed(R, 42);
+		const uint32_t Expected42[4] = {2399007886u, 4293122540u, 1743717038u, 2217374311u};
+		for (int I = 0; I < 4; ++I)
+		{
+			const uint32_t Got = PP::RngNext(R);
+			CHECK(Got == Expected42[I], "seed 42 pinned vector mismatch");
+		}
+	}
+
+	// --- stream discipline
+	{
+		PP::FRng A, B;
+		PP::RngSeed(A, 1337);
+		PP::RngSeed(B, 1337);
+		bool Same = true;
+		for (int I = 0; I < 100; ++I)
+		{
+			if (PP::RngNext(A) != PP::RngNext(B)) { Same = false; }
+		}
+		CHECK(Same, "same seed must reproduce the stream");
+
+		PP::FRng C, D;
+		PP::RngSeed(C, 1);
+		PP::RngSeed(D, 2);
+		bool Diverged = false;
+		for (int I = 0; I < 16; ++I)
+		{
+			if (PP::RngNext(C) != PP::RngNext(D)) { Diverged = true; }
+		}
+		CHECK(Diverged, "different seeds must diverge");
+
+		// bounds + degenerate spans
+		PP::FRng E;
+		PP::RngSeed(E, 7);
+		bool InBounds = true;
+		for (int I = 0; I < 10000; ++I)
+		{
+			const int32_t V = PP::RngRange(E, 6, 34);
+			if (V < 6 || V > 34) { InBounds = false; }
+		}
+		CHECK(InBounds, "rng_range must stay in [6,34]");
+		CHECK(PP::RngRange(E, 5, 5) == 5, "degenerate span must return lo");
+		CHECK(PP::RngRange(E, 9, 3) == 9, "inverted span must return lo");
+
+		// spans wider than INT32_MAX must not overflow (int64 span math)
+		PP::FRng F;
+		PP::RngSeed(F, 3);
+		const int32_t Wide = PP::RngRange(F, INT32_MIN, INT32_MAX);
+		CHECK(Wide >= INT32_MIN && Wide <= INT32_MAX, "full-int32 span must stay in range");
+	}
+
+	// --- FNV-1a-64 conformance (published test vectors + invariants)
+	{
+		CHECK(PP::Fnv1a64(nullptr, 0) == PP::FNV64_OFFSET, "fnv1a64(empty) must equal the offset basis");
+		const uint8_t A[1] = {'a'};
+		CHECK(PP::Fnv1a64(A, 1) == 0xaf63dc4c8601ec8cull, "fnv1a64(\"a\") must equal the published vector");
+		const uint8_t PP[2] = {'p', 'p'};
+		CHECK(PP::Fnv1a64(PP, 2) != 0, "fnv1a64(pp) must be nonzero");
+		const uint8_t AB[2] = {'a', 'b'};
+		const uint8_t BA[2] = {'b', 'a'};
+		CHECK(PP::Fnv1a64(AB, 2) != PP::Fnv1a64(BA, 2), "fnv1a64 must be order-sensitive");
+	}
+
+	// --- replay equality (the spine contract, ODN-11)
+	uint64_t HashA = 0;
+	{
+		PP::FSimState A, B;
+		A.Initialize(42);
+		B.Initialize(42);
+		for (uint64_t I = 1; I <= 100; ++I)
+		{
+			PP::Step(A, I);
+			PP::Step(B, I);
+		}
+		HashA = PP::StateHash(A);
+		CHECK(HashA == PP::StateHash(B), "same seed + same ticks must replay identical");
+		CHECK(A.TickNonce == B.TickNonce, "tick nonce must match on replay");
+
+		PP::FSimState C;
+		C.Initialize(43);
+		for (uint64_t I = 1; I <= 100; ++I)
+		{
+			PP::Step(C, I);
+		}
+		CHECK(PP::StateHash(C) != HashA, "different seed must diverge");
+
+		PP::FSimState D;
+		D.Initialize(42);
+		const uint64_t HashD0 = PP::StateHash(D);
+		PP::Step(D, 1);
+		CHECK(PP::StateHash(D) != HashD0, "a step must change the state hash (non-vacuous heartbeat)");
+	}
+
+	// --- Step guards: backward tick + terminal freeze (ODN-2, E17)
+	{
+		PP::FSimState S;
+		S.Initialize(9);
+		PP::Step(S, 5);
+		const uint32_t Nonce5 = S.TickNonce;
+		PP::Step(S, 3); // backward -> ignored
+		CHECK(S.Tick == 5, "backward tick must be ignored (tick stays)");
+		CHECK(S.TickNonce == Nonce5, "backward tick must be ignored (nonce stays)");
+		PP::Step(S, 6); // forward again -> still advances normally
+		CHECK(S.Tick == 6, "a later tick must still advance after a swallowed one");
+		CHECK(S.TickNonce != Nonce5, "a later tick must redraw the nonce");
+
+		S.bTerminal = true; // E17 barrier
+		const uint64_t TickBefore = S.Tick;
+		const uint32_t NonceBefore = S.TickNonce;
+		PP::Step(S, 999);
+		CHECK(S.Tick == TickBefore, "terminal state must freeze the tick");
+		CHECK(S.TickNonce == NonceBefore, "terminal state must freeze the nonce");
+	}
+
+	// --- serialization wire format (ODN-11): byte-level layout pin.
+	// The standalone counterpart of the UE SerializeVersioned test: magic
+	// "PPUE" little-endian + version + fields; capacity-guard returns 0.
+	{
+		PP::FSimState S;
+		S.Initialize(7);
+		PP::Step(S, 1);
+
+		uint8_t Buf[64];
+		const size_t N = PP::SerializeState(S, Buf, sizeof(Buf));
+		CHECK(N == 45, "serialized size must be 4+4+8+8+4+8+8+1 = 45");
+		CHECK(Buf[0] == 0x50 && Buf[1] == 0x50 && Buf[2] == 0x55 && Buf[3] == 0x45,
+			"magic bytes must spell 'PPUE' little-endian on the wire");
+		CHECK(Buf[4] == 1, "save version byte must be 1");
+		CHECK(Buf[8] == 7 && Buf[9] == 0, "seed must serialize little-endian (7 -> 07 00)");
+		CHECK(Buf[16] == 1 && Buf[17] == 0, "tick must serialize little-endian (1 -> 01 00)");
+
+		// capacity guard: too-small buffer returns 0, never writes
+		uint8_t Small[44];
+		CHECK(PP::SerializeState(S, Small, sizeof(Small)) == 0, "undersized buffer must return 0");
+
+		// round-trip stability
+		uint8_t Buf2[64];
+		const size_t N2 = PP::SerializeState(S, Buf2, sizeof(Buf2));
+		CHECK(N2 == N, "serialize length must be stable");
+		CHECK(std::memcmp(Buf, Buf2, N) == 0, "serialize bytes must be stable");
+	}
+
+	// --- the committed golden, asserted engine-free (must match
+	// docs/goldens/probe-seed42-ticks100.json — re-bless updates BOTH)
+	{
+		PP::FSimState State;
+		State.Initialize(42);
+		uint32_t First4[4] = {0, 0, 0, 0};
+		{
+			PP::FRng R;
+			PP::RngSeed(R, 42);
+			for (int I = 0; I < 4; ++I)
+			{
+				First4[I] = PP::RngNext(R);
+			}
+		}
+		State.Initialize(42);
+		for (uint64_t I = 1; I <= 100; ++I)
+		{
+			PP::Step(State, I);
+		}
+		const uint64_t Hash = PP::StateHash(State);
+		CHECK(State.TickNonce == 2381141952u, "golden tick_nonce must match the committed golden");
+		CHECK(Hash == 0xfbe6fae2655cadf7ull, "golden state_hash must match the committed golden");
+		const uint32_t GoldenFirst4[4] = {2399007886u, 4293122540u, 1743717038u, 2217374311u};
+		CHECK(std::memcmp(First4, GoldenFirst4, sizeof(First4)) == 0, "golden rng_first4 must match the committed golden");
+	}
+
+	// --- PPProbe-equivalent report (the commandlet's numbers, computed here)
+	PP::FSimState State;
+	State.Initialize(42);
+	uint32_t First4[4] = {0, 0, 0, 0};
+	{
+		PP::FRng R;
+		PP::RngSeed(R, 42);
+		for (int I = 0; I < 4; ++I)
+		{
+			First4[I] = PP::RngNext(R);
+		}
+	}
+	State.Initialize(42);
+	for (uint64_t I = 1; I <= 100; ++I)
+	{
+		PP::Step(State, I);
+	}
+	const uint64_t Hash = PP::StateHash(State);
+
+	if (argc > 1 && std::strcmp(argv[1], "--json") == 0)
+	{
+		std::printf("{\"seed\":42,\"ticks\":100,\"tick_nonce\":%u,\"state_hash\":\"%016llx\",\"rng_first4\":[%u,%u,%u,%u],\"save_magic\":\"PPUE\",\"save_version\":1}\n",
+			State.TickNonce, (unsigned long long)Hash,
+			First4[0], First4[1], First4[2], First4[3]);
+	}
+	else
+	{
+		std::printf("spine-check: seed=42 ticks=100 tick_nonce=%u state_hash=%016llx rng0=[%u %u %u %u]\n",
+			State.TickNonce, (unsigned long long)Hash,
+			First4[0], First4[1], First4[2], First4[3]);
+	}
+
+	if (Failures == 0)
+	{
+		if (argc > 1 && std::strcmp(argv[1], "--json") == 0)
+		{
+			std::fprintf(stderr, "spine-check: ALL GREEN\n");
+		}
+		else
+		{
+			std::printf("spine-check: ALL GREEN (%d checks executed)\n", Executions);
+		}
+		return 0;
+	}
+	std::fprintf(stderr, "spine-check: %d FAILURE(S) of %d checks\n", Failures, Executions);
+	return 1;
+}
