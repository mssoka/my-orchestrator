+#!/usr/bin/env bash
+# bin/vision-read — the screenshot-verification entry point (AGENTS.md,
+# docs/agent-playbook.md, docs/project-context.md).
+#
+# Reads <image> with a vision-capable model and answers <prompt>. This repo
+# ships NO local vision model; the contract is:
+#   1. A backend configured via VISION_READ_BACKEND=<cmd> (a command that
+#      accepts <image> <prompt> on argv) — this script execs it; or
+#   2. The pi/agent harness: open the image with the `read` tool — the
+#      model receives the pixels as an attachment.
+# Anything else exits 1 LOUDLY (never a silent pass, never a guessed
+# answer — flash/glm have no native vision).
+set -uo pipefail
+
+if [ $# -lt 1 ]; then
+  echo "usage: bin/vision-read <image> [prompt]" >&2
+  exit 2
+fi
+IMG="$1"
+shift
+PROMPT="${1:-describe the image contents}"
+
+if [ ! -f "$IMG" ]; then
+  echo "vision-read: no such image: $IMG" >&2
+  exit 1
+fi
+
+if [ -n "${VISION_READ_BACKEND:-}" ]; then
+  # shellcheck disable=SC2086 — documented as a single command path.
+  exec $VISION_READ_BACKEND "$IMG" "$PROMPT"
+fi
+
+cat >&2 <<'EOF'
+vision-read: no vision backend configured (VISION_READ_BACKEND unset).
+  - In pi/this harness: open the image with the `read` tool (the model
+    receives the image as an attachment) — never guess image content.
+  - Or set VISION_READ_BACKEND to a command that accepts <image> <prompt>,
+    e.g.  export VISION_READ_BACKEND="qwen-vl-run"
+EOF
+exit 1
