--- /dev/null
+++ b/Source/PacketPlumberCoreTests/PP_RngTests.cpp
@@ -0,0 +1,97 @@
+// PP_RngTests.cpp — ODN-9 conformance, UE automation side.
+// The SAME assertions live in tests/spine_check.cpp (standalone runner) —
+// the cross-language determinism contract. If the engine-side vectors ever
+// diverge from the standalone runner's, the port broke.
+#include "Misc/AutomationTest.h"
+
+#include "PacketPlumberCore/PP_Rng.h"
+
+#if WITH_DEV_AUTOMATION_TESTS
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPRngPinnedVectorsSeed0, "PacketPlumber.Determinism.RngPinnedVectorsSeed0",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPRngPinnedVectorsSeed0::RunTest(const FString &Parameters)
+{
+	// Seed 0's first 8 outputs — pinned from the Odin reference (core/rng_test.odin).
+	const uint32_t Expected[8] = {2196338726u, 1832588393u, 3253730937u, 2647056997u,
+								  2191141068u, 1480505347u, 3030956019u, 209995402u};
+	PP::FRng R;
+	PP::RngSeed(R, 0);
+	for (int32 I = 0; I < 8; ++I)
+	{
+		const uint32_t Got = PP::RngNext(R);
+		TestEqual(FString::Printf(TEXT("seed 0 output %d"), I), Got, Expected[I]);
+	}
+	return true;
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPRngPinnedVectorsSeed42, "PacketPlumber.Determinism.RngPinnedVectorsSeed42",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPRngPinnedVectorsSeed42::RunTest(const FString &Parameters)
+{
+	const uint32_t Expected[4] = {2399007886u, 4293122540u, 1743717038u, 2217374311u};
+	PP::FRng R;
+	PP::RngSeed(R, 42);
+	for (int32 I = 0; I < 4; ++I)
+	{
+		const uint32_t Got = PP::RngNext(R);
+		TestEqual(FString::Printf(TEXT("seed 42 output %d"), I), Got, Expected[I]);
+	}
+	return true;
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPRngRangeBounds, "PacketPlumber.Determinism.RngRangeBounds",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPRngRangeBounds::RunTest(const FString &Parameters)
+{
+	PP::FRng R;
+	PP::RngSeed(R, 7);
+	for (int32 I = 0; I < 10000; ++I)
+	{
+		const int32 V = PP::RngRange(R, 6, 34);
+		TestTrue(TEXT("rng_range must stay in [6,34]"), V >= 6 && V <= 34);
+		if (V < 6 || V > 34)
+		{
+			return false;
+		}
+	}
+	TestEqual(TEXT("degenerate span must return lo"), PP::RngRange(R, 5, 5), 5);
+	TestEqual(TEXT("inverted span must return lo"), PP::RngRange(R, 9, 3), 9);
+	return true;
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPRngStreamsIndependent, "PacketPlumber.Determinism.RngStreamsIndependent",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPRngStreamsIndependent::RunTest(const FString &Parameters)
+{
+	// same seed => identical stream (the determinism keystone)
+	PP::FRng A, B;
+	PP::RngSeed(A, 1337);
+	PP::RngSeed(B, 1337);
+	for (int32 I = 0; I < 100; ++I)
+	{
+		TestEqual(TEXT("same seed must reproduce the stream"), PP::RngNext(A), PP::RngNext(B));
+	}
+
+	// different seeds must diverge
+	PP::FRng C, D;
+	PP::RngSeed(C, 1);
+	PP::RngSeed(D, 2);
+	bool bSame = true;
+	for (int32 I = 0; I < 16; ++I)
+	{
+		if (PP::RngNext(C) != PP::RngNext(D))
+		{
+			bSame = false;
+			break;
+		}
+	}
+	TestFalse(TEXT("different seeds must diverge"), bSame);
+	return true;
+}
+
+#endif // WITH_DEV_AUTOMATION_TESTS
