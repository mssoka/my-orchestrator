+#!/usr/bin/env bash
+# scripts/format-check.sh — clang-format gate for Source/.
+# Prefers the engine-bundled clang-format (UE 5.8 ships one); falls back to
+# a system clang-format >= 14. Missing entirely -> SKIP with reason (never
+# a silent pass). Config: .clang-format at the repo root (UE defaults).
+set -uo pipefail
+
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+cd "$ROOT"
+
+FMT=""
+for cand in \
+  /Users/Shared/Epic\ Games/UE_5.8/Engine/Extras/ThirdPartyNotUE/CLang/bin/clang-format \
+  "$(command -v clang-format 2>/dev/null || true)"; do
+  if [ -n "$cand" ] && [ -x "$cand" ]; then
+    FMT="$cand"
+    break
+  fi
+done
+
+if [ -z "$FMT" ]; then
+  echo "SKIP: no clang-format found (engine not installed yet) — format gate deferred"
+  exit 0
+fi
+
+if ! "$FMT" --version | grep -qE "version (1[4-9]|[2-9][0-9])"; then
+  echo "SKIP: clang-format too old ($("$FMT" --version)) — need >= 14"
+  exit 0
+fi
+
+BAD=0
+while IFS= read -r f; do
+  if ! "$FMT" --dry-run --Werror "$f" >/dev/null 2>&1; then
+    echo "NOT FORMATTED: $f"
+    BAD=1
+  fi
+done < <(find Source -name '*.cpp' -o -name '*.h' | sort)
+
+[ "$BAD" -eq 1 ] && exit 1
+echo "format: all Source/ files clean ($FMT)"
+exit 0
