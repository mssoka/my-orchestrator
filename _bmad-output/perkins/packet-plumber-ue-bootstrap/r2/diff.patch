@@ -0,0 +1,31 @@
+// PP_Hash.h — FNV-1a-64, the state-hash + replay-equality primitive
+// (ODN-11 / core/hash.odin port, Packet-Plumber-UE).
+//
+// Pinned constants; identical on every target (the spine, ODN-10). The T1
+// golden (arch 10.2) is the FNV-1a-64 of the canonical serialized sim state;
+// the catalog hash is the FNV-1a-64 of the exact catalog bytes in force.
+// Same file policy as PP_Rng.h: no UE headers, compiles in the engine module
+// and the standalone spine-check runner.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace PP
+{
+
+inline constexpr uint64_t FNV64_OFFSET = 0xcbf29ce484222325ull; // FNV-1a 64-bit offset basis
+inline constexpr uint64_t FNV64_PRIME = 0x100000001b3ull;		// FNV-1a 64-bit prime
+
+inline uint64_t Fnv1a64(const uint8_t *Data, size_t Size)
+{
+	uint64_t H = FNV64_OFFSET;
+	for (size_t I = 0; I < Size; ++I)
+	{
+		H ^= static_cast<uint64_t>(Data[I]);
+		H *= FNV64_PRIME;
+	}
+	return H;
+}
+
+} // namespace PP
