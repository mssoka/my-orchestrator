+# scripts/lib/engine.sh — shared Unreal Engine discovery (W1).
+#
+# The single source of truth for finding the headless editor binary, used
+# by local-ci.sh, run-tests-headless.sh and install-engine.sh. Order:
+#   $UE_EDITOR_PATH -> $UE_ROOT -> the standard Epic install locations.
+# Source this file (it only defines functions), then call find_engine.
+#
+# Usage:
+#   source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/engine.sh"
+#   ENGINE_CMD="$(find_engine || true)"
+
+# Print the path to UnrealEditor-Cmd if an install is found, else nothing.
+find_engine() {
+  if [ -n "${UE_EDITOR_PATH:-}" ] && [ -x "$UE_EDITOR_PATH" ]; then
+    echo "$UE_EDITOR_PATH"
+    return 0
+  fi
+  if [ -n "${UE_ROOT:-}" ]; then
+    local cand="$UE_ROOT/Engine/Binaries/Mac/UnrealEditor-Cmd"
+    if [ -x "$cand" ]; then
+      echo "$cand"
+      return 0
+    fi
+  fi
+  local glob
+  for glob in /Users/Shared/Epic\ Games/UE_5.8/Engine/Binaries/Mac/UnrealEditor-Cmd \
+              /Users/Shared/Epic\ Games/UnrealEngine/5.8/Engine/Binaries/Mac/UnrealEditor-Cmd; do
+    if [ -x "$glob" ]; then
+      echo "$glob"
+      return 0
+    fi
+  done
+  return 1
+}
