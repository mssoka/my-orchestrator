+#!/usr/bin/env bash
+# scripts/install-engine.sh — UE 5.8.x presence check + the manual install
+# step (documented, not automated: the Epic Launcher requires an interactive
+# login; there is no scriptable engine-install path).
+#
+#   scripts/install-engine.sh          # status + instructions
+#   scripts/install-engine.sh --check  # exit 0 = engine usable, 1 = not yet
+set -uo pipefail
+
+# Shared find_engine (UE_EDITOR_PATH -> UE_ROOT -> standard Epic locations).
+source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/engine.sh"
+
+ENGINE_CMD="$(find_engine || true)"
+
+if [ "${1:-}" = "--check" ]; then
+  if [ -n "$ENGINE_CMD" ]; then
+    echo "engine found: $ENGINE_CMD"
+    exit 0
+  fi
+  echo "engine NOT found" >&2
+  exit 1
+fi
+
+if [ -n "$ENGINE_CMD" ]; then
+  echo "✅ Unreal Engine found: $ENGINE_CMD"
+  echo "   (set UE_EDITOR_PATH if it lives elsewhere)"
+  exit 0
+fi
+
+cat <<'EOF'
+❌ Unreal Engine 5.8.x is NOT installed on this machine.
+
+There is no scriptable engine install (the Epic Games Launcher requires an
+interactive login; source builds need Epic-linked GitHub access + a very
+long local build). The manual step is ~10 minutes of clicking + a large
+download (40-60 GB). Do this once:
+
+1. Install the launcher (one of):
+     brew install --cask epic-games
+   or download from https://store.epicgames.com/download
+
+2. Open "Epic Games Launcher", sign in, accept the EULA.
+
+3. Library → "Unreal Engine" → the version dropdown (top-right) →
+   "5.8.x" (latest 5.8 patch) → Install.
+   Default location: /Users/Shared/Epic Games/UE_5.8
+
+4. When the install finishes, open this repo and run:
+     scripts/local-ci.sh
+   The engine gates (build / tests / probe / golden) run automatically.
+
+5. Optional for the 5.9 upgrade path (see docs/research-report.md):
+   repeat step 3 for 5.9 when it releases (late 2026), then right-click
+   PacketPlumberUE.uproject → "Switch Unreal Engine version" → 5.9.
+
+Troubleshooting:
+- Installed elsewhere?  export UE_EDITOR_PATH=/path/to/UnrealEditor-Cmd
+- Right-click the .uproject → "Generate Xcode project" once to confirm the
+  project association + module wiring before the first CI run.
+EOF
+exit 1
