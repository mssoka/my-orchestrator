+	step_once(&s, cat)
+	bs, ok := bundles_slot_for_pair(&s.bundles, min(res, rt), max(res, rt))
+	testing.expectf(t, ok, "bundle exists")
+
+	// populate the ring
+	for tick in u64(1)..=u64(UTIL_WINDOW_TICKS) {
+		bundle_tx_record(&s.bundles, tick, bs, 1)
+	}
+	testing.expectf(t, bundle_tx_window(&s.bundles, u64(UTIL_WINDOW_TICKS), bs) == u64(UTIL_WINDOW_TICKS), "ring populated")
+
+	// a topology change rebuilds the view — bundle slots can renumber, so the
+	// ring MUST reset (a stale ring would misattribute history).
+	topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{rt, res, std}}, cat) // parallel pipe, same pair
+	step_once(&s, cat)
+	bs2, ok2 := bundles_slot_for_pair(&s.bundles, min(res, rt), max(res, rt))
+	testing.expectf(t, ok2, "bundle survives the rebuild")
+	testing.expectf(t, bundle_tx_window(&s.bundles, u64(UTIL_WINDOW_TICKS), bs2) == 0,
+		"rebuild resets the window (got %d)", bundle_tx_window(&s.bundles, u64(UTIL_WINDOW_TICKS), bs2))
+	testing.expectf(t, s.bundles.tx_slot_tick[int(bs2)*UTIL_WINDOW_TICKS] == 0,
+		"rebuild zeroes the slot ticks (stale ticks must not survive)")
+}
+
+@(test)
+test_bundle_tx_ring_bounds_and_no_write :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, bs := tx_ring_setup(cat)
+	defer run_destroy(&s)
+
+	// served == 0 never writes — the slot keeps its prior value.
+	bundle_tx_record(&s.bundles, 1, bs, 5)
+	bundle_tx_record(&s.bundles, 2, bs, 0)
+	testing.expectf(t, bundle_tx_window(&s.bundles, 2, bs) == 5, "served==0 is a no-write (got %d)", bundle_tx_window(&s.bundles, 2, bs))
+
+	// defensive bounds: an out-of-range bundle slot records nothing and reads 0.
+	bundle_tx_record(&s.bundles, 3, 9999, 7)
+	testing.expectf(t, bundle_tx_window(&s.bundles, 3, 9999) == 0, "out-of-range window reads 0")
+}
