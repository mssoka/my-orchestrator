index 00000000..5c63964e
--- /dev/null
+++ b/core/units.odin
@@ -0,0 +1,162 @@
+package core
+
+// units.odin — the network-unit canon (user ruling 2026-08-23: "rather than
+// units, use proper networking terms — Mbps/Kbps/Gbps capacity, bytes for
+// packet sizes; would help me understand as a network engineer"). The sim's
+// internal numbers are UNTOUCHED (isomorphic — see the job spec); this module
+// is the DERIVED mapping that makes every display speak network-native.
+//
+// The model: the game clock runs slowed vs the network-real clock by
+// SIM_TIME_SCALE (Mini-Motorways readable pace). A tier's line rate in real
+// bits/s is pinned by its OWN serialization delay — the game's
+// ceil(packet_bandwidth/cap) transit IS frame_bits/rate in disguise:
+//
+//     transit_ticks  = ceil(packet_bandwidth / capacity_units)
+//     rate_bps       = frame_bits × logic_hz × SIM_TIME_SCALE / transit_ticks
+//
+// SIM_TIME_SCALE is pinned by the MM-pace ruling (packet-plumber-v2-pace-
+// tuning, 2026-08-21): a standard pipe (cap 15) carries a 1500 B frame in
+// ~8 ticks. Standard = 100 Mbps (the briefing's distribution-tier number):
+//
+//     S = 100e6 × 8 / (12000 × 20) = 3333.33 → 3333
+//     (integer check: ceil(12000 × 20 × 3333 / 100e6) = ceil(7.9992) = 8 ✓)
+//
+// The tier rates THEN derive from the game's own transits — narrow 66.7
+// Mbps · standard 100 Mbps · wide 266.7 Mbps (display: 67 / 100 / 267).
+// The briefing's nominal 10/100/1000 Mbps ladder is arithmetically
+// incompatible with the fixed transits (see the spec's "RESOLUTION OF A
+// BRIEFING CONTRADICTION" — the hard rules win; documented in the PR body).
+//
+// HONEST UTILIZATION (the NOC bug fix): the ifHCOutOctets/ifSpeed pattern.
+// The link's transmission work = served bandwidth-units (what the serve
+// budget actually spent); octets transmitted = served × frame_bytes /
+// packet_bandwidth (12.5 B/unit at the 1500 B / 120 pace). Utilization =
+// served-over-the-window ÷ (line rate × window) — bounded at 100%, exactly
+// 100% at saturation, ~16% for a single residential stream on a standard
+// link, 0% for a lone queued packet (backlog ≠ utilization — queue depth is
+// its OWN signal).
+//
+// Integer-only (ODN-10); pure (no state, no I/O — ODN-1). All formatters
+// return temp-arena strings (the per-frame render convention).
+
+import "core:fmt"
+
+// SIM_TIME_SCALE — the game-clock dilation vs the network clock (3333: the
+// game shows 1 network-second as 3333 game-seconds — readable pace). Pinned
+// by the MM-pace ruling: standard 1500 B @ 100 Mbps = 8 ticks.
+SIM_TIME_SCALE :: 3333
+
+// FRAME_BYTES — the uniform frame size (1500 B standard MTU). Per-class
+// sizes (email 512 B, streaming ~9 KB jumbo) are the FOLLOW-UP knob — the
+// extension point is the tx-octet conversion below (served × frame/pb).
+FRAME_BYTES :: 1500
+
+// UTIL_WINDOW_TICKS — the utilization measurement window (240 ticks = 12 s
+// @ 20 Hz; 30 × the standard 8-tick serialization — exact integer math at
+// saturation, smooth readings for light streams). Same status as the health
+// window (a rolling measurement seam, documented in balance.json's era).
+UTIL_WINDOW_TICKS :: 240
+
+// transit_ticks — the serialization formula (the game's own): a frame takes
+// ceil(packet_bandwidth / capacity) ticks to cross a link of the given
+// capacity. The unit model's "frame_bits ÷ rate" in game ticks.
+transit_ticks :: proc(packet_bandwidth, capacity: u32) -> u32 {
+	if capacity == 0 {
+		return 1 // defensive — a zero-cap bundle never serves; avoid div-by-0
+	}
+	return (packet_bandwidth + capacity - 1) / capacity
+}
+
+// line_rate_bps — a link's line rate in REAL bits/s, derived from its own
+// serialization delay: frame_bits × logic_hz × SIM_TIME_SCALE / transit.
+// Standard (cap 15, pb 120, 20 Hz): 12000×20×3333/8 = 99,990,000 → "100
+// Mbps". A 2-member standard bundle (cap 30, transit 4): ~200 Mbps — pooled
+// capacity scales the rate (redundancy is active capacity, 2.1).
+line_rate_bps :: proc(packet_bandwidth, capacity: u32, logic_hz: i32) -> u64 {
+	t := u64(transit_ticks(packet_bandwidth, capacity))
+	if t == 0 {
+		return 0
+	}
+	return u64(FRAME_BYTES) * 8 * u64(logic_hz) * SIM_TIME_SCALE / t
+}
+
+// line_rate_bytes_per_tick — the same line rate in game ticks (bytes/tick =
+// frame_bytes / transit). The honest utilization reference (rate × window
+// in the ifHCOutOctets/ifSpeed pattern). Integer floor (standard: 187 of
+// 187.5 — the half-byte is display noise; the util formula below never
+// divides by it).
+line_rate_bytes_per_tick :: proc(packet_bandwidth, capacity: u32) -> u32 {
+	t := transit_ticks(packet_bandwidth, capacity)
+	if t == 0 {
+		return 0
+	}
+	return FRAME_BYTES / t
+}
+
+// served_to_octets — transmitted octets for a window's served bandwidth-
+// units (12.5 B/unit at the 1500 B / 120 pace). The ifHCOutOctets analog.
+served_to_octets :: proc(served_units: u64, packet_bandwidth: u32) -> u64 {
+	if packet_bandwidth == 0 {
+		return 0
+	}
+	return served_units * u64(FRAME_BYTES) / u64(packet_bandwidth)
+}
+
+// util_pct_window — HONEST utilization: served-units over the window ÷
+// (capacity × window), clamped 0..100. Never exceeds 100 (the serve budget
+// bounds the window's work); exactly 100 at saturation; 0 for a queued-but-
+// idle link (backlog ≠ utilization — the NOC bug fix).
+util_pct_window :: proc(served_units: u64, window_ticks, capacity: u32) -> u32 {
+	if window_ticks == 0 || capacity == 0 {
+		return 0
+	}
+	pct := served_units * 100 / (u64(window_ticks) * u64(capacity))
+	return u32(min(pct, 100))
+}
+
+// format_rate — a bit rate as an auto-scaled network-native label
+// (Kbps/Mbps/Gbps; rounded integers, one decimal for Gbps). ASCII (the HUD
+// text policy). Temp-arena string (the per-frame render convention).
+format_rate :: proc(bps: u64) -> string {
+	if bps >= 1_000_000_000 {
+		tenths := (bps + 50_000_000) / 100_000_000 // rounded 0.1 Gbps
+		return fmt.tprintf("%d.%d Gbps", tenths / 10, tenths % 10)
+	}
+	if bps >= 1_000_000 {
+		return fmt.tprintf("%d Mbps", (bps + 500_000) / 1_000_000)
+	}
+	if bps >= 1_000 {
+		return fmt.tprintf("%d Kbps", (bps + 500) / 1_000)
+	}
+	return fmt.tprintf("%d bps", bps)
+}
+
+// format_bytes — a byte count as an auto-scaled label (B/KiB/MiB, one
+// decimal). ASCII; temp-arena string.
+format_bytes :: proc(n: u64) -> string {
+	if n >= 1_048_576 {
+		tenths := (n * 10 + 524_288) / 1_048_576 // rounded 0.1 MiB
+		return fmt.tprintf("%d.%d MiB", tenths / 10, tenths % 10)
+	}
+	if n >= 1_024 {
+		tenths := (n * 10 + 512) / 1_024 // rounded 0.1 KiB
+		return fmt.tprintf("%d.%d KiB", tenths / 10, tenths % 10)
+	}
+	return fmt.tprintf("%d B", n)
+}
+
+// format_rate_compact — the tray-chip variant (the 96 px chip budget):
+// "67M" / "100M" / "267M" / "30K" / "1.1G". ASCII; temp-arena string.
+format_rate_compact :: proc(bps: u64) -> string {
+	if bps >= 1_000_000_000 {
+		tenths := (bps + 50_000_000) / 100_000_000
+		return fmt.tprintf("%d.%dG", tenths / 10, tenths % 10)
+	}
+	if bps >= 1_000_000 {
+		return fmt.tprintf("%dM", (bps + 500_000) / 1_000_000)
+	}
+	if bps >= 1_000 {
+		return fmt.tprintf("%dK", (bps + 500) / 1_000)
+	}
+	return fmt.tprintf("%d", bps)
+}
diff --git a/core/units_test.odin b/core/units_test.odin
new file mode 100644
index 00000000..c0d85788
--- /dev/null
+++ b/core/units_test.odin
@@ -0,0 +1,76 @@
+package core
+
+// units_test.odin — pins the network-unit canon (v2-network-units): the
+// SIM_TIME_SCALE derivation reproduces the game's own transit ticks, the
+// honest utilization formula is bounded + exact at saturation, and the
+// formatters speak network-native.
+
+import "core:testing"
+
+@(test)
+test_units_transit_and_rates :: proc(t: ^testing.T) {
+	// the serialization formula IS the game's transit (ceil(pb/cap)) — the
+	// unit model never changes it, it just names it.
+	testing.expect_value(t, transit_ticks(120, 10), u32(12)) // narrow
+	testing.expect_value(t, transit_ticks(120, 15), u32(8))  // standard
+	testing.expect_value(t, transit_ticks(120, 40), u32(3))  // wide
+	testing.expect_value(t, transit_ticks(120, 30), u32(4))  // 2-member standard bundle
+	testing.expect_value(t, transit_ticks(120, 0), u32(1))   // defensive
+
+	// the rates derive from the transits via SIM_TIME_SCALE — standard is
+	// EXACTLY the briefing's 100 Mbps pin (rounded); the ladder is the
+	// physics-consistent set (the spec's contradiction ruling).
+	// 12000 × 20 × 3333 / 8 = 99,990,000
+	testing.expect(t, line_rate_bps(120, 15, 20) == 99_990_000, "standard = 99.99 Mbps (the 100 Mbps pin, rounded for display)")
+	testing.expect(t, line_rate_bps(120, 10, 20) == 66_660_000, "narrow = 66.66 Mbps (derived from its 12-tick transit)")
+	testing.expect(t, line_rate_bps(120, 40, 20) == 266_640_000, "wide = 266.64 Mbps (derived from its 3-tick transit)")
+	testing.expect(t, line_rate_bps(120, 30, 20) == 199_980_000, "a 2-member standard bundle pools to ~200 Mbps")
+
+	// the game-scale line rate: frame_bytes / transit (bytes per tick)
+	testing.expect_value(t, line_rate_bytes_per_tick(120, 15), u32(187)) // 187.5 floors
+	testing.expect_value(t, line_rate_bytes_per_tick(120, 10), u32(125))
+	testing.expect_value(t, line_rate_bytes_per_tick(120, 40), u32(500))
+}
+
+@(test)
+test_units_honest_utilization :: proc(t: ^testing.T) {
+	// the bug: a lone QUEUED packet (backlog) is NOT utilization — 0 served
+	// units read 0%, never the old 800%-clamped-to-100.
+	testing.expect_value(t, util_pct_window(0, 240, 15), u32(0))
+
+	// saturation: a standard link serves its full budget every tick — the
+	// window's work = W × cap → exactly 100%.
+	testing.expect_value(t, util_pct_window(240 * 15, 240, 15), u32(100))
+	testing.expect_value(t, util_pct_window(240 * 7, 240, 7), u32(100)) // decayed legacy bundle
+
+	// a single residential stream on a standard link (1 frame / 48 ticks =
+	// 120 units per 48 ticks → 600 units per 240-tick window): ~16.7% —
+	// the acceptance's "single-stream reads well under 100%".
+	testing.expect_value(t, util_pct_window(600, 240, 15), u32(16))
+
+	// half load: 50% exactly.
+	testing.expect_value(t, util_pct_window(120 * 15, 240, 15), u32(50))
+
+	// the octet counter: served units × 1500 / 120 (12.5 B/unit)
+	testing.expect_value(t, served_to_octets(120, 120), u64(1500))
+	testing.expect_value(t, served_to_octets(600, 120), u64(7500))
+	testing.expect_value(t, served_to_octets(240*15, 120), u64(45_000)) // a saturated window = 45 KB
+}
+
+@(test)
+test_units_formatters :: proc(t: ^testing.T) {
+	testing.expect_value(t, format_rate(99_990_000), "100 Mbps")
+	testing.expect_value(t, format_rate(66_660_000), "67 Mbps")
+	testing.expect_value(t, format_rate(266_640_000), "267 Mbps")
+	testing.expect_value(t, format_rate(30_000), "30 Kbps")
+	testing.expect_value(t, format_rate(1_070_000_000), "1.1 Gbps")
+	testing.expect_value(t, format_bytes(1500), "1.5 KiB")
+	testing.expect_value(t, format_bytes(45_000), "43.9 KiB")
+	testing.expect_value(t, format_bytes(1_500_000), "1.4 MiB")
+	testing.expect_value(t, format_bytes(12), "12 B")
+	testing.expect_value(t, format_rate_compact(99_990_000), "100M")
+	testing.expect_value(t, format_rate_compact(66_660_000), "67M")
+	testing.expect_value(t, format_rate_compact(266_640_000), "267M")
+	testing.expect_value(t, format_rate_compact(30_000), "30K")
+	testing.expect_value(t, format_rate_compact(1_070_000_000), "1.1G")
+}
