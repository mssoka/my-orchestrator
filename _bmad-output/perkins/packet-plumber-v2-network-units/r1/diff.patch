+		return // defensive — sized at rebuild
+	}
+	if b.tx_slot_tick[s] != tick {
+		b.tx_slot_tick[s] = tick // stale slot: zero + rewrite
+		b.tx_served[s] = 0
+	}
+	b.tx_served[s] += served
