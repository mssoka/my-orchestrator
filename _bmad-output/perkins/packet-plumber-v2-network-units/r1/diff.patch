+// into its window slot (the honest transmitted-work counter). Called from
+// flow_step's serve pass once per bundle per tick (served == 0 skips — the
+// slot keeps its last value; the tick key makes staleness exact).
+bundle_tx_record :: proc(b: ^Bundles, tick: u64, bi: u32, served: u32) {
+	if served == 0 {
+		return
+	}
+	if int(bi) >= int(b.n) {
+		return // defensive — a vanished bundle never records
+	}
+	s := int(bi) * UTIL_WINDOW_TICKS + int(tick % UTIL_WINDOW_TICKS)
