+// utilization numerator). Pure read over the ring (stats_compute's call).
+bundle_tx_window :: proc(b: ^Bundles, tick: u64, bi: u32) -> u64 {
+	if int(bi) >= int(b.n) {
+		return 0
+	}
+	lo := u64(0)
+	if tick > UTIL_WINDOW_TICKS {
+		lo = tick - UTIL_WINDOW_TICKS // (tick-W, tick] — W ticks inclusive
+	}
+	sum: u64 = 0
+	base := int(bi) * UTIL_WINDOW_TICKS
+	for s in 0..<UTIL_WINDOW_TICKS {
+		st := b.tx_slot_tick[base + s]
+		if st > lo && st <= tick {
