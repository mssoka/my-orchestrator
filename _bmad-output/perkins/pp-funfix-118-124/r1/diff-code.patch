+@(test)
+test_health_meter_refill_streak_in_grace :: proc(t: ^testing.T) {
+	// The #124 recovery path: with the meter SCARRED (a spent drain episode)
+	// and a class breach-latched IN GRACE (no active drain), the meter heals
+	// +meter_refill_per_tick (1)/tick after meter_refill_streak_ticks (200)
