+	// coexist). Crafted-state staging (the test_health_win_lose_same_tick
+	// precedent): the narrow fixture is genuinely saturated, so the crafted
+	// latch/grace/meter state is the LIVE state, stepped naturally.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 42, cat.hash, TEST_LOGIC_HZ)
+	s.era = 3
+	health_narrow_fixture(&s, cat)
+	s.health_enabled = true
+	step_n(&s, 100, cat) // the fixture's breach is live by ~85 (the D-2 re-pin) — the latch is hot
+	stream := u16(1)
+	testing.expectf(t, s.health.breach[stream], "the fixture must be breach-latched before the craft")
+	// craft the scar: mid-drain meter, a fresh 300-tick grace, latch on
+	s.health.meter_pct = 55
+	s.health.grace[stream].grace_left = 300
+	s.health.no_drain_streak = 0
+	// ticks 101..~420: in grace, no drain — the streak builds to 200 (refill
+	// starts ~301) and the meter climbs +1/tick to the cap; the grace then
+	// expires ~400 and the drain resumes — refill and drain never coexist.
+	meters: [dynamic]u32
+	defer delete(meters)
+	for i in 0..<320 {
+		prev := s.health.meter_pct
+		step_n(&s, 1, cat)
+		append(&meters, s.health.meter_pct)
+		if s.health.meter_pct == prev + 1 {
+			testing.expectf(t, s.health.breach[stream],
+				"the refill must run while breach-latched-in-grace (tick %d)", s.tick)
+		}
+	}
+	// find the first refill tick: it must be >= 200 no-drain ticks after the
+	// craft (the streak gate) and climb EXACTLY 1/tick to the 100 cap.
+	first := -1
+	for m, i in meters {
+		if first < 0 && m > 55 {
+			first = i
+			testing.expectf(t, i + 1 >= 200,
+				"the refill must not start before the 200-tick streak (first move at tick %d)", i + 1)
+			testing.expectf(t, m == 56, "the refill must climb +1/tick, got %d", m)
+		}
+	}
+	testing.expectf(t, first >= 0, "the meter must refill while in grace (no move in 320 ticks)")
+	peak: u32 = 0
+	for m in meters {
+		if m > peak {
+			peak = m
+		}
+	}
+	testing.expectf(t, peak == 100,
+		"the scar must heal fully to the 100 cap before the expiry, peak %d", peak)
+	testing.expectf(t, meters[len(meters) - 1] < 100,
+		"the drain must have resumed after the expiry (the refill never coexists), got %d", meters[len(meters) - 1])
+	// the grace then expires under the sustained breach (~330): the drain
+	// resumes and the meter FALLS — refill and drain never coexist.
+	meter_before_expiry := s.health.meter_pct
+	for i := 0; i < 260 && !s.terminal; i += 1 {
+		step_n(&s, 1, cat)
+	}
+	testing.expectf(t, health_count_tag(s.events[:], EVENT_TAG_GRACE_EXPIRED) >= 1,
+		"the crafted grace must expire under the sustained breach")
+	testing.expectf(t, s.health.meter_pct < meter_before_expiry,
+		"the meter must drain again after the expiry (got %d >= %d)", s.health.meter_pct, meter_before_expiry)
+	testing.expectf(t, s.terminal && s.outcome == .Lost,
+		"the un-fixed breach must still lose (the tension is preserved)")
+}
