+	cat.packet_types[1].health_grace_ticks = 100 // the streaming grace: expiry ~185 (breach ~85)
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 42, cat.hash, TEST_LOGIC_HZ)
+	s.era = 3
+	health_narrow_fixture(&s, cat)
+	s.health_enabled = true
+	step_n(&s, 200, cat) // breach ~85 + grace 100 -> draining from ~185
+	testing.expectf(t, s.health.breach[1] && s.health.grace[1].grace_left == 0,
+		"streaming must be post-grace and draining")
+	testing.expectf(t, s.health.meter_pct < 100, "the meter must be mid-drain, got %d", s.health.meter_pct)
+	for i := 0; i < 40 && !s.terminal; i += 1 {
+		step_n(&s, 1, cat)
+		testing.expectf(t, s.health.no_drain_streak == 0,
+			"an active drain tick must reset the streak (tick %d, streak %d)", s.tick, s.health.no_drain_streak)
+	}
