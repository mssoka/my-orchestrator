+pub fn submit_button_renders_without_disabled_for_no_js_test() {
+  // Progressive enhancement: SSR must render the submit button ENABLED so
+  // the no-JS fallback can post (server-side consent validation is the
+  // authoritative gate); when JS runs, form.js's consent gate disables it
+  // on init. Regression pin for the hard-coded SSR `disabled` attribute
+  // that made no-JS submission impossible. Lustre renders attributes
+  // sorted by name, so the bug shape is
+  // `data-testid="submit-application" disabled type="submit"` — probe the
+  // window right after the testid, before the tag closes.
+  let vacancy = test_helpers.test_vacancy_row()
+  let html = form_view.view_application_page(vacancy, "")
+  let assert Ok(#(_, after)) =
+    string.split_once(html, "data-testid=\"submit-application\"")
+  // Probe the remainder of the button tag (up to its closing `>`), not a
+  // fixed-width window — a future attribute sorting between data-testid and
+  // disabled must not hide a regression, and a substring like
+  // `data-disabled-reason` must not false-positive.
+  let assert Ok(#(tag_tail, _)) = string.split_once(after, ">")
+  tag_tail
+  |> string.contains("disabled")
+  |> should.be_false
+}
