+// Group_Cluster_View — the DERIVED estate view: live terminals partitioned
+// into groups under radius adjacency (two terminals are group-adjacent when
+// their Euclidean distance <= radius_tiles). `id[slot]` = the cluster id (the
+// slot of the cluster's FIRST member — slot order, deterministic) and
+// `size[slot]` = the cluster's member count (0 for non-live / non-terminal
+// slots). Pure function of (topology, catalog) — seed-derived, never
+// serialized (replay recomputes it identically from the same topology; the T1
+// hash stays a function of the serialized state — the lane_caps precedent).
+Group_Cluster_View :: struct {
+	id:   [dynamic]u32,
+	size: [dynamic]u32,
+}
+
+// group_view_destroy — free the view's arrays (scratch-owned; the caller
+// built it on the temp allocator).
+group_view_destroy :: proc(v: ^Group_Cluster_View) {
+	delete(v.id)
+	delete(v.size)
+}
+
+// group_find — union-find find with path compression (the parent array is
+// scratch).
+group_find :: proc(parent: ^[dynamic]i32, x: i32) -> i32 {
+	root := x
+	for parent[root] != root {
+		root = parent[root]
+	}
+	cur := x
+	for parent[cur] != root {
+		next := parent[cur]
+		parent[cur] = root
+		cur = next
+	}
+	return root
+}
+
+// group_union — union two live terminal slots under radius adjacency. The
+// SMALLER root wins deterministically — the final cluster id is the smallest
+// member slot (slot order, insertion-stable — ODN-10).
+group_union :: proc(parent: ^[dynamic]i32, a, b: i32) {
+	ra := group_find(parent, a)
+	rb := group_find(parent, b)
+	if ra != rb {
+		if ra < rb {
+			parent[rb] = ra
+		} else {
+			parent[ra] = rb
+		}
+	}
+}
+
+// group_cluster_view_build — build the derived estate view (see
+// Group_Cluster_View). Pairwise union under radius adjacency in slot order
+// (deterministic — no map iteration, ODN-10), then compress + count. O(n²)
+// distance checks on a map of tens of terminals is trivial at 20 Hz. The
+// radius is the catalog's radius_tiles (the loader guarantees it exceeds the
+// E31 packing floor).
+group_cluster_view_build :: proc(t: ^Topology, cat: ^Catalogs,
+                                 alloc := context.temp_allocator) -> (v: Group_Cluster_View) {
+	n := len(t.node_alive)
+	v.id = make([dynamic]u32, n, n, alloc)
+	v.size = make([dynamic]u32, n, n, alloc)
+	parent := make([dynamic]i32, n, n, alloc)
+	defer delete(parent)
+	for i in 0..<n {
+		parent[i] = -1
+		if t.node_alive[i] && t.node_kind[i] == .Terminal {
+			parent[i] = i32(i)
+		}
+	}
+	radius := i64(cat.balance.growth_groups.radius_tiles)
+	r2 := radius * radius
+	for a in 0..<n {
+		if parent[a] < 0 {
+			continue
+		}
+		for b in a + 1..<n {
+			if parent[b] < 0 {
+				continue
+			}
+			d := t.node_pos[a] - t.node_pos[b]
+			if i64(d[0])*i64(d[0]) + i64(d[1])*i64(d[1]) <= r2 {
+				group_union(&parent, i32(a), i32(b))
+			}
+		}
+	}
+	// pass 1: count members per root (accumulates at the root slot)
+	for i in 0..<n {
+		if parent[i] < 0 {
+			continue
+		}
+		root := group_find(&parent, i32(i))
+		v.size[root] += 1
+	}
+	// pass 2: propagate the root's size + id to every member (dead slots stay 0)
+	for i in 0..<n {
+		if parent[i] < 0 {
+			continue
+		}
+		root := group_find(&parent, i32(i))
+		v.size[i] = v.size[root]
+		v.id[i] = u32(root)
+	}
+	return
+}
