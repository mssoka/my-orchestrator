+// test_groups_view_and_scale — the mechanism's pure pieces, unit-pinned (no
+// seed dependence): the derived cluster view partitions live terminals under
+// radius adjacency (sizes + first-member ids, slot order), and the director's
+// pick-scale formula gates on the estate threshold (min_members) and grows
+// with membership. These are the load-bearing invariants the flow-level pins
+// build on.
+@(test)
+test_groups_view_and_scale :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 1, cat.hash, TEST_LOGIC_HZ)
+	res_idx, _ := node_type_index(cat, "residential")
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	// three clustered residentials (all pairwise <= radius 5: a compact
+	// estate), one isolated residential far away, one router (a non-terminal
+	// must never join a cluster).
+	topology_spawn_node(&s.topology, res_idx, {13, 15}, cat) // 0
+	topology_spawn_node(&s.topology, res_idx, {16, 15}, cat) // 1 (3 tiles)
+	topology_spawn_node(&s.topology, res_idx, {14, 18}, cat) // 2 (~3.2 tiles)
+	topology_spawn_node(&s.topology, rt_idx, {20, 15}, cat)  // 3 (router)
+	topology_spawn_node(&s.topology, res_idx, {30, 25}, cat) // 4 (isolated, > 5 from all)
+
+	view := group_cluster_view_build(&s.topology, cat)
+	defer group_view_destroy(&view)
+	// the estate: slots 0,1,2 -> one cluster, id = 0 (the first member), size 3
+	testing.expectf(t, view.size[0] == 3 && view.id[0] == 0, "cluster member 0: size %d id %d (want 3/0)", view.size[0], view.id[0])
