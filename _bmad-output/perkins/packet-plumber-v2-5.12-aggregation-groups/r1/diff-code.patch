+	s.growth_enabled = true
+	run_growth(&s, 28*GROWTH_INTERVAL_TICKS, cat)
+
+	min_m := cat.balance.growth_groups.min_members
+	radius := i64(cat.balance.growth_groups.radius_tiles)
+	r2 := radius * radius
+	view := group_cluster_view_build(&s.topology, cat)
+	defer group_view_destroy(&view)
+	span := growth_connect_span(cat, 3)
+	spawns := 0
+	estate_seen := false
+	isolated_seen := false
+	compact_ok := true
