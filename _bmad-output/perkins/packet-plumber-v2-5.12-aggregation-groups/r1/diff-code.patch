+	topology_spawn_node(&s.topology, host_idx, {16, 15}, cat) // 1
+	topology_spawn_node(&s.topology, host_idx, {14, 18}, cat) // 2
+	topology_spawn_node(&s.topology, host_idx, {17, 18}, cat) // 3
+	// the isolated host (far from every estate member)
+	topology_spawn_node(&s.topology, host_idx, {30, 25}, cat) // 4
+	// four residential sinks (the streaming dst set — far apart, singletons)
+	topology_spawn_node(&s.topology, res_idx, {6, 8}, cat)   // 5
+	topology_spawn_node(&s.topology, res_idx, {26, 8}, cat)  // 6
+	topology_spawn_node(&s.topology, res_idx, {6, 22}, cat)  // 7
+	topology_spawn_node(&s.topology, res_idx, {26, 22}, cat) // 8
