+	testing.expectf(t, view.size[2] == 3 && view.id[2] == 0, "cluster member 2: size %d id %d (want 3/0)", view.size[2], view.id[2])
+	// the router is not a terminal — never a cluster member
+	testing.expectf(t, view.size[3] == 0 && view.id[3] == 0, "router must not join a cluster: size %d", view.size[3])
