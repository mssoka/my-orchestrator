+	testing.expect_value(t, group_pick_scale(cat, 1), i32(1000))
+	testing.expect_value(t, group_pick_scale(cat, 2), i32(1000))
+	testing.expect_value(t, group_pick_scale(cat, 3), i32(1500)) // 1000 + 2×250
+	testing.expect_value(t, group_pick_scale(cat, 4), i32(1750)) // 1000 + 3×250
+	testing.expect_value(t, group_pick_scale(cat, 8), i32(2750)) // 1000 + 7×250
