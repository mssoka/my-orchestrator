+	topology_spawn_node(&s.topology, res_idx, {26, 8}, cat)  // 6
+	topology_spawn_node(&s.topology, res_idx, {6, 22}, cat)  // 7
+	topology_spawn_node(&s.topology, res_idx, {26, 22}, cat) // 8
+	topology_spawn_node(&s.topology, res_idx, {10, 14}, cat) // 9
+	topology_spawn_node(&s.topology, res_idx, {22, 14}, cat) // 10
+	topology_spawn_node(&s.topology, res_idx, {10, 26}, cat) // 11
+	topology_spawn_node(&s.topology, res_idx, {22, 26}, cat) // 12
+	// each campus: 3 wide access drops to R1 (pipes 0..8 -> bundles 0..2)
+	campuses := []u32{2, 3, 4}
