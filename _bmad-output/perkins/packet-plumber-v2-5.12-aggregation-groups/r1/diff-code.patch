+	uplink_bundle := u32(NO_BUNDLE)
+	if b, ok := bundle_of_pipe(&s, 9); ok {
+		uplink_bundle = b
+	}
+	triggered_uplink := false
+	for tg in trigger_targets {
+		if tg == uplink_bundle {
+			triggered_uplink = true
+		}
+	}
