+// terminal to its credit rate and no weight can move the shares).
+// Deterministic for a fixed seed.
+run_estate_concentration :: proc(seed: u64, member_weight: i32, W: u64) -> (estate_share_permille: i64, total: u64) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	cat.balance.pool_max_packets = 100000 // the E22 backstop is not under test
+	cat.balance.growth_groups.member_weight_permille = member_weight
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, seed, cat.hash, TEST_LOGIC_HZ)
+	s.era = 3 // streaming (hosts) + email (res sinks) — the concentration subject is streaming
+	host_idx, _ := node_type_index(cat, "content_host")
+	res_idx, _ := node_type_index(cat, "residential")
