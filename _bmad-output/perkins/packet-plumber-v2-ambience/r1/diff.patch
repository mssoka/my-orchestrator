+# NEW: tools/build_ambience_loop.py
+#!/usr/bin/env python3
+"""Build the v2-ambience music bed from the vaulted source WAV.
+
+Source (NEVER committed — 35MB, vaulted locally):
+    /Users/moses/code/_local-refs/audio/Warm Analog Drift.wav
+    (PCM s16le 48kHz stereo, 184.16s; provenance + contract in the vault
+    README — Suno Premier, user-owned, perpetual commercial rights.)
+
+Output: assets/audio/ambience_loop.ogg (committed, ~0.9MB, vorbis 48kHz
+stereo, 125.6s) + a same-named .wav intermediate (24MB — delete it; it is
+the encode source, not a repo artifact).
+
+Seamless-loop design (numbers are DATA, re-derivable from the vault file):
+  - Window [A, B] = [41.4s, 167.0s] (125.6s). These two regions carry the
+    highest harmonic similarity in the track: 8s-window spectral cosine
+    similarity 0.76 (same pad/chord). A hard cut would click (waveform
+    cross-correlation across the wrap peaks at 0.25 — no beat-lockable
+    phrase boundary), so the wrap is crossfaded instead.
+  - Blend-at-end: the last X=7.75s of the loop are an equal-power (cosine)
+    crossfade of the window tail [B-X, B] (fading out) into the window head
+    [A, A+X] (fading in). At the wrap the file returns to its own head at
+    full level; the residual one-sample discontinuity measures 0.048 peak
+    (measured from this exact build) — inaudible on an ambient bed.
+
+Requires ffmpeg with a vorbis encoder (`-strict -2` for the experimental
+native encoder on homebrew builds).
+
+Run from the repo root:  python3 tools/build_ambience_loop.py
+"""
+import wave
+import numpy as np
+import subprocess
+import os
+
+SRC = "/Users/moses/code/_local-refs/audio/Warm Analog Drift.wav"
+OUT_WAV = "assets/audio/ambience_loop.wav"
+OUT_OGG = "assets/audio/ambience_loop.ogg"
+A = 41.4   # loop start (seconds in the source)
+B = 167.0  # loop end   (seconds in the source)
+XF = 7.75  # crossfade length (seconds)
+
+with wave.open(SRC, "rb") as w:
+    n_ch, samp_w, rate, n_frames = w.getnchannels(), w.getsampwidth(), w.getframerate(), w.getnframes()
+    raw = w.readframes(n_frames)
+
+data = np.frombuffer(raw, dtype=np.int16).astype(np.float32) / 32768.0
+stereo = data.reshape(-1, n_ch) if n_ch == 2 else np.column_stack([data, data])
+
+a = int(A * rate)
+b = int(B * rate)
+x = int(XF * rate)
+seg = stereo[a:b].copy()
+L = seg.shape[0]
+
+# equal-power cosine crossfade over the last X seconds: tail fades out,
+# head fades in — the file's own head, so the wrap lands on material that
+# just faded in (harmonically identical by construction).
+t = np.arange(x) / x
+fade_out = np.cos(0.5 * np.pi * t)[:, None]
+fade_in = np.sin(0.5 * np.pi * t)[:, None]
+seg[L - x:L] = seg[L - x:L] * fade_out + seg[:x] * fade_in
+
+# --- continuity checks (documented in assets/audio/README.md) -------------
+wrap_disc = np.max(np.abs(seg[L - 1] - seg[0]))
+mid_disc = np.max(np.abs(seg[L - x] - seg[L - x - 1]))
+print(f"loop {L/rate:.2f}s: wrap discontinuity {wrap_disc:.4f} peak, "
+      f"crossfade entry {mid_disc:.5f} peak")
+
+pcm = (np.clip(seg, -1.0, 1.0) * 32767.0).astype(np.int16)
+with wave.open(OUT_WAV, "wb") as w:
+    w.setnchannels(2)
+    w.setsampwidth(2)
+    w.setframerate(rate)
+    w.writeframes(pcm.tobytes())
+print(f"wrote {OUT_WAV} ({os.path.getsize(OUT_WAV)/1e6:.1f}MB — intermediate, "
+      f"delete after encode; never commit)")
+
+subprocess.run([
+    "ffmpeg", "-y", "-loglevel", "error",
+    "-i", OUT_WAV,
+    "-c:a", "vorbis", "-strict", "-2", "-q:a", "5",
+    OUT_OGG,
+], check=True)
+print(f"wrote {OUT_OGG} ({os.path.getsize(OUT_OGG)/1e6:.2f}MB)")
+
