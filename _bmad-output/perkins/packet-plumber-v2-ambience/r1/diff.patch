+// envelope, ever.
+bed_envelope_step :: proc(a: ^Audio, dt: f32) {
+	if !a.bed_on {
+		return
+	}
+	if a.bed_duck_t > 0 {
+		a.bed_duck_t = max(0, a.bed_duck_t - dt)
