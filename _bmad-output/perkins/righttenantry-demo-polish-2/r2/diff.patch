+//// Demo-mode PDF v4 `extras` payloads — the sections the audit report's
+//// executive summary, analyst's brief, category notes, recommendations and
+//// verification methodology read. Split out of `pdf_prebake.gleam` so the
+//// per-applicant demo craft lives apart from the bake tooling.
+////
+//// Depth target: the REAL staging reports (18-19 pages). Every section the
+//// real pipeline emits is populated here with demo-universe data — concerns
+//// and contradictions included (a flawless report is as unconvincing as a
+//// scanty one). All facts stay consistent with the client fixture stories
+//// (demo_fixtures.gleam / demo_store.gleam) and the rows in pdf_prebake.
+////
+//// Shape contract: matches what contract_v4's encoders emit (extras JSON is
+//// rendered directly by the Typst template — see extras-or() in
+//// audit_report.typ). Evidence excerpts with a "Key: Value" shape carry
+//// `structured: true` so the template bolds the key half.
+
+import gleam/json
+import gleam/list
+
+pub type Evidence {
+  Evidence(
+    source: String,
+    excerpt: String,
+    confidence: String,
+    structured: Bool,
+  )
+}
+
+/// Free-form quote evidence (rendered italic-quoted by the template).
+fn ev(source: String, excerpt: String, confidence: String) -> Evidence {
+  Evidence(source:, excerpt:, confidence:, structured: False)
+}
+
+/// "Key: Value" evidence (the template splits on ": " and bolds the key).
+fn ev_kv(
+  source: String,
+  key: String,
+  value: String,
+  confidence: String,
+) -> Evidence {
+  Evidence(
+    source:,
+    excerpt: key <> ": " <> value,
+    confidence:,
+    structured: True,
+  )
+}
+
+fn note(
+  rationale: String,
+  confidence: String,
+  evidence evidence: List(Evidence),
+) -> json.Json {
+  json.object([
+    #("rationale", json.string(rationale)),
+    #("confidence", json.string(confidence)),
+    #("checks_performed", json.array([], of: json.string)),
+    #(
+      "evidence",
+      json.array(evidence, of: fn(e) {
+        json.object([
+          #("source", json.string(e.source)),
+          #("excerpt", json.string(e.excerpt)),
+          #("confidence", json.string(e.confidence)),
+          #("structured", json.bool(e.structured)),
+        ])
+      }),
+    ),
+  ])
+}
+
+fn rec(
+  action: String,
+  reason: String,
+  priority: String,
+  category: String,
+) -> json.Json {
+  json.object([
+    #("action", json.string(action)),
+    #("reason", json.string(reason)),
+    #("priority", json.string(priority)),
+    #("category", json.string(category)),
+  ])
+}
+
+type ExtrasParts {
+  ExtrasParts(
+    insight: String,
+    notes: json.Json,
+    recs: List(json.Json),
+    checks: List(String),
+    low_confidence: List(String),
+  )
+}
+
+/// Credit-reference + RTB lines every report carries (mirrors the real
+/// pipeline's "What we didn't do" list; the credit check is the
+/// credit-check-out-of-scope note the report structure requires).
+fn base_checks() -> List(String) {
+  [
+    "Credit reference check (out of scope)",
+    "RTB tenancy registration lookup (not yet integrated)",
+    "Employer phone verification (no auto-dial integration)",
+  ]
+}
+
+/// Non-empty so the report's "Scoring priority" block renders (the template
+/// gates on `category_weights` presence, and the ordinal narrative — income
+/// + references heaviest — matches the Methodology page's prose).
+fn weights() -> json.Json {
+  json.object([
+    #("income_affordability", json.float(0.25)),
+    #("reference_verification", json.float(0.25)),
+    #("employment_stability", json.float(0.125)),
+    #("rental_history", json.float(0.125)),
+    #("application_completeness", json.float(0.125)),
+    #("red_flag_detection", json.float(0.125)),
+  ])
+}
+
+/// The v4 `extras` blob the report's executive summary + analyst's brief +
+/// category notes + recommendations + verification methodology read. Each
+/// applicant carries the SAME sections at the SAME depth as the real
+/// staging reports, populated with demo-universe facts.
+///
+/// `docs_processed` comes from the caller (pdf_prebake) so this module
+/// never imports the bake tooling back.
+pub fn extras_for(application_id: String, docs_processed: Int) -> String {
+  let parts = case application_id {
+    "a-aoife" -> aoife_parts()
+    "a-conor" -> conor_parts()
+    "a-marta" -> marta_parts()
+    "a-declan" -> declan_parts()
+    "a-sara" -> sara_parts()
+    "a-tom" -> tom_parts()
+    // Purged a-grace id -> a-grainne.
+    "a-grainne" -> grainne_parts()
+    "a-liam" -> liam_parts()
+    _ -> fallback_parts()
+  }
+  json.to_string(
+    json.object([
+      #("detailed_insight", json.string(parts.insight)),
+      #("category_notes", parts.notes),
+      #(
+        "verification_summary",
+        json.object([
+          #("documents_processed", json.int(docs_processed)),
+          #("documents_failed", json.int(0)),
+          #("checks_unavailable", json.array(parts.checks, of: json.string)),
+          #(
+            "low_confidence_areas",
+            json.array(parts.low_confidence, of: json.string),
+          ),
+        ]),
+      ),
+      #("recommendations", json.array(parts.recs, of: fn(r) { r })),
+      #("category_weights", weights()),
+    ]),
+  )
+}
+
+fn fallback_parts() -> ExtrasParts {
+  ExtrasParts(
+    insight: "This is synthetic demo data. The applicant's analysis follows the same pipeline as a real report.",
+    notes: json.object([]),
+    recs: [],
+    checks: base_checks(),
+    low_confidence: [],
+  )
+}
