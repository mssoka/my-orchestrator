+//// Demo report-data pin (fix 2): every baked demo report must carry the
+//// SAME sections at the SAME depth as the real staging reports — the
+//// sections the Typst template reads from the v4 `extras` payload. If a
+//// future edit thins a payload (drops the analyst's brief, empties the
+//// category notes, removes the credit-check note), this test goes red
+//// before the scanty PDF ships.
+////
+//// Structural pin only — the prose is demo craft, not asserted here.
+
+import demo/pdf_prebake
+import demo/pdf_report_data
+import gleam/dict.{type Dict}
+import gleam/dynamic/decode
+import gleam/json
+import gleam/list
+import gleam/string
+import gleeunit/should
+
+const all_applicants: List(String) = [
+  "a-aoife",
+  "a-conor",
+  "a-marta",
+  "a-declan",
+  "a-sara",
+  "a-tom",
+  "a-grainne",
+  "a-liam",
+]
+
+const canonical_slugs: List(String) = [
+  "income_affordability",
+  "employment_stability",
+  "rental_history",
+  "reference_verification",
+  "application_completeness",
+  "red_flag_detection",
+]
+
+const valid_confidences: List(String) = ["high", "medium", "low"]
+
+const valid_priorities: List(String) = ["high", "medium", "low"]
+
+type NoteShape {
+  NoteShape(rationale: String, confidence: String, evidence_count: Int)
+}
+
+type SummaryShape {
+  SummaryShape(checks: List(String), docs_processed: Int)
+}
+
+type ExtrasShape {
+  ExtrasShape(
+    insight: String,
+    notes: Dict(String, NoteShape),
+    rec_priorities: List(String),
+    weights_count: Int,
+    checks: List(String),
+    docs_processed: Int,
+  )
+}
+
+fn note_decoder() -> decode.Decoder(NoteShape) {
+  use rationale <- decode.field("rationale", decode.string)
+  use confidence <- decode.field("confidence", decode.string)
+  // Evidence items carry mixed value types (string excerpts + a bool
+  // `structured` flag); only the count matters for this pin.
+  use evidence <- decode.field("evidence", decode.list(decode.success(Nil)))
+  decode.success(NoteShape(
+    rationale:,
+    confidence:,
+    evidence_count: list.length(evidence),
+  ))
+}
+
+fn rec_decoder() -> decode.Decoder(String) {
+  decode.field("priority", decode.string, decode.success)
+}
+
+fn summary_decoder() -> decode.Decoder(SummaryShape) {
+  use checks <- decode.field("checks_unavailable", decode.list(decode.string))
+  use docs <- decode.field("documents_processed", decode.int)
+  decode.success(SummaryShape(checks:, docs_processed: docs))
+}
+
+fn extras_decoder() -> decode.Decoder(ExtrasShape) {
+  use insight <- decode.field("detailed_insight", decode.string)
+  use notes <- decode.field(
+    "category_notes",
+    decode.dict(decode.string, note_decoder()),
+  )
+  use recs <- decode.field("recommendations", decode.list(rec_decoder()))
+  use weights <- decode.field(
+    "category_weights",
+    decode.dict(decode.string, decode.float),
+  )
+  use summary <- decode.field("verification_summary", summary_decoder())
+  decode.success(ExtrasShape(
+    insight:,
+    notes:,
+    rec_priorities: recs,
+    weights_count: dict.size(weights),
+    checks: summary.checks,
+    docs_processed: summary.docs_processed,
+  ))
+}
+
+fn extras_for(app_id: String) -> ExtrasShape {
+  let docs = list.length(pdf_prebake.documents_for(app_id))
+  let raw = pdf_report_data.extras_for(app_id, docs)
+  case json.parse(from: raw, using: extras_decoder()) {
+    Ok(shape) -> shape
+    Error(_) -> panic as "demo extras decode failed"
+  }
+}
+
+/// Every applicant's extras carries every real-report section with
+/// substance — the same sections the 18-19 page staging exemplars show.
+pub fn every_demo_report_has_all_real_report_sections_test() {
+  list.each(all_applicants, fn(app_id) {
+    let extras = extras_for(app_id)
+
+    // Analyst's Brief — the long-form section (real reports run to pages).
+    let brief_long_enough = string.length(extras.insight) > 1200
+    brief_long_enough |> should.be_true
+
+    // Category Notes — all six canonical categories, each with a rationale,
+    // a valid confidence bucket, and at least one evidence item.
+    list.each(canonical_slugs, fn(slug) {
+      case dict.get(extras.notes, slug) {
+        Ok(note) -> {
+          let rationale_long_enough = string.length(note.rationale) > 80
+          rationale_long_enough |> should.be_true
+          list.contains(valid_confidences, note.confidence)
+          |> should.be_true
+          let has_evidence = note.evidence_count > 0
+          has_evidence |> should.be_true
+        }
+        _ -> should.fail()
+      }
+    })
+
+    // Recommended Next Steps — non-empty, with valid priority buckets.
+    let has_recs = list.length(extras.rec_priorities) >= 3
+    has_recs |> should.be_true
+    list.each(extras.rec_priorities, fn(priority) {
+      list.contains(valid_priorities, priority) |> should.be_true
+    })
+
+    // Scoring priority — non-empty category_weights so the Methodology
+    // page's priority block renders.
+    let has_weights = extras.weights_count > 0
+    has_weights |> should.be_true
+
+    // Verification summary — the credit-check-out-of-scope note is part of
+    // the real report structure ("What we didn't do"); every demo report
+    // must carry it, plus a processed-document count that matches the
+    // documents the bake feeds the snapshot.
+    list.contains(extras.checks, "Credit reference check (out of scope)")
+    |> should.be_true
+    extras.docs_processed
+    |> should.equal(list.length(pdf_prebake.documents_for(app_id)))
+  })
+}
