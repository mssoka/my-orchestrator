-fn leaderboard_entry(app: DemoApplication) -> LeaderboardEntry {
+/// overall_score of a DemoApplication (None when analysis pending).
+fn analysis_score(app: DemoApplication) -> Option(Int) {
+  case app.analysis {
+    Some(an) -> an.overall_score
+    None -> None
+  }
+}
+
+/// Order applications exactly like the real leaderboard SQL:
+/// `ORDER BY overall_score DESC NULLS LAST, created_at ASC, id ASC`.
+fn compare_apps(a: DemoApplication, b: DemoApplication) -> order.Order {
+  case analysis_score(a), analysis_score(b) {
+    None, None -> compare_apps_tiebreak(a, b)
+    None, Some(_) -> order.Gt
+    Some(_), None -> order.Lt
+    Some(x), Some(y) ->
+      case int.compare(y, x) {
+        order.Eq -> compare_apps_tiebreak(a, b)
+        other -> other
+      }
+  }
+}
+
+fn compare_apps_tiebreak(a: DemoApplication, b: DemoApplication) -> order.Order {
+  case string.compare(a.application.created_at, b.application.created_at) {
+    order.Eq -> string.compare(a.application.id, b.application.id)
+    other -> other
+  }
+}
+
+/// Assign competition ranks (1, 2, 3, 4, 4, 6, ...): consecutive entries
+/// that share a score share a rank, and the next distinct score jumps by
+/// the tie count. Entries with score None receive rank None — the input is
+/// expected to be sorted by score DESC NULLS LAST, so None values appear
+/// at the tail. Port of `vacancy/application_list_handler.gleam`
+/// `competition_ranks` so the demo's rank labels + Compare-top-3 gate
+/// behave exactly like the real app's.
+pub fn competition_ranks(
+  scores: List(Option(Int)),
+  start start: Int,
+) -> List(Option(Int)) {
+  do_competition_ranks(scores, start, None, None, [])
+  |> list.reverse
+}
+
+fn do_competition_ranks(
+  scores: List(Option(Int)),
+  position: Int,
+  prev_score: Option(Int),
+  prev_rank: Option(Int),
+  acc: List(Option(Int)),
+) -> List(Option(Int)) {
+  case scores {
+    [] -> acc
+    [None, ..rest] ->
+      do_competition_ranks(rest, position + 1, prev_score, prev_rank, [
+        None,
+        ..acc
+      ])
+    [Some(s), ..rest] -> {
+      let rank = case prev_score, prev_rank {
+        Some(ps), Some(pr) if ps == s -> pr
+        _, _ -> position
+      }
+      do_competition_ranks(rest, position + 1, Some(s), Some(rank), [
+        Some(rank),
+        ..acc
+      ])
+    }
+  }
+}
