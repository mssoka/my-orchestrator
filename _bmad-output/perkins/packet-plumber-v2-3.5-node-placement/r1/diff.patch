@@ -0,0 +1,259 @@
+package core
+
+// placement_test.odin — Story 3.5: player node placement (Cmd_Place_Router),
+// the edge-case contracts as durable tests. Pins:
+//   (a) validate_place: junction-kind-only (terminals never player-placed —
+//       5.1 canon), map bounds + min-separation (Invalid_Placement),
+//       unknown type;
+//   (b) apply_place: spawns a live junction, monotonic id (E11), gen bump
+//       (rule 1 — the routing-table rebuild trigger);
+//   (c) port limits (canon #14): a junction at port_capacity rejects further
+//       draws (.Router_Ports_Full); terminals are never port-limited; a
+//       demolished pipe frees its port;
+//   (d) replay-equality: a placement + draw in the action log replays
+//       byte-identically (E10);
+//   (e) the binary log round-trip carries Cmd_Place_Router, and a version-2
+//       log rejects cleanly (LOG_VERSION 3, the 1.2→2 precedent).
+
+import "core:testing"
+
+@(test)
+test_place_rejects_terminal_type :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, _, _ := topo_setup(t, cat)
+	defer run_destroy(&s)
+	res_type, _ := node_type_index(cat, "residential")
+	cmd := Command{apply_tick = 1, kind = Cmd_Place_Router{type_idx = res_type, pos = {24, 6}}}
+	_, err := topology_apply_edit(&s.topology, cmd, cat)
+	testing.expect(t, err == .Not_A_Junction, "a terminal type must not be placeable hardware (5.1 canon)")
+	testing.expectf(t, node_count(&s.topology) == 3, "a rejected placement must mutate nothing, got %d nodes", node_count(&s.topology))
+}
+
+@(test)
+test_place_rejects_unknown_type :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, _, _, _ := topo_setup(t, cat)
+	defer run_destroy(&s)
+	cmd := Command{apply_tick = 1, kind = Cmd_Place_Router{type_idx = 99, pos = {24, 6}}}
+	_, err := topology_apply_edit(&s.topology, cmd, cat)
+	testing.expect(t, err == .Unknown_Node_Type, "out-of-range type_idx must reject with .Unknown_Node_Type")
+	testing.expectf(t, node_count(&s.topology) == 3, "a rejected placement must mutate nothing, got %d nodes", node_count(&s.topology))
+}
+
+@(test)
+test_place_rejects_invalid_spots :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, _, _, _ := topo_setup(t, cat)
+	defer run_destroy(&s)
+	basic, _ := node_type_index(cat, "router_basic")
+	// too close to an existing node: fixture router at {20,15} — {22,15} is 2
+	// tiles away (< PLACEMENT_MIN_SEP_TILES = 7)
+	close_cmd := Command{apply_tick = 1, kind = Cmd_Place_Router{type_idx = basic, pos = {22, 15}}}
+	_, err := topology_apply_edit(&s.topology, close_cmd, cat)
+	testing.expect(t, err == .Invalid_Placement, "too-close spot must reject with .Invalid_Placement")
+	// off-map: outside the 40×30 grid
+	offmap := Command{apply_tick = 1, kind = Cmd_Place_Router{type_idx = basic, pos = {-2, 6}}}
+	_, err2 := topology_apply_edit(&s.topology, offmap, cat)
+	testing.expect(t, err2 == .Invalid_Placement, "off-map spot must reject with .Invalid_Placement")
+	offmap2 := Command{apply_tick = 1, kind = Cmd_Place_Router{type_idx = basic, pos = {40, 6}}}
+	_, err3 := topology_apply_edit(&s.topology, offmap2, cat)
+	testing.expect(t, err3 == .Invalid_Placement, "off-map (x = w_tiles) must reject with .Invalid_Placement")
+	testing.expectf(t, node_count(&s.topology) == 3, "rejected placements must mutate nothing, got %d nodes", node_count(&s.topology))
+}
+
+@(test)
+test_place_legal_applies :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, _, _, _ := topo_setup(t, cat)
+	defer run_destroy(&s)
+	basic, _ := node_type_index(cat, "router_basic")
+	gen_before := s.topology.gen
+	nodes_before := node_count(&s.topology)
+	// {24,6} clears the fixture (nearest node {20,15}: dx=4, dy=9 → 9.8 ≥ 7)
+	// and sits inside the 40×30 grid.
+	cmd := Command{apply_tick = 1, kind = Cmd_Place_Router{type_idx = basic, pos = {24, 6}}}
+	res, err := topology_apply_edit(&s.topology, cmd, cat)
+	testing.expectf(t, err == .None, "legal placement must apply, got %v", err)
+	testing.expect(t, res.ok, "legal placement returns ok")
+	testing.expectf(t, node_count(&s.topology) == nodes_before + 1, "placement must spawn a node, got %d nodes", node_count(&s.topology))
+	// the returned id is the new node's (monotonic, E11) + it is a live junction
+	slot, ok := node_slot(&s.topology, res.id)
+	testing.expect(t, ok, "placed node id must resolve")
+	testing.expect(t, s.topology.node_alive[slot], "placed node must be live")
+	testing.expect(t, s.topology.node_kind[slot] == .Junction, "placed node must be a junction")
+	testing.expectf(t, s.topology.node_pos[slot] == [2]i32{24, 6}, "placed node must sit at the requested tile")
+	testing.expectf(t, s.topology.node_type[slot] == basic, "placed node must carry the catalog type")
+	// gen bumps on placement (rule 1: a new node can open new paths)
+	testing.expectf(t, s.topology.gen == gen_before + 1, "placement must bump gen, got %d → %d", gen_before, s.topology.gen)
+}
