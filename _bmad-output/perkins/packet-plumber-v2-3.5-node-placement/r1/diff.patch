+@(test)
+test_place_command_binary_roundtrip :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	state: Run_State
+	defer run_destroy(&state)
+	run_init(&state, 42, cat.hash, TEST_LOGIC_HZ)
+	test_seed_fixture(&state, cat)
+	basic, _ := node_type_index(cat, "router_basic")
+	append(&state.action_log, Command{apply_tick = 1, kind = Cmd_Place_Router{type_idx = basic, pos = {24, 6}}})
+	append(&state.action_log, Command{apply_tick = 2, kind = Cmd_Place_Router{type_idx = basic, pos = {9, 27}}})
+
+	bytes := log_write(&state, context.temp_allocator)
+	header, cmds, ok := log_read(bytes, context.temp_allocator)
+	testing.expect(t, ok, "round-trip must parse")
+	testing.expect(t, header.seed == 42, "header seed mismatch")
+	testing.expectf(t, len(cmds) == 2, "command count: got %d, want 2", len(cmds))
+	for i in 0..<len(cmds) {
+		ca := cmds[i].kind.(Cmd_Place_Router)
+		cb := state.action_log[i].kind.(Cmd_Place_Router)
+		testing.expectf(t, ca.type_idx == cb.type_idx && ca.pos == cb.pos,
+			"cmd %d payload mismatch: {%d,%v} vs {%d,%v}", i, ca.type_idx, ca.pos, cb.type_idx, cb.pos)
+	}
+
+	// a version-2 log must reject cleanly (LOG_VERSION 3 — the 1.2→2 precedent:
+	// old logs are a defined rejection, never a silent partial parse)
+	v2 := make([]u8, len(bytes), context.temp_allocator)
+	copy(v2, bytes)
+	v2[4] = 2 // version field (second u32, little-endian)
+	v2[5], v2[6], v2[7] = 0, 0, 0
+	_, _, old := log_read(v2, context.temp_allocator)
+	testing.expect(t, !old, "a version-2 log must reject cleanly (LOG_VERSION 3)")
+}
