+test_placement_replays_byte_identical :: proc(t: ^testing.T) {
+	// the E10 keystone for placement: a Cmd_Place_Router in the action log must
+	// re-sim byte-identically from a fresh run + the same log (like draw).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	live: Run_State
+	defer run_destroy(&live)
+	run_init(&live, 42, cat.hash, TEST_LOGIC_HZ)
+	res, rt, host := test_seed_fixture(&live, cat)
+	basic, _ := node_type_index(cat, "router_basic")
+	std, _ := pipe_tier_index(cat, "standard")
+	append(&live.action_log, Command{apply_tick = 1, kind = Cmd_Place_Router{type_idx = basic, pos = {24, 6}}})
+	append(&live.action_log, Command{apply_tick = 50, kind = Cmd_Draw_Pipe{a = rt, b = 3, tier = std}})
+	append(&live.action_log, Command{apply_tick = 60, kind = Cmd_Draw_Pipe{a = 3, b = host, tier = std}})
+
+	live_hashes := record_run(&live, 300, cat)
+	defer delete(live_hashes)
+
+	testing.expectf(t, node_count(&live.topology) == 4, "placement must spawn a 4th node, got %d", node_count(&live.topology))
+	testing.expectf(t, pipe_count(&live.topology) == 2, "placed router must accept pipes, got %d pipes", pipe_count(&live.topology))
+	testing.expect(t, !live.replay_error, "live run must not latch replay_error")
+	_ = res
+
+	replayed: Run_State
+	defer run_destroy(&replayed)
