+	testing.expect(t, !replayed.replay_error, "replay must not latch replay_error (ODN-11 critical)")
+	testing.expectf(t, node_count(&replayed.topology) == 4, "replay must reproduce the placed node")
+	testing.expectf(t, len(live_hashes) == len(replay_hashes), "tick count mismatch: live %d vs replay %d", len(live_hashes), len(replay_hashes))
+	diverged := false
+	for i in 0..<len(live_hashes) {
+		if live_hashes[i] != replay_hashes[i] { diverged = true }
+	}
