@@ -0,0 +1,45 @@
+package render
+
+// tray.odin — the hardware tray (Story 3.5, ported from the prototype's
+// hud.odin). Chips: one per pipe tier (link chips — select the draw tier),
+// then one per junction node type (router chips — arm placement mode).
+// Bottom-center; the SAME rect math serves hit-testing in the app and the
+// draw here (single source, like the prototype). No inventory counts in v2
+// (the economy is a later story) — chips are mode selectors only.
+
+import rl "vendor:raylib"
+//
+// TRAY_CHIP_W/H — the chip box; TRAY_GAP — spacing. Mirrors the prototype's
+// constants so the port is faithful.
+
+TRAY_CHIP_W :: 96
+TRAY_CHIP_H :: 26
+TRAY_GAP    :: 8
+
+// tray_router_types — the junction node-type indices in catalog order (the
+// placeable hardware roster). Terminals are NEVER player-placed (story 5.1
+// canon) — junction kinds only.
+tray_router_types :: proc(v: ^View, out: []u16) -> int {
+	n := 0
+	for nt, i in v.catalogs.node_types {
+		if nt.kind == .Junction && n < len(out) {
+			out[n] = u16(i)
+			n += 1
+		}
+	}
+	return n
+}
+
+// tray_chip_count — link chips + router chips.
+tray_chip_count :: proc(v: ^View) -> int {
+	rts: [8]u16
+	return len(v.catalogs.pipe_tiers) + tray_router_types(v, rts[:])
+}
+
+// tray_chip_rect — the rect of chip i (link chips first, then router chips).
+tray_chip_rect :: proc(v: ^View, i: int) -> rl.Rectangle {
+	n := tray_chip_count(v)
+	total_w := f32(n*TRAY_CHIP_W + (n-1)*TRAY_GAP)
+	x0 := (f32(v.win_w) - total_w) / 2
+	return {x0 + f32(i) * (TRAY_CHIP_W + TRAY_GAP), f32(v.win_h) - TRAY_CHIP_H - 10, TRAY_CHIP_W, TRAY_CHIP_H}
+}
