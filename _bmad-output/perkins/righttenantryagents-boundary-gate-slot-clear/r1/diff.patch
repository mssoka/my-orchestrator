+            live,
+            review_key=STATE_FINAL_COMPLIANCE_REVIEW,
+            judge_kind="final",
+            dirty_review=dirty_review,
+        )
+        ctx = _DivergentCtx(live, run_node)
+
+        asyncio.run(agent_mod._run_final_compliance_gate(ctx))
+
+        # The clean verdict must NOT be dropped — symmetric with the boundary
+        # gate. Pre-fix the slot was never cleared → finalize read the stale
+        # dirty review (non-None) → bypassed the cross-check → fail-closed.
+        assert ctx.session.state.get(STATE_PIPELINE_ERROR) is None
