+# ──────────────────────────────────────────────────────────────────────────
+# Multi-attempt stale-dirty-slot (residual of #172, closed by #173)
+#
+# #173's defensive cross-check lives inside `if review is None:` in the
+# finalize guards, but the gate loops NEVER cleared the review slot between
+# attempts — so a dirty review from attempt 0 could survive a state-prop
+# failure on a clean attempt 1 and reach finalize as a NON-None dirty value,
+# bypassing the cross-check and fail-closing on stale data (dropping the
+# clean verdict — the #172 harm via the multi-attempt path). The fix: pop
+# the review slot at the top of each attempt so a lost clean write yields
+# None and falls into the EXISTING cross-check.
+#
+# These tests drive the REAL `_run_boundary_compliance_gate` /
+# `_run_final_compliance_gate` loops through the production state-view
+# divergence (`_DivergentCtx`). Attempt 0 writes a dirty review + dirty
+# stamp; attempt 1 models the lost-clean-write-while-stamp-lands window
+# (the triggering window Perkins flagged — see the reachability note on
+# `final_output`-read below). Without the per-attempt pop, finalize reads
+# the stale dirty review (non-None) and fail-closes — these tests FAIL. With
+# the pop, finalize sees None and the existing cross-check proceeds on the
+# clean stamp. This is the real wiring path, not a simulated bypass.
+# ──────────────────────────────────────────────────────────────────────────
+
+
+def _multi_attempt_judge_run_node(
+    live: dict, *, review_key: str, judge_kind: str, dirty_review: dict
+):
+    """A ``run_node`` modelling the #172-residual multi-attempt window.
+
+    Branches on the per-attempt meta the gate loop seeds before each
+    ``run_node``: attempt 0 commits a DIRTY review + dirty verdict stamp
+    (the judge's legitimate first pass); attempt 1 models the state-prop
+    failure — the clean ``output_key`` write is LOST (the review slot is left
+    untouched) while the clean verdict stamp LANDS (written from the judge's
+    OWN ctx, immune to the pipeline node's state-view bug). This is exactly
+    the window the per-attempt slot-clear protects against.
+    """
+
+    async def run(_ctx, _node) -> None:
+        attempt = _ctx.session.state[STATE_COMPLIANCE_JUDGE_META]["attempt"]
+        if attempt == 0:
+            live[review_key] = dirty_review
+            live[STATE_COMPLIANCE_REVIEW_VERDICT] = {
+                "judge_kind": judge_kind,
+                "passed": False,
+                "violation_count": 1,
+            }
+        else:
+            # Lost-clean-write window: the stamp LANDS, the review slot does NOT.
+            live[STATE_COMPLIANCE_REVIEW_VERDICT] = {
+                "judge_kind": judge_kind,
+                "passed": True,
+                "violation_count": 0,
+            }
+
+    return run
+
+
+async def _repair_pass_ok(*_args, **_kwargs) -> bool:
+    """Stub for ``_run_compliance_repair`` returning True.
+
+    The constrained repair pass is ORTHOGONAL to the slot-clear + cross-check
+    wiring under test here (a sibling function, not the gate loop itself).
+    Stubbing it True lets the loop reach the re-judge (attempt 1) without
+    exercising the unrelated repair agent — the same isolation the existing
+    #172 tests apply by stubbing the judge via ``_DivergentCtx.run_node``.
+    The REAL scrub + REAL finalize + REAL cross-check all still run, so the
+    slot-clear wiring is exercised end-to-end, not masked.
+    """
+    return True
+
+
+class TestBoundaryGateMultiAttemptStaleDirtySlot:
+    def test_lost_clean_write_does_not_drop_clean_verdict(self, monkeypatch):
+        monkeypatch.setattr(
+            agent_mod, "verification_compliance_judge_agent", lambda: object()
+        )
+        monkeypatch.setattr(agent_mod, "_run_compliance_repair", _repair_pass_ok)
+
+        dirty_review = {
+            "passed": False,
+            "violations": [
+                {
+                    "field": "personal_statement_verification.details",
+                    "ground": "gender",
+                    "span": "He pays rent reliably",
+                    "why": "gendered pronoun",
+                }
+            ],
+        }
+        live: dict = {}
+        run_node = _multi_attempt_judge_run_node(
+            live,
+            review_key=STATE_VERIFICATION_COMPLIANCE_REVIEW,
+            judge_kind="boundary",
+            dirty_review=dirty_review,
+        )
+        # The boundary scrub reads ``ctx.state`` (the stale snapshot); seed it
+        # with the flagged verifier output so scrub resolves the span and
+        # returns touched — letting the loop reach the re-judge (attempt 1).
+        # The snapshot stays stale w.r.t. the judge's run_node writes (the bug).
+        ctx = _DivergentCtx(
+            live,
+            run_node,
+            stale_seed={
+                STATE_PERSONAL_STATEMENT_VERIFICATION: {
+                    "details": "He pays rent reliably and is a great tenant."
+                }
+            },
+        )
+
+        asyncio.run(agent_mod._run_boundary_compliance_gate(ctx))
+
+        # The clean verdict must NOT be dropped: finalize sees a None review
+        # (slot cleared per-attempt + the clean write was lost) and the
+        # existing cross-check finds the clean stamp → scoring proceeds.
+        # Pre-fix the slot was never cleared → finalize read the stale dirty
+        # review (non-None) → bypassed the cross-check → fail-closed.
+        assert ctx.session.state.get(STATE_PIPELINE_ERROR) is None
+
+
