++	testing.expectf(t, len(EASE16) == 16, "EASE16 must be 16 entries (got %d)", len(EASE16))
++	testing.expectf(t, EASE16[0] == 0, "EASE16[0] must be 0 (tween-start continuity), got %v", EASE16[0])
++	testing.expectf(t, EASE16[15] == 1, "EASE16[15] must be 1 (exact arrival == raw bytes), got %v", EASE16[15])
++	mono := true
++	table := EASE16 // local copy — a constant can't be indexed by a runtime index
++	for i in 1..<len(table) {
++		if table[i] < table[i-1] {
++			mono = false
++		}
++	}
