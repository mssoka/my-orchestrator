++// gauge_tick — feed every gauge from live sim truth, once per stepped
++// tick. The raw derivations mirror the draws' own math (the displayed
++// LEVEL of each gauge; numbers/labels stay raw at the draw sites):
++//   health  — Health_State.meter_pct (0..100 by core);
++//   pool    — in-flight vs pool_max_packets, clamped to 0..100 (the bar
++//             level; the POOL n/n label keeps the exact count);
++//   SLA     — per-class avg latency ms + loss pct (the two strobing
++//             readouts; delivered/dropped counters are monotone truth and
++//             never ease).
++// Pure over the passed state (reads only; the sim is never touched).
++gauge_tick :: proc(v: ^View, tick: u64, health: ^pp.Health_State, flow: ^pp.Flow_State, cat: ^pp.Catalogs) {
++	gauge_target(v, &v.gauges.health, i32(health.meter_pct), tick)
++	cap := u32(max(1, cat.balance.pool_max_packets))
++	pool_pct := i32(min(u32(len(flow.packets)) * 100 / cap, 100))
++	gauge_target(v, &v.gauges.pool, pool_pct, tick)
++	for c in 0..<len(flow.sla) {
++		if c >= len(v.gauges.sla_ms) {
++			break // roster cap: beyond it the draw reads raw (the zero-value fallback)
++		}
++		acc := &flow.sla[c]
++		avg_ms: i32 = 0
++		if acc.delivered > 0 {
++			avg_ms = i32(acc.total_latency_ms / acc.delivered)
++		}
++		demand := acc.delivered + acc.dropped
++		loss: i32 = 0
++		if demand > 0 {
++			loss = i32(acc.dropped * 100 / demand)
++		}
++		gauge_target(v, &v.gauges.sla_ms[c], avg_ms, tick)
++		gauge_target(v, &v.gauges.sla_loss[c], loss, tick)
++	}
++}
