diff --git a/core/sound_events_test.odin b/core/sound_events_test.odin
new file mode 100644
index 0000000..c8f3e93
--- /dev/null
+++ b/core/sound_events_test.odin
@@ -0,0 +1,142 @@
+package core
+
+// sound_events_test.odin — v2-sound-immediacy (Perkins r1 warning 6): the two
+// new event tags (15 = PIPE_DRAWN, 16 = NODE_SPAWNED) pinned at the LOWEST
+// layer with NAMED assertions — the T1 goldens bite but localize nothing.
+// Positive legs name the tags + their exact ticks; the negative legs pin the
+// guard rails: a REJECTED draw command emits nothing, and a growth-DISABLED
+// run emits no NODE_SPAWNED. These are the W6 "core negative legs" that lift
+// the advisory gate's P0/P1 with blocker 1's exec-level pin.
+
+import "core:testing"
+
+// count_tag — how many events of `tag` sit in the run's event buffer.
+count_event_tag :: proc(state: ^Run_State, tag: u8) -> int {
+	n := 0
+	for e in state.events {
+		if e.tag == tag {
+			n += 1
+		}
+	}
+	return n
+}
+
+// step_logged — apply the action log's commands for tick N, then step N
+// (the pinned replay convention — record_run's shape, without the hash).
+step_logged :: proc(state: ^Run_State, tick: u64, cat: ^Catalogs) {
+	batch := make([dynamic]Command, 0, 4, context.temp_allocator)
+	for cmd in state.action_log {
+		if cmd.apply_tick == tick {
+			append(&batch, cmd)
+		}
+	}
+	step(state, tick, batch[:], cat)
+	free_all(context.temp_allocator)
+}
+
+// step_and_count_tag — step `ticks` ticks (record_run's shape) and return
+// how many events of `tag` were emitted ACROSS the whole run (record_run
+// clears the buffer per tick — a post-run count sees only the last tick's
+// events, which would miss mid-run emissions entirely).
+step_and_count_tag :: proc(state: ^Run_State, ticks: u64, cat: ^Catalogs, tag: u8) -> int {
+	n := 0
+	for tick in u64(1)..=ticks {
+		before := len(state.events)
+		step_logged(state, tick, cat)
+		for e in state.events[before:] {
+			if e.tag == tag {
+				n += 1
+			}
+		}
+		clear(&state.events)
+	}
+	return n
+}
+
+@(test)
+test_pipe_drawn_event_on_applied_draw :: proc(t: ^testing.T) {
+	// positive leg: a VALID draw applied at its apply_tick emits exactly one
+	// PIPE_DRAWN at that tick (tag 15, zero payload).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, _ := topo_setup(t, cat)
+	defer run_destroy(&s)
+
+	std, _ := pipe_tier_index(cat, "standard")
+	append(&s.action_log, Command{apply_tick = 3, kind = Cmd_Draw_Pipe{a = res, b = rt, tier = std}})
+
+	step_logged(&s, 3, cat)
+
+	testing.expectf(t, count_event_tag(&s, EVENT_TAG_PIPE_DRAWN) == 1,
+		"an applied draw must emit exactly one PIPE_DRAWN, got %d", count_event_tag(&s, EVENT_TAG_PIPE_DRAWN))
+	for e in s.events {
+		if e.tag == EVENT_TAG_PIPE_DRAWN {
+			testing.expectf(t, e.tick == 3, "PIPE_DRAWN tick %d, want the apply tick 3", e.tick)
+		}
+	}
+	testing.expectf(t, pipe_count(&s.topology) == 1, "the draw must apply (1 pipe), got %d", pipe_count(&s.topology))
+	testing.expect(t, !s.replay_error, "a valid draw must not latch replay_error")
+}
+
+@(test)
+test_pipe_drawn_absent_on_rejected_draw :: proc(t: ^testing.T) {
+	// negative leg: a draw that FAILS validation (terminal-to-terminal, E26)
+	// must emit NO PIPE_DRAWN — the event is the applied-draw witness, not a
+	// command-attempt echo.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, _, host := topo_setup(t, cat)
+	defer run_destroy(&s)
+
+	std, _ := pipe_tier_index(cat, "standard")
+	append(&s.action_log, Command{apply_tick = 3, kind = Cmd_Draw_Pipe{a = res, b = host, tier = std}})
+
+	step_logged(&s, 3, cat)
+
+	testing.expectf(t, count_event_tag(&s, EVENT_TAG_PIPE_DRAWN) == 0,
+		"a rejected draw must emit no PIPE_DRAWN, got %d", count_event_tag(&s, EVENT_TAG_PIPE_DRAWN))
+	testing.expectf(t, pipe_count(&s.topology) == 0, "a rejected draw must apply nothing, got %d pipes", pipe_count(&s.topology))
+	testing.expect(t, s.replay_error, "a rejected replayed command must latch replay_error")
+}
+
+@(test)
+test_node_spawned_event_on_growth :: proc(t: ^testing.T) {
+	// positive leg: a growth-enabled run emits NODE_SPAWNED at the growth
+	// tick (tag 16) — the reveal the spawn-feel telegraph announces. Long
+	// run (20 windows) so spawns are certain despite rejection sampling
+	// (the test_growth_e31_validity shape).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, _, _, _ := topo_setup(t, cat)
+	defer run_destroy(&s)
+	s.era = 3
+	s.growth_enabled = true
+
+	interval := cat.balance.terminal_spawn_interval_ticks
+	spawns := step_and_count_tag(&s, 20 * interval, cat, EVENT_TAG_NODE_SPAWNED)
+
+	testing.expectf(t, spawns >= 1, "a growing run must emit NODE_SPAWNED, got %d", spawns)
+}
+
+@(test)
+test_node_spawned_absent_with_growth_off :: proc(t: ^testing.T) {
+	// negative leg: growth DISABLED (the zero value — every legacy run)
+	// emits no NODE_SPAWNED even across many ticks.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, _, _, _ := topo_setup(t, cat)
+	defer run_destroy(&s)
+	s.era = 3
+	// growth_enabled stays false
+
+	interval := cat.balance.terminal_spawn_interval_ticks
+	spawns := step_and_count_tag(&s, 2 * interval, cat, EVENT_TAG_NODE_SPAWNED)
+
+	testing.expectf(t, spawns == 0,
+		"a growth-off run must emit no NODE_SPAWNED, got %d", spawns)
+	testing.expectf(t, node_count(&s.topology) == 3, "growth-off must keep the 3-node fixture, got %d", node_count(&s.topology))
+}
