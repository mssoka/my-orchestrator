diff --git a/app/input/exec_test.odin b/app/input/exec_test.odin
new file mode 100644
index 0000000..664c133
--- /dev/null
+++ b/app/input/exec_test.odin
@@ -0,0 +1,167 @@
+package input
+
+// exec_test.odin — v2-sound-immediacy: the exec-level pin for the live
+// fast-path PIPE_DRAWN append (Perkins r1 blocker 1 — the wiring shipped
+// unpinned: parity nils sim_events on purpose, goldens drive step's batch
+// path, live passes {} to step, and NO test drove commit_draw — deleting the
+// append was CI-silent, killing the shipped wire click AND the live-side
+// witness of the ODN-14 byte-identity claim). The settings_effect_wiring
+// precedent: drive the REAL proc (commit_draw, package-private — hence this
+// test lives in package input), assert the exact event.
+//
+// Fixture: a minimal 3-node topology (two terminals + one junction) + a
+// minimal catalog (one pipe tier, junction port capacity, the QoS ladder's
+// first row). Deterministic; no raylib device needed.
+
+import "core:testing"
+import pp "../../core"
+
+// TEST_LOGIC_HZ — the pinned 20 Hz logic rate (matches core's TEST_LOGIC_HZ;
+// the value is a catalog/run-setup field here, not a shared constant).
+TEST_LOGIC_HZ :: 20
+
+// wire_test_cat — the minimal catalog commit_draw's validate/apply path
+// needs: one pipe tier (max_span admits the fixture's short spans), the
+// fixture's node types (junction with ports + terminals), and the
+// auto_ladder first row (qos_unconfigured_weights reads [0][0]).
+wire_test_cat :: proc(cat: ^pp.Catalogs) {
+	cat^ = {}
+	cat.balance.map_w_tiles = 64
+	cat.balance.map_h_tiles = 36
+	cat.balance.auto_ladder[0][0] = 100 // Standard lane 100% — the unconfigured default
+	append(&cat.pipe_tiers, pp.Pipe_Tier{id = "test", display = "test", max_span = 20, cost_per_tile = 1})
+	append(&cat.node_types,
+		pp.Node_Type{id = "residential", display = "res", kind = .Terminal, terminal_role = .Residential, port_capacity = 0},
+		pp.Node_Type{id = "router_basic", display = "rt", kind = .Junction, port_capacity = 4},
+		pp.Node_Type{id = "content_host", display = "host", kind = .Terminal, terminal_role = .Content_Host, port_capacity = 0},
+	)
+}
+
+// wire_test_topo — a 3-node fixture: residential(0) ← router(1) → host(2).
+// The fixture shape mirrors the harness's seed_fixture ids (node ids are
+// monotonic spawn order — E11).
+wire_test_topo :: proc(t: ^pp.Topology, cat: ^pp.Catalogs) {
+	t^ = {}
+	pp.topology_spawn_node(t, 0, {8, 15}, cat)  // residential -> id 0
+	pp.topology_spawn_node(t, 1, {14, 15}, cat) // router     -> id 1
+	pp.topology_spawn_node(t, 2, {20, 15}, cat) // host       -> id 2
+}
+
+@(test)
+test_commit_draw_emits_pipe_drawn_event :: proc(t: ^testing.T) {
+	cat_storage: pp.Catalogs
+	cat := &cat_storage
+	wire_test_cat(cat)
+	defer pp.catalogs_destroy(cat)
+
+	// Run_State (not a bare Topology) so run_destroy frees the applied
+	// pipe's QoS weights — the ODN-18 arena discipline.
+	st: pp.Run_State
+	pp.run_init(&st, 42, cat.hash, TEST_LOGIC_HZ)
+	defer pp.run_destroy(&st)
+	wire_test_topo(&st.topology, cat)
+
+	log: [dynamic]pp.Command
+	defer delete(log)
+	events: [dynamic]pp.Event
+	defer delete(events)
+
+	ictx: Input
+	ictx.topo = &st.topology
+	ictx.cat = cat
+	ictx.log = &log
+	ictx.sim_events = &events
+	ictx.tick = 7 // arbitrary — the event must carry apply_tick = tick + 1 = 8
+
+	// a valid draw: residential(0) -> router(1) on tier 0 (the only tier).
+	ictx.drag = {active = true, from_node = 0, wx = 8 * f32(cat.balance.tile_px), wy = 15 * f32(cat.balance.tile_px), valid = .None, placing = -1}
+	ictx.drag_to = 1
+	ictx.tier = 0
+
+	commit_draw(&ictx)
+
+	testing.expectf(t, len(events) == 1, "exactly one PIPE_DRAWN event, got %d", len(events))
+	if len(events) == 1 {
+		testing.expect_value(t, events[0].tag, pp.EVENT_TAG_PIPE_DRAWN)
+		testing.expectf(t, events[0].tick == 8, "event tick %d, want apply_tick 8 (inp.tick+1)", events[0].tick)
+	}
+	// the command is logged at the same apply_tick (the byte-identity twin).
+	testing.expectf(t, len(log) == 1, "one logged draw command, got %d", len(log))
+	if len(log) == 1 {
+		testing.expect_value(t, log[0].apply_tick, u64(8))
+	}
+	// the topology actually gained the pipe (the event is not a stray).
+	testing.expectf(t, len(st.topology.pipe_alive) == 1, "the draw must apply, got %d pipes", len(st.topology.pipe_alive))
+}
+
+@(test)
+test_commit_draw_invalid_emits_nothing :: proc(t: ^testing.T) {
+	cat_storage: pp.Catalogs
+	cat := &cat_storage
+	wire_test_cat(cat)
+	defer pp.catalogs_destroy(cat)
+
+	st: pp.Run_State
+	pp.run_init(&st, 42, cat.hash, TEST_LOGIC_HZ)
+	defer pp.run_destroy(&st)
+	wire_test_topo(&st.topology, cat)
+
+	log: [dynamic]pp.Command
+	defer delete(log)
+	events: [dynamic]pp.Event
+	defer delete(events)
+
+	ictx: Input
+	ictx.topo = &st.topology
+	ictx.cat = cat
+	ictx.log = &log
+	ictx.sim_events = &events
+	ictx.tick = 7
+
+	// an INVALID draw: terminal-to-terminal (residential(0) -> host(2)) — the
+	// E26 rejection. commit_draw must emit NOTHING (no event, no log entry).
+	ictx.drag = {active = true, from_node = 0, wx = 8 * f32(cat.balance.tile_px), wy = 15 * f32(cat.balance.tile_px), valid = .None, placing = -1}
+	ictx.drag_to = 2
+	ictx.tier = 0
+
+	commit_draw(&ictx)
+
+	testing.expectf(t, len(events) == 0, "invalid draw must emit no event, got %d", len(events))
+	testing.expectf(t, len(log) == 0, "invalid draw must not log a command, got %d", len(log))
+	testing.expectf(t, len(st.topology.pipe_alive) == 0, "invalid draw must not apply, got %d pipes", len(st.topology.pipe_alive))
+}
+
+// test_commit_draw_no_sim_events — the nil-safety leg: a caller that never
+// wired sim_events (parity) must not crash and must not emit anything — the
+// event feed is app-only.
+@(test)
+test_commit_draw_nil_sim_events :: proc(t: ^testing.T) {
+	cat_storage: pp.Catalogs
+	cat := &cat_storage
+	wire_test_cat(cat)
+	defer pp.catalogs_destroy(cat)
+
+	st: pp.Run_State
+	pp.run_init(&st, 42, cat.hash, TEST_LOGIC_HZ)
+	defer pp.run_destroy(&st)
+	wire_test_topo(&st.topology, cat)
+
+	log: [dynamic]pp.Command
+	defer delete(log)
+
+	ictx: Input
+	ictx.topo = &st.topology
+	ictx.cat = cat
+	ictx.log = &log
+	// sim_events deliberately nil (the parity drive's shape)
+	ictx.tick = 3
+
+	ictx.drag = {active = true, from_node = 0, wx = 8 * f32(cat.balance.tile_px), wy = 15 * f32(cat.balance.tile_px), valid = .None, placing = -1}
+	ictx.drag_to = 1
+	ictx.tier = 0
+
+	commit_draw(&ictx)
+
+	testing.expectf(t, len(log) == 1, "the command still logs without sim_events, got %d", len(log))
+	testing.expectf(t, len(st.topology.pipe_alive) == 1, "the draw still applies without sim_events, got %d", len(st.topology.pipe_alive))
+}
