+chime_append :: proc(out: ^[dynamic]f32, f_thump, tau_thump, amp_thump: f32,
+                     f_body, tau_body, amp_body: f32,
+                     f_tick, tau_tick, amp_tick: f32, dur_s: f32) {
+	n := int(dur_s * SYNTH_SAMPLE_RATE)
+	ramp := max(1, SYNTH_RAMP_SAMPLES)
+	dt := f32(1) / SYNTH_SAMPLE_RATE
+	phase_thump: f32 = 0
+	phase_body: f32 = 0
+	phase_tick: f32 = 0
+	for i in 0..<n {
