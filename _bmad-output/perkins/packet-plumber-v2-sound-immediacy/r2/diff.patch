+		testing.expectf(t, a.pending.wire_variant >= 0 && a.pending.wire_variant < WIRE_VARIANTS,
+			"wire variant %d out of range", a.pending.wire_variant)
+	}
+	for i in 0..<10 {
+		consumer_consume(&a, []pp.Event{{tick = u64(3000 + i), tag = pp.EVENT_TAG_NODE_SPAWNED}}, nil)
+		testing.expectf(t, a.pending.spawn_variant >= 0 && a.pending.spawn_variant < SPAWN_VARIANTS,
+			"spawn variant %d out of range", a.pending.spawn_variant)
+	}
+}
+
+@(test)
+test_consumer_wire_draw :: proc(t: ^testing.T) {
+	a: Audio
+	consumer_init(&a)
+	ev := []pp.Event{{tick = 100, tag = pp.EVENT_TAG_PIPE_DRAWN}}
+	consumer_consume(&a, ev, nil)
+	testing.expectf(t, a.wire_draws == 1, "wire_draws %d, want 1", a.wire_draws)
+	testing.expectf(t, a.pending.wire_plays == 1, "wire_plays %d, want 1", a.pending.wire_plays)
+	testing.expectf(t, a.pending.wire_variant >= 0 && a.pending.wire_variant < WIRE_VARIANTS,
+		"wire_variant %d out of range", a.pending.wire_variant)
+	testing.expectf(t, a.crisis_draws == 0 && a.arrival_draws == 0 && a.spawn_draws == 0,
+		"wire draw must not move the other kinds' counters")
+}
+
+@(test)
+test_consumer_spawn_draw :: proc(t: ^testing.T) {
+	a: Audio
+	consumer_init(&a)
+	ev := []pp.Event{{tick = 100, tag = pp.EVENT_TAG_NODE_SPAWNED}}
+	consumer_consume(&a, ev, nil)
+	testing.expectf(t, a.spawn_draws == 1, "spawn_draws %d, want 1", a.spawn_draws)
+	testing.expectf(t, a.pending.spawn_plays == 1, "spawn_plays %d, want 1", a.pending.spawn_plays)
+	testing.expectf(t, a.pending.spawn_variant >= 0 && a.pending.spawn_variant < SPAWN_VARIANTS,
+		"spawn_variant %d out of range", a.pending.spawn_variant)
+	testing.expectf(t, a.crisis_draws == 0 && a.arrival_draws == 0 && a.wire_draws == 0,
+		"spawn draw must not move the other kinds' counters")
 }
