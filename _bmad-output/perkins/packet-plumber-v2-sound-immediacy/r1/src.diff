@@ -315,6 +315,13 @@ commit_draw :: proc(inp: ^Input) {
 		cmd := pp.Cmd_Draw_Pipe{a = inp.drag.from_node, b = inp.drag_to, tier = inp.tier}
 		if _, err := pp.topology_apply_edit(inp.topo, pp.Command{1, cmd}, inp.cat); err == .None {
 			append(inp.log, pp.Command{apply_tick = inp.tick + 1, kind = cmd})
+			// v2-sound: the live fast-path twin of step's PIPE_DRAWN emission —
+			// the SAME event at the SAME apply_tick (inp.tick + 1), so live and
+			// replay event streams stay byte-identical (ODN-14). The audio
+			// consumer picks it up on the next frame's drain (≤ 1 frame later).
+			if inp.sim_events != nil {
+				append(inp.sim_events, pp.Event{tick = inp.tick + 1, tag = pp.EVENT_TAG_PIPE_DRAWN})
+			}
 			if inp.on_draw_commit != nil { inp.on_draw_commit(inp.user, inp) }
 		}
 	}
