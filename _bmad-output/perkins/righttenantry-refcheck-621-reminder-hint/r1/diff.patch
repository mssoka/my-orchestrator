+/// #621: a taken-over contact_initiated row must NOT promise a future
+/// automated reminder. The cadence sweep excludes taken-over rows
+/// (`sweep_due_reference_calls.sql` keeps `taken_over_at IS NULL`), so the
+/// "Next reminder in ~2 days" hint would be a promise the system never
+/// keeps — the takeover toast already says "automated messages stopped", and
+/// the attempt-log hint must agree. The timeline itself still renders (the
+/// invite + takeover events stay visible); only the future-promise hint is
+/// dropped.
+pub fn taken_over_row_hides_next_reminder_hint_test() {
+  let taken =
+    reference_call.ReferenceCallDetail(
+      ..contact_row("rc-1", ContactInitiated),
+      taken_over_at: Some("2026-08-03T08:00:00Z"),
+      attempt_log: [
+        reference_call.AttemptLogEntry(
+          kind: "invitation_sent",
+          at: "2026-08-01T10:04:00Z",
+          channel: "email",
+          outcome: "delivered",
+          detail: "",
+        ),
+        reference_call.AttemptLogEntry(
+          kind: "taken_over",
+          at: "2026-08-03T08:00:00Z",
+          channel: "",
+          outcome: "",
+          detail: "",
+        ),
+      ],
+    )
+  let html =
+    render_with_actions(
+      calls: [taken],
+      off: False,
+      attestation_on_file: False,
+      expanded: ["rc-1"],
+      menu_open: None,
+      confirm: None,
+      edit: dict.new(),
+      inflight: [],
+    )
+  // The takeover surface renders…
+  html
+  |> string.contains("refcheck-taken-over-landlord_ref")
+  |> should.be_true
+  html |> string.contains("You&#39;re handling this one") |> should.be_true
+  // …and the reminder promise is gone.
+  html
+  |> string.contains("Next reminder in ~2 days if there&#39;s no reply")
+  |> should.be_false
+}
