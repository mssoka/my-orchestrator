+Key_Press :: struct {
+	key: Key,
+}
+
+Mouse_Press :: struct {
+	pos:    rl.Vector2,
+	button: Mouse_Button,
+}
+
+Mouse_Release :: struct {
+	pos:    rl.Vector2,
+	button: Mouse_Button,
+}
+
+Mouse_Move :: struct {
+	pos: rl.Vector2,
+}
+
+Touch_Press :: struct {
+	pos: rl.Vector2,
+}
+
+Touch_Move :: struct {
+	pos: rl.Vector2,
+}
+
+Touch_Release :: struct {
+	pos: rl.Vector2,
+}
+
+Two_Finger_Pan :: struct {
+	dx, dy: f32,
+}
+
+Pad_Button_Press :: struct {
+	button: Pad_Button,
+}
