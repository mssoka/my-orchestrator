+// --- Intent — the semantic, device-agnostic action ----------------------------
+
+// Retry — R/Enter at Game_Over (mouse) / A at Game_Over (pad): fresh run,
+// fresh seed (E32). App effect.
+Retry :: struct {}
+
+// Toggle_Pause — P/Space / pad Start: Run ↔ Paused (5.3). The executor flips
+// the mode; the sim freezes deterministically (no commands involved).
+Toggle_Pause :: struct {}
+
+// Toggle_Assist — T: the Job B assist tier cycle (full → glow-only → off).
+// App effect.
+Toggle_Assist :: struct {}
+
+// Toggle_Overlay — D (PP_DEBUG builds only): the 5.7 debug overlay. App effect.
+Toggle_Overlay :: struct {}
+
+// Cancel — ESC / right-click-while-placing / pad B: cancels an armed placement
+// (placing → -1) or deselects (ESC with no placement); the swallow latch is
+// always set (the cancel gesture's release must not re-select).
+Cancel :: struct {}
+
+// Cancel_Drag — pad B with a draw in progress: abandon the in-progress draw
+// (the pad has no ESC/right-click equivalent, so B must be able to escape a
+// stuck drag — the mouse recovers via a new press; the pad cannot). The mouse
+// ESC keeps the old behavior (it never cancels a drag — see Cancel).
+Cancel_Drag :: struct {}
+
+// Press_Anchor — a left press re-anchored the latch: the old handle_input's
+// press block RESET press_swallowed at its top, and on a same-frame ESC/right
+// cancel (whose block ran BEFORE the press) that reset must WIN over the
+// cancel's latch. This intent runs AFTER the frame's Cancel(s) in the executor
+// queue, reproducing the old sequential order (Perkins B2).
+Press_Anchor :: struct {}
+
+// Select_Tier — a tray link-chip press (mouse) or a bumper cycle (pad): set
+// the draw tier. Tray clicks also exit placement mode + clear the drag state.
+Select_Tier :: struct {
+	tier: u16,
+}
+
+// Arm_Placement — a tray router-chip press: toggle placement mode for a node
+// type (click again to cancel, like the current tray).
+Arm_Placement :: struct {
+	type_idx: i32,
+}
+
+// Begin_Draw — a press on a node (mouse/touch) or A on the pad cursor: start
+// the draw drag from the node at the given world position.
+Begin_Draw :: struct {
+	node: u32,
+	wx, wy: f32,
+}
+
+// Cursor_Move — the pointer moved (mouse move / touch move / placement ghost
+// tracking). The executor routes by state: mid-drag it re-snaps + re-validates
+// the in-progress draw (live preview, READ-ONLY); while placing it tracks the
+// placement ghost + validates the spot.
+Cursor_Move :: struct {
+	wx, wy: f32,
+}
+
+// Drag_Release — a left release while a draw drag is active: commit the
+// validated draw (the edit fast-path command) or, if the release didn't move
+// past the click threshold, click-select instead (the 5.5 release-based
+// surface — node → pipe → clear on EVERY left release).
+Drag_Release :: struct {
+	pos: rl.Vector2,
+}
+
+// Place_Release — a left release while placement mode is armed: commit the
+// validated router placement (press_swallowed + the moved check gate it).
+Place_Release :: struct {
+	pos: rl.Vector2,
+}
+
+// Select — a plain left release (no drag, no placement): click-select at the
+// release point (5.5 — reachable even when no drag happened).
+Select :: struct {
+	pos: rl.Vector2,
+}
+
+// Demolish — X/DEL with a selection: demolish the selected pipe or junction
+// (the core's E1 / E27 paths, existing commands — no new command kinds).
+Demolish :: struct {}
+
+// Set_Class — the 1/2 keys with a pipe selected: pick the class the lane keys
+// act on.
+Set_Class :: struct {
+	class: u16,
+}
+
+// Set_Lane — the E/S/B keys (or a panel row) with a pipe selected: assign the
+// class to a lane, then the auto-follow writes the ladder split through
+// Cmd_Set_Weights unless the manual editor owns the weights.
+Set_Lane :: struct {
+	lane: u8,
+}
+
+// Arm_Preview — U with a pipe selected: arm/disarm the R4 upgrade preview
+// (app effect — the pure look, never a command).
+Arm_Preview :: struct {}
+
+// Cycle_Tier — pad bumpers (no pipe selected): cycle the draw tier by dir.
+Cycle_Tier :: struct {
+	dir: i8,
+}
+
+// Cycle_Class — pad bumpers (pipe selected): cycle the lane-key class by dir.
+Cycle_Class :: struct {
+	dir: i8,
+}
+
+// Node_Select — pad dpad: step the node cursor by dir through the alive nodes
+// (in id order — deterministic, no map iteration).
+Node_Select :: struct {
+	step: i32,
+}
+
+// Confirm — pad A: with no draw active, begin a draw at the pad cursor; with a
+// draw active, aim-commit it at the pad cursor (the same validated command the
+// mouse's drag release produces); at Game_Over, retry.
+Confirm :: struct {}
+
+// Pan — two-finger pan (touch): the camera-pan intent. The view is camera-fit
+// only (landscape framing is a camera-fit decision, §18 OQ-1) — the executor
+// is a deliberate no-op today, flagged in the PR; NOT camera work.
+Pan :: struct {
+	dx, dy: f32,
+}
+
+// Right_Click — a right press with no placement armed: the QoS-panel select /
+// drag-interrupt path (mouse UI — the app handler owns the pipe select + panel
+// state; the executor interrupts an in-flight drag first).
+Right_Click :: struct {
+	pos: rl.Vector2,
+}
+
+Intent :: union {
+	Retry,
+	Cancel_Drag,
+	Press_Anchor,
+	Toggle_Pause,
+	Toggle_Assist,
+	Toggle_Overlay,
+	Cancel,
+	Select_Tier,
+	Arm_Placement,
+	Begin_Draw,
+	Cursor_Move,
+	Drag_Release,
+	Place_Release,
+	Select,
+	Demolish,
+	Set_Class,
+	Set_Lane,
+	Arm_Preview,
+	Cycle_Tier,
+	Cycle_Class,
+	Node_Select,
+	Confirm,
+	Pan,
+	Right_Click,
+}
