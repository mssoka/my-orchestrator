diff --git a/harness/parity.odin b/harness/parity.odin
new file mode 100644
index 0000000..f9e9f17
--- /dev/null
+++ b/harness/parity.odin
@@ -0,0 +1,858 @@
+package main
+
+// parity.odin — Story 5.4: the T1 across-inputs golden (input parity, ODN-12 /
+// FORGE #6). Drives SCRIPTED (synthetic) device-event frames through the
+// intent layer's three mappings (app/input — mouse, touch, controller) and
+// asserts:
+//   1. the emitted Command sequence is IDENTICAL across devices (parity by
+//      construction — all three map onto the same Intents and run through the
+//      ONE shared executor; there is no per-device command production),
+//   2. the resulting sim hash stream is IDENTICAL across devices (the full
+//      T1-strength check — any nondeterminism in the mappings breaks it),
+//   3. the streams equal explicit expected commands (the mappings produce the
+//      RIGHT commands, not just mutually-equal ones),
+//   4. the mouse baseline of the command scenarios is blessed as a real T1
+//      golden (goldens/input_parity_*.t1) — checked on run, re-blessed
+//      deliberately with `save`.
+//
+// NO physical device: the mappings run on the event data alone (the poll
+// adapters in input/poll.odin are the only raylib-state readers, and the
+// parity test never calls them). Deterministic by construction: fixed fixture
+// (seed 42), fixed 1280x720 view, no wall clock, no randomness in the
+// mappings.
+//
+// CLI: `harness input-parity [save]`.
+
+import "core:fmt"
+import "core:os"
+import rl "vendor:raylib"
+import pp "../core"
+import rnd "../app/render"
+import inp "../app/input"
+
+// PARITY_TICKS — the sim steps after the scripted input (commands apply at
+// tick 1, then the heartbeat steps). Any fixed count is deterministic; 12
+// covers the apply + a stable tail.
+PARITY_TICKS :: 12
+
+// Parity_Device — which devices a scenario drives.
+Parity_Device :: enum { Mouse, Touch, Pad }
+
+// Parity_Scenario — one cross-input scenario: per-device frame scripts (a
+// frame = one dispatch_frame call's event list) + the expected command kinds
+// (apply_tick 1) + the setup (tier/sel_pipe/sel_class presets).
+Parity_Scenario :: struct {
+	name:     string,
+	mouse:    [dynamic][]inp.Device_Event,
+	touch:    [dynamic][]inp.Device_Event,
+	pad:      [dynamic][]inp.Device_Event,
+	tier:     u16, // the preset draw tier (-1/u16 max = leave the default standard)
+	sel_pipe: i64, // preset selection (0 = none selected)
+	sel_class: u16, // preset lane-key class
+	expected: [dynamic]pp.Command, // the expected command stream (all devices)
+}
+
+// Parity_Run — one device's drive result: the produced command log, the
+// per-tick hash stream, the final input surface + the lane auto-follow data
+// (the final pipe-0 weights + the ladder's result for its assignments — read
+// from the run BEFORE the state is destroyed; the lane scenario's structural
+// assert uses them. The topology itself is NOT copied (its slices share the
+// run state's backing — a copy would double-free).
+Parity_Run :: struct {
+	log:     [dynamic]pp.Command,
+	hashes:  [dynamic]u64,
+	// the final input-surface state as SCALARS (NOT a copy of the Input ctx —
+	// the ctx's scratch buffers are freed when drive_parity returns, so a copy
+	// would hold dangling dynamic headers; everything the scenario checks is a
+	// scalar — blind-hunter note 9)
+	sel_node:   i64,
+	sel_pipe:   i64,
+	sel_class:  u16,
+	tier:       u16,
+	placing:    i32,
+	pad_has:    bool,
+	pad_node:   u32,
+	drag_active: bool,
+	mode:       inp.Mode, // the post-run FSM state (the pause scenario)
+	last_reject: pp.Edit_Error, // the post-run reject toast (the rejection scenario)
+	has_pipe0: bool, // a pipe 0 existed at the run end (the lane assert)
+	pipe0_weights: [3]i32, // the final pipe-0 weights (the auto-follow wrote them)
+	pipe0_auto:    [3]i32, // the ladder's split for pipe 0's final assignments
+}
+
+// evs — ONE dispatch frame's events, heap-allocated (the scenario data must
+// outlive the tick loops' free_all — a stack/temp backing would dangle).
+evs :: proc(events: ..inp.Device_Event) -> []inp.Device_Event {
+	back := make([]inp.Device_Event, len(events))
+	for e, i in events {
+		back[i] = e
+	}
+	return back
+}
+
+// frames — a device's frame script, heap-allocated (same lifetime rule).
+frames :: proc(fs: ..[]inp.Device_Event) -> [dynamic][]inp.Device_Event {
+	out := make([dynamic][]inp.Device_Event, 0, len(fs))
+	for f in fs {
+		append(&out, f)
+	}
+	return out
+}
+
+// expected_of — a scenario's expected command stream, heap-allocated.
+expected_of :: proc(cmds: ..pp.Command) -> [dynamic]pp.Command {
+	out := make([dynamic]pp.Command, 0, len(cmds))
+	for c in cmds {
+		append(&out, c)
+	}
+	return out
+}
+
+// parity_right_click_effect — the right-click select path (the app's
+// effect_right_click body, wired into the parity ctx so the right-click
+// scenario pins the W3/W5 transcription: the drag interrupt + the pipe
+// select). Mirrors app/main.odin's effect_right_click exactly.
+parity_right_click_effect :: proc(user: rawptr, ictx: ^inp.Input, pos: rl.Vector2) {
+	// the app's effect_right_click delegates to the same helper — the parity
+	// hook must too, or the pin drifts from the app (Perkins note)
+	inp.right_click_select(ictx, pos)
+}
+
+// drive_parity — run one device's scripted frames through the intent layer
+// and step the produced log (the T1 hash stream). Deterministic: seed-42
+// fixture, minimal run setup (era 0, no growth — the input layer's
+// determinism is the subject, not the growth system), the 1280x720 view.
+// `on_right_click` is an optional effect hook (nil except the right-click
+// scenario, which wires parity_right_click_effect).
+drive_parity :: proc(cat: ^pp.Catalogs, frames: [dynamic][]inp.Device_Event, tier: u16,
+	sel_pipe: i64, sel_class: u16, on_right_click: proc(rawptr, ^inp.Input, rl.Vector2) = nil) -> Parity_Run {
+	state: pp.Run_State
+	pp.run_init(&state, 42, cat.hash, cat.balance.logic_hz)
+	seed_fixture(&state, cat)
+
+	view: rnd.View
+	view.catalogs = cat // the render package reads the catalogs (tray chip count/rects)
+	rnd.view_compute(&view, 1280, 720, &cat.balance)
+
+	ictx: inp.Input
+	ictx.topo = &state.topology
+	ictx.cat = cat
+	ictx.view = &view
+	ictx.log = &state.action_log
+	inp.init(&ictx) // make the scratch buffers (init also resets the selection presets to -1)
+	defer inp.destroy(&ictx)
+	ictx.tick = 0
+	ictx.mode = .Run
+	ictx.tier = tier
+	ictx.sel_pipe = sel_pipe
+	ictx.sel_class = sel_class
+	ictx.placing = -1
+	ictx.on_right_click = on_right_click
+
+	for f in frames {
+		inp.dispatch_frame(&ictx, f)
+	}
+
+	// step the produced log + hash (the run_demo T1 loop shape, no pauses)
+	hashes := make([dynamic]u64, 0, PARITY_TICKS) // owned by the returned Parity_Run (the cleanup frees it)
+	sim_tick: u64 = 0
+	for w in u64(1) ..= PARITY_TICKS {
+		before := len(state.events)
+		sim_tick += 1
+		batch := make([dynamic]pp.Command, 0, 4, context.temp_allocator)
+		for cmd in state.action_log {
+			if cmd.apply_tick == sim_tick {
+				append(&batch, cmd)
+			}
+		}
+		pp.step(&state, sim_tick, batch[:], cat)
+		append(&hashes, pp.state_hash(&state, state.events[before:], cat, context.temp_allocator))
+		clear(&state.events)
+		// NOTE: NO per-tick free_all here — the scenario checks append fail strings
+		// with fmt.tprintf (temp arena), and a free_all would turn them into
+		// freed-memory garbage before the report prints (the run.odin aprintf
+		// lesson). The parity temp usage is tiny (12 ticks x small batches).
+	}
+
+	log := make([dynamic]pp.Command, 0, 8)
+	for cmd in state.action_log {
+		append(&log, cmd)
+	}
+	run := Parity_Run{
+		log = log,
+		hashes = hashes,
+		sel_node = ictx.sel_node,
+		sel_pipe = ictx.sel_pipe,
+		sel_class = ictx.sel_class,
+		tier = ictx.tier,
+		placing = ictx.placing,
+		pad_has = ictx.pad_has,
+		pad_node = ictx.pad_node,
+		drag_active = ictx.drag.active,
+		mode = ictx.mode,
+		last_reject = ictx.last_reject,
+	}
+	if len(state.topology.pipe_weights) > 0 {
+		run.has_pipe0 = true
+		run.pipe0_weights = state.topology.pipe_weights[0]
+		run.pipe0_auto = pp.qos_auto_weights(&state.topology, cat, 0)
+	}
+	pp.run_destroy(&state)
+	return run
+}
+
+// parity_run_destroy — free a Parity_Run's owned buffers (the log + the hash
+// stream; the ictx's scratch buffers were freed by drive_parity's own defer).
+parity_run_destroy :: proc(r: ^Parity_Run) {
+	delete(r.log)
+	delete(r.hashes)
+}
+
+// cmd_equal — structural command comparison (apply_tick + kind).
+cmd_equal :: proc(a, b: pp.Command) -> bool {
+	if a.apply_tick != b.apply_tick {
+		return false
+	}
+	return a.kind == b.kind
+}
+
+// cmd_string — a one-line render for failure messages.
+cmd_string :: proc(c: pp.Command) -> string {
+	#partial switch k in c.kind {
+	case pp.Cmd_Draw_Pipe:
+		return fmt.tprintf("Draw{%d,%d,tier%d}@%d", k.a, k.b, k.tier, c.apply_tick)
+	case pp.Cmd_Demolish_Pipe:
+		return fmt.tprintf("Demolish_Pipe{%d}@%d", k.pipe, c.apply_tick)
+	case pp.Cmd_Demolish_Node:
+		return fmt.tprintf("Demolish_Node{%d}@%d", k.node, c.apply_tick)
+	case pp.Cmd_Place_Router:
+		return fmt.tprintf("Place{%d,(%d,%d)}@%d", k.type_idx, k.pos[0], k.pos[1], c.apply_tick)
+	case pp.Cmd_Set_Weights:
+		return fmt.tprintf("Emphasis{%d,%v}@%d", k.pipe, k.weights, c.apply_tick)
+	case pp.Cmd_Set_Lane:
+		return fmt.tprintf("Lane{%d,class%d,lane%d}@%d", k.pipe, k.class, k.lane, c.apply_tick)
+	}
+	return fmt.tprintf("cmd@%d", c.apply_tick)
+}
+
+// check_scenario — assert a scenario: (1) expected == each participating
+// device's log, (2) all participating devices' logs + hash streams identical.
+// Appends one-line failures; returns green.
+check_scenario :: proc(sc: ^Parity_Scenario, runs: []Parity_Run, devices: []Parity_Device,
+	fails: ^[dynamic]string) -> bool {
+	ok := true
+	// hash streams must be identical across devices (the T1-strength equality)
+	base_hashes: [dynamic]u64
+	defer delete(base_hashes)
+	base_log: [dynamic]pp.Command
+	defer delete(base_log)
+	first := true
+	for d, i in devices {
+		r := &runs[i]
+		if first {
+			append(&base_hashes, ..r.hashes[:])
+			append(&base_log, ..r.log[:])
+			first = false
+			continue
+		}
+		if len(r.hashes) != len(base_hashes) {
+			append(fails, fmt.tprintf("  %s %s: hash length %d != baseline %d",
+				sc.name, d, len(r.hashes), len(base_hashes)))
+			ok = false
+		}
+		for h in 0 ..< min(len(r.hashes), len(base_hashes)) {
+			if r.hashes[h] != base_hashes[h] {
+				append(fails, fmt.tprintf("  %s %s: hash stream DIVERGES at tick %d (%016x != %016x) — input parity broken",
+					sc.name, d, h+1, r.hashes[h], base_hashes[h]))
+				ok = false
+				break
+			}
+		}
+		if len(r.log) != len(base_log) {
+			append(fails, fmt.tprintf("  %s %s: command count %d != baseline %d",
+				sc.name, d, len(r.log), len(base_log)))
+			ok = false
+		}
+		for c in 0 ..< min(len(r.log), len(base_log)) {
+			if !cmd_equal(r.log[c], base_log[c]) {
+				append(fails, fmt.tprintf("  %s %s: command %d %s != baseline %s — input parity broken",
+					sc.name, d, c+1, cmd_string(r.log[c]), cmd_string(base_log[c])))
+				ok = false
+				break
+			}
+		}
+	}
+	// every participating device's log must equal the expected stream
+	for d, i in devices {
+		r := &runs[i]
+		if len(r.log) != len(sc.expected) {
+			append(fails, fmt.tprintf("  %s %s: expected %d commands, got %d",
+				sc.name, d, len(sc.expected), len(r.log)))
+			ok = false
+			continue
+		}
+		for c in 0 ..< len(sc.expected) {
+			if !cmd_equal(r.log[c], sc.expected[c]) {
+				append(fails, fmt.tprintf("  %s %s: command %d = %s, want %s",
+					sc.name, d, c+1, cmd_string(r.log[c]), cmd_string(sc.expected[c])))
+				ok = false
+			}
+		}
+	}
+	return ok
+}
+
+// --- the scenarios -----------------------------------------------------------
+
+// build_scenarios — the parity matrix. Screen positions are resolved from the
+// 1280x720 view + the fixture (deterministic): node screens, the pipe
+// midpoint, the tray chip centers.
+build_scenarios :: proc(cat: ^pp.Catalogs, view: ^rnd.View) -> [dynamic]Parity_Scenario {
+	sc: [dynamic]Parity_Scenario
+
+	tier_std, _ := pp.pipe_tier_index(cat, "standard")
+	tier_wide, _ := pp.pipe_tier_index(cat, "wide")
+	router_idx, _ := pp.node_type_index(cat, "router_basic")
+
+	// the fixture node screens (res 0, router 1, host 2 — 12 tiles apart)
+	n0 := rnd.node_screen(view, FIXTURE_RES_POS)
+	n1 := rnd.node_screen(view, FIXTURE_RT_POS)
+	n2 := rnd.node_screen(view, FIXTURE_HOST_POS)
+	mid01 := rl.Vector2{(n0.x + n1.x) / 2, (n0.y + n1.y) / 2}
+	// a free placement tile (10,10) — clear of the fixture's separation radii
+	place_pos := rnd.to_screen(view, f32(10)*f32(cat.balance.tile_px), f32(10)*f32(cat.balance.tile_px))
+	// an empty-ground point (a pan must not hit a node or pipe — clear of the
+	// fixture: tile (10,8), far from every node row)
+	empty01 := rnd.to_screen(view, f32(10)*f32(cat.balance.tile_px), f32(8)*f32(cat.balance.tile_px))
+	// the tray chip centers: link chips first (index = pipe-tier index), then
+	// router chips (index = len(tiers) + k)
+	chip_wide := chip_center(view, int(tier_wide))
+	chip_router := chip_center(view, len(cat.pipe_tiers))
+
+	// 1. draw — the headline: all three devices produce Draw{0,1,standard}
+	append(&sc, Parity_Scenario{
+		name = "input_parity_draw",
+		sel_pipe = -1, // no preset selection
+		tier = tier_std,
+		mouse = frames(
+			evs(inp.Device_Event(inp.Mouse_Press{pos = n0, button = .Left})),
+			evs(inp.Device_Event(inp.Mouse_Move{pos = mid01})),
+			evs(inp.Device_Event(inp.Mouse_Release{pos = n1, button = .Left})),
+		),
+		touch = frames(
+			evs(inp.Touch_Press{pos = n0}),
+			evs(inp.Touch_Move{pos = mid01}),
+			evs(inp.Touch_Release{pos = n1}),
+		),
+		pad = frames(
+			evs(inp.Pad_Button_Press{button = .Dpad_Down}), // cursor -> node 0
+			evs(inp.Pad_Button_Press{button = .A}), // begin draw at node 0
+			evs(inp.Pad_Button_Press{button = .Dpad_Down}), // cursor -> node 1
+			evs(inp.Pad_Button_Press{button = .A}), // aim-commit draw 0->1
+		),
+		expected = expected_of(
+			{1, pp.Cmd_Draw_Pipe{a = 0, b = 1, tier = tier_std}},
+		),
+	})
+
+	// 2. draw_wide — the tier preset flows through: Draw{1,2,wide}
+	append(&sc, Parity_Scenario{
+		name = "input_parity_draw_wide",
+		sel_pipe = -1, // no preset selection
+		tier = tier_wide,
+		mouse = frames(
+			evs(inp.Mouse_Press{pos = n1, button = .Left}),
+			evs(inp.Mouse_Move{pos = rl.Vector2{(n1.x + n2.x) / 2, (n1.y + n2.y) / 2}}),
+			evs(inp.Mouse_Release{pos = n2, button = .Left}),
+		),
+		touch = frames(
+			evs(inp.Touch_Press{pos = n1}),
+			evs(inp.Touch_Move{pos = rl.Vector2{(n1.x + n2.x) / 2, (n1.y + n2.y) / 2}}),
+			evs(inp.Touch_Release{pos = n2}),
+		),
+		pad = frames(
+			evs(inp.Pad_Button_Press{button = .Dpad_Down}),
+			evs(inp.Pad_Button_Press{button = .Dpad_Down}),
+			evs(inp.Pad_Button_Press{button = .A}), // begin draw at node 1
+			evs(inp.Pad_Button_Press{button = .Dpad_Down}), // cursor -> node 2
+			evs(inp.Pad_Button_Press{button = .A}), // aim-commit draw 1->2
+		),
+		expected = expected_of(
+			{1, pp.Cmd_Draw_Pipe{a = 1, b = 2, tier = tier_wide}},
+		),
+	})
+
+	// 3. select — a tap/click/aim on the router selects it (state, no commands)
+	append(&sc, Parity_Scenario{
+		name = "input_parity_select",
+		sel_pipe = -1, // no preset selection
+		tier = tier_std,
+		mouse = frames(
+			evs(inp.Mouse_Press{pos = n1, button = .Left}),
+			evs(inp.Mouse_Release{pos = n1, button = .Left}),
+		),
+		touch = frames(
+			evs(inp.Touch_Press{pos = n1}),
+			evs(inp.Touch_Release{pos = n1}),
+		),
+		pad = frames(
+			evs(inp.Pad_Button_Press{button = .Dpad_Down}), // cursor -> node 0
+			evs(inp.Pad_Button_Press{button = .Dpad_Down}), // cursor -> node 1
+		),
+		expected = expected_of(),
+	})
+
+	// 4. tier_cycle — the tray chip (mouse) vs the bumper (pad) both reach wide
+	append(&sc, Parity_Scenario{
+		name = "input_parity_tier_cycle",
+		sel_pipe = -1, // no preset selection
+		tier = tier_std,
+		mouse = frames(
+			evs(inp.Mouse_Press{pos = chip_wide, button = .Left}),
+		),
+		pad = frames(
+			evs(inp.Pad_Button_Press{button = .R_Bumper}), // standard -> wide
+		),
+		expected = expected_of(),
+	})
+
+	// 5. class_cycle — the 2 key (mouse, SETS class 1) vs the bumper (pad,
+	// CYCLES from 0 to 1) reach the same shared class state. The preset
+	// sel_class = 0 makes BOTH halves non-vacuous: each must CHANGE the value
+	// (Perkins W11 — a dropped key/bumper path fails the assert).
+	append(&sc, Parity_Scenario{
+		name = "input_parity_class_cycle",
+		tier = tier_std,
+		sel_pipe = 0, // a preset selection (the class keys gate on it)
+		sel_class = 0,
+		mouse = frames(
+			evs(inp.Key_Press{key = .Two}), // class 1 (streaming)
+		),
+		pad = frames(
+			evs(inp.Pad_Button_Press{button = .L_Bumper}), // 0 -> 1 (wrap)
+		),
+		expected = expected_of(),
+	})
+
+	// 6. pan — the FULL two-finger gesture (press on empty ground -> pan ->
+	// lift), not one mid-gesture frame (edge-hunter finding 8): the Pan intent
+	// is a no-op today (camera work flagged per §18 OQ-1) and the gesture's
+	// press/lift must not produce commands or selection changes either.
+	append(&sc, Parity_Scenario{
+		name = "input_parity_pan",
+		sel_pipe = -1, // no preset selection
+		tier = tier_std,
+		touch = frames(
+			evs(inp.Touch_Press{pos = empty01}),
+			evs(inp.Two_Finger_Pan{dx = 12, dy = -4}),
+			evs(inp.Two_Finger_Pan{dx = 8, dy = -2}),
+			evs(inp.Touch_Release{pos = empty01}),
+		),
+		expected = expected_of(),
+	})
+
+	// 7. lane — mouse+keys: draw, click-select the pipe, assign email to
+	// express (the auto-follow writes the ladder split). The emphasis is
+	// asserted structurally by lane_post_check (the ladder is the executor's
+	// source — read from the run's final topology, never hand-duplicated).
+	append(&sc, Parity_Scenario{
+		name = "input_parity_lane",
+		sel_pipe = -1, // no preset selection
+		tier = tier_std,
+		mouse = frames(
+			evs(inp.Mouse_Press{pos = n0, button = .Left}),
+			evs(inp.Mouse_Release{pos = n1, button = .Left}),
+			evs(inp.Mouse_Press{pos = mid01, button = .Left}),
+			evs(inp.Mouse_Release{pos = mid01, button = .Left}),
+			evs(inp.Key_Press{key = .E}),
+		),
+		expected = expected_of(
+			{1, pp.Cmd_Draw_Pipe{a = 0, b = 1, tier = tier_std}},
+			{1, pp.Cmd_Set_Lane{pipe = 0, class = 0, lane = pp.LANE_EXPRESS}},
+		),
+	})
+
+	// 8. demolish — mouse+keys: draw, click-select the pipe, X demolishes it
+	append(&sc, Parity_Scenario{
+		name = "input_parity_demolish",
+		tier = tier_std,
+		mouse = frames(
+			evs(inp.Mouse_Press{pos = n0, button = .Left}),
+			evs(inp.Mouse_Release{pos = n1, button = .Left}),
+			evs(inp.Mouse_Press{pos = mid01, button = .Left}),
+			evs(inp.Mouse_Release{pos = mid01, button = .Left}),
+			evs(inp.Key_Press{key = .X}),
+		),
+		expected = expected_of(
+			{1, pp.Cmd_Draw_Pipe{a = 0, b = 1, tier = tier_std}},
+			{1, pp.Cmd_Demolish_Pipe{pipe = 0}},
+		),
+	})
+
+	// 9. place — mouse: arm router placement from the tray, click a free tile
+	append(&sc, Parity_Scenario{
+		name = "input_parity_place",
+		sel_pipe = -1, // no preset selection
+		tier = tier_std,
+		mouse = frames(
+			evs(inp.Mouse_Press{pos = chip_router, button = .Left}),
+			evs(inp.Mouse_Press{pos = place_pos, button = .Left}),
+			evs(inp.Mouse_Release{pos = place_pos, button = .Left}),
+		),
+		expected = expected_of(
+			{1, pp.Cmd_Place_Router{type_idx = u16(router_idx), pos = {10, 10}}},
+		),
+	})
+
+	// 10. cancel — mouse: arm placement, ESC cancels (state, no commands)
+	append(&sc, Parity_Scenario{
+		name = "input_parity_cancel",
+		sel_pipe = -1, // no preset selection
+		tier = tier_std,
+		mouse = frames(
+			evs(inp.Mouse_Press{pos = chip_router, button = .Left}),
+			evs(inp.Key_Press{key = .Esc}),
+		),
+		expected = expected_of(),
+	})
+
+	// 11. right_click — mouse: draw 0->1, right-click the pipe SELECTS it (the
+	// W3/W5 transcription, wired through a minimal parity effect that mirrors
+	// the app's effect_right_click) — no commands, sel_pipe == 0.
+	append(&sc, Parity_Scenario{
+		name = "input_parity_right_click",
+		tier = tier_std,
+		sel_pipe = -1, // no preset selection
+		mouse = frames(
+			evs(inp.Mouse_Press{pos = n0, button = .Left}),
+			evs(inp.Mouse_Release{pos = n1, button = .Left}),
+			evs(inp.Mouse_Press{pos = mid01, button = .Right}),
+		),
+		expected = expected_of(
+			{1, pp.Cmd_Draw_Pipe{a = 0, b = 1, tier = tier_std}},
+		),
+	})
+
+	// 12. right_x — B1 pin: a right-press frame EARLY-RETURNED in the old
+	// handle_input, so a same-frame X was IGNORED (select only, never demolish).
+	// The mapping now suppresses phase-2 keys on right-press frames. Script:
+	// draw 0->1, then ONE frame [right-click the pipe + X] — the right-click
+	// selects; the X must NOT demolish.
+	append(&sc, Parity_Scenario{
+		name = "input_parity_right_x",
+		tier = tier_std,
+		sel_pipe = -1, // no preset selection
+		mouse = frames(
+			evs(inp.Mouse_Press{pos = n0, button = .Left}),
+			evs(inp.Mouse_Release{pos = n1, button = .Left}),
+			evs(inp.Mouse_Press{pos = mid01, button = .Right}, inp.Key_Press{key = .X}),
+		),
+		expected = expected_of(
+			{1, pp.Cmd_Draw_Pipe{a = 0, b = 1, tier = tier_std}},
+		),
+	})
+
+	// 13. esc_press — B2 pin: a same-frame ESC + left-press while placing — the
+	// old cancel block ran FIRST (placing=-1), then the press re-anchored +
+	// reset the swallow + STARTED A DRAG (the release committed). The mapping
+	// now decides the press branch on the post-cancel state (placing_eff) +
+	// re-clears the swallow via Press_Anchor. Script: arm placement, then ONE
+	// frame [ESC + press node 0], then release node 1 — the draw COMMITS.
+	append(&sc, Parity_Scenario{
+		name = "input_parity_esc_press",
+		tier = tier_std,
+		sel_pipe = -1, // no preset selection
+		mouse = frames(
+			evs(inp.Mouse_Press{pos = chip_router, button = .Left}), // arm placement
+			evs(inp.Key_Press{key = .Esc}, inp.Mouse_Press{pos = n0, button = .Left}),
+			evs(inp.Mouse_Release{pos = n1, button = .Left}),
+		),
+		expected = expected_of(
+			{1, pp.Cmd_Draw_Pipe{a = 0, b = 1, tier = tier_std}},
+		),
+	})
+
+	// 14. reject — the Command-stage rejection pin (Perkins W7): a terminal-to-
+	// terminal draw (residential 0 -> content_host 2) validates as
+	// .Terminal_To_Terminal — NO command, NO log entry (the ghost surfaces the
+	// rejection; the core never mutates). (The last_reject toast paths —
+	// demolish/lane rejections — need a stale selection, which the app's
+	// selection-clear discipline makes unreachable through the UI by design.)
+	append(&sc, Parity_Scenario{
+		name = "input_parity_reject",
+		tier = tier_std,
+		sel_pipe = -1, // no preset selection
+		mouse = frames(
+			evs(inp.Mouse_Press{pos = n0, button = .Left}),
+			evs(inp.Mouse_Release{pos = n2, button = .Left}),
+		),
+		expected = expected_of(),
+	})
+
+	// 15. pad_cancel — W6 pin: pad B with a draw in progress abandons it
+	// (Cancel_Drag — the pad's escape hatch); no command, no stuck drag.
+	append(&sc, Parity_Scenario{
+		name = "input_parity_pad_cancel",
+		tier = tier_std,
+		sel_pipe = -1, // no preset selection
+		pad = frames(
+			evs(inp.Pad_Button_Press{button = .Dpad_Down}), // cursor -> node 0
+			evs(inp.Pad_Button_Press{button = .A}), // begin draw at node 0
+			evs(inp.Pad_Button_Press{button = .B}), // abandon the draw
+		),
+		expected = expected_of(),
+	})
+
+	// 16. pause — W8 pin: P toggles the FSM to Paused (the intent-layer mode
+	// mirror; no commands — the sim freezes deterministically, 5.3).
+	append(&sc, Parity_Scenario{
+		name = "input_parity_pause",
+		tier = tier_std,
+		sel_pipe = -1, // no preset selection
+		mouse = frames(
+			evs(inp.Key_Press{key = .P}),
+		),
+		expected = expected_of(),
+	})
+
+	// 17. pad_cursor — W10 pin: the pad_step boundaries — first Dpad_Up lands
+	// on the LAST alive node (2), the wrap from 2 steps back to 0.
+	append(&sc, Parity_Scenario{
+		name = "input_parity_pad_cursor",
+		tier = tier_std,
+		sel_pipe = -1, // no preset selection
+		pad = frames(
+			evs(inp.Pad_Button_Press{button = .Dpad_Up}), // first placement -> last (2)
+			evs(inp.Pad_Button_Press{button = .Dpad_Down}), // wrap -> 0
+		),
+		expected = expected_of(),
+	})
+
+	return sc
+}
+
+// chip_center — the center of tray chip i.
+chip_center :: proc(view: ^rnd.View, i: int) -> rl.Vector2 {
+	r := rnd.tray_chip_rect(view, i)
+	return {r.x + r.width / 2, r.y + r.height / 2}
+}
+
+// scenario_devices — the devices a scenario drives (non-empty scripts).
+scenario_devices :: proc(sc: ^Parity_Scenario) -> [dynamic]Parity_Device {
+	devs: [dynamic]Parity_Device
+	if len(sc.mouse) > 0 { append(&devs, Parity_Device.Mouse) }
+	if len(sc.touch) > 0 { append(&devs, Parity_Device.Touch) }
+	if len(sc.pad) > 0 { append(&devs, Parity_Device.Pad) }
+	return devs
+}
+
+// run_input_parity — `harness input-parity [save]`. Returns 0 on green.
+run_input_parity :: proc(cat: ^pp.Catalogs, save: bool) -> i32 {
+	view: rnd.View
+	view.catalogs = cat // the render package reads the catalogs (tray chip count/rects)
+	rnd.view_compute(&view, 1280, 720, &cat.balance)
+
+	scenarios := build_scenarios(cat, &view)
+	defer {
+		for &sc in scenarios {
+			for &f in sc.mouse { delete(f) }
+			for &f in sc.touch { delete(f) }
+			for &f in sc.pad { delete(f) }
+			delete(sc.expected)
+		}
+		delete(scenarios)
+	}
+
+	fails: [dynamic]string
+	defer delete(fails)
+	green := 0
+
+	for &sc in scenarios {
+		devs := scenario_devices(&sc)
+		defer delete(devs)
+		runs := make([]Parity_Run, len(devs))
+		defer {
+			for &r in runs {
+				parity_run_destroy(&r)
+			}
+			delete(runs)
+		}
+		for d, i in devs {
+			hook: proc(rawptr, ^inp.Input, rl.Vector2) = nil
+			if sc.name == "input_parity_right_click" || sc.name == "input_parity_right_x" {
+				hook = parity_right_click_effect
+			}
+			switch d {
+			case .Mouse:
+				runs[i] = drive_parity(cat, sc.mouse, sc.tier, sc.sel_pipe, sc.sel_class, hook)
+			case .Touch:
+				runs[i] = drive_parity(cat, sc.touch, sc.tier, sc.sel_pipe, sc.sel_class, hook)
+			case .Pad:
+				runs[i] = drive_parity(cat, sc.pad, sc.tier, sc.sel_pipe, sc.sel_class, hook)
+			}
+		}
+
+		// the per-scenario state assertions (tier/class/select/place/cancel)
+		check_states(cat, &sc, runs[:], devs[:], &fails)
+
+		// the lane auto-follow structural assert (the ladder is the source)
+		if sc.name == "input_parity_lane" {
+			check_lane_emphasis(cat, runs[:], devs[:], &fails)
+			// the auto-follow wrote a third command (Set_Emphasis with the ladder's
+			// weights for the pipe's final assignments — read from the run, never
+			// hand-duplicated) — fold it into the expected stream so the equality
+			// check covers it.
+			if len(runs) > 0 && len(runs[0].log) == 3 {
+				append(&sc.expected, pp.Command{1, pp.Cmd_Set_Weights{pipe = 0, weights = runs[0].pipe0_auto}})
+			}
+		}
+
+		// the cross-device command + hash equality + the expected-stream check
+		if !check_scenario(&sc, runs[:], devs[:], &fails) {
+			continue
+		}
+
+		// the blessed T1 manifests (command scenarios only): the mouse
+		// baseline hash stream. Check on run, bless on save.
+		if sc.name == "input_parity_draw" || sc.name == "input_parity_draw_wide" {
+			if save {
+				demo := Demo{name = sc.name, seed = 42}
+				write_manifest(sc.name, &demo, cat.hash, cat.balance.logic_hz, runs[0].hashes[:])
+			} else {
+				demo := Demo{name = sc.name, seed = 42}
+				check_manifest(sc.name, &demo, cat.hash, cat.balance.logic_hz, runs[0].hashes[:], &fails)
+			}
+		}
+		green += 1
+	}
+
+	if len(fails) > 0 {
+		fmt.printf("  FAIL input-parity\n")
+		for m in fails {
+			fmt.printf("    - %s\n", m)
+		}
+		return 1
+	}
+	fmt.printf("  PASS input-parity   %d scenario(s) green — mouse == touch == controller (ODN-12 / FORGE #6)\n", green)
+	return 0
+}
+
+// check_states — the per-scenario input-surface assertions (no commands):
+// select (mouse/touch sel_node == pad pad_node == 1), tier_cycle (both ==
+// wide), class_cycle (mouse == 0, pad == 1 — key SETS, bumper CYCLES), pan
+// (nothing changed), cancel (placing == -1).
+check_states :: proc(cat: ^pp.Catalogs, sc: ^Parity_Scenario, runs: []Parity_Run, devs: []Parity_Device,
+	fails: ^[dynamic]string) {
+	// helper: find a device's run
+	find :: proc(runs: []Parity_Run, devs: []Parity_Device, d: Parity_Device) -> (^Parity_Run, bool) {
+		for i in 0 ..< len(devs) {
+			if devs[i] == d {
+				return &runs[i], true
+			}
+		}
+		return nil, false
+	}
+	wide_idx, _ := pp.pipe_tier_index(cat, "wide")
+	switch sc.name {
+	case "input_parity_select":
+		if r, ok := find(runs, devs, .Mouse); ok && r.sel_node != 1 {
+			append(fails, fmt.tprintf("  %s mouse: sel_node %d, want 1 (router)", sc.name, r.sel_node))
+		}
+		if r, ok := find(runs, devs, .Touch); ok && r.sel_node != 1 {
+			append(fails, fmt.tprintf("  %s touch: sel_node %d, want 1", sc.name, r.sel_node))
+		}
+		if r, ok := find(runs, devs, .Pad); ok && (!r.pad_has || r.pad_node != 1) {
+			append(fails, fmt.tprintf("  %s pad: pad_node %d (has %v), want 1", sc.name, r.pad_node, r.pad_has))
+		}
+	case "input_parity_tier_cycle":
+		if r, ok := find(runs, devs, .Mouse); ok && r.tier != u16(wide_idx) {
+			append(fails, fmt.tprintf("  %s mouse: tier %d, want wide (%d)", sc.name, r.tier, wide_idx))
+		}
+		if r, ok := find(runs, devs, .Pad); ok && r.tier != u16(wide_idx) {
+			append(fails, fmt.tprintf("  %s pad: tier %d, want wide (%d)", sc.name, r.tier, wide_idx))
+		}
+	case "input_parity_class_cycle":
+		if r, ok := find(runs, devs, .Mouse); ok && r.sel_class != 1 {
+			append(fails, fmt.tprintf("  %s mouse: sel_class %d, want 1 (the 2 key SETS class 1 — non-vacuous)", sc.name, r.sel_class))
+		}
+		if r, ok := find(runs, devs, .Pad); ok && r.sel_class != 1 {
+			append(fails, fmt.tprintf("  %s pad: sel_class %d, want 1 (L_Bumper CYCLES 0 -> 1)", sc.name, r.sel_class))
+		}
+	case "input_parity_cancel":
+		if r, ok := find(runs, devs, .Mouse); ok && r.placing != -1 {
+			append(fails, fmt.tprintf("  %s mouse: placing %d, want -1 (ESC cancels)", sc.name, r.placing))
+		}
+	case "input_parity_pan":
+		if r, ok := find(runs, devs, .Touch); ok && (r.drag_active || r.sel_pipe != -1 || r.sel_node != -1) {
+			append(fails, fmt.tprintf("  %s touch: pan must be a no-op (drag %v, sel pipe %d, sel node %d)",
+				sc.name, r.drag_active, r.sel_pipe, r.sel_node))
+		}
+	case "input_parity_right_click":
+		// W1 (Perkins): the scenario promised sel_pipe == 0 — now asserted
+		if r, ok := find(runs, devs, .Mouse); ok && r.sel_pipe != 0 {
+			append(fails, fmt.tprintf("  %s mouse: right-click must SELECT the pipe (sel_pipe %d, want 0)", sc.name, r.sel_pipe))
+		}
+	case "input_parity_right_x":
+		// B1 pin: the right-press frame selected the pipe; the same-frame X was
+		// suppressed (the expected check already asserts NO demolish command)
+		if r, ok := find(runs, devs, .Mouse); ok && r.sel_pipe != 0 {
+			append(fails, fmt.tprintf("  %s mouse: right-click+X must leave the pipe SELECTED (sel_pipe %d, want 0 — X suppressed on the right-press frame)", sc.name, r.sel_pipe))
+		}
+	case "input_parity_esc_press":
+		// B2 pin: the ESC+press frame cancelled placement AND started a drag
+		// (the expected check asserts the committed draw)
+		if r, ok := find(runs, devs, .Mouse); ok && r.placing != -1 {
+			append(fails, fmt.tprintf("  %s mouse: placing %d, want -1 (the ESC cancel stuck)", sc.name, r.placing))
+		}
+	case "input_parity_reject":
+		if r, ok := find(runs, devs, .Mouse); ok && r.sel_node != -1 && r.sel_pipe != -1 {
+			append(fails, fmt.tprintf("  %s mouse: a rejected draw must not change the selection (sel pipe %d, node %d)",
+				sc.name, r.sel_pipe, r.sel_node))
+		}
+	case "input_parity_pad_cancel":
+		if r, ok := find(runs, devs, .Pad); ok && r.drag_active {
+			append(fails, fmt.tprintf("  %s pad: B must abandon the draw (drag still active)", sc.name))
+		}
+	case "input_parity_pause":
+		if r, ok := find(runs, devs, .Mouse); ok && r.mode != .Paused {
+			append(fails, fmt.tprintf("  %s mouse: P must pause (mode %v, want Paused)", sc.name, r.mode))
+		}
+	case "input_parity_pad_cursor":
+		if r, ok := find(runs, devs, .Pad); ok && (!r.pad_has || r.pad_node != 0) {
+			append(fails, fmt.tprintf("  %s pad: cursor (has %v, node %d), want node 0 (Up first -> 2, Down wraps -> 0)", sc.name, r.pad_has, r.pad_node))
+		}
+	}
+}
+
+// check_lane_emphasis — the lane auto-follow: any trailing Cmd_Set_Weights
+// must carry the ladder's weights for the pipe's final assignments (read from
+// the run's final topology — the executor's own source; never hand-duplicated
+// in the test).
+check_lane_emphasis :: proc(cat: ^pp.Catalogs, runs: []Parity_Run, devs: []Parity_Device,
+	fails: ^[dynamic]string) {
+	if len(runs) == 0 {
+		return
+	}
+	// the mouse run is the lane baseline (all participating devices share the
+	// same log — the equality check already proved it)
+	r := &runs[0]
+	if !r.has_pipe0 {
+		return // pipe 0 never existed (a draw failure — the expected check caught it)
+	}
+	if len(r.log) >= 3 {
+		last := r.log[len(r.log)-1]
+		w, ok := last.kind.(pp.Cmd_Set_Weights)
+		if !ok {
+			append(fails, fmt.tprintf("  input_parity_lane: trailing command %s, want Cmd_Set_Weights (auto-follow)", cmd_string(last)))
+			return
+		}
+		if w.weights != r.pipe0_auto {
+			append(fails, fmt.tprintf("  input_parity_lane: auto weights %v, want ladder %v", w.weights, r.pipe0_auto))
+		}
+	} else {
+		// no trailing emphasis — the ladder already matched the default set
+		if r.pipe0_weights != r.pipe0_auto {
+			append(fails, fmt.tprintf("  input_parity_lane: no auto-follow written but weights %v != ladder %v", r.pipe0_weights, r.pipe0_auto))
+		}
+	}
+}
