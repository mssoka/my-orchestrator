+// popover_demolish_hit — the demolish popover's BUTTON leg of the press
+// hit-test (node + pipe popovers): a press on the demolish button submits the
+// demolish through the shared executor and swallows the press. ONE copy — the
+// app's popover_click (main.odin) and the harness parity hook
+// (parity_ui_press_effect) both delegate here, so the B1 pin can't drift from
+// the app (Perkins note: no hand-duplicated hit-test to drift). The non-button
+// popover-rect swallow stays app-side (the app owns the popover visuals).
+popover_demolish_hit :: proc(inp: ^Input, pos: rl.Vector2) -> bool {
+	if inp.sel_node >= 0 {
+		slot, ok := pp.node_slot(inp.topo, u32(inp.sel_node))
+		if !ok || inp.topo.node_kind[slot] != .Junction {
+			return false
+		}
+		pop := rnd.popover_rect(inp.view, rnd.node_screen(inp.view, inp.topo.node_pos[slot]), rnd.POPOVER_H_NODE)
+		if rl.CheckCollisionPointRec(pos, rnd.demolish_button_rect(pop)) {
+			demolish_node(inp, u32(inp.sel_node))
+			return true
+		}
+		return false
+	}
+	if inp.sel_pipe >= 0 {
+		ps, ok := pp.pipe_slot(inp.topo, u32(inp.sel_pipe))
+		if !ok {
+			return false
+		}
+		pop := rnd.popover_rect(inp.view, pipe_popover_anchor(inp, ps), rnd.POPOVER_H_PIPE)
+		if rl.CheckCollisionPointRec(pos, rnd.demolish_button_rect(pop)) {
+			demolish_pipe(inp, u32(inp.sel_pipe))
+			return true
+		}
+		return false
+	}
+	return false
+}
+
+// pipe_popover_anchor — the popover anchor for a pipe: the midpoint of its
+// endpoints in screen px (moved from main.odin's pipe_anchor — the input
+// package owns the topology + view; ONE copy for the shared hit-tests).
+pipe_popover_anchor :: proc(inp: ^Input, ps: u32) -> rl.Vector2 {
+	t := inp.topo
+	sa, _ := pp.node_slot(t, t.pipe_a[ps])
+	sb, _ := pp.node_slot(t, t.pipe_b[ps])
+	a := rnd.node_screen(inp.view, t.node_pos[sa])
+	b := rnd.node_screen(inp.view, t.node_pos[sb])
+	return {(a.x + b.x) / 2, (a.y + b.y) / 2}
+}
+
