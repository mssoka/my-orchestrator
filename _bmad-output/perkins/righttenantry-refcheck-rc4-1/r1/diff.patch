+/// §4.2 belt-and-braces: the SQL read already strips raw referee IP/UA from
+/// `result.fraud_signals.form_session` at the boundary; this re-verifies the
+/// serialized payload can never carry the internal-only markers, whatever the
+/// stored row contains (a spoofed/malformed payload can't leak internals).
+///
+/// The result document rides as a JSON *string* field, so internal keys that
+/// would live inside it appear backslash-escaped on the wire (`\"referee_ip\"`
+/// not `"referee_ip"`) — both forms are checked so the guard can't be beaten
+/// by the escaping (Perkins-style lens finding, rc4-1 self-review #1).
+/// Returns True when the serialized text is clean.
+pub fn verify_payload_has_no_internal_fields(payload: String) -> Bool {
+  let markers = [
+    "\"form_token\"",
+    "\"payload_ref\"",
+    "\"referee_ip\"",
+    "\"referee_user_agent\"",
+    "\\\"referee_ip\\\"",
+    "\\\"referee_user_agent\\\"",
+  ]
+  list.all(markers, fn(marker) { !string.contains(payload, marker) })
+}
+
+/// Encode one `reference_calls[]` entry (§8.1). The row comes from
+/// `list_reference_calls_for_detail.sql`, which selects ONLY public columns
+/// (no form_token, no objection_detail, no fraud_signals column) and strips
+/// raw IP/UA from the stored result — so the wire can only ever carry the
+/// §8.1 fields + server-computed hooks/disclaimer.
+pub fn encode_reference_call(
+  row: sql.ListReferenceCallsForDetailRow,
+) -> json.Json {
+  let attempts = parse_attempt_log(row.attempts)
+  let hooks = compute_hooks(row.status)
