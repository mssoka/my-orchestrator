+// -- RC4.1: reference_calls[] (§8.1/§8.2/§9.5) --------------------------------
+
+/// The §9.5 written-channel disclaimer — the calibration copy from §8.1,
+/// verbatim (provenance framing, never invalidation). Server-rendered per
+/// channel: written (`form`/`manual-entry`) results with a stored verification
+/// block carry the call-encouragement note; minimal terminal results
+/// (unreachable/objected/refused — verification null) and rows without a
+/// result carry NO disclaimer (there is no written response to validate —
+/// their per-state display copy is the UX workstream's §8.2 job). Voice is
+/// v2-reserved (no v1 result is voice-channel).
+const written_response_disclaimer = "Written response, provenance-checked — not verbally confirmed. A quick call to the referee is the strongest final check."
+
+/// Terminal reference_call statuses (the migration's live-row exclusion set +
+/// `partial`). The canonical source is `compute_hooks_decoded`'s case — the
+/// migration's live-row index is the other half; keep both in lockstep.
+/// §8.2 hooks — the state rules the API computes so the panel never
+/// re-derives them client-side (AR-RC13).
+///
+/// - `can_record_manual`: any non-terminal status (a terminal has no live
+///   lifecycle left to record against; `skipped` is NOT terminal — A6
+///   re-enables it to `queued`).
+/// - `can_substitute_referee`: terminal `objected` / `unreachable` only (§8.2).
+/// - `can_retry`: `failed` only.
+///
+/// Hooks are computed from the DECODED status so they always agree with the
+/// status the wire carries: an unrecognised DB value (impossible today — the
+/// PG enum is constrained; a future expand-then-contract window) decodes to
+/// `Failed` and renders as a failed row with failed-row hooks — the panel can
+/// never show a recordable affordance on a row rendered terminal (self-review
+/// #3: hooks and status must never diverge on the wire).
+pub fn compute_hooks(status: String) -> shared_reference_call.ReferenceCallHooks {
+  compute_hooks_decoded(shared_reference_call.status_from_string(status))
+}
+
+/// Hooks from the DECODED status, so the hooks always agree with the
+/// status the wire carries (the encoder serialises via the same decode —
+/// an unknown DB value would surface as `failed` on the wire AND here,
+/// never as a recordable row rendered terminal). Pure and exported for the
+/// hook-matrix unit tests.
+pub fn compute_hooks_decoded(
+  status: shared_reference_call.ReferenceCallStatus,
+) -> shared_reference_call.ReferenceCallHooks {
+  let terminal = case status {
+    shared_reference_call.FormCompleted -> True
+    shared_reference_call.Partial -> True
+    shared_reference_call.Unreachable -> True
+    shared_reference_call.Refused -> True
+    shared_reference_call.Objected -> True
+    shared_reference_call.ManualRecorded -> True
+    shared_reference_call.Failed -> True
+    shared_reference_call.Completed -> True
+    _ -> False
+  }
+  shared_reference_call.ReferenceCallHooks(
+    can_record_manual: !terminal,
+    can_substitute_referee: status == shared_reference_call.Objected
+      || status == shared_reference_call.Unreachable,
+    can_retry: status == shared_reference_call.Failed,
+  )
+}
+
+/// §9.5 display_disclaimer: written-channel results carry the note iff the
+/// stored result contains a verification block (a written response actually
+/// exists). The result text is already §4.2-stripped at the SQL boundary.
+/// Unparseable/absent result -> None (no response to validate).
+pub fn compute_display_disclaimer(result_text: String) -> Option(String) {
+  case result_text {
+    "" -> None
+    text ->
+      case json.parse(text, decode.dynamic) {
+        Ok(value) ->
+          // The verification block is an OBJECT when a written response
+          // exists; it is null on minimal terminal results (unreachable /
+          // objected / refused). decode.dynamic accepts null, so require a
+          // dict to distinguish "a response exists" from "no response".
+          case
+            decode.run(
+              value,
+              decode.at(
+                ["verification"],
+                decode.dict(decode.string, decode.dynamic),
+              ),
+            )
+          {
+            Ok(_) -> Some(written_response_disclaimer)
+            Error(_) -> None
+          }
+        Error(_) -> None
+      }
+  }
+}
