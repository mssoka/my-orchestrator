+  application_detail_handler.compute_display_disclaimer("")
+  |> should.equal(None)
+}
+
+/// Malformed stored result -> no disclaimer (fail closed, never a fabricated
+/// note on unparseable data).
+pub fn disclaimer_malformed_result_test() {
+  application_detail_handler.compute_display_disclaimer("{not json")
+  |> should.equal(None)
+}
+
+// -- RC4.1: §4.2 boundary strip (the lens-guard) ------------------------------
+
+/// The serialized entry carries ONLY the §8.1 public keys — form_token,
+/// objection_detail.payload_ref, and raw IP/UA never reach the wire, even
+/// when the row fixture contains them (the SQL read strips at the boundary;
+/// this pins the encoder's whitelist).
+pub fn encode_reference_call_strips_internal_fields_test() {
+  // Realistic input: the SQL detail read has ALREADY stripped the raw
+  // IP/UA from result (that strip is the integration test's job to prove —
+  // the encoder cannot rebuild JSON). The encoder receives the stripped
+  // row; this pins the encoder's whitelist: the §8.1 public surface is
+  // serialized and the internal markers never appear in EITHER form
+  // (unescaped `"referee_ip"` or escaped `\"referee_ip\"` inside the
+  // result JSON-string field).
+  let row =
+    sample_reference_call_row(
+      status: "form_completed",
+      outcome: "form_completed",
+      result: "{\"schema_version\":\"refcall-v1\",\"fraud_signals\":{\"form_session\":{\"ip_matches_applicant\":true}}}",
+    )
+  let wire =
+    application_detail_handler.encode_reference_call(row)
+    |> json.to_string
+  // The §8.1 public surface survives.
+  wire |> string.contains("\"reference_call_id\"") |> should.be_true
+  wire |> string.contains("\"status\":\"form_completed\"") |> should.be_true
+  wire |> string.contains("\"attempt_count\":2") |> should.be_true
+  wire |> string.contains("\"attempts\"") |> should.be_true
+  wire |> string.contains("\"hooks\"") |> should.be_true
+  // The §4.2 internal-only markers are absent from the serialized payload.
+  application_detail_handler.verify_payload_has_no_internal_fields(wire)
+  |> should.be_true
+}
+
+/// Negative control (2026-08-09 field-note discipline): the guard must
+/// actually BITE. Feed it a payload that carries internals in both forms —
+/// unescaped (a hypothetical top-level key regression) and escaped (the real
+/// result-string form) — and assert it returns False. If the guard is ever
+/// weakened, this test fails.
+pub fn verify_payload_guard_detects_internal_markers_test() {
+  application_detail_handler.verify_payload_has_no_internal_fields(
+    "{\"data\":{\"reference_calls\":[{\"result\":\"{\\\"referee_ip\\\": \\\"203.0.113.7\\\"}\"}]}}",
+  )
+  |> should.be_false
+  application_detail_handler.verify_payload_has_no_internal_fields(
+    "{\"data\":{\"reference_calls\":[{\"referee_ip\":\"203.0.113.7\"}]}}",
+  )
+  |> should.be_false
+  application_detail_handler.verify_payload_has_no_internal_fields(
+    "{\"data\":{\"reference_calls\":[{\"form_token\":\"tok\"}]}}",
+  )
+  |> should.be_false
+  application_detail_handler.verify_payload_has_no_internal_fields(
+    "{\"data\":{\"reference_calls\":[{\"objection_detail\":{\"payload_ref\":\"p\"}}]}}",
+  )
+  |> should.be_false
+}
+
+/// The derived booleans (ip_matches_applicant) survive the strip — only the
+/// raw comparators are internal.
+pub fn encode_reference_call_keeps_derived_booleans_test() {
+  let row =
+    sample_reference_call_row(
+      status: "form_completed",
+      outcome: "form_completed",
+      result: "{\"schema_version\":\"refcall-v1\",\"fraud_signals\":{\"form_session\":{\"ip_matches_applicant\":true,\"device_fingerprint_match\":false}}}",
+    )
+  let wire =
+    application_detail_handler.encode_reference_call(row)
+    |> json.to_string
+  wire |> string.contains("ip_matches_applicant") |> should.be_true
+  wire |> string.contains("referee_ip") |> should.be_false
+}
+
+/// Pre-terminal row: null outcome/result/next_attempt_at encode as null, not
+/// '' (the panel distinguishes absent from empty).
+pub fn encode_reference_call_pre_terminal_nullables_test() {
+  let row = sample_reference_call_row(status: "queued", outcome: "", result: "")
+  let wire =
+    application_detail_handler.encode_reference_call(row)
+    |> json.to_string
+  wire |> string.contains("\"outcome\":null") |> should.be_true
+  wire |> string.contains("\"result\":null") |> should.be_true
+  wire |> string.contains("\"display_disclaimer\":null") |> should.be_true
+}
+
+/// Unparseable attempts degrade to [] (never a fabricated log entry).
+pub fn encode_reference_call_malformed_attempts_test() {
+  let row =
+    sql.ListReferenceCallsForDetailRow(
+      id: "uuid-rc-1",
+      ref_slot: "landlord_ref",
+      owner_label: "primary",
+      status: "queued",
+      outcome: "",
+      attempt_count: 0,
+      next_attempt_at: "",
+      attempts: "{not json",
+      result: "",
+    )
+  let wire =
+    application_detail_handler.encode_reference_call(row)
+    |> json.to_string
+  wire |> string.contains("\"attempts\":[]") |> should.be_true
+}
diff --git a/server/test/integration/reference_detail_payload_integration_test.gleam b/server/test/integration/reference_detail_payload_integration_test.gleam
new file mode 100644
index 00000000..9b89a9bf
--- /dev/null
+++ b/server/test/integration/reference_detail_payload_integration_test.gleam
@@ -0,0 +1,268 @@
+//// RC4.1 detail-payload integration tests — the §4.2 boundary strip + the
+//// §8.1 reference_calls[] contract end to end (DB → handler → wire).
+////
+//// The load-bearing assertions: a stored reference_call row carrying EVERY
+//// §4.2 internal marker (form_token, objection_detail.payload_ref, raw
+//// referee IP/UA inside result.fraud_signals.form_session) serialises to a
+//// payload that contains NONE of them — the read strips at the SQL boundary
+//// and the encoder whitelists the §8.1 public keys. Plus: hooks computed per
+//// §8.2, display_disclaimer per §9.5, attestation_on_file per AD-2/A4.
+
+import application/application_detail_handler
+import gleam/dynamic/decode
+import gleam/http
+import gleam/string
+import gleeunit/should
+import integration/helpers.{setup, test_server_config}
+import integration/test_db
+import pog
+import unitest
+import wisp/simulate
+
+/// Seeds landlord + vacancy + application + a `reference_call` row whose
+/// result carries the full §4.2 internal-only set (raw IP/UA in
+/// form_session), plus form_token + objection_detail with payload_ref.
+/// Returns (landlord_id, vacancy_id, application_id).
+fn seed_app_with_internal_rich_reference_call(
+  db: pog.Connection,
+) -> #(String, String, String) {
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, False)
+  let assert Ok(application_id) =
+    test_db.seed_application(db, vacancy_id, "rc41@test.com")
+
+  let result =
+    "{\"schema_version\":\"refcall-v1\",\"reference_call_id\":\"sentinel\",\"application_id\":\""
+    <> application_id
+    <> "\",\"ref_slot\":\"landlord_ref\",\"owner_label\":\"primary\",\"channel\":\"form\",\"outcome\":\"form_completed\",\"attempts\":[],\"verification\":{\"identity_confirmed\":true,\"relationship_to_applicant\":\"landlord\"},\"fraud_signals\":{\"contact_reused_within_application\":false,\"contact_duplicate_of_applicant\":false,\"contact_reused_across_applications\":false,\"line_type\":\"mobile\",\"voip_or_burner\":false,\"form_session\":{\"completion_seconds\":300,\"ip_matches_applicant\":true,\"device_fingerprint_match\":false,\"focus_seconds_reported\":280,\"referee_ip\":\"203.0.113.7\",\"referee_user_agent\":\"Mozilla/5.0 (Macintosh)\"},\"geo_vs_claimed_property\":\"unknown\",\"coached_answer_score\":null},\"ai_summary\":{\"headline\":\"sentinel\"},\"compliance\":{\"gdpr_notice_given\":true,\"referee_channel_preference\":null,\"recording_consent\":\"not_recorded\"}}"
+
+  let decoder = decode.at([0], decode.string)
+  let assert Ok(returned) =
+    pog.query(
+      "INSERT INTO reference_call (
+         application_id, ref_slot, owner_label, status, outcome,
+         contact_name, contact_email, contact_phone,
+         attempt_count, next_attempt_at, attempts,
+         form_token, channel, result, fraud_signals,
+         objection_detail
+       )
+       VALUES (
+         $1::uuid, 'landlord_ref', 'primary', 'form_completed', 'form_completed',
+         'Larry Landlord', 'larry@example.com', '+353871111111',
+         2, now(), '[{\"at\":\"2026-08-01T08:00:00Z\",\"channel\":\"email\",\"outcome\":\"delivered\",\"detail\":\"\"}]'::jsonb,
+         'form_token_internal_sentinel', 'form', $2::jsonb, $2::jsonb,
+         '{\"channel\":\"form\",\"received_at\":\"2026-08-01T09:00:00Z\",\"payload_ref\":\"obj_payload_ref_sentinel\"}'::jsonb
+       )
+       RETURNING id::text",
+    )
+    |> pog.parameter(pog.text(application_id))
+    |> pog.parameter(pog.text(result))
+    |> pog.returning(decoder)
+    |> pog.execute(db)
+  let assert [row_id, ..] = returned.rows
+  let _ = row_id
+  #(landlord_id, vacancy_id, application_id)
+}
+
+/// GET the detail payload as the landlord would.
+fn fetch_detail(
+  db: pog.Connection,
+  landlord_id: String,
+  vacancy_id: String,
+  application_id: String,
+) -> String {
+  let req =
+    simulate.request(
+      http.Get,
+      "/api/v1/vacancies/" <> vacancy_id <> "/applications/" <> application_id,
+    )
+  let resp =
+    application_detail_handler.handle_get_detail(
+      req,
+      test_server_config(db),
+      test_db.test_landlord(landlord_id),
+      vacancy_id,
+      application_id,
+    )
+  resp.status |> should.equal(200)
+  simulate.read_body(resp)
+}
+
+/// The §4.2 lens-guard: every internal-only marker stored in the row is
+/// ABSENT from the serialized payload, while the §8.1 public contract
+/// (reference_calls[] with all fields + hooks + disclaimer) is present.
+pub fn detail_payload_strips_internal_fields_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(landlord_id, vacancy_id, application_id) =
+    seed_app_with_internal_rich_reference_call(db)
+  let body = fetch_detail(db, landlord_id, vacancy_id, application_id)
+
+  // §4.2: internals never leave the server. The result document rides as a
+  // JSON *string* field, so its inner keys appear backslash-escaped on the
+  // wire (`\"referee_ip\"`) — assert BOTH the unescaped and escaped forms
+  // absent, plus the raw values themselves (self-review #1: the unescaped
+  // form alone is vacuous).
+  string.contains(body, "form_token_internal_sentinel") |> should.be_false
+  string.contains(body, "obj_payload_ref_sentinel") |> should.be_false
+  string.contains(body, "\"referee_ip\"") |> should.be_false
+  string.contains(body, "\\\"referee_ip\\\"") |> should.be_false
+  string.contains(body, "\"referee_user_agent\"") |> should.be_false
+  string.contains(body, "\\\"referee_user_agent\\\"") |> should.be_false
+  string.contains(body, "203.0.113.7") |> should.be_false
+  string.contains(body, "Mozilla/5.0") |> should.be_false
+
+  // The strip must actually BITE (negative-control discipline): the payload
+  // DOES carry public reference data (the entry's top-level key is
+  // unescaped), proving the absence-assertions above are live, not vacuous.
+  string.contains(body, "\"reference_call_id\"") |> should.be_true
+  string.contains(body, "\"attempt_count\":2") |> should.be_true
+
+  // §8.1: the contract surface is present.
+  string.contains(body, "\"reference_calls\"") |> should.be_true
+  string.contains(body, "\"reference_call_id\"") |> should.be_true
+  string.contains(body, "\"ref_slot\":\"landlord_ref\"") |> should.be_true
+  string.contains(body, "\"owner_label\":\"primary\"") |> should.be_true
+  string.contains(body, "\"status\":\"form_completed\"") |> should.be_true
+  string.contains(body, "\"outcome\":\"form_completed\"") |> should.be_true
+  string.contains(body, "\"attempt_count\":2") |> should.be_true
+  string.contains(body, "\"attempts\"") |> should.be_true
+  string.contains(body, "\"hooks\"") |> should.be_true
+  string.contains(body, "\"can_record_manual\":false") |> should.be_true
+  string.contains(body, "\"can_substitute_referee\":false") |> should.be_true
+  string.contains(body, "\"can_retry\":false") |> should.be_true
+  // §9.5: written result with verification -> the calibration disclaimer.
+  string.contains(body, "Written response, provenance-checked")
+  |> should.be_true
+  // §4.2: the DERIVED booleans survive (only the raw comparators are
+  // internal). The stored result is embedded as a JSON *string* field, so
+  // its inner keys are double-escaped in the raw body (\"key\").
+  string.contains(body, "\\\"ip_matches_applicant\\\": true")
+  |> should.be_true
+  string.contains(body, "\\\"device_fingerprint_match\\\": false")
+  |> should.be_true
+  // The result document itself is present (stripped).
+  string.contains(body, "\\\"schema_version\\\": \\\"refcall-v1\\\"")
+  |> should.be_true
+}
+
+/// Negative control (2026-08-09 field-note discipline): the stripping
+/// assertions must actually bite. Flip the check to search for a marker the
+/// payload DOES carry — proving the assertion path is live, not vacuously
+/// green. (This test asserts the positive; the strip test above asserts the
+/// negative. If the read ever stops stripping, the strip test fails.)
+pub fn payload_does_carry_public_reference_data_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(landlord_id, vacancy_id, application_id) =
+    seed_app_with_internal_rich_reference_call(db)
+  let body = fetch_detail(db, landlord_id, vacancy_id, application_id)
+  // The §8.1 entry surface is present — the search path is live.
+  string.contains(body, "\"reference_call_id\"") |> should.be_true
+  string.contains(body, "larry@example.com") |> should.be_false
+}
+
+/// AD-2/A4: attestation_on_file is true when the applicant's
+/// reference_contact_attestation acknowledgement row exists, false otherwise.
+pub fn attestation_on_file_reflects_acknowledgement_row_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, False)
+  let assert Ok(application_id) =
+    test_db.seed_application(db, vacancy_id, "rc41-attest@test.com")
+
+  let decoder = decode.at([0], decode.string)
+  let assert Ok(_) =
+    pog.query(
+      "INSERT INTO acknowledgement_record (application_id, record_type, policy_version)
+       VALUES ($1::uuid, 'reference_contact_attestation', 'v1')
+       RETURNING id::text",
+    )
+    |> pog.parameter(pog.text(application_id))
+    |> pog.returning(decoder)
+    |> pog.execute(db)
+
+  let body = fetch_detail(db, landlord_id, vacancy_id, application_id)
+  string.contains(body, "\"attestation_on_file\":true") |> should.be_true
+}
+
+pub fn attestation_on_file_false_without_row_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, False)
+  let assert Ok(application_id) =
+    test_db.seed_application(db, vacancy_id, "rc41-noattest@test.com")
+  let body = fetch_detail(db, landlord_id, vacancy_id, application_id)
+  string.contains(body, "\"attestation_on_file\":false") |> should.be_true
+}
+
+/// Pre-trigger apps (no reference rows): reference_calls is an empty array,
+/// never null and never missing.
+pub fn reference_calls_empty_for_untriggered_app_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, False)
+  let assert Ok(application_id) =
+    test_db.seed_application(db, vacancy_id, "rc41-empty@test.com")
+  let body = fetch_detail(db, landlord_id, vacancy_id, application_id)
+  string.contains(body, "\"reference_calls\":[]") |> should.be_true
+}
+
+/// The existing detail contract is untouched: applications, ai_analysis,
+/// audit trail, documents and household sidecars still serialize.
+pub fn existing_detail_contract_preserved_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, False)
+  let assert Ok(application_id) =
+    test_db.seed_application(db, vacancy_id, "rc41-contract@test.com")
+  let body = fetch_detail(db, landlord_id, vacancy_id, application_id)
+  string.contains(body, "\"application\"") |> should.be_true
+  string.contains(body, "\"ai_analysis\"") |> should.be_true
+  string.contains(body, "\"audit_trail\"") |> should.be_true
+  string.contains(body, "\"documents\"") |> should.be_true
+  string.contains(body, "\"income_sources\"") |> should.be_true
+  string.contains(body, "\"co_applicants\"") |> should.be_true
+  string.contains(body, "\"vacancy_name\"") |> should.be_true
+}
+
+/// Corrupt-row resilience (self-review #5): a scalar/mis-shaped stored result
+/// must not error the whole read — the jsonb_typeof guard passes it through
+/// verbatim (a non-object result cannot carry the form_session path, so no
+/// §4.2 leak) and the other rows still render. The payload stays 200 with
+/// the remaining reference_calls visible.
+pub fn corrupt_scalar_result_does_not_break_read_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, False)
+  let assert Ok(application_id) =
+    test_db.seed_application(db, vacancy_id, "rc41-corrupt@test.com")
+
+  let decoder = decode.at([0], decode.string)
+  let assert Ok(_) =
+    pog.query(
+      "INSERT INTO reference_call (
+         application_id, ref_slot, owner_label, status, outcome,
+         contact_name, attempt_count, attempts, result
+       )
+       VALUES (
+         $1::uuid, 'landlord_ref', 'primary', 'form_completed', 'form_completed',
+         'Larry Landlord', 1, '[]'::jsonb, '42'::jsonb
+       )
+       RETURNING id::text",
+    )
+    |> pog.parameter(pog.text(application_id))
+    |> pog.returning(decoder)
+    |> pog.execute(db)
+
+  let body = fetch_detail(db, landlord_id, vacancy_id, application_id)
+  // The row still renders (scalar result passes through verbatim).
+  string.contains(body, "\"reference_call_id\"") |> should.be_true
+  // And the §4.2 markers stay absent.
+  string.contains(body, "\"referee_ip\"") |> should.be_false
+}
