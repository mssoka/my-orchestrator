+/// §8.2 hook matrix — the load-bearing state rules. Terminal rows get no
+/// manual-record; objected/unreachable get substitute; failed gets retry;
+/// everything else is recordable.
+pub fn hooks_compute_matrix_test() {
+  let check = fn(status: String, record: Bool, substitute: Bool, retry: Bool) {
+    let hooks = application_detail_handler.compute_hooks(status)
+    hooks.can_record_manual |> should.equal(record)
+    hooks.can_substitute_referee |> should.equal(substitute)
+    hooks.can_retry |> should.equal(retry)
+  }
+  check("queued", True, False, False)
+  check("skipped", True, False, False)
+  check("contact_initiated", True, False, False)
+  check("awaiting_correction", True, False, False)
+  check("form_completed", False, False, False)
+  check("partial", False, False, False)
+  check("unreachable", False, True, False)
+  check("refused", False, False, False)
+  check("objected", False, True, False)
+  check("manual_recorded", False, False, False)
+  check("failed", False, False, True)
+  // v2-reserved voice statuses are non-terminal — recordable.
+  check("scheduled", True, False, False)
+  check("calling", True, False, False)
+  check("completed", False, False, False)
+}
