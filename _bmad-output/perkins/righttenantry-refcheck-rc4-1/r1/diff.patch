+    owner_label: shared_reference_call.owner_label_from_string(row.owner_label),
+    status: shared_reference_call.status_from_string(row.status),
+    outcome: case row.outcome {
+      "" -> None
+      s -> Some(shared_reference_call.outcome_from_string(s))
+    },
+    attempt_count: row.attempt_count,
+    next_attempt_at: case row.next_attempt_at {
+      "" -> None
+      s -> Some(s)
+    },
+    attempts:,
+    result: case row.result {
+      "" -> None
+      s -> Some(s)
+    },
+    display_disclaimer: disclaimer,
+    hooks:,
+  ))
+}
+
+/// Parse the stored attempts JSONB text into typed entries. The row's
+/// `attempts` JSONB shape is `[{at, channel, outcome, detail}]` (all strings,
+/// append-only). Unparseable/empty text -> [] (the log is absent, never a
+/// fabricated entry).
+fn parse_attempt_log(
+  text: String,
+) -> List(shared_reference_call.ReferenceCallAttempt) {
+  case text {
+    "" -> []
+    t ->
+      case json.parse(t, decode.list(shared_reference_call.attempt_decoder())) {
+        Ok(entries) -> entries
+        Error(_) -> []
+      }
+  }
+}
