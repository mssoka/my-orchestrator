diff --git a/server/src/application/form_sections/reference_attestation.gleam b/server/src/application/form_sections/reference_attestation.gleam
new file mode 100644
index 00000000..3caf0d7b
--- /dev/null
+++ b/server/src/application/form_sections/reference_attestation.gleam
@@ -0,0 +1,187 @@
+//// Reference-contact attestation card (refcheck v1, RC1.2).
+////
+//// Rendered at the end of the References section, this card records the
+//// applicant's explicit choice about referee contact: `attested` (Yes — my
+//// referees expect to be contacted) or `declined` (No — don't contact my
+//// referees automatically). It is an acknowledgement, not consent — the
+//// lawful basis for contact is legitimate interest, and the word "consent"
+//// never appears in relation to this record (AD-2).
+////
+//// All copy is verbatim from the UX spec (§5.3, consolidated in the §10.1
+//// copy deck) and lives in `form_copy`. The card reuses the `.consent-block`
+//// elevated-card anatomy (UX §13) rather than inventing a new treatment.
+////
+//// `validate_choice` is the single owner of the submission-time rule (an
+//// explicit choice, no default, no silent skip — fixed server-side in
+//// RC1.1). `application_handler.validate_form` delegates to it, and the
+//// form-stepper work lifts the same function into its References-step
+//// gating — keep it self-contained.
+
+import application/form_copy
+import application/form_sections/common
+import gleam/list
+import gleam/string
+import lustre/attribute.{attribute}
+import lustre/element
+import lustre/element/html
+
+/// Submission field name — fixed by RC1.1's server contract (`validate_form`,
+/// `insert_application_row`, `error_summary.label_for`).
+pub const field_name = "reference_contact_choice"
+
+/// Posted value for the Yes option ("attestation recorded" — writes a
+/// `reference_contact_attestation` acknowledgement row, RC1.1).
+pub const attested_value = "attested"
+
+/// Posted value for the No option (feature off for this application; submits
+/// normally, no acknowledgement row).
+pub const declined_value = "declined"
+
+/// The submission-time attestation rule: an explicit attested/declined
+/// answer is required — no default selection, no silent skip. Returns the
+/// error tuple (keyed with `field_name` so the error summary anchors to the
+/// card) for the caller to prepend to its error list.
+pub fn validate_choice(
+  values: List(#(String, String)),
+) -> Result(Nil, #(String, String)) {
+  // Trimmed to match `application_handler.get_form_value`, which the insert
+  // and acknowledgement-write paths read through — validator and writer must
+  // agree on what counts as a choice.
+  case common.get_val(values, field_name) |> string.trim {
+    "attested" | "declined" -> Ok(Nil)
+    _ -> Error(#(field_name, form_copy.attestation_choice_error))
+  }
+}
+
+/// The attestation card. `selected` is the posted value on an error
+/// re-render ("" on first paint — no default selection, ever); `error` is
+/// the validation message when the submit came back unanswered.
+pub fn view(
+  selected selected: String,
+  error error: String,
+) -> element.Element(a) {
+  let has_err = error != ""
+  let error_id = "field-" <> field_name <> "-error"
+  html.div(
+    [
+      attribute.class(case has_err {
+        True -> "consent-block has-error"
+        False -> "consent-block"
+      }),
+      // Error-summary anchor target (`error_summary.anchor_for`) — the banner
+      // link scrolls here when the choice is missing at submit.
+      attribute.id("field-" <> field_name),
+      attribute("data-testid", "ref-attestation"),
+    ],
+    [
+      html.h3(
+        [
+          attribute.class("attestation-heading"),
+          attribute.id("ref-attestation-heading"),
+        ],
+        [html.text(form_copy.attestation_heading)],
+      ),
+      html.p(
+        [
+          attribute.class("attestation-body"),
+          attribute.id("ref-attestation-help"),
+        ],
+        [
+          html.text(form_copy.attestation_body <> " "),
+          html.a(
+            [
+              attribute.href("/privacy"),
+              attribute("target", "_blank"),
+              attribute("rel", "noopener noreferrer"),
+            ],
+            [html.text(form_copy.attestation_privacy_link)],
+          ),
+        ],
+      ),
+      html.div(
+        [
+          attribute.class("attestation-options"),
+          attribute("role", "radiogroup"),
+          attribute("aria-required", "true"),
+          attribute("aria-labelledby", "ref-attestation-heading"),
+          // Help text always describes the group; on error the message joins
+          // it so the group↔error association persists beyond the one-shot
+          // role="alert" announcement (house `view_error_span` pattern).
+          attribute("aria-describedby", case has_err {
+            True -> "ref-attestation-help " <> error_id
+            False -> "ref-attestation-help"
+          }),
+        ],
+        [
+          view_option(
+            value: attested_value,
+            label: form_copy.attestation_yes_label,
+            description: form_copy.attestation_yes_description,
+            testid: "ref-attestation-yes",
+            selected: selected,
+          ),
+          view_option(
+            value: declined_value,
+            label: form_copy.attestation_no_label,
+            description: form_copy.attestation_no_description,
+            testid: "ref-attestation-no",
+            selected: selected,
+          ),
+        ],
+      ),
+      html.p([attribute.class("attestation-footer")], [
+        html.text(form_copy.attestation_footer),
+      ]),
+      ..case has_err {
+        True -> [
+          html.span(
+            [
+              attribute.class("field-error"),
+              attribute.id(error_id),
+              attribute("role", "alert"),
+              attribute("aria-live", "polite"),
+              attribute("style", "display:flex"),
+            ],
+            [html.text(error)],
+          ),
+        ]
+        False -> []
+      }
+    ],
+  )
+}
+
+fn view_option(
+  value value: String,
+  label label: String,
+  description description: String,
+  testid testid: String,
+  selected selected: String,
+) -> element.Element(a) {
+  let opt_id = "field-" <> field_name <> "-" <> value
+  let checked_attrs = case value == selected {
+    True -> [attribute("checked", "")]
+    False -> []
+  }
+  html.label([attribute.class("attestation-option"), attribute.for(opt_id)], [
+    html.input(
+      [
+        attribute.type_("radio"),
+        attribute.id(opt_id),
+        attribute.name(field_name),
+        attribute.value(value),
+        attribute("required", ""),
+        attribute("data-testid", testid),
+      ]
+      |> list.append(checked_attrs),
+    ),
+    html.span([attribute.class("attestation-option-text")], [
+      html.span([attribute.class("attestation-option-label")], [
+        html.text(label),
+      ]),
+      html.span([attribute.class("attestation-option-description")], [
+        html.text(description),
+      ]),
+    ]),
+  ])
+}
