diff --git a/server/test/application/reference_attestation_test.gleam b/server/test/application/reference_attestation_test.gleam
new file mode 100644
index 00000000..57b6a760
--- /dev/null
+++ b/server/test/application/reference_attestation_test.gleam
@@ -0,0 +1,259 @@
+//// Tests for the reference-contact attestation card (refcheck v1, RC1.2).
+////
+//// Pins the story's acceptance criteria: verbatim §5.2/§5.3 copy, required
+//// radio pair with no default selection, the radiogroup aria wiring, the
+//// error-summary anchor/scroll contract, re-selection on error re-render,
+//// and `validate_choice` — the single function the form-stepper lifts into
+//// its References-step gating.
+
+import application/form_copy
+import application/form_pages
+import application/form_sections/reference_attestation
+import application/form_sections/references
+import gleam/string
+import gleeunit/should
+import lustre/element
+import test_helpers
+
+fn render(selected: String, error: String) -> String {
+  reference_attestation.view(selected: selected, error: error)
+  |> element.to_string
+}
+
+// -- Pristine render (first paint) ---------------------------------------------
+
+pub fn card_renders_verbatim_copy_and_testids_test() {
+  let html = render("", "")
+  html |> string.contains("data-testid=\"ref-attestation\"") |> should.be_true
+  html
+  |> string.contains("data-testid=\"ref-attestation-yes\"")
+  |> should.be_true
+  html
+  |> string.contains("data-testid=\"ref-attestation-no\"")
+  |> should.be_true
+  // UX §5.3, verbatim (constants live in form_copy).
+  html |> string.contains("Contacting your referees") |> should.be_true
+  html
+  |> string.contains(
+    "RightTenantry can check your references for the landlord.",
+  )
+  |> should.be_true
+  html
+  |> string.contains("How we handle referee data \u{2197}")
+  |> should.be_true
+  html
+  |> string.contains("Yes \u{2014} my referees expect to be contacted")
+  |> should.be_true
+  html
+  |> string.contains(
+    "They\u{2019}ve agreed to act as my referees and know they\u{2019}ll hear from RightTenantry.",
+  )
+  |> should.be_true
+  html
+  |> string.contains(
+    "No \u{2014} don\u{2019}t contact my referees automatically",
+  )
+  |> should.be_true
+  html
+  |> string.contains(
+    "The landlord will see my references and can contact them directly instead.",
+  )
+  |> should.be_true
+  html
+  |> string.contains(
+    "Either choice is fine. It changes how references are checked, not how your application is shown.",
+  )
+  |> should.be_true
+}
+
+pub fn card_radiogroup_aria_wiring_test() {
+  let html = render("", "")
+  html |> string.contains("role=\"radiogroup\"") |> should.be_true
+  html |> string.contains("aria-required=\"true\"") |> should.be_true
+  html
+  |> string.contains("aria-describedby=\"ref-attestation-help\"")
+  |> should.be_true
+  html
+  |> string.contains("aria-labelledby=\"ref-attestation-heading\"")
+  |> should.be_true
+  // The help-text element the describedby points at must exist.
+  html |> string.contains("id=\"ref-attestation-help\"") |> should.be_true
+  html
+  |> string.contains("id=\"ref-attestation-heading\"")
+  |> should.be_true
+}
+
+pub fn card_posts_the_rc1_1_contract_test() {
+  let html = render("", "")
+  // Field name + values fixed by RC1.1's validate_form / insert path.
+  html
+  |> string.contains("name=\"reference_contact_choice\"")
+  |> should.be_true
+  html |> string.contains("value=\"attested\"") |> should.be_true
+  html |> string.contains("value=\"declined\"") |> should.be_true
+  // Required, and the error-summary anchor id on the card.
+  html |> string.contains("required") |> should.be_true
+  html
+  |> string.contains("id=\"field-reference_contact_choice\"")
+  |> should.be_true
+  // Privacy link opens the notice in a new tab (house pattern).
+  html |> string.contains("href=\"/privacy\"") |> should.be_true
+  html |> string.contains("target=\"_blank\"") |> should.be_true
+}
+
+pub fn card_has_no_default_selection_test() {
+  // No `checked` attribute on either radio on first paint — an explicit
+  // choice, never an assumed-yes dark pattern. (Lustre renders the empty
+  // attribute as a bare `checked` immediately before `data-testid`; the
+  // footer copy contains the word "checked", so assert the attribute form.)
+  let html = render("", "")
+  html
+  |> string.contains("checked data-testid=\"ref-attestation-yes\"")
+  |> should.be_false
+  html
+  |> string.contains("checked data-testid=\"ref-attestation-no\"")
+  |> should.be_false
+}
+
+// -- Error state ----------------------------------------------------------------
+
+pub fn card_error_state_shows_message_and_has_error_test() {
+  let html = render("", form_copy.attestation_choice_error)
+  html |> string.contains("has-error") |> should.be_true
+  html
+  |> string.contains("Choose one option to continue.")
+  |> should.be_true
+  // Error announced on submit-scroll (role="alert" live region).
+  html |> string.contains("role=\"alert\"") |> should.be_true
+}
+
+// -- Re-selection on error re-render ---------------------------------------------
+
+pub fn card_reselects_attested_on_rerender_test() {
+  let html = render("attested", "")
+  html
+  |> string.contains("checked data-testid=\"ref-attestation-yes\"")
+  |> should.be_true
+  html
+  |> string.contains("checked data-testid=\"ref-attestation-no\"")
+  |> should.be_false
+}
+
+pub fn card_reselects_declined_on_rerender_test() {
+  let html = render("declined", "")
+  html
+  |> string.contains("checked data-testid=\"ref-attestation-no\"")
+  |> should.be_true
+  html
+  |> string.contains("checked data-testid=\"ref-attestation-yes\"")
+  |> should.be_false
+}
+
+// -- validate_choice (the stepper-callable owner) ---------------------------------
+
+pub fn validate_choice_accepts_attested_and_declined_test() {
+  reference_attestation.validate_choice([
+    #("reference_contact_choice", "attested"),
+  ])
+  |> should.be_ok
+  reference_attestation.validate_choice([
+    #("reference_contact_choice", "declined"),
+  ])
+  |> should.be_ok
+  // Surrounding whitespace still counts — the validator and the
+  // (trimming) insert/acknowledgement paths must agree.
+  reference_attestation.validate_choice([
+    #("reference_contact_choice", " attested "),
+  ])
+  |> should.be_ok
+}
+
+pub fn validate_choice_rejects_missing_empty_and_tampered_test() {
+  let expected =
+    Error(#("reference_contact_choice", "Choose one option to continue."))
+  reference_attestation.validate_choice([])
+  |> should.equal(expected)
+  reference_attestation.validate_choice([#("reference_contact_choice", "")])
+  |> should.equal(expected)
+  reference_attestation.validate_choice([
+    #("reference_contact_choice", "yes"),
+  ])
+  |> should.equal(expected)
+}
+
+// -- Section integration -----------------------------------------------------------
+
+pub fn references_section_has_framing_and_card_test() {
+  let html = references.view(values: [], errors: []) |> element.to_string
+  // §5.2 framing, verbatim, above the first referee field group.
+  html |> string.contains("Your references") |> should.be_true
+  html
+  |> string.contains(
+    "Give details for people who know you as a tenant, employee, or personally. If you\u{2019}re happy for us to, we\u{2019}ll check these references for the landlord \u{2014} see the choice at the end of this section.",
+  )
+  |> should.be_true
+  // Framing renders before the first referee field group. Presence is
+  // asserted before ordering: string.crop returns the whole document on a
+  // missing substring, which would pass the length comparison vacuously.
+  html |> string.contains("landlord-ref-group") |> should.be_true
+  let intro_at = string.crop(html, "Your references")
+  let group_at = string.crop(html, "landlord-ref-group")
+  { string.length(intro_at) > string.length(group_at) }
+  |> should.be_true
+  // Card renders after the last field of the section (has_ccjs radio).
+  html |> string.contains("field-has_ccjs") |> should.be_true
+  let card_at = string.crop(html, "data-testid=\"ref-attestation\"")
+  let ccjs_at = string.crop(html, "field-has_ccjs")
+  { string.length(card_at) < string.length(ccjs_at) }
+  |> should.be_true
+  // The superseded pre-v1 hint is gone (contradicted the attestation).
+  html
+  |> string.contains("will ring every reference you list")
+  |> should.be_false
+}
+
+pub fn references_section_rerenders_choice_error_inline_test() {
+  let html =
+    references.view(
+      values: [#("reference_contact_choice", "attested")],
+      errors: [
+        #("reference_contact_choice", "Choose one option to continue."),
+      ],
+    )
+    |> element.to_string
+  html
+  |> string.contains("Choose one option to continue.")
+  |> should.be_true
+  html |> string.contains("has-error") |> should.be_true
+  html
+  |> string.contains("checked data-testid=\"ref-attestation-yes\"")
+  |> should.be_true
+}
+
+// -- Submit-scroll wiring: banner anchor → card -----------------------------------
+
+pub fn error_rerender_banner_links_to_card_test() {
+  let vacancy = test_helpers.test_vacancy_row()
+  let errors = [
+    #("reference_contact_choice", "Choose one option to continue."),
+  ]
+  let values = [#("email", "aisling@example.com")]
+  let html = form_pages.view_form_with_errors(vacancy, errors, values, "")
+  // Banner anchor targets the card id…
+  html
+  |> string.contains("href=\"#field-reference_contact_choice\"")
+  |> should.be_true
+  // …with the §5.3 card heading as its label — asserted as the banner row's
+  // full "label — message" string so a label_for regression can't hide
+  // behind the card's own h3 rendering the same words.
+  html
+  |> string.contains(
+    "Contacting your referees \u{2014} Choose one option to continue.",
+  )
+  |> should.be_true
+  // …and the card itself renders the inline error.
+  html
+  |> string.contains("id=\"field-reference_contact_choice\"")
+  |> should.be_true
+  html |> string.contains("has-error") |> should.be_true
+}
