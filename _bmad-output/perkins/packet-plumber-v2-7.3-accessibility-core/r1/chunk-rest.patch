new file mode 100644
index 0000000..552ddb0
--- /dev/null
+++ b/tools/derive_a11y_palettes.py
@@ -0,0 +1,257 @@
+#!/usr/bin/env python3
+"""derive_a11y_palettes.py — Story 7.3's colorblind palette derivation.
+
+The three deficiency mode tables in data/palette.json ("modes") are NOT
+aesthetic choices: they are DERIVED. This script is the derivation record —
+
+  1. Take the canon palette tokens (data/palette.json) + the packet class
+     colors (data/packet_types.json — the catalog itself is NEVER edited;
+     class remaps ride the mode table and apply at draw time).
+  2. Simulate each token under Deuteranopia / Protanopia / Tritanopia
+     (Machado, Oliveira & Fernandes 2009, physiologically-based model,
+     severity 1.0 — sRGB -> linear -> matrix -> back).
+  3. Check every SIGNAL pair (states, lanes, ghost, pipe tiers, route marks,
+     packet classes) + the MAP pairs (water/park/coast vs land) for
+     separation under the simulation.
+  4. Where a pair collides, search the mode-space remap: shift lightness
+     (the axis that survives ALL three deficiencies) and nudge hue onto the
+     deficiency's residual discriminable axis (blue-yellow for deutan/protan,
+     red-green for tritan), within the light-canvas aesthetic (muted tones,
+     warm reserved for danger).
+  5. Emit the JSON mode tables + a verification report.
+
+The runtime oracle (harness/palcheck.odin) re-simulates and enforces the same
+pairwise thresholds against the SHIPPED tables — this script derives;
+palcheck keeps the tables honest forever.
+
+Usage: python3 tools/derive_a11y_palettes.py   (writes the report to stdout;
+       paste the "modes" block into data/palette.json verbatim).
+"""
+
+import json, math, sys, itertools
+
+# ---------------------------------------------------------------- transforms
+
+def srgb_to_linear(c):  # c in 0..255 -> 0..1
+    c = c / 255.0
+    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
+
+def linear_to_srgb(c):  # 0..1 -> 0..255
+    v = c / 12.92 if c <= 0.04045 else 1.055 * (c ** (1 / 2.4)) - 0.055
+    return max(0, min(255, round(v * 255)))
+
+# Machado et al. 2009 severity-1.0 matrices (linear RGB).
+MATRICES = {
+    "deutan": (0.367322, 0.860646, -0.227968,
+               0.280085, 0.672501,  0.047413,
+               -0.011820, 0.042940, 0.968881),
+    "protan": (0.152286, 1.052583, -0.204868,
+               0.114503, 0.786281,  0.099216,
+               -0.003882, -0.048116, 1.051998),
+    "tritan": (1.255528, -0.076749, -0.178779,
+               -0.078411, 0.930809,  0.147602,
+               0.004733,  0.691367,  0.303900),
+}
+
+def simulate(rgb, mode):
+    m = MATRICES[mode]
+    r, g, b = (srgb_to_linear(c) for c in rgb)
+    lr = m[0]*r + m[1]*g + m[2]*b
+    lg = m[3]*r + m[4]*g + m[5]*b
+    lb = m[6]*r + m[7]*g + m[8]*b
+    return (linear_to_srgb(lr), linear_to_srgb(lg), linear_to_srgb(lb))
+
+def dist(a, b):  # Euclidean on simulated 8-bit sRGB (0..441)
+    return math.sqrt(sum((x - y) ** 2 for x, y in zip(a, b)))
+
+def lum(rgb):  # relative luminance 0..1 (for the lightness axis)
+    r, g, b = (srgb_to_linear(c) for c in rgb)
+    return 0.2126 * r + 0.7152 * g + 0.0722 * b
+
+def scale_lum(rgb, target_l):
+    """Scale a color's luminance toward target_l, clamped (a crude but
+    deterministic L shift — hue family is preserved to first order)."""
+    cur = lum(rgb)
+    if cur <= 0:
+        cur = 1e-6
+    for _ in range(64):
+        k = target_l / cur
+        cand = tuple(max(0, min(255, round(c * k))) for c in rgb)
+        if lum(cand) >= target_l * 0.98:
+            return cand
+        rgb = cand
+        cur = max(lum(cand), 1e-6)
+    return rgb
+
+def mix(a, b, t):  # linear mix in 8-bit space
+    return tuple(round(x + (y - x) * t) for x, y in zip(a, b))
+
+# ---------------------------------------------------------------- the canon
+
+PAL = json.load(open("data/palette.json"))
+PKT = json.load(open("data/packet_types.json"))
+
+def tok(name):
+    v = PAL[name]
+    return tuple(v[:3])
+
+CLASS_BASE = {e["id"]: tuple(e["color_rgba"][:3]) for e in PKT["entries"]}
+
+# Signal pairs: (label, color-a, color-b, threshold). T_SIGNAL: calibrated so
+# every canon pair that a normal-vision player reads as clearly distinct
+# clears it, and the classic CVD collisions (green vs red etc.) fail it.
+T_SIGNAL, T_MAP = 48.0, 40.0
+
+def pair_list(mode, remap, classes):
+    """The oracle pairs, computed on EFFECTIVE colors (mode remap overrides
+    base palette / catalog values — the whole point)."""
+    P = []
+    def eff(name):
+        if name in remap and name != "house_roofs":
+            return tuple(remap[name][:3])
+        return tok(name)
+    triad = [eff("state_healthy"), eff("state_congested"), eff("state_critical")]
+    for a, b in itertools.combinations(triad, 2):
+        P.append(("state-triad", a, b, T_SIGNAL))
+    lanes = [eff("lane_express"), eff("lane_standard"), eff("lane_best_effort")]
+    for a, b in itertools.combinations(lanes, 2):
+        P.append(("lanes", a, b, T_SIGNAL))
+    P.append(("ghost", eff("ghost_ok"), eff("ghost_bad"), T_SIGNAL))
+    pipes = [eff("pipe_copper"), eff("pipe_steel"), eff("pipe_fiber")]
+    for a, b in itertools.combinations(pipes, 2):
+        P.append(("pipe-tiers", a, b, T_SIGNAL))
+    P.append(("route-marks", eff("route_glow"), eff("route_tie"), T_SIGNAL))
+    cls = [tuple(classes.get(cid, CLASS_BASE[cid])[:3]) for cid in CLASS_BASE]
+    for a, b in itertools.combinations(cls, 2):
+        P.append(("packet-classes", a, b, T_SIGNAL))
+    # map legibility (soft pairs)
+    for a, b in [("water", "park"), ("water", "canvas"), ("park", "canvas"), ("coast", "canvas")]:
+        P.append((f"map-{a}-{b}", eff(a), eff(b), T_MAP))
+    return P
+
+# ---------------------------------------------------------------- derivation
+# The remap strategy per mode (hand-set target luminances / hue anchors — the
+# Okabe-Ito logic: L separation + the residual axis), then numeric search.
+
+def derive(mode):
+    classes = dict(CLASS_BASE)  # mode remaps for class colors
+    remap = {}                  # palette token -> rgb
+
+    # -- the state triad: the classic trap. healthy -> deep teal (bluish,
+    #    darker), congested -> pale amber (much lighter), critical -> dark
+    #    brick (yellowish-red, darkest). L gaps + blue-yellow axis carry
+    #    deutan/protan; red-green axis carries tritan.
+    teal   = (0, 118, 132)
+    pale   = (242, 213, 120)
+    brick  = (168, 44, 24)
+    if mode == "tritan":
+        # tritan keeps red-green, loses blue-yellow: make healthy GREEN-dark
+        # (not teal) and congested warm-light; critical stays dark red.
+        teal  = (16, 138, 74)
+        pale  = (240, 204, 96)
+    remap["state_healthy"]   = teal
+    remap["state_congested"] = pale
+    remap["state_critical"]  = brick
+
+    # -- lanes: express must read as the "hot" lane. deutan/protan: push
+    #    express bright/warm, standard slate, best-effort olive-dark; space L.
+    remap["lane_express"]     = (240, 176, 48)
+    remap["lane_standard"]    = (130, 136, 160)
+    remap["lane_best_effort"] = (88, 98, 54)
+    if mode == "tritan":
+        remap["lane_express"]     = (238, 132, 36)
+        remap["lane_standard"]    = (122, 128, 154)
+        remap["lane_best_effort"] = (48, 104, 48)
+
+    # -- ghost ok/bad: ok = cool slate (matches standard), bad = the critical
+    remap["ghost_ok"]  = (120, 128, 148, PAL["ghost_ok"][3])
+    remap["ghost_bad"] = (brick[0], brick[1], brick[2], PAL["ghost_bad"][3])
+
+    # -- pipe tiers: copper/steel/fiber — deutan-safe by L spacing
+    remap["pipe_copper"] = (188, 108, 40)
+    remap["pipe_steel"]  = (122, 132, 146)
+    remap["pipe_fiber"]  = (36, 60, 132)
+    if mode == "tritan":
+        remap["pipe_fiber"] = (52, 44, 150)
+
+    # -- route marks: glow = healthy family, tie = express family (linked to
+    #    the triad anchors by construction — verified by the oracle)
+    remap["route_glow"] = (teal[0], teal[1], teal[2], PAL["route_glow"][3])
+    remap["route_tie"]  = (pale[0], pale[1], pale[2], PAL["route_tie"][3])
+
+    # -- map tokens: deutan/protan turn water/park into near-twins (blue vs
+    #    green both drop toward beige). Separate by L + warmth: water darker
+    #    + more saturated blue, park lighter + yellower.
+    remap["water"] = (96, 138, 172)
+    remap["park"]  = (196, 204, 132)
+    if mode == "tritan":
+        # tritan compresses blue-yellow: separate water/park on LIGHTNESS
+        # (water much darker, park much lighter) — L survives every CVD.
+        remap["water"] = (52, 92, 156)
+        remap["park"]  = (196, 212, 128)
+    remap["coast"] = (204, 186, 138) if mode == "tritan" else (216, 198, 150)
+
+    # -- packet classes: email slate vs streaming deep blue collide under
+    #    tritan (blue-yellow loss). deutan/protan: L-space them; tritan:
+    #    push email warm-gray, streaming stays blue-dark (red-green axis).
+    if mode in ("deutan", "protan"):
+        classes["email"] = (96, 102, 118)
+        classes["streaming"] = (24, 52, 140)
+    else:
+        classes["email"] = (146, 128, 110)
+        classes["streaming"] = (30, 60, 150)
+
+    # -- roofs/host/router accents: variety is decorative (never the sole
+    #    encoder) but must not collapse into mud. Hand-picked MUTED anchors
+    #    per mode (L-spread + the residual axis; no saturation blowouts).
+    if mode in ("deutan", "protan"):
+        remap["house_roofs"] = [(96, 38, 98), (178, 142, 74), (26, 98, 112), (58, 66, 94)]
+    else:
+        remap["house_roofs"] = [(130, 54, 38), (112, 106, 44), (36, 100, 60), (72, 80, 112)]
+
+    return remap, classes
+
+def verify(mode, remap, classes, tune=True):
+    """Check every pair under the simulation on EFFECTIVE colors. Returns the
+    (possibly empty) failure list — no silent auto-nudging: anchors are the
+    canon; if a pair fails, HAND-TUNE the anchors above."""
+    return [(lab, a, b, t) for lab, a, b, t in pair_list(mode, remap, classes)
+            if dist(simulate(a, mode), simulate(b, mode)) < t]
+
+# ---------------------------------------------------------------- report
+
+def emit():
+    print("// ---- paste into data/palette.json (the \"modes\" block) ----")
+    out = {"modes": {}}
+    all_ok = True
+    for mode in ("deutan", "protan", "tritan"):
+        remap, classes = derive(mode)
+        fails = verify(mode, remap, classes)
+        ok = not fails
+        all_ok = all_ok and ok
+        table = {}
+        for k, v in remap.items():
+            if k == "house_roofs":
+                table[k] = [list(c) + [255] for c in v]
+            elif isinstance(v, tuple):
+                base_a = PAL[k][3] if k in PAL else 255
+                table[k] = list(v[:3]) + [base_a]
+        if classes:
+            table["packet_classes"] = {cid: list(c) + [255] for cid, c in classes.items()}
+        out["modes"][mode] = table
+        print(f"// {mode}: {'ALL PAIRS CLEAR' if ok else 'PAIRS FAILING — HAND-TUNE ANCHORS'}")
+    print(json.dumps(out, indent=2))
+
+    # verification detail (which pair, which sides)
+    for mode in ("deutan", "protan", "tritan"):
+        remap, classes = derive(mode)
+        fails = verify(mode, remap, classes)
+        print(f"\n== {mode} pair report (simulated distances; thresholds in parens) ==")
+        for lab, a, b, t in pair_list(mode, remap, classes):
+            d = dist(simulate(a, mode), simulate(b, mode))
+            flag = "ok" if d >= t else "FAIL"
+            print(f"  {flag:4} {lab:16} {d:6.1f} ({t:.0f})")
+    sys.exit(0 if all_ok else 1)
+
+if __name__ == "__main__":
+    emit()
