diff --git a/harness/goldens.odin b/harness/goldens.odin
index 008a4f3..e347add 100644
--- a/harness/goldens.odin
+++ b/harness/goldens.odin
@@ -25,10 +25,37 @@ Report :: struct {
 // whether the rlsw window was initialized. Owned by main, passed to run_demo.
 Render_Ctx :: struct {
 	palette: rnd.Palette,
+	// 7.3: the immutable loaded base — a11y modes rebuild `palette` from it
+	// per demo (the demos run sequentially through ONE ctx, so a mode must
+	// never leak into the next demo; a11y_reset restores the defaults).
+	palette_base: rnd.Palette,
 	view:    rnd.View,
 	ready:   bool,
 }
 
+// a11y_reset — restore the harness view to the defaults (no palette mode,
+// motion on, ×1.00). Called at the top of EVERY run_demo so an a11y demo
+// never contaminates its siblings in the same sequential run (the blessed
+// goldens must stay byte-identical by construction).
+a11y_reset :: proc(rc: ^Render_Ctx) {
+	rnd.palette_apply_mode(&rc.palette_base, &rc.palette, .Off)
+	rc.view.reduced_motion = false
+	rc.view.ui_scale = 1.0
+}
+
+// apply_demo_a11y — apply a demo's 7.3 directives to the render ctx
+// (View-only: the sim/replay never sees a byte — T1 + replay byte-identical
+// by construction).
+apply_demo_a11y :: proc(rc: ^Render_Ctx, demo: ^Demo) {
+	rnd.palette_apply_mode(&rc.palette_base, &rc.palette, rnd.Palette_Mode(demo.a11y_palette))
+	rc.view.reduced_motion = demo.a11y_reduced
+	switch demo.a11y_scale_pct {
+	case 125: rc.view.ui_scale = 1.25
+	case 150: rc.view.ui_scale = 1.5
+	case:     rc.view.ui_scale = 1.0
+	}
+}
+
