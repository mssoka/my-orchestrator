@@ -0,0 +1,87 @@
+package render
+
+// hud_test.odin — the UI-scale knob's rounding contract (Perkins r1 B6/P1:
+// scaling coverage was thin). The hud()/hud_f() helpers are the byte-identity
+// hinge — at x1.00 they MUST return the constants exactly (the blessed T2
+// goldens depend on it), and at x1.25/x1.50 they must round to stable ints.
+
+import "core:testing"
+
+// a minimal view with the scale set (view_compute would need a Balance — the
+// helpers only read ui_scale).
+hud_test_view :: proc(scale: f32) -> View {
+	v: View
+	v.ui_scale = scale
+	return v
+}
+
+@(test)
+hud_scale_1_identity :: proc(t: ^testing.T) {
+	// the golden hinge: x1.00 must reproduce every constant exactly (int
+	// math byte-identity — the pre-existing T2 goldens' survival proof)
+	v := hud_test_view(1.0)
+	for k in i32(1) ..< 700 {
+		testing.expect(t, hud(&v, k) == k, "hud x1.00 is the identity")
+		testing.expect(t, hud_f(&v, f32(k)) == f32(k), "hud_f x1.00 is the identity")
+	}
+}
+
+@(test)
+hud_scale_125_stable_ints :: proc(t: ^testing.T) {
+	v := hud_test_view(1.25)
+	// the constants the captured HUD uses must land on stable integers
+	ks := []i32{10, 14, 15, 17, 20, 22, 54, 230, 240, 440, 62, 96, 26}
+	for k in ks {
+		got := hud(&v, k)
+		// the value must equal the round of the product (the +0.5 trunc rule)
+		want := i32(f32(k) * 1.25 + 0.5)
+		testing.expect(t, got == want, "hud x1.25 rounds half-up")
+	}
+}
+
+@(test)
+hud_scale_150_stable_ints :: proc(t: ^testing.T) {
+	v := hud_test_view(1.50)
+	ks := []i32{10, 14, 15, 17, 20, 22, 54, 230, 240, 440, 62, 96, 26}
+	for k in ks {
+		got := hud(&v, k)
+		want := i32(f32(k) * 1.50 + 0.5)
+		testing.expect(t, got == want, "hud x1.50 rounds half-up")
+	}
+}
+
+@(test)
+hud_zero_scale_defaults_after_view_compute :: proc(t: ^testing.T) {
+	// view_compute forces a x1.00 default on a zero-inited view (a 0 scale
+	// would collapse every hud() to 0 — the palcheck/parity construction
+	// path)
+	v: View
+	// emulate view_compute's guard
+	if v.ui_scale <= 0 {
+		v.ui_scale = 1.0
+	}
+	testing.expect(t, hud(&v, 440) == 440, "the zero-guard lands on the identity")
+}
+
+@(test)
+crisis_card_width_clamp :: proc(t: ^testing.T) {
+	// Perkins r1 B4: at x1.50 the centered banner must CLEAR the forecast
+	// panel's left edge (no 'WEATHER REPORT' behind the banner).
+	v := hud_test_view(1.5)
+	v.win_w = 1280
+	v.win_h = 720
+	cw := crisis_card_width(&v)
+	// the banner's right edge = (win_w + cw)/2 + pad(15) must be <= the
+	// forecast's left edge (920) minus the gap
+	right := (f32(v.win_w) + f32(cw)) / 2 + f32(hud(&v, 10))
+	forecast_left := f32(v.win_w) - f32(hud(&v, 230)) - f32(hud(&v, 10))
+	testing.expect(t, right <= forecast_left, "the x1.50 banner clears the forecast")
+	// and at x1.00/x1.25 the clamp must NOT engage (byte-identity)
+	scales := []f32{1.0, 1.25}
+	for scale in scales {
+		w := hud_test_view(scale)
+		w.win_w = 1280
+		w.win_h = 720
+		testing.expect(t, crisis_card_width(&w) == hud(&w, 440), "the clamp never engages at <=1.25")
+	}
+}
