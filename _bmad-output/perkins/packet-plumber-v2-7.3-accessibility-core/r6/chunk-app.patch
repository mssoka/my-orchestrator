new file mode 100644
index 0000000..21ad08b
--- /dev/null
+++ b/app/render/settings_panel.odin
@@ -0,0 +1,185 @@
+package render
+
+// settings_panel.odin — Story 7.3's settings panel (the a11y surface, user
+// ruling 2026-08-19: a PANEL, not hotkey-only). The popover pattern: layout
+// is owned HERE — the app hit-tests the SAME rects this package draws
+// (single source, like popover_rect/tray_chip_rect); the panel draws ONLY
+// from the app's render loop (never draw_world), so the T2 capture path can
+// never see it. All geometry runs through hud()/hud_f() so the UI-scale knob
+// scales the panel with the rest of the chrome (draw + hit-test share the
+// same math — they cannot diverge).
+//
+// Rows: 0 colorblind palette (off/deutan/protan/tritan cycle), 1 reduced
+// motion (toggle), 2 UI scale (100/125/150% steps), 3 audio (mute — the 7.2
+// setting surfaced; discoverable a11y). ASCII-only labels (lint gate 6).
+
+import "core:fmt"
+import rl "vendor:raylib"
+
+SETTINGS_ROW_COUNT :: 4
+
+SETTINGS_ROW_PALETTE :: 0
+SETTINGS_ROW_MOTION  :: 1
+SETTINGS_ROW_SCALE   :: 2
+SETTINGS_ROW_AUDIO   :: 3
+
+// Settings_Snapshot — the panel's read-only view of the app's a11y state
+// (passed by value from the app's draw loop; the panel never reaches back
+// into the App).
+Settings_Snapshot :: struct {
+	mode:          Palette_Mode,
+	reduced_motion: bool,
+	ui_scale:      f32,
+	muted:         bool,
+}
+
+// settings_panel_rect — the card rect, centered on the window (a modal
+// surface; it is never entity-anchored). Width/height scale with the knob.
+settings_panel_rect :: proc(v: ^View) -> rl.Rectangle {
+	w := f32(hud(v, 400))
+	row_h := f32(hud(v, 38))
+	title_h := f32(hud(v, 46))
+	h := title_h + row_h * f32(SETTINGS_ROW_COUNT) + f32(hud(v, 30))
+	x := (f32(v.win_w) - w) / 2
+	y := (f32(v.win_h) - h) / 2
+	return {x, y, w, h}
+}
+
+// settings_row_rect — row i's rect inside the card (label left, value chip
+// right — the whole row is the hit target, matching the tray chips' fat
+// targets). The SAME rect serves the draw + the app's press hit-test.
+settings_row_rect :: proc(v: ^View, row: int) -> rl.Rectangle {
+	if row < 0 || row >= SETTINGS_ROW_COUNT {
+		return {}
+	}
+	card := settings_panel_rect(v)
+	row_h := f32(hud(v, 38))
+	title_h := f32(hud(v, 46))
+	return {
+		card.x + f32(hud(v, 10)),
+		card.y + title_h + row_h * f32(row),
+		card.width - f32(hud(v, 20)),
+		row_h,
+	}
+}
+
+// settings_chip_rect — the compact always-visible mode chip (bottom-left
+// corner: free real estate — the tray owns bottom-center, the caption strip
+// sits above the tray, the pause chip owns the top gap). Doubles as the
+// touch entry: tapping it toggles the panel (the app's ui-press hit-test).
+settings_chip_rect :: proc(v: ^View) -> rl.Rectangle {
+	scaled := v.ui_scale > 1.001 || v.palette.mode != .Off || v.reduced_motion
+	txt := "A11Y SETTINGS (S)" if !scaled else a11y_chip_text(v)
+	fs := hud(v, 13)
+	w := f32(len(txt)) * f32(fs) / 2 + f32(hud(v, 20))
+	h := f32(hud(v, 22))
+	return {f32(hud(v, 10)), f32(v.win_h) - h - f32(hud(v, 10)), w, h}
+}
+
+// a11y_chip_text — the compact active-mode summary (ASCII, lint gate 6).
+a11y_chip_text :: proc(v: ^View) -> string {
+	#partial switch v.palette.mode {
+	case .Deutan:  return "A11Y: DEUTAN" if v.ui_scale <= 1.001 else "A11Y: DEUTAN 125%+"
+	case .Protan: return "A11Y: PROTAN" if v.ui_scale <= 1.001 else "A11Y: PROTAN 125%+"
+	case .Tritan: return "A11Y: TRITAN" if v.ui_scale <= 1.001 else "A11Y: TRITAN 125%+"
+	case:         return "A11Y: 125%+" if v.ui_scale > 1.001 else "A11Y SETTINGS (S)"
+	}
+}
+
+// settings_row_label — row i's label + current value string.
+settings_row_label :: proc(row: int, snap: Settings_Snapshot) -> (label, value: string) {
+	switch row {
+	case SETTINGS_ROW_PALETTE:
+		#partial switch snap.mode {
+		case .Deutan:  return "COLORBLIND PALETTE", "DEUTERANOPIA"
+		case .Protan: return "COLORBLIND PALETTE", "PROTANOPIA"
+		case .Tritan: return "COLORBLIND PALETTE", "TRITANOPIA"
+		case:         return "COLORBLIND PALETTE", "OFF"
+		}
+	case SETTINGS_ROW_MOTION:
+		return "REDUCED MOTION", ("ON" if snap.reduced_motion else "OFF")
+	case SETTINGS_ROW_SCALE:
+		pct := i32(snap.ui_scale * 100 + 0.5)
+		return "UI SCALE", fmt.aprintf("%d%%", pct, allocator = context.temp_allocator)
+	case SETTINGS_ROW_AUDIO:
+		return "AUDIO", ("MUTED" if snap.muted else "ON")
+	case:
+		return "", ""
+	}
+}
+
+// draw_settings_panel — the card + rows + the focus highlight. `focus` is
+// the input-owned focused row (the app passes inp.panel_row); -1 draws no
+// focus (not expected while open, defensive).
+draw_settings_panel :: proc(v: ^View, snap: Settings_Snapshot, focus: int) {
+	p := v.palette
+	card := settings_panel_rect(v)
+	rl.DrawRectangle(i32(card.x), i32(card.y), i32(card.width), i32(card.height), rl.Color{255, 248, 236, 248})
+	rl.DrawRectangleLines(i32(card.x), i32(card.y), i32(card.width), i32(card.height), p.ink)
+	title_h := hud(v, 46)
+	draw_text_c(v, "SETTINGS", i32(card.x) + hud(v, 14), i32(card.y) + hud(v, 12), hud(v, 17), p.ink)
+	draw_text_c(v, "S / tap chip to close", i32(card.x) + hud(v, 14), i32(card.y) + title_h + hud(v, SETTINGS_ROW_COUNT * 38 + 4), hud(v, 12), p.ink_soft)
+	for row in 0..<SETTINGS_ROW_COUNT {
+		r := settings_row_rect(v, row)
+		focused := row == focus
+		bg := rl.Color{0, 0, 0, 0}
+		if focused {
+			bg = rl.Color{242, 181, 68, 60}
+		}
+		rl.DrawRectangle(i32(r.x), i32(r.y), i32(r.width), i32(r.height), bg)
+		if focused {
+			rl.DrawRectangleLines(i32(r.x), i32(r.y), i32(r.width), i32(r.height), p.ink_soft)
+		}
+		label, value := settings_row_label(row, snap)
+		draw_text_c(v, label, i32(r.x) + hud(v, 10), i32(r.y) + hud(v, 10), hud(v, 14), p.ink)
+		// the value chip, right-aligned (the tray chip styling)
+		fs := hud(v, 14)
+		vw := i32(len(value)) * fs / 2
+		vx := i32(r.x + r.width) - vw - hud(v, 12)
+		chip_col := value_chip_color(p^, row, snap)
+		rl.DrawRectangle(vx - hud(v, 8), i32(r.y) + hud(v, 5), vw + hud(v, 16), fs + hud(v, 8), rl.Color{232, 221, 194, 255})
+		draw_text_c(v, value, vx, i32(r.y) + hud(v, 10), fs, chip_col)
+	}
+}
+
+// value_chip_color — the value text color: ink for neutral values, the state
+// colors (darkened text variants — the contrast canon) for active a11y rows
+// so an active mode reads at a glance.
+value_chip_color :: proc(p: Palette, row: int, snap: Settings_Snapshot) -> rl.Color {
+	switch row {
+	case SETTINGS_ROW_PALETTE:
+		if snap.mode != .Off {
+			return state_congested_text(p)
+		}
+	case SETTINGS_ROW_MOTION:
+		if snap.reduced_motion {
+			return state_healthy_text(p)
+		}
+	case SETTINGS_ROW_SCALE:
+		if snap.ui_scale > 1.001 {
+			return state_healthy_text(p)
+		}
+	case SETTINGS_ROW_AUDIO:
+		if snap.muted {
+			return state_critical_text(p)
+		}
+	}
+	return p.ink
+}
+
+// draw_settings_chip — the always-visible chip (bottom-left). Shows the
+// compact active-mode summary when any mode/scale is active.
+draw_settings_chip :: proc(v: ^View, snap: Settings_Snapshot) {
+	r := settings_chip_rect(v)
+	p := v.palette
+	active := snap.mode != .Off || snap.reduced_motion || snap.ui_scale > 1.001
+	bg := rl.Color{30, 40, 50, 170}
+	if active {
+		bg = rl.Color{30, 40, 50, 210}
+	}
+	rl.DrawRectangle(i32(r.x), i32(r.y), i32(r.width), i32(r.height), bg)
+	txt := a11y_chip_text(v)
+	fs := hud(v, 13)
+	w := i32(r.width)
+	draw_text_c(v, txt, i32(r.x) + (w - i32(len(txt)) * fs / 2) / 2, i32(r.y) + hud(v, 4), fs, rl.Color{255, 255, 255, 255})
+}
