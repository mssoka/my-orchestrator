+	case "lane_standard":    return .Lane_Standard, true
+	case "lane_best_effort": return .Lane_Best_Effort, true
+	case "ghost_ok":         return .Ghost_Ok, true
+	case "ghost_bad":        return .Ghost_Bad, true
+	case "pipe_copper":      return .Pipe_Copper, true
+	case "pipe_steel":       return .Pipe_Steel, true
+	case "pipe_fiber":       return .Pipe_Fiber, true
+	case "route_glow":       return .Route_Glow, true
+	case "route_tie":        return .Route_Tie, true
+	case "water":            return .Water, true
+	case "park":             return .Park, true
+	case "coast":            return .Coast, true
