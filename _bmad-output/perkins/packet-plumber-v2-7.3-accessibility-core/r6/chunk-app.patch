+// parse_mode_table — one "modes"/<name> object into a Mode_Table. Token
+// names mirror the palette.json keys exactly (single source with the
+// derivation script's output).
+parse_mode_table :: proc(o: json.Object, t: ^Mode_Table) {
+	for name, v in o {
