diff --git a/harness/palcheck.odin b/harness/palcheck.odin
index 1f4d777..5893450 100644
--- a/harness/palcheck.odin
+++ b/harness/palcheck.odin
@@ -17,12 +17,129 @@ package main
 // Usage: harness palcheck   (exit 0 = green, 1 = a check failed, 2 = setup)
 
 import "core:fmt"
+import "core:math"
 import "core:os"
 import "core:strings"
 import rl "vendor:raylib"
 import pp "../core"
 import rnd "../app/render"
 
+// --- 7.3: the colorblind oracle (Machado et al. 2009, severity 1.0) --------
+// Re-simulates the SHIPPED mode tables under each deficiency and enforces
+// pairwise separation on the signal tokens (the same pairs the derivation
+// script verifies). palcheck is a CPU-side analysis tool (not render
+// geometry) — f32 math here does not touch the pixel-determinism spine.
+
+MACHADO_DEUTAN := [9]f32{0.367322, 0.860646, -0.227968, 0.280085, 0.672501, 0.047413, -0.011820, 0.042940, 0.968881}
+MACHADO_PROTAN := [9]f32{0.152286, 1.052583, -0.204868, 0.114503, 0.786281, 0.099216, -0.003882, -0.048116, 1.051998}
+MACHADO_TRITAN := [9]f32{1.255528, -0.076749, -0.178779, -0.078411, 0.930809, 0.147602, 0.004733, 0.691367, 0.303900}
+
+srgb_to_linear :: proc(c: f32) -> f32 {
+	if c <= 0.04045 {
+		return c / 12.92
+	}
+	return math.pow((c + 0.055) / 1.055, 2.4)
+}
+
+linear_to_srgb :: proc(c: f32) -> f32 {
+	// the correct sRGB inverse (Perkins r2 blocker 3): the forward threshold
+	// 0.04045 sRGB == 0.0031308 LINEAR; BELOW it the inverse MULTIPLIES by
+	// 12.92. r2 shipped the forward formula here — dark linear outputs
+	// crushed toward 0 and the separation oracle measured the wrong space.
+	v := c * 12.92 if c <= 0.0031308 else 1.055 * math.pow(c, 1.0 / 2.4) - 0.055
+	return clamp(v, 0, 1)
+}
+
+cvd_simulate :: proc(rgb: rl.Color, m: [9]f32) -> [3]f32 {
+	r := srgb_to_linear(f32(rgb.r) / 255)
+	g := srgb_to_linear(f32(rgb.g) / 255)
+	b := srgb_to_linear(f32(rgb.b) / 255)
+	return {
+		linear_to_srgb(m[0] * r + m[1] * g + m[2] * b) * 255,
+		linear_to_srgb(m[3] * r + m[4] * g + m[5] * b) * 255,
+		linear_to_srgb(m[6] * r + m[7] * g + m[8] * b) * 255,
+	}
+}
+
+cvd_dist :: proc(a, b: [3]f32) -> f32 {
+	dx := a[0] - b[0]
+	dy := a[1] - b[1]
+	dz := a[2] - b[2]
+	return math.sqrt(dx * dx + dy * dy + dz * dz)
+}
+
+// a11y_separation_check — the pairwise oracle over the SHIPPED mode tables.
+// Returns the fail count (0 = every required pair separates under that
+// deficiency's simulation).
+a11y_separation_check :: proc(cat: ^pp.Catalogs, base: ^rnd.Palette, mode: rnd.Palette_Mode) -> (fails: int, min_dist: f32) {
+	m: [9]f32
+	if mode == .Off {
+		return 0, 1e9
+	}
+	#partial switch mode {
+	case .Deutan:
+		m = MACHADO_DEUTAN
+	case .Protan:
+		m = MACHADO_PROTAN
+	case .Tritan:
+		m = MACHADO_TRITAN
+	}
+	// rebuild the effective palette (the shipped tables — palette_apply_mode
+	// is the exact runtime path the app/harness use)
+	eff: rnd.Palette
+	rnd.palette_apply_mode(base, &eff, mode)
+	p := &eff
+	// the signal pairs: states, lanes, ghost, pipe tiers, route marks, packet
+	// classes (the mode's override or the catalog base), map tokens.
+	pairs: [dynamic][2]rl.Color
+	defer delete(pairs)
+	append(&pairs, [2]rl.Color{p.state_healthy, p.state_congested})
+	append(&pairs, [2]rl.Color{p.state_healthy, p.state_critical})
+	append(&pairs, [2]rl.Color{p.state_congested, p.state_critical})
+	append(&pairs, [2]rl.Color{p.lane_express, p.lane_standard})
+	append(&pairs, [2]rl.Color{p.lane_express, p.lane_best_effort})
+	append(&pairs, [2]rl.Color{p.lane_standard, p.lane_best_effort})
+	append(&pairs, [2]rl.Color{p.ghost_ok, p.ghost_bad})
+	append(&pairs, [2]rl.Color{p.pipe_copper, p.pipe_steel})
+	append(&pairs, [2]rl.Color{p.pipe_copper, p.pipe_fiber})
+	append(&pairs, [2]rl.Color{p.pipe_steel, p.pipe_fiber})
+	append(&pairs, [2]rl.Color{p.route_glow, p.route_tie})
+	append(&pairs, [2]rl.Color{p.water, p.park})
+	append(&pairs, [2]rl.Color{p.water, p.canvas})
+	append(&pairs, [2]rl.Color{p.park, p.canvas})
+	append(&pairs, [2]rl.Color{p.coast, p.canvas})
+	// packet classes: the effective draw-time color (mode override or catalog)
+	// — the draw path (mode_class_color) is the single source.
+	cls_eff: [dynamic]rl.Color
+	defer delete(cls_eff)
+	for pt in cat.packet_types {
+		c := rl.Color{pt.color_rgba[0], pt.color_rgba[1], pt.color_rgba[2], 255}
+		append(&cls_eff, rnd.mode_class_color(p, pt.id, c))
+	}
+	for i in 0 ..< len(cls_eff) {
+		for j in i + 1 ..< len(cls_eff) {
+			append(&pairs, [2]rl.Color{cls_eff[i], cls_eff[j]})
+		}
+	}
+	// the pinned thresholds (the derivation's): 48 for the signal pairs,
+	// 40 for the map pairs (water/park/coast vs canvas).
+	min_d := f32(1e9)
+	for pr in pairs {
+		da := cvd_dist(cvd_simulate(pr[0], m), cvd_simulate(pr[1], m))
+		min_d = min(min_d, da)
+		threshold := f32(48)
+		if (pr[0] == p.water || pr[0] == p.park || pr[0] == p.coast || pr[0] == p.canvas) {
+			threshold = 40
+		}
+		if da < threshold {
+			fails += 1
+		}
+	}
+	return fails, min_d
+}
+
+
+
 // the canon §2 hexes the sprite family EMITS (the objective oracle). The
 // top-down render shows the ROOFS — the steep camera occludes the wall band,
 // so body hexes never enter the sprites (Perkins r2 W-B: the check must pin
@@ -289,6 +406,55 @@ run_palcheck :: proc(cat: ^pp.Catalogs) -> int {
 		pp.run_destroy(&state)
 	}
 
+	// --- 4. the 7.3 colorblind oracle + mode-golden presence (E9.1) ---------
+	// The separation oracle re-simulates the SHIPPED mode tables under each
+	// deficiency and enforces the pairwise thresholds (a future token edit
+	// that re-collides fails CI, not playtesters). The presence scans pin
+	// that the mode ACTUALLY RENDERS: the crisis frame's banner border +
+	// state-triad ring colors under each mode are objectively present in its
+	// blessed golden.
+	{
+		base := rnd.palette_load()
+		modes := []rnd.Palette_Mode{.Deutan, .Protan, .Tritan}
+		for mode in modes {
+			fails_a, min_d := a11y_separation_check(cat, &base, mode)
+			check(fails_a == 0, fmt.aprintf("a11y separation (%s; min sim-dist %.1f)", rnd.palette_mode_name(mode), min_d), int(min_d * 100))
+			// presence on the blessed mode golden (the 65000ms crisis frame)
+			gold := fmt.tprintf("goldens/a11y_%s/65000ms.png", rnd.palette_mode_name(mode))
