index 0000000..990decf
--- /dev/null
+++ b/harness/a11y_oracle_test.odin
@@ -0,0 +1,48 @@
+package main
+
+// a11y_oracle_test.odin — the palcheck colorblind oracle's NEGATIVE leg
+// (Perkins r1 B6/P0: the oracle bites in the CI gate, but nothing proved a
+// poison FAILS it — an oracle that never fails is a vacuous gate). Poison a
+// shipped token pair -> the separation check must fail; a clean palette must
+// pass. Runs headless (`odin test harness`) — no window, no render.
+
+import "core:testing"
+import pp "../core"
+import rnd "../app/render"
+
+// oracle_cat — the real catalogs (the oracle's packet-class leg reads
+// cat.packet_types; the committed data files are the deterministic fixture —
+// the test runner's cwd is the repo root, like the harness itself).
+oracle_cat :: proc(t: ^testing.T) -> pp.Catalogs {
+	cat: pp.Catalogs
+	if e := load_catalogs(&cat); e != "" {
+		testing.fail_now(t, "oracle test cannot load the catalogs")
+	}
+	return cat
+}
+
+@(test)
+a11y_oracle_bites_on_poison :: proc(t: ^testing.T) {
+	cat := oracle_cat(t)
+	defer pp.catalogs_destroy(&cat)
+	base := rnd.palette_load()
+	// poison: force deutan's state_healthy to equal its state_congested (the
+	// classic CVD collapse the oracle exists to catch)
+	base.modes.deutan.set[int(rnd.Palette_Token.State_Healthy)] = true
+	base.modes.deutan.colors[int(rnd.Palette_Token.State_Healthy)] = base.modes.deutan.colors[int(rnd.Palette_Token.State_Congested)]
+	// the state-triad pair (healthy vs congested) then simulates at distance 0
+	fails, _ := a11y_separation_check(&cat, &base, .Deutan)
+	testing.expect(t, fails > 0, "a poisoned token pair must FAIL the oracle")
+}
+
+@(test)
+a11y_oracle_passes_clean :: proc(t: ^testing.T) {
+	cat := oracle_cat(t)
+	defer pp.catalogs_destroy(&cat)
+	base := rnd.palette_load()
+	modes := []rnd.Palette_Mode{.Deutan, .Protan, .Tritan}
+	for mode in modes {
+		fails, _ := a11y_separation_check(&cat, &base, mode)
+		testing.expect(t, fails == 0, "the shipped tables must pass the oracle (clean)")
+	}
+}
