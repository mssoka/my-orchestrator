diff --git a/app/settings.odin b/app/settings.odin
new file mode 100644
index 0000000..fc3deee
--- /dev/null
+++ b/app/settings.odin
@@ -0,0 +1,182 @@
+package main
+
+// settings.odin — Story 7.3's disk persistence (user ruling 2026-08-19:
+// settings survive app relaunch). App-side ONLY — the sim never reads or
+// writes this file; no save/log/LOG_VERSION involvement (ODN-1/11). The
+// first persistent-settings home in the codebase (the assist tier + mute are
+// in-session only by prior canon; the panel makes a11y persistence the
+// natural first tenant — later settings (volumes, assists) land here too).
+//
+// Format: a tiny versioned binary (ODN-11's "JSON is for catalogs" doctrine —
+// no JSON int/float traps). Version 1: 4 bytes — magic, version, then three
+// u8 values (palette mode 0-3, reduced-motion 0/1, ui-scale step 0-2) + a
+// checksum byte. Load: any mismatch → DEFAULTS + a stderr note (never a
+// crash, never a block). Save: write-then-rename (atomic on APFS), called on
+// every panel change.
+
+import "core:fmt"
+import "core:os"
+import "core:strings"
+import rnd "./render"
+
+// the fixed dotfile in the user's home (a launch from any cwd finds the same
+// file; absent HOME → the cwd dotfile, still deterministic).
+SETTINGS_FILE_NAME :: ".pp-settings.bin"
+SETTINGS_MAGIC :: u8(0x50) // 'P'
+SETTINGS_VERSION :: u8(1)
+
+// UI_SCALE_STEPS — the E9.3 knob (user ruling 2026-08-19: ×1.00/×1.25/×1.50).
+UI_SCALE_STEPS :: [3]f32{1.00, 1.25, 1.50}
+UI_SCALE_COUNT :: 3
+
+A11y_Settings :: struct {
+	palette:       rnd.Palette_Mode,
+	reduced_motion: bool,
+	scale_step:    u8, // 0..UI_SCALE_COUNT-1
+}
+
+DEFAULT_A11Y :: proc() -> A11y_Settings {
+	return A11y_Settings{palette = .Off, reduced_motion = false, scale_step = 0}
+}
+
+settings_path :: proc() -> string {
+	home := os.get_env_alloc("HOME", context.temp_allocator)
+	if home == "" {
+		return SETTINGS_FILE_NAME
+	}
+	return strings.concatenate({home, "/", SETTINGS_FILE_NAME}, context.temp_allocator)
+}
+
+settings_load :: proc() -> A11y_Settings {
+	return settings_load_at(settings_path())
+}
+
+settings_save :: proc(s: A11y_Settings) {
+	settings_save_at(settings_path(), s)
+}
+
+// settings_load_at / settings_save_at — the path-injected core (the default
+// HOME dotfile wraps these; the unit tests inject a temp path for hermetic
+// coverage of the whole contract — Perkins r1 B3: zero automated coverage
+// shipped in r1). Every failure mode falls back to DEFAULTS, never a crash,
+// never a bad mode.
+settings_load_at :: proc(path: string) -> A11y_Settings {
+	s := DEFAULT_A11Y()
+	data, err := os.read_entire_file_from_path(path, context.temp_allocator)
+	if err != nil || len(data) < 6 {
+		fmt.eprintfln("settings: no readable settings at %s — defaults", path)
+		return s
+	}
+	if data[0] != SETTINGS_MAGIC || data[1] != SETTINGS_VERSION {
+		fmt.eprintfln("settings: %s has a foreign format — defaults", path)
+		return s
+	}
+	// checksum: the sum of the payload bytes (any single-byte corruption
+	// flips the checksum — a corrupt file falls back, never a bad mode)
+	sum := u8(0)
+	for i in 2 ..< 5 {
+		sum += data[i]
+	}
+	if sum != data[5] {
+		fmt.eprintfln("settings: %s failed its checksum — defaults", path)
+		return s
+	}
+	if data[2] > u8(rnd.Palette_Mode.Tritan) {
+		fmt.eprintfln("settings: palette mode out of range — defaults")
+		return s
+	}
+	if data[3] > 1 {
+		fmt.eprintfln("settings: reduced-motion out of range — defaults")
+		return s
+	}
+	if data[4] >= UI_SCALE_COUNT {
+		fmt.eprintfln("settings: ui-scale step out of range — defaults")
+		return s
+	}
+	s.palette = rnd.Palette_Mode(data[2])
+	s.reduced_motion = data[3] == 1
+	s.scale_step = data[4]
+	return s
+}
+
+settings_save_at :: proc(path: string, s: A11y_Settings) {
+	buf: [6]u8
+	buf[0] = SETTINGS_MAGIC
+	buf[1] = SETTINGS_VERSION
+	buf[2] = u8(s.palette)
+	buf[3] = 1 if s.reduced_motion else 0
+	buf[4] = s.scale_step
+	buf[5] = buf[2] + buf[3] + buf[4]
+	tmp := strings.concatenate({path, ".tmp"}, context.temp_allocator)
+	if err := os.write_entire_file(tmp, buf[:]); err != nil {
+		fmt.eprintfln("settings: save failed %s: %v", tmp, err)
+		return
+	}
+	// atomic rename — a crash mid-write leaves the OLD file (or none), never
+	// a torn one; the loader's checksum guards the rest.
+	if err := os.rename(tmp, path); err != nil {
+		fmt.eprintfln("settings: rename failed %s: %v", path, err)
+	}
+}
+
+// scale_of — the ui_scale factor for a step index.
+scale_of :: proc(step: u8) -> f32 {
+	steps := UI_SCALE_STEPS // local copy — a constant can't be indexed by a runtime index
+	if int(step) >= UI_SCALE_COUNT {
+		return steps[0]
+	}
+	return steps[step]
+}
+
+// step_of — the nearest step index for a factor (the reverse read for the
+// panel display + save).
+step_of :: proc(scale: f32) -> u8 {
+	steps := UI_SCALE_STEPS // local copy — runtime-indexed
+	best, bd := u8(0), f32(1e9)
+	for i in 0 ..< UI_SCALE_COUNT {
+		d := abs(scale - steps[i])
+		if d < bd {
+			bd, best = d, u8(i)
+		}
+	}
+	return best
+}
+
+// cycle_scale — the E9.3 knob's step with WRAP (Perkins r1 B2): a touch-only
+// player's tap delivers delta 0 (next) — clamping at the top step STRANDED
+// them at 150% with no way back. Wrapping makes the knob recoverable like
+// the palette cycle (150% -> 100% on the next next). Pure — unit-tested.
+cycle_scale :: proc(cur: u8, delta: i32) -> u8 {
+	n := i32(UI_SCALE_COUNT)
+	return u8((i32(cur) + delta + n) % n)
+}
+
+// cycle_palette — the palette-mode cycle with wrap (off -> deutan -> protan
+// -> tritan -> off). Pure — unit-tested.
+cycle_palette :: proc(cur: u8, delta: i32) -> u8 {
+	n := i32(rnd.Palette_Mode.Tritan) + 1
+	return u8((i32(cur) + delta + n) % n)
+}
+
+// adjust_step — the cycle rows' tap normalization (Perkins r2 blocker 1):
+// a delta-0 activate (touch row-tap, mouse row-click, Enter, pad A) means
+// "next" — the cycle rows advance +1; explicit +/- keep their sign. Without
+// this, delta-0 was a NO-OP and a touch-only player could never change the
+// palette or the scale (worse than a one-way ratchet). Pure — unit-tested.
+adjust_step :: proc(delta: i32) -> i32 {
+	if delta == 0 {
+		return 1
+	}
+	return delta
+}
+
+// a11y_apply — apply a loaded A11y_Settings to the EFFECTIVE view (the exact
+// startup sequence the app runs: rebuild the palette from the immutable base,
+// set the motion flag + the scale factor). Extracted so the startup
+// application is unit-testable headless (Perkins r3 blocker 4c) — the app
+// init calls this; a test drives it against a saved file.
+a11y_apply :: proc(s: A11y_Settings, base: ^rnd.Palette, eff: ^rnd.Palette, v: ^rnd.View) {
+	rnd.palette_apply_mode(base, eff, s.palette)
+	v.reduced_motion = s.reduced_motion
+	v.ui_scale = scale_of(s.scale_step)
+}
diff --git a/app/settings_test.odin b/app/settings_test.odin
new file mode 100644
index 0000000..1152e65
--- /dev/null
+++ b/app/settings_test.odin
@@ -0,0 +1,206 @@
+package main
+
+// settings_test.odin — Story 7.3's settings-persistence contract, pinned
+// headless (Perkins r1 B3: r1 shipped ZERO coverage). The whole load/save
+// contract is pure file I/O — path-injected (settings_load_at/save_at) so the
+// tests are hermetic (a temp path, never the user's HOME dotfile).
+
+import "core:fmt"
+import "core:os"
+import "core:strings"
+import "core:testing"
+import "core:time"
+import rnd "./render"
+
+// tmp_settings_path — a unique temp path PER CALL, with NO shared mutable
+// state (Perkins r3 blocker 1: the r3 counter raced under Odin's parallel
+// @(test) runner — several tests landed on the same path and clobbered each
+// other's fixtures). The path derives from the monotonic-ish wall clock
+// (nanoseconds — unique per call, collision-free in parallel runs; the test
+// never asserts on the name, only its uniqueness).
+rnd_palette_for_test :: proc() -> rnd.Palette {
+	return rnd.palette_load()
+}
+
+tmp_settings_path :: proc(t: ^testing.T) -> string {
+	now := time.now()
+	dir, derr := os.temp_dir(context.temp_allocator)
+	if derr != nil {
+		dir = "."
+	}
+	path := strings.concatenate({dir, "/pp-settings-test-", fmt.tprintf("%d", time.to_unix_nanoseconds(now))}, context.temp_allocator)
+	os.remove(path) // a stale file must never leak into the test
+	return path
+}
+
+write_settings_bytes :: proc(path: string, bytes: []u8) {
+	if err := os.write_entire_file(path, bytes); err != nil {
+		// a test-fixture write failure is a test failure — surface loudly
+		panic("settings test: cannot write fixture")
+	}
+}
+
+@(test)
+settings_round_trip :: proc(t: ^testing.T) {
+	path := tmp_settings_path(t)
+	defer os.remove(path)
+	orig := A11y_Settings{palette = .Protan, reduced_motion = true, scale_step = 2}
+	settings_save_at(path, orig)
+	got := settings_load_at(path)
+	testing.expect(t, got == orig, "round-trip must restore the saved settings")
+}
+
+@(test)
+settings_missing_file_defaults :: proc(t: ^testing.T) {
+	dir, derr := os.temp_dir(context.temp_allocator)
+	if derr != nil { dir = "." }
+	path := strings.concatenate({dir, "/pp-settings-NO-SUCH-FILE-", fmt.tprintf("%d", 99999)}, context.temp_allocator)
+	defer os.remove(path)
+	got := settings_load_at(path)
+	testing.expect(t, got == DEFAULT_A11Y(), "a missing file must fall back to defaults")
+}
+
+@(test)
+settings_truncated_defaults :: proc(t: ^testing.T) {
+	path := tmp_settings_path(t)
+	defer os.remove(path)
+	write_settings_bytes(path, []u8{SETTINGS_MAGIC, SETTINGS_VERSION, 1}) // 3 bytes — too short
+	got := settings_load_at(path)
+	testing.expect(t, got == DEFAULT_A11Y(), "a truncated file must fall back to defaults")
+}
+
+@(test)
+settings_foreign_version_defaults :: proc(t: ^testing.T) {
+	path := tmp_settings_path(t)
+	defer os.remove(path)
+	buf := [6]u8{SETTINGS_MAGIC, 99, 1, 1, 2, 0} // version 99
+	buf[5] = buf[2] + buf[3] + buf[4]
+	write_settings_bytes(path, buf[:])
+	got := settings_load_at(path)
+	testing.expect(t, got == DEFAULT_A11Y(), "a foreign-version file must fall back to defaults")
+}
+
+@(test)
+settings_bad_magic_defaults :: proc(t: ^testing.T) {
+	path := tmp_settings_path(t)
+	defer os.remove(path)
+	buf := [6]u8{0xAB, SETTINGS_VERSION, 1, 1, 2, 0} // wrong magic
+	buf[5] = buf[2] + buf[3] + buf[4]
+	write_settings_bytes(path, buf[:])
+	got := settings_load_at(path)
+	testing.expect(t, got == DEFAULT_A11Y(), "a bad-magic file must fall back to defaults")
+}
+
+@(test)
+settings_bad_checksum_defaults :: proc(t: ^testing.T) {
+	path := tmp_settings_path(t)
+	defer os.remove(path)
+	buf := [6]u8{SETTINGS_MAGIC, SETTINGS_VERSION, 1, 1, 2, 99} // checksum flipped
+	write_settings_bytes(path, buf[:])
+	got := settings_load_at(path)
+	testing.expect(t, got == DEFAULT_A11Y(), "a checksum-failed file must fall back to defaults")
+}
+
+@(test)
+settings_mode_out_of_range_defaults :: proc(t: ^testing.T) {
+	path := tmp_settings_path(t)
+	defer os.remove(path)
+	buf := [6]u8{SETTINGS_MAGIC, SETTINGS_VERSION, 9, 1, 2, 0} // palette 9 > Tritan(3)
+	buf[5] = buf[2] + buf[3] + buf[4]
+	write_settings_bytes(path, buf[:])
+	got := settings_load_at(path)
+	testing.expect(t, got == DEFAULT_A11Y(), "an out-of-range palette mode must fall back to defaults")
+}
+
+@(test)
+settings_motion_out_of_range_defaults :: proc(t: ^testing.T) {
+	path := tmp_settings_path(t)
+	defer os.remove(path)
+	buf := [6]u8{SETTINGS_MAGIC, SETTINGS_VERSION, 1, 7, 2, 0} // motion 7 != 0/1
+	buf[5] = buf[2] + buf[3] + buf[4]
+	write_settings_bytes(path, buf[:])
+	got := settings_load_at(path)
+	testing.expect(t, got == DEFAULT_A11Y(), "an out-of-range motion byte must fall back to defaults")
+}
+
+@(test)
+settings_scale_out_of_range_defaults :: proc(t: ^testing.T) {
+	path := tmp_settings_path(t)
+	defer os.remove(path)
+	buf := [6]u8{SETTINGS_MAGIC, SETTINGS_VERSION, 1, 1, 5, 0} // step 5 >= UI_SCALE_COUNT
+	buf[5] = buf[2] + buf[3] + buf[4]
+	write_settings_bytes(path, buf[:])
+	got := settings_load_at(path)
+	testing.expect(t, got == DEFAULT_A11Y(), "an out-of-range scale step must fall back to defaults")
+}
+
+@(test)
+settings_scale_of_steps :: proc(t: ^testing.T) {
+	testing.expect(t, scale_of(0) == 1.00, "step 0 -> x1.00")
+	testing.expect(t, scale_of(1) == 1.25, "step 1 -> x1.25")
+	testing.expect(t, scale_of(2) == 1.50, "step 2 -> x1.50")
+	testing.expect(t, scale_of(3) == 1.00, "step 3 (OOR) -> x1.00")
+	testing.expect(t, step_of(1.25) == 1, "x1.25 -> step 1")
+	testing.expect(t, step_of(1.0) == 0, "x1.00 -> step 0")
+}
+
+@(test)
+settings_cycle_scale_wraps :: proc(t: ^testing.T) {
+	// Perkins r1 B2: a touch-only player at the top step must be able to get
+	// BACK — the cycle wraps 150% -> 100%, never clamps-and-strands.
+	testing.expect(t, cycle_scale(0, 1) == 1, "100% next -> 125%")
+	testing.expect(t, cycle_scale(1, 1) == 2, "125% next -> 150%")
+	testing.expect(t, cycle_scale(2, 1) == 0, "150% next -> 100% (the B2 wrap)")
+	testing.expect(t, cycle_scale(0, -1) == 2, "100% prev -> 150%")
+	testing.expect(t, cycle_scale(2, -1) == 1, "150% prev -> 125%")
+	testing.expect(t, cycle_scale(0, 0) == 0, "a zero delta holds the step")
+}
+
+@(test)
+settings_adjust_step_normalizes :: proc(t: ^testing.T) {
+	// Perkins r2 blocker 1: a delta-0 activate MUST advance the cycle rows
+	// (touch tap / mouse click / Enter / pad A all deliver 0); explicit +/-
+	// pass through unchanged.
+	testing.expect(t, adjust_step(0) == 1, "delta 0 -> +1 (tap = next)")
+	testing.expect(t, adjust_step(1) == 1, "delta +1 passes through")
+	testing.expect(t, adjust_step(-1) == -1, "delta -1 passes through")
+	// the composed tap path: cycle + adjust_step(0) must actually advance
+	testing.expect(t, cycle_scale(0, adjust_step(0)) == 1, "tap advances 100% -> 125%")
+	testing.expect(t, cycle_scale(2, adjust_step(0)) == 0, "tap wraps 150% -> 100%")
+	testing.expect(t, cycle_palette(0, adjust_step(0)) == 1, "tap advances off -> deutan")
+}
+
+@(test)
+settings_cycle_palette_wraps :: proc(t: ^testing.T) {
+	testing.expect(t, cycle_palette(0, 1) == 1, "off next -> deutan")
+	testing.expect(t, cycle_palette(3, 1) == 0, "tritan next -> off")
+	testing.expect(t, cycle_palette(0, -1) == 3, "off prev -> tritan")
+	testing.expect(t, cycle_palette(2, 1) == 3, "protan next -> tritan")
+}
+
+@(test)
+settings_startup_apply :: proc(t: ^testing.T) {
+	// Perkins r3 blocker 4c: the STARTUP application of persisted settings
+	// must land in the effective view (palette mode + motion + scale) — the
+	// exact sequence the app init runs (a11y_apply). A saved file round-
+	// trips through the same code path the app boots with.
+	path := tmp_settings_path(t)
+	defer os.remove(path)
+	settings_save_at(path, A11y_Settings{palette = .Tritan, reduced_motion = true, scale_step = 2})
+	loaded := settings_load_at(path)
+	base := rnd_palette_for_test()
+	eff: rnd.Palette
+	view: rnd.View
+	a11y_apply(loaded, &base, &eff, &view)
+	testing.expect(t, eff.mode == .Tritan, "startup applies the persisted palette mode")
+	testing.expect(t, eff.state_healthy == base.modes.tritan.colors[int(rnd.Palette_Token.State_Healthy)], "startup applies the palette tokens")
+	testing.expect(t, view.reduced_motion == true, "startup applies reduced-motion")
+	testing.expect(t, view.ui_scale == 1.50, "startup applies the scale step")
+	// a defaults-loaded file resets everything
+	path2 := tmp_settings_path(t)
+	defer os.remove(path2)
+	settings_save_at(path2, A11y_Settings{})
+	loaded2 := settings_load_at(path2)
+	a11y_apply(loaded2, &base, &eff, &view)
+	testing.expect(t, eff.mode == .Off && !view.reduced_motion && view.ui_scale == 1.00, "defaults reset the effective view")
+}
