+// (Perkins r1 B6/P0: the oracle bites in the CI gate, but nothing proved a
+// poison FAILS it — an oracle that never fails is a vacuous gate). Poison a
+// shipped token pair -> the separation check must fail; a clean palette must
+// pass. Runs headless (`odin test harness`) — no window, no render.
+
+import "core:testing"
+import pp "../core"
+import rnd "../app/render"
+
+// oracle_cat — the real catalogs (the oracle's packet-class leg reads
+// cat.packet_types; the committed data files are the deterministic fixture —
+// the test runner's cwd is the repo root, like the harness itself).
+oracle_cat :: proc(t: ^testing.T) -> pp.Catalogs {
+	cat: pp.Catalogs
+	if e := load_catalogs(&cat); e != "" {
+		testing.fail_now(t, "oracle test cannot load the catalogs")
+	}
+	return cat
