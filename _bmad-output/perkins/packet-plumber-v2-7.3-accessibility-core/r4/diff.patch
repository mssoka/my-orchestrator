+
+palette_token_by_name :: proc(name: string) -> (Palette_Token, bool) {
+	switch name {
+	case "state_healthy":    return .State_Healthy, true
+	case "state_congested":  return .State_Congested, true
+	case "state_critical":   return .State_Critical, true
+	case "lane_express":     return .Lane_Express, true
+	case "lane_standard":    return .Lane_Standard, true
+	case "lane_best_effort": return .Lane_Best_Effort, true
+	case "ghost_ok":         return .Ghost_Ok, true
+	case "ghost_bad":        return .Ghost_Bad, true
+	case "pipe_copper":      return .Pipe_Copper, true
