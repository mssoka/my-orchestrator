+			}
+		}
+		return true // a tap off the rows is still swallowed — the modal owns the surface
+	}
+	if rl.CheckCollisionPointRec(pos, rnd.settings_chip_rect(ictx.view)) {
+		ictx.panel_open = true
+		ictx.panel_row = 0
+		if ictx.on_settings != nil { ictx.on_settings(ictx.user, ictx) }
+		return true
+	}
+	return false
+}
