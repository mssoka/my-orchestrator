+
+palette_set_token :: proc(p: ^Palette, tok: Palette_Token, c: rl.Color) {
+	switch tok {
+	case .State_Healthy:    p.state_healthy = c
+	case .State_Congested:  p.state_congested = c
+	case .State_Critical:   p.state_critical = c
+	case .Lane_Express:     p.lane_express = c
+	case .Lane_Standard:    p.lane_standard = c
+	case .Lane_Best_Effort: p.lane_best_effort = c
+	case .Ghost_Ok:         p.ghost_ok = c
+	case .Ghost_Bad:        p.ghost_bad = c
+	case .Pipe_Copper:      p.pipe_copper = c
+	case .Pipe_Steel:       p.pipe_steel = c
+	case .Pipe_Fiber:       p.pipe_fiber = c
+	case .Route_Glow:       p.route_glow = c
+	case .Route_Tie:        p.route_tie = c
+	case .Water:            p.water = c
+	case .Park:             p.park = c
+	case .Coast:            p.coast = c
+	}
+}
+
+// palette_apply_mode — rebuild the EFFECTIVE palette (`dst`) from the loaded
+// base (`base`) with the mode's overrides applied. `base` is never mutated
+// (the app/harness keep one base + one effective Palette; switching modes
+// is a fresh copy + apply — no drift, `.Off` is byte-identical to the base).
+// The map cells (map.odin) cache off the run seed — a palette change does
+// NOT invalidate them (the map renders per-cell classification; colors are
+// read at draw). Presentation-only [ODN-1]: never touches sim state.
+palette_apply_mode :: proc(base: ^Palette, dst: ^Palette, mode: Palette_Mode) {
+	dst^ = base^
+	dst.mode = mode
+	if mode == .Off {
+		return
+	}
+	t: ^Mode_Table
+	#partial switch mode {
+	case .Deutan:  t = &dst.modes.deutan
+	case .Protan: t = &dst.modes.protan
+	case .Tritan:  t = &dst.modes.tritan
+	case:          return
+	}
+	for tok in Palette_Token {
+		i := int(tok)
+		if t.set[i] {
+			palette_set_token(dst, tok, t.colors[i])
+		}
+	}
+	if t.roofs_set {
+		dst.house_roofs = t.roofs
+	}
+}
+
+// mode_class_color — the EFFECTIVE packet-class color: the mode's override
+// when the class id matches, else the catalog base. Draw-time only (the
+// catalog is never edited — cat.hash is golden-poison; the remap is a
+// presentation concern, ODN-1).
+mode_class_color :: proc(p: ^Palette, class_id: string, base: rl.Color) -> rl.Color {
+	if p.mode == .Off {
+		return base
+	}
+	t: ^Mode_Table
+	#partial switch p.mode {
+	case .Deutan:  t = &p.modes.deutan
+	case .Protan: t = &p.modes.protan
+	case .Tritan:  t = &p.modes.tritan
+	case:          return base
+	}
+	for i in 0..<MAX_CLASS_OVERRIDES {
+		if !t.classes_set[i] || !t.classes[i].set { continue }
+		if len(class_id) == t.classes[i].id_len {
+			match := true
+			for j in 0..<t.classes[i].id_len {
+				if class_id[j] != t.classes[i].id[j] {
+					match = false
+					break
+				}
+			}
+			if match {
+				return t.classes[i].col
+			}
+		}
+	}
+	return base
+}
+
 jcol :: proc(o: json.Object, key: string, def: rl.Color) -> rl.Color {
 	if arr, ok := o[key].(json.Array); ok {
 		return jcol_arr(arr, def)
