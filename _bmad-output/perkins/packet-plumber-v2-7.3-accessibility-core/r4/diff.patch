 // crisis_banner_rect — the banner card's rect when it draws (the SAME math
 // draw_crisis_banner fills; ok=false when no banner draws — the app hit-tests
 // this for the 7.1 alerts-as-nav click).
+// crisis_card_width — the banner card width, CLAMPED so the centered card
+// clears the top-right forecast panel at high UI scales (Perkins r1 B4: at
+// ×1.50 the unclamped 660px card's right edge crossed the forecast's left
+// edge — 'WEATHER REPORT' rendered behind the banner; the E9.3 chrome-legible
+// AC failed at the knob's own max). Single source: the rect + the draw share
+// it, so the hit-test and the pixels can never diverge. At ×1.00/×1.25 the
+// clamp never engages (byte-identical to the blessed goldens).
+crisis_card_width :: proc(v: ^View) -> i32 {
+	card_w := hud(v, 440)
+	pad := hud(v, 10)
+	forecast_left := v.win_w - hud(v, 230) - hud(v, 10) // the forecast panel's left edge
+	max_right := forecast_left - hud(v, 10)             // a 10px gap keeps them apart
+	// the banner is centered: right edge = (win_w + card_w)/2 + pad
+	max_card := 2 * (max_right - pad) - v.win_w
+	if card_w > max_card {
+		card_w = max(hud(v, 240), max_card) // never crush below the minimum
+	}
+	return card_w
+}
+
+// crisis_text_scale — the banner text scale: hud() at ×1.00/×1.25 (the clamp
+// never engages), and the clamp ratio at ×1.50 so the title always fits the
+// narrowed card (deterministic int math — the draw's single source).
+crisis_text_scale :: proc(v: ^View) -> f32 {
+	return min(1.0, f32(crisis_card_width(v)) / f32(hud(v, 440)))
