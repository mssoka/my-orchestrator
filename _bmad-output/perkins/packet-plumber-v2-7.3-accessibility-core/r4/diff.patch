diff --git a/app/qos_panel_test.odin b/app/qos_panel_test.odin
new file mode 100644
index 0000000..22e0097
--- /dev/null
+++ b/app/qos_panel_test.odin
@@ -0,0 +1,36 @@
+package main
+
+// qos_panel_test.odin — the QoS manual-editor scaled-geometry pin (Perkins r3
+// blocker 4d: B2's fix — values derived from the scaled nudge rects — had no
+// automated pin). At EVERY scale step the − and + buttons must not overlap
+// and the weight value must sit strictly BETWEEN them (never inside a button).
+
+import "core:testing"
+import rnd "./render"
+
+@(test)
+qos_nudge_geometry_never_overlaps :: proc(t: ^testing.T) {
+	steps := UI_SCALE_STEPS // local copy
+	for si in 0 ..< len(steps) {
+		scale := steps[si]
+		v: rnd.View
+		v.ui_scale = scale
+		v.win_w = 1280
+		v.win_h = 720
+		for lane in i32(0) ..< 3 {
+			m := qos_nudge_rect(&v, 2, lane, true)
+			ppp := qos_nudge_rect(&v, 2, lane, false)
+			testing.expect(t, m.x + m.width <= ppp.x, "the minus button clears the plus button at every scale")
+			val := f32(qos_value_between(&v, m, ppp))
+			testing.expect(t, val >= m.x + m.width, "the value starts right of the minus button")
+			testing.expect(t, val + 20 <= ppp.x, "the value fits before the plus button")
+		}
+		// the lanes' columns must not collide with each other either (the
+		// r3 x1.50 lane-1/2 value-vs-previous-plus finding)
+		for lane in i32(1) ..< 3 {
+			prev_plus := qos_nudge_rect(&v, 2, lane - 1, false)
+			cur_minus := qos_nudge_rect(&v, 2, lane, true)
+			testing.expect(t, prev_plus.x + prev_plus.width <= cur_minus.x, "a lane's column clears the previous lane's")
+		}
+	}
+}
