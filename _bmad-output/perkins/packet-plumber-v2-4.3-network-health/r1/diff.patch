-	append(&cat.packet_types, Packet_Type{id = "streaming", display = "Streaming", shape = .Triangle, icon = "play", color_rgba = {30, 74, 152, 255}, latency_tol_ms = 300, max_loss_pct = 10, bandwidth_demand = 2, default_lane = 1, demand_weight = 1, era_introduced = 3})
+	append(&cat.packet_types, Packet_Type{id = "email", display = "Email", shape = .Circle, icon = "mail", color_rgba = {90, 98, 112, 255}, latency_tol_ms = 500, max_loss_pct = 30, bandwidth_demand = 1, default_lane = 1, demand_weight = 1, era_introduced = 1, health_grace_ticks = 400, health_drain_pct_per_tick = 1})
+	append(&cat.packet_types, Packet_Type{id = "streaming", display = "Streaming", shape = .Triangle, icon = "play", color_rgba = {30, 74, 152, 255}, latency_tol_ms = 300, max_loss_pct = 10, bandwidth_demand = 2, default_lane = 1, demand_weight = 1, era_introduced = 3, health_grace_ticks = 400, health_drain_pct_per_tick = 2})
 	// 3.1: the per-era demand (mirrors data/demand.json — eras 1/2 email-only,
 	// era 3 email + streaming + the streaming_surge set-piece). 4.2: the surge
 	// set-piece names its crisis archetype (crises.json cross-ref).
diff --git a/core/health.odin b/core/health.odin
new file mode 100644
index 0000000..d8bf02e
--- /dev/null
+++ b/core/health.odin
@@ -0,0 +1,363 @@
+package core
+
+// health.odin — Story 4.3: S5 Network Health (arch §6.5): the aggregate loss
+// condition + the surge-window win tracking. The meter drains on SUSTAINED
+// per-class SLA breach (grace countdown first — the recoverable window),
+// recharges when every class is healthy, and emptying it → Run_Lost (Error
+// 404) → the terminal-event barrier (E17) freezes the run — one terminal
+// event per run by construction.
+//
+// The measurement is WINDOWED (the E30 seam the 3.4 sla_evaluate comment
+// deferred): per class, a rolling window of `health.window_ticks` per-tick
+// deltas (delivered/dropped/latency_ms). The 3.4 cumulative loss latch is
+// MONOTONE by contract — feeding the meter from it would drain forever after
+// the first breach, so the health layer measures its own windowed ratios
+// against the same per-class catalog tolerances (E30 enter/exit thresholds).
+// The 3.4 evaluator + its events + latches stay untouched (golden compat).
+//
+// The per-tick deltas are DIFFED from the flow's cumulative SLA accumulators
+// (prev_* scratch) — no flow coupling, no event-buffer reads, and a same-tick
+// re-step sees delta 0 (re-step-safe; the 4.2 accepted-convention note: the
+// ring slot may be overwritten with zeros on a same-tick re-step — the
+// harness drains per step, the app never re-steps, replay never re-steps, so
+// replay equality holds). The window rings + sums + breach latches + grace
+// cells + prev scratch are DERIVED (never serialized — replay rebuilds them
+// identically from the serialized flow + tick history; same status as
+// lane_caps/sla_breach); only meter_pct + the non-zero grace rows + the
+// surge-win accumulators ride the T1 hash.
+//
+// Grace (E30, per class): breach ENTER with `grace_left > 0` starts the
+// countdown (Grace_Started{class}); a re-breach during an ACTIVE grace is a
+// no-op (the countdown is NOT restarted — one countdown per episode);
+// recovery cancels it (no drain, no event); expiry while still breached emits
+// Grace_Expired{class} + the class starts DRAINING. Gradual refill (the
+// proven-fun prototype's never-lose guard): a recovered class's grace_left
+// refills +grace_refill_per_tick ONLY after a grace_refill_streak_ticks
+// healthy streak, capped at the class's full grace — consecutive episodes
+// burn the shared countdown, so a flapping line can never re-arm a full grace
+// forever.
+//
+// Drain (E16): per tick, drain = min(max over DRAINED classes (breached AND
+// post-grace) of the class's health_drain_pct_per_tick, the balance cap) —
+// max(severity), NOT sum, plus the per-tick cap ("never instant": the meter
+// cannot empty faster than 100/cap ticks). Recharge: when NO class is
+// breached, +recharge_pct_per_tick toward 100.
+//
+// Empty → Run_Lost (E17): on the drain tick that would empty the meter,
+// health_update emits Run_Lost (tag 3), latches terminal/outcome, and emits
+// NO Grace_Expired/Meter_Changed that tick (`run_lost` supersedes
+// `grace_expired`); the step barrier then skips the rest of the tick
+// (win_lose_eval's terminal guard) — one terminal event per run.
+//
+// Surge-window win tracking: when Run_State.surge_win_pct != 0, the layer
+// tracks the era's first set-piece carrying a crisis archetype (the surge —
+// the crises.json cross-ref): OVERALL delivered/dropped (all classes) over
+// the active span; the accumulators reset when a new surge starts (never
+// double-count) and FREEZE when it ends (surge_done latches at the
+// deactivation tick). win_lose_eval evaluates the ratio (uptime >=
+// surge_win_pct → Run_Won; E24: a zero-completion window is neutral — never
+// a fake win). The win tracking is INDEPENDENT of health_enabled (the flags
+// are orthogonal run setup: `win surge <n>` alone suffices).
+//
+// Back-compat: Run_State.health_enabled gates the METER + grace + drain +
+// events (false = fully inert — the pre-4.3 demos' behavior unchanged; only
+// their T1 bytes shift via the catalog_hash fold). Integer-only (ODN-10);
+// arrays only, no maps (ODN-10); no file/clock reads (ODN-1).
+
+// health_make / health_destroy — Run_State.health lifetime (mirrors
+// crisis_make/crisis_destroy; ODN-18 arena discipline lands later).
+health_make :: proc(h: ^Health_State, allocator := context.allocator) {
+	h^ = {}
+	h.meter_pct = 100 // the meter starts FULL (the run-init default; the disabled state reads 100 too)
+	h.breach = make([dynamic]bool, 0, 4, allocator)
+	h.grace = make([dynamic]Grace_Cell, 0, 4, allocator)
+	h.prev_delivered = make([dynamic]u64, 0, 4, allocator)
+	h.prev_dropped = make([dynamic]u64, 0, 4, allocator)
+	h.prev_latency = make([dynamic]u64, 0, 4, allocator)
+	h.win_delivered = make([dynamic]u64, 0, 4, allocator)
+	h.win_dropped = make([dynamic]u64, 0, 4, allocator)
+	h.win_latency = make([dynamic]u64, 0, 4, allocator)
+	h.ring = make([dynamic]Window_Tick, 0, 4, allocator)
+}
+
+health_destroy :: proc(h: ^Health_State) {
+	delete(h.breach)
+	delete(h.grace)
+	delete(h.prev_delivered)
+	delete(h.prev_dropped)
+	delete(h.prev_latency)
+	delete(h.win_delivered)
+	delete(h.win_dropped)
+	delete(h.win_latency)
+	delete(h.ring)
+}
+
+// event_emit_health — append a Grace_Started / Grace_Expired event with its
+// class payload (4.3, ODN-14). Tag-conditional in the serializer —
+// append-only, pre-4.3 streams byte-identical.
+event_emit_health :: proc(state: ^Run_State, tick: u64, tag: u8, class: u16) {
+	append(&state.events, Event{tick = tick, tag = tag, class = class})
+}
+
+// event_emit_meter — append a Meter_Changed event with the meter-pct payload
+// byte (4.3, ODN-14).
+event_emit_meter :: proc(state: ^Run_State, tick: u64, pct: u32) {
+	append(&state.events, Event{tick = tick, tag = EVENT_TAG_METER_CHANGED, meter = u8(pct)})
+}
+
+// surge_active — is a crisis-archetype set-piece (the surge) active this tick?
+// The era's set-pieces with a crises.json archetype cross-ref (archetype_idx
+// >= 0) are the crisis-bearing ones; the MVP has exactly one (the surge).
+// Pure catalog read — the same rule the crisis engine + forecast use, no
+// director call (health_update must not allocate a plan).
+surge_active :: proc(cat: ^Catalogs, era: u8, tick: u64) -> bool {
+	if era == 0 || int(era) > len(cat.demand.eras) {
+		return false
+	}
+	de := &cat.demand.eras[era-1]
+	for &sp in de.set_pieces {
+		if sp.archetype_idx >= 0 && set_piece_active(&sp, tick) {
+			return true
+		}
+	}
+	return false
+}
+
+// health_ensure — grow the per-class health arrays (breach/grace/prev/win
+// sums) + the flat ring up to `n` classes with the catalog window. APPEND-
+// ONLY growth: existing slots never move (slot = class × window + tick %
+// window), so the ring's history stays valid when a new class appears mid-run
+// (deterministic — replay sees the same growth). The ring tail is explicitly
+// zeroed (determinism — never trust a resize's new memory).
+health_ensure :: proc(h: ^Health_State, cat: ^Catalogs, n: int) {
+	win := u32(cat.balance.health.window_ticks)
+	want := n * int(win)
+	if win != h.window_ticks || len(h.ring) != want {
+		old_len := len(h.ring)
+		h.window_ticks = win
+		resize(&h.ring, want)
+		// zero ONLY the new tail explicitly (resize's new memory must not leak
+		// stale values into the sums; the EXISTING slots keep their history —
+		// a mid-run class appearance must not wipe the live classes' window).
+		for i in old_len..<want {
+			h.ring[i] = {}
+		}
+	}
+	for len(h.breach) < n {
+		append(&h.breach, false)
+		// the grace cell ARMS FULL on the class's first demand (the prototype's
+		// init-full semantics): the first breach gets the class's full
+		// countdown; a SPENT grace (0 after expiry) re-arms ONLY via the
+		// gradual refill — a re-breach with a spent grace drains immediately
+		// (the one-countdown-per-episode rule, E30).
+		full := u32(0)
+		if len(h.breach) - 1 < len(cat.packet_types) {
+			full = cat.packet_types[len(h.breach) - 1].health_grace_ticks
+		}
+		append(&h.grace, Grace_Cell{grace_left = full})
+		append(&h.prev_delivered, 0)
+		append(&h.prev_dropped, 0)
+		append(&h.prev_latency, 0)
+		append(&h.win_delivered, 0)
+		append(&h.win_dropped, 0)
+		append(&h.win_latency, 0)
+	}
+}
+
+// health_update — the per-tick Network Health eval (called inside core.step
+// AFTER crisis_evaluate, BEFORE win_lose_eval — the spine's order: flow →
+// crisis → health → win/lose). See the file header for the full contract.
+health_update :: proc(state: ^Run_State, tick: u64, cat: ^Catalogs) {
+	h := &state.health
+
+	// the catalog-bound class set (rows are class-id-indexed; a beyond-catalog
+	// row is never measured by sla_evaluate — same defensive guard here).
+	n := len(state.flow.sla)
+	if n > len(cat.packet_types) {
+		n = len(cat.packet_types)
+	}
+	if n == 0 {
+		return // no demand yet — nothing to measure (E24)
+	}
+	health_ensure(h, cat, n)
+
+	bal := &cat.balance.health
+	win := u64(h.window_ticks)
+
+	// surge-window tracking (independent of health_enabled — the win flags
+	// are orthogonal run setup). The deactivation-edge detector (prev_in_surge)
+	// is derived state; the accumulators freeze at the window end.
+	in_surge := state.surge_win_pct != 0 && surge_active(cat, state.era, tick)
+	if in_surge && !h.prev_in_surge {
+		h.surge_delivered = 0 // a NEW surge starts a fresh window (never double-count)
+		h.surge_dropped = 0
+	}
+
+	// the per-class pass: diffs → ring → windowed breach latch (E30) → grace.
+	// The just-expired classes are collected for the post-drain emissions (the
+	// E17 suppression needs the meter-empty decision first).
+	expired := make([dynamic]u16, 0, 4, context.temp_allocator)
+	defer delete(expired)
+	any_breach := false
+	for c in 0..<n {
+		acc := &state.flow.sla[c]
+		tol := &cat.packet_types[c]
+
+		// per-tick deltas (the accumulator diff — re-step-safe)
+		dd := acc.delivered - h.prev_delivered[c]
+		dp := acc.dropped - h.prev_dropped[c]
+		dl := acc.total_latency_ms - h.prev_latency[c]
+		h.prev_delivered[c] = acc.delivered
+		h.prev_dropped[c] = acc.dropped
+		h.prev_latency[c] = acc.total_latency_ms
+
+		// the flat ring (slot = class × window + tick % window)
+		slot := int(c) * int(h.window_ticks) + int(tick % win)
+		h.win_delivered[c] += dd - u64(h.ring[slot].delivered)
+		h.win_dropped[c] += dp - u64(h.ring[slot].dropped)
+		h.win_latency[c] += dl - h.ring[slot].latency_ms
+		h.ring[slot] = Window_Tick{delivered = u32(dd), dropped = u32(dp), latency_ms = dl}
+
+		if in_surge {
+			h.surge_delivered += dd
+			h.surge_dropped += dp
+		}
+
+		// E30 windowed breach latch: ENTER strictly above the tolerance (loss
+		// OR latency); EXIT only when BOTH sit at or below tolerance − margin
+		// (the hysteresis band — an oscillating class cannot flap the latch
+		// every tick). E24: a class with no completed demand in the window
+		// measures nothing (neutral).
+		old := h.breach[c]
+		completed := h.win_delivered[c] + h.win_dropped[c]
+		loss_pct := u64(0)
+		if completed > 0 {
+			loss_pct = h.win_dropped[c] * 100 / completed
+		}
+		avg_ms := u64(0)
+		if h.win_delivered[c] > 0 {
+			avg_ms = h.win_latency[c] / h.win_delivered[c]
+		}
+		exit_loss := u64(0)
+		if tol.max_loss_pct > bal.exit_margin_pct {
+			exit_loss = u64(tol.max_loss_pct - bal.exit_margin_pct)
+		}
+		exit_lat := u64(0)
+		if tol.latency_tol_ms > bal.exit_margin_ms {
+			exit_lat = u64(tol.latency_tol_ms - bal.exit_margin_ms)
+		}
+		entered := (completed > 0 && loss_pct > u64(tol.max_loss_pct)) ||
+			(h.win_delivered[c] > 0 && avg_ms > u64(tol.latency_tol_ms))
+		exited := !(completed > 0 && loss_pct > exit_loss) &&
+			!(h.win_delivered[c] > 0 && avg_ms > exit_lat)
+		if !old && entered {
+			h.breach[c] = true
+		} else if old && exited {
+			h.breach[c] = false
+		}
+		if h.breach[c] {
+			any_breach = true
+		}
+
+		if !state.health_enabled {
+			continue // the meter machinery is gated — the ring/latch still ride (derived)
+		}
+
+		// the per-class grace lifecycle (E30 — one countdown per episode)
+		cell := &h.grace[c]
+		full_grace := tol.health_grace_ticks
+		if h.breach[c] {
+			cell.healthy_streak = 0
+			if cell.grace_left > 0 {
+				if !old {
+					// a NEW episode with a countdown — Grace_Started on the
+					// enter edge (a re-breach during an active grace is a no-op:
+					// old stays true, the countdown simply continues)
+					event_emit_health(state, tick, EVENT_TAG_GRACE_STARTED, u16(c))
+				}
+				cell.grace_left -= 1
+				if cell.grace_left == 0 {
+					// the countdown ran out while still breached — the class
+					// starts DRAINING (the Grace_Expired event lands after the
+					// meter move, suppressed if the meter empties — E17)
+					append(&expired, u16(c))
+				}
+			}
+		} else {
+			// healthy: the gradual refill (the never-lose guard) — the grace
+			// re-arms +refill_per_tick ONLY after a sustained healthy streak
+			cell.healthy_streak += 1
+			if cell.grace_left < full_grace &&
+			   cell.healthy_streak >= u32(bal.grace_refill_streak_ticks) {
+				add := u32(bal.grace_refill_per_tick)
+				if cell.grace_left + add > full_grace {
+					cell.grace_left = full_grace
+				} else {
+					cell.grace_left += add
+				}
+			}
+		}
+	}
+
+	if !state.health_enabled {
+		// meter inert — but the surge-done edge still needs to latch (the win
+		// tracking is orthogonal)
+		if h.prev_in_surge && !in_surge && state.surge_win_pct != 0 {
+			h.surge_done = true
+		}
+		h.prev_in_surge = in_surge
+		return
+	}
+
+	// drain (E16): max severity over the DRAINED classes (breached AND
+	// post-grace — a class in grace does not drain), capped per tick.
+	drain: u32 = 0
+	if any_breach {
+		for c in 0..<n {
+			if h.breach[c] && h.grace[c].grace_left == 0 {
+				sev := cat.packet_types[c].health_drain_pct_per_tick
+				if sev > drain {
+					drain = sev
+				}
+			}
+		}
+		if drain > u32(bal.drain_cap_pct_per_tick) {
+			drain = u32(bal.drain_cap_pct_per_tick)
+		}
+	}
+
+	if drain > 0 {
+		if h.meter_pct <= drain {
+			// E17 — the meter emptied: Run_Lost supersedes everything this
+			// tick (no Grace_Expired, no Meter_Changed — `run_lost` supersedes
+			// `grace_expired`), terminal latches, the step barrier skips the
+			// rest of the tick.
+			h.meter_pct = 0
+			event_emit(state, tick, EVENT_TAG_RUN_LOST)
+			state.terminal = true
+			state.outcome = .Lost
+		} else {
+			h.meter_pct -= drain
+			for c in expired {
+				event_emit_health(state, tick, EVENT_TAG_GRACE_EXPIRED, c)
+			}
+			event_emit_meter(state, tick, h.meter_pct)
+		}
+	} else if !any_breach && h.meter_pct < 100 {
+		// recharge: every class healthy
+		recharge := u32(bal.recharge_pct_per_tick)
+		if h.meter_pct + recharge > 100 {
+			h.meter_pct = 100
+		} else {
+			h.meter_pct += recharge
+		}
+		event_emit_meter(state, tick, h.meter_pct)
+	}
+
+	// surge-done edge: the window JUST ended — freeze the accumulators for
+	// win_lose_eval (the ratio is evaluated at the deactivation tick).
+	if h.prev_in_surge && !in_surge && state.surge_win_pct != 0 {
+		h.surge_done = true
+	}
+	h.prev_in_surge = in_surge
+}
diff --git a/core/health_test.odin b/core/health_test.odin
new file mode 100644
index 0000000..91323e6
--- /dev/null
+++ b/core/health_test.odin
@@ -0,0 +1,866 @@
+package core
+
+// health_test.odin — Story 4.3's durable contracts (arch §6.5, E16/E17/E30,
+// ODN-14, [FORGE #3]). Pins:
+//   (a) the meter is INERT when health_enabled is false (back-compat: the
+//       pre-4.3 demos' behavior — no events, no drain, no Run_Lost);
+//   (b) E30 — windowed measurement (a burst breach RECOVERS as the window
+//       slides — the 3.4 monotone-latch trap avoided), enter/exit hysteresis
+//       at the margins, one countdown per episode (re-breach in an active
+//       grace = no-op), gradual grace refill (the never-lose guard);
+//   (c) E16 — drain = max(severity), not sum, plus the per-tick cap (never
+//       instant);
+//   (d) E17 — an empty meter emits Run_Lost from health_update, suppresses
+//       Grace_Expired/Meter_Changed that tick, and the terminal barrier
+//       freezes the run (one terminal event per run);
+//   (e) the surge win — overall uptime >= surge_win_pct at the window-end
+//       tick -> Run_Won; below the threshold (or zero completed demand) -> no
+//       win; a meter-empty on the window-end tick is a LOSE (spine order);
+//   (f) the no-soft-lock property [FORGE #3] — every adversarial fixture
+//       reaches terminal within a bounded horizon, a mid-drain fix recovers
+//       the meter (recoverable-until-empty), a healthy run never goes
+//       terminal;
+//   (g) replay byte-identity over the full drain -> lose loop (E10), the
+//       restart-clean retry cycle (ODN-13/E32), and the serialized byte
+//       layout (meter + grace rows + tags 10/11/12 payloads,
+//       absent-when-disabled).
+//
+// Fixtures: the crisis narrow-pipe shape (era 3 + narrow path = saturated at
+// base demand — the pool fills, E22 sheds accrue, the windowed loss breaches
+// within ~260 ticks); the mult2 catalog variant (surge 2/tick — the 4.2
+// healthy-fix precedent) for the win; a second residential for two-class
+// fixtures (email needs a res->res pair).
+
+import "core:testing"
+
+// health_record_run — step a run collecting the health event stream (the
+// ODN-14 drain convention — record_run clears the buffer per tick, so
+// event-scans must collect as they step) + the per-tick hashes. Mirrors
+// crisis_record_run; the caller owns both slices.
+health_record_run :: proc(s: ^Run_State, ticks: u64, cat: ^Catalogs) -> ([dynamic]u64, [dynamic]Event) {
+	hashes := make([dynamic]u64, 0, ticks)
+	events := make([dynamic]Event, 0, 64)
+	for tick in u64(1)..=ticks {
+		before := len(s.events)
+		batch := make([dynamic]Command, 0, 4, context.temp_allocator)
+		for cmd in s.action_log {
+			if cmd.apply_tick == tick {
+				append(&batch, cmd)
+			}
+		}
+		step(s, tick, batch[:], cat)
+		h := state_hash(s, s.events[before:], cat, context.temp_allocator)
+		append(&hashes, h)
+		for e in s.events[before:] {
+			append(&events, e)
+		}
+		clear(&s.events)
+		free_all(context.temp_allocator)
+	}
+	return hashes, events
+}
+
+// health_count_tag — count events with a given tag in a collected stream.
+health_count_tag :: proc(evs: []Event, tag: u8) -> int {
+	n := 0
+	for e in evs {
+		if e.tag == tag {
+			n += 1
+		}
+	}
+	return n
+}
+
+// health_narrow_fixture — the saturated narrow-pipe fixture (era 3 set by the
+// caller): the crisis shape (res <- rt -> host on narrows drawn at tick 1).
+// At base demand the path saturates -> the pool fills (~tick 256) -> E22
+// sheds accrue -> the windowed loss breaches within ~260 ticks.
+health_narrow_fixture :: proc(s: ^Run_State, cat: ^Catalogs) -> (u32, u32, u32) {
+	return crisis_seed_fixture(s, cat)
+}
+
+// health_prepared_fixture — the mult2 WIN fixture (the crisis healthy-fix
+// shape scaled to the REAL service math): TWO routers (the 4-port limit — a
+// single router cannot carry the surge), 2 wides per leg per router. Per
+// router: 80 u/tick service vs the ECMP-split 60 u/tick in-window (mult2:
+// 2/tick x 60 u) — headroom, no sheds, uptime ~100%. Latency: 2 hops x 2
+// ticks (wide 40 u vs streaming 60 u) = 200 ms < 300 — latency-healthy.
+// Only streaming spawns (one residential: email's res->res pair is empty).
+health_prepared_fixture :: proc(s: ^Run_State, cat: ^Catalogs) {
+	res_idx, _ := node_type_index(cat, "residential")
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	host_idx, _ := node_type_index(cat, "content_host")
+	r := topology_spawn_node(&s.topology, res_idx, {8, 15}, cat)
+	g1 := topology_spawn_node(&s.topology, rt_idx, {14, 15}, cat)
+	g2 := topology_spawn_node(&s.topology, rt_idx, {20, 15}, cat)
+	h := topology_spawn_node(&s.topology, host_idx, {26, 15}, cat)
+	sla_draw(s, cat, r, g1, "wide", 1)
+	sla_draw(s, cat, r, g1, "wide", 1)
+	sla_draw(s, cat, g1, h, "wide", 1)
+	sla_draw(s, cat, g1, h, "wide", 1)
+	sla_draw(s, cat, r, g2, "wide", 1)
+	sla_draw(s, cat, r, g2, "wide", 1)
+	sla_draw(s, cat, g2, h, "wide", 1)
+	sla_draw(s, cat, g2, h, "wide", 1)
+}
+
+// health_second_residential — add a second residential (a res->res pair so
+// the EMAIL class spawns — the two-class fixtures need it).
+health_second_residential :: proc(s: ^Run_State, cat: ^Catalogs) -> u32 {
+	res_idx, _ := node_type_index(cat, "residential")
+	return topology_spawn_node(&s.topology, res_idx, {32, 15}, cat)
+}
+
+// health_catalog_fast_grace — the two-class E16 variant: the EMAIL grace
+// drops to 300 so BOTH classes are post-grace within a live run. Dynamics:
+// streaming breach ~5 + grace 400 -> drains from ~404 (severity 2); email
+// breach ~90 + grace 300 -> drains from ~390 (severity 1). The overlap band
+// [404, ~447] (the streaming death) is the max-not-sum assertion window.
+health_catalog_fast_grace :: proc(cat: ^Catalogs) {
+	cat.packet_types[0].health_grace_ticks = 300
+}
+
+// health_apply_fix — the recovery edit (the 2-router wide fan): demolish the
+// narrows, PLACE a second router, and draw 2 wides per leg on BOTH routers.
+// Per router: 80 u/tick service vs the ECMP-split 60 u/tick of the real base
+// demand (2 streaming/tick x 60 u) — the single-router 4-wide shape cannot
+// carry the base demand within the 4-port limit (4+4 ports > 4). The placed
+// router sits at (25, 9): >= 7 tiles from every live node (PLACEMENT_MIN_SEP)
+// and the res@(8,15) -> rt2 span rounds to 18 (<= wide max_span).
+health_apply_fix :: proc(s: ^Run_State, cat: ^Catalogs, at_tick: u64) {
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	append(&s.action_log, Command{apply_tick = at_tick, kind = Cmd_Demolish_Pipe{pipe = 0}})
+	append(&s.action_log, Command{apply_tick = at_tick, kind = Cmd_Demolish_Pipe{pipe = 1}})
+	append(&s.action_log, Command{apply_tick = at_tick + 1, kind = Cmd_Place_Router{type_idx = rt_idx, pos = {25, 9}}})
+	sla_draw(s, cat, 0, 1, "wide", at_tick + 2)
+	sla_draw(s, cat, 0, 1, "wide", at_tick + 2)
+	sla_draw(s, cat, 1, 2, "wide", at_tick + 2)
+	sla_draw(s, cat, 1, 2, "wide", at_tick + 2)
+	sla_draw(s, cat, 0, 3, "wide", at_tick + 2)
+	sla_draw(s, cat, 0, 3, "wide", at_tick + 2)
+	sla_draw(s, cat, 3, 2, "wide", at_tick + 2)
+	sla_draw(s, cat, 3, 2, "wide", at_tick + 2)
+}
