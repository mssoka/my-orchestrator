+	health_narrow_fixture(&s, cat)
+	s.health_enabled = true
+	// burn the grace fully: breach ~5 + expiry ~405 (Grace_Expired). The fix
+	// lands LATE in the grace (231 — the exit needs a full window slide, so
+	// the countdown keeps burning through the stuck window: it hits 0 at the
+	// expiry while the latch is still hot — the grace is SPENT and the meter
+	// drains until the exit ~433 (the mid-drain survival band).
+	step_n(&s, 230, cat)
+	health_apply_fix(&s, cat, 231)
+	step_n(&s, 180, cat) // tick 410: past the expiry, mid-drain (meter ~88)
+	testing.expectf(t, health_count_tag(s.events[:], EVENT_TAG_GRACE_EXPIRED) == 1, "the grace must expire under sustained breach")
+	testing.expectf(t, s.health.grace[1].grace_left == 0, "a spent grace reads 0, got %d", s.health.grace[1].grace_left)
+	testing.expectf(t, s.health.meter_pct < 100, "the meter must be draining, got %d", s.health.meter_pct)
+	// scan per tick for the first refill value: the exit ~433, the 50-tick
+	// streak gate, then the gradual refill — the first refilled value must be
+	// exactly grace_refill_per_tick (5), never a jump to the full 400.
+	first_refill := u32(0)
+	for i in 0..<500 {
