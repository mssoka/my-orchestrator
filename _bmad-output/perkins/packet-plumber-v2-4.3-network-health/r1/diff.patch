+@(test)
+test_health_grace_rebreach_noop_e30 :: proc(t: ^testing.T) {
+	// E30: a re-breach does NOT re-arm the countdown (one countdown per
+	// episode). Shape: breach ~5 (the countdown burns); the fix at 61 stops
+	// the drops, but the WINDOW keeps the latch hot until the burst slides
+	// out (~245 — the countdown keeps burning through the stuck window: the
+	// same episode); the latch exits with the grace partially burnt; a
+	// re-break right after must NOT restore the full 400 — the countdown
+	// resumes from the burnt value.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 42, cat.hash, TEST_LOGIC_HZ)
+	s.era = 3
+	health_narrow_fixture(&s, cat)
+	s.health_enabled = true
+	step_n(&s, 60, cat) // breach ~5 — in grace (the countdown is burning)
+	testing.expectf(t, s.health.grace[1].grace_left < 400, "the countdown must be burning")
+	// the fix: stops the drops, but the latch stays hot (the window slide)
+	health_apply_fix(&s, cat, 61)
+	step_n(&s, 190, cat) // tick 250: the burst slid out at ~245 -> the latch EXITED
+	testing.expectf(t, !s.health.breach[1], "the latch must exit once the burst slides out")
+	after_exit := s.health.grace[1].grace_left
+	testing.expectf(t, after_exit < 400 && after_exit > 0,
+		"the countdown must be partially burnt at the exit, got %d", after_exit)
+	testing.expectf(t, health_count_tag(s.events[:], EVENT_TAG_GRACE_EXPIRED) == 0,
+		"the grace must NOT have expired (the exit beat the expiry)")
+	// re-break: demolish the fan + re-draw the narrows (the path reverts to
+	// saturated; a bare broken path would stop ALL drops and never re-breach).
+	// The re-breach fires when the resumed drops push the windowed ratio over
+	// the tolerance (~tick 275) — well before the 50-tick refill streak gate.
+	append(&s.action_log, Command{apply_tick = 251, kind = Cmd_Demolish_Pipe{pipe = 2}})
+	append(&s.action_log, Command{apply_tick = 251, kind = Cmd_Demolish_Pipe{pipe = 3}})
+	append(&s.action_log, Command{apply_tick = 251, kind = Cmd_Demolish_Pipe{pipe = 4}})
+	append(&s.action_log, Command{apply_tick = 251, kind = Cmd_Demolish_Pipe{pipe = 5}})
+	append(&s.action_log, Command{apply_tick = 251, kind = Cmd_Demolish_Pipe{pipe = 6}})
+	append(&s.action_log, Command{apply_tick = 251, kind = Cmd_Demolish_Pipe{pipe = 7}})
+	append(&s.action_log, Command{apply_tick = 251, kind = Cmd_Demolish_Pipe{pipe = 8}})
+	append(&s.action_log, Command{apply_tick = 251, kind = Cmd_Demolish_Pipe{pipe = 9}})
+	sla_draw(&s, cat, 0, 1, "narrow", 252)
+	sla_draw(&s, cat, 1, 2, "narrow", 252)
+	step_n(&s, 60, cat)
+	testing.expectf(t, s.health.breach[1], "the re-breach must re-enter the latch")
+	after := s.health.grace[1].grace_left
+	testing.expectf(t, after <= after_exit - 20,
+		"re-breach must not re-arm the countdown: %d -> %d (want <= %d)", after_exit, after, after_exit - 20)
+}
