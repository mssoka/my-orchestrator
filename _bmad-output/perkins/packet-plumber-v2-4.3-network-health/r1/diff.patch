+import "core:fmt"
+import pp "../../core"
+import rl "vendor:raylib"
+
+// HEALTH_CARD_H — the meter card's total height (the crisis banner draws
+// below it when the meter is live: y = 10 + HEALTH_CARD_H + 6).
+HEALTH_CARD_H :: i32(52)
+
+// draw_health_meter — the top-center meter card (clear of the top-left run
+// HUD + the top-right forecast panel). The bar spans 240 px with a 10 px
+// segment per 4 pct (chunky — readable at a glance); the fill color follows
+// the meter (green >= 60, amber >= 30, red below — the number + caption are
+// the never-color-alone encoders). The per-class chips show the countdowns
+// (seconds = grace_left / logic_hz) and the drain state. Zero pixels when
+// `enabled` is false.
+draw_health_meter :: proc(v: ^View, health: ^pp.Health_State, cat: ^pp.Catalogs, enabled: bool) {
+	if !enabled {
+		return
+	}
+	p := v.palette
+	card_w := i32(440)
+	pad := i32(10)
+	x := (v.win_w - card_w) / 2
+	y := i32(10)
+
+	// the card backdrop
+	rl.DrawRectangle(x - pad, y - pad, card_w + 2 * pad, HEALTH_CARD_H, rl.Color{255, 244, 236, 240})
+	rl.DrawRectangleLines(x - pad, y - pad, card_w + 2 * pad, HEALTH_CARD_H, p.ink_soft)
+
+	// label + the pct number (the primary read — never color alone)
+	draw_text_c(v, "NETWORK HEALTH", x, y, 15, p.ink)
+	pct_txt := fmt.aprintf("%d%%", health.meter_pct, allocator = context.temp_allocator)
+	col := p.state_healthy
+	if health.meter_pct < 60 {
+		col = p.state_strain
+	}
+	if health.meter_pct < 30 {
+		col = p.state_critical
+	}
+	draw_text_c(v, pct_txt, x + card_w - 48, y, 15, col)
+
+	// the bar: 240 px, 10 px per 4 pct (chunky segments, deterministic)
+	bar_x := x
+	bar_y := y + 22
+	bar_w := i32(240)
+	bar_h := i32(14)
+	rl.DrawRectangle(bar_x, bar_y, bar_w, bar_h, p.ink_soft)
+	fill := i32(health.meter_pct) * bar_w / 100
+	if fill > 0 {
+		rl.DrawRectangle(bar_x, bar_y, fill, bar_h, col)
+	}
+	rl.DrawRectangleLines(bar_x, bar_y, bar_w, bar_h, p.ink)
+
+	// the per-class chips: countdowns + the drain state. One line per class
+	// with an active grace or breach (class-id order — deterministic).
+	chip_x := x + bar_w + 14
+	chip_y := y + 4
+	hz := i32(max(1, cat.balance.logic_hz))
+	for c in 0..<len(health.grace) {
+		if c >= len(cat.packet_types) {
+			continue
+		}
+		pt := &cat.packet_types[c]
+		chip := ""
+		chip_col := p.ink_soft
+		if health.grace[c].grace_left > 0 {
+			secs := i32(health.grace[c].grace_left) / hz
+			chip = fmt.aprintf("%s grace %ds", pt.display, secs, allocator = context.temp_allocator)
+			chip_col = p.state_strain
+		} else if c < len(health.breach) && health.breach[c] {
+			chip = fmt.aprintf("%s BREACHED", pt.display, allocator = context.temp_allocator)
+			chip_col = p.state_critical
+		} else {
+			continue // healthy + no countdown — no chip (zero extra pixels)
+		}
+		draw_text_c(v, chip, chip_x, chip_y, 12, chip_col)
+		chip_y += 15
+	}
+}
