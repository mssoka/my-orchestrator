+// --- the no-soft-lock property [FORGE #3] -------------------------------------
+
+@(test)
+test_health_no_soft_lock_property :: proc(t: ^testing.T) {
+	// FORGE #3's no-soft-lock guarantee, as a property: (a) EVERY adversarial
+	// fixture reaches terminal (Run_Lost) within a bounded horizon — a stuck
+	// network fills the pool, sheds (E22), the windowed loss breaches, the
+	// grace expires, and the meter drains; (b) recovery is possible until the
+	// meter is EMPTY (recoverable-until-empty — the escape always exists);
+	// (c) a healthy run with health on and no win condition NEVER goes
+	// terminal (no false loss).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	// (a) the adversarial sweep: narrow saturation across seeds. Bound:
+	// pool fill (512 / 2 per tick = 256) + breach detection (~30) + streaming
+	// grace (200) + drain at 2/tick (50) + slack -> 700.
+	horizon := u64(700)
+	seeds := []u64{42, 7, 999, 2026}
+	for seed in seeds {
+		s: Run_State
+		run_init(&s, seed, cat.hash, TEST_LOGIC_HZ)
+		s.era = 3
+		health_narrow_fixture(&s, cat)
+		s.health_enabled = true
+		step_n(&s, horizon, cat)
+		testing.expectf(t, s.terminal && s.outcome == .Lost,
+			"seed %d: the adversarial run must reach Run_Lost within %d ticks (no soft-lock)", seed, horizon)
+		testing.expectf(t, s.health.meter_pct == 0, "seed %d: the meter must be empty at the lose", seed)
+		run_destroy(&s)
+	}
+
+	// (b) recoverable-until-empty: saturate, fix LATE in the grace (the exit
+	// needs a full window slide, so the fix must land within ~250 ticks of the
+	// breach to beat the drain; at 231 the meter still drains after the ~404
+	// expiry — the escape exists while the meter is above 0) and the meter
+	// must climb back.
+	s2: Run_State
+	defer run_destroy(&s2)
+	run_init(&s2, 42, cat.hash, TEST_LOGIC_HZ)
+	s2.era = 3
+	health_narrow_fixture(&s2, cat)
+	s2.health_enabled = true
+	step_n(&s2, 230, cat) // in grace (breach ~5, expiry ~404) — the meter still 100
+	health_apply_fix(&s2, cat, 231)
+	step_n(&s2, 180, cat) // tick 410: the expiry fired, the meter is DRAINING (~88)
+	testing.expectf(t, !s2.terminal, "a mid-grace fix must not lose the run")
+	testing.expectf(t, s2.health.meter_pct > 0 && s2.health.meter_pct < 100,
+		"the meter must be mid-drain (recoverable), got %d", s2.health.meter_pct)
+	step_n(&s2, 400, cat) // the exit ~415, then recharge to full
+	testing.expectf(t, s2.health.meter_pct == 100,
+		"the meter must fully recover to 100, got %d", s2.health.meter_pct)
+
+	// (c) healthy + health on + no win condition: never terminal through the
+	// surge + margin (no false loss on a prepared network).
+	s3: Run_State
+	defer run_destroy(&s3)
+	run_init(&s3, 42, cat.hash, TEST_LOGIC_HZ)
+	s3.era = 3
+	crisis_catalog_mult2(cat, 0) // the prepared fan is sized for the mult2 surge
+	health_prepared_fixture(&s3, cat)
+	s3.health_enabled = true
+	// surge_win_pct left 0 — the win condition disabled
+	step_n(&s3, 3400, cat)
+	testing.expect(t, !s3.terminal, "a healthy prepared run must never go terminal")
+	testing.expectf(t, s3.health.meter_pct == 100, "the meter must stay full, got %d", s3.health.meter_pct)
+}
