+@(test)
+test_spawn_fx_feed_and_reveal_math :: proc(t: ^testing.T) {
+	cat: pp.Catalogs
+	sfx_load_cat(&cat, context.temp_allocator)
+	defer pp.catalogs_destroy(&cat)
+	interval := u64(cat.balance.terminal_spawn_interval_ticks)
+	s := sfx_run(&cat, interval) // t80: the first window landed — 1 event
+	defer pp.run_destroy(&s)
+
+	// the harness/app slice discipline: the events appended by THIS tick
+	before := len(s.events) - 1 // the last event is the t80 NODE_SPAWNED
+	_ = before
+	slice := s.events[before:]
+	v: View
+	v.catalogs = &cat
+	// a stale telegraph at the SAME tick must retarget onto the landed node
+	v.spawn_fx.telegraph = Spawn_Telegraph{pos = {0, 0}, spawn_tick = 80}
+	v.spawn_fx.telegraph_valid = true
+	spawn_fx_feed(&v, slice, &s.topology, 80)
+
+	testing.expectf(t, len(v.spawn_fx.reveals) == 1, "one NODE_SPAWNED -> one reveal, got %d", len(v.spawn_fx.reveals))
+	if len(v.spawn_fx.reveals) != 1 {
+		return
+	}
+	r := v.spawn_fx.reveals[0]
+	slot, ok := pp.node_slot(&s.topology, s.topology.next_node_id - 1)
+	testing.expectf(t, ok && r.node_id == s.topology.node_id[slot],
+		"the reveal must name the spawned node (got id %d)", r.node_id)
+	if ok {
+		testing.expectf(t, r.pos == s.topology.node_pos[slot], "the reveal must carry the node position")
+	}
+	testing.expectf(t, v.spawn_fx.telegraph.pos == r.pos && v.spawn_fx.telegraph.spawn_tick == 80,
+		"a same-tick telegraph must retarget onto the landed node")
+
+	// the reveal envelope: age 0 -> (0.4, 0.3); mid -> between; done -> none
+	sc, fa, okr := spawn_fx_reveal_transform(&v, r.node_id, 80)
+	testing.expectf(t, okr, "the reveal must be live at the growth tick")
+	testing.expectf(t, sc == 0.4 && fa == 0.3, "age 0: got scale %v fade %v want 0.4 0.3", sc, fa)
+	sc2, fa2, ok2 := spawn_fx_reveal_transform(&v, r.node_id, 80 + SPAWN_REVEAL_TICKS / 2)
+	testing.expectf(t, ok2 && sc2 > 0.4 && sc2 < 1.0 && fa2 > 0.3 && fa2 < 1.0,
+		"mid-reveal must interpolate: got %v %v", sc2, fa2)
+	sc3, fa3, ok3 := spawn_fx_reveal_transform(&v, r.node_id, 80 + SPAWN_REVEAL_TICKS)
+	testing.expectf(t, !ok3, "the reveal must expire at SPAWN_REVEAL_TICKS (got %v %v %v)", sc3, fa3, ok3)
+
+	// reduced-motion pins the reveal instant
+	v.reduced_motion = true
+	sc4, fa4, ok4 := spawn_fx_reveal_transform(&v, r.node_id, 80)
+	testing.expectf(t, !ok4, "reduced-motion reveals must draw normally (pinned instant): %v %v %v", sc4, fa4, ok4)
+}
