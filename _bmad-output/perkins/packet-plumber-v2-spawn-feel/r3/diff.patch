--- /dev/null
+++ b/app/render/spawn_fx.odin
@@ -0,0 +1,511 @@
+package render
+
+// spawn_fx.odin — v2-spawn-feel: the terminal-spawn telegraph + reveal
+// (the user's complaint #3: a terminal spawn is an INSTANT POP with zero
+// telegraph). Pure view-layer (ODN-1): nothing here writes sim state, and
+// nothing changes WHEN a spawned node becomes gameplay-valid — the growth
+// tick is untouched; the reveal is cosmetic timing only.
+//
+// Three moments, all tick-anchored (the §10.4 render-determinism rule — the
+// harness captures at exact ticks, so every animation below is a pure
+// function of (tick, effect state) and golden captures stay reproducible):
+//
+//   1. TELEGRAPH — a soft expanding ring at the NEXT spawn's position for
+//      the 10 ticks (0.5 s @ 20 Hz) BEFORE the node lands. The position is
+//      PREDICTED by running a SHADOW copy of the sim forward to the next
+//      growth window (the sim is fully deterministic + seed-derived, so the
+//      shadow's spawn is bit-exact — same state, same commands, same rng
+//      draws). Cause→effect: the player sees where the next terminal will
+//      appear before it pops.
+//   2. REVEAL — the new node's sprite scales 0.4→1.0 + fades in over 8
+//      ticks (0.4 s) from the growth tick; the ring bursts + fades out
+//      across the same window.
+//   3. PLACEMENT — the pipes near the new node pulse a brief highlight
+//      (4 ticks = 0.2 s): "this node just joined the network".
+//
+// Reduced-motion (E9.2) pins the effects to their most legible STATIC
+// reading (the pulse_read precedent): the ring draws at a fixed radius +
+// alpha, the reveal is instant (no scale/fade), the highlight is steady.
+//
+// The event stream is the reveal's authority (the app AND the harness feed
+// the same EVENT_TAG_NODE_SPAWNED slice per tick, so live + capture draw
+// the identical reveal at the identical tick). The telegraph is the
+// prediction's authority (the app predicts once per window — and re-predicts
+// when a player edit bumps the topology gen mid-window; the harness
+// re-predicts per capture — both are pure functions of the same state, so
+// they agree bit-for-bit).
+
+import pp "../../core"
+import rl "vendor:raylib"
+import "core:mem"
+
+// --- the animation timeline (ticks @ 20 Hz) --------------------------------
+// The 08-21 pace-tuning cadence is 80 ticks (4 s) per spawn window — the
+// telegraph lead + reveal are tuned for that read (steady streams are sparse
+// at 4 s, so the fatigue-variation from the briefing is moot; the constants
+// live here so a future cadence knob lands them in the same place).
+SPAWN_LEAD_TICKS  :: 10 // the telegraph appears 0.5 s before the node lands
+SPAWN_REVEAL_TICKS :: 8 // the sprite reveal runs 0.4 s from the growth tick
+SPAWN_HIGHLIGHT_TICKS :: 4 // the pipe highlight pulse (0.2 s — the MM moment)
+SPAWN_BURST_TICKS :: 8   // the ring's post-pop burst + fade (with the reveal)
+SPAWN_RING_SEGS :: 36    // the pinned annulus fan (10° steps, raylib's own)
+SPAWN_RING_W_TILES :: 0.16 // the ring stroke width in tiles
+SPAWN_HIGHLIGHT_RADIUS_TILES :: 8 // pipes within this of the new node pulse
+
+// SPAWN_RING_TABLE — the pinned unit-circle table (the LED-ring precedent:
+// §10.4 bans transcendentals in the rasterized path, so the annulus fan is
+// built from precomputed cos/sin at 10° steps — deterministic on every
+// platform, unlike libm's cosf). Generated offline; never hand-edit.
+SPAWN_RING_TABLE :: [SPAWN_RING_SEGS][2]f32{
+	{1.0000, 0.0000}, {0.9848, 0.1736}, {0.9397, 0.3420}, {0.8660, 0.5000}, {0.7660, 0.6428}, {0.6428, 0.7660}, {0.5000, 0.8660}, {0.3420, 0.9397}, {0.1736, 0.9848}, {0.0000, 1.0000}, {-0.1736, 0.9848}, {-0.3420, 0.9397}, {-0.5000, 0.8660}, {-0.6428, 0.7660}, {-0.7660, 0.6428}, {-0.8660, 0.5000}, {-0.9397, 0.3420}, {-0.9848, 0.1736}, {-1.0000, 0.0000}, {-0.9848, -0.1736}, {-0.9397, -0.3420}, {-0.8660, -0.5000}, {-0.7660, -0.6428}, {-0.6428, -0.7660}, {-0.5000, -0.8660}, {-0.3420, -0.9397}, {-0.1736, -0.9848}, {-0.0000, -1.0000}, {0.1736, -0.9848}, {0.3420, -0.9397}, {0.5000, -0.8660}, {0.6428, -0.7660}, {0.7660, -0.6428}, {0.8660, -0.5000}, {0.9397, -0.3420}, {0.9848, -0.1736},
+}
+
+// Spawn_Telegraph — the predicted next spawn (the pre-pop ring's anchor).
+// `spawn_tick` is the growth window the prediction was made for; the draw is
+// a pure function of (spawn_tick, tick), so the ring's timeline
+// [spawn_tick-LEAD, spawn_tick+BURST] never needs an explicit clear — it
+// expires by construction and a new prediction simply replaces it.
+Spawn_Telegraph :: struct {
+	pos:        [2]i32,
+	spawn_tick: u64,
+}
+
+// Spawn_Reveal — one landed terminal's reveal (fed from the NODE_SPAWNED
+// event stream; the node id resolves the sprite + the pipe highlight).
+Spawn_Reveal :: struct {
+	node_id:    u32,
+	pos:        [2]i32,
+	spawn_tick: u64,
+}
+
+// Spawn_FX — the View-owned presentation state (never serialized; reset per
+// run — node ids recycle across runs, ODN-13 freshness).
+Spawn_FX :: struct {
+	telegraph:        Spawn_Telegraph,
+	telegraph_valid:  bool,
+	reveals:          [dynamic]Spawn_Reveal,
+	// the prediction dedup (app-side; the harness forces per-capture):
+	predicted_window: u64, // the growth window the current telegraph is for
+	predicted_gen:    u32, // the topology gen the prediction was made at
+}
+
+spawn_fx_init :: proc(fx: ^Spawn_FX, allocator := context.allocator) {
+	fx^ = {}
+	fx.reveals = make([dynamic]Spawn_Reveal, 0, 4, allocator)
+}
+
+spawn_fx_destroy :: proc(fx: ^Spawn_FX) {
+	delete(fx.reveals)
+	fx^ = {}
+}
+
+// spawn_fx_reset — a fresh run: drop every effect + the prediction dedup
+// (node ids recycle; a stale telegraph would announce a spawn that never
+// happens). The app calls it in start_run, the harness before each demo.
+spawn_fx_reset :: proc(fx: ^Spawn_FX) {
+	clear(&fx.reveals)
+	fx.telegraph_valid = false
+	fx.predicted_window = 0
+	fx.predicted_gen = 0
+}
+
+// spawn_fx_feed — consume this tick's event slice (the same slice the audio
+// consumer + the stats path read — the app never drains state.events, the
+// 4.2 tripwire). Each EVENT_TAG_NODE_SPAWNED appends a reveal for the node
+// the growth director just added. The event has ZERO payload (v2-sound), so
+// the node is identified from the topology: node ids are monotonic per run
+// (E11), so the newest spawns are next_node_id-1, -2, ... in event order.
+// A telegraph for THIS tick is retargeted to the landed node's actual
+// position (the reveal is authoritative; the prediction is exact in demos,
+// and a mid-window player edit can only ever move the ring, never the node).
+spawn_fx_feed :: proc(v: ^View, events: []pp.Event, topo: ^pp.Topology, tick: u64) {
+	fx := &v.spawn_fx
+	n_spawns: u32 = 0
+	for e in events {
+		if e.tag == pp.EVENT_TAG_NODE_SPAWNED {
+			n_spawns += 1
+		}
+	}
+	if n_spawns == 0 {
+		return
+	}
+	// newest-first walk-back: the LAST spawn event in the slice is the newest
+	// node (next_node_id-1); earlier ones walk back through the ids.
+	remaining := n_spawns
+	for e in events {
+		if e.tag != pp.EVENT_TAG_NODE_SPAWNED {
+			continue
+		}
+		id := topo.next_node_id - remaining
+		remaining -= 1
+		slot, ok := pp.node_slot(topo, id)
+		if !ok {
+			continue // defensive — the spawn is live by construction
+		}
+		pos := topo.node_pos[slot]
+		append(&fx.reveals, Spawn_Reveal{node_id = id, pos = pos, spawn_tick = e.tick})
+		if fx.telegraph_valid && fx.telegraph.spawn_tick == e.tick {
+			fx.telegraph.pos = pos // the event is the authority at the pop
+		}
+	}
+	// bounded: a reveal window is 8 ticks; the 4 s cadence keeps ≤ 2 live.
+	// A pause/catch-up burst must never grow the buffer unbounded.
+	for len(fx.reveals) > 4 {
+		ordered_remove(&fx.reveals, 0)
+	}
+}
+
+// --- the shadow sim (the telegraph's predictor) ----------------------------
+// The sim is fully deterministic (seed-derived; the rng draws come only from
+// flow + growth), so the spawn at the NEXT growth window is a pure function
+// of (state at tick, the commands applied between tick and the window). The
+// shadow is a deep copy of Run_State stepped FORWARD with the same commands
+// the live sim will apply — the predicted position is bit-exact. The shadow
+// never touches the live state (ODN-1); it is a view-layer read.
+
+// shadow_clone — deep-copy a Run_State (everything step() touches: topology,
+// routing, bundles, flow, crisis, health, era gate, rng + scalars). The
+// action_log + event buffer are SKIPPED: the shadow steps with an explicit
+// pending-command slice (caller-provided), and no system READS the event
+// buffer (it is drain-only — the 4.2 tripwire), so the shadow's empty buffer
+// cannot diverge the sim. destroy via pp.run_destroy (zero action_log/events
+// delete safely).
+shadow_clone :: proc(src: ^pp.Run_State, allocator := context.allocator) -> pp.Run_State {
+	clone := src^ // scalars + rng + the struct shells (data pointers STALE)
+	clone.action_log = {}
+	clone.events = {}
+	c := &clone
+	t := &src.topology
+	// NOTE: make([dynamic]T, n, n) zero-inits; mem.copy then fills the data.
+	c.topology.node_alive = clone_dyn(t.node_alive, allocator)
+	c.topology.node_id = clone_dyn(t.node_id, allocator)
+	c.topology.node_kind = clone_dyn(t.node_kind, allocator)
+	c.topology.node_role = clone_dyn(t.node_role, allocator)
+	c.topology.node_type = clone_dyn(t.node_type, allocator)
+	c.topology.node_pos = clone_dyn(t.node_pos, allocator)
+	c.topology.pipe_alive = clone_dyn(t.pipe_alive, allocator)
+	c.topology.pipe_id = clone_dyn(t.pipe_id, allocator)
+	c.topology.pipe_a = clone_dyn(t.pipe_a, allocator)
+	c.topology.pipe_b = clone_dyn(t.pipe_b, allocator)
+	c.topology.pipe_tier = clone_dyn(t.pipe_tier, allocator)
+	c.topology.pipe_span = clone_dyn(t.pipe_span, allocator)
+	c.topology.pipe_weights = clone_dyn(t.pipe_weights, allocator)
+	c.topology.pipe_lane_over = clone_dyn(t.pipe_lane_over, allocator)
+	r := &src.routing
+	c.routing.hop_offset = clone_dyn(r.hop_offset, allocator)
+	c.routing.hop_count = clone_dyn(r.hop_count, allocator)
+	c.routing.hops = clone_dyn(r.hops, allocator)
+	b := &src.bundles
+	c.bundles.pipe_bundle = clone_dyn(b.pipe_bundle, allocator)
+	c.bundles.bundle_lo = clone_dyn(b.bundle_lo, allocator)
+	c.bundles.bundle_hi = clone_dyn(b.bundle_hi, allocator)
+	c.bundles.bundle_cap = clone_dyn(b.bundle_cap, allocator)
+	c.bundles.bundle_count = clone_dyn(b.bundle_count, allocator)
+	c.bundles.bundle_tier = clone_dyn(b.bundle_tier, allocator)
+	f := &src.flow
+	c.flow.packets = clone_dyn(f.packets, allocator)
+	c.flow.demand = clone_dyn(f.demand, allocator)
+	c.flow.sla = clone_dyn(f.sla, allocator)
+	c.flow.sla_breach = clone_dyn(f.sla_breach, allocator)
+	c.flow.lane_caps = clone_dyn(f.lane_caps, allocator)
+	c.flow.spawn_credit_milli = clone_dyn(f.spawn_credit_milli, allocator)
+	c.flow.drop_sites = clone_dyn(f.drop_sites, allocator)
+	cr := &src.crisis
+	c.crisis.node_congestion = clone_dyn(cr.node_congestion, allocator)
+	c.crisis.pipe_congestion = clone_dyn(cr.pipe_congestion, allocator)
+	c.crisis.forecast = clone_dyn(cr.forecast, allocator)
+	c.crisis.active = clone_dyn(cr.active, allocator)
+	c.crisis.cooldowns = clone_dyn(cr.cooldowns, allocator)
+	c.crisis.node_health = clone_dyn(cr.node_health, allocator)
+	h := &src.health
+	c.health.breach = clone_dyn(h.breach, allocator)
+	c.health.grace = clone_dyn(h.grace, allocator)
+	c.health.prev_delivered = clone_dyn(h.prev_delivered, allocator)
+	c.health.prev_dropped = clone_dyn(h.prev_dropped, allocator)
+	c.health.prev_latency = clone_dyn(h.prev_latency, allocator)
+	c.health.win_delivered = clone_dyn(h.win_delivered, allocator)
+	c.health.win_dropped = clone_dyn(h.win_dropped, allocator)
+	c.health.win_latency = clone_dyn(h.win_latency, allocator)
+	c.health.ring = clone_dyn(h.ring, allocator)
+	g := &src.era_gate
+	c.era_gate.ring = clone_dyn(g.ring, allocator)
+	c.era_gate.win_delivered = clone_dyn(g.win_delivered, allocator)
+	c.era_gate.win_dropped = clone_dyn(g.win_dropped, allocator)
+	c.era_gate.prev_delivered = clone_dyn(g.prev_delivered, allocator)
+	c.era_gate.prev_dropped = clone_dyn(g.prev_dropped, allocator)
+	return clone
+}
+
+// clone_dyn — deep-copy a [dynamic]T (data + length; same capacity).
+clone_dyn :: proc(src: [dynamic]$T, allocator := context.allocator) -> [dynamic]T {
+	out := make([dynamic]T, len(src), len(src), allocator)
+	if len(src) > 0 {
+		mem.copy(raw_data(out), raw_data(src), len(src) * size_of(T))
+	}
+	return out
+}
+
+// spawn_fx_predict — predict the next growth-window spawn by stepping a
+// shadow copy of the live state to the window. `pending` is the command
+// slice the shadow applies at its apply_tick (the harness passes the demo's
+// action_log — the live sim applies those inside step; the APP passes {} —
+// its fast-path edits are already inside the cloned topology). `force`
+// bypasses the dedup (the harness re-predicts per capture; the app predicts
+// once per window + on topology-gen change, so mid-window player edits
+// retarget the ring within a frame).
+//
+// Exactness: the shadow replays the identical rng draws (flow + growth are
+// the only rng consumers), so with no state divergence the predicted
+// position IS the spawn position. Deterministic in both callers: same state
+// + same pending slice -> the same telegraph (the harness goldens and the
+// live app agree bit-for-bit).
+spawn_fx_predict :: proc(v: ^View, state: ^pp.Run_State, cat: ^pp.Catalogs, tick: u64, pending: []pp.Command, force: bool) {
+	fx := &v.spawn_fx
+	interval := cat.balance.terminal_spawn_interval_ticks
+	if interval <= 0 {
+		fx.telegraph_valid = false
+		return
+	}
+	// the next growth window STRICTLY after this tick (the step at `tick`
+	// already ran — a tick % interval == 0 window has already landed).
+	window := tick + u64(interval) - (tick % u64(interval))
+	lead := window - tick
+	if lead > SPAWN_LEAD_TICKS {
+		// outside the telegraph window — a stale telegraph (a spawn whose
+		// reveal finished) just stays until its timeline expires; nothing to
+		// do. The dedup resets so the next window re-predicts.
+		if fx.predicted_window == window {
+			fx.predicted_window = 0
+		}
+		return
+	}
+	if !force && fx.predicted_window == window && fx.predicted_gen == state.topology.gen {
+		return // already predicted for this window + topology
+	}
+	fx.predicted_window = window
+	fx.predicted_gen = state.topology.gen
+
+	shadow := shadow_clone(state, context.temp_allocator)
+	defer pp.run_destroy(&shadow)
+	nodes_before := shadow.topology.next_node_id
+	for tt in tick + 1 ..= window {
+		batch := make([dynamic]pp.Command, 0, 4, context.temp_allocator)
+		for cmd in pending {
+			if cmd.apply_tick == tt {
+				append(&batch, cmd)
+			}
+		}
+		pp.step(&shadow, tt, batch[:], cat)
+	}
+	if shadow.topology.next_node_id > nodes_before {
+		// exactly one spawn per window by construction (the growth branch
+		// applies one node per window; the same-tick re-step guard is
+		// irrelevant here — the shadow steps strictly forward).
+		new_id := shadow.topology.next_node_id - 1
+		if slot, ok := pp.node_slot(&shadow.topology, new_id); ok {
+			fx.telegraph = Spawn_Telegraph{pos = shadow.topology.node_pos[slot], spawn_tick = window}
+			fx.telegraph_valid = true
+			return
+		}
+	}
+	// no spawn this window (rejection budget / era gate / no mesh) — the
+	// honest negative: no ring for a spawn that will not come.
+	fx.telegraph_valid = false
+}
+
+// --- drawing ---------------------------------------------------------------
+
+// spawn_fx_draw_telegraph — the expanding ring, drawn UNDER the pipes/nodes
+// (announced before the node lands; the burst + fade carries the pop). A
+// filled annulus (the pinned-table triangle fan) — the rlsw software
+// renderer alpha-blends FILLS only (line alpha is ignored), so the ring's
+// soft fade survives the golden captures. Reduced-motion pins a static
+// mid-radius ring (the pulse_read precedent — presence, not motion).
+spawn_fx_draw_telegraph :: proc(v: ^View, tick: u64) {
+	fx := &v.spawn_fx
+	if !fx.telegraph_valid {
+		return
+	}
+	T := fx.telegraph.spawn_tick
+	if tick < T - SPAWN_LEAD_TICKS || tick > T + SPAWN_BURST_TICKS {
+		return // the timeline expires by construction — no explicit clear
+	}
+	age := i64(tick) - i64(T - SPAWN_LEAD_TICKS)
+	s := v.tile_px * v.scale
+	c := node_screen(v, fx.telegraph.pos)
+	if v.reduced_motion {
+		// pinned presence: a static mid-radius ring at a fixed soft alpha
+		draw_ring_annulus(v, c, (1.0 - SPAWN_RING_W_TILES * 0.5) * s, 1.0 * s, {255, 255, 255, 140})
+		return
+	}
+	pre := f32(SPAWN_LEAD_TICKS)
+	burst := f32(SPAWN_BURST_TICKS)
+	r: f32
+	alpha: f32
+	if age <= SPAWN_LEAD_TICKS {
+		k := f32(age) / pre
+		e := smoothstep01(k)
+		r = (0.35 + 0.75 * e) * s
+		alpha = 0.30 + 0.35 * e
+		// the brief "ping" — a soft fill at the ring's birth (2 ticks)
+		if age <= 2 {
+			rl.DrawCircleV(c, r, {255, 255, 255, 26})
+		}
+	} else {
+		k := f32(age - SPAWN_LEAD_TICKS) / burst
+		r = (1.10 + 0.45 * k) * s
+		alpha = 0.65 * (1.0 - k)
+	}
+	if alpha <= 0.01 {
+		return
+	}
+	// the ring: a soft white annulus (reads on the cream canvas) with a faint
+	// ink under-stroke for contrast. Two stacked annuli = the stroke.
+	wa := u8(alpha * 255)
+	ink := v.palette.ink_soft
+	ink.a = u8(alpha * 0.55 * 255)
+	outer := r + SPAWN_RING_W_TILES * s * 0.5
+	inner := r - SPAWN_RING_W_TILES * s * 0.5
+	draw_ring_annulus(v, c, inner, outer, {255, 255, 255, wa})
+	draw_ring_annulus(v, c, outer, outer + SPAWN_RING_W_TILES * s * 0.55, ink)
+}
+
+// draw_ring_annulus — a filled ring segment between inner/outer radii at
+// screen pos `c`, built from the pinned SPAWN_RING_TABLE (two triangles per
+// segment — a quad fan; RL_TRIANGLES fills alpha-blend in the rlsw software
+// renderer, unlike line alpha). Deterministic: no transcendentals, fixed
+// 36-segment geometry at every scale (the health-ring stroke precedent).
+draw_ring_annulus :: proc(v: ^View, c: rl.Vector2, r_in, r_out: f32, col: rl.Color) {
+	if r_out <= 0 || r_in < 0 || col.a == 0 {
+		return
+	}
+	for i in 0 ..< SPAWN_RING_SEGS {
+		j := (i + 1) % SPAWN_RING_SEGS
+		table := SPAWN_RING_TABLE // local copy — a constant can't be indexed by a runtime index
+		a1 := table[i]
+		a2 := table[j]
+		p1o := rl.Vector2{c.x + a1[0] * r_out, c.y + a1[1] * r_out}
+		p2o := rl.Vector2{c.x + a2[0] * r_out, c.y + a2[1] * r_out}
+		p1i := rl.Vector2{c.x + a1[0] * r_in, c.y + a1[1] * r_in}
+		p2i := rl.Vector2{c.x + a2[0] * r_in, c.y + a2[1] * r_in}
+		// CCW winding in screen space (rlgl culls BACK faces with front = CCW
+		// — the CW order culled BOTH the rlsw capture AND the GPU app; the
+		// sprite quads render because their winding is CCW). tri 1: p1o,
+		// p1i, p2o — tri 2: p2o, p1i, p2i
+		rl.DrawTriangle(p1o, p1i, p2o, col)
+		rl.DrawTriangle(p2o, p1i, p2i, col)
+	}
+}
+
+// spawn_fx_reveal_transform — the (scale, fade) for a node id at `tick`
+// (ok=false = no live reveal — draw normally). Scale 0.4→1.0 + fade 0.3→1
+// over SPAWN_REVEAL_TICKS from the growth tick (smoothstep — the reveal is
+// a moment, not a cutscene). Reduced-motion pins (1, 1): the node pops in
+// (the a11y-correct reading — motion off means instant presence, the
+// telegraph ring still announces the moment).
+spawn_fx_reveal_transform :: proc(v: ^View, node_id: u32, tick: u64) -> (scale, fade: f32, ok: bool) {
+	if v.reduced_motion {
+		return 1, 1, false
+	}
+	for r in v.spawn_fx.reveals {
+		if r.node_id != node_id {
+			continue
+		}
+		if tick < r.spawn_tick || tick >= r.spawn_tick + SPAWN_REVEAL_TICKS {
+			continue
+		}
+		k := f32(tick - r.spawn_tick) / f32(SPAWN_REVEAL_TICKS)
+		e := smoothstep01(k)
+		return 0.4 + 0.6 * e, 0.3 + 0.7 * e, true
+	}
+	return 1, 1, false
+}
+
+// spawn_fx_draw_highlight — the placement feedback: pipes within
+// SPAWN_HIGHLIGHT_RADIUS_TILES of a revealing node pulse a translucent glow
+// band over the bundle (the route-glow color — the same positive-feedback
+// token the R3 post-draw glow uses; "this node just joined the network").
+// Drawn after draw_bundles (over the pipes), before the nodes. FILLS ONLY
+// (the rlsw line-alpha trap: a translucent DrawLineEx would capture solid —
+// the band is a quad pair + round caps, alpha-blending like the ring
+// annulus). The normal math is the draw_path_offset_band precedent
+// (Vector2Length + divide — deterministic IEEE, already in the raster path).
+// Reduced-motion pins the steady band.
+spawn_fx_draw_highlight :: proc(v: ^View, topo: ^pp.Topology, tick: u64) {
+	if v.reduced_motion {
+		return
+	}
+	p := v.palette
+	col := p.route_glow
+	for r in v.spawn_fx.reveals {
+		if tick < r.spawn_tick || tick >= r.spawn_tick + SPAWN_HIGHLIGHT_TICKS {
+			continue
+		}
+		k := f32(tick - r.spawn_tick) / f32(SPAWN_HIGHLIGHT_TICKS)
+		a := u8(f32(col.a) * (1.0 - k))
+		if a == 0 {
+			continue
+		}
+		// the estate radius (growth_groups.radius_tiles = 5) + a margin: the
+		// new node's own neighborhood — the pipes it just joined. TILE units
+		// on both sides (mid/r.pos are tile coords — a *tile_px here would
+		// compare tile-distance² against (8×26)² px² and exclude NOTHING on a
+		// 40×30 map; Perkins r1 B1).
+		rad := f32(SPAWN_HIGHLIGHT_RADIUS_TILES)
+		for ps in 0 ..< len(topo.pipe_alive) {
+			if !topo.pipe_alive[ps] {
+				continue
+			}
+			sa, oka := pp.node_slot(topo, topo.pipe_a[ps])
+			sb, okb := pp.node_slot(topo, topo.pipe_b[ps])
+			if !oka || !okb {
+				continue
+			}
+			ma := topo.node_pos[sa]
+			mb := topo.node_pos[sb]
+			mid := [2]i32{(ma[0] + mb[0]) / 2, (ma[1] + mb[1]) / 2}
+			dx := f32(mid[0]) - f32(r.pos[0])
+			dy := f32(mid[1]) - f32(r.pos[1])
+			if dx * dx + dy * dy > rad * rad {
+				continue
+			}
+			a_ := node_screen(v, ma)
+			b_ := node_screen(v, mb)
+			d := b_ - a_
+			l := rl.Vector2Length(d)
+			if l <= 0.0001 {
+				continue
+			}
+			nx, ny := -d.y / l, d.x / l
+			hw := 3.5 * v.scale // half the band width (7 px at scale 1)
+			hc := col
+			hc.a = a
+			// the quad: a±n -> b±n (two triangles, CCW in screen space — the
+			// rlgl backface-culling convention; the CW order would cull both
+			// the rlsw capture AND the GPU app). Round caps via fills.
+			q1 := rl.Vector2{a_.x + nx * hw, a_.y + ny * hw}
+			q2 := rl.Vector2{a_.x - nx * hw, a_.y - ny * hw}
+			q3 := rl.Vector2{b_.x - nx * hw, b_.y - ny * hw}
+			q4 := rl.Vector2{b_.x + nx * hw, b_.y + ny * hw}
+			rl.DrawTriangle(q1, q4, q3, hc)
+			rl.DrawTriangle(q1, q3, q2, hc)
+			rl.DrawCircleV(a_, hw, hc)
+			rl.DrawCircleV(b_, hw, hc)
+		}
+	}
+}
+
+// smoothstep01 — the only easing in the spawn-fx path: pure float ops (no
+// transcendentals — §10.4), deterministic IEEE math on every platform.
+smoothstep01 :: proc(k: f32) -> f32 {
+	if k <= 0 { return 0 }
+	if k >= 1 { return 1 }
+	return k * k * (3.0 - 2.0 * k)
+}
+
+// clamp01 — the shared alpha/scale clamp (spawn-fx + the wash/chip fade).
+clamp01 :: proc(x: f32) -> f32 {
+	if x < 0 { return 0 }
+	if x > 1 { return 1 }
+	return x
+}
