+	// a same-state second predict must be a no-op (the app calls per frame)
+	spawn_fx_predict(&v, &s, &cat, 76, {}, false)
+	testing.expectf(t, v.spawn_fx.telegraph.pos == first.pos && v.spawn_fx.telegraph.spawn_tick == first.spawn_tick,
+		"the dedup must keep the first prediction stable across frames")
