+@(test)
+test_spawn_fx_predict_pending_commands :: proc(t: ^testing.T) {
+	cat: pp.Catalogs
+	sfx_load_cat(&cat, context.temp_allocator)
+	defer pp.catalogs_destroy(&cat)
+	// Perkins r1 B2: the original fixture DRAW 0->3 spans 25 tiles > the
+	// standard tier's max_span 14, so it was REJECTED on both sides and the
+	// pin was a tautology. The pending command is now a ROUTER PLACE at t77
+	// (the harness's `place` directive path) at (13,6): legal (4.12 from the
+	// fixture router, 5/4.12 from the terminals — past the 4/2 separation
+	// split) and it BLOCKS the no-pending spawn [10,6] (3 tiles away —
+	// inside the E31 4-tile node-separation floor), so the window must land
+	// elsewhere — the anti-vacuity assert below (P1 != P0) pins that the
+	// shadow really consumed the pending slice.
+	rt_idx, _ := pp.node_type_index(&cat, "router_basic")
+	pending := []pp.Command{{kind = pp.Cmd_Place_Router{type_idx = rt_idx, pos = {13, 6}}, apply_tick = 77}}
+	s := sfx_run(&cat, 75)
+	defer pp.run_destroy(&s)
+
+	// the live path: apply the place at t77 exactly like the harness does
+	// (the command batch rides step's validate-then-apply loop)
+	pp.step(&s, 76, {}, &cat)
+	pp.step(&s, 77, pending, &cat)
+	pp.step(&s, 78, {}, &cat)
+	pp.step(&s, 79, {}, &cat)
+	pp.step(&s, 80, {}, &cat)
+	// the pending place must have MATERIALIZED (legal = a rejected command
+	// would make this whole test vacuous) and must not latch the critical
+	// replay flag
+	testing.expectf(t, sfx_count_junctions(&s.topology) == 3,
+		"the in-separation router place must materialize (got %d junctions want 3)", sfx_count_junctions(&s.topology))
+	testing.expect(t, !s.replay_error, "a legal pending command must not latch replay_error")
+	slot, ok := pp.node_slot(&s.topology, s.topology.next_node_id - 1)
+	testing.expectf(t, ok, "the live sim must have spawned at t80")
+	if !ok {
+		return
+	}
+	actual := s.topology.node_pos[slot]
+
+	// the shadow path: predict from t75 WITH the pending slice
+	s2 := sfx_run(&cat, 75)
+	defer pp.run_destroy(&s2)
+	v: View
+	v.catalogs = &cat
+	spawn_fx_predict(&v, &s2, &cat, 75, pending, true)
+	testing.expectf(t, v.spawn_fx.telegraph_valid, "the t80 window is 5 ticks out - a telegraph must be predicted")
+	if v.spawn_fx.telegraph_valid {
+		testing.expectf(t, v.spawn_fx.telegraph.pos == actual,
+			"the pending place must move the prediction exactly like the live sim: got %v want %v",
+			v.spawn_fx.telegraph.pos, actual)
+	}
+
+	// ANTI-VACUITY: the same prediction WITHOUT the pending slice must land
+	// ELSEWHERE (the new junction re-anchors the candidate search) — if P0 ==
+	// P1, the shadow ignored the pending commands and the pin proves nothing.
+	s3 := sfx_run(&cat, 75)
+	defer pp.run_destroy(&s3)
+	v2: View
+	v2.catalogs = &cat
+	spawn_fx_predict(&v2, &s3, &cat, 75, {}, true)
+	testing.expectf(t, v2.spawn_fx.telegraph_valid, "the no-pending prediction must also be valid")
+	if v2.spawn_fx.telegraph_valid {
+		testing.expectf(t, v2.spawn_fx.telegraph.pos != v.spawn_fx.telegraph.pos,
+			"the pending place must CHANGE the prediction (got %v both ways - the shadow dropped the pending slice?)",
+			v.spawn_fx.telegraph.pos)
+	}
+
+	// the NEGATIVE leg (Perkins: "and/or cover the exceed case as a
+	// negative"): an OUT-OF-SEPARATION pending place (2 tiles from the
+	// fixture router - below the 4-tile router_router floor) is rejected by
+	// validate-then-apply on BOTH sides — no router appears and the
+	// prediction still matches the live sim (both saw the same rejection).
+	bad := []pp.Command{{kind = pp.Cmd_Place_Router{type_idx = rt_idx, pos = {13, 10}}, apply_tick = 77}}
+	s4 := sfx_run(&cat, 75)
+	defer pp.run_destroy(&s4)
+	pp.step(&s4, 76, {}, &cat)
+	pp.step(&s4, 77, bad, &cat)
+	pp.step(&s4, 78, {}, &cat)
+	pp.step(&s4, 79, {}, &cat)
+	pp.step(&s4, 80, {}, &cat)
+	testing.expectf(t, sfx_count_junctions(&s4.topology) == 2,
+		"the out-of-separation place (2 < 4) must NOT materialize (got %d junctions)", sfx_count_junctions(&s4.topology))
+	bslot, bok := pp.node_slot(&s4.topology, s4.topology.next_node_id - 1)
+	testing.expectf(t, bok, "the live sim must have spawned at t80 (rejected-place leg)")
+	s5 := sfx_run(&cat, 75)
+	defer pp.run_destroy(&s5)
+	v3: View
+	v3.catalogs = &cat
+	spawn_fx_predict(&v3, &s5, &cat, 75, bad, true)
+	testing.expectf(t, v3.spawn_fx.telegraph_valid, "the rejected-pending prediction must still be valid")
+	if v3.spawn_fx.telegraph_valid && bok {
+		testing.expectf(t, v3.spawn_fx.telegraph.pos == s4.topology.node_pos[bslot],
+			"a REJECTED pending place must still predict the live spawn (got %v want %v - the shadow diverged on the rejection)",
+			v3.spawn_fx.telegraph.pos, s4.topology.node_pos[bslot])
+	}
+}
