+@(test)
+test_spawn_fx_feed_multiple_events_walkback :: proc(t: ^testing.T) {
+	cat: pp.Catalogs
+	sfx_load_cat(&cat, context.temp_allocator)
+	defer pp.catalogs_destroy(&cat)
+	// two NODE_SPAWNED in one slice (a pause catch-up): the slice order is
+	// tick order, so the OLDER spawn must map to the LOWER id. Fabricate the
+	// slice by appending two events with the topology pre-grown by one node.
+	s: pp.Run_State
+	pp.run_init(&s, 42, cat.hash, cat.balance.logic_hz)
+	defer pp.run_destroy(&s)
+	sfx_fixture(&s, &cat)
+	rt, _ := pp.node_type_index(&cat, "router_basic")
+	res, _ := pp.node_type_index(&cat, "residential")
+	pp.topology_spawn_node(&s.topology, rt, {20, 15}, &cat) // id 4 — the OLDER spawn
+	pp.topology_spawn_node(&s.topology, res, {24, 15}, &cat) // id 5 — the newer
+	append(&s.events, pp.Event{tick = 80, tag = pp.EVENT_TAG_NODE_SPAWNED})
+	append(&s.events, pp.Event{tick = 160, tag = pp.EVENT_TAG_NODE_SPAWNED})
+
+	v: View
+	v.catalogs = &cat
+	spawn_fx_feed(&v, s.events[:], &s.topology, 160)
+	testing.expectf(t, len(v.spawn_fx.reveals) == 2, "two events -> two reveals, got %d", len(v.spawn_fx.reveals))
+	if len(v.spawn_fx.reveals) != 2 {
+		return
+	}
+	// event order preserved: reveals[0] = the OLDER (id 4), reveals[1] = id 5
+	testing.expectf(t, v.spawn_fx.reveals[0].node_id == 4 && v.spawn_fx.reveals[1].node_id == 5,
+		"walk-back order: got %d, %d want 4, 5", v.spawn_fx.reveals[0].node_id, v.spawn_fx.reveals[1].node_id)
+	testing.expectf(t, v.spawn_fx.reveals[0].pos == [2]i32{20, 15} && v.spawn_fx.reveals[1].pos == [2]i32{24, 15},
+		"positions: got %v %v", v.spawn_fx.reveals[0].pos, v.spawn_fx.reveals[1].pos)
+}
+
+@(test)
+test_spawn_fx_predict_dedup :: proc(t: ^testing.T) {
+	cat: pp.Catalogs
