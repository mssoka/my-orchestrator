+package render
+
+// spawn_fx_test.odin — v2-spawn-feel's durable pins (the briefing's
+// load-bearing guards):
+//
+//   (a) SHADOW EXACTNESS — the clone round-trips the sim: clone(step(N)) hashes
+//       identically to the live state, and stepping both forward with the same
+//       commands keeps them hash-identical (the prediction is only as good as
+//       the clone — a missed field silently drifts the telegraph).
+//   (b) PREDICT EXACTNESS — at T-5 the predicted spawn position equals the
+//       node the real sim actually spawns at the window T (same seed, same
+//       state — the shadow replays the identical rng draws).
+//   (c) the honest negatives — no telegraph outside the lead window, with
+//       growth off, or when the window's plan rejects (no spawn).
+//   (d) FEED — NODE_SPAWNED events append the reveal for the right node id +
+//       position, and retarget a same-tick telegraph onto the landed node.
+//   (e) REVEAL MATH — the (scale, fade) envelope is a pure function of age
+//       (0.4/0.3 at the growth tick -> 1/1 at SPAWN_REVEAL_TICKS), expired
+//       effects are invisible, reduced-motion pins (1, 1).
+//   (f) PENDING COMMANDS — the shadow applies the caller's pending slice at
+//       the apply ticks (the harness path — a demo draw between tick and the
+//       window must move the prediction exactly like the live sim).
+//
+// The catalog fixture is the REAL committed data (loaded from data/*.json —
+// the render test's cwd is the repo root, like the harness): a hand-rolled
+// catalog would silently omit a field the growth/flow path reads and bless a
+// divergent shadow.
+
+import "core:os"
+import "core:testing"
+import "core:fmt"
+import pp "../../core"
+
+// sfx_load_cat — load the committed catalogs (the app's load_catalogs path —
+// render tests can't import the app package, so this mirrors it).
+sfx_load_cat :: proc(cat: ^pp.Catalogs, allocator := context.allocator) {
+	src: pp.Catalog_Sources
+	defer {
+		delete(src.node_types)
+		delete(src.pipe_tiers)
+		delete(src.balance)
+		delete(src.packet_types)
+		delete(src.demand)
+		delete(src.eras)
+		delete(src.crises)
+	}
+	read1 :: proc(path: string) -> []u8 {
+		b, err := os.read_entire_file_from_path(path, context.allocator)
+		if err != nil {
+			fmt.eprintfln("sfx_test: cannot read %s", path)
+		}
+		return b
+	}
+	src.node_types = read1("data/node_types.json")
+	src.pipe_tiers = read1("data/pipe_tiers.json")
+	src.balance = read1("data/balance.json")
+	src.packet_types = read1("data/packet_types.json")
+	src.demand = read1("data/demand.json")
+	src.eras = read1("data/eras.json")
+	src.crises = read1("data/crises.json")
+	if e := pp.catalogs_load(cat, &src); e.file != "" {
+		fmt.eprintfln("sfx_test: catalog load failed: %s %s", e.file, e.rule)
+	}
+}
+
+// sfx_fixture — the growth.dem recipe's seed topology: the residential ←
+// router → content_host fixture + a player-placed router (the mesh growth
+// grows outward from) at the demo's exact spot. Era 1 + growth on.
+sfx_fixture :: proc(s: ^pp.Run_State, cat: ^pp.Catalogs) {
+	res, _ := pp.node_type_index(cat, "residential")
+	rt, _ := pp.node_type_index(cat, "router_basic")
+	host, _ := pp.node_type_index(cat, "content_host")
+	pp.topology_spawn_node(&s.topology, res, {10, 10}, cat)   // id 0
+	pp.topology_spawn_node(&s.topology, rt, {12, 10}, cat)    // id 1
+	pp.topology_spawn_node(&s.topology, host, {14, 10}, cat)  // id 2
+	placed := pp.topology_spawn_node(&s.topology, rt, {34, 15}, cat) // id 3
+	pp.topology_apply_edit(&s.topology, pp.Command{kind = pp.Cmd_Draw_Pipe{a = 1, b = placed, tier = 1}}, cat)
+	s.era = 1
+	s.growth_enabled = true
+}
+
+// sfx_run — a growth-enabled run stepped to `ticks` (the growth.dem recipe).
+sfx_run :: proc(cat: ^pp.Catalogs, ticks: u64) -> pp.Run_State {
+	s: pp.Run_State
+	pp.run_init(&s, 42, cat.hash, cat.balance.logic_hz)
+	sfx_fixture(&s, cat)
+	for t in u64(1) ..= ticks {
+		pp.step(&s, t, {}, cat)
+	}
+	return s
+}
+
+// sfx_count_junctions — the live junction count (the mesh the growth grows
+// from; the pending-place legs assert on it to prove materialization).
+sfx_count_junctions :: proc(topo: ^pp.Topology) -> int {
+	n := 0
+	for i in 0 ..< len(topo.node_alive) {
+		if topo.node_alive[i] && topo.node_kind[i] == .Junction {
+			n += 1
+		}
+	}
+	return n
+}
+
+// sfx_hash — the per-tick T1 derivation (the manifest hash — the same the
+// harness pins; no events in the shadow, so the empty slice).
+sfx_hash :: proc(s: ^pp.Run_State, cat: ^pp.Catalogs) -> u64 {
+	return pp.state_hash(s, {}, cat, context.temp_allocator)
+}
+
+@(test)
+test_spawn_fx_shadow_clone_round_trips :: proc(t: ^testing.T) {
+	cat: pp.Catalogs
+	sfx_load_cat(&cat, context.temp_allocator)
+	defer pp.catalogs_destroy(&cat)
+	s := sfx_run(&cat, 65) // t65: mid-window, live traffic + credits + SLA
+	defer pp.run_destroy(&s)
+
+	clone := shadow_clone(&s, context.temp_allocator)
+	defer pp.run_destroy(&clone)
+	testing.expectf(t, sfx_hash(&clone, &cat) == sfx_hash(&s, &cat),
+		"clone must hash-identical to the live state at clone time")
+
+	// step BOTH to t66 with the same (empty) command batch — identical draws
+	// -> identical rng -> identical hashes (a missed clone field diverges here)
+	pp.step(&s, 66, {}, &cat)
+	pp.step(&clone, 66, {}, &cat)
+	testing.expectf(t, sfx_hash(&clone, &cat) == sfx_hash(&s, &cat),
+		"clone+step must stay hash-identical to the live sim (a missed field in shadow_clone drifts the telegraph)")
+	testing.expect(t, !clone.replay_error, "the shadow must not latch replay_error")
+}
+
+@(test)
+test_spawn_fx_predict_matches_actual_spawn :: proc(t: ^testing.T) {
+	cat: pp.Catalogs
+	sfx_load_cat(&cat, context.temp_allocator)
+	defer pp.catalogs_destroy(&cat)
+	interval := u64(cat.balance.terminal_spawn_interval_ticks) // 80
+	s := sfx_run(&cat, interval - 5) // t75: 5 ticks before the t80 window
+	defer pp.run_destroy(&s)
+
+	v: View
+	v.catalogs = &cat
+	spawn_fx_predict(&v, &s, &cat, 75, {}, true)
+	testing.expectf(t, v.spawn_fx.telegraph_valid, "the t80 window is 5 ticks out - a telegraph must be predicted")
+	testing.expectf(t, v.spawn_fx.telegraph.spawn_tick == 80, "telegraph window: got %d want 80", v.spawn_fx.telegraph.spawn_tick)
+
+	// the ground truth: run the REAL sim to t80 and find the spawned node
+	pp.step(&s, 76, {}, &cat)
+	pp.step(&s, 77, {}, &cat)
