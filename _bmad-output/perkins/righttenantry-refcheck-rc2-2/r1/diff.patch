+// will hook the reference-check trigger onto this same apply_status_update
+// path; this test pins the plumbing the trigger depends on.
+// ============================================================================
+pub fn patch_status_to_viewed_writes_audit_row_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let assert Ok(app_id) =
+    test_db.seed_application_with_status(
+      db,
+      vacancy_id,
+      "viewed@example.com",
+      "shortlisted",
+    )
+
+  let req =
+    simulate.request(
+      http.Patch,
+      "/api/v1/vacancies/"
+        <> vacancy_id
+        <> "/applications/"
+        <> app_id
+        <> "/status",
+    )
+    |> simulate.json_body(json.object([#("status", json.string("viewed"))]))
+  let resp =
+    application_detail_handler.handle_update_status(
+      req,
+      test_server_config(db),
+      test_db.test_landlord(landlord_id),
+      vacancy_id,
+      app_id,
+    )
+
+  resp.status |> should.equal(200)
+  simulate.read_body(resp)
+  |> string.contains("\"status\":\"viewed\"")
+  |> should.be_true
+
+  let assert Ok(status_after) =
+    test_db.query_text(
+      db,
+      "SELECT status::text FROM application WHERE id = '" <> app_id <> "'::uuid",
+    )
+  status_after |> should.equal("viewed")
+
+  let assert Ok(audit_count) =
+    test_db.query_int(db, "SELECT count(*)::int FROM audit_log
+       WHERE event_type = 'status_changed'
+         AND entity_id = '" <> app_id <> "'::uuid")
+  audit_count |> should.equal(1)
+
+  // Postgres' jsonb::text serialiser emits a space after each colon
+  // (`"from": "shortlisted"`), so the assertions match that format.
+  let assert Ok(audit_details) =
+    test_db.query_text(db, "SELECT details::text FROM audit_log
+       WHERE event_type = 'status_changed'
+         AND entity_id = '" <> app_id <> "'::uuid")
+  string.contains(audit_details, "\"from\": \"shortlisted\"") |> should.be_true
+  string.contains(audit_details, "\"to\": \"viewed\"") |> should.be_true
+}
