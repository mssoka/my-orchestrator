diff --git a/shared/test/application_test.gleam b/shared/test/application_test.gleam
new file mode 100644
index 00000000..bce82aba
--- /dev/null
+++ b/shared/test/application_test.gleam
@@ -0,0 +1,54 @@
+//// Round-trip tests for the application_status shared codecs. The
+//// `every_status_*` tests enumerate ALL seven variants explicitly — adding
+//// a new variant without a matching encode/from_string/decoder arm fails
+//// here, the same net as error_code_test / reference_call_test. Pins the
+//// RC2.2 acceptance criterion that `Viewed` round-trips as `"viewed"`
+//// across shared, server, and client.
+
+import gleam/json
+import gleam/list
+import gleeunit/should
+import shared/application.{
+  type ApplicationStatus, Approved, AutoClosed, Rejected, Shortlisted, Submitted,
+  UnderReview, Viewed,
+}
+
+fn all_statuses() -> List(ApplicationStatus) {
+  [Submitted, UnderReview, Shortlisted, Viewed, Approved, Rejected, AutoClosed]
+}
+
+pub fn every_status_round_trips_test() {
+  list.each(all_statuses(), fn(status) {
+    status
+    |> application.encode_status
+    |> application.status_from_string
+    |> should.equal(status)
+  })
+}
+
+pub fn status_decoder_accepts_all_test() {
+  list.each(all_statuses(), fn(status) {
+    let encoded = json.string(application.encode_status(status))
+    let assert Ok(decoded) =
+      json.parse(json.to_string(encoded), application.status_decoder())
+    decoded |> should.equal(status)
+  })
+}
+
+pub fn status_decoder_rejects_unknown_test() {
+  json.parse("\"nonsense\"", application.status_decoder())
+  |> should.be_error
+}
+
+/// Guards the v1 contract count: seven application_status values once
+/// `viewed` (RC2.2 / A5) is added.
+pub fn contract_count_test() {
+  list.length(all_statuses()) |> should.equal(7)
+}
+
+/// Pins the RC2.2 wire string the server `parse_status` and the client
+/// stepper must agree on.
+pub fn viewed_wire_string_test() {
+  application.encode_status(Viewed) |> should.equal("viewed")
+  application.status_from_string("viewed") |> should.equal(Viewed)
+}
diff --git a/supabase/migrations/20260808120000_add_viewed_application_status.sql b/supabase/migrations/20260808120000_add_viewed_application_status.sql
new file mode 100644
index 00000000..3a8dae74
--- /dev/null
+++ b/supabase/migrations/20260808120000_add_viewed_application_status.sql
@@ -0,0 +1,16 @@
+-- Reference-Checking v1, Amendments register A5: the reference-check
+-- trigger moves from "shortlist" to "viewing". This adds the `viewed`
+-- application_status value, positioned AFTER `shortlisted`, so the
+-- application reflects where it really is once the landlord marks the
+-- viewing as carried out. RC2.3 fires reference_check creation on the
+-- transition INTO `viewed`; this migration only adds the enum value.
+--
+-- Add-only: no existing status value is renamed or removed. The
+-- `IF NOT EXISTS` guard makes the migration idempotent.
+--
+-- Postgres forbids referencing a newly-added enum value in the same
+-- transaction that added it, so no trigger function here casts to
+-- 'viewed' (the auto_closed two-migration split precedent). rc2-2 adds
+-- the value only; the viewed trigger logic lands in a later RC2.3
+-- migration once this one has committed.
+ALTER TYPE application_status ADD VALUE IF NOT EXISTS 'viewed' AFTER 'shortlisted';
