diff --git a/harness/dublin_shot.odin b/harness/dublin_shot.odin
new file mode 100644
index 00000000..98eede0e
--- /dev/null
+++ b/harness/dublin_shot.odin
@@ -0,0 +1,90 @@
+package main
+
+// dublin_shot.odin — v2-dublin-board: the KYLE-gate capture verb. Renders the
+// DUBLIN board underlay at the camera-fit zoom + a zoomed core close-up
+// (pure underlay — the gallery's exact framing: terrain/streets/candidates/
+// labels, no nodes/HUD) so the live board can be graded side-by-side against
+// the blessed #90 gallery previews (docs/captures/dublin-map-spike). The
+// in-game frame itself is proven by the dublin demo's T2 goldens (underlay +
+// nodes + pipes + HUD through the real draw_world path).
+//
+// Usage: harness dublin-shot [outdir]   (default bin/dublin-shot)
+//   writes <outdir>/baywide.png + <outdir>/templebar.png
+//
+// The zoomed capture drives the view transform directly (scale = fit ×
+// CAM_ZOOM_STEP^n, off centered on the world point) — the same f32 math the
+// camera derives (camera.odin), deterministic (the §10.4 rule).
+
+import "core:fmt"
+import "core:strings"
+import rl "vendor:raylib"
+import pp "../core"
+import rnd "../app/render"
+
+// dublin_shot_view — set the view transform for a zoom level: `zoom` = the
+// CAM_ZOOM_STEP^n multiplier (1.0 = fit; 3.2 ≈ 4 notches in), centered on
+// the world point `center_tx, center_ty` (tiles). Mirrors the camera's
+// derivation (screen = win/2 + (world - center) × fit × zoom).
+dublin_shot_view :: proc(v: ^rnd.View, zoom: f32, center_tx, center_ty: f32) {
+	v.scale = rnd.camera_fit(v) * zoom
+	cx := center_tx * v.tile_px
+	cy := center_ty * v.tile_px
+	v.off_x = (f32(v.win_w) - v.world_w * v.scale) / 2 - (cx - v.world_w / 2) * v.scale
+	v.off_y = (f32(v.win_h) - v.world_h * v.scale) / 2 - (cy - v.world_h / 2) * v.scale
+}
+
+// dublin_shot_capture — draw the current view + write the PNG (the rlsw
+// readback path: flip + swizzle — the T2 spine's normalization). The
+// topology is EMPTY (the pure-underlay framing — the board itself is the
+// subject, like the gallery previews).
+dublin_shot_capture :: proc(rc: ^Render_Ctx, state: ^pp.Run_State, out: string) {
+	rl.BeginDrawing()
+	rnd.draw_world(&rc.view, &state.topology, &state.bundles, &state.flow, &state.crisis, 0, {}, -1, -1, 42)
+	rl.EndDrawing()
+	img := rl.LoadImageFromScreen()
+	rl.ImageFlipVertical(&img)
+	swizzle_rb(&img)
+	cpath := strings.clone_to_cstring(out, context.temp_allocator)
+	if !rl.ExportImage(img, cpath) {
+		fmt.eprintfln("dublin-shot: failed to write %s", out)
+	}
+	rl.UnloadImage(img)
+}
+
+run_dublin_shot :: proc(outdir: string, cat: ^pp.Catalogs) -> int {
+	rl.SetTraceLogLevel(.ERROR)
+	rl.InitWindow(1280, 720, "pp-dublin-shot")
+	defer rl.CloseWindow()
+
+	rc: Render_Ctx
+	render_setup(&rc, cat)
+	bd, e := board_load(cat)
+	if e != "" {
+		fmt.eprintfln("dublin-shot: %s", e)
+		return 2
+	}
+	rc.view.map_source = u8(pp.Map_Source.Dublin)
+	rc.view.board = bd
+
+	state: pp.Run_State
+	defer pp.run_destroy(&state)
+	dublin_board_scene(&state, cat, 42)
+
+	// the fit view (the whole board — the gallery's baywide framing)
+	dublin_shot_view(&rc.view, 1.0, 20, 15)
+	dublin_shot_capture(&rc, &state, fmt.tprintf("%s/baywide.png", outdir))
+
+	// the city-core close-up (Temple Bar — the gallery's crop framing)
+	dublin_shot_view(&rc.view, 3.2, 17.9, 17.4)
+	dublin_shot_capture(&rc, &state, fmt.tprintf("%s/templebar.png", outdir))
+
+	fmt.printfln("dublin-shot: board captures written to %s/baywide.png + %s/templebar.png", outdir, outdir)
+	return 0
+}
+
+// dublin_board_scene — the bare board frame: an empty run at era 3 (the
+// underlay is the whole frame — zero nodes/pipes, like the preview renderer).
+dublin_board_scene :: proc(state: ^pp.Run_State, cat: ^pp.Catalogs, seed: u64) {
+	pp.run_init(state, seed, cat.hash, cat.balance.logic_hz)
+	state.era = 3
+}
