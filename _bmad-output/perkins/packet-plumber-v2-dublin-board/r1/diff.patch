+package core
+
+// map.odin — the map-source model (packet-plumber-v2-dublin-board, stage 1 of
+// the real-maps arc): the named determinism input `map` (procedural | dublin)
+// + the baked Dublin board (data/maps/dublin.json, merged in #90). The map
+// source is run setup like the seed — serialized into the T1 hash
+// (ABSENT-WHEN-procedural, so every legacy run stays byte-identical) and
+// re-created identically on replay from the demo/asset (the fixture
+// precedent). The BOARD is caller-owned data (loaded from bytes by the
+// app/harness — core does no file I/O, ODN-1), exactly like the catalogs.
+//
+// Streets do NOT constrain pipes in this story (stage 2): the board changes
+// WHERE growth spawns + what the view draws, never the placement rules. The
+// extract pipeline (tools/osm_extract.py) is untouched — this file is the
+// read side of the baked snapshot only.
+//
+// The 1-in-6 density (user ruling 2026-08-23, rulings.density_default in the
+// asset): the asset stores street-adjacent points at sub-tile resolution
+// (~0.02 tiles ≈ 14 m apart along streets); the user's blessed calm default
+// is the deterministic stride-6 subsample (spawn_candidates[::6] — the same
+// index set the preview tool renders at 1in6). At bake-LOAD the pool is
+// snapped to the integer tile grid + deduped (a spawn is a TILE, never a
+// sub-tile point) + out-of-grid tiles discarded — the "filter at bake-load"
+// of the briefing (rule 3): the pool only ever contains legal tiles; the E31
+// pairwise predicates (growth_pos_valid: grid bounds + min-separation from
+// nodes/pipe segments) still run at spawn time and can REJECT a pool tile —
+// the pool is a candidate set, never a guaranteed placement.
+//
+// District assignment (the estate anchors): each pool tile is assigned to its
+// NEAREST district anchor (Euclidean, tile units; ties to the lower district
+// index — deterministic, no map iteration, ODN-10). The growth_groups
+// estate machinery (cluster radius/caps) applies WITHIN districts on the
+// board: the ATTACH family draws from the anchor's OWN district's pool (an
+// estate never crosses a district boundary), and the derived cluster view is
+// unchanged (radius adjacency) — the district scoping at the DRAW makes
+// cross-district estates unreachable by construction. The exact interplay is
+// documented in growth.odin.
+
+import "core:encoding/json"
+import "core:fmt"
+import "core:math"
+
+// Map_Source — the named map input (run setup, serialized absent-when-0).
+Map_Source :: enum u8 {
+	// Procedural = 0 — the pre-board noise map (the zero value: every legacy
+	// run/demo/replay defaults here and stays byte-identical).
+	Procedural = 0,
+	// Dublin = 1 — the baked cross-section board (data/maps/dublin.json).
+	Dublin = 1,
+}
+
+// MAP_SPAWN_STRIDE — the 1-in-6 density stride over the asset's
+// spawn_candidates (the user's blessed calm default; the asset comment names
+// 1in3 = [::3] as the denser data option — the stride is a load-time
+// constant so the GAMEPLAY pool and the render dots can never disagree).
+MAP_SPAWN_STRIDE :: 6
+
+// District_Kind — the label tier of a Dublin district (mirrors the preview
+// tool's LABEL_PRIORITY: city > town > village > suburb > quarter ==
+// neighbourhood). Render-only (the sim reads only the anchor assignment).
+District_Kind :: enum u8 {
+	City = 0,
+	Town = 1,
+	Village = 2,
+	Suburb = 3,
+	Quarter = 4,
+	Neighbourhood = 5,
+}
+
+district_kind_rank :: proc(k: District_Kind) -> i32 {
+	#partial switch k {
+	case .City:          return 5
+	case .Town:          return 4
+	case .Village:       return 3
+	case .Suburb:        return 2
+	case .Quarter:       return 1
+	case .Neighbourhood: return 1
+	}
+	return 0
+}
+
+// Map_District — one baked district (a named anchor the user's gallery
+// labels). `pos` is in tile units (the baked center); `kind` drives label
+// priority/size; `name` is the render label text.
+Map_District :: struct {
+	name: string,
+	kind: District_Kind,
+	pos:  [2]f32, // tile units (the baked anchor)
+}
+
+// Map_Board — the parsed dublin.json asset. Loaded by the caller (app/
+// harness) from bytes via map_board_load; owned by the caller (run_destroy
+// never frees it — the board outlives any single run, like the catalogs).
+// The SIM reads only: w_tiles/h_tiles (validated == balance), the candidate
+// pool + per-district ranges + district anchors. The terrain/streets/
+// attribution fields are RENDER-ONLY (the view draws them; the sim never
+// reads a byte — growth touches only the pool).
+Map_Board :: struct {
+	w_tiles: i32,
+	h_tiles: i32,
+	// the 1-in-6 spawn pool: integer tile positions, snapped + deduped +
+	// grid-filtered at load (the briefing rule-3 "filter at bake-load").
+	candidates: [dynamic][2]i32,
+	// the 1-in-6 RENDER dots: the RAW sub-tile points (the blessed gallery's
+	// dotted-street texture — the dots sit at ~14 m spacing along streets, so
+	// they render as a dotted line, not individual buildings). The view draws
+	// these; the sim spawns from `candidates` (the snapped pool) — the two
+	// can never disagree (both derive from the same stride-6 subsample).
+	render_dots: [dynamic][2]f32,
+	// parallel to candidates: the tile's district index (nearest anchor).
+	candidate_district: [dynamic]u16,
+	// per-district candidate index runs — district d's pool is
+	// candidates[district_start[d]..district_start[d+1]) (flat, no map
+	// iteration — ODN-10). Length = len(districts) + 1.
+	district_start: [dynamic]u32,
+	// the district anchors (file order — deterministic; index = the u16
+	// above). `name` is a parse-time clone (owned, freed by map_board_destroy).
+	districts: [dynamic]Map_District,
+	// --- render-only underlay (the sim never reads these) ---
+	water:      [dynamic][dynamic][2]f32, // terrain polygons (tile units)
+	coast:      [dynamic][dynamic][2]f32,
+	park:       [dynamic][dynamic][2]f32,
+	arterial:   [dynamic][dynamic][2]f32, // street polylines (tile units)
+	local:      [dynamic][dynamic][2]f32,
+	attribution: string, // the ODbL credit line ("© OpenStreetMap contributors")
+}
+
+// map_board_destroy — free the board's owned buffers (the caller owns the
+// board value; call once when the process is done with it — the app frees at
+// exit, the harness's board cache lives for the process).
+map_board_destroy :: proc(b: ^Map_Board) {
+	for d in b.districts {
+		delete(d.name)
+	}
+	delete(b.districts)
+	delete(b.attribution)
+	delete(b.candidates)
+	delete(b.render_dots)
+	delete(b.candidate_district)
+	delete(b.district_start)
+	map_polys_destroy(&b.water)
+	map_polys_destroy(&b.coast)
+	map_polys_destroy(&b.park)
+	map_polys_destroy(&b.arterial)
+	map_polys_destroy(&b.local)
+}
+
+map_polys_destroy :: proc(polys: ^[dynamic][dynamic][2]f32) {
+	for p in polys {
+		delete(p)
+	}
+	delete(polys^)
+}
+
+// map_json_str — a required string field from a JSON object (fail loud).
+map_json_str :: proc(obj: json.Object, key: string) -> (string, bool) {
+	v, ok := obj[key].(json.String)
+	if !ok {
+		return "", false
+	}
+	return v, true
+}
+
+// map_json_f32_pair — a required [x, y] pair from a JSON array (fail loud).
+map_json_f32_pair :: proc(v: json.Value) -> ([2]f32, bool) {
+	arr, ok := v.(json.Array)
+	if !ok || len(arr) != 2 {
+		return {}, false
+	}
+	x, okx := arr[0].(json.Float)
+	y, oky := arr[1].(json.Float)
+	if !okx || !oky {
+		return {}, false
+	}
+	return {f32(x), f32(y)}, true
+}
+
+// map_ring_clean — dedupe consecutive duplicate points (OSM rings repeat the
+// closing/stitch vertex; an ear-clip triangulator needs a simple ring), drop
+// the closing repeat, and reject degenerate rings (< 3 points). Appends the
+// cleaned ring to `out` — OWNERSHIP TRANSFER: the appended dynamic array
+// shares `pts`'s backing store, so the success path never deletes it (the
+// failure paths delete explicitly — never free a store the board now owns).
+map_ring_clean :: proc(out: ^[dynamic][dynamic][2]f32, poly: json.Array, allocator := context.allocator) {
+	pts := make([dynamic][2]f32, 0, len(poly), allocator)
+	for v in poly {
+		p, ok := map_json_f32_pair(v)
+		if !ok {
+			delete(pts)
+			return // malformed — skip the ring (the asset is baked; defensive)
+		}
+		if len(pts) > 0 && pts[len(pts)-1] == p {
+			continue // consecutive duplicate (OSM stitch vertices)
+		}
+		append(&pts, p)
+	}
+	if len(pts) < 3 {
+		delete(pts)
+		return
+	}
+	// a ring's last point may repeat the first (closed rings) — drop it so
+	// the triangulator sees a simple open chain.
+	if pts[0] == pts[len(pts)-1] {
+		pop(&pts)
+	}
+	if len(pts) < 3 {
+		delete(pts)
+		return
+	}
+	append(out, pts)
+}
+
+// map_line_clean — a street polyline (NOT a ring): consecutive-duplicate
+// dedupe + the ≥2-point minimum. Same ownership rule as map_ring_clean.
+map_line_clean :: proc(out: ^[dynamic][dynamic][2]f32, line: json.Array, allocator := context.allocator) {
+	pts := make([dynamic][2]f32, 0, len(line), allocator)
+	for v in line {
+		p, ok := map_json_f32_pair(v)
+		if !ok {
+			delete(pts)
+			return
+		}
+		if len(pts) > 0 && pts[len(pts)-1] == p {
+			continue
+		}
+		append(&pts, p)
+	}
+	if len(pts) < 2 {
+		delete(pts)
+		return
+	}
+	append(out, pts)
+}
+
+// map_polys_load — parse a terrain (ring) list or a street (polyline) list.
+// `rings` selects the cleaning rule (terrain rings close; street polylines
+// are open chains — a 2-point street is legal).
+map_polys_load :: proc(out: ^[dynamic][dynamic][2]f32, v: json.Value, rings: bool, allocator := context.allocator) -> bool {
+	arr, ok := v.(json.Array)
+	if !ok {
+		return false
+	}
+	for poly in arr {
+		pa, okp := poly.(json.Array)
+		if !okp {
+			return false
+		}
+		if rings {
+			map_ring_clean(out, pa, allocator)
+		} else {
+			map_line_clean(out, pa, allocator)
+		}
+	}
+	return true
+}
+
+// map_board_load — parse + validate the baked dublin.json bytes into a
+// Map_Board. Fail-loud on any structural violation (the asset is committed +
+// extract-validated; a bad load is a broken tree, never a silent partial
+// board). `bal` pins the design-grid contract: the board dims MUST equal the
+// balance map dims (the camera fit + E31 grid bounds derive from balance —
+// a mismatch would place the city off the play surface).
+map_board_load :: proc(src: []u8, bal: ^Balance, allocator := context.allocator) -> (b: Map_Board, err: string) {
+	v, perr := json.parse(src, parse_integers = false, allocator = allocator)
+	if perr != nil {
+		return {}, fmt.tprintf("map_board_load: dublin.json parse failed: %v", perr)
+	}
+	defer json.destroy_value(v, allocator)
+	obj, ok := v.(json.Object)
+	if !ok {
+		return {}, "map_board_load: dublin.json root is not an object"
+	}
+	// --- board dims (the design-grid contract) ---
+	bo, okb := obj["board"].(json.Object)
+	if !okb {
+		return {}, "map_board_load: missing board block"
+	}
+	b.w_tiles = i32(json_get_int(bo, "w_tiles", -1))
+	b.h_tiles = i32(json_get_int(bo, "h_tiles", -1))
+	if b.w_tiles != bal.map_w_tiles || b.h_tiles != bal.map_h_tiles {
+		return {}, fmt.tprintf("map_board_load: board dims %dx%d != balance map dims %dx%d (the design-grid contract)",
+			b.w_tiles, b.h_tiles, bal.map_w_tiles, bal.map_h_tiles)
+	}
+	// --- attribution (the ODbL credit the view renders) ---
+	if attr, oka := map_json_str(obj, "attribution"); oka {
+		b.attribution = strings_clone(attr, allocator)
+	}
+	// --- districts (file order = index order; deterministic) ---
+	dist_arr, okd := obj["districts"].(json.Array)
+	if !okd {
+		return {}, "map_board_load: missing districts"
+	}
+	for dv in dist_arr {
+		doj, okdo := dv.(json.Object)
+		if !okdo {
+			return {}, "map_board_load: malformed district"
+		}
+		name, okn := map_json_str(doj, "name")
+		if !okn {
+			return {}, "map_board_load: district missing name"
+		}
+		px, okx := doj["x"].(json.Float)
+		py, oky := doj["y"].(json.Float)
+		if !okx || !oky {
+			return {}, "map_board_load: district missing x/y"
+		}
+		kind := District_Kind.Suburb
+		if ks, oks := map_json_str(doj, "kind"); oks {
+			switch ks {
+			case "city":          kind = .City
+			case "town":          kind = .Town
+			case "village":       kind = .Village
+			case "suburb":        kind = .Suburb
+			case "quarter":       kind = .Quarter
+			case "neighbourhood": kind = .Neighbourhood
+			case: // unknown kind — keep the suburb default (defensive; the asset is baked)
+			}
+		}
+		append(&b.districts, Map_District{name = strings_clone(name, allocator), kind = kind, pos = {f32(px), f32(py)}})
+	}
+	if len(b.districts) == 0 {
+		return {}, "map_board_load: no districts"
+	}
+	// --- the 1-in-6 spawn pool (stride -> snap -> grid filter -> dedupe) ---
+	cands, okc := obj["spawn_candidates"].(json.Array)
+	if !okc {
+		return {}, "map_board_load: missing spawn_candidates"
+	}
+	// pass 1: snap + filter (a spawn is a TILE — the E31 grid contract)
+	snapped := make([dynamic][2]i32, 0, len(cands) / MAP_SPAWN_STRIDE, allocator)
+	defer delete(snapped)
+	for i := 0; i < len(cands); i += MAP_SPAWN_STRIDE {
+		p, okp := map_json_f32_pair(cands[i])
+		if !okp {
+			return {}, "map_board_load: malformed spawn candidate"
+		}
+		tx := i32(math.round(f64(p[0])))
+		ty := i32(math.round(f64(p[1])))
+		if tx < 0 || tx >= b.w_tiles || ty < 0 || ty >= b.h_tiles {
+			continue // the "filter at bake-load": out-of-grid tiles never enter the pool
+		}
+		append(&snapped, [2]i32{tx, ty})
+	}
+	// pass 2: dedupe (first occurrence wins — file order, deterministic) +
+	// the district assignment (nearest anchor; ties to the lower index).
+	// Linear scans (no map iteration, ODN-10): 37k tiles × 719 pool is
+	// trivial at load.
+	b.candidates = make([dynamic][2]i32, 0, len(snapped), allocator)
+	b.candidate_district = make([dynamic]u16, 0, len(snapped), allocator)
+	for p in snapped {
+		dup := false
+		for i in 0..<len(b.candidates) {
+			if b.candidates[i] == p {
+				dup = true
+				break
+			}
+		}
+		if dup {
+			continue
+		}
+		best: u16 = 0
+		bd2 := max(f32)
+		for di in 0..<len(b.districts) {
+			dx := f32(p[0]) - b.districts[di].pos[0]
+			dy := f32(p[1]) - b.districts[di].pos[1]
+			d2 := dx * dx + dy * dy
+			if d2 < bd2 {
+				bd2 = d2
+				best = u16(di)
+			}
+		}
+		append(&b.candidates, p)
+		append(&b.candidate_district, best)
+	}
+	// the render dots (raw sub-tile points — the gallery's dotted texture)
+	b.render_dots = make([dynamic][2]f32, 0, len(snapped), allocator)
+	for i := 0; i < len(cands); i += MAP_SPAWN_STRIDE {
+		p, okp := map_json_f32_pair(cands[i])
+		if !okp {
+			return {}, "map_board_load: malformed spawn candidate"
+		}
+		if p[0] < 0 || p[0] >= f32(b.w_tiles) || p[1] < 0 || p[1] >= f32(b.h_tiles) {
+			continue
+		}
+		append(&b.render_dots, p)
+	}
+	if len(b.candidates) == 0 {
+		return {}, "map_board_load: the 1-in-6 spawn pool is empty (degenerate asset)"
+	}
+	// per-district ranges (flat — the ATTACH family's pool draw)
+	b.district_start = make([dynamic]u32, len(b.districts) + 1, allocator)
+	for di in 0..<len(b.districts) {
+		b.district_start[di] = 0 // (filled below; the sentinel at the end)
+	}
+	// count per district, then prefix-sum into the start table. Two passes
+	// (no per-district dynamic arrays — flat ranges, ODN-10).
+	counts := make([]u32, len(b.districts), allocator)
+	defer delete(counts)
+	for i in 0..<len(b.candidates) {
+		counts[b.candidate_district[i]] += 1
+	}
+	acc: u32 = 0
+	for di in 0..<len(b.districts) {
+		b.district_start[di] = acc
+		acc += counts[di]
+	}
+	b.district_start[len(b.districts)] = acc
+	// --- the render-only underlay (terrain rings + street polylines) ---
+	if !map_polys_load(&b.water, obj["terrain"].(json.Object)["water"], true, allocator) {
+		return {}, "map_board_load: malformed terrain.water"
+	}
+	if !map_polys_load(&b.coast, obj["terrain"].(json.Object)["coast"], true, allocator) {
+		return {}, "map_board_load: malformed terrain.coast"
+	}
+	if !map_polys_load(&b.park, obj["terrain"].(json.Object)["park"], true, allocator) {
+		return {}, "map_board_load: malformed terrain.park"
+	}
+	if !map_polys_load(&b.arterial, obj["streets"].(json.Object)["arterial"], false, allocator) {
+		return {}, "map_board_load: malformed streets.arterial"
+	}
+	if !map_polys_load(&b.local, obj["streets"].(json.Object)["local"], false, allocator) {
+		return {}, "map_board_load: malformed streets.local"
+	}
+	return b, ""
+}
+
+// json_get_int — a required integer field (the catalog loader's convention).
+json_get_int :: proc(obj: json.Object, key: string, def: i64) -> i64 {
+	if v, ok := obj[key]; ok {
+		#partial switch x in v {
+		case json.Float:
+			return i64(x)
+		}
+	}
+	return def
+}
+
+// strings_clone — strings.clone under the board's allocator (the core already
+// imports core:strings elsewhere; a tiny alias keeps map.odin self-contained).
+strings_clone :: proc(s: string, allocator := context.allocator) -> string {
+	out := make([]u8, len(s), allocator)
+	copy(out, s)
+	return string(out)
+}
+
+// map_board_candidate_pool — the global pool range (the SEED family's draw
+// domain): candidates[0..len). Convenience accessor mirroring the per-district
+// ranges (district d = candidates[district_start[d]..district_start[d+1])).
+map_board_pool_lo :: proc(b: ^Map_Board) -> u32 { return 0 }
+map_board_pool_hi :: proc(b: ^Map_Board) -> u32 { return u32(len(b.candidates)) }
diff --git a/core/map_test.odin b/core/map_test.odin
new file mode 100644
index 00000000..71fbcf3e
--- /dev/null
+++ b/core/map_test.odin
@@ -0,0 +1,206 @@
+package core
+
+// map_test.odin — v2-dublin-board: the board loader + the board-aware growth
+// as durable tests (the acceptance-pin convention). Pins:
+//   (a) the 1-in-6 stride -> snap -> grid-filter -> dedupe pool contract
+//       (a spawn is a TILE; out-of-grid points never enter the pool);
+//   (b) the district assignment (nearest anchor, ties to the lower index) +
+//       the flat per-district ranges (the ATTACH family's draw domain);
+//   (c) the design-grid contract: board dims != balance map dims is a
+//       defined load error (fail loud, never a mis-sized play surface);
+//   (d) dublin growth spawns land ON the pool (a real-street tile), the E31
+//       predicates still gate (never an illegal placement), and the ATTACH
+//       family stays WITHIN the anchor's district (the growth_groups
+//       interplay: cluster radius/caps apply within districts);
+//   (e) the procedural path is untouched (existing growth tests pin it).
+
+import "core:fmt"
+import "core:testing"
+
+// test_board — a synthetic board on the catalog's 40×30 grid with TWO
+// districts (A at (6,6), B at (24,6)) and a cross-shaped pool per district:
+// the tiles sit 4 tiles from the district anchor (the E31 sep floor) so the
+// ATTACH family can land candidates (a tile must be >= terminal_min_sep_tiles
+// from the anchor node AND within radius_tiles of it — the [4, 5] ring).
+test_board :: proc(allocator := context.allocator) -> Map_Board {
+	b: Map_Board
+	b.w_tiles = 40
+	b.h_tiles = 30
+	append(&b.districts, Map_District{name = "A", pos = {6, 6}})
+	append(&b.districts, Map_District{name = "B", pos = {24, 6}})
+	// pool tiles in file order (the dedupe keeps first occurrences): A's
+	// cross (the anchor + the 4-tile ring), then B's cross.
+	pool := [10][2]i32{
+		[2]i32{2, 6}, [2]i32{10, 6}, [2]i32{6, 2}, [2]i32{6, 10}, [2]i32{6, 6},
+		[2]i32{20, 6}, [2]i32{28, 6}, [2]i32{24, 2}, [2]i32{24, 10}, [2]i32{24, 6},
+	}
+	for p in pool {
+		append(&b.candidates, p)
+	}
+	b.candidate_district = make([dynamic]u16, 0, 16, allocator)
+	for i in 0..<len(b.candidates) {
+		append(&b.candidate_district, board_district_at(&b, b.candidates[i]))
+	}
+	// the flat per-district ranges (the loader's prefix-sum shape)
+	b.district_start = make([dynamic]u32, 3, allocator)
+	acc: u32 = 0
+	for di in 0..<2 {
+		b.district_start[di] = acc
+		for i in 0..<len(b.candidates) {
+			if b.candidate_district[i] == u16(di) {
+				acc += 1
+			}
+		}
+	}
+	b.district_start[2] = acc
+	return b
+}
+
+test_board_destroy :: proc(b: ^Map_Board) {
+	delete(b.candidates)
+	delete(b.candidate_district)
+	delete(b.district_start)
+	for d in b.districts {
+		delete(d.name)
+	}
+	delete(b.districts)
+}
+
+// dublin_growth_run — step a run with growth on + the board pinned. `bias`
+// overrides the test catalog's growth_groups bias (0 = the SEED family only
+// — the pool-draw test; 1000 = the strict ATTACH doctrine — the district
+// test). `seeds` pre-places terminals on pool tiles (the attach anchors).
+// The router goes at (6,14) — 8 tiles below district A's anchor, clear of
+// every pool tile's E31 sep ring, connectable to both districts (span 18).
+// Returns the grown terminal positions (ids >= 4 — the director's spawns;
+// the fixture ids 0..2 + the router + the pre-seeded anchors are excluded).
+dublin_growth_run :: proc(t: ^testing.T, cat: ^Catalogs, board: ^Map_Board, bias: i32, seeds: [][2]i32) -> [dynamic][2]i32 {
+	s, _, _, _ := topo_setup(t, cat)
+	defer run_destroy(&s)
+	router_idx, _ := node_type_index(cat, "router_basic")
+	topology_spawn_node(&s.topology, router_idx, {6, 14}, cat)
+	res_idx, _ := node_type_index(cat, "residential")
+	for sd in seeds {
+		topology_spawn_node(&s.topology, res_idx, sd, cat)
+	}
+	s.era = 3
+	s.growth_enabled = true
+	s.map_source = u8(Map_Source.Dublin)
+	s.board = board
+	cat.balance.growth_groups.bias_prob_permille = bias
+	// 480 ticks = 6 spawn windows (80 = the balance pace knob)
+	record_run(&s, 480, cat)
+	out := make([dynamic][2]i32, context.temp_allocator)
+	for i in 0..<len(s.topology.node_alive) {
+		if s.topology.node_alive[i] && s.topology.node_kind[i] == .Terminal && s.topology.node_id[i] >= 4 + u32(len(seeds)) {
+			// ids 0..3 are the fixture (res, rt, host) + the test router;
+			// the pre-seeded anchors follow — only the director's OWN
+			// spawns are under test
+			append(&out, s.topology.node_pos[i])
+		}
+	}	return out
+}
+
+@(test)
+test_map_board_load_pool_contract :: proc(t: ^testing.T) {
+	// (a) stride -> snap -> grid filter -> dedupe: the pool holds integer
+	// TILES only, in first-occurrence order; out-of-grid points never enter.
+	// A 5-point strip at 0.2-tile spacing inside the grid + points outside.
+	src := `{"board":{"w_tiles":8,"h_tiles":6},"spawn_candidates":[[1.1,1.2],[1.3,1.4],[1.5,1.6],[7.9,5.1],[-0.4,2.0],[2.0,6.4]],"districts":[{"name":"D","kind":"city","x":4,"y":3}],"terrain":{"water":[],"coast":[],"park":[]},"streets":{"arterial":[],"local":[]}}`
+	bal := Balance{map_w_tiles = 8, map_h_tiles = 6}
+	b, err := map_board_load(transmute([]u8)src, &bal, context.temp_allocator)
+	defer map_board_destroy(&b)
+	testing.expect(t, err == "", fmt.tprintf("board load failed: %s", err))
+	// stride 6 over 6 candidates = 1 point (the first). It snaps to (1,1).
+	testing.expectf(t, len(b.candidates) == 1, "pool must hold exactly 1 tile, got %d", len(b.candidates))
+	testing.expectf(t, b.candidates[0] == [2]i32{1, 1}, "snapped pool tile wrong: %v", b.candidates[0])
+	// the render dots hold the RAW subsample (same stride)
+	testing.expectf(t, len(b.render_dots) == 1, "render dots must hold 1 point, got %d", len(b.render_dots))
+}
+
+@(test)
+test_map_board_load_dims_contract :: proc(t: ^testing.T) {
+	// (c) the design-grid contract: a board whose dims differ from the
+	// balance map dims is a defined load error (fail loud).
+	src := `{"board":{"w_tiles":40,"h_tiles":30},"spawn_candidates":[[1,1]],"districts":[{"name":"D","kind":"city","x":4,"y":3}],"terrain":{"water":[],"coast":[],"park":[]},"streets":{"arterial":[],"local":[]}}`
+	bal := Balance{map_w_tiles = 8, map_h_tiles = 6} // mismatched
+	b, err := map_board_load(transmute([]u8)src, &bal, context.temp_allocator)
+	defer map_board_destroy(&b)
+	testing.expect(t, err != "", "mismatched board dims must fail loud")
+	testing.expectf(t, len(b.candidates) == 0, "a failed load must not return a usable pool (%d tiles)", len(b.candidates))
+}
+
+@(test)
+test_growth_dublin_spawns_on_pool :: proc(t: ^testing.T) {
+	// (d) the headline acceptance: dublin growth spawns land ON the board's
+	// street tiles (the pool), never off-pool, and every spawn stays E31-valid
+	// (the existing predicates gate the pool — a candidate, never a
+	// guaranteed placement). The SEED family (bias 0) draws the pool; the
+	// fresh-area floor + E31 reject what they reject — the pool is the only
+	// domain.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	board := test_board(context.allocator)
+	defer test_board_destroy(&board)
+	terminals := dublin_growth_run(t, cat, &board, 0, {})
+	defer delete(terminals)
+	testing.expectf(t, len(terminals) > 0, "dublin SEED growth must spawn (the mesh + the pool are connectable)")
+	for pos in terminals {
+		on_pool := false
+		for c in board.candidates {
+			if c == pos {
+				on_pool = true
+				break
+			}
+		}
+		testing.expectf(t, on_pool, "spawn %v is NOT on a pool tile (the streets-constrain rule)", pos)
+		// the E31 floor still holds (the existing predicate — belt)
+		testing.expectf(t, pos[0] >= 0 && pos[0] < board.w_tiles && pos[1] >= 0 && pos[1] < board.h_tiles,
+			"spawn %v is outside the board grid", pos)
+	}
+}
+
+@(test)
+test_growth_dublin_attach_stays_in_estate_radius :: proc(t: ^testing.T) {
+	// (d) the growth_groups interplay on the board (the streets rule): the
+	// ATTACH family draws the anchor's STREET RING (the pool tiles in
+	// [min_sep, radius] of a member) — every attach spawn sits within the
+	// estate radius of a member (the strict-radius closure preserved: no
+	// strays), on a pool tile, E31-valid. Pre-seed one terminal per district
+	// (the anchors at the cross centers); the strict doctrine (bias 1000)
+	// then extends each estate from its own streets.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	board := test_board(context.allocator)
+	defer test_board_destroy(&board)
+	seeds := [2][2]i32{{6, 6}, {24, 6}}
+	terminals := dublin_growth_run(t, cat, &board, 1000, seeds[:])
+	defer delete(terminals)
+	testing.expectf(t, len(terminals) > 0, "dublin ATTACH growth must spawn (the anchors sit on the pool)")
+	radius := i64(cat.balance.growth_groups.radius_tiles)
+	r2 := radius * radius
+	for pos in terminals {
+		on_pool := false
+		for c in board.candidates {
+			if c == pos {
+				on_pool = true
+				break
+			}
+		}
+		testing.expectf(t, on_pool, "attach spawn %v is NOT on a pool tile", pos)
+		// the strict-radius closure: every spawn sits within the estate radius
+		// of the nearest seed anchor (the attach's own ring guarantees this —
+		// pinned so a regression to an unbounded draw fails here).
+		in_radius := false
+		for sd in seeds {
+			d := pos - sd
+			if i64(d[0])*i64(d[0])+i64(d[1])*i64(d[1]) <= r2 {
+				in_radius = true
+				break
+			}
+		}
+		testing.expectf(t, in_radius, "attach spawn %v sits outside the estate radius of every anchor (a stray)", pos)
+	}
+}
