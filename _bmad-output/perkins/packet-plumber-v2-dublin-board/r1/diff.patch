+// gallery's dtext) + the ink text. Mirrors draw_text_font but with the halo.
+draw_text_font_halo :: proc(f: rl.Font, txt: string, x, y, size: i32, col, halo: rl.Color) {
+	cbuf := make([dynamic]u8, 0, len(txt) + 1, context.temp_allocator)
