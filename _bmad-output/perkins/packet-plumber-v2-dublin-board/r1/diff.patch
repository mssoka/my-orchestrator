+		draw_text_font_halo(v.font_copyright, "\xc2\xa9", x, y, size, v.palette.ink_faint, halo)
+		draw_text_font_halo(v.font, b.attribution[2:], x + i32(w.x), y, size, v.palette.ink_faint, halo)
+	} else {
+		draw_text_font_halo(v.font, b.attribution, x, y, size, v.palette.ink_faint, halo)
+	}
+}
