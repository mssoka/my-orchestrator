diff --git a/harness/catalogs.odin b/harness/catalogs.odin
index b3aa8453..96711309 100644
--- a/harness/catalogs.odin
+++ b/harness/catalogs.odin
@@ -74,3 +74,34 @@ seed_qos_fixture :: proc(state: ^pp.Run_State, cat: ^pp.Catalogs) {
 	pp.topology_spawn_node(&state.topology, res_idx, {14, 22}, cat)
 	pp.topology_spawn_node(&state.topology, res_idx, {26, 22}, cat)
 }
+
+// --- v2-dublin-board: the board cache ---------------------------------------
+// The baked Dublin board (data/maps/dublin.json) is loaded ONCE per harness
+// process (a sequential demo run shares the read-only parse — the sim and
+// the view read the same Map_Board; the replay paths re-derive the identical
+// spawns from the identical asset bytes, so byte-identical replay holds by
+// construction). Package-level cache (package main — the ODN-13 no-globals
+// rule binds core, not the harness CLI).
+board_cache: pp.Map_Board
+board_cache_loaded: bool
+
+// board_load — parse data/maps/dublin.json into the cached Map_Board (lazy,
+// once per process). Returns the cache pointer + "" on success, "" + a
+// one-line error otherwise (fail loud — a dublin demo must never silently
+// run procedural).
+board_load :: proc(cat: ^pp.Catalogs) -> (^pp.Map_Board, string) {
+	if board_cache_loaded {
+		return &board_cache, ""
+	}
+	bytes, e := os.read_entire_file_from_path("data/maps/dublin.json", context.temp_allocator)
+	if e != nil {
+		return nil, fmt.tprintf("board_load: cannot read data/maps/dublin.json: %v", e)
+	}
+	b, lerr := pp.map_board_load(bytes, &cat.balance, context.allocator)
+	if lerr != "" {
+		return nil, fmt.tprintf("board_load: %s", lerr)
+	}
+	board_cache = b
+	board_cache_loaded = true
+	return &board_cache, ""
+}
