+// dublin_label_cstr — the district name as a null-terminated temp string
+// (DrawTextEx needs a cstring; the temp arena frees it at the frame end).
+dublin_label_cstr :: proc(s: string) -> string {
+	cbuf := make([dynamic]u8, 0, len(s) + 1, context.temp_allocator)
