new file mode 100644
index 00000000..a4b4c8aa
--- /dev/null
+++ b/app/render/dublin.odin
@@ -0,0 +1,445 @@
+package render
+
+// dublin.odin — v2-dublin-board (stage 1 of the real-maps arc): the Dublin
+// board underlay renderer. When the map source = dublin this REPLACES the
+// procedural noise map (map.odin) as the world background, in the paper-map
+// aesthetic the #90 gallery blessed (the user's gate: the board must match
+// the gallery previews — KYLE grades a live capture side-by-side). Draw
+// order mirrors the gallery's renderer (tools/render_dublin_preview.py)
+// exactly: canvas -> terrain (water/coast/park) -> grid (18% blend) ->
+// streets (arterial heavier, local faint) -> spawn candidates (the 1-in-6
+// dotted texture) -> district labels (IBM Plex, collision-avoided, canvas
+// halo) -> the ODbL attribution (rule 5: "© OpenStreetMap contributors"
+// renders in-game, bottom-left of the board).
+//
+// Determinism: every draw is the same IEEE f32 camera transform the
+// procedural map uses (to_screen/scale/off — the §10.4 rasterized-path rule,
+// no transcendentals, no libm). The terrain rasterization (even-odd
+// point-in-polygon into a per-world-px cell grid) runs ONCE per board
+// (cached in the View — rebuilt when the board pointer changes) and is pure
+// integer/f32 arithmetic; the per-frame draws are pure functions of the
+// board + the camera. Same board + same camera -> byte-identical pixels
+// (the T2 spine).
+//
+// PRESENTATION ONLY (ODN-1): the view READS the board (the sim's board
+// pointer is run setup, never touched here); T1 hashes ignore this layer by
+// construction — the underlay is not sim state, exactly like the procedural
+// map's cells.
+
+import pp "../../core"
+import rl "vendor:raylib"
+
+// Dublin_Board_Render — the render-side cache for one Map_Board. The terrain
+// is rasterized ONCE per board into a per-world-px cell grid (even-odd
+// point-in-polygon — the SAME fill rule the gallery's renderer uses, so the
+// OSM pinch/retrace artifacts that break ear clipping fill exactly like the
+// blessed previews) + the district label draw order (kind priority, stable).
+// Rebuilt when the View's board pointer changes (dublin_render_ensure).
+Dublin_Board_Render :: struct {
+	board:    ^pp.Map_Board,
+	// terrain cells: one u8 per world px (the board rect w×h px): 0 = none
+	// (the canvas base shows through), 1 = water, 2 = coast, 3 = park
+	// (later kinds overwrite earlier — the gallery's draw order). Drawn as
+	// span-filled rects like the procedural map's cells (map_draw).
+	terrain_cells: [dynamic]u8,
+	cells_w:       i32,
+	cells_h:       i32,
+	// the district draw order (kind rank desc, stable for equal ranks —
+	// file order): labels draw highest-priority first, collision-dropped
+	// against the already-placed set (the gallery's label rule).
+	label_order: [dynamic]u16,
+}
+
+// terrain cell kinds (the cache's byte values — NOT Map_Kind: 0 must mean
+// "no feature" so the canvas base shows through; the procedural map's Land
+// has no equivalent on the board — the gallery's base IS the paper).
+DUBLIN_CELL_NONE  :: u8(0)
+DUBLIN_CELL_WATER :: u8(1)
+DUBLIN_CELL_COAST :: u8(2)
+DUBLIN_CELL_PARK  :: u8(3)
+
+// --- art-tuning constants (the D9 style dial; the gallery is the oracle) ----
+// Label sizes in WORLD px at the 26px/tile design grid (they scale with the
+// camera like everything in the world pass — at fit zoom the board reads like
+// the gallery's baywide view; zooming grows them proportionally). The
+// preview's sizes (30/24/20/17/14/12 at 52px/tile) scale by 26/52 = 0.5 for
+// the in-game grid; the city label nudged up (the game's font-overhaul
+// readability bar).
+DUBLIN_LABEL_SIZE := [6]i32{18, 15, 13, 11, 10, 10} // city/town/village/suburb/quarter/neighbourhood (world px)
+// Label-anchor collision gaps (world px) — the preview's at 2× scale, halved
+// for the in-game grid (the baywide's relative density).
+DUBLIN_LABEL_GAP := [6]f32{999, 75, 60, 48, 35, 30}
+// The street skeleton: arterials at 0.030 tiles wide, locals at 0.020 (the
+// preview's crop proportions — 3px/2px at 104px/tile). Widths are screen px,
+// scale-aware (max 1 at fit — the baywide's 1px look).
+DUBLIN_STREET_ARTERIAL_W :: 0.030
+DUBLIN_STREET_LOCAL_W    :: 0.020
+// The candidate-dot radius in world px (0.55 at the preview's SS=2 → 1.1px
+// screen at fit ≈ 1px; grows with the camera).
+DUBLIN_DOT_RADIUS :: 0.55
+// The grid blend (18% — map.odin's GRID_ALPHA is the procedural twin; the
+// preview draws 46/255).
+DUBLIN_GRID_ALPHA :: 46
+// The district-label halo color = canvas at 235 alpha (the preview's paper
+// halo) + the ink text.
+DUBLIN_LABEL_HALO_ALPHA :: 235
+
+// dublin_render_destroy — free the cache's buffers (called by view teardown).
+dublin_render_destroy :: proc(d: ^Dublin_Board_Render) {
+	delete(d.terrain_cells)
+	delete(d.label_order)
+	d.board = nil
+}
+
+// dublin_render_ensure — rebuild the cache when the board pointer changes
+// (the app/harness set view.board at run setup; a different board = a full
+// rebuild). The terrain rasterization + label order are deterministic (pure
+// f32/int ops — the even-odd crossings are IEEE division + comparisons).
+dublin_render_ensure :: proc(v: ^View) {
+	d := &v.dublin
+	if d.board == v.board && len(d.label_order) > 0 {
+		return
+	}
+	if d.board != nil {
+		dublin_render_destroy(d)
+	}
+	if v.board == nil {
+		return
+	}
+	b := v.board
+	d.board = b
+	// --- the terrain cell grid (1 cell per world px — the map_draw
+	// resolution; the gallery's even-odd fill rule) ---
+	w := b.w_tiles * i32(v.tile_px)
+	h := b.h_tiles * i32(v.tile_px)
+	d.cells_w = w
+	d.cells_h = h
+	d.terrain_cells = make([dynamic]u8, w * h) // 0 = none (canvas shows through)
+	tile_px := v.tile_px
+	// water, then coast, then park — each later kind overwrites (the
+	// gallery's draw order: coast beats water at the ring, park beats both).
+	dublin_rasterize_rings(&d.terrain_cells, b.water[:], DUBLIN_CELL_WATER, w, h, tile_px)
+	dublin_rasterize_rings(&d.terrain_cells, b.coast[:], DUBLIN_CELL_COAST, w, h, tile_px)
+	dublin_rasterize_rings(&d.terrain_cells, b.park[:], DUBLIN_CELL_PARK, w, h, tile_px)
+	// the label draw order: kind rank descending (stable for equal ranks —
+	// the gallery's sorted-by-priority rule).
+	d.label_order = make([dynamic]u16, 0, len(b.districts))
+	for i in 0..<len(b.districts) {
+		append(&d.label_order, u16(i))
+	}
+	// insertion sort by rank desc (121 items — trivial; deterministic).
+	for i in 1..<len(d.label_order) {
+		key := d.label_order[i]
+		j := i
+		for j > 0 && pp.district_kind_rank(b.districts[d.label_order[j-1]].kind) < pp.district_kind_rank(b.districts[key].kind) {
+			d.label_order[j] = d.label_order[j-1]
+			j -= 1
+		}
+		d.label_order[j] = key
+	}
+}
+
+// dublin_rasterize_rings — stamp `kind` on every cell inside any ring of
+// `rings` (even-odd point-in-polygon per cell, bbox-culled). The ray cast
+// counts crossings of the horizontal ray to +x — the EXACT rule PIL's
+// polygon fill uses, so the OSM pinch/retrace artifacts (which break ear
+// clipping) fill identically to the blessed gallery. Pure f32 ops
+// (division + comparisons — deterministic, no libm).
+dublin_rasterize_rings :: proc(cells: ^[dynamic]u8, rings: [][dynamic][2]f32, kind: u8, w, h: i32, tile_px: f32) {
+	for ring in rings {
+		if len(ring) < 3 {
+			continue
+		}
+		// the ring's tile-space bbox (the cells to test)
+		minx := ring[0][0]
+		maxx := minx
+		miny := ring[0][1]
+		maxy := miny
+		for p in ring {
+			minx = min(minx, p[0])
+			maxx = max(maxx, p[0])
+			miny = min(miny, p[1])
+			maxy = max(maxy, p[1])
+		}
+		x0 := max(0, i32(minx * tile_px))
+		x1 := min(w, i32(maxx * tile_px) + 1)
+		y0 := max(0, i32(miny * tile_px))
+		y1 := min(h, i32(maxy * tile_px) + 1)
+		for cy in y0..<y1 {
+			for cx in x0..<x1 {
+				// the cell center in tile space (the test point)
+				px := (f32(cx) + 0.5) / tile_px
+				py := (f32(cy) + 0.5) / tile_px
+				if dublin_point_in_ring(ring[:], px, py) {
+					cells[cy * w + cx] = kind
+				}
+			}
+		}
+	}
+}
+
+// dublin_point_in_ring — the even-odd ray cast (crossing number): the point
+// is inside iff the ray to +x crosses an odd number of edges. The classic
+// (y-bracketing + x-crossing) formulation — same rule as PIL's polygon fill.
+dublin_point_in_ring :: proc(ring: [][2]f32, x, y: f32) -> bool {
+	inside := false
+	j := len(ring) - 1
+	for i in 0..<len(ring) {
+		a := ring[i]
+		b := ring[j]
+		if (a[1] > y) != (b[1] > y) {
+			t := (y - a[1]) / (b[1] - a[1])
+			if a[0] + t * (b[0] - a[0]) > x {
+				inside = !inside
+			}
+		}
+		j = i
+	}
+	return inside
+}
+
+// dublin_tile_screen — the board's tile coords -> screen (the same
+// to_screen world transform the procedural map uses).
+dublin_tile_screen :: proc(v: ^View, tx, ty: f32) -> rl.Vector2 {
+	return to_screen(v, tx * v.tile_px, ty * v.tile_px)
+}
+
+// dublin_map_draw — the board underlay (called from map_draw when the map
+// source = dublin; the procedural path is untouched). Base canvas fill
+// (window), then the world pass in the gallery's draw order.
+dublin_map_draw :: proc(v: ^View, b: ^pp.Map_Board) {
+	dublin_render_ensure(v)
+	p := v.palette
+	rl.DrawRectangle(0, 0, v.win_w, v.win_h, p.canvas)
+	if v.dublin.board != b {
+		return // the cache failed to build (defensive — a nil cache draws nothing extra)
+	}
+
+	// 1. terrain (canon order: water -> coast -> park — the cell grid
+	//    rasterized at load already applied the overwrite order; the draw is
+	//    a span-fill over the world rect, skipping the none-cells).
+	dublin_draw_terrain(v)
+
+	// 2. the grid (18% blend over land AND water — map.odin's grid rule).
+	grid := p.grid
+	grid.a = DUBLIN_GRID_ALPHA
+	step := v.tile_px * v.scale
+	if step > 0 {
+		// verticals at every tile boundary, clipped to the world rect
+		for tx: i32 = 0; tx <= b.w_tiles; tx += 1 {
+			sx := v.off_x + f32(tx) * v.tile_px * v.scale
+			rl.DrawLineEx({sx, v.off_y}, {sx, v.off_y + f32(b.h_tiles) * v.tile_px * v.scale}, 1, grid)
+		}
+		for ty: i32 = 0; ty <= b.h_tiles; ty += 1 {
+			sy := v.off_y + f32(ty) * v.tile_px * v.scale
+			rl.DrawLineEx({v.off_x, sy}, {v.off_x + f32(b.w_tiles) * v.tile_px * v.scale, sy}, 1, grid)
+		}
+	}
+
+	// 3. the street skeleton (arterial heavier, local faint).
+	aw := max(1, i32(DUBLIN_STREET_ARTERIAL_W * v.tile_px * v.scale + 0.5))
+	lw := max(1, i32(DUBLIN_STREET_LOCAL_W * v.tile_px * v.scale + 0.5))
+	for line in b.arterial {
+		dublin_draw_line(v, line[:], p.ink_soft, aw)
+	}
+	for line in b.local {
+		dublin_draw_line(v, line[:], p.ink_faint, lw)
+	}
+
+	// 4. the spawn candidates (the 1-in-6 dotted texture — the gallery's
+	//    density knob at the user's blessed calm default).
+	dot := p.house_bodies[0]
+	dot.a = 150
+	r := max(1, i32(DUBLIN_DOT_RADIUS * v.scale + 0.5))
+	for d in b.render_dots {
+		s := dublin_tile_screen(v, d[0], d[1])
+		if s.x < -f32(r) || s.x > f32(v.play_w) + f32(r) || s.y < -f32(r) || s.y > f32(v.win_h) + f32(r) {
+			continue
+		}
+		rl.DrawCircleV(s, f32(r), dot)
+	}
+
+	// 5. the district labels (kind-priority order, collision-avoided, paper
+	//    halo) + 6. the ODbL attribution (rule 5 — the map corner).
+	dublin_draw_labels(v, b)
+	dublin_draw_attribution(v, b)
+}
+
+// dublin_draw_terrain — the span-filled terrain cell grid (the procedural
+// map's exact draw pattern: per-row runs of equal kind as integer-screen
+// rects; adjacent spans share fceil boundaries so no hairline leaks the
+// canvas through). Cells are 1 world px — at fit zoom they ARE the screen
+// pixels (pixel-exact coastlines); zoomed, the stepping is the soft-backdrop
+// cost of the deterministic even-odd fill (the streets/dots/labels stay
+// vector-crisp).
+dublin_draw_terrain :: proc(v: ^View) {
+	p := v.palette
+	w := v.dublin.cells_w
+	h := v.dublin.cells_h
+	if len(v.dublin.terrain_cells) < int(w * h) || w <= 0 || h <= 0 {
+		return
+	}
+	for y in 0..<h {
+		row_top := fceil(v.off_y + f32(y) * v.scale)
+		row_bot := fceil(v.off_y + f32(y + 1) * v.scale)
+		if row_bot <= row_top {
+			continue
+		}
+		x: i32 = 0
+		for x < w {
+			k := v.dublin.terrain_cells[y * w + x]
+			if k == DUBLIN_CELL_NONE {
+				x += 1
+				continue
+			}
+			x0 := x
+			for x < w && v.dublin.terrain_cells[y * w + x] == k {
+				x += 1
+			}
+			col: rl.Color
+			if k == DUBLIN_CELL_WATER {
+				col = p.water
+			} else if k == DUBLIN_CELL_COAST {
+				col = p.coast
+			} else {
+				col = p.park
+			}
+			sx0 := fceil(v.off_x + f32(x0) * v.scale)
+			sx1 := fceil(v.off_x + f32(x) * v.scale)
+			rl.DrawRectangle(sx0, row_top, sx1 - sx0, row_bot - row_top, col)
+		}
+	}
+}
+
+// dublin_draw_line — one street polyline (world px -> screen), culled by its
+// world bbox. `w` is the screen-px width.
+dublin_draw_line :: proc(v: ^View, pts: [][2]f32, col: rl.Color, w: i32) {
+	if len(pts) < 2 {
+		return
+	}
+	// world-px bbox cull (the polyline's points are tile coords)
+	minx := pts[0][0] * v.tile_px
+	maxx := minx
+	miny := pts[0][1] * v.tile_px
+	maxy := miny
+	for i in 1..<len(pts) {
+		x := pts[i][0] * v.tile_px
+		y := pts[i][1] * v.tile_px
+		minx = min(minx, x)
+		maxx = max(maxx, x)
+		miny = min(miny, y)
+		maxy = max(maxy, y)
+	}
+	view_left := -v.off_x / v.scale
+	view_top := -v.off_y / v.scale
+	view_right := (f32(v.play_w) - v.off_x) / v.scale
+	view_bot := (f32(v.win_h) - v.off_y) / v.scale
+	if maxx < view_left || minx > view_right || maxy < view_top || miny > view_bot {
+		return
+	}
+	prev := dublin_tile_screen(v, pts[0][0], pts[0][1])
+	for i in 1..<len(pts) {
+		cur := dublin_tile_screen(v, pts[i][0], pts[i][1])
+		rl.DrawLineEx(prev, cur, f32(w), col)
+		prev = cur
+	}
+}
+
+// dublin_draw_labels — the district labels: kind-priority order, dropped when
+// an already-placed label's anchor is within the kind's collision gap, drawn
+// centered with the canvas halo (the gallery's label rule). Screen size =
+// world size × the camera scale (labels grow with the zoom, like the map).
+dublin_draw_labels :: proc(v: ^View, b: ^pp.Map_Board) {
+	if len(v.dublin.label_order) == 0 {
+		return
+	}
+	ink := v.palette.ink
+	halo := v.palette.canvas
+	halo.a = DUBLIN_LABEL_HALO_ALPHA
+	placed := make([dynamic][2]f32, 0, 16, context.temp_allocator)
+	for oi in 0..<len(v.dublin.label_order) {
+		di := int(v.dublin.label_order[oi])
