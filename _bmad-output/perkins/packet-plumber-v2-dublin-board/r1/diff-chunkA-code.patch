+	halo.a = DUBLIN_LABEL_HALO_ALPHA
+	x := i32(pos.x)
+	y := i32(pos.y)
+	// the attribution starts with the © codepoint (the UTF-8 lead "\xc2\xa9"
+	// — the source stays ASCII; the lint gate's rule). Draw it via the
+	// one-glyph font, then the remainder via the body font.
+	if len(b.attribution) >= 2 && b.attribution[0] == 0xC2 && b.attribution[1] == 0xA9 {
+		cstr := cstring(raw_data([]u8{0xC2, 0xA9, 0}))
