@@ -0,0 +1,465 @@
+package core
+
+// growth_test.odin — Story 5.1: deterministic map growth + spawn validity
+// (E31) as durable tests (the acceptance-pin convention). Pins:
+//   (a) growth-disabled runs are INERT (zero draws, zero mutations — the
+//       existing-goldens-unshifted back-compat contract);
+//   (b) the schedule: one terminal per GROWTH_INTERVAL_TICKS window, a pure
+//       function of the executed tick (no wall-clock);
+//   (c) terminals ONLY (routers are NEVER director-spawned — 3.5 amendment)
+//       + era-unlocked types only;
+//   (d) E31 validity: every spawned terminal is connectable-within-span of a
+//       live junction + min-separated from every node AND pipe segment +
+//       inside the map grid;
+//   (e) outward-from-mesh bias: with a one-router mesh every spawn lands in
+//       the annulus [GROWTH_OUT_MIN, connect_span] around the router;
+//   (f) growth waits when no junction exists (the mesh is player-placed);
+//   (g) THE determinism pin: same seed -> identical timeline/positions; a
+//       growing map replays byte-identically from the action log (E10);
+//   (h) the era gating: growth_connect_span + the terminal roster respect
+//       era_introduced.
+
+import "core:testing"
+
+// The core test fixture's terminal positions (mirror test_seed_fixture in
+// determinism_test.odin — the harness's FIXTURE_* consts are package main,
+// not visible here). Growth spawns can never land here (min separation from
+// every live node), so they are the reliable "seed terminals" to skip when
+// counting growth spawns.
+TEST_FIXTURE_RES_POS :: [2]i32{8, 15}
+TEST_FIXTURE_HOST_POS :: [2]i32{32, 15}
+
+// run_growth — step a run `ticks` ticks with growth on (fixture + era 3 unless
+// overridden). The caller mutates the returned state's setup BEFORE this (the
+// fixture toggle, era, growth flag, extra spawn_node, action-log commands).
+// Mirrors record_run (determinism_test.odin) but owns a growth-enabled run.
+run_growth :: proc(state: ^Run_State, ticks: u64, cat: ^Catalogs) -> [dynamic]u64 {
+	return record_run(state, ticks, cat)
+}
+
+// spawned_terminals — the live nodes spawned by growth (every node beyond the
+// fixture) — the caller's assertion surface. Returns their node ids + kinds.
+count_terminals :: proc(t: ^Topology) -> int {
+	n := 0
+	for i in 0..<len(t.node_alive) {
+		if t.node_alive[i] && t.node_kind[i] == .Terminal {
+			n += 1
+		}
+	}
+	return n
+}
+
+count_junctions :: proc(t: ^Topology) -> int {
+	n := 0
+	for i in 0..<len(t.node_alive) {
+		if t.node_alive[i] && t.node_kind[i] == .Junction {
+			n += 1
+		}
+	}
+	return n
+}
+
+@(test)
+test_growth_disabled_is_inert :: proc(t: ^testing.T) {
+	// back-compat contract: growth_enabled = false (the zero value — every
+	// legacy run) draws no rng and spawns nothing. The harness gate is the
+	// full byte-identical proof (all 27 existing demos re-run green); this
+	// unit test pins the mechanism.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, _, _, _ := topo_setup(t, cat)
+	defer run_destroy(&s)
+	s.era = 3
+	run_growth(&s, 600, cat)
+	testing.expectf(t, node_count(&s.topology) == 3, "growth-disabled run must keep the 3-node fixture, got %d", node_count(&s.topology))
+	testing.expectf(t, count_terminals(&s.topology) == 2, "growth-disabled run must keep 2 terminals, got %d", count_terminals(&s.topology))
+	testing.expect(t, !s.replay_error, "growth-disabled run must not latch replay_error")
+}
+
+@(test)
+test_growth_schedule_and_terminals_only :: proc(t: ^testing.T) {
+	// one terminal per GROWTH_INTERVAL_TICKS window, terminals ONLY (routers
+	// are NEVER director-spawned — 3.5 amendment). Custom topology: a single
+	// player-placed router (fixture off), so the mesh is a clean one-point
+	// mesh and every window's spawn is near-certain (rejection budget is
+	// ample on an empty map).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 42, cat.hash, TEST_LOGIC_HZ)
+	rt, _ := node_type_index(cat, "router_basic")
+	topology_spawn_node(&s.topology, rt, {20, 15}, cat)
+	s.era = 3
+	s.growth_enabled = true
+
+	run_growth(&s, 3 * GROWTH_INTERVAL_TICKS, cat)
