+test_growth_replay_byte_identical :: proc(t: ^testing.T) {
+	// THE spine pin: a GROWING map with logged commands (placement + draws)
+	// replays byte-identically from the action log — growth is seed-derived
+	// (derive, don't record): the replay re-derives the same spawns from the
+	// same rng stream, so live and replay hashes agree (E10).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	live: Run_State
+	defer run_destroy(&live)
+	run_init(&live, 42, cat.hash, TEST_LOGIC_HZ)
+	res, rt, host := test_seed_fixture(&live, cat)
+	basic, _ := node_type_index(cat, "router_basic")
+	std, _ := pipe_tier_index(cat, "standard")
+	live.era = 3
+	live.growth_enabled = true
+	append(&live.action_log, Command{apply_tick = 1, kind = Cmd_Place_Router{type_idx = basic, pos = {24, 6}}})
+	append(&live.action_log, Command{apply_tick = 50, kind = Cmd_Draw_Pipe{a = rt, b = 3, tier = std}})
+	append(&live.action_log, Command{apply_tick = 60, kind = Cmd_Draw_Pipe{a = res, b = rt, tier = std}})
+	_ = host
+
+	live_hashes := record_run(&live, 10 * GROWTH_INTERVAL_TICKS, cat)
+	defer delete(live_hashes)
+	testing.expectf(t, node_count(&live.topology) > 5, "growth run must spawn terminals past the 5 seeded/placed nodes, got %d", node_count(&live.topology))
+	testing.expect(t, !live.replay_error, "live growth run must not latch replay_error")
+
+	replayed: Run_State
+	defer run_destroy(&replayed)
+	run_init(&replayed, 42, cat.hash, TEST_LOGIC_HZ)
+	test_seed_fixture(&replayed, cat)
+	replayed.era = 3
+	replayed.growth_enabled = true // run setup — re-created identically, like the fixture
+	delete(replayed.action_log)
+	replayed.action_log = clone_log(live.action_log)
+	replay_hashes := record_run(&replayed, 10 * GROWTH_INTERVAL_TICKS, cat)
+	defer delete(replay_hashes)
+
+	testing.expect(t, !replayed.replay_error, "replay growth run must not latch replay_error (ODN-11 critical)")
+	testing.expectf(t, len(live_hashes) == len(replay_hashes), "tick count mismatch: live %d vs replay %d", len(live_hashes), len(replay_hashes))
+	diverged := false
+	for i in 0..<len(live_hashes) {
+		if live_hashes[i] != replay_hashes[i] {
+			diverged = true
+		}
+	}
+	testing.expectf(t, !diverged, "REPLAY DIVERGENCE: growing-map hashes differ — growth must be seed-derived (E10)")
+}
