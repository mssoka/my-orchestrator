+	testing.expect(t, !growth_pipe_sep_ok(&s.topology, {26, 17}, GROWTH_MIN_SEP_TILES), "candidate 2 tiles from a pipe segment must fail pipe separation")
+	testing.expect(t, growth_pipe_sep_ok(&s.topology, {26, 19}, GROWTH_MIN_SEP_TILES), "candidate 4 tiles from a pipe segment must pass pipe separation")
+	// off the segment's end: {33,17} — nearest point is the endpoint {32,15}
+	// (dist sqrt(1+4) ~ 2.2 < 3) so node sep rejects it even though the
+	// segment projection is outside — the endpoint check is the bound.
