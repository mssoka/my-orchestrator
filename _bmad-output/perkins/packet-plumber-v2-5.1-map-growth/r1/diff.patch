+// e31_recheck — the end-of-run E31 audit for ONE growth spawn, excluding the
+// spawn's OWN node (the live algorithm validates a candidate BEFORE spawning,
+// so the placed node itself must not count against its separation). Checks:
+// bounds + min separation from every OTHER node + every pipe segment +
+// connectable-within-span of a junction.
+e31_recheck :: proc(t: ^Topology, cat: ^Catalogs, self_slot: u32, pos: [2]i32, span: i32) -> bool {
+	if pos[0] < 0 || pos[0] >= cat.balance.map_w_tiles {
+		return false
+	}
+	if pos[1] < 0 || pos[1] >= cat.balance.map_h_tiles {
+		return false
+	}
+	sep2 := i64(GROWTH_MIN_SEP_TILES) * i64(GROWTH_MIN_SEP_TILES)
+	for i in 0..<len(t.node_alive) {
+		if !t.node_alive[i] || i == int(self_slot) {
+			continue
+		}
+		d := t.node_pos[i] - pos
+		if i64(d[0])*i64(d[0]) + i64(d[1])*i64(d[1]) < sep2 {
+			return false
+		}
+	}
+	if !growth_pipe_sep_ok(t, pos, GROWTH_MIN_SEP_TILES) {
+		return false
+	}
+	return growth_connectable(t, pos, span)
+}
+
