+	testing.expect(t, !growth_node_sep_ok(&s.topology, {21, 15}, GROWTH_MIN_SEP_TILES), "candidate 1 tile from a node must fail node separation")
+	// {23,15} is 3 tiles (boundary) — accepted
+	testing.expect(t, growth_node_sep_ok(&s.topology, {23, 15}, GROWTH_MIN_SEP_TILES), "candidate at the 3-tile boundary must pass node separation")
+
+	// pipe sep: draw the fixture router -> host pipe, then a candidate near
+	// the pipe's middle: pipe {20,15}->{32,15}; the midpoint {26,15}; a
+	// candidate at {26,17} is 2 tiles from the segment (< 3) — reject; at
+	// {26,19} is 4 tiles (>= 3) — accept (endpoint distances: {26,19} vs
+	// {20,15} = sqrt(36+16) ~ 7.2, vs {32,15} = sqrt(36+16) ~ 7.2 — the
+	// segment is the binding constraint).
+	std, _ := pipe_tier_index(cat, "standard")
+	_, err := topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{a = 1, b = 2, tier = std}}, cat)
