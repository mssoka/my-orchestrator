+	testing.expectf(t, count_terminals(&s.topology) == 3, "all growth spawns must be terminals, got %d", count_terminals(&s.topology))
+	testing.expectf(t, count_junctions(&s.topology) == 1, "growth must never spawn a junction (routers are player-placed), got %d", count_junctions(&s.topology))
