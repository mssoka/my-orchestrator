index 00000000..1ba78f21
--- /dev/null
+++ b/server/src/reference_checks/fraud.gleam
@@ -0,0 +1,263 @@
+//// The honest fraud-signals builder (AD-10).
+////
+//// Pure server-side code: turns gathered inputs into the `fraud_signals`
+//// JSON object that lands in `result.fraud_signals` (authoritative) and the
+//// denormalised `reference_call.fraud_signals` column. The load-bearing rule
+//// is AD-10 honesty — signals are clues about provenance, NEVER fabricated
+//// detections, NEVER verdicts. They never auto-reject and never alter a
+//// score (§9.4). The v2-reserved signals emit their honest placeholders
+//// exactly: `geo_vs_claimed_property` = `"unknown"`, `coached_answer_score`
+//// = null, `voice_matches_other_reference` is ABSENT (the key is never
+//// emitted), `referee_contact_invalid` is ABSENT until a correction cycle
+//// exhausts (rc3-7 never fabricates it; the stamp is a SQL `jsonb_set` the
+//// RC4.3 correction-exhaustion path calls).
+////
+//// Two build phases (§7.3):
+////   - `creation_fraud_signals` — at row creation (trigger): the pure-DB
+////     reuse signals + the Twilio line-type lookup + the honest placeholders.
+////     `form_session` is null (no form yet). `result` stays null at this
+////     phase; only the `fraud_signals` column is written.
+////   - `submission_fraud_signals` — at form submit (form_handler): re-runs
+////     the pure-DB signals (contacts can change via the correction loop),
+////     carries the creation-time line-type (no paid re-lookup), and computes
+////     the full `form_session` block (completion_seconds, ip_matches_applicant,
+////     device_fingerprint_match — a UA compare, labelled weak,
+////     focus_seconds_reported). Raw referee IP/UA live INSIDE `form_session`
+////     and are INTERNAL-ONLY (§4.2): RC4.1 strips them at the landlord API
+////     boundary. The derived booleans are the public face.
+////
+//// DB-reuse inputs are gathered by the caller (trigger / form_handler) —
+//// fraud.gleam is pure and owns no DB/HTTP. `cross_app_reuse` is precomputed
+//// by a SQL read (same effective contact under a DIFFERENT referee name in
+//// another application — the innocent letting-agent case, same name, does
+//// NOT flag).
+
+import gleam/dynamic/decode
+import gleam/json
+import gleam/list
+import gleam/option.{type Option, None, Some}
+import reference_checks/lookup
+
+/// A referee's effective contact (the snapshot OR corrected value — the
+/// caller resolves which via `corrected_*` fallback). Used for the pure-DB
+/// reuse + duplicate signals.
+pub type RefContact {
+  RefContact(name: String, email: Option(String), phone: Option(String))
+}
+
+/// The pure-DB inputs (AD-10). Gathered by the caller; fraud.gleam is pure.
+pub type FraudDbInputs {
+  FraudDbInputs(
+    // The referee being scored (this row's effective contact).
+    this_ref: RefContact,
+    // The application's OTHER reference rows' effective contacts (for
+    // `contact_reused_within_application` — per-ref involvement: does THIS
+    // ref's contact appear in another slot?).
+    other_application_refs: List(RefContact),
+    // The applicant's own contact (for `contact_duplicate_of_applicant`).
+    applicant: RefContact,
+    // Precomputed by the cross-application SQL read: true iff this ref's
+    // effective contact appears under a DIFFERENT name in another
+    // application's reference rows (for `contact_reused_across_applications`).
+    cross_app_reuse: Bool,
+  )
+}
+
+/// The `form_session` inputs (computed at submission only). Raw referee
+/// IP/UA are INTERNAL-ONLY (§4.2) — they ride inside `form_session` for the
+/// server-side evidence trail and RC4.1 strips them at the API boundary.
+pub type FormSessionInputs {
+  FormSessionInputs(
+    referee_ip: String,
+    referee_user_agent: String,
+    applicant_ip: String,
+    applicant_user_agent: String,
+    // Server wall-clock seconds from `form_opened_at` to now (computed in
+    // SQL — `EXTRACT(EPOCH FROM (now() - form_opened_at))`); None when the
+    // form was never opened.
+    completion_seconds: Option(Int),
+    // Client-reported focus seconds (rc3-4 `_focus_seconds`, JS-wired).
+    focus_seconds: Int,
+  )
+}
+
+// -- Phase 1: creation-time signals ------------------------------------------
+
+/// Build the creation-time `fraud_signals` (AD-10): pure-DB reuse signals +
+/// the line-type lookup + the honest placeholders. `form_session` is null
+/// (no form yet); `referee_contact_invalid` is ABSENT. The caller writes
+/// this to the `fraud_signals` column; `result` stays null until terminal.
+pub fn creation_fraud_signals(
+  db db: FraudDbInputs,
+  line_type line_type: lookup.LineType,
+) -> json.Json {
+  base_fraud_signals(db:, line_type:, form_session: json.null())
+}
+
+// -- Phase 2: submission-time signals ----------------------------------------
+
+/// Build the full submission-time `fraud_signals` (AD-10): re-runs the
+/// pure-DB signals (contacts can change via the correction loop), carries
+/// the creation-time line-type (no paid re-lookup), and computes the full
+/// `form_session` block. `referee_contact_invalid` is ABSENT. The caller
+/// embeds this in `result.fraud_signals` AND the denormalised column.
+pub fn submission_fraud_signals(
+  db db: FraudDbInputs,
+  line_type line_type: lookup.LineType,
+  fs fs: FormSessionInputs,
+) -> json.Json {
+  base_fraud_signals(db:, line_type:, form_session: form_session_block(fs))
+}
+
+// -- The shared AD-10 shape (both phases differ only in form_session) --------
+
+fn base_fraud_signals(
+  db db: FraudDbInputs,
+  line_type line_type: lookup.LineType,
+  form_session form_session: json.Json,
+) -> json.Json {
+  json.object([
+    #(
+      "contact_reused_within_application",
+      json.bool(reused_within_application(
+        db.this_ref,
+        db.other_application_refs,
+      )),
+    ),
+    #(
+      "contact_duplicate_of_applicant",
+      json.bool(duplicate_of_applicant(db.this_ref, db.applicant)),
+    ),
+    #("contact_reused_across_applications", json.bool(db.cross_app_reuse)),
+    #("line_type", json.string(lookup.line_type_to_string(line_type))),
+    #("voip_or_burner", json.bool(lookup.voip(line_type))),
+    #("form_session", form_session),
+    // Honest placeholders — NEVER fabricated (AD-10). geo has no geo-IP db;
+    // coached has no LLM pass in v1. Both emit their exact honest value.
+    #("geo_vs_claimed_property", json.string("unknown")),
+    #("coached_answer_score", json.null()),
+    // voice_matches_other_reference is v3-reserved (Art 9 biometric gate) —
+  // the key is ABSENT, never a placeholder. Do not emit it.
+  // referee_contact_invalid is ABSENT here — it is stamped only by the
+  // RC4.3 correction-exhaustion path (stamp_referee_contact_invalid.sql).
+  ])
+}
+
+/// The `form_session` block (computed at submission). Raw referee IP/UA are
+/// INTERNAL-ONLY (§4.2) — present server-side for the evidence trail, stripped
+/// at the landlord API boundary by RC4.1. `device_fingerprint_match` is a UA
+/// string compare, NOT a JS fingerprint library — it is labelled weak (AD-10);
+/// the boolean is uniform with `ip_matches_applicant`, the weakness is a
+/// documented property of the signal that RC4 renders with a caveat.
+fn form_session_block(fs: FormSessionInputs) -> json.Json {
+  json.object([
+    #("completion_seconds", int_or_null(fs.completion_seconds)),
+    #(
+      "ip_matches_applicant",
+      bool_or_null(ip_matches(fs.referee_ip, fs.applicant_ip)),
+    ),
+    #(
+      "device_fingerprint_match",
+      // AD-10: a UA string compare, NOT a JS fingerprint library — honestly
+      // weak. The bool is uniform with ip_matches_applicant; the weakness is a
+      // documented property of this signal (RC4 renders the caveat). No data
+      // key — keeps the form_session block to the AD-10 keys exactly.
+      bool_or_null(ua_matches(fs.referee_user_agent, fs.applicant_user_agent)),
+    ),
+    #("focus_seconds_reported", json.int(fs.focus_seconds)),
+    // Internal-only (§4.2) — RC4.1 strips at the API boundary.
+    #("referee_ip", json.string(fs.referee_ip)),
+    #("referee_user_agent", json.string(fs.referee_user_agent)),
+  ])
+}
+
+// -- Pure signal computations (exported for unit tests) ----------------------
+
+/// `contact_reused_within_application`: does THIS ref's effective email or
+/// phone appear in another of the application's reference slots? (AD-10.)
+/// Empty contacts never match (a missing phone is not "reused").
+pub fn reused_within_application(
+  this: RefContact,
+  others: List(RefContact),
+) -> Bool {
+  list.any(others, fn(other) { shares_contact(this, other) })
+}
+
+/// `contact_duplicate_of_applicant`: is the referee's effective contact the
+/// applicant's OWN email or phone? (AD-10.) Empty contacts never match.
+pub fn duplicate_of_applicant(ref: RefContact, applicant: RefContact) -> Bool {
+  shares_contact(ref, applicant)
+}
+
+/// `form_session.ip_matches_applicant`: referee form IP vs applicant-
+/// submission IP. Both must be present + exactly equal to confirm; either
+/// absent -> None (unknown — never fabricated). (AD-10.)
+pub fn ip_matches(referee_ip: String, applicant_ip: String) -> Option(Bool) {
+  exact_match(referee_ip, applicant_ip)
+}
+
+/// `form_session.device_fingerprint_match` — a User-Agent string compare
+/// (NOT a JS fingerprint lib), labelled WEAK (AD-10). Both must be present +
+/// exactly equal to confirm; either absent -> None. (AD-10.)
+pub fn ua_matches(referee_ua: String, applicant_ua: String) -> Option(Bool) {
+  exact_match(referee_ua, applicant_ua)
+}
+
+// -- Phase 2 helper: carry the creation-time line-type (no paid re-lookup) ---
+
+/// Carry the creation-time `line_type` from a stored `fraud_signals` JSON
+/// text (AD-10: at submission, line-type is NOT re-looked-up — the contact
+/// hasn't changed in v1 until RC4.3's correction re-triggers a fresh lookup).
+/// `Unknown` when the text is empty (a pre-rc3-7 row, or a creation-time
+/// stamp failure) or unparseable — never fabricated (AD-10 honesty).
+pub fn carry_line_type(fraud_signals_text: String) -> lookup.LineType {
+  case fraud_signals_text {
+    "" -> lookup.Unknown
+    text ->
+      case json.parse(text, decode.at(["line_type"], decode.string)) {
+        Ok(s) -> lookup.line_type_from_string(s)
+        Error(_) -> lookup.Unknown
+      }
+  }
+}
+
+// -- internals ---------------------------------------------------------------
+
+/// Two contacts share if their effective email matches OR their effective
+/// phone matches. Empty contacts never match (a missing field is not reuse).
+fn shares_contact(a: RefContact, b: RefContact) -> Bool {
+  same_optional(a.email, b.email) || same_optional(a.phone, b.phone)
+}
+
+/// Two optional non-empty strings are the same when both are present,
+/// non-empty, and exactly equal. Empty/absent never matches.
+fn same_optional(a: Option(String), b: Option(String)) -> Bool {
+  case a, b {
+    Some(x), Some(y) -> x != "" && y != "" && x == y
+    _, _ -> False
+  }
+}
+
+/// Two required-ish strings match exactly when both are non-empty + equal;
+/// either empty -> None (unknown); non-empty + unequal -> Some(False).
+fn exact_match(referee: String, applicant: String) -> Option(Bool) {
+  case referee, applicant {
+    "", _ -> None
+    _, "" -> None
+    r, a -> Some(r == a)
+  }
+}
+
+fn int_or_null(value: Option(Int)) -> json.Json {
+  case value {
+    Some(n) -> json.int(n)
+    None -> json.null()
+  }
+}
+
+fn bool_or_null(value: Option(Bool)) -> json.Json {
+  case value {
+    Some(b) -> json.bool(b)
+    None -> json.null()
+  }
+}
