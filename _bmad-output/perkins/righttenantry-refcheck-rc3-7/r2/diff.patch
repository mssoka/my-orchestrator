@@ -0,0 +1,125 @@
+//// Shared input-gathering helpers for the AD-10 fraud-signals builder
+//// (rc3-7). `fraud.gleam` is the pure builder; this module owns the small
+//// DB + parsing glue both call sites (trigger at creation, form_handler at
+//// submission) share, so the two do not drift (DRY — extracted after Perkins
+//// r1 W1). Best-effort throughout: a query failure degrades to honest
+//// defaults (empty other-refs, not-flagged cross-app) — never blocks the
+//// caller, never fabricates a signal (AD-10).
+
+import gleam/int
+import gleam/list
+import gleam/option.{type Option, None, Some}
+import pog
+import reference_checks/fraud
+import reference_checks/sql
+import youid/uuid
+
+/// '' -> None, else Some(value). The effective-contact columns read as '' for
+/// a referee with no contact of that kind (the COALESCE-to-'' convention).
+pub fn opt_nonempty(value: String) -> Option(String) {
+  case value {
+    "" -> None
+    other -> Some(other)
+  }
+}
+
+/// None -> '' (the SQL TEXT-param convention — pass Option(String) to a TEXT
+/// param as '').
+pub fn opt_to_str(o: Option(String)) -> String {
+  case o {
+    Some(s) -> s
+    None -> ""
+  }
+}
+
+/// Parse the cross-application reuse count ('' / unparseable -> 0).
+pub fn parse_count(text: String) -> Int {
+  case int.parse(text) {
+    Ok(n) -> n
+    Error(_) -> 0
+  }
+}
+
+/// Parse the SQL-derived completion_seconds text ('' -> None: the form was
+/// never opened, or the value is unparseable).
+pub fn parse_int_opt(text: String) -> Option(Int) {
+  case text {
+    "" -> None
+    other ->
+      case int.parse(other) {
+        Ok(n) -> Some(n)
+        Error(_) -> None
+      }
+  }
+}
+
+/// Effective contact = corrected value when present (non-empty), else the
+/// immutable snapshot (AD-7). A corrected '' is treated as absent (falls back
+/// to the snapshot), matching the SQL `NULLIF(corrected,'')` convention.
+pub fn effective_contact(
+  corrected: Option(String),
+  snapshot: Option(String),
+) -> Option(String) {
+  case corrected {
+    Some(c) ->
+      case opt_nonempty(c) {
+        Some(v) -> Some(v)
+        None -> snapshot
+      }
+    None -> snapshot
+  }
+}
+
+/// Build a `RefContact` from the SQL row's effective columns (name +
+/// effective_email/phone, already COALESCE'd to '' for absent).
+pub fn from_effective(
+  name name: String,
+  effective_email effective_email: String,
+  effective_phone effective_phone: String,
+) -> fraud.RefContact {
+  fraud.RefContact(
+    name:,
+    email: opt_nonempty(effective_email),
+    phone: opt_nonempty(effective_phone),
+  )
+}
+
+/// The application's OTHER reference rows' effective contacts (excludes
+/// `exclude_id`), for `contact_reused_within_application` (per-ref
+/// involvement: does THIS ref's contact appear in another slot?). Pure —
+/// caller reads the rows once (via `get_application_reference_contacts`) and
+/// passes them in; this just filters + maps. Best-effort at the read is the
+/// caller's concern (an empty list reads as no reuse).
+pub fn other_refs_from_rows(
+  rows: List(sql.GetApplicationReferenceContactsRow),
+  exclude_id exclude_id: String,
+) -> List(fraud.RefContact) {
+  rows
+  |> list.filter(fn(r) { r.id != exclude_id })
+  |> list.map(fn(r) {
+    from_effective(r.contact_name, r.effective_email, r.effective_phone)
+  })
+}
+
+/// `contact_reused_across_applications` (AD-10): true iff this referee's
+/// effective contact appears under a DIFFERENT name in another application's
+/// reference rows (the innocent same-name letting agent does NOT flag).
+/// Best-effort: a query failure reads as not-flagged.
+pub fn cross_application_reuse(
+  db: pog.Connection,
+  app_uuid: uuid.Uuid,
+  this_ref this_ref: fraud.RefContact,
+) -> Bool {
+  case
+    sql.count_cross_application_contact_reuse(
+      db,
+      app_uuid,
+      this_ref.name,
+      opt_to_str(this_ref.email),
+      opt_to_str(this_ref.phone),
+    )
+  {
+    Ok(pog.Returned(_, [row, ..])) -> parse_count(row.reuse_count) > 0
+    _ -> False
+  }
+}
