+pub fn line_type_from_string_round_trips_test() {
+  // Every emitted signal string maps back to its LineType.
+  lookup.line_type_from_string("mobile") |> should.equal(lookup.Mobile)
+  lookup.line_type_from_string("landline") |> should.equal(lookup.Landline)
