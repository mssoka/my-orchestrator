+// -- Phase 1 fraud-signals stamp (rc3-7, AD-10) ------------------------------
+
+/// Stamp the creation-time `fraud_signals` on the application's NEWLY-CREATED
+/// reference rows only: pure-DB reuse signals + the Twilio line-type lookup +
+/// honest placeholders (`form_session: null`). Runs AFTER the creation tx
+/// commits so the reuse reads see the rows and the line-type HTTP lookup
+/// never holds the insert tx. Best-effort throughout — a failure leaves that
+/// row's `fraud_signals` null honestly (AD-10) and logs, never failing the
+/// trigger.
+///
+/// `created_ids` scopes the stamp to the rows this trigger call inserted (B1:
+/// `handle_start` re-fires the trigger on demand, so re-triggers are a
+/// supported operation — a wholesale re-stamp would wipe a submitted
+/// sibling's `form_session`). Empty `created_ids` (a pure re-trigger no-op)
+/// stamps nothing. The reuse COMPUTATION still reads the application's full
+/// reference set; only the WRITE is scoped to the new rows.
+fn stamp_creation_fraud(
+  config: ServerConfig,
+  app_uuid: Uuid,
+  data: sql.GetApplicationReferenceDataRow,
+  created_ids: List(String),
+) -> Nil {
+  case created_ids {
+    [] -> Nil
+    _ ->
+      case sql.get_application_reference_contacts(config.db, app_uuid) {
+        Ok(pog.Returned(_, all_refs)) -> {
+          let applicant =
+            fraud.RefContact(
+              // name is unused for duplicate_of_applicant (email/phone only).
+              name: "",
+              email: Some(data.applicant_email),
+              phone: data.applicant_phone,
+            )
+          // Stamp ONLY the newly-created rows (never a submitted sibling).
+          let to_stamp =
+            list.filter(all_refs, fn(r) { list.contains(created_ids, r.id) })
+          list.each(to_stamp, fn(ref) {
+            stamp_one_creation_fraud(config, app_uuid, ref, all_refs, applicant)
+          })
+        }
+        _ ->
+          // Read failure — best-effort: leave fraud_signals null.
+          wisp.log_warning(
+            "stamp_creation_fraud: could not read reference contacts for "
+            <> uuid.to_string(app_uuid),
+          )
+      }
+  }
+}
+
+fn stamp_one_creation_fraud(
+  config: ServerConfig,
+  app_uuid: Uuid,
+  ref: sql.GetApplicationReferenceContactsRow,
+  all_refs: List(sql.GetApplicationReferenceContactsRow),
+  applicant: fraud.RefContact,
+) -> Nil {
+  let this_ref =
+    fraud_inputs.from_effective(
+      ref.contact_name,
+      ref.effective_email,
+      ref.effective_phone,
+    )
+  let other_refs = fraud_inputs.other_refs_from_rows(all_refs, ref.id)
+  let cross_app =
+    fraud_inputs.cross_application_reuse(config.db, app_uuid, this_ref)
+  // Line-type lookup (AD-10): only when the referee has a phone. No-ops to
+  // Unknown when Twilio is unconfigured or the lookup fails — never blocks.
+  let line_type = case this_ref.phone {
+    Some(phone) -> lookup.lookup_line_type(config.twilio, config.sentry, phone)
+    None -> lookup.Unknown
+  }
+  let signals =
+    fraud.creation_fraud_signals(
+      fraud.FraudDbInputs(
+        this_ref:,
+        other_application_refs: other_refs,
+        applicant:,
+        cross_app_reuse: cross_app,
+      ),
+      line_type,
+    )
+  case uuid.from_string(ref.id) {
+    Ok(id) ->
+      case sql.stamp_creation_fraud_signals(config.db, id, signals) {
+        Ok(_) -> Nil
+        Error(err) ->
+          wisp.log_warning(
+            "stamp_creation_fraud: stamp failed for "
+            <> ref.id
+            <> ": "
+            <> string.inspect(err),
+          )
+      }
+    Error(_) ->
+      wisp.log_warning("stamp_creation_fraud: non-uuid reference id " <> ref.id)
+  }
+}
