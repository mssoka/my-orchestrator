+/// The fraud-signal string for a line type (AD-10 `line_type`): `"mobile"`,
+/// `"landline"`, `"voip"`, `"unknown"`. `Unknown` covers both the genuine
+/// indeterminate case and the no-keys no-op path — the honest v1 value when
+/// Twilio is unconfigured or the lookup failed (AD-10: never fabricated).
+/// Pure for tests.
+pub fn line_type_to_string(line_type: LineType) -> String {
+  case line_type {
+    Mobile -> "mobile"
+    Landline -> "landline"
+    VoIP -> "voip"
+    Unknown -> "unknown"
+  }
+}
+
+/// Inverse of `line_type_to_string` — map a stored `line_type` signal string
+/// back to a `LineType`. `Unknown` covers `"unknown"` + any unmapped value
+/// (the honest fallback — never fabricated). Pure for tests.
+pub fn line_type_from_string(text: String) -> LineType {
+  case text {
+    "mobile" -> Mobile
+    "landline" -> Landline
+    "voip" -> VoIP
+    _ -> Unknown
+  }
+}
