diff --git a/server/test/integration/reference_checks_fraud_integration_test.gleam b/server/test/integration/reference_checks_fraud_integration_test.gleam
new file mode 100644
index 00000000..c85f555d
--- /dev/null
+++ b/server/test/integration/reference_checks_fraud_integration_test.gleam
@@ -0,0 +1,263 @@
+//// Integration tests for rc3-7 fraud-signals SQL contracts (AD-10): the
+//// cross-application reuse read (innocent letting-agent vs suspicious
+//// different-name), the creation-time `fraud_signals` stamp, and the
+//// `referee_contact_invalid` jsonb_set stamp (preserves the other keys, §6.4,
+//// and handles a null column honestly). The pure `fraud.gleam` builder is
+//// unit-tested; the form_handler Phase 2 wiring is exercised by the form
+//// integration suite. These pin the SQL contracts the builders + wiring
+//// depend on, durably (the lowest layer).
+////
+//// Assertions parse the stored `fraud_signals::text` (Postgres jsonb output
+//// carries a space after `:`) rather than substring-matching, so they are
+//// robust to the jsonb text formatting.
+
+import gleam/dict
+import gleam/dynamic/decode
+import gleam/int
+import gleam/json
+import gleam/option
+import gleam/result
+import gleeunit/should
+import integration/helpers.{setup}
+import integration/test_db
+import pog
+import reference_checks/fraud
+import reference_checks/lookup
+import reference_checks/sql as rc_sql
+import unitest
+import youid/uuid
+
+fn seed_app(db: pog.Connection, email: String) -> String {
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 0)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let assert Ok(application_id) =
+    test_db.seed_application(db, vacancy_id, email)
+  application_id
+}
+
+/// Insert a landlord_ref row with the given contact (non-idempotent insert —
+/// the test owns seeding order). Returns the row id.
+fn insert_call(
+  db: pog.Connection,
+  application_id: String,
+  name: String,
+  email: String,
+  phone: String,
+) -> String {
+  let assert Ok(app_uuid) = uuid.from_string(application_id)
+  let assert Ok(returned) =
+    rc_sql.insert_reference_call(
+      db,
+      app_uuid,
+      "landlord_ref",
+      "primary",
+      name,
+      email,
+      phone,
+    )
+  case returned.rows {
+    [row, ..] -> row.id
+    _ -> panic as "insert_reference_call returned no id"
+  }
+}
+
+/// Read a row's `fraud_signals` column back as text ('' when null).
+fn fraud_signals_text(db: pog.Connection, id: String) -> String {
+  let assert Ok(row_uuid) = uuid.from_string(id)
+  let assert Ok(returned) = rc_sql.get_reference_call_by_id(db, row_uuid)
+  case returned.rows {
+    [row, ..] -> row.fraud_signals
+    _ -> panic as "get_reference_call_by_id returned no row"
+  }
+}
+
+/// The reuse count for a referee contact (parsed from the ::text result).
+fn reuse_count(
+  db: pog.Connection,
+  this_app: String,
+  name: String,
+  email: String,
+  phone: String,
+) -> Int {
+  let assert Ok(app_uuid) = uuid.from_string(this_app)
+  let assert Ok(returned) =
+    rc_sql.count_cross_application_contact_reuse(
+      db,
+      app_uuid,
+      name,
+      email,
+      phone,
+    )
+  case returned.rows {
+    [row, ..] ->
+      case int.parse(row.reuse_count) {
+        Ok(n) -> n
+        Error(_) -> 0
+      }
+    _ -> 0
+  }
+}
+
+/// A realistic creation-time fraud_signals object for "Mary Ref".
+fn mary_signals(line_type line_type: lookup.LineType) -> json.Json {
+  fraud.creation_fraud_signals(
+    fraud.FraudDbInputs(
+      this_ref: fraud.RefContact(
+        name: "Mary Ref",
+        email: option.Some("mary@example.com"),
+        phone: option.Some("+353861111111"),
+      ),
+      other_application_refs: [],
+      applicant: fraud.RefContact(
+        name: "",
+        email: option.Some("a@example.com"),
+        phone: option.None,
+      ),
+      cross_app_reuse: False,
+    ),
+    line_type,
+  )
+}
+
+/// A top-level key is present in the stored fraud_signals jsonb.
+fn has_key(text: String, key: String) -> Bool {
+  case json.parse(text, decode.dict(decode.string, decode.dynamic)) {
+    Ok(map) -> dict.has_key(map, key)
+    Error(_) -> False
+  }
+}
+
+/// A top-level string field's value in the stored fraud_signals jsonb.
+fn string_field(text: String, key: String) -> String {
+  let assert Ok(value) = json.parse(text, decode.at([key], decode.string))
+  value
+}
+
+/// A top-level bool field's value in the stored fraud_signals jsonb.
+fn bool_field(text: String, key: String) -> Bool {
+  let assert Ok(value) = json.parse(text, decode.at([key], decode.bool))
+  value
+}
