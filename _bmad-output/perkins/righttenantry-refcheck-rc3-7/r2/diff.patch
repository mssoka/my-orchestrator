+       -- form_opened_at -> now; '' when the form was never opened).
+       a.email                    AS applicant_email,
+       a.phone                    AS applicant_phone,
+       a.submitted_ip_text,
+       a.submitted_user_agent,
+       COALESCE(rc.fraud_signals::text, '') AS fraud_signals,
+       COALESCE((EXTRACT(EPOCH FROM (now() - rc.form_opened_at))::int)::text, '') AS completion_seconds,
        l.name                     AS landlord_display_name,
        v.origin_domain
 FROM reference_call rc
diff --git a/server/src/reference_checks/sql/stamp_creation_fraud_signals.sql b/server/src/reference_checks/sql/stamp_creation_fraud_signals.sql
new file mode 100644
index 00000000..77db9cf2
--- /dev/null
+++ b/server/src/reference_checks/sql/stamp_creation_fraud_signals.sql
@@ -0,0 +1,18 @@
+-- Phase 1 (rc3-7, AD-10): write the creation-time `fraud_signals` to the
+-- column right after row creation. The pure-DB reuse signals + the Twilio
+-- line-type lookup + the honest placeholders (`form_session: null`). `result`
+-- stays null until terminal — only the `fraud_signals` column is written at
+-- creation, so fraud review can query pre-submission (§7.3: line-type + DB
+-- checks run at creation). Best-effort: the row exists regardless of this
+-- stamp; a stamp failure leaves `null` `fraud_signals` honestly (AD-10).
+--
+-- The caller (trigger) computes the signals in Gleam (pure) from the
+-- in-memory referee trios + the applicant's own contact + the cross-app
+-- reuse read + the line-type lookup, then passes the json.Json value here
+-- (Squirrel types the ::jsonb param as Json and serialises it itself).
+--- stamp_creation_fraud_signals(reference_call_id: UUID, fraud_signals: JSONB)
+UPDATE reference_call
+SET fraud_signals = $2::jsonb,
+    updated_at   = now()
+WHERE id = $1
+RETURNING id::text;
diff --git a/server/src/reference_checks/sql/stamp_referee_contact_invalid.sql b/server/src/reference_checks/sql/stamp_referee_contact_invalid.sql
new file mode 100644
index 00000000..e9587ada
--- /dev/null
+++ b/server/src/reference_checks/sql/stamp_referee_contact_invalid.sql
@@ -0,0 +1,24 @@
+-- referee_contact_invalid (AD-7, §6.4): stamp the claim-integrity signal when
+-- a correction cycle exhausts — the row moves awaiting_correction -> unreachable
+-- on its SECOND failure. Supersedes heist-535's referee_number_wrong (the same
+-- signal, widened to email bounces as well as bad phone numbers).
+--
+-- rc3-7 provides the MECHANISM only; the LIVE second-failure terminal
+-- (awaiting_correction -> unreachable) is RC4.3 (needs a correction-timeout
+-- SLA the arch does not specify). rc3-7 never fabricates the signal — both
+-- builders keep it absent; this stamp is what RC4.3 calls on exhaustion.
+--
+-- jsonb_set adds the key to whatever `fraud_signals` already holds (the
+-- creation-time DB + line-type signals) without disturbing the other keys;
+-- COALESCE to '{}' so a null column (a pre-rc3-7 row) is handled honestly.
+-- The caller guards the transition; the UPDATE is by id.
+--- stamp_referee_contact_invalid(reference_call_id: UUID)
+UPDATE reference_call
+SET fraud_signals = jsonb_set(
+      COALESCE(fraud_signals, '{}'::jsonb),
+      '{referee_contact_invalid}',
+      'true'::jsonb
+    ),
+    updated_at = now()
+WHERE id = $1
+RETURNING id::text;
