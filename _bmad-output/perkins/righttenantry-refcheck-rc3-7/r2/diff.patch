+// -- AC4: innocent reuse (same name) vs suspicious (different name) ----------
+
+pub fn cross_app_reuse_innocent_letting_agent_same_name_is_zero_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let app_a = seed_app(db, "a@example.com")
+  let app_b = seed_app(db, "b@example.com")
+  // A letting agent legitimately listed under the SAME name + phone across
+  // two applications — innocent, NOT fraud (AD-10).
+  let _ = insert_call(db, app_a, "Legit Lettings", "", "+353860000000")
+  let _ = insert_call(db, app_b, "Legit Lettings", "", "+353860000000")
+  reuse_count(db, app_a, "Legit Lettings", "", "+353860000000")
+  |> should.equal(0)
+}
+
+pub fn cross_app_reuse_different_name_flags_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let app_a = seed_app(db, "a@example.com")
+  let app_b = seed_app(db, "b@example.com")
+  // Same phone, DIFFERENT names across applications — the suspicious pattern.
+  let _ = insert_call(db, app_a, "Alice Ref", "", "+353860000000")
+  let _ = insert_call(db, app_b, "Bob Ref", "", "+353860000000")
+  reuse_count(db, app_a, "Alice Ref", "", "+353860000000")
+  |> should.equal(1)
+}
+
+pub fn cross_app_reuse_empty_contact_never_matches_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let app_a = seed_app(db, "a@example.com")
+  let app_b = seed_app(db, "b@example.com")
+  // A referee with no phone/email must never read as reused (NULLIF guard).
+  let _ = insert_call(db, app_a, "Alice Ref", "", "")
+  let _ = insert_call(db, app_b, "Bob Ref", "", "")
+  reuse_count(db, app_a, "Alice Ref", "", "")
+  |> should.equal(0)
+}
+
+pub fn cross_app_reuse_excludes_this_application_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let app_a = seed_app(db, "a@example.com")
+  let assert Ok(app_uuid) = uuid.from_string(app_a)
+  // A reuse WITHIN app_a (two slots, different names) must not count as
+  // cross-application (the query excludes this application's own rows).
+  let _ = insert_call(db, app_a, "Alice Ref", "", "+353860000000")
+  let assert Ok(_) =
+    rc_sql.insert_reference_call(
+      db,
+      app_uuid,
+      "employer_ref",
+      "primary",
+      "Erin Ref",
+      "",
+      "+353860000000",
+    )
+  reuse_count(db, app_a, "Alice Ref", "", "+353860000000")
+  |> should.equal(0)
+}
+
+// -- AC2: creation-time fraud_signals stamp ----------------------------------
+
+pub fn creation_stamp_writes_fraud_signals_column_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let app = seed_app(db, "a@example.com")
+  let id = insert_call(db, app, "Mary Ref", "mary@example.com", "+353861111111")
+  let assert Ok(row_uuid) = uuid.from_string(id)
+  // Build a real creation-time fraud_signals object + stamp it.
+  let assert Ok(_) =
+    rc_sql.stamp_creation_fraud_signals(
+      db,
+      row_uuid,
+      mary_signals(lookup.Unknown),
+    )
+  let text = fraud_signals_text(db, id)
+  // The AD-10 honest values land exactly (Unknown line-type here).
+  string_field(text, "line_type") |> should.equal("unknown")
+  string_field(text, "geo_vs_claimed_property") |> should.equal("unknown")
+  // voice + referee_contact_invalid are ABSENT (the keys never exist).
+  has_key(text, "voice_matches_other_reference") |> should.be_false
+  has_key(text, "referee_contact_invalid") |> should.be_false
+}
+
+// -- AC5: referee_contact_invalid jsonb_set stamp (§6.4) ---------------------
+
+pub fn referee_contact_invalid_stamp_adds_flag_preserving_keys_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let app = seed_app(db, "a@example.com")
+  let id = insert_call(db, app, "Mary Ref", "mary@example.com", "+353861111111")
+  let assert Ok(row_uuid) = uuid.from_string(id)
+  // Stamp a creation-time object first (the realistic precondition).
+  let assert Ok(_) =
+    rc_sql.stamp_creation_fraud_signals(
+      db,
+      row_uuid,
+      mary_signals(lookup.Mobile),
+    )
+  // Now the correction-exhaustion stamp (the RC4.3 hook).
+  let assert Ok(_) = rc_sql.stamp_referee_contact_invalid(db, row_uuid)
+  let text = fraud_signals_text(db, id)
+  bool_field(text, "referee_contact_invalid") |> should.be_true
+  // jsonb_set preserved the creation-time keys (not a wholesale overwrite).
+  string_field(text, "line_type") |> should.equal("mobile")
+  has_key(text, "contact_reused_within_application") |> should.be_true
+}
+
+pub fn referee_contact_invalid_stamp_handles_null_column_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let app = seed_app(db, "a@example.com")
+  // A row whose fraud_signals is still null (a pre-rc3-7 row, or a creation
+  // stamp that failed). The COALESCE-to-'{}' must handle it honestly.
+  let id = insert_call(db, app, "Mary Ref", "mary@example.com", "+353861111111")
+  let assert Ok(row_uuid) = uuid.from_string(id)
+  fraud_signals_text(db, id) |> should.equal("")
+  let assert Ok(_) = rc_sql.stamp_referee_contact_invalid(db, row_uuid)
+  let text = fraud_signals_text(db, id)
+  bool_field(text, "referee_contact_invalid") |> should.be_true
+}
