+// --- rc3-7 fraud-signals: creation stamp (W3) + re-trigger idempotency (B1) ---
+
+/// The `fraud_signals` column text for a slot's row ('' when null).
+fn fraud_signals_for_slot(
+  db: pog.Connection,
+  application_id: String,
+  slot: String,
+) -> String {
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT COALESCE(fraud_signals::text, '') FROM reference_call
+       WHERE application_id = $1 AND ref_slot = $2 AND owner_label = 'primary'",
+    )
+    |> pog.parameter(pog.text(application_id))
+    |> pog.parameter(pog.text(slot))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  case returned.rows {
+    [text, ..] -> text
+    _ -> ""
+  }
+}
+
+/// Stamp an arbitrary fraud_signals json on a slot's row (test-only —
+/// simulates a submitted row carrying a form_session block).
+fn stamp_fraud_signals_raw(
+  db: pog.Connection,
+  application_id: String,
+  slot: String,
+  json_text: String,
+) -> Nil {
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE reference_call SET fraud_signals = $3::jsonb, updated_at = now()
+       WHERE application_id = $1 AND ref_slot = $2 AND owner_label = 'primary'",
+    )
+    |> pog.parameter(pog.text(application_id))
+    |> pog.parameter(pog.text(slot))
+    |> pog.parameter(pog.text(json_text))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  Nil
+}
+
+/// AC2 / W3: the trigger stamps the creation-time fraud_signals on each
+/// newly-created row (the orchestrator glue, not just the SQL contract).
+pub fn trigger_stamps_creation_fraud_signals_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id) =
+    seed_full_app(db, "rc3-fraud-a@example.com", False, "attested")
+  let #(landlord, vacancy, app) = uuids(landlord_id, vacancy_id, app_id)
+
+  let _ = trigger.run_create_checks(config, app, landlord, vacancy)
+
+  // Each created row carries the creation-time fraud_signals (the keys are
+  // present; values are honest — line_type unknown here since Twilio is
+  // Disabled in the test config).
+  let landlord_fs = fraud_signals_for_slot(db, app_id, "landlord_ref")
+  landlord_fs |> string.contains("line_type") |> should.be_true
+  landlord_fs
+  |> string.contains("contact_reused_within_application")
+  |> should.be_true
+  landlord_fs |> string.contains("geo_vs_claimed_property") |> should.be_true
+  // form_session is null at creation (no form yet).
+  landlord_fs |> string.contains("\"form_session\": null") |> should.be_true
+  // The honest-absent keys are absent.
+  landlord_fs
+  |> string.contains("voice_matches_other_reference")
+  |> should.be_false
+  landlord_fs |> string.contains("referee_contact_invalid") |> should.be_false
+}
+
+/// B1 regression: a re-trigger (idempotent, inserted==0) must NOT wipe a
+/// submitted sibling's fraud_signals. `handle_start` re-fires the trigger on
+/// demand, so re-triggers are a supported operation; the creation stamp is
+/// scoped to newly-created rows only.
+pub fn re_trigger_does_not_wipe_submitted_fraud_signals_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id) =
+    seed_full_app(db, "rc3-fraud-b@example.com", False, "attested")
+  let #(landlord, vacancy, app) = uuids(landlord_id, vacancy_id, app_id)
+
+  let _ = trigger.run_create_checks(config, app, landlord, vacancy)
+  // Simulate a SUBMITTED landlord row: stamp a submitted-shape fraud_signals
+  // carrying a form_session block (completion_seconds etc.).
+  stamp_fraud_signals_raw(
+    db,
+    app_id,
+    "landlord_ref",
+    "{\"line_type\":\"mobile\",\"form_session\":{\"completion_seconds\":120,\"ip_matches_applicant\":true},\"geo_vs_claimed_property\":\"unknown\",\"coached_answer_score\":null}",
+  )
+
+  // Re-trigger (idempotent — no new rows).
+  let second = trigger.run_create_checks(config, app, landlord, vacancy)
+  second |> should.equal(Ok(trigger.Created(count: 0)))
+
+  // B1: the submitted fraud_signals SURVIVES — the completion_seconds key
+  // (present only in the submitted form_session block, never in the
+  // creation-time object whose form_session is null) is still there. A wipe
+  // would replace it with creation-time signals (form_session: null).
+  let after = fraud_signals_for_slot(db, app_id, "landlord_ref")
+  after |> string.contains("completion_seconds") |> should.be_true
+  after |> string.contains("\"form_session\": null") |> should.be_false
+}
+
+/// B1 (sibling): a re-trigger that creates a NEW row (a freed slot) must not
+/// wipe a submitted SIBLING. The stamp is scoped to created_ids, not the
+/// whole application.
+pub fn re_trigger_new_row_does_not_wipe_submitted_sibling_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id) =
+    seed_full_app(db, "rc3-fraud-c@example.com", False, "attested")
+  let #(landlord, vacancy, app) = uuids(landlord_id, vacancy_id, app_id)
+
+  let _ = trigger.run_create_checks(config, app, landlord, vacancy)
+  // Simulate a submitted landlord row.
+  stamp_fraud_signals_raw(
+    db,
+    app_id,
+    "landlord_ref",
+    "{\"line_type\":\"mobile\",\"form_session\":{\"completion_seconds\":240},\"geo_vs_claimed_property\":\"unknown\",\"coached_answer_score\":null}",
+  )
+  // Terminalize the employer slot so a re-trigger can create a NEW employer
+  // row (the live-slot unique index frees the slot once terminal). Then re-fire.
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE reference_call SET status = 'failed', next_attempt_at = NULL
+       WHERE application_id = $1 AND ref_slot = 'employer_ref' AND owner_label = 'primary'",
+    )
+    |> pog.parameter(pog.text(app_id))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  let second = trigger.run_create_checks(config, app, landlord, vacancy)
+  // A new employer row is created (the slot freed); the submitted landlord
+  // sibling must be untouched.
+  second |> should.equal(Ok(trigger.Created(count: 1)))
+  let landlord_after = fraud_signals_for_slot(db, app_id, "landlord_ref")
+  landlord_after |> string.contains("completion_seconds") |> should.be_true
+  landlord_after
+  |> string.contains("\"form_session\": null")
+  |> should.be_false
+}
