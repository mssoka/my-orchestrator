diff --git a/server/test/reference_checks/fraud_test.gleam b/server/test/reference_checks/fraud_test.gleam
new file mode 100644
index 00000000..5f7ed621
--- /dev/null
+++ b/server/test/reference_checks/fraud_test.gleam
@@ -0,0 +1,297 @@
+//// Unit tests for reference_checks/fraud — the AD-10 honest fraud-signals
+//// builder. Pure — no DB. Pins: every signal in the AD-10 table, the honest
+//// placeholders EXACTLY (geo "unknown", coached null, voice ABSENT,
+//// referee_contact_invalid ABSENT), the innocent-reuse read, the weak UA
+//// compare, and the §4.2 raw-IP/UA containment inside form_session.
+
+import gleam/json
+import gleam/option.{None, Some}
+import gleam/string
+import gleeunit/should
+import reference_checks/fraud
+import reference_checks/lookup
+
+// -- helpers ------------------------------------------------------------------
+
+fn as_text(j: json.Json) -> String {
+  json.to_string(j)
+}
+
+fn applicant() -> fraud.RefContact {
+  fraud.RefContact(
+    name: "Aisling",
+    email: Some("aisling@mail.ie"),
+    phone: Some("+353860000000"),
+  )
+}
+
+/// A landlord referee whose contact is NOT the applicant's and NOT reused.
+fn clean_landlord_ref() -> fraud.RefContact {
+  fraud.RefContact(
+    name: "Mary",
+    email: Some("mary@mail.ie"),
+    phone: Some("+353861111111"),
+  )
+}
+
+fn empty_db() -> fraud.FraudDbInputs {
+  fraud.FraudDbInputs(
+    this_ref: clean_landlord_ref(),
+    other_application_refs: [],
+    applicant: applicant(),
+    cross_app_reuse: False,
+  )
+}
+
+fn fs(ip ip: String, ua ua: String) -> fraud.FormSessionInputs {
+  fraud.FormSessionInputs(
+    referee_ip: ip,
+    referee_user_agent: ua,
+    applicant_ip: "203.0.113.10",
+    applicant_user_agent: "Mozilla/5.0 (applicant)",
+    completion_seconds: Some(312),
+    focus_seconds: 280,
+  )
+}
+
+// -- AC1: the AD-10 table, exactly + honestly ---------------------------------
+
+pub fn creation_emits_every_ad10_signal_test() {
+  let text = as_text(fraud.creation_fraud_signals(empty_db(), lookup.Mobile))
+  // The three pure-DB reuse signals.
+  text
+  |> string.contains("\"contact_reused_within_application\":false")
+  |> should.be_true
+  text
+  |> string.contains("\"contact_duplicate_of_applicant\":false")
+  |> should.be_true
+  text
+  |> string.contains("\"contact_reused_across_applications\":false")
+  |> should.be_true
+  // Line-type (carried from the lookup) + voip_or_burner.
+  text |> string.contains("\"line_type\":\"mobile\"") |> should.be_true
+  text |> string.contains("\"voip_or_burner\":false") |> should.be_true
+  // Honest placeholders — EXACTLY these values, never a guess.
+  text
+  |> string.contains("\"geo_vs_claimed_property\":\"unknown\"")
+  |> should.be_true
+  text |> string.contains("\"coached_answer_score\":null") |> should.be_true
+  // form_session is null at creation (no form yet).
+  text |> string.contains("\"form_session\":null") |> should.be_true
+}
+
+pub fn creation_line_type_unknown_is_honest_test() {
+  // No Twilio keys / lookup failed -> Unknown -> "unknown" + voip false.
+  // Never a fabricated value (AD-10 honesty).
+  let text = as_text(fraud.creation_fraud_signals(empty_db(), lookup.Unknown))
+  text |> string.contains("\"line_type\":\"unknown\"") |> should.be_true
+  text |> string.contains("\"voip_or_burner\":false") |> should.be_true
+}
+
+pub fn voice_matches_other_reference_is_absent_test() {
+  // v3 biometric — the key is NEVER emitted (AD-10 absence contract).
+  let text = as_text(fraud.creation_fraud_signals(empty_db(), lookup.Mobile))
+  text
+  |> string.contains("voice_matches_other_reference")
+  |> should.be_false
+}
+
+pub fn referee_contact_invalid_is_absent_until_exhaustion_test() {
+  // rc3-7 never fabricates this signal; it is stamped only by the RC4.3
+  // correction-exhaustion path. Both builders emit it ABSENT.
+  let creation =
+    as_text(fraud.creation_fraud_signals(empty_db(), lookup.Mobile))
+  let submission =
+    as_text(fraud.submission_fraud_signals(
+      empty_db(),
+      lookup.Mobile,
+      fs("", ""),
+    ))
+  creation |> string.contains("referee_contact_invalid") |> should.be_false
+  submission |> string.contains("referee_contact_invalid") |> should.be_false
+}
+
+// -- AC2 / AC3: form_session at submission; raw IP/UA internal-only ----------
+
+pub fn submission_computes_form_session_test() {
+  let text =
+    as_text(fraud.submission_fraud_signals(
+      empty_db(),
+      lookup.Mobile,
+      fs("203.0.113.10", "Mozilla/5.0 (applicant)"),
+    ))
+  // completion_seconds carried through.
+  text |> string.contains("\"completion_seconds\":312") |> should.be_true
+  // ip_matches_applicant: referee IP == applicant IP -> true.
+  text |> string.contains("\"ip_matches_applicant\":true") |> should.be_true
+  // device_fingerprint_match: referee UA == applicant UA -> true (weak).
+  text
+  |> string.contains("\"device_fingerprint_match\":true")
+  |> should.be_true
+  text |> string.contains("\"focus_seconds_reported\":280") |> should.be_true
+}
+
+pub fn submission_mismatch_is_false_not_null_test() {
+  // Both present + different -> Some(False), not None (a real non-match).
+  let text =
+    as_text(fraud.submission_fraud_signals(
+      empty_db(),
+      lookup.Mobile,
+      fs("198.51.100.9", "Mozilla/5.0 (different)"),
+    ))
+  text |> string.contains("\"ip_matches_applicant\":false") |> should.be_true
+  text
+  |> string.contains("\"device_fingerprint_match\":false")
+  |> should.be_true
+}
+
+pub fn submission_missing_applicant_ip_is_null_test() {
+  // Applicant capture absent -> None (unknown — never fabricated).
+  let inputs =
+    fraud.FormSessionInputs(
+      referee_ip: "203.0.113.10",
+      referee_user_agent: "Mozilla/5.0 (ref)",
+      applicant_ip: "",
+      applicant_user_agent: "Mozilla/5.0 (applicant)",
+      completion_seconds: Some(100),
+      focus_seconds: 90,
+    )
+  let text =
+    as_text(fraud.submission_fraud_signals(empty_db(), lookup.Mobile, inputs))
+  text |> string.contains("\"ip_matches_applicant\":null") |> should.be_true
+}
+
+pub fn raw_ip_ua_live_inside_form_session_test() {
+  // §4.2: raw IPs/UAs live INSIDE form_session (internal-only; RC4.1 strips).
+  let text =
+    as_text(fraud.submission_fraud_signals(
+      empty_db(),
+      lookup.Mobile,
+      fs("203.0.113.10", "Mozilla/5.0 (ref)"),
+    ))
+  text
+  |> string.contains("\"referee_ip\":\"203.0.113.10\"")
+  |> should.be_true
+  text
+  |> string.contains("\"referee_user_agent\":\"Mozilla/5.0 (ref)\"")
+  |> should.be_true
+}
+
+// -- AC4: innocent reuse is not fraud ----------------------------------------
+
+pub fn innocent_letting_agent_across_apps_is_not_flagged_test() {
+  // The cross-application SQL reads "same contact under a DIFFERENT name".
+  // A letting agent appearing under the SAME name across applications is
+  // innocent -> cross_app_reuse = false -> the signal is false (a clue that
+  // does NOT fire). fraud.gleam honours the precomputed boolean.
+  let innocent = fraud.FraudDbInputs(..empty_db(), cross_app_reuse: False)
+  let text = as_text(fraud.creation_fraud_signals(innocent, lookup.Landline))
+  text
+  |> string.contains("\"contact_reused_across_applications\":false")
+  |> should.be_true
+}
+
+pub fn suspicious_cross_app_reuse_under_different_name_flags_test() {
+  // Same contact under a DIFFERENT name across apps -> the SQL returns true
+  // -> the signal fires (a clue; never a verdict, never auto-reject).
+  let suspicious = fraud.FraudDbInputs(..empty_db(), cross_app_reuse: True)
+  let text = as_text(fraud.creation_fraud_signals(suspicious, lookup.Landline))
+  text
+  |> string.contains("\"contact_reused_across_applications\":true")
+  |> should.be_true
+}
+
+// -- pure-DB reuse + duplicate computations ----------------------------------
+
+pub fn reused_within_application_detects_shared_phone_test() {
+  // Two slots of one application share a phone -> reuse flagged (per-ref).
+  let this =
+    fraud.RefContact(name: "A", email: None, phone: Some("+353860000000"))
+  let other =
+    fraud.RefContact(
+      name: "B",
+      email: Some("b@mail.ie"),
+      phone: Some("+353860000000"),
+    )
+  fraud.reused_within_application(this, [other]) |> should.be_true
+}
+
+pub fn reused_within_application_clean_is_false_test() {
+  let this = clean_landlord_ref()
+  let other =
+    fraud.RefContact(
+      name: "Employer",
+      email: Some("hr@work.ie"),
+      phone: Some("+353862222222"),
+    )
+  fraud.reused_within_application(this, [other]) |> should.be_false
+}
+
+pub fn reused_within_application_empty_contacts_never_match_test() {
+  // A missing phone/email is not "reused" (honesty: absence is not a match).
+  let this = fraud.RefContact(name: "A", email: None, phone: None)
+  let other = fraud.RefContact(name: "B", email: None, phone: None)
+  fraud.reused_within_application(this, [other]) |> should.be_false
+}
+
+pub fn duplicate_of_applicant_flags_shared_email_test() {
+  // Referee email == applicant email -> duplicate (a claim-integrity clue).
+  let ref =
+    fraud.RefContact(
+      name: "Mary",
+      email: Some("aisling@mail.ie"),
+      phone: Some("+353869999999"),
+    )
+  fraud.duplicate_of_applicant(ref, applicant()) |> should.be_true
+}
+
+pub fn duplicate_of_applicant_clean_is_false_test() {
+  fraud.duplicate_of_applicant(clean_landlord_ref(), applicant())
+  |> should.be_false
+}
+
+// -- ip / ua match semantics --------------------------------------------------
+
+pub fn ip_matches_equal_is_true_test() {
+  fraud.ip_matches("203.0.113.10", "203.0.113.10") |> should.equal(Some(True))
+}
+
+pub fn ip_matches_different_is_false_test() {
+  fraud.ip_matches("203.0.113.10", "198.51.100.9") |> should.equal(Some(False))
+}
+
+pub fn ip_matches_missing_is_null_test() {
+  fraud.ip_matches("", "203.0.113.10") |> should.equal(None)
+  fraud.ip_matches("203.0.113.10", "") |> should.equal(None)
+}
+
+pub fn ua_matches_semantics_mirror_ip_test() {
+  // Weak (UA compare), but the match semantics mirror ip_matches.
+  fraud.ua_matches("Mozilla/5.0 (x)", "Mozilla/5.0 (x)")
+  |> should.equal(Some(True))
+  fraud.ua_matches("Mozilla/5.0 (x)", "curl/8.0") |> should.equal(Some(False))
+  fraud.ua_matches("", "Mozilla/5.0 (x)") |> should.equal(None)
+}
+
+// -- carry_line_type (D3: carry the creation-time line_type at submission) ----
+
+pub fn carry_line_type_empty_is_unknown_test() {
+  // A pre-rc3-7 row, or a creation stamp that failed -> Unknown (honest).
+  fraud.carry_line_type("") |> should.equal(lookup.Unknown)
+}
+
+pub fn carry_line_type_valid_maps_back_test() {
+  let signals =
+    "{\"line_type\":\"mobile\",\"form_session\":null,\"geo_vs_claimed_property\":\"unknown\"}"
+  fraud.carry_line_type(signals) |> should.equal(lookup.Mobile)
+}
+
+pub fn carry_line_type_missing_key_is_unknown_test() {
+  // No line_type key -> Unknown (honest — never fabricated).
+  fraud.carry_line_type("{\"form_session\":null}")
+  |> should.equal(lookup.Unknown)
+}
+
+pub fn carry_line_type_unparseable_is_unknown_test() {
+  fraud.carry_line_type("not json at all") |> should.equal(lookup.Unknown)
+}
