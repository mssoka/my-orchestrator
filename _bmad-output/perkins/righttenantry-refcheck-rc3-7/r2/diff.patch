+// -- Phase 2 fraud-signals build (rc3-7, AD-10) -------------------------------
+
+/// Build the submission-time `fraud_signals` (AD-10): re-run the pure-DB
+/// reuse signals (contacts can change via the correction loop), carry the
+/// creation-time line-type (no paid re-lookup), and compute the full
+/// `form_session` block — completion_seconds, ip_matches_applicant,
+/// device_fingerprint_match (a UA compare, labelled weak),
+/// focus_seconds_reported. Raw referee IP/UA live INSIDE form_session and are
+/// internal-only (§4.2 — RC4.1 strips them at the landlord API boundary).
+/// Best-effort: a fraud-signal query failure degrades to honest defaults
+/// (empty other-refs, not-flagged cross-app), never blocks the submit.
+fn build_submission_fraud_signals(
+  config: ServerConfig,
+  req: Request,
+  row: sql.GetFormContextByFormTokenRow,
+  values: List(#(String, String)),
+) -> json.Json {
+  let this_ref =
+    fraud.RefContact(
+      name: row.contact_name,
+      email: fraud_inputs.effective_contact(
+        row.corrected_email,
+        row.contact_email,
+      ),
+      phone: fraud_inputs.effective_contact(
+        row.corrected_phone,
+        row.contact_phone,
+      ),
+    )
+  let applicant =
+    fraud.RefContact(
+      // name is unused for duplicate_of_applicant (email/phone only).
+      name: "",
+      email: Some(row.applicant_email),
+      phone: row.applicant_phone,
+    )
+  let app_uuid = uuid.from_string(row.application_id)
+  let other_refs = case app_uuid {
+    Ok(id) ->
+      case sql.get_application_reference_contacts(config.db, id) {
+        Ok(pog.Returned(_, refs)) ->
+          fraud_inputs.other_refs_from_rows(refs, row.id)
+        _ -> []
+      }
+    Error(_) -> []
+  }
+  let cross_app = case app_uuid {
+    Ok(id) -> fraud_inputs.cross_application_reuse(config.db, id, this_ref)
+    Error(_) -> False
+  }
+  let db =
+    fraud.FraudDbInputs(
+      this_ref:,
+      other_application_refs: other_refs,
+      applicant:,
+      cross_app_reuse: cross_app,
+    )
+  let fs =
+    fraud.FormSessionInputs(
+      referee_ip: request_helpers.client_ip(req),
+      referee_user_agent: request_helpers.client_user_agent(req),
+      applicant_ip: row.submitted_ip_text,
+      applicant_user_agent: row.submitted_user_agent,
+      completion_seconds: fraud_inputs.parse_int_opt(row.completion_seconds),
+      focus_seconds: parse_focus_seconds(values),
+    )
+  fraud.submission_fraud_signals(
+    db,
