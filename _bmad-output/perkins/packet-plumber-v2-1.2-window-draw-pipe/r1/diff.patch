diff --git a/harness/drift.odin b/harness/drift.odin
new file mode 100644
index 0000000..67f8bfe
--- /dev/null
+++ b/harness/drift.odin
@@ -0,0 +1,124 @@
+package main
+
+// drift.odin — the W1 carry-forward from #21: a CI-exercised NEGATIVE test that
+// a deliberately-drifted action log is REJECTED by the replay gate (the #599-r2
+// / verification-gap lesson — the gate's "rejects drift" must be PROVEN in CI,
+// not just asserted locally). For each drift mutation we write the mutated
+// bytes to a temp file and run the REAL replay gate (replay_hashes) against it;
+// every mutation MUST be rejected. If any drift is accepted, the gate is broken
+// and drift_check returns non-zero.
+
+import "core:fmt"
+import "core:os"
+import pp "../core"
+
+// drift_check — for every demo with a blessed log, mutate the log bytes six
+// ways and assert the replay gate rejects each. Returns 0 if every drift was
+// rejected, 1 otherwise.
+drift_check :: proc(cat: ^pp.Catalogs) -> i32 {
+	names, ok := list_demos()
+	if !ok {
+		fmt.eprintln("drift-check: no demos/ directory")
+		return 2
+	}
+	bad := 0
+	checked := 0
+	for name in names {
+		lpath := log_path(name)
+		if !os.exists(lpath) {
+			continue
+		} // skip demos without a blessed log
+		data, err := os.read_entire_file_from_path(lpath, context.allocator)
+		if err != nil {
+			fmt.eprintfln("drift-check: %s: cannot read log: %v", name, err)
+			bad += 1
+			continue
+		}
+		man, okm := read_manifest(manifest_path(name))
+		if !okm {
+			fmt.eprintfln("drift-check: %s: no manifest (bless first)", name)
+			bad += 1
+			continue
+		}
+		ticks := u64(man.ticks)
+
+		mutations := make_drift_mutations(data)
+		for m in mutations {
+			checked += 1
+			tmp := fmt.tprintf("/tmp/pp-drift-%s-%s.bin", name, m.label)
+			if werr := os.write_entire_file(tmp, m.bytes); werr != nil {
+				fmt.eprintfln("drift-check: %s: cannot write %s: %v", name, tmp, werr)
+				bad += 1
+				continue
+			}
+			fails := make([dynamic]string, context.temp_allocator)
+			_, accepted := replay_hashes(tmp, cat, ticks, &fails)
+			delete(fails)
+			if accepted {
+				// the gate ACCEPTED a drifted log — this is the failure we're
+				// here to catch (the gate must REJECT every one of these).
+				fmt.eprintfln("drift-check: %s: FAIL — gate ACCEPTED drifted log (%s)", name, m.label)
+				bad += 1
+			} else {
+				fmt.printf("  drift %-14s %-16s rejected (OK)\n", name, m.label)
+			}
+			os.remove(tmp)
+		}
+		free_all(context.temp_allocator)
+	}
+	if checked == 0 {
+		fmt.eprintln("drift-check: no blessed logs found to mutate (run `harness save` first)")
+		return 2
+	}
+	if bad > 0 {
+		fmt.eprintfln("drift-check: %d/%d mutation(s) NOT rejected — the replay gate is broken", bad, checked)
+		return 1
+	}
+	fmt.eprintfln("drift-check: %d mutation(s) across %d demo(s) all rejected — gate bites (ODN-11)", checked, len(names))
+	return 0
+}
+
+Mutation :: struct {
+	label: string,
+	bytes: []u8,
+}
+
+// mutated — clone src into a new []u8, apply the mutation, return it wrapped.
+// (Module-level so the mutation proc literal doesn't need to capture src —
+// Odin nested procs are non-capturing.)
+mutated :: proc(src: []u8, label: string, mutate: proc(b: []u8)) -> Mutation {
+	c := make([dynamic]u8, len(src), context.temp_allocator)
+	copy(c[:], src)
+	mutate(c[:])
+	return {label = label, bytes = c[:]}
+}
+
+// make_drift_mutations — the six drift classes the replay gate must reject:
+//   catalog_hash / logic_hz header drift (the ODN-11 binding), magic + version
+//   + unknown-tag corruption (log_read rejects), and truncation.
+make_drift_mutations :: proc(src: []u8) -> [dynamic]Mutation {
+	out := make([dynamic]Mutation, 0, 6, context.temp_allocator)
+	// catalog_hash occupies bytes 17..24 (after magic4 + ver4 + seed8 + era1).
+	if len(src) > 24 {
+		append(&out, mutated(src, "catalog_hash", proc(b: []u8) { b[17] ~= 0xFF }))
+	}
+	// logic_hz occupies bytes 25..28.
+	if len(src) > 28 {
+		append(&out, mutated(src, "logic_hz", proc(b: []u8) { b[25] ~= 0x01 }))
+	}
+	if len(src) > 0 {
+		append(&out, mutated(src, "bad_magic", proc(b: []u8) { b[0] ~= 0xFF }))
+	}
+	if len(src) > 4 {
+		append(&out, mutated(src, "bad_version", proc(b: []u8) { b[4] = 99 }))
+	}
+	// unknown command tag (byte 41 = header 33 + apply_tick 8).
+	if len(src) > 41 {
+		append(&out, mutated(src, "bad_tag", proc(b: []u8) { b[41] = 0xFF }))
+	}
+	// truncation — drop the last byte.
+	trunc := make([dynamic]u8, len(src)-1, context.temp_allocator)
+	copy(trunc[:], src[:len(src)-1])
+	append(&out, Mutation{label = "truncated", bytes = trunc[:]})
+	return out
+}
diff --git a/harness/goldens.odin b/harness/goldens.odin
new file mode 100644
index 0000000..f490734
--- /dev/null
+++ b/harness/goldens.odin
@@ -0,0 +1,213 @@
+package main
+
+// goldens.odin — T2 pixel-golden capture + compare + bless + agent-readable
+// diff bundles (arch §10.2/§10.4/§10.5). Zero-tolerance compare on DECODED
+// pixels (never file bytes); the rlsw readback is normalized (vertical flip +
+// BGRA→RGBA swizzle) before compare/export so the compare is byte-exact.
+//
+// T1 (state-hash manifests) lives in manifest.odin. T2 here renders the world
+// pass to the rlsw memory framebuffer (no GPU/display), reads it back, and
+// compares against the blessed PNG.
+
+import "core:fmt"
+import "core:os"
+import "core:strings"
+import rl "vendor:raylib"
+import pp "../core"
+import rnd "../app/render"
+
+Report :: struct {
+	demo:      string,
+	diff_dirs: [dynamic]string,
+}
+
+// Render_Ctx — the harness's render setup: the palette + camera-fit view +
+// whether the rlsw window was initialized. Owned by main, passed to run_demo.
+Render_Ctx :: struct {
+	palette: rnd.Palette,
+	view:    rnd.View,
+	ready:   bool,
+}
+
+// render_setup — load the palette + compute the camera-fit view. Does NOT init
+// raylib (the caller inits the window once for the whole harness run).
+render_setup :: proc(rc: ^Render_Ctx, cat: ^pp.Catalogs) {
+	rc.palette = rnd.palette_load()
+	rc.view.palette = &rc.palette
+	rc.view.catalogs = cat
+	rnd.view_compute(&rc.view, 1280, 720, &cat.balance)
+	rc.ready = true
+}
+
+// --- T2 capture -----------------------------------------------------------------
+
+// Render the world pass headless and read back normalized RGBA pixels. The
+// drag state defaults to {} (no active drag) — the golden frame is a settled
+// drawn-pipe state, not a mid-drag preview (so no HUD text is captured).
+capture_frame :: proc(rc: ^Render_Ctx, topo: ^pp.Topology) -> rl.Image {
+	rl.BeginDrawing()
+	rnd.draw_world(&rc.view, topo, {})
+	rl.EndDrawing()
+	img := rl.LoadImageFromScreen()
+	rl.ImageFlipVertical(&img) // framebuffer readback is bottom-up
+	swizzle_rb(&img)           // rlsw framebuffer is BGRA
+	return img
+}
+
+swizzle_rb :: proc(img: ^rl.Image) {
+	px := rl.LoadImageColors(img^)
+	n := int(img.width) * int(img.height)
+	for i in 0..<n {
+		px[i].r, px[i].b = px[i].b, px[i].r
+	}
+	// build the normalized image struct around the swizzled pixels
+	new_img: rl.Image
+	new_img.data = raw_data(px)
+	new_img.width = img.width
+	new_img.height = img.height
+	new_img.mipmaps = 1
+	new_img.format = .UNCOMPRESSED_R8G8B8A8
+	rl.UnloadImage(img^) // frees the old buffer only (we keep px)
+	img^ = new_img
+}
+
+golden_path :: proc(demo: string, ms: i64) -> string {
+	return fmt.tprintf("goldens/%s/%05dms.png", demo, ms)
+}
+
+write_golden :: proc(demo: string, ms: i64, img: rl.Image) {
+	dir := fmt.tprintf("goldens/%s", demo)
+	mkdir_p(dir)
+	path := golden_path(demo, ms)
+	cpath := strings.clone_to_cstring(path, context.temp_allocator)
+	ok := rl.ExportImage(img, cpath)
+	if !ok {
+		fmt.eprintfln("harness: failed to write %s", path)
+	}
+	rl.UnloadImage(img)
+}
+
+check_golden :: proc(demo: string, ms: i64, img: rl.Image, report: ^Report, fails: ^[dynamic]string) {
+	path := golden_path(demo, ms)
+	if !os.exists(path) {
+		append(fails, fmt.tprintf("T2 %dms: no golden (run `harness save %s` to bless)", ms, demo))
+		append(&report.diff_dirs, save_diff_bundle(demo, ms, img, {}))
+		rl.UnloadImage(img)
+		return
+	}
+	golden := rl.LoadImage(strings.clone_to_cstring(path, context.temp_allocator))
+	mismatch, total, bbox := compare_images(golden, img)
+	if mismatch < 0 {
+		// undecodable or dimension-drifted golden — the pixel tier must fail
+		// loudly, never pass on nothing (review r1 blocker).
+		dir := save_diff_bundle(demo, ms, img, {})
+		append(&report.diff_dirs, dir)
+		append(fails, fmt.tprintf("T2 %dms: golden corrupt or wrong size — cannot compare (re-bless deliberately)", ms))
+	} else if mismatch > 0 {
+		dir := save_diff_bundle(demo, ms, img, golden)
+		append(&report.diff_dirs, dir)
+		append(fails, fmt.tprintf("T2 %dms: %d/%d pixels differ (bbox %v) — diff bundle at %s",
+			ms, mismatch, total, bbox, dir))
+	} else {
+		rl.UnloadImage(img)
+	}
+	rl.UnloadImage(golden)
+}
+
+compare_images :: proc(a, b: rl.Image) -> (mismatched: int, total: int, bbox: [4]int) {
+	if a.width != b.width || a.height != b.height {
+		return -1, 0, {}
+	}
+	pa := rl.LoadImageColors(a)
+	pb := rl.LoadImageColors(b)
+	defer rl.UnloadImageColors(pa)
+	defer rl.UnloadImageColors(pb)
+	total = int(a.width) * int(a.height)
+	bbox = {1 << 30, 1 << 30, -1, -1}
+	for i in 0..<total {
+		if pa[i] != pb[i] {
+			mismatched += 1
+			x := i % int(a.width)
+			y := i / int(a.width)
+			bbox[0] = min(bbox[0], x)
+			bbox[1] = min(bbox[1], y)
+			bbox[2] = max(bbox[2], x)
+			bbox[3] = max(bbox[3], y)
+		}
+	}
+	return mismatched, total, bbox
+}
+
+// expected/actual/diff + diff.json (§10.5 — the agent's entry point on mismatch)
+save_diff_bundle :: proc(demo: string, ms: i64, actual: rl.Image, expected: rl.Image) -> string {
+	dir := fmt.tprintf("goldens/_reports/%s/latest", demo)
+	mkdir_p(dir)
+	base := fmt.tprintf("%05dms", ms)
+	mkdir_p(fmt.tprintf("%s/%s", dir, base))
+	rl.ExportImage(actual, strings.clone_to_cstring(fmt.tprintf("%s/%s/actual.png", dir, base), context.temp_allocator))
+	if expected.width > 0 {
+		rl.ExportImage(expected, strings.clone_to_cstring(fmt.tprintf("%s/%s/expected.png", dir, base), context.temp_allocator))
+		pa := rl.LoadImageColors(expected)
+		pb := rl.LoadImageColors(actual)
+		n := int(expected.width) * int(expected.height)
+		out := make([]rl.Color, n, context.temp_allocator)
+		mismatch, total, bbox := compare_images(expected, actual)
+		for i in 0..<n {
+			if pa[i] != pb[i] {
+				out[i] = {255, 0, 0, 255} // red overlay on change
+			} else {
+				out[i] = {u8(u16(pa[i].r)/3), u8(u16(pa[i].g)/3), u8(u16(pa[i].b)/3), 255}
+			}
+		}
+		dimg: rl.Image
+		dimg.data = raw_data(out)
+		dimg.width = expected.width
+		dimg.height = expected.height
+		dimg.mipmaps = 1
+		dimg.format = .UNCOMPRESSED_R8G8B8A8
+		rl.ExportImage(dimg, strings.clone_to_cstring(fmt.tprintf("%s/%s/diff.png", dir, base), context.temp_allocator))
+		// NOTE: never UnloadImage(dimg) — dimg.data is the Odin temp arena's,
+		// not raylib's; unloading would free a non-raylib pointer.
+		rl.UnloadImageColors(pa)
+		rl.UnloadImageColors(pb)
+		js := fmt.tprintf(`{"frame_ms": %d, "mismatched_pixels": %d, "total_pixels": %d, "bounding_box": [%d, %d, %d, %d]}`,
+			ms, mismatch, total, bbox[0], bbox[1], bbox[2], bbox[3])
+		write_file(fmt.tprintf("%s/%s/diff.json", dir, base), transmute([]u8)js)
+	} else {
+		js := fmt.tprintf(`{"frame_ms": %d, "note": "no golden existed"}`, ms)
+		write_file(fmt.tprintf("%s/%s/diff.json", dir, base), transmute([]u8)js)
+	}
+	return fmt.tprintf("%s/%s", dir, base)
+}
+
+write_report :: proc(report: ^Report, fails: [dynamic]string) {
+	if len(report.diff_dirs) == 0 && len(fails) == 0 {
+		return
+	}
+	dir := fmt.tprintf("goldens/_reports/%s", report.demo)
+	mkdir_p(dir)
+	sb := strings.builder_make(context.temp_allocator)
+	strings.write_string(&sb, "# harness report\n")
+	for f in fails {
+		strings.write_string(&sb, "- ")
+		strings.write_string(&sb, f)
+		strings.write_string(&sb, "\n")
+	}
+	write_file(fmt.tprintf("%s/REPORT.txt", dir), transmute([]u8)strings.to_string(sb))
+}
+
+// recursive mkdir (os.make_directory is single-level)
+mkdir_p :: proc(path: string) {
+	parts := strings.split(path, "/", context.temp_allocator)
+	cur: [dynamic]u8
+	for part, i in parts {
+		if i > 0 {
+			append(&cur, '/')
+		}
+		for c in part {
+			append(&cur, u8(c))
+		}
+		os.make_directory(string(cur[:]))
+	}
+	delete(cur)
+}
