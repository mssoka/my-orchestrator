diff --git a/harness/catalogs.odin b/harness/catalogs.odin
new file mode 100644
index 0000000..371ae14
--- /dev/null
+++ b/harness/catalogs.odin
@@ -0,0 +1,53 @@
+package main
+
+// catalogs.odin — the harness's file-IO + fixture setup. Core is pure (no file
+// I/O — ODN-1), so the harness owns reading data/*.json into bytes and handing
+// them to core's catalogs_load. It also owns seeding the static 1.2 fixture
+// (the hardcoded 3-node map) — run setup that, like the seed, is re-created
+// identically on every replay (NOT part of the action log).
+
+import "core:fmt"
+import "core:os"
+import pp "../core"
+
+// load_catalogs — read the sim-relevant catalogs from data/ and parse them into
+// the caller-owned cat. Returns "" on success, a one-line error otherwise.
+// (palette.json is cosmetic — the render layer loads it, not core.)
+load_catalogs :: proc(cat: ^pp.Catalogs) -> string {
+	src: pp.Catalog_Sources
+	nt, e1 := os.read_entire_file_from_path("data/node_types.json", context.temp_allocator)
+	if e1 != nil { return fmt.tprintf("cannot read data/node_types.json: %v", e1) }
+	pt, e2 := os.read_entire_file_from_path("data/pipe_tiers.json", context.temp_allocator)
+	if e2 != nil { return fmt.tprintf("cannot read data/pipe_tiers.json: %v", e2) }
+	bal, e3 := os.read_entire_file_from_path("data/balance.json", context.temp_allocator)
+	if e3 != nil { return fmt.tprintf("cannot read data/balance.json: %v", e3) }
+	src.node_types = nt
+	src.pipe_tiers = pt
+	src.balance = bal
+	cerr := pp.catalogs_load(cat, &src)
+	if cerr.file != "" {
+		return pp.catalog_error_string(cerr)
+	}
+	return ""
+}
+
+// The 1.2 static fixture: residential(0) ← router(1) → content_host(2), on row
+// y=15, 12 tiles apart. Both spans fit the 'standard' tier (max 14). The player
+// (or demo) draws residential→router then router→content_host. The fixture is
+// DETERMINISTIC — identical positions every replay — so it never needs to ride
+// in the action log (run setup, like the seed).
+//
+// Returns the three node ids in spawn order.
+FIXTURE_RES_POS :: [2]i32{8, 15}
+FIXTURE_RT_POS :: [2]i32{20, 15}
+FIXTURE_HOST_POS :: [2]i32{32, 15}
+
+seed_fixture :: proc(state: ^pp.Run_State, cat: ^pp.Catalogs) -> (u32, u32, u32) {
+	res_idx, _ := pp.node_type_index(cat, "residential")
+	rt_idx, _ := pp.node_type_index(cat, "router_basic")
+	host_idx, _ := pp.node_type_index(cat, "content_host")
+	r := pp.topology_spawn_node(&state.topology, res_idx, FIXTURE_RES_POS, cat)
+	g := pp.topology_spawn_node(&state.topology, rt_idx, FIXTURE_RT_POS, cat)
+	h := pp.topology_spawn_node(&state.topology, host_idx, FIXTURE_HOST_POS, cat)
+	return r, g, h
+}
diff --git a/harness/demo.odin b/harness/demo.odin
index c8b8f89..d94929b 100644
--- a/harness/demo.odin
+++ b/harness/demo.odin
@@ -1,30 +1,44 @@
 package main
 
-// demo.odin — the scripted-demo model + parser (arch §10.3). A demo is a
-// header (seed) + a run length (ms) + expectations; it lowers to an action
-// log through the real core path (the harness plays intents through the
-// Command_Bus in 1.2; for the 1.1 spine boot.dem has no commands).
+// demo.odin — the scripted-demo model + parser (arch §10.3). A demo is a header
+// (seed) + a run length (ms) + expectations + draw intents (lowered to the
+// action log through the real core path) + T2 capture times. It lowers to an
+// action log via the SAME Input→Command_Bus→core path a mouse drives (the
+// harness resolves the intent to a post-validation Command); the resulting log
+// IS the replay artifact (ODN-11).
 //
-// Time: demo `run` is authored in ms and converted to ticks by
-// floor(ticks = run_ms * logic_hz / 1000) — the spine ticks directly (no
