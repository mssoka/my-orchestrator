 TEST_LOGIC_HZ :: i32(20)
 
+// A minimal self-contained catalog (mirrors data/*.json values) so the unit
+// tests don't touch the filesystem — core is pure (ODN-1). The hash just has
+// to be consistent within a run so the log/replay binding is exercised.
+TEST_CATALOG_HASH :: u64(0x0123456789ABCDEF)
+
+// test_catalog fills the CALLER-OWNED cat (stack storage — no pointer leak) and
+// returns the same pointer for convenience. Free the arrays with
+// catalogs_destroy.
+test_catalog :: proc(cat: ^Catalogs, allocator := context.allocator) -> ^Catalogs {
+	cat.hash = TEST_CATALOG_HASH
+	cat.node_types = make([dynamic]Node_Type, 0, 8, allocator)
+	append(&cat.node_types, Node_Type{id = "residential", display = "Residential", kind = .Terminal, terminal_role = .Residential, throughput_units = 5, port_capacity = 0, era_introduced = 1})
+	append(&cat.node_types, Node_Type{id = "content_host", display = "Content Host", kind = .Terminal, terminal_role = .Content_Host, throughput_units = 80, port_capacity = 0, era_introduced = 3})
+	append(&cat.node_types, Node_Type{id = "router_basic", display = "Basic Router", kind = .Junction, terminal_role = .None, throughput_units = 40, port_capacity = 4, era_introduced = 1})
+	cat.pipe_tiers = make([dynamic]Pipe_Tier, 0, 8, allocator)
+	append(&cat.pipe_tiers, Pipe_Tier{id = "narrow", display = "Narrow Copper", capacity_units = 5, clean_span = 8, max_span = 10, cost_per_tile = 5, era_introduced = 1})
