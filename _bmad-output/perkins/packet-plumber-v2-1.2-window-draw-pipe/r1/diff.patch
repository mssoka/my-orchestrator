diff --git a/core/topology.odin b/core/topology.odin
new file mode 100644
index 0000000..d4d808f
--- /dev/null
+++ b/core/topology.odin
@@ -0,0 +1,204 @@
+package core
+
+// topology.odin — S1 Topology Graph (ODN-1, architecture §6.1), minimal for
+// Story 1.2: nodes (terminal/junction) + pipes, the edit authority (validate
+// + apply), and the pinned integer distance metric. NO routing/flow here
+// (that's 1.3); NO QoS/inventory/health yet (later slices).
+//
+// Data layout: parallel arrays indexed by slot (insertion-ordered — core
+// iterates ARRAYS only, ODN-10); there are NO maps anywhere. Ids are monotonic
+// per run, never recycled (E11): next_node_id/next_pipe_id only climb, and a
+// demolished entity's slot is tombstoned (alive=false), its id never reused.
+//
+// The topology terminals-via-routers canon (E26, art amendment A6): terminals
+// connect via routers only — never terminal-to-terminal. validate_draw rejects
+// a terminal↔terminal drag with .Terminal_To_Terminal.
+
+Topology :: struct {
+	// nodes (parallel arrays; index = slot)
+	node_alive:   [dynamic]bool,
+	node_id:      [dynamic]u32,     // monotonic, never recycled (E11)
+	node_kind:    [dynamic]Node_Kind,
+	node_role:    [dynamic]Terminal_Role,
+	node_type:    [dynamic]u16,     // index into Catalogs.node_types
+	node_pos:     [dynamic][2]i32,  // integer grid (ODN-10)
+	next_node_id: u32,
+
+	// pipes (parallel arrays; index = slot)
+	pipe_alive:   [dynamic]bool,
+	pipe_id:      [dynamic]u32,
+	pipe_a:       [dynamic]u32, // node ids (resolved, post-snap)
+	pipe_b:       [dynamic]u32,
+	pipe_tier:    [dynamic]u16, // index into Catalogs.pipe_tiers
+	pipe_span:    [dynamic]i32, // cached integer Euclidean (rounded)
+	next_pipe_id: u32,
+}
+
+topology_make :: proc(t: ^Topology, allocator := context.allocator) {
+	t^ = {}
+	t.node_alive = make([dynamic]bool, 0, 8, allocator)
+	t.node_id = make([dynamic]u32, 0, 8, allocator)
+	t.node_kind = make([dynamic]Node_Kind, 0, 8, allocator)
+	t.node_role = make([dynamic]Terminal_Role, 0, 8, allocator)
+	t.node_type = make([dynamic]u16, 0, 8, allocator)
+	t.node_pos = make([dynamic][2]i32, 0, 8, allocator)
+	t.pipe_alive = make([dynamic]bool, 0, 8, allocator)
+	t.pipe_id = make([dynamic]u32, 0, 8, allocator)
+	t.pipe_a = make([dynamic]u32, 0, 8, allocator)
+	t.pipe_b = make([dynamic]u32, 0, 8, allocator)
+	t.pipe_tier = make([dynamic]u16, 0, 8, allocator)
+	t.pipe_span = make([dynamic]i32, 0, 8, allocator)
+}
+
+topology_destroy :: proc(t: ^Topology) {
+	delete(t.node_alive)
+	delete(t.node_id)
+	delete(t.node_kind)
+	delete(t.node_role)
+	delete(t.node_type)
+	delete(t.node_pos)
+	delete(t.pipe_alive)
+	delete(t.pipe_id)
+	delete(t.pipe_a)
+	delete(t.pipe_b)
+	delete(t.pipe_tier)
+	delete(t.pipe_span)
+}
+
+node_count :: proc(t: ^Topology) -> int {
+	n := 0
+	for alive in t.node_alive { if alive { n += 1 } }
+	return n
+}
+
+pipe_count :: proc(t: ^Topology) -> int {
+	n := 0
+	for alive in t.pipe_alive { if alive { n += 1 } }
+	return n
+}
+
+// id -> slot, only for LIVE nodes (linear; core is map-free — ODN-10).
+node_slot :: proc(t: ^Topology, id: u32) -> (u32, bool) {
+	for i in 0 ..< len(t.node_alive) {
+		if t.node_alive[i] && t.node_id[i] == id { return u32(i), true }
+	}
+	return 0, false
+}
+
+// --- the pinned integer distance metric (arch §6.1) -------------------------
+// All span/cost/snap math uses integer Euclidean; no sqrt in the comparison
+// path (compare squares), and an integer Newton isqrt for the length. Exact,
+// cheap, identical on every target (ODN-10).
+
+dist2 :: proc(a, b: [2]i32) -> i64 {
+	dx := i64(a[0] - b[0])
+	dy := i64(a[1] - b[1])
+	return dx*dx + dy*dy
+}
+
+isqrt :: proc(x: i64) -> i64 {
+	if x <= 0 { return 0 }
+	r := x
+	y := (r + 1) / 2
+	for y < r {
+		r = y
+		y = (r + x / r) / 2
+	}
+	return r
+}
+
+// Rounded Euclidean distance between two grid points (matches round(sqrt(d²)),
+// computed integer-only). One metric serves span validation, draw cost, and
+// the snap radius (E4).
+span_between :: proc(a, b: [2]i32) -> i32 {
+	d2 := dist2(a, b)
+	r := isqrt(d2)
+	// round half up: isqrt floors; bump when the fractional part ≥ .5
+	if d2 - r*r > r { r += 1 }
+	return i32(r)
+}
+
+// --- node spawning (the harness/app seed the fixture; core is the authority) -
+
+// topology_spawn_node — append a node from its catalog type. Returns the new
+// monotonic id. The fixture is deterministic by construction (the caller passes
+// fixed positions); it is NOT part of the action log — like the seed, it is
+// run setup, re-created identically on every replay.
+topology_spawn_node :: proc(t: ^Topology, type_idx: u16, pos: [2]i32, cat: ^Catalogs) -> u32 {
+	nt := cat.node_types[type_idx]
+	id := t.next_node_id
+	t.next_node_id += 1
+	append(&t.node_alive, true)
+	append(&t.node_id, id)
+	append(&t.node_kind, nt.kind)
+	append(&t.node_role, nt.terminal_role)
+	append(&t.node_type, type_idx)
+	append(&t.node_pos, pos)
+	return id
+}
+
+is_terminal :: proc(t: ^Topology, slot: u32) -> bool {
+	return t.node_kind[slot] == .Terminal
+}
+
+// --- the edit authority: validate-then-apply (single source of truth) -------
+// The Command_Bus merely resolves a pointer to a node id (snap); the core's
+// validate_draw is the ONLY legality check, so live edits and replay can never
+// diverge on legality (the action log stores post-snap, post-validation truth).
+
+validate_draw :: proc(t: ^Topology, c: Cmd_Draw_Pipe, cat: ^Catalogs) -> Edit_Error {
+	if c.a == c.b { return .Self_Loop } // E3
+	sa, oka := node_slot(t, c.a)
+	sb, okb := node_slot(t, c.b)
+	if !oka || !okb { return .Missing_Node }
+	if is_terminal(t, sa) && is_terminal(t, sb) { return .Terminal_To_Terminal } // E26
+	if u32(c.tier) >= u32(len(cat.pipe_tiers)) { return .Unknown_Tier }
+	span := span_between(t.node_pos[sa], t.node_pos[sb])
+	if span > cat.pipe_tiers[c.tier].max_span { return .Span_Exceeds_Tier }
+	return .None
+}
+
+// apply_draw — assumes validate_draw returned .None. Appends a pipe, caching its
+// integer span. The new pipe is live this tick (edit fast-path) and recorded in
+// the action log with apply_tick = next (ODN-2); replay re-applies it at that
+// tick before stepping.
+apply_draw :: proc(t: ^Topology, c: Cmd_Draw_Pipe, cat: ^Catalogs) -> u32 {
+	sa := node_slot_raw(t, c.a)
+	sb := node_slot_raw(t, c.b)
+	span := span_between(t.node_pos[sa], t.node_pos[sb])
+	id := t.next_pipe_id
+	t.next_pipe_id += 1
+	append(&t.pipe_alive, true)
+	append(&t.pipe_id, id)
+	append(&t.pipe_a, c.a)
+	append(&t.pipe_b, c.b)
+	append(&t.pipe_tier, c.tier)
+	append(&t.pipe_span, span)
+	return id
+}
+
+// node_slot_raw — unchecked slot lookup (caller validated). Linear.
+node_slot_raw :: proc(t: ^Topology, id: u32) -> u32 {
+	for i in 0 ..< len(t.node_alive) {
+		if t.node_id[i] == id { return u32(i) }
+	}
+	return 0 // unreachable when called post-validate
+}
+
+// topology_apply_edit — the single validate-then-apply entry. Returns the new
+// pipe id on success, or the typed rejection. The app fast-path calls this on
+// mouse-release; the harness/step path calls this from the replayed log.
+topology_apply_edit :: proc(t: ^Topology, cmd: Command, cat: ^Catalogs) -> (Edit_Result, Edit_Error) {
+	#partial switch c in cmd.kind {
+	case Cmd_Draw_Pipe:
+		if e := validate_draw(t, c, cat); e != .None { return {}, e }
+		id := apply_draw(t, c, cat)
+		return {ok = true, id = id}, .None
+	}
+	return {}, .Unknown_Command
+}
+
+// draw_cost — length × tier cost factor (the cost the ghost displays). Integer.
+draw_cost :: proc(span: i32, tier_idx: u16, cat: ^Catalogs) -> i32 {
+	return span * cat.pipe_tiers[tier_idx].cost_per_tile
+}
diff --git a/core/topology_test.odin b/core/topology_test.odin
new file mode 100644
index 0000000..1ad64dc
--- /dev/null
+++ b/core/topology_test.odin
@@ -0,0 +1,124 @@
+package core
+
+// topology_test.odin — the Story 1.2 edge-case contracts as durable tests (arch
+// §11.7): the snap-inclusive radius (E4), monotonic ids (E11), and the draw
+// rejections (E3 self-loop, E26 terminal↔terminal, span-exceeds-tier). Pinned
+// at the lowest layer so they survive review rounds, refactors, and Perkins.
+
+import "core:testing"
+
+// A fresh fixture-backed topology for each validation case.
+topo_setup :: proc(t: ^testing.T, cat: ^Catalogs) -> (Run_State, u32, u32, u32) {
+	s: Run_State
+	run_init(&s, 1, cat.hash, TEST_LOGIC_HZ)
+	res, rt, host := test_seed_fixture(&s, cat)
+	return s, res, rt, host
+}
+
+@(test)
+test_draw_rejects_self_loop :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, _, _ := topo_setup(t, cat)
+	defer run_destroy(&s)
+	std, _ := pipe_tier_index(cat, "standard")
+	cmd := Command{apply_tick = 1, kind = Cmd_Draw_Pipe{a = res, b = res, tier = std}}
+	_, err := topology_apply_edit(&s.topology, cmd, cat)
+	testing.expect(t, err == .Self_Loop, "node→itself must reject with .Self_Loop (E3)")
+	testing.expectf(t, pipe_count(&s.topology) == 0, "a rejected draw must mutate nothing, got %d pipes", pipe_count(&s.topology))
+}
+
+@(test)
+test_draw_rejects_terminal_to_terminal :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, _, host := topo_setup(t, cat)
+	defer run_destroy(&s)
+	std, _ := pipe_tier_index(cat, "standard")
+	cmd := Command{apply_tick = 1, kind = Cmd_Draw_Pipe{a = res, b = host, tier = std}}
+	_, err := topology_apply_edit(&s.topology, cmd, cat)
+	testing.expect(t, err == .Terminal_To_Terminal, "terminal↔terminal must reject with .Terminal_To_Terminal (E26)")
+	testing.expectf(t, pipe_count(&s.topology) == 0, "a rejected draw must mutate nothing, got %d pipes", pipe_count(&s.topology))
+}
+
+@(test)
+test_draw_rejects_span_exceeds_tier :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, _ := topo_setup(t, cat)
+	defer run_destroy(&s)
+	// narrow max_span=10; residential{8,15}→router{20,15} span=12 > 10 → reject
+	narrow, _ := pipe_tier_index(cat, "narrow")
+	cmd := Command{apply_tick = 1, kind = Cmd_Draw_Pipe{a = res, b = rt, tier = narrow}}
+	_, err := topology_apply_edit(&s.topology, cmd, cat)
+	testing.expect(t, err == .Span_Exceeds_Tier, "over-span draw must reject with .Span_Exceeds_Tier")
+	testing.expectf(t, pipe_count(&s.topology) == 0, "a rejected draw must mutate nothing, got %d pipes", pipe_count(&s.topology))
+}
+
+@(test)
+test_draw_rejects_unknown_tier_and_missing_node :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, _ := topo_setup(t, cat)
+	defer run_destroy(&s)
+	// unknown tier index (out of catalog range)
+	cmd_bad_tier := Command{apply_tick = 1, kind = Cmd_Draw_Pipe{a = res, b = rt, tier = 99}}
+	_, err := topology_apply_edit(&s.topology, cmd_bad_tier, cat)
+	testing.expect(t, err == .Unknown_Tier, "out-of-range tier must reject with .Unknown_Tier")
+	// a node id that was never spawned
+	cmd_missing := Command{apply_tick = 1, kind = Cmd_Draw_Pipe{a = res, b = 9999, tier = 0}}
+	_, err2 := topology_apply_edit(&s.topology, cmd_missing, cat)
+	testing.expect(t, err2 == .Missing_Node, "unknown node must reject with .Missing_Node")
+}
+
+@(test)
+test_draw_legal_pipe_applies :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, host := topo_setup(t, cat)
+	defer run_destroy(&s)
+	std, _ := pipe_tier_index(cat, "standard")
+	// residential→router (span 12 ≤ 14) and router→content_host (span 12 ≤ 14)
+	r1, e1 := topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{res, rt, std}}, cat)
+	testing.expectf(t, e1 == .None, "legal draw 1 must apply, got %v", e1)
+	testing.expect(t, r1.ok, "legal draw 1 returns ok")
+	r2, e2 := topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{rt, host, std}}, cat)
+	testing.expectf(t, e2 == .None, "legal draw 2 must apply, got %v", e2)
+	testing.expect(t, r2.ok, "legal draw 2 returns ok")
+	testing.expectf(t, pipe_count(&s.topology) == 2, "two legal draws = 2 pipes, got %d", pipe_count(&s.topology))
+	// the cached span matches the metric
+	testing.expectf(t, s.topology.pipe_span[0] == 12, "cached span must be 12, got %d", s.topology.pipe_span[0])
+}
+
+@(test)
+test_node_ids_monotonic_never_recycled :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 1, cat.hash, TEST_LOGIC_HZ)
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	a := topology_spawn_node(&s.topology, rt_idx, {5, 5}, cat)
+	b := topology_spawn_node(&s.topology, rt_idx, {6, 6}, cat)
+	c := topology_spawn_node(&s.topology, rt_idx, {7, 7}, cat)
+	testing.expectf(t, a == 0 && b == 1 && c == 2, "ids must be 0,1,2 got %d,%d,%d (E11 monotonic)", a, b, c)
+	testing.expectf(t, s.topology.next_node_id == 3, "next_node_id must advance to 3, got %d", s.topology.next_node_id)
+}
+
+@(test)
+test_distance_metric_pinned :: proc(t: ^testing.T) {
+	// integer Euclidean, rounded — the pinned span/cost/snap metric (arch §6.1).
+	testing.expect_value(t, span_between({0, 0}, {0, 0}), 0)
+	testing.expect_value(t, span_between({0, 0}, {3, 4}), 5)         // 3-4-5
+	testing.expect_value(t, span_between({0, 0}, {12, 0}), 12)       // residential→router
+	testing.expect_value(t, span_between({8, 15}, {20, 15}), 12)     // the fixture span
+	// E4 snap radius inclusive: dist² at the boundary must compare <= radius²
+	testing.expect(t, dist2({0, 0}, {36, 0}) <= 36*36, "snap must be inclusive at the radius boundary (E4)")
+	testing.expect(t, dist2({0, 0}, {37, 0}) > 36*36, "snap must exclude just past the radius (E4)")
+}
