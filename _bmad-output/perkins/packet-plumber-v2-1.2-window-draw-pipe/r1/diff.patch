index 1be24c3..cb05566 100644
--- a/core/determinism_test.odin
+++ b/core/determinism_test.odin
@@ -10,27 +10,55 @@ package core
 //   (d) FNV-1a-64 (the T1 + catalog hash primitive) matches the conformance
 //       basis — the spine's hashes are the canonical algorithm, not a typo.
 //
-// The spine has no topology yet (story 1.2); step is a heartbeat + command
-// recorder, so the keystone exercises the rng + the applied-command record +
-// the canonical serializer + the binary log end to end — the same plumbing
-// real sim state will ride once Topology lands.
+// Story 1.2: the placeholder Cmd_Set_Arg is replaced by the real Cmd_Draw_Pipe
