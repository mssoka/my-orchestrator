diff --git a/app/main.odin b/app/main.odin
new file mode 100644
index 0000000..23e9d5b
--- /dev/null
+++ b/app/main.odin
@@ -0,0 +1,256 @@
+package main
+
+// app/main.odin — the first runnable app.bin (Story 1.2): a 1280×720 window
+// rendering the hardcoded static map where the player draws one pipe
+// (drag node→node, snap, cost) via the validated Command_Bus + the edit
+// fast-path. The sim steps through the SAME package core as the harness; the
+// view is the SAME package render. NO routing/flow yet (1.3).
+//
+// Run: odin run app   (GPU raylib — the playable surface; the harness uses the
+// software renderer for bit-exact goldens).
+
+import "core:fmt"
+import "core:os"
+import "core:strings"
+import pp "../core"
+import rnd "./render"
+import rl "vendor:raylib"
+
+WIN_W :: 1280
+WIN_H :: 720
+
+App :: struct {
+	cat:       pp.Catalogs,
+	state:     pp.Run_State,
+	view:      rnd.View,
+	palette:   rnd.Palette,
+	drag:      rnd.Drag_State,
+	tick:      u64,
+	accum:     f64, // the fixed-timestep accumulator (ODN-2)
+	std_tier:  u16, // the tier app draws (the workhorse 'standard')
+	res_id:    u32,
+	rt_id:     u32,
+	host_id:   u32,
+	drag_to:   u32, // the node the cursor is currently snapped to (0 = none)
+}
+
+main :: proc() {
+	cat: pp.Catalogs
+	if e := load_catalogs(&cat); e != "" {
+		fmt.eprintfln("app: %s", e)
+		os.exit(1)
+	}
+	defer pp.catalogs_destroy(&cat)
+
+	rl.InitWindow(WIN_W, WIN_H, "Packet Plumber — v2 story 1.2")
+	defer rl.CloseWindow()
+	rl.SetTargetFPS(60)
+
+	app: App
+	app.cat = cat
+	std, _ := pp.pipe_tier_index(&cat, "standard")
+	app.std_tier = std
+
+	// the run + the deterministic fixture (identical to the harness's)
+	pp.run_init(&app.state, 42, cat.hash, cat.balance.logic_hz)
+	app.res_id, app.rt_id, app.host_id = seed_fixture(&app.state, &cat)
+
+	// the view (camera-fit); recomputed on resize
+	app.palette = rnd.palette_load()
+	app.view.palette = &app.palette
+	app.view.catalogs = &cat
+	rnd.view_compute(&app.view, WIN_W, WIN_H, &cat.balance)
+
+	tick_seconds := 1.0 / f64(cat.balance.logic_hz)
+
+	for !rl.WindowShouldClose() {
+		// --- the fixed-timestep sim (ODN-2): step at logic_hz, clamped --------
+		dt := min(f64(rl.GetFrameTime()), 0.25)
+		app.accum += dt
+		max_steps := 5
+		steps := 0
+		for app.accum >= tick_seconds && steps < max_steps {
+			app.tick += 1
+			pp.step(&app.state, app.tick, {}, &cat) // edits land via the fast-path
+			app.accum -= tick_seconds
+			steps += 1
+		}
+		app.accum = min(app.accum, tick_seconds) // bounded catch-up debt
+
+		// re-fit on resize (camera-fit reveals more map on wider/taller windows)
+		if rl.IsWindowResized() {
+			rnd.view_compute(&app.view, rl.GetScreenWidth(), rl.GetScreenHeight(), &cat.balance)
+		}
+
+		handle_input(&app)
+
+		// --- render ----------------------------------------------------------
+		rl.BeginDrawing()
+		defer rl.EndDrawing()
+		rl.ClearBackground(app.palette.canvas)
+		rnd.draw_world(&app.view, &app.state.topology, app.drag)
+		draw_hud(&app)
+	}
+}
+
+// --- input: drag-draw with snap-to-node (ODN-12) ----------------------------
+
+handle_input :: proc(app: ^App) {
+	mx, my := rl.GetMouseX(), rl.GetMouseY()
+	wx, wy := rnd.from_screen(&app.view, f32(mx), f32(my))
+
+	if rl.IsMouseButtonPressed(.LEFT) {
+		// start a drag only if the press lands on a node
+		if id, ok := snap_node(app, wx, wy); ok {
+			app.drag.active = true
+			app.drag.from_node = id
+			app.drag.wx = wx
+			app.drag.wy = wy
+			app.drag.valid = .None
+			app.drag.cost = 0
+			app.drag_to = 0
+		}
+	} else if app.drag.active {
+		app.drag.wx = wx
+		app.drag.wy = wy
+		// re-snap + re-validate the in-progress draw (live preview, READ-ONLY)
+		if id, ok := snap_node(app, wx, wy); ok && id != app.drag.from_node {
+			app.drag_to = id
+			span := pp.span_between(node_pos(app, app.drag.from_node), node_pos(app, id))
+			app.drag.cost = pp.draw_cost(span, app.std_tier, &app.cat)
+			app.drag.valid = pp.validate_draw(&app.state.topology,
+				pp.Cmd_Draw_Pipe{app.drag.from_node, id, app.std_tier}, &app.cat)
+		} else {
+			app.drag_to = 0
+			app.drag.valid = .None
+			app.drag.cost = 0
+		}
+		if rl.IsMouseButtonReleased(.LEFT) {
+			// commit if snapped to a legal target
+			if app.drag_to != 0 && app.drag.valid == .None {
+				cmd := pp.Cmd_Draw_Pipe{app.drag.from_node, app.drag_to, app.std_tier}
+				if _, err := pp.topology_apply_edit(&app.state.topology,
+					pp.Command{1, cmd}, &app.cat); err == .None {
+					// edit fast-path (ODN-2): applied THIS frame, logged at next tick
+					append(&app.state.action_log, pp.Command{
+						apply_tick = app.tick + 1,
+						kind = cmd,
+					})
+				}
+			}
+			app.drag.active = false
+			app.drag_to = 0
+		}
+	}
+}
+
+// snap_node — nearest live node to a world-px point within the snap radius
+// (INCLUSIVE, E4). Integer-Euclidean² metric (the pinned distance). Ties break
+// to the lower id.
+snap_node :: proc(app: ^App, wx, wy: f32) -> (u32, bool) {
+	t := &app.state.topology
+	tile := f32(app.cat.balance.tile_px)
+	radius := f32(app.cat.balance.snap_radius)
+	r2 := f64(radius) * f64(radius)
+	best: u32 = 0
+	best_d2 := r2
+	found := false
+	for i in 0..<len(t.node_alive) {
+		if !t.node_alive[i] {
+			continue
+		}
+		nx := f32(t.node_pos[i][0]) * tile
+		ny := f32(t.node_pos[i][1]) * tile
+		dx := f64(nx - wx)
+		dy := f64(ny - wy)
+		d2 := dx*dx + dy*dy
+		if d2 <= best_d2 {
+			if d2 == best_d2 && found && t.node_id[i] > best {
+				continue
+			}
+			best = t.node_id[i]
+			best_d2 = d2
+			found = true
+		}
+	}
+	return best, found
+}
+
+node_pos :: proc(app: ^App, id: u32) -> [2]i32 {
+	slot, _ := pp.node_slot(&app.state.topology, id)
+	return app.state.topology.node_pos[slot]
+}
+
+draw_hud :: proc(app: ^App) {
+	p := app.palette
+	// title + instructions
+	title := "Packet Plumber — v2 story 1.2"
+	draw_text(app, title, 12, 10, 22, p.ink)
+	draw_text(app, "drag a node onto another node to draw a pipe (standard tier)", 12, 36, 16, p.ink_soft)
+	// the cost readout on the drag ghost
+	if app.drag.active && app.drag_to != 0 {
+		cur := rnd.to_screen(&app.view, app.drag.wx, app.drag.wy)
+		if app.drag.valid == .None {
+			label := fmt.tprintf("cost %d", app.drag.cost)
+			draw_text(app, label, i32(cur.x)+12, i32(cur.y)-14, 16, p.ink)
+		} else {
+			draw_text(app, reject_label(app.drag.valid), 12, 60, 16, rl.Color{200, 60, 60, 255})
+		}
+	}
+}
+
+reject_label :: proc(e: pp.Edit_Error) -> string {
+	#partial switch e {
+	case .Self_Loop: return "can't draw a pipe from a node to itself"
+	case .Terminal_To_Terminal: return "terminals connect via routers only"
+	case .Span_Exceeds_Tier: return "too far for the standard tier"
+	case .Missing_Node: return "no node there"
+	case .Unknown_Tier: return "unknown tier"
+	}
+	return "can't draw there"
+}
+
+draw_text :: proc(app: ^App, txt: string, x, y: i32, size: i32, col: rl.Color) {
+	cbuf := make([dynamic]u8, 0, len(txt)+1, context.temp_allocator)
+	for c in txt {
+		append(&cbuf, u8(c))
+	}
+	append(&cbuf, 0)
+	rl.DrawText(cstring(raw_data(cbuf)), x, y, size, col)
+}
+
+// --- catalog IO + the 1.2 fixture (shared shape with the harness) -----------
+
+load_catalogs :: proc(cat: ^pp.Catalogs) -> string {
+	src: pp.Catalog_Sources
+	nt, e1 := os.read_entire_file_from_path("data/node_types.json", context.temp_allocator)
+	if e1 != nil {
+		return fmt.tprintf("cannot read data/node_types.json: %v", e1)
+	}
+	pt, e2 := os.read_entire_file_from_path("data/pipe_tiers.json", context.temp_allocator)
+	if e2 != nil {
+		return fmt.tprintf("cannot read data/pipe_tiers.json: %v", e2)
+	}
+	bal, e3 := os.read_entire_file_from_path("data/balance.json", context.temp_allocator)
+	if e3 != nil {
+		return fmt.tprintf("cannot read data/balance.json: %v", e3)
+	}
+	src.node_types = nt
+	src.pipe_tiers = pt
+	src.balance = bal
+	cerr := pp.catalogs_load(cat, &src)
+	if cerr.file != "" {
+		return pp.catalog_error_string(cerr)
+	}
+	return ""
+}
+
+seed_fixture :: proc(state: ^pp.Run_State, cat: ^pp.Catalogs) -> (u32, u32, u32) {
+	res_idx, _ := pp.node_type_index(cat, "residential")
+	rt_idx, _ := pp.node_type_index(cat, "router_basic")
+	host_idx, _ := pp.node_type_index(cat, "content_host")
+	r := pp.topology_spawn_node(&state.topology, res_idx, {8, 15}, cat)
+	g := pp.topology_spawn_node(&state.topology, rt_idx, {20, 15}, cat)
+	h := pp.topology_spawn_node(&state.topology, host_idx, {32, 15}, cat)
+	return r, g, h
+}
diff --git a/app/render/palette.odin b/app/render/palette.odin
new file mode 100644
index 0000000..7fe0e40
--- /dev/null
+++ b/app/render/palette.odin
@@ -0,0 +1,118 @@
+package render
+
+// palette.odin — the light-canvas canon as DATA (look-book v1 / art-direction
+// v1). All values cosmetic; loaded from data/palette.json (ODN-5 — art tuning
+// is data; the core never reads it). Story 1.2 trims the roster to what the
+// static map + drawn pipes + drag ghost need (no packet/ocean/park colors yet).
+
+import "core:encoding/json"
+import rl "vendor:raylib"
+
+Palette :: struct {
+	canvas:       rl.Color,
+	grid:         rl.Color,
+	ink:          rl.Color,
+	ink_soft:     rl.Color,
+	house_bodies: [4]rl.Color,
+	house_roofs:  [4]rl.Color,
+	host_body:    rl.Color,
+	host_roof:    rl.Color,
+	router_body:  rl.Color,
+	router_dark:  rl.Color,
+	router_led:   rl.Color,
+	pipe_copper:  rl.Color,
+	pipe_steel:   rl.Color,
+	pipe_fiber:   rl.Color,
+	pipe_unalloc: rl.Color,
+	ghost_ok:     rl.Color,
+	ghost_bad:    rl.Color,
+}
+
+DEFAULT_PALETTE_JSON :: #load("../../data/palette.json")
+
+palette_load :: proc(source: []byte = DEFAULT_PALETTE_JSON) -> Palette {
+	p: Palette
+	v, err := json.parse(source, parse_integers = true)
+	if err != nil {
+		return fallback_palette()
+	}
+	obj, okm := v.(json.Object)
+	if !okm {
+		return fallback_palette()
+	}
+	p.canvas = jcol(obj, "canvas", {232, 221, 194, 255})
+	p.grid = jcol(obj, "grid", {194, 182, 148, 255})
+	p.ink = jcol(obj, "ink", {51, 65, 79, 255})
+	p.ink_soft = jcol(obj, "ink_soft", {106, 112, 120, 255})
+	if arr, ok := obj["house_bodies"].(json.Array); ok && len(arr) == 4 {
+		for i in 0..<4 {
+			if q, okq := arr[i].(json.Array); okq { p.house_bodies[i] = jcol_arr(q, {232, 90, 74, 255}) }
+		}
+	} else {
+		p.house_bodies = {{232, 90, 74, 255}, {242, 201, 76, 255}, {94, 203, 107, 255}, {74, 155, 226, 255}}
+	}
+	if arr, ok := obj["house_roofs"].(json.Array); ok && len(arr) == 4 {
+		for i in 0..<4 {
+			if q, okq := arr[i].(json.Array); okq { p.house_roofs[i] = jcol_arr(q, {122, 46, 38, 255}) }
+		}
+	} else {
+		p.house_roofs = {{122, 46, 38, 255}, {122, 84, 24, 255}, {44, 106, 52, 255}, {38, 80, 126, 255}}
+	}
+	p.host_body = jcol(obj, "host_body", {62, 120, 208, 255})
+	p.host_roof = jcol(obj, "host_roof", {38, 76, 142, 255})
+	p.router_body = jcol(obj, "router_body", {94, 110, 128, 255})
+	p.router_dark = jcol(obj, "router_dark", {62, 74, 92, 255})
+	p.router_led = jcol(obj, "router_led", {46, 139, 87, 255})
+	p.pipe_copper = jcol(obj, "pipe_copper", {142, 94, 46, 255})
+	p.pipe_steel = jcol(obj, "pipe_steel", {120, 128, 140, 255})
+	p.pipe_fiber = jcol(obj, "pipe_fiber", {46, 84, 148, 255})
+	p.pipe_unalloc = jcol(obj, "pipe_unalloc", {58, 74, 92, 255})
+	p.ghost_ok = jcol(obj, "ghost_ok", {120, 128, 140, 200})
+	p.ghost_bad = jcol(obj, "ghost_bad", {232, 69, 69, 200})
+	return p
+}
+
+// used when the JSON is somehow unreadable — the look-book hexes, inline.
+fallback_palette :: proc() -> Palette {
+	p: Palette
+	p.canvas = {232, 221, 194, 255}
+	p.grid = {194, 182, 148, 255}
+	p.ink = {51, 65, 79, 255}
+	p.ink_soft = {106, 112, 120, 255}
+	p.house_bodies = {{232, 90, 74, 255}, {242, 201, 76, 255}, {94, 203, 107, 255}, {74, 155, 226, 255}}
+	p.house_roofs = {{122, 46, 38, 255}, {122, 84, 24, 255}, {44, 106, 52, 255}, {38, 80, 126, 255}}
+	p.host_body = {62, 120, 208, 255}
+	p.host_roof = {38, 76, 142, 255}
+	p.router_body = {94, 110, 128, 255}
+	p.router_dark = {62, 74, 92, 255}
+	p.router_led = {46, 139, 87, 255}
+	p.pipe_copper = {142, 94, 46, 255}
+	p.pipe_steel = {120, 128, 140, 255}
+	p.pipe_fiber = {46, 84, 148, 255}
+	p.pipe_unalloc = {58, 74, 92, 255}
+	p.ghost_ok = {120, 128, 140, 200}
+	p.ghost_bad = {232, 69, 69, 200}
+	return p
+}
+
+jcol :: proc(o: json.Object, key: string, def: rl.Color) -> rl.Color {
+	if arr, ok := o[key].(json.Array); ok {
+		return jcol_arr(arr, def)
+	}
+	return def
+}
+
+jcol_arr :: proc(arr: json.Array, def: rl.Color) -> rl.Color {
+	if len(arr) != 4 {
+		return def
+	}
+	c: rl.Color
+	for i in 0..<4 {
+		n, ok := arr[i].(json.Integer)
+		if !ok {
+			return def
+		}
+		c[i] = u8(n)
+	}
+	return c
+}
diff --git a/app/render/view.odin b/app/render/view.odin
new file mode 100644
index 0000000..1837d66
--- /dev/null
+++ b/app/render/view.odin
@@ -0,0 +1,260 @@
+package render
+
+// view.odin — the View layer (architecture §9.1): camera-fit + the light-canvas
+// world pass. Reads ONLY the topology (ODN-1: the view never perturbs sim
+// state). All draw math is basic IEEE float (the §10.4 render-determinism rule
+// — no transcendentals anywhere in the rasterized path; the LED ring uses a
+// pinned 16-point table).
+//
+// Story 1.2 scope: a STATIC map (cream canvas + snap lattice — no procedural
+// land/ocean yet), straight thick-line pipes (bezier curves are a later juice
+// step), buildings + the capacity-scaled router puck, and the drag ghost. No
+// packets / health rings / QoS markers (those land with flow, 1.3+).
+
+import pp "../../core"
+import rl "vendor:raylib"
+
+View :: struct {
+	palette:  ^Palette,
+	catalogs: ^pp.Catalogs,
+	win_w:    i32,
+	win_h:    i32,
+	scale:    f32,
+	off_x:    f32,
+	off_y:    f32,
+	tile_px:  f32,
+	world_w:  f32,
+	world_h:  f32,
+}
+
+// Drag_State — the live drag preview state, owned by the app. The view only
+// reads it (ODN-1). `valid` drives the ghost color; `cost` is drawn near the
+// cursor (length × tier — the draw verb's cost, M1).
+Drag_State :: struct {
+	active:    bool,
+	from_node: u32, // the node id the drag started on
+	wx, wy:    f32, // current cursor in world px
+	valid:     pp.Edit_Error,
+	cost:      i32,
+}
+
+// view_compute — camera-fit the world (map_w×map_h tiles) into the window like
+// GL5.2's aspect=expand: wider/taller windows reveal more map. Pure float div.
+view_compute :: proc(v: ^View, win_w, win_h: i32, bal: ^pp.Balance) {
+	v.win_w = win_w
+	v.win_h = win_h
+	v.tile_px = f32(bal.tile_px)
+	v.world_w = f32(bal.map_w_tiles) * v.tile_px
+	v.world_h = f32(bal.map_h_tiles) * v.tile_px
+	sx := f32(win_w) / v.world_w
+	sy := f32(win_h) / v.world_h
+	v.scale = min(sx, sy)
+	v.off_x = (f32(win_w) - v.world_w * v.scale) / 2
+	v.off_y = (f32(win_h) - v.world_h * v.scale) / 2
+}
+
+to_screen :: proc(v: ^View, wx, wy: f32) -> rl.Vector2 {
+	return {v.off_x + wx * v.scale, v.off_y + wy * v.scale}
+}
+
+from_screen :: proc(v: ^View, sx, sy: f32) -> (f32, f32) {
+	if v.scale <= 0 {
+		return 0, 0
+	} // minimized-window guard
+	return (sx - v.off_x) / v.scale, (sy - v.off_y) / v.scale
+}
+
+node_screen :: proc(v: ^View, pos: [2]i32) -> rl.Vector2 {
+	return to_screen(v, f32(pos[0]) * v.tile_px, f32(pos[1]) * v.tile_px)
+}
+
+// --- the world pass ----------------------------------------------------------
+
+draw_world :: proc(v: ^View, topo: ^pp.Topology, drag: Drag_State) {
+	map_draw(v)
+	draw_pipes(v, topo)
+	draw_nodes(v, topo)
+	if drag.active {
+		draw_ghost(v, topo, drag)
+	}
+}
+
+// map_draw — the static 1.2 map: cream canvas + a faint snap lattice. No
+// procedural geography (that's a later art step); the fixture nodes + drawn
+// pipes are the map content.
+map_draw :: proc(v: ^View) {
+	p := v.palette
+	rl.DrawRectangle(0, 0, v.win_w, v.win_h, p.canvas)
+	// the snap lattice, blended toward the canvas so it stays subtle
+	g, c := p.grid, p.canvas
+	grid_soft := rl.Color{
+		u8((u16(g.r)*45 + u16(c.r)*55) / 100),
+		u8((u16(g.g)*45 + u16(c.g)*55) / 100),
+		u8((u16(g.b)*45 + u16(c.b)*55) / 100), 255}
+	tile := v.tile_px * v.scale
+	x := v.off_x
+	for x < f32(v.win_w) {
+		rl.DrawLine(i32(x), 0, i32(x), v.win_h, grid_soft)
+		x += tile
+	}
+	y := v.off_y
+	for y < f32(v.win_h) {
+		rl.DrawLine(0, i32(y), v.win_w, i32(y), grid_soft)
+		y += tile
+	}
+}
+
+draw_pipes :: proc(v: ^View, topo: ^pp.Topology) {
+	for i in 0..<len(topo.pipe_alive) {
+		if !topo.pipe_alive[i] {
+			continue
+		}
+		sa, oka := pp.node_slot(topo, topo.pipe_a[i])
+		sb, okb := pp.node_slot(topo, topo.pipe_b[i])
+		if !oka || !okb {
+			continue
+		}
+		a := node_screen(v, topo.node_pos[sa])
+		b := node_screen(v, topo.node_pos[sb])
+		col := tier_pipe_color(v, topo.pipe_tier[i])
+		width := tier_pipe_width(v, topo.pipe_tier[i]) * v.scale
+		rl.DrawLineEx(a, b, width, col)
+		// rounded caps (a clean look + hides the square line ends)
+		rl.DrawCircleV(a, width * 0.5, col)
+		rl.DrawCircleV(b, width * 0.5, col)
+		// the glowing inner core on fiber (the modernization read, A4)
+		if v.catalogs.pipe_tiers[topo.pipe_tier[i]].id == "wide" {
+			rl.DrawLineEx(a, b, width * 0.45, v.palette.pipe_fiber)
+		}
+	}
+}
+
+draw_nodes :: proc(v: ^View, topo: ^pp.Topology) {
+	for i in 0..<len(topo.node_alive) {
+		if !topo.node_alive[i] {
+			continue
+		}
+		c := node_screen(v, topo.node_pos[i])
+		if topo.node_kind[i] == .Junction {
+			draw_router(v, topo.node_id[i], c)
+		} else {
+			draw_building(v, topo.node_id[i], topo.node_role[i], c)
+		}
+	}
+}
+
+// residential = peaked-roof house (varied cheerful body); content_host = server
+// block with a play glyph (YouTune). Variant keyed by id so it's stable.
+draw_building :: proc(v: ^View, id: u32, role: pp.Terminal_Role, c: rl.Vector2) {
+	p := v.palette
+	s := v.tile_px * v.scale
+	if role == .Content_Host {
+		w := s * 1.15
+		h := s * 0.95
+		rl.DrawRectangleV({c.x - w/2, c.y - h/2 + s*0.12}, {w, h - s*0.12}, p.host_body)
+		rl.DrawRectangleV({c.x - w/2, c.y - h/2}, {w, s * 0.28}, p.host_roof)
+		// play triangle (the YouTune brand glyph)
+		g := s * 0.22
+		v1 := rl.Vector2{c.x - g * 0.6, c.y - g * 0.8}
+		v2 := rl.Vector2{c.x - g * 0.6, c.y + g * 0.8}
+		v3 := rl.Vector2{c.x + g, c.y}
+		rl.DrawTriangle(v3, v2, v1, {250, 246, 238, 255})
+		return
+	}
+	// residential: peaked-roof house
+	variant := int(id) % 4
+	body := p.house_bodies[variant]
+	roof := p.house_roofs[variant]
+	w := s * 0.92
+	h := s * 0.62
+	left := c.x - w/2
+	top := c.y - h * 0.15
+	rl.DrawRectangleV({left, top}, {w, h}, body)
+	r1 := rl.Vector2{left - s * 0.06, top}
+	r2 := rl.Vector2{left + w + s * 0.06, top}
+	r3 := rl.Vector2{c.x, top - s * 0.42}
+	rl.DrawTriangle(r1, r3, r2, roof)
+	// door
+	dw := s * 0.16
+	rl.DrawRectangleV({c.x - dw/2, top + h - s * 0.3}, {dw, s * 0.3}, roof)
+}
+
+// draw_router — the capacity-scaled puck (A3): body disc + dark core + a 4-LED
+// ring (the basic router's ports — canon #14 made visible). LEDs sit on a
+// pinned 16-gon (4 ports divide 16); no transcendentals in the geometry.
+draw_router :: proc(v: ^View, id: u32, c: rl.Vector2) {
+	_ = id
+	p := v.palette
+	base := v.tile_px * v.scale * 0.5
+	r := base * 0.9
+	rl.DrawCircleV(c, r, p.router_body)
+	rl.DrawCircleV(c, r * 0.45, p.router_dark)
+	leds := 4 // basic router: 4 ports
+	stride := 16 / leds
+	circle := CIRCLE16 // local copy — a constant can't be indexed by a runtime index
+	for i in 0..<leds {
+		k := (i*stride + 12) % 16 // start at the top
+		pos := rl.Vector2{
+			c.x + circle[k][0] * r * 0.78,
+			c.y + circle[k][1] * r * 0.78,
+		}
+		rl.DrawCircleV(pos, max(1.5, r*0.11), p.router_led)
+	}
+}
+
+// draw_ghost — the drag preview: a line from the source node to the cursor,
+// green when the in-progress draw would validate, red when it would reject.
+draw_ghost :: proc(v: ^View, topo: ^pp.Topology, drag: Drag_State) {
+	p := v.palette
+	from_pos, ok := pp.node_slot(topo, drag.from_node)
+	if !ok {
+		return
+	}
+	a := node_screen(v, topo.node_pos[from_pos])
+	b := to_screen(v, drag.wx, drag.wy)
+	col := p.ghost_ok
+	if drag.valid != .None {
+		col = p.ghost_bad
+	}
+	rl.DrawLineEx(a, b, 5*v.scale, col)
+	rl.DrawCircleV(b, 4*v.scale, col)
+}
+
+tier_pipe_color :: proc(v: ^View, tier: u16) -> rl.Color {
+	switch v.catalogs.pipe_tiers[tier].id {
+	case "narrow": return v.palette.pipe_copper
+	case "standard": return v.palette.pipe_steel
+	case "wide": return v.palette.pipe_fiber
+	}
+	return v.palette.pipe_unalloc
+}
+
+tier_pipe_width :: proc(v: ^View, tier: u16) -> f32 {
+	switch v.catalogs.pipe_tiers[tier].id {
+	case "narrow": return 3.5
+	case "standard": return 5.5
+	case "wide": return 8.5
+	}
+	return 4.5
+}
+
+// unit circle, 16 points (k * 22.5 deg), correctly-rounded decimal constants —
+// identical on every platform (no libm cos/sin anywhere in the render path).
+CIRCLE16 :: [16][2]f32{
+	{1.00000000, 0.00000000},
+	{0.92387954, 0.38268343},
+	{0.70710678, 0.70710678},
+	{0.38268343, 0.92387954},
+	{0.00000000, 1.00000000},
+	{-0.38268343, 0.92387954},
+	{-0.70710678, 0.70710678},
+	{-0.92387954, 0.38268343},
+	{-1.00000000, 0.00000000},
+	{-0.92387954, -0.38268343},
+	{-0.70710678, -0.70710678},
+	{-0.38268343, -0.92387954},
+	{0.00000000, -1.00000000},
+	{0.38268343, -0.92387954},
+	{0.70710678, -0.70710678},
+	{0.92387954, -0.38268343},
+}
diff --git a/core/catalog.odin b/core/catalog.odin
new file mode 100644
index 0000000..326360f
--- /dev/null
+++ b/core/catalog.odin
@@ -0,0 +1,246 @@
+package core
+
+// catalog.odin — data-driven content catalogs (ODN-5). JSON single source,
+// loaded once, fail-fast validated (unknown fields, out-of-range values,
+// missing required content abort with a named error), read-only after load.
+// Sim-relevant values are integers only. The core parses from BYTES — the
+// app/harness own file IO (#load-embedded or disk in dev), so the core never
+// touches core:os (ODN-1).
+//
+// Story 1.2 carries a MINIMAL roster: node_types (residential / content_host /
+// router_basic), pipe_tiers (narrow / standard / wide), balance (logic_hz +
+// snap_radius + map dims). packet_types / demand / crises / QoS land with the
+// flow slice (1.3+); the palette is cosmetic and lives in the render layer.
+
+import "core:encoding/json"
+import "core:fmt"
+
+// --- enums shared across the core --------------------------------------------
+
+Node_Kind :: enum u8 { Terminal, Junction }
+
+Terminal_Role :: enum u8 { None, Residential, Content_Host }
+
+// --- catalog row types -------------------------------------------------------
+
+Node_Type :: struct {
+	id:               string,
+	display:          string,
+	kind:             Node_Kind,
+	terminal_role:    Terminal_Role,
+	throughput_units: i32,
+	port_capacity:    i32, // 0 = unlimited (terminals); 4/8/16 for router tiers
+	era_introduced:   i32,
+}
+
+Pipe_Tier :: struct {
+	id:             string,
+	display:        string,
+	capacity_units: i32,
+	clean_span:     i32,
+	max_span:       i32,   // the hard span cap, enforced at edit (E3 family)
+	cost_per_tile:  i32,   // draw cost factor: cost = span × cost_per_tile
+	era_introduced: i32,
+}
+
+Balance :: struct {
+	logic_hz:    i32,
+	max_ticks:   i32,
+	snap_radius: i32, // inclusive node-snap radius in world px (E4)
+	map_w_tiles: i32,
+	map_h_tiles: i32,
+	tile_px:     i32,
+}
+
+Catalogs :: struct {
+	node_types: [dynamic]Node_Type,
+	pipe_tiers: [dynamic]Pipe_Tier,
+	balance:    Balance,
+	hash:       u64, // FNV-1a-64 over the sim-relevant source bytes (fixed order)
+}
+
+// The bytes the app/harness hand the core (it never opens files). Order is
+// fixed so catalog_hash is stable.
+Catalog_Sources :: struct {
+	node_types: []byte,
+	pipe_tiers: []byte,
+	balance:    []byte,
+}
+
+Catalog_Error :: struct {
+	file:  string,
+	field: string,
+	rule:  string,
+}
+
+catalog_error_string :: proc(err: Catalog_Error, allocator := context.allocator) -> string {
+	return fmt.aprintf("catalog %s: field %s — %s", err.file, err.field, err.rule, allocator = allocator)
+}
+
+// catalogs_load — parse + validate the sim-relevant catalogs from bytes into
+// the CALLER-OWNED cat (stack or field; no pointer allocation → no leak). On
+// any violation returns a named error; the caller surfaces it and aborts
+// (§7.1, never silent). On success cat.node_types / cat.pipe_tiers are made
+// with the context allocator; free them with catalogs_destroy.
+catalogs_load :: proc(cat: ^Catalogs, src: ^Catalog_Sources, allocator := context.allocator) -> Catalog_Error {
+	context.allocator = allocator
+	cat.hash = catalogs_hash_sources(src)
+
+	// node_types
+	{
+		v, e := json.parse(src.node_types, parse_integers = true)
+		if e != nil { return {"node_types.json", "$", "invalid JSON"} }
+		obj, ok := v.(json.Object)
+		if !ok { return {"node_types.json", "$", "root must be an object"} }
+		entries, oke := obj["entries"].(json.Array)
+		if !oke { return {"node_types.json", "entries", "missing array"} }
+		cat.node_types = make([dynamic]Node_Type, 0, 8, allocator)
+		for ev in entries {
+			eo := ev.(json.Object) or_continue
+			nt: Node_Type
+			nt.id = jstr(eo, "id")
+			nt.display = jstr(eo, "display_name")
+			switch jstr(eo, "kind") {
+			case "terminal": nt.kind = .Terminal
+			case "junction": nt.kind = .Junction
+			case: return {"node_types.json", nt.id, "kind must be terminal|junction"}
+			}
+			nt.terminal_role = role_from_name(jstr(eo, "terminal_role"))
+			nt.throughput_units = jint(eo, "throughput_units", 0)
+			nt.port_capacity = jint(eo, "port_capacity", 0)
+			nt.era_introduced = jint(eo, "era_introduced", 1)
+			if nt.id == "" { return {"node_types.json", "id", "empty id"} }
+			if nt.kind == .Terminal && nt.terminal_role == .None {
+				return {"node_types.json", nt.id, "terminal without a role"}
+			}
+			append(&cat.node_types, nt)
+		}
+		if len(cat.node_types) == 0 { return {"node_types.json", "entries", "empty"} }
+	}
+
+	// pipe_tiers
+	{
+		v, e := json.parse(src.pipe_tiers, parse_integers = true)
+		if e != nil { return {"pipe_tiers.json", "$", "invalid JSON"} }
+		obj, ok := v.(json.Object)
+		if !ok { return {"pipe_tiers.json", "$", "root must be an object"} }
+		entries, oke := obj["entries"].(json.Array)
+		if !oke { return {"pipe_tiers.json", "entries", "missing array"} }
+		cat.pipe_tiers = make([dynamic]Pipe_Tier, 0, 8, allocator)
+		for ev in entries {
+			eo := ev.(json.Object) or_continue
+			t: Pipe_Tier
+			t.id = jstr(eo, "id")
+			t.display = jstr(eo, "display_name")
+			t.capacity_units = jint(eo, "capacity_units", 0)
+			t.clean_span = jint(eo, "clean_span", 0)
+			t.max_span = jint(eo, "max_span", 0)
+			t.cost_per_tile = jint(eo, "cost_per_tile", 0)
+			t.era_introduced = jint(eo, "era_introduced", 1)
+			if t.id == "" || t.capacity_units <= 0 || t.max_span <= 0 || t.cost_per_tile < 0 {
+				return {"pipe_tiers.json", t.id, "id/capacity/max_span/cost invalid"}
+			}
+			append(&cat.pipe_tiers, t)
+		}
+		if len(cat.pipe_tiers) == 0 { return {"pipe_tiers.json", "entries", "empty"} }
+	}
+
+	// balance
+	{
+		v, e := json.parse(src.balance, parse_integers = true)
+		if e != nil { return {"balance.json", "$", "invalid JSON"} }
+		obj, ok := v.(json.Object)
+		if !ok { return {"balance.json", "$", "root must be an object"} }
+		b: Balance
+		b.logic_hz = jint(obj, "logic_hz", 0)
+		if b.logic_hz <= 0 || b.logic_hz > 1000 {
+			return {"balance.json", "logic_hz", "must be in 1..1000 (single source of tick timing)"}
+		}
+		b.max_ticks = jint(obj, "max_ticks", 100000)
+		b.snap_radius = jint(obj, "snap_radius", 36)
+		if b.snap_radius <= 0 {
+			return {"balance.json", "snap_radius", "must be > 0"}
+		}
+		if mp, okm := obj["map"].(json.Object); okm {
+			b.map_w_tiles = jint(mp, "w_tiles", 0)
+			b.map_h_tiles = jint(mp, "h_tiles", 0)
+			b.tile_px = jint(mp, "tile_px", 0)
+		}
+		if b.map_w_tiles <= 0 || b.map_h_tiles <= 0 || b.tile_px <= 0 {
+			return {"balance.json", "map", "map w_tiles/h_tiles/tile_px must be > 0"}
+		}
+		cat.balance = b
+	}
+
+	// PROTO required content (fail-fast cross-checks)
+	if _, ok := node_type_index(cat, "residential"); !ok {
+		return {"node_types.json", "residential", "1.2 requires the residential type"}
+	}
+	if _, ok := node_type_index(cat, "router_basic"); !ok {
+		return {"node_types.json", "router_basic", "1.2 requires the router_basic type"}
+	}
+	return {}
+}
+
+// catalogs_destroy — free the catalog's owned dynamic arrays (the Catalogs
+// itself is caller-owned — stack or field — so no pointer free here).
+catalogs_destroy :: proc(cat: ^Catalogs) {
+	delete(cat.node_types)
+	delete(cat.pipe_tiers)
+}
+
+// FNV-1a-64 over the sim-relevant catalog bytes in fixed order (hash.odin).
+// palette is cosmetic and deliberately NOT hashed — it must not bind replay.
+catalogs_hash_sources :: proc(src: ^Catalog_Sources) -> u64 {
+	h := FNV64_OFFSET
+	fold := proc(h: ^u64, bytes: []u8) {
+		for b in bytes {
+			h^ = (h^ ~ u64(b)) * FNV64_PRIME // FNV-1a: xor then multiply
+		}
+	}
+	fold(&h, src.node_types)
+	fold(&h, src.pipe_tiers)
+	fold(&h, src.balance)
+	return h
+}
+
+// --- lookups (linear; core is map-free — ODN-10) ----------------------------
+
+node_type_index :: proc(cat: ^Catalogs, id: string) -> (u16, bool) {
+	for nt, i in cat.node_types {
+		if nt.id == id { return u16(i), true }
+	}
+	return 0, false
+}
+
+pipe_tier_index :: proc(cat: ^Catalogs, id: string) -> (u16, bool) {
+	for t, i in cat.pipe_tiers {
+		if t.id == id { return u16(i), true }
+	}
+	return 0, false
+}
+
+role_from_name :: proc(name: string) -> Terminal_Role {
+	switch name {
+	case "residential":  return .Residential
+	case "content_host": return .Content_Host
+	}
+	return .None
+}
+
+// --- tiny JSON accessors (parse_integers = true => numbers are json.Integer) --
+
+jstr :: proc(o: json.Object, key: string) -> string {
+	if v, ok := o[key].(json.String); ok { return v }
+	return ""
+}
+
+jint :: proc(o: json.Object, key: string, def: i32) -> i32 {
+	if v, ok := o[key]; ok {
+		#partial switch x in v {
+		case json.Integer: return i32(x)
+		case json.Float:   return i32(x)
+		}
+	}
+	return def
+}
