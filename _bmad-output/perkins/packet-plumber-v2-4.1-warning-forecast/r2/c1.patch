+		{tick = 2, tag = EVENT_TAG_WARNING_CLEARED, sign = u8(Warning_Sign.Pipe_Pressure), target = 7},
+	}
+	dump := state_dump(&s, events, cat, context.temp_allocator)
+
+	w := writer_make(context.temp_allocator)
+	w_u32(&w, 4) // the section count
+	w_u64(&w, 1); w_u8(&w, EVENT_TAG_PACKET_ARRIVED)
+	w_u64(&w, 1); w_u8(&w, EVENT_TAG_SLA_THRESHOLD_CROSSED); w_u16(&w, 3); w_u8(&w, 1); w_u8(&w, 1)
+	w_u64(&w, 2); w_u8(&w, EVENT_TAG_WARNING_RAISED); w_u8(&w, u8(Warning_Sign.Node_Critical)); w_u32(&w, 9)
+	w_u64(&w, 2); w_u8(&w, EVENT_TAG_WARNING_CLEARED); w_u8(&w, u8(Warning_Sign.Pipe_Pressure)); w_u32(&w, 7)
+	want := w.buf[:]
+	testing.expectf(t, len(dump) >= len(want), "dump (%d) shorter than the event tail (%d)", len(dump), len(want))
+	if len(dump) >= len(want) {
+		off := len(dump) - len(want)
+		for i in 0..<len(want) {
+			if dump[off+i] != want[i] {
+				testing.expectf(t, false, "event tail byte %d: got %02x want %02x", i, dump[off+i], want[i])
+				break
+			}
+		}
+	}
+}
+
+@(test)
+test_warning_evaluate_idempotent_and_pure :: proc(t: ^testing.T) {
+	// warning_evaluate is a pure reader (the forecast-purity contract): a
+	// second direct call on the same state changes nothing — no new events,
+	// identical crisis arrays, and the rng/topology/flow are untouched.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 43, cat.hash, TEST_LOGIC_HZ)
+	s.era = 3
+	_, rt, host := test_seed_fixture(&s, cat)
+	sla_draw(&s, cat, host, rt, "standard", 1)
+	sla_spawn(&s, 1, 0, host, 0) // stuck at the host (no route to res0)
+	step(&s, 1, {}, cat)
+	clear(&s.events)
+
+	rng_before := s.rng
+	gen_before := s.topology.gen
+	packets_before := len(s.flow.packets)
+
+	warning_evaluate(&s, s.tick, cat)
+	n_events := len(s.events)
+	n1 := len(s.crisis.node_strain)
+	f1 := len(s.crisis.forecast)
+	warning_evaluate(&s, s.tick, cat)
+
+	testing.expectf(t, len(s.events) == n_events, "second eval must not emit events (got %d, want %d)", len(s.events), n_events)
+	testing.expectf(t, len(s.crisis.node_strain) == n1, "node_strain length changed on re-eval")
+	testing.expectf(t, len(s.crisis.forecast) == f1, "forecast length changed on re-eval")
+	testing.expect(t, s.rng == rng_before, "warning_evaluate must not draw the sim rng")
+	testing.expect_value(t, s.topology.gen, gen_before)
+	testing.expectf(t, len(s.flow.packets) == packets_before, "warning_evaluate must not touch the flow")
+}
