+import "core:fmt"
+import "core:strings"
+import pp "../../core"
+import rl "vendor:raylib"
+
+// draw_forecast_panel — the weather report at the top-right. Each row names a
+// set-piece inside its forecast window: "<set-piece id> x<N> -12s" (or "NOW"
+// once active). The label is the set-piece's CATALOG id (resolved via the era
+// + sp_index — review r1 N2: the first cut hardcoded "SURGE", which would
+// mislabel any future non-surge archetype; the catalog id is honest for
+// every archetype). Color + glyph + caption — never color alone. Draws
+// NOTHING when there are no rows (the capture-stability contract).
+draw_forecast_panel :: proc(v: ^View, crisis: ^pp.Crisis_State, cat: ^pp.Catalogs, era: u8) {
+	if len(crisis.forecast) == 0 {
+		return
+	}
+	p := v.palette
+	// the panel card (top-right, clear of the top-left run HUD)
+	card_w := i32(230)
+	pad := i32(10)
+	line_h := i32(20)
+	title_h := i32(24)
+	x := v.win_w - card_w - pad
+	y := i32(10)
+	rows := len(crisis.forecast)
+	h := title_h + i32(rows) * line_h + pad
+	// translucent card so the map still reads behind it
+	card := rl.Color{255, 252, 244, 235}
+	rl.DrawRectangle(x - pad, y - pad, card_w + 2 * pad, h, card)
+	border := rl.Color{51, 65, 79, 40}
+	rl.DrawRectangleLines(x - pad, y - pad, card_w + 2 * pad, h, border)
+
+	draw_text_c(v, "WEATHER REPORT", x, y, 16, p.ink)
+	ty := y + title_h - 4
+	for f in crisis.forecast {
+		name := "setpiece"
+		if era > 0 && int(era) <= len(cat.demand.eras) {
+			de := &cat.demand.eras[era-1]
+			if int(f.sp_index) < len(de.set_pieces) {
+				name = de.set_pieces[f.sp_index].id
+			}
+		}
+		mult := fmt.aprintf("x%d", f.multiplier, allocator = context.temp_allocator)
+		col := p.state_strain
+		when_suffix := ""
+		if f.active {
+			when_suffix = "NOW"
+			col = p.state_critical
+		} else {
+			secs := f.countdown_ticks / u64(max(1, cat.balance.logic_hz))
+			when_suffix = fmt.aprintf("-%ds", secs, allocator = context.temp_allocator)
+		}
+		line := strings.join({name, mult, when_suffix}, "  ", context.temp_allocator)
+		draw_text_c(v, line, x, ty, 15, col)
+		ty += line_h
+	}
+}
