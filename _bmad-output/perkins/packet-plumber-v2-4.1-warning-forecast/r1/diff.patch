diff --git a/core/warnings.odin b/core/warnings.odin
new file mode 100644
index 0000000..e0f75ec
--- /dev/null
+++ b/core/warnings.odin
@@ -0,0 +1,258 @@
+package core
+
+// warnings.odin — Story 4.1: the warning surface (arch §6.4 S4 + ODN-4, the
+// [FORGE #3] fairness contract). Strain metrics from Topology + Flow each tick
+// → warning signs (node 🟡/🔴, pipe pressure) with lead times → the demand
+// forecast. TELEGRAPH ONLY: this file never fires a crisis (that is 4.2's
+// Crisis Engine) and never touches win/lose (that is 4.3). The forecast READS
+// the demand director's set-piece schedule (demand.odin) — it triggers
+// nothing.
+//
+// warning_evaluate runs INSIDE core.step after flow_step (the SLA counters are
+// final) and before win_lose_eval — the architecture's spine data-flow
+// (… Packet_Flow → crisis [warnings] → win_lose_eval → snapshot). The terminal
+// barrier (E17) skips it post-Run_Won/Run_Lost by construction (step returns
+// before any eval).
+//
+// The strain measures (the pinned contracts):
+//   • NODE strain = Σ packet_bandwidth of packets RESIDENT at the node that
+//     FAILED a forward attempt (Packet.waiting_ticks >= 1 — incremented in
+//     flow.odin's forward pass when no route exists, cleared on every
+//     successful forward) ÷ node_types[node_type].throughput_units. A packet
+//     that forwards next tick — fresh spawn or fresh transit — has
+//     waiting_ticks 0 and NEVER strains (the no-flicker contract); an
+//     unroutable pile-up does (the honest "stuck" signal).
+//   • PIPE pressure = the FULLEST lane queue's depth on the bundle vs its E9
+//     bound (lane_queue_packets × packet_bandwidth) — "pressure climbing toward
+//     saturation" (GDD M5): a lone packet on a pipe is 1/6 of a lane bound
+//     (17 %, healthy — no busy-flicker); a lane at its bound (6 packets) is
+//     100 % — the E9 ladder is dropping. Every member pipe carries its
+//     bundle's level (the bundle is the capacity unit, 2.1).
+//   • FORECAST = the era's set-pieces inside [start - lead, start + duration)
+//     — a pure read of the schedule; never fires anything.
+//
+// All warning state is DERIVED (rebuilt identically on replay from serialized
+// state — the same status as lane_caps / sla_breach): the strain LEVELS are a
+// pure function of (packets, topology, bundles, catalogs, tick), the forecast
+// of (era, tick, catalog). The serializer emits only the non-None entries +
+// forecast rows (absent-when-empty), so the T1 golden pins the warning state
+// (E10) without binding replay to this file's iteration order.
+//
+// Integer-only (ODN-10); arrays only, no maps (ODN-10); no file/clock reads
+// (ODN-1). The lead times (strained 30 s / critical 10 s / pressure 20 s —
+// GDD Numerical Design) live in balance.json `warnings`; the UI reads them
+// from there (they are not re-stated here).
+
+// crisis_make / crisis_destroy — Run_State.crisis lifetime (mirrors
+// flow_init/flow_destroy; ODN-18 arena discipline lands later).
+crisis_make :: proc(c: ^Crisis_State, allocator := context.allocator) {
+	c^ = {}
+	c.node_strain = make([dynamic]Strain_Level, 0, 8, allocator)
+	c.pipe_strain = make([dynamic]Strain_Level, 0, 8, allocator)
+	c.forecast = make([dynamic]Forecast_Entry, 0, 2, allocator)
+}
+
+crisis_destroy :: proc(c: ^Crisis_State) {
+	delete(c.node_strain)
+	delete(c.pipe_strain)
+	delete(c.forecast)
+}
+
+// event_emit_warning — append a Warning_Raised / Warning_Cleared event with its
+// payload (4.1, ODN-14). sign names the level boundary crossed; target is the
+// node id (node signs) or pipe id (pipe signs).
+event_emit_warning :: proc(state: ^Run_State, tick: u64, tag: u8, sign: Warning_Sign, target: u32) {
+	append(&state.events, Event{tick = tick, tag = tag, sign = u8(sign), target = target})
+}
+
+// strain_level — map an integer percent to the tri-state level (inclusive
+// lower bounds — art-direction §6.1: strain >= 70 % strained, >= 90 %
+// critical). Thresholds come from the balance warnings block (data-driven).
+strain_level :: proc(pct: i64, amber, red: i32) -> Strain_Level {
+	if pct >= i64(red) do return .Red
+	if pct >= i64(amber) do return .Amber
+	return .None
+}
+
+// node_strain_transition — one node's level change vs its prior level: emit
+// the event for the boundary crossed (one event per transition) and return the
+// new level. Dead node slots never warn (a demolished node is its own
+// resolution — no phantom cleared events).
+node_strain_transition :: proc(state: ^Run_State, tick: u64, old, new: Strain_Level, node_id: u32) -> Strain_Level {
+	if old == new {
+		return new
+	}
+	switch new {
+	case .Red:
+		// entering Red (from None or Amber): the critical alarm raises
+		event_emit_warning(state, tick, EVENT_TAG_WARNING_RAISED, .Node_Critical, node_id)
+	case .Amber:
+		if old == .Red {
+			// Red eased to Amber: the critical level ENDED (strained persists)
+			event_emit_warning(state, tick, EVENT_TAG_WARNING_CLEARED, .Node_Critical, node_id)
+		} else {
+			event_emit_warning(state, tick, EVENT_TAG_WARNING_RAISED, .Node_Strained, node_id)
+		}
+	case .None:
+		// the level that ENDED is the one that was raised last (Red supersedes
+		// Amber): clear the highest raised sign.
+		if old == .Red {
+			event_emit_warning(state, tick, EVENT_TAG_WARNING_CLEARED, .Node_Critical, node_id)
+		} else {
+			event_emit_warning(state, tick, EVENT_TAG_WARNING_CLEARED, .Node_Strained, node_id)
+		}
+	}
+	return new
+}
+
+// pipe_strain_transition — same contract for pipes (signs Pipe_Pressure /
+// Pipe_Critical; target = pipe id).
+pipe_strain_transition :: proc(state: ^Run_State, tick: u64, old, new: Strain_Level, pipe_id: u32) -> Strain_Level {
+	if old == new {
+		return new
+	}
+	switch new {
+	case .Red:
+		event_emit_warning(state, tick, EVENT_TAG_WARNING_RAISED, .Pipe_Critical, pipe_id)
+	case .Amber:
+		if old == .Red {
+			event_emit_warning(state, tick, EVENT_TAG_WARNING_CLEARED, .Pipe_Critical, pipe_id)
+		} else {
+			event_emit_warning(state, tick, EVENT_TAG_WARNING_RAISED, .Pipe_Pressure, pipe_id)
+		}
+	case .None:
+		if old == .Red {
+			event_emit_warning(state, tick, EVENT_TAG_WARNING_CLEARED, .Pipe_Critical, pipe_id)
+		} else {
+			event_emit_warning(state, tick, EVENT_TAG_WARNING_CLEARED, .Pipe_Pressure, pipe_id)
+		}
+	}
+	return new
+}
+
+// warning_evaluate — the per-tick warning pass: rebuild Crisis_State from the
+// current flow + topology + schedule and emit transition events vs the prior
+// tick's levels (read in place before overwriting — the arrays hold last
+// tick's derivation). One event per level boundary crossed; a zero-traffic
+// tick moves nothing (no packets → no strain → no transitions — the E24
+// neutrality pattern, no fabricated signals).
+warning_evaluate :: proc(state: ^Run_State, tick: u64, cat: ^Catalogs) {
+	w := &cat.balance.warnings
+	t := &state.topology
+	cr := &state.crisis
+	f := &state.flow
+
+	// --- 1. per-slot level arrays: resize to cover the current topology
+	// (resize PRESERVES existing elements = the prior tick's derivation; new
+	// slots append as None). The in-place compare-then-write below uses those
+	// old values as the transition baseline.
+	if len(cr.node_strain) != len(t.node_alive) {
+		resize(&cr.node_strain, len(t.node_alive))
+	}
+	if len(cr.pipe_strain) != len(t.pipe_alive) {
+		resize(&cr.pipe_strain, len(t.pipe_alive))
+	}
+
+	// --- 2. accumulate the measured strain (scratch; freed at return)
+	// Node loads: per node SLOT — the stuck-packet backlog (waiting_ticks >= 1)
+	// is the honest node signal (see the header contract). Pipe pressure: per
+	// BUNDLE slot, the FULLEST lane's queue depth vs its E9 bound
+	// (lane_queue_packets x packet_bandwidth) — "pressure climbing toward
+	// saturation" (GDD M5): a lone packet on a pipe is 1/6 of a lane bound
+	// (17 % — healthy, no busy-flicker); a lane at its bound (6 packets) is
+	// 100 % — the E9 ladder is dropping. The pressure levels replicate to
+	// every member pipe of the bundle (the bundle is the capacity unit, 2.1).
+	nload := make([dynamic]i64, len(t.node_alive), len(t.node_alive), context.temp_allocator)
+	defer delete(nload)
+	press := make([dynamic]i64, int(state.bundles.n), int(state.bundles.n), context.temp_allocator)
+	defer delete(press)
+	lane_bound_units := i64(cat.balance.lane_queue_packets) * i64(cat.balance.packet_bandwidth)
+	for bs in 0..<int(state.bundles.n) {
+		if lane_bound_units <= 0 { break }
+		fullest := i64(0)
+		for lane in u8(0)..<LANE_COUNT {
+			depth := i64(bundle_lane_count(state, cat, u32(bs), lane))
+			units := depth * i64(cat.balance.packet_bandwidth)
+			if units > fullest {
+				fullest = units
+			}
+		}
+		press[bs] = fullest
+	}
+
+	// Node loads: count the STUCK packets (waiting_ticks >= 1 — they failed a
+	// forward attempt; fresh spawns + fresh transits have 0 and never strain,
+	// the pinned no-flicker contract) into their node's slot.
+	for i in 0..<len(f.packets) {
+		p := &f.packets[i]
+		if p.delivered || p.on_edge { continue }
+		if p.waiting_ticks == 0 { continue }
+		for ns in 0..<len(t.node_alive) {
+			if t.node_alive[ns] && t.node_id[ns] == p.at_node {
+				nload[ns] += i64(cat.balance.packet_bandwidth)
+				break
+			}
+		}
+	}
+
+	// --- 3. node levels + transition events (slot order; node id targets)
+	for ns in 0..<len(t.node_alive) {
+		if !t.node_alive[ns] {
+			cr.node_strain[ns] = .None // dead slots never warn
+			continue
+		}
+		throughput := i64(cat.node_types[t.node_type[ns]].throughput_units)
+		new := Strain_Level.None
+		if throughput > 0 {
+			new = strain_level(nload[ns] * 100 / throughput, w.node_amber_pct, w.node_red_pct)
+		}
+		cr.node_strain[ns] = node_strain_transition(state, tick, cr.node_strain[ns], new, t.node_id[ns])
+	}
+
+	// --- 4. pipe levels (each pipe carries its bundle's pressure) + events
+	for ps in 0..<len(t.pipe_alive) {
+		if !t.pipe_alive[ps] {
+			cr.pipe_strain[ps] = .None
+			continue
+		}
+		bs := state.bundles.pipe_bundle[ps]
+		new := Strain_Level.None
+		if bs != NO_BUNDLE && lane_bound_units > 0 {
+			new = strain_level(press[bs] * 100 / lane_bound_units, w.pipe_amber_pct, w.pipe_red_pct)
+		}
+		cr.pipe_strain[ps] = pipe_strain_transition(state, tick, cr.pipe_strain[ps], new, t.pipe_id[ps])
+	}
+
+	// --- 5. the demand forecast: every era set-piece inside its window
+	// [start - lead, start + duration) — a pure read of the schedule. The
+	// forecast never fires anything (4.2's job); countdown_ticks = start - tick
+	// (0 once active — the panel shows NOW).
+	clear(&cr.forecast)
+	if state.era > 0 && int(state.era) <= len(cat.demand.eras) {
+		de := &cat.demand.eras[state.era-1]
+		for si in 0..<len(de.set_pieces) {
+			sp := &de.set_pieces[si]
+			lead := sp.forecast_lead_ticks
+			window_start := sp.start_tick
+			if window_start > lead {
+				window_start -= lead
+			} else {
+				window_start = 0
+			}
+			if tick < window_start { continue }
+			if tick >= sp.start_tick + sp.duration_ticks { continue }
+			countdown := u64(0)
+			if tick < sp.start_tick {
+				countdown = sp.start_tick - tick
+			}
+			append(&cr.forecast, Forecast_Entry{
+				sp_index = u16(si),
+				class = sp.class,
+				multiplier = sp.multiplier,
+				start_tick = sp.start_tick,
+				countdown_ticks = countdown,
+				active = tick >= sp.start_tick,
+			})
+		}
+	}
+}
diff --git a/core/warnings_test.odin b/core/warnings_test.odin
new file mode 100644
index 0000000..62bd8f5
--- /dev/null
+++ b/core/warnings_test.odin
@@ -0,0 +1,297 @@
+package core
+
+// warnings_test.odin — pins the 4.1 warning surface (warnings.odin):
+//   (a) node strain = the STUCK-packet backlog (waiting_ticks >= 1) vs node
+//       throughput — amber at the balance 70 % ladder, red at 90 %, with
+//       Warning_Raised/Cleared events at exact ticks;
+//   (b) the no-flicker contract — fresh spawns + fresh transit arrivals
+//       (waiting_ticks 0) never strain, so a healthy busy network emits
+//       ZERO warning events;
+//   (c) pipe pressure = the fullest lane's depth vs its E9 bound (6 packets =
+//       100 % — dropping; 5 = 83 % amber; a lone packet = 17 % healthy);
+//   (d) the forecast = the era set-pieces inside their windows (exact
+//       countdowns; active rows; out-of-window rows absent);
+//   (e) zero-traffic neutrality (E24 pattern) — no strain, no events;
+//   (f) replay byte-identity (E10) — the warning state + event stream
+//       reproduce from the action log alone.
+//
+// All expectations are GOLDEN-VERIFIED (the 3.4 pattern): the sim is seeded
+// + deterministic, so the crossing ticks are exact. If a threshold or a
+// spawn lands differently, the ticks here must be re-read from the sim and
+// re-pinned — never guessed.
+
+import "core:testing"
+
+// warn_record_run — step a run collecting the warning event stream (the
+// ODN-14 drain convention: record_run clears the buffer per tick, so
+// event-scans must collect as they step) + the per-tick hashes. Only
+// Warning_Raised / Warning_Cleared events are collected.
+warn_record_run :: proc(s: ^Run_State, ticks: u64, cat: ^Catalogs) -> ([dynamic]u64, [dynamic]Event) {
+	hashes := make([dynamic]u64, 0, ticks)
+	events := make([dynamic]Event, 0, 16)
+	for tick in u64(1)..=ticks {
+		before := len(s.events)
+		batch := make([dynamic]Command, 0, 4, context.temp_allocator)
+		for cmd in s.action_log {
+			if cmd.apply_tick == tick {
+				append(&batch, cmd)
+			}
+		}
+		step(s, tick, batch[:], cat)
+		for e in s.events[before:] {
+			if e.tag == EVENT_TAG_WARNING_RAISED || e.tag == EVENT_TAG_WARNING_CLEARED {
+				append(&events, e)
+			}
+		}
+		append(&hashes, state_hash(s, s.events[before:], cat, context.temp_allocator))
+		clear(&s.events)
+		free_all(context.temp_allocator)
+	}
+	return hashes, events
+}
+
+// warn_assert_stream — the exact-stream pin: every collected event must equal
+// the expected (tick, tag, sign, target) in order, and vice versa.
+warn_assert_stream :: proc(t: ^testing.T, got: []Event, want: []Event) {
+	testing.expectf(t, len(got) == len(want), "warning stream: got %d events, want %d — %v",
+		len(got), len(want), got)
+	for i in 0..<min(len(got), len(want)) {
+		e := got[i]
+		w := want[i]
+		testing.expectf(t, e.tick == w.tick && e.tag == w.tag && e.sign == w.sign && e.target == w.target,
+			"event %d: got (tick %d tag %d sign %d target %d) want (tick %d tag %d sign %d target %d)",
+			i, e.tick, e.tag, e.sign, e.target, w.tick, w.tag, w.sign, w.target)
+	}
+}
+
+// --- (a) node strain transitions + events -------------------------------------
+
+@(test)
+test_node_strain_amber_red_clear :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 7, cat.hash, TEST_LOGIC_HZ)
+	res, rt, host := test_seed_fixture(&s, cat)
+	sla_draw(&s, cat, res, rt, "standard", 1) // only res->router until relief
+	sla_draw(&s, cat, rt, host, "standard", 8) // the relief draw
+	// host->res packets with no full route pile up AT THE HOST (the routing
+	// table gives complete paths only — the packet waits where the route
+	// fails). Host throughput 80: 1 packet = 37 % (healthy), 2 = 75 % (amber),
+	// 3 = 112 % (red). The relief draw opens host->router->res and drains all.
+	sla_spawn(&s, 1, 0, host, res)
+	sla_spawn(&s, 2, 0, host, res)
+	sla_spawn(&s, 3, 0, host, res)
+	hashes, evs := warn_record_run(&s, 20, cat)
+	defer delete(hashes)
+	defer delete(evs)
+
+	// The hand-verified stream (each spawn tick the forward pass fails the
+	// missing route and increments waiting_ticks; the resident never strains
+	// and pipe 0 never crosses 70 % of a lane bound — max 3 packets = 50 %):
+	//   @2 RAISED Node_Strained, node 2 (A+B: 60/80 = 75 %)
+	//   @3 RAISED Node_Critical, node 2 (A+B+C: 90/80 = 112 %)
+	//   @8 CLEARED Node_Critical, node 2 (the relief draw lets all through)
+	warn_assert_stream(t, evs[:], []Event{
+		{tick = 2, tag = EVENT_TAG_WARNING_RAISED, sign = u8(Warning_Sign.Node_Strained), target = 2},
+		{tick = 3, tag = EVENT_TAG_WARNING_RAISED, sign = u8(Warning_Sign.Node_Critical), target = 2},
+		{tick = 8, tag = EVENT_TAG_WARNING_CLEARED, sign = u8(Warning_Sign.Node_Critical), target = 2},
+	})
+}
+
+// --- (b) the no-flicker contract ----------------------------------------------
+
+@(test)
+test_node_strain_no_flicker_healthy_transit :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 11, cat.hash, TEST_LOGIC_HZ)
+	res, rt, host := test_seed_fixture(&s, cat)
+	sla_draw(&s, cat, res, rt, "standard", 1)
+	sla_draw(&s, cat, rt, host, "standard", 1)
+	// lone transits, spaced 6 ticks — each packet forwards every tick it is
+	// at a node (healthy path), so waiting_ticks stays 0 and NOTHING strains
+	for k in u64(1)..=25 {
+		if k % 6 == 1 {
+			sla_spawn(&s, k, 0, res, host)
+		}
+	}
+	hashes, evs := warn_record_run(&s, 30, cat)
+	defer delete(hashes)
+	defer delete(evs)
+
+	testing.expectf(t, len(evs) == 0, "healthy transits must never warn, got %v", evs)
+	testing.expect_value(t, s.crisis.node_strain[0], Strain_Level.None)
+	testing.expect_value(t, s.crisis.node_strain[1], Strain_Level.None)
+	testing.expect_value(t, s.crisis.node_strain[2], Strain_Level.None)
+	// every surviving packet that transited has waiting_ticks 0 (the counter
+	// is the strain measure — a healthy run must not accrue it)
+	for p in s.flow.packets {
+		testing.expectf(t, p.waiting_ticks == 0, "packet %d accrued waiting_ticks %d on a healthy path",
+			p.id, p.waiting_ticks)
+	}
+}
+
+// --- (c) pipe pressure vs the E9 lane bound ------------------------------------
+
+@(test)
+test_pipe_pressure_lane_bound :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 13, cat.hash, TEST_LOGIC_HZ)
+	res, rt, host := test_seed_fixture(&s, cat)
+	sla_draw(&s, cat, res, rt, "standard", 1)
+	sla_draw(&s, cat, rt, host, "standard", 1)
+	// SIX packets in the Standard lane of pipe 0's bundle, ALL spawned at
+	// tick 1: they forward together onto pipe 0 (the lane bound is 6 — they
+	// fit exactly) and the slow service (15 units/tick = 0.5 packets/tick)
+	// drains them one per 2 ticks. Depth: 6/6 = 100 % red @1, 5/6 = 83 %
+	// amber from the first arrival, 4/6 = 67 % healthy from the second.
+	for k in u64(1)..=6 {
+		sla_spawn(&s, 1, 0, res, host)
+	}
+	hashes, evs := warn_record_run(&s, 20, cat)
+	defer delete(hashes)
+	defer delete(evs)
+
+	// The hand-verified stream (FIFO service: packet n arrives at end of tick
+	// 2n+1, so the depth drops 6 -> 5 at tick 3 and 5 -> 4 at tick 5; the
+	// arrivals forward onward on pipe 1 the next tick — the full route exists
+	// — so no node strain):
+	//   @1 RAISED  Pipe_Critical, pipe 0 (6/6 of the E9 bound — dropping)
+	//   @3 CLEARED Pipe_Critical, pipe 0 (5/6 = 83 % — still amber)
+	//   @5 CLEARED Pipe_Pressure, pipe 0 (4/6 = 67 % — healthy again)
+	warn_assert_stream(t, evs[:], []Event{
+		{tick = 1, tag = EVENT_TAG_WARNING_RAISED, sign = u8(Warning_Sign.Pipe_Critical), target = 0},
+		{tick = 3, tag = EVENT_TAG_WARNING_CLEARED, sign = u8(Warning_Sign.Pipe_Critical), target = 0},
+		{tick = 5, tag = EVENT_TAG_WARNING_CLEARED, sign = u8(Warning_Sign.Pipe_Pressure), target = 0},
+	})
+}
+
+// --- (d) the demand forecast ----------------------------------------------------
+
+@(test)
+test_forecast_window_rows :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	// pure schedule reads: no traffic needed (the forecast is a function of
+	// era + tick + catalog). Era 3's surge: start 1200, duration 1800, lead
+	// 600 -> window [600, 3000).
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 3, cat.hash, TEST_LOGIC_HZ)
+	s.era = 3
+
+	check :: proc(t: ^testing.T, s: ^Run_State, cat: ^Catalogs, tick: u64,
+		want_rows: int, want_countdown: u64, want_active: bool) {
+		step(s, tick, {}, cat)
+		testing.expectf(t, len(s.crisis.forecast) == want_rows,
+			"tick %d: forecast rows %d, want %d", tick, len(s.crisis.forecast), want_rows)
+		if len(s.crisis.forecast) == 1 {
+			f := s.crisis.forecast[0]
+			testing.expectf(t, f.sp_index == 0 && f.class == 1 && f.multiplier == 10,
+				"tick %d: row sp %d class %d mult %d", tick, f.sp_index, f.class, f.multiplier)
+			testing.expectf(t, f.countdown_ticks == want_countdown,
+				"tick %d: countdown %d, want %d", tick, f.countdown_ticks, want_countdown)
+			testing.expectf(t, f.active == want_active,
+				"tick %d: active %v, want %v", tick, f.active, want_active)
+		}
+		clear(&s.events)
+	}
+
+	check(t, &s, cat, 599, 0, 0, false)   // before the lead window
+	check(t, &s, cat, 600, 1, 600, false) // window opens at start - lead
+	check(t, &s, cat, 1000, 1, 200, false)
+	check(t, &s, cat, 1199, 1, 1, false)
+	check(t, &s, cat, 1200, 1, 0, true) // active: countdown 0, NOW
+	check(t, &s, cat, 2999, 1, 0, true)
+	check(t, &s, cat, 3000, 0, 0, false) // window closed (start + duration)
+}
+
+// --- (e) zero-traffic neutrality -------------------------------------------------
+
+@(test)
+test_zero_traffic_neutral :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 17, cat.hash, TEST_LOGIC_HZ)
+	test_seed_fixture(&s, cat)
+	hashes, evs := warn_record_run(&s, 30, cat)
+	defer delete(hashes)
+	defer delete(evs)
+
+	testing.expectf(t, len(evs) == 0, "zero traffic must emit no warnings, got %v", evs)
+	testing.expectf(t, len(s.crisis.forecast) == 0, "era 0 must carry no forecast rows")
+	for i in 0..<len(s.crisis.node_strain) {
+		testing.expect_value(t, s.crisis.node_strain[i], Strain_Level.None)
+	}
+	for i in 0..<len(s.crisis.pipe_strain) {
+		testing.expect_value(t, s.crisis.pipe_strain[i], Strain_Level.None)
+	}
+}
+
+// --- (f) replay byte-identity -----------------------------------------------------
+
+@(test)
+test_warning_replay_byte_identical :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	live: Run_State
+	defer run_destroy(&live)
+	run_init(&live, 19, cat.hash, TEST_LOGIC_HZ)
+	res, rt, host := test_seed_fixture(&live, cat)
+	sla_draw(&live, cat, res, rt, "standard", 1)
+	sla_draw(&live, cat, rt, host, "standard", 8)
+	sla_spawn(&live, 1, 0, host, res)
+	sla_spawn(&live, 2, 0, host, res)
+	sla_spawn(&live, 3, 0, host, res)
+	live_hashes, live_evs := warn_record_run(&live, 20, cat)
+	defer delete(live_hashes)
+	defer delete(live_evs)
+
+	replayed: Run_State
+	defer run_destroy(&replayed)
+	run_init(&replayed, 19, cat.hash, TEST_LOGIC_HZ)
+	res_idx, _ := node_type_index(cat, "residential")
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	host_idx, _ := node_type_index(cat, "content_host")
+	topology_spawn_node(&replayed.topology, res_idx, {8, 15}, cat)
+	topology_spawn_node(&replayed.topology, rt_idx, {20, 15}, cat)
+	topology_spawn_node(&replayed.topology, host_idx, {32, 15}, cat)
+	replayed.action_log = clone_log(live.action_log, context.allocator)
+	sla_spawn(&replayed, 1, 0, 2, 0)
+	sla_spawn(&replayed, 2, 0, 2, 0)
+	sla_spawn(&replayed, 3, 0, 2, 0)
+	replayed_hashes, replayed_evs := warn_record_run(&replayed, 20, cat)
+	defer delete(replayed_hashes)
+	defer delete(replayed_evs)
+
+	testing.expectf(t, len(replayed_hashes) == len(live_hashes), "hash stream lengths must match")
+	for i in 0..<len(live_hashes) {
+		if replayed_hashes[i] != live_hashes[i] {
+			testing.expectf(t, false, "FIRST DIVERGENCE at tick %d: %016x != %016x",
+				i+1, replayed_hashes[i], live_hashes[i])
+			break
+		}
+	}
+	warn_assert_stream(t, replayed_evs[:], live_evs[:])
+}
diff --git a/data/balance.json b/data/balance.json
index 5893dcd..4ae60b7 100644
--- a/data/balance.json
+++ b/data/balance.json
@@ -6,6 +6,16 @@
   "packet_bandwidth": 30,
   "lane_queue_packets": 6,
   "pool_max_packets": 512,
+  "warnings": {
+    "_comment": "Story 4.1 warning-sign thresholds + lead times (art-direction §6.1 'Trigger [balance.json]'; GDD Numerical Design). Integer percents; leads in ticks @ 20Hz (30s=600, 10s=200, 20s=400). The UI telegraph reads the leads; the T1 pins the levels + the catalog_hash pins these numbers.",
+    "node_amber_pct": 70,
