@@ -0,0 +1,66 @@
+package render
+
+// forecast.odin — the 4.1 forecast "weather report" panel (the P3 fairness
+// surface, GDD M5): names the incoming SetPieces with a countdown, so the
+// player sees the surge coming and has time to redesign. Screen-space HUD,
+// drawn by the app's draw_hud AND the harness's T2 capture (single source —
+// the golden is the panel). It READS the serialized forecast rows only; it
+// never fires anything (that is 4.2's Crisis Engine).
+//
+// Zero pixels when the forecast is empty (the golden-stability rule: demos
+// outside a forecast window keep byte-identical T2 frames). The countdown is
+// the core's countdown_ticks at the last step boundary — the view never
+// samples time (ODN-1: the app steps at logic_hz; the panel shows the sim's
+// own clock, which is what replay sees).
+
+import "core:fmt"
+import "core:strings"
+import pp "../../core"
+import rl "vendor:raylib"
+
+// draw_forecast_panel — the weather report at the top-right. Each row names a
+// set-piece inside its forecast window: "<CLASS> SURGE ×N — 12s" (or "NOW"
+// once active). Color + glyph + caption — never color alone. Draws NOTHING
+// when there are no rows (the capture-stability contract).
+draw_forecast_panel :: proc(v: ^View, crisis: ^pp.Crisis_State, cat: ^pp.Catalogs) {
+	if len(crisis.forecast) == 0 {
+		return
+	}
+	p := v.palette
+	// the panel card (top-right, clear of the top-left run HUD)
+	card_w := i32(230)
+	pad := i32(10)
+	line_h := i32(20)
+	title_h := i32(24)
+	x := v.win_w - card_w - pad
+	y := i32(10)
+	rows := len(crisis.forecast)
+	h := title_h + i32(rows) * line_h + pad
+	// translucent card so the map still reads behind it
+	card := rl.Color{255, 252, 244, 235}
+	rl.DrawRectangle(x - pad, y - pad, card_w + 2 * pad, h, card)
+	border := rl.Color{51, 65, 79, 40}
+	rl.DrawRectangleLines(x - pad, y - pad, card_w + 2 * pad, h, border)
+
+	draw_text_c(v, "WEATHER REPORT", x, y, 16, p.ink)
+	ty := y + title_h - 4
+	for f in crisis.forecast {
+		name := "SETPIECE"
+		if int(f.class) < len(cat.packet_types) {
+			name = cat.packet_types[f.class].display
+		}
+		mult := fmt.aprintf("SURGE x%d", f.multiplier, allocator = context.temp_allocator)
+		col := p.state_strain
+		when_suffix := ""
+		if f.active {
+			when_suffix = "NOW"
+			col = p.state_critical
+		} else {
+			secs := f.countdown_ticks / u64(max(1, cat.balance.logic_hz))
+			when_suffix = fmt.aprintf("-%ds", secs, allocator = context.temp_allocator)
+		}
+		line := strings.join({name, mult, when_suffix}, "  ", context.temp_allocator)
+		draw_text_c(v, line, x, ty, 15, col)
+		ty += line_h
+	}
+}
