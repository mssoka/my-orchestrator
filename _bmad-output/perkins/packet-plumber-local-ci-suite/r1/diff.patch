+# Dockerfile.ci — the ubuntu leg of .github/workflows/ci.yml, runnable locally
+# for free (the GH Actions runner is billing-blocked since 2026-08-16; the
+# workflow stays byte-identical — this image is a LOCAL replica, not a change).
+#
+# Reproduces, in order: the pinned Odin release tarball (arch-aware, exactly
+# like the workflow's case block), the X11 link deps, then bakes the rlsw
+# software-raylib shadow (tools/build_raylib_sw.sh) so warm runs skip the
+# ~40s clone+compile that CI pays for on every run.
+#
+#   docker build -f Dockerfile.ci -t packet-plumber-ci:local .
+#
+# Use tools/ci-local.sh instead — it builds + runs with the right flags and
+# bind-mounts goldens/_reports/ so failure diff bundles surface on the host.
+FROM ubuntu:24.04
+
+# The workflow's steps all run under bash (ci.yml: shell: bash) — mirror that
+# so set -o pipefail semantics match CI exactly.
+SHELL ["/bin/bash", "-o", "pipefail", "-c"]
+
+# No interactive debconf prompts in image builds (the standard docker hang trap
+# if a future dep pulls tzdata/locales).
+ENV DEBIAN_FRONTEND=noninteractive
+
+# The workflow's Linux GUI link deps (ci.yml "Linux GUI link deps" step), plus
+# what the gates themselves need: lint.sh's python3 ASCII scanner, and the
+# rlsw shadow build's cc/ar/git.
+RUN apt-get update -qq \
+ && apt-get install -y -qq --no-install-recommends \
+      ca-certificates curl git build-essential clang python3 \
+      libx11-dev libxcursor-dev libxrandr-dev libxinerama-dev libxi-dev \
+      libgl1-mesa-dev \
+ && rm -rf /var/lib/apt/lists/*
+
+# The pinned Odin release tarball — the workflow's "Install Odin" step,
+# mirrored for the container's arch (docker buildx sets TARGETARCH for
+# cross-arch builds; plain builds fall back to uname -m).
+ARG TARGETARCH
+COPY .odin-version /src/.odin-version
+RUN set -euo pipefail \
+ && PIN="$(cat /src/.odin-version)" \
+ && case "${TARGETARCH:-$(uname -m)}" in \
+      amd64|x86_64)                ASSET="odin-linux-amd64-${PIN}.tar.gz" ;; \
+      arm64|aarch64)               ASSET="odin-linux-arm64-${PIN}.tar.gz" ;; \
+      *) echo "unsupported arch: ${TARGETARCH:-$(uname -m)}" >&2; exit 1 ;; \
+    esac \
+ && echo "fetching odin ${PIN} (${ASSET})" \
+ && curl -fsSL "https://github.com/odin-lang/Odin/releases/download/${PIN}/${ASSET}" -o /tmp/odin.tar.gz \
+ && mkdir -p /opt/odin \
+ && tar -xzf /tmp/odin.tar.gz -C /opt/odin \
+ && ODIN_BIN="$(find /opt/odin -maxdepth 3 -name odin -type f | head -1 | xargs dirname)" \
+ && if [ -z "${ODIN_BIN:-}" ] || [ ! -x "$ODIN_BIN/odin" ]; then \
+      echo "odin binary not found; artifact layout:"; find /opt/odin -maxdepth 3 | head -20; exit 1; \
+    fi \
+ && ln -sf "$ODIN_BIN/odin" /usr/local/bin/odin \
+ && odin version
+
+# Bake the rlsw software-raylib shadow (architecture §10.4: bit-exact pixels,
+# no GPU/display). Layer-cached: only tools/ changes invalidate it. The
+# shadow dir is dockerignored from the tree COPY below, so the bake survives.
+COPY tools/ /src/tools/
+RUN cd /src && tools/build_raylib_sw.sh
+
+# The repo itself — artifact dirs are stripped by .dockerignore, so the
+# container sees exactly what CI's checkout would see (plus the baked shadow).
+COPY . /src
+
+# ci-local.sh runs the container as the invoking uid (host-owned report files
+# in the goldens/_reports bind-mount); a+rwX keeps /src writable for it.
+RUN chmod -R a+rwX /src
+
+WORKDIR /src
+CMD ["tools/ci-local.sh", "--in-container"]
