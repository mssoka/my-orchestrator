+++ b/tools/ci-local.sh
@@ -0,0 +1,235 @@
+#!/usr/bin/env bash
+# tools/ci-local.sh — the GH CI gates, run locally for free.
+#
+#   tools/ci-local.sh                 # all 8 gates in a linux container (the ubuntu leg)
+#   tools/ci-local.sh --fast          # gates 1-2 only (lint + unit tests — the 10-second loop)
+#   tools/ci-local.sh --mac           # the same 8 gates natively on macOS
+#   tools/ci-local.sh --native        # alias for --mac
+#   tools/ci-local.sh --windows-cross # EXPERIMENTAL: compile-only windows cross-build
+#
+# The gate list mirrors .github/workflows/ci.yml step-for-step — the workflow
+# is the spec; never edit one without the other. Same order, same failure
+# semantics (stop on first failure), same per-gate names in the summary.
+set -uo pipefail
+
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+cd "$ROOT"
+
+IMAGE="packet-plumber-ci:local"
+FAST=0
+NATIVE=0
+WIN_CROSS=0
+IN_CONTAINER=0
+
+usage() {
+  cat <<'EOF'
+tools/ci-local.sh — the GH CI gates, run locally for free.
+
+  tools/ci-local.sh                 # all 8 gates in a linux container (the ubuntu leg)
+  tools/ci-local.sh --fast          # gates 1-2 only (lint + unit tests — the 10-second loop)
+  tools/ci-local.sh --mac           # the same 8 gates natively on macOS
+  tools/ci-local.sh --native        # alias for --mac
+  tools/ci-local.sh --windows-cross # EXPERIMENTAL: compile-only windows cross-build
+                                    # (probes the LOCAL toolchain; use --in-container for the container's)
+EOF
+}
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --fast) FAST=1 ;;
+    --mac|--native) NATIVE=1 ;;
+    --windows-cross) WIN_CROSS=1 ;;
+    --in-container) IN_CONTAINER=1 ;;
+    -h|--help) usage; exit 0 ;;
+    *) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
+  esac
+  shift
+done
+
+# ---------------------------------------------------------------- the gates --
+# One entry per GH CI run step (workflow order + workflow step names). The
+# SAME list runs in the container and natively — parity by construction.
+# (Gate 7 mirrors the workflow exactly: bin/ already exists by then because
+# gate 4's harness.sh mkdirs it — do NOT add setup steps to these commands.)
+GATES=(
+  "Purity + grep gates (ODN-1)|tools/lint.sh"
+  "Core unit tests (the determinism + topology contracts)|odin test core"
+  "Game builds (app.bin compiles + links)|odin build app -out:app.bin"
+  "Golden harness (T1 hashes + T2 software pixels + replay gate)|tools/harness.sh run"
+  "W1 drift-rejection negative test|tools/harness.sh drift-check"
+  "Assist preview cross-check (R2a preview == sim routing)|tools/harness.sh preview-check"
+  "PP_DEBUG overlay builds (compile gate)|odin build app -define:PP_DEBUG=true -out:app-debug.bin && odin build harness -define:PP_DEBUG=true -out:bin/harness-debug"
+  "Stats stream replay-identity (live == replay)|tools/harness.sh stats-check pause && tools/harness.sh stats-check qos_contention"
+)
+
+# run_gates <count> — run the first <count> gates, stop-on-fail, summarize.
+run_gates() {
+  local n="$1" results=() rc=0 i=0 label cmd entry
+  for entry in "${GATES[@]:0:$n}"; do
+    i=$((i + 1))
+    label="${entry%%|*}"
+    cmd="${entry#*|}"
+    echo ""
+    echo "── gate $i/$n — $label"
+    if bash -c "$cmd"; then
+      echo "   ✅ PASS"
+      results+=("✅  gate $i  $label")
+    else
+      rc=$?
+      echo "   ❌ FAIL (exit $rc)"
+      results+=("❌  gate $i  $label")
+      echo ""
+      echo "gate $i failed — stopping (same failure semantics as CI)."
+      break
+    fi
+  done
+  echo ""
+  echo "═══════════════════════════════════════════════════════════"
+  if [ "$NATIVE" -eq 1 ]; then LEG="native (macOS)"; else LEG="linux container"; fi
+  echo "  LOCAL CI SUMMARY — $LEG — $([ "$FAST" -eq 1 ] && echo "fast (gates 1-$n)" || echo "full suite")"
+  for r in "${results[@]}"; do echo "  $r"; done
+  if [ "$rc" -ne 0 ] && [ "${#results[@]}" -lt "$n" ]; then
+    echo "  ⏭  gates $(( ${#results[@]} + 1 ))-$n not run (stop-on-fail)"
+  fi
+  echo "═══════════════════════════════════════════════════════════"
+  return "$rc"
+}
+
+# ------------------------------------------------------ windows-cross gate --
+# EXPERIMENTAL, per the 2026-08-16 ruling: compile-ONLY probe of
+# -target:windows_amd64. If the toolchain/vendor:raylib fights it, REPORT the
+# output and exit 0-with-warning — never force it green.
+run_windows_cross() {
+  echo "== EXPERIMENTAL: windows_amd64 cross-build (compile-only gate, not in GH CI)"
+  if ! command -v odin >/dev/null 2>&1; then
+    echo "ERROR: odin not found on PATH — install the pinned release from .odin-version" >&2
+    exit 1
+  fi
+  # NOTE: the pinned odin (dev-2026-08) prints "Linking for cross compilation
+  # for this platform is not yet supported" on stderr and exits 0 WITHOUT
+  # emitting the binary — the exit code alone lies, so success = rc 0 AND the
+  # artifact exists.
+  local out rc
+  rm -f app-win.exe
+  out="$(odin build app -target:windows_amd64 -out:app-win.exe 2>&1)"
+  rc=$?
+  if [ "$rc" -eq 0 ] && [ -s app-win.exe ]; then
+    if [ "$IN_CONTAINER" -eq 1 ]; then
+      echo "   ✅ windows_amd64 cross-build succeeded → app-win.exe (in-container; the --rm container discards it)"
+    else
+      echo "   ✅ windows_amd64 cross-build succeeded → app-win.exe"
+    fi
+    return 0
+  fi
+  echo "   ❌ cross-build failed (exit $rc, no app-win.exe produced) — reporting the toolchain findings, not forcing:"
+  echo ""
+  [ -n "$out" ] && echo "$out"
+  echo ""
+  echo "⚠️  windows-cross: failed as reported above — exiting 0 (experimental gate; see the PR for findings)."
+  return 0
+}
+
+# ------------------------------------------------------------ native mode --
+run_native() {
+  if ! command -v odin >/dev/null 2>&1; then
+    echo "ERROR: odin not found on PATH — install the pinned release from .odin-version" >&2
+    exit 1
+  fi
+  local pin ver token
+  if [ ! -r .odin-version ]; then
+    echo "ERROR: .odin-version is missing or unreadable — cannot verify the toolchain pin" >&2
+    exit 1
+  fi
+  pin="$(cat .odin-version)"
+  ver="$(odin version | head -1)"
+  # Compare the version TOKEN, not a substring: a different-month toolchain
+  # (e.g. dev-2026-07 or a stable v0.x) must warn even when the pin string
+  # appears inside the version. A same-month NIGHTLY passes the token check
+  # but gets an informational note — the goldens are verified bit-identical
+  # between the release tarball and the nightly in the container-vs-native
+  # runs, so it is not a loud-warning event.
+  token="$(printf '%s' "$ver" | grep -oE 'dev-[0-9]{4}-[0-9]{2}' | head -1 || true)"
+  if [ "$token" != "$pin" ]; then
+    echo "⚠️  WARNING: local odin is '$ver', but .odin-version pins '$pin'."
+    echo "   The goldens can drift on a toolchain difference (CI uses the pinned release tarball)."
+    echo "   Continuing anyway — you were warned."
+  elif printf '%s' "$ver" | grep -q 'nightly'; then
+    echo "ℹ  local odin is a $pin nightly — the CI pin is the release tarball."
+    echo "   Same-month nightlies produced bit-identical goldens in the container-vs-native runs;"
+    echo "   re-check if the nightly moves mid-month."
+  fi
+  run_gates "$([ "$FAST" -eq 1 ] && echo 2 || echo 8)"
+}
+
+# --------------------------------------------------------- container mode --
+run_container() {
+  if ! docker info >/dev/null 2>&1; then
+    echo "ERROR: Docker is not running (or not installed). Start Docker Desktop, then retry." >&2
+    echo "       This is a dev tool, not CI — no cryptic socket errors here." >&2
+    exit 1
+  fi
+  echo "== building $IMAGE (layer-cached; the first build fetches the pinned odin + raylib 6.0)"
+  if ! docker build -f "$ROOT/Dockerfile.ci" -t "$IMAGE" "$ROOT"; then
+    echo "ERROR: docker build failed — check the output above (network fetch of the pinned toolchain is the usual cause)." >&2
+    exit 1
+  fi
+  local reports="$ROOT/goldens/_reports" extra=() rc
+  if ! mkdir -p "$reports"; then
+    echo "ERROR: cannot create $reports — check the parent dir's permissions." >&2
+    exit 1
+  fi
+  [ "$FAST" -eq 1 ] && extra+=(--fast)
+  [ "$WIN_CROSS" -eq 1 ] && extra+=(--windows-cross)
+  echo "== running the suite in the container (host build artifacts never enter it;"
+  echo "   goldens/_reports/ is the only writable mount, so failure bundles surface here)"
+  # Pre-flight: prove the bind mount is actually writable by the container
+  # uid before spending minutes on gates (SELinux-enforcing Linux hosts need
+  # a :z/:Z label on the mount — the probe names it instead of a bare EACCES).
+  if ! docker run --rm --user "$(id -u):$(id -g)" \
+        -v "$reports:/src/goldens/_reports" "$IMAGE" \
+        bash -c 'touch /src/goldens/_reports/.ci-local-probe && rm -f /src/goldens/_reports/.ci-local-probe' >/dev/null 2>&1; then
+    echo "ERROR: the container cannot write into $reports." >&2
+    echo "       On SELinux-enforcing Linux hosts add ':Z' to the bind mount; otherwise check the dir's ownership." >&2
+    exit 1
+  fi
+  docker run --rm \
+    --user "$(id -u):$(id -g)" \
+    -v "$reports:/src/goldens/_reports" \
+    "$IMAGE" tools/ci-local.sh --in-container ${extra[@]+"${extra[@]}"}
+  rc=$?
+  if [ "$rc" -ne 0 ]; then
+    echo ""
+    echo "container run failed (exit $rc) — see the gate summary above." >&2
+  fi
+  exit "$rc"
+}
+
+# --------------------------------------------------------------- dispatch --
+# Flag conflicts fail loudly — they are never silently redefined.
+if [ "$WIN_CROSS" -eq 1 ] && [ "$FAST" -eq 1 ]; then
+  echo "ERROR: --windows-cross and --fast cannot be combined (the cross probe replaces the gate list)." >&2
+  exit 2
+fi
+if [ "$IN_CONTAINER" -eq 1 ] && [ "$NATIVE" -eq 1 ]; then
+  echo "ERROR: --in-container and --mac/--native are mutually exclusive." >&2
+  exit 2
+fi
+
+# --windows-cross probes the LOCAL toolchain by default (briefing AC: "given
+# the mac toolchain"); only --in-container probes the container's toolchain.
+if [ "$WIN_CROSS" -eq 1 ]; then
+  run_windows_cross
+  exit $?
+fi
+
+if [ "$IN_CONTAINER" -eq 1 ]; then
+  run_gates "$([ "$FAST" -eq 1 ] && echo 2 || echo 8)"
+  exit $?
+fi
+
+if [ "$NATIVE" -eq 1 ]; then
+  run_native
+  exit $?
+fi
+
+run_container
