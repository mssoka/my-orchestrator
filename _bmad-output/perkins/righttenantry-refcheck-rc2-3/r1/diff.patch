diff --git a/server/test/integration/reference_checks_trigger_integration_test.gleam b/server/test/integration/reference_checks_trigger_integration_test.gleam
new file mode 100644
index 00000000..6fc64c3b
--- /dev/null
+++ b/server/test/integration/reference_checks_trigger_integration_test.gleam
@@ -0,0 +1,460 @@
+//// Integration tests for the reference-check trigger + manual control APIs
+//// (RC2.3) — durable DB-level pins for the story's acceptance criteria:
+//// auto-create on the viewed transition (right slots, no-contact skip,
+//// declined suppression, pre-v1 allowed), idempotency against the live-slot
+//// index, manual-start equivalence, skip (queued->skipped + before-trigger
+//// create + idempotent), re-enable (skipped->queued + next_attempt_at
+//// re-arm), pre-excluded-slot respect, and the lifecycle audit rows (AD-16).
+
+import gleam/dynamic/decode
+import gleam/option.{type Option, None, Some}
+import gleeunit/should
+import integration/helpers.{setup, test_server_config}
+import integration/test_db
+import pog
+import reference_checks/trigger
+import unitest
+import youid/uuid
+
+// --- seed helpers ----------------------------------------------------------
+
+/// Seeds a landlord + paid vacancy + application with full referee trios
+/// (landlord, character, employer — all with email + phone),
+/// `never_rented_before`, and `reference_contact_choice`. `choice` is
+/// `"attested"`, `"declined"`, or `""` for NULL (the pre-v1 case). Returns
+/// `(landlord_id, vacancy_id, application_id)`.
+fn seed_full_app(
+  db: pog.Connection,
+  email: String,
+  never_rented: Bool,
+  choice: String,
+) -> #(String, String, String) {
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 0)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let never_rented_sql = case never_rented {
+    True -> "true"
+    False -> "false"
+  }
+  let assert Ok(returned) =
+    pog.query("INSERT INTO application (
+         vacancy_id, first_name, last_name, email, phone,
+         employment_status, monthly_income_cents,
+         landlord_ref_name, landlord_ref_email, landlord_ref_phone,
+         character_ref_name, character_ref_email, character_ref_phone,
+         employer_ref_name, employer_ref_email, employer_ref_phone,
+         never_rented_before, reference_contact_choice
+       )
+       VALUES (
+         $1::uuid, 'Aisling', 'Applicant', $2, '+353861234567',
+         'employed', 250000,
+         'Larry Landlord', 'larry@example.com', '+353871111111',
+         'Carla Character', 'carla@example.com', '+353872222222',
+         'Ed Employer', 'ed@example.com', '+353873333333',
+         " <> never_rented_sql <> ", NULLIF($3, '')
+       )
+       RETURNING id::text")
+    |> pog.parameter(pog.text(vacancy_id))
+    |> pog.parameter(pog.text(email))
+    |> pog.parameter(pog.text(choice))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  let assert [application_id, ..] = returned.rows
+  #(landlord_id, vacancy_id, application_id)
+}
+
+/// Like `seed_full_app` but omits the employer-ref contact (no email, no
+/// phone) so the employer slot has no contact data.
+fn seed_app_no_employer_contact(
+  db: pog.Connection,
+  email: String,
+) -> #(String, String, String) {
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 0)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let assert Ok(returned) =
+    pog.query(
+      "INSERT INTO application (
+         vacancy_id, first_name, last_name, email, phone,
+         employment_status, monthly_income_cents,
+         landlord_ref_name, landlord_ref_email, landlord_ref_phone,
+         employer_ref_name, employer_ref_email, employer_ref_phone,
+         never_rented_before, reference_contact_choice
+       )
+       VALUES (
+         $1::uuid, 'Aisling', 'Applicant', $2, '+353861234567',
+         'employed', 250000,
+         'Larry Landlord', 'larry@example.com', '+353871111111',
+         'Ed Employer', NULL, NULL,
+         false, 'attested'
+       )
+       RETURNING id::text",
+    )
+    |> pog.parameter(pog.text(vacancy_id))
+    |> pog.parameter(pog.text(email))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  let assert [application_id, ..] = returned.rows
+  #(landlord_id, vacancy_id, application_id)
+}
+
+fn uuids(
+  landlord_id: String,
+  vacancy_id: String,
+  application_id: String,
+) -> #(uuid.Uuid, uuid.Uuid, uuid.Uuid) {
+  let assert Ok(l) = uuid.from_string(landlord_id)
+  let assert Ok(v) = uuid.from_string(vacancy_id)
+  let assert Ok(a) = uuid.from_string(application_id)
+  #(l, v, a)
+}
+
+// --- inspection helpers ----------------------------------------------------
+
+fn count_calls(db: pog.Connection, application_id: String) -> Int {
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT COUNT(*)::int FROM reference_call WHERE application_id = $1",
+    )
+    |> pog.parameter(pog.text(application_id))
+    |> pog.returning(decode.at([0], decode.int))
+    |> pog.execute(db)
+  case returned.rows {
+    [n, ..] -> n
+    _ -> -1
+  }
+}
+
+/// The status of the live (non-terminal) row for a slot, if any.
+fn live_status(
+  db: pog.Connection,
+  application_id: String,
+  slot: String,
+) -> Option(String) {
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT status::text FROM reference_call
+       WHERE application_id = $1 AND ref_slot = $2 AND owner_label = 'primary'
+         AND status NOT IN (
+           'form_completed','unreachable','refused','objected',
+           'manual_recorded','failed','completed','partial'
+         )",
+    )
+    |> pog.parameter(pog.text(application_id))
+    |> pog.parameter(pog.text(slot))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  case returned.rows {
+    [s, ..] -> Some(s)
+    _ -> None
+  }
+}
+
+/// Any row for a slot (incl. terminal), by status — used to confirm a
+/// skipped row exists regardless of liveness.
+fn any_status(
+  db: pog.Connection,
+  application_id: String,
+  slot: String,
+) -> Option(String) {
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT status::text FROM reference_call
+       WHERE application_id = $1 AND ref_slot = $2 AND owner_label = 'primary'",
+    )
+    |> pog.parameter(pog.text(application_id))
+    |> pog.parameter(pog.text(slot))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  case returned.rows {
+    [s, ..] -> Some(s)
+    _ -> None
+  }
+}
+
+fn next_attempt_is_set(
+  db: pog.Connection,
+  application_id: String,
+  slot: String,
+) -> Bool {
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT (next_attempt_at IS NOT NULL)::text FROM reference_call
+       WHERE application_id = $1 AND ref_slot = $2 AND owner_label = 'primary'",
+    )
+    |> pog.parameter(pog.text(application_id))
+    |> pog.parameter(pog.text(slot))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  case returned.rows {
+    ["true", ..] -> True
+    _ -> False
+  }
+}
+
+fn count_audit(db: pog.Connection, event_str: String) -> Int {
+  let assert Ok(returned) =
+    pog.query("SELECT COUNT(*)::int FROM audit_log WHERE event_type = $1")
+    |> pog.parameter(pog.text(event_str))
+    |> pog.returning(decode.at([0], decode.int))
+    |> pog.execute(db)
+  case returned.rows {
+    [n, ..] -> n
+    _ -> -1
+  }
+}
+
+// --- tests -----------------------------------------------------------------
+
+pub fn viewed_trigger_creates_landlord_and_employer_rows_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id) =
+    seed_full_app(db, "rc3-a@example.com", False, "attested")
+  let #(landlord, vacancy, app) = uuids(landlord_id, vacancy_id, app_id)
+
+  let outcome = trigger.run_create_checks(config, app, landlord, vacancy)
+
+  outcome |> should.equal(Ok(trigger.Created(count: 2)))
+  count_calls(db, app_id) |> should.equal(2)
+  live_status(db, app_id, "landlord_ref") |> should.equal(Some("queued"))
+  live_status(db, app_id, "employer_ref") |> should.equal(Some("queued"))
+  // Nothing is sent at creation (AD-14) — but the cadence clock is armed.
+  next_attempt_is_set(db, app_id, "landlord_ref") |> should.be_true
+  next_attempt_is_set(db, app_id, "employer_ref") |> should.be_true
+  // The character slot is never used when the applicant rented before.
+  live_status(db, app_id, "character_ref") |> should.equal(None)
+}
+
+pub fn viewed_trigger_uses_character_ref_when_never_rented_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id) =
+    seed_full_app(db, "rc3-b@example.com", True, "attested")
+  let #(landlord, vacancy, app) = uuids(landlord_id, vacancy_id, app_id)
+
+  let _ = trigger.run_create_checks(config, app, landlord, vacancy)
+
+  // Never-rented swaps the character slot in for the landlord slot (AD-13);
+  // the landlord slot is NOT used.
