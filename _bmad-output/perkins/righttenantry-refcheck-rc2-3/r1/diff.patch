@@ -0,0 +1,29 @@
+-- Pre-trigger skip (A6, FR-RC4): when a landlord excludes a reference
+-- BEFORE the viewing trigger has created any row, insert a 'skipped' row
+-- directly so it OCCUPIES the slot. The auto-trigger's
+-- insert_reference_call_if_absent then hits ON CONFLICT DO NOTHING against
+-- this skipped row (skipped is live for idx_reference_call_live, A6), so a
+-- landlord-pre-excluded slot is respected when the viewing fires.
+--
+-- ON CONFLICT DO NOTHING makes a repeated skip idempotent (a second skip on
+-- a slot that already has a skipped -- or any live -- row is a silent
+-- no-op). RETURNING yields 0 rows on conflict (caller writes no audit) and
+-- 1 row on insert (caller writes the reference_call_skipped audit).
+--
+-- next_attempt_at is NULL: a skipped row is never chased by the sweep. The
+-- contact snapshot is carried so a later re-enable has someone to chase.
+-- contact_name is NOT NULL in the schema, so the caller MUST only invoke
+-- this when the slot has a name (otherwise skip is a no-op -- there is no
+-- referee to exclude).
+INSERT INTO reference_call (
+  application_id, ref_slot, owner_label,
+  contact_name, contact_email, contact_phone,
+  status, next_attempt_at
+)
+VALUES ($1, $2, $3, $4, NULLIF($5, ''), NULLIF($6, ''), 'skipped', NULL)
+ON CONFLICT (application_id, ref_slot, owner_label) WHERE status NOT IN (
+  'form_completed', 'unreachable', 'refused', 'objected',
+  'manual_recorded', 'failed', 'completed', 'partial'
+)
+DO NOTHING
+RETURNING id::text;
diff --git a/server/src/reference_checks/sql/re_enable_reference_call.sql b/server/src/reference_checks/sql/re_enable_reference_call.sql
new file mode 100644
index 00000000..dde2981c
--- /dev/null
+++ b/server/src/reference_checks/sql/re_enable_reference_call.sql
@@ -0,0 +1,18 @@
+-- Re-enable a skipped reference (A6, FR-RC4): guarded skipped -> queued
+-- transition that RE-ARMS the cadence clock (next_attempt_at = now()) so
+-- the sweep (RC3.5) picks the row up. The sweep owns all sends (AD-14) --
+-- re-enabling sends nothing, it only makes the row eligible again.
+--
+-- This is a dedicated query rather than reusing update_reference_call_status
+-- because that query's next_attempt_at CASE only clears (entering a
+-- terminal/skipped status) or preserves (other transitions); it can never
+-- re-arm to now(). Re-enable is the one transition that must re-arm.
+--
+-- 0-row result means no 'skipped' row exists for the id -- the caller
+-- surfaces a branded 404.
+UPDATE reference_call
+SET status = 'queued'::reference_call_status,
+    next_attempt_at = now()
+WHERE id = $1
+  AND status = 'skipped'::reference_call_status
+RETURNING id::text;
diff --git a/server/src/reference_checks/trigger.gleam b/server/src/reference_checks/trigger.gleam
new file mode 100644
index 00000000..bcd4fcaa
--- /dev/null
+++ b/server/src/reference_checks/trigger.gleam
@@ -0,0 +1,921 @@
+//// Reference-check creation trigger + landlord control APIs (Story RC2.3).
+////
+//// Connects RC2.2's `viewed` application status to RC2.1's `reference_call`
+//// schema: when a landlord marks the viewing done, the system auto-creates
+//// `queued` reference-call rows for the primary applicant's applicable
+//// referee slots (FR-RC3). The landlord can also start a check manually
+//// pre-viewing and skip/re-enable individual references (FR-RC4 + A6).
+////
+//// The sweep (RC3.5) owns every actual send — creation stamps
+//// `next_attempt_at = now()` and sends nothing (AD-14). Declined
+//// attestation (`reference_contact_choice = 'declined'`) suppresses
+//// creation entirely: the feature is off for that application (A4).
+
+import ai/sql as ai_sql
+import application/sql as app_sql
+import audit/audit_log
+import audit/escalation
+import audit/event_type
+import config.{type ServerConfig}
+import gleam/json
+import gleam/list
+import gleam/option.{type Option, None, Some}
+import gleam/string
+import pog
+import response_helpers
+import retention/audit_log_schema as alog
+import sentry/sentry_client
+import shared/error_code
+import shared/landlord.{type Landlord}
+import wisp.{type Request, type Response}
+import youid/uuid.{type Uuid}
+
+import reference_checks/sql
+
+/// The primary-applicant owner label. Co-applicant employer refs are
+/// schema-ready (`owner_label`) but their auto-triggering is deferred
+/// (AD-13) — v1 creates rows for the primary applicant only.
+const primary_owner: String = "primary"
+
+/// `entity_type` for every `reference_call` lifecycle audit row (AD-16).
+const audit_entity: String = "reference_call"
+
+// ---------------------------------------------------------------------------
+// Viewed trigger (FR-RC3) — post-commit hook in apply_status_update
+// ---------------------------------------------------------------------------
+
+/// Post-commit hook for `apply_status_update` (the sibling of
+/// `maybe_send_shortlist_notification`): when the transition lands on
+/// `Viewed`, auto-create the `queued` reference-call rows. Returns `Nil` —
+/// the status change has already committed and the response goes out
+/// regardless; a creation failure is observability-only (Sentry), matching
+/// the shortlist-notification posture at this exact call site. The manual-
+/// start API is the human-recoverable fallback if this silently fails.
+pub fn maybe_trigger_reference_checks(
+  config: ServerConfig,
+  app_uuid: Uuid,
+  landlord_uuid: Uuid,
+  vacancy_uuid: Uuid,
+  new_status: app_sql.ApplicationStatus,
+) -> Nil {
+  case new_status {
+    app_sql.Viewed ->
+      case run_create_checks(config, app_uuid, landlord_uuid, vacancy_uuid) {
+        Ok(_) -> Nil
+        Error(error) -> {
+          report_trigger_failure(config.sentry, app_uuid, error)
+          Nil
+        }
+      }
+    _ -> Nil
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Core creation — shared by the viewed trigger and the manual-start API
+// ---------------------------------------------------------------------------
+
+/// Outcome of a creation pass. `Created` carries the number of rows actually
+/// inserted (0 when every applicable slot already had a live row or none were
+/// eligible); `Suppressed` means the applicant declined attestation so no rows
+/// were even considered.
+pub type CreateOutcome {
+  Created(count: Int)
+  Suppressed
+}
+
+/// Why creation could not proceed.
+pub type CreateError {
+  /// The application was not found or not owned by the landlord — the read
+  /// returned no row. The trigger path treats this as observability-only
+  /// (ownership was already verified by the status PATCH); the manual-start
+  /// path surfaces it as a branded 404.
+  ApplicationNotFound
+  /// A database failure inside the creation transaction.
+  DbError(pog.TransactionError(String))
+}
+
+/// The single creation path for both the viewed trigger and the manual-start
+/// API (FR-RC3/RC4: manual start creates rows "exactly as the auto-trigger
+/// would"). Reads the application's reference data, suppresses when the
+/// applicant declined, selects the primary applicant's applicable slots
+/// (landlord-ref OR character-ref when `never_rented_before`, plus
+/// employer-ref), skips slots with no contact data, and runs the idempotent
+/// inserts + `reference_call_created` audits inside one transaction (both
+/// slots or neither).
+pub fn run_create_checks(
+  config: ServerConfig,
+  app_uuid: Uuid,
+  landlord_uuid: Uuid,
+  vacancy_uuid: Uuid,
+) -> Result(CreateOutcome, CreateError) {
+  let db = config.db
+  case
+    sql.get_application_reference_data(
+      db,
+      app_uuid,
+      landlord_uuid,
+      vacancy_uuid,
+    )
+  {
+    Error(err) ->
+      // A read failure is a genuine DB problem — surface it (the trigger
+      // path will Sentry it; the manual path will 500).
+      Error(DbError(pog.TransactionQueryError(err)))
+    Ok(pog.Returned(_, [])) -> Error(ApplicationNotFound)
+    Ok(pog.Returned(_, [data])) ->
+      case data.reference_contact_choice {
+        // FR-RC3 + A4: declined means the feature is off for this
+        // application — no rows, no audits. (None = pre-v1 application —
+        // proceeds, per AD-2.)
+        Some("declined") -> Ok(Suppressed)
+        _ -> create_eligible_slots(config, app_uuid, landlord_uuid, data)
+      }
+    // A single-row SELECT by application id; >1 row is impossible.
+    Ok(_) -> Error(ApplicationNotFound)
+  }
+}
+
+fn create_eligible_slots(
+  config: ServerConfig,
+  app_uuid: Uuid,
+  landlord_uuid: Uuid,
+  data: sql.GetApplicationReferenceDataRow,
+) -> Result(CreateOutcome, CreateError) {
+  // The landlord-ref slot and the character-ref slot are ONE slot in two
+  // flavours (AD-13): character-ref is used when the applicant never rented
+  // before. Never both. Employer-ref is an independent second slot.
+  let #(rental_slot, rental_name, rental_phone, rental_email) = case
+    data.never_rented_before == "true"
+  {
+    True -> #(
+      "character_ref",
+      data.character_ref_name,
+      data.character_ref_phone,
+      data.character_ref_email,
+    )
+    False -> #(
+      "landlord_ref",
+      data.landlord_ref_name,
+      data.landlord_ref_phone,
+      data.landlord_ref_email,
+    )
+  }
+  let candidates = [
+    #(rental_slot, rental_name, rental_phone, rental_email),
+    #(
+      "employer_ref",
+      data.employer_ref_name,
+      data.employer_ref_phone,
+      data.employer_ref_email,
+    ),
+  ]
+  // Skip slots with no contact data (FR-RC3): a referee needs a name AND a
+  // way to reach them (email or phone). contact_name is NOT NULL in the
+  // schema, so a nameless slot can never receive a row.
+  let eligible = list.filter(candidates, trio_has_contact)
+
+  let run = fn(tx: pog.Connection) {
+    list.try_each(eligible, fn(slot) {
+      create_one_slot(
+        tx,
+        app_uuid: app_uuid,
+        landlord_uuid: landlord_uuid,
+        slot: slot.0,
+        name: slot.1,
+        phone: slot.2,
+        email: slot.3,
+      )
+    })
+  }
+  case pog.transaction(config.db, run) {
+    Ok(_) -> Ok(Created(count: list.length(eligible)))
+    Error(err) -> Error(DbError(err))
+  }
+}
+
+/// Inserts one slot's row (idempotent) and writes the `reference_call_created`
+/// audit only when a row was actually created (ON CONFLICT DO NOTHING returns
+/// 0 rows on a conflict — a double trigger, or a landlord-pre-skipped slot).
+/// Runs inside the caller's transaction so row + audit commit together.
+fn create_one_slot(
+  tx: pog.Connection,
+  app_uuid app_uuid: Uuid,
+  landlord_uuid landlord_uuid: Uuid,
+  slot slot: String,
+  name name: Option(String),
+  phone phone: Option(String),
+  email email: Option(String),
+) -> Result(Nil, String) {
+  case
+    sql.insert_reference_call_if_absent(
+      tx,
+      app_uuid,
+      slot,
+      primary_owner,
+      opt_to_str(name),
+      opt_to_str(email),
+      opt_to_str(phone),
+    )
+  {
+    Ok(pog.Returned(_, [row])) ->
+      // Newly created — record the lifecycle audit (AD-16).
+      case uuid.from_string(row.id) {
+        Ok(row_uuid) ->
+          case
+            audit_log.create(
+              tx,
+              user_id: landlord_uuid,
+              event: event_type.ReferenceCallCreated,
+              entity_type: audit_entity,
+              entity_id: row_uuid,
+              details: json.object([
+                alog.non_pii(alog.RefSlot, json.string(slot)),
+                alog.non_pii(
+                  alog.ApplicationId,
+                  json.string(uuid.to_string(app_uuid)),
+                ),
+              ]),
+            )
+          {
+            Ok(_) -> Ok(Nil)
+            Error(err) ->
+              Error(
+                "reference_call_created audit failed: " <> string.inspect(err),
+              )
+          }
+        Error(_) ->
+          Error("could not parse inserted reference_call id: " <> row.id)
+      }
+    Ok(_) ->
+      // 0 rows — a live row already occupies this slot (ON CONFLICT DO
+      // NOTHING), so no duplicate was created and no audit is written (the
+      // original creation already audited). The catch-all also covers any
+      // unexpected multi-row return defensively.
+      Ok(Nil)
+    Error(err) ->
+      Error("insert_reference_call_if_absent failed: " <> string.inspect(err))
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Manual start API (FR-RC4)
+// ---------------------------------------------------------------------------
+
+/// `POST /api/v1/vacancies/:vid/applications/:aid/reference-checks/start` —
+/// landlord starts the checks for an applicant before the viewing (the
+/// "manual hook", AD-13 as amended). Creates rows exactly as the viewed
+/// trigger would (declined-suppression applies identically — the feature is
+/// off for a declined application regardless of who initiates).
+pub fn handle_start(
+  _req: Request,
+  config: ServerConfig,
+  landlord: Landlord,
+  vacancy_id: String,
+  application_id: String,
+) -> Response {
+  case parse_app_uuids(application_id, landlord.id, vacancy_id) {
+    Error(resp) -> resp
+    Ok(#(app_uuid, landlord_uuid, vacancy_uuid)) ->
+      run_action_with_prechecks(
+        config,
+        app_uuid,
+        landlord_uuid,
+        vacancy_uuid,
+        fn() {
+          case
+            run_create_checks(config, app_uuid, landlord_uuid, vacancy_uuid)
+          {
+            Ok(_) ->
+              json_ok(
+                json.object([
+                  #("started", json.bool(True)),
+                ]),
+              )
+            Error(ApplicationNotFound) ->
+              response_helpers.json_error(
+                error_code.NotFound,
+                "Application not found",
+                404,
+              )
+            Error(DbError(err)) -> {
+              wisp.log_error(
+                "reference-checks start failed: " <> string.inspect(err),
+              )
+              response_helpers.json_error(
+                error_code.ServerError,
+                "Couldn't start reference checks. Give it another go.",
+                500,
+              )
+            }
+          }
+        },
+      )
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Skip API (FR-RC4 + A6)
+// ---------------------------------------------------------------------------
+
+/// `POST /api/v1/vacancies/:vid/applications/:aid/reference-checks/:slot/skip`
+/// — landlord excludes a reference. Handles both "at trigger" and "before
+/// trigger" (A6): a `queued` row transitions to `skipped`; if no live row
+/// exists, a `skipped` row is created directly to reserve the slot (so the
+/// viewed trigger's idempotent insert later respects it). Idempotent —
+/// skipping an already-skipped slot is a no-op.
+pub fn handle_skip(
+  _req: Request,
+  config: ServerConfig,
+  landlord: Landlord,
+  vacancy_id: String,
+  application_id: String,
+  slot_str: String,
+) -> Response {
+  case is_valid_slot(slot_str) {
+    False ->
+      response_helpers.json_error(
+        error_code.InvalidPayload,
+        "Couldn't skip that reference. Unknown reference type.",
+        400,
+      )
+    True ->
+      case parse_app_uuids(application_id, landlord.id, vacancy_id) {
+        Error(resp) -> resp
+        Ok(#(app_uuid, landlord_uuid, vacancy_uuid)) ->
+          run_action_with_prechecks(
+            config,
+            app_uuid,
+            landlord_uuid,
+            vacancy_uuid,
+            fn() {
+              do_skip(config, app_uuid, landlord_uuid, vacancy_uuid, slot_str)
+            },
+          )
+      }
+  }
+}
+
+pub fn do_skip(
+  config: ServerConfig,
+  app_uuid: Uuid,
+  landlord_uuid: Uuid,
+  vacancy_uuid: Uuid,
+  slot: String,
+) -> Response {
+  let db = config.db
+  case
+    sql.get_application_reference_data(
+      db,
+      app_uuid,
+      landlord_uuid,
+      vacancy_uuid,
+    )
+  {
+    Error(_) ->
+      response_helpers.json_error(
+        error_code.ServerError,
+        "Couldn't skip that reference. Give it another go.",
+        500,
+      )
+    Ok(pog.Returned(_, [])) ->
+      response_helpers.json_error(
+        error_code.NotFound,
+        "Application not found",
+        404,
+      )
+    Ok(pog.Returned(_, [data])) -> {
+      let live = find_live_row_for_slot(db, app_uuid, slot)
+      case live {
+        // A skipped row already occupies the slot — idempotent no-op.
+        Some(row) if row.status == "skipped" ->
+          json_ok(json.object([#("skipped", json.bool(True))]))
+        // A queued row — guarded transition to skipped (clears next_attempt_at).
+        Some(row) if row.status == "queued" ->
+          transition_to_skipped(config, landlord_uuid, row.id, slot)
+        // The row is mid-flight (contact_initiated / awaiting_correction / a
+        // v2 voice state) — skip is a queued/pre-trigger action only.
+        Some(_) ->
+          response_helpers.json_error(
+            error_code.Conflict,
+            "This reference is already being contacted.",
+            409,
+          )
+        None -> {
+          // No live row — the "before trigger" path (A6). Reserve the slot
+          // with a skipped row so the viewed trigger respects it later.
+          // Declined attestation = feature off: nothing to reserve.
+          case data.reference_contact_choice {
+            Some("declined") ->
+              json_ok(json.object([#("skipped", json.bool(True))]))
+            _ ->
+              create_skipped_slot(config, app_uuid, landlord_uuid, slot, data)
+          }
+        }
+      }
+    }
+    Ok(_) ->
+      response_helpers.json_error(
+        error_code.NotFound,
+        "Application not found",
+        404,
+      )
+  }
+}
+
+fn transition_to_skipped(
+  config: ServerConfig,
+  landlord_uuid: Uuid,
+  row_id: String,
+  slot: String,
+) -> Response {
+  case uuid.from_string(row_id) {
+    Error(_) ->
+      response_helpers.json_error(
+        error_code.ServerError,
+        "Couldn't skip that reference. Give it another go.",
+        500,
+      )
+    Ok(row_uuid) ->
+      case
+        sql.update_reference_call_status(
+          config.db,
+          row_uuid,
+          sql.Skipped,
+          "",
+          "",
+          sql.Queued,
+        )
+      {
+        Ok(pog.Returned(_, [_])) -> {
+          write_lifecycle_audit(
+            config,
+            landlord_uuid,
+            row_uuid,
+            slot,
+            from: "queued",
+            to: "skipped",
+            event: event_type.ReferenceCallSkipped,
+          )
+          json_ok(json.object([#("skipped", json.bool(True))]))
+        }
+        // 0 rows — the row transitioned between our read and this write
+        // (a concurrent action). Treat as a conflict: the caller re-reads.
+        // The catch-all also covers any unexpected multi-row return.
+        Ok(_) ->
+          response_helpers.json_error(
+            error_code.Conflict,
+            "This reference changed state. Refresh and try again.",
+            409,
+          )
+        Error(err) -> {
+          wisp.log_error("skip transition failed: " <> string.inspect(err))
+          response_helpers.json_error(
+            error_code.ServerError,
+            "Couldn't skip that reference. Give it another go.",
+            500,
+          )
+        }
+      }
+  }
+}
+
+fn create_skipped_slot(
+  config: ServerConfig,
+  app_uuid: Uuid,
+  landlord_uuid: Uuid,
+  slot: String,
+  data: sql.GetApplicationReferenceDataRow,
+) -> Response {
+  let #(name, phone, email) = trio_for_slot(slot, data)
+  case name {
+    // No referee for this slot — there is nothing to exclude (contact_name
+    // is NOT NULL). Idempotent success: the slot would never receive a row.
+    None -> json_ok(json.object([#("skipped", json.bool(True))]))
+    Some(contact_name) -> {
+      let run = fn(tx: pog.Connection) {
+        create_one_skipped_slot(
+          tx,
+          app_uuid: app_uuid,
+          landlord_uuid: landlord_uuid,
+          slot: slot,
+          name: contact_name,
+          phone: phone,
+          email: email,
+        )
+      }
+      case pog.transaction(config.db, run) {
+        Ok(_) -> json_ok(json.object([#("skipped", json.bool(True))]))
+        Error(err) -> {
+          wisp.log_error("skip create failed: " <> string.inspect(err))
+          response_helpers.json_error(
+            error_code.ServerError,
+            "Couldn't skip that reference. Give it another go.",
+            500,
+          )
+        }
+      }
+    }
+  }
+}
+
+fn create_one_skipped_slot(
+  tx: pog.Connection,
+  app_uuid app_uuid: Uuid,
+  landlord_uuid landlord_uuid: Uuid,
+  slot slot: String,
+  name name: String,
+  phone phone: Option(String),
+  email email: Option(String),
+) -> Result(Nil, String) {
+  case
+    sql.insert_reference_call_skipped(
+      tx,
+      app_uuid,
+      slot,
+      primary_owner,
+      name,
+      opt_to_str(email),
+      opt_to_str(phone),
+    )
+  {
+    Ok(pog.Returned(_, [row])) ->
+      case uuid.from_string(row.id) {
+        Ok(row_uuid) ->
+          case
+            audit_log.create(
+              tx,
+              user_id: landlord_uuid,
+              event: event_type.ReferenceCallSkipped,
+              entity_type: audit_entity,
+              entity_id: row_uuid,
+              details: json.object([
+                alog.non_pii(alog.RefSlot, json.string(slot)),
+                alog.non_pii(
+                  alog.ApplicationId,
+                  json.string(uuid.to_string(app_uuid)),
+                ),
+              ]),
+            )
+          {
+            Ok(_) -> Ok(Nil)
+            Error(err) ->
+              Error(
+                "reference_call_skipped audit failed: " <> string.inspect(err),
+              )
+          }
+        Error(_) ->
+          Error("could not parse inserted reference_call id: " <> row.id)
+      }
+    // 0 rows — a live row appeared between our read and this insert (a
+    // concurrent action), so nothing was created. The catch-all also covers
+    // any unexpected multi-row return defensively.
+    Ok(_) -> Ok(Nil)
+    Error(err) ->
+      Error("insert_reference_call_skipped failed: " <> string.inspect(err))
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Re-enable API (FR-RC4 + A6)
+// ---------------------------------------------------------------------------
+
+/// `POST /api/v1/vacancies/:vid/applications/:aid/reference-checks/:slot/re-enable`
+/// — landlord re-enables a skipped reference. Guarded `skipped -> queued`
+/// transition that re-arms the cadence clock (`next_attempt_at = now()`) so
+/// the sweep (RC3.5) picks the row up. The sweep owns all sends — re-
+/// enabling sends nothing.
+pub fn handle_re_enable(
+  _req: Request,
+  config: ServerConfig,
+  landlord: Landlord,
+  vacancy_id: String,
+  application_id: String,
+  slot_str: String,
+) -> Response {
+  case is_valid_slot(slot_str) {
+    False ->
+      response_helpers.json_error(
+        error_code.InvalidPayload,
+        "Couldn't re-enable that reference. Unknown reference type.",
+        400,
+      )
+    True ->
+      case parse_app_uuids(application_id, landlord.id, vacancy_id) {
+        Error(resp) -> resp
+        Ok(#(app_uuid, landlord_uuid, vacancy_uuid)) ->
+          run_action_with_prechecks(
+            config,
+            app_uuid,
+            landlord_uuid,
+            vacancy_uuid,
+            fn() { do_re_enable(config, app_uuid, landlord_uuid, slot_str) },
+          )
+      }
+  }
+}
+
+pub fn do_re_enable(
+  config: ServerConfig,
+  app_uuid: Uuid,
+  landlord_uuid: Uuid,
+  slot: String,
+) -> Response {
+  let db = config.db
+  case find_skipped_row_for_slot(db, app_uuid, slot) {
+    None ->
+      // No skipped row for this slot — nothing to re-enable.
+      response_helpers.json_error(
+        error_code.NotFound,
+        "This reference isn't skipped.",
+        404,
+      )
+    Some(row) ->
+      case uuid.from_string(row.id) {
+        Error(_) ->
+          response_helpers.json_error(
+            error_code.ServerError,
+            "Couldn't re-enable that reference. Give it another go.",
+            500,
+          )
+        Ok(row_uuid) ->
+          case sql.re_enable_reference_call(db, row_uuid) {
+            Ok(pog.Returned(_, [_])) -> {
+              write_lifecycle_audit(
+                config,
+                landlord_uuid,
+                row_uuid,
+                slot,
+                from: "skipped",
+                to: "queued",
+                event: event_type.ReferenceCallReEnabled,
+              )
+              json_ok(json.object([#("re-enabled", json.bool(True))]))
+            }
+            // 0 rows — the row transitioned between our read and this write.
+            // The catch-all also covers any unexpected multi-row return.
+            Ok(_) ->
+              response_helpers.json_error(
+                error_code.Conflict,
+                "This reference changed state. Refresh and try again.",
+                409,
+              )
+            Error(err) -> {
+              wisp.log_error("re-enable failed: " <> string.inspect(err))
+              response_helpers.json_error(
+                error_code.ServerError,
+                "Couldn't re-enable that reference. Give it another go.",
+                500,
+              )
+            }
+          }
+      }
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Shared helpers
+// ---------------------------------------------------------------------------
+
+/// Ownership + archived-vacancy prechecks (the `handle_update_status`
+/// pattern). On success runs `action`; on failure returns the branded
+/// response. `verify_application_ownership` also gates the action to the
+/// landlord's own applications; `verify_vacancy_active` blocks mutation of
+/// archived vacancies.
+fn run_action_with_prechecks(
+  config: ServerConfig,
+  app_uuid: Uuid,
+  landlord_uuid: Uuid,
+  vacancy_uuid: Uuid,
+  action: fn() -> Response,
+) -> Response {
+  let db = config.db
+  case ai_sql.verify_application_ownership(db, app_uuid, landlord_uuid) {
+    Ok(pog.Returned(_, [row])) if row.match_count > 0 ->
+      case app_sql.verify_vacancy_active(db, vacancy_uuid, landlord_uuid) {
+        Ok(pog.Returned(_, [vacancy_row])) if vacancy_row.is_archived ->
+          response_helpers.json_error(
+            error_code.VacancyUnavailable,
+            "This vacancy is archived. Restore it to continue reviewing applications.",
+            422,
+          )
+        _ -> action()
+      }
+    _ ->
+      response_helpers.json_error(
+        error_code.NotFound,
+        "Application not found",
+        404,
+      )
+  }
+}
+
+/// Parses the three UUIDs every application-route handler receives. On any
+/// parse failure, short-circuits with a branded `InvalidId` 400 — mirrors
+/// `application_detail_handler.with_three_uuids`.
+fn parse_app_uuids(
+  application_id: String,
+  landlord_id: String,
+  vacancy_id: String,
+) -> Result(#(Uuid, Uuid, Uuid), Response) {
+  case
+    uuid.from_string(application_id),
+    uuid.from_string(landlord_id),
+    uuid.from_string(vacancy_id)
+  {
+    Ok(app_uuid), Ok(landlord_uuid), Ok(vacancy_uuid) ->
+      Ok(#(app_uuid, landlord_uuid, vacancy_uuid))
+    _, _, _ ->
+      Error(response_helpers.json_error(
+        error_code.InvalidId,
+        "That application link didn't look right.",
+        400,
+      ))
+  }
+}
+
+/// The first live (non-terminal) row for the slot, if any. Terminal statuses
+/// match `idx_reference_call_live`'s exclusion list — a terminal row does not
+/// occupy the slot.
+fn find_live_row_for_slot(
+  db: pog.Connection,
+  app_uuid: Uuid,
+  slot: String,
+) -> Option(sql.ListReferenceCallsForApplicationRow) {
+  case sql.list_reference_calls_for_application(db, app_uuid) {
+    Ok(pog.Returned(_, rows)) ->
+      case
+        list.find(rows, fn(row) {
+          row.ref_slot == slot
+          && row.owner_label == primary_owner
+          && !is_terminal(row.status)
+        })
+      {
+        Ok(row) -> Some(row)
+        Error(_) -> None
+      }
+    Error(_) -> None
+  }
+}
+
+/// The skipped row for the slot, if any (re-enable only applies to a skipped
+/// row — the dedicated `re_enable_reference_call` query guards on it too).
+fn find_skipped_row_for_slot(
+  db: pog.Connection,
+  app_uuid: Uuid,
+  slot: String,
+) -> Option(sql.ListReferenceCallsForApplicationRow) {
+  case sql.list_reference_calls_for_application(db, app_uuid) {
+    Ok(pog.Returned(_, rows)) ->
+      case
+        list.find(rows, fn(row) {
+          row.ref_slot == slot
+          && row.owner_label == primary_owner
+          && row.status == "skipped"
+        })
+      {
+        Ok(row) -> Some(row)
+        Error(_) -> None
+      }
+    Error(_) -> None
+  }
+}
+
+/// Terminal statuses — every status excluded from `idx_reference_call_live`
+/// (a live row occupies its slot; a terminal row does not). `'skipped'` is
+/// deliberately NOT terminal (A6 — it occupies its slot until re-enabled).
+fn is_terminal(status: String) -> Bool {
+  list.contains(
+    [
+      "form_completed",
+      "unreachable",
+      "refused",
+      "objected",
+      "manual_recorded",
+      "failed",
+      "completed",
+      "partial",
+    ],
+    status,
+  )
+}
+
+/// A referee is contactable when there is a name AND a way to reach them
+/// (email or phone). Used to skip no-contact slots at creation (FR-RC3).
+fn trio_has_contact(
+  triple: #(String, Option(String), Option(String), Option(String)),
+) -> Bool {
+  case triple {
+    #(_, Some(_), Some(_), _) -> True
+    #(_, Some(_), _, Some(_)) -> True
+    _ -> False
+  }
+}
+
+/// The contact trio for a given slot from the application data.
+fn trio_for_slot(
+  slot: String,
+  data: sql.GetApplicationReferenceDataRow,
+) -> #(Option(String), Option(String), Option(String)) {
+  case slot {
+    "landlord_ref" -> #(
+      data.landlord_ref_name,
+      data.landlord_ref_phone,
+      data.landlord_ref_email,
+    )
+    "character_ref" -> #(
+      data.character_ref_name,
+      data.character_ref_phone,
+      data.character_ref_email,
+    )
+    _ -> #(
+      data.employer_ref_name,
+      data.employer_ref_phone,
+      data.employer_ref_email,
+    )
+  }
+}
+
+fn opt_to_str(o: Option(String)) -> String {
+  case o {
+    Some(s) -> s
+    None -> ""
+  }
+}
+
+/// A valid referee slot path segment. `shared.ref_slot_from_string` is a
+/// total function that falls back to `LandlordRef` for unknown values, so it
+/// can't validate a path param — this does.
+fn is_valid_slot(slot: String) -> Bool {
+  slot == "landlord_ref" || slot == "character_ref" || slot == "employer_ref"
+}
+
+fn json_ok(body: json.Json) -> Response {
+  wisp.json_response(json.to_string(body), 200)
+}
+
+/// Writes a skip/re-enable lifecycle audit, fail-open (Tier 2) — the state
+/// transition has already committed; an audit failure is observability-only.
+fn write_lifecycle_audit(
+  config: ServerConfig,
+  landlord_uuid: Uuid,
+  row_uuid: Uuid,
+  slot: String,
+  from from: String,
+  to to: String,
+  event event: event_type.AuditEvent,
+) -> Nil {
+  let details =
+    json.object([
+      alog.non_pii(alog.RefSlot, json.string(slot)),
+      alog.non_pii(alog.From, json.string(from)),
+      alog.non_pii(alog.To, json.string(to)),
+    ])
+  case
+    audit_log.create(
+      config.db,
+      user_id: landlord_uuid,
+      event: event,
+      entity_type: audit_entity,
+      entity_id: row_uuid,
+      details: details,
+    )
+  {
+    Ok(_) -> Nil
+    Error(err) -> escalation.fail_open(config.sentry, event, row_uuid, err)
+  }
+}
+
+/// Capture a viewed-trigger creation failure to Sentry (fail-open — the
+/// status already committed to `viewed`; the manual-start API is the
+/// human-recoverable fallback).
+fn report_trigger_failure(
+  sentry: sentry_client.Sentry,
+  app_uuid: Uuid,
+  error: CreateError,
+) -> Nil {
+  let app_id_str = uuid.to_string(app_uuid)
+  let message =
+    case error {
+      ApplicationNotFound ->
+        "reference viewed-trigger: application not found (ownership verified by status PATCH) "
+      DbError(_) -> "reference viewed-trigger: creation transaction failed "
+    }
+    <> app_id_str
+  wisp.log_warning(message)
+  sentry_client.capture(
+    sentry,
+    sentry_client.BackgroundEvent(
+      event_type: "ReferenceTriggerFailed",
+      message: message,
+      level: sentry_client.LevelError,
+      tags: [
+        #("application_id", app_id_str),
+        #("error_class", case error {
+          ApplicationNotFound -> "application_not_found"
+          DbError(_) -> "db_error"
+        }),
+      ],
+    ),
+  )
+}
