+//// Reference-check message templates — the copy contract (Story RC3.2).
+////
+//// Pure builders for every cadence message the sweep (rc3-5) sends: the T0
+//// invite (email + SMS, the Art 14 notice vehicle, architecture §9.1), the
+//// T+24h applicant co-nudge, the T+48h/T+96h reminders, and the T+96h
+//// landlord warm-handoff email with the attempt log rendered (§8.3).
+////
+//// Copy is UX-deck verbatim (ux-reference-checking §6.2–6.4, §7.9, §10.1)
+//// modulo three documented deviations: (1) the RT-wide em-dash ban in
+//// user-facing copy, (2) the 2026-08-08 stop-link amendment (every SMS
+//// carries `/reference/:token/stop`, never "reply STOP" — the Alpha Sender
+//// ID is one-way, AD-6 corrected), and (3) slot-neutral phrasing where the
+//// deck is landlord-ref-shaped. See the story spec's deviations register.
+////
+//// This module is pure: no IO, no DB, no env. Send dispatch lives in
+//// `reference_checks/send.gleam`. Capability tokens appear ONLY inside the
+//// form/stop URLs — never in subjects, log lines, or `detail` strings
+//// (the attempt log is landlord-visible).
+
+import gleam/int
+import gleam/list
+import gleam/string
+import notification/email_client
+import shared/reference_call.{
+  type RefSlot, CharacterRef, EmployerRef, LandlordRef,
+}
+
+// ---------------------------------------------------------------------------
+// Per-channel outcome vocabulary — shaped for the row's `attempts` JSONB
+// ([{at, channel, outcome, detail}]; the sweep stamps `at` when it builds
+// the guarded append, append_reference_call_attempt.sql).
+// ---------------------------------------------------------------------------
+
+/// The notification channel a single message went out on. Distinct from
+/// `shared/reference_call.Channel` (the RESULT channel: form/manual/voice).
+pub type MessageChannel {
+  Email
+  Sms
+}
+
+/// The immediate send result. `Bounced` is NOT here: bounces are only known
+/// later via the delivery webhooks (rc3-6) — a helper can only report what
+/// the provider did synchronously.
+pub type Outcome {
+  Delivered
+  Skipped
+  Failed
+}
+
+/// One channel's outcome, ready for the attempt log. `detail` carries the
+/// provider id (Resend email id / Twilio message SID) on `delivered`, the
+/// reason on `failed`, and the skip cause on `skipped`. It must NEVER carry
+/// the capability token (landlord-visible).
+pub type ChannelOutcome {
+  ChannelOutcome(channel: MessageChannel, outcome: Outcome, detail: String)
+}
+
+pub fn channel_name(channel: MessageChannel) -> String {
+  case channel {
+    Email -> "email"
+    Sms -> "sms"
+  }
+}
+
+pub fn outcome_name(outcome: Outcome) -> String {
+  case outcome {
+    Delivered -> "delivered"
+    Skipped -> "skipped"
+    Failed -> "failed"
+  }
+}
+
+/// One attempt-log line for the warm-handoff email. Plain strings: the sweep
+/// decodes the row's `attempts` JSONB (or builds entries from its own send
+/// results) and hands them over; this module only renders.
+pub type AttemptEntry {
+  AttemptEntry(at: String, channel: String, outcome: String, detail: String)
+}
+
+// ---------------------------------------------------------------------------
+// URL builders (AD-3 form link, AD-6 stop-link, §9.1 notice link)
+// ---------------------------------------------------------------------------
+
+/// The referee form link (AD-3 capability-token route, rc3-3 owns the route).
+pub fn form_url(base_url base: String, token token: String) -> String {
+  base <> "/reference/" <> token
+}
+
+/// The stop-link (AD-6 as amended 2026-08-08): the referee's one-tap
+/// opt-out. GET renders a confirm page, POST objects (pre-fetch-safe);
+/// rc3-4 owns the route, this module only embeds the URL.
+pub fn stop_url(base_url base: String, token token: String) -> String {
+  form_url(base_url: base, token: token) <> "/stop"
+}
+
+/// The referee Art 14 notice: the `referee-data` section of the privacy
+/// page (the anchor is a documented stability contract,
+/// legal/privacy_sections/referee_data.gleam).
+pub fn notice_url(base_url base: String) -> String {
+  base <> "/privacy#referee-data"
+}
+
+// ---------------------------------------------------------------------------
+// Shared template inputs + small pure helpers
+// ---------------------------------------------------------------------------
+
+/// Everything a referee-facing template needs, already resolved by the
+/// caller (the sweep): names, the slot, the minted form token, the public
+/// origin, and the pre-formatted link-expiry date ("" when unknown).
+pub type RefereeContext {
+  RefereeContext(
+    referee_first_name: String,
+    applicant_full_name: String,
+    applicant_first_name: String,
+    landlord_display_name: String,
+    slot: RefSlot,
+    form_token: String,
+    base_url: String,
+    expiry_date: String,
+  )
+}
+
+/// The slot-appropriate substitution for the deck's "her previous landlord"
+/// (deviation 3: the deck is landlord-ref-shaped; employer/character referees
+/// must not be told they were listed as a landlord).
+pub fn role_phrase(slot slot: RefSlot) -> String {
+  case slot {
+    LandlordRef -> "their previous landlord"
+    EmployerRef -> "their employer"
+    CharacterRef -> "a character referee for them"
+  }
+}
+
+/// First whitespace-delimited token of a free-text name ("Colm Byrne" →
+/// "Colm"). Referee names arrive as one free-text field, so the greeting
+/// derives the first name. A name that is all whitespace yields "" — the
+/// greeting then reads "Hi ," which is ugly but truthful (contact_name is
+/// NOT NULL in the schema, so this is a data-quality edge, not a crash).
+pub fn first_name(name name: String) -> String {
+  case string.split(string.trim(name), " ") {
+    [first, ..] -> first
+    [] -> name
+  }
+}
+
+/// The expiry text for reminder-2 copy. The caller pre-formats
+/// `form_token_expires_at` (emails receive pre-formatted date strings, the
+/// `format_close_date` precedent); "" falls back to the A3 truth (the link
+/// lives 10 days from the invitation) so the copy never lies.
+fn expiry_text(expiry_date: String) -> String {
+  case expiry_date {
+    "" -> "10 days from our first message"
+    formatted -> formatted
+  }
+}
+
+// ---------------------------------------------------------------------------
+// T0 invite (UX §6.2 + §6.3 as amended)
+// ---------------------------------------------------------------------------
+
+pub fn invite_email_subject(applicant_full_name name: String) -> String {
+  name <> " listed you as a referee: a 5-minute form"
+}
+
+pub fn build_invite_email_html(ctx ctx: RefereeContext) -> String {
+  let form = form_url(ctx.base_url, ctx.form_token)
+  let stop = stop_url(ctx.base_url, ctx.form_token)
+  let notice = notice_url(ctx.base_url)
+  let safe_form = email_client.escape_html(form)
+  let safe_stop = email_client.escape_html(stop)
+  let safe_notice = email_client.escape_html(notice)
+
+  email_wrapper(
+    email_paragraph(
+      "Hi " <> email_client.escape_html(ctx.referee_first_name) <> ",",
+    )
+    <> email_paragraph(
+      email_client.escape_html(ctx.applicant_full_name)
+      <> " has applied to rent a home and gave us your details as "
+      <> role_phrase(ctx.slot)
+      <> ".",
+    )
+    <> email_paragraph(
+      "The landlord uses RightTenantry to collect references. Could you confirm a few details about "
+      <> email_client.escape_html(ctx.applicant_first_name)
+      <> "? It's a short form, about 5 minutes, no account needed, works on any phone.",
+    )
+    <> cta_button(safe_form, "Complete the reference")
+    <> email_paragraph("The link is unique to you and expires in 10 days.")
+    <> email_paragraph(
+      "Don't know "
+      <> email_client.escape_html(ctx.applicant_first_name)
+      <> ", or don't want to take part? <a href=\""
+      <> safe_stop
+      <> "\" style=\"color: #1B2A4A;\">Decline here</a> and we'll stop contacting you and let the landlord know. No reason needed.",
+    )
+    <> email_divider()
+    // The Art 14 block (architecture §9.1 required list): controller
+    // identity, processor, source, purpose + basis, retention, rights
+    // including objection, notice URL.
+    <> "<p style=\"font-family: "
+    <> brand_font
+    <> "; font-size: 14px; color: #64748B; line-height: 1.6; margin: 16px 0 0 0;\">"
+    <> "<strong>Your data, in plain terms.</strong> We got your name and contact details from "
+    <> email_client.escape_html(ctx.applicant_full_name)
+    <> ". The landlord, "
+    <> email_client.escape_html(ctx.landlord_display_name)
+    <> ", is the data controller; RightTenantry processes your answers on their behalf to verify this application (lawful basis: legitimate interest). Your answers are shared with the landlord as part of "
+    <> email_client.escape_html(ctx.applicant_first_name)
+    <> "'s application, kept only as long as the application is retained, and never used for marketing. You can see, correct, delete, or object to your data at any time, details and contact routes: <a href=\""
+    <> safe_notice
+    <> "\" style=\"color: #1B2A4A;\">"
+    <> safe_notice
+    <> "</a>.</p>",
+  )
+}
+
+pub fn build_invite_sms(ctx ctx: RefereeContext) -> String {
+  "Hi "
+  <> ctx.referee_first_name
+  <> ", "
+  <> ctx.applicant_full_name
+  <> " gave us your details as a referee for a rental application. Can you confirm a few details in a 5-min form? "
+  <> form_url(ctx.base_url, ctx.form_token)
+  <> " From RightTenantry for the landlord. Info & your rights: "
+  <> notice_url(ctx.base_url)
+  <> " To opt out: "
+  <> stop_url(ctx.base_url, ctx.form_token)
+}
+
+// ---------------------------------------------------------------------------
+// T+48h / T+96h reminders (UX §6.4 as amended)
+// ---------------------------------------------------------------------------
+
+pub type ReminderStage {
+  ReminderOne
+  ReminderTwo
+}
+
+pub fn reminder_email_subject(
+  stage stage: ReminderStage,
+  applicant_full_name name: String,
+) -> String {
+  case stage {
+    ReminderOne -> "Still happy to help " <> name <> "? 5 minutes"
+    ReminderTwo -> "Last message from us: reference for " <> name
+  }
+}
+
+pub fn build_reminder_email_html(
+  stage stage: ReminderStage,
+  ctx ctx: RefereeContext,
+) -> String {
+  let form = email_client.escape_html(form_url(ctx.base_url, ctx.form_token))
+  let stop = email_client.escape_html(stop_url(ctx.base_url, ctx.form_token))
+  let notice = email_client.escape_html(notice_url(ctx.base_url))
+  let safe_applicant = email_client.escape_html(ctx.applicant_full_name)
+  let notice_footer =
+    "<p style=\"font-family: "
+    <> brand_font
+    <> "; font-size: 13px; color: #94A3B8; line-height: 1.6; margin: 16px 0 0 0;\">"
+    <> "Info &amp; your rights: <a href=\""
+    <> notice
+    <> "\" style=\"color: #94A3B8;\">"
+    <> notice
+    <> "</a></p>"
+
+  case stage {
+    ReminderOne ->
+      email_wrapper(
+        email_paragraph(
+          "Hi " <> email_client.escape_html(ctx.referee_first_name) <> ",",
+        )
+        <> email_paragraph(
+          "A quick reminder about the reference form for "
+          <> safe_applicant
+          <> "'s rental application. If you've already started, the same link picks up where you left off: <a href=\""
+          <> form
+          <> "\" style=\"color: #1B2A4A;\">"
+          <> form
+          <> "</a>",
+        )
+        <> email_paragraph(
+          "Not able to help? <a href=\""
+          <> stop
+          <> "\" style=\"color: #1B2A4A;\">Decline</a> and we'll stop contacting you.",
+        )
+        <> email_divider()
+        <> notice_footer,
+      )
+    ReminderTwo ->
+      email_wrapper(
+        email_paragraph(
+          "Hi " <> email_client.escape_html(ctx.referee_first_name) <> ",",
+        )
+        <> email_paragraph(
+          "This is our last message about "
+          <> safe_applicant
+          <> "'s application. If the timing is bad or you'd rather not take part, that's fine: <a href=\""
+          <> stop
+          <> "\" style=\"color: #1B2A4A;\">decline here</a> and we'll close this off. Otherwise the form is here until "
+          <> email_client.escape_html(expiry_text(ctx.expiry_date))
+          <> ": <a href=\""
+          <> form
+          <> "\" style=\"color: #1B2A4A;\">"
+          <> form
+          <> "</a>",
+        )
+        <> email_paragraph(
+          "After this we'll simply let the landlord know we couldn't reach you.",
+        )
+        <> email_divider()
+        <> notice_footer,
+      )
+  }
+}
+
+pub fn build_reminder_sms(
+  stage stage: ReminderStage,
+  ctx ctx: RefereeContext,
+) -> String {
+  case stage {
+    ReminderOne ->
+      "Reminder: "
+      <> ctx.applicant_full_name
+      <> "'s reference form takes about 5 min: "
+      <> form_url(ctx.base_url, ctx.form_token)
+      <> ". RightTenantry. To stop these messages: "
+      <> stop_url(ctx.base_url, ctx.form_token)
+    ReminderTwo ->
+      "Last reminder: the reference form for "
+      <> ctx.applicant_full_name
+      <> " is here until "
+      <> expiry_text(ctx.expiry_date)
+      <> ": "
+      <> form_url(ctx.base_url, ctx.form_token)
+      <> ". RightTenantry. To stop these messages: "
+      <> stop_url(ctx.base_url, ctx.form_token)
+  }
+}
+
+// ---------------------------------------------------------------------------
+// T+24h applicant co-nudge (UX §10.1) — email to the APPLICANT, so no
+// stop-link and no notice link (the applicant is not this notice's subject).
+// ---------------------------------------------------------------------------
+
+pub fn co_nudge_email_subject(referee_first_name name: String) -> String {
+  "A quick word to " <> name <> " helps your application"
+}
+
+pub fn build_co_nudge_email_html(
+  applicant_first_name applicant_first_name: String,
+  referee_name referee_name: String,
+) -> String {
+  email_wrapper(
+    email_paragraph(
+      "Hi " <> email_client.escape_html(applicant_first_name) <> ",",
+    )
+    <> email_paragraph(
+      "We've invited "
+      <> email_client.escape_html(referee_name)
+      <> " to complete your reference, but haven't heard back yet. A quick message from you ('expect a text from RightTenantry, it's legitimate') makes a real difference. No action needed beyond that. We'll keep the process moving.",
+    ),
+  )
+}
+
+// ---------------------------------------------------------------------------
+// T+96h landlord warm-handoff (§7.9 line + §8.3 attempt-log mandate)
+// ---------------------------------------------------------------------------
+
+pub fn warm_handoff_email_subject(
+  referee_name referee_name: String,
+  applicant_full_name applicant_full_name: String,
+) -> String {
+  "Couldn't reach "
+  <> referee_name
+  <> " ("
+  <> applicant_full_name
+  <> "'s referee)"
+}
+
+pub fn build_warm_handoff_email_html(
+  landlord_name landlord_name: String,
+  referee_name referee_name: String,
+  applicant_full_name applicant_full_name: String,
+  attempts attempts: List(AttemptEntry),
+  application_url application_url: String,
+) -> String {
+  let safe_url = email_client.escape_html(application_url)
+  let attempt_lines = case attempts {
+    [] -> "<li style=\"" <> item_style <> "\">No attempts recorded.</li>"
+    _ -> string.join(list.map(attempts, render_attempt_line), "")
+  }
+  let count = int.to_string(list.length(attempts))
+
+  email_wrapper(
+    email_paragraph("Hi " <> email_client.escape_html(landlord_name) <> ",")
+    <> email_paragraph(
+      "Couldn't reach "
+      <> email_client.escape_html(referee_name)
+      <> " ("
+      <> email_client.escape_html(applicant_full_name)
+      <> "'s referee). You can take over from the application page.",
+    )
+    <> email_paragraph(
+      "We've tried to reach them "
+      <> count
+      <> " times over the last 4 days. The attempt log:",
+    )
+    <> "<ul style=\"padding-left: 20px; margin: 0 0 16px 0;\">"
+    <> attempt_lines
+    <> "</ul>"
+    <> email_paragraph(
+      "Their contact details and the same log are on the application page. If they complete the form anyway, it still shows up there.",
+    )
+    <> cta_button(safe_url, "Open the application")
+    <> email_divider()
+    <> fallback_link(safe_url),
+  )
+}
+
+fn render_attempt_line(entry: AttemptEntry) -> String {
+  "<li style=\""
+  <> item_style
+  <> "\">"
+  <> email_client.escape_html(entry.at)
+  <> ": "
+  <> email_client.escape_html(entry.channel)
+  <> ", "
+  <> email_client.escape_html(entry.outcome)
+  <> case entry.detail {
+    "" -> ""
+    detail -> " (" <> email_client.escape_html(detail) <> ")"
+  }
+  <> "</li>"
+}
+
+// ---------------------------------------------------------------------------
+// Email markup primitives — local, minimal, inline-styled (story decision 7:
+// email_client's wrapper/CTA/divider stay private; a third email family can
+// extract a shared markup module later). Same brand tokens as email_client.
+// ---------------------------------------------------------------------------
+
+const brand_font = "'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
+
+const item_style = "font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 15px; color: #2D2D2D; line-height: 1.6; margin: 0 0 8px 0;"
+
+fn email_paragraph(inner: String) -> String {
+  "<p style=\"font-family: "
+  <> brand_font
+  <> "; font-size: 16px; color: #64748B; line-height: 1.6; margin: 0 0 16px 0;\">"
+  <> inner
+  <> "</p>"
+}
+
+fn email_wrapper(body_content: String) -> String {
+  "<!DOCTYPE html>"
+  <> "<html lang=\"en\">"
+  <> "<head>"
+  <> "<meta charset=\"utf-8\" />"
+  <> "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />"
+  <> "<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" />"
+  <> "<meta name=\"color-scheme\" content=\"light only\" />"
+  <> "</head>"
+  <> "<body style=\"margin: 0; padding: 0; background-color: #FAFAF7; font-family: "
+  <> brand_font
+  <> ";\">"
+  <> "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color: #FAFAF7;\">"
+  <> "<tr><td align=\"center\" style=\"padding: 40px 16px;\">"
+  <> "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width: 520px; background-color: #FFFFFF; border-radius: 16px; overflow: hidden; border: 1px solid #E2E8F0; box-shadow: 0 20px 40px -15px rgba(0,0,0,0.05);\">"
+  <> "<tr><td style=\"background-color: #1B2A4A; padding: 32px 40px; text-align: center;\">"
+  <> "<span style=\"font-family: "
+  <> brand_font
+  <> "; font-size: 22px; font-weight: 700; letter-spacing: -0.5px;\">"
+  <> "<span style=\"color: #D4942A;\">Right</span><span style=\"color: #FFFFFF;\">Tenantry</span>"
+  <> "</span>"
+  <> "</td></tr>"
+  <> "<tr><td style=\"padding: 40px 40px 16px 40px;\">"
+  <> body_content
+  <> "</td></tr>"
+  <> "</table>"
+  <> "</td></tr></table>"
+  <> "</body></html>"
+}
+
+fn cta_button(url: String, text: String) -> String {
+  "<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin: 24px 0;\">"
+  <> "<tr><td align=\"center\" style=\"border-radius: 8px; background-color: #D4942A;\">"
+  <> "<a href=\""
+  <> url
+  <> "\" target=\"_blank\" style=\"display: block; padding: 16px 32px; font-family: "
+  <> brand_font
+  <> "; font-size: 15px; font-weight: 700; color: #FFFFFF; text-decoration: none; text-transform: uppercase; letter-spacing: 1px; text-align: center;\">"
+  <> text
+  <> "</a>"
+  <> "</td></tr></table>"
+}
+
+fn email_divider() -> String {
+  "<hr style=\"border: none; border-top: 1px solid #E2E8F0; margin: 16px 0 0 0;\" />"
+}
+
+fn fallback_link(url: String) -> String {
+  "<p style=\"font-family: "
+  <> brand_font
+  <> "; font-size: 13px; color: #64748B; line-height: 1.6; margin: 16px 0 0 0;\">"
+  <> "If the button doesn't work, copy this link: "
+  <> url
+  <> "</p>"
+}
diff --git a/server/src/reference_checks/send.gleam b/server/src/reference_checks/send.gleam
new file mode 100644
index 00000000..77e94485
--- /dev/null
+++ b/server/src/reference_checks/send.gleam
@@ -0,0 +1,260 @@
+//// Reference-check send helpers (Story RC3.2) — the functions the cadence
+//// sweep (rc3-5) calls to fire each template.
+////
+//// Each helper renders via `reference_checks/messages.gleam` (pure) and
+//// dispatches through rc3-1's `notification/sms_client` (Alpha Sender ID
+//// "RTenantry", status-callback URL already inside the client) and the
+//// existing `notification/email_client`. Every helper returns per-channel
+//// `ChannelOutcome`s shaped for the row's attempt log; the sweep owns the
+//// DB append + the `at` timestamp (AD-14).
+////
+//// No-op doctrine (AC5): a missing Resend key, a `Disabled` Twilio handle,
+//// or an absent contact on one channel yields a `skipped` outcome + one log
+//// line — never a crash, never a Sentry capture (expected config state, the
+//// "shortlist email skipped" precedent). Real provider failures come back
+//// as `failed` outcomes (sms_client captures those to Sentry itself;
+//// email_client logs them).
+
+import gleam/option.{type Option, None, Some}
+import notification/email_client
+import notification/sms_client
+import reference_checks/messages.{
+  type ChannelOutcome, type RefereeContext, ChannelOutcome, Delivered, Email,
+  Failed, Skipped, Sms,
+}
+import sentry/sentry_client
+import wisp
+
+/// Referee-facing mail sender (OQ-11: the existing verified transactional
+/// domain; the address is display-only over the righttenantry.ie domain).
+const referee_sender: String = "RightTenantry References <references@righttenantry.ie>"
+
+/// Applicant- and landlord-facing mail sender — the established transactional
+/// identity those audiences already receive (co-nudge + warm handoff).
+const standard_sender: String = "RightTenantry <noreply@app.righttenantry.ie>"
+
+/// The three handles the helpers need, assembled from `ServerConfig` by the
+/// caller in one line (story decision 3: keeps this module decoupled from
+/// the 20-field config and the unit tests light).
+pub type SendDeps {
+  SendDeps(
+    resend_api_key: String,
+    twilio: sms_client.Twilio,
+    sentry: sentry_client.Sentry,
+  )
+}
+
+/// A referee-directed message: the rendering context plus the resolved
+/// effective contacts (the sweep applies corrected ?? snapshot before
+/// calling — AD-7's effective-contact rule lives with the caller).
+pub type RefereeMessage {
+  RefereeMessage(
+    context: RefereeContext,
+    to_email: Option(String),
+    to_phone: Option(String),
+  )
+}
+
+// ---------------------------------------------------------------------------
+// T0 invite (email + SMS)
+// ---------------------------------------------------------------------------
+
+/// Send the T0 invite on both channels. Returns one outcome per channel
+/// (order: email, sms) — a channel with no contact or no keys comes back
+/// `skipped`, never an error.
+pub fn send_invite(
+  deps deps: SendDeps,
+  message message: RefereeMessage,
+) -> List(ChannelOutcome) {
+  let ctx = message.context
+  [
+    send_referee_email(
+      deps,
+      message.to_email,
+      subject: messages.invite_email_subject(ctx.applicant_full_name),
+      html: messages.build_invite_email_html(ctx),
+      template: "reference_invite",
+    ),
+    send_referee_sms(deps, message.to_phone, messages.build_invite_sms(ctx)),
+  ]
+}
+
+// ---------------------------------------------------------------------------
+// T+48h / T+96h reminders (email + SMS)
+// ---------------------------------------------------------------------------
+
+/// Send a reminder (stage 1 = T+48h, stage 2 = T+96h) on both channels.
+pub fn send_reminder(
+  deps deps: SendDeps,
+  stage stage: messages.ReminderStage,
+  message message: RefereeMessage,
+) -> List(ChannelOutcome) {
+  let ctx = message.context
+  let template = case stage {
+    messages.ReminderOne -> "reference_reminder_1"
+    messages.ReminderTwo -> "reference_reminder_2"
+  }
+  [
+    send_referee_email(
+      deps,
+      message.to_email,
+      subject: messages.reminder_email_subject(stage, ctx.applicant_full_name),
+      html: messages.build_reminder_email_html(stage, ctx),
+      template:,
+    ),
+    send_referee_sms(
+      deps,
+      message.to_phone,
+      messages.build_reminder_sms(stage, ctx),
+    ),
+  ]
+}
+
+// ---------------------------------------------------------------------------
+// T+24h applicant co-nudge (email to the APPLICANT only, AD-4)
+// ---------------------------------------------------------------------------
+
+/// Send the applicant co-nudge. `to_email` is the applicant's address
+/// (required — the application always captures one). Single channel.
+pub fn send_co_nudge(
+  deps deps: SendDeps,
+  to_email to_email: String,
+  applicant_first_name applicant_first_name: String,
+  referee_name referee_name: String,
+  referee_first_name referee_first_name: String,
+) -> ChannelOutcome {
+  case deps.resend_api_key {
+    "" -> skip_email_no_key("co-nudge")
+    api_key ->
+      email_client.send_email_with_tags(
+        api_key,
+        standard_sender,
+        to_email,
+        messages.co_nudge_email_subject(referee_first_name),
+        messages.build_co_nudge_email_html(applicant_first_name:, referee_name:),
+        [#("template", "reference_co_nudge")],
+      )
+      |> email_outcome
+  }
+}
+
+// ---------------------------------------------------------------------------
+// T+96h landlord warm-handoff (email to the landlord with the attempt log)
+// ---------------------------------------------------------------------------
+
+/// Send the landlord warm-handoff email (the T+96h "we're struggling to
+/// reach them" handoff with the attempt log rendered, architecture §8.3).
+/// `attempts` is the row's attempt log as plain entries (the sweep decodes /
+/// accumulates them). Single channel.
+pub fn send_warm_handoff(
+  deps deps: SendDeps,
+  to_email to_email: String,
+  landlord_name landlord_name: String,
+  referee_name referee_name: String,
+  applicant_full_name applicant_full_name: String,
+  attempts attempts: List(messages.AttemptEntry),
+  application_url application_url: String,
+) -> ChannelOutcome {
+  case deps.resend_api_key {
+    "" -> skip_email_no_key("warm handoff")
+    api_key ->
+      email_client.send_email_with_tags(
+        api_key,
+        standard_sender,
+        to_email,
+        messages.warm_handoff_email_subject(referee_name, applicant_full_name),
+        messages.build_warm_handoff_email_html(
+          landlord_name:,
+          referee_name:,
+          applicant_full_name:,
+          attempts:,
+          application_url:,
+        ),
+        [#("template", "reference_warm_handoff")],
+      )
+      |> email_outcome
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Channel plumbing
+// ---------------------------------------------------------------------------
+
+fn send_referee_email(
+  deps: SendDeps,
+  to: Option(String),
+  subject subject: String,
+  html html: String,
+  template template: String,
+) -> ChannelOutcome {
+  case to {
+    None -> ChannelOutcome(Email, Skipped, "no email contact on file")
+    Some(address) ->
+      case deps.resend_api_key {
+        "" -> skip_email_no_key(template)
+        api_key ->
+          email_client.send_email_with_tags(
+            api_key,
+            referee_sender,
+            address,
+            subject,
+            html,
+            [#("template", template)],
+          )
+          |> email_outcome
+      }
+  }
+}
+
+fn send_referee_sms(
+  deps: SendDeps,
+  to: Option(String),
+  body: String,
+) -> ChannelOutcome {
+  case to {
+    None -> ChannelOutcome(Sms, Skipped, "no phone contact on file")
+    Some(number) ->
+      sms_client.send_sms(
+        twilio: deps.twilio,
+        sentry: deps.sentry,
+        to: number,
+        body:,
+      )
+      |> sms_outcome
+  }
+}
+
+/// The empty-key skip (the `application_detail_handler` shortlist precedent):
+/// one warning line + a `skipped` outcome, never Sentry (expected config).
+fn skip_email_no_key(template: String) -> ChannelOutcome {
+  wisp.log_warning(
+    "reference " <> template <> " email skipped (no RESEND_API_KEY)",
+  )
+  ChannelOutcome(Email, Skipped, "no RESEND_API_KEY")
+}
+
+/// Map an email_client result onto the attempt-log vocabulary. `Ok` carries
+/// the Resend email id; `Error` the reason. Exposed `@internal` for tests.
+@internal
+pub fn email_outcome(result: Result(String, String)) -> ChannelOutcome {
+  case result {
+    Ok(email_id) -> ChannelOutcome(Email, Delivered, email_id)
+    Error(reason) -> ChannelOutcome(Email, Failed, reason)
+  }
+}
+
+/// Map an sms_client result onto the attempt-log vocabulary. The client's
+/// `Skipped` (Twilio `Disabled`) is the no-op path, not an error.
+/// Exposed `@internal` for tests.
+@internal
+pub fn sms_outcome(
+  result: Result(sms_client.SendOutcome, String),
+) -> ChannelOutcome {
+  case result {
+    Ok(sms_client.Sent(message_sid)) ->
+      ChannelOutcome(Sms, Delivered, message_sid)
+    Ok(sms_client.Skipped) ->
+      ChannelOutcome(Sms, Skipped, "twilio not configured")
+    Error(reason) -> ChannelOutcome(Sms, Failed, reason)
+  }
+}
diff --git a/server/test/reference_checks/messages_test.gleam b/server/test/reference_checks/messages_test.gleam
new file mode 100644
index 00000000..012a1542
--- /dev/null
+++ b/server/test/reference_checks/messages_test.gleam
@@ -0,0 +1,389 @@
+//// Unit tests for reference_checks/messages — the copy contract.
+////
+//// Every template renders with fixtures and is asserted for: the Art 14
+//// required elements (invite email), the stop-link in EVERY SMS + the email
+//// decline links (AD-6 amended — never "reply STOP"), the em-dash absence
+//// (RT global ban), exact URL builders, and HTML escaping of interpolated
+//// names. Pinned copy strings come from the story spec (the UX deck modulo
+//// the three documented deviations).
+
+import gleam/string
+import gleeunit/should
+import reference_checks/messages
+import shared/reference_call.{CharacterRef, EmployerRef, LandlordRef}
+
+const base = "https://righttenantry.ie"
+
+const token = "testtoken123"
+
+fn fixture_ctx() -> messages.RefereeContext {
+  messages.RefereeContext(
+    referee_first_name: "Colm",
+    applicant_full_name: "Aisling O'Brien",
+    applicant_first_name: "Aisling",
+    landlord_display_name: "Niamh Murphy",
+    slot: LandlordRef,
+    form_token: token,
+    base_url: base,
+    expiry_date: "18 August 2026",
+  )
+}
+
+const form_link = "https://righttenantry.ie/reference/testtoken123"
+
+const stop_link = "https://righttenantry.ie/reference/testtoken123/stop"
+
+const notice_link = "https://righttenantry.ie/privacy#referee-data"
+
+// -- URL builders ------------------------------------------------------------
+
+pub fn form_url_test() {
+  messages.form_url(base_url: base, token: token)
+  |> should.equal(form_link)
+}
+
+pub fn stop_url_appends_stop_test() {
+  messages.stop_url(base_url: base, token: token)
+  |> should.equal(stop_link)
+}
+
+pub fn notice_url_points_at_referee_anchor_test() {
+  messages.notice_url(base_url: base)
+  |> should.equal(notice_link)
+}
+
+// -- small pure helpers ------------------------------------------------------
+
+pub fn role_phrase_per_slot_test() {
+  messages.role_phrase(slot: LandlordRef)
+  |> should.equal("their previous landlord")
+  messages.role_phrase(slot: EmployerRef)
+  |> should.equal("their employer")
+  messages.role_phrase(slot: CharacterRef)
+  |> should.equal("a character referee for them")
+}
+
+pub fn first_name_takes_first_token_test() {
+  messages.first_name(name: "Colm Byrne") |> should.equal("Colm")
+  messages.first_name(name: " Colm ") |> should.equal("Colm")
+  messages.first_name(name: "Colm") |> should.equal("Colm")
+}
+
+pub fn channel_and_outcome_names_match_attempt_log_vocabulary_test() {
+  messages.channel_name(messages.Email) |> should.equal("email")
+  messages.channel_name(messages.Sms) |> should.equal("sms")
+  messages.outcome_name(messages.Delivered) |> should.equal("delivered")
+  messages.outcome_name(messages.Skipped) |> should.equal("skipped")
+  messages.outcome_name(messages.Failed) |> should.equal("failed")
+}
+
+// -- T0 invite email: the Art 14 required list (AC1) ------------------------
+
+pub fn invite_email_subject_test() {
+  messages.invite_email_subject(applicant_full_name: "Aisling O'Brien")
+  |> should.equal("Aisling O'Brien listed you as a referee: a 5-minute form")
+}
+
+pub fn invite_email_names_controller_and_processor_test() {
+  let html = messages.build_invite_email_html(fixture_ctx())
+  // Controller identity = the landlord; RightTenantry = processor.
+  string.contains(html, "The landlord, Niamh Murphy, is the data controller")
+  |> should.be_true
+  string.contains(
+    html,
+    "RightTenantry processes your answers on their behalf to verify this application (lawful basis: legitimate interest)",
+  )
+  |> should.be_true
+}
+
+pub fn invite_email_names_source_purpose_retention_rights_test() {
+  let html = messages.build_invite_email_html(fixture_ctx())
+  // Source = the applicant.
+  string.contains(
+    html,
+    "We got your name and contact details from Aisling O&#39;Brien",
+  )
+  |> should.be_true
+  // Retention in plain terms + no marketing.
+  string.contains(
+    html,
+    "kept only as long as the application is retained, and never used for marketing",
+  )
+  |> should.be_true
+  // Rights including objection + the notice URL.
+  string.contains(
+    html,
+    "You can see, correct, delete, or object to your data at any time",
+  )
+  |> should.be_true
+  string.contains(html, notice_link) |> should.be_true
+}
+
+pub fn invite_email_carries_form_link_and_decline_stop_link_test() {
+  let html = messages.build_invite_email_html(fixture_ctx())
+  string.contains(html, "Complete the reference") |> should.be_true
+  string.contains(html, form_link) |> should.be_true
+  // The decline affordance IS the stop-link (AD-6 amended).
+  string.contains(html, "Decline here") |> should.be_true
+  string.contains(html, stop_link) |> should.be_true
+  string.contains(html, "expires in 10 days") |> should.be_true
+}
+
+pub fn invite_email_uses_slot_role_phrase_test() {
+  let ctx = messages.RefereeContext(..fixture_ctx(), slot: EmployerRef)
+  let html = messages.build_invite_email_html(ctx)
+  string.contains(html, "gave us your details as their employer.")
+  |> should.be_true
+}
+
+// -- T0 invite SMS: short notice + links, never reply-STOP (AC1) ------------
+
+pub fn invite_sms_carries_form_notice_and_stop_links_test() {
+  let sms = messages.build_invite_sms(fixture_ctx())
+  string.contains(sms, form_link) |> should.be_true
+  string.contains(sms, notice_link) |> should.be_true
+  string.contains(sms, stop_link) |> should.be_true
+  string.contains(sms, "Hi Colm, Aisling O'Brien gave us your details")
+  |> should.be_true
+  string.contains(sms, "From RightTenantry for the landlord")
+  |> should.be_true
+}
+
+pub fn invite_sms_never_says_reply_stop_test() {
+  let sms = messages.build_invite_sms(fixture_ctx())
+  string.contains(sms, "Reply STOP") |> should.be_false
+  string.contains(sms, "reply STOP") |> should.be_false
+}
+
+// -- Reminders (AC2) ---------------------------------------------------------
+
+pub fn reminder_subjects_test() {
+  messages.reminder_email_subject(messages.ReminderOne, "Aisling O'Brien")
+  |> should.equal("Still happy to help Aisling O'Brien? 5 minutes")
+  messages.reminder_email_subject(messages.ReminderTwo, "Aisling O'Brien")
+  |> should.equal("Last message from us: reference for Aisling O'Brien")
+}
+
+pub fn reminder_one_email_carries_links_test() {
+  let html =
+    messages.build_reminder_email_html(messages.ReminderOne, fixture_ctx())
+  string.contains(html, "the same link picks up where you left off")
+  |> should.be_true
+  string.contains(html, form_link) |> should.be_true
+  string.contains(html, stop_link) |> should.be_true
+  string.contains(html, notice_link) |> should.be_true
+}
+
+pub fn reminder_two_email_carries_expiry_and_finality_test() {
+  let html =
+    messages.build_reminder_email_html(messages.ReminderTwo, fixture_ctx())
+  // The interpolated name escapes its apostrophe; the static possessive
+  // suffix keeps its raw apostrophe.
+  string.contains(
+    html,
+    "This is our last message about Aisling O&#39;Brien's application",
+  )
+  |> should.be_true
+  string.contains(html, "the form is here until 18 August 2026")
+  |> should.be_true
+  string.contains(html, "decline here") |> should.be_true
+  string.contains(html, stop_link) |> should.be_true
+  string.contains(
+    html,
+    "we'll simply let the landlord know we couldn't reach you",
+  )
+  |> should.be_true
+}
+
+pub fn reminder_two_email_falls_back_when_expiry_unknown_test() {
+  let ctx = messages.RefereeContext(..fixture_ctx(), expiry_date: "")
+  let html = messages.build_reminder_email_html(messages.ReminderTwo, ctx)
+  string.contains(html, "the form is here until 10 days from our first message")
+  |> should.be_true
+}
+
+pub fn reminder_smss_carry_stop_link_test() {
+  let one = messages.build_reminder_sms(messages.ReminderOne, fixture_ctx())
+  string.contains(
+    one,
+    "Reminder: Aisling O'Brien's reference form takes about 5 min",
+  )
+  |> should.be_true
+  string.contains(one, form_link) |> should.be_true
+  string.contains(one, stop_link) |> should.be_true
+  string.contains(one, "To stop these messages:") |> should.be_true
+  string.contains(one, "reply STOP") |> should.be_false
+
+  let two = messages.build_reminder_sms(messages.ReminderTwo, fixture_ctx())
+  string.contains(two, "Last reminder: the reference form for Aisling O'Brien")
+  |> should.be_true
+  string.contains(two, "until 18 August 2026") |> should.be_true
+  string.contains(two, stop_link) |> should.be_true
+  string.contains(two, "reply STOP") |> should.be_false
+}
+
+// -- Co-nudge (AC2): applicant-facing, no stop-link --------------------------
+
+pub fn co_nudge_subject_test() {
+  messages.co_nudge_email_subject(referee_first_name: "Colm")
+  |> should.equal("A quick word to Colm helps your application")
+}
+
+pub fn co_nudge_body_carries_the_mechanic_test() {
+  let html =
+    messages.build_co_nudge_email_html(
+      applicant_first_name: "Aisling",
+      referee_name: "Colm Byrne",
+    )
+  string.contains(html, "We've invited Colm Byrne to complete your reference")
+  |> should.be_true
+  string.contains(html, "expect a text from RightTenantry, it's legitimate")
+  |> should.be_true
+  string.contains(html, "We'll keep the process moving.") |> should.be_true
+  // Applicant-facing: no referee opt-out machinery, no Art 14 referee notice.
+  string.contains(html, "/stop") |> should.be_false
+  string.contains(html, "privacy#referee-data") |> should.be_false
+}
+
+// -- Warm handoff (§7.9 line + attempt log) ----------------------------------
+
+pub fn warm_handoff_subject_test() {
+  messages.warm_handoff_email_subject("Colm Byrne", "Aisling O'Brien")
+  |> should.equal("Couldn't reach Colm Byrne (Aisling O'Brien's referee)")
+}
+
+pub fn warm_handoff_renders_line_log_and_cta_test() {
+  let attempts = [
+    messages.AttemptEntry(
+      at: "2026-08-14 09:12",
+      channel: "email",
+      outcome: "delivered",
+      detail: "resend-id-1",
+    ),
+    messages.AttemptEntry(
+      at: "2026-08-14 09:12",
+      channel: "sms",
+      outcome: "failed",
+      detail: "Twilio API error: HTTP 400",
+    ),
+  ]
+  let html =
+    messages.build_warm_handoff_email_html(
+      landlord_name: "Niamh",
+      referee_name: "Colm Byrne",
+      applicant_full_name: "Aisling O'Brien",
+      attempts:,
+      application_url: "https://righttenantry.ie/dashboard/vacancies/v1/applications/a1",
+    )
+  // §7.9 verbatim line.
+  string.contains(html, "You can take over from the application page.")
+  |> should.be_true
+  string.contains(
+    html,
+    "We've tried to reach them 2 times over the last 4 days",
+  )
+  |> should.be_true
+  string.contains(html, "2026-08-14 09:12: email, delivered (resend-id-1)")
+  |> should.be_true
+  string.contains(html, "sms, failed (Twilio API error: HTTP 400)")
+  |> should.be_true
+  string.contains(html, "Open the application") |> should.be_true
+  string.contains(
+    html,
+    "https://righttenantry.ie/dashboard/vacancies/v1/applications/a1",
+  )
+  |> should.be_true
+}
+
+pub fn warm_handoff_empty_log_renders_honestly_test() {
+  let html =
+    messages.build_warm_handoff_email_html(
+      landlord_name: "Niamh",
+      referee_name: "Colm Byrne",
+      applicant_full_name: "Aisling O'Brien",
+      attempts: [],
+      application_url: "https://righttenantry.ie/x",
+    )
+  string.contains(html, "No attempts recorded.") |> should.be_true
+  string.contains(html, "0 times") |> should.be_true
+}
+
+// -- Em-dash ban (RT global) + reply-STOP ban: every built string ------------
+
+pub fn no_em_dash_in_any_template_test() {
+  let ctx = fixture_ctx()
+  let outputs = [
+    messages.invite_email_subject(ctx.applicant_full_name),
+    messages.build_invite_email_html(ctx),
+    messages.build_invite_sms(ctx),
+    messages.reminder_email_subject(
+      messages.ReminderOne,
+      ctx.applicant_full_name,
+    ),
+    messages.reminder_email_subject(
+      messages.ReminderTwo,
+      ctx.applicant_full_name,
+    ),
+    messages.build_reminder_email_html(messages.ReminderOne, ctx),
+    messages.build_reminder_email_html(messages.ReminderTwo, ctx),
+    messages.build_reminder_sms(messages.ReminderOne, ctx),
+    messages.build_reminder_sms(messages.ReminderTwo, ctx),
+    messages.co_nudge_email_subject("Colm"),
+    messages.build_co_nudge_email_html("Aisling", "Colm Byrne"),
+    messages.warm_handoff_email_subject("Colm Byrne", "Aisling O'Brien"),
+    messages.build_warm_handoff_email_html(
+      "Niamh",
+      "Colm Byrne",
+      "Aisling O'Brien",
+      [],
+      "https://righttenantry.ie/x",
+    ),
+  ]
+  list_all_free_of(outputs, "\u{2014}")
+}
+
+pub fn no_reply_stop_anywhere_test() {
+  let ctx = fixture_ctx()
+  let outputs = [
+    messages.build_invite_email_html(ctx),
+    messages.build_invite_sms(ctx),
+    messages.build_reminder_email_html(messages.ReminderOne, ctx),
+    messages.build_reminder_email_html(messages.ReminderTwo, ctx),
+    messages.build_reminder_sms(messages.ReminderOne, ctx),
+    messages.build_reminder_sms(messages.ReminderTwo, ctx),
+  ]
+  list_all_free_of(outputs, "Reply STOP")
+  list_all_free_of(outputs, "reply STOP")
+}
+
+fn list_all_free_of(outputs: List(String), needle: String) -> Nil {
+  case outputs {
+    [] -> Nil
+    [head, ..rest] -> {
+      string.contains(head, needle) |> should.be_false
+      list_all_free_of(rest, needle)
+    }
+  }
+}
+
+// -- HTML escaping of interpolated values ------------------------------------
+
+pub fn invite_email_escapes_interpolated_names_test() {
+  let ctx =
+    messages.RefereeContext(
+      ..fixture_ctx(),
+      applicant_full_name: "<script>alert(1)</script>",
+      landlord_display_name: "Niamh <b>Murphy</b>",
+    )
+  let html = messages.build_invite_email_html(ctx)
+  string.contains(html, "<script>alert(1)</script>") |> should.be_false
+  string.contains(html, "&lt;script&gt;") |> should.be_true
+  string.contains(html, "Niamh &lt;b&gt;Murphy&lt;/b&gt;") |> should.be_true
+}
+
+pub fn sms_templates_do_not_escape_apostrophes_test() {
+  // SMS is plain text: O'Brien stays literal (the fixture carries one).
+  let sms = messages.build_invite_sms(fixture_ctx())
+  string.contains(sms, "Aisling O'Brien") |> should.be_true
+  string.contains(sms, "&#39;") |> should.be_false
+}
diff --git a/server/test/reference_checks/send_test.gleam b/server/test/reference_checks/send_test.gleam
new file mode 100644
index 00000000..97e789a1
--- /dev/null
+++ b/server/test/reference_checks/send_test.gleam
@@ -0,0 +1,206 @@
+//// Unit tests for reference_checks/send — the no-op doctrine + the outcome
+//// mapping. Real provider sends are NOT exercised (the email_client_test /
+//// sms_client_test approach: HTTP glue is integration territory); what is
+//// pinned here is that a missing key or a missing contact NEVER reaches
+//// HTTP and always comes back `skipped` with an honest detail string.
+
+import gleam/option.{None, Some}
+import gleeunit/should
+import notification/sms_client
+import reference_checks/messages
+import reference_checks/send
+import sentry/sentry_client
+import shared/reference_call.{LandlordRef}
+
+fn no_key_deps() -> send.SendDeps {
+  send.SendDeps(
+    resend_api_key: "",
+    twilio: sms_client.Disabled,
+    sentry: sentry_client.Disabled,
+  )
+}
+
+fn fixture_message() -> send.RefereeMessage {
+  send.RefereeMessage(
+    context: messages.RefereeContext(
+      referee_first_name: "Colm",
+      applicant_full_name: "Aisling O'Brien",
+      applicant_first_name: "Aisling",
+      landlord_display_name: "Niamh Murphy",
+      slot: LandlordRef,
+      form_token: "testtoken123",
+      base_url: "https://righttenantry.ie",
+      expiry_date: "18 August 2026",
+    ),
+    to_email: Some("colm@example.ie"),
+    to_phone: Some("+353861234567"),
+  )
+}
+
+// -- AC5: no keys -> all channels skipped, no crash, no HTTP -----------------
+
+pub fn send_invite_no_keys_skips_both_channels_test() {
+  send.send_invite(no_key_deps(), fixture_message())
+  |> should.equal([
+    messages.ChannelOutcome(
+      messages.Email,
+      messages.Skipped,
+      "no RESEND_API_KEY",
+    ),
+    messages.ChannelOutcome(
+      messages.Sms,
+      messages.Skipped,
+      "twilio not configured",
+    ),
+  ])
+}
+
+pub fn send_reminder_no_keys_skips_both_channels_test() {
+  send.send_reminder(no_key_deps(), messages.ReminderOne, fixture_message())
+  |> should.equal([
+    messages.ChannelOutcome(
+      messages.Email,
+      messages.Skipped,
+      "no RESEND_API_KEY",
+    ),
+    messages.ChannelOutcome(
+      messages.Sms,
+      messages.Skipped,
+      "twilio not configured",
+    ),
+  ])
+}
+
+pub fn send_co_nudge_no_key_skips_test() {
+  send.send_co_nudge(
+    no_key_deps(),
+    to_email: "aisling@example.ie",
+    applicant_first_name: "Aisling",
+    referee_name: "Colm Byrne",
+    referee_first_name: "Colm",
+  )
+  |> should.equal(messages.ChannelOutcome(
+    messages.Email,
+    messages.Skipped,
+    "no RESEND_API_KEY",
+  ))
+}
+
+pub fn send_warm_handoff_no_key_skips_test() {
+  send.send_warm_handoff(
+    no_key_deps(),
+    to_email: "niamh@example.ie",
+    landlord_name: "Niamh",
+    referee_name: "Colm Byrne",
+    applicant_full_name: "Aisling O'Brien",
+    attempts: [],
+    application_url: "https://righttenantry.ie/x",
+  )
+  |> should.equal(messages.ChannelOutcome(
+    messages.Email,
+    messages.Skipped,
+    "no RESEND_API_KEY",
+  ))
+}
+
+// -- AC4: an absent contact skips only its own channel -----------------------
+
+pub fn send_invite_missing_email_skips_email_only_test() {
+  let message = send.RefereeMessage(..fixture_message(), to_email: None)
+  let outcomes = send.send_invite(no_key_deps(), message)
+  outcomes
+  |> should.equal([
+    messages.ChannelOutcome(
+      messages.Email,
+      messages.Skipped,
+      "no email contact on file",
+    ),
+    messages.ChannelOutcome(
+      messages.Sms,
+      messages.Skipped,
+      "twilio not configured",
+    ),
+  ])
+}
+
+pub fn send_invite_missing_phone_skips_sms_only_test() {
+  let message = send.RefereeMessage(..fixture_message(), to_phone: None)
+  send.send_invite(no_key_deps(), message)
+  |> should.equal([
+    messages.ChannelOutcome(
+      messages.Email,
+      messages.Skipped,
+      "no RESEND_API_KEY",
+    ),
+    messages.ChannelOutcome(
+      messages.Sms,
+      messages.Skipped,
+      "no phone contact on file",
+    ),
+  ])
+}
+
+pub fn send_invite_no_contact_at_all_skips_both_test() {
+  let message =
+    send.RefereeMessage(..fixture_message(), to_email: None, to_phone: None)
+  send.send_invite(no_key_deps(), message)
+  |> should.equal([
+    messages.ChannelOutcome(
+      messages.Email,
+      messages.Skipped,
+      "no email contact on file",
+    ),
+    messages.ChannelOutcome(
+      messages.Sms,
+      messages.Skipped,
+      "no phone contact on file",
+    ),
+  ])
+}
+
+// -- outcome mappers (AC4: delivered carries the provider id) ----------------
+
+pub fn email_outcome_maps_ok_to_delivered_with_id_test() {
+  send.email_outcome(Ok("re_abc123"))
+  |> should.equal(messages.ChannelOutcome(
+    messages.Email,
+    messages.Delivered,
+    "re_abc123",
+  ))
+}
+
+pub fn email_outcome_maps_error_to_failed_with_reason_test() {
+  send.email_outcome(Error("Resend API error: 422"))
+  |> should.equal(messages.ChannelOutcome(
+    messages.Email,
+    messages.Failed,
+    "Resend API error: 422",
+  ))
+}
+
+pub fn sms_outcome_maps_sent_to_delivered_with_sid_test() {
+  send.sms_outcome(Ok(sms_client.Sent(message_sid: "SM123abc")))
+  |> should.equal(messages.ChannelOutcome(
+    messages.Sms,
+    messages.Delivered,
+    "SM123abc",
+  ))
+}
+
+pub fn sms_outcome_maps_skipped_to_skipped_test() {
+  send.sms_outcome(Ok(sms_client.Skipped))
+  |> should.equal(messages.ChannelOutcome(
+    messages.Sms,
+    messages.Skipped,
+    "twilio not configured",
+  ))
+}
+
+pub fn sms_outcome_maps_error_to_failed_test() {
+  send.sms_outcome(Error("Twilio API error: HTTP 400"))
+  |> should.equal(messages.ChannelOutcome(
+    messages.Sms,
+    messages.Failed,
+    "Twilio API error: HTTP 400",
+  ))
+}
