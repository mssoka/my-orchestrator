@@ -0,0 +1,1696 @@
+//// Demo-mode in-memory store.
+////
+//// Pure MVU state on the Model (`Model.demo_store`): seeded from the JSON
+//// fixtures through the PRODUCTION `shared/` decoders, mutated only by
+//// demo dispatch, and re-seeded on every `/demo` entry and on "Reset demo".
+//// Non-persistence is by construction - a page refresh drops the whole
+//// Model, and nothing in this module (or anywhere in `demo/`) touches the
+//// network (the CI grep lint enforces that).
+////
+//// DERIVED, NOT SERIALIZED: the dashboard list, vacancy detail, leaderboard,
+//// application detail, comparison and archived views are all computed on
+//// demand from the single source of truth (vacancies + their applications).
+//// A mutation touches one place and every surface re-derives consistently -
+//// no parallel lists to drift.
+////
+//// The per-application craft (AI report content, documents, audit trail,
+//// reference calls, income/co-applicants) lives here, keyed by application
+//// id. It is constructed TYPED against the shared types (compile-time), and
+//// the conformance suite round-trips every derived surface through the
+//// shared ENCODERS + DECODERS so a codec drift fails `make test`.
+
+import demo/demo_fixtures.{type SeedError} as fixtures
+import gleam/int
+import gleam/list
+import gleam/option.{type Option, None, Some}
+import gleam/result
+import gleam/set
+import gleam/string
+import shared/ai_analysis.{
+  type AiAnalysis, type RiskLevel, AiAnalysis, Completed, High, Low, Medium,
+  Pending, Processing,
+}
+import shared/application.{
+  type Application, type ApplicationStatus, Application, Approved, Rejected,
+  Shortlisted, Submitted, UnderReview, Viewed,
+}
+import shared/application_detail.{
+  type ApplicationDetail, type AuditEntry, ApplicationDetail, AuditEntry,
+}
+import shared/bulk_invite.{type BulkInviteResult, BulkInviteResult}
+import shared/co_applicant.{type CoApplicant, CoApplicant}
+import shared/document.{
+  type Document, type DocumentCategory, AdditionalDocs, CharacterRef, Document,
+  EmployerRef, LandlordRef, ProofOfIncome,
+}
+import shared/income_source.{type IncomeSource, IncomeSource, SelfEmployed}
+import shared/landlord.{type Landlord, Landlord, Realtime}
+import shared/leaderboard.{
+  type LeaderboardEntry, type LeaderboardResponse, LeaderboardEntry,
+  LeaderboardResponse,
+}
+import shared/notification.{type Notification, Notification}
+import shared/reference_call.{
+  type ReferenceCallDetail, type ReferenceCallHooks, Completed as RefCompleted,
+  ContactInitiated, EmployerRef as RefEmployerRef, LandlordRef as RefLandlordRef,
+  OutcomeCompleted, Primary, Queued as RefQueued, ReferenceCallDetail,
+  ReferenceCallHooks, Scheduled, Skipped as RefSkipped,
+}
+import shared/vacancy.{
+  type AwaitingApplicant, type CreateVacancyPayload, type DashboardStats,
+  type UpdateVacancyPayload, type Vacancy, type VacancyDetail,
+  type VacancyForEdit, type VacancyWithStats, Active, AwaitingApplicant, Closed,
+  DashboardStats, Draft, Vacancy, VacancyDetail, VacancyForEdit,
+  VacancyWithStats,
+}
+
+// -- Types -------------------------------------------------------------------
+
+/// One application with its full AI + document + reference context, as the
+/// application-detail endpoint would serve it.
+pub type DemoApplication {
+  DemoApplication(
+    application: Application,
+    analysis: Option(AiAnalysis),
+    audit_trail: List(AuditEntry),
+    documents: List(Document),
+    income_sources: List(IncomeSource),
+    co_applicants: List(CoApplicant),
+    reference_calls: List(ReferenceCallDetail),
+    attestation_on_file: Bool,
+    movement: String,
+  )
+}
+
+pub type DemoVacancy {
+  DemoVacancy(
+    vacancy: Vacancy,
+    applications: List(DemoApplication),
+    archived_at: Option(String),
+  )
+}
+
+pub type DemoStore {
+  DemoStore(
+    landlord: Landlord,
+    vacancies: List(DemoVacancy),
+    notifications: List(Notification),
+  )
+}
+
+// -- Seeding -----------------------------------------------------------------
+
+/// An empty store - belt-and-braces fallback if seeding ever fails at
+/// runtime (the conformance suite is the real guard; this just prevents a
+/// crash). Demo dispatch against an empty store resolves empty lists, which
+/// render the normal empty states.
+pub fn empty_store() -> DemoStore {
+  DemoStore(
+    landlord: Landlord(
+      id: "demo-landlord",
+      email: "sarah.mitchell@example.ie",
+      name: "Sarah Mitchell",
+      phone: None,
+      company_name: None,
+      rtb_number: None,
+      free_analyses_remaining: 3,
+      notification_preference: Realtime,
+      created_at: "2026-08-19T00:00:00Z",
+      has_password: True,
+      accepted_policy_version: "2026-05-23",
+    ),
+    vacancies: [],
+    notifications: [],
+  )
+}
+
+/// Build a fresh store from the fixtures. A decode failure anywhere is a
+/// hard error (the drift guard) - never a silent empty demo.
+pub fn seed() -> Result(DemoStore, SeedError) {
+  use landlord <- result.try(fixtures_seed_landlord())
+  use notifications <- result.try(fixtures_seed_notifications())
+  use vacancies <- result.try(fixtures_seed_vacancies())
+  use applications <- result.try(fixtures_seed_applications())
+  let demo_vacancies =
+    list.map(vacancies, fn(v) {
+      DemoVacancy(
+        vacancy: v,
+        applications: applications
+          |> list.filter(fn(a) { a.vacancy_id == v.id })
+          |> list.map(attach_craft),
+        archived_at: case v.id {
+          "v-sunningdale" -> Some("2026-07-16T09:00:00Z")
+          _ -> None
+        },
+      )
+    })
+  Ok(DemoStore(landlord:, vacancies: demo_vacancies, notifications:))
+}
+
+fn fixtures_seed_landlord() -> Result(Landlord, SeedError) {
+  fixtures.seed_landlord() |> fixtures.seed_error_from_result
+}
+
+fn fixtures_seed_notifications() -> Result(List(Notification), SeedError) {
+  fixtures.seed_notifications() |> fixtures.seed_error_from_result
+}
+
+fn fixtures_seed_vacancies() -> Result(List(Vacancy), SeedError) {
+  fixtures.seed_vacancies() |> fixtures.seed_error_from_result
+}
+
+fn fixtures_seed_applications() -> Result(List(Application), SeedError) {
+  fixtures.seed_applications() |> fixtures.seed_error_from_result
+}
+
+// -- Per-application craft (the marketing) -----------------------------------
+
+fn attach_craft(app: Application) -> DemoApplication {
+  DemoApplication(
+    application: app,
+    analysis: analysis_for(app.id),
+    audit_trail: audit_for(app.id),
+    documents: documents_for(app.id),
+    income_sources: income_for(app.id),
+    co_applicants: co_applicants_for(app.id),
+    reference_calls: reference_calls_for(app.id),
+    attestation_on_file: True,
+    movement: movement_for(app.id),
+  )
+}
