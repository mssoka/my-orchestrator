+fn change_status(
+  store: DemoStore,
+  vacancy_id: String,
+  application_id: String,
+  slug: String,
+  event_type: String,
+) -> #(DemoStore, Result(String, Nil)) {
+  let target = status_from_slug(slug)
+  // The audit detail's trigger mirrors the event kind: an auto-open writes
+  // "auto", a landlord action writes "manual" (r4 note — the old code
+  // hardcoded manual for both).
+  let trigger = case event_type {
+    "status_auto_changed" -> "auto"
+    _ -> "manual"
+  }
+  let updated =
+    list.map(store.vacancies, fn(v) {
+      case v.vacancy.id == vacancy_id {
+        False -> v
+        True ->
+          DemoVacancy(
+            ..v,
+            applications: list.map(v.applications, fn(app) {
+              case app.application.id == application_id {
+                False -> app
+                True ->
+                  DemoApplication(
+                    ..app,
+                    application: Application(..app.application, status: target),
+                    audit_trail: list.append(app.audit_trail, [
+                      AuditEntry(
+                        event_type:,
+                        details: Some(
+                          "{\"to\":\""
+                          <> slug
+                          <> "\",\"trigger\":\""
+                          <> trigger
+                          <> "\"}",
+                        ),
+                        created_at: "2026-08-19T00:00:00Z",
+                      ),
+                    ]),
+                  )
+              }
+            }),
+          )
+      }
+    })
+  #(DemoStore(..store, vacancies: updated), Ok(slug))
+}
