+  VacancyWithStats(
+    id: vac.id,
+    user_id: vac.user_id,
+    property_name: vac.property_name,
+    address_line_1: vac.address_line_1,
+    city: vac.city,
+    monthly_rent_cents: vac.monthly_rent_cents,
+    status: vac.status,
+    is_paid: vac.is_paid,
+    short_code: vac.short_code,
+    bedrooms: vac.bedrooms,
+    property_type: vac.property_type,
+    created_at: vac.created_at,
+    closes_at: vac.closes_at,
+    total_applications: total,
+    analysed_applications: list.length(analysed_apps(v.applications)),
+    strong_count: count_score(v.applications, 70, 101),
+    review_count: count_score(v.applications, 40, 70),
+    weak_count: count_score(v.applications, 0, 40),
+    days_remaining: demo_days_remaining(vac.id, vac.closes_at),
+    is_free_vacancy: vac.is_paid == False,
+  )
+}
+
+/// Static countdowns for the demo - believable, deterministic, reset on
+/// every seed. (Real days-remaining comes from the server's clock; the
+/// demo deliberately keeps a fixed picture so screenshots and reviews are
+/// stable.)
+/// Fixture vacancies keep their fixed countdowns (stable screenshots);
+/// anything else (a vacancy created inside the demo) derives its remaining
+/// days from its closes_at against the demo's fixed "now" (2026-08-19).
+fn demo_days_remaining(vacancy_id: String, closes_at: String) -> Int {
+  case vacancy_id {
+    "v-maples" -> 14
+    "v-harbour" -> 21
+    _ -> days_between("2026-08-19", closes_at)
+  }
+}
+
+/// Whole days between two YYYY-MM-DD… ISO date strings (naive Gregorian day
+/// numbers; demo data is "now"-relative so timezone handling is unneeded).
+fn days_between(from_iso: String, to_iso: String) -> Int {
+  date_to_day_number(to_iso) - date_to_day_number(from_iso)
+}
+
+fn date_to_day_number(iso: String) -> Int {
+  let parts = case string.split(string.slice(iso, 0, 10), "-") {
+    [y, m, d] -> #(y, m, d)
+    _ -> #("2026", "08", "19")
+  }
+  let y = case int.parse(parts.0) {
+    Ok(n) -> n
+    Error(_) -> 2026
+  }
+  let m = case int.parse(parts.1) {
+    Ok(n) -> n
+    Error(_) -> 8
+  }
+  let d = case int.parse(parts.2) {
+    Ok(n) -> n
+    Error(_) -> 19
+  }
+  let y0 = y - 1
+  y0 * 365 + y0 / 4 - y0 / 100 + y0 / 400 + month_offset(y, m) + d
+}
+
+fn month_offset(year: Int, month: Int) -> Int {
+  let acc = case month {
+    m if m > 1 -> 31
+    _ -> 0
+  }
+  let acc = case month > 2 {
+    True -> acc + days_in_month(year, 2)
+    False -> acc
+  }
+  let acc = case month > 3 {
+    True -> acc + 31
+    False -> acc
+  }
+  let acc = case month > 4 {
+    True -> acc + 30
+    False -> acc
+  }
+  let acc = case month > 5 {
+    True -> acc + 31
+    False -> acc
+  }
+  let acc = case month > 6 {
+    True -> acc + 30
+    False -> acc
+  }
+  let acc = case month > 7 {
+    True -> acc + 31
+    False -> acc
+  }
+  let acc = case month > 8 {
+    True -> acc + 31
+    False -> acc
+  }
+  let acc = case month > 9 {
+    True -> acc + 30
+    False -> acc
+  }
+  let acc = case month > 10 {
+    True -> acc + 31
+    False -> acc
+  }
+  let acc = case month > 11 {
+    True -> acc + 30
+    False -> acc
+  }
+  acc
+}
