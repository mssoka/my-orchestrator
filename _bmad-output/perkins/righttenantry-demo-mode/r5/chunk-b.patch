+fn opt_str(value: String) -> Option(String) {
+  case value {
+    "" -> None
+    s -> Some(s)
+  }
+}
+
+/// Add `days` to an ISO date-time string (naive Gregorian day arithmetic on
+/// the YYYY-MM-DD prefix; demo data is always "now"-relative so no timezone
+/// handling is needed).
+fn add_days_iso(iso: String, days: Int) -> String {
+  let date = string.slice(iso, 0, 10)
+  let date_parts = case string.split(date, "-") {
+    [y, m, d] -> #(y, m, d)
+    _ -> #("2026", "08", "19")
+  }
+  let y = case int.parse(date_parts.0) {
+    Ok(n) -> n
+    Error(_) -> 2026
+  }
+  let m = case int.parse(date_parts.1) {
+    Ok(n) -> n
+    Error(_) -> 8
+  }
+  let d = case int.parse(date_parts.2) {
+    Ok(n) -> n
+    Error(_) -> 19
+  }
+  // Roll forward day-by-month until the day fits — validity windows can
+  // span multiple months (a single rollover produced impossible dates like
+  // 2026-09-33 for validity >= ~43 days).
+  let #(y2, m2, d2) = roll_forward(y, m, d + days)
+  pad2(y2) <> "-" <> pad2(m2) <> "-" <> pad2(d2) <> string.drop_start(iso, 10)
+}
+
+fn roll_forward(y: Int, m: Int, day: Int) -> #(Int, Int, Int) {
+  let total = days_in_month(y, m)
+  case day > total {
+    False -> #(y, m, day)
+    True ->
+      case m == 12 {
+        True -> roll_forward(y + 1, 1, day - total)
+        False -> roll_forward(y, m + 1, day - total)
+      }
+  }
+}
+
+fn days_in_month(year: Int, month: Int) -> Int {
+  case month {
+    2 ->
+      case is_leap_year(year) {
+        True -> 29
+        False -> 28
+      }
+    4 | 6 | 9 | 11 -> 30
+    _ -> 31
+  }
+}
+
+fn is_leap_year(year: Int) -> Bool {
+  case year % 4 == 0 {
+    False -> False
+    True ->
+      case year % 100 == 0 {
+        False -> True
+        True -> year % 400 == 0
+      }
+  }
+}
+
+fn pad2(n: Int) -> String {
+  case n < 10 {
+    True -> "0" <> int.to_string(n)
+    False -> int.to_string(n)
+  }
+}
+
+/// Stable short id suffix from a property name (lowercase alphanumeric,
+/// up to 8 chars) so re-created demo vacancies don't collide.
+fn id_suffix(value: String) -> String {
+  let cleaned =
+    value
+    |> string.lowercase
+    |> string.replace(each: " ", with: "-")
+    |> string.replace(each: "'", with: "")
+    |> string.replace(each: ".", with: "")
+  case string.length(cleaned) {
+    n if n <= 8 -> cleaned
+    n -> string.drop_end(cleaned, n - 8)
+  }
+}
