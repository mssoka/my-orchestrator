+      failed:,
+      total:,
+      is_burst_active:,
+    ),
+  )
+}
+
+// -- Reference checks ---------------------------------------------------------
+/// Generic reference-check action (RC4.3): start / skip / re_enable /
+/// take_over / correct / substitute. `call_id` keys the row; the demo store
+/// maps the action to a status/contact mutation.
+pub fn refcheck_action(
+  store: DemoStore,
+  vacancy_id: String,
+  application_id: String,
+  call_id: String,
+  action: String,
+  on_response: fn(Result(String, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
