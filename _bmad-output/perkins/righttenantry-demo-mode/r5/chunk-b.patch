+fn count_score(apps: List(DemoApplication), min: Int, max: Int) -> Int {
+  list.length(
+    list.filter(analysed_apps(apps), fn(a) {
+      case a.analysis {
+        Some(an) ->
+          case an.overall_score {
+            Some(s) -> s >= min && s < max
+            None -> False
+          }
+        None -> False
+      }
+    }),
+  )
+}
