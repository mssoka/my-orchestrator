+  store: DemoStore,
+  on_response: fn(Result(#(List(VacancyWithStats), DashboardStats), ApiError)) ->
+    msg,
+) -> Effect(msg) {
+  let #(vacancies, stats) = demo_store.dashboard(store)
+  deliver(on_response, #(vacancies, stats))
+}
+
+pub fn get_detail(
+  store: DemoStore,
+  vacancy_id: String,
+  on_response: fn(Result(VacancyDetail, ApiError)) -> msg,
+) -> Effect(msg) {
+  case demo_store.vacancy_detail(store, vacancy_id) {
+    Ok(detail) -> deliver(on_response, detail)
+    Error(_) -> deliver_err(on_response)
+  }
+}
+
