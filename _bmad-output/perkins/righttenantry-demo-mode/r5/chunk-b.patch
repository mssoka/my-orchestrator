+pub fn update_vacancy(
+  store: DemoStore,
+  vacancy_id: String,
+  payload: UpdateVacancyPayload,
+) -> #(DemoStore, Result(Vacancy, Nil)) {
+  let updated =
+    list.map(store.vacancies, fn(v) {
+      case v.vacancy.id == vacancy_id {
+        False -> v
+        True -> {
+          let old = v.vacancy
+          DemoVacancy(
+            ..v,
+            vacancy: Vacancy(
+              ..old,
+              property_name: payload.property_name,
+              address_line_1: payload.address_line_1,
+              address_line_2: opt_str(payload.address_line_2),
+              city: payload.city,
+              county: payload.county,
+              eircode: opt_str(payload.eircode),
+              monthly_rent_cents: payload.monthly_rent_cents,
+              bedrooms: payload.bedrooms,
+              bathrooms: payload.bathrooms,
+              furnished: payload.furnished,
+              property_type: payload.property_type,
+              pets_policy: payload.pets_policy,
+              smoking_policy: payload.smoking_policy,
+              available_from: payload.available_from,
+              lease_term: opt_str(payload.lease_term),
+              requirements: opt_str(payload.requirements),
+              status: case payload.status {
+                "active" -> Active
+                "closed" -> Closed
+                _ -> old.status
+              },
+            ),
+          )
+        }
+      }
+    })
+  let next = DemoStore(..store, vacancies: updated)
+  #(next, find_vacancy(next, vacancy_id) |> result.map(fn(v) { v.vacancy }))
+}
