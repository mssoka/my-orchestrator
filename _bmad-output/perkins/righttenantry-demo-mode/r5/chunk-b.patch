+
+    // -- Scoring status (static: one completed response, no polling chain) ---------
+    AppRequestedScoringStatus(generation, vid, _visible) ->
+      case generation == model.scoring_generation {
+        False -> #(model, effect.none())
+        True -> {
+          let store = store_of(model)
+          #(
+            model,
+            demo_api.get_scoring_status(store, vid, fn(result) {
+              ApiReturnedScoringStatus(generation, result)
+            }),
+          )
+        }
+      }
+
+    // -- Reference checks ------------------------------------------------------------
+    UserChoseRefcheckAction(call_id, action) -> {
+      // Immediate actions (skip / re-enable) fire the api straight away; the
+      // confirm/edit-opening kinds are UI-only and fall through untouched.
+      case action {
+        RefcheckSkip -> fire_demo_refcheck(model, call_id, "skip")
+        RefcheckReEnable -> fire_demo_refcheck(model, call_id, "re_enable")
+        _ -> fallback(model, msg)
+      }
+    }
+    UserConfirmedRefcheckAction(call_id) -> {
+      case model.refcheck_confirm {
+        Some(confirm) if confirm.call_id == call_id ->
+          case confirm.kind {
+            RefcheckConfirmStart -> fire_demo_refcheck(model, call_id, "start")
+            RefcheckConfirmTakeOver ->
+              fire_demo_refcheck(model, call_id, "take_over")
+          }
+        _ -> #(model, effect.none())
+      }
+    }
+    UserSavedRefcheckEdit(call_id) ->
+      case dict.get(model.refcheck_edit, call_id) {
+        Ok(edit) ->
+          // The §8.3 edit-trio knows whether it was opened as a correction
+          // (AD-7) or a substitution (new row) — dispatch the right action
+          // so a substitute doesn't behave as a correction.
+          case edit.kind {
+            RefcheckEditSubstitute -> {
+              // §8.3 validation, mirroring the real save path: a referee
+              // needs a name AND a reachable channel — an empty save must
+              // NOT wipe the contact and report success.
+              let name = string.trim(edit.name)
+              let email = string.trim(edit.email)
+              let phone = string.trim(edit.phone)
+              case name {
+                "" ->
+                  edit_error(model, call_id, edit, copy.refcheck_edit_need_name)
+                _ ->
+                  case email, phone {
+                    "", "" ->
+                      edit_error(
+                        model,
+                        call_id,
+                        edit,
+                        copy.refcheck_edit_need_channel,
+                      )
+                    _, _ ->
+                      fire_demo_refcheck_substitute(
+                        model,
+                        call_id,
+                        name,
+                        email,
+                        phone,
+                      )
+                  }
+              }
+            }
+            RefcheckEditCorrect -> fire_demo_refcheck(model, call_id, "correct")
+          }
+        Error(_) -> #(model, effect.none())
+      }
+
+    // -- Notifications ---------------------------------------------------------------
+    AppRequestedNotifications -> {
+      let store = store_of(model)
+      #(
+        Model(..model, notifications: Loading),
+        demo_api.fetch_notifications(store, ApiReturnedNotifications),
+      )
+    }
+    UserClickedNotification(id, _entity_type, _entity_id) -> {
+      let store = store_of(model)
+      let #(next, eff) =
+        demo_api.mark_notification_read(store, id, "", ApiReturnedMarkRead)
+      // The real arm closes the dropdown after marking read — mirror it.
+      #(
+        Model(
+          ..model,
+          demo_store: Some(next),
+          show_notification_dropdown: False,
+        ),
+        eff,
+      )
+    }
+    UserClickedMarkAllRead -> {
+      let store = store_of(model)
+      let #(next, eff) =
+        demo_api.mark_all_notifications_read(store, "", ApiReturnedMarkAllRead)
+      // W11 (r4): clear the badge optimistically like the real arm — the
+      // store mutation alone leaves the bell's unread count stale.
+      #(Model(..model, demo_store: Some(next), unread_count: 0), eff)
+    }
+
+    // -- Vacancy lifecycle ------------------------------------------------------------
+    UserClickedPublishVacancy(id) ->
+      case model.loading_action {
+        Some(_) -> #(model, effect.none())
+        None -> {
+          let store = store_of(model)
+          let #(next, eff) =
+            demo_api.publish_vacancy(store, id, "", fn(result) {
+              msg.ApiReturnedPublishVacancy(id, result)
+            })
+          #(
+            Model(
+              ..model,
+              demo_store: Some(next),
+              loading_action: Some(LoadingPublish(id)),
+            ),
+            eff,
+          )
+        }
+      }
+    UserConfirmedCloseVacancy(id) ->
+      case model.loading_action {
+        Some(_) -> #(Model(..model, confirm_action: None), effect.none())
+        None -> {
+          let store = store_of(model)
+          let #(next, eff) =
+            demo_api.close_vacancy(store, id, "", ApiReturnedCloseVacancy)
+          #(
+            Model(
+              ..model,
+              demo_store: Some(next),
+              confirm_action: None,
+              loading_action: Some(LoadingClose),
+            ),
+            eff,
+          )
+        }
+      }
+    UserConfirmedArchiveVacancy(id) ->
+      case model.loading_action {
+        Some(_) -> #(Model(..model, confirm_action: None), effect.none())
+        None -> {
+          let store = store_of(model)
+          let #(next, eff) =
+            demo_api.archive_vacancy(store, id, "", ApiReturnedArchiveVacancy)
+          #(
+            Model(
+              ..model,
+              demo_store: Some(next),
+              confirm_action: None,
+              loading_action: Some(LoadingArchive),
+            ),
+            eff,
+          )
+        }
+      }
+
+    // Everything else (response messages, form inputs, UI toggles, modals,
+    // create/edit vacancy submissions — those branch on demo_mode inside
+    // client.gleam's shared helpers) falls through to the real handler.
+    _ -> fallback(model, msg)
+  }
+}
+
+// -- Helpers -----------------------------------------------------------------
+
+/// Brand-voice info toast for surfaces that aren't part of the demo.
+fn demo_not_in_demo_toast(
+  model: Model,
+  message: String,
+) -> #(Model, Effect(Msg)) {
+  let toast_id = model.next_toast_id + 1
+  #(
+    Model(
+      ..model,
+      toasts: list.append(model.toasts, [
+        model.Toast(id: toast_id, message:, level: model.ToastInfo),
+      ]),
+      next_toast_id: toast_id,
+    ),
+    effect.from(fn(dispatch) {
+      global.set_timeout(5000, fn() { dispatch(msg.AppDismissToast(toast_id)) })
+      Nil
+    }),
+  )
+}
+
+/// §8.3 inline validation failure — set the row's error, keep the form open
+/// (mirror of the real path's need-name / need-channel branches).
+fn edit_error(
+  model: Model,
+  call_id: String,
+  edit: model.RefcheckEdit,
+  message: String,
+) -> #(Model, Effect(Msg)) {
+  #(
+    Model(
+      ..model,
+      refcheck_edit: dict.insert(
+        model.refcheck_edit,
+        call_id,
+        model.RefcheckEdit(..edit, error: Some(message)),
+      ),
+    ),
+    effect.none(),
+  )
+}
+
+/// The demo store, or a fresh seed when unset (unreachable while demo_mode
+/// is True; the fallback keeps the demo crash-free on a None). Shared with
+/// client.gleam's demo branches via the `pub` export — the single home for
+/// the None->seed fallback.
+pub fn store_of(model: Model) -> DemoStore {
+  case model.demo_store {
+    Some(store) -> store
+    None ->
+      // Unreachable while demo_mode is True (entry/reset always seed first);
+      // fall back to a fresh seed so the demo can never crash on a None.
+      case demo_store.seed() {
+        Ok(store) -> store
+        Error(_) -> demo_store.empty_store()
+      }
+  }
+}
+
+fn reset_demo(model: Model) -> #(Model, Effect(Msg)) {
+  case demo_store.seed() {
+    Ok(store) -> {
+      demo_analytics.capture_event(demo_analytics.demo_reset)
+      let #(vacancies, stats) = demo_store.dashboard(store)
+      let landlord = demo_store.landlord(store)
+      #(
+        Model(
+          ..model,
+          route: routes.Demo,
+          demo_store: Some(store),
+          auth: Success(landlord),
+          vacancies: Success(vacancies),
+          dashboard_stats: Success(stats),
+          vacancy_detail: NotAsked,
+          leaderboard: NotAsked,
+          application_detail: NotAsked,
+          comparison_details: NotAsked,
+          archived_vacancies: NotAsked,
+          awaiting_list: NotAsked,
+          notifications: NotAsked,
+          toasts: [],
+        ),
+        effect.batch([
+          demo_api.fetch_notifications(store, ApiReturnedNotifications),
+          // Reset from a non-dashboard page must return to the demo root —
+          // every other surface was set to NotAsked above and would strand
+          // on a skeleton without a navigation.
+          modem.replace("/demo", None, None),
+        ]),
+      )
+    }
+    // W16 (r4): a seed failure is a decode-drift hard error (the fixture
+    // guard) — exit the demo with a brand-voice toast rather than a dead
+    // click. The reset CTA is the only survivor when fixtures break.
+    Error(_) -> {
+      let #(toast_model, toast_eff) =
+        demo_not_in_demo_toast(model, copy.demo_reset_failed)
+      #(
+        Model(
+          ..toast_model,
+          route: routes.Landing,
+          demo_mode: False,
+          demo_store: None,
+        ),
+        effect.batch([toast_eff, modem.replace("/", None, None)]),
+      )
+    }
+  }
+}
+
+fn demo_status(
+  model: Model,
+  vid: String,
+  aid: String,
+  status: String,
+) -> #(Model, Effect(Msg)) {
+  let store = store_of(model)
+  let #(next, eff) =
+    demo_api.update_application_status(
+      store,
+      vid,
+      aid,
+      status,
+      "",
+      ApiReturnedStatusUpdate,
+    )
+  #(
+    Model(
+      ..model,
+      demo_store: Some(next),
+      loading_action: Some(LoadingStatusUpdate),
+    ),
+    eff,
+  )
+}
+
+/// Fire a reference-check action through the demo api, restoring the same
+/// in-flight marker the real flow sets (the ApiReturnedRefcheckAction
+/// response handler in update_inner does the rest).
+/// Substitute action with the typed referee trio — discarding the landlord's
+/// just-typed contacts would silently lose their input.
+fn fire_demo_refcheck_substitute(
+  model: Model,
+  call_id: String,
+  name: String,
+  email: String,
+  phone: String,
+) -> #(Model, Effect(Msg)) {
+  let store = store_of(model)
+  case model.route {
+    routes.ApplicationDetail(vid, aid) -> {
+      let #(next, eff) =
+        demo_api.refcheck_action_with_contact(
+          store,
+          vid,
+          aid,
+          call_id,
+          "substitute",
+          name,
+          email,
+          phone,
+          fn(result) {
+            ApiReturnedRefcheckAction(call_id, "substitute", result)
+          },
+        )
+      #(
+        Model(
+          ..model,
+          demo_store: Some(next),
+          refcheck_action_inflight: set.insert(
+            model.refcheck_action_inflight,
+            call_id,
+          ),
+        ),
+        eff,
+      )
+    }
+    _ -> #(model, effect.none())
+  }
+}
+
+fn fire_demo_refcheck(
+  model: Model,
+  call_id: String,
+  action: String,
+) -> #(Model, Effect(Msg)) {
+  let store = store_of(model)
+  // The store mutation key (underscore form) differs from the wire action
+  // name the shared toast matcher expects (hyphen form) — the response
+  // message must carry the hyphenated name or the toast falls to the wrong
+  // fallback copy.
+  let wire_action = case action {
+    "re_enable" -> "re-enable"
+    "take_over" -> "take-over"
+    other -> other
+  }
+  case model.route {
+    routes.ApplicationDetail(vid, aid) -> {
+      let #(next, eff) =
+        demo_api.refcheck_action(store, vid, aid, call_id, action, fn(result) {
+          ApiReturnedRefcheckAction(call_id, wire_action, result)
+        })
+      #(
+        Model(
+          ..model,
+          demo_store: Some(next),
+          refcheck_action_inflight: set.insert(
+            model.refcheck_action_inflight,
+            call_id,
+          ),
+        ),
+        eff,
+      )
+    }
+    _ -> #(model, effect.none())
+  }
+}
+
+/// 90s download timeout — mirrors client.gleam's `download_timeout` so a
+/// slow static asset (unlikely) still surfaces the brand-voice toast.
+fn download_timeout(id: String) -> Effect(Msg) {
+  effect.from(fn(dispatch) {
+    global.set_timeout(90_000, fn() {
+      dispatch(msg.AppTimedOutDownloadReport(id))
+    })
+    Nil
+  })
+}
