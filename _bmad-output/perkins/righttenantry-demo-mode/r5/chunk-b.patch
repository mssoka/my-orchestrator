+/// substitute form's contacts. `substitute` replaces the row's contact with
+/// the typed values (never nulls: the landlord just entered them).
+pub fn refcheck_action_with_contact(
+  store: DemoStore,
+  vacancy_id: String,
+  application_id: String,
+  call_id: String,
+  action: String,
+  name: String,
+  email: String,
+  phone: String,
+) -> #(DemoStore, Result(String, Nil)) {
+  let updated =
+    list.map(store.vacancies, fn(v) {
+      case v.vacancy.id == vacancy_id {
+        False -> v
+        True ->
+          DemoVacancy(
+            ..v,
+            applications: list.map(v.applications, fn(app) {
+              case app.application.id == application_id {
+                False -> app
+                True ->
+                  DemoApplication(
+                    ..app,
+                    reference_calls: list.map(app.reference_calls, fn(call) {
+                      case call.reference_call_id == call_id {
+                        False -> call
+                        True -> apply_refcheck(call, action, name, email, phone)
+                      }
+                    }),
+                  )
+              }
+            }),
+          )
+      }
+    })
+  #(DemoStore(..store, vacancies: updated), Ok(call_id))
+}
+
+fn apply_refcheck(
+  call: ReferenceCallDetail,
+  action: String,
+  name: String,
+  email: String,
+  phone: String,
+) -> ReferenceCallDetail {
+  case action {
+    "start" -> ReferenceCallDetail(..call, status: Scheduled)
+    "skip" -> ReferenceCallDetail(..call, status: RefSkipped)
+    "re_enable" -> ReferenceCallDetail(..call, status: RefQueued)
+    "take_over" ->
+      ReferenceCallDetail(..call, taken_over_at: Some("2026-08-19T00:00:00Z"))
+    "correct" ->
+      ReferenceCallDetail(..call, correction_cycles: call.correction_cycles + 1)
+    "substitute" -> {
+      // The landlord typed the new referee into the form — apply it, don't
+      // blank it. Partial overwrite: only fields with a typed value change
+      // (an empty field keeps the existing contact detail).
+      let call = case name {
+        "" -> call
+        typed -> ReferenceCallDetail(..call, contact_name: Some(typed))
+      }
+      let call = case email {
+        "" -> call
+        typed -> ReferenceCallDetail(..call, contact_email: Some(typed))
+      }
+      case phone {
+        "" -> call
+        typed -> ReferenceCallDetail(..call, contact_phone: Some(typed))
+      }
+    }
+    _ -> call
+  }
+}
