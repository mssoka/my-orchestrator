+pub fn dashboard(store: DemoStore) -> #(List(VacancyWithStats), DashboardStats) {
+  let active_vacancies =
+    store.vacancies |> list.filter(fn(v) { v.archived_at == None })
+  let pending_analysis =
+    list.fold(active_vacancies, 0, fn(n, v) {
+      n
+      + list.length(
+        list.filter(v.applications, fn(a) {
+          case a.analysis {
+            Some(an) ->
+              case an.status {
+                Pending | Processing -> True
+                _ -> False
+              }
+            None -> False
+          }
+        }),
+      )
+    })
+  let scored =
+    list.fold(active_vacancies, 0, fn(n, v) {
+      n
+      + list.length(
+        list.filter(v.applications, fn(a) {
+          case a.analysis {
+            Some(an) -> an.status == Completed
+            None -> False
+          }
+        }),
+      )
+    })
+  let total_applications =
+    list.fold(active_vacancies, 0, fn(n, v) { n + list.length(v.applications) })
+  let stats =
+    DashboardStats(
+      active_vacancies: list.length(active_vacancies),
+      total_applications:,
+      pending_analysis:,
+      scored_applications: scored,
+    )
+  #(list.map(active_vacancies, vacancy_with_stats), stats)
+}
+
+pub fn archived(store: DemoStore) -> List(VacancyWithStats) {
+  store.vacancies
+  |> list.filter(fn(v) { v.archived_at != None })
+  |> list.map(vacancy_with_stats)
+}
