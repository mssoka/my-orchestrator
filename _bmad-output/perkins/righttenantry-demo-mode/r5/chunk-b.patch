+pub fn leaderboard(
+  store: DemoStore,
+  vacancy_id: String,
+) -> Result(LeaderboardResponse, Nil) {
+  use v <- result.try(find_vacancy(store, vacancy_id))
+  let entries = list.map(v.applications, leaderboard_entry)
+  let scored =
+    list.filter(entries, fn(e) {
+      case e.overall_score {
+        Some(_) -> True
+        None -> False
+      }
+    })
+  Ok(LeaderboardResponse(
+    entries:,
+    total: list.length(entries),
+    strong_count: list.length(
+      list.filter(scored, fn(e) {
+        case e.overall_score {
+          Some(s) -> s >= 70
+          None -> False
+        }
+      }),
+    ),
+    review_count: list.length(
+      list.filter(scored, fn(e) {
+        case e.overall_score {
+          Some(s) -> s >= 40 && s < 70
+          None -> False
+        }
+      }),
+    ),
+    weak_count: list.length(
+      list.filter(scored, fn(e) {
+        case e.overall_score {
+          Some(s) -> s < 40
+          None -> False
+        }
+      }),
+    ),
+    shortlisted_count: list.length(
+      list.filter(entries, fn(e) { e.status == Shortlisted }),
+    ),
+  ))
+}
+
+fn leaderboard_entry(app: DemoApplication) -> LeaderboardEntry {
+  let a = app.application
+  let analysis_status = case app.analysis {
+    Some(an) -> ai_analysis.encode_status(an.status)
+    None -> "pending"
+  }
+  LeaderboardEntry(
+    id: a.id,
+    first_name: a.first_name,
+    last_name: a.last_name,
+    monthly_income_cents: a.monthly_income_cents,
+    status: a.status,
+    created_at: a.created_at,
+    ai_status: analysis_status,
+    overall_score: case app.analysis {
+      Some(an) -> an.overall_score
+      None -> None
+    },
+    movement: app.movement,
+    score_based_rank: case app.analysis {
+      Some(an) -> an.overall_score
+      None -> None
+    },
+    job_title: a.job_title,
+    current_city: a.current_city,
+    household_monthly_income_cents: a.household_monthly_income_cents,
+    co_applicant_count: a.co_applicant_count,
+    has_proof_of_income: has_doc(app.documents, ProofOfIncome),
+    has_landlord_ref: has_doc(app.documents, LandlordRef),
