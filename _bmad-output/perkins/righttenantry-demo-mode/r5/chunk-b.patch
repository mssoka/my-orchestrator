+
+/// The demo dispatcher. `fallback` is client.gleam's `update_inner`.
+pub fn handle(
+  model model: Model,
+  msg msg: Msg,
+  fallback fallback: fn(Model, Msg) -> #(Model, Effect(Msg)),
+) -> #(Model, Effect(Msg)) {
+  case msg {
+    // -- Payments are not part of the demo --------------------------------------
+    // The "why pay" unlock/extend surfaces are real Stripe flows — clicking
+    // them in demo must never reach payment_api (no Stripe invocation from
+    // demo mode). Surfaced as a brand-voice info toast; the banner CTA is the
+    // conversion path.
+    UserClickedPayCheckout(_vid) | UserClickedExtendVacancy(_vid) ->
+      demo_not_in_demo_toast(model, copy.demo_payments_toast)
+    UserConfirmedUnlockConsent(_)
+    | UserConfirmedExtensionConsent(_)
+    | UserToggledUnlockConsent(_)
+    | UserToggledExtensionConsent(_)
+    | UserCancelledUnlockConsent
+    | UserCancelledExtensionConsent
+    | AppPolledPaymentStatus(_) -> #(model, effect.none())
+
+    // -- Settings are not part of the demo --------------------------------------
+    // /settings is blocked at the view (a demo notice renders instead), and
+    // these write messages are intercepted as defense-in-depth — a stray
+    // dispatch can never fire a real settings_api write (profile, password,
+    // preferences, ACCOUNT DELETION) with the demo's bogus CSRF token.
+    UserSubmittedProfile ->
+      demo_not_in_demo_toast(model, copy.demo_settings_profile_toast)
+    UserSubmittedPasswordChange ->
+      demo_not_in_demo_toast(model, copy.demo_settings_password_toast)
+    UserChangedNotificationPreference(_) ->
+      demo_not_in_demo_toast(model, copy.demo_settings_prefs_toast)
+    UserClickedDeleteAccount | UserConfirmedAccountDeletion ->
+      demo_not_in_demo_toast(model, copy.demo_settings_delete_toast)
+    AppRequestedBillingHistory | UserClickedSettingsSection(_) -> #(
+      model,
+      effect.none(),
+    )
+
+    UserClosedDeleteModal -> #(
+      Model(
+        ..model,
+        delete_modal_open: False,
+        delete_confirm_email: "",
+        delete_in_progress: False,
+      ),
+      effect.none(),
+    )
+
+    // -- Bulk reject (sweep nudge / select mode) --------------------------------
+    UserClickedMarkAllRejected(vid) ->
+      case model.application_detail {
+        Success(detail) -> {
+          let ids =
+            sweep_nudge_banner.open_ids(detail.application, model.leaderboard)
+          case ids {
+            [] -> #(model, effect.none())
+            _ -> {
+              let store = store_of(model)
+              let #(next, eff) =
+                demo_api.bulk_reject_applications(
+                  store,
+                  vid,
+                  ids,
+                  "sweep_nudge",
+                  "",
+                  msg.ApiReturnedBulkReject,
+                )
+              #(
+                Model(
+                  ..model,
+                  demo_store: Some(next),
+                  bulk_reject_loading: True,
+                ),
+                eff,
+              )
+            }
+          }
+        }
+        _ -> #(model, effect.none())
+      }
+    UserClickedMarkSelectedRejected(vid) -> {
+      let ids = set.to_list(model.selected_for_rejection)
+      case ids {
+        [] -> #(model, effect.none())
+        _ -> {
+          let store = store_of(model)
+          let #(next, eff) =
+            demo_api.bulk_reject_applications(
+              store,
+              vid,
+              ids,
+              "leaderboard_select",
+              "",
+              msg.ApiReturnedBulkReject,
+            )
+          #(
+            Model(..model, demo_store: Some(next), bulk_reject_loading: True),
+            eff,
+          )
+        }
+      }
+    }
+
+    // -- Demo chrome ----------------------------------------------------------
+    UserClickedResetDemo -> reset_demo(model)
+    // The create-vacancy entry navigates (real handler) but must be counted.
+    UserClickedCreateVacancy -> {
+      demo_analytics.capture_event(demo_analytics.demo_create_vacancy_open)
+      fallback(model, msg)
+    }
+    UserClickedDemoCta -> {
+      demo_analytics.capture_event(demo_analytics.demo_cta_click)
+      #(model, effect.none())
+    }
+    // Signing out of the demo exits back to the landing page — there is no
+    // session to destroy.
+    UserClickedLogout -> {
+      // Exit cleanly: clear demo_mode + the mock session AND every
+      // demo-populated store field, so a later real login can never see the
+      // demo vacancies (the dashboard refetch gates on NotAsked).
+      #(
+        Model(
+          ..model
+          |> model.clear_demo_state,
+          // W1: an explicit sign-out stays signed out — drop the stashed
+          // real session rather than restoring it (nav-exit restores).
+          auth: NotAsked,
+          demo_saved_auth: NotAsked,
+          demo_saved_csrf: "",
+          route: routes.Landing,
+          toasts: [],
+        ),
+        modem.push("/", None, None),
+      )
+    }
+
+    // -- Static demo: no background polling, no session refresh ----------------
+    AppPolledData(_, _, _) -> #(model, effect.none())
+    AppRequestedSessionRefresh -> #(model, effect.none())
+    AppRetriedApplicationOpen(_, _, _) -> #(model, effect.none())
+
+    // -- Dashboard -------------------------------------------------------------
+    AppRequestedDashboardData -> {
+      let store = store_of(model)
+      #(
+        Model(..model, vacancies: Loading, dashboard_stats: Loading),
+        demo_api.list_vacancies(store, ApiReturnedDashboardData),
+      )
+    }
+
+    // -- Vacancy detail + leaderboard ------------------------------------------
+    AppRequestedVacancyDetail(id) -> {
+      let store = store_of(model)
+      #(
+        Model(
+          ..model,
+          vacancy_detail: Loading,
+          vacancy_detail_request_id: Some(id),
+          leaderboard: Loading,
+          leaderboard_total: 0,
+          leaderboard_strong_count: 0,
+          leaderboard_review_count: 0,
+          leaderboard_weak_count: 0,
+          leaderboard_shortlisted_count: 0,
+          leaderboard_page: 1,
+          leaderboard_loading_more: False,
+          clipboard_copied: None,
+          bulk_invite_emails: "",
+          awaiting_expanded: False,
+          awaiting_list: NotAsked,
+          reminding_applicant_email: None,
+          scoring_status: None,
+          scoring_poll_count: 0,
+          scoring_poll_vacancy_id: "",
+          scoring_error_count: 0,
+        ),
+        effect.batch([
+          demo_api.get_detail(store, id, ApiReturnedVacancyDetail),
+          demo_api.fetch_leaderboard(store, id, ApiReturnedLeaderboard),
+        ]),
+      )
+    }
+    AppRequestedLeaderboard(id) -> {
+      let store = store_of(model)
+      #(
+        Model(
+          ..model,
+          leaderboard: Loading,
+          leaderboard_page: 1,
+          leaderboard_total: 0,
+          leaderboard_strong_count: 0,
+          leaderboard_review_count: 0,
+          leaderboard_weak_count: 0,
+          leaderboard_shortlisted_count: 0,
+          leaderboard_loading_more: False,
+        ),
+        demo_api.fetch_leaderboard(store, id, ApiReturnedLeaderboard),
+      )
+    }
+    UserClickedLoadMoreApplications(vacancy_id) -> {
+      let store = store_of(model)
+      #(
+        Model(..model, leaderboard_loading_more: True),
+        demo_api.fetch_leaderboard_page(
+          store,
+          vacancy_id,
+          model.leaderboard_page + 1,
+          ApiReturnedLeaderboardPage,
+        ),
+      )
+    }
+
+    // -- Application detail -----------------------------------------------------
+    AppRequestedApplicationDetail(vid, aid) -> {
+      let store = store_of(model)
+      #(
+        Model(
+          ..model,
+          application_detail: Loading,
+          application_detail_request_id: Some(aid),
+        ),
+        demo_api.fetch_application_detail(
+          store,
+          vid,
+          aid,
+          ApiReturnedApplicationDetail,
+        ),
+      )
+    }
+    UserChangedApplicationStatus(vid, aid, new_status) -> {
+      case model.loading_action == Some(LoadingStatusUpdate) {
+        True -> #(model, effect.none())
+        False -> demo_status(model, vid, aid, new_status)
+      }
+    }
+    UserConfirmedApproval(vid, aid) -> {
+      let #(updated, eff) = demo_status(model, vid, aid, "approved")
+      // Refetch the leaderboard from the POST-mutation store so the approved
+      // applicant's row reflects the new status (the pre-mutation store
+      // would leave them under-review).
+      let store = case updated.demo_store {
+        Some(next) -> next
+        None -> store_of(model)
+      }
+      let leaderboard_eff =
+        demo_api.fetch_leaderboard(store, vid, ApiReturnedLeaderboard)
+      #(
+        Model(..updated, show_approval_confirm: False, pending_approval: None),
+        effect.batch([eff, leaderboard_eff]),
+      )
+    }
+    UserConfirmedRejection(vid, aid) -> {
+      let #(updated, eff) = demo_status(model, vid, aid, "rejected")
+      #(
+        Model(..updated, show_reject_confirm: False, pending_rejection: None),
+        eff,
+      )
+    }
+    UserConfirmedBackwardTransition(vid, aid, target) -> {
+      let #(updated, eff) = demo_status(model, vid, aid, target)
+      #(
+        Model(
+          ..updated,
+          show_backward_confirm: False,
+          pending_backward_transition: None,
+        ),
+        eff,
+      )
+    }
+
+    // -- Archived ---------------------------------------------------------------
+    AppRequestedArchivedVacancies -> {
+      let store = store_of(model)
+      #(
+        Model(..model, archived_vacancies: Loading),
+        demo_api.fetch_archived(store, ApiReturnedArchivedVacancies),
+      )
+    }
+    UserClickedRestoreVacancy(id) -> {
