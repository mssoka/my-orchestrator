+/// The fetches a fresh demo entry needs for its route: dashboard + bell for
+/// the demo root, the route's own data for a deep-linked demo route.
+fn demo_entry_effects(store: DemoStore, route: Route) -> Effect(Msg) {
+  let base = [demo_api.fetch_notifications(store, ApiReturnedNotifications)]
+  let route_eff = case route {
+    routes.Demo | routes.Dashboard -> [
+      demo_api.list_vacancies(store, ApiReturnedDashboardData),
+    ]
+    routes.VacancyDetail(id) | routes.VacancyHandoff(id) -> [
+      demo_api.get_detail(store, id, ApiReturnedVacancyDetail),
+      demo_api.fetch_leaderboard(store, id, ApiReturnedLeaderboard),
+    ]
+    routes.VacancyEdit(id) -> [
+      demo_api.get_for_edit(store, id, ApiReturnedVacancyForEdit),
+    ]
+    routes.ApplicationDetail(vid, aid) -> [
+      demo_api.fetch_application_detail(
+        store,
+        vid,
+        aid,
+        ApiReturnedApplicationDetail,
+      ),
+    ]
+    routes.ArchivedVacancies -> [
+      demo_api.fetch_archived(store, ApiReturnedArchivedVacancies),
+    ]
+    routes.Comparison(vid) -> [
+      demo_api.fetch_comparison(
+        store,
+        vid,
+        load_comparison_ids(),
+        ApiReturnedComparisonDetails,
+      ),
+    ]
+    _ -> []
   }
+  effect.batch(list.append(base, route_eff))
+}
