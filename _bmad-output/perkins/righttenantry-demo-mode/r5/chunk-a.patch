+/// True when the route is the demo root or a deep link into demo fixture ids
+/// (v-maples / v-harbour / v-sunningdale). Real vacancy ids are UUIDs, so a
+/// "v-" prefix unambiguously identifies demo data. A refresh on such a URL
+/// re-enters the demo; anything else boots normally.
+fn is_demo_route(route: Route) -> Bool {
+  case route {
+    routes.Demo -> True
+    routes.VacancyDetail(id)
+    | routes.VacancyEdit(id)
+    | routes.VacancyHandoff(id) -> string.starts_with(id, "v-")
+    routes.ApplicationDetail(vid, _) -> string.starts_with(vid, "v-")
+    routes.Comparison(vid) -> string.starts_with(vid, "v-")
+    _ -> False
+  }
+}
