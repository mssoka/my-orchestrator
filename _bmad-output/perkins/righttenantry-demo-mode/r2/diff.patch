+/// The fixture JSON strings exposed for the conformance suite, which parses
+/// each one with the corresponding production decoder and fails the build on
+/// drift. (The store itself decodes the same constants through the same
+/// decoders — this list exists so the test can enumerate them without
+/// reaching into private constants.)
+pub fn all_fixture_jsons() -> List(#(String, String)) {
+  [
