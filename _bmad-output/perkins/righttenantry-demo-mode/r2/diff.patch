+      GetCoApplicantsByApplicationRow(
+        id: "co-aoife-1",
+        first_name: "Daniel",
+        last_name: "Murphy",
+        monthly_income_cents: Some(240_000),
+        employment_status: "employed",
+        note: "Software engineer, moving in together",
+        employer_name: "Helix Systems",
+        employer_ref_name: "Helix Systems HR",
+        employer_ref_phone: "01 555 0170",
+        employer_ref_email: "people@helix.example.com",
+        has_guarantor: False,
+        guarantor_name: "",
+        guarantor_relationship: "",
+        guarantor_phone: "",
+        guarantor_email: "",
+        guarantor_monthly_income_cents: 0,
+        guarantor_employer: "",
+      ),
+    ]
+    _ -> []
+  }
+}
+
+// -- Main --------------------------------------------------------------------
+
+pub fn main() {
+  // RT_DEMO_PRIV_DIR overrides the priv dir (the Erlang-idiomatic way to
+  // pass a path; documented regen: `RT_DEMO_PRIV_DIR=priv gleam run
+  // -m demo/pdf_prebake` from the server root).
+  let priv_dir = case envoy.get("RT_DEMO_PRIV_DIR") {
+    Ok(dir) -> dir
+    Error(_) -> "priv"
+  }
+  let out_dir = priv_dir <> "/static/demo"
+  case simplifile.create_directory_all(out_dir) {
+    Ok(_) -> Nil
+    Error(_) -> Nil
+  }
+  let results =
+    list.map(payloads(), fn(p) {
+      let out_path = out_dir <> "/report-" <> p.application_id <> ".pdf"
+      case audit_report.generate(to_report_data(p), priv_dir) {
+        Ok(bytes) -> #(p.application_id, write(out_path, bytes))
+        Error(err) -> #(
+          p.application_id,
+          Error("generate failed: " <> describe_generate_error(err)),
+        )
+      }
+    })
+  list.each(results, fn(r) {
+    case r {
+      #(id, Ok(_)) -> io.println("✓ " <> id)
+      #(id, Error(msg)) -> io.println("✗ " <> id <> ": " <> msg)
+    }
+  })
+  let failures =
+    results
+    |> list.filter(fn(r) {
+      case r {
+        #(_, Error(_)) -> True
+        _ -> False
+      }
+    })
+    |> list.length
+  case failures {
+    0 ->
+      io.println(
+        "Pre-baked "
+        <> int_to_string(list.length(results))
+        <> " demo report PDFs into "
+        <> out_dir,
+      )
+    _ ->
+      io.println(
+        "FAILED: "
+        <> int_to_string(failures)
+        <> " of "
+        <> int_to_string(list.length(results))
+        <> " PDFs failed",
+      )
+  }
+}
+
+fn write(path: String, bytes: BitArray) -> Result(Nil, String) {
+  case simplifile.write_bits(path, bytes) {
+    Ok(_) -> Ok(Nil)
+    Error(err) -> Error(simplifile.describe_error(err))
+  }
+}
+
+fn describe_generate_error(err: audit_report.GenerateError) -> String {
+  case err {
+    audit_report.TypstFailed(message) -> "typst failed: " <> message
+    audit_report.TypstTimedOut(message) -> "typst timed out: " <> message
+    audit_report.OutputUnreadable(message) -> "output unreadable: " <> message
+  }
+}
+
+fn int_to_string(n: Int) -> String {
+  int.to_string(n)
+}
