diff --git a/client/src/demo/demo_analytics.gleam b/client/src/demo/demo_analytics.gleam
new file mode 100644
index 00000000..a9818f3b
--- /dev/null
+++ b/client/src/demo/demo_analytics.gleam
@@ -0,0 +1,50 @@
+//// Demo-mode PostHog analytics bridge.
+////
+//// Fires demo-flagged events behind the EXISTING consent gate — the FFI
+//// checks `posthog.has_opted_in_capturing()` itself, so callers fire
+//// unconditionally and the no-consent case drops silently (fail-open,
+//// same as `components/meta_pixel`). No identify, no PII: props carry only
+//// synthetic fixture ids and surface names.
+////
+//// The narrow FFI surface was approved by the user in the 2026-08-19
+//// lavish design verdict (Q2 — "Approve the narrow FFI — ship analytics
+//// in this PR").
+
+import gleam/json
+import gleam/list
+
+@external(javascript, "./demo_analytics_ffi.mjs", "capture")
+fn capture_ffi(event: String, props_json: String) -> Nil
+
+pub fn capture_event(event: String) -> Nil {
+  capture_ffi(event, "{}")
+}
+
+pub fn capture_with_props(event: String, props: List(#(String, String))) -> Nil {
+  capture_ffi(
+    event,
+    json.to_string(
+      json.object(list.map(props, fn(p) { #(p.0, json.string(p.1)) })),
+    ),
+  )
+}
+
+// -- Event names --------------------------------------------------------------
+
+pub const demo_entry = "demo_entry"
+
+pub const demo_reset = "demo_reset"
+
+pub const demo_vacancy_open = "demo_vacancy_open"
+
+pub const demo_application_open = "demo_application_open"
+
+pub const demo_comparison_open = "demo_comparison_open"
+
+pub const demo_archived_open = "demo_archived_open"
+
+pub const demo_report_download = "demo_report_download"
+
+pub const demo_cta_click = "demo_cta_click"
+
+pub const demo_create_vacancy_open = "demo_create_vacancy_open"
diff --git a/client/src/demo/demo_analytics_ffi.mjs b/client/src/demo/demo_analytics_ffi.mjs
new file mode 100644
index 00000000..c5e05edd
--- /dev/null
+++ b/client/src/demo/demo_analytics_ffi.mjs
@@ -0,0 +1,31 @@
+// Narrow FFI bridge for firing demo-flagged PostHog events from the SPA.
+// APPROVED via the 2026-08-19 lavish design verdict (job righttenantry-demo-mode,
+// Q2): one capture call, fail-open, consent-checked inside, zero PII —
+// the same shape as the pre-approved meta_pixel bridge.
+//
+// The event fires ONLY when PostHog's own persisted consent state says the
+// visitor opted in (`has_opted_in_capturing` — maintained by consent.js).
+// No identify, no user properties, no PII: props carry only demo-state
+// facts (surface names, vacancy/applicant ids from the synthetic fixtures).
+// Failure posture: fail-open — a missing posthog, a throw, or a revoked
+// consent all no-op and the SPA keeps working.
+
+function can_capture() {
+  return (
+    typeof window !== "undefined" &&
+    typeof window.posthog === "object" &&
+    window.posthog !== null &&
+    typeof window.posthog.has_opted_in_capturing === "function" &&
+    window.posthog.has_opted_in_capturing() &&
+    typeof window.posthog.capture === "function"
+  );
+}
+
+export function capture(event, props_json) {
+  if (!can_capture()) return undefined;
+  try {
+    const props = typeof props_json === "string" ? JSON.parse(props_json) : {};
+    window.posthog.capture(event, props);
+  } catch (_) {}
+  return undefined;
+}
diff --git a/client/src/demo/demo_api.gleam b/client/src/demo/demo_api.gleam
new file mode 100644
index 00000000..93812891
--- /dev/null
+++ b/client/src/demo/demo_api.gleam
@@ -0,0 +1,461 @@
+//// Demo-mode API mirror — the seam that makes the demo work without a
+//// backend.
+////
+//// Every function mirrors a real `api/*.gleam` signature but resolves from
+//// the in-memory `demo_store` and dispatches the response through the SAME
+//// `msg` constructor the real handler consumes — so `update_inner`'s
+//// response arms render the mock identically to a live response. The real
+//// api modules are never touched, and this module (like all of `demo/`)
+//// performs NO network calls: responses are dispatched synchronously via
+//// `effect.from`. The one deliberate exception is the report download,
+//// which fetches a PRE-BAKED static PDF (a read-only asset GET, never an
+//// API endpoint).
+////
+//// The CI grep lint enforces the no-network rule by banning the API-client
+//// modules and fetch imports across demo/ — except this one documented
+//// static-asset fetch in `download`.
+
+import api/api_error.{type ApiError}
+import api/auth_api.{type AuthResponse, AuthResponse}
+import demo/demo_store.{type DemoStore}
+import gleam/bit_array
+import gleam/fetch
+import gleam/http/request
+import gleam/http/response.{type Response}
+import gleam/javascript/promise
+import gleam/list
+import gleam/option.{type Option, None, Some}
+import gleam/result
+import gleam/string
+import lustre/effect.{type Effect}
+import model.{type ScoringStatusResponse, ScoringStatusResponse}
+import rsvp
+import shared/application_detail.{type ApplicationDetail}
+import shared/bulk_invite.{type BulkInviteResult}
+import shared/leaderboard.{type LeaderboardResponse}
+import shared/notification.{type Notification}
+import shared/policy_highlights
+import shared/vacancy.{
+  type AwaitingApplicant, type CreateVacancyPayload, type DashboardStats,
+  type UpdateVacancyPayload, type Vacancy, type VacancyDetail,
+  type VacancyForEdit, type VacancyWithStats,
+}
+
+// -- Effect plumbing ----------------------------------------------------------
+
+/// Dispatch `on_response(Ok(value))` on the next tick — the demo analogue
+/// of an HTTP response arriving. Runs through Lustre's normal dispatch, so
+/// the rest of the app cannot tell the mock from the real thing.
+fn deliver(on_response: fn(Result(a, ApiError)) -> msg, value: a) -> Effect(msg) {
+  effect.from(fn(dispatch) { dispatch(on_response(Ok(value))) })
+}
+
+/// Deliver a synthetic internal error (unreachable for seeded ids, but the
+/// code must be total). Routes through `api_error.from_body` — the same
+/// production-sanctioned path `report_api` uses for client-side rejections.
+fn deliver_err(on_response: fn(Result(a, ApiError)) -> msg) -> Effect(msg) {
+  effect.from(fn(dispatch) { dispatch(on_response(Error(internal_error()))) })
+}
+
+fn internal_error() -> ApiError {
+  api_error.from_body("{\"error\":{\"code\":\"internal_error\"}}")
+}
+
+// -- Auth --------------------------------------------------------------------
+
+pub fn check_session(
+  store: DemoStore,
+  on_response: fn(Result(AuthResponse, ApiError)) -> msg,
+) -> Effect(msg) {
+  deliver(
+    on_response,
+    AuthResponse(
+      landlord: demo_store.landlord(store),
+      csrf_token: "demo-csrf-token",
+      server_policy_version: policy_highlights.version,
+    ),
+  )
+}
+
+// -- Vacancy -----------------------------------------------------------------
+
+pub fn list_vacancies(
+  store: DemoStore,
+  on_response: fn(Result(#(List(VacancyWithStats), DashboardStats), ApiError)) ->
+    msg,
+) -> Effect(msg) {
+  let #(vacancies, stats) = demo_store.dashboard(store)
+  deliver(on_response, #(vacancies, stats))
+}
+
+pub fn get_detail(
+  store: DemoStore,
+  vacancy_id: String,
+  on_response: fn(Result(VacancyDetail, ApiError)) -> msg,
+) -> Effect(msg) {
+  case demo_store.vacancy_detail(store, vacancy_id) {
+    Ok(detail) -> deliver(on_response, detail)
+    Error(_) -> deliver_err(on_response)
+  }
+}
+
+pub fn fetch_archived(
+  store: DemoStore,
+  on_response: fn(Result(List(VacancyWithStats), ApiError)) -> msg,
+) -> Effect(msg) {
+  deliver(on_response, demo_store.archived(store))
+}
+
+pub fn get_for_edit(
+  store: DemoStore,
+  vacancy_id: String,
+  on_response: fn(Result(VacancyForEdit, ApiError)) -> msg,
+) -> Effect(msg) {
+  case demo_store.for_edit(store, vacancy_id) {
+    Ok(for_edit) -> deliver(on_response, for_edit)
+    Error(_) -> deliver_err(on_response)
+  }
+}
+
+pub fn fetch_awaiting(
+  store: DemoStore,
+  vacancy_id: String,
+  on_response: fn(Result(List(AwaitingApplicant), ApiError)) -> msg,
+) -> Effect(msg) {
+  deliver(on_response, demo_store.awaiting(store, vacancy_id))
+}
+
+pub fn send_reminder(
+  store: DemoStore,
+  vacancy_id: String,
+  _csrf_token: String,
+  on_response: fn(Result(#(Int, Int), ApiError)) -> msg,
+) -> Effect(msg) {
+  let #(next, result) = demo_store.send_reminder(store, vacancy_id)
+  let _ = next
+  deliver(on_response, result)
+}
+
+pub fn remind_applicant(
+  store: DemoStore,
+  vacancy_id: String,
+  _email: String,
+  _csrf_token: String,
+  on_response: fn(Result(#(Int, Int), ApiError)) -> msg,
+) -> Effect(msg) {
+  let #(next, result) = demo_store.remind_applicant(store, vacancy_id)
+  let _ = next
+  deliver(on_response, result)
+}
+
+pub fn send_bulk_invite(
+  store: DemoStore,
+  vacancy_id: String,
+  _emails: String,
+  _csrf_token: String,
+  on_response: fn(Result(BulkInviteResult, ApiError)) -> msg,
+) -> Effect(msg) {
+  let #(next, result) = demo_store.send_bulk_invite(store, vacancy_id)
+  let _ = next
+  deliver(on_response, result)
+}
+
+// -- Vacancy mutations --------------------------------------------------------
+
+pub fn create_vacancy(
+  store: DemoStore,
+  payload: CreateVacancyPayload,
+  _csrf_token: String,
+  on_response: fn(Result(Vacancy, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
+  let #(next, vacancy) = demo_store.create_vacancy(store, payload)
+  #(next, deliver(on_response, vacancy))
+}
+
+pub fn update_vacancy(
+  store: DemoStore,
+  vacancy_id: String,
+  payload: UpdateVacancyPayload,
+  _csrf_token: String,
+  on_response: fn(Result(Vacancy, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
+  let #(next, result) = demo_store.update_vacancy(store, vacancy_id, payload)
+  #(next, respond_result(result, on_response))
+}
+
+pub fn publish_vacancy(
+  store: DemoStore,
+  vacancy_id: String,
+  _csrf_token: String,
+  on_response: fn(Result(Vacancy, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
+  let #(next, result) = demo_store.publish_vacancy(store, vacancy_id)
+  #(next, respond_result(result, on_response))
+}
+
+pub fn archive_vacancy(
+  store: DemoStore,
+  vacancy_id: String,
+  _csrf_token: String,
+  on_response: fn(Result(String, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
+  let #(next, result) = demo_store.archive_vacancy(store, vacancy_id)
+  #(next, respond_result(result, on_response))
+}
+
+pub fn restore_vacancy(
+  store: DemoStore,
+  vacancy_id: String,
+  _csrf_token: String,
+  on_response: fn(Result(String, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
+  let #(next, result) = demo_store.restore_vacancy(store, vacancy_id)
+  #(next, respond_result(result, on_response))
+}
+
+pub fn close_vacancy(
+  store: DemoStore,
+  vacancy_id: String,
+  _csrf_token: String,
+  on_response: fn(Result(String, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
+  let #(next, result) = demo_store.close_vacancy(store, vacancy_id)
+  #(next, respond_result(result, on_response))
+}
+
+// -- Application ---------------------------------------------------------------
+
+pub fn fetch_leaderboard(
+  store: DemoStore,
+  vacancy_id: String,
+  on_response: fn(Result(LeaderboardResponse, ApiError)) -> msg,
+) -> Effect(msg) {
+  fetch_leaderboard_page(store, vacancy_id, 1, on_response)
+}
+
+pub fn fetch_leaderboard_page(
+  store: DemoStore,
+  vacancy_id: String,
+  _page: Int,
+  on_response: fn(Result(LeaderboardResponse, ApiError)) -> msg,
+) -> Effect(msg) {
+  case demo_store.leaderboard(store, vacancy_id) {
+    Ok(response) -> deliver(on_response, response)
+    Error(_) -> deliver_err(on_response)
+  }
+}
+
+pub fn fetch_application_detail(
+  store: DemoStore,
+  vacancy_id: String,
+  application_id: String,
+  on_response: fn(Result(ApplicationDetail, ApiError)) -> msg,
+) -> Effect(msg) {
+  case demo_store.application_detail(store, vacancy_id, application_id) {
+    Ok(detail) -> deliver(on_response, detail)
+    Error(_) -> deliver_err(on_response)
+  }
+}
+
+pub fn mark_application_opened(
+  store: DemoStore,
+  vacancy_id: String,
+  application_id: String,
+  _csrf_token: String,
+  on_response: fn(Result(String, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
+  let #(next, result) =
+    demo_store.mark_opened(store, vacancy_id, application_id)
+  #(next, respond_result(result, on_response))
+}
+
+pub fn update_application_status(
+  store: DemoStore,
+  vacancy_id: String,
+  application_id: String,
+  new_status: String,
+  _csrf_token: String,
+  on_response: fn(Result(String, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
+  let #(next, result) =
+    demo_store.set_status(store, vacancy_id, application_id, new_status)
+  #(next, respond_result(result, on_response))
+}
+
+pub fn fetch_comparison(
+  store: DemoStore,
+  vacancy_id: String,
+  ids: List(String),
+  on_response: fn(Result(List(ApplicationDetail), ApiError)) -> msg,
+) -> Effect(msg) {
+  case demo_store.comparison(store, vacancy_id, ids) {
+    Ok(details) -> deliver(on_response, details)
+    Error(_) -> deliver_err(on_response)
+  }
+}
+
+pub fn bulk_reject_applications(
+  store: DemoStore,
+  vacancy_id: String,
+  ids: List(String),
+  _trigger: String,
+  _csrf_token: String,
+  on_response: fn(Result(Int, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
