+        case e.overall_score {
+          Some(s) -> s >= 70
+          None -> False
+        }
+      }),
+    ),
+    review_count: list.length(
+      list.filter(scored, fn(e) {
+        case e.overall_score {
+          Some(s) -> s >= 40 && s < 70
+          None -> False
+        }
+      }),
+    ),
+    weak_count: list.length(
+      list.filter(scored, fn(e) {
+        case e.overall_score {
+          Some(s) -> s < 40
+          None -> False
+        }
+      }),
+    ),
+    shortlisted_count: list.length(
+      list.filter(entries, fn(e) { e.status == Shortlisted }),
+    ),
+  ))
+}
