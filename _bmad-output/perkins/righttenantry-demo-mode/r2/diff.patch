+fn vacancy_with_stats(v: DemoVacancy) -> VacancyWithStats {
+  let vac = v.vacancy
+  let total = list.length(v.applications)
+  VacancyWithStats(
+    id: vac.id,
+    user_id: vac.user_id,
+    property_name: vac.property_name,
+    address_line_1: vac.address_line_1,
+    city: vac.city,
+    monthly_rent_cents: vac.monthly_rent_cents,
+    status: vac.status,
+    is_paid: vac.is_paid,
+    short_code: vac.short_code,
+    bedrooms: vac.bedrooms,
+    property_type: vac.property_type,
+    created_at: vac.created_at,
+    closes_at: vac.closes_at,
+    total_applications: total,
+    analysed_applications: list.length(analysed_apps(v.applications)),
+    strong_count: count_score(v.applications, 70, 101),
+    review_count: count_score(v.applications, 40, 70),
+    weak_count: count_score(v.applications, 0, 40),
+    days_remaining: demo_days_remaining(vac.id),
+    is_free_vacancy: vac.is_paid == False,
+  )
+}
