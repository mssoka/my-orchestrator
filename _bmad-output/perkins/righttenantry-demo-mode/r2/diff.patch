+////
+//// Three elements per the 2026-08-19 design verdict:
+////   * "Demo - nothing is saved" - sets the expectation, never a modal.
+////   * "Create your vacancy →" - the in-demo CTA, persistent in the banner
+////     (verdict B), linking to /signup and firing the demo_cta_click event
+////     from the update handler.
+////   * "Reset demo" - re-seeds the in-memory store from the fixtures.
+
+import copy
+import lustre/attribute.{attribute, class}
+import lustre/element.{type Element}
+import lustre/element/html
+import lustre/event
+import msg.{type Msg, UserClickedDemoCta, UserClickedResetDemo}
+
+pub fn view_demo_banner() -> Element(Msg) {
+  html.div(
+    [
+      attribute("data-testid", "demo-banner"),
+      class(
+        "bg-amber/10 border-b border-amber/30 px-4 md:px-8 py-2.5 flex flex-wrap items-center justify-between gap-2",
+      ),
+    ],
+    [
+      html.p(
+        [
+          attribute("data-testid", "demo-banner-message"),
+          class("text-sm font-semibold text-amber"),
+        ],
+        [
+          html.text(
+            "Demo - nothing is saved. This is mock data, refreshed every visit.",
+          ),
+        ],
+      ),
+      html.div([class("flex items-center gap-3")], [
+        html.a(
+          [
+            attribute("data-testid", "demo-banner-cta"),
+            attribute.href("/signup"),
+            event.on_click(UserClickedDemoCta),
+            class(
+              "bg-amber text-white text-sm font-bold rounded-lg px-4 py-1.5 hover:bg-amber/90 transition-colors",
+            ),
+          ],
+          [html.text(copy.demo_banner_cta)],
+        ),
+        html.button(
+          [
+            attribute("data-testid", "demo-reset-btn"),
+            attribute("type", "button"),
+            event.on_click(UserClickedResetDemo),
+            class(
+              "bg-white border border-amber/40 text-amber text-xs font-bold rounded-lg px-3 py-1.5 hover:bg-amber/5 transition-colors cursor-pointer",
+            ),
+          ],
+          [html.text(copy.demo_banner_reset)],
+        ),
+      ]),
+    ],
+  )
+}
