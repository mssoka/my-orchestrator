@@ -0,0 +1,31 @@
+//// Pins the demo report-download path (Perkins r1 B1 + advisory gate):
+//// the analysis-id → application-id mapping and the baked-asset keying
+//// must stay aligned, or every demo download 404s.
+
+import demo/demo_api
+import demo/demo_store
+import gleam/list
+import gleam/string
+import gleeunit/should
+
+pub fn analysis_id_maps_to_baked_key_test() {
+  // "an-aoife" -> "a-aoife" — the id that keys report-a-aoife.pdf.
+  demo_api.application_id_from_analysis("an-aoife")
+  |> should.equal("a-aoife")
+  demo_api.application_id_from_analysis("an-declan")
+  |> should.equal("a-declan")
+}
+
+/// Every report_filenames entry's application id is reachable from its
+/// analysis id ("an-<app-id>"), so every demo download resolves to a baked
+/// asset.
+pub fn every_baked_report_has_a_matching_analysis_test() {
+  let pairs = demo_store.report_filenames()
+  list.length(pairs) |> should.equal(8)
+  list.each(pairs, fn(pair) {
+    // pair.0 is the app id ("a-aoife"); the analysis id is "an-aoife".
+    let analysis_id = "an-" <> string.drop_start(pair.0, 2)
+    demo_api.application_id_from_analysis(analysis_id)
+    |> should.equal(pair.0)
+  })
+}
diff --git a/scripts/lint_demo_network.py b/scripts/lint_demo_network.py
new file mode 100644
index 00000000..a8040a68
--- /dev/null
+++ b/scripts/lint_demo_network.py
@@ -0,0 +1,187 @@
+#!/usr/bin/env python3
+"""Demo-mode no-network structural lint (issue #628, Option B).
+
+The demo must never fire a real api-module request while `model.demo_mode` is
+True. The demo branches in client.gleam are all of the shape
+`case model.demo_mode { True -> <demo store> False -> <real api> }`, so this
+lint enforces the fall-through invariant structurally: every real api-module
+call on the landlord surfaces must sit within a few lines of a demo_mode
+`case` in the same arm (the `False` branch of the guard), or live in a
+documented demo-unreachable handler.
+
+Exemptions (principled, kept minimal):
+  * `auth_api.*` — the auth flows (login/signup/logout/password/accept-policy)
+    always run with demo_mode False: entering them exits the demo first, and
+    `check_session` is guarded at the top of its handler.
+  * The `ApiReturnedSession` arm — its very first line is the demo guard
+    (`case model.demo_mode { True -> #(model, effect.none()) ... }`), and the
+    route fetches inside only run in the `False` branch.
+
+Exit 1 on violation. Run as part of `test.yml`.
+"""
+
+import re
+import sys
+
+API_MODULES = [
+    "vacancy_api",
+    "application_api",
+    "scoring_api",
+    "report_api",
+    "notification_api",
+    "reference_checks_api",
+    "payment_api",
+    "settings_api",
+]
+
+# Message arms whose real api calls are structurally unreachable in demo mode
+# (auth flows always exit the demo first; ApiReturnedSession is guarded at the
+# top of the handler).
+# Messages whose real arms in update_inner are unreachable in demo mode
+# because demo/demo_update.gleam intercepts them and resolves from the
+# in-memory store. Keep this in sync with the request messages in
+# demo_update.handle — a message listed here must have a demo arm there.
+DEMO_INTERCEPTED = {
+    "AppRequestedDashboardData",
+    "AppRequestedVacancyDetail",
+    "AppRequestedLeaderboard",
+    "UserClickedLoadMoreApplications",
+    "AppRequestedApplicationDetail",
+    "UserChangedApplicationStatus",
+    "UserConfirmedApproval",
+    "UserConfirmedRejection",
+    "UserConfirmedBackwardTransition",
+    "AppRequestedArchivedVacancies",
+    "UserClickedRestoreVacancy",
+    "UserToggledAwaitingSection",
+    "UserClickedSendReminder",
+    "UserClickedRemindApplicant",
+    "UserSubmittedBulkInvite",
+    "AppRequestedComparisonDetails",
+    "UserClickedDownloadReport",
+    "AppRequestedScoringStatus",
+    "UserChoseRefcheckAction",
+    "UserConfirmedRefcheckAction",
+    "UserSavedRefcheckEdit",
+    "AppRequestedNotifications",
+    "UserClickedNotification",
+    "UserClickedMarkAllRead",
+    "UserClickedPublishVacancy",
+    "UserConfirmedCloseVacancy",
+    "UserConfirmedArchiveVacancy",
+    "UserClickedPayCheckout",
+    "UserClickedExtendVacancy",
+    "UserClickedMarkAllRejected",
+    "UserClickedMarkSelectedRejected",
+    "UserSubmittedProfile",
+    "UserSubmittedPasswordChange",
+    "UserChangedNotificationPreference",
+    "UserClickedDeleteAccount",
+    "UserConfirmedAccountDeletion",
+    # Extra messages whose real arms are unreachable in demo (no-op'd or
+    # never produced because the demo never enters the payment flow).
+    "AppRetriedApplicationOpen",
+    "AppRequestedBillingHistory",
+    "UserClickedSettingsSection",
+    "ApiReturnedConsentCheck",
+    "UserConfirmedUnlockConsent",
+    "ApiReturnedExtensionConsentCheck",
+    "UserConfirmedExtensionConsent",
+    "AppPolledPaymentStatus",
+}
+
+# Helpers that branch on demo_mode internally (verified to carry the store).
+DEMO_BRANCHED_HELPERS = {
+    "submit_vacancy",
+    "handle_vacancy_update",
+    "handle_application_opened",
+    "dispatch_status_update",
+    "refetch_refcheck_effect",
+    "fire_refcheck_slot_action",
+    "fire_refcheck_call_action",
+    "save_refcheck_edit",
+}
+
+EXEMPT_ARMS = {
+    # helpers that branch on demo_mode internally
+    # auth_api arms — demo mode is always False here
+    "ApiReturnedLogin",
+    "UserSubmittedLogin",
+    "UserSubmittedSignup",
+    "ApiReturnedSignup",
+    "UserClickedGoogleSignIn",
+    "UserClickedLogout",
+    "ApiReturnedLogout",
+    "UserClickedResendConfirmation",
+    "ApiReturnedResendConfirmation",
+    "UserSubmittedForgot",
+    "ApiReturnedForgot",
+    "UserSubmittedReset",
+    "ApiReturnedReset",
+    "UserAcceptedPolicy",
+    "ApiReturnedAcceptPolicy",
+    # /me handlers — ApiReturnedSession is demo-guarded at the top; the
+    # policy-refresh sibling only fires from the (non-demo) tab-focus
+    # listener, which the demo boot never installs.
+    "ApiReturnedSession",
+    "ApiReturnedPolicyRefresh",
+}
+
+
+def main() -> int:
+    path = "client/src/client.gleam"
+    lines = open(path).read().splitlines()
+    violations = []
+    for idx, line in enumerate(lines):
+        call = api_call_on(line)
+        if call is None:
+            continue
+        # Find the enclosing scope: walk back to the nearest message arm
+        # (4-space indent) OR a top-level function boundary — whichever is
+        # nearer. Helpers (submit_vacancy, handle_*) must be demo-guarded
+        # individually, so stopping at the fn boundary is correct.
+        arm_name = ""
+        for j in range(idx - 1, -1, -1):
+            if re.match(r"^    (User|App|Api|Browser|msg\.)[A-Za-z0-9_]+", lines[j]):
+                arm_name = lines[j].strip().split("(")[0].split(".")[-1]
+                # strip trailing case syntax ("->", "{", "#")
+                arm_name = (
+                    arm_name.split("->")[0].strip().rstrip("{").rstrip("#").strip()
+                )
+                break
+            if re.match(r"^(pub )?fn ", lines[j]):
+                arm_name = "<fn:" + lines[j].strip().split("(")[0].replace("pub fn ", "").replace("fn ", "") + ">"
+                break
+        if arm_name in EXEMPT_ARMS or arm_name in DEMO_INTERCEPTED:
+            continue
+        if arm_name.startswith("<fn:") and arm_name[4:-1] in DEMO_BRANCHED_HELPERS:
+            continue
+        # Check a generous window above the call for a demo_mode guard in the
+        # same scope (the False branch of a demo case can sit 10+ lines below
+        # the guard when the True branch is verbose).
+        window = "\n".join(lines[max(0, idx - 35) : idx])
+        guarded = "model.demo_mode" in window or "updated_model.demo_mode" in window
+        if not guarded:
+            violations.append(f"  client.gleam:{idx + 1}: {line.strip()} (scope: {arm_name})")
+    if violations:
+        print(
+            "::error::unguarded real api calls in client.gleam — reachable from demo "
+            "mode. Demo-branch them (case model.demo_mode { True -> demo store "
+            "False -> real api }) or intercept the message in demo/demo_update.gleam:"
+        )
+        print("\n".join(violations))
+        return 1
+    print("demo no-network lint clean: every real api call is demo-guarded or demo-unreachable.")
+    return 0
+
+
+def api_call_on(line: str):
+    for mod in API_MODULES:
+        m = re.search(r"\b" + mod + r"\.[a-z_]+", line)
+        if m:
+            return m.group(0)
+    return None
+
+
+if __name__ == "__main__":
+    sys.exit(main())
