+
+/// Handle the full navigation-reset + route-triggered-fetch logic for a
+/// URL change. Extracted from the BrowserChangedUrl arm so demo mode can
+/// wrap entry/exit without touching the (large) body. The route-triggered
+/// fetches branch on `model.demo_mode` so an in-demo navigation fetches
+/// demo data (see the `// demo:` markers).
+/// Register a `visibilitychange` listener that silently refreshes /me each
+/// time a background tab comes back to the foreground. Cheap defence against
+/// the multi-tab footgun: if tab A accepts the policy, tab B (which would
+/// otherwise sit on the old modal forever) picks up the new
+/// server_policy_version the moment the landlord switches back to it.
+fn handle_browser_change(
+  model: Model,
+  uri: Uri,
+  route: Route,
+) -> #(Model, Effect(Msg)) {
+  let eff = case route, model.auth {
+    routes.Landing, Success(_)
+    | routes.Login, Success(_)
+    | routes.Signup, Success(_)
+    -> modem.push("/dashboard", None, None)
+    _, _ -> effect.none()
+  }
+  // Scoring ticks carry their creation generation and there's no
+  // clear_timeout, so bumping orphans any in-flight scoring chain on any
+  // navigation. A paid detail re-entry starts a fresh one.
+  let scoring_generation = model.scoring_generation + 1
+  let updated_model =
+    Model(
+      ..model,
+      route:,
+      show_avatar_dropdown: False,
+      show_mobile_menu: False,
+      show_notification_dropdown: False,
+      show_help_menu: False,
+      // Reset landing intro video so returning to the landing page
+      // shows the fresh poster, not a paused <video>.
+      landing_intro_video_playing: False,
+      confirm_action: None,
+      loading_action: None,
+      show_approval_confirm: False,
+      pending_approval: None,
+      show_reject_confirm: False,
+      pending_rejection: None,
+      show_backward_confirm: False,
+      pending_backward_transition: None,
+      // Cancel polling on navigation — timers may still fire but handlers
+      // guard on these being None/0 so they become no-ops
+      payment_polling: None,
+      payment_poll_count: 0,
+      payment_error_count: 0,
+      scoring_generation:,
+      // Reset checkout_loading on every navigation so a dropped Stripe
+      // response (network blip, blocked external navigation) doesn't
+      // leave the CTA stuck on return. The vid stored here is also used
+      // by ApiReturnedCheckoutUrl to suppress redirects from in-flight
+      // calls that started before the user navigated away.
+      checkout_loading: None,
+      // Same lifecycle for the extension SKU's in-flight tracker.
+      extension_checkout_loading: None,
+      // Same reasoning for the refund-policy unlock-consent modal: a
+      // route change while it's open should dismiss it. Submitting
+      // state is also cleared — once the user navigates away, the
+      // imminent-redirect protection no longer applies.
+      unlock_consent_modal_open: None,
+      unlock_consent_checked: False,
+      unlock_consent_submitting: False,
+      // Same for the extension consent modal.
+      extension_consent_modal_open: None,
+      extension_consent_checked: False,
+      extension_consent_submitting: False,
+    )
+  // If the unlock-consent modal was open, the focus trap was installed
+  // on mount but never uninstalled by the dismissal Msg path that this
+  // route change skipped. Tear it down now so keyboard focus isn't
+  // captured on the destination route. Same lifecycle applies to the
+  // extension-consent modal (shares the same focus-trap singleton).
+  let any_consent_modal_open = case
+    model.unlock_consent_modal_open,
+    model.extension_consent_modal_open
+  {
+    None, None -> False
+    _, _ -> True
+  }
+  let eff = case any_consent_modal_open {
+    True ->
+      effect.batch([
+        eff,
+        effect.from(fn(_dispatch) { policy_reaccept_modal_focus.uninstall() }),
+      ])
+    False -> eff
+  }
+  // Reset vacancy form when navigating away from create page
+  let updated_model = case model.route, route {
+    routes.VacancyCreate, r if r != routes.VacancyCreate ->
+      reset_vacancy_form(updated_model)
+    _, _ -> updated_model
+  }
+  // Clear open_dispatched + application_detail_request_id on route
+  // change away from ApplicationDetail. open_dispatched only dedupes
+  // POST /open within a single detail-page lifetime; preserving it
+  // across navigation traps the SPA in stuck-Submitted if the vacancy
+  // was archived between GET and POST and later restored, and lets
+  // the set grow unboundedly across long sessions. The request id is
+  // cleared so the POST /open response handler's stale-route check
+  // can be a single equality (request_id == aid) regardless of the
+  // detail-page RemoteData phase — Loading is still a valid
+  // continuation, but a missing request_id unambiguously means the
+  // detail page is gone.
+  let updated_model = case model.route, route {
+    routes.ApplicationDetail(_, _), r ->
+      case r {
+        routes.ApplicationDetail(_, _) -> updated_model
+        _ ->
+          Model(
+            ..updated_model,
+            open_dispatched: set.new(),
+            application_detail_request_id: None,
+          )
+      }
+    _, _ -> updated_model
+  }
+  // Trigger dashboard data fetch when navigating to dashboard
+  let eff = case route, updated_model.vacancies {
+    routes.Dashboard, NotAsked ->
+      effect.batch([
+        eff,
+        // demo: the demo store resolves the dashboard locally.
+        case updated_model.demo_mode {
+          True ->
+            demo_api.list_vacancies(
+              demo_store_of(updated_model),
+              ApiReturnedDashboardData,
+            )
+          False -> vacancy_api.list_vacancies(ApiReturnedDashboardData)
+        },
+      ])
+    _, _ -> eff
+  }
+  let updated_model = case route, updated_model.vacancies {
+    routes.Dashboard, NotAsked ->
+      Model(..updated_model, vacancies: Loading, dashboard_stats: Loading)
+    _, _ -> updated_model
+  }
+  // Trigger vacancy detail + leaderboard fetch when navigating to detail or handoff
+  let #(updated_model, eff) = case route {
+    routes.VacancyDetail(id) | routes.VacancyHandoff(id) -> #(
+      Model(
+        ..updated_model,
+        vacancy_detail: Loading,
+        vacancy_detail_request_id: Some(id),
+        leaderboard: Loading,
+        leaderboard_total: 0,
+        leaderboard_strong_count: 0,
+        leaderboard_review_count: 0,
+        leaderboard_weak_count: 0,
+        leaderboard_shortlisted_count: 0,
+        leaderboard_page: 1,
+        leaderboard_loading_more: False,
+        clipboard_copied: None,
+        bulk_invite_emails: "",
+        awaiting_expanded: False,
+        awaiting_list: NotAsked,
+        awaiting_visible_count: model.awaiting_page_size,
+        reminding_applicant_email: None,
+        scoring_status: None,
+        scoring_poll_count: 0,
+        scoring_poll_vacancy_id: "",
+        // Fresh chain, fresh retry budget — a chain orphaned mid-retry
+        // must not hand its spent error count to the next one.
+        scoring_error_count: 0,
+      ),
+      effect.batch([
+        eff,
+        // demo: resolve detail + leaderboard from the store.
+        case updated_model.demo_mode {
+          True ->
+            demo_api.get_detail(
+              demo_store_of(updated_model),
+              id,
+              ApiReturnedVacancyDetail,
+            )
+          False -> vacancy_api.get_detail(id, ApiReturnedVacancyDetail)
+        },
+        case updated_model.demo_mode {
+          True ->
+            demo_api.fetch_leaderboard(
+              demo_store_of(updated_model),
+              id,
+              ApiReturnedLeaderboard,
+            )
+          False -> application_api.fetch_leaderboard(id, ApiReturnedLeaderboard)
+        },
+      ]),
+    )
+    routes.VacancyEdit(id) ->
+      // Only initialise edit state on a *fresh* entry into the edit route.
+      // When `BrowserChangedUrl` fires while we are already on
+      // `VacancyEdit(id)` (e.g. the unsaved-changes guard below replaces
+      // the URL back to /edit), this block must be a pure no-op so it
+      // doesn't wipe `vacancy_edit_has_unsaved_changes`,
+      // `show_unsaved_changes_prompt`, or re-fetch and clobber dirty form
+      // fields.
+      case model.route {
+        routes.VacancyEdit(old_id) if old_id == id -> #(updated_model, eff)
+        _ -> #(
+          Model(
+            ..updated_model,
+            vacancy_edit_loading: True,
+            vacancy_edit_id: id,
+            vacancy_edit_server_error: "",
+            vacancy_edit_saving: False,
+            vacancy_edit_status: "",
+            show_edit_warning_modal: False,
+            vacancy_edit_has_unsaved_changes: False,
+            show_unsaved_changes_prompt: False,
+            unsaved_changes_destination: None,
+          ),
+          effect.batch([
+            eff,
+            // demo: resolve the edit payload from the store.
+            case updated_model.demo_mode {
+              True ->
+                demo_api.get_for_edit(
+                  demo_store_of(updated_model),
+                  id,
+                  ApiReturnedVacancyForEdit,
+                )
+              False -> vacancy_api.get_for_edit(id, ApiReturnedVacancyForEdit)
+            },
+          ]),
+        )
+      }
+    _ -> #(updated_model, eff)
+  }
+  // Trigger application detail fetch when navigating to detail page
+  let #(updated_model, eff) = case route {
+    routes.ApplicationDetail(vid, aid) -> #(
+      Model(
+        ..updated_model,
+        application_detail: Loading,
+        application_detail_request_id: Some(aid),
+        show_approval_confirm: False,
+        pending_approval: None,
+        show_reject_confirm: False,
+        pending_rejection: None,
+        show_backward_confirm: False,
+        pending_backward_transition: None,
+        stepper_focused_index: 0,
+        documents_expanded: False,
+        viewing_popover_open: False,
+        // Reference panel (RC4.2): collapsed rows don't leak across
+        // applicants. `refcheck_auto_expanded` deliberately survives —
+        // "collapsed on return" (UX §7.4) means a completed summary
+        // expands only on the first view of an applicant.
+        refcheck_expanded: set.new(),
+        refcheck_explainer_open: False,
+        // Reference panel (RC4.3) row-action state: the overflow menu,
+        // inline confirms, and edit-trios are per-application surfaces —
+        // reset on route change so nothing leaks across applicants (r1
+        // W9: a pending edit carries the landlord's typed referee PII).
+        refcheck_menu_open: None,
+        refcheck_confirm: None,
+        refcheck_edit: dict.new(),
+        refcheck_action_inflight: set.new(),
+        // Drop any in-flight report download — late responses are
+        // dropped via the id-mismatch guard in ApiReturnedReportPdf, but
+        // clearing the flag here keeps the spinner from following the
+        // landlord onto the next applicant.
+        report_download_loading: None,
+        show_all_audit: False,
+        // Collapse any previously expanded insight so state doesn't leak
+        // across applicants when the landlord clicks from one detail
+        // page to another on the same vacancy.
+        insight_expanded: False,
+      ),
+      effect.batch([
+        eff,
+        // demo: resolve the detail from the store.
+        case updated_model.demo_mode {
+          True ->
+            demo_api.fetch_application_detail(
+              demo_store_of(updated_model),
+              vid,
+              aid,
+              ApiReturnedApplicationDetail,
+            )
+          False ->
+            application_api.fetch_application_detail(
+              vid,
+              aid,
+              ApiReturnedApplicationDetail,
+            )
+        },
+      ]),
+    )
+    _ -> #(updated_model, eff)
+  }
+  // Trigger archived vacancies fetch
+  let #(updated_model, eff) = case route {
+    routes.ArchivedVacancies -> #(
+      Model(..updated_model, archived_vacancies: Loading),
+      effect.batch([
+        eff,
+        // demo: resolve the archived list from the store.
+        case updated_model.demo_mode {
+          True ->
+            demo_api.fetch_archived(
+              demo_store_of(updated_model),
+              ApiReturnedArchivedVacancies,
+            )
+          False -> vacancy_api.fetch_archived(ApiReturnedArchivedVacancies)
+        },
+      ]),
+    )
+    _ -> #(updated_model, eff)
+  }
+  // Reset signup confirmation state when navigating away from signup
+  let updated_model = case route {
+    routes.Signup -> updated_model
+    _ -> Model(..updated_model, signup_needs_confirmation: False)
+  }
+  // Reset the resend-confirmation UI when leaving the screens that host it:
+  // the login 403 flag lives only on /login; the "Sent" state lives on both
+  // /login and /signup (the signup confirmation screen).
+  let updated_model = case route {
+    routes.Login -> updated_model
+    _ -> Model(..updated_model, login_email_not_confirmed: False)
+  }
+  let updated_model = case route {
+    routes.Login | routes.Signup -> updated_model
+    _ -> Model(..updated_model, resend_confirmation_sent: False)
+  }
+  // Reset vacancy form when navigating away from handoff page
+  let updated_model = case model.route, route {
+    routes.VacancyHandoff(_), r ->
+      case r {
+        routes.VacancyHandoff(_) -> updated_model
+        _ -> reset_vacancy_form(updated_model)
+      }
+    _, _ -> updated_model
+  }
+  // Unsaved changes guard: intercept navigation away from edit page
+  let #(updated_model, eff) = case model.route, route {
+    routes.VacancyEdit(edit_id), r ->
+      case r {
+        routes.VacancyEdit(_) -> #(updated_model, eff)
+        _ ->
+          case model.vacancy_edit_has_unsaved_changes {
+            True -> #(
+              Model(
+                ..updated_model,
+                route: model.route,
+                show_unsaved_changes_prompt: True,
+                unsaved_changes_destination: Some(r),
+              ),
+              modem.replace("/vacancies/" <> edit_id <> "/edit", None, None),
+            )
+            False -> #(
+              reset_vacancy_edit(reset_vacancy_form(updated_model)),
+              eff,
+            )
+          }
+      }
+    _, _ -> #(updated_model, eff)
+  }
+  // Reset comparison_ids when vacancy changes
+  let updated_model = case get_vacancy_id(model.route), get_vacancy_id(route) {
+    Some(old_vid), Some(new_vid) if old_vid != new_vid -> {
+      save_comparison_ids([])
+      Model(..updated_model, comparison_ids: [], comparison_details: NotAsked)
+    }
+    None, _ -> updated_model
+    _, None -> {
+      save_comparison_ids([])
+      Model(..updated_model, comparison_ids: [], comparison_details: NotAsked)
+    }
+    _, _ -> updated_model
+  }
+  // Reset comparison_details when leaving comparison page; fetch when entering
+  let #(updated_model, eff) = case route {
+    routes.Comparison(vid) ->
+      case updated_model.comparison_ids {
+        [] -> #(updated_model, eff)
+        ids -> #(
+          Model(..updated_model, comparison_details: Loading),
+          effect.batch([
+            eff,
+            // demo: resolve comparison details from the store.
+            case updated_model.demo_mode {
+              True ->
+                demo_api.fetch_comparison(
+                  demo_store_of(updated_model),
+                  vid,
+                  ids,
+                  ApiReturnedComparisonDetails,
+                )
+              False ->
+                application_api.fetch_comparison(
+                  vid,
+                  ids,
+                  ApiReturnedComparisonDetails,
+                )
+            },
+          ]),
+        )
+      }
+    _ -> #(
+      Model(
+        ..updated_model,
+        comparison_details: NotAsked,
+        // Expanded-insight state is scoped to a single compare viewing
+        // session — clear it as soon as the landlord navigates away.
+        expanded_insights: set.new(),
+      ),
+      eff,
+    )
+  }
+  // Derive `leaderboard_select_mode` from the `?mode=select` query param
+  // on the VacancyDetail route, and clear it (plus selected set) on every
+  // other route. Any VacancyDetail route change resets the selection so
+  // ids from vacancy A can't bleed into vacancy B's action bar even when
+  // both URLs carry `?mode=select`.
+  let updated_model = case route {
+    routes.VacancyDetail(_) -> {
+      let new_mode = case uri.query {
+        Some(qs) ->
+          case gleam_uri.parse_query(qs) {
+            Ok(params) ->
+              case list.find(params, fn(p) { p.0 == "mode" }) {
+                Ok(#(_, "select")) -> True
+                _ -> False
+              }
+            Error(_) -> False
+          }
+        None -> False
+      }
+      Model(
+        ..updated_model,
+        leaderboard_select_mode: new_mode,
+        selected_for_rejection: set.new(),
+      )
+    }
+    _ ->
+      Model(
+        ..updated_model,
+        leaderboard_select_mode: False,
+        selected_for_rejection: set.new(),
+      )
+  }
+  // Detect ?payment=success on vacancy detail page — show toast and start polling
+  let #(updated_model, eff) = case route {
+    routes.VacancyDetail(vid) ->
+      case uri.query {
+        Some(query_string) ->
+          case gleam_uri.parse_query(query_string) {
+            Ok(params) ->
+              case list.find(params, fn(p) { p.0 == "payment" }) {
+                // demo: no Stripe flow ever ran, so a crafted ?payment=success
+                // URL must not start polling or fire the pixel.
+                Ok(#(_, "success")) if updated_model.demo_mode -> #(
+                  updated_model,
+                  modem.replace(route_to_path(route), None, None),
+                )
+                Ok(#(_, "success")) -> {
+                  let toast_model_eff =
+                    add_toast(
+                      updated_model,
+                      "Vacancy unlocked. AI analysis is starting, and results typically arrive within a few minutes.",
+                      ToastSuccess,
+                    )
+                  // Replace URL to remove query param
+                  let replace_eff =
+                    modem.replace(route_to_path(route), None, None)
+                  // Start payment status polling
+                  let poll_eff = schedule_payment_poll(vid)
+                  // Fire browser-side Pixel Purchase via the verify
+                  // endpoint. session_id arrives in the URL as
+                  // {CHECKOUT_SESSION_ID} substituted by Stripe.
+                  // Verify ownership + consent server-side; SPA
+                  // fires fbq with matching event_id for CAPI dedup.
+                  let session_id = case
+                    list.find(params, fn(p) { p.0 == "session_id" })
+                  {
+                    Ok(#(_, v)) -> v
+                    Error(_) -> ""
+                  }
+                  let pixel_eff =
+                    payment_api.fire_pixel_purchase_for_session(
+                      session_id,
+                      msg.AppNoOp,
+                    )
+                  #(
+                    Model(
+                      ..toast_model_eff.0,
+                      payment_polling: Some(vid),
+                      payment_poll_count: 0,
+                    ),
+                    effect.batch([
+                      eff,
+                      toast_model_eff.1,
+                      replace_eff,
+                      poll_eff,
+                      pixel_eff,
+                    ]),
+                  )
+                }
+                _ -> #(updated_model, eff)
+              }
+            Error(_) -> #(updated_model, eff)
+          }
+        _ -> #(updated_model, eff)
+      }
+    _ -> #(updated_model, eff)
+  }
+  // Detect ?extended=success on vacancy detail page — toast + refetch so
+  // the new closes_at / status show without polling. The extension webhook
+  // commits closes_at atomically, so a single refetch after Stripe redirect
+  // is enough (no polling required, unlike unlock which waits for
+  // burst-scoring to start).
+  let #(updated_model, eff) = case route {
+    routes.VacancyDetail(vid) ->
+      case uri.query {
+        Some(query_string) ->
+          case gleam_uri.parse_query(query_string) {
+            Ok(params) ->
+              case list.find(params, fn(p) { p.0 == "extended" }) {
+                // demo: no Stripe flow ever ran — drop the crafted param.
+                Ok(#(_, "success")) if updated_model.demo_mode -> #(
+                  updated_model,
+                  modem.replace(route_to_path(route), None, None),
+                )
+                Ok(#(_, "success")) -> {
+                  let toast_result =
+                    add_toast(
+                      updated_model,
+                      "Vacancy extended. You've got another 14 days.",
+                      ToastSuccess,
+                    )
+                  let replace_eff =
+                    modem.replace(route_to_path(route), None, None)
+                  let refetch_eff =
+                    vacancy_api.get_detail(vid, msg.ApiReturnedVacancyDetail)
+                  // Browser-side Pixel Purchase fire — same path
+                  // as the unlock branch above. Extension is a
+                  // distinct Stripe session_id so dedup still
+                  // works correctly against the webhook-side CAPI
+                  // Purchase event.
+                  let ext_session_id = case
+                    list.find(params, fn(p) { p.0 == "session_id" })
+                  {
+                    Ok(#(_, v)) -> v
+                    Error(_) -> ""
+                  }
+                  let ext_pixel_eff =
+                    payment_api.fire_pixel_purchase_for_session(
+                      ext_session_id,
+                      msg.AppNoOp,
+                    )
+                  #(
+                    toast_result.0,
+                    effect.batch([
+                      eff,
+                      toast_result.1,
+                      replace_eff,
+                      refetch_eff,
+                      ext_pixel_eff,
+                    ]),
+                  )
+                }
+                _ -> #(updated_model, eff)
+              }
+            Error(_) -> #(updated_model, eff)
+          }
+        _ -> #(updated_model, eff)
+      }
+    _ -> #(updated_model, eff)
+  }
+  // Detect ?verified=true, ?reset=success, or ?error=... on login page
+  // (email confirmation / password reset redirect). Toast + modem.replace
+  // strips the query param so reload/back doesn't re-show the message.
+  let #(updated_model, eff) = case route {
+    routes.Login ->
+      case uri.query {
+        Some(query_string) ->
+          case gleam_uri.parse_query(query_string) {
+            Ok(params) ->
+              case list.find(params, fn(p) { p.0 == "verified" }) {
+                Ok(#(_, "true")) -> {
+                  let toast_result =
+                    add_toast(
+                      updated_model,
+                      "Email verified. You can now log in.",
+                      ToastSuccess,
+                    )
+                  let replace_eff = modem.replace("/login", None, None)
+                  #(
+                    toast_result.0,
+                    effect.batch([eff, toast_result.1, replace_eff]),
+                  )
+                }
+                _ ->
+                  case list.find(params, fn(p) { p.0 == "reset" }) {
+                    Ok(#(_, "success")) -> {
+                      let toast_result =
+                        add_toast(
+                          updated_model,
+                          "Your password's been updated. Sign in with your new one.",
+                          ToastSuccess,
+                        )
+                      let replace_eff = modem.replace("/login", None, None)
+                      #(
+                        toast_result.0,
+                        effect.batch([eff, toast_result.1, replace_eff]),
+                      )
+                    }
+                    _ ->
+                      case list.find(params, fn(p) { p.0 == "error" }) {
+                        Ok(_) -> {
+                          let toast_result =
+                            add_toast(
+                              updated_model,
+                              "Email verification didn't work: the link may have expired. Try signing up again.",
+                              ToastError,
+                            )
+                          let replace_eff = modem.replace("/login", None, None)
+                          #(
+                            toast_result.0,
+                            effect.batch([
+                              eff,
+                              toast_result.1,
+                              replace_eff,
+                            ]),
+                          )
+                        }
+                        _ -> #(updated_model, eff)
+                      }
+                  }
+              }
+            Error(_) -> #(updated_model, eff)
+          }
+        _ -> #(updated_model, eff)
+      }
+    routes.ForgotPassword ->
+      // ?error=expired arrives after handle_email_confirm fails to verify
+      // a recovery token (expired / already used). Surface a toast so the
+      // landlord understands why they landed here after clicking the
+      // email link.
+      case uri.query {
+        Some(query_string) ->
+          case gleam_uri.parse_query(query_string) {
+            Ok(params) ->
+              case list.find(params, fn(p) { p.0 == "error" }) {
+                Ok(_) -> {
+                  let toast_result =
+                    add_toast(
+                      updated_model,
+                      "That reset link has already been used or expired. Request a new one.",
+                      ToastError,
+                    )
+                  let replace_eff =
+                    modem.replace("/forgot-password", None, None)
+                  #(
+                    toast_result.0,
+                    effect.batch([eff, toast_result.1, replace_eff]),
+                  )
+                }
+                _ -> #(updated_model, eff)
+              }
+            Error(_) -> #(updated_model, eff)
+          }
+        _ -> #(updated_model, eff)
+      }
+    _ -> #(updated_model, eff)
+  }
+  // Initialize profile form when navigating to Settings
+  let updated_model = case route {
+    routes.Settings -> init_profile_form(updated_model)
+    _ -> updated_model
+  }
+  // Billing route → show Settings with Billing section active
+  let #(updated_model, eff) = case route {
+    routes.Billing -> #(
+      Model(
+        ..init_profile_form(updated_model),
+        settings_section: model.BillingSection,
+        billing_loading: True,
+      ),
+      effect.batch([
+        eff,
+        // demo: billing is view-blocked — never fetch it.
