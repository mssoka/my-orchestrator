+//// Demo-mode update dispatcher — the single interception point for demo
+//// messages.
+////
+//// `update/2` routes here whenever `model.demo_mode` is True. This module
+//// handles the demo-relevant REQUEST messages (fetches + mutations) by
+//// resolving from the in-memory store and dispatching the SAME response
+//// `msg` constructors the real handlers consume — so `update_inner`'s
+//// response arms render the mock with zero duplication. Everything else
+//// (response messages, UI toggles, form inputs, modals) falls through to
+//// the `fallback` (client.gleam's `update_inner`), which is also where the
+//// handful of response-side refetch side-effects carry their own tiny
+//// demo branches (marked `// demo:` in client.gleam).
+////
+//// No network: every effect here comes from `demo/demo_api.gleam`, which
+//// dispatches synchronously — the CI grep lint bans network imports from
+//// `demo/`.
+
+import components/sweep_nudge_banner
+import copy
+import demo/demo_analytics
+import demo/demo_api
+import demo/demo_store.{type DemoStore}
+import gleam/dict
+import gleam/list
+import gleam/option.{None, Some}
+import gleam/set
+import lustre/effect.{type Effect}
+import model.{
+  type Model, LoadingArchive, LoadingBulkInvite, LoadingClose, LoadingPublish,
+  LoadingReminder, LoadingStatusUpdate, Model, RefcheckConfirmStart,
+  RefcheckConfirmTakeOver, RefcheckEditCorrect, RefcheckEditSubstitute,
+  RefcheckReEnable, RefcheckSkip,
+}
+import modem
+import msg.{
+  type Msg, ApiReturnedApplicantReminder, ApiReturnedApplicationDetail,
+  ApiReturnedArchiveVacancy, ApiReturnedArchivedVacancies, ApiReturnedAwaiting,
+  ApiReturnedBulkInvite, ApiReturnedCloseVacancy, ApiReturnedComparisonDetails,
+  ApiReturnedDashboardData, ApiReturnedLeaderboard, ApiReturnedLeaderboardPage,
+  ApiReturnedMarkAllRead, ApiReturnedMarkRead, ApiReturnedNotifications,
+  ApiReturnedRefcheckAction, ApiReturnedReminder, ApiReturnedRestoreVacancy,
+  ApiReturnedScoringStatus, ApiReturnedStatusUpdate, ApiReturnedVacancyDetail,
+  AppPolledData, AppPolledPaymentStatus, AppRequestedApplicationDetail,
+  AppRequestedArchivedVacancies, AppRequestedBillingHistory,
+  AppRequestedComparisonDetails, AppRequestedDashboardData,
+  AppRequestedLeaderboard, AppRequestedNotifications, AppRequestedScoringStatus,
+  AppRequestedSessionRefresh, AppRequestedVacancyDetail,
+  AppRetriedApplicationOpen, UserCancelledExtensionConsent,
+  UserCancelledUnlockConsent, UserChangedApplicationStatus,
+  UserChangedNotificationPreference, UserChoseRefcheckAction,
+  UserClickedCreateVacancy, UserClickedDeleteAccount, UserClickedDemoCta,
+  UserClickedDownloadReport, UserClickedExtendVacancy,
+  UserClickedLoadMoreApplications, UserClickedLogout, UserClickedMarkAllRead,
+  UserClickedMarkAllRejected, UserClickedMarkSelectedRejected,
+  UserClickedNotification, UserClickedPayCheckout, UserClickedPublishVacancy,
+  UserClickedRemindApplicant, UserClickedResetDemo, UserClickedRestoreVacancy,
+  UserClickedSendReminder, UserClickedSettingsSection, UserClosedDeleteModal,
+  UserConfirmedAccountDeletion, UserConfirmedApproval,
+  UserConfirmedArchiveVacancy, UserConfirmedBackwardTransition,
+  UserConfirmedCloseVacancy, UserConfirmedExtensionConsent,
+  UserConfirmedRefcheckAction, UserConfirmedRejection,
+  UserConfirmedUnlockConsent, UserSavedRefcheckEdit, UserSubmittedBulkInvite,
+  UserSubmittedPasswordChange, UserSubmittedProfile, UserToggledAwaitingSection,
+  UserToggledExtensionConsent, UserToggledUnlockConsent,
+}
+import plinth/javascript/global
+import shared/remote_data.{Loading, NotAsked, Success}
+import shared/routes
+
+/// The demo dispatcher. `fallback` is client.gleam's `update_inner`.
+pub fn handle(
+  model model: Model,
+  msg msg: Msg,
+  fallback fallback: fn(Model, Msg) -> #(Model, Effect(Msg)),
+) -> #(Model, Effect(Msg)) {
+  case msg {
+    // -- Payments are not part of the demo --------------------------------------
+    // The "why pay" unlock/extend surfaces are real Stripe flows — clicking
+    // them in demo must never reach payment_api (no Stripe invocation from
+    // demo mode). Surfaced as a brand-voice info toast; the banner CTA is the
+    // conversion path.
+    UserClickedPayCheckout(_vid) | UserClickedExtendVacancy(_vid) ->
+      demo_not_in_demo_toast(model, copy.demo_payments_toast)
+    UserConfirmedUnlockConsent(_)
+    | UserConfirmedExtensionConsent(_)
+    | UserToggledUnlockConsent(_)
+    | UserToggledExtensionConsent(_)
+    | UserCancelledUnlockConsent
+    | UserCancelledExtensionConsent
+    | AppPolledPaymentStatus(_) -> #(model, effect.none())
+
+    // -- Settings are not part of the demo --------------------------------------
+    // /settings is blocked at the view (a demo notice renders instead), and
+    // these write messages are intercepted as defense-in-depth — a stray
+    // dispatch can never fire a real settings_api write (profile, password,
+    // preferences, ACCOUNT DELETION) with the demo's bogus CSRF token.
+    UserSubmittedProfile ->
+      demo_not_in_demo_toast(model, copy.demo_settings_profile_toast)
+    UserSubmittedPasswordChange ->
+      demo_not_in_demo_toast(model, copy.demo_settings_password_toast)
+    UserChangedNotificationPreference(_) ->
+      demo_not_in_demo_toast(model, copy.demo_settings_prefs_toast)
+    UserClickedDeleteAccount | UserConfirmedAccountDeletion ->
+      demo_not_in_demo_toast(model, copy.demo_settings_delete_toast)
+    AppRequestedBillingHistory | UserClickedSettingsSection(_) -> #(
+      model,
+      effect.none(),
+    )
+
+    UserClosedDeleteModal -> #(
+      Model(
+        ..model,
+        delete_modal_open: False,
+        delete_confirm_email: "",
+        delete_in_progress: False,
+      ),
+      effect.none(),
+    )
+
+    // -- Bulk reject (sweep nudge / select mode) --------------------------------
+    UserClickedMarkAllRejected(vid) ->
+      case model.application_detail {
+        Success(detail) -> {
+          let ids =
+            sweep_nudge_banner.open_ids(detail.application, model.leaderboard)
+          case ids {
+            [] -> #(model, effect.none())
+            _ -> {
+              let store = store_of(model)
+              let #(next, eff) =
+                demo_api.bulk_reject_applications(
+                  store,
+                  vid,
+                  ids,
+                  "sweep_nudge",
+                  "",
+                  msg.ApiReturnedBulkReject,
+                )
+              #(
+                Model(
+                  ..model,
+                  demo_store: Some(next),
+                  bulk_reject_loading: True,
+                ),
+                eff,
+              )
+            }
+          }
+        }
+        _ -> #(model, effect.none())
+      }
+    UserClickedMarkSelectedRejected(vid) -> {
+      let ids = set.to_list(model.selected_for_rejection)
+      case ids {
+        [] -> #(model, effect.none())
+        _ -> {
+          let store = store_of(model)
