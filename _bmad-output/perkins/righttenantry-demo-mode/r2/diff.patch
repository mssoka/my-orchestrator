diff --git a/.github/workflows/test.yml b/.github/workflows/test.yml
index c99312af..84ac0ad8 100644
--- a/.github/workflows/test.yml
+++ b/.github/workflows/test.yml
@@ -127,6 +127,29 @@ jobs:
           fi
           echo "All outbound HTTP calls use explicit timeouts."
 
+      - name: Lint — demo mode issues no network calls (issue #628, Option B)
+        run: |
+          # 1. demo/ modules: ban the API-client layer entirely, and ban the
+          #    fetch transport outside the one documented static-PDF fetch in
+          #    demo_api.download. rsvp is allowed ONLY for the pure
+          #    parse_relative_uri helper (relative URL resolution, no I/O).
+          VIOLATIONS=$(grep -rn "api_helpers" client/src/demo/ --include="*.gleam" || true)
+          RSVP_VERBS=$(grep -rnE "rsvp\\.(send|get|post|put|patch|delete)" client/src/demo/ --include="*.gleam" || true)
+          FETCH_VIOLATIONS=$(grep -rln "gleam/fetch" client/src/demo/ --include="*.gleam" | grep -v "demo_api.gleam" || true)
+          if [ -n "$VIOLATIONS" ] || [ -n "$RSVP_VERBS" ] || [ -n "$FETCH_VIOLATIONS" ]; then
+            echo "::error::demo/ modules must not touch the network — the demo resolves from the in-memory store. The only permitted touch is the pre-baked static PDF fetch in demo_api.download:"
+            echo "$VIOLATIONS"
+            echo "$RSVP_VERBS"
+            echo "$FETCH_VIOLATIONS"
+            exit 1
+          fi
+          # 2. client.gleam fall-through class: every real api-module call on
+          #    the landlord surfaces must sit inside a demo_mode-guarded
+          #    branch, or the demo (or a crafted demo URL) fires a real
+          #    request. lint_demo_network.py enforces that structurally.
+          python3 scripts/lint_demo_network.py
+          echo "Demo mode is fully client-side: no API/network imports in demo/, no unguarded api calls in client.gleam."
+
       - name: Lint — RT-wide em-dash ban in user-facing source (#607 item 4)
         run: |
           python3 scripts/lint_em_dash.py
