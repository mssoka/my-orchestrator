+    monthly_rent_cents: p.monthly_rent_cents,
+    overall_score: p.overall_score,
+    risk_level: p.risk_level,
+    category_scores: Some(p.category_scores),
+    flags: Some(p.flags),
+    positives: Some(p.positives),
+    insight: Some(p.insight),
+    ai_disclaimer: Some(
+      "This assessment is generated by AI and provided to assist your decision. It is not a substitute for your own checks or for legal advice. RightTenantry never uses the ten grounds in the Equal Status Acts as criteria.",
+    ),
+    schema_version: "v4",
+    extras: Some("{}"),
+    snapshot: ApplicationSnapshot(
+      application: p.row,
+      co_applicants: [],
+      income_sources: [],
+      documents: [],
+    ),
+  )
+}
