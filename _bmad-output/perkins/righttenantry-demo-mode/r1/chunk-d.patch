diff --git a/.github/workflows/test.yml b/.github/workflows/test.yml
index c99312af..7fc2b756 100644
--- a/.github/workflows/test.yml
+++ b/.github/workflows/test.yml
@@ -127,6 +127,21 @@ jobs:
           fi
           echo "All outbound HTTP calls use explicit timeouts."
 
+      - name: Lint — demo mode issues no network calls (issue #628, Option B)
+        run: |
+          VIOLATIONS=$(grep -rn "rsvp\|api_helpers" client/src/demo/ --include="*.gleam" || true)
+          # The one permitted network touch is the pre-baked static PDF fetch
+          # in demo_api.download (gleam/fetch on /static/demo/*.pdf) — every
+          # OTHER demo module must stay import-free of the network layer.
+          FETCH_VIOLATIONS=$(grep -rln "gleam/fetch" client/src/demo/ --include="*.gleam" | grep -v "demo_api.gleam" || true)
+          if [ -n "$VIOLATIONS" ] || [ -n "$FETCH_VIOLATIONS" ]; then
+            echo "::error::demo/ modules must not import the API/network layer — the demo resolves from the in-memory store. The only permitted network touch is the pre-baked static PDF fetch in demo_api.download:"
+            echo "$VIOLATIONS"
+            echo "$FETCH_VIOLATIONS"
+            exit 1
+          fi
+          echo "Demo mode is fully client-side: no API/network imports in demo/."
+
       - name: Lint — RT-wide em-dash ban in user-facing source (#607 item 4)
         run: |
           python3 scripts/lint_em_dash.py
