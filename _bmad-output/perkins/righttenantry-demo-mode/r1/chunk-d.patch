+  let base =
+    base_row(
+      id,
+      first_name,
+      last_name,
+      string.lowercase(first_name)
+        <> "."
+        <> string.lowercase(last_name)
+        <> "@example.ie",
+      "employed",
+      income,
+      household,
+      status,
+      created_at,
+    )
+  GetApplicationDetailRow(
+    ..base,
+    job_title: Some(job_title),
+    employer_name: Some(employer),
+    num_occupants: Some(1),
+    desired_move_in_date: Some("2026-09-01"),
+    listing_source: Some("Daft"),
+  )
+}
