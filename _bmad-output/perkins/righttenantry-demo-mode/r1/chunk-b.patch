+/// Result type used by the store's seed — a decode failure anywhere is a
+/// hard error (the drift guard), never a silent empty demo.
+pub type SeedError {
+  SeedError(message: String)
+}
+
+pub fn seed_error_from_result(
+  result: Result(a, json.DecodeError),
+) -> Result(a, SeedError) {
+  case result {
+    Ok(value) -> Ok(value)
+    Error(_) -> Error(SeedError("demo fixture decode failed"))
+  }
+}
+
+pub fn result_to_seed_error(result: Result(a, String)) -> Result(a, SeedError) {
+  case result {
+    Ok(value) -> Ok(value)
+    Error(message) -> Error(SeedError(message))
+  }
+}
