+}
+
+pub fn correct_reference(
+  store: DemoStore,
+  vacancy_id: String,
+  application_id: String,
+  call_id: String,
+  _name: String,
+  _email: String,
+  _phone: String,
+  _csrf_token: String,
+  on_response: fn(Result(String, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
