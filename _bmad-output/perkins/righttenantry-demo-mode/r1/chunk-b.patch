+
+pub fn substitute_reference(
+  store: DemoStore,
+  vacancy_id: String,
+  application_id: String,
+  call_id: String,
+  name: String,
+  email: String,
+  phone: String,
+  _csrf_token: String,
+  on_response: fn(Result(String, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
