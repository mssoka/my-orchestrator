+fn change_status(
+  store: DemoStore,
+  vacancy_id: String,
+  application_id: String,
+  slug: String,
+  event_type: String,
+) -> #(DemoStore, Result(String, Nil)) {
+  let target = status_from_slug(slug)
+  let updated =
+    list.map(store.vacancies, fn(v) {
+      case v.vacancy.id == vacancy_id {
+        False -> v
+        True ->
+          DemoVacancy(
+            ..v,
+            applications: list.map(v.applications, fn(app) {
+              case app.application.id == application_id {
+                False -> app
+                True ->
+                  DemoApplication(
+                    ..app,
+                    application: Application(..app.application, status: target),
+                    audit_trail: list.append(app.audit_trail, [
+                      AuditEntry(
+                        event_type:,
+                        details: Some(
+                          "{\"to\":\"" <> slug <> "\",\"trigger\":\"manual\"}",
+                        ),
+                        created_at: "2026-08-19T00:00:00Z",
+                      ),
+                    ]),
+                  )
+              }
+            }),
+          )
+      }
+    })
+  #(DemoStore(..store, vacancies: updated), Ok(slug))
+}
+
+pub fn bulk_reject(
+  store: DemoStore,
+  vacancy_id: String,
+  ids: List(String),
+) -> #(DemoStore, Int) {
+  let id_set = set.from_list(ids)
+  let updated =
+    list.map(store.vacancies, fn(v) {
+      case v.vacancy.id == vacancy_id {
+        False -> v
+        True ->
+          DemoVacancy(
+            ..v,
+            applications: list.map(v.applications, fn(app) {
+              case set.contains(id_set, app.application.id) {
+                False -> app
+                True ->
+                  DemoApplication(
+                    ..app,
+                    application: Application(
+                      ..app.application,
+                      status: Rejected,
+                    ),
+                    audit_trail: list.append(app.audit_trail, [
+                      AuditEntry(
+                        event_type: "status_bulk_rejected",
+                        details: Some("{\"trigger\":\"leaderboard_select\"}"),
+                        created_at: "2026-08-19T00:00:00Z",
+                      ),
+                    ]),
+                  )
+              }
+            }),
+          )
+      }
+    })
+  let rejected = case find_vacancy(store, vacancy_id) {
+    Ok(v) ->
+      list.length(
+        list.filter(v.applications, fn(a) {
+          set.contains(id_set, a.application.id)
+        }),
+      )
+    Error(_) -> 0
+  }
+  #(DemoStore(..store, vacancies: updated), rejected)
+}
+
+pub fn remind_applicant(
+  store: DemoStore,
+  _vacancy_id: String,
+) -> #(DemoStore, #(Int, Int)) {
+  #(store, #(1, 0))
+}
+
+pub fn send_reminder(
+  store: DemoStore,
+  _vacancy_id: String,
+) -> #(DemoStore, #(Int, Int)) {
+  #(store, #(2, 1))
+}
+
+pub fn send_bulk_invite(
+  store: DemoStore,
+  _vacancy_id: String,
+) -> #(DemoStore, BulkInviteResult) {
+  #(
+    store,
+    BulkInviteResult(
+      sent: 2,
+      invalid: 1,
+      invalid_emails: ["bad@example.ie"],
+      trimmed: 0,
+    ),
+  )
+}
+
+pub fn refcheck_action(
+  store: DemoStore,
+  vacancy_id: String,
+  application_id: String,
+  call_id: String,
+  action: String,
+) -> #(DemoStore, Result(String, Nil)) {
+  let updated =
+    list.map(store.vacancies, fn(v) {
+      case v.vacancy.id == vacancy_id {
+        False -> v
+        True ->
+          DemoVacancy(
+            ..v,
+            applications: list.map(v.applications, fn(app) {
+              case app.application.id == application_id {
+                False -> app
+                True ->
+                  DemoApplication(
+                    ..app,
+                    reference_calls: list.map(app.reference_calls, fn(call) {
+                      case call.reference_call_id == call_id {
+                        False -> call
+                        True -> apply_refcheck(call, action)
+                      }
+                    }),
+                  )
+              }
+            }),
+          )
+      }
+    })
+  #(DemoStore(..store, vacancies: updated), Ok(call_id))
+}
+
+fn apply_refcheck(
+  call: ReferenceCallDetail,
+  action: String,
+) -> ReferenceCallDetail {
+  case action {
+    "start" -> ReferenceCallDetail(..call, status: Scheduled)
+    "skip" -> ReferenceCallDetail(..call, status: RefSkipped)
+    "re_enable" -> ReferenceCallDetail(..call, status: RefQueued)
+    "take_over" ->
+      ReferenceCallDetail(..call, taken_over_at: Some("2026-08-19T00:00:00Z"))
+    "correct" ->
+      ReferenceCallDetail(..call, correction_cycles: call.correction_cycles + 1)
+    "substitute" ->
+      ReferenceCallDetail(
+        ..call,
+        contact_name: None,
+        contact_email: None,
+        contact_phone: None,
+      )
+    _ -> call
+  }
+}
+
+pub fn notifications(store: DemoStore) -> List(Notification) {
+  store.notifications
+}
+
+pub fn mark_notification_read(
+  store: DemoStore,
+  notification_id: String,
+) -> #(DemoStore, Result(String, Nil)) {
+  let updated =
+    list.map(store.notifications, fn(n) {
+      case n.id == notification_id {
+        True -> Notification(..n, is_read: True)
+        False -> n
+      }
+    })
+  #(DemoStore(..store, notifications: updated), Ok(notification_id))
+}
+
+pub fn mark_all_notifications_read(
+  store: DemoStore,
+) -> #(DemoStore, Result(Nil, Nil)) {
+  let updated =
+    list.map(store.notifications, fn(n) { Notification(..n, is_read: True) })
+  #(DemoStore(..store, notifications: updated), Ok(Nil))
+}
+
+// -- Lookups for the api mirror ----------------------------------------------
+
+pub fn landlord(store: DemoStore) -> Landlord {
+  store.landlord
+}
+
+pub fn notifications_unread(store: DemoStore) -> #(List(Notification), Int) {
+  #(
+    store.notifications,
+    list.length(list.filter(store.notifications, fn(n) { n.is_read == False })),
+  )
+}
+
+pub fn report_filenames() -> List(#(String, String)) {
+  [
+    #("a-aoife", "RightTenantry-Report-Aoife-Ni-Riain.pdf"),
+    #("a-conor", "RightTenantry-Report-Conor-OSullivan.pdf"),
+    #("a-marta", "RightTenantry-Report-Marta-Kowalska.pdf"),
+    #("a-declan", "RightTenantry-Report-Declan-Murphy.pdf"),
+    #("a-sara", "RightTenantry-Report-Sara-Walsh.pdf"),
+    #("a-tom", "RightTenantry-Report-Tom-Byrne.pdf"),
+    #("a-grace", "RightTenantry-Report-Grace-Kelly.pdf"),
+    #("a-liam", "RightTenantry-Report-Liam-Doyle.pdf"),
+  ]
+}
+
+// -- Helpers -----------------------------------------------------------------
+
+fn find_vacancy(
+  store: DemoStore,
+  vacancy_id: String,
+) -> Result(DemoVacancy, Nil) {
+  case list.find(store.vacancies, fn(v) { v.vacancy.id == vacancy_id }) {
+    Ok(v) -> Ok(v)
+    Error(_) -> Error(Nil)
+  }
+}
+
+fn find_application(
+  v: DemoVacancy,
+  application_id: String,
+) -> Result(DemoApplication, Nil) {
+  case list.find(v.applications, fn(a) { a.application.id == application_id }) {
+    Ok(a) -> Ok(a)
+    Error(_) -> Error(Nil)
+  }
+}
+
+fn opt_str(value: String) -> Option(String) {
+  case value {
+    "" -> None
+    s -> Some(s)
+  }
+}
+
+/// Stable short id suffix from a property name (lowercase alphanumeric,
+/// up to 8 chars) so re-created demo vacancies don't collide.
+fn id_suffix(value: String) -> String {
+  let cleaned =
+    value
+    |> string.lowercase
+    |> string.replace(each: " ", with: "-")
+    |> string.replace(each: "'", with: "")
+    |> string.replace(each: ".", with: "")
+  case string.length(cleaned) {
+    n if n <= 8 -> cleaned
+    n -> string.drop_end(cleaned, n - 8)
+  }
+}
diff --git a/client/src/demo/demo_update.gleam b/client/src/demo/demo_update.gleam
new file mode 100644
index 00000000..700baf93
--- /dev/null
+++ b/client/src/demo/demo_update.gleam
@@ -0,0 +1,569 @@
+//// Demo-mode update dispatcher — the single interception point for demo
+//// messages.
+////
+//// `update/2` routes here whenever `model.demo_mode` is True. This module
+//// handles the demo-relevant REQUEST messages (fetches + mutations) by
+//// resolving from the in-memory store and dispatching the SAME response
+//// `msg` constructors the real handlers consume — so `update_inner`'s
+//// response arms render the mock with zero duplication. Everything else
+//// (response messages, UI toggles, form inputs, modals) falls through to
+//// the `fallback` (client.gleam's `update_inner`), which is also where the
+//// handful of response-side refetch side-effects carry their own tiny
+//// demo branches (marked `// demo:` in client.gleam).
+////
+//// No network: every effect here comes from `demo/demo_api.gleam`, which
+//// dispatches synchronously — the CI grep lint bans network imports from
+//// `demo/`.
+
+import demo/demo_analytics
+import demo/demo_api
+import demo/demo_store.{type DemoStore}
+import gleam/option.{None, Some}
+import gleam/set
+import lustre/effect.{type Effect}
+import model.{
+  type Model, LoadingArchive, LoadingBulkInvite, LoadingClose, LoadingPublish,
+  LoadingReminder, LoadingStatusUpdate, Model, RefcheckConfirmStart,
+  RefcheckConfirmTakeOver, RefcheckReEnable, RefcheckSkip,
+}
+import modem
+import msg.{
+  type Msg, ApiReturnedApplicantReminder, ApiReturnedApplicationDetail,
+  ApiReturnedArchiveVacancy, ApiReturnedArchivedVacancies, ApiReturnedAwaiting,
+  ApiReturnedBulkInvite, ApiReturnedCloseVacancy, ApiReturnedComparisonDetails,
+  ApiReturnedDashboardData, ApiReturnedLeaderboard, ApiReturnedLeaderboardPage,
+  ApiReturnedMarkAllRead, ApiReturnedMarkRead, ApiReturnedNotifications,
+  ApiReturnedRefcheckAction, ApiReturnedReminder, ApiReturnedRestoreVacancy,
+  ApiReturnedScoringStatus, ApiReturnedStatusUpdate, ApiReturnedVacancyDetail,
+  AppPolledData, AppRequestedApplicationDetail, AppRequestedArchivedVacancies,
+  AppRequestedComparisonDetails, AppRequestedDashboardData,
+  AppRequestedLeaderboard, AppRequestedNotifications, AppRequestedScoringStatus,
+  AppRequestedSessionRefresh, AppRequestedVacancyDetail,
+  AppRetriedApplicationOpen, UserChangedApplicationStatus,
+  UserChoseRefcheckAction, UserClickedDemoCta, UserClickedDownloadReport,
+  UserClickedLoadMoreApplications, UserClickedLogout, UserClickedMarkAllRead,
+  UserClickedNotification, UserClickedPublishVacancy, UserClickedRemindApplicant,
+  UserClickedResetDemo, UserClickedRestoreVacancy, UserClickedSendReminder,
+  UserConfirmedApproval, UserConfirmedArchiveVacancy,
+  UserConfirmedBackwardTransition, UserConfirmedCloseVacancy,
+  UserConfirmedRefcheckAction, UserConfirmedRejection, UserSavedRefcheckEdit,
+  UserSubmittedBulkInvite, UserToggledAwaitingSection,
+}
+import plinth/javascript/global
+import shared/remote_data.{Loading, NotAsked, Success}
+import shared/routes
+
+/// The demo dispatcher. `fallback` is client.gleam's `update_inner`.
+pub fn handle(
+  model model: Model,
+  msg msg: Msg,
+  fallback fallback: fn(Model, Msg) -> #(Model, Effect(Msg)),
+) -> #(Model, Effect(Msg)) {
+  case msg {
+    // -- Demo chrome ----------------------------------------------------------
+    UserClickedResetDemo -> reset_demo(model)
+    UserClickedDemoCta -> {
+      demo_analytics.capture_event(demo_analytics.demo_cta_click)
+      #(model, effect.none())
+    }
+    // Signing out of the demo exits back to the landing page — there is no
+    // session to destroy.
+    UserClickedLogout -> {
+      demo_analytics.capture_event(demo_analytics.demo_reset)
+      #(
+        Model(
+          ..model,
+          demo_mode: False,
+          demo_store: None,
+          auth: NotAsked,
+          route: routes.Landing,
+          toasts: [],
+        ),
+        modem.push("/", None, None),
+      )
+    }
+
+    // -- Static demo: no background polling, no session refresh ----------------
+    AppPolledData(_, _, _) -> #(model, effect.none())
+    AppRequestedSessionRefresh -> #(model, effect.none())
+    AppRetriedApplicationOpen(_, _, _) -> #(model, effect.none())
+
+    // -- Dashboard -------------------------------------------------------------
+    AppRequestedDashboardData -> {
+      let store = store_of(model)
+      #(
+        Model(..model, vacancies: Loading, dashboard_stats: Loading),
+        demo_api.list_vacancies(store, ApiReturnedDashboardData),
+      )
+    }
+
+    // -- Vacancy detail + leaderboard ------------------------------------------
+    AppRequestedVacancyDetail(id) -> {
+      let store = store_of(model)
+      #(
+        Model(
+          ..model,
+          vacancy_detail: Loading,
+          vacancy_detail_request_id: Some(id),
+          leaderboard: Loading,
+          leaderboard_total: 0,
+          leaderboard_strong_count: 0,
+          leaderboard_review_count: 0,
+          leaderboard_weak_count: 0,
+          leaderboard_shortlisted_count: 0,
+          leaderboard_page: 1,
+          leaderboard_loading_more: False,
+          clipboard_copied: None,
+          bulk_invite_emails: "",
+          awaiting_expanded: False,
+          awaiting_list: NotAsked,
+          reminding_applicant_email: None,
+          scoring_status: None,
+          scoring_poll_count: 0,
+          scoring_poll_vacancy_id: "",
+          scoring_error_count: 0,
+        ),
+        effect.batch([
+          demo_api.get_detail(store, id, ApiReturnedVacancyDetail),
+          demo_api.fetch_leaderboard(store, id, ApiReturnedLeaderboard),
+        ]),
+      )
+    }
+    AppRequestedLeaderboard(id) -> {
+      let store = store_of(model)
+      #(
+        Model(
+          ..model,
+          leaderboard: Loading,
+          leaderboard_page: 1,
+          leaderboard_total: 0,
+          leaderboard_strong_count: 0,
+          leaderboard_review_count: 0,
+          leaderboard_weak_count: 0,
+          leaderboard_shortlisted_count: 0,
+          leaderboard_loading_more: False,
+        ),
+        demo_api.fetch_leaderboard(store, id, ApiReturnedLeaderboard),
+      )
+    }
+    UserClickedLoadMoreApplications(vacancy_id) -> {
+      let store = store_of(model)
+      #(
+        Model(..model, leaderboard_loading_more: True),
+        demo_api.fetch_leaderboard_page(
+          store,
+          vacancy_id,
+          model.leaderboard_page + 1,
+          ApiReturnedLeaderboardPage,
+        ),
+      )
+    }
+
+    // -- Application detail -----------------------------------------------------
+    AppRequestedApplicationDetail(vid, aid) -> {
+      let store = store_of(model)
+      #(
+        Model(
+          ..model,
+          application_detail: Loading,
+          application_detail_request_id: Some(aid),
+        ),
+        demo_api.fetch_application_detail(
+          store,
+          vid,
+          aid,
+          ApiReturnedApplicationDetail,
+        ),
+      )
+    }
+    UserChangedApplicationStatus(vid, aid, new_status) -> {
+      case model.loading_action == Some(LoadingStatusUpdate) {
+        True -> #(model, effect.none())
+        False -> demo_status(model, vid, aid, new_status)
+      }
+    }
+    UserConfirmedApproval(vid, aid) -> {
+      let #(updated, eff) = demo_status(model, vid, aid, "approved")
+      let store = store_of(model)
+      let leaderboard_eff =
+        demo_api.fetch_leaderboard(store, vid, ApiReturnedLeaderboard)
+      #(
+        Model(..updated, show_approval_confirm: False, pending_approval: None),
+        effect.batch([eff, leaderboard_eff]),
+      )
+    }
+    UserConfirmedRejection(vid, aid) -> {
+      let #(updated, eff) = demo_status(model, vid, aid, "rejected")
+      #(
+        Model(..updated, show_reject_confirm: False, pending_rejection: None),
+        eff,
+      )
+    }
+    UserConfirmedBackwardTransition(vid, aid, target) -> {
+      let #(updated, eff) = demo_status(model, vid, aid, target)
+      #(
+        Model(
+          ..updated,
+          show_backward_confirm: False,
+          pending_backward_transition: None,
+        ),
+        eff,
+      )
+    }
+
+    // -- Archived ---------------------------------------------------------------
+    AppRequestedArchivedVacancies -> {
+      let store = store_of(model)
+      #(
+        Model(..model, archived_vacancies: Loading),
+        demo_api.fetch_archived(store, ApiReturnedArchivedVacancies),
+      )
+    }
+    UserClickedRestoreVacancy(id) -> {
+      let store = store_of(model)
+      let #(next, eff) =
+        demo_api.restore_vacancy(store, id, "", ApiReturnedRestoreVacancy)
+      #(Model(..model, demo_store: Some(next)), eff)
+    }
+
+    // -- Awaiting + reminders ----------------------------------------------------
+    UserToggledAwaitingSection -> {
+      let expanded = !model.awaiting_expanded
+      case expanded, model.vacancy_detail {
+        True, Success(detail) -> {
+          let store = store_of(model)
+          #(
+            Model(
+              ..model,
+              awaiting_expanded: True,
+              awaiting_list: Loading,
+              awaiting_visible_count: model.awaiting_page_size,
+            ),
+            demo_api.fetch_awaiting(store, detail.id, fn(result) {
+              ApiReturnedAwaiting(detail.id, result)
+            }),
+          )
+        }
+        _, _ -> #(
+          Model(
+            ..model,
+            awaiting_expanded: expanded,
+            awaiting_visible_count: model.awaiting_page_size,
+          ),
+          effect.none(),
+        )
+      }
+    }
+    UserClickedSendReminder(vacancy_id) -> {
+      let store = store_of(model)
+      #(
+        Model(..model, loading_action: Some(LoadingReminder)),
+        demo_api.send_reminder(store, vacancy_id, "", ApiReturnedReminder),
+      )
+    }
+    UserClickedRemindApplicant(vacancy_id, email) -> {
+      let store = store_of(model)
+      #(
+        Model(
+          ..model,
+          loading_action: Some(LoadingReminder),
+          reminding_applicant_email: Some(email),
+        ),
+        demo_api.remind_applicant(
+          store,
+          vacancy_id,
+          email,
+          "",
+          ApiReturnedApplicantReminder,
+        ),
+      )
+    }
+    UserSubmittedBulkInvite(vacancy_id) ->
+      case model.bulk_invite_emails {
+        "" -> #(model, effect.none())
+        _ -> {
+          let store = store_of(model)
+          #(
+            Model(..model, loading_action: Some(LoadingBulkInvite)),
+            demo_api.send_bulk_invite(
+              store,
+              vacancy_id,
+              model.bulk_invite_emails,
+              "",
+              ApiReturnedBulkInvite,
+            ),
+          )
+        }
+      }
+
+    // -- Comparison ---------------------------------------------------------------
+    AppRequestedComparisonDetails(vid, ids) ->
+      case ids {
+        [] -> #(model, effect.none())
+        _ -> {
+          let store = store_of(model)
+          #(
+            Model(..model, comparison_details: Loading),
+            demo_api.fetch_comparison(
+              store,
+              vid,
+              ids,
+              ApiReturnedComparisonDetails,
+            ),
+          )
+        }
+      }
+
+    // -- Report download -----------------------------------------------------------
+    UserClickedDownloadReport(id) ->
+      case model.report_download_loading {
+        Some(_) -> #(model, effect.none())
+        None -> {
+          let store = store_of(model)
+          #(
+            Model(..model, report_download_loading: Some(id)),
+            effect.batch([
+              demo_api.download(store, id, fn(r) {
+                msg.ApiReturnedReportPdf(id, r)
+              }),
+              download_timeout(id),
+            ]),
+          )
+        }
+      }
+
+    // -- Scoring status (static: one completed response, no polling chain) ---------
+    AppRequestedScoringStatus(generation, vid, _visible) ->
+      case generation == model.scoring_generation {
+        False -> #(model, effect.none())
+        True -> {
+          let store = store_of(model)
+          #(
+            model,
+            demo_api.get_scoring_status(store, vid, fn(result) {
+              ApiReturnedScoringStatus(generation, result)
+            }),
+          )
+        }
+      }
+
+    // -- Reference checks ------------------------------------------------------------
+    UserChoseRefcheckAction(call_id, action) -> {
+      // Immediate actions (skip / re-enable) fire the api straight away; the
+      // confirm/edit-opening kinds are UI-only and fall through untouched.
+      case action {
+        RefcheckSkip -> fire_demo_refcheck(model, call_id, "skip")
+        RefcheckReEnable -> fire_demo_refcheck(model, call_id, "re_enable")
+        _ -> fallback(model, msg)
+      }
+    }
+    UserConfirmedRefcheckAction(call_id) -> {
+      case model.refcheck_confirm {
+        Some(confirm) if confirm.call_id == call_id ->
+          case confirm.kind {
+            RefcheckConfirmStart -> fire_demo_refcheck(model, call_id, "start")
+            RefcheckConfirmTakeOver ->
+              fire_demo_refcheck(model, call_id, "take_over")
+          }
+        _ -> #(model, effect.none())
+      }
+    }
+    UserSavedRefcheckEdit(call_id) ->
+      fire_demo_refcheck(model, call_id, "correct")
+
+    // -- Notifications ---------------------------------------------------------------
+    AppRequestedNotifications -> {
+      let store = store_of(model)
+      #(
+        Model(..model, notifications: Loading),
+        demo_api.fetch_notifications(store, ApiReturnedNotifications),
+      )
+    }
+    UserClickedNotification(id, _entity_type, _entity_id) -> {
+      let store = store_of(model)
+      let #(next, eff) =
+        demo_api.mark_notification_read(store, id, "", ApiReturnedMarkRead)
+      #(Model(..model, demo_store: Some(next)), eff)
+    }
+    UserClickedMarkAllRead -> {
+      let store = store_of(model)
+      let #(next, eff) =
+        demo_api.mark_all_notifications_read(store, "", ApiReturnedMarkAllRead)
+      #(Model(..model, demo_store: Some(next)), eff)
+    }
+
+    // -- Vacancy lifecycle ------------------------------------------------------------
+    UserClickedPublishVacancy(id) ->
+      case model.loading_action {
+        Some(_) -> #(model, effect.none())
+        None -> {
+          let store = store_of(model)
+          let #(next, eff) =
+            demo_api.publish_vacancy(store, id, "", fn(result) {
+              msg.ApiReturnedPublishVacancy(id, result)
+            })
+          #(
+            Model(
+              ..model,
+              demo_store: Some(next),
+              loading_action: Some(LoadingPublish(id)),
+            ),
+            eff,
+          )
+        }
+      }
+    UserConfirmedCloseVacancy(id) ->
+      case model.loading_action {
+        Some(_) -> #(Model(..model, confirm_action: None), effect.none())
+        None -> {
+          let store = store_of(model)
+          let #(next, eff) =
+            demo_api.close_vacancy(store, id, "", ApiReturnedCloseVacancy)
+          #(
+            Model(
+              ..model,
+              demo_store: Some(next),
+              confirm_action: None,
+              loading_action: Some(LoadingClose),
+            ),
+            eff,
+          )
+        }
+      }
+    UserConfirmedArchiveVacancy(id) ->
+      case model.loading_action {
+        Some(_) -> #(Model(..model, confirm_action: None), effect.none())
+        None -> {
+          let store = store_of(model)
+          let #(next, eff) =
+            demo_api.archive_vacancy(store, id, "", ApiReturnedArchiveVacancy)
+          #(
+            Model(
+              ..model,
+              demo_store: Some(next),
+              confirm_action: None,
+              loading_action: Some(LoadingArchive),
+            ),
+            eff,
+          )
+        }
+      }
+
+    // Everything else (response messages, form inputs, UI toggles, modals,
+    // create/edit vacancy submissions — those branch on demo_mode inside
+    // client.gleam's shared helpers) falls through to the real handler.
+    _ -> fallback(model, msg)
+  }
+}
+
+// -- Helpers -----------------------------------------------------------------
+
+fn store_of(model: Model) -> DemoStore {
+  case model.demo_store {
+    Some(store) -> store
+    None ->
+      // Unreachable while demo_mode is True (entry/reset always seed first);
+      // fall back to a fresh seed so the demo can never crash on a None.
+      case demo_store.seed() {
+        Ok(store) -> store
+        Error(_) -> demo_store.empty_store()
+      }
+  }
+}
+
+fn reset_demo(model: Model) -> #(Model, Effect(Msg)) {
+  case demo_store.seed() {
+    Ok(store) -> {
+      demo_analytics.capture_event(demo_analytics.demo_reset)
+      let #(vacancies, stats) = demo_store.dashboard(store)
+      let landlord = demo_store.landlord(store)
+      #(
+        Model(
+          ..model,
+          demo_store: Some(store),
+          auth: Success(landlord),
+          vacancies: Success(vacancies),
+          dashboard_stats: Success(stats),
+          vacancy_detail: NotAsked,
+          leaderboard: NotAsked,
+          application_detail: NotAsked,
+          comparison_details: NotAsked,
+          archived_vacancies: NotAsked,
+          awaiting_list: NotAsked,
+          notifications: NotAsked,
+          toasts: [],
+        ),
+        demo_api.fetch_notifications(store, ApiReturnedNotifications),
+      )
+    }
+    Error(_) -> #(model, effect.none())
+  }
+}
+
+fn demo_status(
+  model: Model,
+  vid: String,
+  aid: String,
+  status: String,
+) -> #(Model, Effect(Msg)) {
+  let store = store_of(model)
+  let #(next, eff) =
+    demo_api.update_application_status(
+      store,
+      vid,
+      aid,
+      status,
+      "",
+      ApiReturnedStatusUpdate,
+    )
+  #(
+    Model(
+      ..model,
+      demo_store: Some(next),
+      loading_action: Some(LoadingStatusUpdate),
+    ),
+    eff,
+  )
+}
+
+/// Fire a reference-check action through the demo api, restoring the same
+/// in-flight marker the real flow sets (the ApiReturnedRefcheckAction
+/// response handler in update_inner does the rest).
+fn fire_demo_refcheck(
+  model: Model,
+  call_id: String,
+  action: String,
+) -> #(Model, Effect(Msg)) {
+  let store = store_of(model)
+  case model.route {
+    routes.ApplicationDetail(vid, aid) -> {
+      let #(next, eff) =
+        demo_api.refcheck_action(store, vid, aid, call_id, action, fn(result) {
+          ApiReturnedRefcheckAction(call_id, action, result)
+        })
+      #(
+        Model(
+          ..model,
+          demo_store: Some(next),
+          refcheck_action_inflight: set.insert(
+            model.refcheck_action_inflight,
+            call_id,
+          ),
+        ),
+        eff,
+      )
+    }
+    _ -> #(model, effect.none())
+  }
+}
+
+/// 90s download timeout — mirrors client.gleam's `download_timeout` so a
+/// slow static asset (unlikely) still surfaces the brand-voice toast.
+fn download_timeout(id: String) -> Effect(Msg) {
+  effect.from(fn(dispatch) {
+    global.set_timeout(90_000, fn() {
+      dispatch(msg.AppTimedOutDownloadReport(id))
+    })
+    Nil
+  })
+}
