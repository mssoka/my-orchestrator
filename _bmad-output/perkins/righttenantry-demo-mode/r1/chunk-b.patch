+/// An empty store - belt-and-braces fallback if seeding ever fails at
+/// runtime (the conformance suite is the real guard; this just prevents a
+/// crash). Demo dispatch against an empty store resolves empty lists, which
+/// render the normal empty states.
+pub fn empty_store() -> DemoStore {
+  DemoStore(
+    landlord: Landlord(
+      id: "demo-landlord",
