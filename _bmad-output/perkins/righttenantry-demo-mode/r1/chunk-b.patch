+  _csrf_token: String,
+  on_response: fn(Result(Vacancy, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
+  let #(next, result) = demo_store.publish_vacancy(store, vacancy_id)
+  #(next, respond_result(result, on_response))
+}
+
+pub fn archive_vacancy(
+  store: DemoStore,
+  vacancy_id: String,
+  _csrf_token: String,
+  on_response: fn(Result(String, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
+  let #(next, result) = demo_store.archive_vacancy(store, vacancy_id)
+  #(next, respond_result(result, on_response))
+}
+
+pub fn restore_vacancy(
+  store: DemoStore,
+  vacancy_id: String,
+  _csrf_token: String,
+  on_response: fn(Result(String, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
+  let #(next, result) = demo_store.restore_vacancy(store, vacancy_id)
+  #(next, respond_result(result, on_response))
+}
+
+pub fn close_vacancy(
+  store: DemoStore,
+  vacancy_id: String,
+  _csrf_token: String,
+  on_response: fn(Result(String, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
+  let #(next, result) = demo_store.close_vacancy(store, vacancy_id)
+  #(next, respond_result(result, on_response))
+}
+
+// -- Application ---------------------------------------------------------------
+
+pub fn fetch_leaderboard(
+  store: DemoStore,
+  vacancy_id: String,
+  on_response: fn(Result(LeaderboardResponse, ApiError)) -> msg,
+) -> Effect(msg) {
+  fetch_leaderboard_page(store, vacancy_id, 1, on_response)
+}
+
+pub fn fetch_leaderboard_page(
+  store: DemoStore,
+  vacancy_id: String,
+  _page: Int,
+  on_response: fn(Result(LeaderboardResponse, ApiError)) -> msg,
+) -> Effect(msg) {
+  case demo_store.leaderboard(store, vacancy_id) {
+    Ok(response) -> deliver(on_response, response)
+    Error(_) -> deliver_err(on_response)
+  }
+}
+
+pub fn fetch_application_detail(
+  store: DemoStore,
+  vacancy_id: String,
+  application_id: String,
+  on_response: fn(Result(ApplicationDetail, ApiError)) -> msg,
+) -> Effect(msg) {
+  case demo_store.application_detail(store, vacancy_id, application_id) {
+    Ok(detail) -> deliver(on_response, detail)
+    Error(_) -> deliver_err(on_response)
+  }
+}
+
+pub fn mark_application_opened(
+  store: DemoStore,
+  vacancy_id: String,
+  application_id: String,
+  _csrf_token: String,
+  on_response: fn(Result(String, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
+  let #(next, result) =
+    demo_store.mark_opened(store, vacancy_id, application_id)
+  #(next, respond_result(result, on_response))
+}
+
+pub fn update_application_status(
+  store: DemoStore,
+  vacancy_id: String,
+  application_id: String,
+  new_status: String,
+  _csrf_token: String,
+  on_response: fn(Result(String, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
+  let #(next, result) =
+    demo_store.set_status(store, vacancy_id, application_id, new_status)
+  #(next, respond_result(result, on_response))
+}
+
+pub fn fetch_comparison(
+  store: DemoStore,
+  vacancy_id: String,
+  ids: List(String),
+  on_response: fn(Result(List(ApplicationDetail), ApiError)) -> msg,
+) -> Effect(msg) {
+  case demo_store.comparison(store, vacancy_id, ids) {
+    Ok(details) -> deliver(on_response, details)
+    Error(_) -> deliver_err(on_response)
+  }
+}
+
+pub fn bulk_reject_applications(
+  store: DemoStore,
+  vacancy_id: String,
+  ids: List(String),
+  _trigger: String,
+  _csrf_token: String,
+  on_response: fn(Result(Int, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
+  let #(next, count) = demo_store.bulk_reject(store, vacancy_id, ids)
+  #(next, deliver(on_response, count))
+}
+
+// -- Scoring ------------------------------------------------------------------
+
+pub fn get_scoring_status(
+  store: DemoStore,
+  vacancy_id: String,
+  on_response: fn(Result(ScoringStatusResponse, ApiError)) -> msg,
+) -> Effect(msg) {
+  let #(in_progress, completed, failed, total, is_burst_active) =
+    demo_store.scoring_status(store, vacancy_id)
+  deliver(
+    on_response,
+    ScoringStatusResponse(
+      in_progress:,
+      completed:,
+      failed:,
+      total:,
+      is_burst_active:,
+    ),
+  )
+}
+
+// -- Reference checks ---------------------------------------------------------
+
+pub fn start_check(
+  store: DemoStore,
+  vacancy_id: String,
+  application_id: String,
+  slot: Option(String),
+  _csrf_token: String,
+  on_response: fn(Result(String, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
+  refcheck(store, vacancy_id, application_id, slot, "start", on_response)
+}
+
+pub fn skip_reference(
+  store: DemoStore,
+  vacancy_id: String,
+  application_id: String,
+  slot: String,
+  _csrf_token: String,
+  on_response: fn(Result(String, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
+  refcheck(store, vacancy_id, application_id, Some(slot), "skip", on_response)
+}
+
+pub fn re_enable_reference(
+  store: DemoStore,
+  vacancy_id: String,
+  application_id: String,
+  slot: String,
+  _csrf_token: String,
