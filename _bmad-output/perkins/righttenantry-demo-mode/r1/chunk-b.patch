+  on_response: fn(Result(String, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
+  refcheck(
+    store,
+    vacancy_id,
+    application_id,
+    Some(call_id),
+    "take_over",
+    on_response,
