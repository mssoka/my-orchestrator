+/// Conformance helper: decode a single JSON string through a decoder,
+/// surfacing a readable failure for the drift-guard test.
+pub fn decode_checked(
+  label: String,
+  json_str: String,
+  decoder decoder: Decoder(a),
+) -> Result(a, String) {
+  case json.parse(json_str, decoder) {
+    Ok(value) -> Ok(value)
+    Error(_) -> Error("fixture '" <> label <> "' failed to decode")
+  }
+}
