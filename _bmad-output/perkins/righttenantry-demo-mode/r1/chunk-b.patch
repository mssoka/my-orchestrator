+  #(next, respond_result(result, on_response))
+}
+
+// -- Report download (the one read-only static-asset fetch) --------------------
+
+/// Mirrors `report_api.download` but serves the PRE-BAKED mock PDF from
+/// `/static/demo/`. This is a static-asset GET — same-origin, read-only,
+/// no API surface, zero AI/typst cost. The `analysis_id` (e.g. "an-aoife")
+/// maps to the application id ("a-aoife") which keys the baked PDF.
+pub fn download(
+  _store: DemoStore,
+  analysis_id: String,
+  on_response: fn(Result(#(BitArray, String), ApiError)) -> msg,
+) -> Effect(msg) {
+  let application_id = string.drop_start(analysis_id, 3)
+  let filename = case
+    list.find(demo_store.report_filenames(), fn(p) { p.0 == application_id })
+  {
+    Ok(pair) -> pair.1
+    Error(_) -> "RightTenantry-Report.pdf"
+  }
+  let url = "/static/demo/report-" <> application_id <> ".pdf"
+  use dispatch <- effect.from
+  case request.from_uri(uri_from(url)) {
+    Error(_) -> dispatch(on_response(Error(internal_error())))
+    Ok(req) -> {
+      let _ =
+        {
+          use fetch_result <- promise.try_await(fetch.send(req))
+          use response <- promise.try_await(fetch.read_bytes_body(fetch_result))
+          promise.resolve(Ok(response))
+        }
+        |> promise.tap(fn(result) {
+          dispatch(on_response(map_pdf_result(result, filename)))
+        })
+      Nil
+    }
+  }
+}
+
+fn uri_from(url: String) -> uri.Uri {
+  case uri.parse(url) {
+    Ok(uri) -> uri
+    Error(_) ->
+      // Unreachable: the URL is a compile-time constant. Fall back to an
+      // empty path so the request builder still returns something total.
+      uri.Uri(
+        scheme: None,
+        userinfo: None,
+        host: None,
+        port: None,
+        path: "/",
+        query: None,
+        fragment: None,
+      )
+  }
+}
+
+fn map_pdf_result(
+  result: Result(Response(BitArray), fetch.FetchError),
+  filename: String,
+) -> Result(#(BitArray, String), ApiError) {
+  use response <- result.try(result |> result.map_error(api_error.from_fetch))
+  case response.status {
+    code if code >= 200 && code < 300 ->
+      case bit_array.byte_size(response.body) {
+        0 -> Error(internal_error())
+        _ -> Ok(#(response.body, filename))
+      }
+    _ -> Error(internal_error())
+  }
+}
+
+fn respond_result(
+  result: Result(a, Nil),
+  on_response: fn(Result(a, ApiError)) -> msg,
+) -> Effect(msg) {
+  case result {
+    Ok(value) -> deliver(on_response, value)
+    Error(_) -> deliver_err(on_response)
+  }
+}
