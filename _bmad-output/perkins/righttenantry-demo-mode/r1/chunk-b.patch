+/// Burst-scoring progress as a plain tuple (in_progress, completed, failed,
+/// total, is_burst_active). The demo store stays free of client-model imports
+/// (no import cycle); `demo/demo_api.gleam` wraps it into the model type.
+pub fn scoring_status(
+  store: DemoStore,
+  vacancy_id: String,
+) -> #(Int, Int, Int, Int, Bool) {
+  let pending = case find_vacancy(store, vacancy_id) {
+    Ok(v) ->
+      list.length(
+        list.filter(v.applications, fn(a) {
+          case a.analysis {
+            Some(an) ->
+              case an.status {
+                Pending | Processing -> True
+                _ -> False
+              }
+            None -> False
+          }
+        }),
+      )
+    Error(_) -> 0
+  }
+  let total = case find_vacancy(store, vacancy_id) {
+    Ok(v) -> list.length(v.applications)
+    Error(_) -> 0
+  }
+  #(0, total - pending, 0, total, False)
+}
