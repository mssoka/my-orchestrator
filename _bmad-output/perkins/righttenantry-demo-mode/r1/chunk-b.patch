+    demo_store.refcheck_action(
+      store,
+      vacancy_id,
+      application_id,
+      call_id,
+      "substitute",
+    )
+  let _ = name
+  let _ = email
+  let _ = phone
+  #(next, respond_result(result, on_response))
+}
+
+fn refcheck(
+  store: DemoStore,
+  vacancy_id: String,
+  application_id: String,
+  slot_or_call: Option(String),
+  action: String,
+  on_response: fn(Result(String, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
+  let call_id = case slot_or_call {
+    Some(id) -> id
+    None -> ""
+  }
+  let #(next, result) =
+    demo_store.refcheck_action(
+      store,
+      vacancy_id,
+      application_id,
+      call_id,
+      action,
+    )
+  #(next, respond_result(result, on_response))
+}
+
+/// Generic reference-check action (RC4.3): start / skip / re_enable /
+/// take_over / correct / substitute. `call_id` keys the row; the demo store
+/// maps the action to a status/contact mutation.
+pub fn refcheck_action(
+  store: DemoStore,
+  vacancy_id: String,
+  application_id: String,
+  call_id: String,
+  action: String,
+  on_response: fn(Result(String, ApiError)) -> msg,
+) -> #(DemoStore, Effect(msg)) {
+  let #(next, result) =
+    demo_store.refcheck_action(
+      store,
+      vacancy_id,
+      application_id,
+      call_id,
+      action,
+    )
+  #(next, respond_result(result, on_response))
+}
+
+// -- Notifications -------------------------------------------------------------
+
+pub fn fetch_notifications(
