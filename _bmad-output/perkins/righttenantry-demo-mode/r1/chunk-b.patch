+//// Demo-mode fixtures — the mock dataset that IS the product marketing.
+////
+//// Every fixture is a JSON string decoded through the PRODUCTION `shared/`
+//// decoders at seed time (see `demo/demo_store.gleam`). That is the drift
+//// guard: if the real API shape evolves, these decodes fail loudly — in the
+//// browser on /demo entry AND in the `make test` conformance suite
+//// (`client/test/demo/fixtures_conformance_test.gleam`) — instead of the
+//// demo silently rotting next to the live product.
+////
+//// All data is synthetic. Names, addresses, employers, emails and stories
+//// are generated placeholders for an imaginary Irish tenancy — no real
+//// person's data. Emails use `example.ie`/`example.com`. Protected
+//// characteristics never appear as criteria (Equal Status Acts); the
+//// stories demonstrate only legitimate criteria: affordability, references,
+//// rental history, occupants, pets.
+
+import gleam/dynamic/decode.{type Decoder}
+import gleam/json
+import shared/application.{type Application}
+import shared/landlord.{type Landlord}
+import shared/notification.{type Notification}
+import shared/vacancy.{type Vacancy}
+
+// -- Landlord ----------------------------------------------------------------
+
