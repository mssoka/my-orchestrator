+/// The full dashboard + detail + comparison data is derivable for every
+/// seeded vacancy — no id in the store dead-ends.
+pub fn demo_store_no_dead_ends_test() {
+  let store = demo_store.seed() |> should.be_ok
+  demo_store.vacancy_detail(store, "v-maples") |> should.be_ok
+  demo_store.vacancy_detail(store, "v-harbour") |> should.be_ok
+  demo_store.for_edit(store, "v-maples") |> should.be_ok
+  let #(_, completed, _, total, active) =
+    demo_store.scoring_status(store, "v-maples")
+  completed |> should.equal(8)
+  // all 8 scored; ciara (pending) is on harbour
+  total |> should.equal(8)
+  active |> should.be_false
+}
