diff --git a/client/test/demo/demo_flow_test.gleam b/client/test/demo/demo_flow_test.gleam
new file mode 100644
index 00000000..b0a06bc4
--- /dev/null
+++ b/client/test/demo/demo_flow_test.gleam
@@ -0,0 +1,186 @@
+//// Demo-mode flow test — drives the demo through the REAL update path
+//// (client.update + demo_update) and asserts the model resolves exactly as
+//// a live session would. This is the non-persistence + integration proof:
+//// every demo request message resolves through the store, and the response
+//// handlers render it — with zero network involved (the demo effects are
+//// synchronous dispatches; the CI demo-no-network grep lint bans rsvp /
+//// fetch / api_helpers imports in demo/ as the structural guard).
+////
+//// Because Lustre effects are opaque to Node tests, the request→response
+//// bridge is exercised in two steps: dispatch the request (asserts the
+//// Loading/state transition + demo_api is wired), then feed the response
+//// message the demo would produce (from the store) and assert the handler
+//// resolves it. The browser E2E (bug-hunt) covers the effect execution.
+
+import client
+import demo/demo_store
+import gleam/list
+import gleam/option.{type Option, None, Some}
+import gleam/string
+import gleeunit/should
+import lustre/dev/simulate
+import lustre/effect.{type Effect}
+import lustre/element
+import model
+import msg
+import shared/remote_data.{Loading, Success}
+import shared/routes
+
+/// A demo-mode model: demo flag on, store seeded, mock landlord authed.
+fn demo_model() -> model.Model {
+  let store = demo_store.seed() |> should.be_ok
+  model.Model(
+    ..model.initial(),
+    route: routes.Demo,
+    demo_mode: True,
+    demo_store: Some(store),
+    auth: Success(demo_store.landlord(store)),
+  )
+}
+
+pub fn demo_entry_shows_dashboard_test() {
+  let m = demo_model()
+  // The view renders the dashboard shell without any auth gate.
+  let sim =
+    simulate.start(
+      simulate.application(
+        init: fn(_) { #(m, effect.none()) },
+        update: client.update,
+        view: client.view,
+      ),
+      Nil,
+    )
+  let html = simulate.view(sim) |> element.to_string
+  html |> string.contains("page-dashboard") |> should.be_true
+  html |> string.contains("demo-banner") |> should.be_true
+}
+
+pub fn demo_dashboard_resolves_test() {
+  let m = demo_model()
+  // Request message → demo dispatch (model flips to Loading).
+  let #(requested, _) = client.update(m, msg.AppRequestedDashboardData)
+  case requested.vacancies {
+    Loading -> Nil
+    _ -> should.fail()
+  }
+  // The store's dashboard data, fed through the real response handler.
+  let #(vacancies, stats) =
+    demo_store.dashboard(m.demo_store |> should_be_some_store)
+  let #(resolved, _) =
+    client.update(
+      requested,
+      msg.ApiReturnedDashboardData(Ok(#(vacancies, stats))),
+    )
+  case resolved.vacancies {
+    Success(list) -> list.length(list) |> should.equal(2)
+    _ -> should.fail()
+  }
+  case resolved.dashboard_stats {
+    Success(stats) -> stats.active_vacancies |> should.equal(2)
+    _ -> should.fail()
+  }
+}
+
+fn should_be_some_store(
+  opt: Option(demo_store.DemoStore),
+) -> demo_store.DemoStore {
+  case opt {
+    Some(s) -> s
+    None -> panic as "demo store missing"
+  }
+}
+
+pub fn demo_vacancy_detail_and_leaderboard_resolve_test() {
+  let m = demo_model()
+  let #(requested, _) =
+    client.update(m, msg.AppRequestedVacancyDetail("v-maples"))
+  case requested.vacancy_detail {
+    Loading -> Nil
+    _ -> should.fail()
+  }
+  let store = should_be_some_store(requested.demo_store)
+  let detail = demo_store.vacancy_detail(store, "v-maples") |> should.be_ok
+  let leaderboard = demo_store.leaderboard(store, "v-maples") |> should.be_ok
+  let #(resolved, _) =
+    client.update(requested, msg.ApiReturnedVacancyDetail(Ok(detail)))
+    |> pair_second_then_update(msg.ApiReturnedLeaderboard(Ok(leaderboard)))
+  case resolved.vacancy_detail {
+    Success(d) -> d.property_name |> should.equal("The Maples")
+    _ -> should.fail()
+  }
+  case resolved.leaderboard {
+    Success(entries) -> list.length(entries) |> should.equal(8)
+    _ -> should.fail()
+  }
+}
+
+fn pair_second_then_update(
+  pair: #(model.Model, Effect(msg.Msg)),
+  next: msg.Msg,
+) -> #(model.Model, Effect(msg.Msg)) {
+  client.update(pair.0, next)
+}
+
+pub fn demo_application_detail_resolves_test() {
+  let m = demo_model()
+  let #(requested, _) =
+    client.update(m, msg.AppRequestedApplicationDetail("v-maples", "a-aoife"))
+  let store = should_be_some_store(requested.demo_store)
+  let detail =
+    demo_store.application_detail(store, "v-maples", "a-aoife")
+    |> should.be_ok
+  let #(resolved, _) =
+    client.update(requested, msg.ApiReturnedApplicationDetail(Ok(detail)))
+  case resolved.application_detail {
+    Success(d) -> d.application.first_name |> should.equal("Aoife")
+    _ -> should.fail()
+  }
+}
+
+/// Reset re-seeds the store and restores a clean dashboard — the
+/// non-persistence contract (refresh = reset; "Reset demo" = same).
+pub fn demo_reset_wipes_state_test() {
+  let m = demo_model()
+  // Mutate: archive a vacancy through the store + response path.
+  let store = should_be_some_store(m.demo_store)
+  let #(mutated, _) = demo_store.archive_vacancy(store, "v-harbour")
+  let mutated_model = model.Model(..m, demo_store: Some(mutated))
+  // Reset re-seeds the store (a fresh seed is a DIFFERENT record — proving
+  // the reset happened) and re-populates the dashboard.
+  let #(after_reset, _) = client.update(mutated_model, msg.UserClickedResetDemo)
+  after_reset.demo_store |> should.be_some
+  let after = should_be_some_store(after_reset.demo_store)
+  let #(vacancies, _) = demo_store.dashboard(after)
+  list.length(vacancies) |> should.equal(2)
+}
+
+/// A demo user leaving the demo (e.g. to the landing page) exits cleanly.
+pub fn demo_exit_clears_demo_state_test() {
+  let m = demo_model()
+  let #(exited, _) = client.update(m, msg.UserClickedLogout)
+  exited.demo_mode |> should.be_false
+  exited.demo_store |> should.be_none
+}
+
+/// The demo never touches the real api modules: every demo request message
+/// is intercepted by demo_update (this test asserts the request handlers do
+/// NOT fall through to update_inner's real api dispatch — the Loading state
+/// change proves the demo branch ran).
+pub fn demo_requests_are_intercepted_test() {
+  let m = demo_model()
+  let #(dash, _) = client.update(m, msg.AppRequestedDashboardData)
+  case dash.vacancies {
+    Loading -> Nil
+    _ -> should.fail()
+  }
+  let #(archived, _) = client.update(m, msg.AppRequestedArchivedVacancies)
+  case archived.archived_vacancies {
+    Loading -> Nil
+    _ -> should.fail()
+  }
+  let #(notif, _) = client.update(m, msg.AppRequestedNotifications)
+  case notif.notifications {
+    Loading -> Nil
+    _ -> should.fail()
+  }
+}
diff --git a/client/test/demo/fixtures_conformance_test.gleam b/client/test/demo/fixtures_conformance_test.gleam
new file mode 100644
index 00000000..693e3ef2
--- /dev/null
+++ b/client/test/demo/fixtures_conformance_test.gleam
@@ -0,0 +1,142 @@
+//// Demo-mode fixture conformance — the drift guard (acceptance criterion 4).
+////
+//// Every fixture JSON string is parsed through the PRODUCTION `shared/`
+//// decoder for its type. If the real API shape evolves (a field renames, a
+//// new required key appears, an enum grows), these decodes fail and
+//// `make test` goes red — the demo cannot silently rot next to the live
+//// product.
+////
+//// The same decodes run at /demo entry (`demo_store.seed`), so a drifted
+//// fixture is caught here AND at runtime entry.
+
+import demo/demo_fixtures
+import demo/demo_store
+import gleam/json
+import gleam/list
+import gleeunit/should
+import shared/application
+import shared/application_detail
+
+pub fn landlord_fixture_decodes_test() {
+  let landlord = demo_fixtures.seed_landlord() |> should.be_ok
+  landlord.name |> should.equal("Sarah Mitchell")
+  // accepted_policy_version must match the current server policy version or
+  // the re-acceptance modal would fire inside the demo.
+  landlord.accepted_policy_version |> should.equal("2026-05-23")
+}
+
