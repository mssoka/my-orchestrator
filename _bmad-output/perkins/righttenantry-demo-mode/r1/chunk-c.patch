+pub fn demo_store_application_detail_round_trip_test() {
+  let store = demo_store.seed() |> should.be_ok
+  let detail =
+    demo_store.application_detail(store, "v-maples", "a-aoife")
+    |> should.be_ok
+  detail.application.first_name |> should.equal("Aoife")
+  detail.ai_analysis |> should.be_some
+  list.length(detail.documents) |> should.equal(4)
+  list.length(detail.reference_calls) |> should.equal(2)
+  list.length(detail.audit_trail) |> should.equal(4)
+
+  // Round-trip through the production ENCODER + DECODER — if the
+  // ApplicationDetail codec shape drifts, this fails even though the typed
+  // construction still compiles.
+  let json_str =
+    detail
+    |> application_detail.encode
+    |> json.to_string
+  case json.parse(json_str, application_detail.decoder()) {
+    Ok(round_tripped) -> round_tripped.application.id |> should.equal("a-aoife")
+    Error(_) -> should.fail()
+  }
+}
