+
+/// Mutations stay pure and derive consistently (single source of truth).
+pub fn demo_store_mutations_test() {
+  let store = demo_store.seed() |> should.be_ok
+  // Archive the second active vacancy → dashboard drops to 1 active.
+  let #(after_archive, _) = demo_store.archive_vacancy(store, "v-harbour")
+  let #(vacancies, _) = demo_store.dashboard(after_archive)
+  list.length(vacancies) |> should.equal(1)
+  // Restore brings it back.
+  let #(after_restore, _) =
+    demo_store.restore_vacancy(after_archive, "v-harbour")
+  let #(vacancies2, _) = demo_store.dashboard(after_restore)
+  list.length(vacancies2) |> should.equal(2)
+  // Status change updates the application + appends an audit entry.
+  let #(after_status, _) =
+    demo_store.set_status(after_restore, "v-maples", "a-sara", "shortlisted")
+  let detail =
+    demo_store.application_detail(after_status, "v-maples", "a-sara")
+    |> should.be_ok
+  detail.application.status |> should.equal(application.Shortlisted)
+  list.length(detail.audit_trail) |> should.equal(3)
+  // submitted + analysis + change
+}
