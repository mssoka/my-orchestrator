+package core
+
+// demolish_test.odin — the Story 2.3 contracts as durable tests (arch §6.1/§6.2,
+// §11.7 edge-cases E1/E2/E27/E29, ODN-10/11). Pins:
+//   (a) E2  — terminal-node demolish is rejected with .Terminal_Demolish;
+//   (b) E27 — junction demolish is an ATOMIC BATCH (incident pipes first in
+//             pipe-id order, then the vertex; one topology_apply_edit call);
+//   (c) E1  — graceful shrink: demolishing one bundle member shrinks the pooled
+//             capacity + traffic continues; only FULL-BUNDLE-LOSS drops the
+//             route;
+//   (d) E29 — a packet on a demolished pipe re-forwards from the DEPARTURE
+//             junction (not its origin) against the rebuilt table (the per-hop-
+//             forwarding payoff; no stale spawn-time route);
+//   (e) E11 — demolished entity ids are monotonic + never recycled;
+//   (f)     — missing/dead demolish targets reject with typed errors;
+//   (g) E10 — a demolish mid-traversal replays byte-identical (the T1 keystone);
+//   (h)     — the new command tags (2/3) survive the ODN-11 binary round-trip.
+//
+// The self-review lens (bmad-review-edge-case-hunter) targets (b) the atomic-
+// batch ordering, (d) the E29 no-stale-route, and (g) determinism over a
+// demolish mid-traversal — all pinned here at the lowest layer. Reuses the
+// shared test helpers (test_catalog / test_seed_fixture / record_run / clone_log
+// / draw / step_n / count_arrived / step_once / bundles_slot_for_pair) defined
+// in the sibling *_test.odin files (one core test package).
+
+import "core:testing"
+
+// demolish_pipe — log a Demolish_Pipe command at apply_tick (applied by step_n
+// at that tick). Mirrors `draw` (flow_test). The pipe id is deterministic from
+// draw order: next_pipe_id starts at 0 and climbs per draw, never recycles
+// (E11), so the Nth drawn pipe has id N-1.
+demolish_pipe :: proc(s: ^Run_State, apply_tick: u64, pipe_id: u32) {
+	append(&s.action_log, Command{apply_tick = apply_tick, kind = Cmd_Demolish_Pipe{pipe = pipe_id}})
+}
+
+// demolish_node — log a Demolish_Node command at apply_tick (applied by step_n).
+demolish_node :: proc(s: ^Run_State, apply_tick: u64, node_id: u32) {
+	append(&s.action_log, Command{apply_tick = apply_tick, kind = Cmd_Demolish_Node{node = node_id}})
+}
+
+@(test)
+test_demolish_terminal_rejected :: proc(t: ^testing.T) {
+	// E2: a terminal node (the demand endpoints — residential / content_host)
+	// cannot be demolished. Both terminals in the fixture reject with the typed
+	// .Terminal_Demolish error and mutate nothing.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, _, host := flow_setup(cat)
+	defer run_destroy(&s)
+	// residential (a source terminal)
+	_, err_res := topology_apply_edit(&s.topology, Command{1, Cmd_Demolish_Node{node = res}}, cat)
+	testing.expectf(t, err_res == .Terminal_Demolish,
+		"demolishing a residential terminal must reject with .Terminal_Demolish, got %v", err_res)
+	// content_host (a sink terminal)
+	_, err_host := topology_apply_edit(&s.topology, Command{1, Cmd_Demolish_Node{node = host}}, cat)
+	testing.expectf(t, err_host == .Terminal_Demolish,
+		"demolishing a content_host terminal must reject with .Terminal_Demolish, got %v", err_host)
+	// a rejected demolish mutates nothing: all three fixture nodes still live
+	testing.expectf(t, node_count(&s.topology) == 3,
+		"a rejected terminal-demolish must mutate nothing, got %d live nodes", node_count(&s.topology))
+}
+
+@(test)
+test_demolish_junction_atomic_batch :: proc(t: ^testing.T) {
+	// E27: demolishing a JUNCTION is an atomic batch — its incident pipes are
+	// demolished first (pipe-id order, each per E1), THEN the vertex — in ONE
+	// topology_apply_edit transaction. The fixture's router has two incident
+	// pipes (res-rt, rt-host); after the demolish, BOTH pipes + the router are
+	// tombstoned while the two terminals survive. (The incident-pipe ORDER is a
+	// determinism property — pipe-id/slot order, a pure function of the topology
+	// at apply time — pinned by the replay-keystone test below.)
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, host := flow_setup(cat)
+	defer run_destroy(&s)
+	std, _ := pipe_tier_index(cat, "standard")
+	_, e1 := topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{res, rt, std}}, cat)
+	_, e2 := topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{rt, host, std}}, cat)
+	testing.expectf(t, e1 == .None && e2 == .None, "both incident draws must apply")
+	testing.expectf(t, pipe_count(&s.topology) == 2, "two pipes drawn, got %d", pipe_count(&s.topology))
+
+	// ONE demolish command removes the router AND both incident pipes atomically
+	r, err := topology_apply_edit(&s.topology, Command{1, Cmd_Demolish_Node{node = rt}}, cat)
+	testing.expectf(t, err == .None, "junction demolish must apply, got %v", err)
+	testing.expectf(t, r.ok && r.id == rt, "the result carries the demolished node id, got ok=%v id=%d", r.ok, r.id)
+	testing.expectf(t, pipe_count(&s.topology) == 0,
+		"the atomic batch tombstoned BOTH incident pipes, got %d live pipes", pipe_count(&s.topology))
+	// the router is gone; the two terminals survive
+	rt_slot, rt_live := node_slot(&s.topology, rt)
+	testing.expectf(t, !rt_live, "the router is tombstoned (slot %d alive=false)", rt_slot)
+	testing.expectf(t, node_count(&s.topology) == 2,
+		"the two terminals survive the junction demolish, got %d live nodes", node_count(&s.topology))
+	_, res_live := node_slot(&s.topology, res)
+	_, host_live := node_slot(&s.topology, host)
+	testing.expect(t, res_live && host_live, "res + host survive")
+	// a junction with NO incident pipes is still a legal (trivial) batch
+	s2, _, rt2, _ := flow_setup(cat)
+	defer run_destroy(&s2)
+	_, err2 := topology_apply_edit(&s2.topology, Command{1, Cmd_Demolish_Node{node = rt2}}, cat)
+	testing.expectf(t, err2 == .None, "an isolated junction demolish (no incident pipes) is a legal trivial batch, got %v", err2)
+}
+
+@(test)
+test_demolish_junction_drops_in_flight_packet :: proc(t: ^testing.T) {
+	// E1 "drop" half + E27: a packet heading AWAY from a junction (on an edge
+	// departing it) when the junction is demolished cannot reroute — its
+	// departure node is gone. The E29 re-forward drops it back to the (now-dead)
+	// junction, and the cull removes it (a silent proxy for the full-game
+	// Packet_Dropped{severance}, arch §6.2 — slice 3 adds the event + SLA). The
+	// packet does NOT linger as a phantom at a tombstoned node.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, host := flow_setup(cat)
+	defer run_destroy(&s)
+	std, _ := pipe_tier_index(cat, "standard")
+	topology_apply_edit(&s.topology, Command{0, Cmd_Draw_Pipe{res, rt, std}}, cat)
+	topology_apply_edit(&s.topology, Command{0, Cmd_Draw_Pipe{rt, host, std}}, cat)
+	flow_seed_demand(&s.flow, 1, res, host)
+	// catch the packet on the rt->host pipe (heading away from rt), then demolish
+	// the rt junction (the E27 batch tombstones res-rt + rt-host + rt itself).
+	demolished := false
+	for tick in u64(1)..=14 {
+		step(&s, tick, {}, cat)
+		if !demolished {
+			for i in 0..<len(s.flow.packets) {
+				p := &s.flow.packets[i]
+				if !p.delivered && p.on_edge && p.heading == host {
+					topology_apply_edit(&s.topology, Command{tick, Cmd_Demolish_Node{node = rt}}, cat)
+					demolished = true
+					break
+				}
+			}
+		}
+	}
+	testing.expectf(t, demolished, "the scenario must catch the packet heading away from rt (non-vacuous)")
+	for tick in u64(15)..=18 { step(&s, tick, {}, cat) } // let the cull + settle converge
+	// THE cull assertion: the packet is GONE (not lingering at the dead junction)
+	testing.expectf(t, count_arrived(&s) == 0, "the packet did not deliver (it was dropped), got %d", count_arrived(&s))
+	testing.expectf(t, len(s.flow.packets) == 0,
+		"the packet stranded at the demolished junction is CULLED (no phantom), got %d in-flight", len(s.flow.packets))
+	// the junction + its incident pipes are gone (the E27 batch)
+	_, rt_live := node_slot(&s.topology, rt)
+	testing.expectf(t, !rt_live, "rt is tombstoned")
+	testing.expectf(t, pipe_count(&s.topology) == 0, "both incident pipes tombstoned, got %d", pipe_count(&s.topology))
+}
+
+@(test)
+test_demolish_missing_targets_rejected :: proc(t: ^testing.T) {
+	// A demolish of a dead / unknown entity is a typed rejection (never silent
+	// success). An honestly-recorded action log never hits this (the id was live
+	// at record time + replay is deterministic), but the app's Command_Bus guard
+	// + a belt-and-braces replay check both rely on the typed error.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, _ := flow_setup(cat)
+	defer run_destroy(&s)
+	std, _ := pipe_tier_index(cat, "standard")
+	rd, _ := topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{res, rt, std}}, cat)
+	testing.expectf(t, rd.ok, "draw must apply")
+	// an unknown pipe id
+	_, err_unknown := topology_apply_edit(&s.topology, Command{1, Cmd_Demolish_Pipe{pipe = 9999}}, cat)
+	testing.expectf(t, err_unknown == .Missing_Pipe, "unknown pipe id -> .Missing_Pipe, got %v", err_unknown)
+	// demolish the live pipe, then demolish it AGAIN (now dead) -> .Missing_Pipe
+	_, err_first := topology_apply_edit(&s.topology, Command{1, Cmd_Demolish_Pipe{pipe = rd.id}}, cat)
+	testing.expectf(t, err_first == .None, "first demolish of a live pipe applies, got %v", err_first)
+	_, err_again := topology_apply_edit(&s.topology, Command{1, Cmd_Demolish_Pipe{pipe = rd.id}}, cat)
+	testing.expectf(t, err_again == .Missing_Pipe,
+		"a second demolish of the now-dead pipe -> .Missing_Pipe, got %v", err_again)
+	// an unknown node id
+	_, err_node := topology_apply_edit(&s.topology, Command{1, Cmd_Demolish_Node{node = 9999}}, cat)
+	testing.expectf(t, err_node == .Missing_Node, "unknown node id -> .Missing_Node, got %v", err_node)
+}
+
+@(test)
+test_demolish_pipe_mid_traversal_reforwards_at_departure :: proc(t: ^testing.T) {
+	// E29 (2.3, now live): a packet on a demolished pipe re-forwards from the
+	// DEPARTURE junction (the node it just left), NOT its original source —
+	// against the rebuilt table. This is the per-hop-forwarding payoff the
+	// prototype's spawn-cached BFS could not do. We catch the packet mid-
+	// traversal on the rt->host pipe, demolish that pipe, and assert the packet
+	// drops to `rt` (the departure) — the old buggy path (at_node = p.src) would
+	// have left it at `res`. The linear fixture has no alternate, so no delivery
+	// (the reroute-via-survivor case is the bundle test below).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, host := flow_setup(cat)
+	defer run_destroy(&s)
+	std, _ := pipe_tier_index(cat, "standard")
+	// draw res->rt (pipe 0) + rt->host (pipe 1) immediately; the first step
+	// rebuilds the table on the gen change.
+	topology_apply_edit(&s.topology, Command{0, Cmd_Draw_Pipe{res, rt, std}}, cat)
+	topology_apply_edit(&s.topology, Command{0, Cmd_Draw_Pipe{rt, host, std}}, cat)
+	flow_seed_demand(&s.flow, 1, res, host)
+	// step tick-by-tick; the moment the packet is ON the rt->host pipe
+	// (on_edge, heading=host), demolish pipe 1. Then keep stepping so the
+	// dropped packet settles at the departure.
+	demolished := false
+	for tick in u64(1)..=14 {
+		step(&s, tick, {}, cat)
+		if !demolished {
+			for i in 0..<len(s.flow.packets) {
+				p := &s.flow.packets[i]
+				if !p.delivered && p.on_edge && p.heading == host {
+					topology_apply_edit(&s.topology, Command{tick, Cmd_Demolish_Pipe{pipe = 1}}, cat)
+					demolished = true
+					break
+				}
+			}
+		}
+	}
+	testing.expectf(t, demolished, "the scenario must catch the packet mid-traversal (non-vacuous)")
+	// THE E29 assertion: the packet waits at the DEPARTURE junction (rt), NOT at
+	// its original source (res). The old at_node=p.src path would fail here.
+	testing.expectf(t, count_arrived(&s) == 0,
+		"no delivery — the only rt->host pipe is gone, got %d", count_arrived(&s))
+	testing.expectf(t, len(s.flow.packets) == 1,
+		"the packet is still in flight (waiting at the departure), got %d", len(s.flow.packets))
+	testing.expectf(t, s.flow.packets[0].at_node == rt,
+		"E29: the packet re-forwards from the DEPARTURE junction rt=%d, not the source res=%d; got at_node=%d",
+		rt, res, s.flow.packets[0].at_node)
+	testing.expectf(t, !s.flow.packets[0].on_edge, "the dropped packet is resident at the departure, not on an edge")
+	// and the route is genuinely gone (full-bundle-loss of a 1-member bundle)
+	testing.expectf(t, !routing_has_path(&s.routing, &s.topology, rt, host),
+		"after the only rt->host pipe is demolished, rt cannot reach host")
+}
+
+@(test)
+test_demolish_bundle_member_graceful_shrink_continues :: proc(t: ^testing.T) {
+	// E1 graceful shrink + E29 reroute-via-survivor: a 2-pipe bundle rt->host
+	// (pooled cap 30) carries a packet. Demolish the bundle's REPRESENTATIVE
+	// member mid-traversal — the packet drops to rt, the bundle rebuilds to 1
+	// member (cap shrinks 30 -> 15), and the packet RE-FORWARDS via the survivor
+	// + still delivers. Traffic continues (no hard cut); only the capacity
+	// shrinks. The delivery itself proves the re-forward (the only way to reach
+	// host after the representative was demolished is via the survivor member).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, host := flow_setup(cat)
+	defer run_destroy(&s)
+	std, _ := pipe_tier_index(cat, "standard")
+	// res->rt (pipe 0), then TWO rt->host pipes (pipe 1 = the representative,
+	// pipe 2 = the survivor) — a 2-member bundle (pooled cap 30).
+	draw(&s, 1, res, rt, std)
+	draw(&s, 1, rt, host, std)
+	draw(&s, 1, rt, host, std)
+	// demolish the representative (pipe 1) at tick 5 — the packet forwarded onto
+	// it at tick 4, so tick 5 catches it mid-traversal (the demolish applies
+	// before the tick's flow, dropping the packet back to rt).
+	demolish_pipe(&s, 5, 1)
+	flow_seed_demand(&s.flow, 1, res, host)
+	step_n(&s, 15, cat)
+	// traffic CONTINUES: the packet delivers despite the mid-traversal demolish
+	testing.expectf(t, count_arrived(&s) == 1,
+		"graceful shrink: the packet still delivers after the representative is demolished, got %d", count_arrived(&s))
+	// the bundle GRACEFULLY SHRANK: 1 survivor member, pooled cap 15 (was 30)
+	bs, ok := bundles_slot_for_pair(&s.bundles, min(rt, host), max(rt, host))
+	testing.expectf(t, ok, "the rt->host bundle survives the partial demolish")
+	testing.expectf(t, s.bundles.bundle_count[bs] == 1,
+		"one survivor member, got count %d", s.bundles.bundle_count[bs])
+	testing.expectf(t, s.bundles.bundle_cap[bs] == 15,
+		"the pooled cap shrank 30 -> 15 (one standard member), got %d", s.bundles.bundle_cap[bs])
+}
+
+@(test)
+test_demolish_full_bundle_loss_drops_route :: proc(t: ^testing.T) {
+	// E1: only FULL-BUNDLE-LOSS drops the route. A 2-member bundle rt->host;
+	// demolish ONE member -> the route survives (1 hop still); demolish the
+	// OTHER -> the route is gone (no pipe between rt and host). The graceful
+	// intermediate (1 member, route still up) is the whole point of "only
+	// full-bundle-loss drops."
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, host := flow_setup(cat)
+	defer run_destroy(&s)
+	std, _ := pipe_tier_index(cat, "standard")
+	topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{res, rt, std}}, cat) // pipe 0
+	topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{rt, host, std}}, cat) // pipe 1
+	topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{rt, host, std}}, cat) // pipe 2 (bundle of 2)
+	step_once(&s, cat)
+	testing.expectf(t, routing_has_path(&s.routing, &s.topology, rt, host),
+		"baseline: rt reaches host through the 2-member bundle")
+	// demolish ONE member -> the route SURVIVES (graceful; 1 member left)
+	topology_apply_edit(&s.topology, Command{1, Cmd_Demolish_Pipe{pipe = 1}}, cat)
+	step_once(&s, cat)
+	testing.expectf(t, routing_has_path(&s.routing, &s.topology, rt, host),
+		"after ONE member demolished the route SURVIVES (graceful, not a hard cut)")
+	bs, ok := bundles_slot_for_pair(&s.bundles, min(rt, host), max(rt, host))
+	testing.expectf(t, ok && s.bundles.bundle_cap[bs] == 15,
+		"the bundle shrunk to 1 member (cap 15), got ok=%v cap=%d", ok, s.bundles.bundle_cap[bs])
+	// demolish the OTHER member -> FULL-BUNDLE-LOSS -> the route DROPS
+	topology_apply_edit(&s.topology, Command{1, Cmd_Demolish_Pipe{pipe = 2}}, cat)
+	step_once(&s, cat)
+	testing.expectf(t, !routing_has_path(&s.routing, &s.topology, rt, host),
+		"after BOTH members demolished (full-bundle-loss) the route DROPS")
+	// the bundle for the pair is gone (no live pipe between rt and host)
+	bs2, ok2 := bundles_slot_for_pair(&s.bundles, min(rt, host), max(rt, host))
+	testing.expectf(t, !ok2, "the rt->host bundle is gone after full-bundle-loss, got ok=%v slot=%d", ok2, bs2)
+}
+
+@(test)
+test_demolish_ids_monotonic_never_recycled :: proc(t: ^testing.T) {
+	// E11: demolished entity ids are monotonic + NEVER recycled. Demolish a
+	// pipe, then draw a new one -> the new id is the NEXT monotonic value, not
+	// the recycled tombstone. Same for nodes. (Tombstones ride the T1 hash via
+	// the alive flags + the monotonic next_*_id counters, so replay reproduces
+	// the id sequence byte-identically.)
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, host := flow_setup(cat)
+	defer run_destroy(&s)
+	std, _ := pipe_tier_index(cat, "standard")
+	r0, _ := topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{res, rt, std}}, cat)  // pipe 0
+	r1, _ := topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{rt, host, std}}, cat) // pipe 1
+	testing.expectf(t, r0.id == 0 && r1.id == 1, "first two pipes are ids 0,1, got %d,%d", r0.id, r1.id)
+	// demolish pipe 0; a new draw must NOT reuse id 0
+	topology_apply_edit(&s.topology, Command{1, Cmd_Demolish_Pipe{pipe = 0}}, cat)
+	r2, _ := topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{res, rt, std}}, cat)
+	testing.expectf(t, r2.id == 2,
+		"the new pipe is id 2 (next monotonic; id 0 is NOT recycled), got %d", r2.id)
+	testing.expectf(t, s.topology.next_pipe_id == 3, "next_pipe_id kept climbing to 3, got %d", s.topology.next_pipe_id)
+	// node ids: demolish the router (id 1), spawn a new router -> id 3 (not 1)
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	topology_apply_edit(&s.topology, Command{1, Cmd_Demolish_Node{node = rt}}, cat)
+	new_rt := topology_spawn_node(&s.topology, rt_idx, {25, 18}, cat)
+	testing.expectf(t, new_rt == 3,
+		"the new router is id 3 (next monotonic; id 1 is NOT recycled), got %d", new_rt)
+	testing.expectf(t, s.topology.next_node_id == 4, "next_node_id kept climbing to 4, got %d", s.topology.next_node_id)
+}
+
+@(test)
+test_demolish_replay_byte_identical :: proc(t: ^testing.T) {
+	// THE determinism keystone over a demolish mid-traversal (Story 2.3's named
+	// golden, [E10, ODN-10/11]): re-step (seed, action_log, demand) twice ->
+	// byte-identical per-tick hash sequence. The demolish rides the action log
+	// (a logged command like draw), so replay re-applies it at its tick; the
+	// post-demolish topology (tombstones + the bumped next_*_id counters) rides
+	// the T1 hash, so a non-deterministic batch order or re-forward would
+	// diverge here. The scenario also pins E27's ordering determinism (the
+	// junction batch re-derives its incident-pipe set identically on replay).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	std, _ := pipe_tier_index(cat, "standard")
+
+	live: Run_State
+	defer run_destroy(&live)
+	run_init(&live, 7, cat.hash, TEST_LOGIC_HZ)
+	res, rt, host := test_seed_fixture(&live, cat)
+	// a richer fixture: two routers so a junction demolish + a bundle partial
+	// loss both exercise the batch + the shrink in one replay
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	rt2 := topology_spawn_node(&live.topology, rt_idx, {26, 15}, cat) // a 4th node (id 3)
+	// draws: res->rt, rt->host x2 (bundle), rt->rt2 (so rt has 3 incident pipes
+	// when it's demolished — a non-trivial E27 batch in pipe-id order)
+	append(&live.action_log, Command{1, Cmd_Draw_Pipe{res, rt, std}})
+	append(&live.action_log, Command{1, Cmd_Draw_Pipe{rt, host, std}})  // pipe 1
+	append(&live.action_log, Command{1, Cmd_Draw_Pipe{rt, host, std}})  // pipe 2 (bundle)
+	append(&live.action_log, Command{1, Cmd_Draw_Pipe{rt, rt2, std}})   // pipe 3
+	// a pipe demolish mid-flow (pipe 1 — the bundle representative) + a junction
+	// demolish (rt — the atomic batch tombstones pipes 0,2,3 then rt)
+	append(&live.action_log, Command{30, Cmd_Demolish_Pipe{pipe = 1}})
+	append(&live.action_log, Command{60, Cmd_Demolish_Node{node = rt}})
+	flow_seed_demand(&live.flow, 1, res, host)
+
+	live_hashes := record_run(&live, 90, cat)
+	defer delete(live_hashes)
+	// sanity: the demolishes actually fired (topology shrank) + no replay error
+	testing.expectf(t, !live.replay_error, "live run must not latch replay_error")
