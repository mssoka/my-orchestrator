+	append(&state.action_log, Command{apply_tick = 1, kind = Cmd_Draw_Pipe{a = res, b = rt, tier = std}})
+	append(&state.action_log, Command{apply_tick = 1, kind = Cmd_Draw_Pipe{a = rt, b = host, tier = std}})
+	append(&state.action_log, Command{apply_tick = 50, kind = Cmd_Demolish_Pipe{pipe = 1}})
+	append(&state.action_log, Command{apply_tick = 80, kind = Cmd_Demolish_Node{node = rt}})
+
+	bytes := log_write(&state, context.temp_allocator)
+	header, cmds, ok := log_read(bytes, context.temp_allocator)
+	testing.expectf(t, ok, "round-trip must parse")
+	testing.expectf(t, header.seed == 42, "header seed: got %d, want 42", header.seed)
+	testing.expectf(t, len(cmds) == 4, "4 commands survived, got %d", len(cmds))
+	// command 0 + 1: draw pipes
+	testing.expectf(t, cmds[0].kind.(Cmd_Draw_Pipe).a == res, "cmd 0 is the draw")
+	// command 2: demolish pipe (tag 2)
+	dp := cmds[2].kind.(Cmd_Demolish_Pipe)
+	testing.expectf(t, dp.pipe == 1, "cmd 2 is Demolish_Pipe{pipe=1}, got %d", dp.pipe)
+	// command 3: demolish node (tag 3)
+	dn := cmds[3].kind.(Cmd_Demolish_Node)
+	testing.expectf(t, dn.node == rt, "cmd 3 is Demolish_Node{node=rt=%d}, got %d", rt, dn.node)
+	// defined rejections still hold
+	_, _, truncated := log_read(bytes[:len(bytes)-1], context.temp_allocator)
+	testing.expect(t, !truncated, "truncated log must reject")
+	// an unknown tag (0xFF) at the first record's tag byte still rejects
+	tagbytes := make([]u8, len(bytes), context.temp_allocator)
+	copy(tagbytes, bytes)
+	// header = magic4 + ver4 + seed8 + era1 + catalog_hash8 + logic_hz4 + count4
+	// = 33 bytes; first record = apply_tick(u64) at 33..41, tag at byte 41.
+	tagbytes[41] = 0xFF
+	_, _, bad_tag := log_read(tagbytes, context.temp_allocator)
+	testing.expect(t, !bad_tag, "unknown command tag must reject")
+}
