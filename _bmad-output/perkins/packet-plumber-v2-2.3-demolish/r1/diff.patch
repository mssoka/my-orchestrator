+// --- demolish (Story 2.3 — edge-cases E1/E2/E27/E29) -------------------------
+// Demolish is a logged command like draw: validate→apply, recorded in the
+// action log, replay-reapplied at its tick. A demolish TOMBSTONES the entity
+// (alive=false; ids are monotonic + never recycled — E11) and bumps gen so the
+// forwarding table + bundle view rebuild at the next step (rule 1). That
+// rebuild IS the routing consequence: a bundle-member demolish shrinks the
+// pooled capacity (graceful — only full-bundle-loss drops the route, E1); a
+// junction demolish is an atomic batch (E27); in-flight packets re-forward at
+// the departure junction against the fresh table (E29 — flow.odin). No new
+// event / no special-casing — the model the slice-1–2.2 spine built, exercised.
+
+// validate_demolish_pipe — the pipe id must resolve to a LIVE pipe. A dead /
+// unknown id rejects with .Missing_Pipe (an honestly-recorded log never hits
+// this — the id was live at record time + replay is deterministic; it is the
+// app's Command_Bus guard + a belt-and-braces replay check).
+validate_demolish_pipe :: proc(t: ^Topology, c: Cmd_Demolish_Pipe) -> Edit_Error {
+	_, ok := pipe_slot(t, c.pipe)
+	if !ok { return .Missing_Pipe }
+	return .None
+}
+
+// apply_demolish_pipe — assumes validate_demolish_pipe returned .None. Tombstones
+// the pipe + bumps gen (the rule-1 rebuild trigger). The routing/bundle
+// consequence (capacity shrink / route drop / in-flight re-forward) is realized
+// by the next rebuild + flow_step — nothing to do here but remove the pipe.
+apply_demolish_pipe :: proc(t: ^Topology, c: Cmd_Demolish_Pipe) {
+	slot, _ := pipe_slot(t, c.pipe)
+	t.pipe_alive[slot] = false
+	t.gen += 1
+}
+
+// validate_demolish_node — the node id must resolve to a LIVE node, and it must
+// NOT be a terminal (E2: terminal demolish is forbidden). Terminals are the
+// demand endpoints (residential / content_host); a junction (router) may be
+// demolished via the atomic batch below.
+validate_demolish_node :: proc(t: ^Topology, c: Cmd_Demolish_Node) -> Edit_Error {
+	slot, ok := node_slot(t, c.node)
+	if !ok { return .Missing_Node }
+	if is_terminal(t, slot) { return .Terminal_Demolish } // E2
+	return .None
+}
+
+// apply_demolish_node — E27 atomic batch. Assumes validate_demolish_node
+// returned .None (live + non-terminal). Tombstones every incident LIVE pipe
+// first — scanned in slot order, which IS pipe-id order (ids are monotonic +
+// appended in slot order, so slot order == id order — deterministic), each per
+// E1 (the reroute/re-forward is automatic via the table rebuild + flow.odin's
+// E29 path) — THEN tombstones the vertex. ONE apply_all transaction, so replay
+// cannot diverge on ordering; gen bumps once (the batch is one topology change;
+// step rebuilds exactly once regardless of how many entities it tombstoned).
+apply_demolish_node :: proc(t: ^Topology, c: Cmd_Demolish_Node) {
+	slot, _ := node_slot(t, c.node)
+	node_id := c.node
+	for pi in 0 ..< len(t.pipe_alive) {
+		if !t.pipe_alive[pi] { continue }
+		_, is_end := pipe_other(t, u32(pi), node_id)
+		if is_end {
+			t.pipe_alive[pi] = false // incident pipe demolished first (per E1)
+		}
+	}
+	t.node_alive[slot] = false // then the vertex
+	t.gen += 1
+}
+
 // topology_apply_edit — the single validate-then-apply entry. Returns the new
-// pipe id on success, or the typed rejection. The app fast-path calls this on
-// mouse-release; the harness/step path calls this from the replayed log.
+// pipe id on a draw / the demolished entity id on a demolish, or the typed
+// rejection. The app fast-path calls this on mouse-release; the harness/step
+// path calls this from the replayed log. Demolish (2.3) joins draw behind the
+// same switch — one legality path, so live edits and replay can never diverge.
 topology_apply_edit :: proc(t: ^Topology, cmd: Command, cat: ^Catalogs) -> (Edit_Result, Edit_Error) {
 	#partial switch c in cmd.kind {
 	case Cmd_Draw_Pipe:
 		if e := validate_draw(t, c, cat); e != .None { return {}, e }
 		id := apply_draw(t, c, cat)
 		return {ok = true, id = id}, .None
+	case Cmd_Demolish_Pipe:
+		if e := validate_demolish_pipe(t, c); e != .None { return {}, e }
+		apply_demolish_pipe(t, c)
+		return {ok = true, id = c.pipe}, .None
+	case Cmd_Demolish_Node:
+		if e := validate_demolish_node(t, c); e != .None { return {}, e }
+		apply_demolish_node(t, c)
+		return {ok = true, id = c.node}, .None
 	}
 	return {}, .Unknown_Command
