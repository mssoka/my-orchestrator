+test_demolish_log_binary_roundtrip :: proc(t: ^testing.T) {
+	// The new command tags (2 = Demolish_Pipe, 3 = Demolish_Node) survive the
+	// ODN-11 binary round-trip byte-for-byte-semantically, and the defined
+	// rejections (truncation, unknown tag) still hold. LOG_VERSION stays 2 —
+	// the new tags are ADDITIVE (an old draw-only log still parses).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
