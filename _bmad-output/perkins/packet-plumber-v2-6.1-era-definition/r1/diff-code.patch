+
+// era.odin — the S6 Era State Machine (arch §6.6, [LATER] seam — now live for
+// Story 6.1). The era FSM owns the ACTIVE era + the ADVANCE mechanic:
+//
+//   - Active era: Run_State.era (run setup / log header start it; the FSM
+//     advances it). Every era-dependent system reads it the same way it
+//     always has — the demand director keys cat.demand.eras[era-1]
+//     (scripted_plan_demand), growth keys era_introduced — so an advance is
+//     ONE state flip with a WHOLE-plan switch by construction.
+//   - Advance request: Cmd_Era_Advance{to_era} — a LOGGED command (the replay
+//     artifact), validated at apply (era_advance_validate) and latched on
+//     state.era_advance_to.
+//   - The fire: era_step (called inside core.step at the reserved S6 seam —
+//     after health_update, before win_lose_eval, per arch §4) executes the
+//     advance when the E14 gate passes: NO ACTIVE CRISIS. An active crisis
+//     DEFERS the advance (state.era_advance_to stays latched) until the
+//     crisis clears — deterministic (the crisis lifecycle is itself replay-
+//     deterministic), and the new era's demand signature never spawns
+//     mid-crisis [E14]. Firing bumps state.era, loads the new era's unlocks
+//     (the roster + infra table ride the catalog; era_step's observable
+//     effect is the era flip + the Era_Advanced event + the demand plan
+//     switching next tick), and clears the latch.
+//
+//   6.2 gate surface: the advance CONDITIONS (sustain SLA >= 95% across the
+//   milestone window AND modernized legacy AND no active crisis — E15) are
+//   story 6.2's scope. 6.2 composes on this seam: it either gates what
+//   REQUESTs an advance (the condition-eval replaces the scripted request as
+//   the trigger) or tightens era_advance_blocked — the request->latch->fire
+//   mechanics pinned here never change.
+//
+//   Determinism (the spine): the request rides the action log (E10 — replay
+//   re-applies the identical command), the deferral is a pure function of the
+//   replay-deterministic crisis registry, and the fire is a pure function of
+//   (log, seed, catalogs) — byte-identical on replay. state.era + the pending
+//   latch ride the T1 hash (serialize.odin — era_advance_to absent-when-0), so
+//   the era-advanced state is itself a golden.
+
+// event_emit_era — append an Era_Advanced event with the NEW era as payload
+// (the Event.class field carries it, tag-conditional — see serialize.odin's
+// w_event_payload; 1..6 fits a u8, class is u16 by the shared-payload idiom).
+event_emit_era :: proc(state: ^Run_State, tick: u64, new_era: u8) {
+	append(&state.events, Event{tick = tick, tag = EVENT_TAG_ERA_ADVANCED, class = u16(new_era)})
+}
+
+// era_advance_validate — the apply-time validation for Cmd_Era_Advance (the
+// command-apply loop in core.step calls this before latching). to_era must be
+// in the era table (1..len(cat.eras)) AND strictly forward (to_era > the era
+// at apply time — an advance to the current or an earlier era is a content /
+// log divergence; a backward advance would corrupt the era arc, never silent).
+era_advance_validate :: proc(state: ^Run_State, c: Cmd_Era_Advance, cat: ^Catalogs) -> Edit_Error {
+	if c.to_era == 0 || int(c.to_era) > len(cat.eras) {
+		return .Invalid_Era_Advance
+	}
+	if c.to_era <= state.era {
+		return .Invalid_Era_Advance
+	}
+	return .None
+}
+
+// era_advance_latch — apply a validated advance request: latch the target era.
+// Last-write-wins (a second request while one is pending replaces the target —
+// deterministic; the MVP's single 2->3 advance never exercises it).
+era_advance_latch :: proc(state: ^Run_State, c: Cmd_Era_Advance) {
+	state.era_advance_to = c.to_era
+}
+
+// era_advance_blocked — the E14 gate: an advance may NOT fire while a crisis
+// is active (an active crisis PRESERVES through the advance — E14's first
+// half; the new era's demand must not spawn mid-crisis — E14's second half).
+// Story 6.2 composes the full advance gate here (sustain-SLA + modernized
+// legacy + no-crisis — E15); the no-crisis term is decided NOW (this story).
+era_advance_blocked :: proc(state: ^Run_State) -> bool {
+	return len(state.crisis.active) > 0
+}
+
+// era_step — the S6 seam (called inside core.step AFTER health_update, BEFORE
+// win_lose_eval — arch §4's reserved slot, [LATER] now live). Executes a
+// pending advance when the E14 gate passes: bumps the active era, loads the
+// new era's unlocks (the roster + infrastructure table are catalog data —
+// validated at load; the demand signature switches by construction: the
+// director reads cat.demand.eras[era-1] on every tick, so the NEXT tick's
+// flow spawns under the new signature), emits Era_Advanced, and clears the
+// latch. Deferred (latch held) while a crisis is active — the fire tick is a
+// pure function of the crisis lifecycle (deterministic).
+era_step :: proc(state: ^Run_State, tick: u64, cat: ^Catalogs) {
+	if state.era_advance_to == 0 {
+		return
+	}
+	if era_advance_blocked(state) {
+		return // E14 — an active crisis defers the advance until it clears
+	}
+	new_era := state.era_advance_to
+	state.era = new_era
+	state.era_advance_to = 0
+	event_emit_era(state, tick, new_era)
+}
diff --git a/core/era_test.odin b/core/era_test.odin
new file mode 100644
index 0000000..c098d24
--- /dev/null
+++ b/core/era_test.odin
@@ -0,0 +1,328 @@
+package core
+
+// era_test.odin — the S6 Era FSM contracts (Story 6.1): the advance mechanic,
+// the E14 deferral, the unlock-table queries, and the replay determinism of
+// the advance event (the story's T1/replay pin, mirrored from the
+// determinism spine's record_run convention).
+
+import "core:testing"
+
+// era_test_catalog — test_catalog + the era table (mirrors data/eras.json for
+// the test rosters; the test catalog's era_introduced values: email=1,
+// streaming=3; nodes residential/router_basic=1, small_biz=2,
+// content_host/campus/router_mid/router_high=3; tiers narrow/standard=1,
+// wide=3). The exact-equality invariants are LOAD-time contracts (pinned in
+// catalog_test.odin); the tests build the table directly. Era 4 exists ONLY
+// in the test table (a forward target for the E14-deferral test — the MVP
+// data stops at era 3; the era table is what the FSM validates against).
+era_test_catalog :: proc(cat: ^Catalogs, allocator := context.allocator) -> ^Catalogs {
+	ei, _ := class_index(cat, "email")
+	si, _ := class_index(cat, "streaming")
+	res, _ := node_type_index(cat, "residential")
+	rt, _ := node_type_index(cat, "router_basic")
+	sb, _ := node_type_index(cat, "small_biz")
+	ch, _ := node_type_index(cat, "content_host")
+	cp, _ := node_type_index(cat, "campus")
+	rm, _ := node_type_index(cat, "router_mid")
+	rh, _ := node_type_index(cat, "router_high")
+	na, _ := pipe_tier_index(cat, "narrow")
+	std, _ := pipe_tier_index(cat, "standard")
+	wd, _ := pipe_tier_index(cat, "wide")
+
+	cat.eras = make([dynamic]Era_Row, 0, 4, allocator)
+	make_row :: proc(cat: ^Catalogs, era: u8, id, display: string, demand_era: u8,
+	                 classes: []u16, nodes: []u16, tiers: []u16) {
+		r: Era_Row
+		r.era = era
+		r.id = id
+		r.display_name = display
+		r.demand_era = demand_era
+		r.packet_classes = make([dynamic]u16, 0, len(classes))
+		for c in classes { append(&r.packet_classes, c) }
+		r.unlock_node_types = make([dynamic]u16, 0, len(nodes))
+		for n in nodes { append(&r.unlock_node_types, n) }
+		r.unlock_pipe_tiers = make([dynamic]u16, 0, len(tiers))
+		for t in tiers { append(&r.unlock_pipe_tiers, t) }
+		append(&cat.eras, r)
+	}
+	make_row(cat, 1, "foundations", "Foundations", 1, {ei}, {res, rt}, {na, std})
+	make_row(cat, 2, "email_web", "Email & Web", 2, {ei}, {res, rt, sb}, {na, std})
+	make_row(cat, 3, "streaming_surge", "The Streaming Surge", 3, {ei, si}, {res, rt, sb, ch, cp, rm, rh}, {na, std, wd})
+	make_row(cat, 4, "real_time", "Real-Time", 3, {ei, si}, {res, rt, sb, ch, cp, rm, rh}, {na, std, wd})
+	return cat
+}
+
+// era_run — a fresh run at `era` with the fixture + standard draws (the
+// demand director needs sinks; the FSM tests need a stepping run).
+era_run :: proc(s: ^Run_State, seed: u64, era: u8, cat: ^Catalogs) {
+	run_init(s, seed, cat.hash, TEST_LOGIC_HZ)
+	s.era = era
+	res, rt, host := test_seed_fixture(s, cat)
+	sla_draw(s, cat, res, rt, "standard", 1)
+	sla_draw(s, cat, rt, host, "standard", 1)
+}
+
+// era_record_run — step a run collecting the FULL event stream (crisis +
+// era + health + ...) + the per-tick hashes, with the ODN-14 drain
+// convention (record_run clears per tick, so the scan must collect as it
+// steps). The E14 test needs the Era_Advanced event, which the crisis-only
+// collector drops.
+era_record_run :: proc(s: ^Run_State, ticks: u64, cat: ^Catalogs) -> ([dynamic]u64, [dynamic]Event) {
+	hashes := make([dynamic]u64, 0, ticks)
+	events := make([dynamic]Event, 0, 8)
+	start := s.tick + 1 // resume from the state's next tick (mid-run callers)
+	for tick in start ..< start + ticks {
+		before := len(s.events)
+		batch := make([dynamic]Command, 0, 4, context.temp_allocator)
+		for cmd in s.action_log {
+			if cmd.apply_tick == tick {
+				append(&batch, cmd)
+			}
+		}
+		step(s, tick, batch[:], cat)
+		for e in s.events[before:] {
+			append(&events, e)
+		}
+		append(&hashes, state_hash(s, s.events[before:], cat, context.temp_allocator))
+		clear(&s.events)
+		free_all(context.temp_allocator)
+	}
+	return hashes, events
+}
+
+@(test)
+test_era_advance_fires_and_switches_demand :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	era_test_catalog(cat)
+	defer catalogs_destroy(cat)
+
+	s: Run_State
+	defer run_destroy(&s)
+	era_run(&s, 42, 2, cat)
+	// the advance REQUEST rides the action log (a logged command — the replay
+	// re-applies it; the flip itself fires in era_step).
+	append(&s.action_log, Command{apply_tick = 100, kind = Cmd_Era_Advance{to_era = 3}})
+
+	hashes := record_run(&s, 200, cat)
+	defer delete(hashes)
+
+	// era 2 -> era 3 exactly once; the latch clears; no replay error.
+	testing.expect_value(t, s.era, u8(3))
+	testing.expect_value(t, s.era_advance_to, u8(0))
+	testing.expect(t, !s.replay_error, "an honest advance must not latch replay_error")
+	// the era-2 ticks hashed with era 2 (tick 99 and before), the era-3 ticks
+	// with era 3 — the flip moved the hash (the era byte rides the T1).
+	testing.expect(t, hashes[98] != hashes[99], "the advance tick must shift the state hash")
+	// the demand signature switched: era 3's demand includes streaming
+	// (content_host source) — the director's plan for the CURRENT era names it.
+	plan := scripted_plan_demand(cat, s.era, 150)
+	defer demand_plan_destroy(&plan)
+	found_streaming := false
+	for e in plan.entries {
+		if e.class == 1 { found_streaming = true }
+	}
+	testing.expect(t, found_streaming, "era 3's demand plan must include the streaming entry")
+}
+
+@(test)
+test_era_advance_e14_deferred_by_crisis :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	era_test_catalog(cat)
+	defer catalogs_destroy(cat)
+
+	// A REAL crisis via the engine (the narrow-path fixture + the era-3 surge
+	// on schedule — the same scenario crisis_test pins): the advance REQUESTED
+	// on the surge tick must be DEFERRED (E14) until the crisis clears, then
+	// fire on the first eligible tick — the deterministic deferral.
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 42, cat.hash, TEST_LOGIC_HZ)
+	s.era = 3
+	crisis_seed_fixture(&s, cat) // narrows res->router (pipe 0) + router->host (pipe 1)
+	append(&s.action_log, Command{apply_tick = 1200, kind = Cmd_Era_Advance{to_era = 4}})
+	// the fix: the flawed narrows demolished @1499 (the whole bottleneck bundle
+	// dies — the engine resolves the crisis via its stable pair identity), the
+	// replacement wides land @1500 (ports 4).
+	append(&s.action_log, Command{apply_tick = 1499, kind = Cmd_Demolish_Pipe{pipe = 0}})
+	append(&s.action_log, Command{apply_tick = 1499, kind = Cmd_Demolish_Pipe{pipe = 1}})
+	sla_draw(&s, cat, 0, 1, "wide", 1500)
+	sla_draw(&s, cat, 0, 1, "wide", 1500)
+	sla_draw(&s, cat, 1, 2, "wide", 1500)
+	sla_draw(&s, cat, 1, 2, "wide", 1500)
+
+	hashes, evs := era_record_run(&s, 2500, cat)
+	defer delete(hashes)
+	defer delete(evs)
+
+	// the crisis triggered on the surge tick (1200) AND the advance was
+	// requested the same tick — the FSM must NOT have fired it (E14: the new
+	// era's demand never spawns mid-crisis). The era stays 3 through the whole
+	// active window; the flip lands on the crisis-CLEAR tick (1499). Filter
+	// the full stream to the events this test owns (the flow/health/warning
+	// events are other stories' streams).
+	filtered := make([dynamic]Event, 0, 8, context.temp_allocator)
+	for e in evs {
+		if e.tag == EVENT_TAG_CRISIS_TRIGGERED || e.tag == EVENT_TAG_CRISIS_RESOLVED || e.tag == EVENT_TAG_ERA_ADVANCED {
+			append(&filtered, e)
+		}
+	}
+	crisis_assert_stream(t, filtered[:], []Event{
+		{tick = 1200, tag = EVENT_TAG_CRISIS_TRIGGERED, archetype = 0, cause = u8(Root_Cause_Kind.Saturated_Bundle), class = 1, target = 1, pipe = 1},
+		{tick = 1499, tag = EVENT_TAG_CRISIS_RESOLVED, archetype = 0, cause = u8(Root_Cause_Kind.Saturated_Bundle), class = 1, target = 1, pipe = 1},
+		{tick = 1499, tag = EVENT_TAG_ERA_ADVANCED, class = 4},
+	})
+	// the era flip must sit AFTER the crisis-resolve tick (never during):
+	// scan the events — no Era_Advanced precedes the resolve.
+	saw_resolve := false
+	for e in filtered {
+		if e.tag == EVENT_TAG_CRISIS_RESOLVED { saw_resolve = true }
+		if e.tag == EVENT_TAG_ERA_ADVANCED {
+			testing.expect(t, saw_resolve, "the advance must not fire before the crisis clears (E14)")
+		}
+	}
+	testing.expect_value(t, s.era, u8(4))
+	testing.expect_value(t, s.era_advance_to, u8(0))
+	testing.expect(t, !s.replay_error, "the E14-deferred advance must not latch replay_error")
+}
+
+@(test)
+test_era_advance_invalid_requests_latch_replay_error :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	era_test_catalog(cat)
+	defer catalogs_destroy(cat)
+
+	// a backward advance (to_era == current) — a log divergence, never silent.
+	s: Run_State
+	defer run_destroy(&s)
+	era_run(&s, 1, 3, cat)
+	step(&s, 1, []Command{{apply_tick = 1, kind = Cmd_Era_Advance{to_era = 3}}}, cat)
+	testing.expect(t, s.replay_error, "a non-forward advance must latch replay_error (ODN-11)")
+	testing.expect_value(t, s.era, u8(3))
+	testing.expect_value(t, s.era_advance_to, u8(0))
+
+	// an out-of-table target (era 5 — the test table stops at 4).
+	s2: Run_State
+	defer run_destroy(&s2)
+	era_run(&s2, 1, 2, cat)
+	step(&s2, 1, []Command{{apply_tick = 1, kind = Cmd_Era_Advance{to_era = 5}}}, cat)
+	testing.expect(t, s2.replay_error, "an out-of-table advance must latch replay_error (ODN-11)")
+	testing.expect_value(t, s2.era, u8(2))
+}
+
+@(test)
+test_era_advance_replay_identity :: proc(t: ^testing.T) {
+	// The story's determinism pin: a run whose action log carries the advance
+	// command must reproduce byte-identical T1 hashes on replay — INCLUDING
+	// the era flip (the era byte + the Era_Advanced event both ride the hash).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	era_test_catalog(cat)
+	defer catalogs_destroy(cat)
+
+	live: Run_State
+	defer run_destroy(&live)
+	era_run(&live, 42, 2, cat)
+	append(&live.action_log, Command{apply_tick = 60, kind = Cmd_Era_Advance{to_era = 3}})
+	live_hashes := record_run(&live, 200, cat)
+	defer delete(live_hashes)
+	testing.expect_value(t, live.era, u8(3))
+	testing.expect(t, !live.replay_error, "live run must not latch replay_error")
+
+	replayed: Run_State
+	defer run_destroy(&replayed)
+	run_init(&replayed, 42, cat.hash, TEST_LOGIC_HZ)
+	replayed.era = 2
+	test_seed_fixture(&replayed, cat) // identical fixture (run setup)
+	delete(replayed.action_log)
+	replayed.action_log = clone_log(live.action_log)
+	replay_hashes := record_run(&replayed, 200, cat)
+	defer delete(replay_hashes)
+
+	testing.expect(t, !replayed.replay_error, "replay must not latch replay_error (ODN-11 critical)")
+	testing.expect_value(t, replayed.era, u8(3))
+	diverged := false
+	for i in 0..<len(live_hashes) {
+		if live_hashes[i] != replay_hashes[i] {
+			diverged = true
+		}
+	}
+	testing.expectf(t, !diverged, "REPLAY DIVERGENCE with the advance command: live vs replay hashes differ")
+}
+
+@(test)
+test_era_advance_deferred_replay_identity :: proc(t: ^testing.T) {
+	// E14's determinism companion: a run whose advance is DEFERRED by a REAL
+	// active crisis (the surge window with no fix — the crisis stays active
+	// the whole run) must stay era-locked in BOTH paths and reproduce
+	// byte-identical T1 hashes (the deferral is a pure function of the
+	// replay-deterministic crisis lifecycle).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	era_test_catalog(cat)
+	defer catalogs_destroy(cat)
+
+	live: Run_State
+	defer run_destroy(&live)
+	run_init(&live, 11, cat.hash, TEST_LOGIC_HZ)
+	live.era = 3
+	crisis_seed_fixture(&live, cat)
+	append(&live.action_log, Command{apply_tick = 1200, kind = Cmd_Era_Advance{to_era = 4}})
+	live_hashes := record_run(&live, 1800, cat)
+	defer delete(live_hashes)
+	testing.expect_value(t, live.era, u8(3)) // E14 — deferred for the whole run
+	testing.expect_value(t, live.era_advance_to, u8(4))
+
+	replayed: Run_State
+	defer run_destroy(&replayed)
+	run_init(&replayed, 11, cat.hash, TEST_LOGIC_HZ)
+	replayed.era = 3
+	crisis_seed_fixture(&replayed, cat) // identical fixture (run setup)
+	delete(replayed.action_log)
+	replayed.action_log = clone_log(live.action_log)
+	replay_hashes := record_run(&replayed, 1800, cat)
+	defer delete(replay_hashes)
+
+	testing.expect_value(t, replayed.era, u8(3))
+	testing.expect(t, !replayed.replay_error, "replay must not latch replay_error (ODN-11 critical)")
+	diverged := false
+	for i in 0..<len(live_hashes) {
+		if live_hashes[i] != replay_hashes[i] {
+			diverged = true
+		}
+	}
+	testing.expectf(t, !diverged, "REPLAY DIVERGENCE under the E14 deferral: live vs replay hashes differ")
+}
+
+@(test)
+test_era_unlock_queries :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	era_test_catalog(cat)
+	defer catalogs_destroy(cat)
+
+	ei, _ := class_index(cat, "email")
+	si, _ := class_index(cat, "streaming")
+	rt, _ := node_type_index(cat, "router_basic")
+	cp, _ := node_type_index(cat, "campus")
+	wd, _ := pipe_tier_index(cat, "wide")
+
+	// the "streaming becomes available" switch: locked in era 2, live in era 3.
+	testing.expect(t, era_class_unlocked(cat, 2, ei), "email must be unlocked in era 2")
+	testing.expect(t, !era_class_unlocked(cat, 2, si), "streaming must be LOCKED in era 2")
+	testing.expect(t, era_class_unlocked(cat, 3, si), "streaming must unlock in era 3")
+	// the infrastructure unlock table.
+	testing.expect(t, era_node_type_unlocked(cat, 2, rt), "router_basic unlocked in era 2")
+	testing.expect(t, !era_node_type_unlocked(cat, 2, cp), "campus LOCKED in era 2 (era_introduced 3)")
+	testing.expect(t, era_node_type_unlocked(cat, 3, cp), "campus unlocks in era 3")
+	testing.expect(t, !era_pipe_tier_unlocked(cat, 2, wd), "wide LOCKED in era 2")
+	testing.expect(t, era_pipe_tier_unlocked(cat, 3, wd), "wide unlocks in era 3")
+	// the era-row boundary: era 0 / beyond-table eras read as not-unlocked.
+	testing.expect(t, !era_class_unlocked(cat, 0, ei), "era 0 unlocks nothing")
+	_, ok := era_row(cat, 0)
+	testing.expect(t, !ok, "era 0 has no row")
+	_, ok = era_row(cat, 5)
+	testing.expect(t, !ok, "era 5 has no row (the test table stops at 4)")
+}
