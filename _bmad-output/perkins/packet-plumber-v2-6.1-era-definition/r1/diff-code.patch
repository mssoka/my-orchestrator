+// --- era lookups (6.1 — the S6 Era FSM's data surface) ----------------------
+
+// era_row — the era table row for `era` (indexed era-1, like demand).
+// ok=false for era 0 or a beyond-table era (the FSM never advances there).
+era_row :: proc(cat: ^Catalogs, era: u8) -> (^Era_Row, bool) {
+	if era == 0 || int(era) > len(cat.eras) {
+		return nil, false
+	}
+	return &cat.eras[era-1], true
+}
+
+// era_class_unlocked — is `class` in the era's ACTIVE roster? The unlock
+// table query the "streaming becomes available" switch exposes (the app's
+// tray + 6.2's gate compose on it). Linear + map-free (ODN-10).
+era_class_unlocked :: proc(cat: ^Catalogs, era: u8, class: u16) -> bool {
+	row, ok := era_row(cat, era)
+	if !ok { return false }
+	for c in row.packet_classes {
+		if c == class { return true }
+	}
+	return false
+}
+
+// era_node_type_unlocked / era_pipe_tier_unlocked — the infrastructure unlock
+// table queries (what the era makes available; the app's tray composes on
+// them). Linear + map-free (ODN-10).
+era_node_type_unlocked :: proc(cat: ^Catalogs, era: u8, node_type: u16) -> bool {
+	row, ok := era_row(cat, era)
+	if !ok { return false }
+	for n in row.unlock_node_types {
+		if n == node_type { return true }
+	}
+	return false
+}
+
+era_pipe_tier_unlocked :: proc(cat: ^Catalogs, era: u8, tier: u16) -> bool {
+	row, ok := era_row(cat, era)
+	if !ok { return false }
+	for t in row.unlock_pipe_tiers {
+		if t == tier { return true }
+	}
+	return false
+}
