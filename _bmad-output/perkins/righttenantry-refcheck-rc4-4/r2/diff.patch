@@ -0,0 +1,95 @@
+//// RC4.4 tests: the notification preference gate + the §7.9 verbatim copy
+//// pins. The dispatch functions themselves need a DB (integration suite);
+//// the PURE decision surface is the preference gate, and the §7.9 bodies
+//// are extracted builders — a copy drift fails CI without a database.
+
+import gleeunit/should
+import notification/notification_dispatch
+import shared/landlord
+
+// -- Preference matrix (RC4.4) ------------------------------------------------
+// The matrix the story's AC proves: in-app notifications ALWAYS land
+// (dispatch is preference-independent — proven by the integration tests),
+// email only for Realtime. Daily users get no reference email: the daily
+// digest is ai_complete-only by design.
+
+pub fn preference_matrix_realtime_allows_email_test() {
+  notification_dispatch.email_allowed_for(landlord.Realtime)
+  |> should.be_true
+}
+
+pub fn preference_matrix_daily_blocks_email_test() {
+  notification_dispatch.email_allowed_for(landlord.Daily)
+  |> should.be_false
+}
+
+pub fn preference_matrix_off_blocks_email_test() {
+  notification_dispatch.email_allowed_for(landlord.Off)
+  |> should.be_false
+}
+
+// -- §7.9 verbatim copy pins --------------------------------------------------
+// The five §7.9 reference events, verbatim, pinned against the EXTRACTED
+// builders the dispatch fns compose from (the late-completion line keeps
+// rc3-4's documented em-dash rephrase — "after all. It's on" — per the
+// standing em-dash ban).
+
+pub fn reference_completed_body_is_79_verbatim_test() {
+  // §7.9: "Reference received: Colm Byrne for Aisling O'Brien." — the title
+  // carries the "Reference received" prefix, the body the rest of the line.
+  notification_dispatch.reference_completed_body(
+    referee_name: "Colm Byrne",
+    applicant_full_name: "Aisling O'Brien",
+    late_after_handoff: False,
+  )
+  |> should.equal("Colm Byrne for Aisling O'Brien.")
+}
+
+pub fn reference_unreachable_body_is_79_verbatim_test() {
+  // §7.9: "Couldn't reach Colm Byrne (Aisling O'Brien's referee). You can
+  // take over from the application page."
+  notification_dispatch.reference_unreachable_body(
+    referee_name: "Colm Byrne",
+    applicant_full_name: "Aisling O'Brien",
+  )
+  |> should.equal(
+    "Couldn't reach Colm Byrne (Aisling O'Brien's referee). You can take over from the application page.",
+  )
+}
+
+pub fn reference_declined_body_is_79_verbatim_test() {
+  // §7.9: "Colm Byrne declined to give a reference for Aisling O'Brien."
+  notification_dispatch.reference_declined_body(
+    referee_name: "Colm Byrne",
+    applicant_full_name: "Aisling O'Brien",
+  )
+  |> should.equal(
+    "Colm Byrne declined to give a reference for Aisling O'Brien.",
+  )
+}
+
+pub fn reference_objected_body_is_79_verbatim_test() {
+  // §7.9: "Colm Byrne asked not to be contacted about Aisling O'Brien's
+  // application."
+  notification_dispatch.reference_objected_body(
+    referee_name: "Colm Byrne",
+    applicant_full_name: "Aisling O'Brien",
+  )
+  |> should.equal(
+    "Colm Byrne asked not to be contacted about Aisling O'Brien's application.",
+  )
+}
+
+pub fn late_completion_body_keeps_rc34_rephrase_test() {
+  // §7.9 has "completed the reference form after all — it's on"; rc3-4
+  // rephrased the em-dash to a period (the standing em-dash ban). Pinned so
+  // the rephrase never silently reverts AND never drifts further.
