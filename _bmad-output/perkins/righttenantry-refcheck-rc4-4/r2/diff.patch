+// -- The §7.6 attempt-log timeline entry (RC4.4, server-built) -----------------
+
+/// One entry of the server-built attempt-log timeline (§7.6) — the panel's
+/// single source of truth for what happened to a reference call (AR-RC13:
+/// the client never re-derives the event set or ordering). The server
+/// derives the kinds from the row's attempts JSONB + lifecycle columns,
+/// normalises every timestamp to RFC3339 (PG `::text` uses a space
+/// separator; lexical sort of mixed formats mis-orders same-day events), and
+/// sorts the whole list by `at` before encoding — the wire order IS the
+/// timeline order.
+///
+/// `kind` is one of: `invitation_sent` | `co_nudge` | `reminder_sent` |
+/// `form_opened` | `corrected` | `taken_over` | `substituted` | `terminal`.
+/// Send entries (invitation/co_nudge/reminder) carry `channel`/`outcome`/
+/// `detail` passthrough from the attempts JSONB (the client joins same-`at`
+/// channels for the "email + SMS" label and picks the nudge variant from
+/// outcome/detail); lifecycle entries leave them empty. `reminder_sent`
+/// entries carry the cadence ordinal ("1", "2") in `detail`.
+pub type AttemptLogEntry {
+  AttemptLogEntry(
+    kind: String,
+    at: String,
+    channel: String,
+    outcome: String,
+    detail: String,
+  )
+}
+
+pub fn encode_attempt_log_entry(entry: AttemptLogEntry) -> json.Json {
+  json.object([
+    #("kind", json.string(entry.kind)),
+    #("at", json.string(entry.at)),
+    #("channel", json.string(entry.channel)),
+    #("outcome", json.string(entry.outcome)),
+    #("detail", json.string(entry.detail)),
+  ])
+}
+
+pub fn attempt_log_entry_decoder() -> decode.Decoder(AttemptLogEntry) {
+  use kind <- decode.field("kind", decode.string)
+  use at <- decode.field("at", decode.string)
+  use channel <- decode.field("channel", decode.string)
+  use outcome <- decode.field("outcome", decode.string)
+  use detail <- decode.field("detail", decode.string)
+  decode.success(AttemptLogEntry(kind:, at:, channel:, outcome:, detail:))
+}
