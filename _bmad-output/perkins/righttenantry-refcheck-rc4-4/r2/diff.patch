+/// RC4.4: stamp the substitution instant on the NEW row (the §7.6 timeline's
+/// "Referee substituted" entry). Called inside do_substitute's transaction
+/// right after the shared idempotent insert succeeds — the shared
+/// insert_reference_call_if_absent is used by the trigger too, so the marker
+/// is a separate guarded write: idempotent (a double-submit's 0-row insert
+/// never reaches this), NULL-guarded (never overwrites), and only ever the
+/// substitute path runs it (a trigger-created row stays unmarked).
+///
+/// > 🐿️ This function was generated automatically using v4.6.0 of
+/// > the [squirrel package](https://github.com/giacomocavalieri/squirrel).
+///
+pub fn mark_substituted_reference_call(
+  db: pog.Connection,
+  arg_1: Uuid,
+) -> Result(pog.Returned(MarkSubstitutedReferenceCallRow), pog.QueryError) {
+  let decoder = {
+    use id <- decode.field(0, decode.string)
+    decode.success(MarkSubstitutedReferenceCallRow(id:))
+  }
+
+  "-- RC4.4: stamp the substitution instant on the NEW row (the §7.6 timeline's
+-- \"Referee substituted\" entry). Called inside do_substitute's transaction
+-- right after the shared idempotent insert succeeds — the shared
+-- insert_reference_call_if_absent is used by the trigger too, so the marker
+-- is a separate guarded write: idempotent (a double-submit's 0-row insert
+-- never reaches this), NULL-guarded (never overwrites), and only ever the
+-- substitute path runs it (a trigger-created row stays unmarked).
+UPDATE reference_call
+SET substituted_at = now()
+WHERE id = $1
+  AND substituted_at IS NULL
+RETURNING id::text;
