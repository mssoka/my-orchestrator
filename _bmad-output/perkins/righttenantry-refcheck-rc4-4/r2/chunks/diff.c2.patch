+// -- The §7.6 attempt-log timeline builder (RC4.4) ----------------------------
+// AR-RC13: the server derives the event set, kinds, and ordering — the
+// client renders labels, never re-derives what happened. Timestamps from the
+// sweep are RFC3339 ("2026-08-01T10:04:00Z"); column timestamps come via PG
+// `::text` ("2026-08-01 21:12:00+00"). All are normalised to the RFC3339
+// `T` separator BEFORE the lexical sort — mixed formats mis-order same-day
+// events (space < 'T'), a latent bug in the old client-side sort this
+// replaces.
+
+const terminal_statuses: List(String) = [
+  "form_completed",
+  "manual_recorded",
+  "unreachable",
+  "refused",
+  "objected",
+  "partial",
+  "failed",
+  // v2-reserved voice terminal — harmless to include.
+  "completed",
+]
+
+/// Build the ordered §7.6 timeline for one reference call. Pure — unit
+/// tested without a DB. `at` values are the raw column strings ('' = absent).
+pub fn build_attempt_log(
+  attempts attempts: List(shared_reference_call.ReferenceCallAttempt),
+  form_opened_at form_opened_at: String,
+  corrected_at corrected_at: String,
+  taken_over_at taken_over_at: String,
+  substituted_at substituted_at: String,
+  terminalized_at terminalized_at: String,
+  submitted_at submitted_at: String,
+  objected_at objected_at: String,
+  updated_at updated_at: String,
+  status status: String,
+) -> List(shared_reference_call.AttemptLogEntry) {
+  let send_entries = build_send_entries(attempts, corrected_at)
+  let lifecycle_entries =
+    build_lifecycle_entries(
+      form_opened_at:,
+      corrected_at:,
+      taken_over_at:,
+      substituted_at:,
+      terminalized_at:,
+      submitted_at:,
+      objected_at:,
+      updated_at:,
+      status:,
+    )
+  list.append(send_entries, lifecycle_entries)
+  |> list.sort(fn(a, b) { string.compare(a.at, b.at) })
+}
+
+/// Label the send batches by cadence position, restarting the count at the
+/// first batch AFTER a correction (correct_reference_call resets
+/// attempt_count to 0 and the sweep re-runs the T0 claim — the post-
+/// correction invitation is a fresh "Invitation sent", never a mislabelled
+/// "Reminder N"). One entry per attempt entry (channel passthrough — the
+/// client joins same-`at` channels for the "email + SMS" label).
+fn build_send_entries(
+  attempts: List(shared_reference_call.ReferenceCallAttempt),
+  corrected_at: String,
+) -> List(shared_reference_call.AttemptLogEntry) {
+  let corrected_ts = normalize_at(corrected_at)
+  attempts
+  |> group_attempts_by_at
+  // The accumulator carries #(cycle_index, restarted, entries). `restarted`
+  // latches once the FIRST post-correction batch has reset the cadence —
+  // without it, every later batch still satisfies `batch_index > 0` and the
+  // restart re-fires indefinitely (B1: post-correction co_nudge + reminders
+  // all rendered as "Invitation sent" with empty ordinals).
+  |> list.fold(#(0, False, []), fn(acc, batch) {
+    let #(batch_index, restarted, entries) = acc
+    let #(at, batch_attempts) = batch
+    let norm_at = normalize_at(at)
+    // The correction cycle boundary: the first batch strictly after the
+    // correction restarts the cadence at the invitation; every batch after
+    // that continues the fresh cycle (co_nudge, reminder 1, reminder 2).
+    let #(cycle_index, restarted) = case corrected_ts {
+      "" -> #(batch_index, restarted)
+      _ ->
+        case string.compare(norm_at, corrected_ts) {
+          Gt ->
+            case restarted {
+              False -> #(0, True)
+              True -> #(batch_index, restarted)
+            }
+          _ -> #(batch_index, restarted)
+        }
+    }
+    let kind = case cycle_index {
+      0 -> "invitation_sent"
+      1 -> "co_nudge"
+      _ -> "reminder_sent"
+    }
+    // Cadence ordinal for reminders; otherwise the ATTEMPT's own detail
+    // passes through (a skipped co-nudge carries its gate reason — "co-nudge
+    // skipped: form already opened" — which the nudge line renders; W6).
+    let labelled =
+      list.map(batch_attempts, fn(attempt) {
+        let detail = case cycle_index {
+          n if n >= 2 -> int.to_string(n - 1)
+          _ -> attempt.detail
+        }
+        shared_reference_call.AttemptLogEntry(
+          kind: kind,
+          at: norm_at,
+          channel: attempt.channel,
+          outcome: attempt.outcome,
+          detail: detail,
+        )
+      })
+    #(cycle_index + 1, restarted, list.append(entries, labelled))
+  })
+  |> pair_third
+}
+
+/// Group the append-only attempts log into cadence batches by shared `at`
+/// (one sweep step stamps one timestamp for all its channel entries),
+/// preserving chronological order.
+fn group_attempts_by_at(
+  attempts: List(shared_reference_call.ReferenceCallAttempt),
+) -> List(#(String, List(shared_reference_call.ReferenceCallAttempt))) {
+  attempts
+  |> list.fold([], fn(groups, entry) {
+    case groups {
+      [] -> [#(entry.at, [entry])]
+      [#(at, entries), ..rest] if at == entry.at -> [
+        #(at, [entry, ..entries]),
+        ..rest
+      ]
+      _ -> [#(entry.at, [entry]), ..groups]
+    }
+  })
+  |> list.reverse
+  |> list.map(fn(group) {
+    let #(at, entries) = group
+    #(at, list.reverse(entries))
+  })
+}
+
+/// The lifecycle column events: form-opened, corrected, taken-over,
+/// substituted, and the terminal event. The terminal instant falls back
+/// `terminalized_at → submitted_at → objected_at → updated_at` so rows
+/// terminalized before the RC4.4 migration still timestamp their terminal
+/// entry (the fallback is the last write on a terminal row, which is the
+/// terminalizing write — except a later takeover, which the takeover entry
+/// itself shows).
+fn build_lifecycle_entries(
+  form_opened_at form_opened_at: String,
+  corrected_at corrected_at: String,
+  taken_over_at taken_over_at: String,
+  substituted_at substituted_at: String,
+  terminalized_at terminalized_at: String,
+  submitted_at submitted_at: String,
+  objected_at objected_at: String,
+  updated_at updated_at: String,
+  status status: String,
+) -> List(shared_reference_call.AttemptLogEntry) {
+  let events = [
+    #("form_opened", normalize_at(form_opened_at)),
+    #("corrected", normalize_at(corrected_at)),
+    #("taken_over", normalize_at(taken_over_at)),
+    #("substituted", normalize_at(substituted_at)),
+  ]
+  let column_entries =
+    events
+    |> list.filter(fn(event) { pair_second(event) != "" })
+    |> list.map(fn(event) {
+      let #(kind, at) = event
+      shared_reference_call.AttemptLogEntry(
+        kind: kind,
+        at: at,
+        channel: "",
+        outcome: "",
+        detail: "",
+      )
+    })
+  let terminal_entries = case list.contains(terminal_statuses, status) {
+    False -> []
+    True ->
+      case
+        first_non_empty([
+          normalize_at(terminalized_at),
+          normalize_at(submitted_at),
+          normalize_at(objected_at),
+          // W2: `updated_at` is polluted by post-terminal writes — a
+          // takeover on a legacy unreachable row bumps it to the TAKEOVER
+          // instant, which would fake the terminal time. Only fall back to
+          // it when the row was never taken over (the terminalizing write
+          // was then the last one).
+          case normalize_at(taken_over_at) {
+            "" -> normalize_at(updated_at)
+            _ -> ""
+          },
+        ])
+      {
+        "" -> []
+        at -> [
+          shared_reference_call.AttemptLogEntry(
+            kind: "terminal",
+            at: at,
+            channel: "",
+            outcome: "",
+            detail: "",
+          ),
+        ]
+      }
+  }
+  list.append(column_entries, terminal_entries)
+}
+
+/// Normalise a timestamp for RFC3339 lexical sorting: PG `::text` renders
+/// "2026-08-01 21:12:00+00" (space separator) while the sweep stamps
+/// "2026-08-01T10:04:00Z" — the space must become `T` or same-day events
+/// sort wrongly (' ' < 'T'). '' passes through (absent marker).
+fn normalize_at(at: String) -> String {
+  string.replace(at, " ", "T")
+}
+
+fn first_non_empty(items: List(String)) -> String {
+  case items {
+    [] -> ""
+    [head, ..rest] ->
+      case head {
+        "" -> first_non_empty(rest)
+        _ -> head
+      }
+  }
+}
+
+fn pair_second(pair: #(a, b)) -> b {
+  let #(_, second) = pair
+  second
+}
+
+fn pair_third(triple: #(a, b, c)) -> c {
+  let #(_, _, third) = triple
+  third
+}
