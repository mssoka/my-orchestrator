+/// The preference gate (RC4.4): does this landlord's notification_preference
+/// allow a realtime email for a reference/vacancy event? In-app notifications
+/// ALWAYS land (dispatch is preference-independent); the DAILY digest is
+/// ai_complete-only by design, so reference events never email daily users —
+/// the matrix is {Realtime: in-app + email, Daily: in-app only, Off: in-app
+/// only}. Pure and exported for the preference-matrix test.
+pub fn email_allowed_for(pref: landlord.NotificationPreference) -> Bool {
+  case pref {
+    landlord.Realtime -> True
+    landlord.Daily -> False
+    landlord.Off -> False
+  }
+}
