new file mode 100644
index 0000000..02bbbe4
--- /dev/null
+++ b/core/node_health.odin
@@ -0,0 +1,114 @@
+package core
+
+// node_health.odin — Story 5.2: the per-node HEALTH state (the tri-state
+// surface: 🟢 healthy → 🟡 strained → 🔴 critical, the GDD M5 primary warning
+// surface). This module adds the PER-NODE layer to the Network Health system
+// (the 4.3 aggregate meter stays the loss condition, unchanged); the story
+// card pins the contract: health transitions fire on defined
+// utilization-vs-throughput thresholds, a 🔴 node is always traceable to a
+// measurable strain, and the states are DERIVED (never recorded).
+//
+// THE MEASURE — utilization vs throughput, the ONLY node-side strain this sim
+// models. A packet AT a node forwards unconditionally when a route exists (the
+// per-hop forward pass — the sim never throttles a node), so a node's honest
+// load is its UN-FORWARDABLE backlog: packets that failed a forward attempt
+// (waiting_ticks >= 1, the same pile the 4.1 strain measures). Flow
+// CONGESTION surfaces on pipes (E9 lane sheds + the 4.1 pipe pressure), never
+// as a node pile. A transit-inclusive "utilization" (all at-node packets) was
+// measured and REJECTED: the health_win prepared fan's routers hold 0–3 one-
+// tick transit packets (75–225% of router_basic throughput) even mid-surge
+// with the meter at 100 — any transit-inclusive measure makes the healthy map
+// scream, violating the "keep it quiet at 🟢" canon. The un-forwardable pile
+// is 0 on healthy traffic by construction and climbs with every real drowning
+// (an unconnected growth-born terminal, a severed route) — the early-warning
+// surface the card wants.
+//
+//     utilization_pct = Σ packet_bandwidth of STUCK at-node packets × 100
+//                       / node_types[node_type].throughput_units
+//     state = strain_level(pct, balance.warnings.node_amber_pct,
+//                          balance.warnings.node_red_pct)   (70/90)
+//
+// The thresholds are the 4.1 strain thresholds BY CHOICE: the card says the
+// health surface must be "coherent with (not contradicting) the forecast's
+// idea of strain" — sharing the data-driven `warnings` block (balance.json)
+// makes the coherence by construction AND keeps catalog_hash untouched (a
+// dedicated block would re-bless every golden). No wall-clock, no randomness:
+// same inputs → same states (E10).
+//
+// DERIVE, DON'T RECORD (card hard req 4). node_health is a pure function of
+// per-tick measurements (flow.packets + topology + catalogs at the step
+// boundary) — rebuilt identically on replay from the serialized state, same
+// status as lane_caps / node_strain's siblings. The array is NEVER serialized:
+// the serializer writes only node_strain/pipe_strain/forecast/active from
+// Crisis_State, so the health surface sits entirely OUTSIDE the save format
+// (no LOG_VERSION bump; a replayed run shows identical health timelines
+// implicitly via identical measurements — pinned by node_health_test.odin).
+// The 4.1 node_strain array is the warning-EVENTS backing store (serialized
+// so the Warning_Raised/Cleared stream rides the T1); node_health is the
+// surface's own state — the same measurement, a distinct (never-recorded)
+// home. This module emits NO events (the health surface is silent; 4.1's
+// events stay the recorded telegraph).
+//
+// Integer-only (ODN-10); arrays only, no maps (ODN-10); no file/clock reads
+// (ODN-1). Evaluated inside core.step AFTER flow_step (the counters are
+// final) and right after warning_evaluate — the spine's warning/health band.
+
+// node_health_measure — the traceability numbers behind one node's health
+// (card hard req 2: a 🔴 node is ALWAYS traceable to a measurable strain).
+// Returns the un-forwardable load in bandwidth units, the node's throughput
+// ceiling, and the utilization percent (0 when nothing is stuck or the node
+// is dead/throughput-less). The app's inspect card reads exactly these
+// numbers; the tests pin them. Takes the flow + topology pieces (not the
+// whole Run_State) so the render's inspect card can call it directly.
+node_health_measure :: proc(flow: ^Flow_State, topo: ^Topology, cat: ^Catalogs, slot: u32) -> (units: u64, throughput: u32, pct: u32) {
+	if slot >= u32(len(topo.node_alive)) || !topo.node_alive[slot] {
+		return 0, 0, 0
+	}
+	if int(topo.node_type[slot]) >= len(cat.node_types) {
+		return 0, 0, 0 // defensive — render-time bounds, like the rest of the view
+	}
+	throughput = u32(cat.node_types[topo.node_type[slot]].throughput_units)
+	bw := u64(cat.balance.packet_bandwidth)
+	node_id := topo.node_id[slot]
+	for i in 0..<len(flow.packets) {
+		p := &flow.packets[i]
+		if p.delivered || p.on_edge {
+			continue
+		}
+		if p.at_node != node_id {
+			continue
+		}
+		if p.waiting_ticks == 0 {
+			continue // the no-flicker contract: fresh spawns/transits never strain
+		}
+		units += bw
+	}
+	if throughput > 0 {
+		pct = u32(units * 100 / u64(throughput))
+	}
+	return units, throughput, pct
+}
+
+// node_health_evaluate — the per-tick health pass (called inside core.step
+// right after warning_evaluate). Rebuilds Crisis_State.node_health from the
+// current flow + topology: resize to cover the topology (preserving prior
+// elements is not required — the array is fully rewritten, unlike the
+// transition-baseline node_strain), then one level per live slot from the
+// measurement. Dead slots read None. Emits NOTHING — the health state is the
+// surface; the 4.1 warning events remain the recorded telegraph.
+node_health_evaluate :: proc(state: ^Run_State, cat: ^Catalogs) {
+	t := &state.topology
+	cr := &state.crisis
+	w := &cat.balance.warnings
+	if len(cr.node_health) != len(t.node_alive) {
+		resize(&cr.node_health, len(t.node_alive))
+	}
+	for ns in 0..<len(t.node_alive) {
+		if !t.node_alive[ns] {
+			cr.node_health[ns] = .None
+			continue
+		}
+		_, _, pct := node_health_measure(&state.flow, &state.topology, cat, u32(ns))
+		cr.node_health[ns] = strain_level(i64(pct), w.node_amber_pct, w.node_red_pct)
+	}
+}
diff --git a/core/node_health_test.odin b/core/node_health_test.odin
new file mode 100644
index 0000000..5b5e85c
--- /dev/null
+++ b/core/node_health_test.odin
@@ -0,0 +1,325 @@
+package core
+
+// node_health_test.odin — Story 5.2's durable contracts (the GDD M5 primary
+// warning surface, E3.3/E3.4). Pins:
+//   (a) threshold transitions fire on the utilization-vs-throughput measure
+//       (the un-forwardable pile ÷ the node's throughput ceiling, the balance
+//       `warnings` 70/90 ladder) — deterministic, no wall-clock/no rng;
+//   (b) TRACEABILITY — node_health_measure returns the exact numbers that put
+//       a node red (load units, throughput, pct) — the inspect card's data;
+//   (c) DERIVE-DON'T-RECORD — a replayed run derives the IDENTICAL health
+//       timeline from the recorded state (E10), and the state dump is
+//       byte-identical before/after mutating node_health (the negative
+//       control: the surface state can never leak into the save format — no
+//       LOG_VERSION bump);
+//   (d) quiet-when-healthy — the prepared fan (the 4.3 win fixture) reads 🟢
+//       on every node through the surge (the "map shouldn't scream" canon);
+//   (e) growth-born nodes telegraph (5.1 coherence) — a director-spawned
+//       terminal the player hasn't connected piles and reads 🔴, while the
+//       connected nodes stay green;
+//   (f) coherence with the 4.1 strain — node_health == node_strain on every
+//       live slot at every tick (the health surface never contradicts the
+//       forecast's idea of strain);
+//   (g) restart-clean — a fresh run context carries no node_health leakage.
+//
+// Fixtures: a manual spawn-only topology (the warning-test pattern — the era
+// director supplies the demand): res(0) → router(1) drawn at tick 1 + res3 →
+// router (email flows through the router — the busy-but-healthy case), the
+// HOST's outbound pipe NEVER drawn (its streaming spawns pile — the drowning
+// case). Host = content_host (80 u/s): 2 stuck = 60 u = 75% (Amber), 4 stuck
+// = 120 u = 150% (Red). The mult2 prepared fan for the healthy sweep.
+
+import "core:testing"
+
+// node_health_snapshot — copy the per-slot health levels into a caller-owned
+// slice (the replay-identity comparison surface).
+node_health_snapshot :: proc(s: ^Run_State, allocator := context.allocator) -> [dynamic]Strain_Level {
+	out := make([dynamic]Strain_Level, len(s.crisis.node_health), len(s.crisis.node_health), allocator)
+	copy(out[:], s.crisis.node_health[:])
+	return out
+}
+
+// node_health_fixture — the 5.2 threshold shape: res(0) → router(1) + res3 →
+// router drawn at tick 1 (email flows — busy-but-healthy), NO router→host
+// pipe (the host's streaming spawns pile — the drowning case). Node ids:
+// 0 res @{8,15}, 1 router @{14,15}, 2 host @{20,15}, 3 res @{14,22} (6/7-tile
+// spans — standard max_span 14). Returns the host id.
+node_health_fixture :: proc(s: ^Run_State, cat: ^Catalogs) -> (host_id: u32) {
+	res_idx, _ := node_type_index(cat, "residential")
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	host_idx, _ := node_type_index(cat, "content_host")
+	r := topology_spawn_node(&s.topology, res_idx, {8, 15}, cat)
+	g := topology_spawn_node(&s.topology, rt_idx, {14, 15}, cat)
+	h := topology_spawn_node(&s.topology, host_idx, {20, 15}, cat)
+	topology_spawn_node(&s.topology, res_idx, {14, 22}, cat) // id 3 — the res→res email pair
+	sla_draw(s, cat, r, g, "standard", 1)
+	sla_draw(s, cat, 3, g, "standard", 1)
+	return h
+}
+
+// --- (a)+(b): threshold transitions + the traceability numbers ---------------
+
+@(test)
+test_node_health_threshold_transitions :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 42, cat.hash, TEST_LOGIC_HZ)
+	s.era = 3 // the streaming-surge era: streaming 2/tick host→res + email 4/tick res→res
+	host_id := node_health_fixture(&s, cat)
+	hs, _ := node_slot(&s.topology, host_id)
+
+	// tick 1: the host's 2 streaming spawns fail to forward (no route) —
+	// 2 × 30 u = 60 u vs the 80 u/s host throughput = 75% → AMBER (the enter
+	// threshold 70, inclusive). The email flows through the router (drawn at
+	// tick 1) — the router must read 🟢 while busy.
+	step_n(&s, 1, cat)
+	testing.expectf(t, s.crisis.node_health[hs] == .Amber,
+		"host must read Amber at 75%% (2 stuck = 60/80), got %v", s.crisis.node_health[hs])
+	units, through, pct := node_health_measure(&s.flow, &s.topology, cat, u32(hs))
+	testing.expectf(t, units == 60 && through == 80 && pct == 75,
+		"traceability numbers at Amber: want (60, 80, 75), got (%d, %d, %d)", units, through, pct)
+	// the router carries email (busy-but-flowing) — must stay green
+	rs, _ := node_slot(&s.topology, 1)
+	testing.expectf(t, s.crisis.node_health[rs] == .None,
+		"a router carrying flowing traffic must stay healthy, got %v", s.crisis.node_health[rs])
+
+	// tick 2: 4 stuck = 120 u = 150% → RED (the 90 threshold, inclusive)
+	step_n(&s, 1, cat)
+	testing.expectf(t, s.crisis.node_health[hs] == .Red,
+		"host must read Red at 150%% (4 stuck = 120/80), got %v", s.crisis.node_health[hs])
+	units, through, pct = node_health_measure(&s.flow, &s.topology, cat, u32(hs))
+	testing.expectf(t, units == 120 && through == 80 && pct == 150,
+		"traceability numbers at Red: want (120, 80, 150), got (%d, %d, %d)", units, through, pct)
+
+	// determinism: a same-seed re-run produces the identical levels (no rng,
+	// no wall-clock — the measure is a pure function of the flow state)
+	s2: Run_State
+	defer run_destroy(&s2)
+	run_init(&s2, 42, cat.hash, TEST_LOGIC_HZ)
+	s2.era = 3
+	node_health_fixture(&s2, cat)
+	step_n(&s2, 2, cat)
+	hs2, _ := node_slot(&s2.topology, host_id)
+	testing.expectf(t, s2.crisis.node_health[hs2] == .Red,
+		"same seed -> same Red state on the re-run, got %v", s2.crisis.node_health[hs2])
+}
+
+// --- (c): derive-don't-record — replay identity + the no-leak negative control
+
+@(test)
+test_node_health_replay_derives_identically :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	// live: the piled-host run, recording per-tick levels + hashes
+	live: Run_State
+	defer run_destroy(&live)
+	run_init(&live, 7, cat.hash, TEST_LOGIC_HZ)
+	live.era = 3
+	node_health_fixture(&live, cat)
+	live_hashes := record_run(&live, 120, cat)
+	defer delete(live_hashes)
+	live_levels := node_health_snapshot(&live)
+	defer delete(live_levels)
+
+	// replay: the SAME action log + run setup — the recorded state alone must
+	// re-derive the identical health timeline (nothing about node_health
+	// enters the log)
+	replayed: Run_State
+	defer run_destroy(&replayed)
+	run_init(&replayed, 7, cat.hash, TEST_LOGIC_HZ)
+	replayed.era = 3
+	node_health_fixture(&replayed, cat)
+	delete(replayed.action_log)
+	replayed.action_log = clone_log(live.action_log)
+	replay_hashes := record_run(&replayed, 120, cat)
+	defer delete(replay_hashes)
+	replay_levels := node_health_snapshot(&replayed)
+	defer delete(replay_levels)
+
+	testing.expectf(t, len(live_hashes) == len(replay_hashes), "tick count mismatch")
+	diverged := false
+	for i in 0..<len(live_hashes) {
+		if live_hashes[i] != replay_hashes[i] {
+			diverged = true
+		}
+	}
+	testing.expectf(t, !diverged, "REPLAY DIVERGENCE over the piled-host run")
+	testing.expectf(t, len(live_levels) == len(replay_levels), "health array length mismatch")
+	for i in 0..<len(live_levels) {
+		testing.expectf(t, live_levels[i] == replay_levels[i],
+			"health timeline diverged at slot %d: live %v vs replay %v", i, live_levels[i], replay_levels[i])
+	}
+	// the timeline must actually contain a non-None state (the pin bites —
+	// a vacuous all-None comparison proves nothing)
+	any_strained := false
+	for lv in live_levels {
+		if lv != .None {
+			any_strained = true
+		}
+	}
+	testing.expectf(t, any_strained, "the fixture must actually strain a node (non-vacuous pin)")
+
+	// the negative control: the state dump is byte-identical before/after
+	// MUTATING node_health — the surface state can never leak into the save
+	// format (if a future serializer ever writes it, this pin goes red)
+	dump_a := state_dump(&live, {}, cat, context.temp_allocator)
+	for i in 0..<len(live.crisis.node_health) {
+		live.crisis.node_health[i] = .Red
+	}
+	dump_b := state_dump(&live, {}, cat, context.temp_allocator)
+	same := len(dump_a) == len(dump_b)
+	if same {
+		for i in 0..<len(dump_a) {
+			if dump_a[i] != dump_b[i] {
+				same = false
+				break
+			}
+		}
+	}
+	testing.expectf(t, same, "node_health must NEVER enter the save format (derive, don't record)")
+}
+
+// --- (d): quiet-when-healthy — the prepared fan through the surge ------------
+
+@(test)
+test_node_health_quiet_when_healthy :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	crisis_catalog_mult2(cat, 0) // the gentler surge (2/tick) — the prepared fan is sized for it
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 42, cat.hash, TEST_LOGIC_HZ)
+	s.era = 3
+	health_prepared_fixture(&s, cat)
+	s.health_enabled = true
+	s.surge_win_pct = 90
+	// sample the health surface at pinned ticks: pre-surge, mid-surge, the
+	// window end (the fan carries the surge — the meter stays 100, and the
+	// surface must stay 🟢 everywhere: "the map shouldn't scream when healthy")
+	for i in 0..<3200 {
+		step_n(&s, 1, cat)
+		if s.tick == 1200 || s.tick == 2000 || s.tick == 3000 {
+			for ns in 0..<len(s.topology.node_alive) {
+				if !s.topology.node_alive[ns] {
+					continue
+				}
+				testing.expectf(t, s.crisis.node_health[ns] == .None,
+					"tick %d: a healthy fan node must stay 🟢, slot %d reads %v",
+					s.tick, ns, s.crisis.node_health[ns])
+			}
+		}
+	}
+	testing.expectf(t, s.health.meter_pct == 100, "the fan must carry the surge (meter 100), got %d", s.health.meter_pct)
+	testing.expectf(t, s.outcome == .Won, "the prepared fan must survive the surge (Run_Won at the window end), got %v", s.outcome)
+}
+
+// --- (e): growth-born nodes telegraph (5.1 coherence) -------------------------
+
+@(test)
+test_node_health_growth_born_nodes :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 4243, cat.hash, TEST_LOGIC_HZ)
+	s.era = 3 // the streaming-surge era (growth spawns residentials + content_hosts)
+	s.growth_enabled = true // 5.1: the director grows the map
+	res_idx, _ := node_type_index(cat, "residential")
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	host_idx, _ := node_type_index(cat, "content_host")
+	r := topology_spawn_node(&s.topology, res_idx, {8, 15}, cat)
+	g := topology_spawn_node(&s.topology, rt_idx, {14, 15}, cat)
+	topology_spawn_node(&s.topology, host_idx, {20, 15}, cat) // id 2 — the host piles (no outbound pipe)
+	topology_spawn_node(&s.topology, res_idx, {14, 22}, cat) // id 3
+	topology_spawn_node(&s.topology, res_idx, {8, 22}, cat) // id 4
+	// the connected legs (email flows) — the host + every growth-born terminal
+	// have NO pipes at all (their own demand piles): the drowning set.
+	sla_draw(&s, cat, r, g, "standard", 3)
+	sla_draw(&s, cat, 3, g, "standard", 3)
+	sla_draw(&s, cat, 4, g, "standard", 3)
+	before := node_count(&s.topology)
+	step_n(&s, 400, cat) // 3 growth windows (120 ticks each) + margin
+	after := node_count(&s.topology)
+	testing.expectf(t, after > before, "growth must spawn terminals (5.1): %d -> %d", before, after)
+
+	// the growth-born terminals (beyond the fixture ids 0..4) must telegraph
+	// 🔴 — their demand piles (no pipes to them)
+	grown_red := 0
+	for ns := 5; ns < len(s.topology.node_alive); ns += 1 {
+		if !s.topology.node_alive[ns] {
+			continue
+		}
+		if s.crisis.node_health[ns] == .Red {
+			grown_red += 1
+		}
+	}
+	testing.expectf(t, grown_red >= 1, "at least one growth-born terminal must read 🔴 (it's drowning unconnected), got %d", grown_red)
+	// the connected nodes stay green (email flows) — quiet where healthy
+	rs, _ := node_slot(&s.topology, r)
+	gslot, _ := node_slot(&s.topology, g)
+	testing.expectf(t, s.crisis.node_health[rs] == .None && s.crisis.node_health[gslot] == .None,
+		"the connected router + residential must stay 🟢, got %v / %v",
+		s.crisis.node_health[rs], s.crisis.node_health[gslot])
+}
+
+// --- (f): coherence with the 4.1 strain ---------------------------------------
+
+@(test)
+test_node_health_coherent_with_node_strain :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 4243, cat.hash, TEST_LOGIC_HZ)
+	s.era = 3
+	node_health_fixture(&s, cat)
+	for i in 0..<120 {
+		step_n(&s, 1, cat)
+		// every live slot: the health surface == the 4.1 strain (the same
+		// measure + thresholds — the surface never contradicts the forecast's
+		// idea of strain, by construction)
+		for ns in 0..<len(s.topology.node_alive) {
+			if !s.topology.node_alive[ns] {
+				continue
+			}
+			if s.crisis.node_health[ns] != s.crisis.node_strain[ns] {
+				testing.expectf(t, false,
+					"tick %d slot %d: health %v != strain %v (coherence violated)",
+					s.tick, ns, s.crisis.node_health[ns], s.crisis.node_strain[ns])
+			}
+		}
+	}
+}
+
+// --- (g): restart-clean -------------------------------------------------------
+
+@(test)
+test_node_health_restart_clean :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	s: Run_State
+	run_init(&s, 42, cat.hash, TEST_LOGIC_HZ)
+	s.era = 3
+	node_health_fixture(&s, cat)
+	step_n(&s, 10, cat)
+	testing.expectf(t, len(s.crisis.node_health) > 0, "the run must have grown the health array")
+	run_destroy(&s)
+	run_init(&s, 999, cat.hash, TEST_LOGIC_HZ)
+	testing.expectf(t, len(s.crisis.node_health) == 0,
+		"a fresh run context must carry no node_health leakage, got %d", len(s.crisis.node_health))
+	run_destroy(&s)
+}
