+++ b/app/render/node_health.odin
@@ -0,0 +1,78 @@
+package render
+
+// node_health.odin — Story 5.2's TRACEABILITY surface (card hard req 2: a 🔴
+// node is ALWAYS traceable to a measurable strain — an inspect/tooltip
+// surface showing the numbers that put it red). A small entity-anchored card,
+// drawn by the APP on hover (the harness capture path never calls this — T2
+// goldens are untouched by construction). The card reads the health state +
+// the measure numbers directly (never color alone: the state NAME + the
+// numbers are the primary encoders; the color chip is the secondary cue).
+// ASCII-only strings (the byte-truncating draw_text_c, lint gate 6).
+
+import "core:fmt"
+import pp "../../core"
+import rl "vendor:raylib"
+
+// NODE_HEALTH_CARD_W/H — the inspect card's fixed geometry (a small 2-line
+// card: the state line + the traceability line).
+NODE_HEALTH_CARD_W :: i32(232)
+NODE_HEALTH_CARD_H :: i32(52)
+
+// node_health_card_state — the state name + color + glyph for the card
+// (mirrors the ring's triad — one shared state vocabulary).
+node_health_card_state :: proc(lvl: pp.Strain_Level, p: ^Palette) -> (name: string, col: rl.Color, glyph: string) {
+	if lvl == .Amber {
+		return "STRAINED", p.state_strain, "!"
+	}
+	if lvl == .Red {
+		return "CRITICAL", p.state_critical, "!!"
+	}
+	return "HEALTHY", p.state_healthy, ""
+}
+
+// draw_node_health_card — the inspect card for ONE node slot: the state name
+// (+ a small state-colored glyph chip — shape + color, never color alone),
+// then the traceability line with the numbers that put the node where it is:
+// "util 150%  (load 120 / 80 u)". Reads the 5.2 measure helper directly (the
+// same numbers the tests pin). `anchor` is the node's screen position; the
+// card sits below-right of the node, clear of the health ring.
+draw_node_health_card :: proc(v: ^View, flow: ^pp.Flow_State, topo: ^pp.Topology, crisis: ^pp.Crisis_State, cat: ^pp.Catalogs, slot: int, anchor: rl.Vector2) {
+	if slot < 0 || slot >= len(topo.node_alive) || !topo.node_alive[slot] {
+		return
+	}
+	lvl := pp.Strain_Level.None
+	if slot < len(crisis.node_health) {
+		lvl = crisis.node_health[slot]
+	}
+	name, col, glyph := node_health_card_state(lvl, v.palette)
+	units, throughput, pct := pp.node_health_measure(flow, topo, cat, u32(slot))
+
+	// the card frame (below-right of the node — clear of the ring + the glyph)
+	s := v.tile_px * v.scale
+	x := i32(anchor.x) + i32(s * 0.7)
+	y := i32(anchor.y) + i32(s * 0.5)
+	card := rl.Color{255, 252, 244, 240}
+	rl.DrawRectangle(x, y, NODE_HEALTH_CARD_W, NODE_HEALTH_CARD_H, card)
+	rl.DrawRectangleLines(x, y, NODE_HEALTH_CARD_W, NODE_HEALTH_CARD_H, rl.Color{51, 65, 79, 60})
+
+	// line 1: the state name + the glyph chip (the icon — never color alone)
+	// NODE 2  [CRITICAL]
+	node_label := fmt.tprintf("NODE %d", topo.node_id[slot])
+	draw_text_c(v, node_label, x + 10, y + 8, 13, v.palette.ink)
+	// the glyph chip: a small state-filled circle + the state glyph (shape +
+	// color) — the "icon" half of the icon + outline canon
+	chip_x := x + NODE_HEALTH_CARD_W - 16
+	chip_y := y + 8
+	if glyph != "" {
+		rl.DrawCircle(chip_x, chip_y, 6, col)
+		rl.DrawCircleLines(chip_x, chip_y, 6, v.palette.ink_soft)
+		draw_text_c(v, glyph, chip_x - 3, chip_y - 8, 12, rl.Color{255, 255, 255, 255})
+	}
+	name_x := x + 10
+	name_y := y + 26
+	draw_text_c(v, name, name_x, name_y, 14, col)
+
+	// line 2: the traceability numbers (what put the node here)
+	trace := fmt.tprintf("util %d%% (load %d / %d u)", pct, units, throughput)
+	draw_text_c(v, trace, x + 10, name_y + 16, 12, v.palette.ink_soft)
+}
