diff --git a/tests/test_gesture.gd b/tests/test_gesture.gd
new file mode 100644
index 0000000..cada219
--- /dev/null
+++ b/tests/test_gesture.gd
@@ -0,0 +1,187 @@
+extends "res://tests/test_base.gd"
+
+## E1.3 gesture lifecycle — drives the REAL input path headless: parsed
+## InputEvents → InputRouter._unhandled_input → physics _pick →
+## ConnectController state machine → commit/cancel. Never the programmatic
+## connect_programmatic shortcut (that path is covered in test_no_sim).
+
+const SCENE := "res://scenes/main.tscn"
+const FRAMES_FOR_PHYSICS := 4
+
+
+func run_all() -> int:
+	print("[test_gesture]")
+	return await _run_gestures()
+
+
+func _run_gestures() -> int:
+	var packed: PackedScene = load(SCENE)
+	if packed == null:
+		check(false, "main.tscn loads")
+		return failures
+	var scene: Node = packed.instantiate()
+	tree.root.add_child(scene)
+	for i in FRAMES_FOR_PHYSICS:
+		await tree.physics_frame # colliders register; space becomes queryable
+
+	var rig: OrbitCamera = scene.get_node("OrbitRig")
+	var router: InputRouter = scene.get_node("InputRouter")
+	var controller: ConnectController = scene.get_node("ConnectController")
+	var sites: Array = scene.get_node("Nodes").get_children().filter(func(c): return c is NodeSite)
+
+	var pair := _pair_with_arc(sites, 0.65)
+	if pair.is_empty():
+		check(false, "found a readable site pair")
+		scene.free()
+		return failures
+	var a: NodeSite = pair[0]
+	var b: NodeSite = pair[1]
+
+	# --- commit: press on A, sweep across the surface, release on B ---
+	rig.frame_point(a.global_position, 1)
+	rig.snap()
+	await tree.process_frame
+	await _press(_unproject(a.global_position))
+	check(controller._source == a, "press on a node enters the DRAW state")
+	var mid: Vector3 = Geodesic.geodesic_points(a.global_position, b.global_position, 2)[1]
+	await _move(_unproject(a.global_position), _unproject(mid)) # exercises _project_pointer + preview
+	await _move(_unproject(mid), _unproject(b.global_position))
+	check(controller._snap_target == b, "pointer over B snaps to B (arc-intent)")
+	await _release(_unproject(b.global_position))
+	check(controller.pipe_count(a, b) == 1, "release on the snapped node COMMITS the pipe")
+	check(controller._source == null, "gesture state cleared after commit")
+
+	# --- cancel: release over empty surface (no node within snap arc) ---
+	var c_site: NodeSite = _site_other_than(sites, [a, b])
+	rig.frame_point(c_site.global_position, 1)
+	rig.snap()
+	await tree.process_frame
+	var size_before: int = controller._registry.size()
+	await _press(_unproject(c_site.global_position))
+	check(controller._source == c_site, "second gesture also enters DRAW")
+	var empty := _empty_surface_point(sites, c_site)
+	await _move(_unproject(c_site.global_position), _unproject(empty))
+	await _release(_unproject(empty))
+	check(controller._registry.size() == size_before, "release on empty surface CANCELS (no pipe)")
+	check(controller._source == null, "cancel clears gesture state")
+
+	# --- sky release cancels (pointer leaves the planet mid-drag) ---
+	rig.frame_point(c_site.global_position, 1)
+	rig.snap()
+	await tree.process_frame
+	await _press(_unproject(c_site.global_position))
+	var sky := _sky_screen_point()
+	await _release(sky)
+	check(controller._registry.size() == size_before, "release over open SKY cancels (no stale-snap commit)")
+
+	# --- focus loss cancels a live gesture ---
+	await _press(_unproject(c_site.global_position))
+	check(controller._source == c_site, "third gesture enters DRAW")
+	router.notification(Node.NOTIFICATION_WM_WINDOW_FOCUS_OUT)
+	check(router._mode == InputRouter.Mode.NONE, "focus-loss resets the router mode")
+	check(controller._source == null and not controller._preview.visible, "focus-loss cancels preview + state")
+	await _release(sky)
+	check(controller._registry.size() == size_before, "post-cancel release commits nothing")
+
+	tree.root.remove_child(scene)
+	scene.free()
+	return failures
+
+
+# --- helpers -----------------------------------------------------------------
+
+func _press(pos: Vector2) -> void:
+	var e := InputEventMouseButton.new()
+	e.button_index = MOUSE_BUTTON_LEFT
+	e.pressed = true
+	e.position = pos
+	e.global_position = pos
+	Input.parse_input_event(e)
+	await tree.process_frame
+	await tree.process_frame
+
+
+func _move(from: Vector2, to: Vector2) -> void:
+	var e := InputEventMouseMotion.new()
+	e.position = to
+	e.global_position = to
+	e.relative = to - from
+	Input.parse_input_event(e)
+	await tree.process_frame
+	await tree.process_frame
+
+
+func _release(pos: Vector2) -> void:
+	var e := InputEventMouseButton.new()
+	e.button_index = MOUSE_BUTTON_LEFT
+	e.pressed = false
+	e.position = pos
+	e.global_position = pos
+	Input.parse_input_event(e)
+	await tree.process_frame
+	await tree.process_frame
+
+
+func _unproject(world: Vector3) -> Vector2:
+	var cam: Camera3D = tree.root.get_node("Main/OrbitRig/Camera3D")
+	return cam.unproject_position(world)
+
+
+## Pair whose arc is closest to `target` — both endpoints comfortably on screen.
+func _pair_with_arc(sites: Array, target: float) -> Array:
+	var best := []
+	var best_diff := 1e9
+	for i in sites.size():
+		for j in range(i + 1, sites.size()):
+			var diff: float = absf(Geodesic.arc_angle(sites[i].global_position, sites[j].global_position) - target)
+			if diff < best_diff:
+				best_diff = diff
+				best = [sites[i], sites[j]]
+	return best
+
+
+func _site_other_than(sites: Array, used: Array) -> NodeSite:
+	for s in sites:
+		if not used.has(s):
+			return s
+	return null
+
+
+## A surface direction with no node within 2x the snap arc, ~29° off the
+## framed axis so it unprojects ON-screen (off-frustum unprojects mirror and
+## land on arbitrary surface points).
+func _empty_surface_point(sites: Array, framed: NodeSite) -> Vector3:
+	var cam: Camera3D = tree.root.get_node("Main/OrbitRig/Camera3D")
+	var c_dir: Vector3 = framed.global_position.normalized()
+	var t1 := c_dir.cross(Vector3.UP)
+	if t1.length() < 0.1:
+		t1 = c_dir.cross(Vector3.RIGHT)
+	t1 = t1.normalized()
+	var t2 := c_dir.cross(t1).normalized()
+	for probe in [
+		c_dir.rotated(t1, 0.5), c_dir.rotated(t1, -0.5),
+		c_dir.rotated(t2, 0.5), c_dir.rotated(t2, -0.5),
+		c_dir.rotated(t1, 0.5).rotated(c_dir, 0.5),
+		c_dir.rotated(t1, -0.5).rotated(c_dir, 0.5),
+	]:
+		var clear := true
+		for s in sites:
+			if Geodesic.arc_angle(probe.normalized() * WorldSeed.PLANET_RADIUS, s.global_position) < 0.48:
+				clear = false
+				break
+		if clear:
+			return probe.normalized() * WorldSeed.PLANET_RADIUS
+	# Deterministic fallback: the pole opposite the camera (rarely populated).
+	return -cam.global_position.normalized() * WorldSeed.PLANET_RADIUS
+
+
+## A screen point aimed at open space past the planet's limb: rotated
+## HORIZONTALLY (around the screen-up axis) — horizontal half-FOV (~38°)
+## clears the limb (asin(R/dist) ≈ 31°) while vertical half-FOV (25°) would
+## mirror an off-screen point back onto the planet.
+func _sky_screen_point() -> Vector2:
+	var cam: Camera3D = tree.root.get_node("Main/OrbitRig/Camera3D")
+	var screen_up := cam.global_transform.basis.y
+	var cam_dir: Vector3 = cam.global_position.normalized()
+	var sky_dir := cam_dir.rotated(screen_up, 0.62).normalized() # ~35.5°: past the limb, in-frustum
+	return cam.unproject_position(cam.global_position + sky_dir * 20.0)
