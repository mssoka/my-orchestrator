+extends "res://tests/test_base.gd"
+
+## E1.3 input contracts: the positional disambiguation rule and the
+## snap-honors-intent commit path.
+
+func run_all() -> int:
+	print("[test_input]")
+	_classify()
+	return failures
+
+
+func _classify() -> void:
+	var site := NodeSite.new()
+	var body := StaticBody3D.new()
+	tree.root.add_child(site)
+	tree.root.add_child(body)
+	check(InputRouter.classify(site) == InputRouter.Mode.DRAW, "press on a node = DRAW")
+	check(InputRouter.classify(body) == InputRouter.Mode.ORBIT, "press on the planet body = ORBIT")
+	check(InputRouter.classify(null) == InputRouter.Mode.ORBIT, "press on the sky = ORBIT")
+	var stray := Camera3D.new()
+	check(InputRouter.classify(stray) == InputRouter.Mode.ORBIT, "any non-node collider = ORBIT")
+	stray.free()
+	tree.root.remove_child(site)
+	tree.root.remove_child(body)
+	site.free()
+	body.free()
