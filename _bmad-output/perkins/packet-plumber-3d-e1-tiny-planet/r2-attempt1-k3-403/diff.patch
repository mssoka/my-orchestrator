+extends SceneTree
+
+## Headless contract runner: `godot --headless -s res://tests/run_tests.gd`
+## Exit 0 = every epic test contract holds; nonzero = failure count evidence.
+## The suite runs on the FIRST process frame: nodes added during
+## `_initialize` are not yet inside the tree (global_transform needs a live
+## tree), and one frame costs nothing.
+
+var _ran := false
+
+
+func _initialize() -> void:
+	process_frame.connect(_run_once, CONNECT_ONE_SHOT)
+
+
+func _run_once() -> void:
+	if _ran:
+		return
+	_ran = true
+	var failures := 0
+	var scripts := [
+		"res://tests/test_geodesic.gd",
+		"res://tests/test_camera.gd",
+		"res://tests/test_input.gd",
+		"res://tests/test_no_sim.gd",
+		"res://tests/test_gesture.gd",
+	]
+	for path in scripts:
+		var packed: GDScript = load(path)
+		if packed == null or not packed.can_instantiate():
+			printerr("  FAIL %s — script failed to load/instantiate" % path)
+			failures += 1
+			continue
+		var inst: RefCounted = packed.new()
+		inst.tree = self
+		failures += await inst.run_all()
+		inst = null # RefCounted — never .free()
+	print("SUITE RESULT: %s (%d failure(s))" % ["PASS" if failures == 0 else "FAIL", failures])
+	quit(1 if failures > 0 else 0)
