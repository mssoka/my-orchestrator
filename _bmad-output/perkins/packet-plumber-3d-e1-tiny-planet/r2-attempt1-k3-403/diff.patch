+extends RefCounted
+
+## Minimal assertion helper shared by test scripts (no framework — the
+## runner counts `failures` and exits nonzero on any).
+
+var tree: SceneTree
+var failures := 0
+var checks := 0
+
+
+func check(cond: bool, label: String) -> void:
+	checks += 1
+	if cond:
+		print("  ok   %s" % label)
+	else:
+		failures += 1
+		printerr("  FAIL %s" % label)
+
+
+func approx(a: float, b: float, eps := 1e-4) -> bool:
+	return absf(a - b) <= eps
+
+
+func vapprox(a: Vector3, b: Vector3, eps := 1e-4) -> bool:
+	return a.distance_to(b) <= eps
