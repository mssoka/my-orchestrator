@@ -0,0 +1,149 @@
+class_name ConnectController
+extends Node
+
+## E1.3 + E1.4 — the connect verb. While drawing, the pointer ray-casts the
+## planet (physics layer 1) and the preview arc follows the surface
+## projection; a generous snap radius (measured in surface ARC, so the feel
+## is zoom-independent) lifts the target to the nearest qualifying node.
+## Release on a snapped node connects; release elsewhere cancels — no
+## accidental pipes. Committed pipes are registered so parallel same-pair
+## pipes merge into one fatter bundle.
+
+const SNAP_ARC_RAD := 0.24 # ~14° of surface arc — generous
+const PREVIEW_COLOR := Color(1.0, 0.85, 0.6, 0.65)
+
+var _source: NodeSite = null
+var _snap_target: NodeSite = null
+var _preview: PipeArc
+
+@onready var rig: OrbitCamera = get_node("../OrbitRig")
+@onready var nodes_container: Node3D = get_node("../Nodes")
+@onready var pipes_container: Node3D = get_node("../Pipes")
+
+## pair key -> {count: int, arc: PipeArc}
+var _registry := {}
+
+
+func _ready() -> void:
+	_preview = PipeArc.new()
+	_preview.name = "Preview"
+	_preview.visible = false
+	_preview.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
+	var mat := StandardMaterial3D.new()
+	mat.albedo_color = PREVIEW_COLOR
+	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
+	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
+	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
+	_preview.material_override = mat
+	pipes_container.add_child(_preview)
+
+
+func all_sites() -> Array:
+	return nodes_container.get_children().filter(func(c): return c is NodeSite)
+
+
+## Router: a draw gesture started on `site`.
+func draw_begin(site: NodeSite) -> void:
+	_source = site
+	_snap_target = null
+	_preview.visible = false # shown on the first projected move — never a stale arc
+
+
+## Router: pointer moved while drawing — follow the surface projection.
+var _last_preview_end := Vector3.INF
+
+
+func draw_move(screen_pos: Vector2, _rel: Vector2) -> void:
+	if _source == null:
+		return
+	var surface := _project_pointer(screen_pos)
+	if surface == Vector3.INF:
+		return # pointer on the sky — hold the last projection
+	_snap_target = Geodesic.snap_candidate(surface, all_sites(), SNAP_ARC_RAD) as NodeSite
+	if _snap_target == _source:
+		_snap_target = null
+	var end := (_snap_target.global_position if _snap_target else surface)
+	# Rebuild the preview mesh only when the arc end actually moved — motion
+	# events arrive per-frame and a full SurfaceTool rebuild per event churns.
+	if end.distance_to(_last_preview_end) > 1e-4:
+		_last_preview_end = end
+		_show_preview(_source.global_position, end)
+		_preview.visible = true
+
+
+## Router: button released — commit or cancel. A release over open sky
+## (no surface under the pointer) cancels: "releasing elsewhere cancels".
+func draw_end(screen_pos: Vector2) -> void:
+	if _project_pointer(screen_pos) == Vector3.INF:
+		_snap_target = null
+	if _source != null and _snap_target != null and _snap_target != _source:
+		connect_programmatic(_source, _snap_target)
+	_source = null
+	_snap_target = null
+	_preview.visible = false
+	_last_preview_end = Vector3.INF
+
+
+## Focus-loss / system cancel: drop the gesture without committing.
+func draw_cancel() -> void:
+	_source = null
+	_snap_target = null
+	_preview.visible = false
+	_last_preview_end = Vector3.INF
+
+
+## Programmatic commit — used by the release path AND the capture harness so
+## the renders tested in captures are exactly the renders gameplay produces.
+func connect_programmatic(a: NodeSite, b: NodeSite) -> PipeArc:
+	var key := _pair_key(a, b)
+	if _registry.has(key):
+		var entry: Dictionary = _registry[key]
+		entry.count += 1
+		var params: Array = entry.arc.merged_params(entry.count)
+		entry.arc.build(a.global_position, b.global_position, params[0], params[1])
+		_pop(entry.arc)
+		return entry.arc
+	var arc := PipeArc.new()
+	arc.name = "Pipe_%s_%s" % [a.name, b.name]
+	pipes_container.add_child(arc)
+	arc.build(a.global_position, b.global_position, 1.0, 3)
+	_registry[key] = {"count": 1, "arc": arc}
+	return arc
+
+
+func pipe_count(a: NodeSite, b: NodeSite) -> int:
+	var key := _pair_key(a, b)
+	return _registry[key].count if _registry.has(key) else 0
+
+
+func _show_preview(a: Vector3, b: Vector3) -> void:
+	_preview.build(a, b, 1.0, 3)
+	_preview.visible = true
+
+
+## Ray-cast the planet collider (layer 1) — physics so props/ocean behave
+## exactly like the real render. Returns the surface point or Vector3.INF.
+func _project_pointer(screen_pos: Vector2) -> Vector3:
+	var cam := rig.camera
+	var from := cam.project_ray_origin(screen_pos)
+	var dir := cam.project_ray_normal(screen_pos)
+	var query := PhysicsRayQueryParameters3D.create(from, from + dir * 200.0, 0b01)
+	var space := get_viewport().world_3d.direct_space_state
+	var hit := space.intersect_ray(query)
+	if hit.is_empty():
+		return Vector3.INF
+	return hit.position
+
+
+## Pair key — unordered, so A→B and B→A share the bundle.
+func _pair_key(a: NodeSite, b: NodeSite) -> String:
+	var an := str(a.name)
+	var bn := str(b.name)
+	return an + "|" + bn if an < bn else bn + "|" + an
+
+
+func _pop(arc: PipeArc) -> void:
+	var tween := create_tween()
+	arc.scale = Vector3.ONE * 1.18
+	tween.tween_property(arc, "scale", Vector3.ONE, 0.18)\
+		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
