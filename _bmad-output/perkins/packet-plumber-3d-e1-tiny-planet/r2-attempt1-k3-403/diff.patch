@@ -0,0 +1,112 @@
+class_name Geodesic
+extends RefCounted
+
+## Pure great-circle math on a sphere (E1.1 surface-math core).
+## Convention: points are world-space positions relative to the planet CENTER.
+## Surface points have length == planet radius. All functions are static and
+## side-effect free so the headless suite can verify every contract.
+
+const EPS := 1e-6
+
+
+## Central angle between two surface points [rad].
+static func arc_angle(a: Vector3, b: Vector3) -> float:
+	return acos(clampf(a.normalized().dot(b.normalized()), -1.0, 1.0))
+
+
+## Surface arc length between two points at the given radius.
+static func arc_length(a: Vector3, b: Vector3, radius: float) -> float:
+	return radius * arc_angle(a, b)
+
+
+## The rotation axis of the great circle from a to b (unit vector).
+## Deterministic for parallel and antipodal inputs: crosses `a` with the
+## first world axis that avoids the dominant axis of `a`.
+static func geodesic_axis(a: Vector3, b: Vector3) -> Vector3:
+	var ua := a.normalized()
+	var axis := ua.cross(b.normalized())
+	if axis.length() > EPS:
+		return axis.normalized()
+	# Parallel or antipodal — deterministic perpendicular fallback.
+	return _deterministic_perp(ua)
+
+
+static func _deterministic_perp(ua: Vector3) -> Vector3:
+	var ax := Vector3.AXIS_X
+	if absf(ua.x) >= absf(ua.y) and absf(ua.x) >= absf(ua.z):
+		ax = Vector3.AXIS_Y
+	elif absf(ua.y) >= absf(ua.x) and absf(ua.y) >= absf(ua.z):
+		ax = Vector3.AXIS_Z
+	var world := Vector3.ZERO
+	match ax:
+		Vector3.AXIS_X: world = Vector3.RIGHT
+		Vector3.AXIS_Y: world = Vector3.UP
+		Vector3.AXIS_Z: world = Vector3.BACK
+	return ua.cross(world).normalized()
+
+
+## `segments + 1` points on the great circle from a to b (endpoints included).
+## Points sit on the sphere through a and b (radius = |a| — callers pass
+## surface points). Every sample lies on the great-circle plane
+## (dot(p, axis) == 0) — the "no tunneling" guarantee.
+static func geodesic_points(a: Vector3, b: Vector3, segments: int) -> PackedVector3Array:
+	var radius := a.length()
+	var ua := a.normalized()
+	var ub := b.normalized()
+	var axis := geodesic_axis(a, b)
+	var ang := arc_angle(ua, ub)
+	var pts := PackedVector3Array()
+	pts.resize(segments + 1)
+	for i in segments + 1:
+		var t := float(i) / float(segments)
+		pts[i] = ua.rotated(axis, ang * t) * radius
+	return pts
+
+
+## Geodesic path lifted off the surface on "trestles": radius profile is
+## R + elevation * sin(pi * t) — endpoints touch the surface, mid peaks at
+## elevation, and no sample ever drops below R.
+static func elevated_path(a: Vector3, b: Vector3, radius: float, elevation: float, segments: int) -> PackedVector3Array:
+	var raw := geodesic_points(a, b, segments)
+	var pts := PackedVector3Array()
+	pts.resize(raw.size())
+	for i in raw.size():
+		var t := float(i) / float(segments)
+		pts[i] = raw[i].normalized() * (radius + elevation * sin(PI * t))
+	return pts
+
+
+## Ray/sphere projection: first hit of the ray (origin, dir) with the sphere
+## (center, radius). Returns the surface point, or Vector3.INF when missing.
+static func ray_sphere(origin: Vector3, dir: Vector3, center: Vector3, radius: float) -> Vector3:
+	var d := dir.normalized()
+	var oc := origin - center
+	var b := oc.dot(d)
+	var c := oc.length_squared() - radius * radius
+	var disc := b * b - c
+	if disc < 0.0:
+		return Vector3.INF
+	var t := -b - sqrt(disc)
+	if t < 0.0:
+		t = -b + sqrt(disc)
+	if t < 0.0:
+		return Vector3.INF
+	return origin + d * t
+
+
+## Snap-by-intent: among `candidates` (each with a `pos` on the surface),
+## return the one with the SMALLEST surface-arc distance to `point`, provided
+## it is within `snap_arc` [rad]. Returns null when nothing qualifies —
+## the caller cancels. The chosen NODE (not the raw pointer point) is the
+## connection endpoint — that is the "intent, not path" contract.
+static func snap_candidate(point: Vector3, candidates: Array, snap_arc: float) -> Node3D:
+	var best: Node3D = null
+	var best_arc := snap_arc
+	for n in candidates:
+		if n == null or not (n is Node3D):
+			continue
+		var arc := arc_angle(point, (n as Node3D).global_position)
+		if arc <= best_arc:
+			best_arc = arc
+			best = n
+	return best
