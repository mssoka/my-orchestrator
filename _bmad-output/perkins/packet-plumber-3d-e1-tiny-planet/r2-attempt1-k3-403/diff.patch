@@ -0,0 +1,75 @@
+extends "res://tests/test_base.gd"
+
+## E1.2 camera contracts: the up-vector never rolls at any azimuth within the
+## latitude clamp, the clamp holds, and ladder zoom stops are exact.
+
+const R := 5.0
+
+var _rig: OrbitCamera
+
+
+func run_all() -> int:
+	print("[test_camera]")
+	_rig = load("res://scripts/orbit_camera.gd").new()
+	var cam := Camera3D.new()
+	cam.name = "Camera3D"
+	_rig.add_child(cam)
+	tree.root.add_child(_rig)
+	_no_roll_sweep()
+	_clamp_holds()
+	_zoom_ladder()
+	_frame_point_centers_target()
+	tree.root.remove_child(_rig)
+	_rig.free()
+	return failures
+
+
+func _no_roll_sweep() -> void:
+	var worst := 0.0
+	var rolled := false
+	for az in range(0, 24):
+		for lat_deg in [-85.0, -60.0, -30.0, 0.0, 30.0, 60.0, 85.0]:
+			_rig._apply_pose(float(az) * TAU / 24.0, deg_to_rad(lat_deg), 14.0)
+			var up := _rig.camera_up().normalized()
+			var ideal := _rig.ideal_up()
+			var dot := clampf(up.dot(ideal), -1.0, 1.0)
+			var ang := acos(dot)
+			worst = maxf(worst, ang)
+			if ang > 1e-3:
+				rolled = true
+	check(not rolled, "zero roll across full azimuth x clamped-latitude sweep (worst %.9f rad)" % worst)
+
+
+func _clamp_holds() -> void:
+	_rig.orbit(Vector2(0, -100000)) # huge drag toward the north pole
+	_rig._apply_pose(_rig._target_azimuth, _rig._target_latitude, 14.0)
+	var cam_lat := asin(clampf(_rig.camera.global_position.normalized().y, -1.0, 1.0))
+	check(cam_lat <= deg_to_rad(85.0) + 1e-6, "latitude clamps at +85 deg")
+	_rig.orbit(Vector2(0, 200000)) # and back through the south pole
+	_rig._apply_pose(_rig._target_azimuth, _rig._target_latitude, 14.0)
+	cam_lat = asin(clampf(_rig.camera.global_position.normalized().y, -1.0, 1.0))
+	check(cam_lat >= deg_to_rad(-85.0) - 1e-6, "latitude clamps at -85 deg")
+	check(_rig.camera.global_position.length() > R, "camera stays above the surface at clamp")
+
+
+func _zoom_ladder() -> void:
+	_rig.zoom(1)
+	check(approx(_rig._target_distance, 15.5), "ladder step in -> district stop")
+	_rig.zoom(1)
+	check(approx(_rig._target_distance, 11.5), "ladder step in -> street stop")
+	_rig.zoom(1)
+	check(approx(_rig._target_distance, 11.5), "ladder saturates at street (no drift past)")
+	_rig.zoom(-5)
+	check(approx(_rig._target_distance, 22.0), "ladder saturates at globe")
+
+
+func _frame_point_centers_target() -> void:
+	var target := Vector3(R * cos(0.5) * cos(0.9), R * sin(0.5), R * cos(0.5) * sin(0.9))
+	_rig.frame_point(target, 0)
+	_rig._apply_pose(_rig._target_azimuth, _rig._target_latitude, _rig._target_distance)
+	var cam := _rig.camera.global_position.normalized()
+	# The camera rides rig +Z ABOVE the point (same side — looking down at it).
+	check(vapprox(cam, target.normalized(), 1e-4), "frame_point puts the camera above the target")
+	var to_target := (target - _rig.camera.global_position).normalized()
+	var forward := -_rig.camera.global_transform.basis.z.normalized()
+	check(vapprox(forward, to_target, 1e-3), "camera forward aims at the framed point")
