+class_name OrbitCamera
+extends Node3D
+
+## E1.2 — turntable orbit rig. The rig sits at the planet center; the Camera3D
+## child rides +Z at the current distance. No-roll guarantee: the rig basis is
+## composed as yaw(world-Y) * pitch(local-X), so basis.y always stays in the
+## plane spanned by world-up and the view direction — the horizon never rolls,
+## at any azimuth, for any latitude in the clamp.
+## View-layer discipline (canon): this rig reads no sim state — there IS no
+## sim in E1 — and mutates nothing outside itself.
+
+const LAT_LIMIT_DEG := 85.0
+const ZOOM_STOPS := [22.0, 15.5, 11.5] # globe / district / street (R = 8 — street hovers ~3.5 units up)
+const ORBIT_SENS := 0.0055 # rad per pixel
+const EASE_RATE := 10.0 # exponential damping rate
+
+@onready var camera: Camera3D = $Camera3D
+
+var _azimuth := 0.6
+var _latitude := 0.35
+var _distance := ZOOM_STOPS[0]
+var _target_azimuth := 0.6
+var _target_latitude := 0.35
+var _target_distance := ZOOM_STOPS[0]
+var _zoom_index := 0
+
+
+func _ready() -> void:
+	_apply_pose(_azimuth, _latitude, _distance)
+
+
+## Drag-delta entry point (called by the input router while orbiting).
+func orbit(delta_screen: Vector2) -> void:
+	_target_azimuth = wrapf(_target_azimuth - delta_screen.x * ORBIT_SENS, 0.0, TAU)
+	_target_latitude = clampf(
+		_target_latitude - delta_screen.y * ORBIT_SENS,
+		deg_to_rad(-LAT_LIMIT_DEG), deg_to_rad(LAT_LIMIT_DEG)
+	)
+
+
+## Ladder zoom: each step eases to a stop, never continuous drift.
+func zoom(step: int) -> void:
+	_zoom_index = clampi(_zoom_index + step, 0, ZOOM_STOPS.size() - 1)
+	_target_distance = ZOOM_STOPS[_zoom_index]
+
+
+## Frame a surface point (center it on screen) — used by captures and later
+## by limb-marker navigation. View-layer only.
+func frame_point(p: Vector3, stop_index: int) -> void:
+	var n := p.normalized()
+	# The camera rides rig +Z, so the rig must face the SAME side as the
+	# point: solve basis.z = (cos lat·sin az, sin lat, cos lat·cos az) = n
+	# for the turntable angles. (Pointing the rig AWAY from n photographs
+	# the antipode — verified the hard way in captures, 2026-09-04.)
+	_target_azimuth = atan2(n.x, n.z)
+	_target_latitude = clampf(asin(clampf(n.y, -1.0, 1.0)), deg_to_rad(-LAT_LIMIT_DEG), deg_to_rad(LAT_LIMIT_DEG))
+	_zoom_index = clampi(stop_index, 0, ZOOM_STOPS.size() - 1)
+	_target_distance = ZOOM_STOPS[_zoom_index]
+
+
+func _process(delta: float) -> void:
+	var k := 1.0 - exp(-EASE_RATE * delta)
+	_azimuth = lerp_angle(_azimuth, _target_azimuth, k)
+	_latitude = lerpf(_latitude, _target_latitude, k)
+	_distance = lerpf(_distance, _target_distance, k)
+	_apply_pose(_azimuth, _latitude, _distance)
+
+
+## Jump straight to the current targets (captures, programmatic framing).
+func snap() -> void:
+	_azimuth = _target_azimuth
+	_latitude = _target_latitude
+	_distance = _target_distance
+	_apply_pose(_azimuth, _latitude, _distance)
+
+
+## Deterministic pose application — the single place the rig basis is built.
+## Public + pure so the headless suite can sweep it for the no-roll contract.
+func _apply_pose(azimuth: float, latitude: float, distance: float) -> void:
+	var lat := clampf(latitude, deg_to_rad(-LAT_LIMIT_DEG), deg_to_rad(LAT_LIMIT_DEG))
+	var pose := Basis(Vector3.UP, azimuth) * Basis(Vector3.RIGHT, -lat)
+	transform = Transform3D(pose, Vector3.ZERO)
+	# The camera rides +Z with IDENTITY local rotation: it inherits the rig
+	# basis, so its -Z points at the planet center and its up IS the rig's
+	# roll-free basis.y. (Never look_at from here — look_at takes GLOBAL
+	# coordinates and would pin the camera to the world +Z axis.)
+	camera.transform = Transform3D(Basis.IDENTITY, Vector3(0, 0, distance))
+
+
+## Test/inspection helper: the camera's world-space up vector.
+func camera_up() -> Vector3:
+	return camera.global_transform.basis.y
+
+
+## Test/inspection helper: ideal roll-free up for the current pose.
+func ideal_up() -> Vector3:
+	var view := (global_position - camera.global_position).normalized()
+	var up := Vector3.UP - view * Vector3.UP.dot(view)
+	return up.normalized()
