+class_name NodeSite
+extends Area3D
+
+## E1.5 — a connectable node: a chunky primitive building staged on a wedge,
+## oriented to the surface normal. Placeholder art per doctrine (primitives +
+## palette tokens only). Carries a collision sphere on physics layer 2 so the
+## input router can tell "press on a node" (draw) from "press on space" (orbit).
+
+const HOUSE_SCALE := Vector3(0.8, 0.55, 0.7)
+const ROUTER_SCALE := Vector3(0.45, 0.8, 0.45)
+
+var site_name := ""
+var kind := "house" # "house" | "router"
+var surface_pos := Vector3.ZERO # world-space surface point (length R)
+
+
+func setup(info: Dictionary) -> void:
+	site_name = info.name
+	kind = info.kind
+	surface_pos = info.pos
+	name = site_name
+	collision_layer = 2
+	collision_mask = 0
+	monitoring = false
+
+	var shape := CollisionShape3D.new()
+	var sphere := SphereShape3D.new()
+	sphere.radius = 0.95
+	shape.shape = sphere
+	shape.position = Vector3(0, 0.35, 0)
+	add_child(shape)
+
+	_orient_to_surface()
+	_build_visual()
+
+
+func _orient_to_surface() -> void:
+	var n := surface_pos.normalized()
+	var helper := Vector3.UP if absf(n.dot(Vector3.UP)) < 0.99 else Vector3.RIGHT
+	var t1 := n.cross(helper).normalized()
+	var t2 := t1.cross(n).normalized() # right-handed: det(t1, n, t2) = +1
+	global_transform = Transform3D(Basis(t1, n, t2), surface_pos * 1.01)
+
+
+func _build_visual() -> void:
+	var root := Node3D.new()
+	root.name = "Visual"
+	add_child(root)
+	if kind == "router":
+		_build_router(root)
+	else:
+		_build_house(root)
+
+
+func _build_house(root: Node3D) -> void:
+	var body := MeshInstance3D.new()
+	var box := BoxMesh.new()
+	box.size = HOUSE_SCALE
+	body.mesh = box
+	body.position = Vector3(0, HOUSE_SCALE.y * 0.5, 0)
+	body.material_override = _mat(WorldSeed.COL_WALL)
+	root.add_child(body)
+
+	var roof := MeshInstance3D.new()
+	var prism := PrismMesh.new()
+	prism.size = Vector3(HOUSE_SCALE.x * 1.12, 0.34, HOUSE_SCALE.z * 1.12)
+	roof.mesh = prism
+	roof.position = Vector3(0, HOUSE_SCALE.y + 0.16, 0)
+	roof.material_override = _mat(WorldSeed.COL_ROOF)
+	root.add_child(roof)
+
+
+func _build_router(root: Node3D) -> void:
+	var tower := MeshInstance3D.new()
+	var box := BoxMesh.new()
+	box.size = ROUTER_SCALE
+	tower.mesh = box
+	tower.position = Vector3(0, ROUTER_SCALE.y * 0.5, 0)
+	tower.material_override = _mat(WorldSeed.COL_ROUTER)
+	root.add_child(tower)
+
+	var antenna := MeshInstance3D.new()
+	var cyl := CylinderMesh.new()
+	cyl.top_radius = 0.03
+	cyl.bottom_radius = 0.03
+	cyl.height = 0.55
+	antenna.mesh = cyl
+	antenna.position = Vector3(0, ROUTER_SCALE.y + 0.27, 0)
+	antenna.material_override = _mat(WorldSeed.COL_ROUTER)
+	root.add_child(antenna)
+
+	var beacon := MeshInstance3D.new()
+	var tip := SphereMesh.new()
+	tip.radius = 0.07
+	tip.height = 0.14
+	tip.radial_segments = 8
+	tip.rings = 4
+	beacon.mesh = tip
+	beacon.position = Vector3(0, ROUTER_SCALE.y + 0.57, 0)
+	beacon.material_override = _mat(WorldSeed.COL_CABLE)
+	root.add_child(beacon)
+
+
+func _mat(col: Color) -> StandardMaterial3D:
+	var m := StandardMaterial3D.new()
+	m.albedo_color = col
+	m.roughness = 1.0
+	return m
