+extends Node
+
+## Capture harness (A4): INERT during normal play — activates only when the
+## game is launched with `-- --capture`. Sequences the camera through the
+## proof shots (globe / district / completed arc / parallel bundle), commits
+## real pipes through the real ConnectController, and saves PNGs to
+## `captures/`. Runs windowed (never --headless — headless has no renderer).
+
+const OUT_DIR := "res://captures"
+
+var _controller: ConnectController
+var _rig: OrbitCamera
+
+
+func _ready() -> void:
+	if not _activated():
+		return
+	_controller = get_node("../ConnectController")
+	_rig = get_node("../OrbitRig")
+	_run()
+
+
+func _activated() -> bool:
+	for arg in OS.get_cmdline_user_args():
+		if arg == "--capture" or arg.begins_with("--capture="):
+			return true
+	return false
+
+
+func _run() -> void:
+	var dir_err := DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT_DIR))
+	if dir_err != OK:
+		push_error("capture: cannot create %s (err %d)" % [OUT_DIR, dir_err])
+		get_tree().quit(1)
+		return
+	await _settle() # children _ready run before main.gd stages the world — wait for it
+	var sites: Array = get_node("../Nodes").get_children().filter(func(c): return c is NodeSite)
+	if sites.size() < 2:
+		push_error("capture: need >= 2 staged nodes")
+		get_tree().quit(1)
+		return
+	# 1 — full globe framed BETWEEN two wedges so two land biomes + an ocean
+	# channel read together (the reference f0 composition).
+	var spread := _most_spread_pair(sites)
+	var frame_p: Vector3 = ((spread[0] as Node3D).global_position + (spread[1] as Node3D).global_position) * 0.5
+	_rig.frame_point(frame_p, 0)
+	_rig.snap()
+	await _settle()
+	await _shot("01-globe-biomes.png")
+	# 2 — district working altitude: frame a readable ~0.65 rad span so the
+	# view is oblique (roofs + terrain, ref f2 style).
+	var near_pair := _readable_pair(sites)
+	_rig.frame_point(_arc_mid(near_pair[0], near_pair[1]), 1)
+	_rig.snap()
+	await _settle()
+	await _shot("02-district.png")
+	# 3 — a completed arc between two buildings (committed via the real verb path):
+	# a readable ~0.65 rad span, framed on the arc midpoint so both buildings
+	# + the full cable read in one shot.
+	var pair := _readable_pair(sites)
+	var a: NodeSite = pair[0]
+	var b: NodeSite = pair[1]
+	_controller.connect_programmatic(a, b)
+	_rig.frame_point(_arc_mid(a, b), 1)
+	_rig.snap()
+	await _settle()
+	await _shot("03-arc-connected.png")
+	# 4 — parallel pipes merged into one fatter bundle, street-close on the cable.
+	_controller.connect_programmatic(a, b)
+	_controller.connect_programmatic(a, b)
+	_rig.frame_point(_arc_mid(a, b), 2)
+	_rig.snap()
+	await _settle()
+	await _shot("04-parallel-bundle.png")
+	print("capture: done -> %s" % ProjectSettings.globalize_path(OUT_DIR))
+	get_tree().quit(0)
+
+
+func _settle(frames := 24) -> void:
+	for i in frames:
+		await get_tree().process_frame
+
+
+## The site pair with the largest angular separation — framing between them
+## catches two wedges + the channel in one globe shot.
+func _most_spread_pair(sites: Array) -> Array:
+	var best := [sites[0], sites[1]]
+	var best_arc := -1.0
+	for i in sites.size():
+		for j in range(i + 1, sites.size()):
+			var arc := Geodesic.arc_angle(sites[i].global_position, sites[j].global_position)
+			if arc > best_arc:
+				best_arc = arc
+				best = [sites[i], sites[j]]
+	return best
+
+
+func _shot(file_name: String) -> void:
+	await RenderingServer.frame_post_draw
+	var img := get_viewport().get_texture().get_image()
+	var path := OUT_DIR.path_join(file_name)
+	var err := img.save_png(ProjectSettings.globalize_path(path))
+	if err != OK:
+		push_error("capture: failed to save %s (err %d)" % [file_name, err])
+		get_tree().quit(1)
+		return
+	print("capture: %s (%d KB)" % [file_name, int(img.get_data().size() / 1024.0)])
+
+## The pair whose span is closest to TARGET_ARC — readable in one frame.
+func _readable_pair(sites: Array) -> Array:
+	var best := [sites[0], sites[1]]
+	var best_diff := 1e9
+	for i in sites.size():
+		for j in range(i + 1, sites.size()):
+			var diff: float = absf(Geodesic.arc_angle(sites[i].global_position, sites[j].global_position) - 0.65)
+			if diff < best_diff:
+				best_diff = diff
+				best = [sites[i], sites[j]]
+	return best
+
+
+## Midpoint direction of the geodesic between two sites (antipodal-safe:
+## the normalized-sum trick degenerates for opposite pairs).
+func _arc_mid(a: NodeSite, b: NodeSite) -> Vector3:
+	var mid := Geodesic.geodesic_points(a.global_position, b.global_position, 2)[1]
+	return mid * WorldSeed.PLANET_RADIUS
