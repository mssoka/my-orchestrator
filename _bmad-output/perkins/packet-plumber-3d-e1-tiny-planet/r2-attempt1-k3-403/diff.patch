+++ b/scripts/world_seed.gd
@@ -0,0 +1,176 @@
+class_name WorldSeed
+extends RefCounted
+
+## The owned-RNG spine (E1): one integer seed deterministically drives the
+## wedge layout, coastline jitter, node placement and surface color noise.
+## No wall-clock, no global RNG state — every draw comes from a seed-derived
+## stream so two runs build byte-identical worlds.
+
+const PLANET_RADIUS := 8.0
+
+# Slice-1 palette tokens (GDD Art Direction, prototype-starting range).
+const COL_SPACE := Color("16243a")
+const COL_GRASS := Color("5fae5f")
+const COL_SAND := Color("d9c07a")
+const COL_ARCTIC := Color("dfe8ee")
+const COL_WATER := Color("3fb8af")
+const COL_CABLE := Color("c96f3a") # saturated accent — network elements only
+const COL_ROOF := Color("b0492f") # barn red — distinct from the RESERVED crisis red #c94b3c (E3.4/E9)
+const COL_WALL := Color("f2e9d8")
+const COL_ROUTER := Color("4a5a6e")
+
+const WEDGE_SPANS_DEG := [112.0, 100.0, 88.0]
+const GAP_FRACTION := 0.88 # wedges may claim up to this of their slot — wider ocean channels read like the ref
+const BAND_COUNT := 26 # latitude bands → zigzag coastline segments
+const COAST_JITTER_RAD := 0.11 # ± coastline wiggle [rad of longitude]
+const MIN_NODE_SEPARATION_RAD := 0.25 # keeps node hitboxes (r 0.95) from overlapping
+
+
+## 32-bit mix (splitmix family) — owned deterministic hash.
+static func hash_i32(x: int) -> int:
+	var z := x & 0xFFFFFFFF
+	z = ((z ^ (z >> 16)) * 0x45D9F3B) & 0xFFFFFFFF
+	z = ((z ^ (z >> 16)) * 0x45D9F3B) & 0xFFFFFFFF
+	return z ^ (z >> 16)
+
+
+## Deterministic float in [0, 1) from an integer stream position.
+static func unit_f(stream: int, salt: int) -> float:
+	return float(hash_i32(stream * 0x9E3779B1 + salt)) / 4294967296.0
+
+
+static func make_rng(seed_value: int) -> RandomNumberGenerator:
+	var rng := RandomNumberGenerator.new()
+	rng.seed = seed_value
+	return rng
+
+
+## 3 MVP biome wedge sectors over longitude. Layout:
+## {order: [Color..], spans: [rad..], starts: [rad..], gaps: [rad..]}
+static func wedge_layout(seed_value: int) -> Dictionary:
+	var rng := make_rng(seed_value + 101)
+	var colors: Array[Color] = [COL_GRASS, COL_SAND, COL_ARCTIC]
+	# Fisher-Yates with the seeded rng.
+	for i in range(colors.size() - 1, 0, -1):
+		var j := rng.randi_range(0, i)
+		var tmp: Color = colors[i]
+		colors[i] = colors[j]
+		colors[j] = tmp
+	var spans: Array[float] = []
+	var gaps: Array[float] = []
+	var starts: Array[float] = []
+	for s in WEDGE_SPANS_DEG:
+		spans.append(deg_to_rad(s) * rng.randf_range(GAP_FRACTION, 1.0))
+	var total := 0.0
+	for s in spans:
+		total += s
+	var gap := (TAU - total) / 3.0
+	for i in 3:
+		gaps.append(gap)
+	var cursor := rng.randf() * TAU
+	for i in 3:
+		starts.append(cursor)
+		cursor += spans[i] + gap
+	return {"order": colors, "spans": spans, "starts": starts, "gaps": gaps}
+
+
+## Smooth-quantized coastline noise for wedge `wi` boundary at latitude
+## `lat_rad`: piecewise-linear over BAND_COUNT bands (the soft zigzag).
+static func coast_noise(seed_value: int, wi: int, end_side: int, lat_rad: float) -> float:
+	var band_f := (lat_rad + PI * 0.5) / PI * float(BAND_COUNT)
+	var band := clampi(int(band_f), 0, BAND_COUNT - 1)
+	var frac := clampf(band_f - float(band), 0.0, 1.0)
+	var h0 := unit_f(seed_value, wi * 7919 + end_side * 104729 + band * 31337)
+	var h1 := unit_f(seed_value, wi * 7919 + end_side * 104729 + (band + 1) * 31337)
+	var v := lerpf(h0, h1, frac) * 2.0 - 1.0
+	return v * COAST_JITTER_RAD
+
+
+## True when longitude `lon` [rad, wrapped 0..TAU) lies inside wedge `wi`.
+static func in_wedge(layout: Dictionary, seed_value: int, wi: int, lon: float, lat_rad: float) -> bool:
+	var start: float = layout.starts[wi]
+	var span: float = layout.spans[wi]
+	var mid := start + span * 0.5
+	var d := fposmod(lon - mid + PI, TAU) - PI
+	var half := span * 0.5
+	var n_start := coast_noise(seed_value, wi, 0, lat_rad)
+	var n_end := coast_noise(seed_value, wi, 1, lat_rad)
+	return d >= -half + minf(n_start, 0.0) and d <= half + maxf(n_end, 0.0)
+
+
+## Biome index for a surface point: 0..2 wedge, -1 ocean.
+static func biome_at(layout: Dictionary, seed_value: int, p: Vector3) -> int:
+	var n := p.normalized()
+	var lon := fposmod(atan2(n.z, n.x), TAU)
+	var lat := asin(clampf(n.y, -1.0, 1.0))
+	for wi in 3:
+		if in_wedge(layout, seed_value, wi, lon, lat):
+			return wi
+	return -1
+
+
+## Seeded node placement: per wedge 2 routers + 9 houses with a minimum
+## angular separation (decaying only in the deterministic fallback), all
+## positions on the sphere at R. Returns Array[Dictionary]:
+## {name, pos, kind} — kind: "router" | "house".
+static func node_placements(seed_value: int, layout: Dictionary) -> Array:
+	var rng := make_rng(seed_value + 907)
+	var placed: Array[Vector3] = []
+	var out: Array = []
+	var idx := 0
+	for wi in 3:
+		# 2 routers + 9 houses per wedge — a world with MANY connectables.
+		var kinds := [
+			"router", "house", "house", "house", "house", "house",
+			"house", "house", "house", "router", "house",
+		]
+		for k in kinds.size():
+			var pos := _placement_attempt(rng, layout, wi, placed)
+			placed.append(pos)
+			idx += 1
+			out.append({
+				"name": "n%02d" % idx,
+				"pos": pos * PLANET_RADIUS,
+				"kind": kinds[k],
+			})
+	return out
+
+
+static func _placement_attempt(rng: RandomNumberGenerator, layout: Dictionary, wi: int, placed: Array[Vector3]) -> Vector3:
+	var span: float = layout.spans[wi]
+	var start: float = layout.starts[wi]
+	var inset := span * 0.22
+	for attempt in 80:
+		# Separation decays deterministically across attempts (25% floor) so
+		# dense layouts still place while early attempts keep full separation.
+		var sep := MIN_NODE_SEPARATION_RAD * maxf(1.0 - float(attempt) / 80.0, 0.25)
+		var lon := start + inset + rng.randf() * (span - inset * 2.0)
+		var lat := deg_to_rad(rng.randf_range(-58.0, 58.0))
+		var p := _from_lon_lat(lon, lat)
+		var ok := true
+		for q in placed:
+			if Geodesic.arc_angle(p, q) < sep:
+				ok = false
+				break
+		if ok:
+			return p
+	# Deterministic last resort: FRESH wedge-center candidates (jittered by
+	# the attempt index), still honoring a 50%-of-minimum separation against
+	# everything placed (10 real tries, not 10 re-checks of one point).
+	var fallback := Vector3.ZERO
+	for attempt in 10:
+		fallback = _from_lon_lat(
+			start + span * 0.5 + (float(attempt) - 5.0) * 0.02,
+			deg_to_rad(rng.randf_range(-40.0, 40.0)))
+		var ok := true
+		for q in placed:
+			if Geodesic.arc_angle(fallback, q) < MIN_NODE_SEPARATION_RAD * 0.5:
+				ok = false
+				break
+		if ok:
+			return fallback
+	return fallback
+
+
+static func _from_lon_lat(lon: float, lat: float) -> Vector3:
+	return Vector3(cos(lat) * cos(lon), sin(lat), cos(lat) * sin(lon))
