new file mode 100644
index 0000000..679aa48
--- /dev/null
+++ b/tests/test_geodesic.gd
@@ -0,0 +1,116 @@
+extends "res://tests/test_base.gd"
+
+## E1.1 geodesic-math contracts: arc length truth, great-circle plane
+## containment (no tunneling), elevation profile, antipodal determinism,
+## ray/sphere projection.
+
+const R := 5.0
+
+
+func run_all() -> int:
+	print("[test_geodesic]")
+	_arc_length_quarter()
+	_plane_containment()
+	_elevation_profile()
+	_antipodal_deterministic()
+	_ray_sphere()
+	_snap_selection()
+	return failures
+
+
+func _arc_length_quarter() -> void:
+	var a := Vector3(R, 0, 0)
+	var b := Vector3(0, R, 0)
+	check(approx(Geodesic.arc_length(a, b, R), PI * R / 2.0), "quarter great circle = pi*R/2")
+	check(approx(Geodesic.arc_angle(a, b), PI / 2.0), "quarter arc angle = pi/2")
+
+
+func _plane_containment() -> void:
+	for pair in [[Vector3(R, 0, 0), Vector3(0, R, 0)], [Vector3(R, 0, 0), Vector3(0, -R * 0.3, R * 0.9).normalized() * R], [Vector3(R * 0.2, R, R * 0.4).normalized() * R, Vector3(-R, 0, R * 0.2).normalized() * R]]:
+		var a: Vector3 = pair[0]
+		var b: Vector3 = pair[1]
+		var axis := Geodesic.geodesic_axis(a, b)
+		var pts := Geodesic.geodesic_points(a, b, 32)
+		var on_plane := true
+		var on_sphere := true
+		for p in pts:
+			if absf(p.normalized().dot(axis)) > 1e-5:
+				on_plane = false
+			if absf(p.length() - R) > 1e-5:
+				on_sphere = false
+		check(on_plane, "path stays on the great-circle plane (%s)" % _pair_label(a, b))
+		check(on_sphere, "every path sample sits ON the surface (no tunneling) (%s)" % _pair_label(a, b))
+		check(vapprox(pts[0], a.normalized() * R), "path starts at a")
+		check(vapprox(pts[pts.size() - 1], b.normalized() * R), "path ends at b")
+
+
+func _elevation_profile() -> void:
+	var a := Vector3(R, 0, 0)
+	var b := Vector3(0, R * 0.6, R * 0.8).normalized() * R
+	var elev := 0.3
+	var pts := Geodesic.elevated_path(a, b, R, elev, 16)
+	var never_below := true
+	for p in pts:
+		if p.length() < R - 1e-6:
+			never_below = false
+	check(never_below, "elevated path never dips below the surface")
+	check(approx(pts[0].length(), R), "elevated path starts on the surface")
+	check(approx(pts[8].length(), R + elev, 1e-5), "mid-arc peak = R + elevation")
+
+
+func _antipodal_deterministic() -> void:
+	var a := Vector3(R, 0, 0)
+	var b := Vector3(-R, 0, 0)
+	var axis := Geodesic.geodesic_axis(a, b)
+	var pts := Geodesic.geodesic_points(a, b, 16)
+	var on_plane := true
+	for p in pts:
+		if absf(p.dot(axis)) > 1e-5:
+			on_plane = false
+	check(on_plane, "antipodal path lies on a deterministic great circle")
+	check(vapprox(pts[16], b), "antipodal endpoint reaches b")
+	check(approx(pts[8].dot(a), 0.0, 1e-5), "antipodal midpoint sits 90 deg from a")
+	check(approx(pts[8].length(), R), "antipodal midpoint on the surface")
+	var axis_again := Geodesic.geodesic_axis(a, b)
+	check(vapprox(axis, axis_again), "antipodal axis choice is stable")
+
+
+func _ray_sphere() -> void:
+	var hit := Geodesic.ray_sphere(Vector3(10, 0, 0), Vector3(-1, 0, 0), Vector3.ZERO, R)
+	check(vapprox(hit, Vector3(R, 0, 0)), "ray at sphere hits nearest point")
+	var miss := Geodesic.ray_sphere(Vector3(10, 20, 0), Vector3(-1, 0, 0), Vector3.ZERO, R)
+	check(miss == Vector3.INF, "ray past the limb misses (INF)")
+	var inside := Geodesic.ray_sphere(Vector3.ZERO, Vector3(0, 0, -1), Vector3.ZERO, R)
+	check(approx(inside.length(), R), "ray from inside hits the far side")
+
+
+func _snap_selection() -> void:
+	var cursor := Vector3(R, 0, 0)
+	var near_node := Node3D.new()
+	near_node.name = "near"
+	var far_node := Node3D.new()
+	far_node.name = "far"
+	var outside_node := Node3D.new()
+	outside_node.name = "outside"
+	tree.root.add_child(near_node)
+	tree.root.add_child(far_node)
+	tree.root.add_child(outside_node)
+	near_node.global_position = Vector3(R * cos(0.08), R * sin(0.08), 0)
+	far_node.global_position = Vector3(R * cos(0.11), R * sin(0.11), 0)
+	outside_node.global_position = Vector3(R * cos(0.6), R * sin(0.6), 0)
+	var picked := Geodesic.snap_candidate(cursor, [far_node, outside_node, near_node], 0.24)
+	check(picked == near_node, "snap picks the minimum-ARC node within radius")
+	var none := Geodesic.snap_candidate(cursor, [outside_node], 0.24)
+	check(none == null, "no candidate within radius -> null (cancel)")
+	var anti := Geodesic.snap_candidate(cursor, [far_node, near_node], 0.24)
+	check(anti == near_node, "snap order-independent (nearest arc wins)")
+	tree.root.remove_child(near_node)
+	tree.root.remove_child(far_node)
+	tree.root.remove_child(outside_node)
+	near_node.free()
+	far_node.free()
+	outside_node.free()
+
+
+func _pair_label(a: Vector3, b: Vector3) -> String:
+	return "%s->%s" % [a.snappedf(0.01), b.snappedf(0.01)]
