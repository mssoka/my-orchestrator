@@ -0,0 +1,203 @@
+class_name Planet
+extends Node3D
+
+## E1.1 — the tiny planet: a seeded icosphere whose faces are colored by
+## biome wedge (grass / sand / arctic) with zigzag coastlines; ocean gaps
+## expose the turquoise water sphere at the horizon. Flat-shaded, vertex
+## colored — the little-planet look-parity base. Also owns the sky dressing
+## (stars, drifting clouds) and the full-sphere collider used by the
+## connect verb's ray-casts.
+
+const SUBDIV := 4
+const WATER_SINK := 0.06 # water sphere below the land radius — shows through the wedge-gap ocean channels (look ref f0)
+
+var _seed := 0
+var _layout := {}
+
+
+func generate(seed_value: int, layout: Dictionary) -> void:
+	_seed = seed_value
+	_layout = layout
+	_build_land()
+	_build_water()
+	_build_collider()
+	_build_stars()
+	_build_clouds()
+
+
+func radius() -> float:
+	return WorldSeed.PLANET_RADIUS
+
+
+func _build_land() -> void:
+	var st := SurfaceTool.new()
+	st.begin(Mesh.PRIMITIVE_TRIANGLES)
+	var faces := _icosphere_faces(SUBDIV)
+	for fi in faces.size():
+		var tri: Array = faces[fi]
+		var centroid: Vector3 = (tri[0] + tri[1] + tri[2]) / 3.0
+		var biome := WorldSeed.biome_at(_layout, _seed, centroid)
+		if biome < 0:
+			continue # ocean gap — water sphere shows through
+		var col: Color = _face_color(biome, fi)
+		for vi in 3:
+			st.set_color(col)
+			st.add_vertex(tri[vi])
+	st.generate_normals()
+	var mesh := st.commit()
+	var mi := MeshInstance3D.new()
+	mi.name = "Land"
+	mi.mesh = mesh
+	var mat := StandardMaterial3D.new()
+	mat.vertex_color_use_as_albedo = true
+	mat.roughness = 1.0
+	mesh.surface_set_material(0, mat)
+	add_child(mi)
+
+
+func _face_color(biome: int, face_idx: int) -> Color:
+	var base: Color = _layout.order[biome]
+	var j := WorldSeed.unit_f(_seed, face_idx * 2654435761)
+	return base.lerp(Color.BLACK if j < 0.5 else Color.WHITE, absf(j - 0.5) * 0.16)
+
+
+func _build_water() -> void:
+	var mi := MeshInstance3D.new()
+	mi.name = "Water"
+	var sphere := SphereMesh.new()
+	sphere.radius = radius() - WATER_SINK
+	sphere.height = (radius() - WATER_SINK) * 2.0
+	sphere.radial_segments = 48
+	sphere.rings = 24
+	mi.mesh = sphere
+	var mat := StandardMaterial3D.new()
+	mat.albedo_color = WorldSeed.COL_WATER
+	mat.roughness = 0.6
+	mi.material_override = mat
+	add_child(mi)
+
+
+func _build_collider() -> void:
+	var body := StaticBody3D.new()
+	body.name = "Collider"
+	body.collision_layer = 1
+	body.collision_mask = 0
+	var shape := CollisionShape3D.new()
+	var sphere := SphereShape3D.new()
+	sphere.radius = radius()
+	shape.shape = sphere
+	body.add_child(shape)
+	add_child(body)
+
+
+func _build_stars() -> void:
+	var mm := MultiMesh.new()
+	mm.transform_format = MultiMesh.TRANSFORM_3D
+	var star := SphereMesh.new()
+	star.radius = 0.08
+	star.height = 0.16
+	star.radial_segments = 6
+	star.rings = 3
+	mm.mesh = star
+	var count := 140
+	mm.instance_count = count
+	for i in count:
+		var dir := Vector3(
+			WorldSeed.unit_f(_seed, 70000 + i) * 2.0 - 1.0,
+			WorldSeed.unit_f(_seed, 80000 + i) * 2.0 - 1.0,
+			WorldSeed.unit_f(_seed, 90000 + i) * 2.0 - 1.0
+		).normalized()
+		var t := Transform3D(Basis.IDENTITY, dir * 70.0)
+		mm.set_instance_transform(i, t)
+	var mmi := MultiMeshInstance3D.new()
+	mmi.name = "Stars"
+	mmi.multimesh = mm
+	var mat := StandardMaterial3D.new()
+	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
+	mat.albedo_color = Color(0.92, 0.95, 1.0)
+	mmi.material_override = mat
+	add_child(mmi)
+
+
+func _build_clouds() -> void:
+	var container := Node3D.new()
+	container.name = "Clouds"
+	add_child(container)
+	for i in 4:
+		var cloud := Node3D.new()
+		var dir := Vector3(
+			WorldSeed.unit_f(_seed, 41000 + i) * 2.0 - 1.0,
+			WorldSeed.unit_f(_seed, 42000 + i) * 2.0 - 1.0,
+			WorldSeed.unit_f(_seed, 43000 + i) * 2.0 - 1.0
+		).normalized()
+		cloud.position = dir * (radius() * 1.55)
+		for puff in 3:
+			var mi := MeshInstance3D.new()
+			var sphere := SphereMesh.new()
+			var r := 0.5 + WorldSeed.unit_f(_seed, 44000 + puff * 10 + i) * 0.4
+			sphere.radius = r
+			sphere.height = r * 1.2
+			sphere.radial_segments = 10
+			sphere.rings = 6
+			mi.mesh = sphere
+			mi.scale = Vector3(1.0, 0.55, 1.0)
+			mi.position = Vector3(puff * 0.7 - 0.7, WorldSeed.unit_f(_seed, 45000 + i * 10 + puff) * 0.3, 0)
+			var mat := StandardMaterial3D.new()
+			mat.albedo_color = Color(0.98, 0.99, 1.0)
+			mat.roughness = 1.0
+			mi.material_override = mat
+			cloud.add_child(mi)
+		container.add_child(cloud)
+
+
+# --- icosphere construction -------------------------------------------------
+
+func _icosphere_faces(subdiv: int) -> Array:
+	var t := (1.0 + sqrt(5.0)) / 2.0
+	var verts := [
+		Vector3(-1, t, 0).normalized(), Vector3(1, t, 0).normalized(),
+		Vector3(-1, -t, 0).normalized(), Vector3(1, -t, 0).normalized(),
+		Vector3(0, -1, t).normalized(), Vector3(0, 1, t).normalized(),
+		Vector3(0, -1, -t).normalized(), Vector3(0, 1, -t).normalized(),
+		Vector3(t, 0, -1).normalized(), Vector3(t, 0, 1).normalized(),
+		Vector3(-t, 0, -1).normalized(), Vector3(-t, 0, 1).normalized(),
+	]
+	var faces := [
+		[0, 11, 5], [0, 5, 1], [0, 1, 7], [0, 7, 10], [0, 10, 11],
+		[1, 5, 9], [5, 11, 4], [11, 10, 2], [10, 7, 6], [7, 1, 8],
+		[3, 9, 4], [3, 4, 2], [3, 2, 6], [3, 6, 8], [3, 8, 9],
+		[4, 9, 5], [2, 4, 11], [6, 2, 10], [8, 6, 7], [9, 8, 1],
+	]
+	var cache := {}
+	var out := []
+	for f in faces:
+		out.append_array(_subdivide(verts[f[0]], verts[f[1]], verts[f[2]], subdiv, cache))
+	return out
+
+
+func _subdivide(a: Vector3, b: Vector3, c: Vector3, depth: int, cache: Dictionary) -> Array:
+	if depth == 0:
+		# Winding swapped (a, c, b): the base icosahedron table is clockwise;
+		# Godot front-faces are counter-clockwise, so leaves emit reversed
+		# triangles — normals point OUTWARD (verified in captures: 2026-09-04).
+		return [[a * radius(), c * radius(), b * radius()]]
+	var ab := _midpoint(a, b, cache)
+	var bc := _midpoint(b, c, cache)
+	var ca := _midpoint(c, a, cache)
+	var out := []
+	out.append_array(_subdivide(a, ab, ca, depth - 1, cache))
+	out.append_array(_subdivide(b, bc, ab, depth - 1, cache))
+	out.append_array(_subdivide(c, ca, bc, depth - 1, cache))
+	out.append_array(_subdivide(ab, bc, ca, depth - 1, cache))
+	return out
+
+
+func _midpoint(a: Vector3, b: Vector3, cache: Dictionary) -> Vector3:
+	var k1 := hash(a.snappedf(1e-5))
+	var k2 := hash(b.snappedf(1e-5))
+	var h := str(mini(k1, k2)) + ":" + str(maxi(k1, k2)) # order-independent key
+	if cache.has(h):
+		return cache[h]
+	var m := ((a + b) * 0.5).normalized()
+	cache[h] = m
+	return m
