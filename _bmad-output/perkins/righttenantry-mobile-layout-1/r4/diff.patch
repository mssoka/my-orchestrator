+pub fn demo_cold_boot_deep_link_tags_leaderboard_test() {
+  // r3 blocker-1 regression: a cold boot (browser refresh / deep-link) to a
+  // demo vacancy dispatches fetch_leaderboard via demo_entry_effects, but
+  // handle_browser_change does NOT fire at boot — so the very first
+  // ApiReturnedLeaderboard would hit the vacancy-id guard against None and be
+  // dropped, leaving the board NotAsked forever. enter_demo must tag
+  // leaderboard_vacancy_id (and set Loading) so the response applies.
+  let m = model.initial()
+  let uri =
+    gleam_uri.parse("http://localhost:4000/vacancies/v-maples") |> should.be_ok
+  let #(entered, _) = client.update(m, msg.BrowserChangedUrl(uri))
+  entered.demo_mode |> should.be_true
+  entered.leaderboard |> should.equal(Loading)
+  entered.leaderboard_vacancy_id |> should.equal(Some("v-maples"))
+  // The deep-link's leaderboard response now passes the guard.
+  let store = should_be_some_store(entered.demo_store)
+  let leaderboard = demo_store.leaderboard(store, "v-maples") |> should.be_ok
+  let #(resolved, _) =
+    client.update(
+      entered,
+      msg.ApiReturnedLeaderboard("v-maples", Ok(leaderboard)),
+    )
+  case resolved.leaderboard {
+    Success(entries) -> list.length(entries) |> should.equal(8)
+    _ -> should.fail()
+  }
+}
