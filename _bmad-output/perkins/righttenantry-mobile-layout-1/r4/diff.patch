diff --git a/client/src/helpers/notification_nav.gleam b/client/src/helpers/notification_nav.gleam
new file mode 100644
index 00000000..d5a9925b
--- /dev/null
+++ b/client/src/helpers/notification_nav.gleam
@@ -0,0 +1,87 @@
+//// Notification deep-link routing decision, shared by the real (`client`) and
+//// demo (`demo_update`) click arms so the two can never drift.
+////
+//// A notification click should navigate to a route: a `vacancy`-typed
+//// notification to that vacancy, an `application`-typed notification to that
+//// application's detail page. The `modem.push` effect is opaque, so this
+//// module owns the pure `Option(String)` path decision — the unit-pinned
+//// regression boundary for BOTH arms.
+
+import demo/demo_store
+import gleam/list
+import gleam/option.{type Option, None, Some}
+import model.{type Model}
+import shared/remote_data
+import shared/routes.{type Route}
+
+/// The vacancy id named by a vacancy-scoped route. Returns `None` for routes
+/// with no single vacancy (dashboard, landing, settings, …). Used both by the
+/// notification resolver and by the route-change refetch guard.
+pub fn get_vacancy_id(route: Route) -> Option(String) {
+  case route {
+    routes.VacancyEdit(id)
+    | routes.VacancyDetail(id)
+    | routes.VacancyHandoff(id)
+    | routes.Comparison(id) -> Some(id)
+    routes.ApplicationDetail(vid, _) -> Some(vid)
+    _ -> None
+  }
+}
+
+/// Resolve the vacancy id that owns an application id, for the application-
+/// notification deep link. Demo data is authoritative in-memory, so a demo
+/// store hit is the reliable path. In the live app the current vacancy's
+/// leaderboard is the only loaded source that maps an application id to its
+/// vacancy, so we resolve from it only when the loaded leaderboard belongs to
+/// the vacancy on screen — `leaderboard_vacancy_id` must match the route's
+/// vacancy id (the leaderboard survives navigation into VacancyEdit/Comparison
+/// and is otherwise stale; matching it to the route prevents resolving an
+/// application to a fabricated vacancy id). When nothing matches, `None` —
+/// the click degrades to a no-op rather than navigating somewhere wrong.
+pub fn resolve_application_vacancy(
+  model: Model,
+  application_id: String,
+) -> Option(String) {
+  let from_demo = case model.demo_mode, model.demo_store {
+    True, Some(store) ->
+      demo_store.find_vacancy_id_for_application(store, application_id)
+    _, _ -> None
+  }
+  case from_demo {
+    Some(id) -> Some(id)
+    None ->
+      case model.leaderboard, get_vacancy_id(model.route) {
+        remote_data.Success(entries), Some(vid)
+          if model.leaderboard_vacancy_id == Some(vid)
+        ->
+          case list.find(entries, fn(e) { e.id == application_id }) {
+            Ok(_) -> Some(vid)
+            Error(_) -> None
+          }
+        _, _ -> None
+      }
+  }
+}
+
+/// The SPA route path a notification click navigates to, or `None` when the
+/// click should no-op. The single routing decision for BOTH entity types so
+/// each is unit-pinable in both arms:
+///   - `"vacancy"` + vacancy id → the vacancy detail page (unchanged).
+///   - `"application"` + application id → that application's detail page,
+///     resolving its owning vacancy first (see `resolve_application_vacancy`).
+///   - anything else (reference_call, unknown) → `None` (no navigation).
+pub fn notification_target_path(
+  model: Model,
+  entity_type: Option(String),
+  entity_id: Option(String),
+) -> Option(String) {
+  case entity_type, entity_id {
+    Some("vacancy"), Some(vid) -> Some("/vacancies/" <> vid)
+    Some("application"), Some(aid) ->
+      case resolve_application_vacancy(model, aid) {
+        Some(vid) -> Some("/vacancies/" <> vid <> "/applications/" <> aid)
+        None -> None
+      }
+    _, _ -> None
+  }
+}
