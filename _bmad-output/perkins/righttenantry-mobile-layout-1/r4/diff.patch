   }
 }
 
+/// Resolve the vacancy id that owns an application id, or `None`. Used by the
+/// application-notification deep link (`entity_type == "application"` — the
+/// notification payload carries only the application id) so the click can
+/// build the `/vacancies/<vid>/applications/<aid>` route. Demo data lives
+/// entirely in-memory, so this is a reliable lookup — the fixtures always
+/// know which vacancy an application belongs to.
+pub fn find_vacancy_id_for_application(
+  store: DemoStore,
+  application_id: String,
+) -> Option(String) {
+  find_vacancy_for_application(store.vacancies, application_id)
+}
+
+fn find_vacancy_for_application(
+  vacancies: List(DemoVacancy),
+  application_id: String,
+) -> Option(String) {
+  case vacancies {
+    [] -> None
+    [v, ..rest] ->
+      case find_application(v, application_id) {
+        Ok(_) -> Some(v.vacancy.id)
+        Error(_) -> find_vacancy_for_application(rest, application_id)
+      }
+  }
+}
