new file mode 100644
index 0000000..3c683a0
--- /dev/null
+++ b/core/pause_test.odin
@@ -0,0 +1,141 @@
+package core
+
+// pause_test.odin — Story 5.3's determinism pins at the DRIVER level. Pause
+// is a driver decision (the app's Sim_Driver / the harness's virtual clock):
+// the core only ever steps while unpaused, so a paused run's executed-tick
+// sequence is an ordinary continuous sequence and replay equality [E10] holds
+// by construction. These tests pin the driver CONTRACT so a future change
+// cannot silently break it:
+//   (a) a pause window records STABLE state — no step, no SIM-driven mutation
+//       (flow/crisis/rng/health frozen; fast-path edits are a separate logged
+//       channel, never a sim-state mutation — the T1 "paused state stable"
+//       golden's core half);
+//   (b) resume continues from the EXACT tick — the post-resume state equals a
+//       never-paused run's state at the same executed ticks;
+//   (c) a mid-pause edit is logged at the next tick the sim will execute
+//       (paused tick + 1 — the ODN-2 edit fast-path convention) and lands on
+//       the first post-resume step;
+//   (d) a pause/resume run with mid-pause edits replays byte-identical [E10].
+
+import "core:testing"
+
+// record_paused_run — the driver under test: wall ticks 1..ticks are the
+// recording schedule; the sim steps only wall ticks OUTSIDE the pause window
+// (pause_from, pause_to] — i.e. the pause takes effect from the wall tick
+// AFTER pause_from (the floor+1 boundary the harness uses for `at <n>ms
+// pause`) and lifts after pause_to. Commands apply at their apply_tick (the
+// pinned replay convention). Returns one hash per WALL tick — the pause
+// window is the same hash repeated (state stable).
+record_paused_run :: proc(state: ^Run_State, ticks: u64, pause_from, pause_to: u64, cat: ^Catalogs, allocator := context.allocator) -> [dynamic]u64 {
+	hashes := make([dynamic]u64, 0, ticks, allocator)
+	sim_tick: u64 = 0
+	for w in u64(1)..=ticks {
+		before := len(state.events)
+		paused := w > pause_from && w <= pause_to
+		if !paused {
+			sim_tick += 1
+			batch := make([dynamic]Command, 0, 4, context.temp_allocator)
+			for cmd in state.action_log {
+				if cmd.apply_tick == sim_tick {
+					append(&batch, cmd)
+				}
+			}
+			step(state, sim_tick, batch[:], cat)
+		}
+		append(&hashes, state_hash(state, state.events[before:], cat, context.temp_allocator))
+		clear(&state.events)
+		free_all(context.temp_allocator)
+	}
+	return hashes
+}
+
+@(test)
+test_pause_freeze_resume_replay :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	// The paused live run: draw 0->1 at tick 1; pause at tick 10 (wall ticks
+	// 11..20 frozen); the player draws 1->2 WHILE PAUSED (logged at
+	// apply_tick 11 — the next tick the sim will execute, the ODN-2 fast-path
+	// convention: the app logs app.tick + 1, and the paused driver's tick is
+	// 10); resume at wall tick 21; a post-resume parallel draw 0->1 logged at
+	// apply_tick 25 (the driver recorded it after 24 executed ticks — fired
+	// several ticks after resume).
+	live: Run_State
+	defer run_destroy(&live)
+	run_init(&live, 42, cat.hash, TEST_LOGIC_HZ)
+	res, rt, host := test_seed_fixture(&live, cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	append(&live.action_log, Command{apply_tick = 1, kind = Cmd_Draw_Pipe{a = res, b = rt, tier = std}})
+	append(&live.action_log, Command{apply_tick = 11, kind = Cmd_Draw_Pipe{a = rt, b = host, tier = std}}) // the MID-PAUSE edit
+	append(&live.action_log, Command{apply_tick = 25, kind = Cmd_Draw_Pipe{a = res, b = rt, tier = std}})
+
+	live_hashes := record_paused_run(&live, 40, 10, 20, cat)
+	defer delete(live_hashes)
+
+	// (a) the pause window is STABLE: wall ticks 11..20 repeat the tick-10
+	// hash — and the window is a REAL freeze (the tick-20 hash is still the
+	// tick-10 state, not a no-op pause that secretly stepped).
+	for w in u64(11)..=20 {
+		testing.expectf(t, live_hashes[w-1] == live_hashes[9],
+			"pause window must be stable at wall tick %d (%016x != tick-10 %016x)",
+			w, live_hashes[w-1], live_hashes[9])
+	}
+
+	// (c) the mid-pause edit lands on the FIRST post-resume step (sim tick 11
+	// at wall 21): the hash changes exactly there — the wall-21 hash must
+	// differ from the frozen window AND match the state with all three draws.
+	testing.expectf(t, live_hashes[20] != live_hashes[19],
+		"the first post-resume step must apply the mid-pause edit (hash must move at wall 21)")
+	testing.expectf(t, pipe_count(&live.topology) == 3,
+		"all three draws must land, got %d", pipe_count(&live.topology))
+	testing.expect(t, !live.replay_error, "live paused run must not latch replay_error")
+
+	// (b) resume continues from the EXACT tick: the paused run's state at
+	// every EXECUTED tick equals a never-paused run stepping the same ticks
+	// with the same log (the paused run executes ticks 1..30 — the same set;
+	// pause only inserts wall-time gaps). The continuous twin's hashes at
+	// sim tick N must equal the paused run's hash at the wall tick where sim
+	// tick N executed (wall N for N <= 10, wall N+10 for N >= 11).
+	cont: Run_State
+	defer run_destroy(&cont)
+	run_init(&cont, 42, cat.hash, TEST_LOGIC_HZ)
+	test_seed_fixture(&cont, cat)
+	cont.action_log = clone_log(live.action_log)
+	cont_hashes := record_run(&cont, 30, cat)
+	defer delete(cont_hashes)
+	for w in u64(1)..=40 {
+		if w > 10 && w <= 20 {
+			continue // paused wall ticks — no sim tick executed
+		}
+		sim := w if w <= 10 else w - 10
+		testing.expectf(t, live_hashes[w-1] == cont_hashes[sim-1],
+			"resume must continue from the exact tick: wall %d (sim %d) %016x != continuous %016x",
+			w, sim, live_hashes[w-1], cont_hashes[sim-1])
+	}
+	// the pause is not a no-op: at wall 20 the paused run is at sim tick 10,
+	// while the continuous run at tick 20 has stepped 10 more sim ticks — the
+	// hashes MUST differ (a vacuous pause would pass everything above).
+	testing.expectf(t, live_hashes[19] != cont_hashes[19],
+		"the paused window must actually freeze (wall-20 hash equals the continuous run's tick-20 — a no-op pause)")
+
+	// (d) replay equality [E10]: a FRESH run with the SAME seed + the SAME
+	// log + the SAME pause schedule reproduces the wall-tick hash sequence
+	// byte-identically.
+	replayed: Run_State
+	defer run_destroy(&replayed)
+	run_init(&replayed, 42, cat.hash, TEST_LOGIC_HZ)
+	test_seed_fixture(&replayed, cat)
+	replayed.action_log = clone_log(live.action_log)
+	replay_hashes := record_paused_run(&replayed, 40, 10, 20, cat)
+	defer delete(replay_hashes)
+	testing.expect(t, !replayed.replay_error, "replay must not latch replay_error (ODN-11 critical)")
+	diverged := false
+	for i in 0..<len(live_hashes) {
+		if live_hashes[i] != replay_hashes[i] {
+			diverged = true
+		}
+	}
+	testing.expectf(t, !diverged, "REPLAY DIVERGENCE: a pause/resume run with mid-pause edits must replay byte-identical [E10]")
+}
