+		for k in board.district_tiles[d] {
+			total += 1
+			testing.expectf(t, map_district_assign(&board, board.candidates[k]) == u16(d),
+				"candidate %v is listed under district %d but assigns to %d (the partition and the lookup must agree)",
+				board.candidates[k], d, map_district_assign(&board, board.candidates[k]))
+		}
+	}
+	testing.expectf(t, total == len(board.candidates),
+		"the partition must cover the pool exactly once: %d memberships vs %d tiles", total, len(board.candidates))
+	testing.expect(t, map_district_assign(&board, {2, 6}) == 0, "tile (2,6) must assign to district A (the nearest anchor)")
+	testing.expect(t, map_district_assign(&board, {28, 6}) == 1, "tile (28,6) must assign to district B")
+	// the tie-break: an EQUIDISTANT tile goes to the LOWER district index
+	// (strict < keeps the first — file order, deterministic).
+	eq: Map_Board
+	defer test_board_destroy(&eq)
+	append(&eq.districts, Map_District{name = "L", pos = {10, 6}})
+	append(&eq.districts, Map_District{name = "R", pos = {20, 6}})
+	testing.expect(t, map_district_assign(&eq, {15, 6}) == 0, "an equidistant tile must tie-break to the lower district index")
+	// the director_board's partition (the director tests' fixture): the
+	// corner tiles land in their own cells.
+	db := director_board(.City, .Suburb, context.allocator)
+	defer test_board_destroy(&db)
+	testing.expect(t, map_district_assign(&db, {1, 1}) == 0 && map_district_assign(&db, {11, 11}) == 0, "A's corner tiles must assign to A")
+	testing.expect(t, map_district_assign(&db, {19, 1}) == 1 && map_district_assign(&db, {29, 11}) == 1, "B's corner tiles must assign to B")
+}
+
+@(test)
+test_growth_dublin_seed_band_exclusion_step :: proc(t: ^testing.T) {
+	// the headline SEED-family wiring at the STEP level (the zoom-band model
+	// as data): with the suburb band at weight 0, EVERY director seed must
+	// land in the city district — a deterministic pin (the 4:1 ratio itself
+	// is pinned at the draw-proc level in growth_test, where the sample
+	// size is large; at step level the district caps + the seed floor bound
+	// the sample, so the crisp, mutation-biting assertion is the exclusion).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	cat.balance.growth_districts.seed_weights[int(District_Kind.Suburb)] = 0
+	board := director_board(.City, .Suburb, context.allocator)
+	defer test_board_destroy(&board)
+	routers := [2][2]i32{{6, 14}, {24, 14}}
+	spawns := director_growth_run(t, cat, &board, 0, routers[:], {}, 12 * cat.balance.terminal_spawn_interval_ticks)
+	defer delete(spawns)
+	testing.expectf(t, len(spawns) > 0, "the city band must grow")
+	for p in spawns {
+		testing.expectf(t, map_district_assign(&board, p) == 0,
+			"spawn %v must land in the city district — the suburb band is excluded from the SEED family", p)
+	}
+}
+
+@(test)
+test_growth_dublin_district_cap_blocks_both_families :: proc(t: ^testing.T) {
+	// the density ruling's hard bound: a district AT ITS CAP stops growing
+	// in BOTH families — its estates never extend (attach) and it is
+	// excluded from the weighted seed pick. Pre-fill district A to its cap
+	// (36 live terminals along A's far LEFT EDGE — the fill caps A WITHOUT
+	// touching the anchor's ring, so the ring-room and estate-cap predicates
+	// can NOT mask the district cap: without the district-cap check the
+	// anchor estate at (9,5) would extend into A). Every spawn must land in
+	// B.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	board := dense_board(.City, .Suburb, context.allocator)
+	defer test_board_destroy(&board)
+	routers := [2][2]i32{{6, 14}, {24, 14}}
+	fill := make([dynamic][2]i32, 0, 36, context.temp_allocator)
+	for x in 1..=3 {
+		for y in 1..=12 {
+			append(&fill, [2]i32{i32(x), i32(y)})
+		}
+	}
+	spawns := director_growth_run(t, cat, &board, 1000, routers[:], fill[:], 12 * cat.balance.terminal_spawn_interval_ticks)
+	defer delete(spawns)
+	testing.expectf(t, len(spawns) > 0, "growth must continue in the uncapped district")
+	for p in spawns {
+		testing.expectf(t, map_district_assign(&board, p) == 1, "spawn %v must land in B — A is at its cap (the density ruling binds both families)", p)
+	}
+}
+
+@(test)
+test_growth_dublin_attach_cluster_pick_band_exclusion :: proc(t: ^testing.T) {
+	// the ATTACH-family district weighting: a ZERO-WEIGHT band is excluded
+	// from the eligibility predicate (not just the weighted draw — a lone
+	// zero-weight cluster must never be picked by the single-eligible
+	// shortcut). With the suburb band zeroed, a suburb-anchored estate must
+	// never extend and the suburb district receives NO seeds: it is fully
+	// dormant. The positive control flips the suburb weight back to 4 —
+	// the suburb estate then extends (the exclusion is the weight, not a
+	// bug). The dense-pool board (dense_board below) gives every member a
+	// ring: district cells are 6x6 step-2 grids (x in [1..11] / [19..29],
+	// y in [1..11]) — a member at (5,5) has ring tiles {(1,5),(9,5),(5,1),
+	// (5,9)} at d2 = 16.
+	// phase 1: the suburb band excluded (weight 0)
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	cat.balance.growth_districts.seed_weights[int(District_Kind.Suburb)] = 0
+	cat.balance.growth_groups.max_members = 40 // the estate cap must not mask the district weighting
+	board := dense_board(.City, .Suburb, context.allocator)
+	defer test_board_destroy(&board)
+	routers := [2][2]i32{{6, 14}, {24, 14}}
+	anchors := [2][2]i32{{5, 5}, {23, 5}}
+	spawns := director_growth_run(t, cat, &board, 1000, routers[:], anchors[:], 12 * cat.balance.terminal_spawn_interval_ticks)
+	defer delete(spawns)
+	testing.expectf(t, len(spawns) > 0, "the city estate must grow")
+	for p in spawns {
+		testing.expectf(t, map_district_assign(&board, p) == 0,
+			"spawn %v must land in the city district — the suburb band is excluded from BOTH families", p)
+	}
+	// phase 2 (the positive control): the suburb weight back to parity —
+	// the suburb estate extends again (the dormancy was the weight).
+	cat.balance.growth_districts.seed_weights[int(District_Kind.Suburb)] = 4
+	spawns2 := director_growth_run(t, cat, &board, 1000, routers[:], anchors[:], 12 * cat.balance.terminal_spawn_interval_ticks)
+	defer delete(spawns2)
+	b_spawns := 0
+	for p in spawns2 {
+		if map_district_assign(&board, p) == 1 {
+			b_spawns += 1
+		}
+	}
+	testing.expectf(t, b_spawns > 0, "with the suburb weight restored the suburb district must receive spawns (the exclusion is the weight)")
+}
