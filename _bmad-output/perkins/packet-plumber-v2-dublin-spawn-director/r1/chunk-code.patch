+// run_dublin_grown — the KYLE mock-match GATE capture verb (stage-2 job 1):
+// plays the dublin_board demo to its end through the REAL core (the same
+// run-setup + step path as run_demo — deterministic, seed-derived growth
+// under the district director) and captures the GROWN board at the
+// gallery's two framings (baywide fit + the Temple Bar zoom) with the full
+// topology drawn — the live spawn behavior the gate grades against the
+// approved mock visuals (docs/captures/dublin-map-mock/).
+//
+// Usage: harness dublin-grown [outdir] [ms]   (default bin/dublin-grown +
+// the demo's own duration; the gate lens extends it — e.g. 240000ms)
+//   writes <outdir>/baywide.png + <outdir>/templebar.png
+run_dublin_grown :: proc(outdir: string, run_ms: u64, cat: ^pp.Catalogs) -> int {
+	rl.SetTraceLogLevel(.ERROR)
+	rl.InitWindow(1280, 720, "pp-dublin-grown")
+	defer rl.CloseWindow()
+
+	rc: Render_Ctx
+	render_setup(&rc, cat)
+	bd, e := board_load(cat)
+	if e != "" {
+		fmt.eprintfln("dublin-grown: %s", e)
+		return 2
+	}
+	rc.view.map_source = u8(pp.Map_Source.Dublin)
+	rc.view.board = bd
+	if !rnd.Dublin_Underlay_Ready(&rc.view) {
+		fmt.eprintfln("dublin-grown: %s failed to load — refusing to capture the degraded board", rnd.UNDERLAY_PATH)
+		return 2
+	}
+
+	text_bytes, rerr := os.read_entire_file_from_path("demos/dublin_board.dem", context.temp_allocator)
+	if rerr != nil {
+		fmt.eprintfln("dublin-grown: cannot read demos/dublin_board.dem")
+		return 2
+	}
+	demo, perr := parse_demo("dublin_board", string(text_bytes))
+	if perr != "" {
+		fmt.eprintfln("dublin-grown: parse error: %s", perr)
+		return 2
+	}
+	defer demo_destroy(&demo)
+
+	state: pp.Run_State
+	defer pp.run_destroy(&state)
+	pp.run_init(&state, demo.seed, cat.hash, cat.balance.logic_hz)
+	state.era = demo.era
+	cfg := Demo_Replay{
+		name = demo.name,
+		use_fixture = demo.use_fixture,
+		qos_fixture = demo.qos_fixture,
+		growth_on = demo.growth_on,
+		advance_gate_on = demo.advance_gate_on,
+		map_source = demo.map_source,
+		session = {goal = demo.win_goal, cap_ms = demo.lose_cap_ms, health_on = demo.health_on, surge_win_pct = demo.surge_win_pct},
+	}
+	defer {
+		delete(cfg.nodes)
+		delete(cfg.spawns)
+		delete(cfg.pauses)
+	}
+	for n in demo.nodes {
+		append(&cfg.nodes, n)
+	}
+	for s in demo.spawns {
+		append(&cfg.spawns, s)
+	}
+	for p in demo.pauses {
+		append(&cfg.pauses, p)
+	}
+	if e := demo_apply_setup(&state, &cfg, cat); e != "" {
+		fmt.eprintfln("dublin-grown: %s", e)
+		return 2
+	}
+	if e := lower_intents(&state, &demo, cat); e != "" {
+		fmt.eprintfln("dublin-grown: %s", e)
+		return 2
+	}
+	max_ticks := demo_run_ticks(&demo, cat.balance.logic_hz)
+	ticks := max_ticks
+	if run_ms > 0 {
+		ticks = run_ms * u64(cat.balance.logic_hz) / 1000
+	}
+	for sim_tick in 0..<ticks {
+		batch := make([dynamic]pp.Command, 0, 4, context.temp_allocator)
+		for cmd in state.action_log {
+			if cmd.apply_tick == sim_tick {
+				append(&batch, cmd)
+			}
+		}
+		pp.step(&state, sim_tick, batch[:], cat)
+		free_all(context.temp_allocator)
+	}
+	if state.replay_error {
+		fmt.eprintfln("dublin-grown: the run latched replay_error — refusing to capture a broken board")
+		return 2
+	}
+	fmt.printfln("dublin-grown: %d ticks played, %d live terminals", ticks, pp.node_count(&state.topology))
+	// the spawn audit — the per-district terminal breakdown (the band-model
+	// lens the mock-match gate grades: dense-core districts richer, backbone
+	// districts sparser, caps never exceeded).
+	counts := make([dynamic]i32, len(bd.districts), len(bd.districts), context.temp_allocator)
+	total_t := 0
+	for i in 0..<len(state.topology.node_alive) {
+		if !state.topology.node_alive[i] || state.topology.node_kind[i] != .Terminal {
+			continue
+		}
+		counts[pp.map_district_assign(bd, state.topology.node_pos[i])] += 1
+		total_t += 1
+	}
+	for d in 0..<len(bd.districts) {
+		if counts[d] == 0 {
+			continue
+		}
+		pool := len(bd.district_tiles[d])
+		fmt.printfln("  audit %-10s %-16s live=%d pool=%d (cap %d)",
+			pp.district_kind_name(bd.districts[d].kind), bd.districts[d].name,
+			counts[d], pool, pp.growth_district_cap(bd, cat, u16(d)))
+	}
+	fmt.printfln("dublin-grown: %d live terminals across %d districts", total_t, len(bd.districts))
+	// the estate lens: the derived cluster view (the group_cluster_view_build
+	// the director itself reads) — how many estates, what sizes, and the
+	// seed district of each (the estate's real-neighborhood anchor).
+	gview := pp.group_cluster_view_build(&state.topology, cat)
+	defer pp.group_view_destroy(&gview)
+	clusters := 0
+	for i in 0..<len(gview.id) {
+		if gview.id[i] != u32(i) || gview.size[i] == 0 {
+			continue
+		}
+		clusters += 1
+		d := pp.map_district_assign(bd, state.topology.node_pos[i])
+		fmt.printfln("  estate size=%d seed-district=%s (%s)", gview.size[i],
+			bd.districts[d].name, pp.district_kind_name(bd.districts[d].kind))
+	}
+	fmt.printfln("dublin-grown: %d estates (the approved cluster shape)", clusters)
+
+	// the fit view (the whole board — the gallery's baywide framing)
+	dublin_shot_view(&rc.view, 1.0, 20, 15)
+	dublin_shot_capture(&rc, &state, fmt.tprintf("%s/baywide.png", outdir))
+	// the city-core close-up (Temple Bar — the gallery's crop framing)
+	dublin_shot_view(&rc.view, 3.2, 17.9, 17.4)
+	dublin_shot_capture(&rc, &state, fmt.tprintf("%s/templebar.png", outdir))
+	fmt.printfln("dublin-grown: grown-board captures written to %s/baywide.png + %s/templebar.png", outdir, outdir)
+	return 0
+}
