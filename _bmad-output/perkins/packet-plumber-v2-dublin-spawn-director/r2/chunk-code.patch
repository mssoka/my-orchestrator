+test_growth_district_cap_formula :: proc(t: ^testing.T) {
+	// r1 N14: the cap formula's branches — the permille iteration surface
+	// (the 667 ≈ 1-in-9 fabric target) + the 1-tile floor + the full-share
+	// default. cap(d) = max(1, floor(pool(d) x permille / 1000)).
