+test_growth_dublin_attach_cluster_pick_bias :: proc(t: ^testing.T) {
+	// THE ATTACH bias pin (Perkins r1 B1): two eligible estates at DISTINCT
+	// weights (city 4 vs suburb 1 — the balance defaults), equal-capacity
+	// dense cells (36 pool tiles each — the district caps cannot bind the
+	// sample), the estate cap lifted (max_members 40 — the 5-member cap
+	// would otherwise mask the weighting once both estates fill). The rich
+	// district's estate must extend MEASURABLY more over the deterministic
+	// windows (4:1 weighted cluster pick). The cells are disjoint (the
+	// 13..17 gap — attach rings never cross), so per-district spawn counts
+	// == per-estate member counts. A uniform-pick regression (weighted_pick
+	// -> rng_range) must fail this pin.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	cat.balance.growth_groups.max_members = 40 // the estate cap must not mask the district weighting
+	board := dense_board(.City, .Suburb, context.allocator)
+	defer test_board_destroy(&board)
+	routers := [2][2]i32{{6, 14}, {24, 14}}
+	anchors := [2][2]i32{{5, 5}, {23, 5}}
+	// Sample 10 windows x 6 seeds, stopping BEFORE A's estate saturates the
+	// 36-tile cell (~9-11 members: the ring room dies as members pack, then
+	// B-only windows dilute the ratio). The ACCEPTED ratio lands below the
+	// raw 4:1 by geometry — A's picks reject more (its ring is always the
+	// more crowded one) and its ring room exhausts first — so the honest
+	// bar is a clear majority (1.5x), which the 4:1 weighting delivers with
+	// margin and a uniform-pick regression misses by far (measured: A=25
+	// B=11 weighted vs A=16 B=21 uniform at 4 seeds; 6 seeds widen it).
+	windows := u64(10)
+	total_a, total_b := 0, 0
+	for seed in 1..=6 {
+		spawns := director_growth_run(t, cat, &board, 1000, routers[:], anchors[:], windows * cat.balance.terminal_spawn_interval_ticks, u64(seed))
+		defer delete(spawns)
+		a, b := 0, 0
+		for p in spawns {
+			if map_district_assign(&board, p) == 0 {
+				a += 1
+			} else {
+				b += 1
+			}
+		}
+		total_a += a
+		total_b += b
+	}
+	testing.expectf(t, total_a > 0 && total_b > 0, "both estates must extend (A=%d B=%d — the fixture is broken if either is zero)", total_a, total_b)
+	testing.expectf(t, total_a > 3 * total_b / 2, "the 4:1 city:suburb cluster weights must bias the ATTACH extensions across seeds (A=%d B=%d)", total_a, total_b)
+}
+
+// cross_board — the W1 fixture: district A (city, a 36-tile cell over
+// x in [1..11], y in [1..11]) + district B (suburb, ONE tile at (15,5)).
+// B's tile sits in A's attach reach: an A member at (11,5) rings tiles at
+// d2 in [16,25] — (15,5) is in B's territory (the nearest-anchor boundary
+// runs between x=11 and x=15), so a cross-boundary attach is geometrically
+// reachable (the real-board straddle, miniaturized).
+cross_board :: proc(k0, k1: District_Kind, allocator := context.allocator) -> Map_Board {
+	b: Map_Board
+	b.w_tiles = 40
+	b.h_tiles = 30
+	append(&b.districts, Map_District{name = "A", kind = k0, pos = {6, 6}})
+	append(&b.districts, Map_District{name = "B", kind = k1, pos = {18, 6}})
+	for x in 1..<12 {
+		for y in 1..<12 {
+			if x % 2 == 0 || y % 2 == 0 {
+				continue
+			}
+			append(&b.candidates, [2]i32{i32(x), i32(y)})
+		}
+	}
+	append(&b.candidates, [2]i32{15, 5})
+	map_board_partition(&b, allocator)
+	return b
+}
