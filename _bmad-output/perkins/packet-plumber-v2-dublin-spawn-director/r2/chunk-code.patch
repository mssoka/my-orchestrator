+	testing.expectf(t, growth_district_cap(&board, cat, 0) == 36, "1000 permille x 36 tiles must cap at 36, got %d", growth_district_cap(&board, cat, 0))
+	// the 667 iteration target: floor(36 x 667 / 1000) = floor(24.012) = 24
+	cat.balance.growth_districts.district_cap_permille = 667
+	testing.expectf(t, growth_district_cap(&board, cat, 0) == 24, "667 permille x 36 tiles must cap at 24, got %d", growth_district_cap(&board, cat, 0))
