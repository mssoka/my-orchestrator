+/// The current UTC time as an RFC3339 string — the attempt-log `at` stamp
+/// and (cast to timestamptz) the cadence SELECT's `now`. Exposed so the
+/// manual-fire handler stamps the same way.
+pub fn now_iso() -> String {
+  timestamp.system_time()
+  |> timestamp.to_rfc3339(calendar.utc_offset)
