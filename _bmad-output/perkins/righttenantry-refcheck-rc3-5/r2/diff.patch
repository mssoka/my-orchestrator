index 00000000..394e13dc
--- /dev/null
+++ b/deployment/terraform/reference-checks-job.tf
@@ -0,0 +1,125 @@
+# Cloud Run Job — 15-minute reference-check cadence sweep (RC3.5).
+#
+# Owns every reference-check send + transition: T0 invite / T+24h applicant
+# co-nudge / T+48h reminder 1 / T+96h reminder 2 + landlord warm-handoff /
+# T+144h silent terminal. Implementation: server/src/reference_checks/sweep.gleam
+# (entry `reference_checks@sweep:main/0`, dispatched by docker-entrypoint.sh).
+# Scheduler is the `reference_checks_fifteen_minutes` entry in scheduler.tf.
+#
+# Production-only — mirrors the retention / digest job gating. Staging fires
+# the sweep on demand via the shared-secret POST /api/v1/internal/reference-
+# checks route (the web service deploys to every env). The job reuses the same
+# container image as the Cloud Run service; the command override runs the
+# sweep module instead of the web server.
+#
+# GitHub Actions deploys by: terraform apply -var="image=<tag>".
+
+# Dedicated runtime SA for the reference-checks job. Gets only the two secrets
+# the sweep actually needs (DATABASE_URL + RESEND_API_KEY), via per-secret IAM
+# bindings below — the narrow-secret posture from retention-job.tf. TWILIO_* is
+# deliberately NOT mounted: the Alpha Sender ID is an external provisioning
+# dependency (Q1) not yet in Secret Manager, so sms_client.init() returns
+# Disabled and SMS sends no-op until a separate task provisions + mounts the
+# Twilio secrets (the briefed "no-op without Twilio keys" posture). SENTRY_DSN
+# is a plain env var (already in local.env_vars) so failures escalate.
+resource "google_service_account" "reference_checks_runtime" {
+  count        = var.environment == "production" ? 1 : 0
+  account_id   = "rt-reference-checks-runtime-${var.environment == "production" ? "prod" : "staging"}"
+  display_name = "RightTenant Reference Checks Runtime (${var.environment})"
+  description  = "Runtime SA for the reference_checks sweep Cloud Run Job — DB + Resend only"
+}
+
+resource "google_secret_manager_secret_iam_member" "reference_checks_database_url" {
+  count     = var.environment == "production" ? 1 : 0
+  project   = var.project_id
+  secret_id = google_secret_manager_secret.app_secrets[local.reference_checks_secret_env_vars["DATABASE_URL"]].secret_id
+  role      = "roles/secretmanager.secretAccessor"
+  member    = "serviceAccount:${google_service_account.reference_checks_runtime[0].email}"
+}
+
+resource "google_secret_manager_secret_iam_member" "reference_checks_resend_api_key" {
+  count     = var.environment == "production" ? 1 : 0
+  project   = var.project_id
+  secret_id = google_secret_manager_secret.app_secrets[local.reference_checks_secret_env_vars["RESEND_API_KEY"]].secret_id
+  role      = "roles/secretmanager.secretAccessor"
+  member    = "serviceAccount:${google_service_account.reference_checks_runtime[0].email}"
+}
+
+# Deploy SA must be able to act as the reference-checks runtime SA so
+# `gcloud run jobs update` can attach it (same pattern as retention/digest).
+resource "google_service_account_iam_member" "deploy_acts_as_reference_checks_runtime" {
+  count              = var.environment == "production" ? 1 : 0
+  service_account_id = google_service_account.reference_checks_runtime[0].name
+  role               = "roles/iam.serviceAccountUser"
+  member             = "serviceAccount:${google_service_account.deploy.email}"
+}
+
+resource "google_cloud_run_v2_job" "reference_checks" {
+  count    = var.environment == "production" ? 1 : 0
+  name     = "righttenantry-reference-checks"
+  location = var.region
+
+  template {
+    template {
+      service_account = google_service_account.reference_checks_runtime[0].email
+      # 15-min cadence: a tick processes a bounded batch (default 500) and
+      # usually finishes in seconds; 900s is generous headroom for a backlog
+      # drain after downtime.
+      timeout = "900s"
+      # One retry covers a transient DB/pool hiccup; the 15-min cadence is
+      # the steady-state retry otherwise. Re-runs are idempotent (the guarded
+      # updates' attempt_count pins make double-advances impossible).
+      max_retries = 1
+
+      containers {
+        image = var.image
+
+        # Override the container entrypoint to run the sweep module instead
+        # of the web server. Dispatched by docker-entrypoint.sh which invokes
+        # `reference_checks@sweep:main/0` via erl.
+        command = ["/app/docker-entrypoint.sh", "reference-checks"]
+
+        resources {
+          limits = {
+            cpu    = "1"
+            memory = "512Mi"
+          }
+        }
+
+        # Plain env vars (same shape as the service so shared modules find
+        # their config). SENTRY_DSN lands here so sweep failures escalate.
+        dynamic "env" {
+          for_each = local.env_vars
+          content {
+            name  = env.key
+            value = env.value
+          }
+        }
+
+        # Secret Manager-backed env vars — DB + RESEND only (the narrow set).
+        # Adding another secret the sweep needs means (1) adding it to
+        # local.reference_checks_secret_env_vars, and (2) adding a matching
+        # per-secret IAM binding above. When TWILIO_* is provisioned, add it
+        # here too (and to the web service secret_env_vars + secrets.tf first).
+        dynamic "env" {
+          for_each = local.reference_checks_secret_env_vars
+          content {
+            name = env.key
+            value_source {
+              secret_key_ref {
+                secret  = env.value
+                version = "latest"
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+
+  depends_on = [
+    google_secret_manager_secret.app_secrets,
+    google_secret_manager_secret_iam_member.reference_checks_database_url,
+    google_secret_manager_secret_iam_member.reference_checks_resend_api_key,
+  ]
+}
diff --git a/deployment/terraform/scheduler.tf b/deployment/terraform/scheduler.tf
index 92bc64c3..f44f2483 100644
--- a/deployment/terraform/scheduler.tf
+++ b/deployment/terraform/scheduler.tf
@@ -355,3 +355,87 @@ resource "google_cloud_scheduler_job" "verification_reminders_hourly" {
     google_cloud_run_v2_job_iam_member.scheduler_can_invoke_verification_reminders,
   ]
 }
+
+# --- Reference-checks cadence scheduler (RC3.5) -------------------------
+# Production-only — mirrors the retention / digest gating. Staging fires the
+# sweep on demand via the shared-secret POST /api/v1/internal/reference-checks
+# route. The 15-min cadence drives the whole reference chase: T0 invite /
+# T+24h co-nudge / T+48h reminder 1 / T+96h reminder 2 + warm-handoff /
+# T+144h silent terminal.
+
+resource "google_service_account" "reference_checks_scheduler" {
+  count        = var.environment == "production" ? 1 : 0
+  account_id   = "rt-reference-checks-scheduler-${var.environment == "production" ? "prod" : "staging"}"
+  display_name = "RightTenant Reference Checks Scheduler (${var.environment})"
+  description  = "Invokes the reference_checks Cloud Run Job every 15 min — ${var.environment}"
+}
+
+# Bind the scheduler SA to the reference-checks job as invoker (and only that).
+resource "google_cloud_run_v2_job_iam_member" "scheduler_can_invoke_reference_checks" {
+  count    = var.environment == "production" ? 1 : 0
+  project  = google_cloud_run_v2_job.reference_checks[0].project
+  location = google_cloud_run_v2_job.reference_checks[0].location
+  name     = google_cloud_run_v2_job.reference_checks[0].name
+  role     = "roles/run.invoker"
+  member   = "serviceAccount:${google_service_account.reference_checks_scheduler[0].email}"
+}
+
+# Deploy SA must be able to act as the reference-checks scheduler SA so
+# terraform can attach it to google_cloud_scheduler_job.reference_checks_fifteen_minutes
+# (mirrors deploy_acts_as_retention_scheduler above).
+resource "google_service_account_iam_member" "deploy_acts_as_reference_checks_scheduler" {
+  count              = var.environment == "production" ? 1 : 0
+  service_account_id = google_service_account.reference_checks_scheduler[0].name
+  role               = "roles/iam.serviceAccountUser"
+  member             = "serviceAccount:${google_service_account.deploy.email}"
+}
+
+# Cloud Scheduler service agent must be able to mint OIDC tokens as this
+# scheduler SA — without it the 15-min fire returns UNAUTHENTICATED and the
+# job never runs (silent cadence death, exactly what AD-15's liveness
+# posture exists to prevent).
+resource "google_service_account_iam_member" "cloudscheduler_creates_tokens_for_reference_checks_scheduler" {
+  count              = var.environment == "production" ? 1 : 0
+  service_account_id = google_service_account.reference_checks_scheduler[0].name
+  role               = "roles/iam.serviceAccountTokenCreator"
+  member             = local.cloudscheduler_service_agent
+}
+
+resource "google_cloud_scheduler_job" "reference_checks_fifteen_minutes" {
+  count       = var.environment == "production" ? 1 : 0
+  name        = "righttenantry-reference-checks-fifteen-minutes"
+  description = "15-min reference-check cadence sweep — invites, co-nudge, reminders, warm-handoff, silent terminal"
+  schedule    = "*/15 * * * *"
+  time_zone   = "Etc/UTC"
+  # Async-acking :run; the 900s on the job itself governs the tick runtime.
+  attempt_deadline = "300s"
+  region           = var.region
+
+  retry_config {
+    # Let the Cloud Run Job's own max_retries handle transient failures so
+    # we don't stack two retry layers. Re-runs are idempotent (the guarded
+    # updates' attempt_count pins make double-advances impossible), but a
+    # flood of parallel 15-min invocations during an outage is still waste.
+    retry_count          = 0
+    min_backoff_duration = "60s"
+    max_backoff_duration = "600s"
+  }
+
+  http_target {
+    http_method = "POST"
+    # OAuth (not OIDC) at the admin :run surface — same rationale as
+    # retention_daily above.
+    uri = "https://run.googleapis.com/v2/projects/${var.project_id}/locations/${google_cloud_run_v2_job.reference_checks[0].location}/jobs/${google_cloud_run_v2_job.reference_checks[0].name}:run"
+
+    oauth_token {
+      service_account_email = google_service_account.reference_checks_scheduler[0].email
+      scope                 = "https://www.googleapis.com/auth/cloud-platform"
+    }
+  }
+
+  depends_on = [
+    google_project_service.cloudscheduler,
+    google_cloud_run_v2_job.reference_checks,
+    google_cloud_run_v2_job_iam_member.scheduler_can_invoke_reference_checks,
+  ]
+}
