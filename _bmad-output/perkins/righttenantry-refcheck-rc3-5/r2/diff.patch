@@ -0,0 +1,25 @@
+-- Guarded cadence advance (AD-14): atomic attempt append + next-step for
+-- the co-nudge (T+24h) / reminder 1 (T+48h) / reminder 2 + warm-handoff
+-- (T+96h) steps. No status change — 'contact_initiated' is the in-flight
+-- referee-form state for the whole chase. The attempt_count guard pins
+-- exactly-once: a concurrent writer or a retry that already advanced this
+-- step returns 0 rows and the caller stands down.
+--
+-- `increment_hours` is the gap to the NEXT step (24 for T+24/T+48, 48 for
+-- T+96), added to the row's CURRENT next_attempt_at. Computing from the
+-- current horizon (not created_at) follows a re-enabled row's re-armed
+-- clock (rc2-3) and keeps the cadence self-healing after downtime. The
+-- sweep passes the exact increment per step.
+--
+-- `expected_attempt_count` is the step the caller computed (1, 2, or 3);
+-- the WHERE pins it so a row that silently jumped ahead (a manual fix, a
+-- re-run) cannot be double-advanced.
+UPDATE reference_call
+SET attempts        = attempts || $2::jsonb,
+    attempt_count   = attempt_count + 1,
+    next_attempt_at = next_attempt_at + ($3 * interval '1 hour'),
+    updated_at      = now()
+WHERE id = $1
+  AND status = 'contact_initiated'
+  AND attempt_count = $4
+RETURNING id::text;
