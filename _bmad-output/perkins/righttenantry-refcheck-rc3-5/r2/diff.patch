+// ===========================================================================
+// Full cadence: a single row walks T0 -> T+24 -> T+48 -> T+96 -> T+144
+// across successive runs (each run advances it one step). Pins the whole
+// engine end-to-end with a no-op send config.
+// ===========================================================================
+
+pub fn full_cadence_walks_to_unreachable_test() {
+  use <- unitest.tag("integration")
+  let db = helpers.setup()
+  let row_id =
+    seed_due_row(
+      db,
+      attempt_count: 0,
+      status: "queued",
+      form_opened: False,
+      draft: "",
+      taken_over: False,
+    )
+
+  // T0
+  let s1 = run_sweep(db)
+  s1.invited |> should.equal(1)
+  row_status(db, row_id) |> should.equal("contact_initiated")
+  // Re-arm next_attempt_at into the past to simulate each cadence step
+  // becoming due (production waits 24h; the test fast-forwards).
+  rearm_due(db, row_id)
+  // T+24 (form never opened -> co-nudge fires)
+  let s2 = run_sweep(db)
+  s2.co_nudged |> should.equal(1)
+  rearm_due(db, row_id)
+  // T+48 reminder 1
+  let s3 = run_sweep(db)
+  s3.reminded_1 |> should.equal(1)
+  rearm_due(db, row_id)
+  // T+96 reminder 2 + warm handoff
+  let s4 = run_sweep(db)
+  s4.warm_handoffs |> should.equal(1)
+  rearm_due(db, row_id)
+  // T+144 silent terminal (no draft -> unreachable)
+  let s5 = run_sweep(db)
+  s5.terminal_unreachable |> should.equal(1)
+  row_status(db, row_id) |> should.equal("unreachable")
+  // Exactly one warm-handoff notification across the whole walk (at T+96),
+  // none at T+144.
+  notification_count(db, row_id) |> should.equal(1)
+}
+
+fn rearm_due(db: pog.Connection, row_id: String) -> Nil {
+  let _ =
+    pog.query(
+      "UPDATE reference_call SET next_attempt_at = now() - interval '1 hour' WHERE id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(row_id))
+    |> pog.returning(decode.at([0], decode.int))
+    |> pog.execute(db)
+  Nil
+}
+
+// ===========================================================================
+// W5: cadence offsets pinned with a fake clock. A wrong offset (24h where
+// 48h was intended, etc.) would ship undetected by the step-advance tests
+// above (they only check attempt_count moves). Here each step's horizon is
+// asserted in seconds-from-anchor against the AD-4 table
+// (T0->+24h, T+24->+24h, T+48->+48h, T+96->+48h).
+// ===========================================================================
+
+/// Seed a row at a chosen cadence position with a FIXED next_attempt_at (the
+/// anchor), so the offset to the next horizon is deterministic.
+fn seed_due_row_at(
+  db: pog.Connection,
+  attempt_count attempt_count: Int,
+  status status: String,
+  anchor anchor: String,
+) -> String {
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 0)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let assert Ok(returned) =
+    pog.query(
+      "INSERT INTO application (
+         vacancy_id, first_name, last_name, email, phone,
+         employment_status, monthly_income_cents,
+         employer_name, job_title, employment_duration,
+         landlord_ref_name, landlord_ref_email, landlord_ref_phone,
+         never_rented_before, reference_contact_choice
+       )
+       VALUES (
+         $1::uuid, 'Aisling', 'O''Brien', 'applicant@example.com', '+353861234567',
+         'employed', 350000,
+         'Acme Ltd', 'Senior Chef', '3 years',
+         'Colm Byrne', 'colm@example.com', '+353871111111',
+         false, 'attested'
+       )
+       RETURNING id::text",
+    )
+    |> pog.parameter(pog.text(vacancy_id))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  let assert [application_id, ..] = returned.rows
+  let assert Ok(inserted) =
+    pog.query("INSERT INTO reference_call (
+         application_id, ref_slot, status, attempt_count,
+         contact_name, contact_email, contact_phone,
+         next_attempt_at
+       )
+       VALUES (
+         $1::uuid, 'landlord_ref', $2::reference_call_status, " <> int.to_string(
+      attempt_count,
+    ) <> ",
+         'Colm Byrne', 'colm@example.com', '+353871111111',
+         NULLIF($3, '')::timestamptz
+       )
+       RETURNING id::text")
+    |> pog.parameter(pog.text(application_id))
+    |> pog.parameter(pog.text(status))
+    |> pog.parameter(pog.text(anchor))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  let assert [row_id, ..] = inserted.rows
+  row_id
+}
+
+/// Seconds between the row's next_attempt_at and the anchor — the offset the
+/// step applied. Asserted in seconds so it's robust to Postgres's text format.
+fn offset_seconds(db: pog.Connection, row_id: String, anchor: String) -> Int {
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT EXTRACT(EPOCH FROM (next_attempt_at - NULLIF($1, '')::timestamptz))::bigint::text FROM reference_call WHERE id = $2::uuid",
+    )
+    |> pog.parameter(pog.text(anchor))
+    |> pog.parameter(pog.text(row_id))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  let assert [secs, ..] = returned.rows
+  let assert Ok(n) = int.parse(secs)
+  n
+}
+
+pub fn cadence_offsets_pinned_with_fake_clock_test() {
+  use <- unitest.tag("integration")
+  let db = helpers.setup()
+  // One row per cadence position, all anchored at the same instant.
+  let anchor = "2026-01-01T00:00:00+00:00"
+  let t0 = seed_due_row_at(db, 0, "queued", anchor)
+  let t24 = seed_due_row_at(db, 1, "contact_initiated", anchor)
+  let t48 = seed_due_row_at(db, 2, "contact_initiated", anchor)
+  let t96 = seed_due_row_at(db, 3, "contact_initiated", anchor)
+
+  // Run with a fixed now one second after the anchor (every row is due).
+  let summary =
+    sweep.run(
+      db,
+      no_key_deps(),
+      now_iso: "2026-01-01T00:00:01+00:00",
+      sentry: sentry_client.Disabled,
+      batch_limit: 100,
+    )
+
+  // All four advanced this tick.
+  summary.invited |> should.equal(1)
+  summary.co_nudged + summary.co_nudge_skipped |> should.equal(1)
+  summary.reminded_1 |> should.equal(1)
+  summary.warm_handoffs |> should.equal(1)
+
+  // AD-4 per-step INCREMENTS (the offset each query applies to the row's
+  // current next_attempt_at), asserted in seconds from the shared anchor:
+  //   T0   step (0->1): +24h   T+24 step (1->2): +24h
+  //   T+48 step (2->3): +48h   T+96 step (3->4): +48h
+  // A wrong increment (24h where 48h was intended at a given step) fails
+  // here — the direct pin a step-advance-only test can't catch.
+  offset_seconds(db, t0, anchor) |> should.equal(24 * 3600)
+  offset_seconds(db, t24, anchor) |> should.equal(24 * 3600)
+  offset_seconds(db, t48, anchor) |> should.equal(48 * 3600)
+  offset_seconds(db, t96, anchor) |> should.equal(48 * 3600)
+}
