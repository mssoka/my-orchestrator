+//// The reference-check cadence sweep (Story RC3.5) — the 15-minute engine
+//// that owns every reference-check send and transition. Humane chasing,
+//// exactly-once, self-healing after downtime, never silently dead.
+////
+//// It is the scheduler/driver for rc3-2's templates + send helpers (the
+//// payload): each tick selects due rows (`next_attempt_at <= now` AND
+//// `taken_over_at IS NULL` AND status IN queued/contact_initiated),
+//// computes the due step from the attempt log (AD-4), sends via the rc3-2
+//// helpers, and applies transition + atomic attempt-append + next-step as
+//// ONE guarded update (AD-4, AD-14). T0 also mints the form_token (rc3-5
+//// owns the T0 mint — creation stamps none).
+////
+//// Separation of concerns (the retention_job / verification_reminder_job
+//// split): `main/0` reads env + bootstraps the DB pool; `run/5` is the
+//// pure-ish worker (DB + SendDeps + a pinned `now` ISO string so fake-clock
+//// tests are deterministic). The Cloud Run Job entry is wired in
+//// `docker-entrypoint.sh` (`reference-checks` arm); the 15-min Cloud
+//// Scheduler + manual-fire `POST /api/v1/internal/reference-checks` route
+//// live in Terraform + `router.gleam`/`sweep_handler.gleam`.
+////
+//// No-op without keys (rc3-2 doctrine): a missing RESEND_API_KEY / Disabled
+//// Twilio handle yields `skipped` attempt outcomes — the sweep still runs +
+//// transitions, SMS/email just don't send until the keys are provisioned.
+
+import db/db
+import dot_env
+import envoy
+import gleam/dict
+import gleam/dynamic/decode
+import gleam/int
+import gleam/json
+import gleam/list
+import gleam/option.{None, Some}
+import gleam/result
+import gleam/string
+import gleam/time/calendar
+import gleam/time/timestamp
+import notification/notification_dispatch
+import notification/sms_client
+import pog
+import reference_checks/messages.{
+  type AttemptEntry, type ChannelOutcome, type RefereeContext, AttemptEntry,
+}
+import reference_checks/questions
+import reference_checks/result as ref_result
+import reference_checks/send
+import reference_checks/sql
+import sentry/sentry_client
+import shared/reference_call.{ref_slot_from_string}
+import wisp
+import youid/uuid.{type Uuid}
+
+// -- Cadence increments (AD-4). The horizon after each step is the row's
+//    CURRENT next_attempt_at + the increment, so a re-enabled row's re-armed
+//    clock is followed and the cadence self-heals after downtime. ---------
+
+/// T0 -> T+24h.
+const step_to_co_nudge: Float = 24.0
+
+/// T+24h -> T+48h.
+const step_to_reminder_1: Float = 24.0
+
+/// T+48h -> T+96h.
+const step_to_reminder_2: Float = 48.0
+
+/// T+96h -> T+144h (then silent terminal).
+const step_to_terminal: Float = 48.0
+
+/// Cap a single tick drains so a backlog after downtime spreads across ticks
+/// instead of blowing the job timeout. 500 is generous for a 15-min cadence.
+const default_batch_limit: Int = 500
+
+/// terminal_reason slugs (§4.6).
+const reason_sequence_exhausted: String = "sequence_exhausted"
+
+pub type RunSummary {
+  RunSummary(
+    due: Int,
+    invited: Int,
+    co_nudged: Int,
+    co_nudge_skipped: Int,
+    reminded_1: Int,
+    reminded_2: Int,
+    warm_handoffs: Int,
+    terminal_partial: Int,
+    terminal_unreachable: Int,
+    failed: Int,
+    stood_down: Int,
+  )
+}
+
+pub type RunError {
+  DbError(String)
+}
+
+// ---------------------------------------------------------------------------
+// Cloud Run Job entry
+// ---------------------------------------------------------------------------
+
+/// Cloud Run Job entry (`docker-entrypoint.sh reference-checks`). Loads env,
+/// bootstraps the DB pool + send deps, runs one tick, logs a per-tick
+/// completion line (AD-15 liveness), and panics on fatal config/DB error so
+/// Cloud Run marks the job failed (the scheduler's retry_config is 0 — the
+/// 15-min cadence is the retry). Per-row failures are logged + Sentry-captured,
+/// never fail the whole tick.
+pub fn main() {
+  dot_env.load_default()
+  wisp.configure_logger()
+
+  let env = envoy.get("ENV") |> result.unwrap("development")
+  wisp.log_info("reference_checks sweep starting (env=" <> env <> ")")
+
+  case bootstrap() {
+    Ok(summary) ->
+      wisp.log_info(
+        "reference_checks sweep complete: "
+        <> "due="
+        <> int.to_string(summary.due)
+        <> " invited="
+        <> int.to_string(summary.invited)
+        <> " co_nudged="
+        <> int.to_string(summary.co_nudged)
+        <> " co_nudge_skipped="
+        <> int.to_string(summary.co_nudge_skipped)
+        <> " reminded_1="
+        <> int.to_string(summary.reminded_1)
+        <> " reminded_2="
+        <> int.to_string(summary.reminded_2)
+        <> " warm_handoffs="
+        <> int.to_string(summary.warm_handoffs)
+        <> " terminal_partial="
+        <> int.to_string(summary.terminal_partial)
+        <> " terminal_unreachable="
+        <> int.to_string(summary.terminal_unreachable)
+        <> " failed="
+        <> int.to_string(summary.failed)
+        <> " stood_down="
+        <> int.to_string(summary.stood_down),
+      )
+    Error(DbError(msg)) -> {
+      wisp.log_error("reference_checks sweep failed (db): " <> msg)
+      sentry_client.capture(
+        sentry_client.init(),
+        sentry_client.BackgroundEvent(
+          event_type: "ReferenceSweepFailed",
+          message: "bootstrap db failure: " <> msg,
+          level: sentry_client.LevelError,
+          tags: [#("sweep", "reference_checks"), #("phase", "bootstrap")],
+        ),
+      )
+      panic as "reference_checks sweep db failure"
+    }
+  }
+}
+
+fn bootstrap() -> Result(RunSummary, RunError) {
+  use db_conn <- result.try(db.start() |> result.map_error(DbError))
+  let resend_api_key = envoy.get("RESEND_API_KEY") |> result.unwrap("")
+  // sms_client.init returns Disabled when TWILIO_* is unset (the external
+  // gate — no SMS sends until the Alpha Sender ID is provisioned, Q1).
+  let twilio = sms_client.init()
+  let sentry = sentry_client.init()
+  let deps = send.SendDeps(resend_api_key:, twilio:, sentry:)
+  // A real ISO now stamps the attempt-log `at` field (a pinned "" would leave
+  // every entry timestampless in production). Tests pass a fixed string.
+  Ok(run(
+    db_conn,
+    deps,
+    now_iso: now_iso(),
+    sentry: sentry,
+    batch_limit: default_batch_limit,
+  ))
+}
+
+/// The current UTC time as an RFC3339 string — the attempt-log `at` stamp
+/// and (cast to timestamptz) the cadence SELECT's `now`. Exposed so the
+/// manual-fire handler stamps the same way.
+pub fn now_iso() -> String {
+  timestamp.system_time()
+  |> timestamp.to_rfc3339(calendar.utc_offset)
+}
+
+// ---------------------------------------------------------------------------
+// The worker
+// ---------------------------------------------------------------------------
+
+/// Run one sweep tick. `now_iso` is an ISO-8601 timestamp string, or "" to
+/// let Postgres default to now() (production passes ""; tests pin the clock
+/// so cadence steps are deterministic). `deps` carries the send helpers'
+/// Resend key + Twilio handle + Sentry; `sentry` is also passed for the
+/// per-row failure path (bootstrap reuses deps.sentry). `batch_limit` caps
+/// the tick. Returns a RunSummary for the liveness log.
+///
+/// Per-row failures (a DB/decode error) mark the row `failed` + Sentry + the
+/// tick continues — a single bad row never aborts the sweep (AD-15). The
+/// guarded updates' 0-row results (a concurrent writer / retry) are counted
+/// as `stood_down`, not failures (AD-14 — exactly-once state transitions).
+pub fn run(
+  db: pog.Connection,
+  deps: send.SendDeps,
+  now_iso now_iso: String,
+  sentry sentry: sentry_client.Sentry,
+  batch_limit batch_limit: Int,
+) -> RunSummary {
+  case sql.sweep_due_reference_calls(db, now_iso, batch_limit) {
+    Error(err) -> {
+      // The due-SELECT failed — the sweep can't run. Capture + return empty.
+      capture(sentry, "", "due-select failed: " <> query_error(err), "select")
+      empty_summary(0)
+    }
+    Ok(pog.Returned(_, rows)) ->
+      list.fold(rows, empty_summary(list.length(rows)), fn(acc, row) {
+        case process_row(db, deps, now_iso, sentry, row) {
+          Invited -> RunSummary(..acc, invited: acc.invited + 1)
+          CoNudged -> RunSummary(..acc, co_nudged: acc.co_nudged + 1)
+          CoNudgeSkipped ->
+            RunSummary(..acc, co_nudge_skipped: acc.co_nudge_skipped + 1)
+          Reminded1 -> RunSummary(..acc, reminded_1: acc.reminded_1 + 1)
+          Reminded2 -> RunSummary(..acc, reminded_2: acc.reminded_2 + 1)
+          WarmHandoff -> RunSummary(..acc, warm_handoffs: acc.warm_handoffs + 1)
+          TerminalPartial ->
+            RunSummary(..acc, terminal_partial: acc.terminal_partial + 1)
+          TerminalUnreachable ->
+            RunSummary(
+              ..acc,
+              terminal_unreachable: acc.terminal_unreachable + 1,
+            )
+          Failed -> RunSummary(..acc, failed: acc.failed + 1)
+          StoodDown -> RunSummary(..acc, stood_down: acc.stood_down + 1)
+        }
+      })
+  }
+}
+
+fn empty_summary(due: Int) -> RunSummary {
+  RunSummary(
+    due:,
+    invited: 0,
+    co_nudged: 0,
+    co_nudge_skipped: 0,
+    reminded_1: 0,
+    reminded_2: 0,
+    warm_handoffs: 0,
+    terminal_partial: 0,
+    terminal_unreachable: 0,
+    failed: 0,
+    stood_down: 0,
+  )
+}
+
+/// The per-row outcome (folded into the RunSummary by `run`).
+pub type RowOutcome {
+  Invited
+  CoNudged
+  CoNudgeSkipped
+  Reminded1
+  Reminded2
+  WarmHandoff
+  TerminalPartial
+  TerminalUnreachable
+  Failed
+  StoodDown
+}
+
+// ---------------------------------------------------------------------------
+// Per-row step logic
+// ---------------------------------------------------------------------------
+
+fn process_row(
+  db: pog.Connection,
+  deps: send.SendDeps,
+  now_iso: String,
+  sentry: sentry_client.Sentry,
+  row: sql.SweepDueReferenceCallsRow,
+) -> RowOutcome {
+  case uuid.from_string(row.id) {
+    Error(_) -> mark_failed(db, sentry, row.id, "bad reference_call id")
+    Ok(row_uuid) ->
+      case row.attempt_count {
+        0 -> step_t0(db, deps, now_iso, sentry, row, row_uuid)
+        1 -> step_co_nudge(db, deps, now_iso, sentry, row, row_uuid)
+        2 ->
+          step_reminder(
+            db,
+            deps,
+            now_iso,
+            sentry,
+            row,
+            row_uuid,
+            messages.ReminderOne,
+            step_to_reminder_2,
+          )
+        3 -> step_warm_handoff(db, deps, now_iso, sentry, row, row_uuid)
+        4 -> step_terminal(db, sentry, row, row_uuid)
+        _ ->
+          // attempt_count > 4 is impossible (T+144 terminalizes at 4); a row
+          // in this state was hand-edited. Mark failed rather than advance.
+          mark_failed(
+            db,
+            sentry,
+            row.id,
+            "attempt_count out of cadence range: "
+              <> int.to_string(row.attempt_count),
+          )
+      }
+  }
+}
+
+/// T0 invite (AD-4): mint the form_token, send the invite (email+SMS), then
+/// guarded claim (queued -> contact_initiated + stamp token + append +
+/// advance). Send-then-claim: a concurrent T0's worst case is a duplicate
+/// invite, never a missing one. A 0-row claim = someone else won -> stand down.
+fn step_t0(
+  db: pog.Connection,
+  deps: send.SendDeps,
+  now_iso: String,
+  sentry: sentry_client.Sentry,
+  row: sql.SweepDueReferenceCallsRow,
+  row_uuid: Uuid,
+) -> RowOutcome {
+  let token = wisp.random_string(48)
+  let context = build_context(row, token)
+  let outcomes =
+    send.send_invite(
+      deps,
+      send.RefereeMessage(
+        context:,
+        to_email: effective_email(row),
+        to_phone: effective_phone(row),
+      ),
+    )
+  let entries = outcomes_to_json(outcomes, now_iso)
+  case sql.sweep_claim_t0(db, row_uuid, token, entries, step_to_co_nudge) {
+    Ok(pog.Returned(_, [_])) -> Invited
+    Ok(_) -> StoodDown
+    // A persistent claim error (a CHECK/trigger violation on this row — a
+    // global DB outage fails the due-SELECT first, so a per-row UPDATE error
+    // is row-specific poison data) would re-send the invite every 15 min
+    // forever under send-then-claim. Mark failed + capture so it stops + is
+    // loud (AC7, AD-15) — the orphaned-invite edge case is the rare
+    // transient blip, Sentry-captured for ops to re-trigger.
+    Error(err) ->
+      mark_failed(db, sentry, row.id, "T0 claim failed: " <> query_error(err))
+  }
+}
+
+/// T+24h applicant co-nudge (AD-4, A2): fires ONLY when the form was never
+/// opened AND no draft exists. Gate fail -> advance the cadence without
+/// sending (log a `skipped` entry so the warm-handoff render shows the full
+/// cadence). Guarded advance; 0-row = stand down.
+fn step_co_nudge(
+  db: pog.Connection,
+  deps: send.SendDeps,
+  now_iso: String,
+  sentry: sentry_client.Sentry,
+  row: sql.SweepDueReferenceCallsRow,
+  row_uuid: Uuid,
+) -> RowOutcome {
+  let context = build_context(row, row.form_token |> option.unwrap(""))
+  let fires = co_nudge_should_fire(row)
+  let entries = case fires {
+    True -> {
+      let outcome =
+        send.send_co_nudge(
+          deps,
+          to_email: row.applicant_email,
+          applicant_first_name: row.applicant_first_name,
+          referee_name: row.contact_name,
+          referee_first_name: context.referee_first_name,
+        )
+      outcomes_to_json([outcome], now_iso)
+    }
+    False -> {
+      // Gate failed (form opened OR draft exists): advance without sending.
+      let reason = case form_was_opened(row) {
+        True -> "co-nudge skipped: form already opened"
+        False -> "co-nudge skipped: draft exists"
+      }
+      json.array([skipped_entry(now_iso, reason)], fn(e) { e })
+    }
+  }
+  case sql.sweep_advance(db, row_uuid, entries, step_to_reminder_1, 1) {
+    Ok(pog.Returned(_, [_])) ->
+      case fires {
+        True -> CoNudged
+        False -> CoNudgeSkipped
+      }
+    Ok(_) -> StoodDown
+    // See step_t0: a persistent advance error is row-specific poison data —
+    // mark failed + capture rather than loop (AC7, AD-15).
+    Error(err) ->
+      mark_failed(
+        db,
+        sentry,
+        row.id,
+        "co-nudge advance failed: " <> query_error(err),
+      )
+  }
+}
+
+/// T+48h reminder 1 / T+96h reminder 2 (the shared reminder step). Sends the
+/// reminder on both channels, guarded-advances. `increment` is the gap to the
+/// next step (24 for T+48, 48 for T+96).
+fn step_reminder(
+  db: pog.Connection,
+  deps: send.SendDeps,
+  now_iso: String,
+  sentry: sentry_client.Sentry,
+  row: sql.SweepDueReferenceCallsRow,
+  row_uuid: Uuid,
+  stage: messages.ReminderStage,
+  increment: Float,
+) -> RowOutcome {
+  let context = build_context(row, row.form_token |> option.unwrap(""))
+  let outcomes =
+    send.send_reminder(
+      deps,
+      stage:,
+      message: send.RefereeMessage(
+        context:,
+        to_email: effective_email(row),
+        to_phone: effective_phone(row),
+      ),
+    )
+  let entries = outcomes_to_json(outcomes, now_iso)
+  // attempt_count guard = 2 for reminder 1, 3 for reminder 2.
+  let expected = case stage {
+    messages.ReminderOne -> 2
+    messages.ReminderTwo -> 3
+  }
+  case sql.sweep_advance(db, row_uuid, entries, increment, expected) {
+    Ok(pog.Returned(_, [_])) ->
+      case stage {
+        messages.ReminderOne -> Reminded1
+        messages.ReminderTwo -> Reminded2
+      }
+    Ok(_) -> StoodDown
+    // See step_t0: a persistent advance error loops (re-sends the reminder
+    // every 15 min). Mark failed + capture (AC7, AD-15).
+    Error(err) ->
+      mark_failed(
+        db,
+        sentry,
+        row.id,
+        "reminder advance failed: " <> query_error(err),
+      )
+  }
+}
+
+/// T+96h reminder 2 + landlord warm-handoff (§8.3). Sends reminder 2,
+/// guarded-advances (to attempt_count 4), THEN dispatches the
+/// `reference_unreachable` notification — AFTER the advance so a retry never
+/// duplicates it (§8.3 no-duplicate-terminal). The notification IS the
+/// unreachable-path notification; the T+144h terminal is silent.
+fn step_warm_handoff(
+  db: pog.Connection,
+  deps: send.SendDeps,
+  now_iso: String,
+  sentry: sentry_client.Sentry,
+  row: sql.SweepDueReferenceCallsRow,
+  row_uuid: Uuid,
+) -> RowOutcome {
+  let context = build_context(row, row.form_token |> option.unwrap(""))
+  let outcomes =
+    send.send_reminder(
+      deps,
+      stage: messages.ReminderTwo,
+      message: send.RefereeMessage(
+        context:,
+        to_email: effective_email(row),
+        to_phone: effective_phone(row),
+      ),
+    )
+  let entries = outcomes_to_json(outcomes, now_iso)
+  case sql.sweep_advance(db, row_uuid, entries, step_to_terminal, 3) {
+    Ok(pog.Returned(_, [_])) -> {
+      // Advance won — dispatch the warm handoff (exactly-once: only the
+      // advance winner notifies), merging this tick's REAL reminder-2
+      // outcomes into the rendered attempt log (W2: no fabricated entry).
+      dispatch_warm_handoff(db, deps, now_iso, row, context, outcomes)
+      WarmHandoff
+    }
+    Ok(_) -> StoodDown
+    // Do NOT dispatch the warm handoff (the advance didn't commit). See
+    // step_t0: a persistent advance error loops; mark failed + capture.
+    Error(err) ->
+      mark_failed(
+        db,
+        sentry,
+        row.id,
+        "warm-handoff advance failed: " <> query_error(err),
+      )
+  }
+}
+
+/// T+144h silent terminal (§8.3): no message, no notification. Branches on
+/// draft_answers (A2) — a saved draft -> `partial` (result structured from
+/// the draft, confidence capped medium); no draft -> `unreachable` (minimal
+/// §4.6 result). next_attempt_at cleared; purge_after stamped from the
+/// application's retention_due_at when set (§9.3).
+fn step_terminal(
+  db: pog.Connection,
+  sentry: sentry_client.Sentry,
+  row: sql.SweepDueReferenceCallsRow,
+  row_uuid: Uuid,
+) -> RowOutcome {
+  let has_draft = has_draft_answers(row)
+  let #(status, outcome, result_json, terminal_outcome) = case has_draft {
+    True -> {
+      let slot = ref_slot_from_string(row.ref_slot)
+      let draft = questions.decode_draft(row.draft_answers)
+      let result =
+        ref_result.partial_result(
+          slot,
+          draft,
+          ref_result.StructureContext(
+            reference_call_id: row.id,
+            application_id: row.application_id,
+            ref_slot: row.ref_slot,
+            owner_label: "primary",
+            attempts: row.attempts,
+            focus_seconds: 0,
+          ),
+        )
+      #(sql.Partial, "partial", result, TerminalPartial)
+    }
+    False -> {
+      let result =
+        ref_result.minimal_terminal_result(
+          outcome: "unreachable",
+          attempts: row.attempts,
+          note: None,
+        )
+      #(sql.Unreachable, "unreachable", result, TerminalUnreachable)
+    }
+  }
+  case
+    sql.sweep_terminal(
+      db,
+      row_uuid,
+      status,
+      outcome,
+      reason_sequence_exhausted,
+      result_json,
+      row.retention_due_at,
+    )
+  {
+    Ok(pog.Returned(_, [_])) -> terminal_outcome
+    Ok(_) -> StoodDown
+    // See step_t0: a persistent terminal error loops (the row stays due,
+    // re-terminalizing every tick). Mark failed + capture (AC7, AD-15).
+    Error(err) ->
+      mark_failed(db, sentry, row.id, "terminal failed: " <> query_error(err))
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Warm-handoff dispatch (§8.3)
+// ---------------------------------------------------------------------------
+
+fn dispatch_warm_handoff(
+  db: pog.Connection,
+  deps: send.SendDeps,
+  now_iso: String,
+  row: sql.SweepDueReferenceCallsRow,
+  context: RefereeContext,
+  outcomes: List(ChannelOutcome),
+) -> Nil {
+  // The attempt log as the landlord will see it: the row's prior attempts
+  // PLUS this tick's REAL reminder-2 outcomes (W2 — no fabricated entry; the
+  // advance already appended these to the row, so this mirrors the truth).
+  let attempts =
+    parse_attempts_entries(row.attempts)
+    |> list.append(outcomes_to_entries(outcomes, now_iso))
+  case uuid.from_string(row.landlord_id), uuid.from_string(row.id) {
+    Ok(landlord_uuid), Ok(reference_call_uuid) -> {
+      let application_url = application_url(row)
+      let email_subject =
+        messages.warm_handoff_email_subject(
+          row.contact_name,
+          context.applicant_full_name,
+        )
+      let email_html =
+        messages.build_warm_handoff_email_html(
+          landlord_name: row.landlord_display_name,
+          referee_name: row.contact_name,
+          applicant_full_name: context.applicant_full_name,
+          attempts:,
+          application_url:,
+        )
+      // W3: this is the ONLY unreachable-path notification (the T+144h
+      // terminal is silent, §8.3). A lost insert must NOT be silent — log +
+      // Sentry so ops notice the missing warm handoff.
+      case
+        notification_dispatch.notify_reference_unreachable(
+          db,
+          landlord_id: landlord_uuid,
+          reference_call_id: reference_call_uuid,
+          referee_name: row.contact_name,
+          applicant_full_name: context.applicant_full_name,
+          email_subject:,
+          email_html:,
+          resend_api_key: deps.resend_api_key,
+        )
+      {
+        Ok(_) -> Nil
+        Error(reason) -> {
+          wisp.log_error(
+            "reference warm-handoff notification failed for "
+            <> row.id
+            <> ": "
+            <> reason,
+          )
+          sentry_client.capture(
+            deps.sentry,
+            sentry_client.BackgroundEvent(
+              event_type: "ReferenceWarmHandoffLost",
+              message: "warm-handoff notification insert failed: " <> reason,
+              level: sentry_client.LevelError,
+              tags: [
+                #("sweep", "reference_checks"),
+                #("reference_call_id", row.id),
+              ],
+            ),
+          )
+          Nil
+        }
+      }
+    }
+    _, _ -> Nil
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Failure path (§4.6, AD-15)
+// ---------------------------------------------------------------------------
+
+/// Mark a row `failed` (outcome NULL, no result) + Sentry capture. Best-effort
+/// on the DB write (a down DB can't be written to); the Sentry capture is the
+/// durable signal. Returns `Failed` regardless (the row could not process).
+fn mark_failed(
+  db: pog.Connection,
+  sentry: sentry_client.Sentry,
+  row_id: String,
+  reason: String,
+) -> RowOutcome {
+  case uuid.from_string(row_id) {
+    Ok(row_uuid) -> {
+      let _ = sql.sweep_mark_failed(db, row_uuid, reason)
+      Nil
+    }
+    Error(_) -> Nil
+  }
+  capture(sentry, row_id, reason, "processing error")
+  Failed
+}
+
+fn capture(
+  sentry: sentry_client.Sentry,
+  row_id: String,
+  detail: String,
+  class: String,
+) -> Nil {
+  sentry_client.capture(
+    sentry,
+    sentry_client.BackgroundEvent(
+      event_type: "ReferenceSweepRowFailed",
+      message: detail,
+      level: sentry_client.LevelError,
+      tags: [
+        #("sweep", "reference_checks"),
+        #("reference_call_id", row_id),
+        #("class", class),
+      ],
+    ),
+  )
+}
+
+// ---------------------------------------------------------------------------
+// Helpers — context, effective contacts, gates, attempt entries
+// ---------------------------------------------------------------------------
+
+/// Build the RefereeContext for the send helpers (rc3-2). `base_url` is the
+/// vacancy's origin domain; `expiry_date` is unknown to the sweep ("").
+fn build_context(
+  row: sql.SweepDueReferenceCallsRow,
+  token: String,
+) -> RefereeContext {
+  messages.RefereeContext(
+    referee_first_name: first_name(row.contact_name),
+    applicant_full_name: row.applicant_first_name
+      <> " "
+      <> row.applicant_last_name,
+    applicant_first_name: row.applicant_first_name,
+    landlord_display_name: row.landlord_display_name,
+    slot: ref_slot_from_string(row.ref_slot),
+    form_token: token,
+    base_url: "https://" <> row.origin_domain,
+    expiry_date: "",
+  )
+}
+
+/// Effective email (corrected ?? snapshot, AD-7).
+fn effective_email(row: sql.SweepDueReferenceCallsRow) -> option.Option(String) {
+  case row.corrected_email {
+    Some(e) -> Some(e)
+    None -> row.contact_email
+  }
+}
+
+/// Effective phone (corrected ?? snapshot, AD-7).
+fn effective_phone(row: sql.SweepDueReferenceCallsRow) -> option.Option(String) {
+  case row.corrected_phone {
+    Some(p) -> Some(p)
+    None -> row.contact_phone
+  }
+}
+
+/// The co-nudge gate (A2): fires only when the form was NEVER opened AND no
+/// draft answers exist. Form-opened or a saved draft means the referee is
+/// already engaging — no point nudging the applicant.
+fn co_nudge_should_fire(row: sql.SweepDueReferenceCallsRow) -> Bool {
+  !form_was_opened(row) && !has_draft_answers(row)
+}
+
+fn form_was_opened(row: sql.SweepDueReferenceCallsRow) -> Bool {
+  row.form_opened_at != ""
+}
+
+/// A draft exists when draft_answers decodes to a non-empty map (a saved
+/// answer). "" / null / corrupt all degrade to empty (questions.decode_draft).
+fn has_draft_answers(row: sql.SweepDueReferenceCallsRow) -> Bool {
+  !dict.is_empty(questions.decode_draft(row.draft_answers))
+}
+
+/// The application-detail URL for the warm-handoff CTA.
+fn application_url(row: sql.SweepDueReferenceCallsRow) -> String {
+  "https://"
+  <> row.origin_domain
+  <> "/vacancies/"
+  <> row.vacancy_id
+  <> "/applications/"
+  <> row.application_id
+}
+
+/// First token of a name (best-effort; the full name is used everywhere it
+/// matters — this is only for the co-nudge's first-name address).
+fn first_name(full: String) -> String {
+  case string.split(full, " ") {
+    [first, ..] -> first
+    _ -> full
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Attempt-log entry builders (the row's `attempts` JSONB shape: {at, channel,
+// outcome, detail}). The sweep stamps `at`; the rc3-2 helpers supply the rest.
+// ---------------------------------------------------------------------------
+
+/// Build the JSON array to append for a step's send outcomes.
+fn outcomes_to_json(outcomes: List(ChannelOutcome), at: String) -> json.Json {
+  json.array(outcomes, fn(o) { outcome_entry(o, at) })
+}
+
+/// Build typed AttemptEntry records for a step's send outcomes (the warm-
+/// handoff render merges these with the row's prior attempts — the real
+/// this-tick outcomes, never a fabricated entry).
+fn outcomes_to_entries(
+  outcomes: List(ChannelOutcome),
+  at: String,
+) -> List(AttemptEntry) {
+  list.map(outcomes, fn(o) {
+    AttemptEntry(
+      at:,
+      channel: messages.channel_name(o.channel),
+      outcome: messages.outcome_name(o.outcome),
+      detail: o.detail,
+    )
+  })
+}
+
+fn outcome_entry(outcome: ChannelOutcome, at: String) -> json.Json {
+  json.object([
+    #("at", json.string(at)),
+    #("channel", json.string(messages.channel_name(outcome.channel))),
+    #("outcome", json.string(messages.outcome_name(outcome.outcome))),
+    #("detail", json.string(outcome.detail)),
+  ])
+}
+
+/// A `skipped` attempt entry (the gate-failed co-nudge), pre-built as JSON.
+fn skipped_entry(at: String, reason: String) -> json.Json {
+  json.object([
+    #("at", json.string(at)),
+    #("channel", json.string("email")),
+    #("outcome", json.string("skipped")),
+    #("detail", json.string(reason)),
+  ])
+}
+
+/// Parse the row's attempts JSONB text into typed entries (for the warm-handoff
+/// render). Malformed -> [].
+fn parse_attempts_entries(text: String) -> List(AttemptEntry) {
+  case text {
+    "" -> []
+    _ ->
+      case json.parse(text, decode.list(attempt_decoder())) {
+        Ok(entries) -> entries
+        Error(_) -> []
+      }
+  }
+}
+
+fn attempt_decoder() -> decode.Decoder(AttemptEntry) {
+  use at <- decode.optional_field("at", "", decode.string)
+  use channel <- decode.optional_field("channel", "", decode.string)
+  use outcome <- decode.optional_field("outcome", "", decode.string)
+  use detail <- decode.optional_field("detail", "", decode.string)
+  decode.success(AttemptEntry(at:, channel:, outcome:, detail:))
+}
+
+fn query_error(err: pog.QueryError) -> String {
+  case err {
+    pog.PostgresqlError(code, name, message) ->
+      "PostgreSQL " <> code <> " (" <> name <> "): " <> message
+    _ -> "query error"
+  }
+}
diff --git a/server/src/reference_checks/sweep_handler.gleam b/server/src/reference_checks/sweep_handler.gleam
new file mode 100644
index 00000000..c28b5af1
--- /dev/null
+++ b/server/src/reference_checks/sweep_handler.gleam
@@ -0,0 +1,73 @@
+//// Internal HTTP trigger for the reference-check cadence sweep (RC3.5).
+//// POST /api/v1/internal/reference-checks
+////
+//// Protected by the X-Internal-Secret header (the digest / verification-
+//// reminder precedent). Lets ops fire the sweep on demand instead of waiting
+//// for the 15-min Cloud Scheduler tick — useful after a deploy, a Twilio key
+//// flip-on, or to drain a backlog. The scheduler-driven Cloud Run Job is the
+//// normal path; this route is the manual override. Runs against the live
+//// config (DB + Resend + Twilio + Sentry), so failures escalate to Sentry
+//// the same as a scheduled tick.
+
+import config.{type ServerConfig}
+import gleam/int
+import gleam/json
+import reference_checks/send
+import reference_checks/sweep
+import response_helpers
+import sentry/sentry_client
+import wisp.{type Request, type Response}
+
+/// Handle POST /api/v1/internal/reference-checks. Runs one sweep tick against
+/// the live config and returns the per-step counts as JSON.
+pub fn handle_run_reference_checks(
+  req req: Request,
+  config config: ServerConfig,
+) -> Response {
+  case response_helpers.require_internal_secret(req, config.internal_secret) {
+    Error(resp) -> resp
+    Ok(_) -> {
+      let deps =
+        send.SendDeps(
+          resend_api_key: config.resend_api_key,
+          twilio: config.twilio,
+          // Manual runs don't escalate per-row failures to the production
+          // Sentry (the verification_reminder precedent) — the scheduled
+          // Cloud Run Job (sweep.main/0) owns the live capture path.
+          sentry: sentry_client.Disabled,
+        )
+      let summary =
+        sweep.run(
+          config.db,
+          deps,
+          now_iso: sweep.now_iso(),
+          sentry: sentry_client.Disabled,
+          batch_limit: 1000,
+        )
+      wisp.log_info(
+        "reference-checks manual sweep: due="
+        <> int.to_string(summary.due)
+        <> " invited="
+        <> int.to_string(summary.invited)
+        <> " failed="
+        <> int.to_string(summary.failed),
+      )
+      let body =
+        json.object([
+          #("due", json.int(summary.due)),
+          #("invited", json.int(summary.invited)),
+          #("co_nudged", json.int(summary.co_nudged)),
+          #("co_nudge_skipped", json.int(summary.co_nudge_skipped)),
+          #("reminded_1", json.int(summary.reminded_1)),
+          #("reminded_2", json.int(summary.reminded_2)),
+          #("warm_handoffs", json.int(summary.warm_handoffs)),
+          #("terminal_partial", json.int(summary.terminal_partial)),
+          #("terminal_unreachable", json.int(summary.terminal_unreachable)),
+          #("failed", json.int(summary.failed)),
+          #("stood_down", json.int(summary.stood_down)),
+        ])
+        |> json.to_string
+      wisp.json_response(body, 200)
+    }
+  }
+}
