diff --git a/server/test/integration/reference_checks_sweep_integration_test.gleam b/server/test/integration/reference_checks_sweep_integration_test.gleam
new file mode 100644
index 00000000..1b161801
--- /dev/null
+++ b/server/test/integration/reference_checks_sweep_integration_test.gleam
@@ -0,0 +1,669 @@
+//// Integration tests for the reference-check cadence sweep (RC3.5).
+////
+//// Pins the acceptance criteria against a real Postgres (Docker test DB):
+//// the per-step cadence (T0 invite / T+24 co-nudge / T+48 reminder 1 /
+//// T+96 reminder 2 + warm-handoff / T+144 silent terminal), EXACTLY-ONCE
+//// (the no-duplicate-T0-across-retry hard requirement), terminal-state
+//// respect (objected sticky, taken-over skipped), and partial vs
+//// unreachable from drafts. Sends no-op (empty RESEND key + Disabled
+//// Twilio) — the sweep still transitions, which is what we assert.
+
+import gleam/dynamic/decode
+import gleam/int
+import gleeunit/should
+import integration/helpers
+import integration/test_db
+import notification/sms_client
+import pog
+import reference_checks/send
+import reference_checks/sweep
+import sentry/sentry_client
+import unitest
+import wisp
+
+fn no_key_deps() -> send.SendDeps {
+  send.SendDeps(
+    resend_api_key: "",
+    twilio: sms_client.Disabled,
+    sentry: sentry_client.Disabled,
+  )
+}
+
+fn run_sweep(db: pog.Connection) -> sweep.RunSummary {
+  wisp.configure_logger()
+  sweep.run(
+    db,
+    no_key_deps(),
+    now_iso: "",
+    sentry: sentry_client.Disabled,
+    batch_limit: 100,
+  )
+}
+
+/// Seed a due reference_call row at a chosen cadence position.
+/// `attempt_count` + `status` set the step; `form_opened` and `draft` drive
+/// the co-nudge gate / partial terminal; `taken_over` skips the row.
+fn seed_due_row(
+  db: pog.Connection,
+  attempt_count attempt_count: Int,
+  status status: String,
+  form_opened form_opened: Bool,
+  draft draft: String,
+  taken_over taken_over: Bool,
+) -> String {
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 0)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let assert Ok(returned) =
+    pog.query(
+      "INSERT INTO application (
+         vacancy_id, first_name, last_name, email, phone,
+         employment_status, monthly_income_cents,
+         employer_name, job_title, employment_duration,
+         landlord_ref_name, landlord_ref_email, landlord_ref_phone,
+         never_rented_before, reference_contact_choice
+       )
+       VALUES (
+         $1::uuid, 'Aisling', 'O''Brien', 'applicant@example.com', '+353861234567',
+         'employed', 350000,
+         'Acme Ltd', 'Senior Chef', '3 years',
+         'Colm Byrne', 'colm@example.com', '+353871111111',
+         false, 'attested'
+       )
+       RETURNING id::text",
+    )
+    |> pog.parameter(pog.text(vacancy_id))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  let assert [application_id, ..] = returned.rows
+  let opened_sql = case form_opened {
+    True -> "now() - interval '3 hours'"
+    False -> "NULL"
+  }
+  let draft_sql = case draft {
+    "" -> "NULL"
+    _ -> "$3::jsonb"
+  }
+  let taken_sql = case taken_over {
+    True -> "now()"
+    False -> "NULL"
+  }
+  // next_attempt_at is in the past (now() - 1h) so the row is due this tick
+  // regardless of which cadence step it's at.
+  let sql = "INSERT INTO reference_call (
+       application_id, ref_slot, status, attempt_count,
+       contact_name, contact_email, contact_phone,
+       form_opened_at, draft_answers, taken_over_at, next_attempt_at
+     )
+     VALUES (
+       $1::uuid, 'landlord_ref', $2::reference_call_status, " <> int.to_string(
+      attempt_count,
+    ) <> ",
+       'Colm Byrne', 'colm@example.com', '+353871111111',
+       " <> opened_sql <> ", " <> draft_sql <> ", " <> taken_sql <> ", now() - interval '1 hour'
+     )
+     RETURNING id::text"
+  let assert Ok(inserted) = case draft {
+    "" ->
+      pog.query(sql)
+      |> pog.parameter(pog.text(application_id))
+      |> pog.parameter(pog.text(status))
+      |> pog.returning(decode.at([0], decode.string))
+      |> pog.execute(db)
+    _ ->
+      pog.query(sql)
+      |> pog.parameter(pog.text(application_id))
+      |> pog.parameter(pog.text(status))
+      |> pog.parameter(pog.text(draft))
+      |> pog.returning(decode.at([0], decode.string))
+      |> pog.execute(db)
+  }
+  let assert [row_id, ..] = inserted.rows
+  row_id
+}
+
+fn row_status(db: pog.Connection, row_id: String) -> String {
+  test_db.query_text(
+    db,
+    "SELECT status::text FROM reference_call WHERE id = '" <> row_id <> "'",
+  )
+  |> result_unwrap
+}
+
+fn row_attempt_count(db: pog.Connection, row_id: String) -> Int {
+  to_int(test_db.query_text(
+    db,
+    "SELECT attempt_count::text FROM reference_call WHERE id = '"
+      <> row_id
+      <> "'",
+  ))
+}
+
+fn row_next_attempt_at_present(db: pog.Connection, row_id: String) -> Bool {
+  to_bool(test_db.query_text(
+    db,
+    "SELECT (next_attempt_at IS NOT NULL)::text FROM reference_call WHERE id = '"
+      <> row_id
+      <> "'",
+  ))
+}
+
+fn row_form_token_present(db: pog.Connection, row_id: String) -> Bool {
+  to_bool(test_db.query_text(
+    db,
+    "SELECT (form_token IS NOT NULL)::text FROM reference_call WHERE id = '"
+      <> row_id
+      <> "'",
+  ))
+}
+
+fn row_outcome(db: pog.Connection, row_id: String) -> String {
+  result_unwrap(test_db.query_text(
+    db,
+    "SELECT COALESCE(outcome::text, '') FROM reference_call WHERE id = '"
+      <> row_id
+      <> "'",
+  ))
+}
+
+fn attempts_length(db: pog.Connection, row_id: String) -> Int {
+  to_int(test_db.query_text(
+    db,
+    "SELECT jsonb_array_length(attempts)::text FROM reference_call WHERE id = '"
+      <> row_id
+      <> "'",
+  ))
+}
+
+fn notification_count(db: pog.Connection, row_id: String) -> Int {
+  to_int(test_db.query_text(
+    db,
+    "SELECT count(*)::text FROM notification WHERE entity_type = 'reference_call' AND entity_id = '"
+      <> row_id
+      <> "'",
+  ))
+}
+
+fn result_verification_present(db: pog.Connection, row_id: String) -> Bool {
+  to_bool(test_db.query_text(
+    db,
+    "SELECT (result->'verification' IS NOT NULL)::text FROM reference_call WHERE id = '"
+      <> row_id
+      <> "'",
+  ))
+}
+
+fn result_confidence(db: pog.Connection, row_id: String) -> String {
+  test_db.query_text(
+    db,
+    "SELECT COALESCE(result->'ai_summary'->>'confidence', '') FROM reference_call WHERE id = '"
+      <> row_id
+      <> "'",
+  )
+  |> result_unwrap
+}
+
+fn result_unwrap(r: Result(String, String)) -> String {
+  let assert Ok(s) = r
+  s
+}
+
+fn to_int(r: Result(String, String)) -> Int {
+  let assert Ok(n) = result_unwrap(r) |> int.parse
+  n
+}
+
+fn to_bool(r: Result(String, String)) -> Bool {
+  result_unwrap(r) == "true"
+}
+
+// ===========================================================================
+// T0 invite (AC2): queued -> contact_initiated, token minted, attempts logged,
+// next_attempt_at advanced.
+// ===========================================================================
+
+pub fn t0_invite_advances_and_mints_token_test() {
+  use <- unitest.tag("integration")
+  let db = helpers.setup()
+  let row_id =
+    seed_due_row(
+      db,
+      attempt_count: 0,
+      status: "queued",
+      form_opened: False,
+      draft: "",
+      taken_over: False,
+    )
+
+  let summary = run_sweep(db)
+
+  summary.invited |> should.equal(1)
+  row_status(db, row_id) |> should.equal("contact_initiated")
+  row_attempt_count(db, row_id) |> should.equal(1)
+  // The T0 invite sends on 2 channels (email + sms); both no-op/skip here,
+  // but both are logged as attempt entries.
+  attempts_length(db, row_id) |> should.equal(2)
+  // The token is minted at T0 (rc3-5 owns the mint).
+  row_form_token_present(db, row_id) |> should.be_true()
+  // next_attempt_at advanced into the future (no longer due).
+  row_next_attempt_at_present(db, row_id) |> should.be_true()
+}
+
+// ===========================================================================
+// EXACTLY-ONCE (AC3) — the hard requirement: a retry / double-fire does NOT
+// re-send T0. After T0 advances next_attempt_at into the future, a second
+// run does not re-select the row.
+// ===========================================================================
+
+pub fn no_duplicate_t0_across_retry_test() {
+  use <- unitest.tag("integration")
+  let db = helpers.setup()
+  let row_id =
+    seed_due_row(
+      db,
+      attempt_count: 0,
+      status: "queued",
+      form_opened: False,
+      draft: "",
+      taken_over: False,
+    )
+
+  let _ = run_sweep(db)
+  // A second run immediately (the retry / double-fire / downtime-recovery case).
+  let second = run_sweep(db)
+
+  // The row was NOT re-selected (next_attempt_at is now future) -> 0 invited.
+  second.invited |> should.equal(0)
+  second.due |> should.equal(0)
+  // attempt_count stayed at 1 (no double-advance); still one invite set.
+  row_attempt_count(db, row_id) |> should.equal(1)
+  attempts_length(db, row_id) |> should.equal(2)
+}
+
+// ===========================================================================
+// Co-nudge gate (AC4): fires ONLY when the form was never opened AND no draft.
+// ===========================================================================
+
+pub fn co_nudge_fires_when_form_unopened_no_draft_test() {
+  use <- unitest.tag("integration")
+  let db = helpers.setup()
+  let row_id =
+    seed_due_row(
+      db,
+      attempt_count: 1,
+      status: "contact_initiated",
+      form_opened: False,
+      draft: "",
+      taken_over: False,
+    )
+
+  let summary = run_sweep(db)
+
+  summary.co_nudged |> should.equal(1)
+  row_attempt_count(db, row_id) |> should.equal(2)
+  // One co-nudge attempt entry (email channel, to the applicant).
+  attempts_length(db, row_id) |> should.equal(1)
+}
+
+pub fn co_nudge_skipped_when_form_already_opened_test() {
+  use <- unitest.tag("integration")
+  let db = helpers.setup()
+  let row_id =
+    seed_due_row(
+      db,
+      attempt_count: 1,
+      status: "contact_initiated",
+      form_opened: True,
+      draft: "",
+      taken_over: False,
+    )
+
+  let summary = run_sweep(db)
+
+  // Gate failed (form opened) -> cadence advances without sending.
+  summary.co_nudge_skipped |> should.equal(1)
+  summary.co_nudged |> should.equal(0)
+  row_attempt_count(db, row_id) |> should.equal(2)
+  // A skipped co-nudge still logs one entry (the warm-handoff render's sake).
+  attempts_length(db, row_id) |> should.equal(1)
+}
+
+pub fn co_nudge_skipped_when_draft_exists_test() {
+  use <- unitest.tag("integration")
+  let db = helpers.setup()
+  let row_id =
+    seed_due_row(
+      db,
+      attempt_count: 1,
+      status: "contact_initiated",
+      form_opened: False,
+      draft: "{\"identity_confirmed\":\"yes\"}",
+      taken_over: False,
+    )
+
+  let summary = run_sweep(db)
+
+  summary.co_nudge_skipped |> should.equal(1)
+  summary.co_nudged |> should.equal(0)
+  row_attempt_count(db, row_id) |> should.equal(2)
+}
+
+// ===========================================================================
+// T+48 reminder 1 + T+96 reminder 2 / warm-handoff (AC2, AC5)
+// ===========================================================================
+
+pub fn reminder_1_advances_test() {
+  use <- unitest.tag("integration")
+  let db = helpers.setup()
+  let row_id =
+    seed_due_row(
+      db,
+      attempt_count: 2,
+      status: "contact_initiated",
+      form_opened: True,
+      draft: "",
+      taken_over: False,
+    )
+
+  let summary = run_sweep(db)
+
+  summary.reminded_1 |> should.equal(1)
+  row_attempt_count(db, row_id) |> should.equal(3)
+  // Reminder 1 = email + sms = 2 entries.
+  attempts_length(db, row_id) |> should.equal(2)
+}
+
+pub fn reminder_2_fires_warm_handoff_notification_test() {
+  use <- unitest.tag("integration")
+  let db = helpers.setup()
+  let row_id =
+    seed_due_row(
+      db,
