+// Reference-form advance helper: report current question layout, select the
+// first visible radio if present, then click the visible Continue button.
+// Returns JSON: {title, labels: [...], inputs: [...], advanced: bool}
+(() => {
+  const sections = [...document.querySelectorAll('section[data-testid="reference-question"]')];
+  const vis = sections.find(s => s.getBoundingClientRect().height > 0);
+  if (!vis) return JSON.stringify({ error: 'no visible question' });
+  const title = vis.querySelector('h2') ? vis.querySelector('h2').textContent.trim().slice(0, 50) : '?';
+  const labels = [...vis.querySelectorAll('label')].filter(l => l.getBoundingClientRect().height > 0)
+    .map(l => ({ txt: (l.textContent || '').trim().slice(0, 28), w: Math.round(l.getBoundingClientRect().width), h: Math.round(l.getBoundingClientRect().height) }));
+  const inputs = [...vis.querySelectorAll('input,textarea,select')].filter(i => i.getBoundingClientRect().height > 0 && i.type !== 'hidden')
+    .map(i => ({ type: i.type || i.tagName.toLowerCase(), w: Math.round(i.getBoundingClientRect().width), h: Math.round(i.getBoundingClientRect().height) }));
+  // select first radio
+  const radios = [...vis.querySelectorAll('input[type=radio]')].filter(r => r.getBoundingClientRect().height > 0);
+  if (radios.length && !radios.some(r => r.checked)) {
+    radios[0].click();
+  }
+  // fill text inputs with a value
+  const texts = [...vis.querySelectorAll('input[type=text]')].filter(i => i.getBoundingClientRect().height > 0);
+  texts.forEach(t => { t.value = 'Test answer'; t.dispatchEvent(new Event('input', { bubbles: true })); t.dispatchEvent(new Event('change', { bubbles: true })); });
+  const months = [...vis.querySelectorAll('input[type=month]')].filter(i => i.getBoundingClientRect().height > 0);
+  months.forEach(t => { t.value = '2024-01'; t.dispatchEvent(new Event('input', { bubbles: true })); t.dispatchEvent(new Event('change', { bubbles: true })); });
+  const checks = [...vis.querySelectorAll('input[type=checkbox]')].filter(i => i.getBoundingClientRect().height > 0);
+  checks.forEach(c => { if (!c.checked) c.click(); });
+  const btn = [...document.querySelectorAll('[data-testid="reference-continue"]')].find(b => b.getBoundingClientRect().height > 0);
+  if (btn) { btn.click(); }
+  return JSON.stringify({ title, labels, inputs, checks: checks.length, advanced: !!btn });
+})()
