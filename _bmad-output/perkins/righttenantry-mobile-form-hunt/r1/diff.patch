new file mode 100644
index 00000000..30a61f2e
--- /dev/null
+++ b/_bmad-output/implementation-artifacts/mobile-form-hunt/notes/probe.js
@@ -0,0 +1,53 @@
+// Mobile overflow + tap-target probe — run via agent-browser eval.
+// Usage: agent-browser eval "$(cat probe.js)"
+(() => {
+  const iw = innerWidth;
+  const out = { innerWidth: iw, scrollW: document.documentElement.scrollWidth, bodyScrollW: document.body ? document.body.scrollWidth : 0, overflowX: getComputedStyle(document.documentElement).overflowX, offenders: [], smallTargets: [] };
+
+  // 1. Overflow offenders — elements sticking out of the viewport horizontally
+  document.querySelectorAll('*').forEach(el => {
+    const r = el.getBoundingClientRect();
+    if (r.width === 0 && r.height === 0) return;
+    if (r.right > iw + 1 || r.left < -1) {
+      const cs = getComputedStyle(el);
+      if (cs.position === 'fixed' || cs.position === 'sticky') return;
+      out.offenders.push({
+        tag: el.tagName,
+        cls: (el.className || '').toString().slice(0, 70),
+        id: el.id || '',
+        left: Math.round(r.left),
+        right: Math.round(r.right),
+        w: Math.round(r.width),
+      });
+    }
+  });
+
+  // 2. Tap targets < 44px (interactive elements)
+  const sel = 'a, button, input, select, textarea, [role="button"], [role="checkbox"], [role="radio"], [data-testid]';
+  const seen = new Set();
+  document.querySelectorAll(sel).forEach(el => {
+    const r = el.getBoundingClientRect();
+    if (r.width === 0 || r.height === 0) return;
+    const cs = getComputedStyle(el);
+    if (cs.visibility === 'hidden' || cs.display === 'none') return;
+    if (r.top > innerHeight + 50 || r.bottom < -50) return; // off-screen
+    const key = el.tagName + '|' + (el.className || '') + '|' + (el.id || '');
+    if (seen.has(key)) return;
+    seen.add(key);
+    if (r.width < 44 || r.height < 44) {
+      // skip tiny icons/links that are part of a larger row (e.g. inline text links) but flag them anyway
+      out.smallTargets.push({
+        tag: el.tagName,
+        cls: (el.className || '').toString().slice(0, 60),
+        id: el.id || '',
+        txt: (el.textContent || el.value || '').toString().trim().slice(0, 30),
+        w: Math.round(r.width),
+        h: Math.round(r.height),
+        top: Math.round(r.top),
+        testid: el.getAttribute('data-testid') || '',
+      });
+    }
+  });
+  out.smallTargetCount = out.smallTargets.length;
+  return JSON.stringify(out);
+})()
