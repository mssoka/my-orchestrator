@@ -0,0 +1,47 @@
+#!/usr/bin/env python3
+"""Run the mobile probe via agent-browser and print a clean summary.
+Usage: probe.py            # probe current page, print summary
+"""
+import json, subprocess, sys, os
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+JS = open(os.path.join(HERE, "probe.js")).read()
+
+def run_eval(js):
+    p = subprocess.run(
+        ["agent-browser", "--session", "righttenantry-mobile-form-hunt", "eval", js],
+        capture_output=True, text=True, timeout=60,
+    )
+    raw = p.stdout.strip().splitlines()[-1] if p.stdout.strip() else "null"
+    # agent-browser wraps eval output in JSON; the payload may be a string that
+    # itself contains JSON — parse until we reach a dict/list/scalar
+    val = raw
+    for _ in range(4):
+        try:
+            parsed = json.loads(val)
+        except Exception:
+            return val
+        if isinstance(parsed, list) and parsed and isinstance(parsed[0], str):
+            val = parsed[0]
+            continue
+        if isinstance(parsed, str) and parsed.strip().startswith(("{", "[")):
+            val = parsed
+            continue
+        return parsed
+    return val
+
+def main():
+    d = run_eval(JS)
+    if not isinstance(d, dict):
+        print("probe failed:", str(d)[:200])
+        sys.exit(1)
+    print(f"innerWidth: {d['innerWidth']} | scrollW: {d['scrollW']} | offenders: {len(d['offenders'])} | smallTargets: {len(d['smallTargets'])}")
+    for o in d["offenders"][:10]:
+        print(f"  OFF: <{o['tag']}> {o['cls'] or o['id'][:40]} L{o['left']} R{o['right']}")
+    for t in d["smallTargets"][:25]:
+        label = t["testid"] or t["cls"] or t["txt"]
+        print(f"  SMALL: <{t['tag']}> {label[:45]} {t['w']}x{t['h']} @top{t['top']}")
+    return d
+
+if __name__ == "__main__":
+    main()
