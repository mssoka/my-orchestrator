+#!/usr/bin/env bash
+# run-probe.sh <out-json> — run the overflow/tap-target probe and save clean JSON
+set -euo pipefail
+SESSION="righttenantry-mobile-form-hunt"
+HERE="$(cd "$(dirname "$0")" && pwd)"
+OUT="${1:-$HERE/probe-out.json}"
+RAW=$(agent-browser --session "$SESSION" eval "$(cat "$HERE/probe.js")" 2>/dev/null | tail -1)
+# agent-browser eval returns a JSON string; strip wrapping quotes if present
+CLEAN=$(python3 -c "
+import sys, json
+raw = sys.stdin.read().strip()
+while isinstance(raw, str):
+    s = raw.strip()
+    if not s.startswith('"') and not s.startswith('['):
+        break
+    try:
+        raw = json.loads(s)
+    except Exception:
+        break
+print(json.dumps(raw))
+" <<< "$RAW")
+echo "$CLEAN" > "$OUT"
+python3 -c "
+import json
+d = json.load(open('$OUT'))
+print('innerWidth:', d['innerWidth'], '| scrollW:', d['scrollW'], '| offenders:', len(d['offenders']), '| smallTargets:', len(d['smallTargets']))
+for o in d['offenders'][:8]: print('  OFF:', o['tag'], (o['cls'] or o['id'])[:50], 'L' + str(o['left']), 'R' + str(o['right']))
+for t in d['smallTargets'][:20]: print('  SMALL:', t['tag'], (t['testid'] or t['cls'] or t['txt'])[:40], str(t['w'])+'x'+str(t['h']))
+"
