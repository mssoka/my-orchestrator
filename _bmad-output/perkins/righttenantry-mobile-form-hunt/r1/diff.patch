   html |> string.contains("stepper-stop-approved") |> should.be_true
 }
 
+pub fn status_stepper_rail_can_shrink_inside_card_test() {
+  // Mobile re-sweep fix: the stepper root is a flex item of a
+  // flex-wrap/justify-center wrapper (application_detail.gleam). Without
+  // min-w-0 the rail refuses to shrink below its content's intrinsic width
+  // (min-width:auto) and escapes the card, clipping the first stop off the
+  // left edge at <768px. min-w-0 lets overflow-x-auto engage at the card width.
+  let html =
+    status_stepper.view(test_application(), 0)
+    |> element.to_string
+  html |> string.contains("min-w-0") |> should.be_true
+}
+
+pub fn status_stepper_terminal_roots_fill_card_test() {
+  // The rejected and auto-closed steppers wrap their rail in a
+  // flex flex-col items-end root — as a flex item of the (now w-full)
+  // application-detail wrapper the root itself must fill the card, or the
+  // rail inside it still overflows both edges on mobile.
+  let rejected_app =
+    application.Application(..test_application(), status: application.Rejected)
+  let rejected =
+    status_stepper.view(rejected_app, 0)
+    |> element.to_string
+  // The root carries w-full (fills the card) and the rail keeps min-w-0.
+  rejected
+  |> string.contains("flex flex-col items-end gap-2 w-full")
+  |> should.be_true
+  rejected |> string.contains("min-w-0") |> should.be_true
+}
+
