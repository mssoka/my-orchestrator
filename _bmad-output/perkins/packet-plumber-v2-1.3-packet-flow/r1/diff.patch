+			if a_id == p.heading {
+				depart_id, arrive_id = b_id, a_id
+			} else if b_id == p.heading {
+				depart_id, arrive_id = a_id, b_id
+			} else {
+				continue // defensive: heading isn't an endpoint (shouldn't happen)
+			}
+			ds, dok := pp.node_slot(topo, depart_id)
+			as_, aok := pp.node_slot(topo, arrive_id)
+			if !dok || !aok {
+				continue
+			}
+			depart := node_screen(v, topo.node_pos[ds])
+			arrive := node_screen(v, topo.node_pos[as_])
+			frac := f32(pp.packet_progress_frac(p, bandwidth)) / 256.0
+			pos = {
+				depart.x + (arrive.x - depart.x) * frac,
+				depart.y + (arrive.y - depart.y) * frac,
+			}
+		} else {
+			ns, ok := pp.node_slot(topo, p.at_node)
+			if !ok {
+				continue
+			}
+			pos = node_screen(v, topo.node_pos[ns])
+		}
+		r := v.tile_px * v.scale * 0.24
+		rl.DrawCircleV(pos, r, v.palette.packet_dark)    // outline (readable on any pipe)
+		rl.DrawCircleV(pos, r * 0.78, v.palette.packet_dot) // body
+	}
+}
