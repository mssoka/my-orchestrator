new file mode 100644
index 0000000..a7deda4
--- /dev/null
+++ b/core/routing.odin
@@ -0,0 +1,174 @@
+package core
+
+// routing.odin — the per-hop forwarding table (architecture §6.2, the locked
+// routing model — canon #18 / routing ruling, lavish 2026-08-10). Each node
+// holds a forwarding entry (node, dst) -> next hop (node + pipe), computed by
+// a deterministic BFS (insertion-order tie-breaks — NO rng in routing for the
+// single-path 1.3 form; ECMP's splitmix64 hash lands in slice 2). The table is
+// REBUILT ONLY WHEN THE TOPOLOGY CHANGES, SYNCHRONOUSLY INSIDE THE TICK (4-rule
+// spine rule 1, ODN-10) — never per-packet, never async. A packet carries NO
+// cached route; at each node it reaches it consults the fresh table — so a
+// topology change propagates at the next junction (E29: automatic migration).
+//
+// The prototype's compute_route BFS + cached packet.route[] is explicitly NOT
+// the model — do not port it. The BFS HERE builds the FORWARDING TABLE (next
+// hop per dst), not a per-packet route; the per-packet pick is a table lookup.
+//
+// Determinism: array-only (no map iteration — ODN-10); insertion-order
+// tie-breaks (stable across targets); integer-only. The table is DERIVED from
+// the Topology (a pure function of it) — so it is NOT serialized into the T1
+// hash (the Topology IS serialized; hashing derived state would bind replay to
+// the table-build algorithm, which is an implementation detail).
+
+Routing_Table :: struct {
+	// flat [from_slot * n + dst_slot] arrays. 0 = no route (node ids are
+	// monotonic from 0, so 0 is never a live next-hop — wait: node id 0 IS
+	// live (the first spawned node). We disambiguate with a separate `ok`
+	// check via the pipe field: pipe ids start at 0 too. So instead, `n`
+	// itself bounds validity and an entry is "no route" when BOTH next==0 AND
+	// pipe==0 — but id 0 is a real node/pipe. We resolve this by storing
+	// entries slot-indexed and treating an unvisited (dst) as next==0/pipe==0
+	// ONLY when the BFS never reached it; since the first node/pipe IS id 0,
+	// we use a +1 offset on stored ids (0 = none, real id v stored as v+1).
+	next: [dynamic]u32, // next-hop NODE id + 1 (0 = no route); indexed [from*n + dst]
+	pipe: [dynamic]u32, // pipe id + 1 toward next hop (0 = no route)
+	n:    u32,          // node slot count the table was built for (== len(node_alive))
+}
+
+routing_make :: proc(r: ^Routing_Table, allocator := context.allocator) {
+	r^ = {}
+	r.next = make([dynamic]u32, 0, 16, allocator)
+	r.pipe = make([dynamic]u32, 0, 16, allocator)
+}
+
+routing_destroy :: proc(r: ^Routing_Table) {
+	delete(r.next)
+	delete(r.pipe)
+}
+
+// routing_rebuild — recompute every node's forwarding entries from the current
+// Topology via BFS (insertion-order tie-breaks). Called by step ONLY when the
+// topology changed (Topology.gen moved — 4-rule spine rule 1). Pure w.r.t. the
+// Topology: identical Topology -> identical table on every target (ODN-10).
+//
+// BFS first-hop propagation: when a node is visited, it inherits the first hop
+// of its BFS predecessor (the neighbor of the source that leads to it). The
+// source's direct neighbors ARE their own first hop. This yields, for every
+// (src, dst), the first edge on a shortest path — exactly what a packet needs
+// to forward one hop toward dst. Ties (equal hop count via different
+// predecessors) resolve to insertion order: the first pipe to reach a node
+// wins (visited-guard), so the table is stable across runs.
+routing_rebuild :: proc(r: ^Routing_Table, t: ^Topology, allocator := context.allocator) {
+	context.allocator = allocator
+	n := u32(len(t.node_alive))
+	need := int(n) * int(n)
+	if n == 0 {
+		clear(&r.next)
+		clear(&r.pipe)
+		r.n = 0
+		return
+	}
+	if len(r.next) != need {
+		resize(&r.next, need)
+		resize(&r.pipe, need)
+	}
+	r.n = n
+	// default: no route (0 — the +1 id scheme makes 0 unambiguously "none")
+	for i in 0..<need {
+		r.next[i] = 0
+		r.pipe[i] = 0
+	}
+
+	// BFS scratch (temp — rebuilds are rare: only on a topology-changing
+	// Command, so the per-rebuild temp churn is negligible).
+	visited := make([]bool, int(n), context.temp_allocator)
+	first_node := make([]u32, int(n), context.temp_allocator) // first-hop node id
+	first_pipe := make([]u32, int(n), context.temp_allocator) // first-hop pipe id
+	queue := make([]u32, int(n), context.temp_allocator)
+
+	for s in 0..<int(n) {
+		if !t.node_alive[s] {
+			continue
+		}
+		for i in 0..<int(n) {
+			visited[i] = false
+		}
+		visited[s] = true
+		head, tail := 0, 1
+		queue[0] = u32(s)
+		first_node[s] = 0 // self: no first hop
+		first_pipe[s] = 0
+		for head < tail {
+			cur := queue[head]
+			head += 1
+			cur_id := t.node_id[cur]
+			// neighbors of cur: scan pipes in insertion order (stable; O(P)
+			// per node — fine at 1.3 scale; an adjacency index is [LATER]).
+			for pi in 0..<len(t.pipe_alive) {
+				if !t.pipe_alive[pi] {
+					continue
+				}
+				neighbor_id, is_end := pipe_other(t, u32(pi), cur_id)
+				if !is_end {
+					continue
+				}
+				ns, ok := node_slot(t, neighbor_id)
+				if !ok || visited[ns] {
+					continue
+				}
+				visited[ns] = true
+				// propagate the first hop: the source's direct neighbor is its
+				// own first hop; deeper nodes inherit their predecessor's.
+				if cur == u32(s) {
+					first_node[ns] = neighbor_id
+					first_pipe[ns] = t.pipe_id[pi]
+				} else {
+					first_node[ns] = first_node[cur]
+					first_pipe[ns] = first_pipe[cur]
+				}
+				queue[tail] = u32(ns)
+				tail += 1
+			}
+		}
+		// store this source's row (slot-indexed; +1 so id 0 is a real value)
+		row := u32(s) * n
+		for d in 0..<int(n) {
+			if d == s || !visited[d] {
+				continue
+			}
+			idx := int(row) + d
+			r.next[idx] = first_node[d] + 1
+			r.pipe[idx] = first_pipe[d] + 1
+		}
+	}
+}
+
+// routing_next_hop — the per-hop decision: at `from_node`, which node + pipe
+// leads toward `dst_node`. ok=false if no route (the packet waits — 1.3's
+// trivial handling of E28; the SLA-undelivered accrual lands with SLA in slice
+// 3). This is THE per-hop lookup — no cached route is consulted, so a topology
+// change (table rebuild) is reflected the moment the packet reaches its next
+// junction (E29: automatic migration under per-hop forwarding).
+routing_next_hop :: proc(r: ^Routing_Table, t: ^Topology, from_node, dst_node: u32) -> (next: u32, pipe: u32, ok: bool) {
+	if r.n == 0 || u64(len(r.next)) != u64(r.n) * u64(r.n) {
+		return 0, 0, false // table not built / stale shape — no route
+	}
+	fs, oks := node_slot(t, from_node)
+	ds, okd := node_slot(t, dst_node)
+	if !oks || !okd {
+		return 0, 0, false
+	}
+	idx := int(fs) * int(r.n) + int(ds)
+	stored := r.next[idx]
+	if stored == 0 {
+		return 0, 0, false // unreachable from `from_node`
+	}
+	return stored - 1, r.pipe[idx] - 1, true // undo the +1 none-sentinel
+}
+
+// routing_has_path — true iff `from_node` can currently reach `dst_node` per
+// the (fresh) table. Used by spawn-time unroutable checks (E28 shape).
+routing_has_path :: proc(r: ^Routing_Table, t: ^Topology, from_node, dst_node: u32) -> bool {
+	_, _, ok := routing_next_hop(r, t, from_node, dst_node)
+	return ok
+}
