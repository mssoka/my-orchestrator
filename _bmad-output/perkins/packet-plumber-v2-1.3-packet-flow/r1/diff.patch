 	append(&t.pipe_b, c.b)
 	append(&t.pipe_tier, c.tier)
 	append(&t.pipe_span, span)
+	t.gen += 1
 	return id
 }
 
@@ -202,3 +206,29 @@ topology_apply_edit :: proc(t: ^Topology, cmd: Command, cat: ^Catalogs) -> (Edit
 draw_cost :: proc(span: i32, tier_idx: u16, cat: ^Catalogs) -> i32 {
 	return span * cat.pipe_tiers[tier_idx].cost_per_tile
 }
+
+// pipe_slot — pipe id -> slot, only for LIVE pipes (linear; core is map-free —
+// ODN-10). Used by the flow (the packet's current edge) + the render.
+pipe_slot :: proc(t: ^Topology, id: u32) -> (u32, bool) {
+	for i in 0 ..< len(t.pipe_alive) {
+		if t.pipe_alive[i] && t.pipe_id[i] == id {
+			return u32(i), true
+		}
+	}
+	return 0, false
+}
+
+// pipe_other — given a pipe slot + one endpoint node id, return the OTHER
+// endpoint (the neighbor). ok=false if `node_id` is not an endpoint of the pipe.
+// The adjacency primitive the forwarding-table BFS + the packet traversal use.
+pipe_other :: proc(t: ^Topology, pipe_slot: u32, node_id: u32) -> (other: u32, ok: bool) {
+	a := t.pipe_a[pipe_slot]
+	b := t.pipe_b[pipe_slot]
+	if a == node_id {
+		return b, true
+	}
+	if b == node_id {
+		return a, true
+	}
+	return 0, false
+}
