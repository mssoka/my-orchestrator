diff --git a/core/flow.odin b/core/flow.odin
new file mode 100644
index 0000000..be9ab96
--- /dev/null
+++ b/core/flow.odin
@@ -0,0 +1,195 @@
+package core
+
+// flow.odin — S2 Packet-Flow Simulation, trivial 1.3 form (architecture §6.2):
+// a packet spawns from a trivial hardcoded demand, advances by bandwidth-units
+// per tick along the drawn graph, and delivers at the sink. The forwarding is
+// PER-HOP (routing.odin): the packet carries NO cached route — at each node it
+// reaches it consults the fresh forwarding table for the next hop. This is the
+// locked routing model in its single-path form (no ECMP/bundles yet, no BFS
+// route cache, no LB — those are slice 2).
+//
+// 1.3 scope (per the story card): ONE packet, ONE path (source -> router ->
+// sink), spawned from a trivial hardcoded demand. No QoS lanes (slice 3), no
+// SLA (slice 3), no demand director / weighted picks (slice 3), no ECMP (slice
+// 2), no bundles (slice 2). The packet's in-flight state rides the T1 hash ->
+// replay-equality over the flow (E10). The flow-sim mechanics (progress vs
+// bandwidth-units, a cosmetic position along the current edge) are mined from
+// the prototype's flow.odin DESIGN; the prototype's BFS routing is NOT ported.
+//
+// Integer-only (ODN-10); arrays only (no map iteration — ODN-10); no file/clock
+// reads (ODN-1).
+
+// Packet — in-flight packet state. NO route[] field (per-hop forwarding). The
+// packet's location is either ON an edge (on_edge = true; `edge` is the pipe
+// being traversed, `heading` its far endpoint) or AT a node (on_edge = false;
+// `at_node` is where it sits, ready to forward). Node/pipe ids are 0-based, so
+// an explicit `on_edge` flag carries the on-edge/at-node distinction (0 is a
+// valid id, not a sentinel). progress_units accumulates the pipe's bandwidth
+// service; when it reaches the packet's bandwidth demand the packet arrives at
+// `heading` and (if not dst) forwards again from there next tick.
+Packet :: struct {
+	id:             u64,
+	src, dst:       u32, // node ids
+	on_edge:        bool, // true = traversing `edge` toward `heading`; false = resident at `at_node`
+	at_node:        u32, // the node the packet sits at (valid when !on_edge)
+	edge:           u32, // pipe id being traversed (valid when on_edge)
+	heading:        u32, // far-endpoint node id of `edge` (valid when on_edge)
+	progress_units: u32, // bandwidth units served on the current edge
+	spawn_tick:     u64,
+	delivered:      bool,
+}
+
+// Spawn_Req — a trivial hardcoded demand entry (1.3: run setup, like the
+// fixture; NOT part of the action log). The flow spawns a packet at `tick`
+// from `src` to `dst`. The pressure-plan director (weighted src/dst picks)
+// lands in slice 3; 1.3 carries one trivial entry.
+Spawn_Req :: struct {
+	tick: u64,
+	src:  u32,
+	dst:  u32,
+}
+
+Flow_State :: struct {
+	packets:        [dynamic]Packet,
+	demand:         [dynamic]Spawn_Req,
+	next_packet_id: u64,
+}
+
+flow_init :: proc(f: ^Flow_State, allocator := context.allocator) {
+	f^ = {}
+	f.packets = make([dynamic]Packet, 0, 16, allocator)
+	f.demand = make([dynamic]Spawn_Req, 0, 4, allocator)
+}
+
+flow_destroy :: proc(f: ^Flow_State) {
+	delete(f.packets)
+	delete(f.demand)
+}
+
+// flow_seed_demand — append a trivial demand entry (run setup; the harness
+// lowers a demo's spawn intents, the app hardcodes one). Re-created identically
+// on every replay (NOT in the action log — like the fixture + seed).
+flow_seed_demand :: proc(f: ^Flow_State, tick: u64, src, dst: u32) {
+	append(&f.demand, Spawn_Req{tick = tick, src = src, dst = dst})
+}
+
+// flow_step — the deterministic tick: spawn from demand, then advance every
+// in-flight packet one step of progress. PER-HOP forwarding: a packet AT a node
+// consults the routing table for its next hop (no cached route — E29). A packet
+// ON an edge consumes the pipe's capacity; when its bandwidth demand is met it
+// arrives at the far endpoint. Delivery at dst fires a Packet_Arrived event.
+//
+// One hop of progress per tick: a packet at a node forwards onto its next edge
+// (starts traversing) but does NOT also consume bandwidth that tick; a packet
+// on an edge consumes bandwidth and, on completion, arrives (forwards again
+// next tick). This keeps the motion readable (one edge-segment of progress per
+// tick) and the determinism coarse (the per-tick state delta is one step).
+flow_step :: proc(state: ^Run_State, tick: u64, cat: ^Catalogs) {
+	f := &state.flow
+	bandwidth := u32(cat.balance.packet_bandwidth)
+
+	// 1. SPAWN from this tick's demand. (1.3: trivial — one packet per req.)
+	for req in f.demand {
+		if req.tick != tick {
+			continue
+		}
+		f.next_packet_id += 1
+		append(&f.packets, Packet{
+			id = f.next_packet_id,
+			src = req.src,
+			dst = req.dst,
+			on_edge = false,
+			at_node = req.src, // resident at the source, ready to forward
+			spawn_tick = tick,
+		})
+	}
+
+	// 2. ADVANCE in-flight packets one step (per-hop). Iterate by index (we
+	// mutate fields; no array structural change in this loop — the cull is a
+	// separate compaction pass below).
+	for i in 0..<len(f.packets) {
+		p := &f.packets[i]
+		if p.delivered {
+			continue
+		}
+		if p.on_edge {
+			// ON AN EDGE — consume bandwidth toward `heading`.
+			ps, ok := pipe_slot(&state.topology, p.edge)
+			if !ok {
+				// The current pipe vanished mid-traversal (a demolish under the
+				// packet — slice 2.3's severance scenario). Under per-hop
+				// forwarding the packet re-forwards from the node it just left;
+				// 1.3 has no demolish so this is defensive. Drop back to the
+				// departure side of the lost edge + re-forward next tick.
+				p.on_edge = false
+				p.at_node = p.src
+				p.progress_units = 0
+				continue
+			}
+			cap := u32(cat.pipe_tiers[state.topology.pipe_tier[ps]].capacity_units)
+			advance_step := cap
+			if advance_step == 0 {
+				advance_step = 1 // defensive: a zero-capacity tier still creeps
+			}
+			p.progress_units += advance_step
+			if p.progress_units >= bandwidth {
+				// arrived at the far endpoint
+				p.at_node = p.heading
+				p.on_edge = false
+				p.progress_units = 0
+				if p.at_node == p.dst {
+					p.delivered = true
+					event_emit(state, tick, EVENT_TAG_PACKET_ARRIVED)
+				}
+			}
+		} else {
+			// AT A NODE — forward via the table (THE per-hop decision).
+			if p.at_node == p.dst {
+				// spawned at its own dst (degenerate); count as delivered
+				p.delivered = true
+				event_emit(state, tick, EVENT_TAG_PACKET_ARRIVED)
+				continue
+			}
+			next, pipe, ok := routing_next_hop(&state.routing, &state.topology, p.at_node, p.dst)
+			if !ok {
+				continue // no route yet (incomplete graph) — wait here; re-tries
+				         // next tick once a topology change rebuilds the table
+			}
+			p.on_edge = true
+			p.edge = pipe
+			p.heading = next
+			p.progress_units = 0
+		}
+	}
+
+	// 3. CULL delivered packets (insertion order preserved — determinism). The
+	// delivery itself is captured in the hash via the Packet_Arrived event
+	// (serialized in the tick's event stream); the in-flight set is what the
+	// hash carries forward.
+	survivors := make([dynamic]Packet, 0, len(f.packets), context.temp_allocator)
+	for p in f.packets {
+		if !p.delivered {
+			append(&survivors, p)
+		}
+	}
+	clear(&f.packets)
+	for p in survivors {
+		append(&f.packets, p)
+	}
+	delete(survivors)
+}
+
+// packet_progress_frac — the cosmetic along-edge fraction in Q8 (0..256) for
+// the render: 0 at the departure node, 256 at `heading`. Pure function of the
+// packet's edge state + the catalog bandwidth (the view reads this; ODN-1).
+// At-node packets return 0 (the render places them at `at_node`).
+packet_progress_frac :: proc(p: ^Packet, bandwidth: u32) -> u32 {
+	if !p.on_edge || bandwidth == 0 {
+		return 0
+	}
+	frac := (u64(p.progress_units) * 256 + u64(bandwidth)/2) / u64(bandwidth) // rounded
+	if frac > 256 {
+		frac = 256
+	}
+	return u32(frac)
+}
diff --git a/core/flow_test.odin b/core/flow_test.odin
new file mode 100644
index 0000000..01480ab
--- /dev/null
+++ b/core/flow_test.odin
@@ -0,0 +1,221 @@
+package core
+
+// flow_test.odin — the Story 1.3 contracts as durable tests (arch §11.7): the
+// per-hop forwarding model (no cached route), the forwarding-table rebuild on
+// topology change (4-rule spine rule 1 — the story's named Golden), the E29
+// no-stale-route property, replay-equality over the flow (E10), and the trivial
+// unroutable-waits handling. Pinned at the lowest layer so they survive review
+// rounds, refactors, and Perkins.
+//
+// Scope note (surfaced in the PR): the FULL E29 — a demolish that severs the
+// path mid-traversal + a re-forward at the next junction — needs the demolish
+// command, which is Story 2.3. 1.3 delivers the MODEL that makes E29 automatic
+// (no cached route -> a topology change propagates via a table rebuild at the
+// next sync); these tests pin that model. The Packet struct has NO route field
+// by construction — the per-hop decision is structural, not a convention.
+
+import "core:testing"
+
+// flow_setup — a fresh run with the 1.2 fixture seeded (res/rt/host). The
+// caller draws pipes + seeds demand for the scenario.
+flow_setup :: proc(cat: ^Catalogs) -> (Run_State, u32, u32, u32) {
+	s: Run_State
+	run_init(&s, 1, cat.hash, TEST_LOGIC_HZ)
+	res, rt, host := test_seed_fixture(&s, cat)
+	return s, res, rt, host
+}
+
+// step_n — step `n` more ticks starting from the run's current tick (continues
+// a run; does NOT restart at tick 1 — a second call picks up where the first
+// left off, so a demand entry at tick 1 is not re-spawned). Applies logged
+// commands per the replay convention (apply all log entries for tick N before
+// stepping N). Mirrors record_run without the per-tick hashing.
+step_n :: proc(s: ^Run_State, n: u64, cat: ^Catalogs) {
+	start := s.tick + 1
+	for tick in start ..< start + n {
+		batch := make([dynamic]Command, 0, 4, context.temp_allocator)
+		for cmd in s.action_log {
+			if cmd.apply_tick == tick {
+				append(&batch, cmd)
+			}
+		}
+		step(s, tick, batch[:], cat)
+		free_all(context.temp_allocator)
+	}
+}
+
+// draw — log a Draw_Pipe command at apply_tick (applied by step_n at that tick).
+draw :: proc(s: ^Run_State, apply_tick: u64, a, b: u32, tier_idx: u16) {
+	append(&s.action_log, Command{apply_tick = apply_tick, kind = Cmd_Draw_Pipe{a = a, b = b, tier = tier_idx}})
+}
+
+count_arrived :: proc(s: ^Run_State) -> int {
+	n := 0
+	for e in s.events {
+		if e.tag == EVENT_TAG_PACKET_ARRIVED {
+			n += 1
+		}
+	}
+	return n
+}
+
+@(test)
+test_per_hop_forwarding_source_to_sink :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, host := flow_setup(cat)
+	defer run_destroy(&s)
