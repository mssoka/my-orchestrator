+// draw_packets — the packet dots (1.3 render pass 5). Each in-flight packet
+// is drawn at a lerped position: on-edge packets sit `progress` of the way
+// along their current pipe (departure node -> heading); at-node packets sit on
+// the node. Pure read of the flow snapshot + topology (ODN-1). The along-edge
+// fraction IS the lerp the story spec calls for ("lerped positions between
+// snapshots" — between the pipe's two endpoint nodes).
+draw_packets :: proc(v: ^View, topo: ^pp.Topology, flow: ^pp.Flow_State) {
+	bandwidth := u32(v.catalogs.balance.packet_bandwidth)
+	for i in 0..<len(flow.packets) {
+		p := &flow.packets[i]
+		if p.delivered {
+			continue
+		}
+		pos: rl.Vector2
+		if p.on_edge {
+			ps, ok := pp.pipe_slot(topo, p.edge)
+			if !ok {
+				continue
+			}
+			a_id := topo.pipe_a[ps]
+			b_id := topo.pipe_b[ps]
+			// departure = the endpoint that ISN'T `heading`; arrive = heading
