+// Session_Cfg — a demo's win/lose run setup (1.4): the deliver-N goal + the
+// tick-cap lose time. Run setup (like the fixture + the spawn demand) — NOT in
+// the action log; re-created identically on every replay. Threaded through both
+// run_demo (live) + replay_hashes (replay) so a win/lose loop is replay-
+// determinate (the determinism field-note: new run-setup threads through BOTH
+// paths, or ODN-11 replay diverges at the terminal tick).
+Session_Cfg :: struct {
+	goal:   u32,
+	cap_ms: i64,
+}
+
+// apply_session — seed a run's win/lose config (run setup). goal 0 = win/lose
+// disabled (back-compat: boot/draw/flow never terminate). cap_ms -> tick_cap via
+// the same floor(ms*hz/1000) the spawn/run timers use.
+apply_session :: proc(state: ^pp.Run_State, cfg: Session_Cfg, hz: i32) {
+	state.goal = cfg.goal
+	state.tick_cap = u64(max(0, cfg.cap_ms * i64(hz) / 1000))
+}
+
+// load_demo_session — re-parse a demo + return its win/lose cfg. Mirrors
+// load_demo_spawns so the standalone replay paths (run_replay, drift-check)
+// re-create the session identically without holding the whole Demo struct.
+load_demo_session :: proc(demo_name: string) -> Session_Cfg {
+	cfg := Session_Cfg{}
+	path := fmt.tprintf("demos/%s.dem", demo_name)
+	text_bytes, err := os.read_entire_file_from_path(path, context.temp_allocator)
+	if err != nil {
+		return cfg
+	}
+	demo, _ := parse_demo(demo_name, string(text_bytes))
+	cfg.goal = demo.win_goal
+	cfg.cap_ms = demo.lose_cap_ms
+	delete(demo.draws)
+	delete(demo.spawns)
+	delete(demo.captures)
+	return cfg
+}
