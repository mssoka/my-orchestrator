diff --git a/core/win_lose.odin b/core/win_lose.odin
new file mode 100644
index 0000000..ddc3d38
--- /dev/null
+++ b/core/win_lose.odin
@@ -0,0 +1,59 @@
+package core
+
+// win_lose.odin — S6 win/lose gate, STUB form (Story 1.4 / architecture §6.5,
+// ODN-13/14, E17). The thinnest end-to-end feedback loop: a packet delivered
+// scores; the tick cap reached with score < goal ends the run (Error 404 stub).
+// Full win/lose depth (SLA meter, surge, Network Health S5) is slice 4; 1.4 is
+// just the loop skeleton the real gate grows onto.
+//
+// This is a sim-side concern, evaluated AFTER flow_step inside core.step (the
+// architecture's spine data-flow: ... Packet_Flow → [crisis/health LATER] →
+// win_lose_eval → snapshot). It appends exactly ONE terminal event per run
+// (Run_Won or Run_Lost) and latches `state.terminal`; the step's top-of-step
+// barrier then freezes the run (E17 — "nothing after Run_Lost; one terminal
+// event per run, by construction"). The app reads `state.outcome` to drive the
+// Game_Over screen; the harness hashes `outcome`/`terminal`/`score` so the
+// terminal frame is replay-determinate.
+//
+// Each terminal condition is gated INDEPENDENTLY: goal == 0 means "no win
+// condition"; tick_cap == 0 means "no cap". BOTH zero (the run_init default)
+// leaves win/lose fully disabled — a run with neither set never goes terminal,
+// which keeps the 1.1–1.3 demos (boot/draw/flow) bit-for-bit unchanged in
+// BEHAVIOR (they still never terminate); only their T1 hash bytes shift
+// (serialize.odin now carries the zeroed win/lose fields), so their goldens are
+// re-blessed, not re-authored.
+//
+// Integer-only (ODN-10); no file/clock reads (ODN-1); no maps (ODN-10).
+
+// win_lose_eval — the per-tick terminal check (called at the end of core.step,
+// after flow_step). Emits Run_Won when the goal is reached; Run_Lost when the
+// tick cap is reached. Win is checked before lose, so a tie tick (goal met AND
+// cap hit the same tick) is a WIN — never a double-emit. Idempotent via the
+// caller's terminal guard: this is only reached while !state.terminal (the step
+// barrier), so the latches below fire at most once per run (E17 — one terminal
+// event, by construction).
+win_lose_eval :: proc(state: ^Run_State, tick: u64) {
+	if state.terminal {
+		return // barrier (caller-guarded): the run is frozen
+	}
+
+	// WIN: the goal was reached (score crossed it this tick — the barrier means
+	// we evaluate every tick until terminal, so this fires the tick it crosses).
+	// goal == 0 = "no win condition" (a cap-only survival scenario, or disabled).
+	if state.goal != 0 && state.score >= state.goal {
+		event_emit(state, tick, EVENT_TAG_RUN_WON)
+		state.terminal = true
+		state.outcome = .Won
+		return
+	}
+
+	// LOSE: the tick cap was reached with score short of the goal. tick_cap == 0
+	// = "no cap" (a goal-only scenario, or disabled). Win was checked first, so a
+	// tie tick never double-emits.
+	if state.tick_cap != 0 && tick >= state.tick_cap {
+		event_emit(state, tick, EVENT_TAG_RUN_LOST)
+		state.terminal = true
+		state.outcome = .Lost
+		return
+	}
+}
