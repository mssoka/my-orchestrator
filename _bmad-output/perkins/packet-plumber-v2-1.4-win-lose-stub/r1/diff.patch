+++ b/core/win_lose_test.odin
@@ -0,0 +1,248 @@
+package core
+
+// win_lose_test.odin — the Story 1.4 contracts as durable tests (arch §6.5,
+// ODN-13/14, E17). Pins:
+//   (a) WIN: a delivered packet scores; score >= goal -> exactly one Run_Won
+//       (outcome=Won, terminal latched), no Run_Lost;
+//   (b) LOSE: the tick cap hit with score < goal -> exactly one Run_Lost
+//       (outcome=Lost), no Run_Won (the Error 404 stub);
+//   (c) the terminal-event barrier (E17): exactly ONE terminal event per run —
+//       post-terminal steps emit nothing + freeze the state;
+//   (d) win beats lose on a tie tick (no double-emit);
+//   (e) goal == 0 DISABLES win/lose (back-compat: boot/draw/flow never
+//       terminate — their behavior is unchanged, only their hash bytes shift);
+//   (f) replay-equality over a full WIN loop INCLUDING the terminal frame (E10).
+//
+// Reuses flow_setup / step_n / draw from flow_test.odin (same package). The
+// self-review lens (bmad-review-edge-case-hunter) targets (c) the barrier +
+// (f) determinism over the loop — both pinned here at the lowest layer.
+
+import "core:testing"
+
+// count_tag — count emitted events with a given tag (state.events is NOT cleared
+// by step_n, so this reads the full run's event stream after stepping).
+count_tag :: proc(s: ^Run_State, tag: u8) -> int {
+	n := 0
+	for e in s.events {
+		if e.tag == tag {
+			n += 1
+		}
+	}
+	return n
+}
+
+@(test)
+test_win_on_goal_reached :: proc(t: ^testing.T) {
+	// WIN: draw source->router->sink, spawn, goal=1. The packet delivers (score
+	// 1) -> Run_Won. Exactly one terminal event; outcome Won; no Run_Lost.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, host := flow_setup(cat)
+	defer run_destroy(&s)
+	std, _ := pipe_tier_index(cat, "standard")
+	draw(&s, 1, res, rt, std)
+	draw(&s, 1, rt, host, std)
+	flow_seed_demand(&s.flow, 1, res, host)
+	s.goal = 1
+	s.tick_cap = 100 // loose cap: the win fires long before it
+	step_n(&s, 10, cat)
+
+	testing.expectf(t, s.score == 1, "one packet delivered -> score 1, got %d", s.score)
+	testing.expectf(t, count_tag(&s, EVENT_TAG_PACKET_ARRIVED) == 1,
+		"one Packet_Arrived, got %d", count_tag(&s, EVENT_TAG_PACKET_ARRIVED))
+	testing.expectf(t, count_tag(&s, EVENT_TAG_RUN_WON) == 1,
+		"exactly one Run_Won, got %d", count_tag(&s, EVENT_TAG_RUN_WON))
+	testing.expectf(t, count_tag(&s, EVENT_TAG_RUN_LOST) == 0,
+		"no Run_Lost on a win, got %d", count_tag(&s, EVENT_TAG_RUN_LOST))
+	testing.expect(t, s.terminal, "the run must latch terminal on a win")
+	testing.expectf(t, s.outcome == .Won, "outcome must be Won, got %v", s.outcome)
+}
+
+@(test)
+test_lose_on_tick_cap :: proc(t: ^testing.T) {
+	// LOSE: draw only source->router (the path is incomplete), spawn, goal=1,
+	// tick_cap short. The packet reaches the router + gets stuck (no route to
+	// the sink); at the cap, score(0) < goal(1) -> Run_Lost (the Error 404 stub).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, host := flow_setup(cat)
+	defer run_destroy(&s)
+	std, _ := pipe_tier_index(cat, "standard")
+	draw(&s, 1, res, rt, std) // only the first leg — the sink is unreachable
+	flow_seed_demand(&s.flow, 1, res, host)
+	s.goal = 1
+	s.tick_cap = 5 // the packet is still stuck at the router at tick 5
+	step_n(&s, 8, cat)
+
+	testing.expectf(t, s.score == 0, "no delivery on an incomplete graph -> score 0, got %d", s.score)
+	testing.expectf(t, count_tag(&s, EVENT_TAG_RUN_LOST) == 1,
+		"exactly one Run_Lost at the cap, got %d", count_tag(&s, EVENT_TAG_RUN_LOST))
+	testing.expectf(t, count_tag(&s, EVENT_TAG_RUN_WON) == 0,
+		"no Run_Won on a lose, got %d", count_tag(&s, EVENT_TAG_RUN_WON))
+	testing.expect(t, s.terminal, "the run must latch terminal on a lose")
+	testing.expectf(t, s.outcome == .Lost, "outcome must be Lost, got %v", s.outcome)
+}
+
+@(test)
+test_terminal_barrier_one_event_per_run :: proc(t: ^testing.T) {
+	// E17 — the named self-review lens: exactly ONE terminal event per run. A
+	// winning run is stepped WELL past its terminal tick; the barrier must (a)
+	// emit no further terminal events, (b) freeze the score/outcome, (c) leave
+	// state.tick at the terminal tick (the run ended there). A missing barrier
+	// would re-evaluate every tick and either double-emit or re-latch.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, host := flow_setup(cat)
+	defer run_destroy(&s)
+	std, _ := pipe_tier_index(cat, "standard")
+	draw(&s, 1, res, rt, std)
+	draw(&s, 1, rt, host, std)
+	flow_seed_demand(&s.flow, 1, res, host)
+	s.goal = 1
+	s.tick_cap = 100
+	step_n(&s, 6, cat) // the win lands at tick 6 (delivery + Run_Won)
+	won_tick := s.tick
+	won_score := s.score
+	testing.expectf(t, count_tag(&s, EVENT_TAG_RUN_WON) == 1,
+		"one Run_Won at the terminal tick, got %d", count_tag(&s, EVENT_TAG_RUN_WON))
+	// step well past the terminal tick — the barrier must hold
+	step_n(&s, 50, cat)
+	testing.expectf(t, count_tag(&s, EVENT_TAG_RUN_WON) == 1,
+		"STILL one Run_Won after 50 post-terminal ticks (barrier), got %d",
+		count_tag(&s, EVENT_TAG_RUN_WON))
+	testing.expectf(t, count_tag(&s, EVENT_TAG_RUN_LOST) == 0,
+		"no Run_Lost ever on a won run (barrier), got %d", count_tag(&s, EVENT_TAG_RUN_LOST))
+	testing.expectf(t, s.score == won_score,
+		"score frozen post-terminal: %d vs %d", s.score, won_score)
+	testing.expectf(t, s.tick == won_tick,
+		"state.tick frozen at the terminal tick: %d vs %d", s.tick, won_tick)
+}
+
+@(test)
+test_win_beats_lose_on_same_tick :: proc(t: ^testing.T) {
+	// No double-emit + precedence: with goal=1 and tick_cap set to the EXACT
+	// delivery tick, both conditions are true that tick. Win is checked first ->
+	// Run_Won fires, Run_Lost never does (one terminal event).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, host := flow_setup(cat)
+	defer run_destroy(&s)
+	std, _ := pipe_tier_index(cat, "standard")
+	draw(&s, 1, res, rt, std)
+	draw(&s, 1, rt, host, std)
+	flow_seed_demand(&s.flow, 1, res, host)
+	s.goal = 1
+	s.tick_cap = 6 // the delivery tick — cap + win coincide
+	step_n(&s, 8, cat)
+	testing.expectf(t, count_tag(&s, EVENT_TAG_RUN_WON) == 1,
+		"win fires on the tie tick, got %d", count_tag(&s, EVENT_TAG_RUN_WON))
+	testing.expectf(t, count_tag(&s, EVENT_TAG_RUN_LOST) == 0,
+		"lose does NOT also fire on the tie tick, got %d", count_tag(&s, EVENT_TAG_RUN_LOST))
+	testing.expectf(t, s.outcome == .Won, "outcome Won on a tie, got %v", s.outcome)
+}
+
+@(test)
+test_goal_zero_disables_win_lose :: proc(t: ^testing.T) {
+	// Back-compat (the boot/draw/flow contract): a run with goal == 0 AND
+	// tick_cap == 0 (both run_init defaults) never goes terminal, even with
+	// deliveries. This is why the 1.1-1.3 demos keep their BEHAVIOR (never
+	// terminate); only their T1 hash bytes shift (serialize.odin now carries the
+	// zeroed win/lose fields).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, host := flow_setup(cat)
+	defer run_destroy(&s)
+	std, _ := pipe_tier_index(cat, "standard")
+	draw(&s, 1, res, rt, std)
+	draw(&s, 1, rt, host, std)
+	flow_seed_demand(&s.flow, 1, res, host)
+	// goal + tick_cap left at their run_init zero defaults (win/lose disabled)
+	step_n(&s, 20, cat)
+	testing.expectf(t, s.score == 1, "the packet still delivers (score 1), got %d", s.score)
+	testing.expect(t, !s.terminal, "a goal-0/cap-0 run must NEVER go terminal")
+	testing.expectf(t, s.outcome == .None, "outcome stays None, got %v", s.outcome)
+	testing.expectf(t, count_tag(&s, EVENT_TAG_RUN_WON) == 0 && count_tag(&s, EVENT_TAG_RUN_LOST) == 0,
+		"no terminal events on a disabled run")
+}
+
+@(test)
+test_cap_only_lose_with_no_goal :: proc(t: ^testing.T) {
+	// The independent-gating contract: goal == 0 disables WIN only — a set cap
+	// still loses (a cap-only survival scenario). goal == 0 does NOT silently kill
+	// the lose condition. (Guards the win_lose_eval refinement against regressing
+	// to a goal==0 early-return that over-disables.)
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, host := flow_setup(cat)
+	defer run_destroy(&s)
+	std, _ := pipe_tier_index(cat, "standard")
+	draw(&s, 1, res, rt, std) // incomplete graph — no delivery possible
+	flow_seed_demand(&s.flow, 1, res, host)
+	// goal left at 0 (no win); tick_cap set -> lose-only
+	s.tick_cap = 5
+	step_n(&s, 8, cat)
+	testing.expectf(t, s.score == 0, "no delivery, got %d", s.score)
+	testing.expectf(t, count_tag(&s, EVENT_TAG_RUN_LOST) == 1,
+		"cap-only lose fires at the cap, got %d", count_tag(&s, EVENT_TAG_RUN_LOST))
+	testing.expectf(t, count_tag(&s, EVENT_TAG_RUN_WON) == 0,
+		"no Run_Won (goal disabled), got %d", count_tag(&s, EVENT_TAG_RUN_WON))
+	testing.expectf(t, s.outcome == .Lost, "outcome Lost, got %v", s.outcome)
+}
+
+@(test)
+test_win_loop_replay_byte_identical :: proc(t: ^testing.T) {
+	// E10 over the full WIN loop INCLUDING the terminal frame: re-step (seed,
+	// action_log, demand, goal, tick_cap) twice -> byte-identical hash sequence.
+	// The terminal tick's hash carries outcome/terminal/score + the Run_Won
+	// event; the post-terminal frozen ticks must also match. The goal + tick_cap
+	// are run-setup (re-created identically in both paths — the determinism
+	// field-note: new run-setup threads through live AND replay).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	live: Run_State
+	defer run_destroy(&live)
+	run_init(&live, 7, cat.hash, TEST_LOGIC_HZ)
+	res, rt, host := test_seed_fixture(&live, cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	draw(&live, 1, res, rt, std)
+	draw(&live, 1, rt, host, std)
+	flow_seed_demand(&live.flow, 1, res, host)
+	live.goal = 1
+	live.tick_cap = 100
+	live_hashes := record_run(&live, 15, cat)
+	defer delete(live_hashes)
+	testing.expect(t, live.terminal, "live run must reach terminal within 15 ticks")
+	testing.expectf(t, live.outcome == .Won, "live run wins, got %v", live.outcome)
+
+	// replay: fresh run, same seed, SAME action log + SAME demand + SAME goal/cap
+	replayed: Run_State
+	defer run_destroy(&replayed)
+	run_init(&replayed, 7, cat.hash, TEST_LOGIC_HZ)
+	test_seed_fixture(&replayed, cat)
+	delete(replayed.action_log)
+	replayed.action_log = clone_log(live.action_log)
+	flow_seed_demand(&replayed.flow, 1, res, host) // identical demand (run setup)
+	replayed.goal = 1                              // identical win config (run setup)
+	replayed.tick_cap = 100                        // identical cap (run setup)
+	replay_hashes := record_run(&replayed, 15, cat)
+	defer delete(replay_hashes)
+	testing.expect(t, !live.replay_error && !replayed.replay_error, "neither run latches replay_error")
+	testing.expectf(t, len(live_hashes) == len(replay_hashes),
+		"tick count mismatch: live %d vs replay %d", len(live_hashes), len(replay_hashes))
+	diverged := false
+	for i in 0..<len(live_hashes) {
+		if live_hashes[i] != replay_hashes[i] {
+			diverged = true
+		}
+	}
+	testing.expectf(t, !diverged,
+		"REPLAY DIVERGENCE over the win loop (incl. the terminal frame)")
+}
