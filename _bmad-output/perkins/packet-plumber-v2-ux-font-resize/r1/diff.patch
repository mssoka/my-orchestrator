 	catalogs: ^pp.Catalogs,
+	// 2026-08-15 (v2-ux-font-resize, user report): the HUD font — the bundled
+	// Open Sans Regular (assets/fonts, OFL 1.1), loaded ONCE at init by the app
+	// AND the harness (same file + same raylib path = the same atlas in both,
+	// so T2 goldens stay bit-exact on every platform). The raylib DEFAULT
+	// bitmap font was illegible at HUD sizes on the light canvas. draw_text_c
+	// draws with this font; a nil/invalid font falls back inside load_hud_font.
+	font:     rl.Font,
 	win_w:    i32,
 	win_h:    i32,
 	scale:    f32,
@@ -417,13 +424,37 @@ draw_building :: proc(v: ^View, id: u32, role: pp.Terminal_Role, c: rl.Vector2)
 // draw_text_c — the render package's small DrawText helper (the app's
 // main.odin has its own; the harness capture uses this one). The render
 // package must not depend on the app package, so the helper lives here.
+// 2026-08-15 (v2-ux-font-resize): draws with the bundled HUD font via
+// DrawTextEx (spacing 1 — the same spacing raylib's DrawText used, so only
+// the glyph METRICS change, never the spacing semantics).
 draw_text_c :: proc(v: ^View, txt: string, x, y, size: i32, col: rl.Color) {
 	cbuf := make([dynamic]u8, 0, len(txt)+1, context.temp_allocator)
 	for ch in txt {
 		append(&cbuf, u8(ch))
 	}
 	append(&cbuf, 0)
-	rl.DrawText(cstring(raw_data(cbuf)), x, y, size, col)
+	rl.DrawTextEx(v.font, cstring(raw_data(cbuf)), {f32(x), f32(y)}, f32(size), 1, col)
+}
+
+// FONT_ASSET — the bundled HUD font (SIL OFL 1.1, license at
+// assets/fonts/OFL.txt). Loaded at app/harness init from the repo root cwd
+// (both run from the root); committed, so the load never depends on a system
+// font — the atlas is byte-deterministic across platforms (the T2 spine).
+FONT_ASSET :: "assets/fonts/open_sans_regular.ttf"
+FONT_BASE_SIZE :: 64 // the atlas size — downscaled to HUD sizes (14-22px)
+
+// load_hud_font — load the bundled Open Sans Regular at FONT_BASE_SIZE with
+// bilinear filtering (smooth at HUD sizes; the prototype's font story used
+// the same LoadFontEx(…, 64, …) + BILINEAR recipe). Fallback: the raylib
+// default font (belt+braces — the asset is committed, so the fallback is
+// unreachable in practice; the prototype kept the same guard).
+load_hud_font :: proc() -> rl.Font {
+	f := rl.LoadFontEx(FONT_ASSET, FONT_BASE_SIZE, nil, 0)
+	if rl.IsFontValid(f) {
+		rl.SetTextureFilter(f.texture, .BILINEAR)
+		return f
+	}
+	return rl.GetFontDefault()
 }
 
