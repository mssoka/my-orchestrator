@@ -0,0 +1,228 @@
+package main
+
+// font_check.odin — the font-overhaul A/B gallery capture verb
+// (2026-08-22, packet-plumber-v2-font-overhaul). PP_DEBUG builds only (the
+// whole file is compile-gated — a plain harness build carries no font-check
+// code, so goldens cannot shift).
+//
+// `font-check <demo> <ms> <font.ttf> <tag>` renders a REAL demo frame (the
+// same shipped draw code the overlay-check verb uses: world + forecast +
+// health + crisis banner + debug overlay) with the candidate font swapped
+// into the render view, and exports:
+//   bin/font-<tag>-<demo>-<ms>.png   the full UI frame at the capture ms
+//   bin/font-<tag>-specimen.png      the specimen canvas (header/body/digit/
+//                                    warning-glyph rows at the game's sizes)
+// plus a stdout verdict line per test codepoint (glyph box + advance — the
+// mechanical ⚠-coverage probe; the raylib default font lacked U+26A0, the
+// exact regression the briefing names).
+//
+// View-layer only: the sim/replay never sees a byte (the candidate font is
+// swapped AFTER the replay — T1 + replay byte-identical by construction; the
+// frame pixels are the only thing that moves). Artifacts land in bin/
+// (gitignored — verification artifacts, never committed).
+
+import "core:c"
+import "core:fmt"
+import "core:os"
+import "core:strings"
+import "core:unicode/utf8"
+import pp "../core"
+import rnd "../app/render"
+import rl "vendor:raylib"
+
+when #config(PP_DEBUG, false) {
+
+// build_probe_set — the probe codepoints: the render package's canonical set
+// (font_codepoints — the SAME list the shipped atlas loads; one source, no
+// re-implementation). Returns the count written into dst.
+build_probe_set :: proc(dst: ^[96]rune) -> int {
+	cps := rnd.font_codepoints()
+	for i in 0..<len(cps) {
+		dst[i] = cps[i]
+	}
+	return len(cps)
+}
+
+// glyph_probe — load <font.ttf> at <size> for the probe codepoints and report
+// per-codepoint whether the font carries a REAL glyph (stbtt box != 0) and
+// its advance. The raylib-default regression the briefing names is a zero
+// box + zero advance for U+26A0 — the mechanical ⚠-coverage verdict.
+glyph_probe :: proc(font_path: string, size: i32) {
+	cps: [96]rune
+	n := build_probe_set(&cps)
+	f := rl.LoadFontEx(strings.clone_to_cstring(font_path, context.temp_allocator), size,
+		&cps[0], c.int(n))
+	if !rl.IsFontValid(f) {
+		fmt.printfln("font-check: probe: cannot load %s", font_path)
+		return
+	}
+	defer rl.UnloadFont(f)
+	for i in 0..<n {
+		cp := cps[i]
+		// W2: the glyph array is COMPACTED (raylib skips missing codepoints) —
+		// look up by VALUE, never by index position (an index over-read for a
+		// font lacking ⚠ would print garbage from unchecked memory).
+		g := rl.GlyphInfo{}
+		for j in 0..<int(f.glyphCount) {
+			if f.glyphs[j].value == cp {
+				g = f.glyphs[j]
+				break
+			}
+		}
+		present := g.advanceX > 0 || (g.image.width > 0 && g.image.height > 0)
+		ch := "?"
+		if cp >= 32 && cp <= 126 {
+			ch = utf8.runes_to_string([]rune{cp}, context.temp_allocator)
+		} else if cp == 0x26A0 {
+			ch = "U+26A0 (WARNING SIGN)"
+		}
+		fmt.printfln("font-check: probe %s @%dpx: present=%v box=%dx%d advance=%d",
+			ch, size, present, g.image.width, g.image.height, g.advanceX)
+	}
+}
+
+// draw_specimen — the specimen canvas (the game's actual text at the game's
+// sizes on the game's canvas, one canvas per candidate): the 24px title
+// header, the 32px win/lose toast, the 16px crisis-banner title line, the
+// 15px body line, the 14px small labels, a tabular-digits block (16px), the
+// NOC-style dense line (15px), and the ⚠ warning row (14px + 22px). Drawn
+// with `warn_font` (the candidate loaded WITH U+26A0 requested — a candidate
+// that lacks the glyph shows its .notdef/blank, the honest picture).
+draw_specimen :: proc(rc: ^Render_Ctx, warn_font: rl.Font) {
+	p := rc.palette
+	rl.ClearBackground(p.canvas)
+	// draw_row copies the string's raw UTF-8 BYTES (the shipped draw_text_font
+	// does the same since the 08-22 overhaul; the specimen's ⚠ rows need the
+	// real UTF-8 encoding to reach the atlas).
+	draw_row :: proc(f: rl.Font, txt: string, y: i32, size: i32, col: rl.Color) {
+		cbuf := make([dynamic]u8, 0, len(txt)+1, context.temp_allocator)
+		for b in transmute([]u8)(txt) {
+			append(&cbuf, b)
+		}
+		append(&cbuf, 0)
+		rl.DrawTextEx(f, cstring(raw_data(cbuf)), {f32(24), f32(y)}, f32(size), 1, col)
+	}
+	warn_sign := "\xe2\x9a\xa0" // U+26A0 as raw UTF-8 bytes (Odin has no rune→string cast)
+	y: i32 = 16
+	draw_row(warn_font, "Packet Plumber - v2", y, 24, p.ink) // the 24px title header (08-23 ladder)
+	y += 36
+	draw_row(warn_font, "SURGE SURVIVED - YOU WIN", y, 32, rl.Color{44, 134, 66, 255}) // the 32px win toast
+	y += 44
+	draw_row(warn_font, "!!  SURGE: S2 ACTIVE - bundle 3 (pipe 7)", y, 16, rnd.state_critical_text(p)) // the 16px crisis title
+	y += 26
+	draw_row(warn_font, "Add capacity before the countdown ends.", y, 15, p.ink) // the 15px redesign line
+	y += 25
+	draw_row(warn_font, "draw pipes; P / Space pauses; U previews upgrade", y, 15, p.ink_soft) // the 15px hint
+	y += 23
+	draw_row(warn_font, "delivered 12 / 20   avg 0.9 s   loss 0%", y, 17, p.ink_soft) // the 17px SLA line (N1: matches the shipped ladder)
+	y += 26
+	// the tabular-digits block (the NOC panel's steady columns: a 5-digit
+	// counter that must not jitter).
+	draw_row(warn_font, "0123456789", y, 16, p.ink)
+	y += 24
+	draw_row(warn_font, "11111 22222 33333 44444", y, 16, p.ink)
+	y += 24
+	draw_row(warn_font, "E9 lane-shed 0042 | pool 512/512 | 100%", y, 15, p.ink) // the dense NOC-style line (15px, shipped)
+	y += 26
+	// the ⚠ rows (the raylib-default regression the briefing names: the
+	// default font had NO U+26A0 — a candidate without the glyph draws
+	// blank/.notdef here; the glyph_probe verdict line names it mechanically).
+	draw_row(warn_font, fmt.aprintf("WARNING SIGN: %s", warn_sign, allocator = context.temp_allocator), y, 14, p.state_critical)
+	y += 24
+	draw_row(warn_font, fmt.aprintf("!!  %s  SURGE ACTIVE", warn_sign, allocator = context.temp_allocator), y, 22, rnd.state_critical_text(p))
+}
+
+// font_check — play <demo> up to <ms> with the candidate font in the view,
+// capture the full UI frame + the specimen canvas. Returns 0 on success.
+font_check :: proc(demo: string, cap_ms: i64, font_path: string, tag: string, cat: ^pp.Catalogs, rc: ^Render_Ctx) -> i32 {
+	// 1. load the candidate at the app's atlas size (the same recipe as
+	// the shipped load_font_file — a failed load is FATAL, never a silent
+	// fallback-font specimen). `warn_font` is the same family loaded WITH
+	// the probe set
+	// (ASCII + U+26A0) — the specimen's ⚠ rows draw through it.
+	cps: [96]rune
+	n := build_probe_set(&cps)
+	f := rl.LoadFontEx(strings.clone_to_cstring(font_path, context.temp_allocator), rnd.FONT_BASE_SIZE, nil, 0)
+	if !rl.IsFontValid(f) {
+		fmt.eprintfln("font-check: cannot load %s", font_path)
+		return 1
+	}
+	rl.SetTextureFilter(f.texture, .BILINEAR)
+	defer rl.UnloadFont(f)
+	warn_font := rl.LoadFontEx(strings.clone_to_cstring(font_path, context.temp_allocator), rnd.FONT_BASE_SIZE,
+		&cps[0], c.int(n))
+	if !rl.IsFontValid(warn_font) {
+		fmt.eprintfln("font-check: cannot load probe atlas for %s", font_path)
+		return 1
+	}
+	rl.SetTextureFilter(warn_font.texture, .BILINEAR)
+	defer rl.UnloadFont(warn_font)
+	old_font := rc.view.font
+	rc.view.font = f
+	defer rc.view.font = old_font
+
+	// 2. the mechanical ⚠-coverage probe (this candidate + the baseline).
+	glyph_probe(font_path, rnd.FONT_BASE_SIZE)
+	glyph_probe(rnd.FONT_ASSET, rnd.FONT_BASE_SIZE) // W3: the comparison baseline = the committed shipped font (open_sans was deleted by this diff)
+
+	// 3. replay the demo to the capture ms (the SHARED setup + driver — the
+	// same sim path the overlay verbs use; the font swap never touches it).
+	state, d, cfg, err := demo_replay_setup(demo, cat)
+	if err != "" {
+		fmt.eprintfln("font-check: %s", err)
+		return 1
+	}
+	defer demo_destroy(&d)
+	defer pp.run_destroy(&state)
+	defer { delete(cfg.nodes); delete(cfg.spawns); delete(cfg.pauses) }
+	sim_tick, stats, stats_valid := run_demo_to_ms(&state, &d, &cfg, cat, cap_ms)
+	if !stats_valid {
+		fmt.eprintfln("font-check: %s: no stepped tick before %dms — nothing to capture", demo, cap_ms)
+		return 1
+	}
+	defer pp.stats_destroy(&stats)
+
+	// 4. render the full UI frame (world + forecast + health + banner + the
+	// NOC debug overlay — the same shipped draw calls the T2 + overlay verbs
+	// use; the feed scan mirrors the overlay-check verb) and export the frame
+	// PNG.
+	feed: rnd.Noc_Feed
+	rnd.noc_feed_scan(&feed, state.events[:])
+	rl.BeginDrawing()
+	rnd.draw_world(&rc.view, &state.topology, &state.bundles, &state.flow, &state.crisis, sim_tick, {}, -1, -1, state.seed)
+	rnd.draw_forecast_panel(&rc.view, &state.crisis, cat, state.era)
+	rnd.draw_health_meter(&rc.view, &state.health, cat, state.health_enabled)
+	banner_y: i32 = 10
+	if state.health_enabled {
+		banner_y = 10 + rnd.HEALTH_CARD_H + 6
+	}
+	rnd.draw_crisis_banner(&rc.view, &state.crisis, cat, state.era, banner_y)
+	rnd.draw_noc_overlay(&rc.view, &feed, &stats, &state.topology, &state.bundles, cat, state.events[:], -1, u32(len(state.flow.packets)), 0)
+	rl.EndDrawing()
+	img := rl.LoadImageFromScreen()
+	rl.ImageFlipVertical(&img)
+	swizzle_rb(&img)
+	frame_out := fmt.tprintf("bin/font-%s-%s-%dms.png", tag, demo, cap_ms)
+	if ok := rl.ExportImage(img, strings_clone_cstr(frame_out)); !ok {
+		fmt.eprintfln("font-check: failed to write %s", frame_out)
+		return 1
+	}
+	fmt.printfln("font-check: %s written (tick %d, %d events)", frame_out, sim_tick, len(state.events))
+
+	// 5. the specimen canvas (the game's text at the game's sizes).
+	rl.BeginDrawing()
+	draw_specimen(rc, warn_font)
+	rl.EndDrawing()
+	spec := rl.LoadImageFromScreen()
+	rl.ImageFlipVertical(&spec)
+	swizzle_rb(&spec)
+	spec_out := fmt.tprintf("bin/font-%s-specimen.png", tag)
+	if ok := rl.ExportImage(spec, strings_clone_cstr(spec_out)); !ok {
+		fmt.eprintfln("font-check: failed to write %s", spec_out)
+		return 1
+	}
+	fmt.printfln("font-check: %s written", spec_out)
+	return 0
+}
+
+} // when #config(PP_DEBUG, false)
