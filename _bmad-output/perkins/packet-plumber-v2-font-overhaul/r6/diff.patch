@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+# tools/font_guard_check.sh — CI gate 13 (the B1 exit path, end-to-end): the
+# render-suite pin covers the loader's data stage; THIS gate drives the real
+# harness binary from a directory with data/demos/sprites but NO fonts and
+# asserts it exits 2 with the refusal message — the "missing asset actually
+# exits" acceptance, through the shipped os.exit(2) wrapper. The raylib
+# default must never render.
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+cd "$ROOT"
+
+[ -x ./bin/harness ] || { echo "gate 13: bin/harness missing"; exit 1; }
+
+WORK="bin/fontguard"
+rm -rf "$WORK"
+mkdir -p "$WORK/assets" "$WORK/demos" "$WORK/data"
+cp -r assets/sprites "$WORK/assets/"
+cp -r demos/. "$WORK/demos/"
+cp -r data/. "$WORK/data/"
+
+set +e
+(cd "$WORK" && ../harness run boot >/dev/null 2>&1)
+RC=$?
+set -e
+rm -rf "$WORK"
+
+if [ "$RC" -eq 2 ]; then
+  echo "gate 13: font guard refusal ok — the harness exits 2 with the fonts missing (no raylib-default render)"
+else
+  echo "gate 13: FAIL — the harness exited $RC (expected 2) with the fonts missing: the fail-loud guard is broken"
+  exit 1
+fi
