diff --git a/app/render/font_test.odin b/app/render/font_test.odin
new file mode 100644
index 00000000..6c4e01b2
--- /dev/null
+++ b/app/render/font_test.odin
@@ -0,0 +1,167 @@
+package render
+
+// font_test.odin — the v2-font-overhaul pipeline pins (2026-08-22, user pick:
+// IBM Plex Sans). The briefing's hard rule 6: the new font must NOT regress on
+// the glyph the raylib default broke on (U+26A0, ⚠ — the default font had no
+// slot at all). The pin is mechanical (glyph-data level — LoadFontData + the
+// in-place fallback merge; no window/GL needed):
+//   (a) the shipped merge puts a REAL ⚠ glyph into the atlas slot, and
+//   (b) NEGATIVE CONTROL: without the fallback file the slot stays empty —
+//       the pin bites (a future font swap that drops the fallback fails).
+// The draw path (draw_text_font) is the raw-UTF-8-bytes copy — a non-ASCII
+// rune reaches the atlas instead of mojibake; game strings stay ASCII by lint
+// gate 6, so this is the pipeline guarantee, not a content change.
+
+import "core:math"
+import "core:os"
+import "core:testing"
+import rl "vendor:raylib"
+
+// font_probe_warning — load the family data with the merge and report whether
+// the ⚠ slot carries a real glyph (box or advance non-zero). `fallback_path`
+// is injected so the test can run the negative control.
+font_probe_warning :: proc(main_path, fallback_path: string) -> bool {
+	cps := font_codepoints()
+	glyphs, count := font_merge_fallback(main_path, fallback_path, FONT_BASE_SIZE, cps[:])
+	if glyphs == nil || count == 0 {
+		return false
+	}
+	defer rl.MemFree(glyphs) // test-side: the merged glyph block is raylib-owned (r3 note)
+	// the compacted array: find the ⚠ entry by VALUE (raylib's lookup rule).
+	for i in 0..<count {
+		if glyphs[i].value == 0x26A0 {
+			g := glyphs[i]
+			return g.image.width > 0 || g.image.height > 0 || g.advanceX > 0
+		}
+	}
+	return false
+}
+
+@(test)
+font_warning_glyph_in_merged_atlas :: proc(t: ^testing.T) {
+	if !os.exists(FONT_ASSET) || !os.exists(FONT_FALLBACK_ASSET) {
+		testing.expect(t, false, "the font assets must be committed (assets/fonts)")
+		return
+	}
+	testing.expect(t, font_probe_warning(FONT_ASSET, FONT_FALLBACK_ASSET),
+		"U+26A0 (the warning sign) must render - the fallback merge puts it in the atlas")
+}
+
+@(test)
+font_warning_glyph_negative_control :: proc(t: ^testing.T) {
+	// the pin bites: without the fallback the slot is empty (Plex Sans has no
+	// ⚠ — the mechanical probe of the family). A font swap that drops the
+	// fallback MUST fail this test.
+	if !os.exists(FONT_ASSET) {
+		testing.expect(t, false, "the font asset must be committed")
+		return
+	}
+	testing.expect(t, !font_probe_warning(FONT_ASSET, "assets/fonts/does-not-exist.ttf"),
+		"negative control: Plex lacks U+26A0 AND an unreadable fallback FAILS the load (B1-residual) - never a silent warning-less atlas")
+}
+
+// font_guard_reports_missing_asset — the B1 pin: the loader must REPORT a
+// missing asset (the app + harness + palcheck exit guards fire on the false
+// return — the raylib default is NEVER coerced inside the loader, so the
+// refusal path is reachable). Pinned at the DATA stage (font_atlas_build —
+// pure CPU; the GPU texture upload is the caller's and cannot fail for the
+// committed assets). The exit itself is the callers' thin
+// `if !rnd.load_fonts { os.exit(2) }` wrapper; this pins the condition that
+// drives it.
+@(test)
+font_guard_reports_missing_asset :: proc(t: ^testing.T) {
+	// the committed family loads clean (the exit guard's happy path)
+	_, atlas, ok := font_atlas_build_from_file(FONT_ASSET)
+	if ok {
+		rl.UnloadImage(atlas) // note (r4): the guard test discards the atlas — free it
+	}
+	testing.expect(t, ok, "the committed HUD family must load")
+	// a missing asset FAILS the load — never the raylib default
+	_, _, ok2 := font_atlas_build_from_file("assets/fonts/definitely-missing.ttf")
+	testing.expect(t, !ok2, "a missing font asset must fail the load (no default coercion)")
+	// the empty-glyph path (a garbage file) fails too
+	_, _, ok3 := font_atlas_build_from_file("data/palette.json")
+	testing.expect(t, !ok3, "a non-font file must fail the load (no default coercion)")
+}
+
+// font_glyph_advance — a codepoint's ADVANCE (the exact field MeasureTextEx
+// sums — rtext.c: `if (font.glyphs[index].advanceX > 0) textWidth +=
+// font.glyphs[index].advanceX`). The panel's right-alignment rides
+// MeasureTextEx, so advance equality IS the tabular-steadiness acceptance.
+// -1 when the glyph is absent.
+font_glyph_advance :: proc(f: rl.Font, cp: rune) -> i32 {
+	for i in 0..<f.glyphCount {
+		if f.glyphs[i].value == cp {
+			return f.glyphs[i].advanceX
+		}
+	}
+	return -1
+}
+
+// font_mono_tabular_digits — the W5 pin: the NOC panel's tabular-steadiness
+// acceptance. Plex Mono's digits are tabular — every digit's atlas rec is
+// the same width — while the Plex Sans body font's LETTERS are proportional
+// (the body digits are tabular too — an IBM family trait; the mono pairing
+// still matters for the panel's look, and this pins it). Data-stage only
+// (no GL; MeasureTextEx itself bails on a zero texture id, so the pin reads
+// the recs directly — the same data MeasureTextEx sums).
+@(test)
+font_mono_tabular_digits :: proc(t: ^testing.T) {
+	mono, am, okm := font_atlas_build_from_file(FONT_MONO_ASSET)
+	if !okm {
+		testing.expect(t, false, "the committed mono font must load")
+		return
+	}
+	defer rl.UnloadImage(am)
+	body, ab, okb := font_atlas_build_from_file(FONT_ASSET)
+	if !okb {
+		testing.expect(t, false, "the committed body font must load")
+		return
+	}
+	defer rl.UnloadImage(ab)
+	w1 := font_glyph_advance(mono, '1')
+	w5 := font_glyph_advance(mono, '5')
+	w0 := font_glyph_advance(mono, '0')
+	testing.expect(t, w1 > 0 && w1 == w5 && w5 == w0,
+		"Plex Mono digits must be tabular (equal advances) - the NOC columns stay steady")
+	// the pin is sensitive (not vacuous): the body font's LETTERS have
+	// different advances than its digits.
+	testing.expect(t, font_glyph_advance(body, 'A') != font_glyph_advance(body, '1'),
+		"body letters must advance differently from digits - the tabular pin is sensitive")
+}
+
+// font_text_contrast_pin — the 08-23 high-contrast ruling, pinned: the
+// TEXT token (ink_soft_text) must clear a 7:1 WCAG-style ratio against the
+// canvas while the SHAPE token (ink_soft) stays at its pre-fold byte (Rule 6:
+// the fold is text-only — gameplay surfaces keep the old ink).
+@(test)
+font_text_contrast_pin :: proc(t: ^testing.T) {
+	p := palette_load()
+	ratio := contrast_ratio(p.ink_soft_text, p.canvas)
+	testing.expect(t, ratio >= 7.0, "ink_soft_text must clear 7:1 vs the canvas (the high-contrast ruling)")
+	shape_ratio := contrast_ratio(p.ink_soft, p.canvas)
+	testing.expect(t, shape_ratio < ratio,
+		"the shape token (ink_soft) must stay LIGHTER than the text token - the fold is text-only (Rule 6)")
+	testing.expect(t, p.ink_soft.r == 92 && p.ink_soft.g == 98 && p.ink_soft.b == 106,
+		"ink_soft must keep its pre-fold byte (palette unchanged beyond the text token)")
+}
+
+// contrast_ratio — the WCAG contrast ratio (sRGB -> relative luminance).
+contrast_ratio :: proc(a, b: rl.Color) -> f32 {
+	la := rel_luminance(a)
+	lb := rel_luminance(b)
+	hi := max(la, lb)
+	lo := min(la, lb)
+	return (hi + 0.05) / (lo + 0.05)
+}
+
+rel_luminance :: proc(c: rl.Color) -> f32 {
+	lin :: proc(v: f32) -> f32 {
+		x := v / 255.0
+		if x <= 0.03928 {
+			return x / 12.92
+		}
+		return math.pow((x + 0.055) / 1.055, 2.4)
+	}
+	return 0.2126 * lin(f32(c.r)) + 0.7152 * lin(f32(c.g)) + 0.0722 * lin(f32(c.b))
+}
