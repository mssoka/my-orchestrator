diff --git a/app/gallery.odin b/app/gallery.odin
new file mode 100644
index 00000000..e1022f82
--- /dev/null
+++ b/app/gallery.odin
@@ -0,0 +1,335 @@
+package main
+
+// gallery.odin — the font-overhaul A/B capture (2026-08-22): PP_DEBUG builds
+// only (the whole file compiles out otherwise — release binaries carry zero
+// gallery code, so normal runs + goldens cannot shift).
+//
+// Armed via PP_FONT_GALLERY=<path-to-ttf>: swaps the HUD font for the
+// candidate and runs a staged scripted session — the REAL windowed app, the
+// REAL input pipeline (Device_Events injected exactly where the D-key e2e
+// injects its presses, before dispatch_frame), capturing the SAME screens
+// per candidate through the SHIPPED draw code:
+//   01-title.png     the boot HUD frame (title header + hints + health + tray)
+//   02-qos.png       the QoS panel (a real drawn pipe, click-selected)
+//   03-noc.png       the D-key debug overlay (dense numbers)
+//   04-settings.png  the a11y settings panel
+//   05-win.png       06-lose.png  the game-over toasts (32px headers)
+// Artifacts land in bin/gallery/<tag>/ (gitignored). The win/lose frames are
+// STAGED view-only state (mode + outcome set directly — presentation only;
+// the sim is already terminal in those frames and the stream never sees it).
+//
+// BUILD (the in-repo producer for PP_SW_AUDIO, N10): the gallery runs the
+// app against the raylib-sw SOFTWARE renderer, headless + bit-exact:
+//   ODIN_ROOT=<main>/tools/raylib-sw/shadow odin build app \
+//       -define:PP_DEBUG=true -define:PP_SW_AUDIO=true -out:bin/app-gallery-sw
+//   PP_FONT_GALLERY=assets/fonts/<candidate>.ttf ./bin/app-gallery-sw
+// (PP_SW_AUDIO stubs the raudio calls the shadow lacks — the seam in
+// app/audio/audio.odin; the SW build also skips the FPS limiter: the
+// PLATFORM_MEMORY GetTime() returns 0 on macOS and the target-fps busy wait
+// spins forever.)
+//
+// STATE: a package-level `gallery` global by design (N9) — the gallery is
+// compile-gated ENTIRELY out of release (the whole file), unlike noc_e2e's
+// App-struct fields which ship inert in every build; hanging it on App would
+// churn the shipped struct for debug-only tooling.
+//
+// The A/B swap targets the BODY font only (the candidate family); headers
+// and the NOC panel keep the shipped Plex weights — the captures isolate
+// the family decision on the body surfaces.
+
+import "core:fmt"
+import "core:os"
+import "core:strings"
+import pp "../core"
+import rnd "./render"
+import inp "./input"
+import rl "vendor:raylib"
+
+when #config(PP_DEBUG, false) {
+
+Gallery_Stage :: enum {
+	Title,          // settle a beat, capture the boot frame
+	Draw_Press,     // press on the res node
+	Draw_Move,      // drag to the router
+	Draw_Release,   // release over the router — the pipe commits
+	Select_Press,   // press on the pipe midpoint
+	Select_Release, // release — click-select (sel_pipe, QoS panel)
+	Qos,            // capture the QoS frame
+	Noc_Press,      // D — overlay on
+	Noc,            // capture the overlay frame
+	Deselect,       // ESC
+	Settings_Press, // S
+	Settings,       // capture the settings frame
+	Win,            // staged game-over win — capture
+	Lose,           // staged game-over lose — capture
+	Done,
+}
+
+Gallery :: struct {
+	on:       bool,
+	tag:      string, // artifact subdir (the candidate's basename)
+	stage:    Gallery_Stage,
+	wait:     int, // frames left in the current settle
+	pending:  bool, // a scripted event is due THIS frame (one-shot — the
+	// inject must fire exactly once per stage: a repeat toggle would flip
+	// the D/S keys off again; the poll loop runs before the stage machine).
+	retries:  int, // N11: the condition-poll frame budget (GALLERY_MAX_RETRIES)
+	res_pos:  rl.Vector2, // the fixture res node's screen position
+	rt_pos:   rl.Vector2, // the fixture router node's screen position
+	pipe_mid: rl.Vector2, // the committed pipe's midpoint (the click target)
+	done:     bool,
+}
+
+gallery: Gallery
+
+// gallery_arm — read PP_FONT_GALLERY; when set, swap in the candidate font +
+// compute the script's anchors. Called AFTER start_run (the fixture nodes
+// exist). A failed font load keeps the app font (the run still captures —
+// the frame then shows the baseline, a useful A/B pairing in one run).
+// NOTE: the gallery runs under the raylib-sw SOFTWARE renderer (the shadow
+// build) — headless, bit-exact like the harness, no GPU/GL — so the captures
+// are the SAME rasterizer as the blessed goldens. The GL-front-buffer
+// freeze + RenderTexture alpha quirks of the GPU path never exist here.
+gallery_arm :: proc(app: ^App) {
+	path := os.get_env_alloc("PP_FONT_GALLERY", context.allocator)
+	if path == "" {
+		return
+	}
+	fmt.printfln("gallery: arm enter")
+	gallery.on = true
+	gallery.tag = font_tag(path)
+	f := rl.LoadFontEx(strings.clone_to_cstring(path, context.temp_allocator), rnd.FONT_BASE_SIZE, nil, 0)
+	if rl.IsFontValid(f) {
+		rl.SetTextureFilter(f.texture, .BILINEAR)
+		app.view.font = f
+		fmt.printfln("gallery: candidate font %s loaded", path)
+	} else {
+		fmt.eprintfln("gallery: cannot load %s — capturing with the baseline font", path)
+	}
+	gallery.res_pos = rnd.node_screen(&app.view, inp.node_pos(&app.state.topology, app.res_id))
+	gallery.rt_pos = rnd.node_screen(&app.view, inp.node_pos(&app.state.topology, app.rt_id))
+	gallery.stage = .Title
+	gallery.wait = 30
+	fmt.printfln("gallery: armed — res@(%.0f,%.0f) rt@(%.0f,%.0f)", gallery.res_pos.x, gallery.res_pos.y, gallery.rt_pos.x, gallery.rt_pos.y)
+}
+
+// font_tag — the artifact dir name: the font file's basename minus the
+// extension (unique per candidate; the tag never collides across runs).
+font_tag :: proc(path: string) -> string {
+	base := path
+	if i := strings.last_index_any(path, "/\\"); i >= 0 {
+		base = path[i+1:]
+	}
+	if i := strings.last_index(base, "."); i > 0 {
+		base = base[:i]
+	}
+	return base
+}
+
+// gallery_inject — stage the frame's scripted Device_Events (the SAME source
+// slot the noc-e2e D presses use: after the polls, before dispatch_frame —
+// the real map -> exec -> effect chain runs untouched; only the key source is
+// scripted).
+gallery_inject :: proc(app: ^App, ictx: ^inp.Input) {
+	if !gallery.on || gallery.done || !gallery.pending {
+		return
+	}
+	gallery.pending = false // one-shot — the event fires exactly once
+	#partial switch gallery.stage {
+	case .Draw_Press:
+		append(&ictx.events, inp.Device_Event(inp.Mouse_Press{pos = gallery.res_pos, button = .Left}))
+	case .Draw_Move:
+		append(&ictx.events, inp.Device_Event(inp.Mouse_Move{pos = gallery.rt_pos}))
+	case .Draw_Release:
+		append(&ictx.events, inp.Device_Event(inp.Mouse_Release{pos = gallery.rt_pos, button = .Left}))
+	case .Select_Press:
+		append(&ictx.events, inp.Device_Event(inp.Mouse_Press{pos = gallery.pipe_mid, button = .Left}))
+	case .Select_Release:
+		append(&ictx.events, inp.Device_Event(inp.Mouse_Release{pos = gallery.pipe_mid, button = .Left}))
+	case .Noc_Press:
+		append(&ictx.events, inp.Device_Event(inp.Key_Press{key = .D}))
+	case .Deselect:
+		append(&ictx.events, inp.Device_Event(inp.Key_Press{key = .Esc}))
+	case .Settings_Press:
+		append(&ictx.events, inp.Device_Event(inp.Key_Press{key = .S}))
+	case:
+		// no event this frame
+	}
+}
+
+// gallery_shot — read the rlsw memory framebuffer (the harness pattern:
+// bottom-up + BGRA — flip + swizzle before export; the same normalization
+// the blessed T2 captures use, so the gallery pixels are the golden
+// rasterizer's own).
+gallery_shot :: proc(app: ^App, name: string) {
+	base := "bin/gallery"
+	if !os.exists(base) {
+		os.make_directory(base)
+	}
+	dir := fmt.tprintf("%s/%s", base, gallery.tag)
+	if !os.exists(dir) {
+		os.make_directory(dir)
+	}
+	path := fmt.tprintf("%s/%s.png", dir, name)
+	img := rl.LoadImageFromScreen()
+	rl.ImageFlipVertical(&img)
+	// swizzle the BGRA framebuffer to RGBA — the exact harness normalization
+	// (LoadImageColors + r/b swap; the blessed T2 captures use the same).
+	px := rl.LoadImageColors(img)
+	n := int(img.width) * int(img.height)
+	for i in 0..<n {
+		px[i].r, px[i].b = px[i].b, px[i].r
+	}
+	new_img: rl.Image
+	new_img.data = raw_data(px)
+	new_img.width = img.width
+	new_img.height = img.height
+	new_img.mipmaps = 1
+	new_img.format = .UNCOMPRESSED_R8G8B8A8
+	rl.UnloadImage(img)
+	defer rl.UnloadImage(new_img)
+	if ok := rl.ExportImage(new_img, strings.clone_to_cstring(path, context.temp_allocator)); ok {
+		fmt.printfln("gallery: %s captured", path)
+	} else {
+		fmt.eprintfln("gallery: %s FAILED to save (screenshot write error)", path)
+	}
+}
+
+// pipe_live — any alive pipe? (the committed draw's poll.)
+pipe_live :: proc(app: ^App) -> bool {
+	for a in app.state.topology.pipe_alive {
+		if a {
+			return true
+		}
+	}
+	return false
+}
+
+// pipe_mid_compute — the first alive pipe's screen midpoint (the click target
+// for the 5.5 release-select — over the map, never over the tray/UI).
+pipe_mid_compute :: proc(app: ^App) {
+	topo := &app.state.topology
+	for i in 0..<len(topo.pipe_alive) {
+		if topo.pipe_alive[i] {
+			a := rnd.node_screen(&app.view, inp.node_pos(topo, topo.pipe_a[i]))
+			b := rnd.node_screen(&app.view, inp.node_pos(topo, topo.pipe_b[i]))
+			gallery.pipe_mid = {(a.x + b.x) / 2, (a.y + b.y) / 2}
+			fmt.printfln("gallery: pipe %d midpoint (%.0f,%.0f)", i, gallery.pipe_mid.x, gallery.pipe_mid.y)
+			return
+		}
+	}
+}
+
+// gallery_stage_game_over — the STAGED terminal frame (view-only: the mode +
+// outcome are presentation state; the sim is not stepped from it and no
+// stream sees the frame).
+gallery_stage_game_over :: proc(app: ^App, outcome: pp.Outcome) {
+	app.mode = .Game_Over
+	app.state.outcome = outcome
+	app.state.health_enabled = true // the meter card rides the toast (4.3)
+	app.surge_win_pct = 100         // the era-3 headline toast (the win variant)
+}
+
+// GALLERY_MAX_RETRIES — the N11 condition-poll frame budget: a stage whose
+// condition never arrives (a swallowed input, a broken executor path) must
+// abort the run with the stage named, never spin forever.
+GALLERY_MAX_RETRIES :: 600 // ~10 s of scripted time at 60 fps
+
+// gallery_frame — the stage machine (called AFTER EndDrawing, like the noc-e2e
+// captures). Returns true when the script is done (the main loop breaks).
+gallery_frame :: proc(app: ^App) -> bool {
+	if !gallery.on {
+		return false
+	}
+	if gallery.wait > 0 {
+		gallery.wait -= 1
+		return false
+	}
+	gallery.retries += 1
+	if gallery.retries > GALLERY_MAX_RETRIES {
+		fmt.eprintfln("gallery: stage %v stalled (retry budget exceeded) — aborting the capture run", gallery.stage)
+		gallery.done = true
+		gallery.stage = .Done
+		return true
+	}
+	switch gallery.stage {
+	case .Title:
+		gallery_shot(app, "01-title")
+		gallery.stage = .Draw_Press
+		gallery.pending = true
+	case .Draw_Press:
+		gallery.stage = .Draw_Move
+		gallery.pending = true
+	case .Draw_Move:
+		gallery.stage = .Draw_Release
+		gallery.pending = true
+	case .Draw_Release:
+		if !pipe_live(app) {
+			gallery.wait = 5 // the commit lands via the executor — poll
+			return false
+		}
+		pipe_mid_compute(app)
+		gallery.stage = .Select_Press
+		gallery.pending = true
+	case .Select_Press:
+		gallery.stage = .Select_Release
+		gallery.pending = true
+	case .Select_Release:
+		if app.input.sel_pipe < 0 {
+			gallery.wait = 3
+			return false
+		}
+		gallery.wait = 45 // let the sim flow a beat (packets on the pipes)
+		gallery.stage = .Qos
+	case .Qos:
+		gallery_shot(app, "02-qos")
+		gallery.stage = .Noc_Press
+		gallery.pending = true
+	case .Noc_Press:
+		gallery.stage = .Noc
+		gallery.wait = 90 // stats need stepped ticks (per-step records)
+	case .Noc:
+		if !app.overlay_on || !app.stats_valid {
+			fmt.printfln("gallery: noc wait — overlay_on=%v stats_valid=%v mode=%v tick=%d terminal=%v", app.overlay_on, app.stats_valid, app.mode, app.tick, app.state.terminal)
+			gallery.wait = 5
+			return false
+		}
+		gallery_shot(app, "03-noc")
+		gallery.stage = .Deselect
+		gallery.pending = true
+	case .Deselect:
+		if app.input.sel_pipe >= 0 {
+			gallery.wait = 5 // the ESC deselect lands via the intent chain
+			return false
+		}
+		gallery.stage = .Settings_Press
+		gallery.pending = true
+	case .Settings_Press:
+		gallery.stage = .Settings
+		gallery.wait = 20
+	case .Settings:
+		if !app.input.panel_open {
+			gallery.wait = 5
+			return false
+		}
+		gallery_shot(app, "04-settings")
+		gallery_stage_game_over(app, .Won)
+		gallery.wait = 15
+		gallery.stage = .Win
+	case .Win:
+		gallery_shot(app, "05-win")
+		gallery_stage_game_over(app, .Lost)
+		gallery.wait = 15
+		gallery.stage = .Lose
+	case .Lose:
+		gallery_shot(app, "06-lose")
+		gallery.done = true
+		gallery.stage = .Done
+		return true
+	case .Done:
+		return true
+	}
+	return false
+}
+
+} // when #config(PP_DEBUG, false)
