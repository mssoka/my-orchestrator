+#!/usr/bin/env bash
+# tools/debug_surface_smoke.sh — LOCAL-ONLY CI gate 12 (W5 wiring + N15
+# debug smoke; no ci.yml step — the local replica's extra verification leg):
+# builds its OWN PP_DEBUG harness against the rlsw software shadow (gate 9's
+# binary is a GPU-links compile gate — not runnable headless) and RUNS the
+# shipped NOC overlay draw on a real demo, asserting the panel rect actually
+# paints (overlay-pixels — an in-code pixel check). A wiring regression that
+# never draws would pass every compile gate and every golden, because the
+# overlay is app-layer and invisible to T2.
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+cd "$ROOT"
+SHADOW="$ROOT/tools/raylib-sw/shadow"
+if [ ! -d "$SHADOW" ]; then
+  "$ROOT/tools/build_raylib_sw.sh"
+fi
+ODIN_ROOT="$SHADOW" odin build harness -define:PP_DEBUG=true -out:bin/harness-debug-sw
+# W3 (r4): the PP_SW_AUDIO seam branch (the 16 stub procs) must be compiled
+# by an automated gate or signature drift stays green.
+ODIN_ROOT="$SHADOW" odin build app -define:PP_DEBUG=true -define:PP_SW_AUDIO=true -out:bin/app-gallery-sw-check
+./bin/harness-debug-sw overlay-pixels qos_contention 12000ms
