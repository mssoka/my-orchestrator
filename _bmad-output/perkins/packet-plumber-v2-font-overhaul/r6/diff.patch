+// run_demo_to_ms — the SHARED replay driver (W4): step a parsed demo to the
+// capture wall-ms (paused wall ticks step nothing — the same driver the run
+// path uses) and return the LAST stepped tick's state + its stats record +
+// the event tail (the app's behavior). The wall clock is bounded by the
+// demo's run length (an out-of-range capture ms clamps to the run end —
+// never steps past the demo's horizon). stats_valid=false when no tick
+// stepped (a paused/frozen window or cap_ms=0). `hashes` (optional) collects
+// the per-tick T1 stream for the overlay-check .t1 sidecar.
+run_demo_to_ms :: proc(state: ^pp.Run_State, d: ^Demo, cfg: ^Demo_Replay, cat: ^pp.Catalogs, cap_ms: i64, hashes: ^[dynamic]u64 = nil) -> (sim_tick: u64, stats: pp.Stats_Record, stats_valid: bool) {
+	hz := cat.balance.logic_hz
+	total_wall := demo_run_ticks(d, hz)
+	wall_max := min(u64(max(0, i64(cap_ms) * i64(hz) / 1000)), total_wall)
+	for w in u64(1)..=wall_max {
+		before := len(state.events)
+		if paused_at(cfg.pauses[:], w, hz) {
+			free_all(context.temp_allocator)
+			continue // a paused wall tick steps nothing
+		}
+		sim_tick += 1
+		batch := make([dynamic]pp.Command, 0, 4, context.temp_allocator)
+		for cmd in state.action_log {
+			if cmd.apply_tick == sim_tick {
+				append(&batch, cmd)
+			}
+		}
+		pp.step(state, sim_tick, batch[:], cat)
+		if stats_valid {
+			pp.stats_destroy(&stats)
+		}
+		h := pp.state_hash(state, state.events[before:], cat, context.temp_allocator)
+		stats = pp.stats_compute(state, cat, h)
+		stats_valid = true
+		if hashes != nil {
+			append(hashes, h)
+		}
+		free_all(context.temp_allocator)
+	}
+	return
+}
+
+// demo_replay_setup — the SHARED parse+apply block (W7/r4: the three PP_DEBUG
+// render verbs — overlay_check, overlay_pixels_check, font_check — used three
+// verbatim copies of this ~25-line setup; the drift class that already bit
+// once). Returns the run state + parsed demo + replay cfg; the CALLER owns
+// the same defer trio every verb uses:
+//   defer demo_destroy(&d); defer pp.run_destroy(&state)
+//   defer { delete(cfg.nodes); delete(cfg.spawns); delete(cfg.pauses) }
+// Internal failures clean up after themselves (no leaks on the error path).
+demo_replay_setup :: proc(demo: string, cat: ^pp.Catalogs) -> (state: pp.Run_State, d: Demo, cfg: Demo_Replay, err: string) {
+	path := fmt.tprintf("demos/%s.dem", demo)
+	text_bytes, rerr := os.read_entire_file_from_path(path, context.temp_allocator)
+	if rerr != nil {
+		return {}, {}, {}, fmt.tprintf("cannot read %s", path)
+	}
+	pd, perr := parse_demo(demo, string(text_bytes))
+	if perr != "" {
+		return {}, {}, {}, perr
+	}
+	d = pd // the named return (no shadowing)
+	pp.run_init(&state, d.seed, cat.hash, cat.balance.logic_hz)
+	state.era = d.era
+	cfg = Demo_Replay{
+		name = d.name,
+		use_fixture = d.use_fixture,
+		qos_fixture = d.qos_fixture,
+		advance_gate_on = d.advance_gate_on,
+		session = {goal = d.win_goal, cap_ms = d.lose_cap_ms, health_on = d.health_on, surge_win_pct = d.surge_win_pct},
+	}
+	for n in d.nodes { append(&cfg.nodes, n) }
+	for s in d.spawns { append(&cfg.spawns, s) }
+	for p in d.pauses { append(&cfg.pauses, p) }
+	if e := demo_apply_setup(&state, &cfg, cat); e != "" {
+		demo_destroy(&d)
+		pp.run_destroy(&state)
+		delete(cfg.nodes); delete(cfg.spawns); delete(cfg.pauses)
+		return {}, {}, {}, e
+	}
+	if e := lower_intents(&state, &d, cat); e != "" {
+		demo_destroy(&d)
+		pp.run_destroy(&state)
+		delete(cfg.nodes); delete(cfg.spawns); delete(cfg.pauses)
+		return {}, {}, {}, e
+	}
+	return state, d, cfg, ""
+}
+
 // strings_clone_cstr — clone a string into a cstring (raylib's ExportImage
 // takes a cstring; the temp arena is fine for the call's lifetime).
 strings_clone_cstr :: proc(s: string) -> cstring {
 	return strings.clone_to_cstring(s, context.temp_allocator)
 }
 
+
+// overlay_pixels_check — the W5-wiring/N15 smoke verb: `overlay-pixels
+// <demo> <ms>` renders the SAME frame as overlay-check (the shipped
+// draw_noc_overlay on a real demo replay) and then asserts IN CODE that the
+// NOC panel rect actually painted (the translucent dark panel + its text:
+// a wiring regression that never draws would pass every compile gate and
+// every golden — the overlay is app-layer, invisible to T2). Exits 1 when
+// the panel is blank. PP_DEBUG builds only.
+overlay_pixels_check :: proc(demo: string, cap_ms: i64, cat: ^pp.Catalogs, rc: ^Render_Ctx) -> i32 {
+	state, d, cfg, err := demo_replay_setup(demo, cat)
+	if err != "" {
+		fmt.eprintfln("overlay-pixels: %s", err)
+		return 1
+	}
+	defer demo_destroy(&d)
+	defer pp.run_destroy(&state)
+	defer { delete(cfg.nodes); delete(cfg.spawns); delete(cfg.pauses) }
+	sim_tick, stats, stats_valid := run_demo_to_ms(&state, &d, &cfg, cat, cap_ms)
+	if !stats_valid {
+		fmt.eprintfln("overlay-pixels: %s: no stepped tick before %dms", demo, cap_ms)
+		return 1
+	}
+	defer pp.stats_destroy(&stats)
+	feed: rnd.Noc_Feed
+	rnd.noc_feed_scan(&feed, state.events[:])
+	// B1 (r4): the vacuous-gate fix — render the SAME frame TWICE (overlay
+	// OFF then ON) and diff INSIDE the panel rect. A dark-sample floor alone
+	// is vacuous (the map/forecast band behind the panel already clears it —
+	// mutation-proven in r4). The DIFF isolates the overlay's own pixels:
+	// with the overlay removed, the two frames are byte-identical and the
+	// diff is ~0 — the gate fails exactly on the never-draws regression.
+	img_off := overlay_pixels_frame(rc, &state, cat, &stats, &feed, sim_tick, false)
+	defer rl.UnloadImage(img_off)
+	img_on := overlay_pixels_frame(rc, &state, cat, &stats, &feed, sim_tick, true)
+	defer rl.UnloadImage(img_on)
+	px_off := rl.LoadImageColors(img_off)
+	defer rl.MemFree(px_off)
+	px_on := rl.LoadImageColors(img_on)
+	defer rl.MemFree(px_on)
+	w := int(img_on.width)
+	// the NOC panel rect (the render package's NOC_PANEL_X/Y/W/H — right
+	// column): count pixels the overlay CHANGED inside it (stride 2 — the
+	// panel's text rows are thin; a stride of 6 could skip them).
+	diff := 0
+	for y := rnd.NOC_PANEL_Y; y < rnd.NOC_PANEL_Y + rnd.NOC_PANEL_H; y += 2 {
+		for x := rnd.NOC_PANEL_X; x < rnd.NOC_PANEL_X + rnd.NOC_PANEL_W; x += 2 {
+			i := y * w + x
+			a := px_off[i]
+			b := px_on[i]
+			if a.r != b.r || a.g != b.g || a.b != b.b {
+				diff += 1
+			}
+		}
+	}
+	if diff < 1000 {
+		fmt.eprintfln("overlay-pixels: FAIL — the overlay changes only %d pixels inside the panel rect (a wiring regression never draws)", diff)
+		return 1
+	}
+	fmt.printfln("overlay-pixels: OK — the overlay paints %d changed pixels inside the panel rect (tick %d)", diff, sim_tick)
+	return 0
+}
+
+// overlay_pixels_frame — render the demo frame with/without the NOC overlay,
+// normalized like every other readback (vertical flip + BGRA->RGBA swizzle —
+// the rlsw framebuffer convention; B1: the old verb sampled the mirrored
+// band). The sim/state/feed are the SAME in both renders, so the pixel diff
+// is the overlay's own contribution.
+overlay_pixels_frame :: proc(rc: ^Render_Ctx, state: ^pp.Run_State, cat: ^pp.Catalogs, stats: ^pp.Stats_Record, feed: ^rnd.Noc_Feed, sim_tick: u64, with_overlay: bool) -> rl.Image {
+	rl.BeginDrawing()
+	rnd.draw_world(&rc.view, &state.topology, &state.bundles, &state.flow, &state.crisis, sim_tick, {}, -1, -1, state.seed)
+	rnd.draw_forecast_panel(&rc.view, &state.crisis, cat, state.era)
+	rnd.draw_health_meter(&rc.view, &state.health, cat, state.health_enabled)
+	rnd.draw_crisis_banner(&rc.view, &state.crisis, cat, state.era, 10)
+	if with_overlay {
+		rnd.draw_noc_overlay(&rc.view, feed, stats, &state.topology, &state.bundles, cat, state.events[:], -1, u32(len(state.flow.packets)), 0)
+	}
+	rl.EndDrawing()
+	img := rl.LoadImageFromScreen()
+	rl.ImageFlipVertical(&img)
+	px := rl.LoadImageColors(img)
+	n := int(img.width) * int(img.height)
+	for i in 0..<n {
+		px[i].r, px[i].b = px[i].b, px[i].r
+	}
+	new_img: rl.Image
+	new_img.data = raw_data(px)
+	new_img.width = img.width
+	new_img.height = img.height
+	new_img.mipmaps = 1
+	new_img.format = .UNCOMPRESSED_R8G8B8A8
+	rl.UnloadImage(img)
+	return new_img
+}
+
 } // when #config(PP_DEBUG, false)
