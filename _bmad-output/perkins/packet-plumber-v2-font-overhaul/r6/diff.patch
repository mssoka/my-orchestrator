+// 2026-08-22 (v2-font-overhaul, user pick: IBM Plex Sans): Open Sans -> Plex
+// Sans (Regular body + SemiBold headers) + Plex Mono (the NOC/tabular
+// surface) + the Noto Sans Symbols 2 fallback for missing glyphs (U+26A0 ⚠ —
+// the exact glyph the raylib default broke on; the mechanical probe in the
+// harness font-check verb pins coverage per family).
+FONT_ASSET           :: "assets/fonts/ibm_plex_sans_regular.ttf"
+FONT_HEADER_ASSET    :: "assets/fonts/ibm_plex_sans_semibold.ttf"
+FONT_MONO_ASSET      :: "assets/fonts/ibm_plex_mono_regular.ttf"
+FONT_FALLBACK_ASSET  :: "assets/fonts/noto_sans_symbols2_regular.ttf"
+FONT_BASE_SIZE :: 64 // the atlas size — downscaled to HUD sizes (12-30px)
+FONT_GLYPH_PADDING :: 4 // the atlas packing padding (OUR choice — raylib's LoadFontEx itself packs with 0; 4px keeps adjacent glyph bitmaps from bleeding under bilinear filtering)
+
+// FONT_CODEPOINTS — the atlas character set: the printable ASCII range the
+// game uses + U+26A0 (⚠, the warning glyph; missing from Plex — the fallback
+// covers it). Drawn strings stay ASCII by lint gate 6; the ⚠ slot makes the
+// pipeline non-regressing (the raylib-default failure mode) + future-proof.
+font_codepoints :: proc() -> [96]rune {
+	cps: [96]rune
+	n := 0
+	for cp in rune(32)..=rune(126) {
+		cps[n] = cp
+		n += 1
+	}
+	cps[n] = rune(0x26A0)
+	return cps
+}
+
+// font_load_data — read a TTF + rasterize the codepoint set (raylib's
+// LoadFontData over the file bytes). Returns the glyph array + count; the
+// caller owns it (the GenImageFontAtlas / Font lifecycle — raylib's own
+// LoadFontEx pattern, rtext.c:569).
+font_load_data :: proc(path: string, size: i32, cps: []rune) -> (glyphs: [^]rl.GlyphInfo, count: c.int) {
+	data, err := os.read_entire_file_from_path(path, context.temp_allocator)
+	if err != nil {
+		return nil, 0
+	}
+	ng: c.int = 0
+	g := rl.LoadFontData(raw_data(data), c.int(len(data)), size,
+		raw_data(cps), c.int(len(cps)), .DEFAULT, &ng)
+	return g, ng
+}
+
+// font_merge_fallback — load the MAIN font's glyphs, then for every requested
+// codepoint the main font lacks, rasterize it from the FALLBACK font and
+// APPEND the glyphs. raylib COMPACTS the glyph array (missing codepoints are
+// skipped; the atlas lookup maps by glyph.value, never by index — appended
+// entries just work). The merged array is allocated with raylib's own
+// allocator (MemAlloc — UnloadFont RL_FREEs it correctly, no cross-allocator
+// frees); the main font's original array BLOCK is MemFree'd after the copy
+// (its glyph image data is now owned by the merged entries — freed exactly
+// once, by UnloadFont, via the merged array).
+font_merge_fallback :: proc(main_path, fallback_path: string, size: i32, cps: []rune) -> (glyphs: [^]rl.GlyphInfo, count: c.int) {
+	glyphs, count = font_load_data(main_path, size, cps)
+	if glyphs == nil {
+		return nil, 0
+	}
+	// the requested codepoints the main font's compacted set lacks — collected
+	// IN ORDER (the fallback glyphs land in the same order the atlas recs
+	// expect; the value-based lookup keeps them findable).
+	missing: [96]rune // the codepoint set is 96 — every gap is representable (N4)
+	missing_n := 0
+	for cp in cps {
+		found := false
+		for i in 0..<count {
+			if glyphs[i].value == cp {
+				found = true
+				break
+			}
+		}
+		if !found && missing_n < len(missing) {
+			missing[missing_n] = cp
+			missing_n += 1
+		}
+	}
+	if missing_n == 0 {
+		return glyphs, count
+	}
+	if missing_n == len(cps) {
+		// the main font carries NONE of the requested codepoints — a broken
+		// asset, not a merge case. Fail loudly (the loader doctrine).
+		return nil, 0
+	}
+	fdata, ferr := os.read_entire_file_from_path(fallback_path, context.temp_allocator)
+	if ferr != nil {
+		// B1-residual (r3): the main font lacks glyphs AND the fallback is
+		// unreadable — returning ok would silently ship an atlas without ⚠
+		// (the CI pin would be the only net). Fail loudly instead.
+		return nil, 0
+	}
+	ng: c.int = 0
+	fg := rl.LoadFontData(raw_data(fdata), c.int(len(fdata)), size,
+		raw_data(missing[:missing_n]), c.int(missing_n), .DEFAULT, &ng)
+	if fg == nil || ng == 0 {
+		// W2 (r4): a READABLE fallback that decoded nothing is as fatal as a
+		// missing file — the atlas would silently ship without the glyphs.
+		rl.MemFree(glyphs)
+		return nil, 0
+	}
+	// merged array: the main glyphs + the fallback's (raylib's allocator —
+	// UnloadFont owns every byte: the glyph structs AND their image data).
+	total := count + ng
+	merged := cast([^]rl.GlyphInfo)rl.MemAlloc(c.uint(size_of(rl.GlyphInfo) * int(total)))
+	if merged == nil {
+		rl.MemFree(glyphs)
+		return nil, 0
+	}
+	for i in 0..<count {
+		merged[i] = glyphs[i]
+	}
+	for j in 0..<ng {
+		merged[count + j] = fg[j]
+	}
+	// W2 completeness: the merged set must cover EVERY requested codepoint —
+	// a fallback that lacks a gap too (or a decode that skipped it) would
+	// silently ship an incomplete atlas. Value-keyed scan (the lookup rule).
+	for cp in cps {
+		found := false
+		for i in 0..<total {
+			if merged[i].value == cp {
+				found = true
+				break
+			}
+		}
+		if !found {
+			rl.MemFree(merged)
+			return nil, 0
+		}
+	}
+	rl.MemFree(glyphs) // the block is free; the glyph image data lives on in merged
+	rl.MemFree(fg)     // N3: the fallback ARRAY block too (its image data is
+	// owned by the merged entries now — freed exactly once, by UnloadFont).
+	return merged, total
+}
+
+// font_atlas_build — pack the glyph array into ONE atlas + the recs (the
+// raylib LoadFontEx pattern: GenImageFontAtlas with PIXELPACK(0) + the 4px
+// padding). PURE CPU (no GL) — the texture upload is the caller's, so the
+// fail-loud contract is testable headless. The atlas is deterministic — same
+// TTF bytes + same codepoints = same pixels in rlsw and GPU (the 08-15
+// determinism note) — so the merged atlas keeps the T2 spine. Returns
+// ok=false on ANY failure — the raylib default is NEVER substituted here
+// (the fail-loud doctrine: a silent default would lie in the captures). The
+// caller owns the atlas image (upload + UnloadImage, or just UnloadImage).
+font_atlas_build :: proc(glyphs: [^]rl.GlyphInfo, count: c.int, size: i32) -> (f: rl.Font, atlas: rl.Image, ok: bool) {
+	if glyphs == nil || count == 0 {
+		return {}, {}, false
+	}
+	atlas = rl.GenImageFontAtlas(glyphs, &f.recs, count, size, FONT_GLYPH_PADDING, 0)
+	if atlas.data == nil {
+		return {}, {}, false
+	}
+	f.baseSize = size
+	f.glyphCount = count
+	f.glyphPadding = FONT_GLYPH_PADDING
+	f.glyphs = glyphs
+	return f, atlas, true
+}
+
+// load_font_file — load one family file + the glyph fallback, merged into a
+// single atlas, texture uploaded. ok=false when the load failed — the CALLER
+// refuses to run (app + harness + palcheck exit; the raylib default must
+// never render). The data stage (font_atlas_build) is the testable core.
+load_font_file :: proc(asset: string) -> (rl.Font, bool) {
+	f, atlas, ok := font_atlas_build_from_file(asset)
+	if !ok {
+		return {}, false
+	}
+	f.texture = rl.LoadTextureFromImage(atlas)
+	rl.SetTextureFilter(f.texture, .BILINEAR)
+	rl.UnloadImage(atlas)
+	return f, rl.IsFontValid(f)
+}
+
+// load_fonts — load the whole HUD family (body + header + mono, each with
+// the glyph fallback merged). Returns false if ANY font failed to load — the
+// app + harness + palcheck refuse to run on false (the fail-loud doctrine,
+// B1: the A/B gallery proved a silent fallback lies). The T2 captures
+// rasterize the same atlases (deterministic across platforms).
+load_fonts :: proc(v: ^View) -> bool {
+	ok: bool
+	v.font, ok = load_font_file(FONT_ASSET)
+	if !ok {
+		return false
+	}
+	v.font_header, ok = load_font_file(FONT_HEADER_ASSET)
+	if !ok {
+		return false
+	}
+	v.font_mono, ok = load_font_file(FONT_MONO_ASSET)
+	return ok
 }
 
 // ROUTER_TIER_SCALE — the puck size multiplier per port tier (look-book A3:
@@ -1816,3 +2019,12 @@ CIRCLE16 :: [16][2]f32{
 	{0.70710678, -0.70710678},
 	{0.92387954, -0.38268343},
 }
+
+// font_atlas_build_from_file — the data-stage loader used by load_font_file
+// AND the headless tests (the fail-loud + tabular pins): file -> merged
+// glyphs -> atlas + recs. The caller owns the atlas image.
+font_atlas_build_from_file :: proc(asset: string) -> (f: rl.Font, atlas: rl.Image, ok: bool) {
+	cps := font_codepoints()
+	glyphs, count := font_merge_fallback(asset, FONT_FALLBACK_ASSET, FONT_BASE_SIZE, cps[:])
+	return font_atlas_build(glyphs, count, FONT_BASE_SIZE)
+}
