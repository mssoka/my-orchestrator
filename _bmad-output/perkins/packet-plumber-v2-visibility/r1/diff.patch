--- a/core/node_health.odin
+++ b/core/node_health.odin
@@ -89,6 +89,39 @@ node_health_measure :: proc(flow: ^Flow_State, topo: ^Topology, cat: ^Catalogs,
 	return units, throughput, pct
 }
 
+// node_stuck_by_class — the per-class stuck-packet breakdown at one node
+// (the gap-5 surface: the rings show THAT a node is stuck; this says WHAT —
+// which class, how many packets). Counts the same pile node_health_measure
+// sums (waiting_ticks >= 1 — packets that failed a forward attempt; the
+// no-flicker contract holds: fresh spawns/transits never count) into a
+// caller-sized per-class counts slice (indexed by class id; sized by the
+// caller, typically len(cat.packet_types)). Returns the total stuck count.
+// Pure read — never serialized, same derive-don't-record status as the
+// health surface.
+node_stuck_by_class :: proc(flow: ^Flow_State, topo: ^Topology, cat: ^Catalogs, slot: u32, counts: []u32) -> (total: u32) {
+	if slot >= u32(len(topo.node_alive)) || !topo.node_alive[slot] {
+		return 0
+	}
+	node_id := topo.node_id[slot]
+	for i in 0..<len(flow.packets) {
+		p := &flow.packets[i]
+		if p.delivered || p.on_edge {
+			continue
+		}
+		if p.at_node != node_id {
+			continue
+		}
+		if p.waiting_ticks == 0 {
+			continue // the no-flicker contract: fresh spawns/transits never strain
+		}
+		total += 1
+		if int(p.class) < len(counts) {
+			counts[p.class] += 1
+		}
+	}
+	return total
+}
