index 0000000..7a1f4c7
--- /dev/null
+++ b/app/render/visibility.odin
@@ -0,0 +1,197 @@
+package render
+
+// visibility.odin — Job packet-plumber-v2-visibility (2026-08-16): make the
+// invisible chokepoints visible IN the game (user ruling 2026-08-14: "if
+// players need a manual to play, that's a design failure"). Two app-layer
+// surfaces, drawn by the app's draw_hud (NEVER by the harness T2 capture
+// path — goldens cannot shift by construction, the 5.2 card precedent):
+//
+//   draw_pool_gauge   — gap 1: the E22 pool cap + map-wide shedding had NO
+//                       HUD surface; the only symptom was the spawn-drop
+//                       cascade + the SLA gauges. This is the surface: the
+//                       in-flight count vs the cap (pool_max_packets), a
+//                       fill bar colored by the same warnings thresholds the
+//                       rest of the telegraph uses (node amber/red pcts — one
+//                       vocabulary, the 5.2 coherence choice), and a
+//                       "SHEDDING +N" tag when E22 drops landed in the recent
+//                       window (map-wide sheds have no per-link home — the
+//                       gauge IS the E22 marker).
+//   draw_drop_markers — gap 2: drops are recorded per tick (class, reason,
+//                       bundle) for the crisis engine but never rendered —
+//                       no marker where the ladder shed. This draws one
+//                       fading marker per bundle that shed E9 in the recent
+//                       window, at the bundle's midpoint (bundle_lo/hi —
+//                       the same canonical pair the crisis engine names).
+//                       E22 sites (NO_BUNDLE) are map-wide by construction —
+//                       they ride the pool gauge's SHEDDING tag, never a map
+//                       marker (the explainer's own framing: "map-wide by
+//                       construction").
+//
+// Both read EXISTING per-tick data only: the app copies state.flow.drop_sites
+// (the per-tick scratch event_emit_drop appends) into a short app-side ring
+// after each step, then passes it here. Nothing is re-derived or re-recorded
+// — no serialization change, no LOG_VERSION bump, T1 byte-identical (the
+// green harness run is the proof). ASCII-only literals (lint gate 6).
+
+import "core:fmt"
+import pp "../../core"
+import rl "vendor:raylib"
+
+// Drop_Mark — one shed site in the app's presentation ring (app-owned; the
+// per-tick scratch is cleared each flow_step, so the app keeps a ~2 s window
+// for display). Mirrors core's Drop_Site — the app copies the scratch
+// verbatim, never re-derives it. `lo`/`hi` snapshot the shed bundle's
+// canonical (min,max) endpoint node pair AT SHED TIME: bundle slots are
+// renumbered on every topology change (bundles_rebuild), so the draw must
+// verify the pair still names the same bundle before anchoring (edge-hunter
+// r1: a mid-window rebuild could otherwise misanchor a marker on a different
+// live bundle that inherited the slot).
+Drop_Mark :: struct {
+	tick:   u64, // the sim tick the shed landed on
+	class:  u16, // packet_types index
+	reason: pp.Drop_Reason, // E9 Queue_Overflow / E22 Pool_Exhaustion
+	bundle: u32, // E9: the shed bundle; E22: NO_BUNDLE (map-wide)
+	lo:     u32, // the bundle's canonical min-endpoint node id at shed time
+	hi:     u32, // the bundle's canonical max-endpoint node id at shed time
+}
+
+// DROP_MARK_WINDOW — the marker/SHEDDING display window in ticks (2 s @ 20 Hz
+// logic — long enough to read, short enough to not smear the map).
+DROP_MARK_WINDOW :: 40
+
+// draw_pool_gauge — gap 1: the pool-pressure HUD line. `x`,`y` = top-left
+// (the app anchors it above the SLA gauges in the bottom-left report block).
+// The bar fill = len(flow.packets) / balance.pool_max_packets — the exact
+// in-flight count the E22 guard compares against the cap (flow_try_spawn), so
+// the gauge reads the sim's own truth. Colors by the balance `warnings` node
+// thresholds (green < amber, amber < red, red ≥) — the same ladder the rings
+// use, so the whole telegraph speaks one vocabulary. The SHEDDING tag counts
+// E22 sites in the window (map-wide sheds — the gauge is their marker).
+// Quiet at green: the bar is the count's context, not a scream; the tag draws
+// ONLY while shedding.
+draw_pool_gauge :: proc(v: ^View, flow: ^pp.Flow_State, cat: ^pp.Catalogs, marks: []Drop_Mark, tick: u64, x, y: i32) {
+	p := v.palette
+	cap := u32(max(1, cat.balance.pool_max_packets))
+	in_flight := u32(len(flow.packets))
+	pct := in_flight * 100 / cap
+	col := p.state_healthy
+	if pct >= u32(cat.balance.warnings.node_red_pct) {
+		col = p.state_critical
+	} else if pct >= u32(cat.balance.warnings.node_amber_pct) {
+		col = p.state_congested
+	}
+	label := fmt.aprintf("POOL %d/%d", in_flight, cap, allocator = context.temp_allocator)
+	draw_text_c(v, label, x, y, 15, p.ink)
+
+	// the fill bar (chunky, like the health meter — 8 px per 10% at 80 px)
+	bar_x := x + 118
+	bar_y := y + 4
+	bar_w := i32(80)
+	bar_h := i32(9)
+	rl.DrawRectangle(bar_x, bar_y, bar_w, bar_h, p.ink_soft)
+	fill := min(i32(pct), 100) * bar_w / 100 // clamp: a bad cap must not draw off-frame (edge-hunter r1)
+	if fill > 0 {
+		rl.DrawRectangle(bar_x, bar_y, fill, bar_h, col)
+	}
+	rl.DrawRectangleLines(bar_x, bar_y, bar_w, bar_h, p.ink)
+
+	// the SHEDDING tag — E22 sites in the window (map-wide sheds; the gauge
+	// is their marker, the explainer's "map-wide by construction")
+	e22 := u32(0)
+	for m in marks {
+		if m.reason == .Pool_Exhaustion && tick - m.tick < DROP_MARK_WINDOW {
+			e22 += 1
+		}
+	}
+	if e22 > 0 {
+		tag := fmt.aprintf("SHEDDING +%d", e22, allocator = context.temp_allocator)
+		draw_text_c(v, tag, x + 210, y, 14, p.state_critical)
+	}
+}
+
+// draw_drop_markers — gap 2: one fading marker per bundle that shed E9 in the
+// window, at the bundle midpoint (the canonical bundle_lo/hi node pair — the
+// same pair the crisis engine names as the bottleneck). Aggregates the count
+// per bundle; alpha fades over the window (oldest mark anchors the fade). E22
+// sites (NO_BUNDLE) never draw here — they ride the pool gauge's tag. A
+// bundle that died mid-window simply has no screen anchor — skipped.
+draw_drop_markers :: proc(v: ^View, topo: ^pp.Topology, bundles: ^pp.Bundles, marks: []Drop_Mark, tick: u64) {
+	if len(marks) == 0 {
+		return
+	}
+	p := v.palette
+	// aggregate per bundle: count + newest tick in the window. The (lo,hi)
+	// canonical node pair rides the aggregation key — bundle SLOTS are
+	// renumbered on every topology change, so two marks on the same slot but
+	// different bundles must never merge (edge-hunter r1).
+	Bundle_Mark :: struct {
+		bundle: u32,
+		lo:     u32,
+		hi:     u32,
+		count:  u32,
+		newest: u64,
+	}
+	agg := make([dynamic]Bundle_Mark, 0, 8, context.temp_allocator)
+	defer delete(agg)
+	for m in marks {
+		if m.reason != .Queue_Overflow || m.bundle == pp.NO_BUNDLE {
+			continue
+		}
+		if tick - m.tick >= DROP_MARK_WINDOW {
+			continue
+		}
+		found := false
+		for i in 0..<len(agg) {
+			if agg[i].bundle == m.bundle && agg[i].lo == m.lo && agg[i].hi == m.hi {
+				agg[i].count += 1
+				if m.tick > agg[i].newest {
+					agg[i].newest = m.tick
+				}
+				found = true
+				break
+			}
+		}
+		if !found {
+			append(&agg, Bundle_Mark{bundle = m.bundle, lo = m.lo, hi = m.hi, count = 1, newest = m.tick})
+		}
+	}
+	for bm in agg {
+		if int(bm.bundle) >= int(bundles.n) {
+			continue
+		}
+		// the identity guard (edge-hunter r1): the CURRENT bundle at this
+		// slot must be the SAME canonical pair the mark was shed on — a
+		// mid-window topology change renumbers slots, and a different live
+		// bundle may now occupy this slot. Never misanchor a marker.
+		if bundles.bundle_lo[bm.bundle] != bm.lo || bundles.bundle_hi[bm.bundle] != bm.hi {
+			continue
+		}
+		lo_slot, okl := pp.node_slot(topo, bm.lo)
+		hi_slot, okh := pp.node_slot(topo, bm.hi)
+		if !okl || !okh {
+			continue // the bundle's endpoints are gone — no anchor
+		}
+		a := node_screen(v, topo.node_pos[lo_slot])
+		b := node_screen(v, topo.node_pos[hi_slot])
+		mid := rl.Vector2{(a.x + b.x) / 2, (a.y + b.y) / 2}
+		age := tick - bm.newest
+		if age >= DROP_MARK_WINDOW {
+			continue
+		}
+		alpha := 1.0 - f32(age) / f32(DROP_MARK_WINDOW)
+		if alpha < 0.15 {
+			continue // effectively gone
+		}
+		col := p.state_critical
+		col.a = u8(f32(col.a) * alpha)
+		// the marker: a small cross (shape, never color alone — the canon) +
+		// the aggregated count. A cross reads "drop here" without colliding
+		// with the ring+glyph node telegraph.
+		s := v.tile_px * v.scale
+		r := s * 0.22
+		rl.DrawLineEx({mid.x - r, mid.y - r}, {mid.x + r, mid.y + r}, 2.5 * v.scale, col)
+		rl.DrawLineEx({mid.x - r, mid.y + r}, {mid.x + r, mid.y - r}, 2.5 * v.scale, col)
+		cnt := fmt.aprintf("x%d", bm.count, allocator = context.temp_allocator)
+		draw_text_c(v, cnt, i32(mid.x) + i32(r) + 3, i32(mid.y) - 9, 13, col)
+	}
+}
