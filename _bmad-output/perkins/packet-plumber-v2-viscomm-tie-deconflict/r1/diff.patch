 	return h
 }
 
+// --- v2-viscomm-tie (2026-08-25): the tie/warning de-conflict pins ------------
+// Finding A of the vis-comm audit: route_tie was RGB-identical to
+// state_congested modulo alpha (242,181,68) — two unrelated meanings sharing
+// hue AND shape (both solid node rings). These pins hold BOTH levers of the
+// fix so a revert to the amber solid ring fails CI, not playtesting:
+// (a) HUE — route_tie is the info-violet family, far from the amber warning
+//     AND >= 15 deg from every pipe tier (so the ring never reads as a tier);
+// (b) SHAPE — the tie mark is a DASHED ring (tie_dash_on pattern), never the
+//     warning telegraph's solid ring.
+@(test)
+route_tie_is_hue_distinct_from_warning_and_pipe_tiers :: proc(t: ^testing.T) {
+	p := palette_load()
+	// the exact shipped bytes (load path + fallback — the data-token pin)
+	expect_color(t, p.route_tie, {150, 94, 232, 235})
+	f := fallback_palette()
+	expect_color(t, f.route_tie, {150, 94, 232, 235})
+	// hue-family exit: the warning telegraph is warm (red-max, blue-min);
+	// the tie mark must NOT be in that family (integer channel ordering).
+	testing.expect(t, p.state_congested.r > p.state_congested.g && p.state_congested.g > p.state_congested.b,
+		"sanity: state_congested must stay in the warm family")
+	testing.expect(t, !(p.route_tie.r > p.route_tie.g && p.route_tie.g > p.route_tie.b),
+		"route_tie must NOT share the warm warning family")
+	// >= 15 deg from every pipe tier (the ring must never read as a tier)
+	tie_h := hue_degrees(p.route_tie)
+	tiers := [3]rl.Color{p.pipe_copper, p.pipe_steel, p.pipe_fiber}
+	for tier, i in tiers {
+		d := abs(tie_h - hue_degrees(tier))
+		d = min(d, 360 - d)
+		testing.expectf(t, d >= 15, "route_tie vs pipe tier %s hue delta %.1f deg < 15", fmt_tok(i), d)
+	}
+}
+
+@(test)
+route_tie_mark_is_a_dashed_ring_not_a_solid_warning_shape :: proc(t: ^testing.T) {
+	// the shape leg: the dash modulation itself (deleting it — reverting
+	// draw_tie_mark to a solid DrawCircleLinesV ring like the warning
+	// telegraph — must fail here or the pin is vacuous).
+	testing.expect(t, TIE_DASH_SEG >= 2, "a dash needs >= 2 consecutive segments to read as a dash")
+	testing.expect(t, TIE_DASH_COUNT >= 4, "fewer than 4 dashes reads as a broken ring, not a dashed one")
+	on := 0
+	for i in 0 ..< SPAWN_RING_SEGS {
+		if tie_dash_on(i) {
+			on += 1
+		}
+	}
+	// exactly half the fan is dash: any always-true revert (solid ring)
+	// or pattern break changes this count.
+	testing.expectf(t, on == SPAWN_RING_SEGS / 2,
+		"dash duty cycle must be 1/2 (on=%d of %d)", on, SPAWN_RING_SEGS)
+	// the pattern alternates in TIE_DASH_SEG-wide runs (run 0 on, run 1 off,
+	// run 2 on, ...) — spot-check the run boundaries.
+	testing.expect(t, tie_dash_on(0), "run 0 must be on")
+	testing.expect(t, !tie_dash_on(TIE_DASH_SEG), "run 1 must be off")
+	testing.expect(t, tie_dash_on(2 * TIE_DASH_SEG), "run 2 must be on")
+}
+
