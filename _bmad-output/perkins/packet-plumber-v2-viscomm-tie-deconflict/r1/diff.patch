+// TIE_DASH_SEG / TIE_DASH_COUNT — the shape-distinctness pins for the tie
+// mark (viscomm audit finding A, 2026-08-25): the equal-cost cue must read
+// as INFORMATION, not warning. The node-health telegraph is a SOLID amber
+// ring; the tie mark is a DASHED info-violet ring (6 dashes of 30 deg = 3
+// table segments on, 3 off around the 36-seg SPAWN_RING_TABLE fan — the
+// annulus-quad precedent, no transcendentals). The test pins these so a
+// revert to a solid ring or the amber family fails CI.
+TIE_DASH_SEG :: 3 // consecutive table segments per dash (30 deg at 36 segs)
+TIE_DASH_COUNT :: SPAWN_RING_SEGS / (2 * TIE_DASH_SEG) // = 6 dashes
+
+// tie_dash_on — is table segment `i` part of a dash? Pure, so the render
+// test can pin the pattern itself (deleting the dash modulation — reverting
+// to a solid warning-shaped ring — fails the pin, not just playtesting).
+tie_dash_on :: proc(i: int) -> bool {
+	return (i / TIE_DASH_SEG) % 2 == 0
+}
+
+// draw_tie_mark — the T2 equal-cost cue at a split node: a DASHED info-violet
+// ring around the node + the rule caption ("equal cost - split by hash" —
+// ASCII, gate 6; a split never looks random: both branches glow and the node
+// names the rule). Shape + hue both de-conflicted from the SOLID amber
+// congestion-warning telegraph (never color alone — ring + caption here,
+// ring + glyph + pulse there).
 draw_tie_mark :: proc(v: ^View, topo: ^pp.Topology, node_id: u32) {
 	p := v.palette
 	slot, ok := pp.node_slot(topo, node_id)
@@ -480,8 +500,23 @@ draw_tie_mark :: proc(v: ^View, topo: ^pp.Topology, node_id: u32) {
 	col := p.route_tie
 	r := s * 0.62
 	th := 2.5 * v.scale
-	for k in 0..<i32(th) {
-		rl.DrawCircleLinesV(c, r - f32(k) * v.scale, col)
+	r_in, r_out := r - th * 0.5, r + th * 0.5
+	table := SPAWN_RING_TABLE // local copy — a constant can't be indexed by a runtime index
+	for i in 0 ..< SPAWN_RING_SEGS {
+		// dash pattern: TIE_DASH_SEG segments on, TIE_DASH_SEG off
+		if !tie_dash_on(i) {
+			continue
+		}
+		j := (i + 1) % SPAWN_RING_SEGS
+		a1 := table[i]
+		a2 := table[j]
+		p1o := rl.Vector2{c.x + a1[0] * r_out, c.y + a1[1] * r_out}
+		p2o := rl.Vector2{c.x + a2[0] * r_out, c.y + a2[1] * r_out}
+		p1i := rl.Vector2{c.x + a1[0] * r_in, c.y + a1[1] * r_in}
+		p2i := rl.Vector2{c.x + a2[0] * r_in, c.y + a2[1] * r_in}
+		// CCW winding (the draw_ring_annulus precedent — rlgl culls BACK)
+		rl.DrawTriangle(p1o, p1i, p2o, col)
+		rl.DrawTriangle(p2o, p1i, p2i, col)
 	}
 	caption := "equal cost - split by hash"
 	fs := i32(max(11, s * 0.30))
