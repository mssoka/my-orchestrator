+// TIE_DASH_SEG / TIE_DASH_COUNT — the shape-distinctness pins for the tie
+// mark (viscomm audit finding A, 2026-08-25): the equal-cost cue must read
+// as INFORMATION, not warning. The node-health telegraph is a SOLID amber
+// ring; the tie mark is a DASHED info-violet ring (TIE_DASH_SEG table
+// segments on, TIE_DASH_SEG off, around the SPAWN_RING_TABLE fan — the
+// annulus-quad precedent, no transcendentals). The count is DERIVED from the
+// fan size, never hard-coded; the `when` below keeps the derivation honest
+// at compile time (r1 N3: the old "6 dashes"/"30 deg" comments could rot
+// silently if SPAWN_RING_SEGS changed).
+TIE_DASH_SEG :: 3 // consecutive table segments per dash
+TIE_DASH_COUNT :: SPAWN_RING_SEGS / (2 * TIE_DASH_SEG) // dashes around the fan (derived)
+
+when SPAWN_RING_SEGS % (2 * TIE_DASH_SEG) != 0 {
+	// compile-time trip (r1 N3): a mis-aligned dash pattern cannot build —
+	// constant division by zero is a compile error when this branch is live.
+	TIE_DASH_TILING_BROKEN :: 1 / 0
+}
+
+// tie_dash_on — is table segment `i` part of a dash? Pure, so the render
+// test can pin the pattern itself (deleting the dash modulation — reverting
+// to a solid warning-shaped ring — fails the pin, not just playtesting).
+tie_dash_on :: proc(i: int) -> bool {
+	return (i / TIE_DASH_SEG) % 2 == 0
+}
+
+// tie_dash_segments — the per-segment DRAW ENUMERATION: exactly the table
+// segments draw_tie_mark draws (its quad loop consumes this array — the r1
+// blocker fix: the drawn set and the pinned set are the same bytes, and the
+// harness pixel-scans the ring itself). The FIXED length is load-bearing:
+// a solid-ring revert (the tie_dash_on guard deleted here) overruns the
+// array and fails the render tests instead of passing them.
+tie_dash_segments :: proc() -> [TIE_DASH_COUNT * TIE_DASH_SEG]int {
+	segs: [TIE_DASH_COUNT * TIE_DASH_SEG]int
+	n := 0
+	for i in 0 ..< SPAWN_RING_SEGS {
+		if !tie_dash_on(i) {
+			continue
+		}
+		segs[n] = i
+		n += 1
+	}
+	return segs
+}
+
+// draw_tie_mark — the T2 equal-cost cue at a split node: a DASHED info-violet
+// ring around the node + the rule caption ("equal cost - split by hash" —
+// ASCII, gate 6; a split never looks random: both branches glow and the node
+// names the rule). Shape + hue both de-conflicted from the SOLID amber
+// congestion-warning telegraph (never color alone — ring + caption here,
+// ring + glyph + pulse there).
 draw_tie_mark :: proc(v: ^View, topo: ^pp.Topology, node_id: u32) {
 	p := v.palette
 	slot, ok := pp.node_slot(topo, node_id)
@@ -480,9 +527,19 @@ draw_tie_mark :: proc(v: ^View, topo: ^pp.Topology, node_id: u32) {
 	col := p.route_tie
 	r := s * 0.62
 	th := 2.5 * v.scale
-	for k in 0..<i32(th) {
-		rl.DrawCircleLinesV(c, r - f32(k) * v.scale, col)
+	r_in, r_out := r - th * 0.5, r + th * 0.5
+	// degenerate guard (the draw_ring_annulus precedent — r1 N7: a zero/negative
+	// radius or fully transparent ring must early-return like its sibling).
+	if r_out <= 0 || r_in < 0 || col.a == 0 {
+		return
 	}
+	// the dashed ring: the draw path CONSUMES the pinned enumeration —
+	// tie_dash_segments() is the single source of the drawn set (the r1
+	// blocker fix: a solid-ring revert must come through the enumeration,
+	// where it fails the fixed length; the harness pixel-scans the ring to
+	// pin this end-to-end).
+	segs := tie_dash_segments()
+	draw_ring_segments(v, c, r_in, r_out, col, segs[:])
 	caption := "equal cost - split by hash"
 	fs := i32(max(11, s * 0.30))
 	cw := i32(len(caption)) * fs / 2
