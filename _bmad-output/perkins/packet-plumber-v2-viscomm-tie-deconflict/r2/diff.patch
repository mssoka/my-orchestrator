diff --git a/app/render/palette_polish_test.odin b/app/render/palette_polish_test.odin
index a9aa9db..040276d 100644
--- a/app/render/palette_polish_test.odin
+++ b/app/render/palette_polish_test.odin
@@ -131,6 +131,98 @@ hue_degrees :: proc(c: rl.Color) -> f32 {
 	return h
 }
 
+// --- v2-viscomm-tie (2026-08-25): the tie/warning de-conflict pins ------------
+// Finding A of the vis-comm audit: route_tie was RGB-identical to
+// state_congested modulo alpha (242,181,68) — two unrelated meanings sharing
+// hue AND shape (both solid node rings). These pins hold BOTH levers of the
+// fix so a revert to the amber solid ring fails CI, not playtesting:
+// (a) HUE — route_tie is the info-violet family, far from the amber warning
+//     AND >= 15 deg from every pipe tier AND every router tier ring (r1 W2:
+//     router tiers are node-centered rings on routers too — exactly where
+//     ECMP split nodes sit; the old 3-pipe array missed the 14.0deg collision
+//     with router_tier_high) + >= 90 deg from state_congested (r1 N8: the
+//     numeric pin, not just the channel-ordering classifier);
+// (b) SHAPE — the tie mark is a DASHED ring: the pattern AND the draw-path
+//     enumeration (tie_dash_segments — what draw_tie_mark consumes), never
+//     the warning telegraph's solid ring (the harness pixel-scans the ring
+//     itself: palcheck section 5).
+@(test)
+route_tie_is_hue_distinct_from_warning_and_pipe_tiers :: proc(t: ^testing.T) {
+	p := palette_load()
+	// the exact shipped bytes (load path + fallback — the data-token pin)
+	// r2: hue 280 (#BA5EE8) — shifted off 264 to clear the 15 deg node-signal
+	// canon vs router_tier_high (250.3 deg).
+	expect_color(t, p.route_tie, {186, 94, 232, 235})
+	f := fallback_palette()
+	expect_color(t, f.route_tie, {186, 94, 232, 235})
+	// hue-family exit: the warning telegraph is warm (red-max, blue-min);
+	// the tie mark must NOT be in that family (integer channel ordering).
+	testing.expect(t, p.state_congested.r > p.state_congested.g && p.state_congested.g > p.state_congested.b,
+		"sanity: state_congested must stay in the warm family")
+	testing.expect(t, !(p.route_tie.r > p.route_tie.g && p.route_tie.g > p.route_tie.b),
+		"route_tie must NOT share the warm warning family")
+	// >= 15 deg from every node-signal ring: pipe tiers AND router tiers (the
+	// ring must never read as a tier — r1 W2 folded the router tiers in).
+	tie_h := hue_degrees(p.route_tie)
+	tiers := [6]rl.Color{p.pipe_copper, p.pipe_steel, p.pipe_fiber,
+		p.router_tier_basic, p.router_tier_mid, p.router_tier_high}
+	for tier, i in tiers {
+		d := abs(tie_h - hue_degrees(tier))
+		d = min(d, 360 - d)
+		testing.expectf(t, d >= 15, "route_tie vs node-signal ring %s hue delta %.1f deg < 15", fmt_tok(i), d)
+	}
+	// r1 N8: the NUMERIC separation pin vs the warning head — circular hue
+	// distance >= 90 deg (a classifier alone let a magenta congested pass).
+	dc := abs(tie_h - hue_degrees(p.state_congested))
+	dc = min(dc, 360 - dc)
+	testing.expectf(t, dc >= 90, "route_tie vs state_congested hue delta %.1f deg < 90", dc)
+}
+
+@(test)
+route_tie_mark_is_a_dashed_ring_not_a_solid_warning_shape :: proc(t: ^testing.T) {
+	// the shape leg — BOTH layers (r1 blocker: the predicate-only pin was
+	// vacuous against the draw path; the enumeration + harness pixel-scan
+	// close it). Deleting the dash modulation — reverting draw_tie_mark to a
+	// solid DrawCircleLinesV-style ring like the warning telegraph — must
+	// fail here or the pin is vacuous.
+	testing.expect(t, TIE_DASH_SEG >= 2, "a dash needs >= 2 consecutive segments to read as a dash")
+	testing.expect(t, TIE_DASH_COUNT >= 4, "fewer than 4 dashes reads as a broken ring, not a dashed one")
+	on := 0
+	for i in 0 ..< SPAWN_RING_SEGS {
+		if tie_dash_on(i) {
+			on += 1
+		}
+	}
+	// exactly half the fan is dash: any always-true revert (solid ring)
+	// or pattern break changes this count.
+	testing.expectf(t, on == SPAWN_RING_SEGS / 2,
+		"dash duty cycle must be 1/2 (on=%d of %d)", on, SPAWN_RING_SEGS)
+	// the pattern alternates in TIE_DASH_SEG-wide runs (run 0 on, run 1 off,
+	// run 2 on, ...) — spot-check the run boundaries.
+	testing.expect(t, tie_dash_on(0), "run 0 must be on")
+	testing.expect(t, !tie_dash_on(TIE_DASH_SEG), "run 1 must be off")
+	testing.expect(t, tie_dash_on(2 * TIE_DASH_SEG), "run 2 must be on")
+	// the DRAW-PATH enumeration pin (r1 blocker fix): draw_tie_mark's quad
+	// loop consumes tie_dash_segments(), so the DRAWN set == this array —
+	// assert set equality against the pattern, both directions. The fixed
+	// array length means a deleted tie_dash_on guard inside the enumeration
+	// PANICS the bounds check here (a solid revert cannot sneak through).
+	segs := tie_dash_segments()
+	testing.expectf(t, len(segs) == SPAWN_RING_SEGS / 2,
+		"the draw enumeration must carry half the fan (got %d of %d)", len(segs), SPAWN_RING_SEGS)
+	k := 0
+	for i in 0 ..< SPAWN_RING_SEGS {
+		if tie_dash_on(i) {
+			// ascending scan: the enumeration must hold exactly i, in order —
+			// a missing, extra, or out-of-place segment fails at its position.
+			testing.expectf(t, k < len(segs) && segs[k] == i,
+				"draw enumeration diverges from the dash pattern at segment %d", i)
+			k += 1
+		}
+	}
+	testing.expect(t, k == len(segs), "the enumeration covers every on-segment exactly (no extras, no gaps)")
+}
+
