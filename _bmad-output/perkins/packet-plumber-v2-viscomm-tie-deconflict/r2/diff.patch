+def strip_jsonc_comments(text):
+    """Remove `//` line comments OUTSIDE string literals. data/palette.json
+    carries inline comments (the font overhaul added them); the derivation
+    must run on the SHIPPED bytes, not a private stripped copy (r1 W1:
+    the a11y numbers were unreproducible from the repo). In-string `//` is
+    preserved; the newline is kept so parse-error line numbers stay true."""
+    out = []
+    in_str = False
+    esc = False
+    i = 0
+    while i < len(text):
+        ch = text[i]
+        if in_str:
+            out.append(ch)
+            if esc:
+                esc = False
+            elif ch == "\\":
+                esc = True
+            elif ch == '"':
+                in_str = False
+            i += 1
+            continue
+        if ch == '"':
+            in_str = True
+            out.append(ch)
+            i += 1
+            continue
+        if ch == "/" and i + 1 < len(text) and text[i + 1] == "/":
+            while i < len(text) and text[i] != "\n":
+                i += 1
+            continue
+        out.append(ch)
+        i += 1
+    return "".join(out)
+
+def load_jsonc(path):
+    return json.loads(strip_jsonc_comments(open(path).read()))
+
+PAL = load_jsonc("data/palette.json")
+PKT = load_jsonc("data/packet_types.json")
 
