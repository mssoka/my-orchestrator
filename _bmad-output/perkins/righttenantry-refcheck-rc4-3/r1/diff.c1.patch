+/// Reads the row and scopes it to the application: absent row OR a row that
+/// belongs to a different application reads as 404 (never a leaked 409 — a
+/// cross-tenant call id must not reveal another landlord's row).
+fn read_owned_row(
+  db: pog.Connection,
+  app_uuid: Uuid,
+  call_uuid: Uuid,
+) -> Result(sql.GetReferenceCallByIdRow, Response) {
+  case sql.get_reference_call_by_id(db, call_uuid) {
+    Error(err) ->
+      Error(response_helpers.json_error(
+        error_code.ServerError,
+        "Couldn't load that reference. Give it another go.",
+        500,
+      ))
