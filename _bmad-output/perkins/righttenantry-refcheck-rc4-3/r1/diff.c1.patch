+/// Updates the application's referee trio for the slot (A1 — the landlord
+/// edits the slot's trio inline; the Off-state chips + future trigger reads
+/// then see the current referee). Returns the affected row count.
+fn update_trio(
+  tx: pog.Connection,
+  app_uuid: Uuid,
+  vacancy_uuid: Uuid,
+  slot: String,
+  trio: Trio,
+) -> Result(Int, pog.QueryError) {
+  case slot {
+    "landlord_ref" ->
+      sql.update_application_referee_trio_landlord(
+        tx,
+        app_uuid,
+        vacancy_uuid,
+        trio.name,
+        trio.email,
+        trio.phone,
+      )
+      |> result.map(row_count)
+    "character_ref" ->
+      sql.update_application_referee_trio_character(
+        tx,
+        app_uuid,
+        vacancy_uuid,
+        trio.name,
+        trio.email,
+        trio.phone,
+      )
+      |> result.map(row_count)
+    "employer_ref" ->
+      sql.update_application_referee_trio_employer(
+        tx,
+        app_uuid,
+        vacancy_uuid,
+        trio.name,
+        trio.email,
+        trio.phone,
+      )
+      |> result.map(row_count)
+    _ -> Error(pog.UnexpectedArgumentCount(expected: 5, got: 0))
+  }
+}
+
+/// The returned-row count of any `pog.Returned` — the trio updates' row
+/// types differ, so each arm maps to this common `Int` immediately.
+fn row_count(returned: pog.Returned(a)) -> Int {
+  list.length(returned.rows)
+}
+
+/// Best-effort landlord-scoped audit write for a row action (the mutation
+/// already committed; a failed audit is captured, never a rollback).
+fn write_action_audit(
+  config: ServerConfig,
+  landlord_uuid: Uuid,
+  call_uuid: Uuid,
+  event: event_type.AuditEvent,
+  details: json.Json,
+) -> Nil {
+  case
+    audit_log.create(
+      config.db,
+      user_id: landlord_uuid,
+      event:,
+      entity_type: audit_entity,
+      entity_id: call_uuid,
+      details:,
+    )
+  {
+    Ok(_) -> Nil
+    Error(err) -> {
+      wisp.log_error("reference action audit failed: " <> string.inspect(err))
+      sentry_client.capture(
+        config.sentry,
+        sentry_client.BackgroundEvent(
+          event_type: "ReferenceActionAuditFailed",
+          message: "reference-call action audit write failed",
+          level: sentry_client.LevelError,
+          tags: [#("entity_id", uuid.to_string(call_uuid))],
+        ),
+      )
+    }
+  }
+}
+
+fn json_ok(body: json.Json) -> Response {
+  wisp.json_response(json.to_string(body), 200)
+}
