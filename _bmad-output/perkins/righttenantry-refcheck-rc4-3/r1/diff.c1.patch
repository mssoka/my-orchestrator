+
+fn validate_trio(trio: Trio) -> Result(Trio, Response) {
+  let name = string.trim(trio.name)
+  let email = string.trim(trio.email)
+  let phone = string.trim(trio.phone)
+  case name, email, phone {
+    "", _, _ ->
+      Error(response_helpers.json_error(
+        error_code.InvalidPayload,
+        "Add the referee's name to save these details.",
+        400,
+      ))
+    _, "", "" ->
+      Error(response_helpers.json_error(
+        error_code.InvalidPayload,
+        "Add an email or phone number to save these details.",
