diff --git a/server/src/reference_checks/actions_handler.gleam b/server/src/reference_checks/actions_handler.gleam
new file mode 100644
index 00000000..27d764f3
--- /dev/null
+++ b/server/src/reference_checks/actions_handler.gleam
@@ -0,0 +1,686 @@
+//// RC4.3 landlord row actions (Story RC4.3): the control surface the panel
+//// wires to — take over manually (A7 warm handoff), correct the referee
+//// trio (AD-7/A1 landlord-driven correction, one cycle), and substitute a
+//// referee after a terminal objection/unreachable (AD-11 hook semantics).
+//// The pre-trigger start/skip/re-enable APIs live in `trigger.gleam` (RC2.3);
+//// this module owns the row-scoped actions that mutate an existing row.
+////
+//// Every endpoint is ownership-checked (three-UUID + application-ownership
+//// + archived-vacancy prechecks — the `handle_update_status` pattern) and
+//// guarded on the row's expected pre-state (AD-14): a single guarded
+//// UPDATE/INSERT, a 0-row result means someone else transitioned first and
+//// the writer stands down with a branded 409. The row id in the path is
+//// scoped to the application (the SQL guards `application_id`), so a
+//// cross-application row reads as 404, never as a leaked 409.
+////
+//// Correction + substitution write their audit rows INSIDE the same
+//// transaction as the mutation (Tier 1 — the AD-16 trail never diverges
+//// from the state change); takeover follows the webhook posture (guarded
+//// single-UPDATE, then best-effort audit).
+
+import application/sql as app_sql
+import audit/audit_log
+import audit/event_type
+import config.{type ServerConfig}
+import gleam/dynamic/decode
+import gleam/json
+import gleam/list
+import gleam/result
+import gleam/string
+import pog
+import response_helpers
+import retention/audit_log_schema as alog
+import sentry/sentry_client
+import shared/error_code
+import shared/landlord.{type Landlord}
+import wisp.{type Request, type Response}
+import youid/uuid.{type Uuid}
+
+import ai/sql as ai_sql
+import reference_checks/sql
+
+/// `entity_type` for every `reference_call` lifecycle audit row (AD-16).
+const audit_entity: String = "reference_call"
+
+// ---------------------------------------------------------------------------
+// Take over manually (A7 warm handoff, UX §7.7)
+// ---------------------------------------------------------------------------
+
+/// `POST /api/v1/vacancies/:vid/applications/:aid/reference-checks/:call_id/take-over`
+/// — the landlord takes the check over manually. Guarded on the waiting
+/// states + `unreachable` (§7.7); writes ONLY `taken_over_at` (the sweep
+/// stops sending — its SELECT already filters `taken_over_at IS NULL`), and
+/// the form link stays live: a late completion still guarded-transitions to
+/// `form_completed` and notifies (§8.6).
+pub fn handle_take_over(
+  _req: Request,
+  config: ServerConfig,
+  landlord: Landlord,
+  vacancy_id: String,
+  application_id: String,
+  call_id: String,
+) -> Response {
+  case parse_uuids(application_id, landlord.id, vacancy_id, call_id) {
+    Error(resp) -> resp
+    Ok(#(app_uuid, landlord_uuid, vacancy_uuid, call_uuid)) ->
+      run_action_with_prechecks(
+        config,
+        app_uuid,
+        landlord_uuid,
+        vacancy_uuid,
+        fn() { do_take_over(config, app_uuid, landlord_uuid, call_uuid) },
+      )
+  }
+}
+
+pub fn do_take_over(
+  config: ServerConfig,
+  app_uuid: Uuid,
+  landlord_uuid: Uuid,
+  call_uuid: Uuid,
+) -> Response {
+  let db = config.db
+  // Read first: distinguishes 404 (row absent / another application) from
+  // 409 (row present but not in a take-over-able state / already taken).
+  case read_owned_row(db, app_uuid, call_uuid) {
+    Error(resp) -> resp
+    Ok(row) ->
+      case sql.take_over_reference_call(db, call_uuid, app_uuid) {
+        Ok(pog.Returned(_, [_, ..])) -> {
+          write_action_audit(
+            config,
+            landlord_uuid,
+            call_uuid,
+            event_type.ReferenceCallTakenOver,
+            json.object([
+              alog.non_pii(alog.RefSlot, json.string(row.ref_slot)),
+              alog.non_pii(alog.From, json.string(row.status)),
+              alog.non_pii(alog.To, json.string("taken_over")),
+            ]),
+          )
+          json_ok(json.object([#("taken_over", json.bool(True))]))
+        }
+        Ok(_) ->
+          response_helpers.json_error(
+            error_code.Conflict,
+            "That reference isn't in a state you can take over right now. Refresh and try again.",
+            409,
+          )
+        Error(err) -> {
+          wisp.log_error("reference take-over failed: " <> string.inspect(err))
+          response_helpers.json_error(
+            error_code.ServerError,
+            "Couldn't take over that reference. Give it another go.",
+            500,
+          )
+        }
+      }
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Correct (AD-7/A1 landlord-driven correction, one cycle — UX §8.3)
+// ---------------------------------------------------------------------------
+
+/// `POST /api/v1/vacancies/:vid/applications/:aid/reference-checks/:call_id/correct`
+/// — the landlord edits the slot's trio inline after a delivery failure. The
+/// corrected values land in `corrected_name/email/phone` (the immutable
+/// `contact_*` snapshot is NEVER touched, A1), the application trio is
+/// updated (the applicant's confirmation is the attestation forewarning), and
+/// the row re-queues (`queued`, `next_attempt_at = now()`) so the sweep owns
+/// the fresh invite (AD-14). `correction_cycles` bumps to 1 — the row's
+/// `awaiting_correction` guard IS the one-cycle rule: a second `correct`
+/// call on a non-awaiting row 409s.
+pub fn handle_correct(
+  req: Request,
+  config: ServerConfig,
+  landlord: Landlord,
+  vacancy_id: String,
+  application_id: String,
+  call_id: String,
+) -> Response {
+  use json_body <- wisp.require_json(req)
+  case decode.run(json_body, trio_decoder()) {
+    Error(_) ->
+      response_helpers.json_error(
+        error_code.InvalidPayload,
+        "Couldn't save those details. Check the form and try again.",
+        400,
+      )
+    Ok(trio) ->
+      case validate_trio(trio) {
+        Error(resp) -> resp
+        Ok(clean) ->
+          case parse_uuids(application_id, landlord.id, vacancy_id, call_id) {
+            Error(resp) -> resp
+            Ok(#(app_uuid, landlord_uuid, vacancy_uuid, call_uuid)) ->
+              run_action_with_prechecks(
+                config,
+                app_uuid,
+                landlord_uuid,
+                vacancy_uuid,
+                fn() {
+                  do_correct(
+                    config,
+                    app_uuid,
+                    landlord_uuid,
+                    vacancy_uuid,
+                    call_uuid,
+                    clean,
+                  )
+                },
+              )
+          }
+      }
+  }
+}
+
+pub fn do_correct(
+  config: ServerConfig,
+  app_uuid: Uuid,
+  landlord_uuid: Uuid,
+  vacancy_uuid: Uuid,
+  call_uuid: Uuid,
+  trio: Trio,
+) -> Response {
+  let run = fn(tx: pog.Connection) {
+    // Read first for the 404/409 split + the audit's slot/status.
+    case sql.get_reference_call_by_id(tx, call_uuid) {
+      Error(err) -> Error(DbFailure(err))
+      Ok(pog.Returned(_, [])) -> Error(RowNotFound)
+      Ok(pog.Returned(_, [row, ..])) ->
+        case row.application_id == uuid.to_string(app_uuid) {
+          False -> Error(RowNotFound)
+          True ->
+            case
+              sql.correct_reference_call(
+                tx,
+                call_uuid,
+                app_uuid,
+                trio.name,
+                trio.email,
+                trio.phone,
+              )
+            {
+              Error(err) -> Error(DbFailure(err))
+              // 0 rows: the row left `awaiting_correction` between the read and
+              // the guard (raced, or the guard's one-cycle rule already spent).
+              Ok(pog.Returned(_, [])) -> Error(NotAwaitingCorrection)
+              Ok(pog.Returned(_, [_, ..])) ->
+                case
+                  update_trio(tx, app_uuid, vacancy_uuid, row.ref_slot, trio)
+                {
+                  Error(err) -> Error(DbFailure(err))
+                  Ok(_) ->
+                    case
+                      audit_log.create(
+                        tx,
+                        user_id: landlord_uuid,
+                        event: event_type.ReferenceCallCorrected,
+                        entity_type: audit_entity,
+                        entity_id: call_uuid,
+                        details: json.object([
+                          alog.non_pii(alog.RefSlot, json.string(row.ref_slot)),
+                          alog.non_pii(
+                            alog.From,
+                            json.string("awaiting_correction"),
+                          ),
+                          alog.non_pii(alog.To, json.string("queued")),
+                        ]),
+                      )
+                    {
+                      Ok(_) -> Ok(True)
+                      Error(err) -> Error(DbFailure(err))
+                    }
+                }
+            }
+        }
+    }
+  }
+  case pog.transaction(config.db, run) {
+    Ok(True) -> json_ok(json.object([#("corrected", json.bool(True))]))
+    Error(pog.TransactionRolledBack(RowNotFound)) ->
+      response_helpers.json_error(
+        error_code.NotFound,
+        "That reference check isn't there anymore. Refresh and try again.",
+        404,
+      )
+    Error(pog.TransactionRolledBack(NotAwaitingCorrection)) ->
+      response_helpers.json_error(
+        error_code.Conflict,
+        "That reference isn't waiting on a correction anymore. Refresh and try again.",
+        409,
+      )
+    Error(pog.TransactionRolledBack(NotSubstitutable)) ->
+      // Unreachable from the correct path — the shared ActionError type
+      // keeps the case total.
+      response_helpers.json_error(
+        error_code.Conflict,
+        "That reference can't be changed right now. Refresh and try again.",
+        409,
+      )
+    Error(pog.TransactionRolledBack(DbFailure(err))) ->
+      db_failure("reference correction failed: " <> string.inspect(err))
+    Error(pog.TransactionQueryError(err)) ->
+      db_failure("reference correction failed: " <> string.inspect(err))
+    Ok(_) ->
+      // Unreachable: the run closure only ever returns Ok(True); a
+      // defensive arm keeps the case total.
+      db_failure("reference correction: unexpected transaction result")
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Substitute referee (AD-11 hook semantics — UX §8.2)
+// ---------------------------------------------------------------------------
+
+/// `POST /api/v1/vacancies/:vid/applications/:aid/reference-checks/:call_id/substitute`
+/// — after a terminal `objected`/`unreachable` (the `can_substitute_referee`
+/// set), the landlord swaps in a NEW referee via the same inline edit-trio.
+/// A NEW `reference_call` row is created for the slot (`queued`,
+/// `next_attempt_at = now()` — the sweep owns the invite) with the new trio
+/// as its immutable snapshot; the prior row is retained as history. The
+/// audit entry carries old + new row ids (AD-16). Idempotent: the live-slot
+/// partial unique index makes a double-submit a silent no-op (200 — the
+/// successor row already occupies the slot).
+pub fn handle_substitute(
+  req: Request,
+  config: ServerConfig,
+  landlord: Landlord,
+  vacancy_id: String,
+  application_id: String,
+  call_id: String,
+) -> Response {
+  use json_body <- wisp.require_json(req)
+  case decode.run(json_body, trio_decoder()) {
+    Error(_) ->
+      response_helpers.json_error(
+        error_code.InvalidPayload,
+        "Couldn't save those details. Check the form and try again.",
+        400,
+      )
+    Ok(trio) ->
+      case validate_trio(trio) {
+        Error(resp) -> resp
+        Ok(clean) ->
+          case parse_uuids(application_id, landlord.id, vacancy_id, call_id) {
+            Error(resp) -> resp
+            Ok(#(app_uuid, landlord_uuid, vacancy_uuid, call_uuid)) ->
+              run_action_with_prechecks(
+                config,
+                app_uuid,
+                landlord_uuid,
+                vacancy_uuid,
+                fn() {
+                  do_substitute(
+                    config,
+                    app_uuid,
+                    landlord_uuid,
+                    vacancy_uuid,
+                    call_uuid,
+                    clean,
+                  )
+                },
+              )
+          }
+      }
+  }
+}
+
+pub fn do_substitute(
+  config: ServerConfig,
+  app_uuid: Uuid,
+  landlord_uuid: Uuid,
+  vacancy_uuid: Uuid,
+  call_uuid: Uuid,
+  trio: Trio,
+) -> Response {
+  let run = fn(tx: pog.Connection) {
+    case sql.get_reference_call_by_id(tx, call_uuid) {
+      Error(err) -> Error(DbFailure(err))
+      Ok(pog.Returned(_, [])) -> Error(RowNotFound)
+      Ok(pog.Returned(_, [row, ..])) ->
+        case row.application_id == uuid.to_string(app_uuid) {
+          False -> Error(RowNotFound)
+          True ->
+            case
+              sql.substitute_reference_call(
+                tx,
+                call_uuid,
+                app_uuid,
+                trio.name,
+                trio.email,
+                trio.phone,
+              )
+            {
+              Error(err) -> Error(DbFailure(err))
+              // 0 rows: the row is not objected/unreachable (a different
+              // terminal, or the guard's app-scope failed) — stand down.
+              Ok(pog.Returned(_, [])) -> Error(NotSubstitutable)
+              Ok(pog.Returned(_, [new_row, ..])) ->
+                case new_row.how {
+                  // Idempotent no-op: a live successor already occupies the
+                  // slot (double-submit, or substituting the OLD terminal
+                  // row after a prior substitution). No trio rewrite, no
+                  // duplicate audit — the original did both.
+                  "existing" -> Ok(new_row.id)
+                  _ ->
+                    case
+                      update_trio(
+                        tx,
+                        app_uuid,
+                        vacancy_uuid,
+                        row.ref_slot,
+                        trio,
+                      )
+                    {
+                      Error(err) -> Error(DbFailure(err))
+                      Ok(_) ->
+                        case
+                          audit_log.create(
+                            tx,
+                            user_id: landlord_uuid,
+                            event: event_type.ReferenceCallSubstituted,
+                            entity_type: audit_entity,
+                            entity_id: call_uuid,
+                            details: json.object([
+                              alog.non_pii(
+                                alog.RefSlot,
+                                json.string(row.ref_slot),
+                              ),
+                              alog.non_pii(alog.From, json.string(row.status)),
+                              alog.non_pii(alog.To, json.string("queued")),
+                              // AD-16: the substitution audit carries old + new ids.
+                              alog.non_pii(
+                                alog.OldReferenceCallId,
+                                json.string(uuid.to_string(call_uuid)),
+                              ),
+                              alog.non_pii(
+                                alog.NewReferenceCallId,
+                                json.string(new_row.id),
+                              ),
+                            ]),
+                          )
+                        {
+                          Ok(_) -> Ok(new_row.id)
+                          Error(err) -> Error(DbFailure(err))
+                        }
+                    }
+                }
+            }
+        }
+    }
+  }
+  case pog.transaction(config.db, run) {
+    Ok(new_id) ->
+      json_ok(
+        json.object([
+          #("substituted", json.bool(True)),
