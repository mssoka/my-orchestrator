+       -- minimal result carries it (§4.6 uniform-read rule).
+       COALESCE(rc.attempts::text, '[]') AS attempts,
        v.user_id::text AS landlord_id,
-       a.first_name || ' ' || a.last_name AS applicant_full_name
+       a.first_name || ' ' || a.last_name AS applicant_full_name,
+       -- RC4.3 additive: the retention stamp at the exhaustion terminal (§9.3).
