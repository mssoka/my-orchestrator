+fn parse_uuids(
+  application_id: String,
+  landlord_id: String,
+  vacancy_id: String,
+  call_id: String,
+) -> Result(#(Uuid, Uuid, Uuid, Uuid), Response) {
+  case
+    uuid.from_string(application_id),
+    uuid.from_string(landlord_id),
+    uuid.from_string(vacancy_id),
+    uuid.from_string(call_id)
+  {
+    Ok(app), Ok(landlord), Ok(vacancy), Ok(call) ->
+      Ok(#(app, landlord, vacancy, call))
+    _, _, _, _ ->
+      Error(response_helpers.json_error(
