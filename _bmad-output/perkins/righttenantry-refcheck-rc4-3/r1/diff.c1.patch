+/// RC4.3 correction-exhaustion (AD-7): the second failure terminalized the
+/// row as unreachable. In-app ONLY — the same posture as the awaiting-
+/// correction notification (Q3=B2: no realtime email, avoiding spam when
+/// several referees bounce); the landlord is actively working this row, and
+/// the unreachable surface (take over / substitute) is where they continue.
+/// Copy follows UX §7.9's Unreachable event. Fires exactly once per
+/// exhaustion — the caller gates on the guarded terminal transition.
+pub fn notify_reference_correction_exhausted(
+  db db: pog.Connection,
+  landlord_id landlord_id: Uuid,
+  reference_call_id reference_call_id: Uuid,
+  referee_name referee_name: String,
+  applicant_full_name applicant_full_name: String,
+) -> Result(String, String) {
+  let title = "Couldn't reach this reference"
+  let body =
+    "Couldn't reach "
+    <> referee_name
+    <> " ("
+    <> applicant_full_name
+    <> "'s referee). You can take over from the application page."
+  dispatch(
+    db,
+    landlord_id,
+    sql.ReferenceUnreachable,
+    title,
+    body,
+    "reference_call",
+    reference_call_id,
+  )
+}
