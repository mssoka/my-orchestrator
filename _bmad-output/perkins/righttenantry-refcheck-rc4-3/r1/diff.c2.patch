+// --- Per-slot start (?slot=) ------------------------------------------------
+
+pub fn per_slot_start_creates_only_the_requested_slot_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id) =
+    seed_full_app(db, "rc43-p@example.com")
+  let #(landlord, vacancy, app) = uuids(landlord_id, vacancy_id, app_id)
+
+  // The RC2.3 pre-declared variant: start ONLY the employer check.
+  let outcome =
+    trigger.run_create_checks_slot(
+      config,
+      app,
+      landlord,
+      vacancy,
+      Some("employer_ref"),
+    )
+
+  outcome |> should.equal(Ok(trigger.Created(count: 1)))
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT COUNT(*)::int FROM reference_call WHERE application_id = $1",
+    )
+    |> pog.parameter(pog.text(app_id))
+    |> pog.returning(decode.at([0], decode.int))
+    |> pog.execute(db)
+  case returned.rows {
+    [n, ..] -> n |> should.equal(1)
+    _ -> Nil
+  }
+  // The other slot is untouched (no landlord_ref row at all).
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT COUNT(*)::int FROM reference_call
+       WHERE application_id = $1 AND ref_slot = 'landlord_ref'",
+    )
+    |> pog.parameter(pog.text(app_id))
+    |> pog.returning(decode.at([0], decode.int))
+    |> pog.execute(db)
+  case returned.rows {
+    [n2, ..] -> n2 |> should.equal(0)
+    _ -> Nil
+  }
+}
