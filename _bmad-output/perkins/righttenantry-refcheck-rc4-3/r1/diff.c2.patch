+pub fn substitute_is_idempotent_and_guarded_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id, call_id) =
+    create_rows(db, "rc43-n@example.com")
+  let #(landlord, vacancy, app) = uuids(landlord_id, vacancy_id, app_id)
+  let assert Ok(call) = uuid.from_string(call_id)
+  set_status(db, call_id, "unreachable")
+  let trio =
+    actions_handler.Trio(name: "Niamh", email: "n@example.com", phone: "")
+
+  // First substitution inserts; the double-submit on the SAME old row hits
+  // the live-slot conflict and returns the existing successor (200 no-op).
+  actions_handler.do_substitute(config, app, landlord, vacancy, call, trio).status
+  |> should.equal(200)
+  actions_handler.do_substitute(config, app, landlord, vacancy, call, trio).status
+  |> should.equal(200)
+
+  // Still exactly TWO rows (old terminal + one successor) and ONE audit.
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT COUNT(*)::int FROM reference_call
+       WHERE application_id = $1 AND ref_slot = 'landlord_ref' AND owner_label = 'primary'",
+    )
+    |> pog.parameter(pog.text(app_id))
+    |> pog.returning(decode.at([0], decode.int))
+    |> pog.execute(db)
+  case returned.rows {
+    [n, ..] -> n |> should.equal(2)
+    _ -> Nil
+  }
+  count_audit(db, "reference_call_substituted") |> should.equal(1)
+
+  // A NON-substitutable terminal (refused) is rejected — 409, no row.
+  let #(_, _, app2_id, call2_id) = create_rows(db, "rc43-o@example.com")
+  let #(_, _, app2) = uuids(landlord_id, vacancy_id, app2_id)
+  set_status(db, call2_id, "refused")
+  let assert Ok(call2) = uuid.from_string(call2_id)
+  actions_handler.do_substitute(config, app2, landlord, vacancy, call2, trio).status
+  |> should.equal(409)
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT COUNT(*)::int FROM reference_call WHERE application_id = $1",
+    )
+    |> pog.parameter(pog.text(app2_id))
+    |> pog.returning(decode.at([0], decode.int))
+    |> pog.execute(db)
+  case returned.rows {
+    [n2, ..] -> n2 |> should.equal(2)
+    _ -> Nil
+  }
+}
