+// --- Correct (AD-7/A1) ------------------------------------------------------
+
+pub fn correct_requeues_with_corrected_contact_and_audits_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id, call_id) =
+    create_rows(db, "rc43-g@example.com")
+  let #(landlord, vacancy, app) = uuids(landlord_id, vacancy_id, app_id)
+  let assert Ok(call) = uuid.from_string(call_id)
+  set_status(db, call_id, "awaiting_correction")
+
+  let resp =
+    actions_handler.do_correct(
+      config,
+      app,
+      landlord,
+      vacancy,
+      call,
+      actions_handler.Trio(
+        name: "Larry Byrne",
+        email: "larry.byrne@example.com",
+        phone: "+353871999999",
+      ),
+    )
+
+  resp.status |> should.equal(200)
+  // Re-queued with the cadence clock re-armed (the sweep owns the fresh
+  // invite, AD-14).
+  row_field(db, call_id, "status") |> should.equal(Some("queued"))
+  row_field(db, call_id, "next_attempt_at") |> should.not_equal(Some(""))
+  // The corrected values land in corrected_* — the immutable snapshot is
+  // NEVER overwritten (A1).
+  row_field(db, call_id, "corrected_name") |> should.equal(Some("Larry Byrne"))
+  row_field(db, call_id, "corrected_email")
+  |> should.equal(Some("larry.byrne@example.com"))
+  row_field(db, call_id, "contact_email")
+  |> should.equal(Some("larry@example.com"))
+  // One correction cycle by the guard.
+  row_field(db, call_id, "correction_cycles") |> should.equal(Some("1"))
+  // The failure reason is cleared (resolved).
+  row_field(db, call_id, "terminal_reason") |> should.equal(Some(""))
+  // A1: the application trio is updated inline.
+  case app_trio(db, app_id) {
+    [name, email, phone] -> {
+      name |> should.equal("Larry Byrne")
+      email |> should.equal("larry.byrne@example.com")
+      phone |> should.equal("+353871999999")
+    }
+    _ -> Nil
+  }
+  count_audit(db, "reference_call_corrected") |> should.equal(1)
+}
+
+pub fn correct_is_guarded_on_awaiting_correction_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id, call_id) =
+    create_rows(db, "rc43-h@example.com")
+  let #(landlord, vacancy, app) = uuids(landlord_id, vacancy_id, app_id)
+  let assert Ok(call) = uuid.from_string(call_id)
+  let trio =
+    actions_handler.Trio(name: "New", email: "new@example.com", phone: "")
+
+  // A queued row is not awaiting correction — 409, no mutation.
+  let resp =
+    actions_handler.do_correct(config, app, landlord, vacancy, call, trio)
+  resp.status |> should.equal(409)
+  row_field(db, call_id, "corrected_email") |> should.equal(Some(""))
+  count_audit(db, "reference_call_corrected") |> should.equal(0)
+
+  // One cycle spent: the second correct on an already-corrected (queued)
+  // row also 409s — the awaiting guard IS the one-cycle rule (AD-7).
+  set_status(db, call_id, "awaiting_correction")
+  actions_handler.do_correct(config, app, landlord, vacancy, call, trio).status
+  |> should.equal(200)
+  actions_handler.do_correct(config, app, landlord, vacancy, call, trio).status
+  |> should.equal(409)
+  row_field(db, call_id, "correction_cycles") |> should.equal(Some("1"))
+}
+
+/// The trio validation + the 404-vs-409 split live in the HTTP handler
+/// (require_json + validate before do_correct), so this test drives
+/// `handle_correct` over wisp/simulate.
+fn correct_http(
+  db: pog.Connection,
+  landlord_id: String,
+  vacancy_id: String,
+  application_id: String,
+  call_id: String,
+  body: json.Json,
+) -> wisp.Response {
+  let req =
+    simulate.request(
+      http.Post,
+      "/api/v1/vacancies/"
+        <> vacancy_id
+        <> "/applications/"
+        <> application_id
+        <> "/reference-checks/"
+        <> call_id
+        <> "/correct",
+    )
+    |> simulate.json_body(body)
+  actions_handler.handle_correct(
+    req,
+    test_server_config(db),
+    test_db.test_landlord(landlord_id),
+    vacancy_id,
+    application_id,
+    call_id,
+  )
+}
+
+pub fn correct_validation_and_cross_application_guards_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id, call_id) =
+    create_rows(db, "rc43-i@example.com")
+  let #(landlord, _, app) = uuids(landlord_id, vacancy_id, app_id)
+  let assert Ok(call) = uuid.from_string(call_id)
+  set_status(db, call_id, "awaiting_correction")
+
+  // No name — 400 via the handler validation.
+  let no_name =
+    correct_http(
+      db,
+      landlord_id,
+      vacancy_id,
+      app_id,
+      call_id,
+      json.object([
+        #("name", json.string("")),
+        #("email", json.string("x@example.com")),
+        #("phone", json.string("")),
+      ]),
+    )
+  no_name.status |> should.equal(400)
+
+  // No reachable channel — 400.
+  let no_channel =
+    correct_http(
+      db,
+      landlord_id,
+      vacancy_id,
+      app_id,
+      call_id,
+      json.object([
+        #("name", json.string("Larry")),
+        #("email", json.string("")),
+        #("phone", json.string("")),
+      ]),
+    )
+  no_channel.status |> should.equal(400)
+
+  // A call id from ANOTHER application reads as 404 (never a leaked 409).
+  let #(_, _, other_app_id, other_call_id) =
+    create_rows(db, "rc43-j@example.com")
+  let cross =
+    correct_http(
+      db,
+      landlord_id,
+      vacancy_id,
+      other_app_id,
+      other_call_id,
+      json.object([
+        #("name", json.string("Larry")),
+        #("email", json.string("x@example.com")),
+        #("phone", json.string("")),
+      ]),
+    )
+  cross.status |> should.equal(404)
+  // No mutation happened anywhere.
+  count_audit(db, "reference_call_corrected") |> should.equal(0)
+}
