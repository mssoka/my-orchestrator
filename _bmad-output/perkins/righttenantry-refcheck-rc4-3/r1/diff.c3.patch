--- /dev/null
+++ b/client/src/api/reference_checks_api.gleam
@@ -0,0 +1,168 @@
+//// RC4.3 reference-check row-action API — the landlord panel's control
+//// surface. Every call is a CSRF-protected POST (`api_helpers.post_json`),
+//// ownership + pre-state guarded server-side (AD-14); the panel refetches
+//// the application detail after a success (the payload is the contract,
+//// AR-RC13). The `on_response` carries the reference_call_id (substitution
+//// returns the new row id; the other actions return "").
+
+import api/api_error.{type ApiError}
+import api/api_helpers
+import gleam/dynamic/decode
+import gleam/json
+import gleam/option.{type Option, None, Some}
+import lustre/effect.{type Effect}
+import rsvp
+
+fn post_action(
+  url: String,
+  body: json.Json,
+  csrf_token: String,
+  on_response: fn(Result(String, ApiError)) -> msg,
+) -> Effect(msg) {
+  api_helpers.post_json(
+    url,
+    body,
+    csrf_token,
+    rsvp.expect_json(action_result_decoder(), fn(result) {
+      on_response(api_error.map_rsvp(result))
+    }),
+  )
+}
+
+/// The actions' responses are `{...}` objects without a shared shape; the
+/// only payload the client needs is the substitution's new row id (absent
+/// -> ""). A successful HTTP round-trip is the signal; the detail refetch
+/// carries the real state.
+fn action_result_decoder() -> decode.Decoder(String) {
+  use id <- decode.optional_field(
+    "reference_call_id",
+    None,
+    decode.optional(decode.string),
+  )
+  decode.success(option.unwrap(id, ""))
+}
+
+fn base_url(vacancy_id: String, application_id: String) -> String {
+  "/api/v1/vacancies/"
+  <> vacancy_id
+  <> "/applications/"
+  <> application_id
+  <> "/reference-checks"
+}
+
+/// POST .../reference-checks/start?slot=<slot> — RC4.3 per-row start (the
+/// RC2.3 endpoint with the pre-declared slot variant). `slot: None` is the
+/// whole-application start.
+pub fn start_check(
+  vacancy_id vacancy_id: String,
+  application_id application_id: String,
+  slot slot: Option(String),
+  csrf_token csrf_token: String,
+  on_response on_response: fn(Result(String, ApiError)) -> msg,
+) -> Effect(msg) {
+  let url = base_url(vacancy_id, application_id) <> "/start"
+  let url = case slot {
+    Some(s) -> url <> "?slot=" <> s
+    None -> url
+  }
+  post_action(url, json.object([]), csrf_token, on_response)
+}
+
+/// POST .../reference-checks/:slot/skip — exclude a queued reference.
+pub fn skip_reference(
+  vacancy_id vacancy_id: String,
+  application_id application_id: String,
+  slot slot: String,
+  csrf_token csrf_token: String,
+  on_response on_response: fn(Result(String, ApiError)) -> msg,
+) -> Effect(msg) {
+  post_action(
+    base_url(vacancy_id, application_id) <> "/" <> slot <> "/skip",
+    json.object([]),
+    csrf_token,
+    on_response,
+  )
+}
+
+/// POST .../reference-checks/:slot/re-enable — bring a skipped reference
+/// back into the cadence.
+pub fn re_enable_reference(
+  vacancy_id vacancy_id: String,
+  application_id application_id: String,
+  slot slot: String,
+  csrf_token csrf_token: String,
+  on_response on_response: fn(Result(String, ApiError)) -> msg,
+) -> Effect(msg) {
+  post_action(
+    base_url(vacancy_id, application_id) <> "/" <> slot <> "/re-enable",
+    json.object([]),
+    csrf_token,
+    on_response,
+  )
+}
+
+/// POST .../reference-checks/:call_id/take-over — A7 warm handoff. The sweep
+/// stops sending; the form link stays live (§8.6).
+pub fn take_over_reference(
+  vacancy_id vacancy_id: String,
+  application_id application_id: String,
+  call_id call_id: String,
+  csrf_token csrf_token: String,
+  on_response on_response: fn(Result(String, ApiError)) -> msg,
+) -> Effect(msg) {
+  post_action(
+    base_url(vacancy_id, application_id) <> "/" <> call_id <> "/take-over",
+    json.object([]),
+    csrf_token,
+    on_response,
+  )
+}
+
+/// POST .../reference-checks/:call_id/correct — AD-7 landlord-driven
+/// correction (one cycle). Body is the §8.3 edit-trio.
+pub fn correct_reference(
+  vacancy_id vacancy_id: String,
+  application_id application_id: String,
+  call_id call_id: String,
+  name name: String,
+  email email: String,
+  phone phone: String,
+  csrf_token csrf_token: String,
+  on_response on_response: fn(Result(String, ApiError)) -> msg,
+) -> Effect(msg) {
+  post_action(
+    base_url(vacancy_id, application_id) <> "/" <> call_id <> "/correct",
+    json.object([
+      #("name", json.string(name)),
+      #("email", json.string(email)),
+      #("phone", json.string(phone)),
+    ]),
+    csrf_token,
+    on_response,
+  )
+}
+
+/// POST .../reference-checks/:call_id/substitute — a NEW reference_call row
+/// for the slot (the prior row is retained as history; AD-16 carries both
+/// ids in the audit).
+pub fn substitute_reference(
+  vacancy_id vacancy_id: String,
+  application_id application_id: String,
+  call_id call_id: String,
+  name name: String,
+  email email: String,
+  phone phone: String,
+  csrf_token csrf_token: String,
+  on_response on_response: fn(Result(String, ApiError)) -> msg,
+) -> Effect(msg) {
+  post_action(
+    base_url(vacancy_id, application_id) <> "/" <> call_id <> "/substitute",
+    json.object([
+      #("name", json.string(name)),
+      #("email", json.string(email)),
+      #("phone", json.string(phone)),
+    ]),
+    csrf_token,
+    on_response,
+  )
+}
