diff --git a/server/src/reference_checks/sql/rearm_queued_reference_calls.sql b/server/src/reference_checks/sql/rearm_queued_reference_calls.sql
new file mode 100644
index 00000000..bfd1cb0c
--- /dev/null
+++ b/server/src/reference_checks/sql/rearm_queued_reference_calls.sql
@@ -0,0 +1,14 @@
+-- RC4.3 r1 (Perkins W6): "Start this check now" on an application whose rows
+-- already exist (the viewed trigger created them) is an idempotent no-op in
+-- the insert — the honest re-arm: nudge every queued row for the application
+-- to due-now so the cadence sweep picks them up on the next tick. Guarded on
+-- queued + not-taken-over (A7: a landlord-handled row is never re-armed).
+-- 0 rows is fine (nothing queued) — the caller treats the re-arm as best-effort.
+--- rearm_queued_reference_calls(application_id: UUID)
+UPDATE reference_call
+SET next_attempt_at = now(),
+    updated_at = now()
+WHERE application_id = $1
+  AND status = 'queued'::reference_call_status
+  AND taken_over_at IS NULL
+RETURNING id::text;
diff --git a/server/src/reference_checks/sql/substitute_reference_call.sql b/server/src/reference_checks/sql/substitute_reference_call.sql
new file mode 100644
index 00000000..c72803a3
--- /dev/null
+++ b/server/src/reference_checks/sql/substitute_reference_call.sql
@@ -0,0 +1,55 @@
+-- RC4.3 referee substitution (AD-11 hook semantics, UX §8.2): the landlord
+-- swaps a terminal objected/unreachable referee for a NEW referee via the
+-- inline edit-trio. Guarded on the old row's pre-state (AD-14): only
+-- terminal objected / unreachable rows may be substituted — the exact set
+-- the §8.2 can_substitute_referee hook computes. A 0-row result means the
+-- row was not in that state (e.g. a different terminal); stand down, no
+-- mutation.
+--
+-- Idempotency (the live-slot partial unique index): a second substitution
+-- for the same slot — a double-submit, or the landlord re-substituting the
+-- OLD terminal row after a successor already exists (the panel keeps the
+-- prior row as history) — conflicts with the live successor and inserts
+-- nothing. Instead of erroring, the query returns the EXISTING successor's
+-- id with `how = 'existing'` (a 200 no-op, no duplicate row, no duplicate
+-- audit); a real insert returns `how = 'inserted'`. The prior terminal row
+-- is untouched in both cases (retained as history).
+--
+-- next_attempt_at = now() — the sweep owns the fresh invite (AD-14).
+--- substitute_reference_call(reference_call_id: UUID, application_id: UUID, new_name: TEXT, new_email: TEXT, new_phone: TEXT)
+WITH guard AS (
+  SELECT application_id, ref_slot, owner_label
+  FROM reference_call
+  WHERE id = $1
+    AND application_id = $2
+    AND status IN ('objected', 'unreachable')
+),
+inserted AS (
+  INSERT INTO reference_call (
+    application_id, ref_slot, owner_label,
+    contact_name, contact_email, contact_phone,
+    next_attempt_at
+  )
+  SELECT application_id, ref_slot, owner_label,
+         $3, NULLIF($4, ''), NULLIF($5, ''),
+         now()
+  FROM guard
+  ON CONFLICT (application_id, ref_slot, owner_label) WHERE status NOT IN (
+    'form_completed', 'unreachable', 'refused', 'objected',
+    'manual_recorded', 'failed', 'completed', 'partial'
+  )
+  DO NOTHING
+  RETURNING id::text
+)
+SELECT id::text, 'inserted' AS how FROM inserted
+UNION ALL
+SELECT rc.id::text, 'existing' AS how
+FROM reference_call rc
+WHERE rc.application_id = (SELECT application_id FROM guard LIMIT 1)
+  AND rc.ref_slot = (SELECT ref_slot FROM guard LIMIT 1)
+  AND rc.owner_label = (SELECT owner_label FROM guard LIMIT 1)
+  AND rc.status NOT IN (
+    'form_completed', 'unreachable', 'refused', 'objected',
+    'manual_recorded', 'failed', 'completed', 'partial'
+  )
+  AND NOT EXISTS (SELECT 1 FROM inserted);
