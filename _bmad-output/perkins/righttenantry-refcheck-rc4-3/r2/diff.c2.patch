+++ b/server/test/integration/reference_checks_actions_integration_test.gleam
@@ -0,0 +1,1347 @@
+//// Integration tests for the RC4.3 reference row actions (Story RC4.3) —
+//// durable DB-level pins for the story's acceptance criteria:
+////
+//// - Take over manually (A7): guarded on waiting states + unreachable,
+////   writes taken_over_at + clears the cadence clock, the sweep skips the
+////   row, a late completion still transitions (§8.6), audit row written.
+//// - Correct (AD-7/A1, one cycle): awaiting_correction -> queued with the
+////   corrected trio (snapshot immutable), app trio updated,
+////   correction_cycles = 1, next_attempt_at re-armed, audit written; the
+////   awaiting guard IS the one-cycle rule (a second correct 409s).
+//// - Exhaustion (AD-7 — the rc3-7 mechanism goes LIVE here): a delivery
+////   failure / wrong-person on a row that already ran its correction
+////   terminalizes as unreachable + stamps referee_contact_invalid + audits
+////   + notifies.
+//// - Substitute (AD-11 hook semantics): a NEW row for the slot (prior
+////   retained as history), app trio updated, audit carries old + new ids
+////   (AD-16), idempotent on double-submit (the existing successor returns
+////   200, no duplicate audit).
+//// - Per-slot start (?slot= — the RC2.3 pre-declared variant).
+////
+//// Handler-level via `actions_handler.do_*` (the trigger-test pattern);
+//// HTTP-level guard tests (409/404/400) via the handler paths.
+
+import application/form_view
+import gleam/dynamic/decode
+import gleam/http
+import gleam/int
+import gleam/json
+import gleam/list
+import gleam/option.{type Option, None, Some}
+import gleam/string
+import gleeunit/should
+import integration/helpers.{setup, test_server_config}
+import integration/test_db
+import pog
+import reference_checks/actions_handler
+import reference_checks/send
+import reference_checks/sql as rc_sql
+import reference_checks/sweep
+import reference_checks/trigger
+import reference_checks/webhooks
+import router
+import sentry/sentry_client
+import unitest
+import wisp
+import wisp/simulate
+import youid/uuid
+
+import notification/sms_client
+
+// --- seed helpers (mirror the trigger suite) --------------------------------
+
+/// Seeds a landlord + paid vacancy + application with full referee trios and
+/// `reference_contact_choice = 'attested'`. Returns the three ids.
+fn seed_full_app(db: pog.Connection, email: String) -> #(String, String, String) {
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 0)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let assert Ok(returned) =
+    pog.query(
+      "INSERT INTO application (
+         vacancy_id, first_name, last_name, email, phone,
+         employment_status, monthly_income_cents,
+         landlord_ref_name, landlord_ref_email, landlord_ref_phone,
+         character_ref_name, character_ref_email, character_ref_phone,
+         employer_ref_name, employer_ref_email, employer_ref_phone,
+         never_rented_before, reference_contact_choice
+       )
+       VALUES (
+         $1::uuid, 'Aisling', 'Applicant', $2, '+353861234567',
+         'employed', 250000,
+         'Larry Landlord', 'larry@example.com', '+353871111111',
+         'Carla Character', 'carla@example.com', '+353872222222',
+         'Ed Employer', 'ed@example.com', '+353873333333',
+         false, 'attested'
+       )
+       RETURNING id::text",
+    )
+    |> pog.parameter(pog.text(vacancy_id))
+    |> pog.parameter(pog.text(email))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  let assert [application_id, ..] = returned.rows
+  #(landlord_id, vacancy_id, application_id)
+}
+
+fn uuids(
+  landlord_id: String,
+  vacancy_id: String,
+  application_id: String,
+) -> #(uuid.Uuid, uuid.Uuid, uuid.Uuid) {
+  let assert Ok(l) = uuid.from_string(landlord_id)
+  let assert Ok(v) = uuid.from_string(vacancy_id)
+  let assert Ok(a) = uuid.from_string(application_id)
+  #(l, v, a)
+}
+
+/// Creates the reference rows for the app (the viewed-trigger path).
+fn create_rows(
+  db: pog.Connection,
+  email: String,
+) -> #(String, String, String, String) {
+  let #(landlord_id, vacancy_id, app_id) = seed_full_app(db, email)
+  let #(landlord, vacancy, app) = uuids(landlord_id, vacancy_id, app_id)
+  let assert Ok(trigger.Created(count: _)) =
+    trigger.run_create_checks(test_server_config(db), app, landlord, vacancy)
+  // The landlord_ref row's id (the first created row).
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT id::text FROM reference_call
+       WHERE application_id = $1 AND ref_slot = 'landlord_ref' AND owner_label = 'primary'",
+    )
+    |> pog.parameter(pog.text(app_id))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  let assert [call_id, ..] = returned.rows
+  #(landlord_id, vacancy_id, app_id, call_id)
+}
+
+/// Directly set a row's status (test setup — moves a row into the state a
+/// transition test needs).
+fn set_status(db: pog.Connection, call_id: String, status: String) -> Nil {
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE reference_call SET status = $2::reference_call_status WHERE id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(call_id))
+    |> pog.parameter(pog.text(status))
+    |> pog.execute(db)
+  Nil
+}
+
+fn row_field(
+  db: pog.Connection,
+  call_id: String,
+  field: String,
+) -> Option(String) {
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT COALESCE("
+      <> field
+      <> "::text, '') FROM reference_call WHERE id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(call_id))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  case returned.rows {
+    [v, ..] -> Some(v)
+    _ -> None
+  }
+}
+
+fn count_audit(db: pog.Connection, event_str: String) -> Int {
+  let assert Ok(returned) =
+    pog.query("SELECT COUNT(*)::int FROM audit_log WHERE event_type = $1")
+    |> pog.parameter(pog.text(event_str))
+    |> pog.returning(decode.at([0], decode.int))
+    |> pog.execute(db)
+  case returned.rows {
+    [n, ..] -> n
+    _ -> -1
+  }
+}
+
+fn audit_details_for(db: pog.Connection, event_str: String) -> List(String) {
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT details::text FROM audit_log WHERE event_type = $1 ORDER BY created_at",
+    )
+    |> pog.parameter(pog.text(event_str))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  returned.rows
+}
+
+/// The app's trio columns for the landlord slot (COALESCE'd to text — the
+/// row decodes as a list of strings).
+fn app_trio(db: pog.Connection, app_id: String) -> List(String) {
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT COALESCE(landlord_ref_name,''), COALESCE(landlord_ref_email,''), COALESCE(landlord_ref_phone,'') FROM application WHERE id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(app_id))
+    |> pog.returning(decode.list(decode.string))
+    |> pog.execute(db)
+  case returned.rows {
+    [t, ..] -> t
+    _ -> []
+  }
+}
+
+// --- r1 rework helpers ------------------------------------------------------
+
+fn run_sweep(db: pog.Connection) -> sweep.RunSummary {
+  wisp.configure_logger()
+  sweep.run(
+    db,
+    send.SendDeps(
+      resend_api_key: "",
+      twilio: sms_client.Disabled,
+      sentry: sentry_client.Disabled,
+    ),
+    now_iso: "",
+    sentry: sentry_client.Disabled,
+    batch_limit: 100,
+  )
+}
+
+fn notification_count(db: pog.Connection, row_id: String) -> Int {
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT COUNT(*)::int FROM notification WHERE entity_type = 'reference_call' AND entity_id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(row_id))
+    |> pog.returning(decode.at([0], decode.int))
+    |> pog.execute(db)
+  case returned.rows {
+    [n, ..] -> n
+    _ -> -1
+  }
+}
+
+fn notification_bodies(db: pog.Connection, row_id: String) -> List(String) {
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT body FROM notification WHERE entity_type = 'reference_call' AND entity_id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(row_id))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  returned.rows
+}
+
+fn test_router_context(db: pog.Connection) -> router.Context {
+  router.Context(
+    config: test_server_config(db),
+    static_directory: "",
+    priv_directory: "",
+    spa_html: "<html>spa shell</html>",
+    bundle_hashes: router.BundleHashes(
+      client_js: option.None,
+      tailwind_css: option.None,
+    ),
+    secret: "",
+    sentry: sentry_client.Disabled,
+  )
+}
+
+// --- Take over (A7) ---------------------------------------------------------
+
+pub fn take_over_queued_row_stops_the_cadence_and_audits_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id, call_id) =
+    create_rows(db, "rc43-a@example.com")
+  let #(landlord, _, app) = uuids(landlord_id, vacancy_id, app_id)
+  let assert Ok(call) = uuid.from_string(call_id)
+
+  let resp = actions_handler.do_take_over(config, app, landlord, call)
+
+  resp.status |> should.equal(200)
+  // A7: the marker is set and the cadence clock is cleared (the sweep's
+  // due-SELECT also excludes taken-over rows — belt and braces).
+  row_field(db, call_id, "taken_over_at") |> should.not_equal(Some(""))
+  row_field(db, call_id, "next_attempt_at") |> should.equal(Some(""))
+  row_field(db, call_id, "status") |> should.equal(Some("queued"))
+  count_audit(db, "reference_call_taken_over") |> should.equal(1)
+}
+
+pub fn take_over_works_from_contact_initiated_and_unreachable_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id, call_id) =
+    create_rows(db, "rc43-b@example.com")
+  let #(landlord, _, app) = uuids(landlord_id, vacancy_id, app_id)
+  let assert Ok(call) = uuid.from_string(call_id)
+
+  // In-flight (invite already sent).
+  set_status(db, call_id, "contact_initiated")
+  actions_handler.do_take_over(config, app, landlord, call).status
+  |> should.equal(200)
+  row_field(db, call_id, "taken_over_at") |> should.not_equal(Some(""))
+
+  // A second take-over of the same row is a guarded no-op (409).
+  actions_handler.do_take_over(config, app, landlord, call).status
+  |> should.equal(409)
+
+  // Unreachable (the §7.7 special case — the marker is not a status change,
+  // so the terminal stays sticky for every other writer).
+  let #(_, _, app2_id, call2_id) = create_rows(db, "rc43-c@example.com")
+  let #(_, _, app2) = uuids(landlord_id, vacancy_id, app2_id)
+  set_status(db, call2_id, "unreachable")
+  let assert Ok(call2) = uuid.from_string(call2_id)
+  actions_handler.do_take_over(config, app2, landlord, call2).status
+  |> should.equal(200)
+  row_field(db, call2_id, "status") |> should.equal(Some("unreachable"))
+  row_field(db, call2_id, "taken_over_at") |> should.not_equal(Some(""))
+}
+
+pub fn take_over_rejects_non_handoff_states_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id, call_id) =
+    create_rows(db, "rc43-d@example.com")
+  let #(landlord, _, app) = uuids(landlord_id, vacancy_id, app_id)
+  let assert Ok(call) = uuid.from_string(call_id)
+
+  // awaiting_correction is the correction flow's state — not take-over-able.
+  set_status(db, call_id, "awaiting_correction")
+  actions_handler.do_take_over(config, app, landlord, call).status
+  |> should.equal(409)
+
+  // Skipped is the re-enable flow's state.
+  set_status(db, call_id, "skipped")
+  actions_handler.do_take_over(config, app, landlord, call).status
+  |> should.equal(409)
+
+  // A completed row is sticky terminal.
+  set_status(db, call_id, "form_completed")
+  actions_handler.do_take_over(config, app, landlord, call).status
+  |> should.equal(409)
+}
+
+pub fn taken_over_row_can_still_complete_late_test() {
