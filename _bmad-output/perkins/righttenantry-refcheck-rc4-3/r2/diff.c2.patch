+pub fn substitute_creates_new_row_and_audits_old_and_new_ids_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id, call_id) =
+    create_rows(db, "rc43-m@example.com")
+  let #(landlord, vacancy, app) = uuids(landlord_id, vacancy_id, app_id)
+  let assert Ok(call) = uuid.from_string(call_id)
+  set_status(db, call_id, "objected")
+
+  let resp =
+    actions_handler.do_substitute(
+      config,
+      app,
+      landlord,
+      vacancy,
+      call,
+      actions_handler.Trio(
+        name: "Niamh Newref",
+        email: "niamh@example.com",
+        phone: "+353870000000",
+      ),
+    )
+
+  resp.status |> should.equal(200)
+  // The NEW row is queued with the new trio as its snapshot + the cadence
+  // clock armed (the sweep owns the invite).
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT id::text, contact_name, COALESCE(contact_email,''), COALESCE(contact_phone,''), status::text, (next_attempt_at IS NOT NULL)::text FROM reference_call
+       WHERE application_id = $1 AND ref_slot = 'landlord_ref' AND owner_label = 'primary'
+       ORDER BY created_at",
+    )
+    |> pog.parameter(pog.text(app_id))
+    |> pog.returning(decode.list(decode.string))
+    |> pog.execute(db)
+  // Old row retained as history (still objected) + the new queued row.
+  // Each ROW decodes as a List(String) (decode.list on a row array).
+  case returned.rows {
+    [old_row, new_row] ->
+      case old_row, new_row {
+        [old_id, _, _, _, old_status, _],
+          [new_id, new_name, new_email, _, new_status, new_clock]
+        -> {
+          old_id |> should.equal(call_id)
+          old_status |> should.equal("objected")
+          new_id |> should.not_equal(call_id)
+          new_status |> should.equal("queued")
+          new_name |> should.equal("Niamh Newref")
+          new_email |> should.equal("niamh@example.com")
+          new_clock |> should.equal("true")
+        }
+        _, _ -> Nil
+      }
+    _ -> Nil
+  }
+
+  // A1: the application trio is updated to the new referee.
+  case app_trio(db, app_id) {
+    [name, email, phone] -> {
+      name |> should.equal("Niamh Newref")
+      email |> should.equal("niamh@example.com")
+      phone |> should.equal("+353870000000")
+    }
+    _ -> Nil
+  }
+
+  // AD-16: the audit entry carries old + new ids.
+  let audits = audit_details_for(db, "reference_call_substituted")
+  list.length(audits) |> should.equal(1)
+  let new_id = case returned.rows {
+    [_, new_row] ->
+      case new_row {
+        [nid, ..] -> nid
+        _ -> ""
+      }
+    _ -> ""
+  }
+  let has_both_ids = case audits {
+    [details, ..] ->
+      details |> string.contains("\"old_reference_call_id\": \"" <> call_id)
+      && details
+      |> string.contains("\"new_reference_call_id\": \"" <> new_id)
+    _ -> False
+  }
+  has_both_ids |> should.be_true
+}
