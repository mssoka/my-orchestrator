 FROM reference_call rc
 JOIN application a ON a.id = rc.application_id
 JOIN vacancy v ON v.id = a.vacancy_id
 WHERE rc.status IN ('queued', 'contact_initiated')
   AND (
     rc.attempts @> NULLIF($1, '')::jsonb
-    OR ($2 <> '' AND COALESCE(NULLIF(rc.corrected_email, ''), rc.contact_email) = $2)
