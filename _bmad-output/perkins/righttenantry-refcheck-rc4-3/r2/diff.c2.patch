+--- find_reference_call_by_send_ref(send_ref_json: TEXT, contact_email: TEXT, contact_phone: TEXT, send_ref: TEXT)
 SELECT rc.id::text,
        rc.status::text,
-       rc.contact_name,
+       COALESCE(NULLIF(rc.corrected_name, ''), rc.contact_name) AS contact_name,
+       -- RC4.3 additive: the one-cycle correction gate — the exhaustion
