+/// W12: the wrong-person route exhausts a corrected row end-to-end (the
+/// second failure via the SSR form, not the webhook).
+pub fn wrong_person_route_exhausts_corrected_row_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id, call_id) =
+    create_rows(db, "rc43-u@example.com")
+  let #(landlord, vacancy, app) = uuids(landlord_id, vacancy_id, app_id)
+  let assert Ok(call) = uuid.from_string(call_id)
+
+  // Cycle 1: wrong person -> awaiting_correction -> corrected.
+  set_status(db, call_id, "contact_initiated")
+  let assert Ok(_) =
+    rc_sql.update_reference_call_status(
+      db,
+      call,
+      rc_sql.AwaitingCorrection,
+      "",
+      "contact_invalid",
+      rc_sql.ContactInitiated,
+    )
+  actions_handler.do_correct(
+    config,
+    app,
+    landlord,
+    vacancy,
+    call,
+    actions_handler.Trio(
+      name: "Larry Byrne",
+      email: "larry.byrne@example.com",
+      phone: "+353871999999",
+    ),
+  ).status
+  |> should.equal(200)
+
+  // The fresh invite lands (the sweep would mint the token — mint one here
+  // so the SSR route has a link), then the wrong-person response arrives.
+  set_status(db, call_id, "contact_initiated")
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE reference_call SET form_token = 'wp-test-token', form_token_expires_at = now() + interval '10 days' WHERE id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(call_id))
+    |> pog.execute(db)
+  let form_token = "wp-test-token"
+  let loaded = form_view.current_unix_ms() - 10_000
+  let req =
+    simulate.request(http.Post, "/reference/" <> form_token <> "/wrong-person")
+    |> simulate.form_body([
+      #("_focus_seconds", "240"),
+      #("_website", ""),
+      #("_form_loaded_at", int.to_string(loaded)),
+    ])
+  let response = router.handle_request(test_router_context(db), req)
+  response.status |> should.equal(200)
+  row_field(db, call_id, "status") |> should.equal(Some("unreachable"))
+  count_audit(db, "reference_call_correction_exhausted") |> should.equal(1)
+}
