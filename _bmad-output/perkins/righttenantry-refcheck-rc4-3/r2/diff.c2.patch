+/// W6 (r1): "Start this check now" on an application whose rows already
+/// exist re-arms the queued rows (the sweep picks them up on the next tick)
+/// — the start endpoint is never a silent no-op.
+pub fn start_reams_existing_queued_rows_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id, _call_id) =
+    create_rows(db, "rc43-z@example.com")
+  // Age the cadence clocks into the past — the observable of the re-arm.
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE reference_call SET next_attempt_at = now() - interval '3 days' WHERE application_id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(app_id))
+    |> pog.execute(db)
+
+  let req =
+    simulate.request(
+      http.Post,
+      "/api/v1/vacancies/"
+        <> vacancy_id
+        <> "/applications/"
+        <> app_id
+        <> "/reference-checks/start",
+    )
+  let resp =
+    trigger.handle_start(
+      req,
+      config,
+      test_db.test_landlord(landlord_id),
+      vacancy_id,
+      app_id,
+    )
+  resp.status |> should.equal(200)
+
+  // Both queued rows re-armed to due-now (no longer the 3-day-old clock).
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT COUNT(*)::int FROM reference_call WHERE application_id = $1 AND next_attempt_at > now() - interval '1 minute'",
+    )
+    |> pog.parameter(pog.text(app_id))
+    |> pog.returning(decode.at([0], decode.int))
+    |> pog.execute(db)
+  case returned.rows {
+    [n, ..] -> n |> should.equal(2)
+    _ -> Nil
+  }
+}
