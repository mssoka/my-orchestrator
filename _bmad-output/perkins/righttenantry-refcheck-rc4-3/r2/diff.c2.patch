+
+  let req =
+    simulate.request(
+      http.Post,
+      "/api/v1/vacancies/"
+        <> other_vacancy_id
+        <> "/applications/"
+        <> app_id
+        <> "/reference-checks/"
+        <> call_id
+        <> "/correct",
+    )
+    |> simulate.json_body(
+      json.object([
+        #("name", json.string("Larry")),
+        #("email", json.string("larry@example.com")),
+        #("phone", json.string("")),
+      ]),
+    )
+  let resp =
+    actions_handler.handle_correct(
+      req,
