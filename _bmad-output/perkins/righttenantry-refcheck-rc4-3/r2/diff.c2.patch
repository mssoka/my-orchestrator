+/// B1 negative control: the PRE-FIX shape (attempt_count 1 + queued) is the
+/// dead-end — the sweep's co-nudge step can never advance a queued row, so
+/// it stands down every tick (the corrected referee would never be
+/// re-invited). Proves the fix test bites.
+pub fn corrected_row_without_attempt_reset_dead_ends_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(_, _, app_id, call_id) = create_rows(db, "rc43-r@example.com")
+  set_status(db, call_id, "queued")
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE reference_call SET attempt_count = 1, next_attempt_at = now() - interval '1 minute' WHERE id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(call_id))
+    |> pog.execute(db)
+
+  let summary = run_sweep(db)
+  // The dead-end: the queued row re-selects every tick and STANDS DOWN (the
+  // advance requires contact_initiated) — never advanced, never
+  // terminalized, never re-invited. (The sibling employer row's T0 invite
+  // is the invited count.)
+  summary.stood_down |> should.equal(1)
+  summary.invited |> should.equal(1)
+  row_field(db, call_id, "status") |> should.equal(Some("queued"))
+  row_field(db, call_id, "attempt_count") |> should.equal(Some("1"))
+}
