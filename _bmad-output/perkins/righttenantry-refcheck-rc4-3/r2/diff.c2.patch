+      "UPDATE reference_call
+       SET attempts = '[{\"at\":\"2026-08-01T08:00:00Z\",\"channel\":\"email\",\"outcome\":\"delivered\",\"detail\":\"old_send_1\"}]'::jsonb,
+           status = 'awaiting_correction'::reference_call_status
+       WHERE id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(call_id))
+    |> pog.execute(db)
+  actions_handler.do_correct(
+    config,
+    app,
+    landlord,
+    vacancy,
+    call,
+    actions_handler.Trio(
+      name: "Larry Byrne",
+      email: "larry.byrne@example.com",
+      phone: "+353871999999",
+    ),
+  ).status
+  |> should.equal(200)
+
+  // The fresh invite lands (a post-correction delivered entry — its `at`
+  // is now()-relative so it is genuinely AFTER corrected_at).
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE reference_call
+       SET attempts = attempts || jsonb_build_array(jsonb_build_object('at', to_char(now(), 'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"'), 'channel', 'email', 'outcome', 'delivered', 'detail', 'new_send_1')),
+           status = 'contact_initiated'::reference_call_status
+       WHERE id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(call_id))
+    |> pog.execute(db)
+
+  // …and its bounce exhausts: unreachable + stamp + audit + notification.
+  webhooks.apply_delivery_failure(
+    db: db,
+    sentry: sentry_client.Disabled,
+    source: "resend",
+    event_id: "evt-new",
+    send_ref: "new_send_1",
+    contact_email: "larry.byrne@example.com",
+    contact_phone: "",
+    terminal_reason: "email_bounced",
+  )
+  row_field(db, call_id, "status") |> should.equal(Some("unreachable"))
+  let signals = row_field(db, call_id, "fraud_signals")
+  case signals {
+    Some(raw) ->
+      raw
+      |> string.contains("\"referee_contact_invalid\": true")
+      |> should.be_true
+    None -> should.fail()
+  }
+  count_audit(db, "reference_call_correction_exhausted") |> should.equal(1)
+  // W2: the notification names the CORRECTED referee, not the stale snapshot.
+  notification_count(db, call_id) |> should.equal(1)
+  notification_bodies(db, call_id)
+  |> list.any(fn(body) { string.contains(body, "Larry Byrne") })
+  |> should.be_true
+}
