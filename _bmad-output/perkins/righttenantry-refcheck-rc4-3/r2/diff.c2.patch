+/// N3: take-over + substitute over HTTP (happy paths) — the full handler
+/// chain incl. the ownership prechecks.
+pub fn take_over_and_substitute_http_happy_paths_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id, call_id) =
+    create_rows(db, "rc43-w@example.com")
+  let landlord = test_db.test_landlord(landlord_id)
+  let #(l_uuid, v_uuid, a_uuid) = uuids(landlord_id, vacancy_id, app_id)
+
+  // The precheck itself must pass (r1 W10 — the app↔vacancy binding).
+  let assert Ok(verified) =
+    rc_sql.verify_application_in_vacancy(db, a_uuid, v_uuid, l_uuid)
+  case verified.rows {
+    [row, ..] -> row.match_count |> should.equal(1)
+    _ -> should.fail()
+  }
+
+  let take_over_req =
+    simulate.request(
+      http.Post,
+      "/api/v1/vacancies/"
+        <> vacancy_id
+        <> "/applications/"
+        <> app_id
+        <> "/reference-checks/"
+        <> call_id
+        <> "/take-over",
+    )
+  actions_handler.handle_take_over(
+    take_over_req,
+    config,
+    landlord,
+    vacancy_id,
+    app_id,
+    call_id,
+  ).status
+  |> should.equal(200)
+  row_field(db, call_id, "taken_over_at") |> should.not_equal(Some(""))
+
+  // Substitute a different row through the handler — app2 lives in its OWN
+  // vacancy AND its own landlord (the prechecks bind all three).
+  let #(app2_landlord_id, app2_vacancy_id, app2_id, call2_id) =
+    create_rows(db, "rc43-x@example.com")
+  set_status(db, call2_id, "objected")
+  let substitute_req =
+    simulate.request(
+      http.Post,
+      "/api/v1/vacancies/"
+        <> app2_vacancy_id
+        <> "/applications/"
+        <> app2_id
+        <> "/reference-checks/"
+        <> call2_id
+        <> "/substitute",
+    )
+    |> simulate.json_body(
+      json.object([
+        #("name", json.string("Niamh Newref")),
+        #("email", json.string("niamh@example.com")),
+        #("phone", json.string("")),
+      ]),
+    )
+  actions_handler.handle_substitute(
+    substitute_req,
+    config,
+    test_db.test_landlord(app2_landlord_id),
+    app2_vacancy_id,
+    app2_id,
+    call2_id,
+  ).status
+  |> should.equal(200)
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT COUNT(*)::int FROM reference_call WHERE application_id = $1",
+    )
+    |> pog.parameter(pog.text(app2_id))
+    |> pog.returning(decode.at([0], decode.int))
+    |> pog.execute(db)
+  case returned.rows {
+    [n, ..] -> n |> should.equal(3)
+    _ -> Nil
+  }
+}
