+      query_string
+      |> string.split("&")
+      |> list.fold(None, fn(acc, pair) {
+        case acc {
+          Some(_) -> acc
+          None ->
+            case pair {
+              "slot=" <> slot -> Some(slot)
+              _ -> None
+            }
+        }
