diff --git a/server/src/reference_checks/sql/take_over_reference_call.sql b/server/src/reference_checks/sql/take_over_reference_call.sql
new file mode 100644
index 00000000..c3382f0b
--- /dev/null
+++ b/server/src/reference_checks/sql/take_over_reference_call.sql
@@ -0,0 +1,27 @@
+-- RC4.3 warm-handoff takeover (A7, UX §7.7): the landlord takes the check
+-- over manually. Guarded single-UPDATE (AD-14) — the row must be in a
+-- waiting state (queued / contact_initiated) or the unreachable terminal
+-- (§7.7: "from unreachable or any waiting state") and must not already be
+-- taken over. A 0-row result means the row was already taken over,
+-- transitioned elsewhere, or is a terminal the takeover does not apply to
+-- (form_completed / refused / objected / failed / partial / skipped /
+-- awaiting_correction) — stand down, no mutation.
+--
+-- Deliberately writes ONLY taken_over_at + next_attempt_at, never status:
+-- `unreachable` is terminal-sticky for every writer (AD-14), but the
+-- takeover marker is not a status change — the row can still late-complete
+-- to form_completed (UX §8.6, A7: "the form link stays live").
+--
+-- next_attempt_at is NULL'd so the sweep's cadence index never re-selects
+-- the row even before the A7 `taken_over_at IS NULL` filter is consulted
+-- (belt-and-braces; the sweep SELECT already excludes taken-over rows).
+--- take_over_reference_call(reference_call_id: UUID, application_id: UUID)
+UPDATE reference_call
+SET taken_over_at = now(),
+    next_attempt_at = NULL,
+    updated_at = now()
+WHERE id = $1
+  AND application_id = $2
+  AND taken_over_at IS NULL
+  AND status IN ('queued', 'contact_initiated', 'unreachable')
+RETURNING id::text;
diff --git a/server/src/reference_checks/sql/update_application_referee_trio_character.sql b/server/src/reference_checks/sql/update_application_referee_trio_character.sql
new file mode 100644
index 00000000..6f8b1b89
--- /dev/null
+++ b/server/src/reference_checks/sql/update_application_referee_trio_character.sql
@@ -0,0 +1,12 @@
+-- RC4.3: update the application's referee trio for the character slot
+-- (A1 — the landlord edits the slot's trio inline, audit-logged). Sibling
+-- of update_application_referee_trio_landlord.sql (squirrel cannot codegen
+-- a dynamic column list; each slot is one fixed query).
+--- update_application_referee_trio_character(application_id: UUID, vacancy_id: UUID, name: TEXT, email: TEXT, phone: TEXT)
+UPDATE application
+SET character_ref_name = NULLIF($3, ''),
+    character_ref_email = NULLIF($4, ''),
+    character_ref_phone = NULLIF($5, '')
+WHERE id = $1
+  AND vacancy_id = $2
+RETURNING id::text;
