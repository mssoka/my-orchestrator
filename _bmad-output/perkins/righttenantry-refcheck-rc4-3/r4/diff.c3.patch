diff --git a/server/src/reference_checks/sql/correct_reference_call.sql b/server/src/reference_checks/sql/correct_reference_call.sql
new file mode 100644
index 00000000..ee51ffa2
--- /dev/null
+++ b/server/src/reference_checks/sql/correct_reference_call.sql
@@ -0,0 +1,46 @@
+-- RC4.3 landlord-driven correction, one cycle (AD-7 as amended by A1, UX
+-- §8.3): the row must be awaiting_correction — that guard IS the one-cycle
+-- rule (after the correction the row is queued; a second `correct` call
+-- 0-rows and the handler 409s). The corrected values land in the
+-- corrected_* columns (NULLIF '' -> NULL); the immutable contact_* snapshot
+-- is NEVER touched. correction_cycles bumps to 1 (max by construction).
+--
+-- Re-queue semantics: status -> 'queued', next_attempt_at -> now() so the
+-- cadence sweep (RC3.5) owns the fresh invite (AD-14 — this writer only
+-- transitions + writes evidence, it does NOT send). terminal_reason is
+-- cleared: the failure that sent the row to awaiting_correction is resolved
+-- (the attempts log keeps the history; the fraud lens only stamps
+-- referee_contact_invalid on EXHAUSTION, RC4.3's second-failure path).
+--
+-- RC4.3 r1 (Perkins B1): attempt_count resets to 0 and the form token is
+-- cleared so the sweep re-runs the T0 claim — a fresh ~288-bit token is
+-- minted and the invite goes to the CORRECTED contact (the cadence step
+-- dispatch keys off attempt_count: a corrected row that failed at T0 would
+-- otherwise land in step_co_nudge, which can never advance a queued row).
+-- corrected_at stamps the correction instant — the exhaustion gate (r1 W3)
+-- uses it to distinguish genuine post-correction failures from stale
+-- redeliveries of the pre-correction send.
+--- correct_reference_call(reference_call_id: UUID, application_id: UUID, corrected_name: TEXT, corrected_email: TEXT, corrected_phone: TEXT)
+UPDATE reference_call
+SET status = 'queued'::reference_call_status,
+    corrected_name = NULLIF($3, ''),
+    corrected_email = NULLIF($4, ''),
+    corrected_phone = NULLIF($5, ''),
+    correction_cycles = correction_cycles + 1,
+    corrected_at = now(),
+    terminal_reason = NULL,
+    attempt_count = 0,
+    form_token = NULL,
+    form_token_expires_at = NULL,
+    -- r2 (W2): the previous referee's session state dies with the cleared
+    -- token — the wrong person's draft answers must never rehydrate into
+    -- the corrected referee's form, and the A2 co-nudge gate must not stay
+    -- suppressed forever.
+    form_opened_at = NULL,
+    draft_answers = NULL,
+    next_attempt_at = now(),
+    updated_at = now()
+WHERE id = $1
+  AND application_id = $2
+  AND status = 'awaiting_correction'::reference_call_status
+RETURNING id::text;
diff --git a/server/src/reference_checks/sql/exhaust_reference_call.sql b/server/src/reference_checks/sql/exhaust_reference_call.sql
new file mode 100644
index 00000000..ca4c20a0
--- /dev/null
+++ b/server/src/reference_checks/sql/exhaust_reference_call.sql
@@ -0,0 +1,34 @@
+-- RC4.3 correction-exhaustion terminal (AD-7: one correction cycle; a
+-- second failure converts the row to unreachable). Fired by the delivery
+-- failure sites (email bounce / SMS failure webhooks, wrong-person route)
+-- when the row already ran its correction (correction_cycles >= 1): instead
+-- of returning to awaiting_correction — which would silently re-ask the
+-- landlord to correct the same details again — the row terminalizes as
+-- unreachable with the referee_contact_invalid fraud signal stamped
+-- (rc3-7's mechanism, LIVE here; the signal is never fabricated).
+--
+-- Guarded single-UPDATE (AD-14): only live pre-correction states
+-- (queued / contact_initiated — the states the sweep sends from) plus the
+-- caller's correction_cycles gate; a 0-row result means someone else
+-- transitioned first and the writer stands down. `outcome` passes as TEXT
+-- with the NULLIF convention (reference_call_status and
+-- reference_call_outcome share constructor names — Squirrel must not emit a
+-- second Gleam type for the outcome enum). purge_after follows the
+-- application's retention schedule (§9.3) when the caller passes it.
+--- exhaust_reference_call(reference_call_id: UUID, outcome: TEXT, terminal_reason: TEXT, result: TEXT, retention_due_at: TEXT)
+UPDATE reference_call
+SET status          = 'unreachable'::reference_call_status,
+    outcome         = NULLIF($2, '')::reference_call_outcome,
+    terminal_reason = $3,
+    result          = $4::jsonb,
+    next_attempt_at = NULL,
+    purge_after     = CASE WHEN $5 = '' THEN purge_after
+                           ELSE $5::timestamptz END,
+    updated_at      = now()
+WHERE id = $1
+  AND status IN ('queued', 'contact_initiated')
+  -- r2 (BLOCKER): a taken-over row is never exhausted — a redelivered
+  -- bounce must not fabricate referee_contact_invalid on a row the
+  -- landlord is handling (A7).
+  AND taken_over_at IS NULL
+RETURNING id::text;
