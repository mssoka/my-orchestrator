diff --git a/server/src/reference_checks/sql/update_application_referee_trio_landlord.sql b/server/src/reference_checks/sql/update_application_referee_trio_landlord.sql
new file mode 100644
index 00000000..e21dbb38
--- /dev/null
+++ b/server/src/reference_checks/sql/update_application_referee_trio_landlord.sql
@@ -0,0 +1,20 @@
+-- RC4.3: update the application's referee trio for a slot (A1 — the
+-- landlord edits the slot's trio inline, audit-logged; the applicant's
+-- verbal/message confirmation is the forewarning the attestation evidences,
+-- so no re-attestation step). Used by BOTH the correction flow (the
+-- corrected values) and the substitution flow (the new referee), so the
+-- Off-state chips + the trigger's slot selection read the current referee.
+--
+-- The slot column set is chosen by the CALLER via three separate queries
+-- (landlord_ref / character_ref / employer_ref) — squirrel cannot codegen a
+-- dynamic column list, and three fixed queries keep the UPDATE guards
+-- trivial. Each query is scoped by application id + vacancy id (defense in
+-- depth: the handler already verified ownership).
+--- update_application_referee_trio_landlord(application_id: UUID, vacancy_id: UUID, name: TEXT, email: TEXT, phone: TEXT)
+UPDATE application
+SET landlord_ref_name = NULLIF($3, ''),
+    landlord_ref_email = NULLIF($4, ''),
+    landlord_ref_phone = NULLIF($5, '')
+WHERE id = $1
+  AND vacancy_id = $2
+RETURNING id::text;
diff --git a/server/src/reference_checks/sql/verify_application_in_vacancy.sql b/server/src/reference_checks/sql/verify_application_in_vacancy.sql
new file mode 100644
index 00000000..ec1d7d99
--- /dev/null
+++ b/server/src/reference_checks/sql/verify_application_in_vacancy.sql
@@ -0,0 +1,15 @@
+-- RC4.3 r1 (Perkins W10): bind the path vacancy to the path application. The
+-- ownership precheck verifies landlord↔application; this closes the
+-- application↔vacancy gap so a same-owner cross-vacancy application id in the
+-- URL (which passed the ownership check) can no longer silently 0-row the
+-- application-trio UPDATE and return a misleading 200. 0 rows = the
+-- application does not live in the path vacancy — the handler 404s.
+--- verify_application_in_vacancy(application_id: UUID, vacancy_id: UUID, landlord_id: UUID)
+SELECT count(*)::int AS match_count
+FROM application a
+WHERE a.id = $1
+  AND a.vacancy_id = $2
+  AND EXISTS (
+    SELECT 1 FROM vacancy v
+    WHERE v.id = a.vacancy_id AND v.user_id = $3
+  );
