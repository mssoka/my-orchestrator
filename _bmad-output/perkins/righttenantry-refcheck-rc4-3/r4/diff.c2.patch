+
+// -- Reference panel (RC4.3) row-action handler tests ------------------------
+
+/// A model whose loaded detail carries the given reference calls (the
+/// action handlers look the row up in the detail payload).
+fn refcheck_detail_model(
+  calls: List(reference_call.ReferenceCallDetail),
+) -> model.Model {
+  model.Model(
+    ..model.initial(),
+    application_detail: remote_data.Success(
+      application_detail.ApplicationDetail(
+        ..test_detail(),
+        reference_calls: calls,
+      ),
+    ),
+    route: routes.ApplicationDetail(vacancy_id: "uuid-vac-1", id: "uuid-app-1"),
+  )
+}
+
+/// The overflow menu toggles open and closed (one at a time).
+pub fn refcheck_menu_toggles_test() {
+  let m = refcheck_detail_model([refcheck_call("rc-1", reference_call.Queued)])
+  let #(opened, _eff) = client.update(m, msg.UserToggledRefcheckMenu("rc-1"))
+  opened.refcheck_menu_open |> should.equal(option.Some("rc-1"))
+  let #(closed, _eff2) =
+    client.update(opened, msg.UserToggledRefcheckMenu("rc-1"))
+  closed.refcheck_menu_open |> should.equal(option.None)
+}
+
+/// Choosing "Start this check now" opens the inline confirm (never a modal)
+/// and closes the menu.
+pub fn refcheck_start_choice_opens_inline_confirm_test() {
+  let m = refcheck_detail_model([refcheck_call("rc-1", reference_call.Queued)])
+  let #(updated, _eff) =
+    client.update(m, msg.UserChoseRefcheckAction("rc-1", model.RefcheckStart))
+  updated.refcheck_menu_open |> should.equal(option.None)
+  // r1 (W7): the confirm renders inside the row detail — the choice expands
+  // the row so a collapsed row never swallows the surface.
+  updated.refcheck_expanded |> set.contains("rc-1") |> should.be_true
+  updated.refcheck_confirm
+  |> should.equal(
+    option.Some(model.RefcheckConfirm(
+      call_id: "rc-1",
+      kind: model.RefcheckConfirmStart,
+    )),
+  )
+}
+
+/// Skip fires the API immediately (no confirm step — §7.4 wireframe).
+pub fn refcheck_skip_fires_immediately_test() {
+  let m = refcheck_detail_model([refcheck_call("rc-1", reference_call.Queued)])
+  let #(updated, _eff) =
+    client.update(m, msg.UserChoseRefcheckAction("rc-1", model.RefcheckSkip))
+  // The slot-scoped fire marks the row in-flight (the observable state
+  // change; the request effect itself is not inspectable).
+  updated.refcheck_action_inflight |> set.contains("rc-1") |> should.be_true
+}
+
+/// Editing the trio opens a prefilled edit state and applies the keystroke.
+pub fn refcheck_trio_editing_updates_live_values_test() {
+  let call =
+    reference_call.ReferenceCallDetail(
+      ..refcheck_call("rc-1", reference_call.AwaitingCorrection),
+      contact_name: option.Some("Larry"),
+      contact_email: option.Some("larry@example.com"),
+      contact_phone: option.None,
+    )
+  let m = refcheck_detail_model([call])
+  let #(updated, _eff) =
+    client.update(
+      m,
+      msg.UserEditedRefcheckTrio("rc-1", "email", "larry@new.ie"),
+    )
+  case updated.refcheck_edit {
+    option.Some(edit) -> {
+      edit.call_id |> should.equal("rc-1")
+      edit.kind |> should.equal(model.RefcheckEditCorrect)
+      edit.name |> should.equal("Larry")
+      edit.email |> should.equal("larry@new.ie")
+    }
+    option.None -> should.fail()
+  }
+}
+
+/// Save with an empty name shows the inline error, fires nothing.
+pub fn refcheck_save_validation_blocks_empty_name_test() {
+  let call =
+    reference_call.ReferenceCallDetail(
+      ..refcheck_call("rc-1", reference_call.AwaitingCorrection),
+      contact_name: option.Some(""),
+      contact_email: option.Some("larry@example.com"),
+    )
+  let m = refcheck_detail_model([call])
+  let #(updated, eff) = client.update(m, msg.UserSavedRefcheckEdit("rc-1"))
+  case updated.refcheck_edit {
+    option.Some(edit) ->
+      edit.error |> should.equal(option.Some(copy.refcheck_edit_need_name))
+    option.None -> should.fail()
+  }
+}
+
+/// Save with no reachable channel shows the channel error, fires nothing.
+pub fn refcheck_save_validation_blocks_no_channel_test() {
+  let call =
+    reference_call.ReferenceCallDetail(
+      ..refcheck_call("rc-1", reference_call.AwaitingCorrection),
+      contact_name: option.Some("Larry"),
+    )
+  let m = refcheck_detail_model([call])
+  let #(updated, eff) = client.update(m, msg.UserSavedRefcheckEdit("rc-1"))
+  case updated.refcheck_edit {
+    option.Some(edit) ->
+      edit.error |> should.equal(option.Some(copy.refcheck_edit_need_channel))
+    option.None -> should.fail()
+  }
+}
+
+/// A successful action clears the pending surfaces, toasts, and refetches
+/// the detail.
+pub fn refcheck_action_success_toasts_and_refetches_test() {
+  let m = refcheck_detail_model([refcheck_call("rc-1", reference_call.Queued)])
+  let #(updated, eff) =
+    client.update(m, msg.ApiReturnedRefcheckAction("rc-1", "take-over", Ok("")))
+  updated.refcheck_edit |> should.equal(option.None)
+  updated.refcheck_confirm |> should.equal(option.None)
+  updated.refcheck_action_inflight |> set.contains("rc-1") |> should.be_false
+  updated.toasts |> list.length() |> should.equal(1)
+}
+
+/// r1 (W8): a stale action response after the landlord navigated away is
+/// dropped — the detail no longer shows the call, so no toast fires.
+pub fn refcheck_late_response_is_dropped_test() {
+  let m = model.Model(..model.initial())
+  let #(updated, _eff) =
+    client.update(
+      m,
+      msg.ApiReturnedRefcheckAction("rc-gone", "take-over", Ok("")),
+    )
+  updated.toasts |> list.length() |> should.equal(0)
+  updated.refcheck_action_inflight
+  |> set.contains("rc-gone")
+  |> should.be_false
+}
+
+/// A failed action keeps the surfaces (the landlord can retry) and toasts
+/// the brand error copy.
+/// r1 (W5): a failed correct/substitute re-enables the edit-trio save
+/// button — the form stays open with the landlord's values.
+pub fn refcheck_action_failure_reenables_save_button_test() {
+  let call =
+    reference_call.ReferenceCallDetail(
+      ..refcheck_call("rc-1", reference_call.AwaitingCorrection),
+      contact_name: option.Some("Larry"),
+      contact_email: option.Some("larry@example.com"),
+    )
+  let m = refcheck_detail_model([call])
+  let m =
+    model.Model(
+      ..m,
+      refcheck_edit: option.Some(model.RefcheckEdit(
+        call_id: "rc-1",
+        kind: model.RefcheckEditCorrect,
+        name: "Larry",
+        email: "larry@example.com",
+        phone: "",
+        saving: True,
+        error: option.None,
+      )),
+    )
+  let #(updated, _eff) =
+    client.update(
+      m,
+      msg.ApiReturnedRefcheckAction(
+        "rc-1",
+        "correct",
+        Error(api_error.new_for_test(error_code.Conflict, dict.new())),
+      ),
+    )
+  case updated.refcheck_edit {
+    option.Some(edit) -> edit.saving |> should.be_false
+    option.None -> should.fail()
+  }
+}
+
+pub fn refcheck_action_failure_toasts_error_test() {
+  let m = refcheck_detail_model([refcheck_call("rc-1", reference_call.Queued)])
+  let #(updated, eff) =
+    client.update(
+      m,
+      msg.ApiReturnedRefcheckAction(
+        "rc-1",
+        "correct",
+        Error(api_error.new_for_test(error_code.Conflict, dict.new())),
+      ),
+    )
+  updated.refcheck_action_inflight |> set.contains("rc-1") |> should.be_false
+  updated.toasts |> list.length() |> should.equal(1)
+}
+
+/// r2 (W9 pin): the four RC4.3 row-action fields reset on route change — a
+/// pending edit's typed referee PII never leaks across applicants.
+pub fn refcheck_action_state_resets_on_route_change_test() {
+  let m =
+    model.Model(
+      ..model.initial(),
+      refcheck_menu_open: option.Some("rc-1"),
+      refcheck_confirm: option.Some(model.RefcheckConfirm(
+        call_id: "rc-1",
+        kind: model.RefcheckConfirmStart,
+      )),
+      refcheck_edit: option.Some(model.RefcheckEdit(
+        call_id: "rc-1",
+        kind: model.RefcheckEditCorrect,
+        name: "Larry",
+        email: "larry@example.com",
+        phone: "",
+        saving: True,
+        error: option.None,
+      )),
+      refcheck_action_inflight: set.from_list(["rc-1"]),
+    )
+  let #(updated, _eff) =
+    client.update(
+      m,
+      msg.BrowserChangedUrl(uri.Uri(
+        scheme: option.Some("http"),
+        userinfo: option.None,
+        host: option.Some("localhost"),
+        port: option.None,
+        path: "/vacancies/v1/applications/a1",
+        query: option.None,
+        fragment: option.None,
+      )),
+    )
+  updated.refcheck_menu_open |> should.equal(option.None)
+  updated.refcheck_confirm |> should.equal(option.None)
+  updated.refcheck_edit |> should.equal(option.None)
+  updated.refcheck_action_inflight |> set.contains("rc-1") |> should.be_false
+}
+
+/// r3 (N7): confirming the take-over dispatches the action (the row is
+/// marked in-flight).
+pub fn refcheck_take_over_confirm_dispatches_test() {
+  let m = refcheck_detail_model([refcheck_call("rc-1", reference_call.Queued)])
+  let m =
+    model.Model(
+      ..m,
+      refcheck_confirm: option.Some(model.RefcheckConfirm(
+        call_id: "rc-1",
+        kind: model.RefcheckConfirmTakeOver,
+      )),
+    )
+  let #(updated, _eff) =
+    client.update(m, msg.UserConfirmedRefcheckAction("rc-1"))
+  updated.refcheck_confirm |> should.equal(option.None)
+  updated.refcheck_action_inflight
+  |> set.contains("rc-1")
+  |> should.be_true
+}
+
+/// r3 (N7): saving a valid correction trio dispatches the endpoint (the row
+/// is marked in-flight).
+pub fn refcheck_save_resend_dispatches_test() {
+  let m =
+    refcheck_detail_model([
+      refcheck_call("rc-1", reference_call.AwaitingCorrection),
+    ])
+  let m =
+    model.Model(
+      ..m,
+      refcheck_edit: option.Some(model.RefcheckEdit(
+        call_id: "rc-1",
+        kind: model.RefcheckEditCorrect,
+        name: "Larry Byrne",
+        email: "larry.byrne@example.com",
+        phone: "",
+        saving: False,
+        error: option.None,
+      )),
+    )
+  let #(updated, _eff) = client.update(m, msg.UserSavedRefcheckEdit("rc-1"))
+  updated.refcheck_action_inflight
+  |> set.contains("rc-1")
+  |> should.be_true
+  case updated.refcheck_edit {
+    option.Some(edit) -> edit.saving |> should.be_true
+    option.None -> should.fail()
+  }
+}
