+//// reference_checks_api wire-format tests (r3 N1) — the client's `?slot=`
+//// per-row start variant and the action URLs are pinned (the server-side
+//// 400 for an invalid slot is pinned in the integration suite).
+
+import api/reference_checks_api
+import gleam/option
+import gleeunit/should
+
+pub fn start_url_without_slot_test() {
+  reference_checks_api.start_check_url("vac-1", "app-1", option.None)
+  |> should.equal(
+    "/api/v1/vacancies/vac-1/applications/app-1/reference-checks/start",
+  )
+}
+
+pub fn start_url_with_slot_test() {
+  reference_checks_api.start_check_url(
+    "vac-1",
+    "app-1",
+    option.Some("employer_ref"),
+  )
+  |> should.equal(
+    "/api/v1/vacancies/vac-1/applications/app-1/reference-checks/start?slot=employer_ref",
+  )
+}
+
+pub fn slot_action_urls_test() {
+  reference_checks_api.slot_action_url("vac-1", "app-1", "landlord_ref", "skip")
+  |> should.equal(
+    "/api/v1/vacancies/vac-1/applications/app-1/reference-checks/landlord_ref/skip",
+  )
+  reference_checks_api.slot_action_url(
+    "vac-1",
+    "app-1",
+    "employer_ref",
+    "re-enable",
+  )
+  |> should.equal(
+    "/api/v1/vacancies/vac-1/applications/app-1/reference-checks/employer_ref/re-enable",
+  )
+}
+
+pub fn call_action_urls_test() {
+  reference_checks_api.call_action_url("vac-1", "app-1", "call-9", "take-over")
+  |> should.equal(
+    "/api/v1/vacancies/vac-1/applications/app-1/reference-checks/call-9/take-over",
+  )
+  reference_checks_api.call_action_url("vac-1", "app-1", "call-9", "correct")
+  |> should.equal(
+    "/api/v1/vacancies/vac-1/applications/app-1/reference-checks/call-9/correct",
+  )
+  reference_checks_api.call_action_url("vac-1", "app-1", "call-9", "substitute")
+  |> should.equal(
+    "/api/v1/vacancies/vac-1/applications/app-1/reference-checks/call-9/substitute",
+  )
+}
