+    )
+    |> pog.parameter(pog.text(call_id))
+    |> pog.execute(db)
+
+  let summary = run_sweep(db)
+  // The dead-end: the queued row re-selects every tick and STANDS DOWN (the
+  // advance requires contact_initiated) — never advanced, never
+  // terminalized, never re-invited. (The sibling employer row's T0 invite
+  // is the invited count.)
+  summary.stood_down |> should.equal(1)
