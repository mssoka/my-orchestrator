+       SET status = 'awaiting_correction'::reference_call_status,
+           attempts = '[{\"at\":\"2026-08-01T08:00:00Z\",\"channel\":\"email\",\"outcome\":\"delivered\",\"detail\":\"ref_send_1\"},{\"at\":\"2026-08-01T09:00:00Z\",\"channel\":\"email\",\"outcome\":\"delivered\",\"detail\":\"co_nudge_send_1\",\"kind\":\"co_nudge\"}]'::jsonb
