+// -- r1 (Perkins) rework pins ------------------------------------------------
+
+/// B1: a corrected row re-enters the cadence at T0 — the sweep re-invites
+/// it with a FRESH token (the invite goes to the corrected contact) instead
+/// of dead-ending in the co-nudge step forever.
+pub fn corrected_row_is_reinvited_by_the_sweep_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id, call_id) =
+    create_rows(db, "rc43-q@example.com")
+  let #(landlord, vacancy, app) = uuids(landlord_id, vacancy_id, app_id)
+  let assert Ok(call) = uuid.from_string(call_id)
+
+  // Simulate a T0 failure: the sweep claimed once (attempt_count 1,
+  // contact_initiated) then the invite bounced -> awaiting_correction.
+  set_status(db, call_id, "contact_initiated")
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE reference_call SET attempt_count = 1, form_token = 'old_token', form_token_expires_at = now() + interval '10 days' WHERE id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(call_id))
+    |> pog.execute(db)
+  set_status(db, call_id, "awaiting_correction")
+
+  // The correction re-queues at T0: attempt_count reset, old token cleared.
+  let resp =
+    actions_handler.do_correct(
+      config,
+      app,
+      landlord,
+      vacancy,
+      call,
+      actions_handler.Trio(
+        name: "Larry Byrne",
+        email: "larry.byrne@example.com",
+        phone: "+353871999999",
+      ),
+    )
+  resp.status |> should.equal(200)
+  row_field(db, call_id, "attempt_count") |> should.equal(Some("0"))
+  row_field(db, call_id, "form_token") |> should.equal(Some(""))
+  row_field(db, call_id, "status") |> should.equal(Some("queued"))
+
+  // The sweep's next tick runs the T0 claim: contact_initiated, a FRESH
+  // token minted, attempt_count 1 — the corrected contact is re-invited.
+  // (The sibling employer row is also queued + due — it gets its own T0;
+  // the landlord row's re-invite is the pin.)
+  let summary = run_sweep(db)
+  summary.invited |> should.equal(2)
+  row_field(db, call_id, "status") |> should.equal(Some("contact_initiated"))
+  row_field(db, call_id, "attempt_count") |> should.equal(Some("1"))
+  row_field(db, call_id, "form_token")
+  |> should.not_equal(Some(""))
+  row_field(db, call_id, "form_token") |> should.not_equal(Some("old_token"))
+}
