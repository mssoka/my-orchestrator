+// --- Exhaustion (AD-7 — the rc3-7 mechanism goes LIVE) ----------------------
+
+/// The exhaustion terminal via the delivery-failure SQL path: a row that
+/// already ran its correction never returns to awaiting_correction — it
+/// terminalizes as unreachable with the referee_contact_invalid signal.
+pub fn second_failure_exhausts_to_unreachable_with_signal_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id, call_id) =
+    create_rows(db, "rc43-k@example.com")
+  let #(landlord, vacancy, app) = uuids(landlord_id, vacancy_id, app_id)
+  let assert Ok(call) = uuid.from_string(call_id)
+
+  // Cycle 1: awaiting_correction -> corrected (queued).
+  set_status(db, call_id, "awaiting_correction")
+  let assert Ok(returned) =
+    rc_sql.correct_reference_call(
+      db,
+      call,
+      app,
+      "Larry Byrne",
+      "larry.byrne@example.com",
+      "+353871999999",
+    )
+  list.length(returned.rows) |> should.equal(1)
+
+  // Failure 2: the row is queued with correction_cycles = 1 — the exhaustion
+  // terminal fires (this is what the webhook/wrong-person call sites run).
+  let result_json = reference_checks_result_minimal(db, call_id)
+  let assert Ok(returned) =
+    rc_sql.exhaust_reference_call(
+      db,
+      call,
+      "unreachable",
+      "email_bounced",
+      result_json,
+      "",
+    )
+  list.length(returned.rows) |> should.equal(1)
+  row_field(db, call_id, "status") |> should.equal(Some("unreachable"))
+  row_field(db, call_id, "next_attempt_at") |> should.equal(Some(""))
+
+  // rc3-7's signal goes LIVE: stamped on exhaustion (the call site runs the
+  // stamp right after the guarded terminal) — never on the first failure.
+  let assert Ok(stamped) = rc_sql.stamp_referee_contact_invalid(db, call)
+  list.length(stamped.rows) |> should.equal(1)
+  let signals = row_field(db, call_id, "fraud_signals")
+  case signals {
+    Some(raw) ->
+      // Stamped ON TOP of the creation-time signals (jsonb_set) — the key
+      // goes live exactly here, and only here.
+      raw
+      |> string.contains("\"referee_contact_invalid\": true")
+      |> should.be_true
+    None -> should.fail()
+  }
+  // The minimal terminal result carries the attempts log (§4.6).
+  row_field(db, call_id, "result") |> should.not_equal(Some(""))
+}
+
+/// Builds the minimal §4.6 terminal result JSON (outcome + attempts).
+fn reference_checks_result_minimal(
+  db: pog.Connection,
+  call_id: String,
+) -> json.Json {
+  let attempts = case row_field(db, call_id, "attempts") {
+    Some(a) -> a
+    None -> "[]"
+  }
+  json.object([
+    #("schema_version", json.string("refcall-v1")),
+    #("channel", json.string("form")),
+    #("outcome", json.string("unreachable")),
+    #("attempts", json.string(attempts)),
+    #("verification", json.null()),
+  ])
+}
