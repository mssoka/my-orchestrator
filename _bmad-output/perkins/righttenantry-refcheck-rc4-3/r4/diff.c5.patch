+/// N3 (r3): the per-slot re-arm only touches the requested slot, and the
+/// declined (suppressed) start path never re-arms.
+pub fn per_slot_rearm_and_declined_no_rearm_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id, _) =
+    create_rows(db, "rc43-mm@example.com")
+  // Age BOTH rows' clocks into the past.
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE reference_call SET next_attempt_at = now() - interval '3 days' WHERE application_id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(app_id))
+    |> pog.execute(db)
+
+  // Start ONLY the employer slot.
+  let req =
+    simulate.request(
+      http.Post,
+      "/api/v1/vacancies/"
+        <> vacancy_id
+        <> "/applications/"
+        <> app_id
+        <> "/reference-checks/start?slot=employer_ref",
+    )
+  trigger.handle_start(
+    req,
+    config,
+    test_db.test_landlord(landlord_id),
+    vacancy_id,
+    app_id,
+  ).status
+  |> should.equal(200)
+
+  // Only the employer row is re-armed; the landlord row keeps the aged clock.
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT ref_slot, (next_attempt_at > now() - interval '1 minute')::text FROM reference_call WHERE application_id = $1 ORDER BY ref_slot",
+    )
+    |> pog.parameter(pog.text(app_id))
+    |> pog.returning(decode.list(decode.string))
+    |> pog.execute(db)
+  case returned.rows {
+    [employer, landlord] ->
+      case employer, landlord {
+        [slot_e, armed_e], [slot_l, armed_l] -> {
+          slot_e |> should.equal("employer_ref")
+          armed_e |> should.equal("true")
+          slot_l |> should.equal("landlord_ref")
+          armed_l |> should.equal("false")
+        }
+        _, _ -> should.fail()
+      }
+    _ -> should.fail()
+  }
+
+  // Declined application: the suppressed start path never re-arms — the
+  // SAME app (its landlord row is still aged from the per-slot test above).
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE application SET reference_contact_choice = 'declined' WHERE id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(app_id))
+    |> pog.execute(db)
+  let declined_req =
+    simulate.request(
+      http.Post,
+      "/api/v1/vacancies/"
+        <> vacancy_id
+        <> "/applications/"
+        <> app_id
+        <> "/reference-checks/start",
+    )
+  trigger.handle_start(
+    declined_req,
+    config,
+    test_db.test_landlord(landlord_id),
+    vacancy_id,
+    app_id,
+  ).status
+  |> should.equal(200)
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT (next_attempt_at > now() - interval '1 minute')::text FROM reference_call WHERE application_id = $1 AND ref_slot = 'landlord_ref'",
+    )
+    |> pog.parameter(pog.text(app_id))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  case returned.rows {
+    [armed, ..] -> armed |> should.equal("false")
+    _ -> should.fail()
+  }
+}
