+/// BLOCKER (r3, TOCTOU): the wrong-person awaiting leg's dedicated SQL has
+/// the taken_over_at backstop — a take-over landing between the token read
+/// and the UPDATE 0-rows instead of yanking a landlord-handled row into the
+/// correction loop.
+pub fn wrong_person_awaiting_sql_has_taken_over_backstop_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
