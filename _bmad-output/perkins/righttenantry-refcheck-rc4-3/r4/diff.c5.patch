+/// B1 negative control: the PRE-FIX shape (attempt_count 1 + queued) is the
+/// dead-end — the sweep's co-nudge step can never advance a queued row, so
+/// it stands down every tick (the corrected referee would never be
+/// re-invited). Proves the fix test bites.
+pub fn corrected_row_without_attempt_reset_dead_ends_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(_, _, app_id, call_id) = create_rows(db, "rc43-r@example.com")
+  set_status(db, call_id, "queued")
