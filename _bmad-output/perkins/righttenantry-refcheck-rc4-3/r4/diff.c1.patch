+// -- Reference panel (RC4.3) action plumbing ---------------------------------
+
+/// The reference_call row for a call id from the loaded detail, if any.
+fn find_refcheck_call(
+  model: Model,
+  call_id: String,
+) -> Option(reference_call.ReferenceCallDetail) {
+  case model.application_detail {
+    Success(detail) ->
+      case
+        list.find(detail.reference_calls, fn(c) {
+          c.reference_call_id == call_id
+        })
+      {
+        Ok(call) -> Some(call)
+        Error(_) -> None
+      }
+    _ -> None
+  }
+}
+
+/// r2 (W8): whether a row-action response is still relevant — the current
+/// route is the application-detail page AND the detail still shows the call.
+fn refcheck_response_is_current(model: Model, call_id: String) -> Bool {
+  case model.route {
+    routes.ApplicationDetail(_, _) -> find_refcheck_call(model, call_id) != None
+    _ -> False
+  }
+}
+
+/// Refetch the application detail after a successful row action — the
+/// payload is the contract the panel renders (AR-RC13). No-op off the
+/// detail route.
+fn refetch_refcheck_effect(model: Model) -> Effect(Msg) {
+  case model.route {
+    routes.ApplicationDetail(vid, aid) ->
+      application_api.fetch_application_detail(
+        vid,
+        aid,
+        ApiReturnedApplicationDetail,
+      )
+    _ -> effect.none()
+  }
+}
+
+/// Fire a slot-scoped action (skip / re-enable / start). The slot comes
+/// from the row itself; the response rides `ApiReturnedRefcheckAction` with
+/// the call id + action name so a late answer after navigation is dropped
+/// by the id-match guard.
+fn fire_refcheck_slot_action(
+  model: Model,
+  call_id: String,
+  action: String,
+  fire: fn(String, String, String, String, fn(Result(String, ApiError)) -> Msg) ->
+    Effect(Msg),
+) -> #(Model, Effect(Msg)) {
+  case find_refcheck_call(model, call_id) {
+    None -> #(model, effect.none())
+    Some(call) ->
+      case model.route {
+        routes.ApplicationDetail(vid, aid) -> {
+          let slot = reference_call.encode_ref_slot(call.ref_slot)
+          #(
+            Model(
+              ..model,
+              refcheck_action_inflight: set.insert(
+                model.refcheck_action_inflight,
+                call_id,
+              ),
+            ),
+            fire(vid, aid, slot, model.csrf_token, fn(result) {
+              ApiReturnedRefcheckAction(call_id, action, result)
+            }),
+          )
+        }
+        _ -> #(model, effect.none())
+      }
+  }
+}
+
+/// Fire a call-scoped action (take-over / correct / substitute) — the
+/// endpoint takes the row id directly.
+fn fire_refcheck_call_action(
+  model: Model,
+  call_id: String,
+  action: String,
+  fire: fn(String, String, String, String, fn(Result(String, ApiError)) -> Msg) ->
+    Effect(Msg),
+) -> #(Model, Effect(Msg)) {
+  case model.route {
+    routes.ApplicationDetail(vid, aid) -> #(
+      Model(
+        ..model,
+        refcheck_action_inflight: set.insert(
+          model.refcheck_action_inflight,
+          call_id,
+        ),
+      ),
+      fire(vid, aid, call_id, model.csrf_token, fn(result) {
+        ApiReturnedRefcheckAction(call_id, action, result)
+      }),
+    )
+    _ -> #(model, effect.none())
+  }
+}
+
+/// The edit-trio prefill. Correct prefills from the row's effective contact
+/// (corrected ?? snapshot); substitute starts EMPTY — §8.2 is "ask the
+/// applicant for ANOTHER referee", never the terminal referee's own details
+/// (r2 W5).
+fn prefill_refcheck_edit(
+  model: Model,
+  call_id: String,
+  kind: model.RefcheckEditKind,
+) -> model.RefcheckEdit {
+  let #(name, email, phone) = case kind {
+    model.RefcheckEditSubstitute -> #("", "", "")
+    model.RefcheckEditCorrect ->
+      case find_refcheck_call(model, call_id) {
+        Some(call) -> #(
+          reference_panel.effective_name_value(call),
+          reference_panel.effective_email_value(call),
+          reference_panel.effective_phone_value(call),
+        )
+        None -> #("", "", "")
+      }
+  }
+  model.RefcheckEdit(
+    call_id: call_id,
+    kind: kind,
+    name: name,
+    email: email,
+    phone: phone,
+    saving: False,
+    error: None,
+  )
+}
+
+/// The edit kind for a call: awaiting-correction rows correct; every other
+/// row substitutes.
+fn refcheck_edit_kind_for(
+  model: Model,
+  call_id: String,
+) -> model.RefcheckEditKind {
+  case find_refcheck_call(model, call_id) {
+    Some(call) ->
+      case call.status {
+        reference_call.AwaitingCorrection -> model.RefcheckEditCorrect
+        _ -> model.RefcheckEditSubstitute
+      }
+    None -> model.RefcheckEditSubstitute
+  }
+}
+
+/// Validate the §8.3 trio client-side (mirror of the server rule — a
+/// referee needs a name AND a reachable channel) and fire the endpoint.
+fn save_refcheck_edit(
+  model: Model,
+  edit: model.RefcheckEdit,
+) -> #(Model, Effect(Msg)) {
+  let name = string.trim(edit.name)
+  let email = string.trim(edit.email)
+  let phone = string.trim(edit.phone)
+  case name {
+    "" -> #(
+      Model(
+        ..model,
+        refcheck_edit: Some(
+          model.RefcheckEdit(..edit, error: Some(copy.refcheck_edit_need_name)),
+        ),
+      ),
+      effect.none(),
+    )
+    _ ->
+      case email, phone {
+        "", "" -> #(
+          Model(
+            ..model,
+            refcheck_edit: Some(
+              model.RefcheckEdit(
+                ..edit,
+                error: Some(copy.refcheck_edit_need_channel),
+              ),
+            ),
+          ),
+          effect.none(),
+        )
+        _, _ -> {
+          let saving =
+            Model(
+              ..model,
+              refcheck_edit: Some(
+                model.RefcheckEdit(..edit, saving: True, error: None),
+              ),
+            )
+          case edit.kind {
+            model.RefcheckEditCorrect ->
+              fire_refcheck_call_action(
+                saving,
+                edit.call_id,
+                "correct",
+                fn(vid, aid, call, csrf, on_response) {
+                  reference_checks_api.correct_reference(
+                    vid,
+                    aid,
+                    call,
+                    name,
+                    email,
+                    phone,
+                    csrf,
+                    on_response,
+                  )
+                },
+              )
+            model.RefcheckEditSubstitute ->
+              fire_refcheck_call_action(
+                saving,
+                edit.call_id,
+                "substitute",
+                fn(vid, aid, call, csrf, on_response) {
+                  reference_checks_api.substitute_reference(
+                    vid,
+                    aid,
+                    call,
+                    name,
+                    email,
+                    phone,
+                    csrf,
+                    on_response,
+                  )
+                },
+              )
+          }
+        }
+      }
+  }
+}
+
+/// The plain-text attempt-log export (the takeover surface's affordance).
+/// RC4.4 owns the full timeline + the verbatim OQ-5 toast; this is the
+/// honest v1 text: the reference, each attempt line, and the current state.
+fn build_attempt_log_text(call: reference_call.ReferenceCallDetail) -> String {
+  let name = reference_panel.effective_name_value(call)
+  let status = reference_call.encode_status(call.status)
+  let lines =
+    call.attempts
+    |> list.map(fn(attempt) {
+      attempt.at
+      <> " - "
+      <> attempt.channel
+      <> " - "
+      <> attempt.outcome
+      <> case attempt.detail {
+        "" -> ""
+        detail -> " (" <> detail <> ")"
+      }
+    })
+    |> string.join("\n")
+  "Reference: " <> name <> "\n" <> "State: " <> status <> "\n" <> lines
+}
+
+fn copy_refcheck_export_effect(call_id: String, text: String) -> Effect(Msg) {
+  effect.from(fn(dispatch) {
+    clipboard.write_text(text)
+    |> promise.tap(fn(result) {
+      dispatch(AppCompletedRefcheckExport(call_id, result))
+    })
+    Nil
+  })
+}
