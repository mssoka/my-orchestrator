+/// ?? contact; RC4.3 — substitution diverges the row from the application
+/// trio), falling back to the application trio for pre-RC4.3 payloads.
+fn referee_name(app: Application, call: ReferenceCallDetail) -> String {
+  let snapshot = effective_name(call)
+  case snapshot {
+    Some(n) if n != "" -> n
+    _ ->
+      case call.ref_slot {
