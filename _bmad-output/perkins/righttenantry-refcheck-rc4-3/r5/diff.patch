diff --git a/server/test/reference_checks/sweep_test.gleam b/server/test/reference_checks/sweep_test.gleam
new file mode 100644
index 00000000..21e50ac6
--- /dev/null
+++ b/server/test/reference_checks/sweep_test.gleam
@@ -0,0 +1,91 @@
+//// Sweep effective-contact unit tests (r2 N12) — the AD-7/W4 rule: once a
+//// correction ran (correction_cycles >= 1) the snapshot is PROVEN DEAD and
+//// the corrected values ARE the contact; a cleared channel stays absent
+//// (never falling back to the failed address). Before any correction,
+//// corrected ?? snapshot.
+
+import gleam/option.{type Option, None, Some}
+import gleeunit/should
+import reference_checks/sql
+import reference_checks/sweep
+
+fn row(
+  cycles cycles: Int,
+  corrected_email corrected_email: Option(String),
+  snapshot_email snapshot_email: Option(String),
+  corrected_phone corrected_phone: Option(String),
+  snapshot_phone snapshot_phone: Option(String),
+) -> sql.SweepDueReferenceCallsRow {
+  sql.SweepDueReferenceCallsRow(
+    id: "rc-1",
+    application_id: "app-1",
+    ref_slot: "landlord_ref",
+    status: "queued",
+    attempt_count: 0,
+    contact_name: "Larry Landlord",
+    contact_email: snapshot_email,
+    contact_phone: snapshot_phone,
+    corrected_email: corrected_email,
+    corrected_phone: corrected_phone,
+    correction_cycles: cycles,
+    form_token: None,
+    form_opened_at: "",
+    draft_answers: "",
+    attempts: "[]",
+    created_at: "2026-08-01T08:00:00Z",
+    vacancy_id: "vac-1",
+    applicant_first_name: "Aisling",
+    applicant_last_name: "Applicant",
+    applicant_email: "aisling@example.com",
+    retention_due_at: "",
+    landlord_id: "landlord-1",
+    origin_domain: "righttenantry.ie",
+    landlord_display_name: "Test Landlord",
+  )
+}
+
+/// Pre-correction: corrected ?? snapshot.
+pub fn effective_contact_pre_correction_test() {
+  let r =
+    row(
+      cycles: 0,
+      corrected_email: None,
+      snapshot_email: Some("snapshot@example.com"),
+      corrected_phone: None,
+      snapshot_phone: Some("+353870000000"),
+    )
+  sweep.effective_email(r) |> should.equal(Some("snapshot@example.com"))
+  sweep.effective_phone(r) |> should.equal(Some("+353870000000"))
+}
+
+/// Post-correction: the corrected value IS the contact.
+pub fn effective_contact_post_correction_test() {
+  let r =
+    row(
+      cycles: 1,
+      corrected_email: Some("corrected@example.com"),
+      snapshot_email: Some("dead@example.com"),
+      corrected_phone: None,
+      snapshot_phone: Some("+353870000000"),
+    )
+  sweep.effective_email(r) |> should.equal(Some("corrected@example.com"))
+  // Phone uncorrected — the corrected-only rule treats the whole snapshot
+  // as proven-dead (AD-7): an uncorrected channel stays absent.
+  sweep.effective_phone(r) |> should.equal(None)
+}
+
+/// r1 W4 / r2: a CLEARED channel post-correction stays ABSENT — the sweep
+/// never falls back to the proven-dead snapshot address (AD-7
+/// never-re-contact).
+pub fn cleared_channel_never_falls_back_to_dead_snapshot_test() {
+  let r =
+    row(
+      cycles: 1,
+      corrected_email: None,
+      snapshot_email: Some("dead@example.com"),
+      corrected_phone: Some("+353879999999"),
+      snapshot_phone: Some("+353870000000"),
+    )
+  sweep.effective_email(r) |> should.equal(None)
+  sweep.effective_phone(r) |> should.equal(Some("+353879999999"))
+}
