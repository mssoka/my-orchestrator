+            attribute("role", "menu"),
+            // r3 (N4) / r4 (N2): the menu takes focus on open — the natural
+            // click-then-Escape flow needs a focused keydown target (the
+            // confirm_modal autofocus pattern).
+            attribute("tabindex", "-1"),
+            attribute.autofocus(True),
+            // r2 (N14): Escape closes the menu (the confirm_modal pattern).
+            event.on(
+              "keydown",
+              menu_escape_decoder(msg.UserToggledRefcheckMenu(
+                call.reference_call_id,
+              )),
+            ),
+            class(
+              "absolute right-0 top-full mt-1 z-20 w-56 bg-white rounded-lg shadow-xl shadow-navy/10 border border-slate-100 py-1",
