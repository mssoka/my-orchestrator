+  |> should.equal(200)
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE reference_call SET form_token = 'wp-race-token', form_token_expires_at = now() + interval '10 days' WHERE id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(call_id))
+    |> pog.execute(db)
+
+  // The wrong-person POST route on the taken-over row: 303 + no transition.
+  let loaded = form_view.current_unix_ms() - 10_000
+  let wp_req =
+    simulate.request(http.Post, "/reference/wp-race-token/wrong-person")
+    |> simulate.form_body([
