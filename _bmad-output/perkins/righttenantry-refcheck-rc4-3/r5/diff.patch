+  let assert Ok(returned) =
+    rc_sql.mark_awaiting_correction_wrong_person(db, call2)
+  list.length(returned.rows) |> should.equal(1)
+  row_field(db, call2_id, "status") |> should.equal(Some("awaiting_correction"))
+}
+
+/// W2 (r3): the contact-fallback leg is PRE-correction only — a redelivered
+/// stale bounce whose envelope equals a CORRECTION-RETAINED channel (the
+/// send_ref is NOT in the attempts — the fallback path) stands down instead
+/// of exhausting a row whose corrected contact was never re-tried.
+pub fn fallback_leg_stale_bounce_stands_down_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id, call_id) =
+    create_rows(db, "rc43-jj@example.com")
+  let #(landlord, vacancy, app) = uuids(landlord_id, vacancy_id, app_id)
+  let assert Ok(call) = uuid.from_string(call_id)
+
+  // The bounce hit the EMAIL; the correction kept the failed email channel
+  // (only the phone was corrected) — the corrected-only effective email
+  // still equals the stale envelope.
+  set_status(db, call_id, "awaiting_correction")
+  actions_handler.do_correct(
+    config,
+    app,
+    landlord,
+    vacancy,
+    call,
+    actions_handler.Trio(
+      name: "Larry Landlord",
+      email: "larry@example.com",
+      phone: "+353879999999",
+    ),
+  ).status
+  |> should.equal(200)
+
+  // A stale redelivered bounce whose send_ref is NOT in the attempts — the
+  // fallback leg — must stand down (post-correction the fallback is
+  // disabled; the row is not found).
+  webhooks.apply_delivery_failure(
+    db: db,
+    sentry: sentry_client.Disabled,
+    source: "resend",
+    event_id: "evt-fallback",
+    send_ref: "unmatched_send_ref",
+    contact_email: "larry@example.com",
+    contact_phone: "",
+    terminal_reason: "email_bounced",
+  )
+  row_field(db, call_id, "status") |> should.equal(Some("queued"))
+  count_audit(db, "reference_call_correction_exhausted") |> should.equal(0)
+  let signals = row_field(db, call_id, "fraud_signals")
+  case signals {
+    Some(raw) ->
+      raw |> string.contains("referee_contact_invalid") |> should.be_false
+    None -> should.fail()
+  }
+}
+
+/// W3 (r3): a bounce of the APPLICANT's co-nudge email never drives a
+/// referee row — co-nudge entries (kind-tagged AND legacy single-email
+/// batches) are excluded from the delivery-failure find (no fabricated
+/// referee_contact_invalid).
+pub fn co_nudge_bounce_stands_down_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id, call_id) =
+    create_rows(db, "rc43-kk@example.com")
+  let #(landlord, vacancy, app) = uuids(landlord_id, vacancy_id, app_id)
+  let assert Ok(call) = uuid.from_string(call_id)
+
+  // A corrected row whose attempts include a LEGACY (untagged) co-nudge
+  // entry — the single-email batch shape (no sms sibling at the same at),
+  // POST-correction: without the exclusion a bounce of the applicant's
+  // address would exhaust the row (r4 W1/W2 — the fixture BITES).
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE reference_call
+       SET status = 'awaiting_correction'::reference_call_status,
+           attempts = jsonb_build_array(
+             jsonb_build_object('at', to_char(now() - interval '1 hour', 'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"'), 'channel', 'email', 'outcome', 'delivered', 'detail', 'ref_send_1'),
+             jsonb_build_object('at', to_char(now() + interval '30 seconds', 'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"'), 'channel', 'email', 'outcome', 'delivered', 'detail', 'co_nudge_send_1')
+           )
+       WHERE id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(call_id))
+    |> pog.execute(db)
+  actions_handler.do_correct(
+    config,
+    app,
+    landlord,
+    vacancy,
+    call,
+    actions_handler.Trio(
+      name: "Larry Byrne",
+      email: "larry.byrne@example.com",
+      phone: "+353871999999",
+    ),
+  ).status
+  |> should.equal(200)
+
+  // The applicant's co-nudge email bounces — the kind-tagged entry is
+  // excluded, the row is not found, nothing happens.
+  webhooks.apply_delivery_failure(
+    db: db,
+    sentry: sentry_client.Disabled,
+    source: "resend",
+    event_id: "evt-conudge",
+    send_ref: "co_nudge_send_1",
+    contact_email: "aisling@example.com",
+    contact_phone: "",
+    terminal_reason: "email_bounced",
+  )
+  row_field(db, call_id, "status") |> should.equal(Some("queued"))
+  count_audit(db, "reference_call_correction_exhausted") |> should.equal(0)
+  let signals = row_field(db, call_id, "fraud_signals")
+  case signals {
+    Some(raw) ->
+      raw |> string.contains("referee_contact_invalid") |> should.be_false
+    None -> should.fail()
+  }
+
+  // Control: a REFEREE send bounce still exhausts (the co-nudge exclusion
+  // did not disable the find).
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE reference_call
+       SET attempts = attempts || jsonb_build_array(
+             jsonb_build_object('at', to_char(now() + interval '30 seconds', 'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"'), 'channel', 'email', 'outcome', 'delivered', 'detail', 'ref_send_2'),
+             jsonb_build_object('at', to_char(now() + interval '30 seconds', 'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"'), 'channel', 'sms', 'outcome', 'delivered', 'detail', 'sms_send_2')
+           ),
+           status = 'contact_initiated'::reference_call_status
+       WHERE id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(call_id))
+    |> pog.execute(db)
+  webhooks.apply_delivery_failure(
+    db: db,
+    sentry: sentry_client.Disabled,
+    source: "resend",
+    event_id: "evt-ref2",
+    send_ref: "ref_send_2",
+    contact_email: "larry.byrne@example.com",
+    contact_phone: "",
+    terminal_reason: "email_bounced",
+  )
+  row_field(db, call_id, "status") |> should.equal(Some("unreachable"))
+  count_audit(db, "reference_call_correction_exhausted") |> should.equal(1)
+}
+
+/// W4 (r3): the sweep's terminal writers carry the taken_over guard — a
+/// take-over landing between the due-SELECT and the T+144h terminal never
+/// terminalizes a landlord-handled row.
+pub fn sweep_terminal_writers_respect_taken_over_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, _, app_id, call_id) =
+    create_rows(db, "rc43-ll@example.com")
+  let #(landlord, _, app) =
+    uuids(landlord_id, "00000000-0000-0000-0000-000000000000", app_id)
+  let assert Ok(call) = uuid.from_string(call_id)
+  set_status(db, call_id, "contact_initiated")
+  let assert Ok(_) =
+    pog.query("UPDATE reference_call SET attempt_count = 4 WHERE id = $1::uuid")
+    |> pog.parameter(pog.text(call_id))
+    |> pog.execute(db)
+  actions_handler.do_take_over(config, app, landlord, call).status
+  |> should.equal(200)
+
+  // The T+144h terminal 0-rows on the taken-over row.
+  let assert Ok(returned) =
+    rc_sql.sweep_terminal(
+      db,
+      call,
+      rc_sql.Unreachable,
+      "unreachable",
+      "sequence_exhausted",
+      json.null(),
+      "",
+    )
+  list.length(returned.rows) |> should.equal(0)
+  row_field(db, call_id, "status") |> should.equal(Some("contact_initiated"))
+}
+
+/// N3 (r3): the per-slot re-arm only touches the requested slot, and the
+/// declined (suppressed) start path never re-arms.
+pub fn per_slot_rearm_and_declined_no_rearm_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id, _) =
+    create_rows(db, "rc43-mm@example.com")
+  // Age BOTH rows' clocks into the past.
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE reference_call SET next_attempt_at = now() - interval '3 days' WHERE application_id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(app_id))
+    |> pog.execute(db)
+
+  // Start ONLY the employer slot.
+  let req =
+    simulate.request(
+      http.Post,
+      "/api/v1/vacancies/"
+        <> vacancy_id
+        <> "/applications/"
+        <> app_id
+        <> "/reference-checks/start?slot=employer_ref",
+    )
+  trigger.handle_start(
+    req,
+    config,
+    test_db.test_landlord(landlord_id),
+    vacancy_id,
+    app_id,
+  ).status
+  |> should.equal(200)
+
+  // Only the employer row is re-armed; the landlord row keeps the aged clock.
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT ref_slot, (next_attempt_at > now() - interval '1 minute')::text FROM reference_call WHERE application_id = $1 ORDER BY ref_slot",
+    )
+    |> pog.parameter(pog.text(app_id))
+    |> pog.returning(decode.list(decode.string))
+    |> pog.execute(db)
+  case returned.rows {
+    [employer, landlord] ->
+      case employer, landlord {
+        [slot_e, armed_e], [slot_l, armed_l] -> {
+          slot_e |> should.equal("employer_ref")
+          armed_e |> should.equal("true")
+          slot_l |> should.equal("landlord_ref")
+          armed_l |> should.equal("false")
+        }
+        _, _ -> should.fail()
+      }
+    _ -> should.fail()
+  }
+
+  // Declined application: the suppressed start path never re-arms — the
+  // SAME app (its landlord row is still aged from the per-slot test above).
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE application SET reference_contact_choice = 'declined' WHERE id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(app_id))
+    |> pog.execute(db)
+  let declined_req =
+    simulate.request(
+      http.Post,
+      "/api/v1/vacancies/"
+        <> vacancy_id
+        <> "/applications/"
+        <> app_id
+        <> "/reference-checks/start",
+    )
+  trigger.handle_start(
+    declined_req,
+    config,
+    test_db.test_landlord(landlord_id),
+    vacancy_id,
+    app_id,
+  ).status
+  |> should.equal(200)
+  let assert Ok(returned) =
+    pog.query(
+      "SELECT (next_attempt_at > now() - interval '1 minute')::text FROM reference_call WHERE application_id = $1 AND ref_slot = 'landlord_ref'",
+    )
+    |> pog.parameter(pog.text(app_id))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  case returned.rows {
+    [armed, ..] -> armed |> should.equal("false")
+    _ -> should.fail()
+  }
+}
+
+/// N16 (r4): sweep_mark_failed carries the taken_over guard too (the r3-W4
+/// pin drove sweep_terminal only).
+pub fn sweep_mark_failed_respects_taken_over_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, _, app_id, call_id) =
+    create_rows(db, "rc43-oo@example.com")
