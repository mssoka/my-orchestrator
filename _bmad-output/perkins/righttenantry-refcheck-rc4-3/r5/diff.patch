+/// Which rows carry §7.3 overflow actions. The awaiting-correction row's
+/// action surface is its OWN body (§8.3 edit-trio — no menu, no dead
+/// entries); taken-over rows lose the menu too (their surface is the
+/// takeover block). The take-over and substitute entries are gated on the
+/// server-computed hooks (r1 B3 — AR-RC13: the panel never re-derives the
+/// legality rules; the statuses only pick the MENU, the hooks decide what
+/// it may contain).
+fn overflow_actions(call: ReferenceCallDetail) -> List(RefcheckAction) {
+  case call.status {
+    // r2 (W6): queued rows offer take-over too — §7.7's waiting states
+    // include queued and the server hook says so; one contract.
+    Queued ->
+      list.append([RefcheckStart, RefcheckSkip], case call.hooks.can_take_over {
+        True -> [RefcheckTakeOver]
+        False -> []
+      })
+    Skipped -> [RefcheckReEnable]
+    ContactInitiated ->
+      case call.hooks.can_take_over {
+        True -> [RefcheckTakeOver]
+        False -> []
+      }
+    Unreachable ->
+      list.append(
+        case call.hooks.can_take_over {
+          True -> [RefcheckTakeOver]
+          False -> []
+        },
+        case call.hooks.can_substitute_referee {
+          True -> [RefcheckSubstitute]
+          False -> []
+        },
+      )
+    // r4 (N13): the spec's menu table promises Objected -> Substitute.
+    Objected ->
+      case call.hooks.can_substitute_referee {
+        True -> [RefcheckSubstitute]
+        False -> []
+      }
+    _ -> []
+  }
+}
