+  detail.contact_email |> should.equal(option.None)
+  detail.contact_phone |> should.equal(option.None)
+  detail.corrected_name |> should.equal(option.None)
+  detail.corrected_email |> should.equal(option.None)
+  detail.corrected_phone |> should.equal(option.None)
+  detail.correction_cycles |> should.equal(0)
+}
