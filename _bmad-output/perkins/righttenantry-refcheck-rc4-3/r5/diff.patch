+  let detail = case json.parse(wire, reference_call.detail_decoder()) {
+    Ok(detail) -> detail
+    Error(_) ->
+      reference_call.ReferenceCallDetail(
+        reference_call_id: "decode-error",
+        ref_slot: LandlordRef,
+        owner_label: Primary,
+        status: Queued,
+        outcome: None,
+        attempt_count: 0,
+        next_attempt_at: None,
+        form_opened_at: None,
+        submitted_at: None,
+        taken_over_at: option.Some("decode-error"),
+        contact_name: option.Some("decode-error"),
+        contact_email: None,
+        contact_phone: None,
+        corrected_name: option.Some("decode-error"),
+        corrected_email: option.Some("decode-error"),
+        corrected_phone: option.Some("decode-error"),
+        correction_cycles: -1,
+        attempts: [],
+        result: None,
+        display_disclaimer: None,
+        hooks: sample_hooks(),
+      )
+  }
+  detail.taken_over_at |> should.equal(option.None)
