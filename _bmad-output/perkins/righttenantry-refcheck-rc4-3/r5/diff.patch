+/// effective basis: a corrected successor re-submitted with a stale trio
+/// must NOT 200-no-op and silently drop the typed referee.
+fn trio_matches_row(
+  row: sql.ListReferenceCallsForApplicationRow,
+  trio: Trio,
+) -> Bool {
+  let name = case row.corrected_name {
+    n if n != "" -> n
+    _ -> row.contact_name
+  }
+  trio.name == name
+  && trio.email == effective_value(row.corrected_email, row.contact_email)
+  && trio.phone == effective_value(row.corrected_phone, row.contact_phone)
+}
+
+/// corrected ?? snapshot for the compare (''-normalised).
+fn effective_value(
+  corrected: Option(String),
+  snapshot: Option(String),
+) -> String {
+  case corrected {
+    Some(c) if c != "" -> c
+    _ -> option.unwrap(snapshot, "")
+  }
+}
+
+/// Updates the application's referee trio for the slot (A1 — the landlord
+/// edits the slot's trio inline; the Off-state chips + future trigger reads
+/// then see the current referee). Returns the affected row count.
+fn update_trio(
+  tx: pog.Connection,
+  app_uuid: Uuid,
+  vacancy_uuid: Uuid,
+  slot: String,
+  trio: Trio,
+) -> Result(Int, pog.QueryError) {
+  case slot {
+    "landlord_ref" ->
+      sql.update_application_referee_trio_landlord(
+        tx,
+        app_uuid,
+        vacancy_uuid,
+        trio.name,
+        trio.email,
+        trio.phone,
+      )
+      |> result.map(row_count)
+    "character_ref" ->
+      sql.update_application_referee_trio_character(
+        tx,
+        app_uuid,
+        vacancy_uuid,
+        trio.name,
+        trio.email,
+        trio.phone,
+      )
+      |> result.map(row_count)
+    "employer_ref" ->
+      sql.update_application_referee_trio_employer(
+        tx,
+        app_uuid,
+        vacancy_uuid,
+        trio.name,
+        trio.email,
+        trio.phone,
+      )
+      |> result.map(row_count)
+    _ ->
+      // Unreachable — ref_slot comes from the DB CHECK constraint. Honest
+      // internal error (r2 N15), never a fabricated argument-count failure.
+      Error(pog.PostgresqlError(
