+
+/// The ownership + archived-vacancy prechecks shared by every row action —
+/// the `handle_update_status` pattern (mirrored in `trigger.gleam`), plus
+/// the r1 (W10) application↔vacancy binding: a same-owner cross-vacancy
+/// application id in the path must 404, not silently 0-row the trio UPDATE.
+fn run_action_with_prechecks(
+  config: ServerConfig,
+  app_uuid: Uuid,
+  landlord_uuid: Uuid,
+  vacancy_uuid: Uuid,
+  action: fn() -> Response,
+) -> Response {
+  let db = config.db
+  case
+    sql.verify_application_in_vacancy(db, app_uuid, vacancy_uuid, landlord_uuid)
+  {
+    Ok(pog.Returned(_, [row])) if row.match_count > 0 ->
+      case app_sql.verify_vacancy_active(db, vacancy_uuid, landlord_uuid) {
+        Ok(pog.Returned(_, [vacancy_row])) if vacancy_row.is_archived ->
+          response_helpers.json_error(
