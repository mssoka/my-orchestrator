+/// The row's effective name (A1, r1 W4): once a correction ran the snapshot
+/// is PROVEN DEAD — the corrected value IS the name, and a cleared field
+/// stays absent (never falling back to the failed contact). Before any
+/// correction, corrected ?? snapshot.
+fn effective_name(call: ReferenceCallDetail) -> Option(String) {
+  case call.correction_cycles >= 1 {
+    True -> call.corrected_name
+    False ->
+      case call.corrected_name {
+        Some(n) if n != "" -> Some(n)
+        _ -> call.contact_name
+      }
+  }
