+  |> should.equal(200)
+
+  let assert Ok(returned) = rc_sql.sweep_mark_failed(db, call, "poison")
+  list.length(returned.rows) |> should.equal(0)
+  row_field(db, call_id, "status") |> should.equal(Some("contact_initiated"))
+}
