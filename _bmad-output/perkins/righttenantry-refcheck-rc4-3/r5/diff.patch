+fn view_substitute_surface(
+  call: ReferenceCallDetail,
+  app: Application,
+  slot: String,
+  edit: Dict(String, RefcheckEdit),
+) -> Element(Msg) {
+  // r1 (B3): the affordance exists only when the server hook says so —
+  // the status arm alone would re-derive the rule client-side (AR-RC13).
+  case call.hooks.can_substitute_referee {
+    False -> element.none()
+    True -> view_substitute_surface_open(call, app, slot, edit)
+  }
+}
+
+fn view_substitute_surface_open(
+  call: ReferenceCallDetail,
+  app: Application,
+  slot: String,
+  edit: Dict(String, RefcheckEdit),
+) -> Element(Msg) {
+  let edit_open = case dict.get(edit, call.reference_call_id) {
+    Ok(e) ->
+      e.call_id == call.reference_call_id && e.kind == RefcheckEditSubstitute
+    Error(_) -> False
+  }
+  html.div([class("space-y-3")], [
+    case edit_open {
+      False ->
+        html.button(
+          [
+            attribute("data-testid", "refcheck-substitute-open-" <> slot),
+            attribute("type", "button"),
+            event.on_click(msg.UserChoseRefcheckAction(
+              call.reference_call_id,
+              RefcheckSubstitute,
+            )),
+            class(
+              "px-3 py-1.5 rounded-lg border border-navy/20 text-sm text-navy font-medium hover:bg-navy/5",
+            ),
+          ],
+          [html.text(copy.refcheck_action_substitute)],
+        )
+      True ->
+        html.div([class("bg-slate-50 rounded-lg p-3 space-y-2")], [
+          html.p([class("text-sm font-semibold text-charcoal")], [
+            html.text(copy.refcheck_substitute_heading),
+          ]),
+          html.p([class("text-xs text-slate leading-relaxed")], [
+            html.text(copy.refcheck_substitute_body),
+          ]),
+          view_edit_trio(call, slot, edit, RefcheckEditSubstitute),
+          view_applicant_chips(app),
+        ])
+    },
+  ])
+}
+
+/// The §8.3 edit-trio form. Values come from the model edit state when it
+/// targets this call, else the row's effective contact (prefill).
+fn view_edit_trio(
+  call: ReferenceCallDetail,
+  slot: String,
+  edit: Dict(String, RefcheckEdit),
+  kind: RefcheckEditKind,
+) -> Element(Msg) {
+  let #(name, email, phone, saving, error) = case
+    dict.get(edit, call.reference_call_id)
+  {
+    Ok(e) if e.kind == kind -> #(e.name, e.email, e.phone, e.saving, e.error)
+    _ ->
+      case kind {
+        // r2 (W5) / r4 (N18): the substitute trio starts EMPTY — the
+        // terminal referee's own contact is never the fallback prefill.
+        RefcheckEditSubstitute -> #("", "", "", False, None)
+        RefcheckEditCorrect -> #(
+          effective_name_value(call),
+          effective_email_value(call),
+          effective_phone_value(call),
+          False,
+          None,
+        )
+      }
+  }
+  let disabled_attr = case saving {
+    True -> [attribute("disabled", "true")]
+    False -> []
+  }
+  html.div([class("space-y-2")], [
+    html.div([class("grid grid-cols-1 sm:grid-cols-3 gap-2")], [
+      text_input(
+        slot,
+        "name",
+        copy.refcheck_field_name,
+        name,
+        "refcheck-edit-name-" <> slot,
+      ),
+      text_input(
+        slot,
+        "email",
+        copy.refcheck_field_email,
+        email,
+        "refcheck-edit-email-" <> slot,
+      ),
+      text_input(
+        slot,
+        "phone",
+        copy.refcheck_field_phone,
+        phone,
+        "refcheck-edit-phone-" <> slot,
+      ),
+    ]),
+    case error {
+      Some(message) ->
+        html.p([class("text-xs text-amber")], [html.text(message)])
+      None -> element.none()
+    },
+    html.div([class("flex items-center gap-2")], [
+      html.button(
+        list.append(
+          [
+            attribute("data-testid", "refcheck-edit-save-" <> slot),
+            attribute("type", "button"),
+            event.on_click(msg.UserSavedRefcheckEdit(call.reference_call_id)),
+            class(
+              "px-3 py-1.5 rounded-lg bg-navy text-white text-sm font-medium hover:bg-navy/90 disabled:opacity-50",
+            ),
+          ],
+          disabled_attr,
+        ),
+        [
+          html.text(case kind {
+            RefcheckEditCorrect -> copy.refcheck_save_resend
+            RefcheckEditSubstitute -> copy.refcheck_substitute_save
+          }),
+        ],
+      ),
+      html.button(
+        [
+          attribute("data-testid", "refcheck-edit-cancel-" <> slot),
+          attribute("type", "button"),
+          event.on_click(msg.UserCancelledRefcheckEdit(call.reference_call_id)),
+          class("px-3 py-1.5 rounded-lg text-sm text-slate hover:bg-slate-100"),
+        ],
+        [html.text(copy.refcheck_edit_cancel)],
+      ),
+    ]),
+  ])
+}
+
+fn text_input(
+  call_id: String,
+  field: String,
+  label: String,
+  value: String,
+  testid: String,
+) -> Element(Msg) {
+  html.label([class("block")], [
+    html.span(
+      [class("text-[10px] font-bold uppercase tracking-widest text-slate")],
+      [
+        html.text(label),
+      ],
+    ),
+    html.input([
+      attribute("data-testid", testid),
+      attribute("type", "text"),
+      attribute("value", value),
+      attribute("aria-label", label),
+      event.on_input(msg.UserEditedRefcheckTrio(call_id, field, _)),
+      class(
+        "mt-1 w-full rounded-lg border border-slate-200 px-2.5 py-1.5 text-sm text-charcoal focus:outline-none focus:ring-2 focus:ring-navy/40",
+      ),
+    ]),
+  ])
+}
+
+/// The §8.3 applicant-contact chips (the landlord checks the right details
+/// with the applicant directly).
+fn view_applicant_chips(app: Application) -> Element(Msg) {
+  html.div([class("flex flex-wrap items-center gap-2")], [
+    html.span([class("text-xs text-slate")], [
+      html.text(copy.refcheck_contact_applicant(app.first_name)),
+    ]),
+    case app.phone {
+      Some(phone) ->
+        contact_chip.view(
+          icon: contact_chip.phone_icon(),
+          value: phone,
+          kind: "phone",
+          on_copy: msg.UserCopiedContact,
+          testid: "refcheck-applicant-phone",
+        )
+      None -> element.none()
+    },
+    case app.email {
+      email if email != "" ->
+        contact_chip.view(
+          icon: contact_chip.email_icon(),
+          value: email,
+          kind: "email",
+          on_copy: msg.UserCopiedContact,
+          testid: "refcheck-applicant-email",
+        )
+      _ -> element.none()
+    },
+  ])
+}
+
+// -- RC4.3 taken-over surface (A7 / §7.7) ------------------------------------
+
+/// The post-takeover block: the referee's effective-contact chips + the
+/// attempt-log export affordance, per §7.7 ("the referee's contact chips
+/// render inline, and the attempt-log export sits beside them").
+fn view_taken_over_surface(
+  call: ReferenceCallDetail,
+  slot: String,
+) -> Element(Msg) {
+  html.div([class("space-y-2")], [
+    html.div([class("flex flex-wrap gap-2")], [
+      case effective_phone_value(call) {
+        phone if phone != "" ->
+          contact_chip.view(
+            icon: contact_chip.phone_icon(),
+            value: phone,
+            kind: "phone",
+            on_copy: msg.UserCopiedContact,
+            testid: "refcheck-taken-over-phone-" <> slot,
+          )
+        _ -> element.none()
+      },
+      case effective_email_value(call) {
+        email if email != "" ->
+          contact_chip.view(
+            icon: contact_chip.email_icon(),
+            value: email,
+            kind: "email",
+            on_copy: msg.UserCopiedContact,
+            testid: "refcheck-taken-over-email-" <> slot,
+          )
+        _ -> element.none()
+      },
+      html.button(
+        [
+          attribute("data-testid", "refcheck-export-" <> slot),
+          attribute("type", "button"),
+          event.on_click(msg.UserClickedRefcheckExport(call.reference_call_id)),
+          class(
+            "inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-50 hover:bg-slate-100 transition-colors text-sm text-charcoal",
+          ),
+        ],
+        [html.text(copy.refcheck_export_log)],
+      ),
+    ]),
+  ])
+}
