+// -- r2 (Perkins) rework pins ------------------------------------------------
+
+/// BLOCKER (r2): a delivery failure on a TAKEN-OVER row stands down — the
+/// landlord is handling it (A7); the row must never re-enter the correction
+/// loop (or exhaust with a fabricated referee_contact_invalid), and the §8.6
+/// late completion stays live.
+pub fn taken_over_row_bounce_stands_down_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id, call_id) =
+    create_rows(db, "rc43-aa@example.com")
+  let #(landlord, _, app) = uuids(landlord_id, vacancy_id, app_id)
+  let assert Ok(call) = uuid.from_string(call_id)
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE reference_call
+       SET attempts = '[{\"at\":\"2026-08-01T08:00:00Z\",\"channel\":\"email\",\"outcome\":\"delivered\",\"detail\":\"send_1\"}]'::jsonb
+       WHERE id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(call_id))
+    |> pog.execute(db)
+
+  // Take over (A7) — the sweep stops, the landlord handles it.
+  actions_handler.do_take_over(config, app, landlord, call).status
+  |> should.equal(200)
+
+  // A redelivered bounce of the pre-take-over send: the find excludes
+  // taken-over rows — nothing happens (no awaiting, no audit, no stamp).
+  webhooks.apply_delivery_failure(
+    db: db,
+    sentry: sentry_client.Disabled,
+    source: "resend",
+    event_id: "evt-taken",
+    send_ref: "send_1",
+    contact_email: "larry@example.com",
+    contact_phone: "",
+    terminal_reason: "email_bounced",
+  )
+  row_field(db, call_id, "status") |> should.equal(Some("queued"))
+  row_field(db, call_id, "taken_over_at") |> should.not_equal(Some(""))
+  count_audit(db, "reference_call_correction_requested") |> should.equal(0)
+  count_audit(db, "reference_call_correction_exhausted") |> should.equal(0)
+  let signals = row_field(db, call_id, "fraud_signals")
+  case signals {
+    Some(raw) ->
+      raw |> string.contains("referee_contact_invalid") |> should.be_false
+    None -> should.fail()
+  }
+
+  // §8.6: a late completion still transitions (the take-over never broke it).
+  let assert Ok(_) =
+    rc_sql.update_reference_call_status(
+      db,
+      call,
+      rc_sql.FormCompleted,
+      "form_completed",
+      "",
+      rc_sql.Queued,
+    )
+  row_field(db, call_id, "status") |> should.equal(Some("form_completed"))
+
+  // The WRONG-PERSON leg of the blocker: a taken-over row's wrong-person
+  // response stands down too (never re-enters the correction loop).
+  let #(_, _, app2_id, call2_id) = create_rows(db, "rc43-zz@example.com")
+  let #(_, _, app2) = uuids(landlord_id, vacancy_id, app2_id)
+  let assert Ok(call2) = uuid.from_string(call2_id)
+  set_status(db, call2_id, "contact_initiated")
+  actions_handler.do_take_over(config, app2, landlord, call2).status
+  |> should.equal(200)
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE reference_call SET form_token = 'wp-taken-token', form_token_expires_at = now() + interval '10 days' WHERE id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(call2_id))
+    |> pog.execute(db)
+  let loaded = form_view.current_unix_ms() - 10_000
+  let wp_req =
+    simulate.request(http.Post, "/reference/wp-taken-token/wrong-person")
+    |> simulate.form_body([
+      #("_focus_seconds", "240"),
+      #("_website", ""),
+      #("_form_loaded_at", int.to_string(loaded)),
+    ])
+  let wp_resp = router.handle_request(test_router_context(db), wp_req)
+  // 303: redirected to the token's truthful state — no transition.
+  wp_resp.status |> should.equal(303)
+  row_field(db, call2_id, "status") |> should.equal(Some("contact_initiated"))
+  count_audit(db, "reference_call_wrong_person") |> should.equal(0)
+}
