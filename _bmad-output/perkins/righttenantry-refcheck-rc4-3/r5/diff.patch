@@ -0,0 +1,18 @@
+-- RC4.3: `corrected_name` — expand-only addition to the landlord-correction
+-- loop (AD-7 as amended by A1). The §8.3 inline edit-trio (UX) has a Name
+-- field alongside Email/Phone; A1's corrected-* pattern (corrected values
+-- live in corrected_* columns; the contact_* snapshot is NEVER overwritten)
+-- extends naturally to the name. The sweep and the detail payload read the
+-- EFFECTIVE name (corrected_name when present, else contact_name), mirroring
+-- the existing corrected_email/corrected_phone treatment.
+--
+-- Expand-only per the repo migration discipline: the previous Cloud Run
+-- revision keeps working against this schema (it simply never writes/reads
+-- the new column).
+ALTER TABLE reference_call
+  ADD COLUMN IF NOT EXISTS corrected_name TEXT,
+  -- RC4.3 r1 (Perkins): the correction timestamp — the exhaustion gate
+  -- (a delivery failure on a corrected row fires only when the failed send
+  -- is POST-correction; a stale/redelivered pre-correction event stands
+  -- down instead of fabricating referee_contact_invalid).
+  ADD COLUMN IF NOT EXISTS corrected_at TIMESTAMPTZ;
