+-- RC4.3 r1 (Perkins W10): bind the path vacancy to the path application. The
+-- ownership precheck verifies landlord↔application; this closes the
+-- application↔vacancy gap so a same-owner cross-vacancy application id in the
+-- URL (which passed the ownership check) can no longer silently 0-row the
+-- application-trio UPDATE and return a misleading 200. 0 rows = the
+-- application does not live in the path vacancy — the handler 404s.
+--- verify_application_in_vacancy(application_id: UUID, vacancy_id: UUID, landlord_id: UUID)
+SELECT count(*)::int AS match_count
+FROM application a
+WHERE a.id = $1
+  AND a.vacancy_id = $2
+  AND EXISTS (
+    SELECT 1 FROM vacancy v
+    WHERE v.id = a.vacancy_id AND v.user_id = $3
+  );
