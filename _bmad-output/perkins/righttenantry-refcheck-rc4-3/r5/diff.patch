+// --- Correct (AD-7/A1) ------------------------------------------------------
+
+pub fn correct_requeues_with_corrected_contact_and_audits_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let config = test_server_config(db)
+  let #(landlord_id, vacancy_id, app_id, call_id) =
+    create_rows(db, "rc43-g@example.com")
+  let #(landlord, vacancy, app) = uuids(landlord_id, vacancy_id, app_id)
+  let assert Ok(call) = uuid.from_string(call_id)
+  set_status(db, call_id, "awaiting_correction")
+  // The failing send's evidence (r1 N4 — the clearing assertion must bite).
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE reference_call SET terminal_reason = 'email_bounced' WHERE id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(call_id))
+    |> pog.execute(db)
+
+  let resp =
+    actions_handler.do_correct(
+      config,
+      app,
+      landlord,
+      vacancy,
+      call,
+      actions_handler.Trio(
+        name: "Larry Byrne",
+        email: "larry.byrne@example.com",
+        phone: "+353871999999",
+      ),
+    )
+
+  resp.status |> should.equal(200)
+  // Re-queued with the cadence clock re-armed (the sweep owns the fresh
+  // invite, AD-14).
+  row_field(db, call_id, "status") |> should.equal(Some("queued"))
+  row_field(db, call_id, "next_attempt_at") |> should.not_equal(Some(""))
+  // The corrected values land in corrected_* — the immutable snapshot is
+  // NEVER overwritten (A1).
+  row_field(db, call_id, "corrected_name") |> should.equal(Some("Larry Byrne"))
+  row_field(db, call_id, "corrected_email")
+  |> should.equal(Some("larry.byrne@example.com"))
+  row_field(db, call_id, "contact_email")
+  |> should.equal(Some("larry@example.com"))
+  // One correction cycle by the guard.
+  row_field(db, call_id, "correction_cycles") |> should.equal(Some("1"))
+  // The failure reason is cleared (resolved).
+  row_field(db, call_id, "terminal_reason") |> should.equal(Some(""))
+  // r1 (B1): the cadence restarts at T0 — attempt_count reset and the old
+  // capability token cleared so the sweep mints a fresh invite link.
+  row_field(db, call_id, "attempt_count") |> should.equal(Some("0"))
+  row_field(db, call_id, "form_token") |> should.equal(Some(""))
+  // A1: the application trio is updated inline.
+  case app_trio(db, app_id) {
+    [name, email, phone] -> {
+      name |> should.equal("Larry Byrne")
+      email |> should.equal("larry.byrne@example.com")
+      phone |> should.equal("+353871999999")
+    }
+    _ -> Nil
+  }
+  count_audit(db, "reference_call_corrected") |> should.equal(1)
+}
