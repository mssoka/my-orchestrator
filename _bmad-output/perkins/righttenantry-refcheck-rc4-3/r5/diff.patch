+/// The returned-row count of any `pog.Returned` — the trio updates' row
+/// types differ, so each arm maps to this common `Int` immediately.
+fn row_count(returned: pog.Returned(a)) -> Int {
+  list.length(returned.rows)
+}
+
+fn json_ok(body: json.Json) -> Response {
+  wisp.json_response(json.to_string(body), 200)
+}
