+fn trio_matches(row: sql.GetReferenceCallByIdRow, trio: Trio) -> Bool {
+  let name = case row.corrected_name {
+    n if n != "" -> n
+    _ -> row.contact_name
+  }
+  let email = effective_value(row.corrected_email, row.contact_email)
+  let phone = effective_value(row.corrected_phone, row.contact_phone)
+  trio.name == name && trio.email == email && trio.phone == phone
