+// -- RC4.3 overflow menu ------------------------------------------------------
+
+/// The `⋯` control + its menu. The menu renders as an absolutely-positioned
+/// card under the button (the row header is the positioning context); one
+/// menu open at a time (model state). Entries fire immediately (skip /
+/// re-enable) or open the inline confirm / edit-trio (start / take-over /
+/// substitute).
+fn view_overflow(
+  call: ReferenceCallDetail,
+  app: Application,
+  slot: String,
+  actions: List(RefcheckAction),
+  menu_open: Option(String),
+) -> Element(Msg) {
+  let name = referee_name(app, call)
+  let open = menu_open == Some(call.reference_call_id)
+  html.div([class("relative flex-shrink-0 self-start")], [
+    html.button(
+      [
+        attribute("data-testid", "refcheck-overflow-" <> slot),
+        attribute("type", "button"),
+        attribute("aria-haspopup", "menu"),
+        attribute("aria-expanded", case open {
+          True -> "true"
+          False -> "false"
+        }),
+        attribute("aria-label", copy.refcheck_overflow_label(name)),
+        event.on_click(msg.UserToggledRefcheckMenu(call.reference_call_id)),
+        class(
+          "text-slate/40 hover:text-slate p-1 rounded flex-shrink-0 self-start focus:outline-none focus:ring-2 focus:ring-navy/40",
+        ),
