@@ -0,0 +1,89 @@
+#!/usr/bin/env python3
+"""test_sprite_foldin.py — pure-text pins for the sculpted fold-in path
+(no Blender needed — CI has none). Wired into lint gate 7.
+
+Legs:
+ 1. W5 guard bites (PR #79 r2): tools/sprite_guard.py::bbox_violation must
+    REJECT an empty bbox, an edge-TOUCHING bbox (clipped by the 256px frame —
+    the old silent-clip class), and an oversize bbox; and ACCEPT an interior
+    bbox. Repo convention: drift gates prove they bite (ci-local.sh W1
+    negative test).
+ 2. SPRITE_SPECS keys == SPRITE_ORDER (AST check of gen_sprites.py) — the
+    main() assert's CI-visible twin: a SPEC/sprite drift fails pre-Blender.
+ 3. HOUSE_COLORS is exactly 4 distinct strict #RRGGBB hexes (the gable .blend
+    is recolored per colorway; gen_sprites.py's hex_rgba raises on a bad hex
+    — this leg catches the drift before a Blender run exists).
+"""
+
+import ast
+import re
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+GEN = ROOT / "tools" / "gen_sprites.py"
+sys.path.insert(0, str(ROOT / "tools"))
+from sprite_guard import bbox_violation  # noqa: E402
+
+RES = 256
+FAILS = []
+
+
+def check(ok, label):
+    print(("ok   " if ok else "FAIL ") + label)
+    if not ok:
+        FAILS.append(label)
+
+
+def spec_literals():
+    """SPRITE_ORDER / HOUSE_COLORS / SPRITE_SPECS out of gen_sprites.py via
+    AST (no bpy import). SPRITE_SPECS values reference HOUSE_COLORS, so that
+    one is evaluated with the colorway list bound — our own source, parsed
+    not imported."""
+    assigns = {}
+    for node in ast.parse(GEN.read_text()).body:
+        if isinstance(node, ast.Assign):
+            for t in node.targets:
+                if isinstance(t, ast.Name) and \
+                        t.id in ("SPRITE_ORDER", "HOUSE_COLORS", "SPRITE_SPECS"):
+                    assigns[t.id] = node.value
+    order = ast.literal_eval(assigns["SPRITE_ORDER"])
+    colors = ast.literal_eval(assigns["HOUSE_COLORS"])
+    specs = eval(compile(ast.Expression(assigns["SPRITE_SPECS"]), "<spec>", "eval"),
+                 {"HOUSE_COLORS": colors})
+    return order, colors, specs
+
+
+def main() -> int:
+    # -- leg 1: the W5 guard bites both ways
+    check(bbox_violation((40, 40, 100, 90), RES) is None, "guard accepts an interior bbox")
+    check(bbox_violation((0, 0, 0, 0), RES) is not None, "guard rejects an empty render")
+    check(bbox_violation((0, 30, 100, 90), RES) is not None, "guard rejects x=0 edge touch (clip)")
+    check(bbox_violation((30, 0, 100, 90), RES) is not None, "guard rejects y=0 edge touch (clip)")
+    check(bbox_violation((30, 30, RES - 30, 90), RES) is not None, "guard rejects x+w=res edge touch")
+    check(bbox_violation((30, 30, 90, RES - 30), RES) is not None, "guard rejects y+h=res edge touch")
+    check(bbox_violation((30, 30, RES, 90), RES) is not None, "guard rejects canvas oversize")
+
+    # -- leg 2: SPEC/sprite-order invariant
+    order, colors, specs = spec_literals()
+    check(sorted(specs) == sorted(order),
+          "SPRITE_SPECS keys == SPRITE_ORDER (got %r)" % sorted(set(specs) ^ set(order)))
+    missing = [n for n in order if n not in specs]
+    check(not missing, "every pinned sprite has a SPEC entry (missing %r)" % missing)
+
+    # -- leg 3: the 4 house colorways are strict, distinct #RRGGBB
+    hexok = re.compile(r"^#[0-9A-Fa-f]{6}$")
+    check(len(colors) == 4 and len(set(colors)) == 4,
+          "HOUSE_COLORS is 4 distinct colorways (got %r)" % colors)
+    check(all(hexok.match(c) for c in colors),
+          "HOUSE_COLORS all strict #RRGGBB (got %r)" % colors)
+
+    if FAILS:
+        print("FAIL: sprite fold-in pins — %d leg(s)" % len(FAILS))
+        return 1
+    print("sprite fold-in pins OK — guard bites, SPEC table consistent")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
