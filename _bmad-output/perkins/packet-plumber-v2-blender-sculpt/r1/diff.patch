+"""sprite_guard.py — the pure-logic half of the sprite fold-in guards.
+
+CI has no Blender, so the bbox-oversize / empty-render guard (W5, PR #79 r2)
+lives here as a pure function: tools/gen_sprites.py calls it on every rendered
+sprite, and tools/test_sprite_foldin.py proves the legs bite (lint gate 7).
+
+A sculpted sprite whose alpha content TOUCHES the canvas edge was clipped by
+the frame (oversized footprint / undersized pad — oversized footprints used
+to clip at the 256px frame edge silently, #79 r2 note 6); an empty bbox means
+the solo/recolor contract misfired. Both are fold-in errors, never blessed.
+"""
+
+
+def bbox_violation(box, res):
+    """box = (x, y, w, h) px content bbox on a res*res canvas.
+    Returns the violation string, or None if the box is fold-in-clean."""
+    x, y, w, h = box
+    if w <= 0 or h <= 0:
+        return "empty render (no alpha content) — solo/recolor contract misfired"
+    if x < 0 or y < 0 or x + w > res or y + h > res:
+        return "bbox exceeds the %dpx canvas" % res
+    if x == 0 or y == 0 or x + w == res or y + h == res:
+        return ("content TOUCHES the %dpx canvas edge — clipped by the frame "
+                "(oversized footprint or undersized pad)" % res)
+    return None
