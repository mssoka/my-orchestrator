+def strip_png_metadata(path):
+    """Drop tEXt/iTXt/zTXt chunks from a written PNG. Blender 5.2's PNG saver
+    embeds a wall-clock `Date` tEXt chunk (RenderSettings.use_metadata is gone
+    in 5.x), so re-runs of the SAME .blend differed BYTE-wise while the pixels
+    never moved — briefing rule 3 wants byte-identical. Pixels (IDAT) and the
+    color chunks are untouched; each copied chunk keeps its own CRC."""
+    import struct
+    with open(path, "rb") as f:
+        data = f.read()
+    if data[:8] != b"\x89PNG\r\n\x1a\n":
+        raise SystemExit("not a PNG: %s" % path)
+    out = bytearray(data[:8])
+    i = 8
+    while i < len(data):
+        ln, = struct.unpack(">I", data[i:i + 4])
+        if data[i + 4:i + 8] not in (b"tEXt", b"iTXt", b"zTXt"):
+            out += data[i:i + 12 + ln]
+        i += 12 + ln
+    with open(path, "wb") as f:
+        f.write(bytes(out))
+
+
