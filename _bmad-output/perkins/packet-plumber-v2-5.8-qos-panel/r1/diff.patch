@@ -0,0 +1,431 @@
+package main
+
+import "core:fmt"
+import pp "../core"
+import rl "vendor:raylib"
+
+// app/qos_panel.odin — Story 5.8: the per-pipe QoS panel (user ruling
+// 2026-08-14). Replaces the 3.2 invisible emphasis dial + text readout:
+// selecting a pipe shows per-type lane rows, the resulting split with real
+// numbers, and the manual weight editor. Auto-reservation (default): the
+// split FOLLOWS the player's type→lane assignments from the data-driven
+// ladder (balance.json lane_auto_reserve_ladder) — the app writes the
+// computed weight set through the SAME serialized command as the manual
+// editor (Cmd_Set_Emphasis, weights payload — replay equality by
+// construction, E10). Manual pipes are marked + revertible to auto.
+//
+// The mode is DERIVED, never stored: a pipe is manual iff its current
+// weights differ from qos_auto_weights(its assignments) — so no extra
+// serialized state, and revert = write the auto set back. `qos_editing`
+// (app-side UI state) only controls whether the editor rows are expanded.
+//
+// Layout (screen px, top-left below the run HUD):
+//   row 0   title "QoS - pipe N - AUTO/MANUAL"
+//   rows 1-3  the lane split (Express/Standard/Best-effort) with % + bar
+//   rows 4..  per-type rows "Email -> Standard" (click the row to cycle lane)
+//   actions  [Edit weights|Auto] [Revert]
+//   (editing) preset chips  [Balanced] [Ex-heavy] [BE-heavy]
+//   (editing) nudge row     E [--] 70 [++] S [--] 30 [++] B [--] 0 [++]
+
+QOS_PANEL_X :: 12
+QOS_PANEL_Y :: 92
+QOS_PANEL_W :: 300
+QOS_ROW_H :: 22
+QOS_ROW0_Y :: QOS_PANEL_Y + 8
+
+// qos_panel_h — the panel's height (grows by two rows while the manual
+// editor is expanded).
+qos_panel_h :: proc(app: ^App) -> i32 {
+	n := 1 + 3 + i32(len(app.cat.packet_types)) + 1 // title + split + classes + actions
+	if app.qos_editing {
+		n += 2 // preset chips + nudges
+	}
+	return 8 + n * QOS_ROW_H
+}
+
+qos_panel_rect :: proc(app: ^App) -> rl.Rectangle {
+	return {f32(QOS_PANEL_X), f32(QOS_PANEL_Y), f32(QOS_PANEL_W), f32(qos_panel_h(app))}
+}
+
+qos_row_y :: proc(row: i32) -> i32 {
+	return QOS_ROW0_Y + row * QOS_ROW_H
+}
+
+// qos_class_row_rect — the per-type row (click to cycle the class's lane).
+qos_class_row_rect :: proc(app: ^App, i: i32) -> rl.Rectangle {
+	return {f32(QOS_PANEL_X + 4), f32(qos_row_y(4 + i)), f32(QOS_PANEL_W - 8), f32(QOS_ROW_H)}
+}
+
+// qos_action_rect — the actions row's buttons: slot 0 = [Edit weights] (auto)
+// or [Auto] (manual); slot 1 = [Revert].
+qos_action_rect :: proc(app: ^App, slot: i32) -> rl.Rectangle {
+	y := qos_row_y(4 + i32(len(app.cat.packet_types)))
+	if slot == 0 {
+		return {f32(QOS_PANEL_X + 8), f32(y + 3), 120, 17}
+	}
+	return {f32(QOS_PANEL_X + 136), f32(y + 3), 90, 17}
+}
+
+// qos_preset_chip_rect — the manual quick-set chips ([Balanced] [Ex-heavy]
+// [BE-heavy]) — one per lane_presets entry.
+qos_preset_chip_rect :: proc(app: ^App, i: i32) -> rl.Rectangle {
+	y := qos_row_y(5 + i32(len(app.cat.packet_types)))
+	n := i32(max(1, len(app.cat.balance.lane_presets)))
+	w := (QOS_PANEL_W - 16 - 4 * (n - 1)) / n
+	return {f32(QOS_PANEL_X + 8 + i * (w + 4)), f32(y + 3), f32(w), 17}
+}
+
+// qos_nudge_rect — the manual editor's −/+ button for one lane.
+qos_nudge_rect :: proc(app: ^App, lane: i32, minus: bool) -> rl.Rectangle {
+	y := qos_row_y(6 + i32(len(app.cat.packet_types)))
+	x := QOS_PANEL_X + 8 + lane * 96
+	if minus {
+		return {f32(x + 20), f32(y + 3), 20, 16}
+	}
+	return {f32(x + 72), f32(y + 3), 20, 16}
+}
+
+// qos_mode_manual — the DERIVED mode: manual iff the pipe's current weights
+// differ from the auto-ladder result for its assignments (or the editor is
+// open). Untouched pipes are auto (weights == default preset == auto of the
+// empty assignment set).
+qos_mode_manual :: proc(app: ^App, ps: u32) -> bool {
+	if app.qos_editing {
+		return true
+	}
+	if int(ps) >= len(app.state.topology.pipe_weights) {
+		return false
+	}
+	w := app.state.topology.pipe_weights[ps]
+	auto := pp.qos_auto_weights(&app.state.topology, &app.cat, u32(app.sel_pipe))
+	return w != auto
+}
+
+// qos_apply_auto — the auto-follow write-through: recompute the ladder split
+// for the pipe's CURRENT assignments and write it through the serialized
+// command (Cmd_Set_Emphasis, weights). No-op when the weights didn't change
+// (a same-state assignment must not spam the action log). A rejection is
+// surfaced, never silent (the toast). NEVER-drop safety by construction: the
+// auto set never zeros an in-play lane and every never-drop class rides an
+// in-play lane — the bus guard is belt-and-braces here.
+qos_apply_auto :: proc(app: ^App, pipe: u32) {
+	ps, ok := pp.pipe_slot(&app.state.topology, pipe)
+	if !ok {
+		return
+	}
+	w := pp.qos_auto_weights(&app.state.topology, &app.cat, pipe)
+	if app.state.topology.pipe_weights[ps] == w {
+		return // nothing to write — the split already matches the ladder
+	}
+	cmd := pp.Cmd_Set_Emphasis{pipe = pipe, weights = w}
+	if _, err := pp.topology_apply_edit(&app.state.topology, pp.Command{1, cmd}, &app.cat); err == .None {
+		append(&app.state.action_log, pp.Command{
+			apply_tick = app.tick + 1,
+			kind = cmd,
+		})
+	} else {
+		app.last_reject = err
+		app.reject_tick = app.tick
+	}
+}
+
+// set_lane_class — assign `class` to `lane` on the selected pipe (the 1/2 +
+// E/S/B keys and the panel's row clicks both land here). Fast-path apply +
+// log, then the auto-follow UNLESS the manual editor is open (manual mode
+// owns the weights — assignments still apply, the split does not auto-follow;
+// [Revert] re-runs the ladder over all assignments).
+set_lane_class :: proc(app: ^App, class: u16, lane: u8) {
+	if app.sel_pipe < 0 {
+		return
+	}
+	if u32(class) >= u32(len(app.cat.packet_types)) {
+		return
+	}
+	pipe := u32(app.sel_pipe)
+	ps, ok := pp.pipe_slot(&app.state.topology, pipe)
+	if !ok {
+		return
+	}
+	// Gate the auto-follow on the pipe's PRE-EDIT derived mode: an AUTO pipe
+	// (weights == the ladder's current result) follows its assignments — a
+	// MANUAL pipe (the player hand-tuned weights) keeps them until an explicit
+	// [Auto]/[Revert] (the ruling's "revertible to auto"). A silent clobber of
+	// player work on the panel's primary affordance would be a UX bug.
+	was_auto := !qos_mode_manual(app, ps)
+	cmd := pp.Cmd_Set_Lane{pipe = pipe, class = class, lane = lane}
+	if _, err := pp.topology_apply_edit(&app.state.topology, pp.Command{1, cmd}, &app.cat); err == .None {
+		append(&app.state.action_log, pp.Command{
+			apply_tick = app.tick + 1,
+			kind = cmd,
+		})
+		if was_auto {
+			qos_apply_auto(app, pipe)
+		}
+	} else {
+		app.last_reject = err
+		app.reject_tick = app.tick
+	}
+}
+
+// qos_cycle_class_lane — the panel row click: advance a class's lane on the
+// selected pipe E -> S -> B -> E.
+qos_cycle_class_lane :: proc(app: ^App, class: u16) {
+	if app.sel_pipe < 0 {
+		return
+	}
+	if u32(class) >= u32(len(app.cat.packet_types)) {
+		return
+	}
+	cur := pp.qos_lane_of(&app.state.topology, &app.cat, u32(app.sel_pipe), class)
+	never_drop := app.cat.packet_types[class].max_loss_pct == 0
+	for step in 1..=pp.LANE_COUNT {
+		next := u8((i32(cur) + i32(step)) % pp.LANE_COUNT)
+		// A never-drop class may not be parked on a zero-weight lane (E6) — skip
+		// zeroed lanes so the cycle advances to a parkable one instead of
+		// deadlocking on a rejection toast. Droppable classes may starve a
+		// zeroed lane (the trade-off mechanic) — the cycle offers it.
+		if never_drop {
+			ps, ok := pp.pipe_slot(&app.state.topology, u32(app.sel_pipe))
+			if !ok {
+				return
+			}
+			if app.state.topology.pipe_weights[ps][next] == 0 {
+				continue
+			}
+		}
+		set_lane_class(app, class, next)
+		return
+	}
+	// all three lanes are zeroed on a never-drop pipe — nothing parkable
+	app.last_reject = .Invalid_Weights
+	app.reject_tick = app.tick
+}
+
+// qos_nudge — the manual editor: move one lane's weight by +/-5 (clamped to
+// 0..MAX_WEIGHT), then write the set through the serialized command. The 100
+// total is NOT enforced (WFQ weights are arbitrary integers — the presets
+// [4,2,1] don't sum to 100 either); the derived % readout follows. E6 + the
+// all-zero guard live in the bus (a zeroed never-drop lane rejects).
+qos_nudge :: proc(app: ^App, lane: u8, minus: bool) {
+	if app.sel_pipe < 0 {
+		return
+	}
+	ps, ok := pp.pipe_slot(&app.state.topology, u32(app.sel_pipe))
+	if !ok || lane >= pp.LANE_COUNT {
+		return
+	}
+	w := app.state.topology.pipe_weights[ps]
+	delta := i32(5)
+	if minus {
+		delta = -5
+	}
+	nv := w[lane] + delta
+	nv = max(0, min(pp.MAX_WEIGHT, nv))
+	if nv == w[lane] {
+		return // clamped — nothing to write
+	}
+	w[lane] = nv
+	cmd := pp.Cmd_Set_Emphasis{pipe = u32(app.sel_pipe), weights = w}
+	if _, err := pp.topology_apply_edit(&app.state.topology, pp.Command{1, cmd}, &app.cat); err == .None {
+		append(&app.state.action_log, pp.Command{
+			apply_tick = app.tick + 1,
+			kind = cmd,
+		})
+	} else {
+		app.last_reject = err
+		app.reject_tick = app.tick
+	}
+}
+
+// qos_apply_preset — the manual quick-set chips: write a catalog preset's
+// weight set through the serialized command (the chip marks the pipe manual —
+// the derived mode reads the non-auto weights).
+qos_apply_preset :: proc(app: ^App, preset: u16) {
+	if app.sel_pipe < 0 {
+		return
+	}
+	if u32(preset) >= u32(len(app.cat.balance.lane_presets)) {
+		return
+	}
+	w := app.cat.balance.lane_presets[preset].weights
+	cmd := pp.Cmd_Set_Emphasis{pipe = u32(app.sel_pipe), weights = w}
+	if _, err := pp.topology_apply_edit(&app.state.topology, pp.Command{1, cmd}, &app.cat); err == .None {
+		append(&app.state.action_log, pp.Command{
+			apply_tick = app.tick + 1,
+			kind = cmd,
+		})
+	} else {
+		app.last_reject = err
+		app.reject_tick = app.tick
+	}
+}
+
+// qos_revert_auto — the [Revert] / [Auto] button: drop the manual weights,
+// re-run the ladder over ALL current assignments, close the editor.
+qos_revert_auto :: proc(app: ^App) {
+	if app.sel_pipe < 0 {
+		return
+	}
+	app.qos_editing = false
+	qos_apply_auto(app, u32(app.sel_pipe))
+}
+
+// qos_panel_click — the panel's hit-test (called on left PRESS when a pipe is
+// selected, before the tray/drag start). Returns true when the press was
+// swallowed: a row click cycles the class's lane; [Edit weights]/[Auto] and
+// [Revert] toggle mode; the chips + nudges edit the weights. A click on the
+// panel's background swallows too (it never deselects, never starts a drag).
+qos_panel_click :: proc(app: ^App, mouse: rl.Vector2) -> bool {
+	if app.sel_pipe < 0 {
+		return false
+	}
+	if !rl.CheckCollisionPointRec(mouse, qos_panel_rect(app)) {
+		return false
+	}
+	// per-type rows (class rows start at row 4)
+	for i in 0..<len(app.cat.packet_types) {
+		if rl.CheckCollisionPointRec(mouse, qos_class_row_rect(app, i32(i))) {
+			qos_cycle_class_lane(app, u16(i))
+			return true
+		}
+	}
+	// actions row
+	ps, ok := pp.pipe_slot(&app.state.topology, u32(app.sel_pipe))
+	if !ok {
+		return false // the selected pipe is gone — nothing to edit
+	}
+	ar0 := qos_action_rect(app, 0)
+	if rl.CheckCollisionPointRec(mouse, ar0) {
+		if app.qos_editing || qos_mode_manual(app, ps) {
+			qos_revert_auto(app)
+		} else {
+			app.qos_editing = true
+		}
+		return true
+	}
+	if rl.CheckCollisionPointRec(mouse, qos_action_rect(app, 1)) {
+		qos_revert_auto(app)
+		return true
+	}
+	// manual editor rows
+	if app.qos_editing {
+		for i in 0..<len(app.cat.balance.lane_presets) {
+			if rl.CheckCollisionPointRec(mouse, qos_preset_chip_rect(app, i32(i))) {
+				qos_apply_preset(app, u16(i))
+				return true
+			}
+		}
+		for lane in 0..<3 {
+			if rl.CheckCollisionPointRec(mouse, qos_nudge_rect(app, i32(lane), true)) {
+				qos_nudge(app, u8(lane), true)
+				return true
+			}
+			if rl.CheckCollisionPointRec(mouse, qos_nudge_rect(app, i32(lane), false)) {
+				qos_nudge(app, u8(lane), false)
+				return true
+			}
+		}
+	}
+	return true // the panel background swallows
+}
+
+// draw_qos_panel — the panel (called from draw_hud when a pipe is selected).
+// Legible text per the user's 2026-08-14 note (>= 14px, ink/ink_soft on the
+// cream card — the full font story is a later story). ASCII-only literals
+// (the byte-truncating draw_text — lint gate 6).
+draw_qos_panel :: proc(app: ^App) {
+	if app.sel_pipe < 0 {
+		app.qos_editing = false
+		return
+	}
+	ps, ok := pp.pipe_slot(&app.state.topology, u32(app.sel_pipe))
+	if !ok {
+		app.qos_editing = false // the selected pipe is gone — close the editor
+		return
+	}
+	p := app.palette
+	panel := qos_panel_rect(app)
+	rl.DrawRectangleRounded(panel, 0.12, 6, rl.Color{240, 232, 212, 235})
+
+	manual := qos_mode_manual(app, ps)
+	cur := app.state.topology.pipe_weights[ps]
+	mode_label := "AUTO" if !manual else "MANUAL"
+	title := fmt.tprintf("QoS - pipe %d - %s", app.sel_pipe, mode_label)
+	draw_text(app, title, QOS_PANEL_X + 10, qos_row_y(0) + 2, 16, p.ink)
+
+	// the resulting split — the caps the flow will allocate (pure proc — a
+	// fast-path edit this frame has not been stepped yet, so flow.lane_caps
+	// would be stale; qos_pipe_caps is the same allocation the flow rebuilds).
+	caps := pp.qos_pipe_caps(&app.state.topology, &app.cat, ps, u32(app.sel_pipe))
+	labels := [3]string{"Express", "Standard", "Best-eff"}
+	cols := [3]rl.Color{p.lane_express, p.lane_standard, p.lane_best_effort}
+	total := u64(caps[0]) + u64(caps[1]) + u64(caps[2])
+	for lane in 0..<3 {
+		y := qos_row_y(1 + i32(lane))
+		pct := i32(0)
+		if total > 0 {
+			pct = i32((u64(caps[lane]) * 100 + total / 2) / total)
+		}
+		label := fmt.tprintf("%s %d%%", labels[lane], pct)
+		draw_text(app, label, QOS_PANEL_X + 10, y + 3, 15, cols[lane])
+		// the proportion bar (width = share of the panel's bar area)
+		bw := i32((QOS_PANEL_W - 150) * u64(caps[lane]) / max(1, total))
+		if bw > 0 {
+			rl.DrawRectangle(QOS_PANEL_X + 118, y + 7, bw, 8, cols[lane])
+		}
+	}
+
+	// per-type rows — class name + its lane on this pipe (default or the
+	// override); clicking the row cycles the lane (or 1/2 + E/S/B).
+	for i in 0..<len(app.cat.packet_types) {
+		row := qos_class_row_rect(app, i32(i))
+		lane := pp.qos_lane_of(&app.state.topology, &app.cat, u32(app.sel_pipe), u16(i))
+		row_label := fmt.tprintf("%s -> %s", app.cat.packet_types[i].display, lane_label(lane))
+		col := p.ink_soft
+		if i32(app.sel_class) == i32(i) {
+			col = p.ink // the key-target class stands out
+			row_label = fmt.tprintf("%s -> %s  [1/2 + E/S/B]", app.cat.packet_types[i].display, lane_label(lane))
+		}
+		draw_text(app, row_label, i32(row.x) + 6, i32(row.y) + 3, 15, col)
+	}
+
+	// actions row — [Edit weights] (auto) / [Auto] (manual) + [Revert].
+	a0 := qos_action_rect(app, 0)
+	a1 := qos_action_rect(app, 1)
+	btn0 := "Edit weights" if !manual else "Auto"
+	rl.DrawRectangleRounded(a0, 0.3, 4, rl.Color{226, 216, 190, 255})
+	rl.DrawRectangleRounded(a1, 0.3, 4, rl.Color{226, 216, 190, 255})
+	draw_text(app, btn0, i32(a0.x) + 8, i32(a0.y) + 1, 13, p.ink)
+	draw_text(app, "Revert", i32(a1.x) + 8, i32(a1.y) + 1, 13, p.ink)
+
+	// the manual editor rows
+	if app.qos_editing {
+		// preset quick-set chips
+		for i in 0..<len(app.cat.balance.lane_presets) {
+			chip := qos_preset_chip_rect(app, i32(i))
+			rl.DrawRectangleRounded(chip, 0.3, 4, rl.Color{226, 216, 190, 255})
+			draw_text(app, app.cat.balance.lane_presets[i].display, i32(chip.x) + 5, i32(chip.y) + 1, 12, p.ink)
+		}
+		// the weight nudges: E [--] 70 [++]  S [--] 30 [++]  B [--] 0 [++]
+		short := [3]string{"E", "S", "B"}
+		for lane in 0..<3 {
+			x := QOS_PANEL_X + 8 + lane * 96
+			y := qos_row_y(6 + i32(len(app.cat.packet_types)))
+			draw_text(app, short[lane], i32(x), y + 4, 14, cols[lane])
+			m := qos_nudge_rect(app, i32(lane), true)
+			ppp := qos_nudge_rect(app, i32(lane), false)
+			rl.DrawRectangleRounded(m, 0.3, 4, rl.Color{226, 216, 190, 255})
+			rl.DrawRectangleRounded(ppp, 0.3, 4, rl.Color{226, 216, 190, 255})
+			draw_text(app, "-", i32(m.x) + 6, i32(m.y), 14, p.ink)
+			draw_text(app, "+", i32(ppp.x) + 6, i32(ppp.y), 14, p.ink)
+			wv := fmt.tprintf("%d", cur[lane])
+			draw_text(app, wv, i32(x + 44), y + 4, 14, p.ink)
+		}
+	}
+
+	// the transient rejection toast (a rejected QoS edit is never silent —
+	// e.g. E6's never-drop guard once that content exists)
+	if app.last_reject != .None && app.tick - app.reject_tick < 30 {
+		draw_text(app, reject_label(app.last_reject), QOS_PANEL_X + 10, i32(panel.y + panel.height) - 18, 14, rl.Color{200, 60, 60, 255})
+	}
+}
