+	testing.expect(t, e == .None, "re-override must apply")
+	_, e = topology_apply_edit(&s.topology, Command{kind = Cmd_Set_Lane{pipe = pipe, class = u16(stream_idx), lane = LANE_STANDARD}}, cat)
+	testing.expect(t, e == .None, "streaming back to Standard must apply")
+	testing.expect_value(t, qos_auto_weights(&s.topology, cat, pipe), [3]i32{0, 70, 30})
+
+	// all assignments on Standard: in-play = {S} only = 1 lane → the ladder's
+	// [100] row → Standard 100% (the spec's documented all-on-Standard edge —
+	// the one place the 1-lane row is reachable once an assignment exists)
+	_, e = topology_apply_edit(&s.topology, Command{kind = Cmd_Set_Lane{pipe = pipe, class = u16(email_idx), lane = LANE_STANDARD}}, cat)
+	testing.expect(t, e == .None, "email→Standard must apply")
+	testing.expect_value(t, qos_auto_weights(&s.topology, cat, pipe), [3]i32{0, 100, 0})
+
+	// email on Express, streaming on Standard: in-play = {E, S} = 2 → 70/30
+	_, e = topology_apply_edit(&s.topology, Command{kind = Cmd_Set_Lane{pipe = pipe, class = u16(email_idx), lane = LANE_EXPRESS}}, cat)
+	testing.expect(t, e == .None, "email→Express must apply")
+	testing.expect_value(t, qos_auto_weights(&s.topology, cat, pipe), [3]i32{70, 30, 0})
+
+	// a second pipe is independent: its untouched state is the default preset
+	append(&s.action_log, Command{apply_tick = 1, kind = Cmd_Draw_Pipe{a = res, b = rt, tier = std}})
+	step_n(&s, 1, cat) // applies the second draw — pipe id 1
+	testing.expect_value(t, qos_auto_weights(&s.topology, cat, 1), [3]i32{1, 1, 1})
+}
+
+@(test)
+test_qos_auto_weights_never_drop_safe :: proc(t: ^testing.T) {
+	// never-drop safety by construction: every in-play lane gets a positive
+	// share, and a never-drop class rides either its assigned lane (in-play)
+	// or Standard (always in-play) — so the AUTO result can never zero a
+	// never-drop lane (E6 is reachable only via manual edits). Pinned against
+	// the banking variant: assign banking→Express and email→Best-effort — the
+	// auto weights must give Express + Standard + Best-effort all > 0.
+	cat_storage: Catalogs
+	cat := never_drop_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 1, cat.hash, TEST_LOGIC_HZ)
+	res, rt, _ := test_seed_fixture(&s, cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	append(&s.action_log, Command{apply_tick = 1, kind = Cmd_Draw_Pipe{a = res, b = rt, tier = std}})
+	step_n(&s, 1, cat) // applies the logged draw — pipe id 0 exists
+	bank_idx := u16(len(cat.packet_types) - 1) // banking (never-drop, default Express)
+	email_idx, _ := class_index(cat, "email")
+	_, e := topology_apply_edit(&s.topology, Command{kind = Cmd_Set_Lane{pipe = 0, class = bank_idx, lane = LANE_EXPRESS}}, cat)
+	testing.expect(t, e == .None, "banking→Express must apply")
+	_, e = topology_apply_edit(&s.topology, Command{kind = Cmd_Set_Lane{pipe = 0, class = u16(email_idx), lane = LANE_BEST_EFFORT}}, cat)
+	testing.expect(t, e == .None, "email→Best-effort must apply")
+	w := qos_auto_weights(&s.topology, cat, 0)
+	// banking rides Express (in-play), email rides Best-effort (in-play),
+	// Standard reserved (always in-play) → every lane > 0
+	testing.expectf(t, w[LANE_EXPRESS] > 0 && w[LANE_STANDARD] > 0 && w[LANE_BEST_EFFORT] > 0,
+		"auto weights must never zero a lane a never-drop class can ride, got %v", w)
+	// …and the command path accepts it (the E6 bus guard agrees)
+	_, e = topology_apply_edit(&s.topology, Command{kind = Cmd_Set_Emphasis{pipe = 0, weights = w}}, cat)
+	testing.expect(t, e == .None, "the auto weight set must pass the bus guard (E6)")
+
+	// UNASSIGNED never-drop default lane (the review-warning case): banking
+	// (never-drop, default Express) is NEVER assigned — only email→Best-effort.
+	// Its default lane must still be folded into the in-play set, so the auto
+	// result keeps Express > 0 and the bus never rejects an auto-follow.
+	s2: Run_State
+	defer run_destroy(&s2)
+	run_init(&s2, 1, cat.hash, TEST_LOGIC_HZ)
+	res2, rt2, _ := test_seed_fixture(&s2, cat)
+	append(&s2.action_log, Command{apply_tick = 1, kind = Cmd_Draw_Pipe{a = res2, b = rt2, tier = std}})
+	step_n(&s2, 1, cat)
+	_, e = topology_apply_edit(&s2.topology, Command{kind = Cmd_Set_Lane{pipe = 0, class = u16(email_idx), lane = LANE_BEST_EFFORT}}, cat)
+	testing.expect(t, e == .None, "email→Best-effort must apply")
+	w2 := qos_auto_weights(&s2.topology, cat, 0)
+	testing.expectf(t, w2[LANE_EXPRESS] > 0 && w2[LANE_STANDARD] > 0 && w2[LANE_BEST_EFFORT] > 0,
+		"unassigned never-drop default lane must stay reserved, got %v", w2)
+	_, e = topology_apply_edit(&s2.topology, Command{kind = Cmd_Set_Emphasis{pipe = 0, weights = w2}}, cat)
+	testing.expect(t, e == .None, "the unassigned-never-drop auto set must pass the bus guard (E6)")
+}
