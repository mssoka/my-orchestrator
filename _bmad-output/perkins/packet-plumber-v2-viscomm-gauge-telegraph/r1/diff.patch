+package main
+
+// gauge_wiring_test.odin — v2-viscomm-gauge-telegraph's APP-LAYER wiring
+// pins (the r1 verification-gap findings — the repo's #1 blocker genus:
+// "a wiring regression that never draws would pass every compile gate and
+// every golden"). The render-package unit tests pin the gauge procs in
+// isolation; these drive the REAL app seams so a removed CALL fails red:
+//
+//   (a) start_run zeroes the gauge-ease state — the retry path (R/Enter)
+//       must never carry a previous run's mid-ease level, stale target, or
+//       live chunk cue into a fresh run (spurious flash + cross-run fill
+//       animation on every retry, invisible to every golden);
+//   (b) feed_drop_sites (the per-tick presentation-feed seam) feeds the
+//       gauge targets from live sim truth — deleting the gauge_tick call
+//       inside the seam ships the whole feature silently disabled while
+//       unit tests, goldens, and palcheck stay green (palcheck feeds its
+//       own view by hand; the harness never feeds by design).
+//
+// The pullback_test fixture + drive style (arm first, then call the REAL
+// proc) — NOT a bare gauge_reset/gauge_tick call.
+
+import "core:testing"
+import pp "../core"
+import rnd "../app/render"
+
+@(test)
+start_run_zeroes_gauge_ease_state :: proc(t: ^testing.T) {
+	app: App
+	pullback_test_app(&app)
+	defer pp.run_destroy(&app.state)
+	defer pp.catalogs_destroy(&app.cat)
+	app.run_live = true // the fixture already run_init'd State — take the clean destroy-then-reinit path
+	app.cat.balance.logic_hz = 20
+	// ARM: a mid-ease death state — seeded, tween live toward a stale
+	// target, chunk cue still flashing (exactly what a retry would inherit)
+	app.view.gauges.health = rnd.Gauge_Ease{
+		seeded = true, active = true, start = 90, target = 34,
+		t0 = 412, flashing = true, flash_t0 = 413,
+	}
+	app.view.gauges.pool.seeded = true
+	app.view.gauges.sla_ms[0] = rnd.Gauge_Ease{seeded = true, target = 45, active = true}
+	// DRIVE the real path
+	start_run(&app, 42)
+	// the fresh run's gauges are pristine: unseeded (the first reading of
+	// the fresh run seeds at raw — no fill animation from the old level)
+	zeroed := !app.view.gauges.health.seeded && !app.view.gauges.health.active &&
+		!app.view.gauges.health.flashing && !app.view.gauges.pool.seeded &&
+		!app.view.gauges.sla_ms[0].seeded
+	testing.expect(t, zeroed, "start_run must drop every gauge tween + chunk cue (a fresh run starts from truth)")
+}
+
+@(test)
+presentation_feed_feeds_gauge_targets :: proc(t: ^testing.T) {
+	app: App
+	pullback_test_app(&app)
+	defer pp.run_destroy(&app.state)
+	defer pp.catalogs_destroy(&app.cat)
+	app.cat.balance.pool_max_packets = 200
+	app.tick = 10
+	// live sim truth: health 55, pool 2/200 (1%), SLA row 0 with 8 delivered
+	// (avg 12ms) + 2 dropped (loss 20%)
+	app.state.health.meter_pct = 55
+	append(&app.state.flow.packets, pp.Packet{})
+	append(&app.state.flow.packets, pp.Packet{})
+	append(&app.state.flow.sla, pp.Sla_Accumulator{})
+	app.state.flow.sla[0].delivered = 8
+	app.state.flow.sla[0].total_latency_ms = 100
+	app.state.flow.sla[0].dropped = 2
+	// DRIVE the real per-tick seam (the fixed-timestep loop's feed)
+	feed_drop_sites(&app)
+	testing.expectf(t, app.view.gauges.health.target == 55,
+		"the presentation feed lands the health target from meter_pct: got %d", app.view.gauges.health.target)
+	testing.expectf(t, app.view.gauges.pool.target == 1,
+		"the presentation feed lands the pool target (2/200 = 1%%): got %d", app.view.gauges.pool.target)
+	testing.expectf(t, app.view.gauges.sla_ms[0].target == 12,
+		"the presentation feed lands the SLA avg-ms target (100/8 = 12): got %d", app.view.gauges.sla_ms[0].target)
+	testing.expectf(t, app.view.gauges.sla_loss[0].target == 20,
+		"the presentation feed lands the SLA loss target (2/10 = 20%%): got %d", app.view.gauges.sla_loss[0].target)
+	// the seeded display reads RAW at the seed tick (no ramp — the wiring
+	// carries the seed rule, not just the target)
+	testing.expectf(t, rnd.gauge_read(&app.view, &app.view.gauges.health, 55, 10) == 55,
+		"the fed gauge seeds at raw (no 0->value fill at run start)")
+}
