diff --git a/app/render/gauge.odin b/app/render/gauge.odin
new file mode 100644
index 0000000..1f2e286
--- /dev/null
+++ b/app/render/gauge.odin
@@ -0,0 +1,288 @@
+package render
+
+// gauge.odin — v2-viscomm-gauge-telegraph (viscomm audit finding B,
+// 2026-08-25): the gauges TELEGRAPH, not snap. Health / pool / SLA values
+// moving fast (drain, refill, SLA decay) read as a strobe when the fill
+// snaps value-to-value; each gauge now carries a display value that EASES
+// toward the raw sim value via a pinned stepped table. Pure view layer
+// (ODN-1): nothing here writes sim state, and the raw truth channels —
+// numbers, counters, breach latches, state colors — stay RAW (the eased
+// quantity is only the drawn LEVEL / the eased display number).
+//
+import pp "../../core"
+
+// EASE16 — the pinned 16-entry ease-out envelope (the PULSE16 §10.4
+// pattern: no transcendentals in the rasterized path; the curve is a
+// precomputed quadratic ease-out, indexed by a tick-derived integer phase).
+// [0] == 0 pins tween-start continuity (display never pops at retarget);
+// [15] == 1 pins EXACT arrival (a finished tween reads raw to the byte).
+EASE16 :: [16]f32{
+	0.000, 0.129, 0.249, 0.360, 0.462, 0.556, 0.640, 0.716,
+	0.782, 0.840, 0.889, 0.929, 0.960, 0.982, 0.996, 1.000,
+}
+
+// EASE_ADV — table entries per tick (the pulse_factor advance idiom). 2
+// entries/tick = an 8-tick tween = 0.4 s at 20 Hz logic: fast enough to
+// read as one motion, slow enough to telegraph WHICH WAY the level moves.
+EASE_ADV :: u64(2)
+
+// CHUNK_PCT — the chunk-flash threshold in gauge units (percent-of-range
+// for the bars): an instantaneous delta >= this fires the ONE-SHOT chunk
+// cue (finding B item 5: "a single-frame flash/chunk cue is allowed ONCE,
+// then ease"). 25 units = a quarter of the gauge in one tick — a pool
+// drained by an event, not an ordinary drain tick.
+CHUNK_PCT :: i32(25)
+
+// CHUNK_SLA_MS — the same re-anchor threshold for the avg-ms display (its
+// units are MILLISECONDS, not pct — one constant can't serve both unit
+// systems without lying about one; the SLA rows draw no flash geometry, so
+// this only re-anchors the glide on a jump worth restarting for).
+CHUNK_SLA_MS :: i32(25)
+
+// CHUNK_FLASH — the chunk cue's table-driven fade (deterministic like the
+// rest): the ghost of the vanished/appeared chunk draws at these alphas
+// for len(CHUNK_FLASH) ticks after the jump, while the fill eases through
+// it. Fill geometry ONLY (never lines — the rlsw line-alpha renders
+// opaque; the 08-23 look-polish lesson).
+CHUNK_FLASH :: [3]f32{0.85, 0.45, 0.18}
+
+// compile-time integrity pins (the `when <bad> { BROKEN :: 1/0 }` idiom —
+// constant division by zero is a compile error when the branch is live).
+when EASE16[0] != 0.0 {
+	EASE16_START_BROKEN :: 1 / 0
+}
+when EASE16[len(EASE16) - 1] != 1.0 {
+	EASE16_END_BROKEN :: 1 / 0
+}
+when EASE_ADV == 0 || EASE_ADV > 4 {
+	EASE_ADV_BROKEN :: 1 / 0
+}
+when CHUNK_PCT <= 0 || CHUNK_PCT > 50 {
+	CHUNK_PCT_BROKEN :: 1 / 0
+}
+when CHUNK_SLA_MS <= 0 || CHUNK_SLA_MS > 1000 {
+	CHUNK_SLA_MS_BROKEN :: 1 / 0
+}
+when len(CHUNK_FLASH) < 1 {
+	CHUNK_FLASH_BROKEN :: 1 / 0
+}
+
+// Gauge_Ease — one gauge's display-ease state. View-owned presentation
+// state (ODN-1): never serialized, never read by the sim, reset per run.
+// ZERO-VALUE = the harness contract: unseeded + inactive, so `gauge_read`
+// returns the raw value EXACTLY — the T2 capture path never feeds targets
+// and every golden stays byte-identical by construction (the pkt_interp
+// precedent: the app steps presentation, the harness renders snapshot-
+// exact).
+Gauge_Ease :: struct {
+	seeded:   bool, // a first target has landed (display == that raw — no 0->value fill at run start)
+	active:   bool, // a tween is in flight (false = display reads raw)
+	start:    i32,  // display value at tween start
+	target:   i32,  // the raw value the tween chases (== current raw while fed)
+	t0:       u64,  // the tick the tween started (phase = (tick - t0) * EASE_ADV)
+	flash_t0: u64,  // the chunk cue's birth tick (gauge_flash_read expires it)
+	flashing: bool, // a chunk cue is running (one per threshold crossing)
+}
+
+// Gauges — the app's whole gauge-ease state, one slot per drawn gauge.
+// SLA slots are FIXED (no per-run allocation — the View is a value struct):
+// 16 covers the full planned roster (data/packet_types.json carries 2 live
+// classes + 7 planned = 9; 16 is headroom) — a class beyond the table
+// simply never feeds, and an unfed gauge reads raw (the fallback IS the
+// zero value, pinned by the unfed test).
+Gauges :: struct {
+	health:   Gauge_Ease,    // the Network Health meter bar (0..100)
+	pool:     Gauge_Ease,    // the pool gauge bar (0..100, clamped)
+	sla_ms:   [16]Gauge_Ease, // per-class avg-latency display (ms)
+	sla_loss: [16]Gauge_Ease, // per-class loss display (pct)
+}
+
+// gauge_reset — a fresh run drops every tween + cue (the spawn_fx_reset
+// precedent: node/class identity recycles, stale display state must never
+// leak across runs).
+gauge_reset :: proc(g: ^Gauges) {
+	g^ = {}
+}
+
+// gauge_display_at — the tween math, pure: display = start + (target -
+// start) * EASE16[phase]. Caller guarantees phase < len(EASE16).
+gauge_display_at :: proc(g: ^Gauge_Ease, phase: int) -> i32 {
+	table := EASE16 // local copy — a constant can't be indexed by a runtime index
+	disp := f32(g.start) + f32(g.target - g.start) * table[phase]
+	if disp >= 0 {
+		return i32(disp + 0.5) // round half-up (the hud() rule — deterministic)
+	}
+	return i32(disp - 0.5)
+}
+
+// gauge_phase — the tween's tick-derived integer phase (entries advanced
+// since t0), or -1 when the tween has arrived (phase past the table).
+gauge_phase :: proc(g: ^Gauge_Ease, tick: u64) -> int {
+	if tick < g.t0 {
+		return -1 // defensive: a clock rewind reads as arrived (tick is monotone in practice)
+	}
+	phase := (tick - g.t0) * EASE_ADV
+	if phase >= u64(len(EASE16)) {
+		return -1
+	}
+	return int(phase)
+}
+
+// gauge_read — the ONE display seam every eased gauge draws through (the
+// pulse_read pattern). Returns the eased display value: raw when the gauge
+// is unfed (the harness capture path — byte-identical goldens by
+// construction), raw when the tween arrived, raw + CLEARED when
+// reduced-motion is on (7.3/E9.2: snap immediately — the most legible
+// static reading, exactly like pulse_read pins PULSE16 to full width).
+gauge_read :: proc(v: ^View, g: ^Gauge_Ease, raw: i32, tick: u64) -> i32 {
+	if v.reduced_motion {
+		return raw
+	}
+	if !g.active {
+		return raw
+	}
+	phase := gauge_phase(g, tick)
+	if phase < 0 {
+		return raw // arrived
+	}
+	return gauge_display_at(g, phase)
+}
+
+// gauge_flash_read — the chunk cue's current alpha factor (0 = no cue).
+// Table-driven + tick-derived; suppressed entirely under reduced-motion
+// (a flash is motion — the 7.3 doctrine's static-most-legible reading).
+gauge_flash_read :: proc(v: ^View, g: ^Gauge_Ease, tick: u64) -> f32 {
+	if v.reduced_motion || !g.flashing {
+		return 0
+	}
+	if tick < g.flash_t0 {
+		return 0 // defensive (monotone tick in practice)
+	}
+	age := int(tick - g.flash_t0)
+	if age >= len(CHUNK_FLASH) {
+		return 0 // expired
+	}
+	table := CHUNK_FLASH // local copy — a constant can't be indexed by a runtime index
+	return table[age]
+}
+
+// gauge_target — the per-tick feed (the app calls this once per STEPPED
+// tick, from the fixed-timestep loop; the harness never calls it). Sets
+// the tween target from live sim truth:
+//   - first feed after reset SEEDS (display = raw, zero animation);
+//   - a changed target rides the ACTIVE tween (phase NOT reset — small
+//     continuous deltas stay continuous, the chase); an ARRIVED tween
+//     re-engages like a fresh one (an arrived-but-active flag must never
+//     eat a later small retarget — the zombie-tween review finding);
+//   - an instantaneous delta >= `threshold` fires the chunk cue ONCE and
+//     re-anchors the tween from the current display (flash, then ease the
+//     full distance — finding B item 5);
+//   - reduced-motion never engages (snap: read stays raw) and keeps the
+//     target tracking so a mid-run toggle starts from truth.
+// `threshold` is in the gauge's own units (CHUNK_PCT for the pct bars,
+// CHUNK_SLA_MS for the avg-ms display — the unit mismatch the r1 review
+// flagged; one constant can't serve two unit systems).
+gauge_target :: proc(v: ^View, g: ^Gauge_Ease, raw: i32, tick: u64, threshold: i32) {
+	if v.reduced_motion {
+		// snap: never engage, but KEEP tracking the raw target so a mid-run
+		// motion toggle starts from truth (no stale tween, no false chunk cue)
+		g.seeded = true
+		g.active = false
+		g.flashing = false
+		g.target = raw
+		return
+	}
+	if !g.seeded {
+		g^ = {seeded = true, target = raw}
+		return
+	}
+	// flash-flag hygiene: the cue's life is age-based at read time; clear
+	// the stale flag at the feed so `flashing` always means "a cue is live
+	// or just fired" (a future consumer must never read a months-old true)
+	if g.flashing && tick >= g.flash_t0 + u64(len(CHUNK_FLASH)) {
+		g.flashing = false
+	}
+	if raw == g.target {
+		return
+	}
+	// an arrived tween re-engages (the zombie fix): `active` may still be
+	// set from a finished tween — treat it as inactive so the retarget
+	// eases instead of snapping value-to-value forever after.
+	if g.active && gauge_phase(g, tick) < 0 {
+		g.active = false
+	}
+	// the display the eye currently sits on (mid-ease math if live, else
+	// the last target — which is what the inactive/arrived read shows)
+	cur := g.target
+	if g.active {
+		cur = gauge_display_at(g, gauge_phase(g, tick))
+	}
+	jump := raw - g.target // the instantaneous delta vs the last-fed raw
+	if abs(jump) >= threshold {
+		// the chunk cue: one shot, then the ease carries the level across
+		g.flashing = true
+		g.flash_t0 = tick
+		g.start = cur // re-anchor: the glide restarts from what the eye sees
+		g.t0 = tick
+		g.active = true
+	} else if !g.active {
+		g.start = cur
+		g.t0 = tick
+		g.active = true
+	}
+	// an active tween just chases the new target (phase untouched)
+	g.target = raw
+}
+
+// pool_fill_pct — the pool bar's displayed LEVEL (in-flight vs cap,
+// clamped 0..100): the feed + the draw share this one derivation (the
+// single-source rule — a future clamp/rounding change can't desync the
+// eased target from the drawn raw).
+pool_fill_pct :: proc(flow: ^pp.Flow_State, cat: ^pp.Catalogs) -> i32 {
+	cap := u32(max(1, cat.balance.pool_max_packets))
+	return i32(min(u32(len(flow.packets)) * 100 / cap, 100))
+}
+
+// sla_avg_ms — the avg-latency readout's raw derivation (0 when nothing
+// has delivered — the draw shows "-" there; shared by feed + draw).
+sla_avg_ms :: proc(acc: ^pp.Sla_Accumulator) -> i32 {
+	if acc.delivered > 0 {
+		return i32(acc.total_latency_ms / acc.delivered)
+	}
+	return 0
+}
+
+// sla_loss_pct — the loss-% readout's raw derivation (0 when no demand —
+// the draw shows "-" there; shared by feed + draw).
+sla_loss_pct :: proc(acc: ^pp.Sla_Accumulator) -> i32 {
+	demand := acc.delivered + acc.dropped
+	if demand > 0 {
+		return i32(acc.dropped * 100 / demand)
+	}
+	return 0
+}
+
+// gauge_tick — feed every gauge from live sim truth, once per stepped
+// tick. The raw derivations are the SHARED procs the draws call (single
+// source): health's meter_pct (0..100 by core), pool_fill_pct, the SLA
+// avg/loss readouts. The SLA gauges seed LAZILY — only once the draw
+// would show a number (delivered > 0 / demand > 0) — so the first VISIBLE
+// reading seeds at raw (no 0->value ramp on a number the player never
+// saw; the r1 review's hidden-readout finding). Pure over the passed
+// state (reads only; the sim is never touched).
+gauge_tick :: proc(v: ^View, tick: u64, health: ^pp.Health_State, flow: ^pp.Flow_State, cat: ^pp.Catalogs) {
+	gauge_target(v, &v.gauges.health, i32(health.meter_pct), tick, CHUNK_PCT)
+	gauge_target(v, &v.gauges.pool, pool_fill_pct(flow, cat), tick, CHUNK_PCT)
+	for c in 0..<len(flow.sla) {
+		if c >= len(v.gauges.sla_ms) {
+			break // roster beyond the slot table: the draw reads raw (the zero-value fallback)
+		}
+		acc := &flow.sla[c]
+		if acc.delivered > 0 {
+			gauge_target(v, &v.gauges.sla_ms[c], sla_avg_ms(acc), tick, CHUNK_SLA_MS)
+		}
+		if acc.delivered + acc.dropped > 0 {
+			gauge_target(v, &v.gauges.sla_loss[c], sla_loss_pct(acc), tick, CHUNK_PCT)
+		}
+	}
+}
diff --git a/app/render/gauge_test.odin b/app/render/gauge_test.odin
new file mode 100644
index 0000000..7228cca
--- /dev/null
+++ b/app/render/gauge_test.odin
@@ -0,0 +1,303 @@
+package render
+
+// gauge_test.odin — v2-viscomm-gauge-telegraph's durable pins (the spec's
+// I/O & Edge-Case Matrix, one pin per row — the briefing's testing standard
+// is NON-NEGOTIABLE: every expectation here is a durable test, not PR prose):
+//
+//   (a) TABLE — EASE16 endpoints ([0]=0 continuity, [15]=1 exact arrival),
+//       strict monotone rise (an ease-out: fast start, settle), and the
+//       telegraph quality (motion visible within the first two entries).
+//   (b) HARNESS-INERT — the golden-stability contract: a zero-value (unfed)
+//       gauge reads raw EXACTLY for every tick — the capture path never
+//       feeds targets, so T2 goldens stay byte-identical by construction.
+//   (c) TWEEN — seed (first reading = raw, no 0->value fill at run start),
+//       no-pop at engage, monotone approach, exact arrival, stays-arrived.
+//   (d) CHASE — a mid-tween target move rides the same tween: the display
+//       change at the retarget tick is bounded by the raw's own move (no
+//       discontinuity larger than the underlying motion), then converges.
+//   (e) CHUNK — an instantaneous delta >= CHUNK_PCT fires the cue exactly
+//       once (alpha > 0 on the jump tick, 0 after len(CHUNK_FLASH) ticks),
+//       the tween re-anchors from the current display, and a LATER chunk
+//       re-fires (once per jump, not once ever). Sub-threshold never cues.
+//   (f) REDUCED MOTION — read snaps to raw, the feed never engages, the
+//       flash is suppressed; toggling motion back off-mid-run starts from
+//       truth (no stale tween, no fabricated chunk).
+//   (g) PAUSE/FREEZE — the phase derives from the tick: an unchanged tick
+//       renders the identical display (deterministic + tick-driven).
+//   (h) FEED (gauge_tick) — health/pool/sla targets land from live sim
+//       truth with the draws' own derivations (pool clamped 0..100; SLA
+//       avg/loss mirror draw_sla_gauges's raw math; roster > 8 unfed ->
+//       the zero-value raw fallback).
+
+import "core:testing"
+import pp "../../core"
+
+@(test)
+gauge_ease16_table_pins :: proc(t: ^testing.T) {
+	testing.expectf(t, len(EASE16) == 16, "EASE16 must be 16 entries (got %d)", len(EASE16))
+	testing.expectf(t, EASE16[0] == 0, "EASE16[0] must be 0 (tween-start continuity), got %v", EASE16[0])
+	testing.expectf(t, EASE16[15] == 1, "EASE16[15] must be 1 (exact arrival == raw bytes), got %v", EASE16[15])
+	mono := true
+	table := EASE16 // local copy — a constant can't be indexed by a runtime index
+	for i in 1..<len(table) {
+		if table[i] < table[i-1] {
+			mono = false
+		}
+	}
+	testing.expect(t, mono, "EASE16 must rise monotonically (an ease-out)")
+	// the telegraph quality: motion must be VISIBLE early (an ease that
+	// crawls at the start reads as a lag, not a telegraph)
+	testing.expectf(t, EASE16[1] >= 0.10, "EASE16[1] too slow (%v) - the gauge must visibly move within 2 ticks", EASE16[1])
+}
+
+// a motion-shell View for the pure-proc pins (no raylib calls needed —
+// gauge_read/gauge_target only touch View.reduced_motion + the gauges).
+gauge_test_view :: proc(reduced: bool) -> (v: View) {
+	v.reduced_motion = reduced
+	return v
+}
+
+@(test)
+gauge_unfed_reads_raw_exactly :: proc(t: ^testing.T) {
+	// THE HARNESS CONTRACT: zero-value gauges (never fed) read raw at every
+	// tick — capture-frame byte-identity lives here. A future change that
+	// engages tweens by default fails here before it ships golden churn.
+	v := gauge_test_view(false)
+	g := Gauge_Ease{} // the zero value the View ships
+	exact := true
+	for tick in u64(0)..=64 {
+		for raw in i32(0)..=100 {
+			if gauge_read(&v, &g, raw, tick) != raw {
+				exact = false
+			}
+		}
+	}
+	testing.expect(t, exact, "an unfed gauge must read raw exactly at every tick (the capture path)")
+	testing.expectf(t, gauge_flash_read(&v, &g, 42) == 0, "an unfed gauge must never flash")
+}
+
+@(test)
+gauge_tween_seed_engage_arrive :: proc(t: ^testing.T) {
+	v := gauge_test_view(false)
+	g := Gauge_Ease{}
+	// SEED: the first feed after reset displays raw — no 0->value animation
+	gauge_target(&v, &g, 100, 10, CHUNK_PCT)
+	testing.expectf(t, gauge_read(&v, &g, 100, 10) == 100, "seed must display raw (no fill animation)")
+	// ENGAGE: 100 -> 60 is a chunk (>= CHUNK_PCT); the tween anchors from the
+	// current display — no-pop continuity at the jump tick
+	gauge_target(&v, &g, 60, 11, CHUNK_PCT)
+	testing.expectf(t, gauge_read(&v, &g, 60, 11) == 100, "tween start must display the CURRENT level (no pop): got %d", gauge_read(&v, &g, 60, 11))
+	// APPROACH: monotone toward 60 across the tween (advance 2 -> 8 ticks)
+	last: i32 = 100
+	mono := true
+	for k in 1..=7 {
+		got := gauge_read(&v, &g, 60, u64(11 + k))
+		if got > last || got < i32(60) {
+			mono = false
+		}
+		last = got
+	}
+	testing.expect(t, mono, "the drain tween must fall monotonically toward the target")
+	// ARRIVAL: exactly the raw at phase end, and it STAYS
+	testing.expectf(t, gauge_read(&v, &g, 60, 19) == 60, "an arrived tween must read raw exactly: got %d", gauge_read(&v, &g, 60, 19))
+	testing.expectf(t, gauge_read(&v, &g, 60, 40) == 60, "an arrived tween must stay arrived")
+	// REFILL engages upward the same way (small jump — no flash expected)
+	gauge_target(&v, &g, 64, 20, CHUNK_PCT)
+	rising := true
+	for k in 0..=8 {
+		got := gauge_read(&v, &g, 64, u64(20 + k))
+		if got < last || got > i32(64) {
+			rising = false
+		}
+		if got > last {
+			last = got
+		}
+	}
+	testing.expect(t, rising, "the refill tween must rise monotonically toward the target")
+	testing.expectf(t, last == 64, "the refill must arrive exactly: got %d", last)
+}
+
+@(test)
+gauge_chase_continuity :: proc(t: ^testing.T) {
+	// a mid-tween target move rides the SAME tween (phase not reset): the
+	// display change at the retarget tick is bounded by the raw's own move
+	v := gauge_test_view(false)
+	g := Gauge_Ease{}
+	gauge_target(&v, &g, 80, 10, CHUNK_PCT)  // seed
+	gauge_target(&v, &g, 60, 11, CHUNK_PCT)  // engage the drain (chunk)
+	before := gauge_read(&v, &g, 60, 13) // mid-ease (phase 4)
+	gauge_target(&v, &g, 57, 14, CHUNK_PCT)         // small retarget mid-tween (no chunk)
+	after := gauge_read(&v, &g, 57, 14)
+	// continuity, honestly bounded: the display move at a retarget may not
+	// exceed the raw's own move PLUS the tween's natural per-tick step at
+	// that phase (the ease was already moving). A snap bypass (display :=
+	// raw) moves the full gap — 14 here — and still fails this bound.
+	tween_step := f32(80-60) * (EASE16[6] - EASE16[4])
+	bound := i32(3) + i32(tween_step + 0.5)
+	testing.expectf(t, abs(after-before) <= bound,
+		"retarget discontinuity: display moved %d (bound %d = raw 3 + tween step %.2f) - before %d after %d",
+		abs(after-before), bound, tween_step, before, after)
+	// converges to the new target
+	testing.expectf(t, gauge_read(&v, &g, 57, 40) == 57, "the chase must converge: got %d", gauge_read(&v, &g, 57, 40))
+}
+
+@(test)
+gauge_chunk_flash_once_per_jump :: proc(t: ^testing.T) {
+	v := gauge_test_view(false)
+	g := Gauge_Ease{}
+	gauge_target(&v, &g, 100, 10, CHUNK_PCT) // seed at full
+	// THE CHUNK JUMP: a pool drained by an event (100 -> 40)
+	gauge_target(&v, &g, 40, 11, CHUNK_PCT)
+	testing.expectf(t, gauge_flash_read(&v, &g, 11) > 0, "a >= CHUNK_PCT jump must fire the chunk cue (alpha %v)", gauge_flash_read(&v, &g, 11))
+	// the cue is TABLE-DRIVEN over its life, then gone (single shot)
+	f1 := gauge_flash_read(&v, &g, 12)
+	testing.expectf(t, f1 >= 0.9*CHUNK_FLASH[1] && f1 <= CHUNK_FLASH[1],
+		"the flash fade tick 1 must read the table (~%v), got %v", CHUNK_FLASH[1], f1)
+	testing.expectf(t, gauge_flash_read(&v, &g, 11 + u64(len(CHUNK_FLASH))) == 0,
+		"the cue must expire after len(CHUNK_FLASH) ticks, got %v", gauge_flash_read(&v, &g, 11 + u64(len(CHUNK_FLASH))))
+	// while the target HOLDS, no re-fire
+	gauge_target(&v, &g, 40, 12, CHUNK_PCT)
+	testing.expect(t, !(g.flashing && g.flash_t0 == 12), "a held target must not re-fire the cue")
+	// a LATER chunk re-fires (once per jump, not once ever)
+	for k in 1..=8 {
+		gauge_target(&v, &g, 40, u64(11 + k), CHUNK_PCT) // hold through the tween
+	}
+	gauge_target(&v, &g, 90, 25, CHUNK_PCT) // the refill chunk
+	testing.expectf(t, gauge_flash_read(&v, &g, 25) > 0, "a second chunk jump must re-fire the cue once")
+	// SUB-THRESHOLD jumps never cue
+	g2 := Gauge_Ease{}
+	gauge_target(&v, &g2, 50, 10, CHUNK_PCT)
+	gauge_target(&v, &g2, 50-CHUNK_PCT+1, 11, CHUNK_PCT) // one unit under the threshold
+	testing.expect(t, !g2.flashing, "a sub-threshold jump must not fire the cue")
+}
+
+@(test)
+gauge_reduced_motion_snaps :: proc(t: ^testing.T) {
+	v := gauge_test_view(true) // reduced motion ON
+	g := Gauge_Ease{}
+	gauge_target(&v, &g, 100, 10, CHUNK_PCT)
+	gauge_target(&v, &g, 40, 11, CHUNK_PCT) // what would be a chunk drain
+	testing.expectf(t, gauge_read(&v, &g, 40, 11) == 40, "reduced motion must snap display to raw immediately: got %d", gauge_read(&v, &g, 40, 11))
+	testing.expectf(t, gauge_flash_read(&v, &g, 11) == 0, "reduced motion must suppress the chunk flash: alpha %v", gauge_flash_read(&v, &g, 11))
+	testing.expect(t, !g.active, "reduced motion must never engage a tween")
+	// toggling motion OFF mid-run starts from truth: the tracked target keeps
+	// the gauge honest (no stale tween, no false chunk on the next move)
+	v.reduced_motion = false
+	gauge_target(&v, &g, 45, 12, CHUNK_PCT) // small move — must NOT flash
+	testing.expect(t, !g.flashing, "a motion toggle must not fabricate a chunk cue from stale state")
+	testing.expectf(t, gauge_read(&v, &g, 45, 12) == 40, "post-toggle engage must start from the tracked level: got %d want 40", gauge_read(&v, &g, 45, 12))
+}
+
+@(test)
+gauge_phase_freezes_with_tick :: proc(t: ^testing.T) {
+	// PAUSE: the phase derives from the tick — an unchanged tick renders the
+	// identical display (deterministic + tick-driven; identical ticks render
+	// identical frames)
+	v := gauge_test_view(false)
+	g := Gauge_Ease{}
+	gauge_target(&v, &g, 100, 10, CHUNK_PCT)
+	gauge_target(&v, &g, 40, 11, CHUNK_PCT)
+	a := gauge_read(&v, &g, 40, 13)
+	b := gauge_read(&v, &g, 40, 13)
+	testing.expectf(t, a == b, "the same tick must render the identical display: %d vs %d", a, b)
+	// the phase ADVANCES only with the tick (the paused ease is frozen)
+	c := gauge_read(&v, &g, 40, 14)
+	testing.expectf(t, c != a || a == 40, "the eased display must advance with the tick (frozen at %d)", a)
+}
+
+@(test)
+gauge_arrived_tween_re_engages :: proc(t: ^testing.T) {
+	// THE ZOMBIE-TWEEN PIN (r1 blind-hunter finding): an arrived tween's
+	// `active` flag stays set — a later sub-threshold retarget must still
+	// EASE (re-engage), never snap value-to-value. Before the fix, every
+	// small delta after the first finished tween snapped forever: exactly
+	// the strobe this feature exists to kill.
+	v := gauge_test_view(false)
+	g := Gauge_Ease{}
+	gauge_target(&v, &g, 100, 10, CHUNK_PCT) // seed
+	gauge_target(&v, &g, 60, 11, CHUNK_PCT)  // chunk engage
+	for k in 1..=8 {
+		gauge_target(&v, &g, 60, u64(11+k), CHUNK_PCT) // hold through arrival
+	}
+	testing.expectf(t, gauge_read(&v, &g, 60, 19) == 60, "must arrive first (precondition)")
+	// the post-arrival small retarget: starts at the shown level, EASES
+	gauge_target(&v, &g, 64, 30, CHUNK_PCT)
+	testing.expectf(t, gauge_read(&v, &g, 64, 30) == 60,
+		"a post-arrival retarget must display the current level first (no snap): got %d", gauge_read(&v, &g, 64, 30))
+	converged := gauge_read(&v, &g, 64, 45)
+	testing.expectf(t, converged == 64, "the post-arrival tween must converge: got %d", converged)
+	// and mid-ease it is BETWEEN the levels (in motion, not snapped)
+	mid := gauge_read(&v, &g, 64, 32)
+	testing.expectf(t, mid > 60 && mid < 64, "the post-arrival tween must be in motion mid-ease: %d", mid)
+}
+
+@(test)
+gauge_flash_flag_expires_at_the_feed :: proc(t: ^testing.T) {
+	// flag hygiene (r1 finding): `flashing` must never read stale-true after
+	// the cue's table life — a future consumer (a11y, sfx, overlay) would
+	// otherwise see a months-old cue.
+	v := gauge_test_view(false)
+	g := Gauge_Ease{}
+	gauge_target(&v, &g, 100, 10, CHUNK_PCT)
+	gauge_target(&v, &g, 40, 11, CHUNK_PCT)
+	testing.expect(t, g.flashing, "the chunk jump fires the cue")
+	for k in 1..=3 {
+		gauge_target(&v, &g, 40, u64(11+k), CHUNK_PCT) // hold past the cue life
+	}
+	testing.expect(t, !g.flashing, "the feed clears the flag once the cue's table life is past")
+}
+
+@(test)
+gauge_sla_slots_seed_lazily :: proc(t: ^testing.T) {
+	// the LAZY SEED (r1 finding): a class with no deliveries/demand yet
+	// shows "-" — its gauge must stay UNSEEDED so the first VISIBLE number
+	// seeds at raw (no 0->value ramp on a readout the player never saw).
+	v := gauge_test_view(false)
+	health: pp.Health_State
+	flow: pp.Flow_State
