+			ghost_dist = max(abs(i32(ghost_px.r)-i32(track.r)), max(abs(i32(ghost_px.g)-i32(track.g)), abs(i32(ghost_px.b)-i32(track.b))))
+			rl.UnloadImageColors(px)
+		}
+		check(ghost_dist >= 20,
+			fmt.aprintf("chunk ghost blends over the track while the cue lives (track-dist %d at the band's tail)", ghost_dist), int(ghost_dist))
+		rl.UnloadImage(img)
+		// expired: age 5 >= len(CHUNK_FLASH) -> no ghost; the fill (phase 10
+		// -> 47%%) nowhere near the band's tail
+		img = gauge_render_meter(&view, &health, cat, 206)
+		gone_dist: i32 = -1
+		if px := rl.LoadImageColors(img); true {
+			gone_px := px[row*int(img.width)+655]
+			gone_dist = max(abs(i32(gone_px.r)-i32(track.r)), max(abs(i32(gone_px.g)-i32(track.g)), abs(i32(gone_px.b)-i32(track.b))))
+			rl.UnloadImageColors(px)
+		}
+		check(gone_dist <= 12,
+			fmt.aprintf("the chunk cue expires (track-dist %d after len(CHUNK_FLASH) ticks)", gone_dist), int(gone_dist))
+		rl.UnloadImage(img)
+
+		// (d) REDUCED MOTION — the same chunk jump snaps to raw, no ghost
+		rnd.gauge_reset(&view.gauges)
+		view.reduced_motion = true
+		rnd.gauge_target(&view, &view.gauges.health, 100, 200, rnd.CHUNK_PCT)
+		rnd.gauge_target(&view, &view.gauges.health, 40, 201, rnd.CHUNK_PCT)
+		img = gauge_render_meter(&view, &health, cat, 202)
+		congested := rnd.state_congested_text(view.palette^)
+		n_snap := gauge_count_fill(img, congested, bar_x, bar_w, row)
+		check(n_snap >= 93 && n_snap <= 99,
+			fmt.aprintf("reduced motion snaps the fill to raw (40%% -> ~96 px, got %d)", n_snap), n_snap)
+		rl.UnloadImage(img)
+		view.reduced_motion = false
+		rnd.gauge_reset(&view.gauges) // leave the view clean for any later section
+
+		// (e) THE POOL GAUGE twin (r1 verification-gap finding: the pool bar's
+		// eased seam had NO draw-level pin — a bypass or a wrong-slot read kept
+		// every gate green). Same craft as the health legs: render the REAL
+		// draw_pool_gauge at a clear anchor + scan the fill extent (the count
+		// of non-track columns across the 80 px bar row; the label draws LEFT
+		// of the bar, marks empty = no SHEDDING tag).
+		pool_x, pool_y := i32(200), i32(500)
+		pbar_x, pbar_w, prow := int(pool_x)+118, 80, int(pool_y)+4+4 // hud(4)=4: bar_y = y+4, scan its middle row
+		pflow: pp.Flow_State
+		defer delete(pflow.packets)
+		for _ in 0..<55 {
+			append(&pflow.packets, pp.Packet{}) // 55 in flight / cap 100 -> pct 55
+		}
+		pcat := cat^ // shallow copy: balance is a value field — the pool cap override never touches the caller's catalog
+		pcat.balance.pool_max_packets = 100
+		// UNFED: the fill reads raw (55 -> 44 px of 80)
+		rnd.gauge_reset(&view.gauges)
+		img = gauge_render_pool(&view, &pflow, &pcat, 999, pool_x, pool_y)
+		n_pool_unfed := gauge_count_fill_extent(img, view.palette.ink_soft, pbar_x, pbar_w, prow)
+		check(n_pool_unfed >= 41 && n_pool_unfed <= 47,
+			fmt.aprintf("unfed pool bar reads RAW exactly (55%% -> ~44 of 80 px, got %d - the app-path twin of the capture contract)", n_pool_unfed), n_pool_unfed)
+		rl.UnloadImage(img)
+		// MID-EASE: seed 79, retarget 55 (sub-chunk), render at phase 4:
+		// display = 79 - 24*EASE16[4] = 67.9 -> 68 -> ~54 px (raw: 44) - an
+		// easing bypass OR a wrong-slot read (health's targets) fails here.
+		rnd.gauge_reset(&view.gauges)
+		rnd.gauge_target(&view, &view.gauges.pool, 79, 100, rnd.CHUNK_PCT)
+		rnd.gauge_target(&view, &view.gauges.pool, 55, 101, rnd.CHUNK_PCT)
+		img = gauge_render_pool(&view, &pflow, &pcat, 103, pool_x, pool_y)
+		n_pool_eased := gauge_count_fill_extent(img, view.palette.ink_soft, pbar_x, pbar_w, prow)
+		check(n_pool_eased >= 51 && n_pool_eased <= 57,
+			fmt.aprintf("mid-ease pool fill sits at the EASE16-predicted edge (~54 px at phase 4, got %d; raw 44 - a bypass or wrong-slot read fails here)", n_pool_eased), n_pool_eased)
+		rl.UnloadImage(img)
+		rnd.gauge_reset(&view.gauges)
+	}
+
 	if fails > 0 {
 		fmt.printfln("palcheck: %d check(s) FAILED", fails)
 		return 1
