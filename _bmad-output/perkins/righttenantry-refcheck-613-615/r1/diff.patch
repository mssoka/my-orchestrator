+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <title>Toast vs consent banner — layering evidence (#615)</title>
+  <!-- Real built assets: the same tailwind.css and consent.js the SPA ships. -->
+  <link rel="stylesheet" href="/server/priv/static/tailwind.css">
+  <script src="/server/priv/static/consent.js" defer></script>
+</head>
+<body class="bg-off-white min-h-screen">
+  <!-- Mock in-flow header, mirroring shell.gleam's app header (bg-navy h-16,
+       notification bell top-right). The toast must sit BELOW this bar. -->
+  <header data-testid="app-header" class="bg-navy h-16 flex items-center justify-between px-4 md:px-8">
+    <span class="font-headline text-xl font-bold text-white">RightTenantry</span>
+    <span data-testid="mock-bell" aria-hidden="true" class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center">🔔</span>
+  </header>
+  <main class="max-w-7xl mx-auto px-4 md:px-8 py-6">
+    <h1 class="font-headline text-lg font-bold text-charcoal mb-2">Toast layering evidence (#615)</h1>
+    <p class="text-sm text-slate">
+      Reproduces the bug-hunt scenario: a fresh visitor (no consent choice yet, so the
+      consent banner is up) triggers the refcheck "Attempt log copied" toast. The toast
+      container below carries the EXACT classes from
+      <code class="text-charcoal">client/src/components/toast.gleam</code>.
+      The banner is the real <code class="text-charcoal">server/priv/static/consent.js</code>.
+    </p>
+  </main>
+
+  <!-- Toast container — byte-faithful to client/src/components/toast.gleam:
+       fixed top-20 right-4 z-[2147483001] (below the h-16 header; one z-step
+       above the consent banner's 2147483000). -->
+  <div
+    data-testid="toast-container"
+    aria-live="polite"
+    class="fixed top-20 right-4 z-[2147483001] flex flex-col-reverse gap-3 max-w-sm"
+  ></div>
+
+  <script>
+    // Simulate the app firing the OQ-5 "Attempt log copied" toast 800ms after
+    // load, auto-dismissing after 5s to mirror client.gleam's toast lifecycle
+    // (global.set_timeout(5000, ...) on success toasts).
+    window.addEventListener("DOMContentLoaded", function () {
+      setTimeout(function () {
+        var container = document.querySelector('[data-testid="toast-container"]');
+        if (!container) return;
+        var toast = document.createElement("div");
+        toast.setAttribute("data-testid", "toast-message");
+        toast.setAttribute("role", "status");
+        toast.className =
+          "bg-white rounded-xl shadow-sm p-4 border-l-4 flex items-center justify-between gap-3 border-teal";
+        var inner = document.createElement("div");
+        inner.className = "flex items-center gap-3";
+        var badge = document.createElement("div");
+        badge.className =
+          "w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm bg-teal/10 text-teal";
+        badge.textContent = "\u2713";
+        var msg = document.createElement("span");
+        msg.className = "text-sm font-medium text-charcoal font-body";
+        msg.textContent =
+          "Attempt log copied. Paste it into your records or a message.";
+        var dismiss = document.createElement("button");
+        dismiss.setAttribute("data-testid", "toast-dismiss");
+        dismiss.setAttribute("type", "button");
+        dismiss.setAttribute("aria-label", "Dismiss");
+        dismiss.className = "text-slate hover:text-charcoal transition-colors ml-2";
+        dismiss.textContent = "\u2715";
+        inner.appendChild(badge);
+        inner.appendChild(msg);
+        toast.appendChild(inner);
+        toast.appendChild(dismiss);
+        container.appendChild(toast);
+      }, 800);
+      setTimeout(function () {
+        var container = document.querySelector('[data-testid="toast-container"]');
+        if (container) container.innerHTML = "";
+      }, 5800);
+    });
+  </script>
+</body>
+</html>
