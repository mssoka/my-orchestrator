+			append(fails, fmt.tprintf("  %s touch: the button demolish must clear the selection (sel_node %d, want -1)", sc.name, r.sel_node))
+		}
+		if r, ok := find(runs, devs, .Pad); ok && r.sel_node != -1 {
+			append(fails, fmt.tprintf("  %s pad: the X demolish must clear the selection (sel_node %d, want -1)", sc.name, r.sel_node))
+		}
+	case "input_parity_demolish_btn_pipe":
+		if r, ok := find(runs, devs, .Mouse); ok && r.sel_pipe != -1 {
+			append(fails, fmt.tprintf("  %s mouse: the pipe button demolish must clear the selection (sel_pipe %d, want -1)", sc.name, r.sel_pipe))
+		}
+		if r, ok := find(runs, devs, .Touch); ok && r.sel_pipe != -1 {
+			append(fails, fmt.tprintf("  %s touch: the pipe button demolish must clear the selection (sel_pipe %d, want -1)", sc.name, r.sel_pipe))
+		}
 	}
 }
 
