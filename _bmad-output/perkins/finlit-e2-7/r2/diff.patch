+class_name FinLitTouchProxy
+extends Control
+## A29 touch proxy: an INVISIBLE enlarged hit area around a small target.
+## Guarantees the tap region meets the role floor (>=160px primary, >=120px
+## secondary) without changing the visible control — the rule governs hit
+## area, not looks. Emits `pressed` on a left tap over the proxy rect; the
+## caller routes it to the target's action (same handler as the button).
+##
+## Placement rules: parent it in an OVERLAY layer (a Container parent would
+## re-layout it) ABOVE the dim, and call reposition() after the target's
+## layout settles — a node measures (0,0) the same frame it is added, so
+## `await target.resized` before wrap() (deferred-layout idiom).
+
+signal pressed
+
+var target: Control
+var role: int = FinLitTouchTargets.Role.SECONDARY
+
+func _ready() -> void:
+	mouse_filter = Control.MOUSE_FILTER_STOP
+	mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
+	visible = false
+
+## Point the proxy at a target and snap it over the target's enlarged rect.
+func wrap(target_control: Control, role_id: int) -> void:
+	target = target_control
+	role = role_id
+	reposition()
+
+## Re-read the target's global rect and re-place the proxy. Guards against the
+## target being freed by a popup close (the proxy then hides itself). The hit
+## rect is clamped to the viewport so it never spills off an edge.
+func reposition() -> void:
+	if target == null or not is_instance_valid(target):
+		visible = false
+		return
+	visible = target.is_visible_in_tree()
+	if not visible:
+		return
+	var viewport_rect := get_viewport_rect()
+	var rect := FinLitTouchTargets.touch_proxy_rect(target.get_global_rect(), role, viewport_rect)
+	global_position = rect.position
+	size = rect.size
+
+func _gui_input(event: InputEvent) -> void:
+	if event is InputEventMouseButton and event.pressed \
+			and event.button_index == MOUSE_BUTTON_LEFT:
+		pressed.emit()
