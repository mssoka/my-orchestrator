+		"damaged": true, "repair_paid": true, "ticks_since_payout": 0}]
+	_street._refresh_dominant_button()
+	check(dominant.text.contains("FIX"), "damaged asset puts FIX ahead of BUY (label %s)" % dominant.text)
+	_street._state["assets"][0]["damaged"] = false
+	_street._refresh_dominant_button()
+	check(dominant.text.contains("BUY"), "no damage + affordable plot -> BUY (label %s)" % dominant.text)
+	_street._state["job"] = ""
+	_street._refresh_dominant_button()
+	check(dominant.text.contains("FIND WORK"), "unemployed prefix wins over everything (label %s)" % dominant.text)
+	# The asset card's FIX button follows the same doctrine as the dominant
+	# button: a free (pre-paid) repair stays enabled even at negative balance.
+	_street._state["balance"] = -5
+	_street._state["assets"] = [{"id": 1, "type": "rental", "name": "Sunny Duplex", "level": 1,
+		"damaged": true, "repair_paid": true, "ticks_since_payout": 0}]
+	var fix_card: Control = _street._make_asset_card(_street._state["assets"][0])
+	var fix_btn: Button = fix_card.get_child(0).get_child(2)
+	check(not fix_btn.disabled, "asset-card FIX enabled for a free repair at negative balance")
+	fix_card.free()
+	_street._state["job"] = "dog_walker"
+	_street._state["assets"] = []
+	_street._state["balance"] = 60
+	_street._refresh_dominant_button()
+
+
+## The leaderboard NEW GAME button (110px tall, below the 120px secondary
+## floor) is wrapped by the touch proxy: floor-sized hit area that encloses
+## the button, routes taps to the SAME handler as the button, and hides on
+## popup close.
+func _check_leaderboard_proxy_scene() -> void:
+	var proxy: FinLitTouchProxy = _street._reset_proxy
+	check(proxy != null and proxy.visible, "leaderboard reset proxy visible while the popup is open")
+	if proxy == null or not proxy.visible:
+		_street._close_popup()
+		return
+	var proxy_rect := proxy.get_global_rect()
+	check(proxy_rect.size.y >= FinLitTouchTargets.min_touch_size(FinLitTouchTargets.Role.SECONDARY),
+		"proxy hit area meets the 120px secondary floor (height %.0f)" % proxy_rect.size.y)
+	check(proxy.target != null and is_instance_valid(proxy.target), "proxy wrapped the reset button")
+	if proxy.target != null and is_instance_valid(proxy.target):
+		check(proxy_rect.encloses(proxy.target.get_global_rect()),
+			"proxy rect encloses the small target (target %.0fx%.0f)" % [proxy.target.size.x, proxy.target.size.y])
+	var wired := false
+	for conn in proxy.pressed.get_connections():
+		if conn["callable"].get_method() == "_on_reset_pressed":
+			wired = true
+	check(wired, "proxy taps route to the same handler as the reset button")
+	# Synthesized tap -> pressed fires (street handler disconnected first so
+	# the probe doesn't wipe the test save via the reset flow).
+	proxy.pressed.disconnect(Callable(_street, "_on_reset_pressed"))
+	_tap_fired["n"] = 0
+	proxy.pressed.connect(func() -> void: _tap_fired["n"] += 1)
+	var ev := InputEventMouseButton.new()
+	ev.button_index = MOUSE_BUTTON_LEFT
+	ev.pressed = true
+	proxy._gui_input(ev)
+	check(_tap_fired["n"] == 1, "a left tap on the proxy emits pressed")
+	# REAL input routing (not injected _gui_input): a tap pushed through the
+	# viewport must reach the proxy — proves the overlay z-order actually
+	# delivers taps over the card (the card's STOP panel sits below the
+	# proxy, which is the topmost PopupLayer child). push_input delivers on
+	# the NEXT idle frame; the stage machine asserts after that frame and
+	# runs the negative control + close (stages 2/3).
+	var routed := InputEventMouseButton.new()
+	routed.button_index = MOUSE_BUTTON_LEFT
+	routed.pressed = true
+	# push_input expects WINDOW coordinates; the proxy's global rect is in
+	# canvas-content space (the stretch transform) — map it over.
+	routed.position = root.get_canvas_transform().affine_inverse() * proxy.get_global_rect().get_center()
+	root.push_input(routed)
+	# Negative control point: inside the card but OUTSIDE the proxy rect.
+	_tap_outside_pos = root.get_canvas_transform().affine_inverse() * (proxy_rect.position + Vector2(-60, 30))
+
+
 func _cleanup_street_scene() -> void:
 	_street.queue_free()
 	_street = null
