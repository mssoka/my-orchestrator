@@ -0,0 +1,110 @@
+class_name FinLitTouchTargets
+extends RefCounted
+## A29 minute-one working rules (pending user confirmation — see the A29 note
+## in project-context.md §Game-Rules-as-Code): the touch-sizing floors and the
+## dominant bottom-center action button's collision priority. Pure logic: no
+## Node/scene deps, no wall clock — unit tests run it headless. The UI only
+## formats labels; the RULES live here (and their mirrors in the theme, pinned
+## by a test).
+
+## Portrait reference viewport (project-context: 720x1280 logical).
+const REFERENCE_VIEWPORT := Vector2(720, 1280)
+
+## Touch floors at the reference viewport (~203 DPI class): >=2cm ~= >=160px
+## for the dominant primary button; 120px for every other target — "never
+## below 120px". One shared min_touch_size constant lives in the theme too
+## (street_theme.tres Button/constants/...); a scene test pins them in sync.
+const MIN_TOUCH_PRIMARY := 160
+const MIN_TOUCH_SECONDARY := 120
+
+enum Role { PRIMARY, SECONDARY }
+
+const ACTION_FIND_WORK := "find_work"
+const ACTION_FIX := "fix"
+const ACTION_BUY := "buy"
+const ACTION_UPGRADE := "upgrade"
+const ACTION_WORK_SHIFT := "work_shift"
+
+## Role floor as a scalar — both dimensions share it.
+static func min_touch_size(role: int) -> float:
+	return float(MIN_TOUCH_PRIMARY) if role == Role.PRIMARY else float(MIN_TOUCH_SECONDARY)
+
+## Clamp a control's minimum size UP to the role floor — never shrinks.
+static func ensure_min_touch(rect: Vector2, role: int) -> Vector2:
+	var min_size := min_touch_size(role)
+	return Vector2(maxf(rect.x, min_size), maxf(rect.y, min_size))
+
+## The sizing rule as an assertion: both dimensions >= the role floor.
+static func satisfies_min_touch(rect: Vector2, role: int) -> bool:
+	var min_size := min_touch_size(role)
+	return rect.x >= min_size - 0.001 and rect.y >= min_size - 0.001
+
+## A29 collision priority [project-context, verbatim]: FIND WORK (unemployed)
+## > FIX (oldest-damaged first) > BUY/UPGRADE > WORK SHIFT. Returns
+## {"action": String, "asset_id": int}; the UI maps action -> label + cooldown.
+## "FIX is always free" (locked): the event pre-pays repairs, so a free repair
+## qualifies at ANY balance (even debt). A legacy unpaid repair
+## (repair_paid=false) the kid can't afford is skipped — a FIX that can never
+## succeed would block BUY/UPGRADE/WORK SHIFT forever (a soft-lock).
+static func dominant_action(state: Dictionary) -> Dictionary:
+	if state.get("job", "") == "":
+		return {"action": ACTION_FIND_WORK, "asset_id": -1}
+	var fix_id := oldest_damaged_repairable(state)
+	if fix_id >= 0:
+		return {"action": ACTION_FIX, "asset_id": fix_id}
+	if state.get("assets", []).size() < FinLitEconomy.MAX_PLOTS \
+			and state.get("balance", 0) >= FinLitEconomy.cheapest_asset_price():
+		return {"action": ACTION_BUY, "asset_id": -1}
+	var upgrade_id := first_upgradeable(state)
+	if upgrade_id >= 0:
+		return {"action": ACTION_UPGRADE, "asset_id": upgrade_id}
+	return {"action": ACTION_WORK_SHIFT, "asset_id": -1}
+
+## FIX tie-break: among damaged assets with a payable repair, the OLDEST wins
+## (lowest id — ids increment at purchase, so id is the durable age key).
+## Defensive: an asset missing its id is skipped (consistent with the .get
+## guards above — the rules engine must never crash on a ragged state).
+static func oldest_damaged_repairable(state: Dictionary) -> int:
+	var oldest_id := -1
+	for asset in state.get("assets", []):
+		if not asset.get("damaged", false):
+			continue
+		var cost := FinLitEconomy.repair_cost(state, asset)
+		if cost > 0 and state.get("balance", 0) < cost:
+			continue # Legacy unpaid repair the kid can't pay — skip, no soft-lock.
+		var asset_id := int(asset.get("id", -1))
+		if asset_id < 0:
+			continue
+		if oldest_id == -1 or asset_id < oldest_id:
+			oldest_id = asset_id
+	return oldest_id
+
+## First upgradeable asset in purchase order (A29 doesn't rule the upgrade
+## tie-break; oldest-first matches the FIX doctrine).
+static func first_upgradeable(state: Dictionary) -> int:
+	for asset in state.get("assets", []):
+		if asset.get("damaged", false):
+			continue
+		var cost := FinLitEconomy.upgrade_cost(asset)
+		if cost >= 0 and state.get("balance", 0) >= cost:
+			return int(asset.get("id", -1))
+	return -1
+
+## A29 modal-card interplay: while a card is open, the dominant button is the
+## card's action or HIDDEN — never both visible. The slice's cards carry their
+## own action buttons, so any open card hides the dominant button.
+static func dominant_button_visible(popup_open: bool) -> bool:
+	return not popup_open
+
+## Touch-proxy rect: the invisible enlarged hit area for a small target — at
+## least the role floor in both dimensions, centered on the target, never
+## shrinking a target that already meets the floor. Clamped inside the given
+## bounds (default: the reference viewport) so the hit area never spills off
+## an edge — an off-screen slice is untappable, which would silently shave
+## the effective hit area below the floor.
+static func touch_proxy_rect(target_rect: Rect2, role: int, bounds_rect := Rect2(Vector2.ZERO, REFERENCE_VIEWPORT)) -> Rect2:
+	var min_size := min_touch_size(role)
+	var proxy_size := Vector2(maxf(target_rect.size.x, min_size), maxf(target_rect.size.y, min_size))
+	var proxy := Rect2(target_rect.get_center() - proxy_size / 2.0, proxy_size)
+	proxy.position = proxy.position.clamp(bounds_rect.position, bounds_rect.position + bounds_rect.size - proxy.size)
+	return proxy
