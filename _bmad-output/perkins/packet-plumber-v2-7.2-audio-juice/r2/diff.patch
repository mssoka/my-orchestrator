+package audio
+
+// audio_test.odin — unit tests for the PURE half of the audio module (the
+// consumer's draw pattern, the throttle, the caption priority/expiry, and
+// the WAV synthesis/packing). No audio device, no raylib calls — the tested
+// procs never touch rl (the flush/play half is device-gated and covered by
+// the app smoke check + manual verification, documented in the PR).
+//
+// Run: odin test app/audio    (links the stock raylib; pure tests only)
+
+import "core:testing"
+import pp "../../core"
+
+@(test)
+test_consumer_crisis_draw :: proc(t: ^testing.T) {
+	a: Audio
+	consumer_init(&a)
+	evs := []pp.Event{
+		{tick = 100, tag = pp.EVENT_TAG_CRISIS_TRIGGERED, archetype = 0},
+	}
+	consumer_consume(&a, evs, nil)
+	testing.expectf(t, a.draws == 1, "crisis: total draws %d, want 1", a.draws)
+	testing.expectf(t, a.crisis_draws == 1, "crisis_draws %d, want 1", a.crisis_draws)
+	testing.expectf(t, a.arrival_draws == 0, "arrival_draws %d, want 0", a.arrival_draws)
+	testing.expectf(t, a.pending.crisis_plays == 1, "crisis_plays %d, want 1", a.pending.crisis_plays)
+	testing.expectf(t, a.pending.crisis_variant >= 0 && a.pending.crisis_variant < CRISIS_VARIANTS,
+		"crisis_variant %d out of range", a.pending.crisis_variant)
+	txt, ok := caption_live(&a, 100)
+	testing.expectf(t, ok && txt == "crisis alert - crisis", "crisis caption %q ok=%v", txt, ok)
+	testing.expectf(t, a.caption.crisis, "crisis caption must be marked crisis")
+}
+
+@(test)
+test_consumer_arrival_throttle :: proc(t: ^testing.T) {
+	a: Audio
+	consumer_init(&a)
+	// a dense burst: 2 arrivals at tick 100, 1 at 101, 1 at 102. The throttle
+	// (min gap 2 ticks) admits 100 and 102; 100b + 101 are suppressed.
+	evs := []pp.Event{
+		{tick = 100, tag = pp.EVENT_TAG_PACKET_ARRIVED},
+		{tick = 100, tag = pp.EVENT_TAG_PACKET_ARRIVED},
+		{tick = 101, tag = pp.EVENT_TAG_PACKET_ARRIVED},
+		{tick = 102, tag = pp.EVENT_TAG_PACKET_ARRIVED},
+	}
+	consumer_consume(&a, evs, nil)
+	testing.expectf(t, a.pending.arrival_plays == 2, "arrival_plays %d, want 2", a.pending.arrival_plays)
+	testing.expectf(t, a.suppressed == 2, "suppressed %d, want 2", a.suppressed)
+	testing.expectf(t, a.arrival_draws == 2, "arrival_draws %d, want 2", a.arrival_draws)
+	testing.expectf(t, a.arrival_last_tick == 102, "last tick %d, want 102", a.arrival_last_tick)
+}
+
+@(test)
+test_caption_crisis_priority :: proc(t: ^testing.T) {
+	a: Audio
+	consumer_init(&a)
+	// arrival first, then crisis in the SAME batch — the crisis must win.
+	consumer_consume(&a, []pp.Event{{tick = 100, tag = pp.EVENT_TAG_PACKET_ARRIVED}}, nil)
+	consumer_consume(&a, []pp.Event{{tick = 101, tag = pp.EVENT_TAG_CRISIS_TRIGGERED, archetype = 0}}, nil)
+	txt, ok := caption_live(&a, 101)
+	testing.expectf(t, ok && txt == "crisis alert - crisis", "W1: crisis clobbered: %q", txt)
+	// an arrival while the crisis caption is unexpired must NOT clobber it.
+	consumer_consume(&a, []pp.Event{{tick = 105, tag = pp.EVENT_TAG_PACKET_ARRIVED}}, nil)
+	txt, ok = caption_live(&a, 105)
+	testing.expectf(t, ok && txt == "crisis alert - crisis", "W1: arrival clobbered the live crisis caption: %q", txt)
+	// after the crisis dwell expires, arrivals own the slot again.
+	consumer_consume(&a, []pp.Event{{tick = 200, tag = pp.EVENT_TAG_PACKET_ARRIVED}}, nil)
+	txt, ok = caption_live(&a, 200)
+	testing.expectf(t, ok && txt == "packet delivered", "post-expiry caption %q", txt)
+}
+
+@(test)
+test_caption_expiry_and_reset :: proc(t: ^testing.T) {
+	a: Audio
+	consumer_init(&a)
+	consumer_consume(&a, []pp.Event{{tick = 100, tag = pp.EVENT_TAG_CRISIS_TRIGGERED, archetype = 0}}, nil)
+	_, ok := caption_live(&a, 100 + CAPTION_DWELL_TICKS)
+	testing.expectf(t, ok, "caption must be live at the dwell end")
+	_, ok = caption_live(&a, 100 + CAPTION_DWELL_TICKS + 1)
+	testing.expectf(t, !ok, "caption must expire after the dwell")
+	// reset_run clears the caption + the throttle (restart coverage).
+	consumer_consume(&a, []pp.Event{{tick = 300, tag = pp.EVENT_TAG_PACKET_ARRIVED}}, nil)
+	audio_reset_run(&a)
+	_, ok = caption_live(&a, 300)
+	testing.expectf(t, !ok, "reset_run must clear the caption")
+	consumer_consume(&a, []pp.Event{{tick = 400, tag = pp.EVENT_TAG_PACKET_ARRIVED}}, nil)
+	testing.expectf(t, a.pending.arrival_plays == 1, "reset_run must reset the throttle (plays %d)", a.pending.arrival_plays)
+}
+
+@(test)
+test_wav_pack_header :: proc(t: ^testing.T) {
+	samples := []f32{0.0, 0.5, -0.5, 1.0}
+	buf := wav_pack(samples)
+	defer delete(buf)
+	testing.expectf(t, len(buf) == 44 + 2 * len(samples), "wav len %d, want %d", len(buf), 44 + 2 * len(samples))
+	testing.expectf(t, string(buf[0:4]) == "RIFF", "no RIFF magic")
+	testing.expectf(t, string(buf[8:12]) == "WAVE", "no WAVE tag")
+	testing.expectf(t, string(buf[12:16]) == "fmt ", "no fmt chunk")
+	testing.expectf(t, u16(buf[20]) | u16(buf[21]) << 8 == 1, "format %d, want 1 (PCM)", u16(buf[20]) | u16(buf[21]) << 8)
+	testing.expectf(t, u16(buf[22]) | u16(buf[23]) << 8 == 1, "channels %d, want 1", u16(buf[22]) | u16(buf[23]) << 8)
+	rate := u32(buf[24]) | u32(buf[25]) << 8 | u32(buf[26]) << 16 | u32(buf[27]) << 24
+	testing.expectf(t, rate == SYNTH_SAMPLE_RATE, "rate %d, want %d", rate, SYNTH_SAMPLE_RATE)
+	testing.expectf(t, string(buf[36:40]) == "data", "no data chunk")
+	data_len := u32(buf[40]) | u32(buf[41]) << 8 | u32(buf[42]) << 16 | u32(buf[43]) << 24
+	testing.expectf(t, data_len == u32(2 * len(samples)), "data len %d", data_len)
+	// sample i sits at buf[44 + 2i]: 0.0 -> 0 (00 00); 0.5 -> 16383 (0x3FFF,
+	// LE FF 3F); -0.5 -> -16383 (0xC001, LE 01 C0); 1.0 -> 32767 (FF 7F)
+	idx1 := 44 + 2 // sample 1 (0.5)
+	idx2 := 44 + 4 // sample 2 (-0.5)
+	idx3 := 44 + 6 // sample 3 (1.0)
+	testing.expectf(t, buf[idx1] == 0xff && buf[idx1+1] == 0x3f, "0.5 sample bytes %02x %02x", buf[idx1], buf[idx1+1])
+	testing.expectf(t, buf[idx2] == 0x01 && buf[idx2+1] == 0xc0, "-0.5 sample bytes %02x %02x", buf[idx2], buf[idx2+1])
+	testing.expectf(t, buf[idx3] == 0xff && buf[idx3+1] == 0x7f, "1.0 sample bytes %02x %02x", buf[idx3], buf[idx3+1])
+}
+
+@(test)
+test_synth_wav_forms :: proc(t: ^testing.T) {
+	kinds := []bool{true, false}
+	for crisis in kinds {
+		for i in 0..<3 {
+			buf := synth_wav(crisis, i)
+			defer delete(buf)
+			testing.expectf(t, len(buf) > 44, "synth(%v,%d) too small: %d", crisis, i, len(buf))
+			testing.expectf(t, string(buf[0:4]) == "RIFF" && string(buf[8:12]) == "WAVE", "synth(%v,%d) bad header", crisis, i)
+			// non-silent: at least one |sample| > 1000 (the placeholders are
+			// tones, never silence — a silent placeholder would be a bug).
+			loud := false
+			for j := 44; j + 1 < len(buf); j += 2 {
+				s := i16(u16(buf[j]) | u16(buf[j+1]) << 8)
+				if s > 1000 || s < -1000 {
+					loud = true
+					break
+				}
+			}
+			testing.expectf(t, loud, "synth(%v,%d) is silent", crisis, i)
+		}
+	}
+}
+
+@(test)
+test_variant_draws_stay_in_range :: proc(t: ^testing.T) {
+	a: Audio
+	consumer_init(&a)
+	for i in 0..<50 {
+		consumer_consume(&a, []pp.Event{{tick = u64(100 + i), tag = pp.EVENT_TAG_PACKET_ARRIVED}}, nil)
+		testing.expectf(t, a.pending.arrival_variant >= 0 && a.pending.arrival_variant < ARRIVAL_VARIANTS,
+			"arrival variant %d out of range", a.pending.arrival_variant)
+	}
+	for i in 0..<10 {
+		consumer_consume(&a, []pp.Event{{tick = u64(1000 + i), tag = pp.EVENT_TAG_CRISIS_TRIGGERED, archetype = 0}}, nil)
+		testing.expectf(t, a.pending.crisis_variant >= 0 && a.pending.crisis_variant < CRISIS_VARIANTS,
+			"crisis variant %d out of range", a.pending.crisis_variant)
+	}
+}
