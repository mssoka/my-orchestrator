+import au "../app/audio" // 7.2: the audio-determinism golden's consumer mirror
 
 log_path :: proc(demo: string) -> string {
 	return fmt.tprintf("goldens/%s.log.bin", demo)
@@ -298,6 +299,20 @@ run_demo :: proc(name: string, save: bool, cat: ^pp.Catalogs, rc: ^Render_Ctx, s
 	fails: [dynamic]string
 	defer delete(fails)
 
+	// 7.2: the audio-determinism golden's consumer mirror — a zero Audio
+	// seeded with the SAME cosmetic seed the app uses, fed the same event
+	// slices the app's consumer eats (per tick here; per frame in the app —
+	// the draws touch ONLY the cosmetic stream, so the interleave granularity
+	// is immaterial to the hash). The replay gate re-sims the blessed log
+	// WITHOUT the consumer and must reproduce the manifest byte-identically —
+	// audio on == audio off (ODN-15). The draws>0 check (after the loop)
+	// is the vacuous-guard: a no-op consumer would pass every hash trivially.
+	audio_consumer: au.Audio
+	audio_consumer_on := name == "audio" || name == "audio_throttle"
+	if audio_consumer_on {
+		au.consumer_init(&audio_consumer)
+	}
+
 	// 5.7: the per-tick stats stream for this demo (empty path = off). The
 	// builder is DEFAULT-allocated (the per-tick free_all would recycle a
 	// temp builder) — freed after the write.
@@ -358,6 +373,15 @@ run_demo :: proc(name: string, save: bool, cat: ^pp.Catalogs, rc: ^Render_Ctx, s
 				}
 			}
 			pp.step(&state, sim_tick, batch[:], cat)
+			// 7.2: the audio consumer interleaves BEFORE the hash (the app's
+			// real order: step -> consume -> hash). PURE — the draws advance
+			// only the app-owned cosmetic stream, never state.rng and never
+			// Run_State (ODN-15), so the sim hash cannot move; the replay
+			// gate re-sims the blessed log WITHOUT the consumer and must match
+			// byte-identically.
+			if audio_consumer_on {
+				au.consumer_consume(&audio_consumer, state.events[before:], cat)
+			}
 			append(&hashes, pp.state_hash(&state, state.events[before:], cat, context.temp_allocator))
 			// 5.7: the per-tick stats record (derived from the just-stepped
 			// state + the per-tick hash). Emitted for STEPPED ticks only — a
@@ -431,6 +455,28 @@ run_demo :: proc(name: string, save: bool, cat: ^pp.Catalogs, rc: ^Render_Ctx, s
 
 		free_all(context.temp_allocator)
 	}
+	// 7.2 vacuous-guards (r1 W3/W4): the goldens must PROVE the consumer ran
+	// AND exercised the alert kinds each scenario claims (a no-op consumer
+	// would pass every hash trivially). audio.dem: BOTH kinds (crisis + 1
+	// arrival). audio_throttle.dem: arrivals + the throttle biting (plays <
+	// arrivals on a dense tick — the suppress path is otherwise unproven).
+	if audio_consumer_on {
+		if name == "audio" {
+			if audio_consumer.crisis_draws < 1 {
+				append(&fails, "audio consumer: no crisis draw — the golden is vacuous")
+			}
+			if audio_consumer.arrival_draws < 1 {
+				append(&fails, "audio consumer: no arrival draw — the golden is vacuous")
+			}
+		} else if name == "audio_throttle" {
+			if audio_consumer.arrival_draws < 1 {
+				append(&fails, "audio consumer: no arrival draw — the throttle golden is vacuous")
+			}
+			if audio_consumer.suppressed == 0 {
+				append(&fails, "audio consumer: arrival throttle never bit (no dense tick) — suppression unproven")
+			}
+		}
+	}
