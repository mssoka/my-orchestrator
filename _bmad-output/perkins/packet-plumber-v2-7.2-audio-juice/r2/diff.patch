@@ -0,0 +1,406 @@
+package audio
+
+// audio.odin — Story 7.2's audio layer (E8.3, ODN-15): a crisis-alert sting
+// and a packet-arrival click through raudio, with variant selection from the
+// APP-OWNED cosmetic Rng (never the sim rng — ODN-15/ODN-9), procedural
+// placeholder tones when real Suno assets are absent, and an on-screen
+// caption for every alert (the a11y contract — story 7.3 builds the full
+// caption system; this is the minimal seam).
+//
+// Determinism spine (ODN-15): this module NEVER writes Run_State and never
+// draws from state.rng. `consumer_consume` has NO access to the sim at all —
+// it receives the event slice + the catalogs and touches only the cosmetic
+// stream, the arrival throttle, and the caption state — so the sim hash
+// cannot move. The T1 golden (demos/audio.dem) pins it: the harness
+// interleaves this module's consumption pattern between steps, and the
+// replay gate (which re-sims WITHOUT the consumer) must reproduce the
+// blessed manifest byte-identically — audio on == audio off.
+//
+// Asset-drop contract (see assets/audio/README.md): drop Suno files at
+// assets/audio/crisis_01.ogg .. crisis_03.ogg and arrival_01.ogg ..
+// arrival_03.ogg (raylib audio formats; OGG Vorbis recommended). A slot
+// without a real file loads a synthesized placeholder; the variant count is
+// FIXED (3 + 3), so the cosmetic draw pattern never depends on which slots
+// are real — the golden stays valid with or without assets.
+
+import "core:c"
+import "core:fmt"
+import "core:math"
+import pp "../../core"
+import rl "vendor:raylib"
+
+// The fixed variant slots (3 stings + 3 clicks). Real assets or synthesized
+// placeholders fill EVERY slot — never a partial set (the draw pattern must
+// be asset-independent).
+CRISIS_VARIANTS :: 3
+ARRIVAL_VARIANTS :: 3
+
+// COSMETIC_SEED — the app-owned cosmetic stream's fixed seed (ODN-15). The
+// sim never reads this stream; the harness consumer mirrors the SAME seed so
+// the T1 golden pins the app's real draw pattern.
+COSMETIC_SEED :: u64(0x5EED_A11D0)
+
+// ARRIVAL_MIN_GAP_TICKS — the arrival-click throttle: at most one click per
+// 2 logic ticks (100 ms at the pinned 20 Hz — 10 clicks/s max). A busy tick
+// with 30 deliveries is ONE click, never a buzz. Suppressed arrivals are
+// silent AND uncaptioned (no alert happened).
+ARRIVAL_MIN_GAP_TICKS :: u64(2)
+
+// CAPTION_DWELL_TICKS — the on-screen caption lives 40 ticks (2 s at 20 Hz).
+CAPTION_DWELL_TICKS :: u64(40)
+
+// The placeholder loudness (real Suno files replace the slot, volume
+// included). Clicks sit under the sting — they fire far more often.
+CRISIS_VOLUME :: f32(0.85)
+ARRIVAL_VOLUME :: f32(0.40)
+
+// The placeholder synth recipes (see synth_wav). Frequencies in Hz.
+CRISIS_BEEPS :: [3]int{3, 2, 4}   // beep counts per variant slot
+CRISIS_FREQS :: [3]f32{660, 880, 660} // the alarm's beep melody (cycled)
+ARRIVAL_F0   :: [3]f32{1800, 1500, 2200} // click sweep starts (per slot)
+ARRIVAL_F1   :: [3]f32{2400, 2000, 2800} // click sweep ends (per slot)
+
+SYNTH_SAMPLE_RATE :: 22050
+SYNTH_RAMP_SAMPLES :: 110       // int(0.005 s * 22050 Hz) — a constant (110.25 truncates)
+
+// Caption — one on-screen alert caption (the a11y contract). `text` is a
+// view into `buf` (buf lives in Audio — the view stays stable). `crisis`
+// marks a crisis caption for the priority rule (W1): an unexpired crisis
+// caption is never clobbered by an arrival caption in the same batch — the
+// crisis is the higher-priority alert (arrivals still win once it expires).
+Caption :: struct {
+	text:       string,
+	buf:        [96]u8,
+	until_tick: u64,
+	crisis:     bool,
+	live:       bool,
+}
+
+// Pending — what consumer_consume decided this frame; audio_flush plays it.
+// Split so the consumer stays pure (the harness golden can run it with no
+// audio device — the draws are the sim-relevant part). u16: a catch-up frame
+// can stage many plays; u8 could wrap on a pathological burst (r1 note).
+Pending :: struct {
+	crisis_plays:   u16,
+	crisis_variant: i32,
+	arrival_plays:  u16,
+	arrival_variant: i32,
+}
+
+// Audio — the module state, owned by App (ODN-13: no globals).
+Audio :: struct {
+	device_on:        bool,  // InitAudioDevice succeeded
+	muted:            bool,  // M toggles; captions stay live while muted
+	cosmetic:         pp.Rng, // ODN-15 — the app-owned stream
+	draws:            u64,   // cosmetic draws so far (the harness's vacuous-guard)
+	crisis_draws:     u64,   // per-kind draw counts — the golden asserts per-kind
+	arrival_draws:    u64,   // minimums (W3), not just the total
+	suppressed:       u64,   // arrivals the throttle silenced (the throttle-bites assert, W4)
+	arrival_last_tick: u64,  // the throttle's last-clicked tick (per run)
+	caption:          Caption,
+	pending:          Pending,
+	crisis:           [CRISIS_VARIANTS]rl.Sound,
+	arrival:          [ARRIVAL_VARIANTS]rl.Sound,
+}
+
+// audio_init — open the raudio device and load every variant slot (real
+// asset when present, synthesized placeholder otherwise). Silent-fallback:
+// a missing device (headless/CI) leaves sounds empty — captions still
+// caption, nothing plays.
+audio_init :: proc(a: ^Audio) {
+	a^ = {}
+	consumer_init(a)
+	rl.InitAudioDevice()
+	a.device_on = rl.IsAudioDeviceReady()
+	if !a.device_on {
+		return
+	}
+	for i in 0..<CRISIS_VARIANTS {
+		path_buf: [64]u8
+		a.crisis[i] = load_variant(
+			fmt.bprintf(path_buf[:], "assets/audio/crisis_%02d.ogg", i + 1),
+			true, i,
+		)
+	}
+	for i in 0..<ARRIVAL_VARIANTS {
+		path_buf: [64]u8
+		a.arrival[i] = load_variant(
+			fmt.bprintf(path_buf[:], "assets/audio/arrival_%02d.ogg", i + 1),
+			false, i,
+		)
+	}
+}
+
+// audio_destroy — unload the sounds + close the device (app teardown).
+audio_destroy :: proc(a: ^Audio) {
+	if a.device_on {
+		for s in a.crisis { rl.UnloadSound(s) }
+		for s in a.arrival { rl.UnloadSound(s) }
+	}
+	rl.CloseAudioDevice()
+}
+
+// audio_reset_run — per-run state reset (start_run): a fresh run's first
+// arrival click must not inherit the prior run's throttle position, and a
+// stale caption must not leak across restarts (ODN-13 freshness).
+audio_reset_run :: proc(a: ^Audio) {
+	a.arrival_last_tick = 0
+	a.caption = {}
+	a.pending = {}
+}
+
+// consumer_init — seed the cosmetic stream (the ONLY state the consumer's
+// draws touch). audio_init calls this; the harness consumer needs the seed
+// alone (no device, no sounds).
+consumer_init :: proc(a: ^Audio) {
+	pp.rng_seed(&a.cosmetic, COSMETIC_SEED)
+}
+
+// consumer_consume — the app's per-frame event consumption on the NEW event
+// slice (events[mark:]), and the harness's per-tick mirror for the T1
+// golden. PURE: variant draws from the cosmetic rng only, the arrival
+// throttle, and the caption state. Never touches Run_State or state.rng
+// (ODN-15) — the sim hash cannot move. Plays are staged in `pending` and
+// flushed by audio_flush (the flush is the only raylib-touching half).
+consumer_consume :: proc(a: ^Audio, events: []pp.Event, cat: ^pp.Catalogs) {
+	for e in events {
+		switch e.tag {
+		case pp.EVENT_TAG_CRISIS_TRIGGERED:
+			// the crisis sting: variant from the cosmetic rng only (ODN-15).
+			variant: i32 = pp.rng_range(&a.cosmetic, 0, i32(CRISIS_VARIANTS) - 1)
+			a.draws += 1
+			a.crisis_draws += 1
+			a.pending.crisis_plays += 1
+			a.pending.crisis_variant = variant
+			set_caption(&a.caption, crisis_caption(&a.caption, cat, e), e.tick, true)
+		case pp.EVENT_TAG_PACKET_ARRIVED:
+			// the arrival click, throttled (see ARRIVAL_MIN_GAP_TICKS). The
+			// throttle keys on the EVENT's tick — a catch-up frame stays
+			// throttled across its ticks.
+			if e.tick < a.arrival_last_tick + ARRIVAL_MIN_GAP_TICKS {
+				a.suppressed += 1
+				continue
+			}
+			a.arrival_last_tick = e.tick
+			variant: i32 = pp.rng_range(&a.cosmetic, 0, i32(ARRIVAL_VARIANTS) - 1)
+			a.draws += 1
+			a.arrival_draws += 1
+			a.pending.arrival_plays += 1
+			a.pending.arrival_variant = variant
+			// W1: the crisis-priority caption rule — an unexpired crisis
+			// caption is never clobbered by an arrival in the same batch
+			// (last-writer-wins previously lost the crisis before it rendered).
+			if !caption_crisis_live(&a.caption, e.tick) {
+				set_caption(&a.caption, "packet delivered", e.tick, false)
+			}
+		}
+	}
+}
+
+// caption_crisis_live — is an unexpired CRISIS caption live at `tick`?
+// (The arrival-caption guard — a crisis alert outranks an arrival click.)
+caption_crisis_live :: proc(c: ^Caption, tick: u64) -> bool {
+	return c.live && c.crisis && tick <= c.until_tick
+}
+
+// audio_flush — play the staged alerts (the only playing half; gated on the
+// device + the mute flag). Muted alerts are dropped, not queued. A batch of
+// repeated plays CYCLES the variants (crisis_batch note): N triggers in one
+// frame stay distinguishable instead of collapsing to the last-drawn variant
+// (the draw pattern is unchanged — one draw per trigger).
+audio_flush :: proc(a: ^Audio) {
+	if !a.device_on || a.muted {
+		a.pending = {}
+		return
+	}
+	for k in 0..<a.pending.crisis_plays {
+		v := (a.pending.crisis_variant + i32(k)) % CRISIS_VARIANTS
+		rl.PlaySound(a.crisis[v])
+	}
+	for k in 0..<a.pending.arrival_plays {
+		v := (a.pending.arrival_variant + i32(k)) % ARRIVAL_VARIANTS
+		rl.PlaySound(a.arrival[v])
+	}
+	a.pending = {}
+}
+
+// toggle_mute — the M-key mute toggle; returns the new state. Stopping the
+// currently-playing stings on mute keeps the flip immediate. Captions stay
+// live while muted (the a11y contract — a muted game is not a silent game).
+toggle_mute :: proc(a: ^Audio) -> bool {
+	a.muted = !a.muted
+	if a.muted && a.device_on {
+		for s in a.crisis { rl.StopSound(s) }
+		for s in a.arrival { rl.StopSound(s) }
+	}
+	return a.muted
+}
+
+is_muted :: proc(a: ^Audio) -> bool {
+	return a.muted
+}
+
+// caption_live — the current caption for tick (expired = none).
+caption_live :: proc(a: ^Audio, tick: u64) -> (string, bool) {
+	if !a.caption.live || tick > a.caption.until_tick {
+		return "", false
+	}
+	return a.caption.text, true
+}
+
+// --- internals ---------------------------------------------------------------
+
+// load_variant — one slot: the real asset file when present, the
+// synthesized placeholder otherwise. The drop-in contract: dropping a Suno
+// file at the slot's path replaces the placeholder byte-for-byte.
+load_variant :: proc(path: string, crisis: bool, idx: int) -> rl.Sound {
+	if rl.FileExists(cstring(raw_data(path))) {
+		s := rl.LoadSound(cstring(raw_data(path)))
+		if s.frameCount > 0 {
+			rl.SetSoundVolume(s, CRISIS_VOLUME if crisis else ARRIVAL_VOLUME)
+			return s
+		}
+		// W6 (r1): a real file that FAILED to decode (frameCount 0) is
+		// unloaded before the placeholder fallback — no orphaned stream
+		// buffer from the failed load.
+		rl.UnloadSound(s)
+	}
+	wave := synth_wav(crisis, idx)
+	defer delete(wave)
+	w := rl.LoadWaveFromMemory(cstring(".wav"), raw_data(wave), c.int(len(wave)))
+	defer rl.UnloadWave(w)
+	s := rl.LoadSoundFromWave(w)
+	rl.SetSoundVolume(s, CRISIS_VOLUME if crisis else ARRIVAL_VOLUME)
+	return s
+}
+
+// set_caption — stamp a caption for `tick` (dwell = CAPTION_DWELL_TICKS).
+// `crisis` marks the caption for the W1 priority rule (see Caption).
+set_caption :: proc(c: ^Caption, txt: string, tick: u64, crisis: bool) {
+	c.text = txt
+	c.until_tick = tick + CAPTION_DWELL_TICKS
+	c.crisis = crisis
+	c.live = true
+}
+
+// crisis_caption — "crisis alert - <display name>" (catalog display strings
+// throughout — a future archetype labels itself). Written into the caption
+// buffer; the returned view is the caption text.
+crisis_caption :: proc(c: ^Caption, cat: ^pp.Catalogs, e: pp.Event) -> string {
+	name := "crisis"
+	if cat != nil && int(e.archetype) < len(cat.crises) {
+		name = cat.crises[e.archetype].display_name
+	}
+	return fmt.bprintf(c.buf[:], "crisis alert - %s", name)
+}
+
+// synth_wav — the placeholder recipe: the crisis alarm (beeps, ~0.6 s) or
+// the arrival click (a 45 ms rising sweep with a fast decay). Returns WAV
+// bytes (PCM16 mono) ready for LoadWaveFromMemory.
+synth_wav :: proc(crisis: bool, idx: int, allocator := context.allocator) -> []u8 {
+	out: [dynamic]f32
+	defer delete(out)
+	if crisis {
+		beeps := CRISIS_BEEPS // constant arrays need a variable to index
+		freqs := CRISIS_FREQS
+		beep_count := beeps[idx % CRISIS_VARIANTS]
+		for b in 0..<beep_count {
+			tone_append(&out, freqs[b % 3], 0.12, 0.5)
+			if b + 1 < beep_count {
+				gap_append(&out, 0.10)
+			}
+		}
+	} else {
+		f0s := ARRIVAL_F0
+		f1s := ARRIVAL_F1
+		slot := idx % ARRIVAL_VARIANTS
+		click_append(&out, f0s[slot], f1s[slot], 0.045, 0.55)
+	}
+	return wav_pack(out[:], allocator)
+}
+
+// tone_append — `dur_s` seconds of a sine at `freq` Hz with a 5 ms linear
+// attack/release ramp (no click artifacts).
+tone_append :: proc(out: ^[dynamic]f32, freq, dur_s, amp: f32) {
+	n := int(dur_s * SYNTH_SAMPLE_RATE)
+	ramp := max(1, SYNTH_RAMP_SAMPLES)
+	for i in 0..<n {
+		t := f32(i) / SYNTH_SAMPLE_RATE
+		v := math.sin(TWO_PI * freq * t) * amp
+		if i < ramp {
+			v *= f32(i) / f32(ramp)
+		}
+		if i >= n - ramp {
+			v *= f32(n - 1 - i) / f32(ramp)
+		}
+		append(out, v)
+	}
+}
+
+// gap_append — `dur_s` of silence (the alarm's inter-beep gap).
+gap_append :: proc(out: ^[dynamic]f32, dur_s: f32) {
+	for _ in 0..<int(dur_s * SYNTH_SAMPLE_RATE) {
+		append(out, 0.0)
+	}
+}
+
+// click_append — `dur_s` of a rising frequency sweep with a fast exponential
+// decay (the arrival "tick": short, percussive, no tail).
+click_append :: proc(out: ^[dynamic]f32, f0, f1, dur_s, amp: f32) {
+	n := int(dur_s * SYNTH_SAMPLE_RATE)
+	phase: f32 = 0
+	dt: f32 = 1.0 / SYNTH_SAMPLE_RATE
+	tau := f32(0.012) // 12 ms decay
+	for i in 0..<n {
+		t := f32(i) / SYNTH_SAMPLE_RATE
+		f := f0 + (f1 - f0) * (f32(i) / f32(n))
+		phase += TWO_PI * f * dt
+		v := math.sin(phase) * amp * math.exp(-t / tau)
+		append(out, v)
+	}
+}
+
+// wav_pack — wrap float samples as PCM16-mono WAV bytes (RIFF/fmt/data).
+wav_pack :: proc(samples: []f32, allocator := context.allocator) -> []u8 {
+	data_len := 2 * len(samples)
+	buf := make([]u8, 44 + data_len, allocator)
+	put_cstr(buf[0:], "RIFF")
+	put_u32_le(buf[4:], u32(36 + data_len))
+	put_cstr(buf[8:], "WAVE")
+	put_cstr(buf[12:], "fmt ")
+	put_u32_le(buf[16:], 16)                   // fmt chunk size
+	put_u16_le(buf[20:], 1)                    // PCM
+	put_u16_le(buf[22:], 1)                    // mono
+	put_u32_le(buf[24:], SYNTH_SAMPLE_RATE)    // sample rate
+	put_u32_le(buf[28:], SYNTH_SAMPLE_RATE * 2) // byte rate (16-bit mono)
+	put_u16_le(buf[32:], 2)                    // block align
+	put_u16_le(buf[34:], 16)                   // bits per sample
+	put_cstr(buf[36:], "data")
+	put_u32_le(buf[40:], u32(data_len))
+	for i in 0..<len(samples) {
+		v := i16(clamp(samples[i], -1.0, 1.0) * 32767.0)
+		buf[44 + 2 * i] = u8(v)
+		buf[45 + 2 * i] = u8(u16(v) >> 8)
+	}
+	return buf
+}
+
+put_cstr :: proc(b: []u8, s: string) {
+	for i in 0..<len(s) {
+		b[i] = s[i]
+	}
+}
+
+put_u16_le :: proc(b: []u8, v: u16) {
+	b[0] = u8(v)
+	b[1] = u8(v >> 8)
+}
+
+put_u32_le :: proc(b: []u8, v: u32) {
+	b[0] = u8(v)
+	b[1] = u8(v >> 8)
+	b[2] = u8(v >> 16)
+	b[3] = u8(v >> 24)
+}
+
+TWO_PI :: f32(2.0 * math.PI)
