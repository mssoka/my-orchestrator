diff --git a/harness/demo.odin b/harness/demo.odin
index 5888ee8..0452bff 100644
--- a/harness/demo.odin
+++ b/harness/demo.odin
@@ -46,6 +46,26 @@ Demolish_Intent :: struct {
 	id:   u32, // pipe id (kind=.Pipe) or node id (kind=.Node)
 }
 
+// Emphasis_Intent — a 3.2 `at <n>ms emphasis <pipe> <preset>` directive: set a
+// pipe's priority-emphasis dial to a lane preset (resolved by id against
+// balance.json's lane_presets at lowering, like tier names). A LOGGED command
+// (Cmd_Set_Emphasis) — replay-determinate.
+Emphasis_Intent :: struct {
+	at_ms:  i64,
+	pipe:   u32, // pipe id (fixture/draw order)
+	preset: string, // lane_presets id (balanced/express_heavy/best_effort_heavy)
+}
+
+// Lane_Intent — a 3.2 `at <n>ms lane <pipe> <class> <lane>` directive: override
+// a packet class's lane on a pipe (class + lane resolved by name at lowering).
+// A LOGGED command (Cmd_Set_Lane) — replay-determinate.
+Lane_Intent :: struct {
+	at_ms: i64,
+	pipe:  u32, // pipe id (fixture/draw order)
+	class: string, // packet_types id (email/streaming)
+	lane:  string, // express|standard|best_effort
+}
+
 // Node_Spawn — a `spawn_node` directive: one node of `type_name` (a catalog
 // node-type id, e.g. "router_basic") at a fixed integer grid position. The
 // node's ID is NOT authored — it is the spawn ORDER (0-based, monotonic, never
@@ -72,6 +92,8 @@ Demo :: struct {
 	draws:              [dynamic]Draw_Intent,
 	spawns:             [dynamic]Spawn_Intent,
 	demolishes:         [dynamic]Demolish_Intent,
+	emphasis:           [dynamic]Emphasis_Intent, // 3.2: `at <n>ms emphasis <pipe> <preset>`
+	lanes:              [dynamic]Lane_Intent,     // 3.2: `at <n>ms lane <pipe> <class> <lane>`
 	captures:           [dynamic]i64, // T2 capture times (ms)
 	win_goal:           u32, // 1.4: packets to deliver for a WIN (0 = win/lose disabled)
 	lose_cap_ms:        i64, // 1.4: tick-cap lose time (0 = no cap); lose if run reaches this with score < goal
@@ -79,8 +101,16 @@ Demo :: struct {
 
 // parse_demo — line-based; `seed <n>`, `run <n>ms`, `expect hash stable`,
 // `at <n>ms draw <from> <to> <tier>`, `at <n>ms spawn <from> <to>`,
-// `at <n>ms demolish pipe|node <id>`, `spawn_node <type> <x> <y>`,
+// `at <n>ms demolish pipe|node <id>`, `at <n>ms emphasis <pipe> <preset>`,
+// `at <n>ms lane <pipe> <class> <lane>`, `spawn_node <type> <x> <y>`,
 // `fixture on|off`, `win goal <n>`, `lose cap <n>ms`, `capture at <n>ms`.
+//
+// VERB ORDERING AT LOWERING (documented): commands are appended to the action
+// log in FIXED GROUP order — draws, then demolishes, then emphasis, then
+// lanes — NOT in file order. Same-tick directives therefore apply in group
+// order regardless of authoring order (e.g. an `at 100ms demolish` always
+// beats an `at 100ms lane` on the same pipe). Deterministic by construction;
+// author same-tick directives on different pipes or accept the group order.
 // Returns "" on success, a one-line error otherwise.
