diff --git a/core/qos.odin b/core/qos.odin
new file mode 100644
index 0000000..0f2a9b1
--- /dev/null
+++ b/core/qos.odin
@@ -0,0 +1,179 @@
+package core
+
+// qos.odin — Story 3.2: the 3-lane QoS procs (ODN-3). QoS is NOT a system: a
+// set of pure procs in package core's flow files, called by flow_step, with
+// lane weights/policies as Topology-owned data. The allocator partitions a
+// pipe's bandwidth across the 3 DiffServ lanes by integer WFQ weights:
+//
+//   qos_allocate :: proc(capacity: u32, w: [3]i32, default_w: [3]i32) -> [3]u32
+//   // weight-only partition (demand is NOT an input — gap-fill is a
+//   // serialization-time concern, story 3.3); all-zero weights → the catalog
+//   // default preset (E5); largest-remainder distribution, Express→Standard→
+//   // Best tie order (E8). Sums/remainders computed in i64 (ODN-10).
+//
+// The never-drop floor (E6) lives in the flow side (qos_pipe_caps, invoked by
+// flow_step), not in the pure allocator: the allocator cannot know which lane
+// carries a never-drop class; the flow knows the class→lane bindings (catalog
+// default_lane + per-pipe overrides), so it floors that lane at a quantum of 1
+// bandwidth-unit after allocation, floors satisfied in lane order (E→S→B) with
+// capacity exhaustion as the defined truncation.
+//
+// Serialization (qos_serialize — work-conserving gap-fill + WRR floor) and the
+// contention drop ladder are Story 3.3; SLA accumulators are 3.4. This file
+// carries only what 3.2 needs: allocation + lane resolution + the floor.
+//
+// Integer-only (ODN-10); arrays only; no file/clock reads (ODN-1).
+
+// qos_allocate — the pure integer-WFQ partition (E8). Largest-remainder over
+// the 3 lane weights: each lane gets floor(capacity * w_i / W) (W = sum of
+// weights, i64), then the remaining units are handed out one per lane in
+// Express→Standard→Best order to the lanes with the largest fractional
+// remainders (ties break to the earlier lane — the E→S→B tie order). The sum
+// of the returned caps is EXACTLY `capacity` for any in-domain weights.
+// Weight domain: 0 ≤ w_i ≤ MAX_WEIGHT (enforced at the Command_Bus +
+// catalog load; the proc itself is total on i32).
+//
+// E5: all-zero weights → `default_w` (the catalog default preset). A zero
+// weight never contributes to the total and never receives a remainder unit —
+// a zeroed lane's cap is 0 (the player's demote-to-nothing choice; the bus
+// rejects it on never-drop lanes, E6).
+qos_allocate :: proc(capacity: u32, w: [3]i32, default_w: [3]i32) -> (caps: [3]u32) {
+	weights := w
+	total: i64 = 0
+	all_zero := true
+	for wv in weights {
+		if wv != 0 { all_zero = false }
+	}
+	if all_zero {
+		weights = default_w // E5 — the catalog default preset
+	}
+	for wv in weights {
+		if wv > 0 { total += i64(wv) }
+	}
+	if total <= 0 {
+		return {} // no positive weight at all (default also degenerate) — nothing to allocate
+	}
+	if capacity == 0 {
+		return {}
+	}
+	c := i64(capacity)
+	given: i64 = 0
+	frac: [LANE_COUNT]i64 // numerator of each lane's remainder, i.e. (c*w_i) % total
+	for i in 0..<LANE_COUNT {
+		if weights[i] <= 0 {
+			continue
+		}
+		num := c * i64(weights[i])
+		q := num / total
+		caps[i] = u32(q)
+		frac[i] = num % total
+		given += q
+	}
+	// largest-remainder: hand out the leftover units to the lanes with the
+	// biggest fractional remainders, ties breaking E→S→B (a strict `>` keeps
+	// the earliest lane on ties — stable + pinned).
+	rem := c - given
+	for rem > 0 {
+		best := -1
+		best_frac: i64 = -1
+		for i in 0..<LANE_COUNT {
+			if weights[i] <= 0 { continue }
+			if frac[i] > best_frac {
+				best_frac = frac[i]
+				best = i
+			}
+		}
+		if best < 0 { break } // all remainder-carrying lanes exhausted (unreachable for in-domain weights)
+		caps[best] += 1
+		frac[best] = -1 // consumed — next round picks the next-largest
+		rem -= 1
+	}
+	return caps
+}
+
+// Lane_Override — a per-pipe, per-class lane assignment (Cmd_Set_Lane data).
+// Stored as a FLAT insertion-ordered list on the Topology (map-free — ODN-10);
+// resolution is last-write-wins over the pipe's entries. A class with no
+// override rides its catalog default_lane (Standard game-wide — GDD M2).
+Lane_Override :: struct {
+	pipe:  u32, // pipe id
+	class: u16, // packet_types index
+	lane:  u8,  // 0=Express 1=Standard 2=Best-effort
+}
+
+// qos_lane_of — resolve the lane a packet class rides on a pipe: the pipe's
+// per-pipe override if present (last-write-wins over the flat list), else the
+// class's catalog default_lane. Deterministic: the override scan is a pure
+// array walk in insertion order (E10).
+qos_lane_of :: proc(t: ^Topology, cat: ^Catalogs, pipe: u32, class: u16) -> u8 {
+	if len(t.pipe_lane_over) > 0 {
+		for i := len(t.pipe_lane_over) - 1; i >= 0; i -= 1 {
+			o := t.pipe_lane_over[i]
+			if o.pipe == pipe && o.class == class {
+				return o.lane
+			}
+		}
+	}
+	if int(class) < len(cat.packet_types) {
+		return cat.packet_types[class].default_lane
+	}
+	return LANE_STANDARD
+}
+
+// qos_pipe_weights — the active WFQ weights of a pipe: its per-pipe weights if
+// set (Cmd_Set_Emphasis), else the catalog default preset. All pipes start on
+// the default preset (the "balanced" dial position — GDD: nothing
+// auto-allocates, the dial is the player's lever).
+qos_pipe_weights :: proc(t: ^Topology, cat: ^Catalogs, pipe_slot: u32) -> [3]i32 {
+	if int(pipe_slot) < len(t.pipe_weights) {
+		return t.pipe_weights[pipe_slot]
+	}
+	return cat.balance.lane_presets[cat.balance.default_preset_idx].weights
+}
+
+// qos_pipe_never_drop — which lanes carry a never-drop class on this pipe
+// (E6): a class with max_loss_pct == 0 whose lane on this pipe (override or
+// default) is the given lane. Lane order E→S→B for the floor walk.
+qos_pipe_never_drop :: proc(t: ^Topology, cat: ^Catalogs, pipe: u32) -> (nd: [LANE_COUNT]bool) {
+	for i in 0..<len(cat.packet_types) {
+		pt := cat.packet_types[i]
+		if pt.max_loss_pct != 0 { continue } // never-drop = 0% loss tolerance
+		lane := qos_lane_of(t, cat, pipe, u16(i))
+		if lane < LANE_COUNT {
+			nd[lane] = true
+		}
+	}
+	return nd
+}
+
+// qos_apply_floor — the E6 floor: a never-drop lane is guaranteed a quantum of
+// 1 bandwidth-unit after allocation. Floors are satisfied in lane order
+// (Express → Standard → Best); when the pipe is too small to floor every
+// zeroed never-drop lane (tiny pipes), capacity exhaustion is the defined
+// truncation (later lanes stay at 0). The floor may oversell the sum by a
+// quantum — defined; 3.3's gap-fill absorbs it at serialization.
+qos_apply_floor :: proc(caps: [3]u32, never_drop: [LANE_COUNT]bool, capacity: u32) -> (out: [3]u32) {
+	out = caps
+	floor_budget := capacity
+	for lane in 0..<LANE_COUNT { // E→S→B
+		if !never_drop[lane] { continue }
+		if out[lane] >= 1 { continue } // already has bandwidth — no floor needed
+		if floor_budget == 0 { break } // capacity exhausted — defined truncation
+		out[lane] = 1
+		floor_budget -= 1
+	}
+	return out
+}
+
+// qos_pipe_caps — the flow-side per-pipe lane allocation: qos_allocate on the
+// pipe's tier capacity + the E6 floor for never-drop lanes on this pipe. This
+// is what flow_step folds into Flow_State.lane_caps (the readout + the 3.3
+// serialization seam) — the E6 floor lives HERE, inside the flow, never in
+// the pure allocator (ODN-3).
+qos_pipe_caps :: proc(t: ^Topology, cat: ^Catalogs, pipe_slot: u32, pipe_id: u32) -> [3]u32 {
+	cap := u32(cat.pipe_tiers[t.pipe_tier[pipe_slot]].capacity_units)
+	w := qos_pipe_weights(t, cat, pipe_slot)
+	caps := qos_allocate(cap, w, cat.balance.lane_presets[cat.balance.default_preset_idx].weights)
+	nd := qos_pipe_never_drop(t, cat, pipe_id)
+	return qos_apply_floor(caps, nd, cap)
+}
diff --git a/core/qos_test.odin b/core/qos_test.odin
new file mode 100644
index 0000000..e5a6856
--- /dev/null
+++ b/core/qos_test.odin
@@ -0,0 +1,357 @@
+package core
+
+// qos_test.odin — Story 3.2's durable contracts (arch §11.7): the E5/E6/E8
+// edge-case pins + the command/replay pins. Pinned at the lowest layer so they
+// survive review rounds, refactors, and Perkins:
+//   [E8] largest-remainder integer distribution, E→S→B tie order, sum == capacity;
+//   [E5] all-zero weights → the catalog default preset;
+//   [E6] never-drop lane floored (lane order, capacity truncation) + the bus
+//        rejects the zeroing edit;
+//   the new commands ride the action log + the binary log round-trip, and a
+//   run with emphasis/lane edits replays byte-identically (E10);
+//   the T1 serialization stays SPARSE for default pipes (the golden-stability
+//   mechanism — existing manifests must not shift).
+
+import "core:testing"
+
+// never_drop_catalog — test_catalog + a banking class (max_loss_pct 0 =
+// never-drop, default_lane 0 = Express). The MVP roster has no never-drop
+// class (banking is era-4 content), so E6's machinery is pinned against this
+// variant — the guard + floor are general over the roster.
+never_drop_catalog :: proc(cat: ^Catalogs, allocator := context.allocator) -> ^Catalogs {
+	test_catalog(cat, allocator)
+	append(&cat.packet_types, Packet_Type{
+		id = "banking", display = "Banking", shape = .Hexagon, icon = "bank",
+		color_rgba = {200, 170, 60, 255}, latency_tol_ms = 400, max_loss_pct = 0,
+		bandwidth_demand = 1, default_lane = LANE_EXPRESS, demand_weight = 1, era_introduced = 4,
+	})
+	return cat
+}
