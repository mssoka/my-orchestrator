+	// the E8 invariant: caps sum to EXACTLY capacity for any in-domain weights
+	weight_sets := [][3]i32{{1, 1, 1}, {4, 2, 1}, {1, 2, 4}, {7, 3, 2}, {1, 0, 0}, {0, 0, 1}, {5, 5, 0}, {1, 2, 3}, {9, 1, 1}, {3, 3, 4}}
+	for cap in u32(1)..=100 {
+		for ws in weight_sets {
+			caps := qos_allocate(cap, ws, {1, 1, 1})
+			total := u64(caps[0]) + u64(caps[1]) + u64(caps[2])
+			testing.expectf(t, total == u64(cap),
