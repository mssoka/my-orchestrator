+	// known-value pins (hand-computed largest-remainder)
+	testing.expect_value(t, qos_allocate(10, {1, 1, 1}, {1, 1, 1}), [3]u32{4, 3, 3}) // floor 3 each, remainder 1 → E
+	testing.expect_value(t, qos_allocate(10, {2, 1, 1}, {1, 1, 1}), [3]u32{5, 3, 2})
+	testing.expect_value(t, qos_allocate(100, {1, 1, 1}, {1, 1, 1}), [3]u32{34, 33, 33})
+	testing.expect_value(t, qos_allocate(2, {1, 1, 1}, {1, 1, 1}), [3]u32{1, 1, 0}) // ties break E→S→B
+	testing.expect_value(t, qos_allocate(1, {1, 1, 1}, {1, 1, 1}), [3]u32{1, 0, 0})
+	// zero weight: never receives a unit; a tie between E and B goes to E
+	testing.expect_value(t, qos_allocate(5, {1, 0, 1}, {1, 1, 1}), [3]u32{3, 0, 2})
+	testing.expect_value(t, qos_allocate(15, {4, 2, 1}, {1, 1, 1}), [3]u32{9, 4, 2})
