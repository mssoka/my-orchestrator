+	// lane override: unknown pipe / class / lane
+	_, e = topology_apply_edit(&s.topology, Command{kind = Cmd_Set_Lane{pipe = 9999, class = 0, lane = LANE_EXPRESS}}, cat)
+	testing.expect(t, e == .Missing_Pipe, "unknown pipe must reject with .Missing_Pipe")
+	_, e = topology_apply_edit(&s.topology, Command{kind = Cmd_Set_Lane{pipe = pipe, class = 99, lane = LANE_EXPRESS}}, cat)
+	testing.expect(t, e == .Unknown_Class, "class out of range must reject with .Unknown_Class")
+	_, e = topology_apply_edit(&s.topology, Command{kind = Cmd_Set_Lane{pipe = pipe, class = 0, lane = 3}}, cat)
+	testing.expect(t, e == .Invalid_Lane, "lane out of 0..2 must reject with .Invalid_Lane")
