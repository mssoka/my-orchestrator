+	pipe := s.topology.pipe_id[0]
+
+	// emphasis: unknown pipe / bad preset
+	_, e := topology_apply_edit(&s.topology, Command{kind = Cmd_Set_Emphasis{pipe = 9999, preset = 0}}, cat)
+	testing.expect(t, e == .Missing_Pipe, "unknown pipe must reject with .Missing_Pipe")
