+@(test)
+test_qos_serialization_sparse_and_roundtrip :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	// A DEFAULT run serializes ZERO QoS bytes — this is the golden-stability
+	// mechanism (pre-QoS T1 manifests cannot shift). Pinned by walking the
+	// canonical dump: the QoS sections sit between the topology's
+	// next_pipe_id and the action-log length, and are ABSENT when empty — so
+	// the u32 right after next_pipe_id must be the action-log length itself
+	// (a default run has no weights section to precede it).
+	s, _ := qos_setup(cat)
+	defer run_destroy(&s)
+	step_n(&s, 2, cat)
+	dump := state_dump(&s, s.events[:], cat, context.temp_allocator)
+	// the sparse contract: the first word after the topology is the action-log
+	// length ITSELF — zero QoS bytes precede it (absent-when-empty sections)
+	word, ok := qos_first_word_after_topology(dump)
+	testing.expectf(t, ok, "dump must parse to the QoS offset")
+	testing.expectf(t, word == u32(len(s.action_log)),
+		"default run must serialize ZERO QoS bytes (first word %d, expected the action-log length %d) — the sparse contract is broken",
+		word, len(s.action_log))
+
+	// run-to-run determinism: two identical default runs hash identically
+	s2, _ := qos_setup(cat)
+	defer run_destroy(&s2)
+	step_n(&s2, 2, cat)
+	testing.expect(t, state_hash(&s, s.events[:], cat) == state_hash(&s2, s2.events[:], cat),
+		"default runs must hash identically (sparse QoS sections)")
+
+	// an emphasis edit MUST add exactly the weights section + change the hash
+	pipe := s2.topology.pipe_id[0]
+	preset, _ := preset_index(cat, "express_heavy")
+	_, e := topology_apply_edit(&s2.topology, Command{kind = Cmd_Set_Emphasis{pipe = pipe, preset = preset}}, cat)
+	testing.expect(t, e == .None, "emphasis apply")
+	append(&s2.action_log, Command{apply_tick = s2.tick + 1, kind = Cmd_Set_Emphasis{pipe = pipe, preset = preset}})
+	step_n(&s2, 1, cat)
+	dump2 := state_dump(&s2, s2.events[:], cat, context.temp_allocator)
+	// the emphasis edit must serialize exactly ONE weights entry (the first
+	// word after the topology is the weights count, not the log length)
+	word2, ok2 := qos_first_word_after_topology(dump2)
+	testing.expectf(t, ok2, "emphasized dump must parse")
+	testing.expectf(t, word2 == 1,
+		"emphasis must serialize exactly one weights entry (first word %d, expected 1)", word2)
+	testing.expect(t, state_hash(&s2, s2.events[:], cat) != state_hash(&s, s.events[:], cat),
+		"an emphasis edit must change the T1 hash")
+
+	// binary log round-trip: the new command tags survive write → read
+	_, e = topology_apply_edit(&s2.topology, Command{kind = Cmd_Set_Lane{pipe = pipe, class = 1, lane = LANE_BEST_EFFORT}}, cat)
+	testing.expect(t, e == .None, "lane apply")
+	append(&s2.action_log, Command{apply_tick = s2.tick + 1, kind = Cmd_Set_Lane{pipe = pipe, class = 1, lane = LANE_BEST_EFFORT}})
+	log_bytes := log_write(&s2, context.temp_allocator)
+	hdr, cmds, okr := log_read(log_bytes, context.temp_allocator)
+	testing.expect(t, okr, "log with QoS commands must parse")
+	testing.expectf(t, len(cmds) == 3, "log must carry draw + emphasis + lane, got %d", len(cmds))
+	testing.expect(t, hdr.seed == s2.seed, "header seed round-trips")
+	#partial switch c in cmds[1].kind {
+	case Cmd_Set_Emphasis:
+		testing.expect(t, c.pipe == pipe && u16(c.preset) == preset, "emphasis record round-trips")
+	case:
+		testing.expect(t, false, "second record must be Cmd_Set_Emphasis")
+	}
+	#partial switch c in cmds[2].kind {
+	case Cmd_Set_Lane:
+		testing.expect(t, c.class == 1 && c.lane == LANE_BEST_EFFORT, "lane record round-trips")
+	case:
+		testing.expect(t, false, "third record must be Cmd_Set_Lane")
+	}
+}
+
+// qos_first_word_after_topology — walk a canonical state dump to the byte
+// right after the topology section (next_pipe_id) and return the u32 found
+// there. The 3.2 QoS sections sit at that offset and are ABSENT-WHEN-EMPTY,
+// so the word is EITHER the weights count (sections present) OR the
+// action-log length (no QoS bytes at all). The caller disambiguates against
+// its known action-log length — this is the sparse-contract pin's reader,
+// and it also documents the writer-only format for any future dump parser.
+qos_first_word_after_topology :: proc(dump: []u8) -> (word: u32, ok: bool) {
+	r := Reader{data = dump}
+	r_u64(&r) // seed
+	r_u64(&r) // tick
+	r_u64(&r) // rng.state
+	r_u64(&r) // rng.inc
+	r_u8(&r)  // era
+	r_u64(&r) // catalog_hash
+	r_i32(&r) // logic_hz
+	r_u32(&r) // score
+	r_u32(&r) // goal
+	r_u64(&r) // tick_cap
+	r_u8(&r)  // terminal
+	r_u8(&r)  // outcome
+	n := r_u32(&r) // flow packets (11 fields each)
+	for i in 0..<int(n) {
+		r_u64(&r); r_u16(&r); r_u32(&r); r_u32(&r); r_u8(&r)
+		r_u32(&r); r_u32(&r); r_u32(&r); r_u32(&r); r_u64(&r); r_u8(&r)
+	}
+	n = r_u32(&r) // flow demand (4 fields each)
+	for i in 0..<int(n) {
+		r_u64(&r); r_u16(&r); r_u32(&r); r_u32(&r)
+	}
+	r_u64(&r) // next_packet_id
+	n = r_u32(&r) // topology nodes (7 fields each)
+	for i in 0..<int(n) {
+		r_u8(&r); r_u32(&r); r_u8(&r); r_u8(&r); r_u16(&r); r_i32(&r); r_i32(&r)
+	}
+	r_u32(&r) // next_node_id
+	n = r_u32(&r) // topology pipes (6 fields each)
+	for i in 0..<int(n) {
+		r_u8(&r); r_u32(&r); r_u32(&r); r_u32(&r); r_u16(&r); r_i32(&r)
+	}
+	r_u32(&r) // next_pipe_id
+	word = r_u32(&r) // the QoS sections (absent-when-empty) or the log length
+	return word, !r.bad
+}
+
+@(test)
+test_qos_replay_byte_identical :: proc(t: ^testing.T) {
+	// E10: a run with emphasis + lane edits replays byte-identically from its
+	// action log alone (the sparse serialization + the logged commands agree).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	live: Run_State
+	defer run_destroy(&live)
+	run_init(&live, 7, cat.hash, TEST_LOGIC_HZ)
+	res, rt, host := test_seed_fixture(&live, cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	append(&live.action_log, Command{apply_tick = 1, kind = Cmd_Draw_Pipe{a = res, b = rt, tier = std}})
+	append(&live.action_log, Command{apply_tick = 1, kind = Cmd_Draw_Pipe{a = rt, b = host, tier = std}})
+	preset, _ := preset_index(cat, "express_heavy")
+	append(&live.action_log, Command{apply_tick = 3, kind = Cmd_Set_Emphasis{pipe = 0, preset = preset}})
+	append(&live.action_log, Command{apply_tick = 5, kind = Cmd_Set_Lane{pipe = 0, class = 1, lane = LANE_BEST_EFFORT}})
+	live_hashes := record_run(&live, 30, cat)
+	defer delete(live_hashes)
+
+	replayed: Run_State
+	defer run_destroy(&replayed)
+	run_init(&replayed, 7, cat.hash, TEST_LOGIC_HZ)
+	test_seed_fixture(&replayed, cat)
+	replayed.action_log = clone_log(live.action_log, context.allocator)
+	replayed_hashes := record_run(&replayed, 30, cat)
+	defer delete(replayed_hashes)
+
+	testing.expectf(t, len(replayed_hashes) == len(live_hashes), "hash stream lengths must match")
+	for i in 0..<len(live_hashes) {
+		testing.expectf(t, replayed_hashes[i] == live_hashes[i],
+			"FIRST DIVERGENCE at tick %d: %016x != %016x", i+1, replayed_hashes[i], live_hashes[i])
+		if replayed_hashes[i] != live_hashes[i] { break }
+	}
+}
diff --git a/core/serialize.odin b/core/serialize.odin
index 3d03aad..f0a13d1 100644
--- a/core/serialize.odin
+++ b/core/serialize.odin
@@ -48,26 +48,30 @@ w_bool :: proc(w: ^Writer, v: bool) { w_u8(w, 1 if v else 0) }
