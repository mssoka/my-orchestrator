+	nd := qos_pipe_never_drop(&s.topology, cat, s.topology.pipe_id[0])
+	testing.expectf(t, nd[LANE_EXPRESS] && !nd[LANE_STANDARD] && !nd[LANE_BEST_EFFORT],
+		"never-drop must mark only Express (banking's default lane), got %v", nd)
+}
