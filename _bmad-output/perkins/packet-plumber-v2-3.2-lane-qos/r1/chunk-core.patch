+package core
+
+// qos_test.odin — Story 3.2's durable contracts (arch §11.7): the E5/E6/E8
+// edge-case pins + the command/replay pins. Pinned at the lowest layer so they
+// survive review rounds, refactors, and Perkins:
+//   [E8] largest-remainder integer distribution, E→S→B tie order, sum == capacity;
+//   [E5] all-zero weights → the catalog default preset;
+//   [E6] never-drop lane floored (lane order, capacity truncation) + the bus
+//        rejects the zeroing edit;
+//   the new commands ride the action log + the binary log round-trip, and a
+//   run with emphasis/lane edits replays byte-identically (E10);
+//   the T1 serialization stays SPARSE for default pipes (the golden-stability
+//   mechanism — existing manifests must not shift).
+
+import "core:testing"
+
+// never_drop_catalog — test_catalog + a banking class (max_loss_pct 0 =
+// never-drop, default_lane 0 = Express). The MVP roster has no never-drop
+// class (banking is era-4 content), so E6's machinery is pinned against this
+// variant — the guard + floor are general over the roster.
+never_drop_catalog :: proc(cat: ^Catalogs, allocator := context.allocator) -> ^Catalogs {
+	test_catalog(cat, allocator)
+	append(&cat.packet_types, Packet_Type{
+		id = "banking", display = "Banking", shape = .Hexagon, icon = "bank",
+		color_rgba = {200, 170, 60, 255}, latency_tol_ms = 400, max_loss_pct = 0,
+		bandwidth_demand = 1, default_lane = LANE_EXPRESS, demand_weight = 1, era_introduced = 4,
+	})
+	return cat
+}
+
+// qos_setup — a fresh run + the 1.2 fixture + one drawn standard pipe (id 0).
+qos_setup :: proc(cat: ^Catalogs) -> (Run_State, u32) {
+	s: Run_State
+	run_init(&s, 1, cat.hash, TEST_LOGIC_HZ)
+	res, rt, _ := test_seed_fixture(&s, cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	append(&s.action_log, Command{apply_tick = 1, kind = Cmd_Draw_Pipe{a = res, b = rt, tier = std}})
+	return s, res
+}
