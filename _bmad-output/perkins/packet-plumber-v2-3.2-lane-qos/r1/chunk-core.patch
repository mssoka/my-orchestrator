+@(test)
+test_qos_pipe_caps_flow_floor_e6 :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := never_drop_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, _ := qos_setup(cat)
+	defer run_destroy(&s)
+	step_n(&s, 1, cat)
+
+	// white-box: force the pipe's weights to zero Express (the bus would
+	// reject this edit on a never-drop pipe — the flow floor is the backstop)
+	ps := u32(0)
+	s.topology.pipe_weights[ps] = {0, 1, 1}
