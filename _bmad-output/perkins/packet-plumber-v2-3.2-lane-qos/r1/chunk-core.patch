+	testing.expectf(t, caps[LANE_EXPRESS] == 1,
+		"E6: never-drop Express lane floored to 1, got %v", caps)
+	// allocation still largest-remainder over {0,1,1} for cap 15: {0,8,7}
+	testing.expectf(t, caps[LANE_STANDARD] == 8 && caps[LANE_BEST_EFFORT] == 7,
+		"E6: non-floored lanes keep the allocation, got %v", caps)
