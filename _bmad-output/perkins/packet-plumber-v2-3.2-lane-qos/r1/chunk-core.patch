+@(test)
+test_qos_bus_rejections_e6 :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := never_drop_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, _ := qos_setup(cat)
+	defer run_destroy(&s)
