+@(test)
+test_qos_allocate_largest_remainder_e8 :: proc(t: ^testing.T) {
+	// known-value pins (hand-computed largest-remainder)
+	testing.expect_value(t, qos_allocate(10, {1, 1, 1}, {1, 1, 1}), [3]u32{4, 3, 3}) // floor 3 each, remainder 1 → E
+	testing.expect_value(t, qos_allocate(10, {2, 1, 1}, {1, 1, 1}), [3]u32{5, 3, 2})
+	testing.expect_value(t, qos_allocate(100, {1, 1, 1}, {1, 1, 1}), [3]u32{34, 33, 33})
+	testing.expect_value(t, qos_allocate(2, {1, 1, 1}, {1, 1, 1}), [3]u32{1, 1, 0}) // ties break E→S→B
+	testing.expect_value(t, qos_allocate(1, {1, 1, 1}, {1, 1, 1}), [3]u32{1, 0, 0})
+	// zero weight: never receives a unit; a tie between E and B goes to E
+	testing.expect_value(t, qos_allocate(5, {1, 0, 1}, {1, 1, 1}), [3]u32{3, 0, 2})
+	testing.expect_value(t, qos_allocate(15, {4, 2, 1}, {1, 1, 1}), [3]u32{9, 4, 2})
+
+	// the E8 invariant: caps sum to EXACTLY capacity for any in-domain weights
+	weight_sets := [][3]i32{{1, 1, 1}, {4, 2, 1}, {1, 2, 4}, {7, 3, 2}, {1, 0, 0}, {0, 0, 1}, {5, 5, 0}, {1, 2, 3}, {9, 1, 1}, {3, 3, 4}}
+	for cap in u32(1)..=100 {
+		for ws in weight_sets {
+			caps := qos_allocate(cap, ws, {1, 1, 1})
+			total := u64(caps[0]) + u64(caps[1]) + u64(caps[2])
+			testing.expectf(t, total == u64(cap),
+				"allocate(%d, %v): sum %d != capacity", cap, ws, total)
+		}
+	}
+}
+
+@(test)
+test_qos_allocate_all_zero_e5 :: proc(t: ^testing.T) {
+	// E5: all-zero weights → the catalog default preset, bit-identical to
+	// passing the preset's weights directly.
+	def := [3]i32{1, 1, 1}
+	for cap in u32(1)..=64 {
+		a := qos_allocate(cap, {0, 0, 0}, def)
+		b := qos_allocate(cap, def, def)
+		testing.expectf(t, a == b, "E5: all-zero must equal default preset for cap %d", cap)
+	}
+	// …and with a non-balanced default
+	hd := [3]i32{4, 2, 1}
+	testing.expect(t, qos_allocate(15, {0, 0, 0}, hd) == qos_allocate(15, hd, hd), "E5 with express_heavy default")
+	// a degenerate all-zero default returns all-zero (total 0 — nothing to allocate)
+	testing.expect_value(t, qos_allocate(10, {0, 0, 0}, {0, 0, 0}), [3]u32{0, 0, 0})
+}
+
+@(test)
+test_qos_apply_floor_e6 :: proc(t: ^testing.T) {
+	// a never-drop lane at cap 0 is floored to a quantum of 1
+	testing.expect_value(t, qos_apply_floor({0, 3, 2}, {true, false, false}, 5), [3]u32{1, 3, 2})
+	// lanes already ≥ 1 are untouched (no-op)
+	testing.expect_value(t, qos_apply_floor({2, 2, 1}, {true, false, false}, 5), [3]u32{2, 2, 1})
+	// floors satisfy in lane order E→S→B…
+	testing.expect_value(t, qos_apply_floor({0, 0, 4}, {true, true, false}, 5), [3]u32{1, 1, 4})
+	// …and capacity exhaustion truncates later floors (tiny pipes, defined)
+	testing.expect_value(t, qos_apply_floor({0, 0, 1}, {true, true, false}, 1), [3]u32{1, 0, 1})
+	// a zero-capacity pipe floors nothing (nothing to give)
+	testing.expect_value(t, qos_apply_floor({0, 0, 0}, {true, true, true}, 0), [3]u32{0, 0, 0})
+}
