+	_, e = topology_apply_edit(&s.topology, Command{kind = Cmd_Set_Lane{pipe = pipe, class = 2, lane = LANE_EXPRESS}}, cat)
+	testing.expect(t, e == .Invalid_Weights, "never-drop class on a zeroed lane must reject (E6)")
+}
