+	testing.expect(t, e == .Invalid_Preset, "preset out of range must reject with .Invalid_Preset")
+
+	// E6: a preset that zeros Express (banking's never-drop lane) is rejected
+	// — build it by injecting a zeroing preset row
+	append(&cat.balance.lane_presets, Lane_Preset{id = "no_express", display = "No Express", weights = {0, 1, 1}})
+	_, e = topology_apply_edit(&s.topology, Command{kind = Cmd_Set_Emphasis{pipe = pipe, preset = u16(len(cat.balance.lane_presets) - 1)}}, cat)
+	testing.expect(t, e == .Invalid_Weights, "zeroing a never-drop lane must reject with .Invalid_Weights (E6)")
+	// and the pipe is untouched (validate-before-apply)
+	testing.expect_value(t, s.topology.pipe_weights[0], [3]i32{1, 1, 1})
