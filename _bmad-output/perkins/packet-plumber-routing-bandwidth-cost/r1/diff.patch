--- /dev/null
+++ b/core/routing_cost_test.odin
@@ -0,0 +1,204 @@
+package core
+
+// routing_cost_test.odin — the 2026-08-13 capacity-cost routing ruling as
+// durable tests (architecture §6.2, the canon amendment). Pins:
+//   (a) the headline: a MIXED-TIER diamond picks the FAT path as a UNIQUE
+//       next hop — no ECMP when end-to-end costs differ (wide 5+5 = 10 beats
+//       narrow 20+20 = 40);
+//   (b) a TRUE different-tier tie: standard(10)+wide(5) == wide(5)+standard(10)
+//       = 15 both ways -> the ECMP set is 2 (equal END-TO-END cost, not equal
+//       tier — the "3+8 vs 8+3" case);
+//   (c) re-step determinism over a mixed-tier flow: record_run live vs replay
+//       -> byte-identical per-tick hashes (the dist values ride the T1 hash
+//       through the packet positions);
+//   (d) ODN-5 wiring: the cost ladder is READ FROM THE CATALOG — mutating
+//       cat.pipe_tiers[].cost changes the routing outcome (a data change
+//       moves behavior).
+//
+// Geometry: a COMPACT diamond (res at (8,15), mids at (16,11)/(16,19), host at
+// (24,15); every span 9 <= narrow max 10) so the narrow legs draw legally —
+// the 2.2 diamond's 13-spans exceed narrow's hard cap. All four legs are
+// router-to-terminal (E26 legal).
+
+import "core:testing"
+
+// cost_diamond_setup — fresh run seeded with a compact diamond
+// (res(8,15), m1(16,11), m2(16,19), host(24,15)). Returns ids.
+cost_diamond_setup :: proc(cat: ^Catalogs) -> (Run_State, u32, u32, u32, u32) {
+	s: Run_State
+	run_init(&s, 1, cat.hash, TEST_LOGIC_HZ)
+	res_idx, _ := node_type_index(cat, "residential")
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	host_idx, _ := node_type_index(cat, "content_host")
+	res := topology_spawn_node(&s.topology, res_idx, {8, 15}, cat)
+	m1 := topology_spawn_node(&s.topology, rt_idx, {16, 11}, cat)
+	m2 := topology_spawn_node(&s.topology, rt_idx, {16, 19}, cat)
+	host := topology_spawn_node(&s.topology, host_idx, {24, 15}, cat)
+	return s, res, m1, m2, host
+}
+
+// cost_draw_diamond — log the four diamond draw-commands at apply_tick, one
+// tier per leg: a_top/bottom to mid1 = tier_a, to mid2 = tier_b, and the two
+// host legs mirror them (m1-host = tier_a, m2-host = tier_b).
+cost_draw_diamond :: proc(s: ^Run_State, apply_tick: u64, res, m1, m2, host: u32, tier_a, tier_b: u16) {
+	draw(s, apply_tick, res, m1, tier_a)
+	draw(s, apply_tick, res, m2, tier_b)
+	draw(s, apply_tick, m1, host, tier_a)
+	draw(s, apply_tick, m2, host, tier_b)
+}
+
+@(test)
+test_cost_mixed_tier_diamond_fat_path_unique :: proc(t: ^testing.T) {
+	// THE headline AC: with costs 20/10/5, the wide path (5+5 = 10) is strictly
+	// cheaper than the narrow path (20+20 = 40), so `res` toward `host` has ONE
+	// equal-cost next hop (m1) — the fat path wins, NO ECMP when costs differ.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	wide, _ := pipe_tier_index(cat, "wide")
+	narrow, _ := pipe_tier_index(cat, "narrow")
+	s, res, m1, m2, host := cost_diamond_setup(cat)
+	defer run_destroy(&s)
+	cost_draw_diamond(&s, 1, res, m1, m2, host, wide, narrow)
+	step_n(&s, 1, cat) // apply the draws + rebuild the table (rule 1)
+
+	// (res, host): UNIQUE next hop m1 (the fat path) — count == 1.
+	off, count, ok := routing_equal_cost_hops(&s.routing, &s.topology, res, host)
+	testing.expectf(t, ok, "(res,host) must resolve")
+	testing.expectf(t, count == 1, "fat path must be the UNIQUE next hop (count 1), got %d", count)
+	testing.expectf(t, s.routing.hops[int(off)].node == m1,
+		"the unique next hop is the fat path's m1, got %d", s.routing.hops[int(off)].node)
+
+	// reverse direction (host -> res) is symmetric: unique next hop m1.
+	_, count_rev, okrev := routing_equal_cost_hops(&s.routing, &s.topology, host, res)
+	testing.expectf(t, okrev && count_rev == 1, "(host,res) unique too, got ok=%v count=%d", okrev, count_rev)
+	nh, _, oknh := routing_next_hop(&s.routing, &s.topology, host, res)
+	testing.expectf(t, oknh && nh == m1, "host's next hop toward res is m1, got ok=%v nh=%d", oknh, nh)
+
+	// the skinny path is still REACHABLE (m2 is on a valid but more expensive
+	// route) — fat preference, not removal: m2 toward host stays count == 1.
+	_, count_m2, okm2 := routing_equal_cost_hops(&s.routing, &s.topology, m2, host)
+	testing.expectf(t, okm2 && count_m2 == 1, "(m2,host) still routable (count 1), got ok=%v count=%d", okm2, count_m2)
+}
+
+@(test)
+test_cost_different_tier_equal_sum_tie_ecmp_two :: proc(t: ^testing.T) {
+	// A TRUE different-tier tie: res->m1 standard(10) + m1->host wide(5) = 15
+	// vs res->m2 wide(5) + m2->host standard(10) = 15 — equal END-TO-END cost
+	// across DIFFERENT tiers. The ECMP set must be 2 (the "3+8 vs 8+3" case:
+	// equal cost is a sum property, never a per-tier equality).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	wide, _ := pipe_tier_index(cat, "wide")
+	s, res, m1, m2, host := cost_diamond_setup(cat)
+	defer run_destroy(&s)
+	// per-side mixed tiers: a-side = std(10) then wide(5); b-side = wide(5) then std(10)
+	draw(&s, 1, res, m1, std)
+	draw(&s, 1, res, m2, wide)
+	draw(&s, 1, m1, host, wide)
+	draw(&s, 1, m2, host, std)
+	step_n(&s, 1, cat)
+
+	off, count, ok := routing_equal_cost_hops(&s.routing, &s.topology, res, host)
+	testing.expectf(t, ok, "(res,host) must resolve")
+	testing.expectf(t, count == 2, "different-tier equal-sum tie must ECMP (count 2), got %d", count)
+	testing.expectf(t, s.routing.hops[int(off)].node == m1 && s.routing.hops[int(off + 1)].node == m2,
+		"tie hops are {{m1, m2}} (insertion order), got {{%d, %d}}",
+		s.routing.hops[int(off)].node, s.routing.hops[int(off + 1)].node)
+}
+
+@(test)
+test_cost_replay_byte_identical :: proc(t: ^testing.T) {
+	// The determinism keystone over the COST model: re-step (seed, log, demand)
+	// twice -> byte-identical per-tick hash sequence. The mixed-tier diamond
+	// makes the Dijkstra non-vacuous (dist values differ from hop counts, so a
+	// nondeterministic relaxation would diverge here).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	wide, _ := pipe_tier_index(cat, "wide")
+
+	live: Run_State
+	defer run_destroy(&live)
+	run_init(&live, 7, cat.hash, TEST_LOGIC_HZ)
+	res_idx, _ := node_type_index(cat, "residential")
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	host_idx, _ := node_type_index(cat, "content_host")
+	res := topology_spawn_node(&live.topology, res_idx, {8, 15}, cat)
+	m1 := topology_spawn_node(&live.topology, rt_idx, {16, 11}, cat)
+	m2 := topology_spawn_node(&live.topology, rt_idx, {16, 19}, cat)
+	host := topology_spawn_node(&live.topology, host_idx, {24, 15}, cat)
+	cost_draw_diamond(&live, 1, res, m1, m2, host, std, wide) // the 15/15 tie diamond
+	for i in 0..<12 {
+		flow_seed_demand(&live.flow, 1, res, host)
+	}
+	live_hashes := record_run(&live, 30, cat)
+	defer delete(live_hashes)
+
+	// replay: fresh run, same seed, SAME action log + SAME demand shape
+	replayed: Run_State
+	defer run_destroy(&replayed)
+	run_init(&replayed, 7, cat.hash, TEST_LOGIC_HZ)
+	topology_spawn_node(&replayed.topology, res_idx, {8, 15}, cat)
+	topology_spawn_node(&replayed.topology, rt_idx, {16, 11}, cat)
+	topology_spawn_node(&replayed.topology, rt_idx, {16, 19}, cat)
+	topology_spawn_node(&replayed.topology, host_idx, {24, 15}, cat)
+	delete(replayed.action_log)
+	replayed.action_log = clone_log(live.action_log)
+	for i in 0..<12 {
+		flow_seed_demand(&replayed.flow, 1, res, host)
+	}
+	replay_hashes := record_run(&replayed, 30, cat)
+	defer delete(replay_hashes)
+	testing.expectf(t, !live.replay_error && !replayed.replay_error, "no replay_error latched")
+	testing.expectf(t, len(live_hashes) == len(replay_hashes), "tick count mismatch")
+	diverged := false
+	for i in 0..<len(live_hashes) {
+		if live_hashes[i] != replay_hashes[i] {
+			diverged = true
+		}
+	}
+	testing.expectf(t, !diverged, "REPLAY DIVERGENCE over the cost model (mixed-tier diamond)")
+}
+
+@(test)
+test_cost_ladder_read_from_data :: proc(t: ^testing.T) {
+	// ODN-5 wiring proof: routing reads the ladder from the CATALOG, not a
+	// hardcoded table. With the stock ladder (wide 5) the fat path (m1) wins
+	// uniquely; after mutating the catalog (wide becomes 100, narrow becomes 1)
+	// the SAME topology routes to the skinny path (m2) uniquely. A data change
+	// moves behavior — the routing cost is data-driven (user ruling 2026-08-13).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	wide, _ := pipe_tier_index(cat, "wide")
+	narrow, _ := pipe_tier_index(cat, "narrow")
+
+	// baseline: stock ladder -> m1 (wide, cost 5) wins
+	s, res, m1, m2, host := cost_diamond_setup(cat)
+	defer run_destroy(&s)
+	cost_draw_diamond(&s, 1, res, m1, m2, host, wide, narrow)
+	step_n(&s, 1, cat)
+	off, count, ok := routing_equal_cost_hops(&s.routing, &s.topology, res, host)
+	testing.expectf(t, ok && count == 1, "stock ladder: unique hop, got ok=%v count=%d", ok, count)
+	testing.expectf(t, s.routing.hops[int(off)].node == m1, "stock ladder: m1 (wide) wins")
+
+	// MUTATE the ladder in the catalog (the ODN-5 single source) — no topology
+	// change, no code change. wide now costs 100, narrow costs 1.
+	cat.pipe_tiers[int(wide)].cost = 100
+	cat.pipe_tiers[int(narrow)].cost = 1
+
+	// rebuild from the SAME topology + the mutated catalog
+	s2, res2, m12, m22, host2 := cost_diamond_setup(cat)
+	defer run_destroy(&s2)
+	cost_draw_diamond(&s2, 1, res2, m12, m22, host2, wide, narrow)
+	step_n(&s2, 1, cat)
+	off2, count2, ok2 := routing_equal_cost_hops(&s2.routing, &s2.topology, res2, host2)
+	testing.expectf(t, ok2 && count2 == 1, "mutated ladder: unique hop, got ok=%v count=%d", ok2, count2)
+	testing.expectf(t, s2.routing.hops[int(off2)].node == m22,
+		"mutated ladder: the narrow path (cost 1) must win now — got %d want m2=%d",
+		s2.routing.hops[int(off2)].node, m22)
+}
