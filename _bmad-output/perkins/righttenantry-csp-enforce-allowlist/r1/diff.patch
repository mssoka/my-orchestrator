diff --git a/server/test/csp_test.gleam b/server/test/csp_test.gleam
index a3b2d3b9..95f0ab7a 100644
--- a/server/test/csp_test.gleam
+++ b/server/test/csp_test.gleam
@@ -1,6 +1,7 @@
 //// Tests for the CSP nonce + policy assembly (server/src/csp.gleam).
 
 import csp
+import gleam/list
 import gleam/string
 import gleeunit/should
 
@@ -80,3 +81,57 @@ pub fn policy_allows_ad_analytics_beacons_test() {
   |> string.contains("script-src 'self' https://connect.facebook.net")
   |> should.be_true
 }
+
+pub fn policy_allows_enforcement_additions_test() {
+  // Enforcement-prep allowlist (Sentry RT-PROD-6/E, RT-PROD-7/G, RT-PROD-F,
+  // RT-PROD-A): each domain must land in exactly its directive, exactly once,
+  // in both the nonce and empty-nonce branches — a duplicated or misplaced
+  // source would mean a directive the allowlist intended to widen stays
+  // narrow and enforcement breaks tracking on live ad spend. Each tuple binds
+  // its domain to the FULL directive line so a token migrated to another
+  // directive fails the contains check.
+  let additions = [
+    #(
+      "connect-src 'self' https://www.google.com https://mpc2-prod-23-is5qnl632q-ue.a.run.app",
+      "mpc2-prod-23-is5qnl632q-ue.a.run.app",
+    ),
+    #(
+      "img-src 'self' data: https://www.google.com https://www.facebook.com https://www.google.ie https://www.google.com.gh",
+      "www.google.ie",
+    ),
+    #(
+      "img-src 'self' data: https://www.google.com https://www.facebook.com https://www.google.ie https://www.google.com.gh",
+      "www.google.com.gh",
+    ),
+    #(
+      "style-src 'self' 'unsafe-inline' https://www.gstatic.com",
+      "www.gstatic.com",
+    ),
+    #(
+      "frame-src 'self' https://www.facebook.com https://toolytics.pa.clients6.google.com",
+      "toolytics.pa.clients6.google.com",
+    ),
+  ]
+
+  let policy = csp.policy("ABC123")
+  let bare_policy = csp.policy("")
+
+  [policy, bare_policy]
+  |> list.each(fn(p) {
+    list.each(additions, fn(pair) {
+      let #(directive, domain) = pair
+      p |> string.contains(directive) |> should.be_true
+      // Exactly once — a duplicated source token would signal a botched merge
+      // (split on the domain: 2 parts ⇔ exactly one occurrence).
+      p |> string.split(domain) |> list.length |> should.equal(2)
+    })
+
+    // Well-formedness: directives `; `-joined, no trailing semicolon, no empty
+    // directive (a `;;` would make the policy inert for that segment), and no
+    // wildcard/eval sources — this PR widens, it must never open.
+    p |> string.ends_with(";") |> should.be_false
+    p |> string.contains(";;") |> should.be_false
+    p |> string.contains("'unsafe-eval'") |> should.be_false
+    p |> string.contains("*") |> should.be_false
+  })
+}
