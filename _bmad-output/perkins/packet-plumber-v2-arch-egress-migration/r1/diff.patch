+	s, res, rt, _ := egress_setup(cat)
+	defer run_destroy(&s)
+
+	// [R2/AD-5] a port's caps = the member-summed bundle caps, IDENTICAL for
+	// both directions (per-pipe weights; full-duplex members). The fixture's
+	// single standard member gives Standard 100, the others 0 (unconfigured
+	// 100% Standard — E5/08-19 ruling), summed identically per direction.
+	for bi in u32(0)..<s.bundles.n {
