+package core
+
+// egress_test.odin — v2-arch-egress S1 pins (the ratified spine 2026-08-26,
+// AD-2): the egress-port identity — (router, egress-port, lane) where
+// egress-port = the directional bundle — over the DERIVED packet membership
+// encoding. Pinned here at the lowest layer so they survive review rounds,
+// refactors, and Perkins:
+//
+//   [AD-2 canonical] the retained departure node (at_node) resolves the
+//   port's direction AND its router; the heading-based derivation coincides
+//   by construction — pinned for every on-edge packet in the fixture.
+//   [AD-2 derived] the directional read twins (port_lane_count /
+//   newest_in_port_lane / port_lane_ready) count ONLY their direction's
+//   packets — a bidirectional fixture splits cleanly.
+//   [S1 invisibility] the undirected bundle_* view equals Σ over directions
+//   for every lane — the legacy reads every mechanic still uses stay exactly
+//   today's numbers (T1 byte-identity until S2/S4).
+//   [port_lane_caps] a port's caps = the member-summed caps, identical for
+//   both directions (R2/AD-5: per-pipe weights, full-duplex members).
+//
+// The mutation leg (S1: port derivation bypass): deleting the direction
+// filter in port_lane_count (or neutering port_dir_of_packet's at_node
+// derivation) makes the directional-count + split pins below FAIL — the
+// pins bite at the derivation, not the walk (verified RED-then-GREEN at
+// authoring; re-prove by reverting the filter).
+
+import "core:strings"
+import "core:testing"
+
+// egress_setup — the fixture for the port pins: the 1.2 fixture nodes
+// (res@{8,15}=0, rt@{20,15}=1, host@{32,15}=2) with BOTH fixture pipes drawn
+// (res—rt and rt—host), stepped once so the routing + bundle views are
+// rebuilt (rule 1). Bundle 0 = pair (res=0, rt=1) lo=0 hi=1; bundle 1 = pair
+// (rt=1, host=2) lo=1 hi=2.
+egress_setup :: proc(cat: ^Catalogs) -> (Run_State, u32, u32, u32) {
+	s: Run_State
+	run_init(&s, 1, cat.hash, TEST_LOGIC_HZ)
+	res, rt, host := test_seed_fixture(&s, cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	draw(&s, 1, res, rt, std)
+	draw(&s, 1, rt, host, std)
+	step_n(&s, 1, cat)
+	return s, res, rt, host
+}
+
+// on_edge_packet — append a synthetic on-edge packet riding `pipe_id` from
+// `from_node` toward `to_node` (the derived encoding exactly as flow_step's
+// forward pass writes it: at_node = the retained departure node).
+on_edge_packet :: proc(s: ^Run_State, class: u16, pipe_id, from_node, to_node: u32, id: u64) {
+	s.flow.next_packet_id += 1
+	append(&s.flow.packets, Packet{
+		id = id,
+		class = class,
+		src = from_node,
+		dst = to_node,
+		on_edge = true,
+		at_node = from_node,
+		edge = pipe_id,
+		heading = to_node,
+		spawn_tick = 0,
+	})
+}
+
+@(test)
+test_port_dir_canonical_and_coincidence :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, host := egress_setup(cat)
+	defer run_destroy(&s)
+
+	// both directions on bundle 0 (res—rt): res→rt departs lo (dir 0),
+	// rt→res departs hi (dir 1); plus rt→host on bundle 1 (lo=rt → dir 0)
+	on_edge_packet(&s, 0, 0, res, rt, 101) // bundle 0 dir 0 (res is lo)
+	on_edge_packet(&s, 0, 0, rt, res, 102) // bundle 0 dir 1 (rt is hi)
+	on_edge_packet(&s, 0, 1, rt, host, 103) // bundle 1 dir 0 (rt is lo of pair 1..2)
+
+	// [AD-2 canonical] the at_node derivation names the direction, and the
+	// heading derivation COINCIDES by construction for every on-edge packet
+	// (the render's other-endpoint rule — pinned here so the coincidence can
+	// never silently break).
+	for i in 0..<len(s.flow.packets) {
+		p := &s.flow.packets[i]
+		if p.delivered || !p.on_edge { continue }
+		b, ok := bundle_of_pipe(&s, p.edge)
+		testing.expectf(t, ok, "packet %d: live pipe must resolve a bundle", p.id)
+		dir := port_dir_of_packet(&s, p)
+		// heading-derived: heading == the pair's hi endpoint iff dir 0
+		heading_dir := PORT_DIR_HI_TO_LO
+		if p.heading == s.bundles.bundle_hi[b] && p.heading != s.bundles.bundle_lo[b] {
+			heading_dir = PORT_DIR_LO_TO_HI
+		}
+		if p.heading == s.bundles.bundle_lo[b] && p.heading != s.bundles.bundle_hi[b] {
+			heading_dir = PORT_DIR_HI_TO_LO
+		}
+		testing.expectf(t, dir == heading_dir,
+			"packet %d: at_node dir %d != heading dir %d (the canonical/coincidence pin)",
+			p.id, dir, heading_dir)
+		// the port's router IS the retained departure node (canonical)
+		testing.expectf(t, egress_router_of_port(&s, b, dir) == p.at_node,
+			"packet %d: router-of-port %d != at_node %d", p.id, egress_router_of_port(&s, b, dir), p.at_node)
+	}
+
+	// spot pins on the fixture ids: bundle 0 pair (0,1) — res(0)→rt(1) is dir 0
+	testing.expect_value(t, port_dir_of_packet(&s, &s.flow.packets[0]), PORT_DIR_LO_TO_HI)
+	testing.expect_value(t, port_dir_of_packet(&s, &s.flow.packets[1]), PORT_DIR_HI_TO_LO)
+	testing.expect_value(t, egress_router_of_port(&s, 0, PORT_DIR_LO_TO_HI), res)
+	testing.expect_value(t, egress_router_of_port(&s, 0, PORT_DIR_HI_TO_LO), rt)
+}
+
+@(test)
+test_port_lane_count_directional_split :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, _ := egress_setup(cat)
+	defer run_destroy(&s)
+
+	// three Standard-lane riders on bundle 0: two res→rt (dir 0), one rt→res
+	// (dir 1) — email defaults to Standard, no overrides on the fixture
+	on_edge_packet(&s, 0, 0, res, rt, 201)
+	on_edge_packet(&s, 0, 0, res, rt, 202)
+	on_edge_packet(&s, 0, 0, rt, res, 203)
+
+	b, ok := bundle_of_pipe(&s, 0)
+	testing.expectf(t, ok, "pipe 0 must resolve bundle 0")
+	testing.expect_value(t, port_lane_count(&s, cat, b, PORT_DIR_LO_TO_HI, LANE_STANDARD), u32(2))
+	testing.expect_value(t, port_lane_count(&s, cat, b, PORT_DIR_HI_TO_LO, LANE_STANDARD), u32(1))
+	// the other lanes are empty in both directions
+	testing.expect_value(t, port_lane_count(&s, cat, b, PORT_DIR_LO_TO_HI, LANE_EXPRESS), u32(0))
+	testing.expect_value(t, port_lane_count(&s, cat, b, PORT_DIR_HI_TO_LO, LANE_BEST_EFFORT), u32(0))
+
+	// newest_in_port_lane: the LAST array-order rider of the direction
+	testing.expectf(t, newest_in_port_lane(&s, cat, b, PORT_DIR_LO_TO_HI, LANE_STANDARD) == 1,
+		"newest dir-0 Standard must be index 1 (packet 202)")
+	testing.expectf(t, newest_in_port_lane(&s, cat, b, PORT_DIR_HI_TO_LO, LANE_STANDARD) == 2,
+		"newest dir-1 Standard must be index 2 (packet 203)")
+	// the exclude contract: a pending shed hides from the directional count
+	// exactly as it does from the undirected one
+	excluded := []int{1}
+	testing.expect_value(t, port_lane_count(&s, cat, b, PORT_DIR_LO_TO_HI, LANE_STANDARD, excluded), u32(1))
+	testing.expectf(t, newest_in_port_lane(&s, cat, b, PORT_DIR_LO_TO_HI, LANE_STANDARD, excluded) == 0,
+		"with index 1 excluded, the newest dir-0 Standard is index 0")
+
+	// port_lane_ready: Standard ready in BOTH directions independently
+	r0 := port_lane_ready(&s, cat, b, PORT_DIR_LO_TO_HI)
+	r1 := port_lane_ready(&s, cat, b, PORT_DIR_HI_TO_LO)
+	testing.expectf(t, r0[LANE_STANDARD] && !r0[LANE_EXPRESS] && !r0[LANE_BEST_EFFORT],
+		"dir-0 readiness must be Standard only")
+	testing.expectf(t, r1[LANE_STANDARD] && !r1[LANE_EXPRESS] && !r1[LANE_BEST_EFFORT],
+		"dir-1 readiness must be Standard only")
+}
+
+@(test)
+test_undirected_view_equals_sum_of_ports :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, host := egress_setup(cat)
+	defer run_destroy(&s)
+
+	// mixed bidirectional load on BOTH bundles: email (Standard) + a
+	// streaming rider (also Standard default) across directions
+	on_edge_packet(&s, 0, 0, res, rt, 301)
+	on_edge_packet(&s, 0, 0, rt, res, 302)
+	on_edge_packet(&s, 0, 1, rt, host, 303) // email rt→host on bundle 1 dir 0 (rt=1 is lo of pair 1..2)
+	on_edge_packet(&s, 1, 1, host, rt, 304) // streaming host→rt on bundle 1 dir 1 (host=2 is hi) — Standard default too
+	on_edge_packet(&s, 0, 1, rt, host, 305) // a second email rt→host rider
+
+	// [S1 invisibility] for every bundle and lane, the undirected view every
+	// mechanic still reads == Σ over the two port queues — the re-key cannot
+	// move a number until a story consumes the directional twins
+	for bi in u32(0)..<s.bundles.n {
+		for lane in u8(0)..<LANE_COUNT {
+			undirected := bundle_lane_count(&s, cat, bi, lane)
+			sum := port_lane_count(&s, cat, bi, PORT_DIR_LO_TO_HI, lane) +
+				port_lane_count(&s, cat, bi, PORT_DIR_HI_TO_LO, lane)
+			testing.expectf(t, undirected == sum,
+				"bundle %d lane %d: undirected %d != Σ ports %d (the S1 invisibility pin)",
+				bi, lane, undirected, sum)
+		}
+	}
+	// the fixture totals: bundle 0 has 2 riders (1/direction), bundle 1 has 3
+	testing.expect_value(t, bundle_lane_count(&s, cat, 0, LANE_STANDARD), u32(2))
+	testing.expect_value(t, bundle_lane_count(&s, cat, 1, LANE_STANDARD), u32(3))
+}
+
+@(test)
+test_port_lane_caps_full_duplex_members :: proc(t: ^testing.T) {
