+@(test)
+test_crisis_cooldown_keyed_by_direction :: proc(t: ^testing.T) {
+	// F1 (the spine's rubric fix): the cooldown re-fire key carries the
+	// direction bit — an A→B resolution must NOT suppress a distinct B→A
+	// re-fire inside the window (the pair alone would).
