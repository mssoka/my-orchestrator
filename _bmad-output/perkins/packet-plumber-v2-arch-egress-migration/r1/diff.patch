+// --- v2-arch-egress S2: full duplex (AD-5, ruling R1) -------------------------
+
+@(test)
+test_full_duplex_direction_independence :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, _ := egress_setup(cat)
+	defer run_destroy(&s)
+
+	// 12 Standard riders on bundle 0 (the res—rt standard pipe, cap 100):
+	// 6 forward (res→rt, dir 0) + 6 reverse (rt→res, dir 1). FULL DUPLEX
+	// (AD-5): each direction drains its own 6×800 = 4800 units at its OWN
+	// 100/tick budget — both directions delivered by tick ~48. Under the
+	// pooled 2.1 doctrine (one shared 100/tick budget for the PAIR) the 12
+	// packets need 9600/100 = 96 ticks — the cross-direction contention the
+	// ruling retires (the mutation leg: hoisting `remaining` out of the
+	// direction loop collapses the split and this pin goes RED).
+	for k in 0..<6 {
+		on_edge_packet(&s, 0, 0, res, rt, u64(400 + k))
+	}
+	for k in 0..<6 {
+		on_edge_packet(&s, 0, 0, rt, res, u64(500 + k))
+	}
+	step_n(&s, 50, cat)
+
+	arrived := count_arrived(&s)
+	testing.expectf(t, arrived == 12,
+		"full duplex: both directions must drain their own budgets by tick 50 (got %d/12 arrived — the shared-budget collapse)", arrived)
+
+	// per-direction windows: each direction served its own ~4800 units (the
+	// window covers (tick-W, tick] with W=240 — everything). Exact: every
+	// rider delivered, so Σ served per direction == 4800 exactly.
+	b, ok := bundle_of_pipe(&s, 0)
+	testing.expectf(t, ok, "pipe 0 resolves bundle 0")
+	testing.expect_value(t, bundle_tx_window(&s.bundles, s.tick, b, PORT_DIR_LO_TO_HI), u64(4800))
+	testing.expect_value(t, bundle_tx_window(&s.bundles, s.tick, b, PORT_DIR_HI_TO_LO), u64(4800))
+}
