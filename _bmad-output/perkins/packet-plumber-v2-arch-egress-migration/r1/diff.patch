+// b2_of — bundle 0 of the second fixture (avoid capture confusion).
+b2_of :: proc(s: ^Run_State) -> u32 {
+	b, ok := bundle_of_pipe(s, 0)
+	if !ok { return 0 }
+	return b
+}
