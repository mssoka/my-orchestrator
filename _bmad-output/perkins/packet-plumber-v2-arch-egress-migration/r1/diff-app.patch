diff --git a/tools/lint.sh b/tools/lint.sh
index 09e0c4d..048d91a 100755
--- a/tools/lint.sh
+++ b/tools/lint.sh
@@ -100,5 +100,16 @@ if ! python3 tools/test_sprite_foldin.py; then
 	FAIL=1
 fi
 
+echo "-- gate 8: no link-queue vocabulary on render paths (spine F5, AD-1)"
+# v2-arch-egress (the ratified spine's Enforcement row, rubric F5): links are
+# dumb bit-pipes — they paint UTILIZATION, never queue state (AD-1: "No unit
+# may derive a 'link queue' concept for any purpose"). Queue/buffering state
+# lives at ROUTER PORTS (AD-2/AD-7: router_buffering, port rows). The gate
+# fails on link_queue-family identifiers or link-scoped queue-state fields in
+# the render/link-vocab surfaces (the LB-gate precedent — a vocabulary drift
+# the render heists could silently introduce).
+HITS=$(grep -rnE 'link_(queue|depth|backlog|buffer|load|congest)' app/ --include='*.odin' || true)
+if [ -n "$HITS" ]; then echo "$HITS"; echo "FAIL: link-queue vocabulary on a render path (spine F5/AD-1)"; FAIL=1; fi
+
 if [ "$FAIL" -ne 0 ]; then exit 1; fi
 echo "lint: all gates green"
