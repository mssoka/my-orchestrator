diff --git a/app/qos_panel_test.odin b/app/qos_panel_test.odin
index 22e0097..884f0f8 100644
--- a/app/qos_panel_test.odin
+++ b/app/qos_panel_test.odin
@@ -34,3 +34,45 @@ qos_nudge_geometry_never_overlaps :: proc(t: ^testing.T) {
 		}
 	}
 }
+
+// qos_queue_depth_rows_fit_the_plate — Perkins r1 B1: the queue-depth block
+// is THREE stacked lines (label + fwd + rev); every line's columns must clear
+// the 300px plate's right edge at EVERY scale step, the lines must not
+// overlap, and the panel height must cover the whole block. The old inline
+// two-direction row ended ~470px — 130-160px past the plate (unclipped).
+@(test)
+qos_queue_depth_rows_fit_the_plate :: proc(t: ^testing.T) {
+	steps := UI_SCALE_STEPS // local copy (Odin: a constant cannot be variably indexed)
+	for si in 0 ..< len(steps) {
+		scale := steps[si]
+		v: rnd.View
+		v.ui_scale = scale
+		v.win_w = 1280
+		v.win_h = 720
+		n_types := 2 // the fixture roster (email + streaming)
+		editing_flags := [2]bool{false, true} // Odin: no for-in over array LITERALS (the memlog trap)
+		for editing in editing_flags {
+			// (1) every direction line's lane columns clear the plate's
+			// right inner edge (the widest cell text "B10"-class ≈ 24px of
+			// advance at 14px — the depth bound is single-digit today, the
+			// margin covers two).
+			for lane in i32(0) ..< 3 {
+				x := qos_qd_lane_x(&v, lane)
+				testing.expect(t, x + rnd.hud(&v, 24) <= rnd.hud(&v, QOS_PANEL_X + QOS_PANEL_W - 6),
+					"queue-depth lane column must clear the plate's right edge")
+			}
+			// (2) the three lines stack without overlap (18px pitch, 14px text)
+			qd_y := qos_row_y(&v, qos_qd_row(n_types, editing))
+			for line in i32(0) ..< 2 {
+				testing.expect(t, qos_qd_line_y(&v, qd_y, line) + rnd.hud(&v, 14) <= qos_qd_line_y(&v, qd_y, line + 1),
+					"queue-depth lines must not overlap")
+			}
+			// (3) the panel's height covers the block's last line (+ its text)
+			bottom := rnd.hud(&v, QOS_PANEL_Y + 8 + qos_panel_rows(n_types, editing) * QOS_ROW_H)
+			last := qos_qd_line_y(&v, qd_y, 2) + rnd.hud(&v, 14)
+			testing.expect(t, last <= bottom, "the panel plate must cover the rev line")
+			// (4) the row-count math: the block is 3 lines, the editor +2 rows
+			testing.expect_value(t, qos_panel_rows(n_types, editing), i32(1 + 3 + n_types + 3 + 1 + (2 if editing else 0)))
+		}
+	}
+}
