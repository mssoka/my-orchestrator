+// --- v2-arch-egress S4: the drop/crisis re-key (AD-4/R4/AV-2/F1) --------------
+
+@(test)
+test_e9_bound_is_per_port :: proc(t: ^testing.T) {
+	// R4: the E9 lane bound is per (port, lane) — a direction's queue fills to
+	// its OWN bound 6 regardless of the reverse direction's load. The pair may
+	// hold 12 queued (the F4 balance note: 6 -> 12 per lane per pair) with
+	// NEITHER port shedding the other's arrivals. The pooled-bound mutation
+	// (counting both directions) fails both halves.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, _ := egress_setup(cat)
+	defer run_destroy(&s)
+	b, ok := bundle_of_pipe(&s, 0)
+	testing.expectf(t, ok, "pipe 0 resolves bundle 0")
+
+	// dir 0 (res→rt) pinned AT the bound: 6 queued
+	for k in 0..<6 {
+		on_edge_packet(&s, 0, 0, res, rt, u64(800 + k))
+	}
+	// dir 1 (rt→res) at 5 — one under its own bound; the PAIR total is 11
+	// (far past the old pooled bound of 6)
+	for k in 0..<5 {
+		on_edge_packet(&s, 0, 0, rt, res, u64(900 + k))
+	}
+
+	// (i) an at-node packet at rt with dst res forwards into (b, dir 1,
+	// Standard): 5 < 6 -> ADMITS (no drop). Pooled counting (11 >= 6) would
+	// shed it — the R4 divergence.
+	before := len(s.events)
+	s.flow.next_packet_id += 1
+	append(&s.flow.packets, Packet{id = 950, class = 0, src = rt, dst = res, on_edge = false, at_node = rt, spawn_tick = s.tick})
+	step_n(&s, 1, cat)
+	dropped := false
+	for e in s.events[before:] {
+		if e.tag == EVENT_TAG_PACKET_DROPPED && e.reason == u8(Drop_Reason.Queue_Overflow) {
+			dropped = true
+			// AV-2: an E9 drop event carries the shed port's direction
+			testing.expectf(t, e.direction == PORT_DIR_HI_TO_LO, "E9 drop direction must be dir 1, got %d", e.direction)
+		}
+	}
+	testing.expectf(t, !dropped, "a port whose lane is under ITS bound must admit (5 < 6; the pair holding 11 is irrelevant — R4)")
+	// and it joined the queue
+	joined := false
+	for p in s.flow.packets {
+		if p.id == 950 && p.on_edge { joined = true }
+	}
+	testing.expectf(t, joined, "the arrival must be on-edge (admitted)")
+
+	// (ii) the pinned port DOES shed: an at-node packet at res with dst rt
+	// forwards into (b, dir 0, Standard): 6 >= 6 -> the arrival's lane is the
+	// lowest non-empty -> the ARRIVAL drops, with the port's direction byte.
+	before = len(s.events)
+	s.flow.next_packet_id += 1
+	append(&s.flow.packets, Packet{id = 951, class = 0, src = res, dst = rt, on_edge = false, at_node = res, spawn_tick = s.tick})
+	step_n(&s, 1, cat)
+	shed := false
+	for e in s.events[before:] {
+		if e.tag == EVENT_TAG_PACKET_DROPPED && e.reason == u8(Drop_Reason.Queue_Overflow) {
+			shed = true
+			testing.expectf(t, e.direction == PORT_DIR_LO_TO_HI, "E9 drop direction must be dir 0, got %d", e.direction)
+			testing.expectf(t, e.target == b, "AV-1: the drop target stays the BUNDLE id (got %d)", e.target)
+		}
+	}
+	testing.expectf(t, shed, "a port whose lane is AT its bound must shed the arrival (R4)")
+}
