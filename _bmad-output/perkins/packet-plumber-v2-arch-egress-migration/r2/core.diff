+package core
+
+// egress_test.odin — v2-arch-egress S1 pins (the ratified spine 2026-08-26,
+// AD-2): the egress-port identity — (router, egress-port, lane) where
+// egress-port = the directional bundle — over the DERIVED packet membership
+// encoding. Pinned here at the lowest layer so they survive review rounds,
+// refactors, and Perkins:
+//
+//   [AD-2 canonical] the retained departure node (at_node) resolves the
+//   port's direction AND its router; the heading-based derivation coincides
+//   by construction — pinned for every on-edge packet in the fixture.
+//   [AD-2 derived] the directional read twins (port_lane_count /
+//   newest_in_port_lane / port_lane_ready) count ONLY their direction's
+//   packets — a bidirectional fixture splits cleanly.
+//   [S1 invisibility] the undirected bundle_* view equals Σ over directions
+//   for every lane — the legacy reads stayed exactly today's numbers through
+//   the whole ladder (T1 byte-identity held at S1: zero re-bless; S2/S4
+//   shifted runs re-blessed per the disclosed inventory).
+//   [port_lane_caps] a port's caps = the member-summed caps, identical for
+//   both directions (R2/AD-5: per-pipe weights, full-duplex members).
+//
+// The mutation leg (S1: port derivation bypass): deleting the direction
+// filter in port_lane_count (or neutering port_dir_of_packet's at_node
+// derivation) makes the directional-count + split pins below FAIL — the
+// pins bite at the derivation, not the walk (verified RED-then-GREEN at
+// authoring; re-prove by reverting the filter).
+
+import "core:strings"
+import "core:testing"
+
+// egress_setup — the fixture for the port pins: the 1.2 fixture nodes
+// (res@{8,15}=0, rt@{20,15}=1, host@{32,15}=2) with BOTH fixture pipes drawn
+// (res—rt and rt—host), stepped once so the routing + bundle views are
+// rebuilt (rule 1). Bundle 0 = pair (res=0, rt=1) lo=0 hi=1; bundle 1 = pair
+// (rt=1, host=2) lo=1 hi=2.
+egress_setup :: proc(cat: ^Catalogs) -> (Run_State, u32, u32, u32) {
+	s: Run_State
+	run_init(&s, 1, cat.hash, TEST_LOGIC_HZ)
+	res, rt, host := test_seed_fixture(&s, cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	draw(&s, 1, res, rt, std)
+	draw(&s, 1, rt, host, std)
+	step_n(&s, 1, cat)
+	return s, res, rt, host
+}
+
+// on_edge_packet — append a synthetic on-edge packet riding `pipe_id` from
+// `from_node` toward `to_node` (the derived encoding exactly as flow_step's
+// forward pass writes it: at_node = the retained departure node).
+on_edge_packet :: proc(s: ^Run_State, class: u16, pipe_id, from_node, to_node: u32, id: u64) {
+	s.flow.next_packet_id += 1
+	append(&s.flow.packets, Packet{
+		id = id,
+		class = class,
+		src = from_node,
+		dst = to_node,
+		on_edge = true,
+		at_node = from_node,
+		edge = pipe_id,
+		heading = to_node,
+		spawn_tick = 0,
+	})
+}
