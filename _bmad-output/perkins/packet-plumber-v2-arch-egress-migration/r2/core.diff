+// --- (c2) Perkins r1 B2: the AV-7 max-never-sum rollup, pinned ------------------
+
+@(test)
+test_pipe_congestion_max_never_sum :: proc(t: ^testing.T) {
+	// AV-7: a member pipe carries the WORSE direction's pressure (max over
+	// the two ports, never the sum — the fibers are shared but the ports are
+	// independent queues). Mutation-proven vacuous before this pin: the old
+	// fixture loaded ONE direction (max == sum there). This fixture loads
+	// BOTH, asymmetrically: the forward port's fullest lane holds 5 of the
+	// 6-packet bound (83% — amber), the reverse port's holds 1 (17% — none).
+	// The pipe reads AMBER. The sum-mutant (lo+hi = 6/6 = 100%) would raise
+	// Pipe_Critical — the exact discriminator.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
