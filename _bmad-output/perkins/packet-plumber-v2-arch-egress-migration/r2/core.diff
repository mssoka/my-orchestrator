+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 13, cat.hash, TEST_LOGIC_HZ)
+	res, rt, host := test_seed_fixture(&s, cat)
+	sla_draw(&s, cat, res, rt, "standard", 1)
+	sla_draw(&s, cat, rt, host, "standard", 1)
+	// FIVE riders forward onto pipe 0's bundle departing res (dir lo->hi,
+	// Standard lane): 5/6 of the E9 bound — amber, not red.
+	for k in u64(1)..=5 {
+		sla_spawn(&s, 1, 0, res, host)
+	}
+	// ONE rider the OTHER way (departing rt, dir hi->lo): 1/6 — no level.
+	sla_spawn(&s, 1, 0, rt, res)
+	hashes, evs := warn_record_run(&s, 20, cat)
+	defer delete(hashes)
+	defer delete(evs)
