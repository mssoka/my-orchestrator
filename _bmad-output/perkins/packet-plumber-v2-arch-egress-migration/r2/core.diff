+// --- v2-arch-egress S5: the latency ledger + the reads (D3/F2 + AV-5 + AD-7) --
+
+@(test)
+test_residency_ledger_terms :: proc(t: ^testing.T) {
+	// F2 (the AD-3 measurement boundary): per-hop delay is EXACTLY
+	// (a) join tick + (b) residency + (c) serialization — Σ over a delivery
+	// equals delivery_tick − spawn_tick. Pinned through the ledger:
+	//   uncontended: (b) = 0 — the lone rider is in service every tick past
+	//   join (the head-of-line is never "waiting");
+	//   contended: the second rider's (b) counts the ticks the scheduler
+	//   spent on the head — exactly its extra delay.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, _ := egress_setup(cat)
+	defer run_destroy(&s)
+	b, _ := bundle_of_pipe(&s, 0)
+
+	// uncontended: ONE email rider, delivered ~8 ticks after its spawn (the
+	// fixture already ran tick 1 — seed the NEXT tick)
+	flow_seed_demand(&s.flow, 2, res, rt, 0)
+	step_n(&s, 10, cat)
+	testing.expectf(t, count_arrived(&s) == 1, "the lone rider delivers")
+	testing.expect_value(t, port_residency_ticks(&s.flow, s.tick, b, PORT_DIR_LO_TO_HI, LANE_STANDARD, 0), u64(0))
+
+	// contended: two riders, 1 tick apart — the second waits out the first's
+	// serialization tail. F2 (the AD-3(a) first-hop boundary, verbatim): the
+	// second rider spawns at tick 3 and forwards DURING tick 3 — the join
+	// coincides with the spawn tick, (a) = 0 elapsed. The head joined at 2
+	// and serializes 3..10; the second waits (b) = 7 ticks (4..10 — the
+	// scheduler reaches it at 11), then serializes (c) = 8 ticks (11..18) and
+	// delivers during 18: (a)+(b)+(c) = 0+7+8 = 15 = delivery(18) −
+	// spawn(3) EXACTLY — the F2 identity. The ledger pins (b) = 7.
+	s2: Run_State
+	run_init(&s2, 7, cat.hash, TEST_LOGIC_HZ)
+	defer run_destroy(&s2)
+	res2, rt2, _ := test_seed_fixture(&s2, cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	draw(&s2, 1, res2, rt2, std)
+	flow_seed_demand(&s2.flow, 2, res2, rt2, 0)
+	flow_seed_demand(&s2.flow, 3, res2, rt2, 0)
+	step_n(&s2, 20, cat)
+	testing.expectf(t, count_arrived(&s2) == 2, "both riders deliver")
+	waited := port_residency_ticks(&s2.flow, s2.tick, b2_of(&s2), PORT_DIR_LO_TO_HI, LANE_STANDARD, 0)
+	testing.expectf(t, waited == 7, "the second rider's residency (b) must be exactly 7 (the head's serialization tail), got %d", waited)
+}
