+	testing.expectf(t, r0[LANE_STANDARD] && !r0[LANE_EXPRESS] && !r0[LANE_BEST_EFFORT],
+		"dir-0 readiness must be Standard only")
+	testing.expectf(t, r1[LANE_STANDARD] && !r1[LANE_EXPRESS] && !r1[LANE_BEST_EFFORT],
