+@(test)
+test_port_dir_canonical_and_coincidence :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	s, res, rt, host := egress_setup(cat)
+	defer run_destroy(&s)
+
+	// both directions on bundle 0 (res—rt): res→rt departs lo (dir 0),
+	// rt→res departs hi (dir 1); plus rt→host on bundle 1 (lo=rt → dir 0)
+	on_edge_packet(&s, 0, 0, res, rt, 101) // bundle 0 dir 0 (res is lo)
+	on_edge_packet(&s, 0, 0, rt, res, 102) // bundle 0 dir 1 (rt is hi)
+	on_edge_packet(&s, 0, 1, rt, host, 103) // bundle 1 dir 0 (rt is lo of pair 1..2)
+
+	// [AD-2 canonical] the at_node derivation names the direction, and the
+	// heading derivation COINCIDES by construction for every on-edge packet
+	// (the render's other-endpoint rule — pinned here so the coincidence can
+	// never silently break).
+	for i in 0..<len(s.flow.packets) {
+		p := &s.flow.packets[i]
+		if p.delivered || !p.on_edge { continue }
+		b, ok := bundle_of_pipe(&s, p.edge)
+		testing.expectf(t, ok, "packet %d: live pipe must resolve a bundle", p.id)
+		dir := port_dir_of_packet(&s, p)
+		// heading-derived: heading == the pair's hi endpoint iff dir 0
+		heading_dir := PORT_DIR_HI_TO_LO
+		if p.heading == s.bundles.bundle_hi[b] && p.heading != s.bundles.bundle_lo[b] {
+			heading_dir = PORT_DIR_LO_TO_HI
+		}
+		if p.heading == s.bundles.bundle_lo[b] && p.heading != s.bundles.bundle_hi[b] {
+			heading_dir = PORT_DIR_HI_TO_LO
+		}
+		testing.expectf(t, dir == heading_dir,
+			"packet %d: at_node dir %d != heading dir %d (the canonical/coincidence pin)",
+			p.id, dir, heading_dir)
+		// the port's router IS the retained departure node (canonical)
+		testing.expectf(t, egress_router_of_port(&s, b, dir) == p.at_node,
+			"packet %d: router-of-port %d != at_node %d", p.id, egress_router_of_port(&s, b, dir), p.at_node)
+	}
+
+	// spot pins on the fixture ids: bundle 0 pair (0,1) — res(0)→rt(1) is dir 0
+	testing.expect_value(t, port_dir_of_packet(&s, &s.flow.packets[0]), PORT_DIR_LO_TO_HI)
+	testing.expect_value(t, port_dir_of_packet(&s, &s.flow.packets[1]), PORT_DIR_HI_TO_LO)
+	testing.expect_value(t, egress_router_of_port(&s, 0, PORT_DIR_LO_TO_HI), res)
+	testing.expect_value(t, egress_router_of_port(&s, 0, PORT_DIR_HI_TO_LO), rt)
+}
