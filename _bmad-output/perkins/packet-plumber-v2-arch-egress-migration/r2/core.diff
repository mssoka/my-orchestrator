+	// the hand-verified stream (the lane-bound fixture's own drain cadence —
+	// 8 ticks per packet): depth 5 at @1 (83% amber), 4 at @9 (67% healthy).
+	warn_assert_stream(t, evs[:], []Event{
+		{tick = 1, tag = EVENT_TAG_WARNING_RAISED, sign = u8(Warning_Sign.Pipe_Congested), target = 0},
+		{tick = 9, tag = EVENT_TAG_WARNING_CLEARED, sign = u8(Warning_Sign.Pipe_Congested), target = 0},
+	})
+	// the AV-7 belt, explicit: Pipe_Critical NEVER fires — the sum-mutant's
+	// signature (5+1 = 6/6 = 100% red at tick 1).
+	for e in evs {
+		testing.expectf(t, e.sign != u8(Warning_Sign.Pipe_Critical),
+			"Pipe_Critical fired (tick %d) — the rollup summed the two ports (AV-7: max, never sum)", e.tick)
