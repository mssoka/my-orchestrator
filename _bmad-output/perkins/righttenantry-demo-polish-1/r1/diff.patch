+    ])
+    "a-conor" -> #([], ["Income affordability (79% of stated income)"])
+    "a-marta" -> #(["Character reference - first-time renter"], [
+      "No Irish rental history",
+    ])
+    "a-sara" -> #(["Landlord reference - awaiting callback"], [
+      "Income affordability",
+    ])
+    "a-tom" -> #(["Landlord reference - declined"], [
+      "Rental history gap",
+      "Income affordability",
+    ])
+    // Purged a-grace id -> a-grainne.
+    "a-grainne" -> #(["Possession order - arrear history"], [
+      "Income affordability",
+      "Red flags",
+    ])
+    "a-liam" -> #(["Employer reference - not provided", "Landlord reference"], [
+      "Income affordability",
+      "Employment stability",
+    ])
+    _ -> #([], [])
+  }
+  json.to_string(
+    json.object([
+      #(
+        "verification_summary",
+        json.object([
+          #("documents_processed", json.int(docs_processed)),
+          #("documents_failed", json.int(0)),
+          #(
+            "checks_unavailable",
