+// -- Polish r1 parity pins ---------------------------------------------------
+
+/// Fix 2: a per-applicant remind mutates the awaiting row to the reminded
+/// stage AND threads the mutated store back onto the Model (the subsequent
+/// ApiReturnedApplicantReminder refetch reads it via demo_store_of).
+pub fn demo_remind_applicant_mutates_store_test() {
+  let m = demo_model()
+  // Emma is the un-reminded row; Peter is followup_due (already reminded).
+  let emma_unreminded = fn(list: List(vacancy.AwaitingApplicant)) -> Bool {
+    case list.find(list, fn(a) { a.email == "emma.doyle@example.ie" }) {
+      Ok(a) -> !a.reminded && !a.followed_up
+      Error(_) -> False
+    }
+  }
+  let rows = demo_store.awaiting(should_be_some_store(m.demo_store), "v-maples")
+  emma_unreminded(rows) |> should.be_true
+
+  let #(after, _) =
+    client.update(
+      m,
+      msg.UserClickedRemindApplicant("v-maples", "emma.doyle@example.ie"),
+    )
+  let store = should_be_some_store(after.demo_store)
+  let after_rows = demo_store.awaiting(store, "v-maples")
+  // Emma now reminded (still not followed-up).
+  let emma = list.find(after_rows, fn(a) { a.email == "emma.doyle@example.ie" })
+  emma
+  |> should.equal(
+    Ok(vacancy.AwaitingApplicant(
+      email: "emma.doyle@example.ie",
+      name: Some("Emma Doyle"),
+      invited_at: "2026-08-15T10:00:00Z",
+      reminded: True,
+      followed_up: False,
+      followup_due: False,
+    )),
+  )
+  // The vacancy detail's remindable count re-derives from the mutated store.
+  let detail = demo_store.vacancy_detail(store, "v-maples") |> should.be_ok
+  detail.remindable_count |> should.equal(0)
+}
+
+/// Fix 2: the bulk reminder mutates every un-reminded row and flips
+/// follow-up-due rows, threaded onto the Model.
+pub fn demo_send_reminder_mutates_store_test() {
+  let m = demo_model()
+  let #(after, _) = client.update(m, msg.UserClickedSendReminder("v-maples"))
+  let store = should_be_some_store(after.demo_store)
+  let rows = demo_store.awaiting(store, "v-maples")
+  // Emma (was un-reminded) now reminded; Peter (was followup_due) followed_up.
+  let all_reminded = list.all(rows, fn(a) { a.reminded })
+  all_reminded |> should.be_true
+  let peter = list.find(rows, fn(a) { a.email == "peter.lyons@example.ie" })
+  peter |> result_map_custom(fn(a) { a.followed_up }) |> should.equal(Ok(True))
+  let detail = demo_store.vacancy_detail(store, "v-maples") |> should.be_ok
+  detail.remindable_count |> should.equal(0)
+  detail.followup_count |> should.equal(0)
+}
+
+fn result_map_custom(result: Result(a, b), f: fn(a) -> c) -> Result(c, b) {
+  case result {
+    Ok(a) -> Ok(f(a))
+    Error(e) -> Error(e)
+  }
+}
