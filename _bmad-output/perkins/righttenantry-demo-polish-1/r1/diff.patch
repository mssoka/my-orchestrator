+/// (documents processed, checks unavailable, low-confidence areas) mirror the
+/// applicant's story so the PDF doesn't read as a template with blank stats.
+fn extras_for(application_id: String) -> String {
+  let docs_processed = list.length(documents_for(application_id))
+  let #(checks_unavailable, low_confidence) = case application_id {
+    "a-aoife" -> #([], ["Income affordability (52% - within typical range)"])
+    "a-declan" -> #(["Employer reference - self-employed applicant"], [
+      "Income stability - self-employed",
