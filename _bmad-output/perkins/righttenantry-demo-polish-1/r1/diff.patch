+/// Fix 6: the a-grace residue is purged to the grainne id — the store serves
+/// an "a-grainne" applicant and no "a-grace" id remains anywhere.
+pub fn demo_a_grainne_purge_test() {
+  let store = demo_store.seed() |> should.be_ok
+  let detail =
+    demo_store.application_detail(store, "v-maples", "a-grainne")
+    |> should.be_ok
+  detail.application.id |> should.equal("a-grainne")
+  // The report filename is keyed by the new id.
+  demo_store.report_filenames()
+  |> list.map(fn(p) { p.0 })
+  |> list.contains("a-grainne")
+  |> should.be_true
+}
+
+/// Fix 3: the demo vacancy detail derives the conditions the shared
+/// leaderboard's Compare-top-3 button gates on — analysed_applications >= 3
+/// AND >= 3 leaderboard entries with a score — so the button renders in the
+/// demo exactly as it does on a real vacancy.
+pub fn demo_compare_top3_gate_holds_test() {
+  let store = demo_store.seed() |> should.be_ok
+  let detail = demo_store.vacancy_detail(store, "v-maples") |> should.be_ok
+  should.equal(detail.analysed_applications, 8)
+  should.equal(detail.analysed_applications >= 3, True)
+  let leaderboard = demo_store.leaderboard(store, "v-maples") |> should.be_ok
+  let ranks =
+    list.length(
+      list.filter(leaderboard.entries, fn(e) { e.overall_score != None }),
+    )
+  should.equal(ranks >= 3, True)
+}
