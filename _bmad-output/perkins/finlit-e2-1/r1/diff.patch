diff --git a/game/scripts/playtest_session.gd b/game/scripts/playtest_session.gd
new file mode 100644
index 0000000..f9bd3ae
--- /dev/null
+++ b/game/scripts/playtest_session.gd
@@ -0,0 +1,135 @@
+class_name PlaytestSession
+## Observer-side session logger for structured playtest runs (story e2-1).
+##
+## Records a JSONL timeline of meaningful in-game events (lottery, first
+## wage, buys, events, ...) so the session observer can fill the playtest
+## scorecard (docs/playtest-scorecard.md) from machine evidence instead of
+## memory: the timed rows (first wage <60s, FIND WORK unaided) read straight
+## off the log's elapsed_ms fields.
+##
+## Pure observer tooling — never mutates game state, never blocks, and is
+## COPPA-safe by construction: no free text, no real names (street names are
+## generator-first dice rolls), only age-bracket bands. Not an autoload (the
+## two-autoload cap lands in E3); street.gd instantiates it when the
+## --playtest flag is present. Overlay surfaces (PlaytestChip) additionally
+## gate on OS.has_feature("debug") so release exports never show them
+## (architecture §Debug Tools).
+##
+## Enable:    godot --path game -- --playtest
+## Log:       user://playtest/session-<yyyy-mm-ddThh-mm-ss>.jsonl  (UTC)
+## Override:  godot --path game -- --playtest --playtest-log <path>
+##
+## Line format (JSON, one per line):
+##   {"event": "first_wage", "elapsed_ms": 1234, "ts": 1754300000.0, ...payload}
+## JSON parses ints as floats — readers must re-cast with int().
+
+const FLAG := "--playtest"
+const LOG_ARG := "--playtest-log"
+const SESSION_DIR := "user://playtest"
+const VERSION := "1"
+
+var path := ""
+var _file: FileAccess = null
+var _start_ms := 0
+var _events := 0
+
+
+## Returns a live session logger when args request playtest mode, else null.
+static func for_args(args: PackedStringArray = OS.get_cmdline_user_args()) -> PlaytestSession:
+	if not requested(args):
+		return null
+	var session := PlaytestSession.new()
+	session.path = resolve_path(args)
+	return session
+
+
+static func requested(args: PackedStringArray) -> bool:
+	return args.has(FLAG)
+
+
+## The log path: the --playtest-log value when given, else a timestamped
+## default under user://playtest/. A trailing flag with no value falls back
+## to the default rather than failing. The default is UTC (no spaces) so the
+## filename correlates directly with the per-record unix `ts` field and never
+## breaks naive shell/URL handling.
+static func resolve_path(args: PackedStringArray) -> String:
+	var override := arg_value(args, LOG_ARG)
+	if not override.is_empty():
+		return override
+	var stamp := Time.get_datetime_string_from_system(true, false).replace(":", "-")
+	return "%s/session-%s.jsonl" % [SESSION_DIR, stamp]
+
+
+static func arg_value(args: PackedStringArray, flag: String) -> String:
+	var i := args.find(flag)
+	if i >= 0 and i + 1 < args.size():
+		return args[i + 1]
+	return ""
+
+
+## Overlay surfaces are debug-build only (feature-tag doctrine), so release
+## exports never render observer UI even if the flag sneaks through.
+static func overlay_allowed() -> bool:
+	return OS.has_feature("debug")
+
+
+## Opens the log and writes the header. Safe to call twice — a second begin
+## is a no-op (street._ready is the only caller; tests pin the contract).
+## If the resolved path already exists (e.g. two launches in the same
+## wall-clock second), a -2/-3 suffix disambiguates so a prior session's
+## timeline is never silently truncated.
+func begin() -> void:
+	if _file != null:
+		return
+	_start_ms = Time.get_ticks_msec()
+	var target := path
+	var n := 2
+	while FileAccess.file_exists(target):
+		target = "%s-%d.%s" % [target.get_basename(), n, target.get_extension()]
+		n += 1
+	path = target
+	var dir := path.get_base_dir()
+	if not dir.is_empty():
+		DirAccess.make_dir_recursive_absolute(dir)
+	_file = FileAccess.open(path, FileAccess.WRITE)
+	if _file == null:
+		push_warning("playtest: cannot open session log %s (error %d) — continuing without logging" % [path, FileAccess.get_open_error()])
+		return
+	record("session_begin", {"version": VERSION, "log_path": path})
+
+
+## True once the log file is actually open. street.gd uses this to hide the
+## observer chip when capture failed to start, so the UI never claims a live
+## session that is not being written.
+func is_logging() -> bool:
+	return _file != null
+
+
+## Appends one JSONL event with elapsed_ms (since begin) and unix ts.
+## Payloads must stay JSON-friendly and COPPA-safe (project-context rules).
+func record(event: String, data: Dictionary = {}) -> void:
+	if _file == null:
+		return
+	_events += 1
+	var line: Dictionary = {
+		"event": event,
+		"elapsed_ms": Time.get_ticks_msec() - _start_ms,
+		"ts": Time.get_unix_time_from_system(),
+	}
+	for key in data:
+		line[key] = data[key]
+	_file.store_line(JSON.stringify(line))
+	_file.flush() # observers read the log mid-session; never buffer a timeline
+	if _file.get_error() != OK:
+		# The line did not reach disk — drop it from the count so the chip
+		# never overstates what persisted (disk full, ejected media, ...).
+		_events -= 1
+		push_warning("playtest: write to %s failed (error %d) — event dropped" % [path, _file.get_error()])
+
+
+func event_count() -> int:
+	return _events
+
+
+func elapsed_ms() -> int:
+	return Time.get_ticks_msec() - _start_ms
