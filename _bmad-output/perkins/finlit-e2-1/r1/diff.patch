+++ b/game/tests/test_playtest_session.gd
@@ -0,0 +1,352 @@
+extends SceneTree
+## Headless tests for the playtest session logger + street wiring (story e2-1).
+##
+## The suite runs in BOTH modes (both are part of the gate):
+##   godot --headless --path game --script res://tests/test_playtest_session.gd
+##   godot --headless --path game --script res://tests/test_playtest_session.gd \
+##       -- --playtest --playtest-log user://test_playtest_sessions/session.jsonl
+##
+## Plain run  -> asserts playtest OFF: no session, no overlay, nothing logged.
+## Playtest run -> asserts ON: session begins, overlay visible, boot event,
+##   and the real boot flow records job_picked -> first_wage exactly once.
+## Exit 0 = all green. All artifacts stay in user://test_* paths, wiped at
+## start and end so stale files from a previous run never fake a result.
+
+var _failures := 0
+var _checks := 0
+var _street: Control
+var _frame := 0
+var _playtest_on := false
+var _log_path := "user://test_playtest_sessions/session.jsonl"
+
+
+func _initialize() -> void:
+	print("== FinLit prototype: playtest session tests ==")
+	_playtest_on = PlaytestSession.requested(OS.get_cmdline_user_args())
+	_wipe_test_dir()
+	_cleanup_save_files()
+	_test_flag_parsing()
+	_test_path_resolution()
+	_test_log_shape_and_order()
+	_test_disabled_is_null()
+	_test_overlay_gate()
+	_test_log_open_failure_reported()
+	_setup_street_scene()
+
+
+func check(condition: bool, label: String) -> void:
+	_checks += 1
+	if condition:
+		print("  ok  %s" % label)
+	else:
+		_failures += 1
+		printerr("FAIL  %s" % label)
+
+
+## --- Pure tests -------------------------------------------------------------------
+
+func _test_flag_parsing() -> void:
+	check(PlaytestSession.requested(["--playtest"]), "requested() true with --playtest")
+	check(PlaytestSession.requested(["--playtest", "--playtest-log", "x.jsonl"]), "requested() true with flag + log arg")
+	check(not PlaytestSession.requested([]), "requested() false with no args")
+	check(not PlaytestSession.requested(["--playtest-log", "x.jsonl"]), "log arg alone does not enable playtest")
+
+
+func _test_path_resolution() -> void:
+	var d := PlaytestSession.resolve_path(["--playtest"])
+	check(d.begins_with("user://playtest/") and d.ends_with(".jsonl"),
+		"default path under user://playtest/, timestamped (%s)" % d)
+	check(not d.contains(" "), "default filename has no spaces (shell/URL-safe)")
+	check(d == d.to_lower() or d.contains("T"), "default filename uses the T separator (UTC)")
+	check(PlaytestSession.resolve_path(["--playtest", "--playtest-log", "/tmp/pt.jsonl"]) == "/tmp/pt.jsonl",
+		"override path honored")
+	check(PlaytestSession.resolve_path(["--playtest", "--playtest-log"]) == PlaytestSession.resolve_path(["--playtest"]),
+		"missing override value falls back to default")
+
+
+func _test_log_shape_and_order() -> void:
+	var path := "user://test_playtest_sessions/unit.jsonl"
+	var session := PlaytestSession.for_args(["--playtest", "--playtest-log", path])
+	check(session != null, "for_args returns a session when the flag is present")
+	if session == null:
+		return
+	check(session.path == path, "session path resolved from args")
+	session.begin()
+	session.begin() # second begin must not duplicate the header
+	session.record("first_wage", {"amount": 12})
+	session.record("buy", {"type": "rental", "name": "Sunny Duplex"})
+	var raw := FileAccess.get_file_as_string(path)
+	var lines: Array = raw.strip_edges().split("\n") if not raw.is_empty() else []
+	check(lines.size() == 3, "one header + two events (double begin is a no-op)")
+	if lines.size() != 3:
+		return
+	var header: Dictionary = JSON.parse_string(lines[0])
+	check(header.get("event", "") == "session_begin", "first line is session_begin")
+	check(header.get("version", "") == PlaytestSession.VERSION, "header carries the log version")
+	check(header.get("log_path", "") == path, "header carries the log path")
+	for i in [1, 2]:
+		var line: Dictionary = JSON.parse_string(lines[i])
+		check(line.get("event", "") != "", "line %d carries an event name" % i)
+		check(typeof(line.get("elapsed_ms")) == TYPE_FLOAT and int(line["elapsed_ms"]) >= 0,
+			"line %d has non-negative elapsed_ms (JSON ints arrive as floats)" % i)
+		check(typeof(line.get("ts")) == TYPE_FLOAT and int(line["ts"]) > 0, "line %d has a unix ts" % i)
+	var wage: Dictionary = JSON.parse_string(lines[1])
+	check(int(wage.get("amount", -1)) == 12, "int payload round-trips (re-cast)")
+	var buy: Dictionary = JSON.parse_string(lines[2])
+	check(buy.get("name", "") == "Sunny Duplex", "string payload survives")
+	check(int(wage["elapsed_ms"]) <= int(buy["elapsed_ms"]), "elapsed_ms is monotonic across events")
+	check(session.event_count() == 3, "event_count counts header + events")
+	# A second session at the same path must never truncate the first.
+	var second := PlaytestSession.for_args(["--playtest", "--playtest-log", path])
+	second.begin()
+	check(second.path != path and second.path.ends_with("-2.jsonl"),
+		"existing log path disambiguated to -2 (no silent truncation)")
+	second.record("first_wage", {"amount": 9})
+	var first_raw := FileAccess.get_file_as_string(path)
+	var first_lines: Array = first_raw.strip_edges().split("\n") if not first_raw.is_empty() else []
+	check(first_lines.size() == 3, "first session's file untouched by the second session")
+	var second_raw := FileAccess.get_file_as_string(second.path)
+	var second_lines: Array = second_raw.strip_edges().split("\n") if not second_raw.is_empty() else []
+	check(second_lines.size() == 2, "second session writes its own header + event")
+
+
+func _test_disabled_is_null() -> void:
+	check(PlaytestSession.for_args([]) == null, "no flag -> no session")
+	check(PlaytestSession.for_args(["x"]) == null, "unrelated args -> no session")
+
+
+func _test_log_open_failure_reported() -> void:
+	# /dev/null is a file, not a dir — the open must fail without crashing.
+	var session := PlaytestSession.for_args(["--playtest", "--playtest-log", "/dev/null/nope.jsonl"])
+	check(session != null, "session constructed even when the log cannot open")
+	session.begin()
+	check(not session.is_logging(), "log-open failure surfaces via is_logging() (chip stays hidden)")
+	session.record("x", {})
+	check(session.event_count() == 0, "events are dropped while not logging")
+
+
+func _test_overlay_gate() -> void:
+	check(PlaytestSession.overlay_allowed() == OS.has_feature("debug"),
+		"overlay gate mirrors the debug feature tag")
+
+
+## --- Scene tests -------------------------------------------------------------------
+
+func make_state(bracket := "8-10") -> Dictionary:
+	var rng := RandomNumberGenerator.new()
+	rng.seed = 42
+	var lottery := FinLitLifeLottery.roll(rng)
+	return FinLitEconomy.new_state("Test Lane", bracket, lottery)
+
+
+func _setup_street_scene() -> void:
+	var backend := LocalJsonBackend.new("user://test_playtest_save.json", "user://test_playtest_identity.json")
+	var state := make_state()
+	state["job"] = "" # fresh start: FIND WORK dominant, first wage still unseen
+	state["balance"] = 60
+	state["seen_first_wage"] = false
+	state["savings_nudged"] = true
+	backend.save_game(state)
+	backend.save_identity(state["street_name"], "8-10")
+	var packed := load("res://scenes/street.tscn")
+	if packed == null:
+		_failures += 1
+		printerr("FAIL  street.tscn failed to load")
+		_finish()
+		return
+	_street = packed.instantiate()
+	_street._backend = backend # test seam: assigned before the deferred _ready
+	root.add_child(_street)
+
+
+func _process(_delta: float) -> bool:
+	if _street == null:
+		return false
+	if not is_instance_valid(_street) or _street.get_node_or_null("%BalanceLabel") == null:
+		_failures += 1
+		printerr("FAIL  street scene failed to boot for playtest scene tests")
+		_finish()
+		return true
+	_frame += 1
+	match _frame:
+		1:
+			pass # street _ready is deferred one frame after add_child
+		2:
+			_check_boot_state()
+			_street._on_job_picked("dog_walker") # next frame's _process pays the wage
+			_send_reroll_input()
+		3:
+			_check_wage_and_log()
+			_street._run_first_launch_flow() # suspends at the age popup
+		4:
+			_street._age_picked.emit("8-10")
+		5:
+			_street._street_name_picked.emit("Fresh Lane")
+		6:
+			_check_lottery_card()
+		7:
+			_check_fresh_boot()
+			_finish()
+			return true
+	return false
+
+
+func _check_boot_state() -> void:
+	var chip: Label = _street.get_node_or_null("%PlaytestChip")
+	check(chip != null, "PlaytestChip exists in the scene (hidden by default)")
+	if _playtest_on:
+		check(_street._playtest != null, "playtest ON: session instantiated")
+		check(PlaytestSession.overlay_allowed() == false or (chip != null and chip.visible),
+			"playtest ON: overlay visible on a debug build")
+		check(FileAccess.file_exists(_log_path), "playtest ON: session log file created")
+		var raw := FileAccess.get_file_as_string(_log_path)
+		var lines: Array = raw.strip_edges().split("\n") if not raw.is_empty() else []
+		check(lines.size() >= 2, "playtest ON: header + boot event written")
+		if lines.size() >= 2:
+			var header: Dictionary = JSON.parse_string(lines[0])
+			check(header.get("event", "") == "session_begin", "playtest ON: header first")
+			var boot: Dictionary = JSON.parse_string(lines[1])
+			check(boot.get("event", "") == "boot", "playtest ON: boot event recorded")
+			check(boot.get("street_name", "") == "Test Lane", "playtest ON: boot carries the loaded street name")
+	else:
+		check(_street._playtest == null, "playtest OFF: no session instantiated")
+		check(chip != null and not chip.visible, "playtest OFF: overlay stays hidden")
+
+
+func _send_reroll_input() -> void:
+	var press := InputEventMouseButton.new()
+	press.button_index = MOUSE_BUTTON_LEFT
+	press.pressed = true
+	_street._on_reroll_input(press)
+	var release := InputEventMouseButton.new()
+	release.button_index = MOUSE_BUTTON_LEFT
+	release.pressed = false
+	_street._on_reroll_input(release)
+	# Observer gestures must not count: right-click and wheel over the stub.
+	var right := InputEventMouseButton.new()
+	right.button_index = MOUSE_BUTTON_RIGHT
+	right.pressed = true
+	_street._on_reroll_input(right)
+
+
+func _check_wage_and_log() -> void:
+	if _playtest_on:
+		var raw := FileAccess.get_file_as_string(_log_path)
+		var lines: Array = raw.strip_edges().split("\n") if not raw.is_empty() else []
+		var events: Array = []
+		for line in lines:
+			events.append(JSON.parse_string(line).get("event", ""))
+		var job_i := events.find("job_picked")
+		var wage_i := events.find("first_wage")
+		check(job_i >= 0, "job_picked recorded")
+		check(wage_i > job_i, "first_wage recorded AFTER job_picked (wage landed from the boot flow)")
+		if wage_i > 0:
+			var first_wage: Dictionary = JSON.parse_string(lines[wage_i])
+			check(int(first_wage["elapsed_ms"]) < 5000, "first_wage elapsed < 5s (preset wage timer fires next frame)")
+			check(int(first_wage.get("amount", -1)) > 0, "first_wage carries the amount")
+		check(events.count("first_wage") == 1, "first_wage recorded exactly once (seen_first_wage guard)")
+		check(events.count("reroll_attempt") == 1, "reroll_attempt recorded on a pressed event only (disabled button never emits pressed)")
+		check(_street._playtest.event_count() == events.size(), "session event count matches the file")
+		_street._pay_wage() # second wage: must not duplicate first_wage
+		_street._pay_wage()
+		var raw2 := FileAccess.get_file_as_string(_log_path)
+		var after: Array = raw2.strip_edges().split("\n") if not raw2.is_empty() else []
+		var events2: Array = []
+		for line in after:
+			events2.append(JSON.parse_string(line).get("event", ""))
+		check(events2.count("first_wage") == 1, "two more wage drops still record first_wage once")
+	else:
+		_street._on_reroll_input(_press_event())
+		_street._pay_wage()
+		check(_street._playtest == null, "playtest OFF: handlers no-op without a session")
+
+
+func _press_event() -> InputEvent:
+	var press := InputEventMouseButton.new()
+	press.button_index = MOUSE_BUTTON_LEFT
+	press.pressed = true
+	return press
+
+
+## --- Cleanup ----------------------------------------------------------------------
+
+func _wipe_test_dir() -> void:
+	var dir := DirAccess.open("user://test_playtest_sessions")
+	if dir:
+		for f in dir.get_files():
+			dir.remove(f)
+		dir = null
+		DirAccess.remove_absolute("user://test_playtest_sessions")
+
+
+func _cleanup_save_files() -> void:
+	for p in ["user://test_playtest_save.json", "user://test_playtest_identity.json"]:
+		if FileAccess.file_exists(p):
+			DirAccess.remove_absolute(p)
+
+
+func _find_node_by_name(node: Node, name: String) -> Node:
+	for child in node.get_children():
+		if child.name == name:
+			return child
+		var found := _find_node_by_name(child, name)
+		if found != null:
+			return found
+	return null
+
+
+func _find_button_by_text(node: Node, needle: String) -> Button:
+	for child in node.get_children():
+		if child is Button and child.text.contains(needle):
+			return child
+		var found := _find_button_by_text(child, needle)
+		if found != null:
+			return found
+	return null
+
+
+## The lottery card is open here (fresh first-launch flow). Playtest mode
+## must have placed a transparent tap probe over the disabled REROLL stub;
+## a direct emit validates the wiring (engine-level routing was verified
+## windowed — disabled buttons receive no gui_input at all, Godot 4.7).
+## ACCEPT LIFE is pressed through the real signal so the accept-path
+## lottery record runs for real.
+func _check_lottery_card() -> void:
+	var probe: Node = _find_node_by_name(_street._popup_root, "RerollTapProbe")
+	if _playtest_on:
+		check(probe != null, "fresh flow: RerollTapProbe overlay sits on the disabled REROLL stub")
+		if probe != null:
+			var ev := InputEventMouseButton.new()
+			ev.button_index = MOUSE_BUTTON_LEFT
+			ev.pressed = true
+			probe.gui_input.emit(ev)
+	else:
+		check(probe == null, "fresh flow: no tap probe outside playtest mode")
+	var accept := _find_button_by_text(_street._popup_root, "ACCEPT LIFE")
+	check(accept != null, "fresh flow: ACCEPT LIFE button present")
+	if accept != null:
+		accept.pressed.emit()
+
+
+func _check_fresh_boot() -> void:
+	if not _playtest_on:
+		check(_street._playtest == null, "fresh flow OFF: still no session")
+		return
+	var raw := FileAccess.get_file_as_string(_log_path)
+	var lines: Array = raw.strip_edges().split("\n") if not raw.is_empty() else []
+	var events: Array = []
+	for line in lines:
+		events.append(JSON.parse_string(line).get("event", ""))
+	check(events.count("boot") == 2, "fresh flow: second boot recorded (per-game segment delimiter)")
+	var boot_i := events.rfind("boot")
+	var boot: Dictionary = JSON.parse_string(lines[boot_i])
+	check(boot.get("street_name", "") == "Fresh Lane", "fresh flow: boot carries the new street name")
+	check(events.has("lottery"), "fresh flow: lottery event recorded on accept")
+	check(events.count("reroll_attempt") == 2, "tap probe recorded a reroll_attempt (direct handler + probe)")
+
+
+func _finish() -> void:
+	_wipe_test_dir()
+	_cleanup_save_files()
+	print("== %d checks, %d failures ==" % [_checks, _failures])
+	quit(0 if _failures == 0 else 1)
