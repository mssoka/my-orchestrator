+def make_small_biz(loc, pal, scale=1.0, name="SmallBiz"):
+    """Small-biz (office) — story 5.11: a low-rise warm-stone office block.
+    Flat parapet roof (two-tone: full-tone rim + darker inner panel), a
+    rooftop AC unit, a cream storefront sign band across the front. Literal +
+    geometric; the office analogue between the gabled residential and the
+    multi-wing campus (look-book §1 / 7.1 amendment)."""
+    bx, by = loc[0], loc[1]
+    parent = _new_group(name, loc)
+    bw, bd, bh = 1.10 * scale, 0.84 * scale, 0.34 * scale
+    body_m = emissive_mat(name + "_body", pal["b_small_biz"], pal["body_str"])
+    top_m  = emissive_mat(name + "_top",  pal["b_small_biz_roof"], pal["body_str"])
+    panel_m = emissive_mat(name + "_panel", pal["b_small_biz_roof"], pal["body_str"] * 0.80)
+    sign_m = emissive_mat(name + "_sign", pal["canvas"], pal["body_str"])
+    add_cube(name + "_body", (bx, by, bh / 2), (bw, bd, bh), body_m, parent)
+    add_cube(name + "_roof", (bx, by, bh + 0.03 * scale), (bw * 1.08, bd * 1.08, 0.06 * scale), top_m, parent)
+    add_cube(name + "_panel", (bx, by, bh + 0.09 * scale), (bw * 0.80, bd * 0.80, 0.02 * scale), panel_m, parent)
+    add_cube(name + "_acu", (bx + 0.26 * scale, by - 0.16 * scale, bh + 0.12 * scale),
+             (0.22 * scale, 0.18 * scale, 0.08 * scale), top_m, parent)
+    add_quad(name + "_sign", (bx, by - bd * 0.52, bh + 0.11 * scale), (bw * 0.72, 0.09 * scale),
+             sign_m, parent=parent)
+    return parent
+
+
+def make_campus(loc, pal, scale=1.0, name="Campus"):
+    """Campus — story 5.11: the largest terminal, a brick multi-wing complex
+    (main hall + two side wings around a shallow quad + a center pavilion + a
+    light clock-tower marking). Literal + geometric; the unmistakable
+    school/campus silhouette, nothing else in the roster reads as multi-wing."""
+    bx, by = loc[0], loc[1]
+    parent = _new_group(name, loc)
+    bw, bd, bh = 1.85 * scale, 1.35 * scale, 0.40 * scale
+    body_m = emissive_mat(name + "_body", pal["b_campus"], pal["body_str"])
+    roof_m = emissive_mat(name + "_roof", pal["b_campus_roof"], pal["body_str"])
+    wing_m = emissive_mat(name + "_wing", pal["b_campus_roof"], pal["body_str"] * 0.85)
+    quad_m = emissive_mat(name + "_quad", pal["b_campus_quad"], pal["body_str"])
+    sign_m = emissive_mat(name + "_sign", pal["canvas"], pal["body_str"])
+    # main hall across the back
+    add_cube(name + "_hall_w", (bx, by + 0.30 * scale, bh / 2), (bw, 0.55 * scale, bh), body_m, parent)
+    add_cube(name + "_hall_r", (bx, by + 0.30 * scale, bh + 0.03 * scale), (bw * 1.03, 0.60 * scale, 0.06 * scale), roof_m, parent)
+    # two side wings forward (the quad arms)
+    for sx in (-0.62, 0.62):
+        add_cube(name + "_wing_w", (bx + sx * scale, by - 0.15 * scale, bh / 2), (0.55 * scale, 1.05 * scale, bh), body_m, parent)
+        add_cube(name + "_wing_r", (bx + sx * scale, by - 0.15 * scale, bh + 0.03 * scale), (0.58 * scale, 1.10 * scale, 0.06 * scale), wing_m, parent)
+    # center pavilion between the wings
+    add_cube(name + "_pav_w", (bx, by - 0.55 * scale, bh / 2), (0.50 * scale, 0.55 * scale, bh), body_m, parent)
+    add_cube(name + "_pav_r", (bx, by - 0.55 * scale, bh + 0.03 * scale), (0.52 * scale, 0.58 * scale, 0.06 * scale), wing_m, parent)
+    # the quad strip (the shallow courtyard read between the wings)
+    add_cube(name + "_quad", (bx, by + 0.06 * scale, 0.02 * scale), (1.10 * scale, 0.42 * scale, 0.02 * scale), quad_m, parent)
+    # clock-tower marking on the hall (the school read)
+    add_cube(name + "_tower", (bx, by + 0.30 * scale, bh + 0.10 * scale), (0.16 * scale, 0.16 * scale, 0.16 * scale), sign_m, parent)
+    return parent
