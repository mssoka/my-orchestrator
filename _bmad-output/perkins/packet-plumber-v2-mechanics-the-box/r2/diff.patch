+// run_palcheck_structural — the CI environment-blind subset (the 2026-08-28
+// golden ruling, USER via Silas: the golden source of truth is LOCAL —
+// byte-exact raster legs run LOCAL-ONLY; CI asserts the structural legs).
+// Covers: the palette-token separation oracle (CPU), the route_tie
+// unremapped pin (CPU), and the 7.4 map-identity pins (CPU cell hashes).
+// The golden-scanning + live-render pixel legs are LOCAL-ONLY — a compact
+// SEPARATE proc, so the local full palcheck path is byte-for-byte unchanged.
+run_palcheck_structural :: proc(cat: ^pp.Catalogs) -> int {
+	rl.SetTraceLogLevel(.ERROR)
+	rl.InitWindow(1280, 720, "pp-palcheck-structural")
+	defer rl.CloseWindow()
+
+	palette := rnd.palette_load()
+	view: rnd.View
+	view.palette = &palette
+	view.catalogs = cat
+	rnd.view_compute(&view, 1280, 720, &cat.balance)
+
+	fmt.println("palcheck --structural (the CI environment-blind subset; raster legs are local-only per the 2026-08-28 golden ruling):")
+	fails := 0
+
+	// the 7.4 map-identity pins (CPU cell hashes — no raster)
+	{
+		h1 := rnd.map_cells_hash(&view, 7)
+		h2 := rnd.map_cells_hash(&view, 7)
+		if h1 != MAP_IDENTITY_PIN {
+			fmt.printf("  FAIL map identity (seed 7 cells pin; observed %016x)\n", h1)
+			fails += 1
+		}
+		if h1 != h2 {
+			fmt.println("  FAIL map same-seed stability (fresh regen == fresh regen)")
+			fails += 1
+		}
+		h3 := rnd.map_cells_hash(&view, 8)
+		if h3 == h1 {
+			fmt.println("  FAIL map seed sensitivity (seed 8 == seed 7)")
+			fails += 1
+		}
+	}
+
+	// the 7.3 colorblind separation oracle + the route_tie unremapped pin
+	// (CPU token math — no raster)
+	{
+		base := rnd.palette_load()
+		modes := []rnd.Palette_Mode{.Deutan, .Protan, .Tritan}
+		for mode in modes {
+			fails_a, min_d := a11y_separation_check(cat, &base, mode)
+			if fails_a != 0 {
+				fmt.printf("  FAIL a11y separation (%s; min sim-dist %.1f) — %d pair(s) collide\n",
+					rnd.palette_mode_name(mode), min_d, fails_a)
+				fails += 1
+			}
+			eff: rnd.Palette
+			rnd.palette_apply_mode(&base, &eff, mode)
+			if eff.route_tie != base.route_tie {
+				fmt.printf("  FAIL a11y %s route_tie remapped (the base violet must survive every mode table)\n", rnd.palette_mode_name(mode))
+				fails += 1
+			}
+		}
+	}
+
+	if fails == 0 {
+		fmt.println("palcheck --structural: all structural legs green")
+		return 0
+	}
+	fmt.printf("palcheck --structural: %d structural leg(s) FAILED\n", fails)
+	return 1
+}
