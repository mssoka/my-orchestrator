+@test
+test_econ_gate_brush_and_first_no :: proc(t: ^testing.T) {
+	cat: Catalogs
+	defer catalogs_destroy(&cat)
+	box_test_catalog(&cat)
+	s: Run_State
+	defer run_destroy(&s)
+	box_test_run(&s, 7, 1, &cat)
+	stats: Box_Greedy_Stats
+	econ_run_greedy(&s, &cat, 1200, &stats)
+	// THE FIRST "NO" MUST LAND ON A GREEDY-BUT-SAFE PLAYER: only once the
+	// box is genuinely (nearly) empty — the bot had built 4 long segments
+	// (56 in-play tiles vs the 48-tile kit) before the ceiling spoke. An
+	// early "no" would be pressure, not consequence.
+	testing.expectf(t, stats.first_no_tick != 0, "no brush observed — the ceiling never spoke (a dead gate)")
+	// the empty-box contract: built + stock ≈ the full kit (nothing was
+	// withheld) and the box held less than one more segment when it spoke
+	// (the "no" is the kit running out, never arbitrary early rejection).
+	testing.expectf(t, stats.first_no_built+stats.first_no_stock >= BOX_FIX_TILES,
+		"the first 'no' landed with only %d+%d material in play — something starved the player",
+		stats.first_no_built, stats.first_no_stock)
+	testing.expectf(t, stats.first_no_built >= BOX_FIX_TILES-14,
+		"the first 'no' landed after only %d in-play tiles — starvation, not an earned brush",
+		stats.first_no_built)
+	// THE BRUSH IS AN EPISODE, NOT SPAM: refusals arrive in bursts bounded
+	// by the dot windows (≤ 1 per restore window + the sustain crossovers).
+	windows := 1200 / BOX_TEST_BASE + 1
+	testing.expectf(t, stats.episodes <= i32(windows) + 2, "too many refusal episodes (%d in %d windows) — the ceiling is pressuring, not brushing",
+		stats.episodes, windows)
+	// SELF-RESOLVING AS A DOT LANDS: after the first refusal, building
+	// resumed (the dot restored the kit; the redeploy loop re-earned it).
+	testing.expect(t, stats.post_dot_draws > 0, "the brush never self-resolved — the dot did not restore the greedy player")
+	// the dot itself was seen on the spine during the run.
+	testing.expect(t, stats.dot_seen, "no dot fired during the gate run — the clock regressed")
+}
