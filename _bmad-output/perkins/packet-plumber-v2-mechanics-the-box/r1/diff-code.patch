+// ------------------------------------------------- the economy gates (Q8) —
+
+// Box_Greedy_Stats — what the gate bot measures.
+Box_Greedy_Stats :: struct {
+	draws_ok:       i32, // draws that applied
+	refusals:       i32, // Box_Spool_Exhausted attempts
+	episodes:       i32, // CONSECUTIVE refusal bursts (the brush's unit — never attempt-spam)
+	first_no_tick:  u64, // the first refusal (0 = never)
+	first_no_built: u32, // tiles in play when the first "no" landed (generosity)
+	first_no_stock: u32, // spool stock left when the first "no" landed (the empty-box measure)
+	post_dot_draws: i32, // draws that applied after the first dot (self-resolution)
+	in_refusal:     bool, // episode tracker (internal)
+	dot_seen:       bool, // (internal) a BOX_DOT crossed during the run
+}
+
+// econ_run_greedy — a deterministic GREEDY-EXPANSIVE bot on the 3-node
+// fixture (res 0 ← rt 1 → host 2). EXPANSION: 3 new routers at 14-tile
+// spacing (the longest legal standard spans — the big-swing instinct), then
+// 2 segments per pair (the chain + 1 parallel; routers are 4-port-capped),
+// drawn every 2 ticks. SUSTAIN: cannibalize-and-redeploy — demolish the
+// oldest segment, redraw it on its pair (the record's "always available"
+// teardown loop). The stats expose the brush's shape.
+econ_run_greedy :: proc(s: ^Run_State, cat: ^Catalogs, ticks: u64, stats: ^Box_Greedy_Stats) {
+	BOX_SEG :: 6 // 3 pairs × 2 segments
+	pairs := [3][2]u32{{1, 3}, {3, 4}, {4, 5}}
+	spots := [3][2]i32{{6, 15}, {6, 29}, {20, 29}} // 14-tile spacing
+	seg_pipe: [BOX_SEG]u32
+	seg_pair: [BOX_SEG]int
+	// the expansion placements (fast-path applies at tick 0; the main loop
+	// owns the tick drive from 1).
+	for k in 0..<3 {
+		if box_apply_cmd(s, Cmd_Place_Router{type_idx = box_rt_idx(cat), pos = spots[k]}, cat) != .None {
+			panic("econ_run_greedy: bot placement refused — the fixture geometry regressed")
+		}
+	}
+	seg_cursor := 0
+	oldest := 0
+	for tick in u64(1)..=ticks {
+		before := len(s.events)
+		step(s, tick, nil, cat)
+		for e in s.events[before:] {
+			if e.tag == EVENT_TAG_BOX_DOT do stats.dot_seen = true
+		}
+		clear(&s.events)
+		if tick % 2 != 0 {
+			continue
+		}
+		a, b: u32
+		if seg_cursor < BOX_SEG {
+			// EXPANSION: the next scripted segment (chain first per pair).
+			a = pairs[seg_cursor / 2][0]
+			b = pairs[seg_cursor / 2][1]
+		} else {
+			// SUSTAIN: demolish the oldest segment, then redraw its pair —
+			// the cannibalize-and-redeploy loop (funded by the refund).
+			dem := oldest % BOX_SEG
+			if box_apply_cmd(s, Cmd_Demolish_Pipe{pipe = seg_pipe[dem]}, cat) != .None {
+				panic("econ_run_greedy: bot demolish refused — the refund contract regressed")
+			}
+			a = pairs[seg_pair[dem] / 2][0]
+			b = pairs[seg_pair[dem] / 2][1]
+		}
+		err := box_apply_cmd(s, Cmd_Draw_Pipe{a = a, b = b, tier = box_std_idx(cat)}, cat)
+		if err == .None {
+			if seg_cursor < BOX_SEG {
+				seg_pipe[seg_cursor] = u32(len(s.topology.pipe_alive) - 1) // the new pipe's id
+				seg_pair[seg_cursor] = seg_cursor
+			} else {
+				dem := oldest % BOX_SEG
+				seg_pipe[dem] = u32(len(s.topology.pipe_alive) - 1)
+			}
+			if seg_cursor < BOX_SEG {
+				seg_cursor += 1
+			} else {
+				oldest += 1
+			}
+			stats.draws_ok += 1
+			if stats.first_no_tick != 0 {
+				stats.post_dot_draws += 1
+			}
+			stats.in_refusal = false
+		} else if err == .Box_Spool_Exhausted {
+			stats.refusals += 1
+			if !stats.in_refusal {
+				stats.episodes += 1
+				stats.in_refusal = true
+			}
+			if stats.first_no_tick == 0 {
+				stats.first_no_tick = tick
+				// tiles in play when the ceiling first spoke: every live
+				// pipe's span (the generosity measure).
+				in_play: u32 = 0
+				for p in 0..<len(s.topology.pipe_alive) {
+					if s.topology.pipe_alive[p] {
+						in_play += u32(s.topology.pipe_span[p])
+					}
+				}
+				stats.first_no_built = in_play
+				stats.first_no_stock = s.box.spools[BOX_SPOOL_STANDARD]
+			}
+		}
+		// .Router_Ports_Full attempts are neither draws nor refusals — the
+		// bot's geometry keeps them impossible (2 segments per 4-port pair).
+	}
+}
