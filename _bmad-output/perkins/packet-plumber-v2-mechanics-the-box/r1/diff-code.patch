diff --git a/harness/econ.odin b/harness/econ.odin
new file mode 100644
index 0000000..cf3b644
--- /dev/null
+++ b/harness/econ.odin
@@ -0,0 +1,392 @@
+package main
+
+// econ.odin — the `econ-check` harness verb (v2-mechanics-the-box, record
+// open questions 1-4 + 7): the L5 calibration evidence generator. A
+// deterministic GREEDY-EXPANSIVE bot (the record's expansive builder: big
+// swings, then cannibalize-and-redeploy) plays the REAL catalog across four
+// scenarios and reports the economy's observable shape:
+//
+//   era1-calm    — the era-1 kit is fat: the ceiling never speaks (calm).
+//   era2-brush   — the era-2 phase brushes the ceiling gently: a handful of
+//                  refusal EPISODES across the phase, each self-resolving as
+//                  a dot lands (ruling 7's authored brush).
+//   era3-slope   — demand growth outruns restore: refusals arrive regularly
+//                  (the bind is a slope inside the era, not a boundary step).
+//   crisis-stall — a different seed's demand shape stresses the clock: the
+//                  dot interval must stay inside [floor, base] (never slower
+//                  than the known spine, never faster than the floor) and
+//                  teardown+dots keep the player rebuilding (Q7: no death
+//                  spiral — the floor absorbs it).
+//
+// Every number printed here rides the PR body (the tuned numbers + runs as
+// evidence, per the record). Deterministic: fixed seeds, fixed spot tables,
+// the real catalogs — same binary, same table.
+
+import pp "../core"
+import "core:fmt"
+
+// Econ_Stats — what a scenario run measures.
+Econ_Stats :: struct {
+	draws_ok:        i32,
+	places_ok:       i32,
+	refusals:        i32,
+	episodes:        i32,
+	first_no_tick:   u64,
+	dot_count:       i32,
+	interval_min:    u64,
+	interval_max:    u64,
+	min_stock:       u32,
+	deliveries:      u64,
+	dots_in_refusal: i32, // dots that landed during a refusal episode (the self-resolution count)
+	piece_starved:   bool, // a placement was refused .Box_Piece_Exhausted (the era-3 PIECE half of the squeeze)
+	in_refusal:      bool, // episode tracker (internal)
+	other_errs:      i32, // debug: span/port/etc. rejections
+}
+
+
+ECON_SPOTS :: [10][2]i32{{6, 15}, {6, 29}, {20, 29}, {34, 29}, {34, 15}, {34, 3}, {20, 3}, {6, 3}, {16, 9}, {26, 9}}
+
+// econ_run_scenario — the greedy bot on the real catalog. Fixed seed, the
+// static fixture (res ← router → host), box on. Expansion: place the spot
+// chain + 2 segments per pair (the chain + 1 parallel — routers are
+// 4-port-capped); sustain: demolish-oldest + redraw its pair
+// (cannibalize-and-redeploy). An action every 2 ticks.
+econ_run_scenario :: proc(cat: ^pp.Catalogs, era: u8, ticks: u64, seed: u64, stats: ^Econ_Stats, name_dbg: string) {
+	s: pp.Run_State
+	defer pp.run_destroy(&s)
+	pp.run_init(&s, seed, cat.hash, cat.balance.logic_hz)
+	s.era = era
+	seed_fixture(&s, cat)
+	s.box_enabled = true
+	pp.box_enable(&s, cat)
+	s.growth_enabled = true // the map grows: demand reach pressure builds
+	// over the run (the real cadence: one terminal per spawn window)
+	stats.interval_min = 1 << 62
+	stats.interval_max = 0
+	stats.min_stock = 1 << 31
+	rt_idx, _ := pp.node_type_index(cat, "router_basic")
+	std_idx, _ := pp.pipe_tier_index(cat, "standard")
+	placed := 0
+	seg_cursor := 0
+	oldest := 0
+	prev_delivered: u64 = 0
+	spot_ids: [16]u32
+	BOX_SEG :: 18 // the 2 fixture legs + 8 pairs × 2 segments
+	seg_pipe: [BOX_SEG]u32 // the CURRENT pipe id per segment (rebuilt segments get new monotonic ids)
+	seg_tier: [BOX_SEG]u16 // the segment's tier (era-3 expansion draws wide — the fiber evidence)
+	wd_idx, _ := pp.pipe_tier_index(cat, "wide")
+	for tick in u64(1)..=ticks {
+		before := len(s.events)
+		pp.step(&s, tick, nil, cat)
+		for e in s.events[before:] {
+			if e.tag == pp.EVENT_TAG_BOX_DOT {
+				stats.dot_count += 1
+				if s.box.dot_interval < stats.interval_min do stats.interval_min = s.box.dot_interval
+				if s.box.dot_interval > stats.interval_max do stats.interval_max = s.box.dot_interval
+				if stats.in_refusal do stats.dots_in_refusal += 1
+			}
+		}
+		clear(&s.events)
+		if s.box.spools[pp.BOX_SPOOL_STANDARD] < stats.min_stock {
+			stats.min_stock = s.box.spools[pp.BOX_SPOOL_STANDARD]
+		}
+		d := econ_delivered_total(&s)
+		if d > prev_delivered {
+			stats.deliveries += d - prev_delivered
+			prev_delivered = d
+		}
+		if tick % 2 != 0 {
+			continue
+		}
+		// the placement half: keep expanding while spots + pieces remain.
+		spots := ECON_SPOTS
+		if placed >= len(spots) && tick % 200 == 0 {
+			// the piece-wall probe: every spot is used — keep PROBING the
+			// piece stock so the era-3 piece bind is observable (a refused
+			// probe is the box saying no on the router half).
+			_, err := pp.box_apply_edit(&s, pp.Command{1, pp.Cmd_Place_Router{type_idx = rt_idx, pos = ECON_SPOTS[0] + [2]i32{1, 1}}}, cat)
+			if err == .Box_Piece_Exhausted {
+				stats.piece_starved = true
+			}
+		}
+		if placed < len(spots) && s.box.pieces[rt_idx] > 0 {
+			pos := spots[placed]
+			res, err := pp.box_apply_edit(&s, pp.Command{1, pp.Cmd_Place_Router{type_idx = rt_idx, pos = pos}}, cat)
+			if err == .Box_Piece_Exhausted {
+				// the era-3 PIECE bind: the box said no on the router half —
+				// the record's "every draw is material off the board".
+				stats.piece_starved = true
+				placed = len(spots) // out of pieces — stop trying
+			} else if err == .None {
+				spot_ids[placed] = res.id // the ACTUAL node id (growth spawns interleave the monotonic ids)
+				placed += 1
+				stats.places_ok += 1
+			} else {
+				placed += 1 // an invalid spot (geometry) — skip it
+			}
+		}
+		a, b: u32
+		tier := std_idx
+		wire_mode := false
+		max_seg := placed * 2 // pairs = placed (fixture link + spot chain)
+		if seg_cursor < max_seg {
+			// the build order: the fixture legs FIRST (res->router, router->
+			// host — so demand actually FLOWS: a sink path exists and the
+			// acceleration has deliveries to read), then the chain pairs —
+			// by RECORDED id (growth spawns interleave the monotonic ids).
+			// Era-3 expansion draws WIDE when the fiber spool affords it —
+			// the spool-mix shift (rulings 6+7) needs calibration evidence.
+			if seg_cursor == 0 {
+				a = 0
+				b = 1
+			} else if seg_cursor == 1 {
+				a = 1
+				b = 2
+			} else {
+				pair := (seg_cursor - 2) / 2
+				a = u32(1)
+				b = spot_ids[0]
+				if pair > 0 && pair < placed {
+					a = spot_ids[pair - 1]
+					b = spot_ids[pair]
+				}
+			}
+			if era >= 3 && seg_cursor >= 2 && s.box.spools[pp.BOX_SPOOL_FIBER] >= 14 {
+				tier = wd_idx
+			}
+		} else if tw_ok, tw_a, tw_b := econ_pick_wire(&s, cat, spot_ids[:], placed); tw_ok {
+			// WIRE: a spawned terminal lacks a line — net-new tiles (the
+			// demand-reach pressure the era ladder is tuned against).
+			a = tw_a
+			b = tw_b
+			wire_mode = true
+		} else {
+			dem := oldest % max_seg
+			// demolish the OLDEST segment by its TRACKED id (rebuilt segments
+			// get new monotonic ids — a raw build-order id would hit a dead
+			// pipe and silently stall the sustain loop), then redraw its pair.
+			pp.box_apply_edit(&s, pp.Command{1, pp.Cmd_Demolish_Pipe{pipe = seg_pipe[dem]}}, cat)
+			if dem == 0 {
+				a = 0
+				b = 1
+			} else if dem == 1 {
+				a = 1
+				b = 2
+			} else {
+				pair := (dem - 2) / 2
+				a = u32(1)
+				b = spot_ids[0]
+				if pair > 0 && pair < placed {
+					a = spot_ids[pair - 1]
+					b = spot_ids[pair]
+				}
+			}
+			tier = seg_tier[dem]
+		}
+		res, err := pp.box_apply_edit(&s, pp.Command{1, pp.Cmd_Draw_Pipe{a = a, b = b, tier = tier}}, cat)
+		if err == .None {
+			stats.draws_ok += 1
+			stats.in_refusal = false
+			if seg_cursor < BOX_SEG {
+				seg_pipe[seg_cursor] = res.id
+				seg_tier[seg_cursor] = tier
+				seg_cursor += 1
+			} else {
+				seg_pipe[oldest % BOX_SEG] = res.id
+				oldest += 1
+			}
+		} else if err == .Router_Ports_Full {
+			// the pair's geometry is exhausted — consume the segment slot and
+			// move on (the wire/sustain phases carry the run's pressure).
+			if seg_cursor < BOX_SEG {
+				seg_cursor += 1
+			} else {
+				oldest += 1
+			}
+		} else if err == .Box_Spool_Exhausted {
+			stats.refusals += 1
+			if !stats.in_refusal {
+				stats.episodes += 1
+				stats.in_refusal = true
+			}
+			if stats.first_no_tick == 0 {
+				stats.first_no_tick = tick
+			}
+		} else {
+			if stats.other_errs < 6 {
+				ka := slot0_kind(&s.topology, a)
+				kb := slot0_kind(&s.topology, b)
+				fmt.eprintfln("  [%s] uncounted draw error tick %d: %v a=%d(%v) b=%d(%v) wire=%v", name_dbg, tick, err, a, ka, b, kb, wire_mode)
+			}
+			stats.other_errs += 1
+		}
+	}
+}
+
+// econ_pick_wire — find a spawned terminal (id > 2) with NO line yet within
+// `max_span` of a placed router: the demand-reach draw (net-new tiles).
+// Returns ok + (router id, terminal id). Deterministic: lowest terminal id,
+// then lowest router id.
+econ_pick_wire :: proc(s: ^pp.Run_State, cat: ^pp.Catalogs, spot_ids: []u32, placed: int) -> (bool, u32, u32) {
+	max_span := 14 // the standard tier's max span (the bot draws standard only)
+	for ts in 0..<len(s.topology.node_alive) {
+		if ts < 3 || !s.topology.node_alive[ts] {
+			continue
+		}
+		if s.topology.node_kind[ts] != .Terminal {
+			continue
+		}
+		// connected already?
+		wired := false
+		for pi in 0..<len(s.topology.pipe_alive) {
+			if !s.topology.pipe_alive[pi] {
+				continue
+			}
+			if s.topology.pipe_a[pi] == s.topology.node_id[ts] || s.topology.pipe_b[pi] == s.topology.node_id[ts] {
+				wired = true
+			}
+		}
+		if wired {
+			continue
+		}
+		// the nearest junction (any) whose ports aren't full
+		best_d := i32(max_span) + 1
+		best_r: u32 = 0
+		for r in 0..<len(s.topology.node_alive) {
+			if !s.topology.node_alive[r] || s.topology.node_kind[r] != .Junction {
+				continue
+			}
+			is_mine := r == 1
+			for k in 0..<placed {
+				if spot_ids[k] == s.topology.node_id[r] {
+					is_mine = true
+				}
+			}
+			if !is_mine {
+				continue // spawned terminals + unplaced ids are not wire anchors
+			}
+			// free port? (canon #14: live pipes per junction ≤ port_capacity)
+			used := 0
+			for pi in 0..<len(s.topology.pipe_alive) {
+				if !s.topology.pipe_alive[pi] {
+					continue
+				}
+				if s.topology.pipe_a[pi] == s.topology.node_id[r] || s.topology.pipe_b[pi] == s.topology.node_id[r] {
+					used += 1
+				}
+			}
+			if used >= int(cat.node_types[s.topology.node_type[r]].port_capacity) {
+				continue
+			}
+			d := pp.span_between_nodes(&s.topology, u32(r), u32(ts))
+			if d <= i32(max_span) && d < best_d {
+				best_d = d
+				best_r = s.topology.node_id[r]
+			}
+		}
+		if best_r != 0 {
+			return true, best_r, s.topology.node_id[ts]
+		}
+	}
+	return false, 0, 0
+}
+
+slot0_kind :: proc(t: ^pp.Topology, id: u32) -> string {
+	for i in 0..<len(t.node_alive) {
+		if t.node_id[i] == id {
+			ka := "dead"
+			if t.node_alive[i] do ka = "alive"
+			if t.node_kind[i] == .Junction do return fmt.tprintf("J(%s)", ka)
+			return fmt.tprintf("T(%s)", ka)
+		}
+	}
+	return "missing"
+}
+
+econ_delivered_total :: proc(s: ^pp.Run_State) -> u64 {
+	t: u64 = 0
+	for i in 0..<len(s.flow.sla) {
+		t += s.flow.sla[i].delivered
+	}
+	return t
+}
+
+econ_check :: proc(cat: ^pp.Catalogs) -> int {
+	fmt.println("econ-check — v2-mechanics-the-box L5 calibration (deterministic; real catalogs)")
+	fmt.println("scenario      ticks  draws  places  refusals  episodes  first_no  dots  interval[min,max]  min_stock  deliveries  dots-in-refusal  piece-starved")
+	fails := 0
+	base := cat.balance.box.dot_interval_ticks
+	floor := cat.balance.box.dot_floor_ticks
+
+	// era1-calm — fat kit: the ceiling never speaks.
+	{
+		stats: Econ_Stats
+		econ_run_scenario(cat, 1, 6000, 42, &stats, "era1-calm")
+		econ_print_row("era1-calm", 6000, &stats)
+		if stats.episodes != 0 {
+			fmt.printf("  FAIL: era-1 must stay calm (0 episodes, got %d)\n", stats.episodes)
+			fails += 1
+		}
+	}
+	// era2-brush — a gentle brush, self-resolving.
+	{
+		stats: Econ_Stats
+		econ_run_scenario(cat, 2, 12000, 42, &stats, "era2-brush")
+		econ_print_row("era2-brush", 12000, &stats)
+		if stats.episodes < 1 || stats.episodes > 8 {
+			fmt.printf("  FAIL: era-2 must brush gently (1..8 episodes, got %d)\n", stats.episodes)
+			fails += 1
+		}
+		if stats.dots_in_refusal == 0 {
+			fmt.println("  FAIL: era-2 brushes must self-resolve (a dot landed mid-shortage)")
+			fails += 1
+		}
+	}
+	// era3-slope — the bind arrives (demand growth outruns restore).
+	{
+		stats: Econ_Stats
+		econ_run_scenario(cat, 3, 24000, 42, &stats, "era3-slope")
+		econ_print_row("era3-slope", 24000, &stats)
+		// the era-3 bind is TWO-SIDED (the record: "every draw is material
+		// off the board"): tile refusals OR the piece wall — either means
+		// the box out-says the player's growth.
+		if stats.episodes < 1 && !stats.piece_starved {
+			fmt.println("  FAIL: era-3 must bind (the slope never spoke — retune the caps/clock)")
+			fails += 1
+		}
+	}
+	// crisis-stall (Q7) — a different demand shape; the clock must hold.
+	{
+		stats: Econ_Stats
+		econ_run_scenario(cat, 3, 24000, 7, &stats, "crisis-stall")
+		econ_print_row("crisis-stall", 24000, &stats)
+		if stats.interval_min < floor {
+			fmt.println("  FAIL: the interval dipped below the floor — the no-soft-lock guarantee broke")
+			fails += 1
+		}
+		if stats.interval_max > base {
+			fmt.println("  FAIL: the interval exceeded the base spine — the worst case is not known")
+			fails += 1
+		}
+		if stats.min_stock == 0 && stats.dot_count == 0 {
+			fmt.println("  FAIL: an empty box with no dots — the death spiral the floor must absorb")
+			fails += 1
+		}
+	}
+	if fails == 0 {
+		fmt.println("econ-check: all scenario verdicts hold")
+		return 0
+	}
+	fmt.printf("econ-check: %d verdict(s) FAILED — retune the era caps / clock, then re-run\n", fails)
+	return 1
+}
+
+econ_print_row :: proc(name: string, ticks: u64, stats: ^Econ_Stats) {
+	imin := stats.interval_min
+	if stats.dot_count == 0 do imin = 0
+	imax := stats.interval_max
+	fmt.printf("%-12s %6d  %5d  %5d  %8d  %8d  %8d  %4d  [%5d,%5d]     %5d    %10d  %4d  %v\n",
+		name, ticks, stats.draws_ok, stats.places_ok, stats.refusals, stats.episodes,
+		stats.first_no_tick, stats.dot_count, imin, imax,
+		stats.min_stock, stats.deliveries, stats.dots_in_refusal, stats.piece_starved)
+}
