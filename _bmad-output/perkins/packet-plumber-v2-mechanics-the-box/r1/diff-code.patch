+package core
+
+// box_test.odin — THE BOX's behavior suite (v2-mechanics-the-box; record open
+// question 8: "a mutation-leg-style gate for the economy … so the tutorial-by-
+// consequence is provable, not vibes"). Pins:
+//
+//   1. the material grammar (rulings 4+6): place costs a held piece, draws
+//      drain the matching spool 1/tile, modernize resplices, teardown refunds
+//      FULLY (unclamped), refusals are atomic (nothing applied, nothing logged);
+//   2. the Cap (ruling 3): era advance raises + restores-to-cap, refills never
+//      push past (no banking), refunds may ride above cap until the next dot;
+//   3. the clock (ruling 5): dots restore + reschedule on the spine; delivery
+//      acceleration clamps to [floor, base]; the floor is ABSOLUTE (the
+//      no-soft-lock guarantee — never gated on performance);
+//   4. replay determinism (E10): a box-on run replays byte-identical;
+//   5. THE ECONOMY GATES THAT CAN FAIL: a deterministic greedy-expansive bot
+//      (build big, then cannibalize-and-redeploy — the record's expansive
+//      builder) hears the ceiling's "no" only when the box is genuinely
+//      empty, hears it in EPISODES (never refusal spam), and self-resolves
+//      as the dot lands — and the gate DETECTS its own mutation legs
+//      (delete-the-cap, drop-the-floor).
+//
+// Fixture: test_catalog + a box clock {base 400, floor 100, accel 1} + era
+// caps re-shaped to the canon GRADIENT in miniature (era 1: 8 basic pieces /
+// 48 standard tiles / no fiber; era 2 raises pieces + opens fiber; era 3 adds
+// mid/high + leans fiber — non-decreasing per type, the load contract's
+// shape). Small caps keep the gates fast; the doctrine-level cadence runs in
+// the L5 harness econ-check against the REAL catalogs.
+
+import "core:testing"
+
+BOX_TEST_BASE :: u64(400)
+BOX_TEST_FLOOR :: u64(100)
+BOX_TEST_ACCEL :: u64(1)
+BOX_FIX_PIECES :: u32(8) // era-1 basic pieces at cap
+BOX_FIX_TILES :: u32(48) // era-1 standard tiles at cap
+
+// box_test_catalog — the shared fixture catalog (era caps re-shaped to the
+// canon gradient in miniature).
+box_test_catalog :: proc(cat: ^Catalogs, allocator := context.allocator) -> ^Catalogs {
+	test_catalog(cat, allocator)
+	cat.balance.box = Box_Balance{
+		dot_interval_ticks           = BOX_TEST_BASE,
+		dot_floor_ticks              = BOX_TEST_FLOOR,
+		dot_accel_ticks_per_delivery = BOX_TEST_ACCEL,
+	}
+	// the fixture's hand-built tiers carry no spool (test_catalog predates
+	// the Box) — resolve the tech classes here or every tier prices as
+	// standard and the resplice grammar silently vanishes.
+	wd, ok_wd := pipe_tier_index(cat, "wide")
+	if !ok_wd do panic("box_test_catalog: no wide tier")
+	cat.pipe_tiers[wd].spool = BOX_SPOOL_FIBER
+	rt, ok_rt := node_type_index(cat, "router_basic")
+	rm, ok_rm := node_type_index(cat, "router_mid")
+	rh, ok_rh := node_type_index(cat, "router_high")
+	if !ok_rt || !ok_rm || !ok_rh do panic("box_test_catalog: junction types missing")
+	for era in 0..<len(cat.eras) {
+		cat.eras[era].box_pieces[rt] = 8
+		cat.eras[era].box_pieces[rm] = 0
+		cat.eras[era].box_pieces[rh] = 0
+		cat.eras[era].box_spools[BOX_SPOOL_STANDARD] = BOX_FIX_TILES
+		cat.eras[era].box_spools[BOX_SPOOL_FIBER] = 0
+	}
+	// era 2 raises pieces + opens fiber; era 3 adds the mid/high kit + leans
+	// fiber (non-decreasing per type — ruling 3's load contract, mirrored).
+	cat.eras[1].box_pieces[rt] = 12
+	cat.eras[1].box_spools[BOX_SPOOL_FIBER] = 40
+	cat.eras[2].box_pieces[rt] = 12
+	cat.eras[2].box_pieces[rm] = 4
+	cat.eras[2].box_pieces[rh] = 2
+	cat.eras[2].box_spools[BOX_SPOOL_FIBER] = 200
+	return cat
+}
+
+// box_test_run — a fresh era-`era` run with the static fixture (res ← router
+// → host) and the Box enabled (the starting kit restored at setup).
+box_test_run :: proc(s: ^Run_State, seed: u64, era: u8, cat: ^Catalogs) -> (u32, u32, u32) {
+	run_init(s, seed, cat.hash, TEST_LOGIC_HZ)
+	s.era = era
+	res, rt, host := test_seed_fixture(s, cat)
+	box_enable(s, cat)
+	return res, rt, host
+}
+
+box_rt_idx :: proc(cat: ^Catalogs) -> u16 {
+	i, ok := node_type_index(cat, "router_basic")
+	if !ok do panic("box_test: no router_basic")
+	return i
+}
+box_mid_idx :: proc(cat: ^Catalogs) -> u16 {
+	i, ok := node_type_index(cat, "router_mid")
+	if !ok do panic("box_test: no router_mid")
+	return i
+}
+box_std_idx :: proc(cat: ^Catalogs) -> u16 {
+	i, ok := pipe_tier_index(cat, "standard")
+	if !ok do panic("box_test: no standard tier")
+	return i
+}
+box_wd_idx :: proc(cat: ^Catalogs) -> u16 {
+	i, ok := pipe_tier_index(cat, "wide")
+	if !ok do panic("box_test: no wide tier")
+	return i
+}
+
+// box_apply_cmd — the fast-path apply used throughout (what the app's
+// Command_Bus does): box_apply_edit, and on success log at the next tick.
+box_apply_cmd :: proc(s: ^Run_State, kind: Command_Kind, cat: ^Catalogs) -> Edit_Error {
+	_, err := box_apply_edit(s, Command{apply_tick = s.tick + 1, kind = kind}, cat)
+	return err
+}
+
+// ---------------------------------------------------------------- the flag --
+
+@test
+test_box_disabled_is_legacy_delegate :: proc(t: ^testing.T) {
+	cat: Catalogs
+	defer catalogs_destroy(&cat)
+	box_test_catalog(&cat)
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 1, cat.hash, TEST_LOGIC_HZ)
+	res, rt, host := test_seed_fixture(&s, &cat)
+	// box-OFF (the zero value): builds are free — the shipped behavior.
+	err := box_apply_cmd(&s, Cmd_Place_Router{type_idx = box_rt_idx(&cat), pos = {20, 19}}, &cat)
+	testing.expect(t, err == .None, "box-off placement must be free")
+	err = box_apply_cmd(&s, Cmd_Draw_Pipe{a = res, b = rt, tier = box_std_idx(&cat)}, &cat)
+	testing.expect(t, err == .None, "box-off draw must be free")
+	testing.expect(t, !s.box_enabled, "box must stay disabled")
+	testing.expect(t, len(s.box.pieces) == 0 && len(s.box.spools) == 0, "a disabled box owns no stock arrays")
+	testing.expect(t, len(s.topology.pipe_alive) == 1, "the draw applied")
+	_ = host
+}
+
+@test
+test_box_enable_grants_the_starting_kit :: proc(t: ^testing.T) {
+	cat: Catalogs
+	defer catalogs_destroy(&cat)
+	box_test_catalog(&cat)
+	s: Run_State
+	defer run_destroy(&s)
+	box_test_run(&s, 1, 1, &cat)
+	testing.expect(t, s.box_enabled, "box enabled")
+	testing.expect(t, s.box.pieces[box_rt_idx(&cat)] == BOX_FIX_PIECES, "era-1 basic pieces at cap")
+	testing.expect(t, s.box.spools[BOX_SPOOL_STANDARD] == BOX_FIX_TILES, "era-1 standard tiles at cap")
+	testing.expect(t, s.box.spools[BOX_SPOOL_FIBER] == 0, "era-1 fiber is empty")
+	testing.expect(t, s.box.next_dot_tick == BOX_TEST_BASE, "the first dot rides the spine from setup")
+}
+
+// ------------------------------------------------------- the material grammar --
+
+@test
+test_box_draw_drains_and_place_costs :: proc(t: ^testing.T) {
+	cat: Catalogs
+	defer catalogs_destroy(&cat)
+	box_test_catalog(&cat)
+	s: Run_State
+	defer run_destroy(&s)
+	res, rt, host := box_test_run(&s, 1, 1, &cat)
+	// the canonical 12-tile draw (the fixture's res→router leg).
+	err := box_apply_cmd(&s, Cmd_Draw_Pipe{a = res, b = rt, tier = box_std_idx(&cat)}, &cat)
+	testing.expect(t, err == .None, "an affordable draw applies")
+	testing.expect(t, s.box.spools[BOX_SPOOL_STANDARD] == BOX_FIX_TILES - 12, "the spool drained exactly the span")
+	testing.expect(t, len(s.topology.pipe_alive) == 1, "the pipe is live")
+	// placement spends a piece of the chosen tier.
+	err = box_apply_cmd(&s, Cmd_Place_Router{type_idx = box_rt_idx(&cat), pos = {20, 19}}, &cat)
+	testing.expect(t, err == .None, "an affordable placement applies")
+	testing.expect(t, s.box.pieces[box_rt_idx(&cat)] == BOX_FIX_PIECES - 1, "the placement spent one basic piece")
+	_ = host
+}
+
+@test
+test_box_refusals_are_atomic :: proc(t: ^testing.T) {
+	cat: Catalogs
+	defer catalogs_destroy(&cat)
+	box_test_catalog(&cat)
+	s: Run_State
