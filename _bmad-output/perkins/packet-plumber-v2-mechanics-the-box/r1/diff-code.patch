+	s: Run_State
+	defer run_destroy(&s)
+	res, rt, host := box_test_run(&s, 11, 1, &cat)
+	append(&s.action_log, Command{apply_tick = 2, kind = Cmd_Draw_Pipe{a = res, b = rt, tier = box_std_idx(&cat)}})
