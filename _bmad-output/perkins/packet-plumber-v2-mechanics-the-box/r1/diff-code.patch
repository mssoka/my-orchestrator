diff --git a/core/box.odin b/core/box.odin
new file mode 100644
index 0000000..ce9cd1e
--- /dev/null
+++ b/core/box.odin
@@ -0,0 +1,366 @@
+package core
+
+import "core:fmt"
+
+// box.odin — THE BOX (mechanics-quinn record, rulings 2+3+4+5+6; job
+// packet-plumber-v2-mechanics-the-box). The build layer's material authority:
+// the player holds TYPED PIECES — router pieces by junction node-type
+// (rulings 2+4: the knights-and-bishops grammar) and pipe tiles on two SPOOLS
+// (ruling 6: standard | fiber, drained 1/tile by the matching tier) — against
+// an ERA CEILING (ruling 3: the caps on Era_Row; era advance RAISES the cap
+// and a restore brings stock TO it, never past — no banking). Refill DOTS
+// restore-to-cap on a KNOWN clock spine (ruling 5), accelerated by deliveries
+// since the last dot, clamped [floor, base] — the floor is the no-soft-lock
+// guarantee and is NEVER gated on performance; the base interval is the
+// ceiling (a crisis-stalled run rides the spine, never slower — the Q7
+// death-spiral answer). Teardown refunds EVERYTHING, unclamped (the full-
+// refund ruling; "cannibalize-and-redeploy is always available, never free —
+// the surge runs while you rebuild").
+//
+// Promotion (ruling 4) needs NO new verb: a router "swap" is demolish (the
+// piece returns) + place the higher tier (a piece is spent) — lifetime cost
+// equals place-big-first by construction. The pipe modernize (Cmd_Set_Pipe_
+// Tier) resplices spools: the new tier's tiles drain the matching spool, the
+// old tier's tiles refund theirs. Only tiers you HOLD are placeable
+// (.Box_Piece_Exhausted) — the single biggest behavioral change vs shipped
+// free tiering, ruled in with eyes open.
+//
+// Determinism (the spine): every proc here is a pure function of serialized
+// state + catalogs + the command stream. The Box gates the SAME validate-
+// then-apply path the replay uses (box_apply_edit wraps topology_apply_edit),
+// so live edits and replay drain/refund identically (E10). state.box_enabled
+// is run setup (like health_enabled/growth_enabled — never serialized); the
+// box section serializes absent-when-disabled, so box-off runs write zero
+// bytes and every legacy golden stays byte-identical modulo the catalog fold.
+
+// box_make / box_destroy — the Box lifetime (mirrors era_gate_make; the
+// arrays stay len-0 until box_enable grows them — a disabled box owns
+// nothing, the zero-value discipline).
+box_make :: proc(b: ^Box_State, allocator := context.allocator) {
+	b^ = {}
+}
+
+box_destroy :: proc(b: ^Box_State) {
+	delete(b.pieces)
+	delete(b.spools)
+}
+
+// box_enable — run setup for a box-on run (the app's start_run / the harness
+// Run_Config; NEVER called mid-run — the Box is setup, like the fixture).
+// Grows the stock arrays, schedules the first dot on the spine, and restores
+// stock to the START era's caps (era 1 is felt-not-counted: the player opens
+// the run holding the full era kit — ruling 7's fat caps).
+box_enable :: proc(state: ^Run_State, cat: ^Catalogs) {
+	// fail loud (never a silent zero-kit run — an era_row miss here would
+	// read as a permanent empty box: dots firing into a box that restores
+	// nothing). A caller passing an era outside the table is a setup bug.
+	if _, ok := era_row(cat, state.era); !ok {
+		panic("box_enable: the run's era has no catalog row — the Box cannot grant a kit")
+	}
+	state.box_enabled = true
+	box_grow(&state.box, cat)
+	box_restore_to_cap(state, cat)
+	state.box.dot_interval = cat.balance.box.dot_interval_ticks
+	state.box.next_dot_tick = state.tick + cat.balance.box.dot_interval_ticks
+	state.box.delivered_baseline = box_total_delivered(state)
+}
+
+// box_grow — size the stock arrays to the catalog (idempotent).
+box_grow :: proc(b: ^Box_State, cat: ^Catalogs) {
+	if len(b.pieces) < len(cat.node_types) {
+		old := len(b.pieces)
+		resize(&b.pieces, len(cat.node_types))
+		for i in old..<len(b.pieces) {
+			b.pieces[i] = 0
+		}
+	}
+	if len(b.spools) < BOX_SPOOL_COUNT {
+		old := len(b.spools)
+		resize(&b.spools, BOX_SPOOL_COUNT)
+		for i in old..<len(b.spools) {
+			b.spools[i] = 0
+		}
+	}
+}
+
+// box_restore_to_cap — the refill (rulings 2+3+5): bring every type UP to its
+// current-era cap, never past it (no banking — a refund overshoot above cap
+// is left alone, never destroyed; refills from below clamp exactly at cap).
+box_restore_to_cap :: proc(state: ^Run_State, cat: ^Catalogs) {
+	row, ok := era_row(cat, state.era)
+	if !ok {
+		return
+	}
+	box_grow(&state.box, cat)
+	for t in 0..<len(state.box.pieces) {
+		cap: u32 = 0
+		if t < len(row.box_pieces) {
+			cap = row.box_pieces[t]
+		}
+		if state.box.pieces[t] < cap {
+			state.box.pieces[t] = cap
+		}
+	}
+	for s in 0..<len(state.box.spools) {
+		cap: u32 = 0
+		if s < len(row.box_spools) {
+			cap = row.box_spools[s]
+		}
+		if state.box.spools[s] < cap {
+			state.box.spools[s] = cap
+		}
+	}
+}
+
+// box_on_era_advance — the crazyhouse rule (ruling 3): "era = new-bigger-set
+// moment". Called from era_step's fire path AFTER the era flip, so the caps
+// read are the NEW era's. The clock spine is untouched (tempo is era-
+// independent; the restore is the advance's own material event).
+box_on_era_advance :: proc(state: ^Run_State, cat: ^Catalogs) {
+	if !state.box_enabled {
+		return
+	}
+	box_restore_to_cap(state, cat)
+}
+
+// Box_Charge_Snapshot — the PRE-APPLY material data box_charge prices from.
+// The charge runs AFTER topology_apply_edit has mutated the topology, so any
+// pre-edit fact (the resplice's OLD tier; a junction demolish's incident-pipe
+// set) must be captured in box_validate and carried through — reading it
+// post-apply silently zeroes the resplice swap and the batch refund.
+Box_Charge_Snapshot :: struct {
+	old_tier:   u16, // Set_Pipe_Tier: the pipe's tier BEFORE the tier-up
+	dp_tier:    u16, // Demolish_Pipe: the pipe's tier BEFORE the tombstone (pipe_slot skips dead pipes — the charge must not re-look-up)
+	dp_span:    i32, // Demolish_Pipe: the pipe's cached span (same post-apply hazard)
+	dn_type:    u16, // Demolish_Node: the junction's node-type (post-apply the node is dead — node_slot skips it)
+	dn_pieces:  u32, // Demolish_Node: the junction's piece (0 = not a node demolish)
+	dn_spools:  [BOX_SPOOL_COUNT]u32, // Demolish_Node: incident tiles per spool
+}
+
+// box_apply_edit — the ONE entry point for player edits on a run (replay +
+// the app fast-path): material legality (the Box) wrapped around the
+// topology's validate-then-apply, then the charge/refund. Order is fixed:
+// box_validate (material) -> topology_apply_edit (topology legality + apply)
+// -> box_charge (drain/refund). A command that is not priceable (unknown
+// tier/node id) passes the Box untouched so the TOPOLOGY authority reports
+// its own canonical error — the Box never shadows a malformed command with a
+// material one. Disabled = pure delegate (byte-identical legacy behavior).
+//
+// Cmd_Era_Advance is not a topology edit and spends no material — it latches
+// exactly as step's replay loop always has (the fire, and the advance-time
+// restore, live in era_step).
+box_apply_edit :: proc(state: ^Run_State, cmd: Command, cat: ^Catalogs) -> (Edit_Result, Edit_Error) {
+	if !state.box_enabled {
+		#partial switch c in cmd.kind {
+		case Cmd_Era_Advance:
+			if e := era_advance_validate(state, c, cat); e != .None {
+				return {}, e
+			}
+			era_advance_latch(state, c)
+			return {}, .None
+		case:
+			return topology_apply_edit(&state.topology, cmd, cat)
+		}
+	}
+	snap: Box_Charge_Snapshot
+	if e := box_validate(state, cmd, cat, &snap); e != .None {
+		return {}, e
+	}
+	#partial switch c in cmd.kind {
+	case Cmd_Era_Advance:
+		if e := era_advance_validate(state, c, cat); e != .None {
+			return {}, e
+		}
+		era_advance_latch(state, c)
+		return {}, .None
+	case:
+		res, err := topology_apply_edit(&state.topology, cmd, cat)
+		if err != .None {
+			return res, err
+		}
+		box_charge(state, cmd, cat, &snap)
+		return res, .None
+	}
+}
+
+// box_validate — the material leg (rulings 4+6): can the player AFFORD this?
+// Every check here is paired with the identical pricing in box_charge below —
+// keep the two in lockstep (the pair is the invariant the tests pin: a
+// validated command never underflows a counter in charge).
+box_validate :: proc(state: ^Run_State, cmd: Command, cat: ^Catalogs, snap: ^Box_Charge_Snapshot) -> Edit_Error {
+	t := &state.topology
+	#partial switch c in cmd.kind {
+	case Cmd_Draw_Pipe:
+		if u32(c.tier) >= u32(len(cat.pipe_tiers)) {
+			return .None // unpriceable — validate_draw reports .Unknown_Tier
+		}
+		sa, oka := node_slot(t, c.a)
+		sb, okb := node_slot(t, c.b)
+		if !oka || !okb {
+			return .None // unpriceable — validate_draw reports .Missing_Node
+		}
+		span := span_between(t.node_pos[sa], t.node_pos[sb])
+		if u64(state.box.spools[cat.pipe_tiers[c.tier].spool]) < u64(span) {
+			return .Box_Spool_Exhausted
+		}
+	case Cmd_Place_Router:
+		if u32(c.type_idx) >= u32(len(cat.node_types)) {
+			return .None // unpriceable — validate_place reports .Unknown_Node_Type
+		}
+		if cat.node_types[c.type_idx].kind != .Junction {
+			return .None // unpriceable — validate_place reports .Not_A_Junction
+		}
+		if state.box.pieces[c.type_idx] < 1 {
+			return .Box_Piece_Exhausted
+		}
+	case Cmd_Set_Pipe_Tier:
+		if u32(c.tier) >= u32(len(cat.pipe_tiers)) {
+			return .None // unpriceable — validate_set_pipe_tier reports .Unknown_Tier
+		}
+		slot, ok := pipe_slot(t, c.pipe)
+		if !ok {
+			return .None // unpriceable — the topology reports .Missing_Pipe
+		}
+		// the resplice: the NEW tier's tiles drain the new spool (the old
+		// tier's tiles refund unconditionally — a refund can never fail).
+		// SAME-SPOOL resplices (mid->wide, both fiber) are NET-ZERO — drain
+		// and refund the identical span — so they price at zero and must
+		// never refuse on a short spool (a pointless refusal would be a
+		// false "no" — the FORGE #2 tripwire's cousin).
+		if cat.pipe_tiers[c.tier].spool != cat.pipe_tiers[t.pipe_tier[slot]].spool {
+			if u64(state.box.spools[cat.pipe_tiers[c.tier].spool]) < u64(t.pipe_span[slot]) {
+				return .Box_Spool_Exhausted
+			}
+		}
+		snap.old_tier = t.pipe_tier[slot] // PRE-apply tier (charge reads post-apply)
+	case Cmd_Demolish_Pipe:
+		slot, ok := pipe_slot(t, c.pipe)
+		if !ok {
+			return .None // unpriceable — the topology reports .Missing_Pipe
+		}
+		// teardown is always affordable (a refund can never fail) — the
+		// snapshot exists so the CHARGE prices the RIGHT pipe post-tombstone
+		// (pipe_slot skips dead pipes; a post-apply re-look-up would fall
+		// back to slot 0 and refund the wrong tier/span — the node-demolish
+		// hazard's pipe-side twin).
+		snap.dp_tier = t.pipe_tier[slot]
+		snap.dp_span = t.pipe_span[slot]
+	case Cmd_Demolish_Node:
+		slot, ok := node_slot(t, c.node)
+		if !ok {
+			return .None // unpriceable — the topology reports .Missing_Node
+		}
+		// the atomic batch: snapshot the refund (the piece + every incident
+		// LIVE pipe's tiles) BEFORE the apply tombstones them.
+		snap.dn_pieces = 1
+		snap.dn_type = t.node_type[slot]
+		for pi in 0..<len(t.pipe_alive) {
+			if !t.pipe_alive[pi] {
+				continue
+			}
+			_, is_end := pipe_other(t, u32(pi), c.node)
+			if is_end {
+				snap.dn_spools[cat.pipe_tiers[t.pipe_tier[pi]].spool] += u32(t.pipe_span[pi])
+			}
+		}
+	case:
+	}
+	return .None
+}
+
+// box_charge — the material movement for an APPLIED command (box_validate
+// passed + topology_apply_edit succeeded). Draws/placements drain; teardown
+// refunds FULLY (ruling 2) and is NEVER clamped — a refund may push stock
+// above the era cap (the next dot's restore-to-cap simply no-ops while stock
+// rides high). The junction-demolish batch refunds the router piece + every
+// incident pipe's tiles in slot order (the same scan apply_demolish_node
+// uses, so replay charges identically).
+box_charge :: proc(state: ^Run_State, cmd: Command, cat: ^Catalogs, snap: ^Box_Charge_Snapshot) {
+	t := &state.topology
+	#partial switch c in cmd.kind {
+	case Cmd_Draw_Pipe:
+		sa := node_slot_raw(t, c.a)
+		sb := node_slot_raw(t, c.b)
+		span := span_between(t.node_pos[sa], t.node_pos[sb])
+		state.box.spools[cat.pipe_tiers[c.tier].spool] -= u32(span)
+	case Cmd_Place_Router:
+		state.box.pieces[c.type_idx] -= 1
+	case Cmd_Set_Pipe_Tier:
+		slot, _ := pipe_slot(t, c.pipe)
+		span := t.pipe_span[slot]
+		state.box.spools[cat.pipe_tiers[c.tier].spool] -= u32(span)
+		state.box.spools[cat.pipe_tiers[snap.old_tier].spool] += u32(span)
+	case Cmd_Demolish_Pipe:
+		state.box.spools[cat.pipe_tiers[snap.dp_tier].spool] += u32(snap.dp_span)
+	case Cmd_Demolish_Node:
+		slot, _ := node_slot(t, c.node)
+			state.box.pieces[snap.dn_type] += snap.dn_pieces
+		for s in 0..<len(state.box.spools) {
+			state.box.spools[s] += snap.dn_spools[s]
+		}
+	case:
+	}
+}
+
+// box_step — the refill clock (ruling 5). Called from core.step AFTER
+// era_step (a same-tick advance+dot: the advance restores to the NEW caps
+// first; the dot then no-ops or tops up — one deterministic order). Fires at
+// most one dot per step (ticks are contiguous; a dot reschedules the next at
+// its fire tick). The interval the NEXT dot rides is decided HERE from the
+// deliveries since the LAST dot — the known worst case: the player can always
+// read when the dot lands (the schedule never moves mid-interval), and a
+// zero-delivery interval rides the BASE spine (a crisis can slow the EARNED
+// acceleration, never the guarantee — the floor is absolute, the base is the
+// ceiling).
+box_step :: proc(state: ^Run_State, tick: u64, cat: ^Catalogs) {
+	if !state.box_enabled {
+		return
+	}
+	if tick < state.box.next_dot_tick {
+		return
+	}
+	box_restore_to_cap(state, cat)
+	event_emit(state, tick, EVENT_TAG_BOX_DOT)
+	delivered_now := box_total_delivered(state)
+	d := delivered_now - state.box.delivered_baseline
+	state.box.delivered_baseline = delivered_now
+	bb := cat.balance.box
+	interval := bb.dot_interval_ticks
+	if d > 0 {
+		pull := d * bb.dot_accel_ticks_per_delivery
+		if pull > interval - bb.dot_floor_ticks {
+			pull = interval - bb.dot_floor_ticks
+		}
+		interval -= pull
+	}
+	state.box.dot_interval = interval
+	state.box.next_dot_tick = tick + interval
+}
+
+// box_total_delivered — the delivery counter the acceleration reads: the sum
+// of the flow's cumulative per-class SLA delivered accumulators. Derived
+// (never serialized in the box — the accumulators themselves ride the T1
+// hash; the box pins only the baseline diff anchor).
+box_total_delivered :: proc(state: ^Run_State) -> u64 {
+	total: u64 = 0
+	for i in 0..<len(state.flow.sla) {
+		total += state.flow.sla[i].delivered
+	}
+	return total
+}
+
+// box_dot_progress_permille — the HUD's next-dot progress (0..1000): how far
+// the current dot interval has run. A pure read of serialized state (the
+// schedule never moves mid-interval — the glanceable contract). 0 when the
+// interval is degenerate (never in a loaded catalog: interval >= 1).
+box_dot_progress_permille :: proc(state: ^Run_State) -> u32 {
+	if state.box.dot_interval == 0 || state.tick >= state.box.next_dot_tick {
+		return 0
+	}
+	left := state.box.next_dot_tick - state.tick
+	if left >= state.box.dot_interval {
+		return 0
+	}
+	run := state.box.dot_interval - left
+	return u32(run * 1000 / state.box.dot_interval)
+}
