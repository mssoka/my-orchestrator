+	append(&s.action_log, Command{apply_tick = 14, kind = Cmd_Era_Advance{to_era = 2}})
+	hashes := record_run(&s, 900, &cat)
+	// the replay: a fresh state, the same setup + the cloned log.
+	r: Run_State
+	defer run_destroy(&r)
