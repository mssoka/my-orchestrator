+	// the ruling: the SHIPPED build starts at Foundations (1). PP_DEBUG
+	// builds pin the streaming-surge override (=3) - the sanctioned debug
+	// path (Perkins r4 B5: the ==1 leg must not fire under PP_DEBUG).
+	when #config(PP_DEBUG, false) {
+		testing.expectf(t, app_start_era() == APP_ERA, "the PP_DEBUG override must pin the streaming-surge start (got %d)", app_start_era())
+		testing.expectf(t, app.state.era == APP_ERA, "the debug override must open the run at the streaming-surge era (got %d)", app.state.era)
+	} else {
+		testing.expectf(t, app_start_era() == u8(1), "the shipped start era must be Foundations (1), got %d", app_start_era())
+		testing.expectf(t, app.state.era == u8(1), "start_run must open the run at the ruling start era (got %d)", app.state.era)
+	}
 	testing.expect(t, app.state.advance_gate_enabled, "the 6.2 advance gate must be LIVE (normal era progression - the Streaming Surge arrives by playing)")
 	testing.expect(t, app.state.box_enabled, "the Box must be enabled (the economy is the ruling's subject)")
