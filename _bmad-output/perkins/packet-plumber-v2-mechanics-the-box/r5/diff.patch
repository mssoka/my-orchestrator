 	// kit grant reads them; box_enable fails loud on a missing row, by
 	// design). Rows run to APP_ERA so PP_DEBUG override builds work too.
-	rt_idx := u16(1) // the fixture's node_types: residential(0), router_basic(1)
+	rt_i, rt_ok := pp.node_type_index(&app.cat, "router_basic")
+	if !rt_ok do panic("pullback fixture: no router_basic")
+	rt_idx := u16(rt_i)
 	for e in 1..=APP_ERA {
 		er := pp.Era_Row{era = u8(e), id = fmt.tprintf("t%d", e)}
 		er.box_pieces = make([dynamic]u32, len(app.cat.node_types))
@@ -557,8 +559,16 @@ start_run_wires_the_ruling_start_era_and_the_advance_gate :: proc(t: ^testing.T)
 	app.run_live = true
 	app.cat.balance.logic_hz = 20
 	start_run(&app, 42)
-	testing.expectf(t, app_start_era() == u8(1), "the shipped start era must be Foundations (1), got %d", app_start_era())
