diff --git a/harness/econ_test.odin b/harness/econ_test.odin
new file mode 100644
index 0000000..05f88ff
--- /dev/null
+++ b/harness/econ_test.odin
@@ -0,0 +1,26 @@
+package main
+
+// econ_test.odin — the W3 (Perkins r3/r4) automation leg: the econ gate's
+// VACUITY premise pinned as a unit test (the CI step runs the full verb;
+// this row pins the mechanism in the standard suite — a silent episode-free
+// era-2 run can never ship green again).
+
+import "core:fmt"
+import "core:testing"
+import pp "../core"
+
+@(test)
+test_econ_era2_brush_bites :: proc(t: ^testing.T) {
+	cat: pp.Catalogs
+	defer pp.catalogs_destroy(&cat)
+	if e := load_catalogs(&cat); e != "" {
+		fmt.eprintfln("econ unit: catalog load failed: %s", e)
+		return
+	}
+	stats: Econ_Stats
+	econ_run_scenario(&cat, 2, 12000, 42, &stats, "era2-brush-unit")
+	testing.expectf(t, stats.crises >= 0, "sanity")
+	testing.expectf(t, stats.refusals > 0, "the era-2 brush produced no refusals — the ceiling never spoke (dead gate)")
+	testing.expectf(t, stats.episodes >= 1 && stats.episodes <= 8, "brush episodes out of band: %d", stats.episodes)
+	testing.expect(t, stats.dots_in_refusal > 0, "no dot landed during a refusal episode — the self-resolution is gone")
+}
