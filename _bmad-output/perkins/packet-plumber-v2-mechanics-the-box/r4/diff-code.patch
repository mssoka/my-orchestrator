+@test
+test_box_check_ghost_matches_commit_box_on :: proc(t: ^testing.T) {
+	cat: Catalogs
+	defer catalogs_destroy(&cat)
+	box_test_catalog(&cat)
+	s: Run_State
+	defer run_destroy(&s)
+	res, rt, host := box_test_run(&s, 1, 1, &cat)
+	// W1: the ghost (box_check_draw) and the commit (box_apply_edit) must
+	// AGREE — the same draw priced .None then drains exactly the priced span.
+	cand := Cmd_Draw_Pipe{a = res, b = rt, tier = box_std_idx(&cat)}
+	testing.expect(t, box_check_draw(&s, cand, &cat) == .None, "an affordable draw prices clean")
+	before := s.box.spools[BOX_SPOOL_STANDARD]
+	err := box_apply_cmd(&s, cand, &cat)
+	testing.expect(t, err == .None, "the commit applies")
+	testing.expect(t, before-s.box.spools[BOX_SPOOL_STANDARD] == 12, "the commit drained exactly the priced span")
+	// a SHORT spool: the ghost refuses with the SAME error the commit would
+	// produce, and refuses BEFORE any state moves.
+	s.box.spools[BOX_SPOOL_STANDARD] = 2
+	testing.expectf(t, box_check_draw(&s, cand, &cat) == .Box_Spool_Exhausted,
+		"the ghost must refuse a draw the commit would refuse")
+	// W1b: box_check_place — an unheld tier refuses, a held tier prices clean.
+	testing.expect(t, box_check_place(&s, Cmd_Place_Router{type_idx = box_mid_idx(&cat), pos = {20, 19}}, &cat) == .Box_Piece_Exhausted,
+		"the placement ghost refuses an unheld tier")
+	testing.expect(t, box_check_place(&s, Cmd_Place_Router{type_idx = box_rt_idx(&cat), pos = {20, 19}}, &cat) == .None,
+		"the placement ghost prices a held tier clean")
+	_ = host
+}
