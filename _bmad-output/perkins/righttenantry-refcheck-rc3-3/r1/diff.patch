+}
+
+fn character_questions() -> List(Question) {
+  [
+    identity_question(),
+    Question(
+      id: "relationship_capacity",
+      control: ShortTextPair,
+      required: True,
+      draft_keys: ["relationship", "capacity"],
+      text: form_copy.q_relationship_capacity,
+    ),
+    Question(
+      id: "known_duration",
+      control: Choice([
+        #("lt_1_year", form_copy.opt_lt_1_year),
+        #("y1_3", form_copy.opt_1_to_3_years),
+        #("y3_10", form_copy.opt_3_to_10_years),
