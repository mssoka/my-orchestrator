+//// The per-slot referee-question registry (Story RC3.3) — pure data + pure
+//// functions. One ordered list per ref slot (previous-landlord 11, employer
+//// 8, character 5, UX §6.5); the views, the answer validators, and the
+//// resume logic all read from this single source so they can never drift.
+////
+//// Copy lives in `form_copy.gleam` (the registry references its functions);
+//// the draft-entry shapes here are the A2 `draft_answers` contract rc3-4's
+//// structurer consumes (pinned in the story spec):
+////   choice answers     -> {"key": "<wire value>"}
+////   tenancy_period     -> {"from":"YYYY-MM","to":"YYYY-MM"} | {"from":...,"ongoing":true}
+////   rent_amount        -> {"amount_eur":"1400"} | {"dont_remember":true}
+////   as-stated text     -> {"as_stated":true} | {"differs":"..."} | {"stated":"..."}
+////   salary             -> {"as_stated":true} | {"different_amount_eur":"..."} | {"dont_know":true}
+////   character capacity -> {"relationship":"...","capacity":"..."}
+//// An OPTIONAL question answered with nothing stores an empty string —
+//// absence means "unanswered" (resume), "" means "deliberately skipped".
+
+import gleam/dict
+import gleam/dynamic.{type Dynamic}
+import gleam/dynamic/decode
+import gleam/int
+import gleam/json.{type Json}
+import gleam/list
+import gleam/option.{type Option, None, Some}
+import gleam/order
+import gleam/result
+import gleam/string
+import reference_checks/form_copy
+import shared/reference_call.{
+  type RefSlot, CharacterRef, EmployerRef, LandlordRef,
+}
+
+/// Raw answer fields arrive as a string dict: `a_*` answer inputs plus
+/// `_`-prefixed internals (`_question`, `_website`, `_form_loaded_at`,
+/// `_focus_seconds`) that never reach this module. The no-JS form POST and
+/// the JS autosave PUT both normalize to this shape before validation.
+/// Why an answer failed validation — the handler maps it to the inline
+/// error copy (Required -> "needs an answer"; Invalid -> "doesn't look right").
+pub type ValidationError {
+  Required
+  Invalid
+}
+
+pub type RawFields =
+  dict.Dict(String, String)
+
+pub type Question {
+  Question(
+    id: String,
+    control: Control,
+    required: Bool,
+    /// The always-written `draft_answers` keys (conditional keys like
+    /// `relationship_other` are NOT listed — resume checks these).
+    draft_keys: List(String),
+    text: fn(form_copy.CopyVars) -> String,
+  )
+}
+
+pub type Control {
+  /// "Are you {referee_name}?" — Yes saves + continues; No is a link out to
+  /// the wrong-person route (never a stored answer).
+  Identity
+  /// Full-width tappable rows; the stored value is the wire value.
+  Choice(List(#(String, String)))
+  /// Choice plus a short-text reveal when "other" is picked.
+  ChoiceWithOther(List(#(String, String)))
+  /// From/to month-year fields or an "ongoing" checkbox.
+  MonthYearOrOngoing
+  /// Whole-euro amount or a "don't remember" toggle.
+  AmountOrDontRemember
+  /// "About right" / "It differs" → short text. When the bound pre-fill
+  /// datum is absent (empty in CopyVars) the control degrades to an open
+  /// short-text question (the as-stated data-availability matrix).
+  AsStatedText(Prefill)
+  /// "About right" / "It was different" → amount / "Don't know".
+  AsStatedAmount
+  /// Two short texts (character relationship + capacity).
+  ShortTextPair
+  /// Textarea with counter; required-ness comes from the Question.
+  FreeText(max_chars: Int)
+}
+
+/// Which application datum an as-stated check confirms against.
+pub type Prefill {
+  PrefillEmploymentDuration
+  PrefillJobTitle
+}
+
+// -- The registry ---------------------------------------------------------------
+
+pub fn questions_for(slot: RefSlot) -> List(Question) {
+  case slot {
+    LandlordRef -> landlord_questions()
+    EmployerRef -> employer_questions()
+    CharacterRef -> character_questions()
+  }
+}
+
+fn identity_question() -> Question {
+  Question(
+    id: "identity",
+    control: Identity,
+    required: True,
+    draft_keys: ["identity_confirmed"],
+    text: form_copy.q_identity,
+  )
+}
+
+fn free_text_question(required required: Bool) -> Question {
+  Question(
+    id: "free_text",
+    control: FreeText(max_chars: 1000),
+    required: required,
+    draft_keys: ["free_text"],
+    text: fn(_vars) { form_copy.q_free_text },
+  )
+}
+
+fn landlord_questions() -> List(Question) {
