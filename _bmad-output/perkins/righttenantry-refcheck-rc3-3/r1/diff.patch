+// Unit tests for server/priv/static/reference_form.js — run with
+// `node --test scripts/js-tests/*.test.js` (wired into `make test`).
+//
+// Covers the pure seams of the RC3.3 enhancement: step advancement
+// (next-question resolution), the focus-seconds clamp, and the mobile
+// gate. The DOM choreography (hide/show, fetch wiring) is covered E2E by
+// bug-hunt scenarios.
+
+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+
+const referenceForm = require("../../server/priv/static/reference_form.js");
+
+test("nextQuestionId advances in registry order", () => {
+  const ids = ["identity", "relationship", "tenancy_confirmed"];
+  assert.equal(referenceForm.nextQuestionId(ids, "identity"), "relationship");
+  assert.equal(
+    referenceForm.nextQuestionId(ids, "relationship"),
+    "tenancy_confirmed",
+  );
+});
+
+test("nextQuestionId returns null on the last question", () => {
+  const ids = ["identity", "relationship"];
+  assert.equal(referenceForm.nextQuestionId(ids, "relationship"), null);
+});
+
+test("nextQuestionId returns null for an unknown id", () => {
+  assert.equal(referenceForm.nextQuestionId(["identity"], "bogus"), null);
+});
+
+test("clampFocusSeconds floors to whole seconds", () => {
+  assert.equal(referenceForm.clampFocusSeconds(0), "0");
+  assert.equal(referenceForm.clampFocusSeconds(999), "0");
+  assert.equal(referenceForm.clampFocusSeconds(2500), "2");
+});
+
+test("clampFocusSeconds is defensive about garbage", () => {
+  assert.equal(referenceForm.clampFocusSeconds(-50), "0");
+  assert.equal(referenceForm.clampFocusSeconds(NaN), "0");
+  assert.equal(referenceForm.clampFocusSeconds(Infinity), "0");
+});
+
+test("shouldStep follows the media-query match", () => {
+  assert.equal(referenceForm.shouldStep(true), true);
+  assert.equal(referenceForm.shouldStep(false), false);
+});
