+++ b/server/src/reference_checks/sql/get_form_context_by_form_token.sql
@@ -0,0 +1,38 @@
+--- get_form_context_by_form_token(form_token: String)
+-- The referee-form session read (Story RC3.3): one join carrying the
+-- reference_call row's session fields, the application's as-stated pre-fill
+-- fields, and the landlord/vacancy display fields the pages + the resend
+-- flow need. Nullable non-text columns use COALESCE(x::text, '') — squirrel
+-- types cast expressions as non-optional (and cannot codegen timestamptz
+-- results at all), so '' is the absent marker, mirroring the NULLIF($n,'')
+-- input convention. Plain nullable TEXT columns stay Option(String).
+-- form_token itself is selected: the resend flow needs the CURRENT token to
+-- build the fresh form URL after a remint.
+SELECT rc.id::text,
+       rc.application_id::text,
+       rc.ref_slot,
+       rc.status::text            AS status,
+       rc.form_token,
+       rc.contact_name,
+       rc.contact_email,
+       rc.contact_phone,
+       rc.corrected_email,
+       rc.corrected_phone,
+       COALESCE(rc.form_token_expires_at::text, '') AS form_token_expires_at,
+       (rc.form_token_expires_at IS NOT NULL AND rc.form_token_expires_at <= now())::text AS is_expired,
+       COALESCE(rc.form_opened_at::text, '') AS form_opened_at,
+       COALESCE(rc.draft_answers::text, '') AS draft_answers,
+       COALESCE(rc.taken_over_at::text, '') AS taken_over_at,
+       a.first_name               AS applicant_first_name,
+       a.last_name                AS applicant_last_name,
+       a.employer_name,
+       a.job_title,
+       a.employment_duration,
+       a.monthly_income_cents,
+       l.name                     AS landlord_display_name,
+       v.origin_domain
+FROM reference_call rc
+JOIN application a ON a.id = rc.application_id
+JOIN vacancy v ON v.id = a.vacancy_id
+JOIN landlord l ON l.id = v.user_id
+WHERE rc.form_token = $1;
