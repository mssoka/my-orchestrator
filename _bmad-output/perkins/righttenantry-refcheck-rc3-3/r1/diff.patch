+++ b/server/src/reference_checks/form_copy.gleam
@@ -0,0 +1,347 @@
+//// Referee-facing copy for the /reference/:token form session (Story RC3.3).
+////
+//// Every user-facing string the referee form renders lives here — the
+//// `application/form_copy.gleam` precedent: views never inline copy. Copy is
+//// UX-deck verbatim (ux-reference-checking §6.5, §8.5, §10.2) modulo two
+//// documented deviations: (1) the RT-wide em-dash ban (\u{2014} never
+//// appears — the copy test asserts absence on every string), (2) slot-neutral
+//// phrasing where the deck is landlord-ref-shaped.
+////
+//// Interpolation vars ride the `CopyVars` record; every value is
+//// server-escaped at render by the view layer (Lustre text nodes escape).
+
+import gleam/int
+import shared/reference_call.{
+  type RefSlot, CharacterRef, EmployerRef, LandlordRef,
+}
+
+/// Interpolation values for the referee-facing copy. As-stated fields are
+/// empty strings when the application never captured the datum (the
+/// as-stated data-availability matrix in the story spec) — the question
+/// registry picks the open-question variant on "".
+pub type CopyVars {
+  CopyVars(
+    referee_name: String,
+    referee_first_name: String,
+    applicant_first_name: String,
+    applicant_full_name: String,
+    employer_name: String,
+    employment_duration: String,
+    job_title: String,
+    annual_salary: String,
+  )
+}
+
+// -- Landing screen (UX §6.5 wireframe; the second Art 14 moment) -------------
+
+pub fn landing_title(vars: CopyVars) -> String {
+  "Reference for " <> vars.applicant_full_name
+}
+
+pub fn landing_opener(slot: RefSlot) -> String {
+  case slot {
+    LandlordRef -> "You're listed as a previous landlord."
+    EmployerRef -> "You're listed as an employer."
+    CharacterRef -> "You're listed as a character referee."
+  }
+}
+
+pub fn landing_context(vars: CopyVars) -> String {
+  vars.applicant_full_name
+  <> " applied to rent a home, and the landlord asked RightTenantry to collect this reference."
+}
+
+pub fn landing_meta(question_count: Int) -> String {
+  "About 5 minutes · "
+  <> int.to_string(question_count)
+  <> " questions · answers saved as you go"
+}
+
+/// The Art 14 restatement. The notice-link text is separate so the view can
+/// wrap it in an anchor to /privacy#referee-data.
+pub fn landing_art14(vars: CopyVars) -> String {
+  "Your answers go to the landlord as part of "
+  <> vars.applicant_first_name
+  <> "'s application. We keep them only as long as the application is kept. Your rights and our contact details: "
+}
+
+pub const landing_notice_link_text = "privacy notice"
+
+pub const landing_start = "Start"
+
+pub fn landing_wrong_person(vars: CopyVars) -> String {
+  "Not "
+  <> vars.referee_first_name
+  <> ", or don't know "
+  <> vars.applicant_first_name
+  <> "?"
+}
+
+pub const landing_wrong_person_link = "Let us know"
+
+pub const landing_decline = "Rather not take part?"
+
+pub const landing_decline_link = "Decline"
+
+// -- Question chrome ------------------------------------------------------------
+
+pub fn progress_text(index: Int, total: Int) -> String {
+  "Question " <> int.to_string(index) <> " of " <> int.to_string(total)
+}
+
+pub const continue_label = "Continue"
+
+pub const save_label = "Save"
+
+pub const back_label = "Back"
+
+pub const optional_marker = "(optional)"
+
+pub const other_text_label = "Tell us in a few words"
+
+pub const from_label = "From"
+
+pub const to_label = "To"
+
+pub const ongoing_label = "The tenancy is ongoing"
+
+pub const dont_remember_label = "Don't remember"
+
+pub const dont_know_label = "Don't know"
+
+pub const about_right_label = "About right"
+
+pub const it_differs_label = "It differs"
+
+pub const it_was_different_label = "It was different"
+
+// -- Review screen (all questions answered; submit is rc3-4's forward link) ----
+
+pub const review_title = "That's everything. Check your answers, then send them to the landlord."
+
+pub const review_submit = "Send my reference"
+
+pub const review_change = "Change"
+
+pub const review_not_answered = "Not answered"
+
+/// Inline validation messages on a question re-render (no-JS POST path).
+pub const answer_required_error = "This one needs an answer to continue."
+
+pub const answer_invalid_error = "That doesn't look right. Check it and try again."
+
+// -- Token-state pages (UX §8.5 + the truthful mapping) -------------------------
+
+pub const not_found_title = "This link doesn't look right."
+
+pub const not_found_body = "If you were expecting a reference form, the link may have been replaced by a newer one. Check the most recent message from us, or contact us."
+
+pub const not_found_contact_link = "Contact us"
+
+pub const expired_title = "This link has expired."
+
+pub const expired_body = "Links last 10 days so old messages can't be reused. If you still want to give this reference, we can send a fresh one."
+
+pub const expired_resend_button = "Send me a new link"
+
+pub const resent_title = "On its way."
+
+pub const resent_body = "We've sent a fresh link to the contact details on file. It expires in 10 days."
+
+/// The resend's honest failure page (every channel failed or skipped): the
+/// remint is rolled back so the referee's retry works from the same page.
+pub const resend_failed_title = "Couldn't send the link."
+
+pub const resend_failed_body = "Something didn't work on our side. Try again in a moment, or contact us if it keeps happening."
+
+pub const resend_failed_retry_button = "Try again"
+
+pub const completed_title = "This reference was already completed."
+
+pub const completed_body = "Thank you."
+
+pub const declined_title = "This reference was declined."
+
+pub const declined_body = "No further messages will come from us."
+
+pub const landlord_handling_title = "The landlord is handling this reference directly."
+
+pub const landlord_handling_body = "You don't need to do anything here."
+
+// -- Question text: previous-landlord set (UX §6.5 table) -----------------------
+
+pub fn q_identity(vars: CopyVars) -> String {
+  "Are you " <> vars.referee_name <> "?"
+}
+
+pub const q_identity_no_link = "No, this isn't me"
+
+pub fn q_relationship(vars: CopyVars) -> String {
+  "What was your relationship to " <> vars.applicant_first_name <> "?"
+}
+
+pub const opt_their_landlord = "Their landlord"
+
+pub const opt_letting_agent = "Letting agent for the property"
+
+pub const opt_other = "Other"
+
+pub fn q_tenancy_confirmed(vars: CopyVars) -> String {
+  "Did " <> vars.applicant_first_name <> " rent a property from you?"
+}
+
+pub const opt_yes = "Yes"
+
+pub const opt_no = "No"
+
+pub const opt_not_sure = "Not sure"
+
+/// DERIVED (as-stated matrix): the UX's as-stated wording presumes tenancy
+/// dates the apply form never captures — this is the §5.3 open form.
+pub fn q_tenancy_period(vars: CopyVars) -> String {
+  "When did " <> vars.applicant_first_name <> "'s tenancy at the property run?"
+}
+
+/// §5.3 open form (no rent datum on the application to confirm against).
+pub const q_rent_amount = "What was the monthly rent?"
+
+pub const q_rent_payment_record = "How was the rent payment record?"
+
+pub const opt_always_on_time = "Always on time"
+
+pub const opt_mostly_on_time = "Mostly on time"
+
+pub const opt_often_late = "Often late"
+
+pub const q_property_condition = "How was the property looked after?"
+
+pub const opt_excellent = "Excellent"
+
+pub const opt_good = "Good"
+
+pub const opt_fair = "Fair"
+
+pub const opt_poor = "Poor"
+
+pub const opt_did_not_see = "Didn't see it after"
+
+pub const q_notice_given_properly = "Was proper notice given before leaving?"
+
+pub const opt_ongoing = "Tenancy is ongoing"
+
+pub const q_deposit_returned = "Was the deposit returned?"
+
+pub const opt_in_full = "In full"
+
+pub const opt_partly = "Partly"
+
+pub const opt_withheld = "Withheld"
+
+pub const opt_still_held = "Still held"
+
+pub fn q_would_rent_again(vars: CopyVars) -> String {
+  "Would you rent to " <> vars.applicant_first_name <> " again?"
+}
+
+pub const opt_unsure = "Unsure"
+
+pub const opt_prefer_not_to_say = "Prefer not to say"
+
+pub const q_free_text = "Anything else the landlord should know?"
+
+// -- Question text: employer set -------------------------------------------------
+
+pub const opt_manager = "Manager"
+
+pub const opt_hr = "HR"
+
+pub const opt_colleague = "Colleague"
+
+pub fn q_works_at(vars: CopyVars) -> String {
+  case vars.employer_name {
+    "" ->
+      "Does or did "
+      <> vars.applicant_first_name
+      <> " work at the company they listed on their application?"
+    name ->
+      "Does or did " <> vars.applicant_first_name <> " work at " <> name <> "?"
+  }
+}
+
+pub fn q_employment_period(vars: CopyVars) -> String {
+  case vars.employment_duration {
+    "" -> "How long has " <> vars.applicant_first_name <> " worked there?"
+    duration ->
+      "The application says "
+      <> vars.applicant_first_name
+      <> " has worked there for "
+      <> duration
+      <> ". Is that right?"
+  }
+}
+
+pub fn q_role(vars: CopyVars) -> String {
+  case vars.job_title {
+    "" -> "What is their role?"
+    title -> "The application says their role is " <> title <> ". Right?"
+  }
+}
+
+pub fn q_salary(vars: CopyVars) -> String {
+  "The application says their salary is €"
+  <> vars.annual_salary
+  <> " a year. Is that right?"
+}
+
+pub const q_would_rehire = "Would you rehire them?"
+
+// -- Question text: character set -------------------------------------------------
+
+pub fn q_relationship_capacity(vars: CopyVars) -> String {
+  "How do you know " <> vars.applicant_first_name <> "?"
+}
+
+pub const relationship_field_label = "Relationship"
+
+pub const relationship_field_hint = "e.g. friend, teammate, neighbour"
+
+pub const capacity_field_label = "In what capacity"
+
+pub const capacity_field_hint = "e.g. five-a-side team, volunteering group"
+
+pub fn q_known_duration(vars: CopyVars) -> String {
+  "How long have you known " <> vars.applicant_first_name <> "?"
+}
+
+pub const opt_lt_1_year = "Less than a year"
+
+pub const opt_1_to_3_years = "1 to 3 years"
+
+pub const opt_3_to_10_years = "3 to 10 years"
+
+pub const opt_gt_10_years = "More than 10 years"
+
+pub fn q_character_statement(vars: CopyVars) -> String {
+  "Is there anything you'd want a landlord to know about "
+  <> vars.applicant_first_name
+  <> "?"
+}
+
+pub fn q_would_stand_again(_vars: CopyVars) -> String {
+  "Would you stand as a referee for them again?"
+}
+
+// -- Misc question-level labels ---------------------------------------------------
+
+pub const amount_placeholder = "€"
+
+/// The autosave indicator in reference_form.js — KEEP IN SYNC (the JS is a
+/// plain static asset and cannot import this constant).
+pub const js_saved_indicator = "Saved"
+
+pub const other_option_label = "Other"
+
+/// The free-text counter hint (the house resize-y + counter pattern).
+pub fn char_counter_hint(max: Int) -> String {
+  int.to_string(max) <> " characters maximum"
+}
diff --git a/server/src/reference_checks/form_handler.gleam b/server/src/reference_checks/form_handler.gleam
new file mode 100644
index 00000000..9ec2fac9
--- /dev/null
+++ b/server/src/reference_checks/form_handler.gleam
@@ -0,0 +1,835 @@
+//// The referee form session (Story RC3.3): the public capability-token
+//// route family `/reference/:token` (AD-3). No login — the ~288-bit
+//// form_token IS the auth.
+////
+////   GET  /reference/:token        landing / form page / review / state page
+////   POST /reference/:token/answer per-question save, no-JS (303 PRG)
+////   PUT  /reference/:token/answer per-question autosave, JS (JSON)
+////   POST /reference/:token/resend expired-link "send me a new link"
+////   GET  /reference/<anything>    branded unknown-link page (catch-all arm)
+////
+//// Design rules that bind every handler here:
+////   - AD-14 guarded writes only: every mutation is a single UPDATE with
+////     the expected pre-state in its WHERE; a 0-row result stands down.
+////   - The token never appears in logs, Sentry messages, audit details, or
+////     attempt entries; the middleware redact registry covers the path.
+////   - Abuse posture (AD-15): honeypot + timing on every POST, silent-drop
+////     with fake success (the /apply precedent) — never an error signal.
+////   - SSR never requires JS: the POST path is first-class.
+
+import application/application_handler
+import application/form_view
+import audit/audit_log
+import audit/event_type
+import config.{type ServerConfig}
+import domain_helpers
+import gleam/dict
+import gleam/dynamic/decode
+import gleam/int
+import gleam/json
+import gleam/list
+import gleam/option.{type Option, None, Some}
+import gleam/string
+import pog
+import reference_checks/form_copy
+import reference_checks/form_pages
+import reference_checks/form_question_pages.{QuestionView}
+import reference_checks/messages
+import reference_checks/questions.{type Question}
+import reference_checks/send
+import reference_checks/sql
+import sentry/sentry_client
+import shared/reference_call.{
+  type RefSlot, type ReferenceCallStatus, AwaitingCorrection, ContactInitiated,
+  Failed, FormCompleted, ManualRecorded, Objected, Partial, Refused, Unreachable,
+}
+import ssr_response
+import wisp.{type Request, type Response}
+import youid/uuid
+
+// -- Token-state classification (pure — the full matrix is unit-tested) -----------
+
+pub type TokenState {
+  /// contact_initiated, not expired (taken-over rows stay Live, A7).
+  Live
+  /// contact_initiated, expired, not taken over: the resend offer page.
+  ExpiredOpen
+  /// No row (or a pre-mint state: queued/skipped — the token cannot exist).
+  Unknown
+  /// form_completed / partial.
+  Completed
+  /// refused / objected.
+  Declined
+  /// manual_recorded / unreachable / failed / awaiting_correction, and the
+  /// taken-over-and-expired corner.
+  LandlordHandling
+}
+
+pub fn classify(
+  found found: Bool,
+  status status: ReferenceCallStatus,
+  taken_over taken_over: Bool,
+  expired expired: Bool,
+) -> TokenState {
+  case found {
+    False -> Unknown
+    True ->
+      case status {
+        ContactInitiated ->
+          case taken_over, expired {
+            False, False -> Live
+            // A7: the form link stays live through warm-handoff takeover.
+            True, False -> Live
+            False, True -> ExpiredOpen
+            True, True -> LandlordHandling
+          }
+        FormCompleted | Partial | reference_call.Completed -> Completed
+        Refused | Objected -> Declined
+        ManualRecorded | Unreachable | Failed | AwaitingCorrection ->
+          LandlordHandling
+        // queued/skipped: the token is minted at T0 (rc3-5), so these can
+        // never be reached by a real link; v2 voice states are inert here.
+        _ -> Unknown
+      }
+  }
+}
+
+pub type LookupError {
+  NotFound
+  LookupQueryFailed(message: String)
+}
+
+// -- GET: the form session ------------------------------------------------------------
+
+pub fn handle_get(req: Request, config: ServerConfig, token: String) -> Response {
+  case lookup_context(config.db, token) {
+    Error(NotFound) -> render_not_found()
+    Error(LookupQueryFailed(msg)) -> {
+      wisp.log_error("reference form: context lookup failed: " <> msg)
+      wisp.internal_server_error()
+    }
+    Ok(row) -> {
+      let state = classify_row(row)
+      case state {
+        Unknown -> render_not_found()
+        Completed ->
+          form_pages.view_completed() |> ssr_response.to_sensitive_response
+        Declined ->
+          form_pages.view_declined() |> ssr_response.to_sensitive_response
+        LandlordHandling ->
+          form_pages.view_landlord_handling()
+          |> ssr_response.to_sensitive_response
+        ExpiredOpen ->
+          form_pages.view_expired(token:)
+          |> ssr_response.to_sensitive_response
+        Live -> render_live(req, config.db, token, row)
+      }
+    }
+  }
+}
+
+/// Live-row GET: stamp form_opened_at (first open only), then landing /
+/// form page / review per the draft + ?q= state.
+fn render_live(
+  req: Request,
+  db: pog.Connection,
+  token: String,
+  row: sql.GetFormContextByFormTokenRow,
+) -> Response {
+  stamp_form_opened(db, token)
+  let slot = reference_call.ref_slot_from_string(row.ref_slot)
+  let vars = copy_vars(row)
+  let draft = questions.decode_draft(row.draft_answers)
+  let draft_keys = dict.keys(draft)
+  let q_param = query_param(req, "q")
+  let all_questions = questions.questions_for(slot)
+  let first = first_question_id(slot)
+
+  case
+    dict.is_empty(draft),
+    q_param,
+    questions.next_unanswered(slot, draft_keys:)
+  {
+    // Nothing answered yet and no deep link: the landing screen (the
+    // second Art 14 moment) comes before any question.
+    True, None, _ ->
+      form_pages.view_landing(
+        vars:,
+        slot:,
+        token:,
+        first_question_id: first,
+        question_count: list.length(all_questions),
+      )
+      |> ssr_response.to_sensitive_response
+    // Everything answered and no specific question requested: review.
+    _, None, None ->
+      form_pages.view_review(
+        vars:,
+        token:,
+        entries: review_entries(slot, draft, vars),
+      )
+      |> ssr_response.to_sensitive_response
+    // Otherwise the form page, positioned at the requested (clamped) or
+    // first-unanswered question.
+    _, _, next ->
+      render_form_page(
+        token:,
+        slot:,
+        vars:,
+        draft:,
+        current_id: clamp_current(slot, q_param, draft_keys, next),
+        error_question: None,
+        error_message: "",
+      )
+  }
+}
+
+/// The form page with every question rendered; `current_id` drives the
+/// mobile stepper start + the Back links. `error_question`/`error_message`
+/// re-render a failed no-JS POST inline.
+fn render_form_page(
+  token token: String,
+  slot slot: RefSlot,
+  vars vars: form_copy.CopyVars,
+  draft draft: questions.Draft,
+  current_id current_id: String,
+  error_question error_question: Option(String),
+  error_message error_message: String,
+) -> Response {
+  let all = questions.questions_for(slot)
+  let total = list.length(all)
+  let loaded_at = form_view.current_unix_ms()
+  let elements =
+    list.index_map(all, fn(q, i) {
+      let back_url = case questions.previous_question(slot, q.id) {
+        Some(prev) ->
+          Some("/reference/" <> token <> "?q=" <> prev.id <> "#q-" <> prev.id)
+        None -> None
+      }
+      form_question_pages.view_question(
+        qv: QuestionView(
+          question: q,
+          index: i + 1,
+          total:,
+          prefill: questions.prefill_for(q:, draft:),
+          vars:,
+          wrong_person_url: "/reference/" <> token <> "/wrong-person",
+        ),
+        token:,
+        loaded_at_ms: loaded_at,
+        current: q.id == current_id,
+        back_url:,
+        error: case error_question {
+          Some(id) if id == q.id -> Some(error_message)
+          _ -> None
+        },
+      )
+    })
+  form_pages.view_form_page(vars:, questions: elements)
+  |> ssr_response.to_sensitive_response
+}
+
+/// The ?q= clamp: a deep link is honoured only for an already-answered
+/// question or the first-unanswered one (Change/Back navigation); anything
+/// else snaps to the first unanswered (or the last question's id when the
+/// set is complete, where the bare URL would have shown the review).
+fn clamp_current(
+  slot: RefSlot,
+  q_param: Option(String),
+  draft_keys: List(String),
+  next: Option(Question),
+) -> String {
+  let valid = case q_param {
+    None -> False
+    Some(id) ->
+      case questions.question_by_id(slot, id) {
+        None -> False
+        Some(q) ->
+          case next {
+            Some(n) if n.id == id -> True
+            _ ->
+              q.draft_keys
+              |> list.all(fn(k) { list.contains(draft_keys, k) })
+          }
+      }
+  }
+  case valid, q_param, next {
+    True, Some(id), _ -> id
+    _, _, Some(n) -> n.id
+    _, _, None -> last_question_id(slot)
+  }
+}
+
+// -- POST /reference/:token/answer (no-JS per-question save) ---------------------------
+
+pub fn handle_answer_post(
+  req: Request,
+  config: ServerConfig,
+  token: String,
+) -> Response {
+  use form_data <- wisp.require_form(req)
+  let values = form_data.values
+
+  // Abuse posture (AD-15): silent-drop with fake advance — a bot learns
+  // nothing from the response shape (the /apply fake-confirmation precedent).
+  case
+    application_handler.is_honeypot_filled(values)
+    || is_answer_timing_suspicious(values)
+  {
+    True -> wisp.redirect(to: "/reference/" <> token)
+    False ->
+      case lookup_context(config.db, token) {
+        Error(NotFound) -> render_not_found()
+        Error(LookupQueryFailed(msg)) -> {
+          wisp.log_error("reference answer: lookup failed: " <> msg)
+          wisp.internal_server_error()
+        }
+        Ok(row) ->
+          case classify_row(row) {
+            Live -> save_answer_from_post(config.db, token, row, values)
+            // The state moved (or the token died) mid-session: the GET
+            // tells the truth.
+            _ -> wisp.redirect(to: "/reference/" <> token)
+          }
+      }
+  }
+}
+
+fn save_answer_from_post(
+  db: pog.Connection,
+  token: String,
+  row: sql.GetFormContextByFormTokenRow,
+  values: List(#(String, String)),
+) -> Response {
+  let slot = reference_call.ref_slot_from_string(row.ref_slot)
+  let vars = copy_vars(row)
+  let fields = dict.from_list(values)
+  case get_value(values, "_question") {
+    "" -> wisp.bad_request("Missing question")
+    question_id ->
+      case questions.question_by_id(slot, question_id) {
+        None -> wisp.bad_request("Unknown question")
+        Some(q) ->
+          case questions.validate_answer(q:, vars:, fields:) {
+            Error(reason) -> {
+              let message = case reason {
+                questions.Required -> form_copy.answer_required_error
+                questions.Invalid -> form_copy.answer_invalid_error
+              }
+              // Inline re-render (the /apply view_form_with_errors
+              // precedent): the failed question current, the message inline.
+              let draft = questions.decode_draft(row.draft_answers)
+              render_form_page(
+                token:,
+                slot:,
+                vars:,
+                draft:,
+                current_id: q.id,
+                error_question: Some(q.id),
+                error_message: message,
+              )
+            }
+            Ok(entries) -> {
+              let patch = json.object(entries)
+              case sql.save_draft_answer(db, token, patch) {
+                Ok(pog.Returned(_, [_, ..])) -> {
+                  let draft_keys =
+                    list.append(
+                      dict.keys(questions.decode_draft(row.draft_answers)),
+                      list.map(entries, fn(e) { e.0 }),
+                    )
+                  let next = questions.next_unanswered(slot, draft_keys:)
+                  case next {
+                    Some(n) ->
+                      wisp.redirect(
+                        to: "/reference/"
+                        <> token
+                        <> "?q="
+                        <> n.id
+                        <> "#q-"
+                        <> n.id,
+                      )
+                    // All answered: the bare URL renders the review screen.
+                    None -> wisp.redirect(to: "/reference/" <> token)
+                  }
+                }
+                // Stand-down (terminal/expired mid-session): the GET tells
+                // the truth.
+                Ok(_) -> wisp.redirect(to: "/reference/" <> token)
+                Error(err) -> {
+                  wisp.log_error(
+                    "reference answer: save failed: " <> string.inspect(err),
+                  )
+                  wisp.internal_server_error()
+                }
+              }
+            }
+          }
+      }
+  }
+}
+
+// -- PUT /reference/:token/answer (JS autosave, JSON) -----------------------------------
+
+pub fn handle_answer_put(
+  req: Request,
+  config: ServerConfig,
+  token: String,
+) -> Response {
+  use json_body <- wisp.require_json(req)
+  case decode.run(json_body, answer_payload_decoder()) {
+    Error(_) -> wisp.json_response("{\"ok\":false}", 400)
+    Ok(#(question_id, fields)) -> {
+      let field_pairs = dict.to_list(fields)
+      // Silent-drop for bots, same doctrine as the POST path.
+      case
+        application_handler.is_honeypot_filled(field_pairs)
+        || is_answer_timing_suspicious(field_pairs)
+      {
+        True -> wisp.json_response("{\"ok\":true}", 200)
+        False ->
+          case lookup_context(config.db, token) {
+            Error(NotFound) ->
+              wisp.json_response("{\"ok\":false,\"reason\":\"unknown\"}", 404)
+            Error(LookupQueryFailed(msg)) -> {
+              wisp.log_error("reference autosave: lookup failed: " <> msg)
+              wisp.internal_server_error()
+            }
+            Ok(row) ->
+              case classify_row(row) {
+                Live ->
+                  save_answer_from_put(
+                    config.db,
+                    token,
+                    row,
+                    question_id,
+                    fields,
+                  )
+                _ ->
+                  wisp.json_response(
+                    "{\"ok\":false,\"reason\":\"closed\"}",
+                    409,
+                  )
+              }
+          }
+      }
+    }
+  }
+}
+
+fn save_answer_from_put(
+  db: pog.Connection,
+  token: String,
+  row: sql.GetFormContextByFormTokenRow,
+  question_id: String,
+  fields: questions.RawFields,
+) -> Response {
+  let slot = reference_call.ref_slot_from_string(row.ref_slot)
+  let vars = copy_vars(row)
+  case questions.question_by_id(slot, question_id) {
+    None -> wisp.json_response("{\"ok\":false}", 400)
+    Some(q) ->
+      case questions.validate_answer(q:, vars:, fields:) {
+        Error(_) ->
+          wisp.json_response("{\"ok\":false,\"reason\":\"invalid\"}", 400)
+        Ok(entries) ->
+          case sql.save_draft_answer(db, token, json.object(entries)) {
+            Ok(pog.Returned(_, [_, ..])) ->
+              wisp.json_response("{\"ok\":true}", 200)
+            Ok(_) ->
+              wisp.json_response("{\"ok\":false,\"reason\":\"closed\"}", 409)
+            Error(err) -> {
+              wisp.log_error(
+                "reference autosave: save failed: " <> string.inspect(err),
+              )
+              wisp.internal_server_error()
+            }
+          }
+      }
+  }
+}
+
+fn answer_payload_decoder() -> decode.Decoder(#(String, questions.RawFields)) {
+  use question <- decode.field("question", decode.string)
+  use fields <- decode.field(
+    "fields",
+    decode.dict(decode.string, decode.string),
+  )
+  decode.success(#(question, fields))
+}
+
+// -- POST /reference/:token/resend (expired link, self-serve) -----------------------------
+
+pub fn handle_resend(
+  req: Request,
+  config: ServerConfig,
+  token: String,
+) -> Response {
+  use form_data <- wisp.require_form(req)
+  let values = form_data.values
+
+  // Full /apply-class timing on this single-action page (2s floor).
+  case
+    application_handler.is_honeypot_filled(values)
+    || application_handler.is_timing_suspicious(values)
+  {
+    // Fake success: a bot sees the same page a referee sees after a send.
+    True -> form_pages.view_resent() |> ssr_response.to_sensitive_response
+    False ->
+      case lookup_context(config.db, token) {
+        Error(NotFound) -> render_not_found()
+        Error(LookupQueryFailed(msg)) -> {
+          wisp.log_error("reference resend: lookup failed: " <> msg)
+          wisp.internal_server_error()
+        }
+        Ok(row) ->
+          case classify_row(row) {
+            ExpiredOpen -> resend_fresh_link(config, token, row)
+            _ -> wisp.redirect(to: "/reference/" <> token)
+          }
+      }
+  }
+}
+
+/// Re-mint the token (old links die), re-send the invite to the effective
+/// contact on file, audit-log the resend (never the token), then the
+/// success page.
+fn resend_fresh_link(
+  config: ServerConfig,
+  old_token: String,
+  row: sql.GetFormContextByFormTokenRow,
+) -> Response {
+  // ~288-bit mint, the insert_erasure_token precedent.
+  let new_token = wisp.random_string(48)
+  case sql.remint_form_token(config.db, old_token, new_token) {
+    Error(err) -> {
+      wisp.log_error("reference resend: remint failed: " <> string.inspect(err))
+      wisp.internal_server_error()
+    }
+    // 0 rows: the state moved under the referee — re-render the truth.
+    Ok(pog.Returned(_, [])) -> wisp.redirect(to: "/reference/" <> old_token)
+    Ok(pog.Returned(_, [_reminted_id, ..])) -> {
+      let outcomes = send_invite_to_effective_contact(config, row, new_token)
+      case any_delivered(outcomes) {
+        True -> {
+          audit_resend(config.db, config.sentry, row, outcomes)
+          form_pages.view_resent() |> ssr_response.to_sensitive_response
+        }
+        // Every channel failed or skipped: the referee would hold a dead
+        // old link and never receive the new one — and "On its way" would
+        // lie. Roll the remint back (the old token returns to its expired
+        // page so a retry works) and render the honest failure page.
+        False -> {
+          wisp.log_error(
+            "reference resend: all channels failed/skipped; rolling back remint",
+          )
+          rollback_remint(
+            config.db,
+            new_token,
+            old_token,
+            row.form_token_expires_at,
+          )
+          form_pages.view_resend_failed(token: old_token)
+          |> ssr_response.to_sensitive_response
+        }
+      }
+    }
+  }
+}
+
+/// Did any channel actually deliver? Exposed for the unit tests (the
+/// success branch can't be exercised hermetically — Delivered needs a real
+/// provider 2xx).
+pub fn any_delivered(outcomes: List(messages.ChannelOutcome)) -> Bool {
+  list.any(outcomes, fn(o) { o.outcome == messages.Delivered })
+}
+
+/// The resend audit payload: channel + outcome only — never the token,
+/// never addresses (the audit_log row shape is append-only evidence).
+/// Exposed for the unit tests.
+pub fn resend_audit_details(
+  outcomes: List(messages.ChannelOutcome),
+) -> json.Json {
+  json.object([
+    #(
+      "channels",
+      json.preprocessed_array(
+        list.map(outcomes, fn(o) {
+          json.object([
+            #("channel", json.string(messages.channel_name(o.channel))),
+            #("outcome", json.string(messages.outcome_name(o.outcome))),
+          ])
+        }),
+      ),
+    ),
+  ])
+}
+
+/// Restore the pre-remint token + TTL after an all-failed resend. A failed
+/// rollback only strands the OLD token (the new one keeps working — the
+/// referee never received it, but the sweep's next send uses it), so a
+/// rollback failure logs and moves on.
+fn rollback_remint(
+  db: pog.Connection,
+  new_token: String,
+  old_token: String,
+  old_expiry: String,
+) -> Nil {
+  case sql.restore_form_token(db, new_token, old_token, old_expiry) {
+    Ok(_) -> Nil
+    Error(err) ->
+      wisp.log_error(
+        "reference resend: rollback failed: " <> string.inspect(err),
+      )
+  }
+}
+
+/// Send the T0 invite to the effective contact (corrected ?? snapshot,
+/// AD-7). Base URL from the vacancy's origin_domain (the invite's own
+/// convention; the apply-canonical precedent).
+fn send_invite_to_effective_contact(
+  config: ServerConfig,
+  row: sql.GetFormContextByFormTokenRow,
+  new_token: String,
+) -> List(messages.ChannelOutcome) {
+  let slot = reference_call.ref_slot_from_string(row.ref_slot)
+  let context =
+    messages.RefereeContext(
+      referee_first_name: messages.first_name(name: row.contact_name),
+      applicant_full_name: applicant_full_name(row),
+      applicant_first_name: row.applicant_first_name,
+      landlord_display_name: row.landlord_display_name,
+      slot:,
+      form_token: new_token,
+      base_url: domain_helpers.origin_from_domain(row.origin_domain),
+      // The invite copy states the 10-day TTL inline; no date needed.
+      expiry_date: "",
+    )
+  let deps =
+    send.SendDeps(
+      resend_api_key: config.resend_api_key,
+      twilio: config.twilio,
+      sentry: config.sentry,
+    )
+  send.send_invite(
+    deps:,
+    message: send.RefereeMessage(
+      context:,
+      to_email: effective(row.corrected_email, row.contact_email),
+      to_phone: effective(row.corrected_phone, row.contact_phone),
+    ),
+  )
+}
+
+fn effective(
+  corrected: Option(String),
+  snapshot: Option(String),
+) -> Option(String) {
+  case corrected, snapshot {
+    Some(c), _ -> Some(c)
+    None, s -> s
+  }
+}
+
+/// The resend audit row (the briefing's AC: "re-sends to the contact on
+/// file, audit-logged"). Tier-2 posture: a failed audit write captures to
+/// Sentry but does not strand the referee after a successful send. The
+/// details carry channel + outcome ONLY — never the token, never addresses.
+fn audit_resend(
+  db: pog.Connection,
+  sentry: sentry_client.Sentry,
+  row: sql.GetFormContextByFormTokenRow,
+  outcomes: List(messages.ChannelOutcome),
+) -> Nil {
+  case uuid.from_string(row.id) {
+    Error(_) ->
+      wisp.log_error("reference resend: corrupt row id — audit skipped")
+    Ok(row_uuid) ->
+      case
+        audit_log.create_system(
+          db,
+          event: event_type.ReferenceCallLinkResent,
+          entity_type: "reference_call",
+          entity_id: row_uuid,
+          details: resend_audit_details(outcomes),
+        )
+      {
+        Ok(_) -> Nil
+        Error(err) -> {
+          wisp.log_error(
+            "reference resend: audit write failed: " <> string.inspect(err),
+          )
+          sentry_client.capture(
+            sentry,
+            sentry_client.BackgroundEvent(
+              event_type: "ReferenceResendAuditFailed",
+              message: "reference-call resend audit write failed",
+              level: sentry_client.LevelError,
+              tags: [#("entity_id", row.id)],
+            ),
+          )
+        }
+      }
+  }
+}
+
+// -- The catch-all -------------------------------------------------------------------------
+
+/// Any deeper GET under /reference/* that isn't a registered arm: the
+/// branded unknown-link page. This arm keeps typo'd deep links off the SPA
+/// shell (which would load analytics against a token-carrying URL, AC7).
+pub fn handle_unknown_path(_req: Request) -> Response {
+  render_not_found()
+}
+
+fn render_not_found() -> Response {
+  form_pages.view_not_found() |> ssr_response.to_not_found_response
+}
+
+// -- Shared internals -------------------------------------------------------------------
+
+fn lookup_context(
+  db: pog.Connection,
+  token: String,
+) -> Result(sql.GetFormContextByFormTokenRow, LookupError) {
+  case sql.get_form_context_by_form_token(db, token) {
+    Ok(pog.Returned(_, [row, ..])) -> Ok(row)
+    Ok(pog.Returned(_, [])) -> Error(NotFound)
+    Error(err) -> Error(LookupQueryFailed(string.inspect(err)))
+  }
+}
+
+fn classify_row(row: sql.GetFormContextByFormTokenRow) -> TokenState {
+  classify(
+    found: True,
+    status: reference_call.status_from_string(row.status),
+    taken_over: row.taken_over_at != "",
+    expired: row.is_expired == "true",
+  )
+}
+
+/// First live GET stamps form_opened_at (AD-10). Guarded IS NULL in SQL;
+/// a stamp failure logs but never blocks the referee.
+fn stamp_form_opened(db: pog.Connection, token: String) -> Nil {
+  case sql.stamp_form_opened(db, token) {
+    Ok(_) -> Nil
+    Error(err) ->
+      wisp.log_error(
+        "reference form: open stamp failed: " <> string.inspect(err),
+      )
+  }
+}
+
+fn copy_vars(row: sql.GetFormContextByFormTokenRow) -> form_copy.CopyVars {
+  form_copy.CopyVars(
+    referee_name: row.contact_name,
+    referee_first_name: messages.first_name(name: row.contact_name),
+    applicant_first_name: row.applicant_first_name,
+    applicant_full_name: applicant_full_name(row),
+    employer_name: option.unwrap(row.employer_name, ""),
+    employment_duration: option.unwrap(row.employment_duration, ""),
+    job_title: option.unwrap(row.job_title, ""),
+    annual_salary: format_annual_salary(row.monthly_income_cents),
+  )
+}
+
+fn applicant_full_name(row: sql.GetFormContextByFormTokenRow) -> String {
+  row.applicant_first_name <> " " <> row.applicant_last_name
+}
+
+/// monthly cents -> annual euros, thousands-separated ("42000" -> "42,000").
+/// Exposed for the unit tests (the employer salary question's copy input).
+pub fn format_annual_salary(monthly_cents: Int) -> String {
+  let annual_eur = monthly_cents * 12 / 100
+  thousands_separated(int.to_string(annual_eur))
+}
+
+fn thousands_separated(digits: String) -> String {
+  let len = string.length(digits)
+  case len <= 3 {
+    True -> digits
+    False -> {
+      let head_len = case len % 3 {
+        0 -> 3
+        n -> n
+      }
+      let head = string.slice(digits, 0, head_len)
+      let rest = string.slice(digits, head_len, len - head_len)
+      string.join([head, ..group_every_three(rest, [])], ",")
+    }
+  }
+}
+
+fn group_every_three(rest: String, acc: List(String)) -> List(String) {
+  case rest {
+    "" -> list.reverse(acc)
+    _ -> {
+      let group = string.slice(rest, 0, 3)
+      let tail = string.slice(rest, 3, string.length(rest) - 3)
+      group_every_three(tail, [group, ..acc])
+    }
+  }
+}
+
+fn query_param(req: Request, name: String) -> Option(String) {
+  wisp.get_query(req)
+  |> list.key_find(name)
+  |> option.from_result
+}
+
+fn first_question_id(slot: RefSlot) -> String {
+  case questions.questions_for(slot) {
+    [first, ..] -> first.id
+    [] -> ""
+  }
+}
+
+fn last_question_id(slot: RefSlot) -> String {
+  case questions.questions_for(slot) |> list.last {
+    Ok(last) -> last.id
+    Error(_) -> ""
+  }
+}
+
+fn review_entries(
+  slot: RefSlot,
+  draft: questions.Draft,
+  vars: form_copy.CopyVars,
+) -> List(form_pages.ReviewEntry) {
+  questions.questions_for(slot)
+  |> list.map(fn(q) {
+    form_pages.ReviewEntry(
+      question_id: q.id,
+      question_text: q.text(vars),
+      summary: questions.answer_summary(q:, draft:),
+    )
+  })
+}
+
+fn get_value(values: List(#(String, String)), name: String) -> String {
+  case list.key_find(values, name) {
+    Ok(v) -> v
+    Error(_) -> ""
+  }
+}
+
+/// Per-question adaptation of the /apply timing check (AC6): the same
+/// fail-closed branches (missing, unparseable, future, implausibly old) with
+/// a 500ms fast floor instead of 2s — the form page renders every question
+/// at one load, so a fast first tap legitimately lands inside 2s. The
+/// resend POST keeps the full 2s /apply floor (single-action page).
+/// Exposed for the unit tests.
+pub fn is_answer_timing_suspicious(values: List(#(String, String))) -> Bool {
+  case get_value(values, "_form_loaded_at") {
+    "" -> True
+    loaded_at_str -> {
+      case int.parse(loaded_at_str) {
+        Error(_) -> True
+        Ok(loaded_at_ms) -> {
+          let delta_ms = form_view.current_unix_ms() - loaded_at_ms
+          delta_ms < 500 || delta_ms > 604_800_000
+        }
+      }
+    }
+  }
+}
diff --git a/server/src/reference_checks/form_pages.gleam b/server/src/reference_checks/form_pages.gleam
new file mode 100644
index 00000000..73114abb
--- /dev/null
+++ b/server/src/reference_checks/form_pages.gleam
@@ -0,0 +1,394 @@
+//// Page-level SSR for the referee form session (Story RC3.3, T8): the shell
+//// (head + brand header + footer), the landing screen (the second Art 14
+//// moment + both escape routes), the all-answered review screen, and the
+//// branded token-state pages (UX §8.5). Per-question rendering lives in
+//// form_question_pages.gleam.
+////
+//// Token-hygiene rules for every page here (AC7): no PostHog, no
+//// analytics, no consent.js; the head carries ONLY fonts.css + form.css +
+//// /static/reference_form.js (self-origin static script — no inline JS, so
+//// no CSP-nonce threading). The handler wraps every page in
+//// ssr_response.to_sensitive_response / to_not_found_response (no-store,
+//// no-referrer, noindex).
+////
+//// No em-dashes in any string (the copy test covers form_copy; view-level
+//// literals here are structural, not copy).
+
+import application/form_view
+import gleam/list
+import lustre/attribute.{attribute}
+import lustre/element.{type Element}
+import lustre/element/html
+import reference_checks/form_copy
+import shared/reference_call.{type RefSlot}
+
+// -- Shell ------------------------------------------------------------------------
+
+/// The page shell. `body_data` carries the data-attributes the JS reads
+/// (the stepper gate + the slot's question count).
+fn page_shell(
+  page_title page_title: String,
+  body_children body_children: List(Element(a)),
+) -> String {
+  html.html([attribute.lang("en")], [
+    html.head([], [
+      html.meta([attribute("charset", "utf-8")]),
+      html.meta([
+        attribute.name("viewport"),
+        attribute("content", "width=device-width, initial-scale=1"),
+      ]),
+      html.title([], page_title),
+      html.meta([
+        attribute.name("robots"),
+        attribute("content", "noindex, nofollow"),
+      ]),
+      html.link([
+        attribute.rel("icon"),
+        attribute.type_("image/png"),
+        attribute.href("/static/favicon-32.png"),
+      ]),
+      html.link([
+        attribute.rel("stylesheet"),
+        attribute.href("/static/fonts/fonts.css"),
+      ]),
+      html.link([
+        attribute.rel("stylesheet"),
+        attribute.href("/static/form.css"),
+      ]),
+      element.element(
+        "script",
+        [
+          attribute("src", "/static/reference_form.js"),
+          attribute("defer", ""),
+        ],
+        [],
+      ),
+    ]),
+    html.body([], [
+      view_brand_header(),
+      html.main([attribute.class("form-container ref-page")], body_children),
+      form_view.view_footer(),
+    ]),
+  ])
+  |> element.to_string
+}
+
+/// Slim brand header — the referee is anonymous; there is no vacancy chrome.
+fn view_brand_header() -> Element(a) {
+  html.header([attribute.class("form-header")], [
+    html.div([attribute.class("header-brand")], [
+      html.span([attribute.class("brand-logo")], [
+        html.span([attribute.class("brand-right")], [html.text("Right")]),
+        html.span([attribute.class("brand-tenantry")], [html.text("Tenantry")]),
+      ]),
+    ]),
+  ])
+}
+
+// -- Landing (the second Art 14 moment + both escape routes) ----------------------
+
+pub fn view_landing(
+  vars vars: form_copy.CopyVars,
+  slot slot: RefSlot,
+  token token: String,
+  first_question_id first_question_id: String,
+  question_count question_count: Int,
+) -> String {
+  page_shell(page_title: form_copy.landing_title(vars), body_children: [
+    html.div(
+      [
+        attribute.class("ref-card"),
+        attribute("data-testid", "reference-landing"),
+      ],
+      [
+        html.h1([attribute.class("ref-title")], [
+          html.text(form_copy.landing_title(vars)),
+        ]),
+        html.p([], [html.text(form_copy.landing_opener(slot))]),
+        html.p([], [html.text(form_copy.landing_context(vars))]),
+        html.p([attribute.class("ref-meta")], [
+          html.text(form_copy.landing_meta(question_count)),
+        ]),
+        html.div([attribute.class("consent-notice")], [
+          html.p([], [
+            html.text(form_copy.landing_art14(vars)),
+            html.a(
+              [
+                attribute.href("/privacy#referee-data"),
+                attribute("target", "_blank"),
+                attribute("rel", "noopener noreferrer"),
+              ],
+              [html.text(form_copy.landing_notice_link_text)],
+            ),
+          ]),
+        ]),
+        html.p([], [
+          html.a(
+            [
+              attribute.href(
+                "/reference/"
+                <> token
+                <> "?q="
+                <> first_question_id
+                <> "#q-"
+                <> first_question_id,
+              ),
+              attribute.class("btn-submit ref-start"),
+              attribute("data-testid", "reference-start"),
+            ],
+            [html.text(form_copy.landing_start)],
+          ),
+        ]),
+        html.div([attribute.class("ref-escapes")], [
+          html.p([], [
+            html.text(form_copy.landing_wrong_person(vars) <> " "),
+            html.a(
+              [
+                attribute.href("/reference/" <> token <> "/wrong-person"),
+                attribute("data-testid", "reference-wrong-person-link"),
+              ],
+              [html.text(form_copy.landing_wrong_person_link)],
+            ),
+          ]),
+          html.p([], [
+            html.text(form_copy.landing_decline <> " "),
+            html.a(
+              [
+                attribute.href("/reference/" <> token <> "/decline"),
+                attribute("data-testid", "reference-decline-link"),
+              ],
+              [html.text(form_copy.landing_decline_link)],
+            ),
+          ]),
+        ]),
+      ],
+    ),
+  ])
+}
+
+// -- The form page (all questions; mobile steps are the JS) -------------------------
+
+/// The form page (all questions; mobile steps are the JS). The token is
+/// already baked into each question form's action by the renderer.
+pub fn view_form_page(
+  vars vars: form_copy.CopyVars,
+  questions questions: List(Element(a)),
+) -> String {
+  page_shell(page_title: form_copy.landing_title(vars), body_children: [
+    html.div(
+      [
+        attribute.class("ref-card"),
+        attribute("data-testid", "reference-form-page"),
+      ],
+      questions,
+    ),
+  ])
+}
+
+// -- Review screen (all questions answered; submit is rc3-4's route) -----------------
+
+/// One review row: the question text, a one-line answer summary, and a
+/// Change link into the form page.
+pub type ReviewEntry {
+  ReviewEntry(question_id: String, question_text: String, summary: String)
+}
+
+pub fn view_review(
+  vars vars: form_copy.CopyVars,
+  token token: String,
+  entries entries: List(ReviewEntry),
+) -> String {
+  let change_link = fn(question_id: String) {
+    "/reference/" <> token <> "?q=" <> question_id <> "#q-" <> question_id
+  }
+  page_shell(page_title: form_copy.landing_title(vars), body_children: [
+    html.div(
+      [
+        attribute.class("ref-card"),
+        attribute("data-testid", "reference-review"),
+      ],
+      [
+        html.h1([attribute.class("ref-title")], [
+          html.text(form_copy.review_title),
+        ]),
+        html.dl(
+          [attribute.class("ref-review-list")],
+          list.flat_map(entries, fn(entry) {
+            [
+              html.dt([], [html.text(entry.question_text)]),
+              html.dd([], [
+                html.text(entry.summary <> " "),
+                html.a(
+                  [
+                    attribute.href(change_link(entry.question_id)),
+                    attribute(
+                      "data-testid",
+                      "reference-change-" <> entry.question_id,
+                    ),
+                  ],
+                  [html.text(form_copy.review_change)],
+                ),
+              ]),
+            ]
+          }),
+        ),
+        html.form(
+          [
+            attribute.method("POST"),
+            attribute.action("/reference/" <> token),
+            attribute("novalidate", ""),
+            attribute("data-testid", "reference-review-form"),
+          ],
+          [
+            form_view.view_honeypot_field(),
+            form_view.view_timing_field(
+              loaded_at_ms: form_view.current_unix_ms(),
+            ),
+            html.button(
+              [
+                attribute.type_("submit"),
+                attribute.class("btn-submit"),
+                attribute("data-testid", "reference-submit"),
+              ],
+              [html.text(form_copy.review_submit)],
+            ),
+          ],
+        ),
+      ],
+    ),
+  ])
+}
+
+// -- Token-state pages (UX §8.5) -----------------------------------------------------
+
+fn view_state_card(
+  title title: String,
+  body body: List(Element(a)),
+  testid testid: String,
+) -> String {
+  page_shell(page_title: title, body_children: [
+    html.div(
+      [
+        attribute.class("ref-card ref-state-card"),
+        attribute("data-testid", testid),
+      ],
+      [html.h1([attribute.class("ref-title")], [html.text(title)]), ..body],
+    ),
+  ])
+}
+
+/// Unknown token (404). Never reveals whether a token was ever valid.
+pub fn view_not_found() -> String {
+  view_state_card(
+    title: form_copy.not_found_title,
+    body: [
+      html.p([], [
+        html.text(form_copy.not_found_body <> " "),
+        html.a(
+          [
+            attribute.href("/contact"),
+            attribute("data-testid", "reference-contact-link"),
+          ],
+          [html.text(form_copy.not_found_contact_link)],
+        ),
+      ]),
+    ],
+    testid: "reference-not-found",
+  )
+}
+
+/// Expired, check still open: the self-serve resend form (POST, so link
+/// pre-fetchers can't fire it).
+pub fn view_expired(token token: String) -> String {
+  view_state_card(
+    title: form_copy.expired_title,
+    body: [
+      html.p([], [html.text(form_copy.expired_body)]),
+      html.form(
+        [
+          attribute.method("POST"),
+          attribute.action("/reference/" <> token <> "/resend"),
+          attribute("novalidate", ""),
+          attribute("data-testid", "reference-resend-form"),
+        ],
+        [
+          form_view.view_honeypot_field(),
+          form_view.view_timing_field(loaded_at_ms: form_view.current_unix_ms()),
+          html.button(
+            [
+              attribute.type_("submit"),
+              attribute.class("btn-submit"),
+              attribute("data-testid", "reference-resend"),
+            ],
+            [html.text(form_copy.expired_resend_button)],
+          ),
+        ],
+      ),
+    ],
+    testid: "reference-expired",
+  )
+}
+
+pub fn view_resent() -> String {
+  view_state_card(
+    title: form_copy.resent_title,
+    body: [html.p([], [html.text(form_copy.resent_body)])],
+    testid: "reference-resent",
+  )
+}
+
+/// The resend's honest failure page: every channel failed or skipped, the
+/// remint was rolled back, and the referee can retry from the same form.
+pub fn view_resend_failed(token token: String) -> String {
+  view_state_card(
+    title: form_copy.resend_failed_title,
+    body: [
+      html.p([], [html.text(form_copy.resend_failed_body)]),
+      html.form(
+        [
+          attribute.method("POST"),
+          attribute.action("/reference/" <> token <> "/resend"),
+          attribute("novalidate", ""),
+          attribute("data-testid", "reference-resend-retry-form"),
+        ],
+        [
+          form_view.view_honeypot_field(),
+          form_view.view_timing_field(loaded_at_ms: form_view.current_unix_ms()),
+          html.button(
+            [
+              attribute.type_("submit"),
+              attribute.class("btn-submit"),
+              attribute("data-testid", "reference-resend-retry"),
+            ],
+            [html.text(form_copy.resend_failed_retry_button)],
+          ),
+        ],
+      ),
+    ],
+    testid: "reference-resend-failed",
+  )
+}
+
+pub fn view_completed() -> String {
+  view_state_card(
+    title: form_copy.completed_title,
+    body: [html.p([], [html.text(form_copy.completed_body)])],
+    testid: "reference-completed",
+  )
+}
+
+pub fn view_declined() -> String {
+  view_state_card(
+    title: form_copy.declined_title,
+    body: [html.p([], [html.text(form_copy.declined_body)])],
+    testid: "reference-declined",
+  )
+}
+
+pub fn view_landlord_handling() -> String {
+  view_state_card(
+    title: form_copy.landlord_handling_title,
+    body: [html.p([], [html.text(form_copy.landlord_handling_body)])],
+    testid: "reference-landlord-handling",
+  )
+}
diff --git a/server/src/reference_checks/form_question_pages.gleam b/server/src/reference_checks/form_question_pages.gleam
new file mode 100644
index 00000000..906b4e66
--- /dev/null
+++ b/server/src/reference_checks/form_question_pages.gleam
@@ -0,0 +1,441 @@
+//// Per-question renderers for the referee form (Story RC3.3, T8). Every
+//// question renders as its own `<form>` (per-question POST works without
+//// JS; the desktop single-page layout is all the forms in one scroll, and
+//// the mobile one-question-per-screen behaviour is reference_form.js
+//// hiding the rest). Controls are full-width tappable rows reusing the
+//// form.css attestation-option pattern (UX §11); free text uses the house
+//// resize-y + counter pattern.
+////
+//// Copy comes from `form_copy.gleam` only. Interpolated names render via
+//// html.text (Lustre escapes). The renderer never decides WHAT a page
+//// shows — the handler hands down the question list, the prefill fields
+//// per question, and the current pointer.
+
+import application/form_view
+import gleam/dict
+import gleam/int
+import gleam/list
+import gleam/option.{type Option, None, Some}
+import gleam/result
+import lustre/attribute.{attribute}
+import lustre/element.{type Element}
+import lustre/element/html
+import reference_checks/form_copy
+import reference_checks/questions.{
+  type Question, type RawFields, AmountOrDontRemember, AsStatedAmount,
+  AsStatedText, Choice, ChoiceWithOther, FreeText, Identity, MonthYearOrOngoing,
+  ShortTextPair,
+}
+
+/// One question with everything its render needs.
+pub type QuestionView {
+  QuestionView(
+    question: Question,
+    /// 1-based position in the slot's set (the "Question i of n" line).
+    index: Int,
+    total: Int,
+    /// Raw field values to pre-fill (from the draft on revisit).
+    prefill: RawFields,
+    /// Copy interpolation vars (names + as-stated pre-fill data).
+    vars: form_copy.CopyVars,
+    /// The wrong-person route URL (only the identity question renders it).
+    wrong_person_url: String,
+  )
+}
+
+/// A question section with its own POST form. `current` marks the block the
+/// mobile stepper starts on; `error` carries the inline validation message
+/// when a no-JS POST fails validation.
+pub fn view_question(
+  qv qv: QuestionView,
+  token token: String,
+  loaded_at_ms loaded_at_ms: Int,
+  current current: Bool,
+  back_url back_url: Option(String),
+  error error: Option(String),
+) -> Element(a) {
+  let q = qv.question
+  html.section(
+    [
+      attribute.class("ref-question"),
+      attribute.id("q-" <> q.id),
+      attribute("data-question", q.id),
+      attribute("data-current", case current {
+        True -> "true"
+        False -> "false"
+      }),
+      attribute("data-testid", "reference-question"),
+      attribute("aria-label", form_copy.progress_text(qv.index, qv.total)),
+    ],
+    [
+      html.form(
+        [
+          attribute.method("POST"),
+          attribute.action("/reference/" <> token <> "/answer"),
+          attribute("novalidate", ""),
+          attribute("data-testid", "reference-answer-form"),
+        ],
+        [
+          html.input([
+            attribute.type_("hidden"),
+            attribute.name("_question"),
+            attribute.value(q.id),
+          ]),
+          form_view.view_honeypot_field(),
+          form_view.view_timing_field(loaded_at_ms: loaded_at_ms),
+          html.input([
+            attribute.type_("hidden"),
+            attribute.name("_focus_seconds"),
+            attribute.value("0"),
+            attribute("data-focus-seconds", ""),
+          ]),
+          html.p(
+            [
+              attribute.class("ref-progress"),
+              attribute("data-testid", "reference-progress"),
+            ],
+            [html.text(form_copy.progress_text(qv.index, qv.total))],
+          ),
+          view_title(qv),
+          view_control(qv),
+          case error {
+            Some(message) ->
+              html.p(
+                [
+                  attribute.class("field-error"),
+                  attribute("role", "alert"),
+                  attribute("data-testid", "reference-question-error"),
+                ],
+                [html.text(message)],
+              )
+            None -> element.none()
+          },
+          view_actions(qv, back_url),
+        ],
+      ),
+    ],
+  )
+}
+
+fn view_title(qv: QuestionView) -> Element(a) {
+  html.h2([attribute.class("ref-question-title")], [
+    html.text(qv.question.text(qv.vars)),
+    case qv.question.required {
+      False ->
+        html.span([attribute.class("optional-suffix")], [
+          html.text(" " <> form_copy.optional_marker),
+        ])
+      True -> element.none()
+    },
+  ])
+}
+
+fn view_actions(qv: QuestionView, back_url: Option(String)) -> Element(a) {
+  case qv.question.control {
+    // Identity's primary action IS the "Yes" answer; "No" is a link out.
+    Identity ->
+      html.div([attribute.class("ref-actions")], [
+        html.button(
+          [
+            attribute.type_("submit"),
+            attribute.class("btn-submit"),
+            attribute("data-testid", "reference-continue"),
+          ],
+          [html.text(form_copy.opt_yes)],
+        ),
+        html.a(
+          [
+            attribute.href(qv.wrong_person_url),
+            attribute.class("ref-escape-link"),
+            attribute("data-testid", "reference-wrong-person-link"),
+          ],
+          [html.text(form_copy.q_identity_no_link)],
+        ),
+      ])
+    _ ->
+      html.div([attribute.class("ref-actions")], [
+        case back_url {
+          Some(url) ->
+            html.a(
+              [
+                attribute.href(url),
+                attribute.class("ref-back-link"),
+                attribute("data-testid", "reference-back"),
+              ],
+              [html.text(form_copy.back_label)],
+            )
+          None -> element.none()
+        },
+        html.button(
+          [
+            attribute.type_("submit"),
+            attribute.class("btn-submit"),
+            attribute("data-testid", "reference-continue"),
+          ],
+          [html.text(form_copy.continue_label)],
+        ),
+      ])
+  }
+}
+
+fn view_control(qv: QuestionView) -> Element(a) {
+  let q = qv.question
+  case q.control {
+    Identity ->
+      // The answer rides a hidden field: the visible controls are the Yes
+      // submit and the No link (rendered in view_actions).
+      html.input([
+        attribute.type_("hidden"),
+        attribute.name("a_identity"),
+        attribute.value("yes"),
+      ])
+    Choice(options) -> view_options(q.id, options, qv.prefill)
+    ChoiceWithOther(options) ->
+      html.div([], [
+        view_options(q.id, options, qv.prefill),
+        view_text_field(
+          qv,
+          field: "a_" <> q.id <> "_other",
+          label: form_copy.other_text_label,
+          placeholder: "",
+          max: 200,
+        ),
+      ])
+    MonthYearOrOngoing -> {
+      let ongoing = prefill_value(qv.prefill, "a_tenancy_ongoing") == "on"
+      html.div([], [
+        html.div([attribute.class("field-row")], [
+          html.div([attribute.class("form-field")], [
+            html.label([attribute.for("f_tenancy_from")], [
+              html.text(form_copy.from_label),
+            ]),
+            html.input([
+              attribute.type_("month"),
+              attribute.id("f_tenancy_from"),
+              attribute.name("a_tenancy_from"),
+              attribute.value(prefill_value(qv.prefill, "a_tenancy_from")),
+              attribute("data-testid", "reference-input-tenancy_from"),
+            ]),
+          ]),
+          html.div([attribute.class("form-field")], [
+            html.label([attribute.for("f_tenancy_to")], [
+              html.text(form_copy.to_label),
+            ]),
+            html.input([
+              attribute.type_("month"),
+              attribute.id("f_tenancy_to"),
+              attribute.name("a_tenancy_to"),
+              attribute.value(prefill_value(qv.prefill, "a_tenancy_to")),
+              attribute("data-testid", "reference-input-tenancy_to"),
+            ]),
+          ]),
+        ]),
+        html.div([attribute.class("checkbox-field")], [
+          html.label([attribute.class("checkbox-label")], [
+            html.input([
+              attribute.type_("checkbox"),
+              attribute.name("a_tenancy_ongoing"),
+              attribute.checked(ongoing),
+              attribute("data-testid", "reference-input-tenancy_ongoing"),
+            ]),
+            html.text(" " <> form_copy.ongoing_label),
+          ]),
+        ]),
+      ])
+    }
+    AmountOrDontRemember ->
+      html.div([], [
+        view_amount_field(qv, "a_" <> q.id),
+        view_checkbox(
+          qv,
+          field: "a_" <> q.id <> "_dont_remember",
+          label: form_copy.dont_remember_label,
+          testid: "reference-input-dont_remember",
+        ),
+      ])
+    AsStatedText(prefill) ->
+      case questions.prefill_value(prefill, qv.vars) {
+        // Open variant: no application datum to confirm against — just the
+        // text field (the question text is already the open form).
+        "" ->
+          view_text_field(
+            qv,
+            field: "a_" <> q.id <> "_text",
+            label: "",
+            placeholder: "",
+            max: 200,
+          )
+        _ ->
+          html.div([], [
+            view_options_named(
+              "a_" <> q.id <> "_choice",
+              [
+                #("as_stated", form_copy.about_right_label),
+                #("differs", form_copy.it_differs_label),
+              ],
+              qv.prefill,
+              q.id,
+            ),
+            view_text_field(
+              qv,
+              field: "a_" <> q.id <> "_text",
+              label: form_copy.other_text_label,
+              placeholder: "",
+              max: 200,
+            ),
+          ])
+      }
+    AsStatedAmount ->
+      html.div([], [
+        view_options_named(
+          "a_" <> q.id <> "_choice",
+          [
+            #("as_stated", form_copy.about_right_label),
+            #("different", form_copy.it_was_different_label),
+            #("dont_know", form_copy.dont_know_label),
+          ],
+          qv.prefill,
+          q.id,
+        ),
+        view_amount_field(qv, "a_" <> q.id <> "_amount"),
+      ])
+    ShortTextPair ->
+      html.div([], [
+        view_text_field(
+          qv,
+          field: "a_relationship",
+          label: form_copy.relationship_field_label,
+          placeholder: form_copy.relationship_field_hint,
+          max: 200,
+        ),
+        view_text_field(
+          qv,
+          field: "a_capacity",
+          label: form_copy.capacity_field_label,
+          placeholder: form_copy.capacity_field_hint,
+          max: 200,
+        ),
+      ])
+    FreeText(max_chars) ->
+      html.div([attribute.class("form-field")], [
+        html.textarea(
+          [
+            attribute.name("a_" <> q.id),
+            attribute("maxlength", int.to_string(max_chars)),
+            attribute("data-testid", "reference-input-" <> q.id),
+          ],
+          prefill_value(qv.prefill, "a_" <> q.id),
+        ),
+        html.p([attribute.class("char-counter")], [
+          html.text(form_copy.char_counter_hint(max_chars)),
+        ]),
+      ])
+  }
+}
+
+// -- Control primitives -----------------------------------------------------------
+
+fn view_options(
+  id: String,
+  options: List(#(String, String)),
+  prefill: RawFields,
+) -> Element(a) {
+  view_options_named("a_" <> id, options, prefill, id)
+}
+
+/// Full-width tappable radio rows (the form.css attestation-option pattern).
+fn view_options_named(
+  name: String,
+  options: List(#(String, String)),
+  prefill: RawFields,
+  id: String,
+) -> Element(a) {
+  let current = prefill_value(prefill, name)
+  html.div(
+    [attribute.class("attestation-options"), attribute.role("radiogroup")],
+    list.map(options, fn(opt) {
+      html.label(
+        [
+          attribute.class("attestation-option"),
+          attribute("data-testid", "reference-option-" <> id <> "-" <> opt.0),
+        ],
+        [
+          html.input([
+            attribute.type_("radio"),
+            attribute.name(name),
+            attribute.value(opt.0),
+            attribute.checked(current == opt.0),
+          ]),
+          html.span([attribute.class("attestation-option-label")], [
+            html.text(opt.1),
+          ]),
+        ],
+      )
+    }),
+  )
+}
+
+fn view_text_field(
+  qv qv: QuestionView,
+  field field: String,
+  label label: String,
+  placeholder placeholder: String,
+  max max: Int,
+) -> Element(a) {
+  let input_id = "f_" <> field
+  html.div([attribute.class("form-field")], [
+    case label {
+      "" -> element.none()
+      _ -> html.label([attribute.for(input_id)], [html.text(label)])
+    },
+    html.input([
+      attribute.type_("text"),
+      attribute.id(input_id),
+      attribute.name(field),
+      attribute("maxlength", int.to_string(max)),
+      attribute("placeholder", placeholder),
+      attribute.value(prefill_value(qv.prefill, field)),
+      attribute("data-testid", "reference-input-" <> field),
+    ]),
+  ])
+}
+
+fn view_amount_field(qv: QuestionView, field: String) -> Element(a) {
+  let input_id = "f_" <> field
+  html.div([attribute.class("form-field")], [
+    html.label([attribute.for(input_id)], [
+      html.text(form_copy.amount_placeholder),
+    ]),
+    html.input([
+      attribute.type_("text"),
+      attribute("inputmode", "numeric"),
+      attribute.id(input_id),
+      attribute.name(field),
+      attribute.value(prefill_value(qv.prefill, field)),
+      attribute("data-testid", "reference-input-" <> field),
+    ]),
+  ])
+}
+
+fn view_checkbox(
+  qv qv: QuestionView,
+  field field: String,
+  label label: String,
+  testid testid: String,
+) -> Element(a) {
+  html.div([attribute.class("checkbox-field")], [
+    html.label([attribute.class("checkbox-label")], [
+      html.input([
+        attribute.type_("checkbox"),
+        attribute.name(field),
+        attribute.checked(prefill_value(qv.prefill, field) == "on"),
+        attribute("data-testid", testid),
+      ]),
+      html.text(" " <> label),
+    ]),
+  ])
+}
+
+fn prefill_value(prefill: RawFields, name: String) -> String {
+  dict.get(prefill, name) |> result.unwrap("")
+}
