+/* fieldset-style[hidden] wins over UA display on modern browsers, but the
+   explicit guard keeps the stepper's show/hide unambiguous (the F1
+   form.css precedent). */
+.ref-question[hidden] {
+  display: none;
+}
+
+.ref-progress {
+  color: var(--slate);
+  font-size: 0.85rem;
+  margin: 0 0 0.5rem;
+}
+
+.ref-question-title {
+  color: var(--navy);
+  font-size: 1.15rem;
+  margin: 0 0 1rem;
+}
+
+.ref-actions {
+  display: flex;
+  align-items: center;
+  gap: 1rem;
+  margin-top: 1.25rem;
+  flex-wrap: wrap;
+}
+
+.ref-actions .btn-submit {
+  width: auto;
+  min-width: 10rem;
+}
+
+.ref-back-link,
+.ref-escape-link {
+  color: var(--slate);
+  font-size: 0.95rem;
+}
+
+.ref-escapes {
+  margin-top: 1.5rem;
+  padding-top: 1rem;
+  border-top: 1px solid #e2e8f0;
+  color: var(--slate);
+  font-size: 0.95rem;
+}
+
+.ref-saved-indicator {
+  color: #0f766e;
+  font-size: 0.9rem;
+}
+
+.ref-review-list dt {
+  color: var(--navy);
+  font-weight: 600;
+  margin-top: 1rem;
+}
+
+.ref-review-list dd {
+  margin: 0.25rem 0 0;
+  color: #334155;
+}
+
+.ref-start {
+  display: inline-block;
+  text-align: center;
+  text-decoration: none;
+  padding: 0.75rem 2rem;
+  min-width: 10rem;
+}
+
+.ref-state-card p {
+  color: #334155;
+}
+
+.ref-state-card form {
+  margin-top: 1.25rem;
+}
+
+@media (max-width: 640px) {
+  .ref-card {
+    padding: 1.5rem 1.25rem;
+  }
+}
diff --git a/server/priv/static/reference_form.js b/server/priv/static/reference_form.js
new file mode 100644
index 00000000..6a85a5de
--- /dev/null
+++ b/server/priv/static/reference_form.js
@@ -0,0 +1,210 @@
+// reference_form.js — RC3.3 progressive enhancement for the public
+// /reference/:token referee form. Progressive enhancement ONLY: without
+// this file the form is fully usable (per-question POST + 303 resume is
+// the first-class no-JS path). When active it:
+//   1. Autosaves each answer with a PUT (JSON) instead of a full POST —
+//      no page reload mid-form.
+//   2. On narrow viewports (<1024px) shows one question per screen and
+//      steps forward after each save (the desktop layout is the single
+//      scrolling page; without JS every question renders in one scroll,
+//      the F1 degradation doctrine).
+//   3. Maintains the _focus_seconds hidden field (seconds since page init
+//      while the tab is visible) — client-reported, honestly weak (AD-10);
+//      rc3-4 reads it at submit for the form_session fraud signal. The
+//      server never persists it from the answer routes.
+//
+// Copy — KEEP IN SYNC with server/src/reference_checks/form_copy.gleam
+// (same precedent as form_draft.js): plain static JS can't import Gleam
+// constants. The user-facing strings here are: SAVED_TEXT.
+//
+// Testability: the pure internals are exported (CommonJS) for `node --test`;
+// browser wiring runs only when a document is present.
+
+(function (root) {
+  "use strict";
+
+  // Keep in sync: form_copy.js_saved_indicator.
+  var SAVED_TEXT = "Saved";
+
+  var MOBILE_QUERY = "(max-width: 1023px)";
+
+  // ---------- Pure internals (exported for tests) ----------
+
+  // The next question id after currentId in the slot's ordered list;
+  // null when current is last (the review screen lives at the bare URL).
+  function nextQuestionId(orderedIds, currentId) {
+    var idx = orderedIds.indexOf(currentId);
+    if (idx === -1 || idx + 1 >= orderedIds.length) return null;
+    return orderedIds[idx + 1];
+  }
+
+  // The focus-seconds payload value: whole seconds, never negative, never
+  // a float with noise beyond the second.
+  function clampFocusSeconds(msSinceInit) {
+    if (!isFinite(msSinceInit) || msSinceInit < 0) return "0";
+    return String(Math.floor(msSinceInit / 1000));
+  }
+
+  // The mobile gate: step only below the desktop breakpoint (UX §11).
+  function shouldStep(matchesMedia) {
+    return !!matchesMedia;
+  }
+
+  // ---------- Browser wiring ----------
+
+  function initBrowser() {
+    var page = root.document.querySelector("[data-testid='reference-form-page']");
+    if (!page) return;
+
+    var questions = Array.prototype.slice.call(
+      page.querySelectorAll(".ref-question"),
+    );
+    if (questions.length === 0) return;
+
+    var orderedIds = questions.map(function (q) {
+      return q.getAttribute("data-question");
+    });
+
+    var isMobile =
+      typeof root.matchMedia === "function" &&
+      root.matchMedia(MOBILE_QUERY).matches;
+
+    // Focus accumulator: wall-clock seconds since init while visible.
+    var initMs = Date.now();
+    function currentFocusSeconds() {
+      return clampFocusSeconds(Date.now() - initMs);
+    }
+
+    function sectionFor(id) {
+      for (var i = 0; i < questions.length; i++) {
+        if (questions[i].getAttribute("data-question") === id) {
+          return questions[i];
+        }
+      }
+      return null;
+    }
+
+    function showOnly(id) {
+      questions.forEach(function (q) {
+        q.hidden = q.getAttribute("data-question") !== id;
+      });
+      var current = sectionFor(id);
+      if (current) {
+        var firstControl = current.querySelector("input, textarea, button");
+        if (firstControl && typeof firstControl.focus === "function") {
+          firstControl.focus();
+        }
+        if (typeof current.scrollIntoView === "function") {
+          current.scrollIntoView({ behavior: "instant", block: "start" });
+        }
+      }
+    }
+
+    // Mobile: start on the server-marked current question.
+    if (shouldStep(isMobile)) {
+      var currentEl = page.querySelector(".ref-question[data-current='true']");
+      var startId = currentEl
+        ? currentEl.getAttribute("data-question")
+        : orderedIds[0];
+      showOnly(startId);
+    }
+
+    function markSaved(section) {
+      var actions = section.querySelector(".ref-actions");
+      if (!actions) return;
+      var existing = actions.querySelector(".ref-saved-indicator");
+      if (existing) existing.parentNode.removeChild(existing);
+      var marker = root.document.createElement("span");
+      marker.className = "ref-saved-indicator";
+      marker.setAttribute("data-testid", "reference-saved");
+      marker.textContent = SAVED_TEXT;
+      actions.appendChild(marker);
+    }
+
+    function onSubmit(event) {
+      var form = event.target;
+      var section = form.closest(".ref-question");
+      if (!section) return;
+      event.preventDefault();
+
+      var questionId = section.getAttribute("data-question");
+      var focusField = form.querySelector("[data-focus-seconds]");
+      if (focusField) focusField.value = currentFocusSeconds();
+
+      var fields = {};
+      var data = new root.FormData(form);
+      data.forEach(function (value, key) {
+        fields[key] = String(value);
+      });
+
+      fetch(form.action, {
+        method: "PUT",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ question: questionId, fields: fields }),
+      })
+        .then(function (res) {
+          if (res.status === 409 || res.status === 404) {
+            // The check closed (or the link died) mid-session — reload so
+            // the GET renders the truthful state page.
+            root.location.assign("/reference/" + tokenFromPath());
+            return;
+          }
+          if (!res.ok) {
+            // Validation wants the server-rendered inline error: fall back
+            // to the native POST path.
+            form.removeEventListener("submit", onSubmit);
+            form.submit();
+            return;
+          }
+          markSaved(section);
+          if (shouldStep(isMobile)) {
+            var nextId = nextQuestionId(orderedIds, questionId);
+            if (nextId) {
+              showOnly(nextId);
+            } else {
+              // Last question saved: the bare URL renders the review.
+              root.location.assign("/reference/" + tokenFromPath());
+            }
+          }
+        })
+        .catch(function () {
+          // Network-level failure: fall back to the native POST.
+          form.removeEventListener("submit", onSubmit);
+          form.submit();
+        });
+    }
+
+    function tokenFromPath() {
+      var parts = root.location.pathname.split("/");
+      return parts.length > 2 ? parts[2] : "";
+    }
+
+    questions.forEach(function (section) {
+      var form = section.querySelector("form");
+      if (form) form.addEventListener("submit", onSubmit);
+    });
+  }
+
+  var api = {
+    nextQuestionId: nextQuestionId,
+    clampFocusSeconds: clampFocusSeconds,
+    shouldStep: shouldStep,
+    _initBrowser: initBrowser,
+  };
+
+  if (typeof module !== "undefined" && module.exports) {
+    module.exports = api;
+  }
+
+  if (
+    typeof root.document !== "undefined" &&
+    root.document &&
+    root.document.body
+  ) {
+    if (root.document.readyState === "loading") {
+      root.document.addEventListener("DOMContentLoaded", initBrowser);
+    } else {
+      initBrowser();
+    }
+  }
+})(typeof window !== "undefined" ? window : this);
