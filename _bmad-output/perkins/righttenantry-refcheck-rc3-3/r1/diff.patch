+    identity_question(),
+    Question(
+      id: "relationship",
+      control: ChoiceWithOther([
+        #("landlord", form_copy.opt_their_landlord),
+        #("letting_agent", form_copy.opt_letting_agent),
+        #("other", form_copy.opt_other),
+      ]),
+      required: True,
+      draft_keys: ["relationship_to_applicant"],
+      text: form_copy.q_relationship,
+    ),
+    Question(
+      id: "tenancy_confirmed",
+      control: Choice([
+        #("yes", form_copy.opt_yes),
+        #("no", form_copy.opt_no),
+        #("not_sure", form_copy.opt_not_sure),
