+      required: True,
+      draft_keys: ["tenancy_confirmed"],
+      text: form_copy.q_tenancy_confirmed,
+    ),
+    Question(
+      id: "tenancy_period",
+      control: MonthYearOrOngoing,
+      required: True,
+      draft_keys: ["tenancy_period"],
+      text: form_copy.q_tenancy_period,
+    ),
+    Question(
+      id: "rent_amount",
+      control: AmountOrDontRemember,
+      required: True,
+      draft_keys: ["rent_amount"],
+      text: fn(_vars) { form_copy.q_rent_amount },
+    ),
+    Question(
+      id: "rent_payment_record",
+      control: Choice([
+        #("always_on_time", form_copy.opt_always_on_time),
+        #("mostly_on_time", form_copy.opt_mostly_on_time),
+        #("often_late", form_copy.opt_often_late),
+        #("dont_know", form_copy.dont_know_label),
+      ]),
+      required: True,
+      draft_keys: ["rent_payment_record"],
+      text: fn(_vars) { form_copy.q_rent_payment_record },
+    ),
+    Question(
+      id: "property_condition",
+      control: Choice([
+        #("excellent", form_copy.opt_excellent),
+        #("good", form_copy.opt_good),
+        #("fair", form_copy.opt_fair),
+        #("poor", form_copy.opt_poor),
+        #("did_not_see", form_copy.opt_did_not_see),
+      ]),
+      required: True,
+      draft_keys: ["property_condition"],
+      text: fn(_vars) { form_copy.q_property_condition },
+    ),
+    Question(
+      id: "notice_given_properly",
+      control: Choice([
+        #("yes", form_copy.opt_yes),
+        #("no", form_copy.opt_no),
+        #("ongoing", form_copy.opt_ongoing),
+        #("dont_know", form_copy.dont_know_label),
+      ]),
+      required: True,
+      draft_keys: ["notice_given_properly"],
+      text: fn(_vars) { form_copy.q_notice_given_properly },
+    ),
+    Question(
+      id: "deposit_returned",
+      control: Choice([
+        #("in_full", form_copy.opt_in_full),
+        #("partly", form_copy.opt_partly),
+        #("withheld", form_copy.opt_withheld),
+        #("still_held", form_copy.opt_still_held),
+        #("dont_know", form_copy.dont_know_label),
+      ]),
+      required: True,
+      draft_keys: ["deposit_returned"],
+      text: fn(_vars) { form_copy.q_deposit_returned },
+    ),
+    Question(
+      id: "would_rent_again",
+      control: Choice([
+        #("yes", form_copy.opt_yes),
+        #("no", form_copy.opt_no),
+        #("unsure", form_copy.opt_unsure),
+        #("prefer_not_to_say", form_copy.opt_prefer_not_to_say),
+      ]),
+      required: True,
+      draft_keys: ["would_rent_again"],
+      text: form_copy.q_would_rent_again,
+    ),
+    free_text_question(required: False),
+  ]
+}
+
+fn employer_questions() -> List(Question) {
+  [
+    identity_question(),
+    Question(
+      id: "relationship",
+      control: ChoiceWithOther([
+        #("manager", form_copy.opt_manager),
+        #("hr", form_copy.opt_hr),
+        #("colleague", form_copy.opt_colleague),
+        #("other", form_copy.opt_other),
+      ]),
+      required: True,
+      draft_keys: ["relationship_to_applicant"],
+      text: form_copy.q_relationship,
+    ),
+    Question(
+      id: "works_at_confirmed",
+      control: Choice([
+        #("yes", form_copy.opt_yes),
+        #("no", form_copy.opt_no),
+        #("not_sure", form_copy.opt_not_sure),
+      ]),
+      required: True,
+      draft_keys: ["works_at_confirmed"],
+      text: form_copy.q_works_at,
+    ),
+    Question(
+      id: "employment_period",
+      control: AsStatedText(PrefillEmploymentDuration),
+      required: True,
+      draft_keys: ["employment_period"],
+      text: form_copy.q_employment_period,
+    ),
+    Question(
+      id: "role_confirmed",
+      control: AsStatedText(PrefillJobTitle),
+      required: True,
+      draft_keys: ["role_confirmed"],
+      text: form_copy.q_role,
+    ),
+    Question(
+      id: "salary_confirmed",
+      control: AsStatedAmount,
+      required: True,
+      draft_keys: ["salary_confirmed"],
+      text: form_copy.q_salary,
+    ),
+    Question(
+      id: "would_rehire",
+      control: Choice([
+        #("yes", form_copy.opt_yes),
+        #("no", form_copy.opt_no),
+        #("unsure", form_copy.opt_unsure),
+        #("prefer_not_to_say", form_copy.opt_prefer_not_to_say),
+      ]),
+      required: True,
+      draft_keys: ["would_rehire"],
+      text: fn(_vars) { form_copy.q_would_rehire },
