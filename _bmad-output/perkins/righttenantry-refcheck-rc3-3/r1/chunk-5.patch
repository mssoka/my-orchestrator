diff --git a/server/test/integration/reference_form_integration_test.gleam b/server/test/integration/reference_form_integration_test.gleam
new file mode 100644
index 00000000..221902a3
--- /dev/null
+++ b/server/test/integration/reference_form_integration_test.gleam
@@ -0,0 +1,499 @@
+//// Referee form session integration tests (Story RC3.3) — durable DB-level
+//// pins for the acceptance criteria: landing stamps form_opened_at (AD-10),
+//// autosave persists to draft_answers (A2), resume follows the draft,
+//// token-state pages are truthful per status, the expired-link resend
+//// re-mints + audits (old token dies), and the honeypot/timing posture
+//// silently drops bot writes.
+
+import gleam/dynamic/decode
+import gleam/http
+import gleam/int
+import gleam/json
+import gleam/list
+import gleam/result
+import gleam/string
+import gleeunit/should
+import integration/helpers.{setup, test_server_config}
+import integration/test_db
+import pog
+import unitest
+import wisp/simulate
+
+import application/form_view
+import reference_checks/form_handler
+
+// --- seed helpers ----------------------------------------------------------
+
+/// Seeds landlord + vacancy + application + a reference_call row with a
+/// form token. Returns (db-independent) #(row_id, token). `status` is the
+/// reference_call_status text; `expiry_sql` is a SQL expression fragment
+/// for form_token_expires_at (e.g. "now() + interval '10 days'").
+fn seed_reference_call(
+  db: pog.Connection,
+  email: String,
+  status: String,
+  expiry_sql: String,
+) -> #(String, String) {
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 0)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let assert Ok(returned) =
+    pog.query(
+      "INSERT INTO application (
+         vacancy_id, first_name, last_name, email, phone,
+         employment_status, monthly_income_cents,
+         employer_name, job_title, employment_duration,
+         landlord_ref_name, landlord_ref_email, landlord_ref_phone,
+         never_rented_before, reference_contact_choice
+       )
+       VALUES (
+         $1::uuid, 'Aisling', 'O''Brien', $2, '+353861234567',
+         'employed', 350000,
+         'Acme Ltd', 'Senior Chef', '3 years',
+         'Colm Byrne', 'colm@example.com', '+353871111111',
+         false, 'attested'
+       )
+       RETURNING id::text",
+    )
+    |> pog.parameter(pog.text(vacancy_id))
+    |> pog.parameter(pog.text(email))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  let assert [application_id, ..] = returned.rows
+  let token = "integration-test-token-" <> email
+  let assert Ok(inserted) =
+    pog.query("INSERT INTO reference_call (
+         application_id, ref_slot, status, contact_name, contact_email,
+         contact_phone, form_token, form_token_expires_at, next_attempt_at
+       )
+       VALUES (
+         $1::uuid, 'landlord_ref', $2::reference_call_status, 'Colm Byrne',
+         'colm@example.com', '+353871111111', $3, " <> expiry_sql <> ", now()
+       )
+       RETURNING id::text")
+    |> pog.parameter(pog.text(application_id))
+    |> pog.parameter(pog.text(status))
+    |> pog.parameter(pog.text(token))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  let assert [row_id, ..] = inserted.rows
+  #(row_id, token)
+}
+
+fn get_form(db: pog.Connection, token: String) {
+  let req = simulate.request(http.Get, "/reference/" <> token)
+  form_handler.handle_get(req, test_server_config(db), token)
+}
+
+fn text_column(db: pog.Connection, token: String, column: String) -> String {
+  test_db.query_text(
+    db,
+    "SELECT COALESCE("
+      <> column
+      <> "::text, '') FROM reference_call WHERE form_token = '"
+      <> token
+      <> "'",
+  )
+  |> result.unwrap("missing")
+}
+
+/// A single top-level draft_answers key as text (the ->> operator; avoids
+/// string-matching jsonb's spaced text rendering).
+fn draft_value(db: pog.Connection, token: String, key: String) -> String {
+  test_db.query_text(
+    db,
+    "SELECT COALESCE(draft_answers ->> '"
+      <> key
+      <> "', '<missing>') FROM reference_call WHERE form_token = '"
+      <> token
+      <> "'",
+  )
+  |> result.unwrap("missing")
+}
+
+fn timing_fields() -> List(#(String, String)) {
+  // 10s since page load: above every fast floor, below the stale cap.
+  let loaded = form_view.current_unix_ms() - 10_000
+  [
+    #("_website", ""),
+    #("_form_loaded_at", int.to_string(loaded)),
+  ]
+}
+
+// --- the session -------------------------------------------------------------
+
+pub fn landing_get_stamps_form_opened_at_once_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(_row_id, token) =
+    seed_reference_call(
+      db,
+      "rc33-landing@example.com",
+      "contact_initiated",
+      "now() + interval '10 days'",
+    )
+
+  let first = get_form(db, token)
+  first.status |> should.equal(200)
+  let body = simulate.read_body(first)
+  string.contains(body, "data-testid=\"reference-landing\"") |> should.be_true
+  // The Art 14 block + both escape routes render before any question.
+  string.contains(body, "/privacy#referee-data") |> should.be_true
+  string.contains(body, "/wrong-person") |> should.be_true
+
+  let stamped = text_column(db, token, "form_opened_at")
+  { stamped != "" } |> should.be_true
+
+  // A second GET never moves the stamp.
+  let _ = get_form(db, token)
+  text_column(db, token, "form_opened_at") |> should.equal(stamped)
+}
+
+pub fn unknown_token_is_a_branded_404_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let response = get_form(db, "no-such-token")
+  response.status |> should.equal(404)
+  simulate.read_body(response)
+  |> string.contains("data-testid=\"reference-not-found\"")
+  |> should.be_true
+}
+
+pub fn answer_post_persists_and_redirects_to_next_question_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(_row_id, token) =
+    seed_reference_call(
+      db,
+      "rc33-answer@example.com",
+      "contact_initiated",
+      "now() + interval '10 days'",
+    )
+
+  let req =
+    simulate.request(http.Post, "/reference/" <> token <> "/answer")
+    |> simulate.form_body([
+      #("_question", "identity"),
+      #("a_identity", "yes"),
+      ..timing_fields()
+    ])
+  let response =
+    form_handler.handle_answer_post(req, test_server_config(db), token)
+  response.status |> should.equal(303)
+  // PRG to the next question.
+  let assert Ok(location) = list.key_find(response.headers, "location")
+  string.contains(location, "?q=relationship") |> should.be_true
+  // The draft carries the answer.
+  draft_value(db, token, "identity_confirmed") |> should.equal("yes")
+}
+
+pub fn reopen_resumes_at_next_unanswered_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(_row_id, token) =
+    seed_reference_call(
+      db,
+      "rc33-resume@example.com",
+      "contact_initiated",
+      "now() + interval '10 days'",
+    )
+  let req =
+    simulate.request(http.Post, "/reference/" <> token <> "/answer")
+    |> simulate.form_body([
+      #("_question", "identity"),
+      #("a_identity", "yes"),
+      ..timing_fields()
+    ])
+  let _ = form_handler.handle_answer_post(req, test_server_config(db), token)
+
+  let page = get_form(db, token)
+  let body = simulate.read_body(page)
+  // The landing is skipped once a draft exists; the form page renders with
+  // the current marker on the first unanswered question.
+  string.contains(body, "data-testid=\"reference-landing\"") |> should.be_false
+  string.contains(body, "data-current=\"true\" data-question=\"relationship\"")
+  |> should.be_true
+}
+
+pub fn answer_put_autosaves_json_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(_row_id, token) =
+    seed_reference_call(
+      db,
+      "rc33-put@example.com",
+      "contact_initiated",
+      "now() + interval '10 days'",
+    )
+  let loaded = form_view.current_unix_ms() - 10_000
+  let payload =
+    json.object([
+      #("question", json.string("identity")),
+      #(
+        "fields",
+        json.object([
+          #("a_identity", json.string("yes")),
+          #("_website", json.string("")),
+          #("_form_loaded_at", json.string(int.to_string(loaded))),
+        ]),
+      ),
+    ])
+  let req =
+    simulate.request(http.Put, "/reference/" <> token <> "/answer")
+    |> simulate.json_body(payload)
+  let response =
+    form_handler.handle_answer_put(req, test_server_config(db), token)
+  response.status |> should.equal(200)
+  draft_value(db, token, "identity_confirmed") |> should.equal("yes")
+}
+
+pub fn validation_error_rerenders_with_inline_message_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(_row_id, token) =
+    seed_reference_call(
+      db,
+      "rc33-invalid@example.com",
+      "contact_initiated",
+      "now() + interval '10 days'",
+    )
+  let req =
+    simulate.request(http.Post, "/reference/" <> token <> "/answer")
+    |> simulate.form_body([
+      #("_question", "tenancy_confirmed"),
+      #("a_tenancy_confirmed", ""),
+      ..timing_fields()
+    ])
+  let response =
+    form_handler.handle_answer_post(req, test_server_config(db), token)
+  response.status |> should.equal(200)
+  let body = simulate.read_body(response)
+  string.contains(body, "data-testid=\"reference-question-error\"")
+  |> should.be_true
+  // Nothing persisted.
+  text_column(db, token, "draft_answers") |> should.equal("")
+}
+
+// --- token states ---------------------------------------------------------------
+
+pub fn terminal_rows_render_truthful_pages_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let cases = [
+    #("form_completed", "reference-completed"),
+    #("partial", "reference-completed"),
+    #("refused", "reference-declined"),
+    #("objected", "reference-declined"),
+    #("unreachable", "reference-landlord-handling"),
+    #("manual_recorded", "reference-landlord-handling"),
+    #("awaiting_correction", "reference-landlord-handling"),
+  ]
+  list.each(cases, fn(pair) {
+    let #(status, testid) = pair
+    let #(_row_id, token) =
+      seed_reference_call(
+        db,
+        "rc33-" <> status <> "@example.com",
+        status,
+        "now() + interval '10 days'",
+      )
+    let response = get_form(db, token)
+    response.status |> should.equal(200)
+    simulate.read_body(response)
+    |> string.contains("data-testid=\"" <> testid <> "\"")
+    |> should.be_true
+  })
+}
+
+pub fn expired_open_renders_resend_offer_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(_row_id, token) =
+    seed_reference_call(
+      db,
+      "rc33-expired@example.com",
+      "contact_initiated",
+      "now() - interval '1 day'",
+    )
+  let response = get_form(db, token)
+  response.status |> should.equal(200)
+  let body = simulate.read_body(response)
+  string.contains(body, "data-testid=\"reference-expired\"") |> should.be_true
+  string.contains(body, "action=\"/reference/" <> token <> "/resend\"")
+  |> should.be_true
+}
+
+pub fn resend_all_channels_failed_rolls_back_the_remint_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(row_id, token) =
+    seed_reference_call(
+      db,
+      "rc33-resend@example.com",
+      "contact_initiated",
+      "now() - interval '1 day'",
+    )
+  let req =
+    simulate.request(http.Post, "/reference/" <> token <> "/resend")
+    |> simulate.form_body(timing_fields())
+  let response = form_handler.handle_resend(req, test_server_config(db), token)
+  // The test env has no Resend/Twilio keys, so both channels skip (the
+  // no-op doctrine) — every outcome is non-delivered, so the handler must
+  // NOT claim a send happened.
+  response.status |> should.equal(200)
+  simulate.read_body(response)
+  |> string.contains("data-testid=\"reference-resend-failed\"")
+  |> should.be_true
+
+  // The remint was rolled back: the row still carries the OLD token, still
+  // expired, so the referee's retry starts from the expired page again.
+  let current_token =
+    test_db.query_text(
+      db,
+      "SELECT form_token FROM reference_call WHERE id = '"
+        <> row_id
+        <> "'::uuid",
+    )
+    |> result.unwrap("")
+  current_token |> should.equal(token)
+  let still_expired =
+    test_db.query_text(
+      db,
+      "SELECT (form_token_expires_at < now())::text FROM reference_call WHERE id = '"
+        <> row_id
+        <> "'::uuid",
+    )
+    |> result.unwrap("")
+  still_expired |> should.equal("true")
+
+  // No send happened, so no resend audit row (the evidence would lie).
+  let audit_count =
+    test_db.query_int(db, "SELECT count(*)::int FROM audit_log
+       WHERE entity_id = '" <> row_id <> "'::uuid AND event_type = 'reference_call_link_resent'")
+    |> result.unwrap(0)
+  audit_count |> should.equal(0)
+
+  // And the retry path really works: the old token renders the expired
+  // page with the resend form again.
+  let retry = get_form(db, token)
+  retry.status |> should.equal(200)
+  simulate.read_body(retry)
+  |> string.contains("data-testid=\"reference-expired\"")
+  |> should.be_true
+}
+
+// NOTE on the delivered path: a Delivered outcome needs a real provider
+// 2xx, which the hermetic test env never produces (the house pattern treats
+// provider HTTP as non-hermetic). The delivered branch (remint persists,
+// audit row written, resent page) is pinned by unit tests on the two seams
+// that decide it (any_delivered, resend_audit_details) plus the guarded
+// SQL's integration coverage elsewhere in this file.
+
+pub fn resend_on_a_live_link_redirects_away_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(_row_id, token) =
+    seed_reference_call(
+      db,
+      "rc33-resend-live@example.com",
+      "contact_initiated",
+      "now() + interval '10 days'",
+    )
+  let req =
+    simulate.request(http.Post, "/reference/" <> token <> "/resend")
+    |> simulate.form_body(timing_fields())
+  let response = form_handler.handle_resend(req, test_server_config(db), token)
+  // Not expired -> no resend; the referee is sent back to the live form.
+  response.status |> should.equal(303)
+  text_column(db, token, "form_token") |> should.equal(token)
+}
+
+pub fn taken_over_row_stays_live_but_offers_no_resend_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(row_id, token) =
+    seed_reference_call(
+      db,
+      "rc33-takeover@example.com",
+      "contact_initiated",
+      "now() - interval '1 day'",
+    )
+  // Unexpired + taken over: the form stays live (A7).
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE reference_call SET taken_over_at = now(),
+         form_token_expires_at = now() + interval '2 days'
+       WHERE id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(row_id))
+    |> pog.execute(db)
+  let live = get_form(db, token)
+  live.status |> should.equal(200)
+  simulate.read_body(live)
+  |> string.contains("data-testid=\"reference-landing\"")
+  |> should.be_true
+
+  // Expired + taken over: landlord handling, no resend.
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE reference_call
+         SET form_token_expires_at = now() - interval '1 hour'
+       WHERE id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(row_id))
+    |> pog.execute(db)
+  let handling = get_form(db, token)
+  simulate.read_body(handling)
+  |> string.contains("data-testid=\"reference-landlord-handling\"")
+  |> should.be_true
+}
+
+// --- abuse posture -------------------------------------------------------------------
+
+pub fn honeypot_filled_post_saves_nothing_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(_row_id, token) =
+    seed_reference_call(
+      db,
+      "rc33-honeypot@example.com",
+      "contact_initiated",
+      "now() + interval '10 days'",
+    )
+  let req =
+    simulate.request(http.Post, "/reference/" <> token <> "/answer")
+    |> simulate.form_body([
+      #("_question", "identity"),
+      #("a_identity", "yes"),
+      #("_website", "http://spam.example"),
+      #("_form_loaded_at", last_of(timing_fields())),
+    ])
+  let response =
+    form_handler.handle_answer_post(req, test_server_config(db), token)
+  // Fake advance, nothing persisted.
+  response.status |> should.equal(303)
+  text_column(db, token, "draft_answers") |> should.equal("")
+}
+
+pub fn missing_timing_post_saves_nothing_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(_row_id, token) =
+    seed_reference_call(
+      db,
+      "rc33-timing@example.com",
+      "contact_initiated",
+      "now() + interval '10 days'",
+    )
+  let req =
+    simulate.request(http.Post, "/reference/" <> token <> "/answer")
+    |> simulate.form_body([#("_question", "identity"), #("a_identity", "yes")])
+  let response =
+    form_handler.handle_answer_post(req, test_server_config(db), token)
+  response.status |> should.equal(303)
+  text_column(db, token, "draft_answers") |> should.equal("")
+}
+
+fn last_of(fields: List(#(String, String))) -> String {
+  let assert Ok(#(_, value)) = list.last(fields)
+  value
+}
