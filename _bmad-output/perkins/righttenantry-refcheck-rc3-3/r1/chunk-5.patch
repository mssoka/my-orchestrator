diff --git a/server/test/reference_checks/form_handler_test.gleam b/server/test/reference_checks/form_handler_test.gleam
new file mode 100644
index 00000000..5a6e8f80
--- /dev/null
+++ b/server/test/reference_checks/form_handler_test.gleam
@@ -0,0 +1,303 @@
+//// Unit tests for the referee form handler's pure seams (Story RC3.3):
+//// the token-state classifier matrix (spec table pinned row by row) and
+//// the per-question timing check (the 500ms-floor /apply adaptation).
+
+import application/form_view
+import gleam/int
+import gleam/json
+import gleam/string
+import gleeunit/should
+import reference_checks/form_handler
+import reference_checks/messages
+import shared/reference_call.{
+  AwaitingCorrection, ContactInitiated, Failed, FormCompleted, ManualRecorded,
+  Objected, Partial, Queued, Refused, Skipped, Unreachable,
+}
+
+// -- classify: the spec's matrix, row by row -------------------------------------------
+
+pub fn unknown_token_is_unknown_test() {
+  form_handler.classify(
+    found: False,
+    status: ContactInitiated,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.Unknown)
+}
+
+pub fn live_row_is_live_test() {
+  form_handler.classify(
+    found: True,
+    status: ContactInitiated,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.Live)
+}
+
+pub fn taken_over_but_unexpired_stays_live_test() {
+  // A7: the form link survives warm-handoff takeover.
+  form_handler.classify(
+    found: True,
+    status: ContactInitiated,
+    taken_over: True,
+    expired: False,
+  )
+  |> should.equal(form_handler.Live)
+}
+
+pub fn expired_open_offers_resend_test() {
+  form_handler.classify(
+    found: True,
+    status: ContactInitiated,
+    taken_over: False,
+    expired: True,
+  )
+  |> should.equal(form_handler.ExpiredOpen)
+}
+
+pub fn taken_over_and_expired_is_landlord_handling_test() {
+  // Post-takeover, messages are the landlord's domain — no resend offer.
+  form_handler.classify(
+    found: True,
+    status: ContactInitiated,
+    taken_over: True,
+    expired: True,
+  )
+  |> should.equal(form_handler.LandlordHandling)
+}
+
+pub fn form_completed_is_completed_test() {
+  form_handler.classify(
+    found: True,
+    status: FormCompleted,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.Completed)
+}
+
+pub fn partial_is_completed_test() {
+  // A2: an abandoned-with-answers terminal still closed with answers saved.
+  form_handler.classify(
+    found: True,
+    status: Partial,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.Completed)
+}
+
+pub fn refused_is_declined_test() {
+  form_handler.classify(
+    found: True,
+    status: Refused,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.Declined)
+}
+
+pub fn objected_is_declined_test() {
+  form_handler.classify(
+    found: True,
+    status: Objected,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.Declined)
+}
+
+pub fn manual_recorded_is_landlord_handling_test() {
+  form_handler.classify(
+    found: True,
+    status: ManualRecorded,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.LandlordHandling)
+}
+
+pub fn unreachable_is_landlord_handling_test() {
+  form_handler.classify(
+    found: True,
+    status: Unreachable,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.LandlordHandling)
+}
+
+pub fn failed_is_landlord_handling_test() {
+  form_handler.classify(
+    found: True,
+    status: Failed,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.LandlordHandling)
+}
+
+pub fn awaiting_correction_is_landlord_handling_test() {
+  // The contact details are being corrected — never re-serve the form to
+  // what may be the wrong person (spec decision, R6 ratified).
+  form_handler.classify(
+    found: True,
+    status: AwaitingCorrection,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.LandlordHandling)
+}
+
+pub fn queued_is_unknown_test() {
+  // The token is minted at T0 — a queued row can never carry one.
+  form_handler.classify(
+    found: True,
+    status: Queued,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.Unknown)
+}
+
+pub fn skipped_is_unknown_test() {
+  form_handler.classify(
+    found: True,
+    status: Skipped,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.Unknown)
+}
+
+pub fn terminal_beats_expiry_test() {
+  // A completed reference with an old expiry still says completed (the
+  // terminal truth wins over the clock).
+  form_handler.classify(
+    found: True,
+    status: FormCompleted,
+    taken_over: False,
+    expired: True,
+  )
+  |> should.equal(form_handler.Completed)
+}
+
+pub fn voice_completed_is_completed_test() {
+  // v2-reserved in v1 (unreachable today) — but a completed reference must
+  // never render the unknown-link page.
+  form_handler.classify(
+    found: True,
+    status: reference_call.Completed,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.Completed)
+}
+
+// -- resend outcome branching (edge-case pass) -----------------------------------------
+
+pub fn any_delivered_true_when_a_channel_delivered_test() {
+  form_handler.any_delivered([
+    messages.ChannelOutcome(messages.Email, messages.Delivered, "email-id"),
+    messages.ChannelOutcome(
+      messages.Sms,
+      messages.Skipped,
+      "twilio not configured",
+    ),
+  ])
+  |> should.be_true
+}
+
+pub fn any_delivered_false_when_all_skipped_or_failed_test() {
+  form_handler.any_delivered([
+    messages.ChannelOutcome(
+      messages.Email,
+      messages.Skipped,
+      "no RESEND_API_KEY",
+    ),
+    messages.ChannelOutcome(messages.Sms, messages.Failed, "provider error"),
+  ])
+  |> should.be_false
+}
+
+pub fn resend_audit_details_never_carries_token_or_addresses_test() {
+  let details =
+    form_handler.resend_audit_details([
+      messages.ChannelOutcome(messages.Email, messages.Delivered, "email-id"),
+      messages.ChannelOutcome(
+        messages.Sms,
+        messages.Skipped,
+        "twilio not configured",
+      ),
+    ])
+  let text = json.to_string(details)
+  string.contains(text, "delivered") |> should.be_true
+  string.contains(text, "email") |> should.be_true
+  string.contains(text, "@") |> should.be_false
+  string.contains(text, "+353") |> should.be_false
+}
+
+// -- is_answer_timing_suspicious -----------------------------------------------------------
+
+fn timing_values(delta_ms: Int) -> List(#(String, String)) {
+  let loaded = form_view.current_unix_ms() - delta_ms
+  [#("_form_loaded_at", int.to_string(loaded))]
+}
+
+pub fn timing_missing_field_is_suspicious_test() {
+  form_handler.is_answer_timing_suspicious([]) |> should.be_true
+}
+
+pub fn timing_empty_is_suspicious_test() {
+  form_handler.is_answer_timing_suspicious([#("_form_loaded_at", "")])
+  |> should.be_true
+}
+
+pub fn timing_garbage_is_suspicious_test() {
+  form_handler.is_answer_timing_suspicious([
+    #("_form_loaded_at", "not-a-number"),
+  ])
+  |> should.be_true
+}
+
+pub fn timing_future_is_suspicious_test() {
+  form_handler.is_answer_timing_suspicious(timing_values(-10_000))
+  |> should.be_true
+}
+
+pub fn timing_instant_is_suspicious_test() {
+  // Scripted replay tripwire: 300ms from page load is below the floor.
+  form_handler.is_answer_timing_suspicious(timing_values(300))
+  |> should.be_true
+}
+
+pub fn timing_normal_answer_passes_test() {
+  form_handler.is_answer_timing_suspicious(timing_values(30_000))
+  |> should.be_false
+}
+
+pub fn timing_fast_but_human_passes_test() {
+  // The /apply 2s floor would eat this; the per-question floor is 500ms.
+  form_handler.is_answer_timing_suspicious(timing_values(1500))
+  |> should.be_false
+}
+
+pub fn timing_stale_over_7_days_is_suspicious_test() {
+  form_handler.is_answer_timing_suspicious(timing_values(604_800_001))
+  |> should.be_true
+}
+
+// -- format_annual_salary -----------------------------------------------------------
+
+pub fn annual_salary_formats_thousands_test() {
+  form_handler.format_annual_salary(350_000) |> should.equal("42,000")
+  form_handler.format_annual_salary(83_333) |> should.equal("9,999")
+  form_handler.format_annual_salary(8_333_300) |> should.equal("999,996")
+  form_handler.format_annual_salary(100_000_000) |> should.equal("12,000,000")
+  form_handler.format_annual_salary(50_000) |> should.equal("6,000")
+  form_handler.format_annual_salary(12_500) |> should.equal("1,500")
+  form_handler.format_annual_salary(10_000) |> should.equal("1,200")
+  form_handler.format_annual_salary(8333) |> should.equal("999")
+}
diff --git a/server/test/reference_checks/form_pages_test.gleam b/server/test/reference_checks/form_pages_test.gleam
new file mode 100644
index 00000000..0f55e58a
--- /dev/null
+++ b/server/test/reference_checks/form_pages_test.gleam
@@ -0,0 +1,221 @@
+//// SSR render pins for the referee form pages (Story RC3.3, T8.3). These
+//// assert the SERIALIZED render (Lustre's output: attributes sorted by
+//// name, empty-valued ones bare, apostrophes as &#39;) — never view-source
+//// assumptions. Pins target data-testids and hrefs; verbatim copy lives in
+//// the copy test (apostrophes land as &#39; in serialized HTML).
+
+import gleam/dict
+import gleam/list
+import gleam/option.{None}
+import gleam/string
+import gleeunit/should
+import reference_checks/form_copy
+import reference_checks/form_pages
+import reference_checks/form_question_pages.{type QuestionView, QuestionView}
+import reference_checks/questions
+import shared/reference_call.{LandlordRef}
+
+fn vars() -> form_copy.CopyVars {
+  form_copy.CopyVars(
+    referee_name: "Colm Byrne",
+    referee_first_name: "Colm",
+    applicant_first_name: "Aisling",
+    applicant_full_name: "Aisling O'Brien",
+    employer_name: "Acme Ltd",
+    employment_duration: "3 years",
+    job_title: "Senior Chef",
+    annual_salary: "42,000",
+  )
+}
+
+const token = "test-token-48-chars"
+
+// -- Landing --------------------------------------------------------------------------
+
+pub fn landing_renders_art14_and_both_escape_routes_test() {
+  let page =
+    form_pages.view_landing(
+      vars: vars(),
+      slot: LandlordRef,
+      token: token,
+      first_question_id: "identity",
+      question_count: 11,
+    )
+  string.contains(page, "data-testid=\"reference-landing\"") |> should.be_true
+  // The Art 14 block + notice link.
+  string.contains(page, "/privacy#referee-data") |> should.be_true
+  string.contains(page, "go to the landlord as part of Aisling&#39;s")
+  |> should.be_true
+  // Both escape routes, before any question.
+  string.contains(page, "href=\"/reference/" <> token <> "/wrong-person\"")
+  |> should.be_true
+  string.contains(page, "href=\"/reference/" <> token <> "/decline\"")
+  |> should.be_true
+  string.contains(page, "data-testid=\"reference-start\"") |> should.be_true
+}
+
+pub fn landing_has_no_analytics_or_posthog_test() {
+  // AC7: no analytics on a token-carrying page, ever.
+  let page =
+    form_pages.view_landing(
+      vars: vars(),
+      slot: LandlordRef,
+      token: token,
+      first_question_id: "identity",
+      question_count: 11,
+    )
+  string.lowercase(page) |> string.contains("posthog") |> should.be_false
+  string.contains(page, "apply_analytics") |> should.be_false
+  string.contains(page, "consent.js") |> should.be_false
+  // The static reference script IS linked (self-origin, no inline JS).
+  string.contains(page, "/static/reference_form.js") |> should.be_true
+  string.contains(page, "noindex, nofollow") |> should.be_true
+}
+
+pub fn landing_meta_counts_questions_test() {
+  let page =
+    form_pages.view_landing(
+      vars: vars(),
+      slot: LandlordRef,
+      token: token,
+      first_question_id: "identity",
+      question_count: 11,
+    )
+  string.contains(page, "11 questions") |> should.be_true
+}
+
+// -- Form page -------------------------------------------------------------------------
+
+fn question_views() -> List(QuestionView) {
+  let slot = LandlordRef
+  questions.questions_for(slot)
+  |> list.index_map(fn(q, i) {
+    QuestionView(
+      question: q,
+      index: i + 1,
+      total: 11,
+      prefill: dict.new(),
+      vars: vars(),
+      wrong_person_url: "/reference/" <> token <> "/wrong-person",
+    )
+  })
+}
+
+pub fn form_page_renders_every_question_with_forms_test() {
+  let qvs = question_views()
+  let elements =
+    list.map(qvs, fn(qv) {
+      form_question_pages.view_question(
+        qv:,
+        token:,
+        loaded_at_ms: 1_700_000_000_000,
+        current: qv.question.id == "identity",
+        back_url: None,
+        error: None,
+      )
+    })
+  let page = form_pages.view_form_page(vars: vars(), questions: elements)
+  // Every landlord question renders its own POST form to the answer route.
+  string.contains(page, "action=\"/reference/" <> token <> "/answer\"")
+  |> should.be_true
+  string.contains(page, "id=\"q-identity\"") |> should.be_true
+  string.contains(page, "id=\"q-would_rent_again\"") |> should.be_true
+  string.contains(page, "id=\"q-free_text\"") |> should.be_true
+  // The honeypot + timing + focus fields ride each form.
+  string.contains(page, "name=\"_website\"") |> should.be_true
+  string.contains(page, "name=\"_form_loaded_at\"") |> should.be_true
+  string.contains(page, "name=\"_focus_seconds\"") |> should.be_true
+  // Progress + the aria announcement.
+  string.contains(page, "Question 4 of 11") |> should.be_true
+  // Option rows are pinned by testid.
+  string.contains(
+    page,
+    "data-testid=\"reference-option-tenancy_confirmed-yes\"",
+  )
+  |> should.be_true
+  // The identity question carries the wrong-person link.
+  string.contains(page, "data-testid=\"reference-wrong-person-link\"")
+  |> should.be_true
+}
+
+// -- Review screen -----------------------------------------------------------------------
+
+pub fn review_screen_lists_summaries_and_submit_test() {
+  let entries = [
+    form_pages.ReviewEntry(
+      question_id: "identity",
+      question_text: "Are you Colm Byrne?",
+      summary: "Yes",
+    ),
+    form_pages.ReviewEntry(
+      question_id: "rent_amount",
+      question_text: "What was the monthly rent?",
+      summary: "€1400",
+    ),
+  ]
+  let page =
+    form_pages.view_review(vars: vars(), token: token, entries: entries)
+  string.contains(page, "data-testid=\"reference-review\"") |> should.be_true
+  string.contains(page, "€1400") |> should.be_true
+  string.contains(
+    page,
+    "href=\"/reference/" <> token <> "?q=rent_amount#q-rent_amount\"",
+  )
+  |> should.be_true
+  // The submit posts to the bare route — rc3-4's forward contract.
+  string.contains(page, "action=\"/reference/" <> token <> "\"")
+  |> should.be_true
+  string.contains(page, "data-testid=\"reference-submit\"") |> should.be_true
+}
+
+// -- Token-state pages ----------------------------------------------------------------------
+
+pub fn not_found_page_is_truthful_and_links_contact_test() {
+  let page = form_pages.view_not_found()
+  string.contains(page, "data-testid=\"reference-not-found\"") |> should.be_true
+  string.contains(page, "doesn&#39;t look right") |> should.be_true
+  string.contains(page, "href=\"/contact\"") |> should.be_true
+}
+
+pub fn expired_page_offers_the_resend_form_test() {
+  let page = form_pages.view_expired(token: token)
+  string.contains(page, "data-testid=\"reference-expired\"") |> should.be_true
+  string.contains(page, "action=\"/reference/" <> token <> "/resend\"")
+  |> should.be_true
+  string.contains(page, "data-testid=\"reference-resend\"") |> should.be_true
+  // The resend form is bot-guarded too.
+  string.contains(page, "name=\"_website\"") |> should.be_true
+  string.contains(page, "name=\"_form_loaded_at\"") |> should.be_true
+}
+
+pub fn resent_page_renders_test() {
+  let page = form_pages.view_resent()
+  string.contains(page, "data-testid=\"reference-resent\"") |> should.be_true
+  string.contains(page, "We&#39;ve sent a fresh link") |> should.be_true
+}
+
+pub fn resend_failed_page_offers_a_working_retry_test() {
+  let page = form_pages.view_resend_failed(token: token)
+  string.contains(page, "data-testid=\"reference-resend-failed\"")
+  |> should.be_true
+  string.contains(page, "Couldn&#39;t send the link") |> should.be_true
+  // The retry posts the resend form again (the rollback restored the old
+  // token's expired page, so this POST works).
+  string.contains(page, "action=\"/reference/" <> token <> "/resend\"")
+  |> should.be_true
+  string.contains(page, "name=\"_website\"") |> should.be_true
+}
+
+pub fn completed_declined_handling_pages_are_distinct_test() {
+  let completed = form_pages.view_completed()
+  let declined = form_pages.view_declined()
+  let handling = form_pages.view_landlord_handling()
+  string.contains(completed, "already completed") |> should.be_true
+  string.contains(declined, "was declined") |> should.be_true
+  string.contains(handling, "handling this reference directly")
+  |> should.be_true
+  // No dead ends: each is its own testid.
+  string.contains(completed, "reference-completed") |> should.be_true
+  string.contains(declined, "reference-declined") |> should.be_true
+  string.contains(handling, "reference-landlord-handling") |> should.be_true
+}
diff --git a/server/test/reference_checks/questions_test.gleam b/server/test/reference_checks/questions_test.gleam
new file mode 100644
index 00000000..6262d8d7
--- /dev/null
+++ b/server/test/reference_checks/questions_test.gleam
@@ -0,0 +1,408 @@
+//// Unit tests for the per-slot question registry (Story RC3.3, T2):
+//// set counts (11/8/5), unique ids, closed option vocabs, resume logic
+//// (next_unanswered across partial drafts), and per-control validation —
+//// the draft_answers contract rc3-4 consumes.
+
+import gleam/dict
+import gleam/json
+import gleam/list
+import gleam/option.{None, Some}
+import gleam/string
+import gleeunit/should
+import reference_checks/form_copy
+import reference_checks/questions
+import shared/reference_call.{CharacterRef, EmployerRef, LandlordRef}
+
+fn vars() -> form_copy.CopyVars {
+  form_copy.CopyVars(
+    referee_name: "Colm Byrne",
+    referee_first_name: "Colm",
+    applicant_first_name: "Aisling",
+    applicant_full_name: "Aisling O'Brien",
+    employer_name: "Acme Ltd",
+    employment_duration: "3 years",
+    job_title: "Senior Chef",
+    annual_salary: "42,000",
+  )
+}
+
+fn open_vars() -> form_copy.CopyVars {
+  form_copy.CopyVars(..vars(), employment_duration: "", job_title: "")
+}
+
+fn fields(pairs: List(#(String, String))) -> questions.RawFields {
+  dict.from_list(pairs)
+}
+
+fn find(slot, id) -> questions.Question {
+  let assert Some(q) = questions.question_by_id(slot, id)
+  q
+}
+
+// -- Registry integrity ----------------------------------------------------------
+
+pub fn landlord_set_has_11_questions_test() {
+  questions.questions_for(LandlordRef) |> list.length |> should.equal(11)
+}
+
+pub fn employer_set_has_8_questions_test() {
+  questions.questions_for(EmployerRef) |> list.length |> should.equal(8)
+}
+
+pub fn character_set_has_5_questions_test() {
+  questions.questions_for(CharacterRef) |> list.length |> should.equal(5)
+}
+
+pub fn question_ids_are_unique_per_slot_test() {
+  [LandlordRef, EmployerRef, CharacterRef]
+  |> list.each(fn(slot) {
+    let ids = questions.questions_for(slot) |> list.map(fn(q) { q.id })
+    ids |> list.unique |> list.length |> should.equal(list.length(ids))
+  })
+}
+
+pub fn free_text_is_optional_except_character_statement_test() {
+  find(LandlordRef, "free_text").required |> should.be_false
+  find(EmployerRef, "free_text").required |> should.be_false
+  find(CharacterRef, "character_statement").required |> should.be_true
+}
+
+// -- Resume -----------------------------------------------------------------------
+
+pub fn next_unanswered_is_first_with_empty_draft_test() {
+  let assert Some(q) = questions.next_unanswered(LandlordRef, draft_keys: [])
+  q.id |> should.equal("identity")
+}
+
+pub fn next_unanswered_skips_answered_test() {
+  let assert Some(q) =
+    questions.next_unanswered(LandlordRef, draft_keys: [
+      "identity_confirmed",
+      "relationship_to_applicant",
+    ])
+  q.id |> should.equal("tenancy_confirmed")
+}
+
+pub fn next_unanswered_none_when_all_answered_test() {
+  let all_keys =
+    questions.questions_for(LandlordRef)
+    |> list.flat_map(fn(q) { q.draft_keys })
+  questions.next_unanswered(LandlordRef, draft_keys: all_keys)
+  |> should.equal(None)
+}
+
+pub fn character_capacity_question_needs_both_keys_test() {
+  // Only one of the two keys present -> still unanswered.
+  let assert Some(q) =
+    questions.next_unanswered(CharacterRef, draft_keys: [
+      "identity_confirmed", "relationship",
+    ])
+  q.id |> should.equal("relationship_capacity")
+}
+
+pub fn previous_question_links_backward_test() {
+  let assert Some(prev) =
+    questions.previous_question(LandlordRef, "tenancy_confirmed")
+  prev.id |> should.equal("relationship")
+  questions.previous_question(LandlordRef, "identity") |> should.equal(None)
+}
+
+// -- Validation: choices -------------------------------------------------------------
+
+pub fn identity_yes_validates_test() {
+  let q = find(LandlordRef, "identity")
+  let assert Ok(entries) =
+    questions.validate_answer(
+      q:,
+      vars: vars(),
+      fields: fields([#("a_identity", "yes")]),
+    )
+  entries
+  |> should.equal([#("identity_confirmed", json.string("yes"))])
+}
+
+pub fn identity_no_is_invalid_test() {
+  // "No" is a link out to the wrong-person route — never a stored answer.
+  let q = find(LandlordRef, "identity")
+  questions.validate_answer(
+    q:,
+    vars: vars(),
+    fields: fields([#("a_identity", "no")]),
+  )
+  |> should.be_error
+}
+
+pub fn choice_rejects_out_of_vocab_value_test() {
+  let q = find(LandlordRef, "tenancy_confirmed")
+  questions.validate_answer(
+    q:,
+    vars: vars(),
+    fields: fields([#("a_tenancy_confirmed", "maybe")]),
+  )
+  |> should.be_error
+}
+
+pub fn choice_with_other_requires_other_text_test() {
+  let q = find(LandlordRef, "relationship")
+  questions.validate_answer(
+    q:,
+    vars: vars(),
+    fields: fields([#("a_relationship", "other")]),
+  )
+  |> should.be_error
+}
+
+pub fn choice_with_other_stores_both_keys_test() {
+  let q = find(LandlordRef, "relationship")
+  let assert Ok(entries) =
+    questions.validate_answer(
+      q:,
+      vars: vars(),
+      fields: fields([
+        #("a_relationship", "other"),
+        #("a_relationship_other", "Her uncle"),
+      ]),
+    )
+  entries
+  |> should.equal([
+    #("relationship_to_applicant", json.string("other")),
+    #("relationship_other", json.string("Her uncle")),
+  ])
+}
+
+pub fn switching_off_other_nulls_the_stale_other_text_test() {
+  // Edge-case pass: "other" saved earlier, then a named option re-saved —
+  // the conditional key must be nulled (the jsonb merge never deletes).
+  let q = find(LandlordRef, "relationship")
+  let assert Ok(entries) =
+    questions.validate_answer(
+      q:,
+      vars: vars(),
+      fields: fields([#("a_relationship", "landlord")]),
+    )
+  entries
+  |> should.equal([
+    #("relationship_to_applicant", json.string("landlord")),
+    #("relationship_other", json.null()),
+  ])
+}
+
+// -- Validation: compound controls ------------------------------------------------------
+
+pub fn tenancy_period_from_to_validates_test() {
+  let q = find(LandlordRef, "tenancy_period")
+  let assert Ok([#("tenancy_period", value)]) =
+    questions.validate_answer(
+      q:,
+      vars: vars(),
+      fields: fields([
+        #("a_tenancy_from", "2023-06"),
+        #("a_tenancy_to", "2025-05"),
+      ]),
+    )
+  json.to_string(value)
+  |> should.equal("{\"from\":\"2023-06\",\"to\":\"2025-05\"}")
+}
+
+pub fn tenancy_period_ongoing_validates_test() {
+  let q = find(LandlordRef, "tenancy_period")
+  let assert Ok([#("tenancy_period", value)]) =
+    questions.validate_answer(
+      q:,
+      vars: vars(),
+      fields: fields([
+        #("a_tenancy_from", "2023-06"),
+        #("a_tenancy_ongoing", "on"),
+      ]),
+    )
+  json.to_string(value)
+  |> should.equal("{\"from\":\"2023-06\",\"ongoing\":true}")
+}
+
+pub fn tenancy_period_rejects_to_before_from_test() {
+  let q = find(LandlordRef, "tenancy_period")
+  questions.validate_answer(
+    q:,
+    vars: vars(),
+    fields: fields([
+      #("a_tenancy_from", "2025-06"),
+      #("a_tenancy_to", "2023-05"),
+    ]),
+  )
+  |> should.be_error
+}
+
+pub fn tenancy_period_rejects_malformed_month_test() {
+  let q = find(LandlordRef, "tenancy_period")
+  questions.validate_answer(
+    q:,
+    vars: vars(),
+    fields: fields([
+      #("a_tenancy_from", "June 2023"),
+      #("a_tenancy_to", "2025-05"),
+    ]),
+  )
+  |> should.be_error
+}
+
+pub fn rent_amount_validates_whole_euros_test() {
+  let q = find(LandlordRef, "rent_amount")
+  let assert Ok([#("rent_amount", value)]) =
+    questions.validate_answer(
+      q:,
+      vars: vars(),
+      fields: fields([#("a_rent_amount", "1400")]),
+    )
+  json.to_string(value) |> should.equal("{\"amount_eur\":\"1400\"}")
+}
+
+pub fn rent_amount_dont_remember_validates_test() {
+  let q = find(LandlordRef, "rent_amount")
+  let assert Ok([#("rent_amount", value)]) =
+    questions.validate_answer(
+      q:,
+      vars: vars(),
+      fields: fields([#("a_rent_amount_dont_remember", "on")]),
+    )
+  json.to_string(value) |> should.equal("{\"dont_remember\":true}")
+}
+
+pub fn rent_amount_rejects_non_numeric_test() {
+  let q = find(LandlordRef, "rent_amount")
+  questions.validate_answer(
+    q:,
+    vars: vars(),
+    fields: fields([#("a_rent_amount", "1,400")]),
+  )
+  |> should.be_error
+}
+
+// -- Validation: as-stated controls -----------------------------------------------------
+
+pub fn as_stated_confirms_the_prefill_test() {
+  let q = find(EmployerRef, "role_confirmed")
+  let assert Ok([#("role_confirmed", value)]) =
+    questions.validate_answer(
+      q:,
+      vars: vars(),
+      fields: fields([#("a_role_confirmed_choice", "as_stated")]),
+    )
+  json.to_string(value) |> should.equal("{\"as_stated\":true}")
+}
+
+pub fn as_stated_differs_carries_text_test() {
+  let q = find(EmployerRef, "employment_period")
+  let assert Ok([#("employment_period", value)]) =
+    questions.validate_answer(
+      q:,
+      vars: vars(),
+      fields: fields([
+        #("a_employment_period_choice", "differs"),
+        #("a_employment_period_text", "About 2 years"),
+      ]),
+    )
+  json.to_string(value) |> should.equal("{\"differs\":\"About 2 years\"}")
+}
+
+pub fn as_stated_open_variant_when_prefill_absent_test() {
+  // The as-stated data-availability matrix: no job_title on the application
+  // -> the question degrades to its open form and stores {"stated": ...}.
+  let q = find(EmployerRef, "role_confirmed")
+  let assert Ok([#("role_confirmed", value)]) =
+    questions.validate_answer(
+      q:,
+      vars: open_vars(),
+      fields: fields([#("a_role_confirmed_text", "Head Chef")]),
+    )
+  json.to_string(value) |> should.equal("{\"stated\":\"Head Chef\"}")
+}
+
+pub fn as_stated_choice_ignored_when_prefill_absent_test() {
+  // A stale "as_stated" post against an open-variant question must not
+  // fabricate a confirmation against nothing.
+  let q = find(EmployerRef, "role_confirmed")
+  questions.validate_answer(
+    q:,
+    vars: open_vars(),
+    fields: fields([#("a_role_confirmed_choice", "as_stated")]),
+  )
+  |> should.be_error
+}
+
+pub fn salary_different_amount_validates_test() {
+  let q = find(EmployerRef, "salary_confirmed")
+  let assert Ok([#("salary_confirmed", value)]) =
+    questions.validate_answer(
+      q:,
+      vars: vars(),
+      fields: fields([
+        #("a_salary_confirmed_choice", "different"),
+        #("a_salary_confirmed_amount", "45000"),
+      ]),
+    )
+  json.to_string(value) |> should.equal("{\"different_amount_eur\":\"45000\"}")
+}
+
+pub fn salary_dont_know_validates_test() {
+  let q = find(EmployerRef, "salary_confirmed")
+  let assert Ok([#("salary_confirmed", value)]) =
+    questions.validate_answer(
+      q:,
+      vars: vars(),
+      fields: fields([#("a_salary_confirmed_choice", "dont_know")]),
+    )
+  json.to_string(value) |> should.equal("{\"dont_know\":true}")
+}
+
+// -- Validation: text controls ------------------------------------------------------------
+
+pub fn character_capacity_stores_both_texts_test() {
+  let q = find(CharacterRef, "relationship_capacity")
+  let assert Ok(entries) =
+    questions.validate_answer(
+      q:,
+      vars: vars(),
+      fields: fields([
+        #("a_relationship", "Friend"),
+        #("a_capacity", "Five-a-side team"),
+      ]),
+    )
+  entries
+  |> should.equal([
+    #("relationship", json.string("Friend")),
+    #("capacity", json.string("Five-a-side team")),
+  ])
+}
+
+pub fn required_free_text_rejects_empty_test() {
+  let q = find(CharacterRef, "character_statement")
+  questions.validate_answer(
+    q:,
+    vars: vars(),
+    fields: fields([#("a_character_statement", "")]),
+  )
+  |> should.be_error
+}
+
+pub fn optional_free_text_stores_empty_string_test() {
+  // "Answered with nothing" is stored as "" so resume never re-asks.
+  let q = find(LandlordRef, "free_text")
+  let assert Ok([#("free_text", value)]) =
+    questions.validate_answer(
+      q:,
+      vars: vars(),
+      fields: fields([#("a_free_text", "")]),
+    )
+  value |> should.equal(json.string(""))
+}
+
+pub fn free_text_rejects_over_1000_chars_test() {
+  let q = find(LandlordRef, "free_text")
+  let long = string.repeat("a", 1001)
+  questions.validate_answer(
+    q:,
+    vars: vars(),
+    fields: fields([#("a_free_text", long)]),
+  )
+  |> should.be_error
+}
