+++ b/server/src/reference_checks/sql/restore_form_token.sql
@@ -0,0 +1,14 @@
+--- restore_form_token(new_token: String, old_token: String, old_expiry: String)
+-- The resend rollback (Story RC3.3 edge-case pass): when a remint succeeded
+-- but EVERY channel send then failed or skipped, the referee would hold a
+-- dead old link and never receive the new one — and the "On its way" page
+-- would lie. The handler restores the old token + its (expired) TTL so the
+-- referee's retry starts from the truthful expired page again. Guarded on
+-- the new token (identity) AND the live status — a concurrent terminal
+-- transition mid-resend must not get a resurrected token.
+UPDATE reference_call
+SET form_token = $2::text,
+    form_token_expires_at = NULLIF($3, '')::timestamptz
+WHERE form_token = $1
+  AND status = 'contact_initiated'
+RETURNING id::text;
diff --git a/server/src/reference_checks/sql/save_draft_answer.sql b/server/src/reference_checks/sql/save_draft_answer.sql
new file mode 100644
index 00000000..a729559e
--- /dev/null
+++ b/server/src/reference_checks/sql/save_draft_answer.sql
@@ -0,0 +1,13 @@
+--- save_draft_answer(form_token: String, patch: Json)
+-- A2 autosave: merge one question's answer patch into draft_answers (top-
+-- level jsonb || = per-key upsert; keys are the question registry's draft
+-- keys). Guarded (AD-14): only a live, unexpired row accepts writes — a
+-- terminal row stands down silently (0 rows) and a taken-over row still
+-- saves (the form link stays live through warm handoff, A7). The status
+-- guard names the single live state; every other state stands down.
+UPDATE reference_call
+SET draft_answers = COALESCE(draft_answers, '{}'::jsonb) || $2::jsonb
+WHERE form_token = $1
+  AND status = 'contact_initiated'
+  AND (form_token_expires_at IS NULL OR form_token_expires_at > now())
+RETURNING id::text;
diff --git a/server/src/reference_checks/sql/stamp_form_opened.sql b/server/src/reference_checks/sql/stamp_form_opened.sql
new file mode 100644
index 00000000..c0bdbdca
--- /dev/null
+++ b/server/src/reference_checks/sql/stamp_form_opened.sql
@@ -0,0 +1,10 @@
+--- stamp_form_opened(form_token: String)
+-- AD-10: the first live-form GET stamps form_opened_at (the
+-- completion_seconds input for form_session fraud signals). Guarded on
+-- IS NULL so repeat opens never move the stamp; 0 rows = already stamped
+-- (or unknown token), which the handler treats as success either way.
+UPDATE reference_call
+SET form_opened_at = now()
+WHERE form_token = $1
+  AND form_opened_at IS NULL
+RETURNING id::text;
