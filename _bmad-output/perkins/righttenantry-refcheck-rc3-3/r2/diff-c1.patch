+// Unit tests for server/priv/static/reference_form.js — run with
+// `node --test scripts/js-tests/*.test.js` (wired into `make test`).
+//
+// Covers the pure seams of the RC3.3 enhancement: step advancement
+// (next-question resolution), the focus-seconds clamp, and the mobile
+// gate. The DOM choreography (hide/show, fetch wiring) is covered E2E by
+// bug-hunt scenarios.
+
+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+
+const referenceForm = require("../../server/priv/static/reference_form.js");
+
+test("nextQuestionId advances in registry order", () => {
+  const ids = ["identity", "relationship", "tenancy_confirmed"];
+  assert.equal(referenceForm.nextQuestionId(ids, "identity"), "relationship");
+  assert.equal(
+    referenceForm.nextQuestionId(ids, "relationship"),
+    "tenancy_confirmed",
+  );
+});
+
+test("nextQuestionId returns null on the last question", () => {
+  const ids = ["identity", "relationship"];
+  assert.equal(referenceForm.nextQuestionId(ids, "relationship"), null);
+});
+
+test("nextQuestionId returns null for an unknown id", () => {
+  assert.equal(referenceForm.nextQuestionId(["identity"], "bogus"), null);
+});
+
+test("clampFocusSeconds floors to whole seconds", () => {
+  assert.equal(referenceForm.clampFocusSeconds(0), "0");
+  assert.equal(referenceForm.clampFocusSeconds(999), "0");
+  assert.equal(referenceForm.clampFocusSeconds(2500), "2");
+});
+
+test("clampFocusSeconds is defensive about garbage", () => {
+  assert.equal(referenceForm.clampFocusSeconds(-50), "0");
+  assert.equal(referenceForm.clampFocusSeconds(NaN), "0");
+  assert.equal(referenceForm.clampFocusSeconds(Infinity), "0");
+});
+
+test("shouldStep follows the media-query match", () => {
+  assert.equal(referenceForm.shouldStep(true), true);
+  assert.equal(referenceForm.shouldStep(false), false);
+});
diff --git a/scripts/js-tests/reference_form_wiring.test.js b/scripts/js-tests/reference_form_wiring.test.js
new file mode 100644
index 00000000..b8c3d0fd
--- /dev/null
+++ b/scripts/js-tests/reference_form_wiring.test.js
@@ -0,0 +1,253 @@
+// Wiring tests for server/priv/static/reference_form.js — drives the
+// browser choreography (mobile step hiding, PUT payload, 409 reload,
+// native-POST fallback, review navigation, capability gate) through the
+// env-injected _initBrowser(env) seam with a fake DOM. The pure seams
+// (nextQuestionId, clampFocusSeconds) live in reference_form.test.js.
+// The per-question server paths themselves are pinned by the Gleam
+// integration suite.
+
+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+
+const referenceForm = require("../../server/priv/static/reference_form.js");
+
+// ---------- Fake DOM ----------
+
+function fakeInput(name, value) {
+  return { name, value };
+}
+
+function fakeSection(questionId, current) {
+  const listeners = {};
+  const hidden = { name: "_question", value: questionId };
+  const timing = { name: "_form_loaded_at", value: "123" };
+  const focus = {
+    name: "_focus_seconds",
+    value: "0",
+    attrs: { "data-focus-seconds": "" },
+    querySelector: null,
+  };
+  const section = {
+    hidden: false,
+    focused: false,
+    scrolled: false,
+    getAttribute(name) {
+      if (name === "data-question") return questionId;
+      if (name === "data-current") return current ? "true" : "false";
+      return null;
+    },
+    querySelector(sel) {
+      if (sel === "form") return form;
+      if (sel === ".ref-actions") return actions;
+      if (sel === ".btn-submit") {
+        return { focus: () => { this.focused = true; } };
+      }
+      return null;
+    },
+    scrollIntoView() {
+      this.scrolled = true;
+    },
+  };
+  const form = {
+    action: "/reference/tok/answer",
+    listeners,
+    submitted: false,
+    addEventListener(event, fn) {
+      listeners[event] = fn;
+    },
+    removeEventListener(event) {
+      delete listeners[event];
+    },
+    submit() {
+      this.submitted = true;
+    },
+    closest(sel) {
+      return sel === ".ref-question" ? section : null;
+    },
+    querySelector(sel) {
+      if (sel === "[data-focus-seconds]") return focus;
+      return null;
+    },
+    _fields: [hidden, timing, focus],
+  };
+  const actions = {
+    children: [],
+    appendChild(el) {
+      this.children.push(el);
+    },
+    querySelector(sel) {
+      if (sel === ".ref-saved-indicator") {
+        return this.children.find((c) => c.className === "ref-saved-indicator") || null;
+      }
+      return null;
+    },
+  };
+  section.form = form;
+  section.actions = actions;
+  return section;
+}
+
+// Builds the fake environment. opts: { mobile, fetchStatus, sections, pathname }
+function fakeEnv(opts = {}) {
+  const sections = opts.sections || [
+    fakeSection("identity", true),
+    fakeSection("relationship", false),
+  ];
+  const fetchCalls = [];
+  const assigned = [];
+  const created = [];
+  const page = {
+    querySelector(sel) {
+      if (sel === ".ref-question[data-current='true']") {
+        return sections.find((s) => s.getAttribute("data-current") === "true") || null;
+      }
+      return null;
+    },
+    querySelectorAll(sel) {
+      return sel === ".ref-question" ? sections : [];
+    },
+  };
+  const env = {
+    document: {
+      querySelector(sel) {
+        return sel === "[data-testid='reference-form-page']" ? page : null;
+      },
+      createElement(tag) {
+        const el = { tag, attrs: {}, className: "", textContent: "", setAttribute(k, v) { this.attrs[k] = v; } };
+        created.push(el);
+        return el;
+      },
+    },
+    fetch: (url, init) => {
+      fetchCalls.push({ url, init });
+      const status = opts.fetchStatus === undefined ? 200 : opts.fetchStatus;
+      return Promise.resolve({ ok: status >= 200 && status < 300, status });
+    },
+    FormData: function (form) {
+      this.forEach = (fn) => {
+        form._fields.forEach((f) => fn(f.value, f.name));
+      };
+    },
+    location: {
+      // location.pathname never carries a query string in a real browser.
+      pathname: opts.pathname || "/reference/tok",
+      assign(url) {
+        assigned.push(url);
+      },
+    },
+    matchMedia: (q) => ({ matches: !!opts.mobile }),
+    Date: {
+      // Mutable clock: init stamps the page load, submissions happen 5s in.
+      now: () => env._now,
+    },
+    _now: 1_700_000_000_000,
+  };
+  return { env, sections, fetchCalls, assigned, created };
+}
+
+function submit(section, env) {
+  if (env) env._now += 5_000;
+  const form = section.form;
+  const event = {
+    target: form,
+    prevented: false,
+    preventDefault() {
+      this.prevented = true;
+    },
+  };
+  form.listeners.submit(event);
+  return event;
+}
+
+// ---------- Tests ----------
+
+test("mobile init hides every question except the server-marked current", () => {
+  const { env, sections } = fakeEnv({ mobile: true });
+  referenceForm._initBrowser(env);
+  assert.equal(sections[0].hidden, false);
+  assert.equal(sections[1].hidden, true);
+});
+
+test("desktop init leaves every question visible (single scrolling page)", () => {
+  const { env, sections } = fakeEnv({ mobile: false });
+  referenceForm._initBrowser(env);
+  assert.equal(sections[0].hidden, false);
+  assert.equal(sections[1].hidden, false);
+});
+
+test("submit PUTs the answer payload with question + fields", async () => {
+  const { env, sections, fetchCalls } = fakeEnv({});
+  referenceForm._initBrowser(env);
+  const event = submit(sections[0], env);
+  await Promise.resolve();
+  assert.equal(event.prevented, true);
+  assert.equal(fetchCalls.length, 1);
+  assert.equal(fetchCalls[0].url, "/reference/tok/answer");
+  assert.equal(fetchCalls[0].init.method, "PUT");
+  const body = JSON.parse(fetchCalls[0].init.body);
+  assert.equal(body.question, "identity");
+  assert.equal(body.fields._question, "identity");
+  // The focus-seconds field is refreshed from the page clock.
+  assert.equal(body.fields._focus_seconds, "5");
+});
+
+test("409 reloads so the GET renders the truthful state page", async () => {
+  const { env, sections, assigned } = fakeEnv({ fetchStatus: 409 });
+  referenceForm._initBrowser(env);
+  submit(sections[0]);
+  await Promise.resolve();
+  assert.deepEqual(assigned, ["/reference/tok"]);
+});
+
+test("mobile steps forward after a save; desktop does not", async () => {
+  const mobile = fakeEnv({ mobile: true });
+  referenceForm._initBrowser(mobile.env);
+  submit(mobile.sections[0]);
+  await Promise.resolve();
+  assert.equal(mobile.sections[0].hidden, true);
+  assert.equal(mobile.sections[1].hidden, false);
+  assert.equal(mobile.sections[1].focused, true);
+
+  const desktop = fakeEnv({ mobile: false });
+  referenceForm._initBrowser(desktop.env);
+  submit(desktop.sections[0]);
+  await Promise.resolve();
+  assert.equal(desktop.sections[0].hidden, false);
+  assert.equal(desktop.sections[1].hidden, false);
+});
+
+test("saving the last question navigates to the review on every viewport", async () => {
+  for (const mobile of [true, false]) {
+    const ctx = fakeEnv({ mobile });
+    referenceForm._initBrowser(ctx.env);
+    submit(ctx.sections[1]);
+    await Promise.resolve();
+    assert.deepEqual(ctx.assigned, ["/reference/tok"]);
+  }
+});
+
+test("400 falls back to the native POST for the server-rendered error", async () => {
+  const { env, sections } = fakeEnv({ fetchStatus: 400 });
+  referenceForm._initBrowser(env);
+  const form = sections[0].form;
+  submit(sections[0]);
+  await Promise.resolve();
+  await Promise.resolve();
+  assert.equal(form.submitted, true);
+  assert.equal(form.listeners.submit, undefined);
+});
+
+test("a fetch-less environment keeps the native POST path untouched", () => {
+  const { env, sections } = fakeEnv({});
+  env.fetch = undefined;
+  referenceForm._initBrowser(env);
+  assert.equal(sections[0].form.listeners.submit, undefined);
+  assert.equal(sections[0].hidden, false);
+});
+
+test("a FormData-less environment keeps the native POST path untouched", () => {
+  const { env, sections } = fakeEnv({});
+  env.FormData = undefined;
+  referenceForm._initBrowser(env);
+  assert.equal(sections[0].form.listeners.submit, undefined);
+});
