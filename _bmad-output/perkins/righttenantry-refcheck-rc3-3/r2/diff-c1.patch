+  })
+}
+
+pub fn expired_open_renders_resend_offer_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(_row_id, token) =
+    seed_reference_call(
+      db,
+      "rc33-expired@example.com",
+      "contact_initiated",
+      "now() - interval '1 day'",
+    )
+  let response = get_form(db, token)
+  response.status |> should.equal(200)
+  let body = simulate.read_body(response)
+  string.contains(body, "data-testid=\"reference-expired\"") |> should.be_true
+  string.contains(body, "action=\"/reference/" <> token <> "/resend\"")
+  |> should.be_true
+}
+
+pub fn resend_all_channels_failed_rolls_back_the_remint_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(row_id, token) =
+    seed_reference_call(
+      db,
+      "rc33-resend@example.com",
+      "contact_initiated",
+      "now() - interval '1 day'",
+    )
+  let req =
+    simulate.request(http.Post, "/reference/" <> token <> "/resend")
+    |> simulate.form_body(timing_fields())
+  let response = form_handler.handle_resend(req, test_server_config(db), token)
+  // The test env has no Resend/Twilio keys, so both channels skip (the
+  // no-op doctrine) — every outcome is non-delivered, so the handler must
+  // NOT claim a send happened.
+  response.status |> should.equal(200)
+  simulate.read_body(response)
+  |> string.contains("data-testid=\"reference-resend-failed\"")
+  |> should.be_true
+
+  // The remint was rolled back: the row still carries the OLD token, still
+  // expired, so the referee's retry starts from the expired page again.
+  let current_token =
+    test_db.query_text(
+      db,
+      "SELECT form_token FROM reference_call WHERE id = '"
+        <> row_id
+        <> "'::uuid",
+    )
+    |> result.unwrap("")
+  current_token |> should.equal(token)
+  let still_expired =
+    test_db.query_text(
+      db,
+      "SELECT (form_token_expires_at < now())::text FROM reference_call WHERE id = '"
+        <> row_id
+        <> "'::uuid",
+    )
+    |> result.unwrap("")
+  still_expired |> should.equal("true")
+
+  // No send happened, so no resend audit row (the evidence would lie).
+  let audit_count =
+    test_db.query_int(db, "SELECT count(*)::int FROM audit_log
+       WHERE entity_id = '" <> row_id <> "'::uuid AND event_type = 'reference_call_link_resent'")
+    |> result.unwrap(0)
+  audit_count |> should.equal(0)
+
+  // And the retry path really works: the old token renders the expired
+  // page with the resend form again.
+  let retry = get_form(db, token)
+  retry.status |> should.equal(200)
+  simulate.read_body(retry)
+  |> string.contains("data-testid=\"reference-expired\"")
+  |> should.be_true
+}
+
+// NOTE on the delivered path: a Delivered outcome needs a real provider
+// 2xx, which the hermetic test env never produces (the house pattern treats
+// provider HTTP as non-hermetic). The delivered branch (remint persists,
+// audit row written, resent page) is pinned by unit tests on the two seams
+// that decide it (any_delivered, resend_audit_details) plus the guarded
+// SQL's integration coverage elsewhere in this file.
+
+pub fn resend_on_a_live_link_redirects_away_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(_row_id, token) =
+    seed_reference_call(
+      db,
+      "rc33-resend-live@example.com",
+      "contact_initiated",
+      "now() + interval '10 days'",
+    )
+  let req =
+    simulate.request(http.Post, "/reference/" <> token <> "/resend")
+    |> simulate.form_body(timing_fields())
+  let response = form_handler.handle_resend(req, test_server_config(db), token)
+  // Not expired -> no resend; the referee is sent back to the live form.
+  response.status |> should.equal(303)
+  text_column(db, token, "form_token") |> should.equal(token)
+}
+
+pub fn taken_over_row_stays_live_but_offers_no_resend_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(row_id, token) =
+    seed_reference_call(
+      db,
+      "rc33-takeover@example.com",
+      "contact_initiated",
+      "now() - interval '1 day'",
+    )
+  // Unexpired + taken over: the form stays live (A7).
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE reference_call SET taken_over_at = now(),
+         form_token_expires_at = now() + interval '2 days'
+       WHERE id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(row_id))
+    |> pog.execute(db)
+  let live = get_form(db, token)
+  live.status |> should.equal(200)
+  simulate.read_body(live)
+  |> string.contains("data-testid=\"reference-landing\"")
+  |> should.be_true
+
+  // Expired + taken over: landlord handling, no resend.
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE reference_call
+         SET form_token_expires_at = now() - interval '1 hour'
+       WHERE id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(row_id))
+    |> pog.execute(db)
+  let handling = get_form(db, token)
+  simulate.read_body(handling)
+  |> string.contains("data-testid=\"reference-landlord-handling\"")
+  |> should.be_true
+}
+
+// --- abuse posture -------------------------------------------------------------------
+
+pub fn honeypot_filled_post_saves_nothing_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(_row_id, token) =
+    seed_reference_call(
+      db,
+      "rc33-honeypot@example.com",
+      "contact_initiated",
+      "now() + interval '10 days'",
+    )
+  let req =
+    simulate.request(http.Post, "/reference/" <> token <> "/answer")
+    |> simulate.form_body([
+      #("_question", "identity"),
+      #("a_identity", "yes"),
+      #("_website", "http://spam.example"),
+      #("_form_loaded_at", last_of(timing_fields())),
+    ])
+  let response =
+    form_handler.handle_answer_post(req, test_server_config(db), token)
+  // Fake advance, nothing persisted.
+  response.status |> should.equal(303)
+  text_column(db, token, "draft_answers") |> should.equal("")
+}
+
