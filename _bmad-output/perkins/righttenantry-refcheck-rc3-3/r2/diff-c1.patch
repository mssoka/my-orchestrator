+pub fn reference_routes_skip_csrf_with_a_session_cookie_test() {
+  // The Perkins r1 blocker: a referee whose browser holds rt_session (a
+  // landlord testing their own invite link) must NOT 403 on any of the
+  // referee POST/PUT routes — the form_token is the capability.
+  [http.Post, http.Put]
+  |> list.each(fn(method) {
+    let paths = [
+      "/reference/tok/answer",
+      "/reference/tok/resend",
+    ]
+    list.each(paths, fn(path) {
+      let req =
+        simulate.request(method, path)
+        |> simulate.cookie(
+          cookie_names.session(),
+          "test_access_token",
+          wisp.Signed,
+        )
+      let resp = csrf.validate(req, "my_secret_key", fn() { ok_handler() })
+      resp.status |> should.equal(200)
+    })
+  })
+}
