+  |> should.be_true
+  // Nothing persisted.
+  text_column(db, token, "draft_answers") |> should.equal("")
+}
+
+// --- token states ---------------------------------------------------------------
+
+pub fn terminal_rows_render_truthful_pages_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let cases = [
+    #("form_completed", "reference-completed"),
+    #("partial", "reference-completed"),
+    #("refused", "reference-declined"),
+    #("objected", "reference-declined"),
+    #("unreachable", "reference-landlord-handling"),
+    #("manual_recorded", "reference-landlord-handling"),
+    #("awaiting_correction", "reference-landlord-handling"),
+  ]
+  list.each(cases, fn(pair) {
+    let #(status, testid) = pair
+    let #(_row_id, token) =
+      seed_reference_call(
+        db,
+        "rc33-" <> status <> "@example.com",
+        status,
+        "now() + interval '10 days'",
+      )
+    let response = get_form(db, token)
+    response.status |> should.equal(200)
+    simulate.read_body(response)
+    |> string.contains("data-testid=\"" <> testid <> "\"")
