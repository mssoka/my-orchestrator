+      #("question", json.string("identity")),
+      #(
+        "fields",
+        json.object([
+          #("a_identity", json.string("yes")),
+          #("_website", json.string("")),
+          #("_form_loaded_at", json.string(int.to_string(loaded))),
+        ]),
+      ),
+    ])
+  let req =
+    simulate.request(http.Put, "/reference/" <> token <> "/answer")
+    |> simulate.json_body(payload)
+  let response =
+    form_handler.handle_answer_put(req, test_server_config(db), token)
+  response.status |> should.equal(200)
+  draft_value(db, token, "identity_confirmed") |> should.equal("yes")
+}
+
+pub fn validation_error_rerenders_with_inline_message_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(_row_id, token) =
+    seed_reference_call(
