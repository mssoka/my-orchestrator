diff --git a/server/src/auth/csrf.gleam b/server/src/auth/csrf.gleam
index 93a679dc..4d8ceefe 100644
--- a/server/src/auth/csrf.gleam
+++ b/server/src/auth/csrf.gleam
@@ -73,6 +73,9 @@ pub fn validate(
 ///   /dsar/:token would otherwise hit CSRF without an X-CSRF-Token header)
 /// - Erasure (token-gated; same rationale as DSAR — the 288-bit token in
 ///   the URL IS the capability, session cookies are irrelevant)
+/// - Referee form (token-gated; same rationale as DSAR — a landlord testing
+///   their own /reference/:token link holds rt_session but sends no
+///   X-CSRF-Token)
 /// - Cookie consent (accepts anonymous tenants on /apply with no session;
 ///   security boundary is Cloudflare rate-limit + strict input validation
 ///   + session-derived landlord_id, not CSRF)
@@ -99,6 +102,12 @@ fn should_skip(path: List(String)) -> Bool {
     ["apply", _, "draft-erasure", _] -> True
     ["dsar", _] -> True
     ["erase", _] -> True
+    // Referee form (AD-3 capability-token family): the ~288-bit form_token
+    // in the URL IS the capability — session cookies are irrelevant. A
+    // logged-in landlord testing their own invite link (or any referee who
+    // also holds an rt_session) would otherwise hit CSRF without an
+    // X-CSRF-Token header and lose their answer. Same rationale as DSAR.
+    ["reference", ..] -> True
     _ -> False
   }
 }
