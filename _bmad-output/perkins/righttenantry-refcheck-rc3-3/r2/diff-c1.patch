+pub fn resend_delivered_remints_audits_and_kills_the_old_link_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(row_id, token) =
+    seed_reference_call(
+      db,
+      "rc33-resend-delivered@example.com",
+      "contact_initiated",
+      "now() - interval '1 day'",
+    )
+  let row = case sql.get_form_context_by_form_token(db, token) {
+    Ok(pog.Returned(_, [row, ..])) -> row
+    _ -> panic as "seeded row must exist"
+  }
+  let response =
+    form_handler.resend_with_send(
+      test_server_config(db),
+      token,
+      row,
+      delivered_send,
+    )
+  response.status |> should.equal(200)
+  simulate.read_body(response)
+  |> string.contains("data-testid=\"reference-resent\"")
+  |> should.be_true
+
+  // The token was re-minted with a fresh TTL...
+  let new_token =
+    test_db.query_text(
+      db,
+      "SELECT form_token FROM reference_call WHERE id = '"
+        <> row_id
+        <> "'::uuid",
+    )
+    |> result.unwrap("")
+  { new_token != "" && new_token != token } |> should.be_true
+
+  // ...the audit row landed with channel outcomes and NO token...
+  let audit_count =
+    test_db.query_int(db, "SELECT count(*)::int FROM audit_log
+       WHERE entity_id = '" <> row_id <> "'::uuid AND event_type = 'reference_call_link_resent'")
+    |> result.unwrap(0)
+  audit_count |> should.equal(1)
+  let audit_details =
+    test_db.query_text(db, "SELECT details::text FROM audit_log
+       WHERE entity_id = '" <> row_id <> "'::uuid AND event_type = 'reference_call_link_resent'")
+    |> result.unwrap("")
+  string.contains(audit_details, "delivered") |> should.be_true
+  string.contains(audit_details, new_token) |> should.be_false
+
+  // ...and the old link is dead while the new one serves the form.
+  let old = get_form(db, token)
+  old.status |> should.equal(404)
+  let new_page = get_form(db, new_token)
+  new_page.status |> should.equal(200)
+}
