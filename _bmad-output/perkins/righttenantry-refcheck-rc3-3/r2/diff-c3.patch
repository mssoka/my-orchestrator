+++ b/server/src/reference_checks/form_question_pages.gleam
@@ -0,0 +1,441 @@
+//// Per-question renderers for the referee form (Story RC3.3, T8). Every
+//// question renders as its own `<form>` (per-question POST works without
+//// JS; the desktop single-page layout is all the forms in one scroll, and
+//// the mobile one-question-per-screen behaviour is reference_form.js
+//// hiding the rest). Controls are full-width tappable rows reusing the
+//// form.css attestation-option pattern (UX §11); free text uses the house
+//// resize-y + counter pattern.
+////
+//// Copy comes from `form_copy.gleam` only. Interpolated names render via
+//// html.text (Lustre escapes). The renderer never decides WHAT a page
+//// shows — the handler hands down the question list, the prefill fields
+//// per question, and the current pointer.
+
+import application/form_view
+import gleam/dict
+import gleam/int
+import gleam/list
+import gleam/option.{type Option, None, Some}
+import gleam/result
+import lustre/attribute.{attribute}
+import lustre/element.{type Element}
+import lustre/element/html
+import reference_checks/form_copy
+import reference_checks/questions.{
+  type Question, type RawFields, AmountOrDontRemember, AsStatedAmount,
+  AsStatedText, Choice, ChoiceWithOther, FreeText, Identity, MonthYearOrOngoing,
+  ShortTextPair,
+}
+
+/// One question with everything its render needs.
+pub type QuestionView {
+  QuestionView(
+    question: Question,
+    /// 1-based position in the slot's set (the "Question i of n" line).
+    index: Int,
+    total: Int,
+    /// Raw field values to pre-fill (from the draft on revisit).
+    prefill: RawFields,
+    /// Copy interpolation vars (names + as-stated pre-fill data).
+    vars: form_copy.CopyVars,
+    /// The wrong-person route URL (only the identity question renders it).
+    wrong_person_url: String,
+  )
+}
+
+/// A question section with its own POST form. `current` marks the block the
+/// mobile stepper starts on; `error` carries the inline validation message
+/// when a no-JS POST fails validation.
+pub fn view_question(
+  qv qv: QuestionView,
+  token token: String,
+  loaded_at_ms loaded_at_ms: Int,
+  current current: Bool,
+  back_url back_url: Option(String),
+  error error: Option(String),
+) -> Element(a) {
+  let q = qv.question
+  html.section(
+    [
+      attribute.class("ref-question"),
+      attribute.id("q-" <> q.id),
+      attribute("data-question", q.id),
+      attribute("data-current", case current {
+        True -> "true"
+        False -> "false"
+      }),
+      attribute("data-testid", "reference-question"),
+      attribute("aria-label", form_copy.progress_text(qv.index, qv.total)),
+    ],
+    [
+      html.form(
+        [
+          attribute.method("POST"),
+          attribute.action("/reference/" <> token <> "/answer"),
+          attribute("novalidate", ""),
+          attribute("data-testid", "reference-answer-form"),
+        ],
+        [
+          html.input([
+            attribute.type_("hidden"),
+            attribute.name("_question"),
+            attribute.value(q.id),
+          ]),
+          form_view.view_honeypot_field(),
+          form_view.view_timing_field(loaded_at_ms: loaded_at_ms),
+          html.input([
+            attribute.type_("hidden"),
+            attribute.name("_focus_seconds"),
+            attribute.value("0"),
+            attribute("data-focus-seconds", ""),
+          ]),
+          html.p(
+            [
+              attribute.class("ref-progress"),
+              attribute("data-testid", "reference-progress"),
+            ],
+            [html.text(form_copy.progress_text(qv.index, qv.total))],
+          ),
+          view_title(qv),
+          view_control(qv),
+          case error {
+            Some(message) ->
+              html.p(
+                [
+                  attribute.class("field-error"),
+                  attribute("role", "alert"),
+                  attribute("data-testid", "reference-question-error"),
+                ],
+                [html.text(message)],
+              )
+            None -> element.none()
+          },
+          view_actions(qv, back_url),
+        ],
+      ),
+    ],
+  )
+}
+
+fn view_title(qv: QuestionView) -> Element(a) {
+  html.h2([attribute.class("ref-question-title")], [
+    html.text(qv.question.text(qv.vars)),
+    case qv.question.required {
+      False ->
+        html.span([attribute.class("optional-suffix")], [
+          html.text(" " <> form_copy.optional_marker),
+        ])
+      True -> element.none()
+    },
+  ])
+}
+
+fn view_actions(qv: QuestionView, back_url: Option(String)) -> Element(a) {
+  case qv.question.control {
+    // Identity's primary action IS the "Yes" answer; "No" is a link out.
+    Identity ->
+      html.div([attribute.class("ref-actions")], [
+        html.button(
+          [
+            attribute.type_("submit"),
+            attribute.class("btn-submit"),
+            attribute("data-testid", "reference-continue"),
+          ],
+          [html.text(form_copy.opt_yes)],
+        ),
+        html.a(
+          [
+            attribute.href(qv.wrong_person_url),
+            attribute.class("ref-escape-link"),
+            attribute("data-testid", "reference-wrong-person-link"),
+          ],
+          [html.text(form_copy.q_identity_no_link)],
+        ),
+      ])
+    _ ->
+      html.div([attribute.class("ref-actions")], [
+        case back_url {
+          Some(url) ->
+            html.a(
+              [
+                attribute.href(url),
+                attribute.class("ref-back-link"),
+                attribute("data-testid", "reference-back"),
+              ],
+              [html.text(form_copy.back_label)],
+            )
+          None -> element.none()
+        },
+        html.button(
+          [
+            attribute.type_("submit"),
+            attribute.class("btn-submit"),
+            attribute("data-testid", "reference-continue"),
+          ],
+          [html.text(form_copy.continue_label)],
+        ),
+      ])
+  }
+}
+
+fn view_control(qv: QuestionView) -> Element(a) {
+  let q = qv.question
+  case q.control {
+    Identity ->
+      // The answer rides a hidden field: the visible controls are the Yes
+      // submit and the No link (rendered in view_actions).
+      html.input([
+        attribute.type_("hidden"),
+        attribute.name("a_identity"),
+        attribute.value("yes"),
+      ])
+    Choice(options) -> view_options(q.id, options, qv.prefill)
+    ChoiceWithOther(options) ->
+      html.div([], [
+        view_options(q.id, options, qv.prefill),
+        view_text_field(
+          qv,
+          field: "a_" <> q.id <> "_other",
+          label: form_copy.other_text_label,
+          placeholder: "",
+          max: 200,
+        ),
+      ])
+    MonthYearOrOngoing -> {
+      let ongoing = prefill_value(qv.prefill, "a_tenancy_ongoing") == "on"
+      html.div([], [
+        html.div([attribute.class("field-row")], [
+          html.div([attribute.class("form-field")], [
+            html.label([attribute.for("f_tenancy_from")], [
+              html.text(form_copy.from_label),
+            ]),
+            html.input([
+              attribute.type_("month"),
+              attribute.id("f_tenancy_from"),
+              attribute.name("a_tenancy_from"),
+              attribute.value(prefill_value(qv.prefill, "a_tenancy_from")),
+              attribute("data-testid", "reference-input-tenancy_from"),
+            ]),
+          ]),
+          html.div([attribute.class("form-field")], [
+            html.label([attribute.for("f_tenancy_to")], [
+              html.text(form_copy.to_label),
+            ]),
+            html.input([
+              attribute.type_("month"),
+              attribute.id("f_tenancy_to"),
+              attribute.name("a_tenancy_to"),
+              attribute.value(prefill_value(qv.prefill, "a_tenancy_to")),
+              attribute("data-testid", "reference-input-tenancy_to"),
+            ]),
+          ]),
+        ]),
+        html.div([attribute.class("checkbox-field")], [
+          html.label([attribute.class("checkbox-label")], [
+            html.input([
+              attribute.type_("checkbox"),
+              attribute.name("a_tenancy_ongoing"),
+              attribute.checked(ongoing),
+              attribute("data-testid", "reference-input-tenancy_ongoing"),
+            ]),
+            html.text(" " <> form_copy.ongoing_label),
+          ]),
+        ]),
+      ])
+    }
+    AmountOrDontRemember ->
+      html.div([], [
+        view_amount_field(qv, "a_" <> q.id),
+        view_checkbox(
+          qv,
+          field: "a_" <> q.id <> "_dont_remember",
+          label: form_copy.dont_remember_label,
+          testid: "reference-input-" <> q.id <> "-dont_remember",
+        ),
+      ])
+    AsStatedText(prefill) ->
+      case questions.prefill_value(prefill, qv.vars) {
+        // Open variant: no application datum to confirm against — just the
+        // text field (the question text is already the open form).
+        "" ->
+          view_text_field(
+            qv,
+            field: "a_" <> q.id <> "_text",
+            label: "",
+            placeholder: "",
+            max: 200,
+          )
+        _ ->
+          html.div([], [
+            view_options_named(
+              "a_" <> q.id <> "_choice",
+              [
+                #("as_stated", form_copy.about_right_label),
+                #("differs", form_copy.it_differs_label),
+              ],
+              qv.prefill,
+              q.id,
+            ),
+            view_text_field(
+              qv,
+              field: "a_" <> q.id <> "_text",
+              label: form_copy.other_text_label,
+              placeholder: "",
+              max: 200,
+            ),
+          ])
+      }
+    AsStatedAmount ->
+      html.div([], [
+        view_options_named(
+          "a_" <> q.id <> "_choice",
+          [
+            #("as_stated", form_copy.about_right_label),
+            #("different", form_copy.it_was_different_label),
+            #("dont_know", form_copy.dont_know_label),
+          ],
+          qv.prefill,
+          q.id,
+        ),
+        view_amount_field(qv, "a_" <> q.id <> "_amount"),
+      ])
+    ShortTextPair ->
+      html.div([], [
+        view_text_field(
+          qv,
+          field: "a_relationship",
+          label: form_copy.relationship_field_label,
+          placeholder: form_copy.relationship_field_hint,
+          max: 200,
+        ),
+        view_text_field(
+          qv,
+          field: "a_capacity",
+          label: form_copy.capacity_field_label,
+          placeholder: form_copy.capacity_field_hint,
+          max: 200,
+        ),
+      ])
+    FreeText(max_chars) ->
+      html.div([attribute.class("form-field")], [
+        html.textarea(
+          [
+            attribute.name("a_" <> q.id),
+            attribute("maxlength", int.to_string(max_chars)),
+            attribute("data-testid", "reference-input-" <> q.id),
+          ],
+          prefill_value(qv.prefill, "a_" <> q.id),
+        ),
+        html.p([attribute.class("char-counter")], [
+          html.text(form_copy.char_counter_hint(max_chars)),
+        ]),
+      ])
+  }
+}
+
+// -- Control primitives -----------------------------------------------------------
+
+fn view_options(
+  id: String,
+  options: List(#(String, String)),
+  prefill: RawFields,
+) -> Element(a) {
+  view_options_named("a_" <> id, options, prefill, id)
+}
+
+/// Full-width tappable radio rows (the form.css attestation-option pattern).
+fn view_options_named(
+  name: String,
+  options: List(#(String, String)),
+  prefill: RawFields,
+  id: String,
+) -> Element(a) {
+  let current = prefill_value(prefill, name)
+  html.div(
+    [attribute.class("attestation-options"), attribute.role("radiogroup")],
+    list.map(options, fn(opt) {
+      html.label(
+        [
+          attribute.class("attestation-option"),
+          attribute("data-testid", "reference-option-" <> id <> "-" <> opt.0),
+        ],
+        [
+          html.input([
+            attribute.type_("radio"),
+            attribute.name(name),
+            attribute.value(opt.0),
+            attribute.checked(current == opt.0),
+          ]),
+          html.span([attribute.class("attestation-option-label")], [
+            html.text(opt.1),
+          ]),
+        ],
+      )
+    }),
+  )
+}
+
+fn view_text_field(
+  qv qv: QuestionView,
+  field field: String,
+  label label: String,
+  placeholder placeholder: String,
+  max max: Int,
+) -> Element(a) {
+  let input_id = "f_" <> field
+  html.div([attribute.class("form-field")], [
+    case label {
+      "" -> element.none()
+      _ -> html.label([attribute.for(input_id)], [html.text(label)])
+    },
+    html.input([
+      attribute.type_("text"),
+      attribute.id(input_id),
+      attribute.name(field),
+      attribute("maxlength", int.to_string(max)),
+      attribute("placeholder", placeholder),
+      attribute.value(prefill_value(qv.prefill, field)),
+      attribute("data-testid", "reference-input-" <> field),
+    ]),
+  ])
+}
+
+fn view_amount_field(qv: QuestionView, field: String) -> Element(a) {
+  let input_id = "f_" <> field
+  html.div([attribute.class("form-field")], [
+    html.label([attribute.for(input_id)], [
+      html.text(form_copy.amount_placeholder),
+    ]),
+    html.input([
+      attribute.type_("text"),
+      attribute("inputmode", "numeric"),
+      attribute.id(input_id),
+      attribute.name(field),
+      attribute.value(prefill_value(qv.prefill, field)),
+      attribute("data-testid", "reference-input-" <> field),
+    ]),
+  ])
+}
+
+fn view_checkbox(
+  qv qv: QuestionView,
+  field field: String,
+  label label: String,
+  testid testid: String,
+) -> Element(a) {
+  html.div([attribute.class("checkbox-field")], [
+    html.label([attribute.class("checkbox-label")], [
+      html.input([
+        attribute.type_("checkbox"),
+        attribute.name(field),
+        attribute.checked(prefill_value(qv.prefill, field) == "on"),
+        attribute("data-testid", testid),
+      ]),
+      html.text(" " <> label),
+    ]),
+  ])
+}
+
+fn prefill_value(prefill: RawFields, name: String) -> String {
+  dict.get(prefill, name) |> result.unwrap("")
+}
