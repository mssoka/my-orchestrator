+//// Referee-facing copy for the /reference/:token form session (Story RC3.3).
+////
+//// Every user-facing string the referee form renders lives here — the
+//// `application/form_copy.gleam` precedent: views never inline copy. Copy is
+//// UX-deck verbatim (ux-reference-checking §6.5, §8.5, §10.2) modulo two
+//// documented deviations: (1) the RT-wide em-dash ban (\u{2014} never
+//// appears — the copy test asserts absence on every string), (2) slot-neutral
+//// phrasing where the deck is landlord-ref-shaped.
+////
+//// Interpolation vars ride the `CopyVars` record; every value is
+//// server-escaped at render by the view layer (Lustre text nodes escape).
+
+import gleam/int
+import shared/reference_call.{
+  type RefSlot, CharacterRef, EmployerRef, LandlordRef,
+}
+
+/// Interpolation values for the referee-facing copy. As-stated fields are
+/// empty strings when the application never captured the datum (the
+/// as-stated data-availability matrix in the story spec) — the question
+/// registry picks the open-question variant on "".
+pub type CopyVars {
+  CopyVars(
+    referee_name: String,
+    referee_first_name: String,
+    applicant_first_name: String,
+    applicant_full_name: String,
+    employer_name: String,
+    employment_duration: String,
+    job_title: String,
+    annual_salary: String,
+  )
+}
+
+// -- Landing screen (UX §6.5 wireframe; the second Art 14 moment) -------------
+
+pub fn landing_title(vars: CopyVars) -> String {
+  "Reference for " <> vars.applicant_full_name
+}
+
+pub fn landing_opener(slot: RefSlot) -> String {
+  case slot {
+    LandlordRef -> "You're listed as a previous landlord."
+    EmployerRef -> "You're listed as an employer."
+    CharacterRef -> "You're listed as a character referee."
+  }
+}
+
+pub fn landing_context(vars: CopyVars) -> String {
+  vars.applicant_full_name
+  <> " applied to rent a home, and the landlord asked RightTenantry to collect this reference."
+}
+
+pub fn landing_meta(question_count: Int) -> String {
+  "About 5 minutes · "
+  <> int.to_string(question_count)
+  <> " questions · answers saved as you go"
+}
+
+/// The Art 14 restatement. The notice-link text is separate so the view can
+/// wrap it in an anchor to /privacy#referee-data.
+pub fn landing_art14(vars: CopyVars) -> String {
+  "Your answers go to the landlord as part of "
+  <> vars.applicant_first_name
+  <> "'s application. We keep them only as long as the application is kept. Your rights and our contact details: "
+}
+
+pub const landing_notice_link_text = "privacy notice"
+
+pub const landing_start = "Start"
+
+pub fn landing_wrong_person(vars: CopyVars) -> String {
+  "Not "
+  <> vars.referee_first_name
+  <> ", or don't know "
+  <> vars.applicant_first_name
+  <> "?"
+}
+
+pub const landing_wrong_person_link = "Let us know"
+
+pub const landing_decline = "Rather not take part?"
+
+pub const landing_decline_link = "Decline"
+
+// -- Question chrome ------------------------------------------------------------
+
+pub fn progress_text(index: Int, total: Int) -> String {
+  "Question " <> int.to_string(index) <> " of " <> int.to_string(total)
+}
+
+pub const continue_label = "Continue"
+
+pub const back_label = "Back"
+
+pub const optional_marker = "(optional)"
+
+pub const other_text_label = "Tell us in a few words"
+
+pub const from_label = "From"
+
+pub const to_label = "To"
+
+pub const ongoing_label = "The tenancy is ongoing"
+
+pub const dont_remember_label = "Don't remember"
+
+pub const dont_know_label = "Don't know"
+
+pub const about_right_label = "About right"
+
+pub const it_differs_label = "It differs"
+
+pub const it_was_different_label = "It was different"
+
+// -- Review screen (all questions answered; submit is rc3-4's forward link) ----
+
+pub const review_title = "That's everything. Check your answers, then send them to the landlord."
+
+pub const review_submit = "Send my reference"
+
+pub const review_change = "Change"
+
+pub const review_not_answered = "Not answered"
+
+/// Inline validation messages on a question re-render (no-JS POST path).
+pub const answer_required_error = "This one needs an answer to continue."
+
+pub const answer_invalid_error = "That doesn't look right. Check it and try again."
+
+// -- Token-state pages (UX §8.5 + the truthful mapping) -------------------------
+
+pub const not_found_title = "This link doesn't look right."
+
+pub const not_found_body = "If you were expecting a reference form, the link may have been replaced by a newer one. Check the most recent message from us, or contact us."
+
+pub const not_found_contact_link = "Contact us"
+
+pub const expired_title = "This link has expired."
+
+pub const expired_body = "Links last 10 days so old messages can't be reused. If you still want to give this reference, we can send a fresh one."
+
+pub const expired_resend_button = "Send me a new link"
+
+pub const resent_title = "On its way."
+
+pub const resent_body = "We've sent a fresh link to the contact details on file. It expires in 10 days."
+
+/// The resend's honest failure page (every channel failed or skipped): the
+/// remint is rolled back so the referee's retry works from the same page.
+pub const resend_failed_title = "Couldn't send the link."
+
+pub const resend_failed_body = "Something didn't work on our side. Try again in a moment, or contact us if it keeps happening."
+
+pub const resend_failed_retry_button = "Try again"
+
+pub const completed_title = "This reference was already completed."
+
+pub const completed_body = "Thank you."
+
+pub const declined_title = "This reference was declined."
+
+pub const declined_body = "No further messages will come from us."
+
+pub const landlord_handling_title = "The landlord is handling this reference directly."
+
+pub const landlord_handling_body = "You don't need to do anything here."
+
+// -- Question text: previous-landlord set (UX §6.5 table) -----------------------
+
+pub fn q_identity(vars: CopyVars) -> String {
+  "Are you " <> vars.referee_name <> "?"
+}
+
+pub const q_identity_no_link = "No, this isn't me"
+
+pub fn q_relationship(vars: CopyVars) -> String {
+  "What was your relationship to " <> vars.applicant_first_name <> "?"
+}
+
+pub const opt_their_landlord = "Their landlord"
+
+pub const opt_letting_agent = "Letting agent for the property"
+
+pub const opt_other = "Other"
+
+pub fn q_tenancy_confirmed(vars: CopyVars) -> String {
+  "Did " <> vars.applicant_first_name <> " rent a property from you?"
+}
+
+pub const opt_yes = "Yes"
+
+pub const opt_no = "No"
+
+pub const opt_not_sure = "Not sure"
+
+/// DERIVED (as-stated matrix): the UX's as-stated wording presumes tenancy
+/// dates the apply form never captures — this is the §5.3 open form.
+pub fn q_tenancy_period(vars: CopyVars) -> String {
+  "When did " <> vars.applicant_first_name <> "'s tenancy at the property run?"
+}
+
+/// §5.3 open form (no rent datum on the application to confirm against).
+pub const q_rent_amount = "What was the monthly rent?"
+
+pub const q_rent_payment_record = "How was the rent payment record?"
+
+pub const opt_always_on_time = "Always on time"
+
+pub const opt_mostly_on_time = "Mostly on time"
+
+pub const opt_often_late = "Often late"
+
+pub const q_property_condition = "How was the property looked after?"
+
+pub const opt_excellent = "Excellent"
+
+pub const opt_good = "Good"
+
+pub const opt_fair = "Fair"
+
+pub const opt_poor = "Poor"
+
+pub const opt_did_not_see = "Didn't see it after"
+
+pub const q_notice_given_properly = "Was proper notice given before leaving?"
+
+pub const opt_ongoing = "Tenancy is ongoing"
+
+pub const q_deposit_returned = "Was the deposit returned?"
+
+pub const opt_in_full = "In full"
+
+pub const opt_partly = "Partly"
+
+pub const opt_withheld = "Withheld"
+
+pub const opt_still_held = "Still held"
+
+pub fn q_would_rent_again(vars: CopyVars) -> String {
+  "Would you rent to " <> vars.applicant_first_name <> " again?"
+}
+
+pub const opt_unsure = "Unsure"
+
+pub const opt_prefer_not_to_say = "Prefer not to say"
+
+pub const q_free_text = "Anything else the landlord should know?"
+
+// -- Question text: employer set -------------------------------------------------
+
+pub const opt_manager = "Manager"
+
+pub const opt_hr = "HR"
+
+pub const opt_colleague = "Colleague"
+
+pub fn q_works_at(vars: CopyVars) -> String {
+  case vars.employer_name {
+    "" ->
+      "Does or did "
+      <> vars.applicant_first_name
+      <> " work at the company they listed on their application?"
+    name ->
+      "Does or did " <> vars.applicant_first_name <> " work at " <> name <> "?"
+  }
+}
+
+pub fn q_employment_period(vars: CopyVars) -> String {
+  case vars.employment_duration {
+    "" -> "How long has " <> vars.applicant_first_name <> " worked there?"
+    duration ->
+      "The application says "
+      <> vars.applicant_first_name
+      <> " has worked there for "
+      <> duration
+      <> ". Is that right?"
+  }
+}
+
+pub fn q_role(vars: CopyVars) -> String {
+  case vars.job_title {
+    "" -> "What is their role?"
+    title -> "The application says their role is " <> title <> ". Right?"
+  }
+}
+
+pub fn q_salary(vars: CopyVars) -> String {
+  "The application says their salary is €"
+  <> vars.annual_salary
+  <> " a year. Is that right?"
+}
+
+pub const q_would_rehire = "Would you rehire them?"
+
+// -- Question text: character set -------------------------------------------------
+
+pub fn q_relationship_capacity(vars: CopyVars) -> String {
+  "How do you know " <> vars.applicant_first_name <> "?"
+}
+
+pub const relationship_field_label = "Relationship"
+
+pub const relationship_field_hint = "e.g. friend, teammate, neighbour"
+
+pub const capacity_field_label = "In what capacity"
+
+pub const capacity_field_hint = "e.g. five-a-side team, volunteering group"
+
+pub fn q_known_duration(vars: CopyVars) -> String {
+  "How long have you known " <> vars.applicant_first_name <> "?"
+}
+
+pub const opt_lt_1_year = "Less than a year"
+
+pub const opt_1_to_3_years = "1 to 3 years"
+
+pub const opt_3_to_10_years = "3 to 10 years"
+
+pub const opt_gt_10_years = "More than 10 years"
+
+pub fn q_character_statement(vars: CopyVars) -> String {
+  "Is there anything you'd want a landlord to know about "
+  <> vars.applicant_first_name
+  <> "?"
+}
+
+pub fn q_would_stand_again(_vars: CopyVars) -> String {
+  "Would you stand as a referee for them again?"
+}
+
+// -- Misc question-level labels ---------------------------------------------------
+
+pub const amount_placeholder = "€"
+
+/// The autosave indicator in reference_form.js — KEEP IN SYNC (the JS is a
+/// plain static asset and cannot import this constant).
+pub const js_saved_indicator = "Saved"
+
+/// The free-text counter hint (the house resize-y + counter pattern).
+pub fn char_counter_hint(max: Int) -> String {
+  int.to_string(max) <> " characters maximum"
+}
diff --git a/server/src/reference_checks/form_pages.gleam b/server/src/reference_checks/form_pages.gleam
