diff --git a/server/test/reference_checks/form_copy_test.gleam b/server/test/reference_checks/form_copy_test.gleam
new file mode 100644
index 00000000..42710932
--- /dev/null
+++ b/server/test/reference_checks/form_copy_test.gleam
@@ -0,0 +1,186 @@
+//// Copy-contract tests for the referee form (Story RC3.3, T3): the RT-wide
+//// em-dash ban holds on EVERY referee-facing string (both prefill variants
+//// of the as-stated questions), and the strings stay free of the banned
+//// "Error"/"Failed" vocabulary (brand voice: "Couldn't", never blame).
+
+import gleam/list
+import gleam/string
+import gleeunit/should
+import reference_checks/form_copy
+import shared/reference_call.{CharacterRef, EmployerRef, LandlordRef}
+
+fn vars() -> form_copy.CopyVars {
+  form_copy.CopyVars(
+    referee_name: "Colm Byrne",
+    referee_first_name: "Colm",
+    applicant_first_name: "Aisling",
+    applicant_full_name: "Aisling O'Brien",
+    employer_name: "Acme Ltd",
+    employment_duration: "3 years",
+    job_title: "Senior Chef",
+    annual_salary: "42,000",
+  )
+}
+
+fn open_vars() -> form_copy.CopyVars {
+  form_copy.CopyVars(
+    ..vars(),
+    employer_name: "",
+    employment_duration: "",
+    job_title: "",
+  )
+}
+
+/// Every referee-facing string, both prefill variants where the copy
+/// branches on application data.
+fn all_strings() -> List(String) {
+  let v = vars()
+  let o = open_vars()
+  [
+    form_copy.landing_title(v),
+    form_copy.landing_opener(LandlordRef),
+    form_copy.landing_opener(EmployerRef),
+    form_copy.landing_opener(CharacterRef),
+    form_copy.landing_context(v),
+    form_copy.landing_meta(11),
+    form_copy.landing_art14(v),
+    form_copy.landing_notice_link_text,
+    form_copy.landing_start,
+    form_copy.landing_wrong_person(v),
+    form_copy.landing_wrong_person_link,
+    form_copy.landing_decline,
+    form_copy.landing_decline_link,
+    form_copy.progress_text(4, 11),
+    form_copy.continue_label,
+    form_copy.back_label,
+    form_copy.optional_marker,
+    form_copy.other_text_label,
+    form_copy.from_label,
+    form_copy.to_label,
+    form_copy.ongoing_label,
+    form_copy.dont_remember_label,
+    form_copy.dont_know_label,
+    form_copy.about_right_label,
+    form_copy.it_differs_label,
+    form_copy.it_was_different_label,
+    form_copy.review_title,
+    form_copy.review_submit,
+    form_copy.review_change,
+    form_copy.review_not_answered,
+    form_copy.answer_required_error,
+    form_copy.answer_invalid_error,
+    form_copy.not_found_title,
+    form_copy.not_found_body,
+    form_copy.not_found_contact_link,
+    form_copy.expired_title,
+    form_copy.expired_body,
+    form_copy.expired_resend_button,
+    form_copy.resent_title,
+    form_copy.resent_body,
+    form_copy.resend_failed_title,
+    form_copy.resend_failed_body,
+    form_copy.resend_failed_retry_button,
+    form_copy.completed_title,
+    form_copy.completed_body,
+    form_copy.declined_title,
+    form_copy.declined_body,
+    form_copy.landlord_handling_title,
+    form_copy.landlord_handling_body,
+    form_copy.q_identity(v),
+    form_copy.q_identity_no_link,
+    form_copy.q_relationship(v),
+    form_copy.opt_their_landlord,
+    form_copy.opt_letting_agent,
+    form_copy.opt_other,
+    form_copy.q_tenancy_confirmed(v),
+    form_copy.opt_yes,
+    form_copy.opt_no,
+    form_copy.opt_not_sure,
+    form_copy.q_tenancy_period(v),
+    form_copy.q_rent_amount,
+    form_copy.q_rent_payment_record,
+    form_copy.opt_always_on_time,
+    form_copy.opt_mostly_on_time,
+    form_copy.opt_often_late,
+    form_copy.q_property_condition,
+    form_copy.opt_excellent,
+    form_copy.opt_good,
+    form_copy.opt_fair,
+    form_copy.opt_poor,
+    form_copy.opt_did_not_see,
+    form_copy.q_notice_given_properly,
+    form_copy.opt_ongoing,
+    form_copy.q_deposit_returned,
+    form_copy.opt_in_full,
+    form_copy.opt_partly,
+    form_copy.opt_withheld,
+    form_copy.opt_still_held,
+    form_copy.q_would_rent_again(v),
+    form_copy.opt_unsure,
+    form_copy.opt_prefer_not_to_say,
+    form_copy.q_free_text,
+    form_copy.opt_manager,
+    form_copy.opt_hr,
+    form_copy.opt_colleague,
+    form_copy.q_works_at(v),
+    form_copy.q_works_at(o),
+    form_copy.q_employment_period(v),
+    form_copy.q_employment_period(o),
+    form_copy.q_role(v),
+    form_copy.q_role(o),
+    form_copy.q_salary(v),
+    form_copy.q_would_rehire,
+    form_copy.q_relationship_capacity(v),
+    form_copy.relationship_field_label,
+    form_copy.relationship_field_hint,
+    form_copy.capacity_field_label,
+    form_copy.capacity_field_hint,
+    form_copy.q_known_duration(v),
+    form_copy.opt_lt_1_year,
+    form_copy.opt_1_to_3_years,
+    form_copy.opt_3_to_10_years,
+    form_copy.opt_gt_10_years,
+    form_copy.q_character_statement(v),
+    form_copy.q_would_stand_again(v),
+    form_copy.amount_placeholder,
+    form_copy.js_saved_indicator,
+    form_copy.char_counter_hint(1000),
+  ]
+}
+
+pub fn no_em_dash_in_any_string_test() {
+  all_strings()
+  |> list.each(fn(s) {
+    string.contains(s, "\u{2014}")
+    |> should.be_false
+  })
+}
+
+pub fn no_banned_error_vocabulary_test() {
+  all_strings()
+  |> list.each(fn(s) {
+    string.contains(s, "Error") |> should.be_false
+    string.contains(s, "Failed") |> should.be_false
+  })
+}
+
+pub fn no_banned_error_vocabulary_any_case_test() {
+  // Case-insensitive sweep (Perkins r1 note): the capitalized check alone
+  // would miss a lowercase "failed" slipping into copy. Substring, so
+  // common words in the list must stay free of them regardless.
+  all_strings()
+  |> list.each(fn(s) {
+    let lower = string.lowercase(s)
+    string.contains(lower, "error") |> should.be_false
+    string.contains(lower, "failed") |> should.be_false
+  })
+}
+
+pub fn art14_block_carries_the_required_elements_test() {
+  // The second Art 14 moment (landing): purpose, retention, rights pointer.
+  let body = form_copy.landing_art14(vars())
+  string.contains(body, "go to the landlord") |> should.be_true
+  string.contains(body, "only as long as the application is kept")
+  |> should.be_true
+  string.contains(body, "rights") |> should.be_true
+}
diff --git a/server/test/reference_checks/form_handler_test.gleam b/server/test/reference_checks/form_handler_test.gleam
new file mode 100644
index 00000000..313fb1c7
--- /dev/null
+++ b/server/test/reference_checks/form_handler_test.gleam
@@ -0,0 +1,370 @@
+//// Unit tests for the referee form handler's pure seams (Story RC3.3):
+//// the token-state classifier matrix (spec table pinned row by row) and
+//// the per-question timing check (the 500ms-floor /apply adaptation).
+
+import application/form_view
+import gleam/int
+import gleam/json
+import gleam/list
+import gleam/option.{None, Some}
+import gleam/string
+import gleeunit/should
+import reference_checks/form_handler
+import reference_checks/messages
+import reference_checks/questions
+import shared/reference_call.{
+  type RefSlot, AwaitingCorrection, ContactInitiated, Failed, FormCompleted,
+  LandlordRef, ManualRecorded, Objected, Partial, Queued, Refused, Skipped,
+  Unreachable,
+}
+
+// -- classify: the spec's matrix, row by row -------------------------------------------
+
+pub fn unknown_token_is_unknown_test() {
+  form_handler.classify(
+    found: False,
+    status: ContactInitiated,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.Unknown)
+}
+
+pub fn live_row_is_live_test() {
+  form_handler.classify(
+    found: True,
+    status: ContactInitiated,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.Live)
+}
+
+pub fn taken_over_but_unexpired_stays_live_test() {
+  // A7: the form link survives warm-handoff takeover.
+  form_handler.classify(
+    found: True,
+    status: ContactInitiated,
+    taken_over: True,
+    expired: False,
+  )
+  |> should.equal(form_handler.Live)
+}
+
+pub fn expired_open_offers_resend_test() {
+  form_handler.classify(
+    found: True,
+    status: ContactInitiated,
+    taken_over: False,
+    expired: True,
+  )
+  |> should.equal(form_handler.ExpiredOpen)
+}
+
+pub fn taken_over_and_expired_is_landlord_handling_test() {
+  // Post-takeover, messages are the landlord's domain — no resend offer.
+  form_handler.classify(
+    found: True,
+    status: ContactInitiated,
+    taken_over: True,
+    expired: True,
+  )
+  |> should.equal(form_handler.LandlordHandling)
+}
+
+pub fn form_completed_is_completed_test() {
+  form_handler.classify(
+    found: True,
+    status: FormCompleted,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.Completed)
+}
+
+pub fn partial_is_completed_test() {
+  // A2: an abandoned-with-answers terminal still closed with answers saved.
+  form_handler.classify(
+    found: True,
+    status: Partial,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.Completed)
+}
+
+pub fn refused_is_declined_test() {
+  form_handler.classify(
+    found: True,
+    status: Refused,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.Declined)
+}
+
+pub fn objected_is_declined_test() {
+  form_handler.classify(
+    found: True,
+    status: Objected,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.Declined)
+}
+
+pub fn manual_recorded_is_landlord_handling_test() {
+  form_handler.classify(
+    found: True,
+    status: ManualRecorded,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.LandlordHandling)
+}
+
+pub fn unreachable_is_landlord_handling_test() {
+  form_handler.classify(
+    found: True,
+    status: Unreachable,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.LandlordHandling)
+}
+
+pub fn failed_is_landlord_handling_test() {
+  form_handler.classify(
+    found: True,
+    status: Failed,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.LandlordHandling)
+}
+
+pub fn awaiting_correction_is_landlord_handling_test() {
+  // The contact details are being corrected — never re-serve the form to
+  // what may be the wrong person (spec decision, R6 ratified).
+  form_handler.classify(
+    found: True,
+    status: AwaitingCorrection,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.LandlordHandling)
+}
+
+pub fn queued_is_unknown_test() {
+  // The token is minted at T0 — a queued row can never carry one.
+  form_handler.classify(
+    found: True,
+    status: Queued,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.Unknown)
+}
+
+pub fn skipped_is_unknown_test() {
+  form_handler.classify(
+    found: True,
+    status: Skipped,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.Unknown)
+}
+
+pub fn terminal_beats_expiry_test() {
+  // A completed reference with an old expiry still says completed (the
+  // terminal truth wins over the clock).
+  form_handler.classify(
+    found: True,
+    status: FormCompleted,
+    taken_over: False,
+    expired: True,
+  )
+  |> should.equal(form_handler.Completed)
+}
+
+pub fn voice_completed_is_completed_test() {
+  // v2-reserved in v1 (unreachable today) — but a completed reference must
+  // never render the unknown-link page.
+  form_handler.classify(
+    found: True,
+    status: reference_call.Completed,
+    taken_over: False,
+    expired: False,
+  )
+  |> should.equal(form_handler.Completed)
+}
+
+// -- resend outcome branching (edge-case pass) -----------------------------------------
+
+pub fn any_delivered_true_when_a_channel_delivered_test() {
+  form_handler.any_delivered([
+    messages.ChannelOutcome(messages.Email, messages.Delivered, "email-id"),
+    messages.ChannelOutcome(
+      messages.Sms,
+      messages.Skipped,
+      "twilio not configured",
+    ),
+  ])
+  |> should.be_true
+}
+
+pub fn any_delivered_false_when_all_skipped_or_failed_test() {
+  form_handler.any_delivered([
+    messages.ChannelOutcome(
+      messages.Email,
+      messages.Skipped,
+      "no RESEND_API_KEY",
+    ),
+    messages.ChannelOutcome(messages.Sms, messages.Failed, "provider error"),
+  ])
+  |> should.be_false
+}
+
+pub fn resend_audit_details_never_carries_token_or_addresses_test() {
+  let details =
+    form_handler.resend_audit_details([
+      messages.ChannelOutcome(messages.Email, messages.Delivered, "email-id"),
+      messages.ChannelOutcome(
+        messages.Sms,
+        messages.Skipped,
+        "twilio not configured",
+      ),
+    ])
+  let text = json.to_string(details)
+  string.contains(text, "delivered") |> should.be_true
+  string.contains(text, "email") |> should.be_true
+  string.contains(text, "@") |> should.be_false
+  string.contains(text, "+353") |> should.be_false
+}
+
+// -- is_answer_timing_suspicious -----------------------------------------------------------
+
+fn timing_values(delta_ms: Int) -> List(#(String, String)) {
+  let loaded = form_view.current_unix_ms() - delta_ms
+  [#("_form_loaded_at", int.to_string(loaded))]
+}
+
+pub fn timing_missing_field_is_suspicious_test() {
+  form_handler.is_answer_timing_suspicious([]) |> should.be_true
+}
+
+pub fn timing_empty_is_suspicious_test() {
+  form_handler.is_answer_timing_suspicious([#("_form_loaded_at", "")])
+  |> should.be_true
+}
+
+pub fn timing_garbage_is_suspicious_test() {
+  form_handler.is_answer_timing_suspicious([
+    #("_form_loaded_at", "not-a-number"),
+  ])
+  |> should.be_true
+}
+
+pub fn timing_future_is_suspicious_test() {
+  form_handler.is_answer_timing_suspicious(timing_values(-10_000))
+  |> should.be_true
+}
+
+pub fn timing_instant_is_suspicious_test() {
+  // Scripted replay tripwire: 300ms from page load is below the floor.
+  form_handler.is_answer_timing_suspicious(timing_values(300))
+  |> should.be_true
+}
+
+pub fn timing_normal_answer_passes_test() {
+  form_handler.is_answer_timing_suspicious(timing_values(30_000))
+  |> should.be_false
+}
+
+pub fn timing_fast_but_human_passes_test() {
+  // The /apply 2s floor would eat this; the per-question floor is 500ms.
+  form_handler.is_answer_timing_suspicious(timing_values(1500))
+  |> should.be_false
+}
+
+pub fn timing_past_7_days_still_passes_within_the_link_ttl_test() {
+  // Perkins r1 W6: the stale cap must exceed the 10-day link TTL, or a
+  // legitimate slow referee's answers are silently dropped with fake
+  // success. 8 days since page load is still a valid answer.
+  form_handler.is_answer_timing_suspicious(timing_values(691_200_000))
+  |> should.be_false
+}
+
+pub fn timing_stale_over_11_days_is_suspicious_test() {
+  form_handler.is_answer_timing_suspicious(timing_values(950_400_001))
+  |> should.be_true
+}
+
+pub fn resend_timing_keeps_the_2s_floor_test() {
+  form_handler.is_resend_timing_suspicious(timing_values(1500))
+  |> should.be_true
+  form_handler.is_resend_timing_suspicious(timing_values(10_000))
+  |> should.be_false
+}
+
+pub fn resend_timing_shares_the_ttl_aware_cap_test() {
+  form_handler.is_resend_timing_suspicious(timing_values(691_200_000))
+  |> should.be_false
+  form_handler.is_resend_timing_suspicious(timing_values(950_400_001))
+  |> should.be_true
+}
+
+// -- format_annual_salary -----------------------------------------------------------
+
+pub fn annual_salary_formats_thousands_test() {
+  form_handler.format_annual_salary(350_000) |> should.equal("42,000")
+  form_handler.format_annual_salary(83_333) |> should.equal("9,999")
+  form_handler.format_annual_salary(8_333_300) |> should.equal("999,996")
+  form_handler.format_annual_salary(100_000_000) |> should.equal("12,000,000")
+  form_handler.format_annual_salary(50_000) |> should.equal("6,000")
+  form_handler.format_annual_salary(12_500) |> should.equal("1,500")
+  form_handler.format_annual_salary(10_000) |> should.equal("1,200")
+  form_handler.format_annual_salary(8333) |> should.equal("999")
+}
+
+// -- clamp_current (the ?q= navigation rule, Perkins r1 note) ---------------------------
+
+pub fn clamp_allows_first_unanswered_test() {
+  let assert Some(next) = questions.next_unanswered(LandlordRef, draft_keys: [])
+  form_handler.clamp_current(LandlordRef, Some("identity"), [], Some(next))
+  |> should.equal("identity")
+}
+
+pub fn clamp_allows_an_answered_question_for_change_navigation_test() {
+  let assert Some(next) =
+    questions.next_unanswered(LandlordRef, draft_keys: ["identity_confirmed"])
+  form_handler.clamp_current(
+    LandlordRef,
+    Some("identity"),
+    ["identity_confirmed"],
+    Some(next),
+  )
+  |> should.equal("identity")
+}
+
+pub fn clamp_snaps_forward_jumps_back_to_first_unanswered_test() {
+  // A referee deep-linking to q5 with nothing answered snaps to identity.
+  let assert Some(next) = questions.next_unanswered(LandlordRef, draft_keys: [])
+  form_handler.clamp_current(LandlordRef, Some("rent_amount"), [], Some(next))
+  |> should.equal("identity")
+}
+
+pub fn clamp_unknown_question_id_snaps_to_next_test() {
+  let assert Some(next) = questions.next_unanswered(LandlordRef, draft_keys: [])
+  form_handler.clamp_current(LandlordRef, Some("bogus"), [], Some(next))
+  |> should.equal("identity")
+}
+
+pub fn clamp_all_answered_targets_the_last_question_test() {
+  let all_keys =
+    questions.questions_for(LandlordRef)
+    |> list.flat_map(fn(q) { q.draft_keys })
+  form_handler.clamp_current(LandlordRef, Some("free_text"), all_keys, None)
+  |> should.equal("free_text")
+}
diff --git a/server/test/reference_checks/form_pages_test.gleam b/server/test/reference_checks/form_pages_test.gleam
new file mode 100644
index 00000000..ac899466
--- /dev/null
+++ b/server/test/reference_checks/form_pages_test.gleam
@@ -0,0 +1,466 @@
+//// SSR render pins for the referee form pages (Story RC3.3, T8.3). These
+//// assert the SERIALIZED render (Lustre's output: attributes sorted by
+//// name, empty-valued ones bare, apostrophes as &#39;) — never view-source
+//// assumptions. Pins target data-testids and hrefs; verbatim copy lives in
+//// the copy test (apostrophes land as &#39; in serialized HTML).
+
+import gleam/dict
+import gleam/list
+import gleam/option.{None, Some}
+import gleam/string
+import gleeunit/should
+import lustre/element
+import reference_checks/form_copy
+import reference_checks/form_pages
+import reference_checks/form_question_pages.{type QuestionView, QuestionView}
+import reference_checks/questions
+import shared/reference_call.{CharacterRef, EmployerRef, LandlordRef}
+
+fn vars() -> form_copy.CopyVars {
+  form_copy.CopyVars(
+    referee_name: "Colm Byrne",
+    referee_first_name: "Colm",
+    applicant_first_name: "Aisling",
+    applicant_full_name: "Aisling O'Brien",
+    employer_name: "Acme Ltd",
+    employment_duration: "3 years",
+    job_title: "Senior Chef",
+    annual_salary: "42,000",
+  )
+}
+
+const token = "test-token-48-chars"
+
+// -- Landing --------------------------------------------------------------------------
+
+pub fn landing_renders_art14_and_both_escape_routes_test() {
+  let page =
+    form_pages.view_landing(
+      vars: vars(),
+      slot: LandlordRef,
+      token: token,
+      first_question_id: "identity",
+      question_count: 11,
+    )
+  string.contains(page, "data-testid=\"reference-landing\"") |> should.be_true
+  // The Art 14 block + notice link.
+  string.contains(page, "/privacy#referee-data") |> should.be_true
+  string.contains(page, "go to the landlord as part of Aisling&#39;s")
+  |> should.be_true
+  // Both escape routes, before any question.
+  string.contains(page, "href=\"/reference/" <> token <> "/wrong-person\"")
+  |> should.be_true
+  string.contains(page, "href=\"/reference/" <> token <> "/decline\"")
+  |> should.be_true
+  string.contains(page, "data-testid=\"reference-start\"") |> should.be_true
+}
+
+pub fn landing_has_no_analytics_or_posthog_test() {
+  // AC7: no analytics on a token-carrying page, ever.
+  let page =
+    form_pages.view_landing(
+      vars: vars(),
+      slot: LandlordRef,
+      token: token,
+      first_question_id: "identity",
+      question_count: 11,
+    )
+  string.lowercase(page) |> string.contains("posthog") |> should.be_false
+  string.contains(page, "apply_analytics") |> should.be_false
+  string.contains(page, "consent.js") |> should.be_false
+  // The static reference script IS linked (self-origin, no inline JS).
+  string.contains(page, "/static/reference_form.js") |> should.be_true
+  string.contains(page, "noindex, nofollow") |> should.be_true
+}
+
