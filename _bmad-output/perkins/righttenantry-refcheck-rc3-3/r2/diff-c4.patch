+//// Unit tests for the per-slot question registry (Story RC3.3, T2):
+//// set counts (11/8/5), unique ids, closed option vocabs, resume logic
+//// (next_unanswered across partial drafts), and per-control validation —
+//// the draft_answers contract rc3-4 consumes.
+
+import gleam/dict
+import gleam/json
+import gleam/list
+import gleam/option.{None, Some}
+import gleam/string
+import gleeunit/should
+import reference_checks/form_copy
+import reference_checks/questions
+import shared/reference_call.{CharacterRef, EmployerRef, LandlordRef}
+
+fn vars() -> form_copy.CopyVars {
+  form_copy.CopyVars(
+    referee_name: "Colm Byrne",
+    referee_first_name: "Colm",
+    applicant_first_name: "Aisling",
+    applicant_full_name: "Aisling O'Brien",
+    employer_name: "Acme Ltd",
+    employment_duration: "3 years",
+    job_title: "Senior Chef",
+    annual_salary: "42,000",
+  )
+}
+
+fn open_vars() -> form_copy.CopyVars {
+  form_copy.CopyVars(..vars(), employment_duration: "", job_title: "")
+}
+
+fn fields(pairs: List(#(String, String))) -> questions.RawFields {
+  dict.from_list(pairs)
+}
+
+fn find(slot, id) -> questions.Question {
+  let assert Some(q) = questions.question_by_id(slot, id)
+  q
+}
+
+// -- Registry integrity ----------------------------------------------------------
+
+pub fn landlord_set_has_11_questions_test() {
+  questions.questions_for(LandlordRef) |> list.length |> should.equal(11)
+}
+
+pub fn employer_set_has_8_questions_test() {
+  questions.questions_for(EmployerRef) |> list.length |> should.equal(8)
+}
+
+pub fn character_set_has_5_questions_test() {
+  questions.questions_for(CharacterRef) |> list.length |> should.equal(5)
+}
+
+pub fn question_ids_are_unique_per_slot_test() {
+  [LandlordRef, EmployerRef, CharacterRef]
+  |> list.each(fn(slot) {
+    let ids = questions.questions_for(slot) |> list.map(fn(q) { q.id })
+    ids |> list.unique |> list.length |> should.equal(list.length(ids))
+  })
+}
+
+pub fn free_text_is_optional_except_character_statement_test() {
+  find(LandlordRef, "free_text").required |> should.be_false
+  find(EmployerRef, "free_text").required |> should.be_false
+  find(CharacterRef, "character_statement").required |> should.be_true
+}
+
+// -- Resume -----------------------------------------------------------------------
+
+pub fn next_unanswered_is_first_with_empty_draft_test() {
+  let assert Some(q) = questions.next_unanswered(LandlordRef, draft_keys: [])
+  q.id |> should.equal("identity")
+}
+
+pub fn next_unanswered_skips_answered_test() {
+  let assert Some(q) =
+    questions.next_unanswered(LandlordRef, draft_keys: [
+      "identity_confirmed",
+      "relationship_to_applicant",
+    ])
+  q.id |> should.equal("tenancy_confirmed")
+}
+
+pub fn next_unanswered_none_when_all_answered_test() {
+  let all_keys =
+    questions.questions_for(LandlordRef)
+    |> list.flat_map(fn(q) { q.draft_keys })
+  questions.next_unanswered(LandlordRef, draft_keys: all_keys)
+  |> should.equal(None)
+}
+
+pub fn character_capacity_question_needs_both_keys_test() {
+  // Only one of the two keys present -> still unanswered.
+  let assert Some(q) =
+    questions.next_unanswered(CharacterRef, draft_keys: [
+      "identity_confirmed", "relationship",
+    ])
+  q.id |> should.equal("relationship_capacity")
+}
+
+pub fn previous_question_links_backward_test() {
+  let assert Some(prev) =
+    questions.previous_question(LandlordRef, "tenancy_confirmed")
+  prev.id |> should.equal("relationship")
+  questions.previous_question(LandlordRef, "identity") |> should.equal(None)
+}
+
+// -- Validation: choices -------------------------------------------------------------
+
+pub fn identity_yes_validates_test() {
+  let q = find(LandlordRef, "identity")
+  let assert Ok(entries) =
+    questions.validate_answer(
+      q:,
+      vars: vars(),
+      fields: fields([#("a_identity", "yes")]),
+    )
+  entries
+  |> should.equal([#("identity_confirmed", json.string("yes"))])
+}
+
+pub fn identity_no_is_invalid_test() {
+  // "No" is a link out to the wrong-person route — never a stored answer.
+  let q = find(LandlordRef, "identity")
+  questions.validate_answer(
+    q:,
+    vars: vars(),
+    fields: fields([#("a_identity", "no")]),
+  )
+  |> should.be_error
+}
+
+pub fn choice_rejects_out_of_vocab_value_test() {
+  let q = find(LandlordRef, "tenancy_confirmed")
+  questions.validate_answer(
+    q:,
+    vars: vars(),
+    fields: fields([#("a_tenancy_confirmed", "maybe")]),
+  )
+  |> should.be_error
+}
+
+pub fn choice_with_other_requires_other_text_test() {
+  let q = find(LandlordRef, "relationship")
+  questions.validate_answer(
+    q:,
+    vars: vars(),
+    fields: fields([#("a_relationship", "other")]),
+  )
+  |> should.be_error
+}
+
+pub fn choice_with_other_stores_both_keys_test() {
+  let q = find(LandlordRef, "relationship")
+  let assert Ok(entries) =
+    questions.validate_answer(
+      q:,
+      vars: vars(),
+      fields: fields([
+        #("a_relationship", "other"),
+        #("a_relationship_other", "Her uncle"),
+      ]),
+    )
+  entries
+  |> should.equal([
+    #("relationship_to_applicant", json.string("other")),
+    #("relationship_other", json.string("Her uncle")),
+  ])
+}
+
+pub fn switching_off_other_nulls_the_stale_other_text_test() {
+  // Edge-case pass: "other" saved earlier, then a named option re-saved —
+  // the conditional key must be nulled (the jsonb merge never deletes).
+  let q = find(LandlordRef, "relationship")
+  let assert Ok(entries) =
+    questions.validate_answer(
+      q:,
+      vars: vars(),
+      fields: fields([#("a_relationship", "landlord")]),
+    )
+  entries
+  |> should.equal([
+    #("relationship_to_applicant", json.string("landlord")),
+    #("relationship_other", json.null()),
+  ])
+}
+
+// -- Validation: compound controls ------------------------------------------------------
+
+pub fn tenancy_period_from_to_validates_test() {
+  let q = find(LandlordRef, "tenancy_period")
+  let assert Ok([#("tenancy_period", value)]) =
+    questions.validate_answer(
+      q:,
+      vars: vars(),
+      fields: fields([
+        #("a_tenancy_from", "2023-06"),
+        #("a_tenancy_to", "2025-05"),
+      ]),
+    )
+  json.to_string(value)
+  |> should.equal("{\"from\":\"2023-06\",\"to\":\"2025-05\"}")
