+    None -> None
+    Some(0) -> None
+    Some(i) ->
+      questions_for(slot)
+      |> list.drop(i - 1)
+      |> list.first
+      |> option.from_result
+  }
+}
+
+// -- Validation: raw fields -> draft entries ------------------------------------------
+
+/// Validate one question's raw fields into `draft_answers` entries.
+/// `Error(Required | Invalid)` = missing/over-length/malformed input. Pure;
+/// unit-tested per control kind.
+pub fn validate_answer(
+  q q: Question,
+  vars vars: form_copy.CopyVars,
+  fields fields: RawFields,
+) -> Result(List(#(String, Json)), ValidationError) {
+  case q.control {
+    Identity ->
+      case field(fields, "a_identity") {
+        "yes" -> Ok([#("identity_confirmed", json.string("yes"))])
+        "" -> Error(Required)
+        _ -> Error(Invalid)
+      }
+    Choice(options) -> {
+      use value <- result.try(choice_value(fields, q.id, options))
+      Ok([#(draft_key(q), json.string(value))])
+    }
+    ChoiceWithOther(options) -> {
+      use value <- result.try(choice_value(fields, q.id, options))
+      let key = draft_key(q)
+      case value {
+        "other" -> {
+          use other <- result.try(bounded_text(
+            fields,
+            "a_" <> q.id <> "_other",
+            1,
+            200,
+          ))
+          Ok([
+            #(key, json.string("other")),
+            #("relationship_other", json.string(other)),
+          ])
+        }
+        _ ->
+          // Null the conditional key so a prior "other" answer can't leave a
+          // stale relationship_other behind (the top-level jsonb merge never
+          // deletes keys).
+          Ok([
+            #(key, json.string(value)),
+            #("relationship_other", json.null()),
+          ])
+      }
+    }
+    MonthYearOrOngoing -> validate_month_year(fields)
+    AmountOrDontRemember -> validate_amount(fields, q.id)
+    AsStatedText(prefill) ->
+      validate_as_stated_text(fields, q.id, prefill, vars)
+    AsStatedAmount -> validate_as_stated_amount(fields, q.id)
+    ShortTextPair -> {
+      use rel <- result.try(bounded_text(fields, "a_relationship", 1, 200))
+      use cap <- result.try(bounded_text(fields, "a_capacity", 1, 200))
+      Ok([
+        #("relationship", json.string(rel)),
+        #("capacity", json.string(cap)),
+      ])
+    }
+    FreeText(max_chars) -> {
+      let raw = field(fields, "a_" <> q.id) |> string.trim
+      case q.required, raw {
+        True, "" -> Error(Required)
+        _, _ ->
+          case string.length(raw) <= max_chars {
+            True -> Ok([#(draft_key(q), json.string(raw))])
+            False -> Error(Invalid)
+          }
+      }
+    }
+  }
+}
+
+fn validate_month_year(
+  fields: RawFields,
+) -> Result(List(#(String, Json)), ValidationError) {
+  use from <- result.try(month_year(fields, "a_tenancy_from"))
+  let ongoing = field(fields, "a_tenancy_ongoing") == "on"
+  case ongoing {
+    True ->
+      Ok([
+        #(
+          "tenancy_period",
+          json.object([
+            #("from", json.string(from)),
+            #("ongoing", json.bool(True)),
+          ]),
+        ),
+      ])
+    False -> {
+      use to <- result.try(month_year(fields, "a_tenancy_to"))
+      // YYYY-MM strings sort chronologically (zero-padded month).
+      case string.compare(from, to) != order.Gt {
+        True ->
+          Ok([
+            #(
+              "tenancy_period",
+              json.object([
+                #("from", json.string(from)),
+                #("to", json.string(to)),
+              ]),
+            ),
+          ])
+        False -> Error(Invalid)
+      }
+    }
+  }
+}
+
+fn validate_amount(
+  fields: RawFields,
+  id: String,
+) -> Result(List(#(String, Json)), ValidationError) {
+  case field(fields, "a_" <> id <> "_dont_remember") {
+    "on" ->
+      Ok([#("rent_amount", json.object([#("dont_remember", json.bool(True))]))])
+    _ -> {
+      use amount <- result.try(euro_amount(fields, "a_" <> id))
+      Ok([#("rent_amount", json.object([#("amount_eur", json.string(amount))]))])
+    }
+  }
+}
+
+fn validate_as_stated_text(
+  fields: RawFields,
+  id: String,
+  prefill: Prefill,
+  vars: form_copy.CopyVars,
+) -> Result(List(#(String, Json)), ValidationError) {
+  case prefill_value(prefill, vars) {
+    // Open variant: no application datum to confirm against.
+    "" -> {
+      use stated <- result.try(bounded_text(
+        fields,
+        "a_" <> id <> "_text",
+        1,
+        200,
+      ))
+      Ok([#(id, json.object([#("stated", json.string(stated))]))])
+    }
+    _ ->
+      case field(fields, "a_" <> id <> "_choice") {
+        "as_stated" ->
+          Ok([#(id, json.object([#("as_stated", json.bool(True))]))])
+        "differs" -> {
+          use text <- result.try(bounded_text(
+            fields,
+            "a_" <> id <> "_text",
+            1,
+            200,
+          ))
+          Ok([#(id, json.object([#("differs", json.string(text))]))])
+        }
+        "" -> Error(Required)
+        _ -> Error(Invalid)
+      }
+  }
+}
+
+fn validate_as_stated_amount(
+  fields: RawFields,
+  id: String,
+) -> Result(List(#(String, Json)), ValidationError) {
+  case field(fields, "a_" <> id <> "_choice") {
+    "as_stated" -> Ok([#(id, json.object([#("as_stated", json.bool(True))]))])
+    "different" -> {
+      use amount <- result.try(euro_amount(fields, "a_" <> id <> "_amount"))
+      Ok([#(id, json.object([#("different_amount_eur", json.string(amount))]))])
+    }
+    "dont_know" -> Ok([#(id, json.object([#("dont_know", json.bool(True))]))])
+    "" -> Error(Required)
+    _ -> Error(Invalid)
+  }
+}
+
+/// The pre-fill datum for an as-stated check; "" means the application
+/// never captured it and the question renders its open variant.
+pub fn prefill_value(prefill: Prefill, vars: form_copy.CopyVars) -> String {
+  case prefill {
+    PrefillEmploymentDuration -> vars.employment_duration
+    PrefillJobTitle -> vars.job_title
+  }
+}
+
+// -- Draft read-back: prefill + review summaries ----------------------------------------
+// The draft is a flat JSON object; values decode per control shape. These
+// two functions are the inverse of validate_answer: prefill_for rebuilds the
+// raw form fields (revisiting a question shows the saved answer), and
+// answer_summary renders the one-line review-screen summary.
+
+/// The decoded `draft_answers` object: flat key -> raw JSON value.
+pub type Draft =
+  dict.Dict(String, Dynamic)
+
+/// Decode the draft_answers text ("" = no draft) into raw dynamics. A
+/// corrupt draft degrades to empty (the form re-asks) rather than 500ing.
+pub fn decode_draft(text: String) -> Draft {
+  case text {
+    "" -> dict.new()
+    _ ->
+      case json.parse(text, decode.dict(decode.string, decode.dynamic)) {
+        Ok(d) -> d
+        Error(_) -> dict.new()
+      }
+  }
+}
+
+fn draft_string(
+  draft: dict.Dict(String, Dynamic),
+  key: String,
+) -> Option(String) {
+  case dict.get(draft, key) {
+    Error(_) -> None
+    Ok(value) ->
+      case decode.run(value, decode.string) {
+        Ok(s) -> Some(s)
+        Error(_) -> None
+      }
+  }
+}
+
+fn draft_field(
+  draft: dict.Dict(String, Dynamic),
+  key: String,
+  field: String,
+) -> Option(String) {
+  case dict.get(draft, key) {
+    Error(_) -> None
+    Ok(value) ->
+      case decode.run(value, decode.at([field], decode.string)) {
+        Ok(s) -> Some(s)
+        Error(_) -> None
+      }
+  }
+}
+
+fn draft_flag(
+  draft: dict.Dict(String, Dynamic),
+  key: String,
+  field: String,
+) -> Bool {
+  case dict.get(draft, key) {
+    Error(_) -> False
+    Ok(value) ->
+      case decode.run(value, decode.at([field], decode.bool)) {
+        Ok(b) -> b
+        Error(_) -> False
+      }
+  }
+}
+
+/// Rebuild a question's raw form fields from the draft (revisit pre-fill).
+pub fn prefill_for(
+  q q: Question,
+  draft draft: dict.Dict(String, Dynamic),
+) -> RawFields {
+  let pairs = case q.control {
+    Identity ->
+      case draft_string(draft, "identity_confirmed") {
+        Some("yes") -> [#("a_identity", "yes")]
+        _ -> []
+      }
+    Choice(_) ->
+      case draft_string(draft, draft_key(q)) {
+        Some(v) -> [#("a_" <> q.id, v)]
+        None -> []
+      }
+    ChoiceWithOther(_) -> {
+      let base = case draft_string(draft, draft_key(q)) {
+        Some(v) -> [#("a_" <> q.id, v)]
+        None -> []
+      }
+      case draft_string(draft, "relationship_other") {
+        Some(t) -> [#("a_" <> q.id <> "_other", t), ..base]
+        None -> base
+      }
+    }
+    MonthYearOrOngoing -> {
+      let from = case draft_field(draft, "tenancy_period", "from") {
+        Some(f) -> [#("a_tenancy_from", f)]
+        None -> []
+      }
+      let to = case draft_field(draft, "tenancy_period", "to") {
+        Some(t) -> [#("a_tenancy_to", t)]
+        None -> []
+      }
+      let ongoing = case draft_flag(draft, "tenancy_period", "ongoing") {
+        True -> [#("a_tenancy_ongoing", "on")]
+        False -> []
+      }
+      list.append(from, list.append(to, ongoing))
+    }
+    AmountOrDontRemember -> {
+      case draft_field(draft, "rent_amount", "amount_eur") {
+        Some(a) -> [#("a_" <> q.id, a)]
+        None ->
+          case draft_flag(draft, "rent_amount", "dont_remember") {
+            True -> [#("a_" <> q.id <> "_dont_remember", "on")]
+            False -> []
+          }
+      }
+    }
+    AsStatedText(_) -> {
+      case draft_flag(draft, q.id, "as_stated") {
+        True -> [#("a_" <> q.id <> "_choice", "as_stated")]
+        False ->
+          case draft_field(draft, q.id, "differs") {
+            Some(t) -> [
+              #("a_" <> q.id <> "_choice", "differs"),
+              #("a_" <> q.id <> "_text", t),
+            ]
+            None ->
+              case draft_field(draft, q.id, "stated") {
+                Some(t) -> [#("a_" <> q.id <> "_text", t)]
+                None -> []
+              }
+          }
+      }
+    }
+    AsStatedAmount -> {
+      case draft_flag(draft, q.id, "as_stated") {
+        True -> [#("a_" <> q.id <> "_choice", "as_stated")]
+        False ->
+          case draft_flag(draft, q.id, "dont_know") {
+            True -> [#("a_" <> q.id <> "_choice", "dont_know")]
+            False ->
+              case draft_field(draft, q.id, "different_amount_eur") {
+                Some(a) -> [
+                  #("a_" <> q.id <> "_choice", "different"),
+                  #("a_" <> q.id <> "_amount", a),
+                ]
+                None -> []
+              }
+          }
+      }
+    }
+    ShortTextPair -> {
+      let rel = case draft_string(draft, "relationship") {
+        Some(r) -> [#("a_relationship", r)]
+        None -> []
+      }
+      let cap = case draft_string(draft, "capacity") {
+        Some(c) -> [#("a_capacity", c)]
+        None -> []
+      }
+      list.append(rel, cap)
+    }
+    FreeText(_) ->
+      case draft_string(draft, draft_key(q)) {
+        Some(t) -> [#("a_" <> q.id, t)]
+        None -> []
+      }
+  }
+  dict.from_list(pairs)
+}
+
+/// The one-line review-screen summary of a saved answer ("Not answered"
+/// when the key is absent — an unanswered optional free text reads the
+/// same; rc3-4 renders the full mapping to the landlord).
+pub fn answer_summary(
+  q q: Question,
+  draft draft: dict.Dict(String, Dynamic),
+) -> String {
+  case q.control {
+    Identity ->
+      case draft_string(draft, "identity_confirmed") {
+        Some("yes") -> form_copy.opt_yes
+        _ -> form_copy.review_not_answered
+      }
+    Choice(options) ->
+      case draft_string(draft, draft_key(q)) {
+        Some(v) -> label_for(options, v)
+        None -> form_copy.review_not_answered
+      }
+    ChoiceWithOther(options) ->
+      case draft_string(draft, draft_key(q)) {
+        Some("other") ->
+          case draft_string(draft, "relationship_other") {
+            Some(t) -> form_copy.opt_other <> ": " <> t
+            None -> form_copy.opt_other
+          }
+        Some(v) -> label_for(options, v)
+        None -> form_copy.review_not_answered
+      }
+    MonthYearOrOngoing ->
+      case draft_field(draft, "tenancy_period", "from") {
+        Some(from) ->
+          case draft_flag(draft, "tenancy_period", "ongoing") {
+            True -> from <> ", " <> form_copy.opt_ongoing
+            False ->
+              case draft_field(draft, "tenancy_period", "to") {
+                Some(to) -> from <> " to " <> to
+                None -> from
+              }
+          }
+        None -> form_copy.review_not_answered
+      }
+    AmountOrDontRemember ->
+      case draft_field(draft, "rent_amount", "amount_eur") {
+        Some(a) -> "€" <> a
+        None ->
+          case draft_flag(draft, "rent_amount", "dont_remember") {
+            True -> form_copy.dont_remember_label
+            False -> form_copy.review_not_answered
+          }
+      }
+    AsStatedText(_) ->
+      case draft_flag(draft, q.id, "as_stated") {
+        True -> form_copy.about_right_label
+        False ->
+          case draft_field(draft, q.id, "differs") {
+            Some(t) -> t
+            None ->
+              case draft_field(draft, q.id, "stated") {
+                Some(t) -> t
+                None -> form_copy.review_not_answered
+              }
+          }
+      }
+    AsStatedAmount ->
+      case draft_flag(draft, q.id, "as_stated") {
+        True -> form_copy.about_right_label
+        False ->
+          case draft_flag(draft, q.id, "dont_know") {
+            True -> form_copy.dont_know_label
+            False ->
+              case draft_field(draft, q.id, "different_amount_eur") {
+                Some(a) -> "€" <> a
+                None -> form_copy.review_not_answered
+              }
+          }
+      }
+    ShortTextPair -> {
+      let rel = draft_string(draft, "relationship")
+      let cap = draft_string(draft, "capacity")
+      case rel, cap {
+        Some(r), Some(c) -> r <> " (" <> c <> ")"
+        Some(r), None -> r
+        _, _ -> form_copy.review_not_answered
+      }
+    }
+    FreeText(_) ->
+      case draft_string(draft, draft_key(q)) {
+        Some("") -> form_copy.review_not_answered
+        Some(t) -> truncate(t, 140)
+        None -> form_copy.review_not_answered
+      }
+  }
+}
+
+fn label_for(options: List(#(String, String)), value: String) -> String {
+  case list.find(options, fn(opt) { opt.0 == value }) {
+    Ok(opt) -> opt.1
+    Error(_) -> value
+  }
+}
+
+fn truncate(text: String, max: Int) -> String {
+  case string.length(text) <= max {
+    True -> text
+    False -> string.slice(text, 0, max) <> "..."
+  }
+}
+
+// -- Field primitives ------------------------------------------------------------------
+
+fn field(fields: RawFields, name: String) -> String {
+  dict.get(fields, name) |> result.unwrap("")
+}
+
+fn draft_key(q: Question) -> String {
+  case q.draft_keys {
+    [k, ..] -> k
+    [] -> q.id
+  }
+}
+
+fn choice_value(
+  fields: RawFields,
+  id: String,
+  options: List(#(String, String)),
+) -> Result(String, ValidationError) {
+  let value = field(fields, "a_" <> id)
+  case value {
+    "" -> Error(Required)
+    _ ->
+      case list.any(options, fn(opt) { opt.0 == value }) {
+        True -> Ok(value)
+        False -> Error(Invalid)
+      }
+  }
+}
+
+fn bounded_text(
+  fields: RawFields,
+  name: String,
+  min: Int,
+  max: Int,
+) -> Result(String, ValidationError) {
+  let value = field(fields, name) |> string.trim
+  let len = string.length(value)
+  case len {
+    0 if min > 0 -> Error(Required)
+    _ ->
+      case len >= min && len <= max {
+        True -> Ok(value)
+        False -> Error(Invalid)
+      }
+  }
+}
+
+/// HTML `type=month` wire format: YYYY-MM, years 1950..2100. The month
+/// must be zero-padded — "2023-6" would break the lexicographic ordering
+/// assumption the from<=to check relies on (crafted input only; browsers
+/// always zero-pad).
+fn month_year(
+  fields: RawFields,
+  name: String,
+) -> Result(String, ValidationError) {
+  let value = field(fields, name) |> string.trim
+  case value {
+    "" -> Error(Required)
+    _ ->
+      case string.split(value, "-") {
+        [year_str, month_str] -> {
+          use year <- result.try(parse_int(year_str))
+          use month <- result.try(parse_int(month_str))
+          case
+            string.length(year_str) == 4
+            && string.length(month_str) == 2
+            && year >= 1950
+            && year <= 2100
+            && month >= 1
+            && month <= 12
+          {
+            True -> Ok(value)
+            False -> Error(Invalid)
+          }
+        }
+        _ -> Error(Invalid)
+      }
+  }
+}
+
+/// Whole euros: 1..7 digits, no symbols or separators ("1400", not "1,400").
+fn euro_amount(
+  fields: RawFields,
+  name: String,
+) -> Result(String, ValidationError) {
+  let value = field(fields, name) |> string.trim
+  case value {
+    "" -> Error(Required)
+    _ ->
+      case int.parse(value) {
+        Ok(n) ->
+          case string.length(value) <= 7 && n > 0 {
+            True -> Ok(value)
+            False -> Error(Invalid)
+          }
+        Error(_) -> Error(Invalid)
+      }
+  }
+}
+
+fn parse_int(text: String) -> Result(Int, ValidationError) {
+  case int.parse(text) {
+    Ok(n) -> Ok(n)
+    Error(_) -> Error(Invalid)
+  }
+}
