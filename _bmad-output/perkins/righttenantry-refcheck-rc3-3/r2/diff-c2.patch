+pub fn question_by_id(slot: RefSlot, id: String) -> Option(Question) {
+  questions_for(slot)
+  |> list.find(fn(q) { q.id == id })
+  |> option.from_result
+}
+
+pub fn question_index(slot: RefSlot, id: String) -> Option(Int) {
+  questions_for(slot)
+  |> list.index_map(fn(q, i) { #(q, i) })
+  |> list.find(fn(pair) { pair.0.id == id })
+  |> option.from_result
+  |> option.map(fn(pair) { pair.1 })
+}
+
+pub fn question_count(slot: RefSlot) -> Int {
+  questions_for(slot) |> list.length
+}
+
+/// The next question to show: the first whose draft keys are not ALL present
+/// in the draft. `None` means every question is answered (the review screen).
+pub fn next_unanswered(
