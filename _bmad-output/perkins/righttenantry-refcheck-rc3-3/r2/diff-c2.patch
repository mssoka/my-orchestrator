+  draft_keys keys: List(String),
+) -> Option(Question) {
+  questions_for(slot)
+  |> list.find(fn(q) {
+    q.draft_keys |> list.any(fn(k) { !list.contains(keys, k) })
+  })
+  |> option.from_result
+}
