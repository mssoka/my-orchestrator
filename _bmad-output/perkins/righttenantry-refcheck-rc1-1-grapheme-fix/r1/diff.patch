+//// Unit tests for the shared request inspection helpers.
+////
+//// Pins the codepoint-bounded slicing contract (refcheck rc1-1
+//// deferred fix): the DB CHECK constraints bound Postgres `length()`
+//// (character/codepoint count), so slicing must be codepoint-bounded
+//// — never grapheme-bounded — or a multi-codepoint header (ZWJ emoji,
+//// combining marks, flags) can exceed the bound post-slice and 500
+//// the write path.
+
+import gleam/http
+import gleam/list
+import gleam/string
+import gleeunit/should
+import request_helpers
+import wisp/simulate
+
+fn codepoint_length(value: String) -> Int {
+  value |> string.to_utf_codepoints |> list.length
+}
+
+// A single grapheme that spans 7 codepoints (ZWJ family emoji). One
+// grapheme of this is already 7 characters by Postgres `length()`.
+const family_emoji = "👨‍👩‍👧‍👦"
+
+fn req_with_ua(ua: String) {
+  simulate.request(http.Get, "/")
+  |> simulate.header("user-agent", ua)
+}
+
+fn req_with_xff(xff: String) {
+  simulate.request(http.Get, "/")
+  |> simulate.header("x-forwarded-for", xff)
+}
+
+// The regression the deferred fix exists for: 100 family emoji is 100
+// graphemes but 700 codepoints. Grapheme slicing to 512 would keep
+// all 700 codepoints (512 graphemes of 7 codepoints = 3584) — well
+// past the 512-char CHECK. Codepoint slicing must cut at 512.
+pub fn user_agent_multi_codepoint_sliced_to_512_codepoints_test() {
+  let ua = string.repeat(family_emoji, 100)
+  // Sanity: this is 700 codepoints and only 100 graphemes — the bug's
+  // precondition (multi-codepoint graphemes).
+  codepoint_length(ua) |> should.equal(700)
+  string.length(ua) |> should.equal(100)
+
+  let sliced = request_helpers.client_user_agent(req_with_ua(ua))
+  codepoint_length(sliced) |> should.equal(512)
+}
+
+// ASCII is 1 codepoint per grapheme — codepoint slicing must be
+// byte-identical to the old grapheme slicing for the common case.
+pub fn user_agent_ascii_still_truncates_to_512_test() {
+  let ua = string.repeat("U", 600)
+  let sliced = request_helpers.client_user_agent(req_with_ua(ua))
+  sliced |> should.equal(string.repeat("U", 512))
+}
+
+pub fn user_agent_absent_header_returns_empty_test() {
+  let req = simulate.request(http.Get, "/")
+  request_helpers.client_user_agent(req) |> should.equal("")
+}
+
+// Multi-codepoint garbage in the XFF first hop must be bounded to 64
+// codepoints — same trap as the UA, at the ip_text CHECK bound.
+pub fn client_ip_multi_codepoint_sliced_to_64_codepoints_test() {
+  let xff = string.repeat(family_emoji, 20) <> ", 10.0.0.1"
+  // 20 graphemes = 140 codepoints, over the 64-char ip_text CHECK.
+  codepoint_length(xff) |> should.equal(150)
+
+  let sliced = request_helpers.client_ip(req_with_xff(xff))
+  codepoint_length(sliced) |> should.equal(64)
+}
+
+// ASCII XFF first hop: trim + first-entry-only + 64-char cap, exactly
+// as before the fix.
+pub fn client_ip_ascii_first_hop_bounded_to_64_test() {
+  let xff = string.repeat("9", 500) <> ", 10.0.0.1"
+  let sliced = request_helpers.client_ip(req_with_xff(xff))
+  sliced |> should.equal(string.repeat("9", 64))
+}
+
+pub fn client_ip_takes_first_entry_only_test() {
+  let req = req_with_xff("  203.0.113.42  , 10.0.0.1")
+  request_helpers.client_ip(req) |> should.equal("203.0.113.42")
+}
+
+pub fn client_ip_absent_header_returns_empty_test() {
+  let req = simulate.request(http.Get, "/")
+  request_helpers.client_ip(req) |> should.equal("")
+}
+
+// A multi-codepoint UA shorter than the bound passes through
+// untouched — slicing never mangles values that fit.
+pub fn user_agent_short_multi_codepoint_unchanged_test() {
+  let ua = string.repeat(family_emoji, 3) <> " Mozilla/5.0"
+  let sliced = request_helpers.client_user_agent(req_with_ua(ua))
+  sliced |> should.equal(ua)
+}
