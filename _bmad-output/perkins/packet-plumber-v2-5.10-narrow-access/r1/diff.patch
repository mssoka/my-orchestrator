+// W11 — the aggregation choke, the honest 4.1 reading (story 5.10 hard
+// requirement 3): MANY residentials (6 per side), each on its OWN narrow
+// access drop, aggregate onto ONE shared standard uplink (the player-built
+// fat path). The shared link saturates at base demand (streaming 1/tick =
+// 30 u/s + cross-side email ~8 u/s vs 15 u/s service) and sheds — and NO drop
+// ever targets a narrow access bundle: a subscriber's own traffic never
+// congests its drop (the 5.9 cap + the 5.10 headroom), so a congested narrow
+// now genuinely signals an undersized access link. Sink-side concentration is
+// spread thin enough (12 residentials) that even the inbound bursts stay
+// under the access capacity (the W6 sink-side boundary stays un-hit).
+@(test)
+test_w11_aggregation_congests_shared_link :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	cat.balance.pool_max_packets = 100000 // the E22 backstop is not under test
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 4243, cat.hash, TEST_LOGIC_HZ)
+	s.era = 3
+	res_idx, _ := node_type_index(cat, "residential")
+	rt_idx, _ := node_type_index(cat, "router_mid")
+	host_idx, _ := node_type_index(cat, "content_host")
+	// 6 homes per side, each on its own narrow drop (spans <= narrow max_span
+	// 10); the two mid routers meet on ONE shared standard uplink; the content
+	// host rides a WIDE drop (a host's own uplink is not the access choke —
+	// the shared link is). router_mid ports: 6 res + uplink = 7 <= 8 per side.
+	a1 := topology_spawn_node(&s.topology, res_idx, {13, 8}, cat)
+	a2 := topology_spawn_node(&s.topology, res_idx, {13, 15}, cat)
+	a3 := topology_spawn_node(&s.topology, res_idx, {13, 22}, cat)
+	a4 := topology_spawn_node(&s.topology, res_idx, {16, 6}, cat)
+	a5 := topology_spawn_node(&s.topology, res_idx, {16, 24}, cat)
+	a6 := topology_spawn_node(&s.topology, res_idx, {27, 15}, cat)
+	ra := topology_spawn_node(&s.topology, rt_idx, {20, 15}, cat)
+	b1 := topology_spawn_node(&s.topology, res_idx, {34, 6}, cat)
+	b2 := topology_spawn_node(&s.topology, res_idx, {38, 11}, cat)
+	b3 := topology_spawn_node(&s.topology, res_idx, {38, 16}, cat)
+	b4 := topology_spawn_node(&s.topology, res_idx, {38, 21}, cat)
+	b5 := topology_spawn_node(&s.topology, res_idx, {36, 24}, cat)
+	b6 := topology_spawn_node(&s.topology, res_idx, {32, 22}, cat)
+	rb := topology_spawn_node(&s.topology, rt_idx, {32, 15}, cat)
+	host := topology_spawn_node(&s.topology, host_idx, {38, 9}, cat)
+	sla_draw(&s, cat, a1, ra, "narrow", 1) // pipe 0 — access A1
+	sla_draw(&s, cat, a2, ra, "narrow", 1) // pipe 1
+	sla_draw(&s, cat, a3, ra, "narrow", 1) // pipe 2
+	sla_draw(&s, cat, a4, ra, "narrow", 1) // pipe 3
+	sla_draw(&s, cat, a5, ra, "narrow", 1) // pipe 4
+	sla_draw(&s, cat, a6, ra, "narrow", 1) // pipe 5
+	sla_draw(&s, cat, b1, rb, "narrow", 1) // pipe 6
+	sla_draw(&s, cat, b2, rb, "narrow", 1) // pipe 7
+	sla_draw(&s, cat, b3, rb, "narrow", 1) // pipe 8
+	sla_draw(&s, cat, b4, rb, "narrow", 1) // pipe 9
+	sla_draw(&s, cat, b5, rb, "narrow", 1) // pipe 10
+	sla_draw(&s, cat, b6, rb, "narrow", 1) // pipe 11
+	sla_draw(&s, cat, host, rb, "wide", 1)   // pipe 12 — the host drop
+	sla_draw(&s, cat, ra, rb, "standard", 1) // pipe 13 — the shared uplink
+
+	W :: u64(600)
+	drops: u64 = 0
+	by_bundle := make(map[u32]u64, 16) // drop targets (resolved to bundles after the run)
+	defer delete(by_bundle)
+	for tick in u64(1)..=W {
+		before := len(s.events)
+		batch := make([dynamic]Command, 0, 4, context.temp_allocator)
+		for cmd in s.action_log {
+			if cmd.apply_tick == tick {
+				append(&batch, cmd)
+			}
+		}
+		step(&s, tick, batch[:], cat)
+		for e in s.events[before:] {
+			if e.tag == EVENT_TAG_PACKET_DROPPED {
+				drops += 1
+				by_bundle[e.target] += 1
+			}
+		}
+		clear(&s.events)
+		free_all(context.temp_allocator)
+	}
+	// the settled bundle slots of the 12 narrow access legs (pipes 0..11 —
+	// the residential drops; pipe 13 is the shared uplink; pipe 12 is the
+	// host's own wide drop). Resolved AFTER the run: the bundle view settles
+	// once the draws apply.
+	narrow_bundles := make(map[u32]bool, 16)
+	defer delete(narrow_bundles)
+	for p in u32(0)..<12 {
+		if b, ok := bundle_of_pipe(&s, p); ok {
+			narrow_bundles[b] = true
+		}
+	}
+	narrow_drops: u64 = 0
+	for b, n in by_bundle {
+		if narrow_bundles[b] {
+			narrow_drops += n
+		}
+	}
+	testing.expectf(t, !s.replay_error, "no draw may be rejected (the fixture must be fully wired — a rejected draw would make the pin vacuous)")
+	testing.expectf(t, drops > 0, "the shared uplink must congest (the aggregation choke is real), got 0 drops")
+	testing.expectf(t, narrow_drops == 0,
+		"%d drops targeted a narrow access bundle (want 0 — a subscriber's own traffic never congests its drop; congestion lives at the shared uplink)", narrow_drops)
+	// non-vacuous: traffic actually flows across the aggregation point
+	testing.expectf(t, s.flow.sla[0].delivered > 0 && s.flow.sla[1].delivered > 0,
+		"both classes must deliver across the shared link (email %d, streaming %d — the aggregation scenario must be live)", s.flow.sla[0].delivered, s.flow.sla[1].delivered)
+}
