+	// ticks = 600 ms — the guard the rebalance lifts).
+	hop_ticks := (i64(cat.balance.packet_bandwidth) + i64(cat.pipe_tiers[narrow].capacity_units) - 1) / i64(cat.pipe_tiers[narrow].capacity_units)
+	testing.expectf(t, hop_ticks * 2 * 50 <= 500, "2-hop email at narrow = %d ms > 500 ms tolerance (W5)", hop_ticks * 2 * 50)
+}
