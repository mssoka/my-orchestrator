+// Self-employed coherence (user ruling 2026-08-04): the employer-trio error
+// messages name the employer-or-business path — a sole trader on the
+// required-error path must never assume an employer for a sole trader.
+pub fn validate_form_employer_errors_use_business_aware_copy_test() {
+  let values =
+    test_helpers.valid_application_form_values()
+    |> list.key_set("employment_status", "self-employed")
+    |> list.key_set("employer_name", "")
+    |> list.key_set("employer_ref_name", "")
+    |> list.append([
+      #("num_occupants", "2"),
+      #("co_applicant_sharing", "yes"),
+      #("co_applicant_count", "1"),
+      #("co_applicant[0][first_name]", "Conor"),
+      #("co_applicant[0][last_name]", "Byrne"),
+      #("co_applicant[0][monthly_income_cents]", "250000"),
+      #("co_applicant[0][employment_status]", "self-employed"),
+      #("co_applicant[0][employer_name]", ""),
+      #("co_applicant[0][employer_ref_name]", ""),
+    ])
+  let errors =
+    application_handler.validate_form(values, test_helpers.test_today())
+  errors
+  |> list.any(fn(e) {
+    e == #("employer_name", "Your employer or business name, please.")
+  })
+  |> should.be_true
+  errors
+  |> list.any(fn(e) {
+    e == #("employer_ref_name", "Who can confirm your work? Their name.")
+  })
+  |> should.be_true
+  errors
+  |> list.any(fn(e) {
+    e == #("co_applicant[0][employer_name]", "Their employer or business name.")
+  })
+  |> should.be_true
+  errors
+  |> list.any(fn(e) {
+    e
+    == #(
+      "co_applicant[0][employer_ref_name]",
+      "Someone who can confirm their work.",
+    )
+  })
+  |> should.be_true
+  // The ruled-out phrasing is gone from every employer-trio message.
+  errors
+  |> list.any(fn(e) { string.contains(e.1, "employer\u{2019}s name") })
+  |> should.be_false
+}
