new file mode 100644
index 0000000..01d0020
--- /dev/null
+++ b/core/serialize.odin
@@ -0,0 +1,201 @@
+package core
+
+// serialize.odin — the canonical serialized form (ODN-11 / T1). Field-wise
+// little-endian, lengths-not-capacities, no padding, no pointers — INCLUDING
+// rng state + the applied-command record + the tick's event stream. FNV-1a-64
+// over this byte stream is the T1 state hash (hash.odin). "Byte-identical
+// replay" = identical hashes = identical canonical bytes (E10).
+//
+// Also the action-log binary format (ODN-11): a versioned little-endian
+// header (magic, version, seed, era, catalog_hash, logic_hz) +
+// length-prefixed records of post-validation commands. The replay gate
+// (harness) reads this back and re-sims; catalog/logic_hz drift is a defined
+// rejection, never silent divergence.
+
+Writer :: struct {
+	buf: [dynamic]u8,
+}
+
+writer_make :: proc(scratch := context.temp_allocator) -> Writer {
+	w: Writer
+	w.buf = make([dynamic]u8, 0, 4096, scratch)
+	return w
+}
+
+w_u8 :: proc(w: ^Writer, v: u8) { append(&w.buf, v) }
+
+w_u16 :: proc(w: ^Writer, v: u16) {
+	append(&w.buf, u8(v), u8(v >> 8))
+}
+
+w_u32 :: proc(w: ^Writer, v: u32) {
+	append(&w.buf, u8(v), u8(v >> 8), u8(v >> 16), u8(v >> 24))
+}
+
+w_i32 :: proc(w: ^Writer, v: i32) { w_u32(w, u32(v)) }
+
+w_u64 :: proc(w: ^Writer, v: u64) {
+	for i in 0..<8 { append(&w.buf, u8(v >> (8 * uint(i)))) }
+}
+
+w_bool :: proc(w: ^Writer, v: bool) { w_u8(w, 1 if v else 0) }
+
+// Per-variant command tag (stable across the wire; new variants append).
+CMD_TAG_SET_ARG :: u8(1)
+
+// --- the T1 state hash --------------------------------------------------------
+
+// Serialize the full sim state and FNV-1a-64 it. Called per tick by the
+// harness (and by the replay-equality unit test). `tick_events` is the slice
+// of state.events produced THIS tick (drained after hashing, ODN-14).
+state_hash :: proc(state: ^Run_State, tick_events: []Event,
+                   scratch := context.temp_allocator) -> u64 {
+	w := state_writer(state, tick_events, scratch)
+	return fnv1a64(w.buf[:])
+}
+
+// The raw canonical bytes (for debugging / future diff bundles).
+state_dump :: proc(state: ^Run_State, tick_events: []Event,
+                   scratch := context.temp_allocator) -> []u8 {
+	w := state_writer(state, tick_events, scratch)
+	return w.buf[:]
+}
+
+state_writer :: proc(state: ^Run_State, tick_events: []Event,
+                     scratch := context.temp_allocator) -> Writer {
+	w := writer_make(scratch)
+
+	w_u64(&w, state.seed)
+	w_u64(&w, state.tick)
+	w_u64(&w, state.rng.state)
+	w_u64(&w, state.rng.inc)
+	w_u8(&w, state.era)
+	w_u64(&w, state.catalog_hash)
+	w_i32(&w, state.logic_hz)
+	w_u32(&w, state.tick_nonce) // per-tick rng heartbeat (1.2: real sim state)
+
+	// the replay artifact (the action log) — lengths-not-capacities, in order
+	w_u32(&w, u32(len(state.action_log)))
+	for cmd in state.action_log {
+		w_u64(&w, cmd.apply_tick)
+		switch c in cmd.kind {
+		case Cmd_Set_Arg: w_u8(&w, CMD_TAG_SET_ARG); w_u32(&w, c.arg)
+		}
+	}
+
+	// applied commands — the spine's "topology" (replaces with real state 1.2)
+	w_u32(&w, u32(len(state.applied)))
+	for a in state.applied {
+		w_u64(&w, a.tick)
+		w_u32(&w, a.arg)
+	}
+
+	// the tick's event stream (ODN-14) — part of the hash so event divergence
+	// is caught without a single pixel
+	w_u32(&w, u32(len(tick_events)))
+	for e in tick_events {
+		w_u64(&w, e.tick)
+		w_u8(&w, e.tag)
+	}
+
+	return w
+}
+
+// --- the action log (ODN-11 binary) -------------------------------------------
+
+LOG_MAGIC :: u32(0x314C5050) // "PPL1" little-endian
+LOG_VERSION :: u32(1)
+
+// Write the run's action log: versioned header + length-prefixed command
+// records. catalog_hash + logic_hz ride in the header so the replay gate can
+// reject drift (ODN-11).
+log_write :: proc(state: ^Run_State, scratch := context.temp_allocator) -> []u8 {
+	w := writer_make(scratch)
+	w_u32(&w, LOG_MAGIC)
+	w_u32(&w, LOG_VERSION)
+	w_u64(&w, state.seed)
+	w_u8(&w, state.era)
+	w_u64(&w, state.catalog_hash)
+	w_i32(&w, state.logic_hz)
+	w_u32(&w, u32(len(state.action_log)))
+	for cmd in state.action_log {
+		w_u64(&w, cmd.apply_tick)
+		switch c in cmd.kind {
+		case Cmd_Set_Arg: w_u8(&w, CMD_TAG_SET_ARG); w_u32(&w, c.arg)
+		}
+	}
+	return w.buf[:]
+}
+
+// --- log reader (the replay half) ---------------------------------------------
+
+Reader :: struct {
+	data: []u8,
+	pos:  int,
+	bad:  bool, // set on any past-end read (truncation = corrupt, never silent)
+}
+
+r_u8 :: proc(r: ^Reader) -> u8 {
+	if r.pos >= len(r.data) {
+		r.bad = true
+		return 0
+	}
+	v := r.data[r.pos]
+	r.pos += 1
+	return v
+}
+
+r_u16 :: proc(r: ^Reader) -> u16 {
+	return u16(r_u8(r)) | (u16(r_u8(r)) << 8)
+}
+
+r_u32 :: proc(r: ^Reader) -> u32 {
+	return u32(r_u8(r)) | (u32(r_u8(r)) << 8) | (u32(r_u8(r)) << 16) | (u32(r_u8(r)) << 24)
+}
+
+r_i32 :: proc(r: ^Reader) -> i32 { return i32(r_u32(r)) }
+
+r_u64 :: proc(r: ^Reader) -> u64 {
+	v: u64 = 0
+	for i in 0..<8 { v |= u64(r_u8(r)) << (8 * uint(i)) }
+	return v
+}
+
+Log_Header :: struct {
+	seed:         u64,
+	era:          u8,
+	catalog_hash: u64,
+	logic_hz:     i32,
+}
+
+// Parse an action log. ok=false on any corruption (magic/version mismatch,
+// truncation, trailing bytes, unknown tag) — critical-error handling (§7.1),
+// never a silent partial parse.
+log_read :: proc(data: []u8, allocator := context.allocator) -> (Log_Header, []Command, bool) {
+	r := Reader{data = data}
+	if r_u32(&r) != LOG_MAGIC do return {}, nil, false
+	if r_u32(&r) != LOG_VERSION do return {}, nil, false
+	h: Log_Header
+	h.seed = r_u64(&r)
+	h.era = r_u8(&r)
+	h.catalog_hash = r_u64(&r)
+	h.logic_hz = r_i32(&r)
+	n := r_u32(&r)
+	// bounds sanity before allocation: the smallest record is 9 bytes
+	// (apply_tick u64 + tag u8); a count beyond the remaining bytes is corrupt.
+	if u64(n) * 9 > u64(len(r.data) - r.pos) do return {}, nil, false
+	cmds := make([]Command, n, allocator)
+	for i in 0..<int(n) {
+		cmd: Command
+		cmd.apply_tick = r_u64(&r)
+		switch r_u8(&r) {
+		case CMD_TAG_SET_ARG:
+			cmd.kind = Cmd_Set_Arg{arg = r_u32(&r)}
+		case:
+			return {}, nil, false
+		}
+		cmds[i] = cmd
+	}
+	if r.bad || r.pos != len(r.data) do return {}, nil, false // truncation/trailing = corrupt
+	return h, cmds, true
+}
diff --git a/core/step.odin b/core/step.odin
new file mode 100644
index 0000000..f88fd45
--- /dev/null
+++ b/core/step.odin
@@ -0,0 +1,36 @@
+package core
+
+// step.odin — the ONLY entry point that advances the simulation (ODN-1).
+//
+// Story 1.1 spine: step is a no-op heartbeat. It (a) applies the tick's
+// replay commands to `applied` (the spine's topology stand-in) and (b) draws
+// the owned RNG once per tick — the thinnest sim activity that makes the
+// determinism plumbing (rng → serialize → hash → replay) real and testable.
+// There is no topology / flow / crisis / health yet (later slices); nothing
+// here reads a clock, a file, or a device (ODN-1), and all math is integer
+// (ODN-10).
+//
+// The command-application convention (pinned, arch §11.1): live edits apply
+// immediately via the edit fast-path (story 1.2's Command_Bus) and are logged
+// with apply_tick = the next tick; replay applies every log entry with
+// apply_tick == N BEFORE stepping N — so live and replay see identical state
+// at every step boundary (E10). For the spine the harness/test feeds step the
+// matching commands directly (no bus yet); the convention still holds.
+step :: proc(state: ^Run_State, tick: u64, commands: []Command) {
+	state.tick = tick
+
+	// apply this tick's commands (spine: record them; 1.2 mutates Topology)
+	for cmd in commands {
+		switch c in cmd.kind {
+		case Cmd_Set_Arg:
+			append(&state.applied, Applied_Cmd{tick = tick, arg = c.arg})
+		}
+	}
+
+	// heartbeat: one owned-RNG draw folded into a per-tick state field. This
+	// is the thinnest sim activity that ties the RNG into the step path
+	// (different seed → different nonce sequence → different hashes; replay
+	// reproduces it exactly). Story 1.2+ replaces tick_nonce with real
+	// rng-derived sim state (demand, spawn, ECMP, …).
+	state.tick_nonce = rng_next(&state.rng)
+}
diff --git a/core/types.odin b/core/types.odin
new file mode 100644
index 0000000..d15cc0e
--- /dev/null
+++ b/core/types.odin
@@ -0,0 +1,92 @@
+package core
+
+// types.odin — the spine state model. A deliberate SUBSET of the full game
+// state (arch §8.2): no Topology / Flow / Crisis / Health yet (those are
+// later slices — story 1.2 onward). Everything here is integer (ODN-10) and
+// the RNG is owned (ODN-9). The determinism spine needs only:
+//   - the seed + rng (the owned PRNG),
+//   - the tick counter,
+//   - the action log (ODN-11 — the replay artifact),
+//   - the per-tick event buffer (ODN-14),
+//   - the catalog_hash + logic_hz the replay gate binds to (ODN-11).
+//
+// `applied` is the spine's stand-in for "the topology that commands mutate":
+// step records each applied command here so the state hash reflects command
+// application (replay-equality is real, not vacuous). Story 1.2 replaces it
+// with the real Topology SOA; the serialize/step/hash plumbing is unchanged.
+
+// Command — the post-validation action-log entry (ODN-11). Tagged union; the
+// spine carries one placeholder variant so the binary log round-trips a
+// payload and replay-equality is exercised. Later stories add Draw_Pipe,
+// Demolish, Set_Lane_Weights, … as new variants behind the same `switch`.
+Command_Kind :: union {
+	Cmd_Set_Arg,
+}
+
+// Spine placeholder command: carries a u32 the run records in `applied`.
+// Real commands (Draw_Pipe{a, b, tier}, …) land in story 1.2+.
+Cmd_Set_Arg :: struct {
+	arg: u32,
+}
+
+Command :: struct {
+	apply_tick: u64,
+	kind:       Command_Kind,
+}
+
+// The spine's deterministic record of command application (replaces with the
+// real Topology in story 1.2). Serialized into the state hash so replay
+// divergence is caught (E10).
+Applied_Cmd :: struct {
+	tick: u64,
+	arg:  u32,
+}
+
+// Event — the per-tick event buffer entry (ODN-14). The spine emits none
+// (step is a no-op heartbeat); later stories add Packet_Arrived,
+// Crisis_Triggered, … The tag byte is the serialized discriminator.
+Event :: struct {
+	tick: u64,
+	tag:  u8, // 0 = (none); spine reserves 1.. for future variants
+}
+
+// Run_State — the authoritative sim state (ODN-1/13). One value per run,
+// created fresh per run (reset = make a new one), passed by pointer. No
+// globals (ODN-13); no maps anywhere (ODN-10).
+Run_State :: struct {
+	seed:         u64,
+	tick:         u64,
+	rng:          Rng,
+	era:          u8,           // [LATER] Era FSM; spine pins 0
+	catalog_hash: u64,          // ODN-11 — binds the run to its catalogs
+	logic_hz:     i32,          // ODN-11 — binds the run to its tick rate
+	action_log:   [dynamic]Command, // the replay artifact (ODN-11)
+	applied:      [dynamic]Applied_Cmd,
+	events:       [dynamic]Event,   // per-tick buffer (ODN-14)
+	tick_nonce:   u32,           // per-tick rng-derived value (heartbeat; 1.2 replaces with real sim state)
+	replay_error: bool,         // latched if a replayed command fails (critical)
+}
+
+// run_init — create a fresh run context (ODN-13: reset = make a new one).
+// The caller (harness/app) resolves catalog_hash + logic_hz from data/*.json
+// (core is pure — no file I/O, ODN-1) and seeds the owned RNG.
+run_init :: proc(state: ^Run_State, seed: u64, catalog_hash: u64, logic_hz: i32,
+                 allocator := context.allocator) {
+	state^ = {} // zero everything (no stale state across runs)
+	state.seed = seed
+	state.catalog_hash = catalog_hash
+	state.logic_hz = logic_hz
+	state.era = 0
+	state.action_log = make([dynamic]Command, allocator)
+	state.applied = make([dynamic]Applied_Cmd, allocator)
+	state.events = make([dynamic]Event, allocator)
+	rng_seed(&state.rng, seed)
+}
+
+// run_destroy — free the run's owned buffers (mirrors run_init; ODN-18
+// arena discipline lands later, but explicit frees are correct now).
+run_destroy :: proc(state: ^Run_State) {
+	delete(state.action_log)
+	delete(state.applied)
+	delete(state.events)
+}
