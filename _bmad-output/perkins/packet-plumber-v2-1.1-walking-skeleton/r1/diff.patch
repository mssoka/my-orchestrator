diff --git a/harness/demo.odin b/harness/demo.odin
new file mode 100644
index 0000000..c8b8f89
--- /dev/null
+++ b/harness/demo.odin
@@ -0,0 +1,88 @@
+package main
+
+// demo.odin — the scripted-demo model + parser (arch §10.3). A demo is a
+// header (seed) + a run length (ms) + expectations; it lowers to an action
+// log through the real core path (the harness plays intents through the
+// Command_Bus in 1.2; for the 1.1 spine boot.dem has no commands).
+//
+// Time: demo `run` is authored in ms and converted to ticks by
+// floor(ticks = run_ms * logic_hz / 1000) — the spine ticks directly (no
+// frame loop / no rendering); the 1/60s virtual clock + floor-to-frame
+// capture quantization lands with T2 (story 1.2+).
+
+import "core:fmt"
+import "core:strconv"
+import "core:strings"
+
+Demo :: struct {
+	name:             string,
+	seed:             u64,
+	run_ms:           i64,
+	expect_hash_stable: bool,
+}
+
+// parse_demo — line-based; `seed <n>`, `run <n>ms`, `expect hash stable`.
+// Returns "" on success, a one-line error otherwise.
+parse_demo :: proc(name: string, text: string) -> (Demo, string) {
+	d := Demo{name = name}
+	for raw in strings.split(text, "\n", context.temp_allocator) {
+		line := strings.trim_space(raw)
+		if len(line) == 0 || line[0] == '#' {
+			continue
+		}
+		fields := strings.fields(line)
+		if len(fields) == 0 {
+			continue
+		}
+		switch fields[0] {
+		case "seed":
+			if len(fields) < 2 {
+				return {}, "seed needs a value"
+			}
+			v, ok := strconv.parse_uint(fields[1], 10)
+			if !ok {
+				return {}, fmt.tprintf("bad seed: %q", fields[1])
+			}
+			d.seed = u64(v)
+		case "run":
+			if len(fields) < 2 {
+				return {}, "run needs a duration (e.g. run 5000ms)"
+			}
+			ms, ok := parse_ms(fields[1])
+			if !ok {
+				return {}, fmt.tprintf("bad run duration: %q", fields[1])
+			}
+			d.run_ms = ms
+		case "expect":
+			if len(fields) >= 3 && fields[1] == "hash" && fields[2] == "stable" {
+				d.expect_hash_stable = true
+			} else {
+				return {}, fmt.tprintf("unknown expect: %s", line)
+			}
+		case:
+			// forward-compat: silently skip future verbs (map, capture, at, …)
+			// so a 1.2+ demo doesn't hard-fail the 1.1 harness. T1 is the spine.
+		}
+	}
+	if d.run_ms <= 0 {
+		return {}, "demo must set `run <n>ms`"
+	}
+	return d, ""
+}
+
+// parse_ms — "5000ms" -> 5000. Trailing 'ms' required.
+parse_ms :: proc(s: string) -> (i64, bool) {
+	if !strings.has_suffix(s, "ms") {
+		return 0, false
+	}
+	n, ok := strconv.parse_int(s[:len(s)-2], 10)
+	if !ok {
+		return 0, false
+	}
+	return i64(n), true
+}
+
+// demo_run_ticks — floor(run_ms * logic_hz / 1000); the integer tick count.
+demo_run_ticks :: proc(d: ^Demo, logic_hz: i32) -> u64 {
+	return u64(max(0, i64(d.run_ms) * i64(logic_hz) / 1000))
+}
