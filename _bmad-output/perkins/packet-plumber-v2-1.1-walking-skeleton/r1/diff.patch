+++ b/harness/main.odin
@@ -0,0 +1,102 @@
+package main
+
+// main.odin — the golden-image harness CLI (ODN-17). Headless for Story 1.1
+// (no window, no raylib — the determinism spine is proven before any view;
+// lavish choice 2B). The first runnable app.bin + T2 pixel goldens land in
+// 1.2; this harness already links the SAME package core and exercises T1 +
+// the replay gate.
+//
+// Usage:
+//   odin run harness -- run [demo...]    replay demos; T1 + replay gate; non-zero on failure
+//   odin run harness -- save [demo...]   re-bless goldens (deliberate; PR-reviewed)
+//   odin run harness -- replay <demo> <log.bin>  re-run from an action log; manifest must match
+
+import "core:fmt"
+import "core:os"
+import "core:strings"
+
+main :: proc() {
+	args := os.args[1:]
+	if len(args) == 0 {
+		usage()
+	}
+	verb := args[0]
+	rest := args[1:]
+
+	if verb == "replay" {
+		if len(rest) != 2 {
+			usage()
+		}
+		os.exit(int(run_replay(rest[0], rest[1])))
+	}
+	if verb != "run" && verb != "save" {
+		usage()
+	}
+
+	names := rest
+	collected: [dynamic]string
+	defer delete(collected)
+	if len(names) == 0 {
+		entries, err := list_demos()
+		if err != nil {
+			fmt.eprintln("harness: no demos/ directory")
+			os.exit(2)
+		}
+		for n in entries {
+			append(&collected, n)
+		}
+		if len(collected) == 0 {
+			fmt.eprintln("harness: no demos/*.dem found")
+			os.exit(2)
+		}
+		names = collected[:]
+	}
+
+	failures := 0
+	for name in names {
+		ok := run_demo(name, verb == "save")
+		if !ok {
+			failures += 1
+		}
+		free_all(context.temp_allocator)
+	}
+
+	if verb == "save" {
+		if failures > 0 {
+			fmt.printf("harness: %d demo(s) FAILED during bless\n", failures)
+			os.exit(1)
+		}
+		fmt.printf("harness: blessed %d demo(s)\n", len(names))
+		os.exit(0)
+	}
+	if failures > 0 {
+		fmt.printf("harness: %d demo(s) FAILED\n", failures)
+		os.exit(1)
+	}
+	fmt.printf("harness: %d demo(s) green\n", len(names))
+}
+
+usage :: proc() {
+	fmt.eprintln("usage: harness run|save [demo...] | replay <demo> <log.bin>")
+	os.exit(2)
+}
+
+// list_demos — names (without .dem) of every demo in demos/.
+list_demos :: proc() -> ([]string, os.Error) {
+	out: [dynamic]string
+	f, err := os.open("demos")
+	if err != nil {
+		return {}, err
+	}
+	entries, derr := os.read_dir(f, -1, context.temp_allocator)
+	os.close(f)
+	if derr != nil {
+		return {}, derr
+	}
+	for e in entries {
+		if strings.has_suffix(e.name, ".dem") {
+			append(&out, strings.clone(e.name[:len(e.name)-4], context.allocator))
+		}
+	}
+	return out[:], nil
+}
diff --git a/harness/manifest.odin b/harness/manifest.odin
new file mode 100644
index 0000000..ba0aed7
--- /dev/null
+++ b/harness/manifest.odin
@@ -0,0 +1,145 @@
+package main
+
+// manifest.odin — the T1 golden manifest (arch §10.2/§10.3). One per demo at
+// goldens/<demo>.t1: a header (the version, demo, seed, logic_hz,
+// catalog_hash, tick count) + one FNV-1a-64 state hash per tick. The header
+// carries catalog_hash + logic_hz so retuning either is a DEFINED re-bless,
+// never a silent shift (ODN-11). The replay gate (run.odin) binds the same
+// pair from the action-log header.
+
+import "core:fmt"
+import "core:os"
+import "core:strconv"
+import "core:strings"
+
+Manifest :: struct {
+	version:      i64,
+	demo:         string,
+	seed:         u64,
+	logic_hz:     i64,
+	catalog_hash: u64,
+	ticks:        i64,
+	hashes:       [dynamic]u64,
+}
+
+manifest_path :: proc(demo: string) -> string {
+	return fmt.tprintf("goldens/%s.t1", demo)
+}
+
+// read_manifest — tolerant line parser (the prototype's shape): keyword lines
+// fill the header; any other 2-field line whose 2nd field parses as hex is a
+// per-tick hash. Returns false on unreadable / missing file.
+read_manifest :: proc(path: string) -> (Manifest, bool) {
+	m: Manifest
+	m.version = -1
+	if !os.exists(path) {
+		return m, false
+	}
+	data, err := os.read_entire_file_from_path(path, context.temp_allocator)
+	if err != nil {
+		return m, false
+	}
+	for raw_line in strings.split(string(data), "\n", context.temp_allocator) {
+		line := strings.trim_space(raw_line)
+		if len(line) == 0 || line[0] == '#' {
+			continue
+		}
+		fields := strings.fields(line)
+		if len(fields) != 2 {
+			continue
+		}
+		switch fields[0] {
+		case "t1":
+			v, _ := strconv.parse_int(fields[1], 10)
+			m.version = i64(v)
+		case "demo":
+			m.demo = strings.clone(fields[1], context.allocator)
+		case "seed":
+			v, _ := strconv.parse_int(fields[1], 10)
+			m.seed = u64(v)
+		case "logic_hz":
+			v, _ := strconv.parse_int(fields[1], 10)
+			m.logic_hz = i64(v)
+		case "catalog_hash":
+			v, _ := strconv.parse_uint(fields[1], 16)
+			m.catalog_hash = u64(v)
+		case "ticks":
+			v, _ := strconv.parse_int(fields[1], 10)
+			m.ticks = i64(v)
+		case:
+			// a per-tick hash line: "<index> <hex>"
+			v, okv := strconv.parse_uint(fields[1], 16)
+			if okv {
+				append(&m.hashes, u64(v))
+			}
+		}
+	}
+	return m, true
+}
+
+// write_manifest — bless the T1 golden (deliberate; PR-reviewed like code).
+write_manifest :: proc(demo_name: string, demo: ^Demo, catalog_hash: u64, logic_hz: i32,
+                       hashes: []u64) {
+	sb := strings.builder_make(context.temp_allocator)
+	strings.write_string(&sb, "# t1 manifest — per-tick FNV-1a-64 state hashes (full sim state)\n")
+	fmt.sbprintf(&sb, "t1 1\ndemo %s\nseed %d\nlogic_hz %d\ncatalog_hash %016x\nticks %d\n",
+		demo_name, demo.seed, logic_hz, catalog_hash, len(hashes))
+	for h, i in hashes {
+		fmt.sbprintf(&sb, "%d %016x\n", i+1, h)
+	}
+	write_file(manifest_path(demo_name), transmute([]u8)strings.to_string(sb))
+}
+
+// check_manifest — compare a live run's hashes + header against the blessed
+// golden. Appends a one-line message per failure. Returns true iff green.
+check_manifest :: proc(demo_name: string, demo: ^Demo, catalog_hash: u64, logic_hz: i32,
+                       hashes: []u64, fails: ^[dynamic]string) -> bool {
+	path := manifest_path(demo_name)
+	if !os.exists(path) {
+		append(fails, fmt.tprintf("T1: no manifest at %s (bless with `harness save %s`)",
+			path, demo_name))
+		return false
+	}
+	m, okm := read_manifest(path)
+	if !okm {
+		append(fails, "T1: unreadable manifest")
+		return false
+	}
+	ok := true
+	if m.version != 1 {
+		append(fails, fmt.tprintf("T1: manifest version %d (want 1)", m.version))
+		ok = false
+	}
+	if m.seed != demo.seed {
+		append(fails, fmt.tprintf("T1: seed drift — manifest %d vs demo %d", m.seed, demo.seed))
+		ok = false
+	}
+	if m.catalog_hash != catalog_hash {
+		append(fails, fmt.tprintf("T1: catalog drift — manifest %016x vs current %016x (re-bless deliberately)",
+			m.catalog_hash, catalog_hash))
+		ok = false
+	}
+	if m.logic_hz != i64(logic_hz) {
+		append(fails, fmt.tprintf("T1: logic_hz drift — manifest %d vs current %d", m.logic_hz, logic_hz))
+		ok = false
+	}
+	if m.ticks != i64(len(m.hashes)) {
+		append(fails, fmt.tprintf("T1: manifest corrupt — ticks header %d but %d hash lines",
+			m.ticks, len(m.hashes)))
+		ok = false
+	}
+	if len(m.hashes) != len(hashes) {
+		append(fails, fmt.tprintf("T1: tick count %d vs golden %d", len(hashes), len(m.hashes)))
+		ok = false
+	} else {
+		for i in 0..<len(hashes) {
+			if hashes[i] != m.hashes[i] {
+				append(fails, fmt.tprintf("T1: STATE DIVERGENCE at tick %d: %016x != golden %016x",
+					i+1, hashes[i], m.hashes[i]))
+				ok = false
+				break
+			}
+		}
+	}
+	return ok
+}
diff --git a/harness/run.odin b/harness/run.odin
new file mode 100644
index 0000000..c745190
--- /dev/null
+++ b/harness/run.odin
@@ -0,0 +1,253 @@
+package main
+
+// run.odin — the harness run/replay engine (arch §10, ODN-17). Headless for
+// Story 1.1: no window, no raylib, T1 only. Loads the catalogs (resolving the
+// catalog_hash + logic_hz the replay gate binds to — ODN-11), plays a demo
+// through the real core, records per-tick T1 state hashes, compares to the
+// blessed manifest (run) / blesses it (save), and runs the replay gate (the
+// blessed action log must re-sim the manifest bit-for-bit; catalog/logic_hz
+// drift is a defined rejection).
+
+import "core:encoding/json"
+import "core:fmt"
+import "core:os"
+import pp "../core"
+
+Catalogs :: struct {
+	hash:     u64,
+	logic_hz: i32,
+}
+
+// The subset of data/balance.json the spine parses (ODN-5: JSON single
+// source, integer-only sim values). Other fields ride in catalog_hash.
+Balance_File :: struct {
+	logic_hz: i32,
+}
+
+// load_catalogs — read data/balance.json, FNV-1a-64 its bytes (catalog_hash),
+// parse logic_hz. Core is pure (no file I/O — ODN-1), so the harness resolves
+// both and hands them to run_init.
+load_catalogs :: proc() -> (Catalogs, string) {
+	data, err := os.read_entire_file_from_path("data/balance.json", context.temp_allocator)
+	if err != nil {
+		return {}, fmt.tprintf("cannot read data/balance.json: %v", err)
+	}
+	bal: Balance_File
+	if jerr := json.unmarshal(data, &bal); jerr != nil {
+		return {}, fmt.tprintf("bad data/balance.json: %v", jerr)
+	}
+	if bal.logic_hz <= 0 || bal.logic_hz > 1000 {
+		return {}, fmt.tprintf("logic_hz %d out of range (1..1000)", bal.logic_hz)
+	}
+	return Catalogs{hash = pp.fnv1a64(data), logic_hz = bal.logic_hz}, ""
+}
+
+log_path :: proc(demo: string) -> string {
+	return fmt.tprintf("goldens/%s.log.bin", demo)
+}
+
+// run_demo — play a demo through the real core, record per-tick T1 hashes,
+// compare to the blessed manifest (run) or bless it (save), and run the
+// replay gate (the blessed log must reproduce the manifest bit-for-bit).
+run_demo :: proc(name: string, save: bool) -> bool {
+	path := fmt.tprintf("demos/%s.dem", name)
+	text_bytes, rerr := os.read_entire_file_from_path(path, context.temp_allocator)
+	if rerr != nil {
+		fmt.eprintfln("harness: cannot read %s", path)
+		return false
+	}
+	demo, perr := parse_demo(name, string(text_bytes))
+	if perr != "" {
+		fmt.eprintfln("harness: %s: parse error: %s", path, perr)
+		return false
+	}
+	catalogs, cerr := load_catalogs()
+	if cerr != "" {
+		fmt.eprintfln("harness: %s", cerr)
+		return false
+	}
+
+	state: pp.Run_State
+	defer pp.run_destroy(&state)
+	pp.run_init(&state, demo.seed, catalogs.hash, catalogs.logic_hz)
+
+	ticks := demo_run_ticks(&demo, catalogs.logic_hz)
+	hashes := make([dynamic]u64, 0, ticks)
+	defer delete(hashes)
+	for tick in u64(1)..=ticks {
+		before := len(state.events)
+		// gather this tick's replay commands (empty for boot.dem — no intents)
+		batch := make([dynamic]pp.Command, 0, 4, context.temp_allocator)
+		for cmd in state.action_log {
+			if cmd.apply_tick == tick {
+				append(&batch, cmd)
+			}
+		}
+		pp.step(&state, tick, batch[:])
+		append(&hashes, pp.state_hash(&state, state.events[before:], context.temp_allocator))
+		clear(&state.events)
+		free_all(context.temp_allocator)
+	}
+
+	fails: [dynamic]string
+	defer delete(fails)
+
+	if save {
+		write_manifest(name, &demo, catalogs.hash, catalogs.logic_hz, hashes[:])
+		write_file(log_path(name), pp.log_write(&state, context.temp_allocator))
+		fmt.printf("  save %-20s ticks=%d\n", name, len(hashes))
+		return true
+	}
+
+	check_manifest(name, &demo, catalogs.hash, catalogs.logic_hz, hashes[:], &fails)
+
+	// replay gate: the blessed log must re-sim the live hashes bit-for-bit
+	if len(fails) == 0 {
+		if !os.exists(log_path(name)) {
+			append(&fails, fmt.tprintf("no blessed log at %s (bless with `harness save %s`)",
+				log_path(name), name))
+		} else if !verify_replay(name, &catalogs, hashes[:]) {
+			append(&fails, "replay of the blessed log diverges from the manifest")
+		}
+	}
+	if state.replay_error {
+		append(&fails, "replay_error latched during the run (ODN-11 critical)")
+	}
+
+	if len(fails) == 0 {
+		fmt.printf("  PASS %-20s ticks=%d\n", name, len(hashes))
+		return true
+	}
+	fmt.printf("  FAIL %s\n", name)
+	for m in fails {
+		fmt.printf("    - %s\n", m)
+	}
+	return false
+}
+
+// replay_hashes — re-run from an action log alone. The ODN-11 replay gate:
+// the header's catalog_hash + logic_hz must match the current catalogs (else a
+// defined rejection, never silent divergence), then re-sim tick 1..ticks.
+replay_hashes :: proc(lpath: string, catalogs: ^Catalogs, ticks: u64,
+                       fails: ^[dynamic]string) -> ([dynamic]u64, bool) {
+	out := make([dynamic]u64)
+	data, err := os.read_entire_file_from_path(lpath, context.temp_allocator)
+	if err != nil {
+		append(fails, fmt.tprintf("replay: cannot read %s", lpath))
+		return out, false
+	}
+	header, cmds, ok := pp.log_read(data, context.allocator)
+	if !ok {
+		append(fails, fmt.tprintf("replay: corrupt log %s", lpath))
+		return out, false
+	}
+	defer delete(cmds)
+	if header.catalog_hash != catalogs.hash {
+		append(fails, fmt.tprintf("replay: catalog drift — log %016x vs current %016x (defined rejection, ODN-11)",
+			header.catalog_hash, catalogs.hash))
+		return out, false
+	}
+	if header.logic_hz != catalogs.logic_hz {
+		append(fails, fmt.tprintf("replay: logic_hz drift — log %d vs current %d (defined rejection, ODN-11)",
+			header.logic_hz, catalogs.logic_hz))
+		return out, false
+	}
+
+	state: pp.Run_State
+	defer pp.run_destroy(&state)
+	pp.run_init(&state, header.seed, catalogs.hash, catalogs.logic_hz)
+	for cmd in cmds {
+		append(&state.action_log, cmd)
+	}
+	for tick in u64(1)..=ticks {
+		before := len(state.events)
+		batch := make([dynamic]pp.Command, 0, 4, context.temp_allocator)
+		for cmd in state.action_log {
+			if cmd.apply_tick == tick {
+				append(&batch, cmd)
+			}
+		}
+		pp.step(&state, tick, batch[:])
+		append(&out, pp.state_hash(&state, state.events[before:], context.temp_allocator))
+		clear(&state.events)
+		free_all(context.temp_allocator)
+	}
+	if state.replay_error {
+		append(fails, "replay: replay_error latched (ODN-11 critical)")
+		return out, false
+	}
+	return out, true
+}
+
+// verify_replay — the in-run gate: the blessed log reproduces the live hashes.
+verify_replay :: proc(demo_name: string, catalogs: ^Catalogs, live_hashes: []u64) -> bool {
+	fails := make([dynamic]string, context.temp_allocator)
+	defer delete(fails)
+	replayed, ok := replay_hashes(log_path(demo_name), catalogs, u64(len(live_hashes)), &fails)
+	defer delete(replayed)
+	if !ok {
+		for f in fails {
+			fmt.printf("    - %s\n", f)
+		}
+		return false
+	}
+	if len(replayed) != len(live_hashes) {
+		fmt.printfln("    - replay length %d != manifest %d", len(replayed), len(live_hashes))
+		return false
+	}
+	for i in 0..<len(live_hashes) {
+		if replayed[i] != live_hashes[i] {
+			fmt.printfln("    - replay FIRST DIVERGENCE at tick %d: %016x != %016x",
+				i+1, replayed[i], live_hashes[i])
+			return false
+		}
+	}
+	return true
+}
+
+// run_replay — standalone: `harness replay <demo> <log.bin>`. Manifest-driven,
+// full length; the bit-for-bit ODN-11 check.
+run_replay :: proc(demo_name, lpath: string) -> i32 {
+	catalogs, cerr := load_catalogs()
+	if cerr != "" {
+		fmt.eprintfln("harness replay: %s", cerr)
+		return 2
+	}
+	man, okm := read_manifest(manifest_path(demo_name))
+	if !okm {
+		fmt.eprintfln("harness replay: no manifest for %s (nothing to verify against)", demo_name)
+		return 1
+	}
+	if man.ticks != i64(len(man.hashes)) {
+		fmt.eprintfln("harness replay: manifest corrupt — ticks header %d but %d hash lines",
+			man.ticks, len(man.hashes))
+		return 1
+	}
+	fails := make([dynamic]string, context.temp_allocator)
+	defer delete(fails)
+	replayed, ok := replay_hashes(lpath, &catalogs, u64(man.ticks), &fails)
+	defer delete(replayed)
+	if !ok {
+		for f in fails {
+			fmt.eprintfln("harness replay: %s", f)
+		}
+		return 1
+	}
+	for i in 0..<min(len(replayed), len(man.hashes)) {
+		if replayed[i] != man.hashes[i] {
+			fmt.eprintfln("harness replay: FIRST DIVERGENCE at tick %d: %016x != golden %016x",
+				i+1, replayed[i], man.hashes[i])
+			return 1
+		}
+	}
+	fmt.printf("harness replay: %d ticks verified against the manifest — bit-for-bit (ODN-11)\n", man.ticks)
+	return 0
+}
+
+// write_file — os.write_entire_file with the error checked-and-logged (never
+// dropped — §7.1).
+write_file :: proc(path: string, data: []u8) {
+	if err := os.write_entire_file(path, data); err != nil {
+		fmt.eprintfln("harness: write failed %s: %v", path, err)
+	}
+}
