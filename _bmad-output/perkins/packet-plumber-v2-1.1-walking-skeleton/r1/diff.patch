diff --git a/core/determinism_test.odin b/core/determinism_test.odin
new file mode 100644
index 0000000..1be24c3
--- /dev/null
+++ b/core/determinism_test.odin
@@ -0,0 +1,221 @@
+package core
+
+// determinism_test.odin — THE determinism spine (ODN-1/9/10/11; the briefing's
+// ONE hard blocker). Pins:
+//   (a) re-stepping (seed, action_log) twice yields byte-identical state_hash
+//       sequences [E10, ODN-10] — the replay-equality keystone;
+//   (b) the same seed reproduces a run, different seeds / catalogs diverge;
+//   (c) the action log survives the binary round-trip, and corrupt inputs get
+//       the defined rejection (never a crash / silent partial parse) [ODN-11];
+//   (d) FNV-1a-64 (the T1 + catalog hash primitive) matches the conformance
+//       basis — the spine's hashes are the canonical algorithm, not a typo.
+//
+// The spine has no topology yet (story 1.2); step is a heartbeat + command
+// recorder, so the keystone exercises the rng + the applied-command record +
+// the canonical serializer + the binary log end to end — the same plumbing
+// real sim state will ride once Topology lands.
+
+import "core:testing"
+
+// A stable catalog_hash for the test runs (the spine doesn't load real
+// catalogs from disk — core is pure, ODN-1; the harness resolves it). The
+// value just has to be consistent within a run so the log/replay binding is
+// exercised identically. A literal avoids a context-requiring proc call at
+// global scope (fnv1a64 is exercised by state_hash + test_fnv1a64_conformance).
+TEST_CATALOG_HASH :: u64(0x0123456789ABCDEF)
+TEST_LOGIC_HZ :: i32(20)
+
+// Step a run from tick 1..ticks, feeding step the commands whose apply_tick
+// == tick (the pinned replay convention: apply all log entries for tick N
+// BEFORE stepping N — §11.1). Records the per-tick state hash. The same proc
+// serves live + replay (the spine has no edit fast-path yet; story 1.2 adds
+// the bus). Drains the tick's events into the hash (ODN-14).
+record_run :: proc(state: ^Run_State, ticks: u64, allocator := context.allocator) -> [dynamic]u64 {
+	hashes := make([dynamic]u64, 0, ticks, allocator)
+	for tick in u64(1)..=ticks {
+		before := len(state.events)
+		batch := make([dynamic]Command, 0, 4, context.temp_allocator)
+		for cmd in state.action_log {
+			if cmd.apply_tick == tick {
+				append(&batch, cmd)
+			}
+		}
+		step(state, tick, batch[:])
+		h := state_hash(state, state.events[before:], context.temp_allocator)
+		append(&hashes, h)
+		clear(&state.events)
+		free_all(context.temp_allocator)
+	}
+	return hashes
+}
+
+// Deep-copy an action log so the replayed run owns its own backing store
+// (avoids a shared-array double-free between the live + replayed runs).
+clone_log :: proc(src: [dynamic]Command, allocator := context.allocator) -> [dynamic]Command {
+	out := make([dynamic]Command, 0, len(src), allocator)
+	for cmd in src {
+		append(&out, cmd)
+	}
+	return out
+}
+
+@(test)
+test_fnv1a64_conformance :: proc(t: ^testing.T) {
+	// empty input = the FNV-1a-64 offset basis (the canonical conformance value)
+	testing.expect_value(t, fnv1a64([]u8{}), FNV64_OFFSET) // empty input == the offset basis
+	// deterministic + nonzero
+	testing.expect(t, fnv1a64([]u8{'p', 'p'}) == fnv1a64([]u8{'p', 'p'}), "fnv1a64 must be deterministic")
+	testing.expect(t, fnv1a64([]u8{'p', 'p'}) != 0, "fnv1a64(pp) must be nonzero")
+	// byte order matters (a hash, not a commutative sum)
+	testing.expect(t, fnv1a64([]u8{'a', 'b'}) != fnv1a64([]u8{'b', 'a'}), "fnv1a64 must be order-sensitive")
+}
+
+@(test)
+test_replay_byte_identical :: proc(t: ^testing.T) {
+	live: Run_State
+	defer {
+		run_destroy(&live)
+	}
+	run_init(&live, 42, TEST_CATALOG_HASH, TEST_LOGIC_HZ)
+
+	// inject a command-built action log (simulating the Command_Bus, story 1.2)
+	append(&live.action_log, Command{apply_tick = 1, kind = Cmd_Set_Arg{arg = 7}})
+	append(&live.action_log, Command{apply_tick = 50, kind = Cmd_Set_Arg{arg = 99}})
+	append(&live.action_log, Command{apply_tick = 200, kind = Cmd_Set_Arg{arg = 3}})
+
+	live_hashes := record_run(&live, 300)
+	defer delete(live_hashes)
+
+	// sanity: the keystone must be command-built + the rng heartbeat must
+	// actually advance state (a vacuous keystone would pass while broken)
+	testing.expectf(t, len(live.applied) == 3, "keystone must apply 3 commands, applied %d", len(live.applied))
+	testing.expectf(t, len(live_hashes) == 300, "expected 300 hashes, got %d", len(live_hashes))
+	testing.expect(t, live_hashes[0] != live_hashes[1], "per-tick hashes must vary (rng heartbeat)")
+
+	// replay: fresh run, same seed, the SAME action-log artifact (ODN-11)
+	replayed: Run_State
+	defer {
+		run_destroy(&replayed)
+	}
+	run_init(&replayed, 42, TEST_CATALOG_HASH, TEST_LOGIC_HZ)
+	delete(replayed.action_log) // run_init's empty log — replaced by the clone
+	replayed.action_log = clone_log(live.action_log)
+	replay_hashes := record_run(&replayed, 300)
+	defer delete(replay_hashes)
+
+	testing.expect(t, !replayed.replay_error, "replay must not latch replay_error (ODN-11 critical)")
+	testing.expectf(t, len(live_hashes) == len(replay_hashes),
+		"tick count mismatch: live %d vs replay %d", len(live_hashes), len(replay_hashes))
+	diverged := false
+	for i in 0..<len(live_hashes) {
+		if live_hashes[i] != replay_hashes[i] {
+			diverged = true
+		}
+	}
+	testing.expectf(t, !diverged, "REPLAY DIVERGENCE: live vs replay hashes differ")
+}
+
+@(test)
+test_seed_reproduces_and_diverges :: proc(t: ^testing.T) {
+	a: Run_State
+	defer {
+		run_destroy(&a)
+	}
+	run_init(&a, 99, TEST_CATALOG_HASH, TEST_LOGIC_HZ)
+	ha := record_run(&a, 300)
+	defer delete(ha)
+
+	b: Run_State
+	defer {
+		run_destroy(&b)
+	}
+	run_init(&b, 99, TEST_CATALOG_HASH, TEST_LOGIC_HZ)
+	hb := record_run(&b, 300)
+	defer delete(hb)
+	same := true
+	for i in 0..<len(ha) {
+		if ha[i] != hb[i] {
+			same = false
+		}
+	}
+	testing.expect(t, same, "same seed must reproduce the hash sequence")
+
+	// a different seed must NOT reproduce the same sequence
+	c: Run_State
+	defer {
+		run_destroy(&c)
+	}
+	run_init(&c, 100, TEST_CATALOG_HASH, TEST_LOGIC_HZ)
+	hc := record_run(&c, 300)
+	defer delete(hc)
+	diff_seed := true
+	for i in 0..<len(ha) {
+		if ha[i] == hc[i] {
+			diff_seed = false
+		}
+	}
+	testing.expect(t, diff_seed, "different seeds must diverge")
+
+	// a different catalog_hash must diverge (the replay gate's binding is real)
+	d: Run_State
+	defer {
+		run_destroy(&d)
+	}
+	run_init(&d, 99, TEST_CATALOG_HASH + 1, TEST_LOGIC_HZ)
+	hd := record_run(&d, 300)
+	defer delete(hd)
+	diff_cat := true
+	for i in 0..<len(ha) {
+		if ha[i] == hd[i] {
+			diff_cat = false
+		}
+	}
+	testing.expect(t, diff_cat, "different catalog_hash must diverge")
+}
+
+@(test)
+test_action_log_binary_roundtrip :: proc(t: ^testing.T) {
+	state: Run_State
+	defer {
+		run_destroy(&state)
+	}
+	run_init(&state, 42, TEST_CATALOG_HASH, TEST_LOGIC_HZ)
+	append(&state.action_log, Command{apply_tick = 1, kind = Cmd_Set_Arg{arg = 7}})
+	append(&state.action_log, Command{apply_tick = 50, kind = Cmd_Set_Arg{arg = 99}})
+
+	bytes := log_write(&state, context.temp_allocator)
+
+	// clean round-trip: header + commands survive byte-for-byte-semantically
+	header, cmds, ok := log_read(bytes, context.temp_allocator)
+	testing.expect(t, ok, "round-trip must parse")
+	testing.expectf(t, header.seed == 42, "header seed: got %d, want 42", header.seed)
+	testing.expect(t, header.catalog_hash == TEST_CATALOG_HASH, "header catalog_hash mismatch")
+	testing.expect(t, header.logic_hz == TEST_LOGIC_HZ, "header logic_hz mismatch")
+	testing.expectf(t, len(cmds) == len(state.action_log),
+		"command count: got %d, want %d", len(cmds), len(state.action_log))
+	for i in 0..<len(cmds) {
+		testing.expectf(t, cmds[i].apply_tick == state.action_log[i].apply_tick,
+			"cmd %d apply_tick mismatch", i)
+		ca := cmds[i].kind.(Cmd_Set_Arg)
+		cb := state.action_log[i].kind.(Cmd_Set_Arg)
+		testing.expectf(t, ca.arg == cb.arg, "cmd %d arg mismatch: %d != %d", i, ca.arg, cb.arg)
+	}
+
+	// defined rejections — never a silent partial parse or a crash (ODN-11)
+	_, _, truncated := log_read(bytes[:len(bytes)-1], context.temp_allocator)
+	testing.expect(t, !truncated, "truncated log must reject")
+	_, _, header_only := log_read(bytes[:8], context.temp_allocator)
+	testing.expect(t, !header_only, "header-only log must reject")
+	garbage := make([]u8, 64, context.temp_allocator)
+	_, _, bad := log_read(garbage, context.temp_allocator)
+	testing.expect(t, !bad, "garbage must reject")
+	_, _, partial_magic := log_read(bytes[:4], context.temp_allocator)
+	testing.expect(t, !partial_magic, "partial magic must reject")
+	// future version field must reject
+	fut := make([]u8, len(bytes), context.temp_allocator)
+	copy(fut, bytes)
+	fut[4] = 99 // bump the version field (second u32, little-endian)
+	fut[5], fut[6], fut[7] = 0, 0, 0
+	_, _, future := log_read(fut, context.temp_allocator)
+	testing.expect(t, !future, "unknown version must reject")
+}
diff --git a/core/hash.odin b/core/hash.odin
new file mode 100644
index 0000000..c746502
--- /dev/null
+++ b/core/hash.odin
@@ -0,0 +1,19 @@
+package core
+
+// hash.odin — FNV-1a-64, the T1 state-hash + catalog-hash primitive. The T1
+// golden (arch §10.2) is the FNV-1a-64 of the canonical serialized sim state
+// (serialize.odin); the catalog_hash (ODN-11, in the save header + every
+// golden manifest) is the FNV-1a-64 of the exact catalog bytes in force.
+// Pinned constants; identical on every target (the spine, ODN-10).
+
+FNV64_OFFSET :: u64(0xcbf29ce484222325) // FNV-1a 64-bit offset basis
+FNV64_PRIME :: u64(0x100000001b3)        // FNV-1a 64-bit prime
+
+fnv1a64 :: proc(data: []u8) -> u64 {
+	h := FNV64_OFFSET
+	for b in data {
+		h ~= u64(b)
+		h *= FNV64_PRIME
+	}
+	return h
+}
diff --git a/core/rng.odin b/core/rng.odin
new file mode 100644
index 0000000..d44a06a
--- /dev/null
+++ b/core/rng.odin
@@ -0,0 +1,70 @@
+package core
+
+// rng.odin — the owned PRNG (ODN-9). PCG32 XSH-RR (64-bit state, 32-bit
+// output) with seed expansion via splitmix64. Explicit integer code; the
+// algorithm's constants are written in the source (the canonical
+// pcg-random.org PCG32 XSH-RR). NOT core:math/rand — the stdlib
+// implementation may drift between Odin releases, and the determinism
+// guarantee must not depend on the toolchain's internals.
+//
+// Seed expansion: splitmix64 expands a single u64 seed into the PCG state +
+// an odd stream selector (three splitmix64 draws), then two PCG advances mix
+// before the first user output. This is the reference seeding the pinned
+// vectors in rng_test.odin were generated against; any future port (server
+// validator, wasm) must reproduce it — this IS the cross-language determinism
+// conformance test (arch REVIEW m6, resolved by ODN-1/9/10).
+
+Rng :: struct {
+	state: u64,
+	inc:   u64, // odd (the PCG stream selector)
+}
+
+// PCG32 constants (pcg-random.org, pinned in source).
+PCG32_MULT :: u64(6364136223846793005)
+
+// splitmix64 constants (SplitMix64 / David Stafford's Mix13), pinned.
+SPLITMIX_DELTA :: u64(0x9E3779B97F4A7C15)
+SPLITMIX_GAMMA1 :: u64(0xBF58476D1CE4E5B9)
+SPLITMIX_GAMMA2 :: u64(0x94D049BB133111EB)
+
+// splitmix64 — advances s by the golden-ratio delta, returns the mixed value.
+// Pure w.r.t. everything except the ^u64 it mutates (the determinism
+// finalizer reused for fresh-seed expansion and — later — the ECMP hash).
+splitmix64 :: proc(s: ^u64) -> u64 {
+	s^ += SPLITMIX_DELTA
+	z := s^
+	z = (z ~ (z >> 30)) * SPLITMIX_GAMMA1
+	z = (z ~ (z >> 27)) * SPLITMIX_GAMMA2
+	return z ~ (z >> 31)
+}
+
+// Seed the PRNG from a single u64. splitmix64 expands the seed into the PCG
+// state + an odd stream selector; two PCG advances mix the state before the
+// first output. Same seed → identical stream (the determinism keystone).
+rng_seed :: proc(r: ^Rng, seed: u64) {
+	s := seed
+	r.state = splitmix64(&s)
+	r.inc = (splitmix64(&s) | 1) // inc must be odd
+	rng_next(r)                  // first mix advance
+	r.state += splitmix64(&s)
+	rng_next(r)                  // second mix advance
+}
+
+// pcg32 XSH-RR: the output is a function of the OLD state, then the state
+// advances. Constants + shift counts pinned to the canonical reference.
+rng_next :: proc(r: ^Rng) -> u32 {
+	old := r.state
+	r.state = old * PCG32_MULT + r.inc
+	xorshifted := u32(((old >> 18) ~ old) >> 27)
+	rot := u32(old >> 59)
+	return (xorshifted >> rot) | (xorshifted << ((-rot) & 31))
+}
+
+// Bounded draw in [lo, hi] INCLUSIVE. Multiply-shift (Lemire) instead of
+// modulo: bias is < 2^-32 and the draw is a single multiply. Callers pass
+// span-ordered (lo <= hi) bounds; a degenerate span returns lo.
+rng_range :: proc(r: ^Rng, lo, hi: i32) -> i32 {
+	if hi <= lo do return lo
+	span := u64(u32(hi - lo)) + 1
+	return lo + i32((u64(rng_next(r)) * span) >> 32)
+}
diff --git a/core/rng_test.odin b/core/rng_test.odin
new file mode 100644
index 0000000..2a91cbc
--- /dev/null
+++ b/core/rng_test.odin
@@ -0,0 +1,76 @@
+package core
+
+// rng_test.odin — the pinned PRNG conformance vectors (ODN-9). Generated from
+// the canonical PCG32 XSH-RR + splitmix64 seed expansion implemented in
+// rng.odin (constants in source). Any future port (server validator, wasm,
+// leaderboard re-sim) MUST reproduce these — this IS the cross-language
+// determinism contract (arch REVIEW m6, resolved by ODN-1/9/10).
+
+import "core:testing"
+
+@(test)
+test_rng_pinned_vectors :: proc(t: ^testing.T) {
+	r: Rng
+	rng_seed(&r, 0)
+	expected := [8]u32{2196338726, 1832588393, 3253730937, 2647056997,
+	                   2191141068, 1480505347, 3030956019, 209995402}
+	for e, i in expected {
+		got := rng_next(&r)
+		testing.expectf(t, got == e, "seed 0 output %d: got %d, want %d", i, got, e)
+	}
+}
+
+@(test)
+test_rng_seed42_pinned :: proc(t: ^testing.T) {
+	r: Rng
+	rng_seed(&r, 42)
+	expected := [4]u32{2399007886, 4293122540, 1743717038, 2217374311}
+	for e, i in expected {
+		got := rng_next(&r)
+		testing.expectf(t, got == e, "seed 42 output %d: got %d, want %d", i, got, e)
+	}
+}
+
+@(test)
+test_rng_range_bounds :: proc(t: ^testing.T) {
+	r: Rng
+	rng_seed(&r, 7)
+	ok := true
+	for _ in 0..<10000 {
+		v := rng_range(&r, 6, 34)
+		if v < 6 || v > 34 {
+			ok = false
+		}
+	}
+	testing.expect(t, ok, "rng_range must stay in [6,34]")
+	// degenerate / inverted span returns lo (the bias-avoidance note, ODN-9)
+	testing.expect(t, rng_range(&r, 5, 5) == 5, "degenerate span must return lo")
+	testing.expect(t, rng_range(&r, 9, 3) == 9, "inverted span must return lo")
+}
+
+@(test)
+test_rng_streams_independent :: proc(t: ^testing.T) {
+	// same seed => identical stream (the determinism keystone)
+	a, b: Rng
+	rng_seed(&a, 1337)
+	rng_seed(&b, 1337)
+	ok := true
+	for _ in 0..<100 {
+		if rng_next(&a) != rng_next(&b) {
+			ok = false
+		}
+	}
+	testing.expect(t, ok, "same seed must reproduce the stream")
+
+	// different seeds must diverge (no correlated streams)
+	c, d: Rng
+	rng_seed(&c, 1)
+	rng_seed(&d, 2)
+	same := true
+	for _ in 0..<16 {
+		if rng_next(&c) != rng_next(&d) {
+			same = false
+		}
+	}
+	testing.expect(t, !same, "different seeds must diverge")
+}
