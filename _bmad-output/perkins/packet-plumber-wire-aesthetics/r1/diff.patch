+++ b/app/render/wire_path_test.odin
@@ -0,0 +1,324 @@
+package render
+
+// wire_path_test.odin — Story 7.5's durable pins (the briefing's load-bearing
+// guards): (a) COST IMMUNITY — pipe cost is the LOGICAL straight geometry
+// (`pipe_span × cost_per_tile`), NEVER the drawn detour: the path module must
+// not change any topology value the cost reads, and the drawn-path length must
+// be able to differ from the logical length without touching cost; (b)
+// DETERMINISM — the same (topology, view) yields byte-identical paths (no RNG,
+// no seed, no map dependence); (c) DEGRADATION — a detour longer than the
+// straight line × WIRE_DETOUR_MAX_LEN_RATIO falls back to straight; (d) JUNCTION
+// SHAPING — n incident pipes get n even-spread anchors around the puck (n=4 →
+// 90° steps), and a count>1 bundle's ribbon fans into member anchors.
+//
+// Run: odin test app/render   (links the stock raylib; these tests never touch
+// rl — pure math over the path module; the golden T1/replay byte-identity is
+// the harness run itself, gate 4).
+
+import "core:testing"
+import rl "vendor:raylib"
+import pp "../../core"
+
+// wire_test_logic_hz — the render-test logic rate (mirrors core's constant).
+wire_test_logic_hz :: i32(20)
+
+// test_view — a minimal View for the path math (mirrors the harness render
+// setup: 26px tiles, 40×30 world, sprites absent → the primitive radii).
+test_view :: proc(v: ^View, cat: ^pp.Catalogs) {
+	v^ = {}
+	v.catalogs = cat
+	v.tile_px = 26.0
+	v.world_w = 40 * 26.0
+	v.world_h = 30 * 26.0
+	v.scale = 1.0
+	v.off_x = 0
+	v.off_y = 0
+	v.sprites.ok = false
+}
+
+// wire_test_catalog — a minimal catalog for the path tests (mirrors core's
+// test_catalog values: the tiers narrow/standard/wide + residential/host/
+// router_basic; core test helpers are test-only, so the render package builds
+// its own — the RENDER tests pin RENDER math, never the sim catalog contract).
+wire_test_catalog :: proc(cat: ^pp.Catalogs, allocator := context.allocator) {
+	cat^ = {}
+	cat.hash = 0x0BAD5EEDCAFE1234
+	cat.node_types = make([dynamic]pp.Node_Type, 0, 8, allocator)
+	append(&cat.node_types, pp.Node_Type{id = "residential", display = "Residential", kind = .Terminal, terminal_role = .Residential, throughput_units = 5, port_capacity = 0, demand_weight = 1, era_introduced = 1})
+	append(&cat.node_types, pp.Node_Type{id = "content_host", display = "Content Host", kind = .Terminal, terminal_role = .Content_Host, throughput_units = 80, port_capacity = 0, demand_weight = 1, era_introduced = 3})
+	append(&cat.node_types, pp.Node_Type{id = "router_basic", display = "Basic Router", kind = .Junction, terminal_role = .None, throughput_units = 40, port_capacity = 4, era_introduced = 1})
+	append(&cat.node_types, pp.Node_Type{id = "router_mid", display = "Mid Router", kind = .Junction, terminal_role = .None, throughput_units = 80, port_capacity = 8, era_introduced = 3})
+	append(&cat.node_types, pp.Node_Type{id = "router_high", display = "High Router", kind = .Junction, terminal_role = .None, throughput_units = 160, port_capacity = 16, era_introduced = 3})
+	cat.pipe_tiers = make([dynamic]pp.Pipe_Tier, 0, 8, allocator)
+	append(&cat.pipe_tiers, pp.Pipe_Tier{id = "narrow", display = "Narrow Copper", capacity_units = 10, cost = 20, clean_span = 8, max_span = 10, cost_per_tile = 5, era_introduced = 1})
+	append(&cat.pipe_tiers, pp.Pipe_Tier{id = "standard", display = "Standard Line", capacity_units = 15, cost = 10, clean_span = 10, max_span = 14, cost_per_tile = 12, era_introduced = 1})
+	append(&cat.pipe_tiers, pp.Pipe_Tier{id = "wide", display = "Wide Fiber", capacity_units = 40, cost = 5, clean_span = 14, max_span = 18, cost_per_tile = 30, era_introduced = 3})
+	cat.balance = pp.Balance{logic_hz = wire_test_logic_hz, max_ticks = 100000, snap_radius = 36, map_w_tiles = 40, map_h_tiles = 30, tile_px = 26, packet_bandwidth = 30}
+	cat.balance.placement = pp.Placement_Balance{router_router_sep_tiles = 4, router_terminal_sep_tiles = 2}
+	// 3.2: the lane presets the draw path needs (topology_apply_edit writes
+	// pipe_weights from the default preset — mirrors core's test_catalog)
+	cat.balance.lane_presets = make([dynamic]pp.Lane_Preset, 0, 4, allocator)
+	append(&cat.balance.lane_presets, pp.Lane_Preset{id = "balanced", display = "Balanced", weights = {1, 1, 1}})
+	cat.balance.default_preset_idx = 0
+}
+
+// wire_setup — a fresh run with a compact 4-pipe router + one stub terminal,
+// drawn at tiers that fit the test geometry.
+wire_setup :: proc(cat: ^pp.Catalogs) -> pp.Run_State {
+	s: pp.Run_State
+	pp.run_init(&s, 99, cat.hash, wire_test_logic_hz)
+	rt_idx, _ := pp.node_type_index(cat, "router_mid") // 8 ports (the 6-pipe fan fits)
+	res_idx, _ := pp.node_type_index(cat, "residential")
+	host_idx, _ := pp.node_type_index(cat, "content_host")
+	rt := pp.topology_spawn_node(&s.topology, rt_idx, {10, 10}, cat) // id 0
+	// four incident pipes, 90° apart around the router (the ✕/＋ read)
+	n1 := pp.topology_spawn_node(&s.topology, res_idx, {10, 2}, cat)   // id 1 north
+	n2 := pp.topology_spawn_node(&s.topology, host_idx, {20, 10}, cat) // id 2 east
+	n3 := pp.topology_spawn_node(&s.topology, res_idx, {10, 18}, cat)  // id 3 south
+	n4 := pp.topology_spawn_node(&s.topology, host_idx, {2, 10}, cat)  // id 4 west
+	pp.topology_apply_edit(&s.topology, pp.Command{kind = pp.Cmd_Draw_Pipe{a = rt, b = n1, tier = 0}}, cat)
+	pp.topology_apply_edit(&s.topology, pp.Command{kind = pp.Cmd_Draw_Pipe{a = rt, b = n2, tier = 1}}, cat)
+	pp.topology_apply_edit(&s.topology, pp.Command{kind = pp.Cmd_Draw_Pipe{a = rt, b = n3, tier = 0}}, cat)
+	pp.topology_apply_edit(&s.topology, pp.Command{kind = pp.Cmd_Draw_Pipe{a = rt, b = n4, tier = 1}}, cat)
+	// a parallel-pipe bundle between the router and a host at (18,16): span
+	// sqrt(8²+6²)=10 tiles — legal for every tier (wide max_span 18)
+	host := pp.topology_spawn_node(&s.topology, host_idx, {18, 16}, cat) // id 5
+	pp.topology_apply_edit(&s.topology, pp.Command{kind = pp.Cmd_Draw_Pipe{a = rt, b = host, tier = 2}}, cat)
+	pp.topology_apply_edit(&s.topology, pp.Command{kind = pp.Cmd_Draw_Pipe{a = rt, b = host, tier = 2}}, cat)
+	pp.bundles_rebuild(&s.bundles, &s.topology, cat)
+	return s
+}
+
+// hash_topology — an FNV-ish fold of the topology's cost-relevant values (the
+// logical spans + node positions). NOT the sim hash (the view can't compute
+// that without events) — this is the cost-immunity SURFACE: if the path module
+// ever touched anything the cost reads, this fold changes.
+hash_topology :: proc(topo: ^pp.Topology) -> u64 {
+	h: u64 = 1469598103934665603
+	for i in 0..<len(topo.pipe_alive) {
+		if !topo.pipe_alive[i] {
+			h = h * 1099511628211 + u64(i)
+			continue
+		}
+		h = h * 1099511628211 + u64(topo.pipe_span[i])
+		h = h * 1099511628211 + u64(topo.pipe_a[i])
+		h = h * 1099511628211 + u64(topo.pipe_b[i])
+		h = h * 1099511628211 + u64(topo.pipe_tier[i])
+	}
+	return h
+}
+
+// --- (a) cost immunity --------------------------------------------------------
+
+@(test)
+test_cost_immunity_logical_span :: proc(t: ^testing.T) {
+	cat: pp.Catalogs
+	wire_test_catalog(&cat, context.temp_allocator)
+	defer pp.catalogs_destroy(&cat)
+	s := wire_setup(&cat)
+	defer pp.run_destroy(&s)
+	v: View
+	test_view(&v, &cat)
+
+	// the logical cost surface BEFORE any path math
+	before := hash_topology(&s.topology)
+
+	// compute every bundle's drawn path (routing ON)
+	paths := wire_paths_compute(&v, &s.topology, &s.bundles)
+	_ = paths
+
+	// the logical cost surface is UNCHANGED — the view never writes cost state
+	after := hash_topology(&s.topology)
+	testing.expectf(t, before == after,
+		"COST IMMUNITY VIOLATION: computing wire paths changed the topology cost surface (%d -> %d)",
+		before, after)
+}
+
+@(test)
+test_cost_stays_on_logical_length :: proc(t: ^testing.T) {
+	cat: pp.Catalogs
+	wire_test_catalog(&cat, context.temp_allocator)
+	defer pp.catalogs_destroy(&cat)
+	s := wire_setup(&cat)
+	defer pp.run_destroy(&s)
+
+	// the drawn path may be LONGER than the logical segment (a detour), but the
+	// player's cost is the logical span × tier (core's draw_cost). Find the
+	// 2-member (rt=0, host=5) bundle — pipes 4+5 — then assert the cost
+	// contract on the LOGICAL span (never the drawn path).
+	bi, bok := pp.bundles_slot_for_pair(&s.bundles, 0, 5)
+	testing.expectf(t, bok && s.bundles.bundle_count[bi] == 2, "2-member bundle (0,5) missing (count=%d)", s.bundles.bundle_count[bi])
+	if !bok {
+		return
+	}
+	los, lok := pp.node_slot(&s.topology, s.bundles.bundle_lo[bi])
+	his, hok := pp.node_slot(&s.topology, s.bundles.bundle_hi[bi])
+	testing.expectf(t, lok && hok, "setup: bundle endpoints missing")
+	if !lok || !hok {
+		return
+	}
+	a := node_world(&s.topology, los, 26.0)
+	b := node_world(&s.topology, his, 26.0)
+	logical := straight_len(a, b)
+	testing.expectf(t, logical > 0, "logical span must be > 0")
+	// the LOGICAL span, in tiles, is what the cost formula reads (span ×
+	// cost_per_tile — the ONLY cost, never a function of the drawn detour).
+	// The expected value uses core's OWN integer span (round-half-up), so the
+	// pin tracks the real cost contract, not a re-derived float.
+	logical_span := pp.span_between(s.topology.node_pos[los], s.topology.node_pos[his])
+	expected := logical_span * cat.pipe_tiers[s.bundles.bundle_tier[bi]].cost_per_tile
+	actual := pp.draw_cost(s.topology.pipe_span[4], s.bundles.bundle_tier[bi], &cat)
+	testing.expectf(t, actual == expected,
+		"draw_cost on the LOGICAL span must be span*tier: got %d want %d", actual, expected)
+	_ = b
+}
+
+// --- (b) determinism ---------------------------------------------------------
+
+@(test)
+test_path_determinism :: proc(t: ^testing.T) {
+	cat: pp.Catalogs
+	wire_test_catalog(&cat, context.temp_allocator)
+	defer pp.catalogs_destroy(&cat)
+	s := wire_setup(&cat)
+	defer pp.run_destroy(&s)
+	v: View
+	test_view(&v, &cat)
+
+	paths1 := wire_paths_compute(&v, &s.topology, &s.bundles)
+	paths2 := wire_paths_compute(&v, &s.topology, &s.bundles)
+	testing.expectf(t, len(paths1) == len(paths2), "path count differs between runs")
+	for i in 0..<len(paths1) {
+		p1 := paths1[i]
+		p2 := paths2[i]
+		testing.expectf(t, p1.n == p2.n, "path %d point count differs (%d vs %d)", i, p1.n, p2.n)
+		for k in 0..<p1.n {
+			testing.expectf(t, p1.pts[k] == p2.pts[k],
+				"path %d point %d differs (%v vs %v) - determinism violated", i, k, p1.pts[k], p2.pts[k])
+		}
+	}
+}
+
+// --- (c) degradation ---------------------------------------------------------
+
+@(test)
+test_degradation_straight_fallback :: proc(t: ^testing.T) {
+	cat: pp.Catalogs
+	wire_test_catalog(&cat, context.temp_allocator)
+	defer pp.catalogs_destroy(&cat)
+	s := wire_setup(&cat)
+	defer pp.run_destroy(&s)
+	v: View
+	test_view(&v, &cat)
+
+	// the (rt=0, host=5) 2-member wide bundle: compute its path and assert the
+	// path is valid + bounded regardless of what the routing decides — the
+	// degradation guard guarantees the router never zigzags into absurdity.
+	bi, ok := pp.bundles_slot_for_pair(&s.bundles, 0, 5)
+	testing.expectf(t, ok, "bundle (rt,host) missing")
+	if !ok {
+		return
+	}
+	band := band_world(&v, s.bundles.bundle_tier[bi], int(s.bundles.bundle_count[bi]))
+	p := wire_path_compute(&v, &s.topology, &s.bundles, bi, band)
+	// whatever the routing decided, the path must be valid + bounded
+	testing.expectf(t, p.n >= 2 && p.n <= MAX_WIRE_POINTS, "path n=%d out of bounds", p.n)
+	// the LOGICAL length is still the reference — never zero
+	los, _ := pp.node_slot(&s.topology, s.bundles.bundle_lo[bi])
+	his, _ := pp.node_slot(&s.topology, s.bundles.bundle_hi[bi])
+	logical := straight_len(node_world(&s.topology, los, 26.0), node_world(&s.topology, his, 26.0))
+	testing.expectf(t, logical > 0, "logical length must be > 0")
+	// the DEGRADATION contract: a drawn path may never exceed straight × ratio
+	// (either it detours within budget or it falls back to straight)
+	if p.n > 2 {
+		drawn := path_len(&p)
+		testing.expectf(t, drawn <= logical * WIRE_DETOUR_MAX_LEN_RATIO + 0.01,
+			"detour too long: drawn %.1f vs logical %.1f (ratio %.2f)",
+			drawn, logical, drawn / logical)
+	}
+}
+
+// --- (d) junction shaping ----------------------------------------------------
+
+@(test)
+test_anchor_even_spread :: proc(t: ^testing.T) {
+	cat: pp.Catalogs
+	wire_test_catalog(&cat, context.temp_allocator)
+	defer pp.catalogs_destroy(&cat)
+	s := wire_setup(&cat)
+	defer pp.run_destroy(&s)
+	v: View
+	test_view(&v, &cat)
+
+	// the router at (10,10) has 4 incident pipes (north/east/south/west) + the
+	// 2-member bundle to (26,26) = 6 incident pipes total → 6 even anchors.
+	rs, ok := pp.node_slot(&s.topology, 0)
+	testing.expectf(t, ok, "router missing")
+	if !ok {
+		return
+	}
+	inc := router_incidents(&s.topology, rs, 26.0)
+	testing.expectf(t, len(inc) == 6, "router incidents = %d, want 6", len(inc))
+	incident_sort(inc[:])
+	// 6 anchors on the 16-gon: adjacent ranks are ~2.67 steps apart — the
+	// spread must be roughly even (each anchor index strictly increasing)
+	base := router_base_index(inc[:])
+	prev := router_anchor_index(base, 0, len(inc))
+	for i in 1..<len(inc) {
+		cur := router_anchor_index(base, i, len(inc))
+		step := (cur - prev + 16) % 16
+		testing.expectf(t, step >= 1 && step <= 4,
+			"anchor spread not even: rank %d step %d (indices %d->%d, n=%d)", i, step, prev, cur, len(inc))
+		prev = cur
+	}
+	// the 4-pipe read: a router with EXACTLY 4 incident pipes gets 90° steps
+	// (the ✕/＋ the briefing demands reads at a glance)
+	inc4 := inc[:4]
+	base4 := router_base_index(inc4)
+	i0 := router_anchor_index(base4, 0, 4)
+	i1 := router_anchor_index(base4, 1, 4)
+	i2 := router_anchor_index(base4, 2, 4)
+	i3 := router_anchor_index(base4, 3, 4)
+	testing.expectf(t, (i1-i0+16)%16 == 4, "n=4 anchor 1 step = %d, want 4 (90 deg)", (i1-i0+16)%16)
+	testing.expectf(t, (i2-i1+16)%16 == 4, "n=4 anchor 2 step = %d, want 4", (i2-i1+16)%16)
+	testing.expectf(t, (i3-i2+16)%16 == 4, "n=4 anchor 3 step = %d, want 4", (i3-i2+16)%16)
+}
+
+@(test)
+test_ribbon_fan_apex :: proc(t: ^testing.T) {
+	cat: pp.Catalogs
+	wire_test_catalog(&cat, context.temp_allocator)
+	defer pp.catalogs_destroy(&cat)
+	s := wire_setup(&cat)
+	defer pp.run_destroy(&s)
+	v: View
+	test_view(&v, &cat)
+
+	// the 2-member bundle (rt,host): its ribbon must FAN — the end apex sits
+	// OUTSIDE the puck rim (pushed out), and the member anchors are TWO
+	// distinct puck-rim points (the fan's feet).
+	bi, ok := pp.bundles_slot_for_pair(&s.bundles, 0, 5)
+	testing.expectf(t, ok, "bundle (rt,host) missing")
+	if !ok {
+		return
+	}
+	band := band_world(&v, s.bundles.bundle_tier[bi], int(s.bundles.bundle_count[bi]))
+	los, _ := pp.node_slot(&s.topology, s.bundles.bundle_lo[bi])
+	his, _ := pp.node_slot(&s.topology, s.bundles.bundle_hi[bi])
+	a := node_world(&s.topology, los, 26.0)
+	b := node_world(&s.topology, his, 26.0)
+	apex_a, anchors_a := end_apex(&v, &s.topology, &s.bundles, bi, 0, b, band)
+	testing.expectf(t, len(anchors_a) == 2, "lo-end fan anchors = %d, want 2", len(anchors_a))
+	if len(anchors_a) == 2 {
+		// the two member anchors are distinct rim points
+		d := rl.Vector2Length(anchors_a[0].pos - anchors_a[1].pos)
+		testing.expectf(t, d > 1.0, "member anchors coincide (fan collapsed), d=%v", d)
+		// the apex is pushed out beyond the puck rim
+		rim := puck_rim_world(&v, 4)
+		rs, _ := pp.node_slot(&s.topology, 8)
+		nw := node_world(&s.topology, rs, 26.0)
+		apex_dist := rl.Vector2Length(apex_a - nw)
+		testing.expectf(t, apex_dist >= rim * 0.9,
+			"fan apex too close to puck center (dist=%v rim=%v) - the fan must clear the rim", apex_dist, rim)
+	}
+}
