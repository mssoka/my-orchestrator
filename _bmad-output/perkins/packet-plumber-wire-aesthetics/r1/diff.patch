diff --git a/app/render/wire_path.odin b/app/render/wire_path.odin
new file mode 100644
index 0000000..13e5a5c
--- /dev/null
+++ b/app/render/wire_path.odin
@@ -0,0 +1,773 @@
+package render
+
+import pp "../../core"
+import rl "vendor:raylib"
+
+// wire_path.odin — Story 7.5: the DRAWN wire path (presentation-only routing +
+// junction shaping). The network LOOKS engineered, not scribbled: each bundle
+// draws along a deterministic polyline that (1) detours around crossings with
+// other pipes (preferring to SLIDE alongside), node/terminal sprites, and the
+// map edge, (2) attaches at router puck-rim anchors allocated evenly around
+// the disc (the 4-pipe ✕/＋ read), and (3) renders parallel-pipe bundles as ONE
+// ribbon that fans open at each end into the member anchors. Everything here
+// is a PURE function of (topology, bundles, view geometry) — no RNG, no seed,
+// no sim mutation (ODN-1: the view never perturbs state). The GRAPH is
+// unchanged: connect/anchor/cap semantics identical; cost stays on the LOGICAL
+// straight segment (`pipe_span × cost_per_tile` — core's draw_cost), never the
+// drawn detour.
+//
+// Determinism: paths are computed in WORLD px (tile units × tile_px, no view
+// scale), so the same map yields the same paths at ANY window size; the view
+// converts to screen at draw time. Obstacles are the OTHER bundles' STRAIGHT
+// logical segments (node centers — a pure function of topology, NOT their own
+// detoured paths), so path order is irrelevant: order-free by construction.
+// All rotation uses the pinned CIRCLE16 table — no transcendentals (§10.4).
+//
+// Degradation: named thresholds WIRE_DETOUR_MAX_LEN_RATIO (a detour longer
+// than straight × ratio is abandoned) and WIRE_DETOUR_MAX_BENDS (the
+// waypoint-insertion cap). Either trips → STRAIGHT — the router never
+// zigzags into absurdity. Terminal stubs (short building drops) skip pipe-
+// crossing detours entirely: crossing is sometimes the RIGHT look.
+
+// WIRE_DETOUR_MAX_LEN_RATIO — a detour longer than this × the straight length
+// is abandoned (the straight crossing reads better than a desperate loop).
+WIRE_DETOUR_MAX_LEN_RATIO :: f32(1.5)
+
+// WIRE_DETOUR_MAX_BENDS — the waypoint-insertion cap (2 waypoints per bend).
+WIRE_DETOUR_MAX_BENDS :: 3
+
+// WIRE_SLIDE_GUTTER — the lateral clearance a sliding detour keeps from the
+// crossed pipe (world px, outside both bands): the "running alongside" gap.
+WIRE_SLIDE_GUTTER :: f32(6.0)
+
+// WIRE_SPRITE_MARGIN — the extra clearance around node/terminal sprites the
+// path must keep (world px).
+WIRE_SPRITE_MARGIN :: f32(3.0)
+
+// WIRE_EDGE_MARGIN — the inset from the world rect the path must stay inside
+// (world px) — "hugging the map edge" is a violation.
+WIRE_EDGE_MARGIN :: f32(14.0)
+
+// WIRE_STUB_TILES — a bundle with a terminal endpoint and a straight span
+// under this many tiles is a "stub": it skips pipe-crossing detours (the
+// crossing is the right look for a short drop) but still avoids sprites/edges.
+WIRE_STUB_TILES :: f32(3.0)
+
+// MAX_WIRE_POINTS — the path polyline capacity (2 endpoints + 2 per bend ×
+// MAX_BENDS). Exceeding it trips the straight fallback (never grows unbounded).
+MAX_WIRE_POINTS :: 2 + 2 * WIRE_DETOUR_MAX_BENDS
+
+// Wire_Path — a deterministic drawn polyline for one bundle, in WORLD px.
+// pts[0] = the lo-end apex, pts[n-1] = the hi-end apex; intermediate points
+// are the detour bends. All consumers (band, lane stripes, riders, halos)
+// walk the SAME polyline so the ribbon read stays consistent.
+Wire_Path :: struct {
+	pts: [MAX_WIRE_POINTS]rl.Vector2,
+	n:   int,
+}
+
+// straight_len — the LOGICAL segment length (world px): the pure A→B geometry
+// the player pays for (core's draw_cost measures pipe_span on this, never the
+// drawn detour). Also the degradation reference length.
+straight_len :: proc(a, b: rl.Vector2) -> f32 {
+	return rl.Vector2Length(b - a)
+}
+
+// path_len — the DRAWN polyline length (world px); compared against
+// straight_len for the degradation ratio.
+path_len :: proc(p: ^Wire_Path) -> f32 {
+	total: f32 = 0
+	for i in 1..<p.n {
+		total += rl.Vector2Length(p.pts[i] - p.pts[i-1])
+	}
+	return total
+}
+
+// --- world-px geometry helpers ----------------------------------------------
+
+// node_world — node slot position in world px (tiles × tile_px; NO view
+// scale/offset — the path is window-independent).
+node_world :: proc(topo: ^pp.Topology, slot: u32, tile_px: f32) -> rl.Vector2 {
+	return {
+		f32(topo.node_pos[slot][0]) * tile_px,
+		f32(topo.node_pos[slot][1]) * tile_px,
+	}
+}
+
+// node_kind_of — node slot kind (Terminal/Junction) with a defensive bound.
+node_kind_of :: proc(topo: ^pp.Topology, slot: u32) -> pp.Node_Kind {
+	if slot >= u32(len(topo.node_kind)) {
+		return .Terminal
+	}
+	return topo.node_kind[slot]
+}
+
+// node_role_of — node slot terminal role (defensive bound; .None for routers).
+node_role_of :: proc(topo: ^pp.Topology, slot: u32) -> pp.Terminal_Role {
+	if slot >= u32(len(topo.node_role)) {
+		return .None
+	}
+	return topo.node_role[slot]
+}
+
+// node_type_of — node slot catalog type index (defensive bound).
+node_type_of :: proc(topo: ^pp.Topology, slot: u32) -> u16 {
+	if slot >= u32(len(topo.node_type)) {
+		return 0
+	}
+	return topo.node_type[slot]
+}
+
+// puck_rim_world — the router puck's RIM radius in world px (where pipe bands
+// attach). Mirrors draw_router/sprite_puck_target — one definition so the
+// anchors sit exactly where the puck edge reads.
+puck_rim_world :: proc(v: ^View, port_capacity: i32) -> f32 {
+	if v.sprites.ok {
+		return sprite_puck_target(v, port_capacity) * 0.5 / max(v.scale, 0.0001)
+	}
+	return v.tile_px * 0.5 * 0.9 * router_tier_scale(port_capacity)
+}
+
+// building_foot_world — a terminal's footprint HALF-WIDTH in world px (where
+// its pipe attaches — the doorstep read; the sprite covers the pipe end).
+building_foot_world :: proc(v: ^View, role: pp.Terminal_Role) -> f32 {
+	t := sprite_house_target(v)
+	#partial switch role {
+	case .Content_Host: t = sprite_host_target(v)
+	case .Small_Biz:    t = sprite_small_biz_target(v)
+	case .Campus:       t = sprite_campus_target(v)
+	}
+	if v.sprites.ok && t > 0 {
+		return t * 0.5 / max(v.scale, 0.0001)
+	}
+	// primitive fallback: the pre-7.1 footprint half-widths
+	#partial switch role {
+	case .Content_Host: return v.tile_px * 0.6
+	case .Small_Biz:    return v.tile_px * 0.55
+	case .Campus:       return v.tile_px * 0.8
+	}
+	return v.tile_px * 0.5
+}
+
+// node_sprite_radius_world — the clearance radius for ANY node as an obstacle
+// (router puck or terminal footprint), world px.
+node_sprite_radius_world :: proc(v: ^View, topo: ^pp.Topology, slot: u32) -> f32 {
+	if node_kind_of(topo, slot) == .Junction {
+		nt := node_type_of(topo, slot)
+		if int(nt) < len(v.catalogs.node_types) {
+			return puck_rim_world(v, v.catalogs.node_types[nt].port_capacity)
+		}
+		return puck_rim_world(v, 4)
+	}
+	return building_foot_world(v, node_role_of(topo, slot))
+}
+
+// --- anchor allocation (the puck-rim spread) --------------------------------
+
+// direction16 — snap a unit vector to the nearest CIRCLE16 entry index
+// (0..15). Dot-product scan, no transcendentals — deterministic.
+direction16 :: proc(dx, dy: f32) -> int {
+	best: int = 0
+	bd: f32 = -1.0
+	circle := CIRCLE16 // local copy — a constant can't be indexed by a runtime index
+	for k in 0..<16 {
+		dot := circle[k][0] * dx + circle[k][1] * dy
+		if dot > bd {
+			bd = dot
+			best = k
+		}
+	}
+	return best
+}
+
+// Incident_Pipe — one live pipe anchored at a router: its direction from the
+// router (world px) + the CIRCLE16 index its direction snaps to.
+Incident_Pipe :: struct {
+	dir:  rl.Vector2, // unit vector router → other endpoint
+	idx:  int,        // direction16 quantized index (0..15)
+	slot: u32,        // pipe slot (deterministic tie-break)
+}
+
+// router_incidents — collect every live pipe touching router node slot `rs`
+// with its direction + quantized index. Insertion order = pipe slot order.
+// Allocation is per-PIPE: parallel members of one bundle each get their own
+// anchor (the ribbon fans into them at each end).
+router_incidents :: proc(topo: ^pp.Topology, rs: u32, tile_px: f32) -> (out: [dynamic]Incident_Pipe) {
+	out = make([dynamic]Incident_Pipe, 0, 8, context.temp_allocator)
+	r := node_world(topo, rs, tile_px)
+	for ps in 0..<len(topo.pipe_alive) {
+		if !topo.pipe_alive[ps] { continue }
+		a_id, b_id := topo.pipe_a[ps], topo.pipe_b[ps]
+		other := b_id
+		if topo.node_id[rs] == b_id {
+			other = a_id
+		} else if topo.node_id[rs] != a_id {
+			continue // not incident to this router
+		}
+		os_, ok := pp.node_slot(topo, other)
+		if !ok { continue }
+		o := node_world(topo, os_, tile_px)
+		d := o - r
+		l := rl.Vector2Length(d)
+		if l <= 0 { continue }
+		u := d / l
+		append(&out, Incident_Pipe{dir = u, idx = direction16(u.x, u.y), slot = u32(ps)})
+	}
+	return
+}
+
+// incident_sort — stable insertion sort by (direction16 index, pipe slot):
+// deterministic, array-only (the incident slice is already ordered by slot —
+// this reorders by angle, ties broken by slot).
+incident_sort :: proc(inc: []Incident_Pipe) {
+	for i in 1..<len(inc) {
+		key := inc[i]
+		j := i
+		for j > 0 && (inc[j-1].idx > key.idx || (inc[j-1].idx == key.idx && inc[j-1].slot > key.slot)) {
+			inc[j] = inc[j-1]
+			j -= 1
+		}
+		inc[j] = key
+	}
+}
+
+// router_base_index — the anchor template's base direction: the MEAN of the
+// incident directions, snapped to the 16-gon (the even spread faces the
+// cluster — deterministic; the ✕/＋ read for n=4 falls out of the rotation).
+router_base_index :: proc(inc: []Incident_Pipe) -> int {
+	mx, my: f32 = 0, 0
+	for i in inc {
+		mx += i.dir.x
+		my += i.dir.y
+	}
+	l := rl.Vector2Length({mx, my})
+	if l <= 0.0001 {
+		return 0 // no/zero incidents (defensive) — anchors at east
+	}
+	return direction16(mx / l, my / l)
+}
+
+// router_anchor_index — pipe `rank`'s anchor index: base + round(rank*16/n)
+// steps around the 16-gon — n=4 → exactly 90° (✕/＋), n=8 → 45°, n=16 → 22.5°.
+router_anchor_index :: proc(base, rank, n: int) -> int {
+	if n <= 1 {
+		return base
+	}
+	return (base + int(f32(rank) * 16.0 / f32(n) + 0.5)) % 16
+}
+
+// Anchor — one pipe's attachment point (world px) + its rim direction index +
+// the member pipe's tier (the fan stub draws at the MEMBER's own tier width,
+// not the pooled band — the "ribbon fans into its pipes" read).
+Anchor :: struct {
+	pos:  rl.Vector2,
+	idx:  int,
+	tier: u16,
+}
+
+// bundle_end_anchors — the member anchors for one bundle end (world px).
+//   lo/terminal end: a single anchor at the building footprint edge toward the
+//     other endpoint (the doorstep; the sprite covers the pipe end).
+//   router end: each member pipe gets its own puck-rim anchor from the
+//     router's incident allocation (the even spread — the fan's foot).
+// `other_world` is the far end's node position (the attach direction for
+// terminals). Returns the member anchors in member order (slot order).
+bundle_end_anchors :: proc(v: ^View, topo: ^pp.Topology, bundles: ^pp.Bundles, bi: u32, end: u32, other_world: rl.Vector2) -> (out: [dynamic]Anchor) {
+	_ = end
+	out = make([dynamic]Anchor, 0, 4, context.temp_allocator)
+	node_slot := u32(0)
+	if end == 0 {
+		node_slot, _ = pp.node_slot(topo, bundles.bundle_lo[bi])
+	} else {
+		node_slot, _ = pp.node_slot(topo, bundles.bundle_hi[bi])
+	}
+	nw := node_world(topo, node_slot, v.tile_px)
+	if node_kind_of(topo, node_slot) != .Junction {
+		// terminal: one anchor at the footprint edge toward the far node
+		d := other_world - nw
+		l := rl.Vector2Length(d)
+		if l <= 0.0001 {
+			d = {1, 0}
+			l = 1
+		}
+		u := d / l
+		foot := building_foot_world(v, node_role_of(topo, node_slot))
+		append(&out, Anchor{pos = nw + u * foot, idx = direction16(u.x, u.y), tier = bundles.bundle_tier[bi]})
+		return
+	}
+	// router: the incident allocation — every member pipe of this bundle that
+	// touches this router gets the puck-rim anchor at its allocated angle.
+	// (The allocation is per-PIPE across ALL incident pipes, so the even spread
+	// covers the whole disc — the ✕/＋ read — and parallel members of ONE
+	// bundle take adjacent ranks, fanning out from the ribbon.)
+	inc := router_incidents(topo, node_slot, v.tile_px)
+	if len(inc) == 0 {
+		append(&out, Anchor{pos = nw, idx = 0})
+		return
+	}
+	incident_sort(inc[:])
+	base := router_base_index(inc[:])
+	nt := node_type_of(topo, node_slot)
+	pc: i32 = 4
+	if int(nt) < len(v.catalogs.node_types) {
+		pc = v.catalogs.node_types[nt].port_capacity
+	}
+	r := puck_rim_world(v, pc)
+	// the incident list is already rank-ordered (sorted by angle, slot tie-
+	// break) — emit the anchors for the members of THIS bundle, in rank order
+	for ri in 0..<len(inc) {
+		ps := inc[ri].slot
+		if int(ps) >= len(bundles.pipe_bundle) || bundles.pipe_bundle[ps] != bi {
+			continue
+		}
+		idx := router_anchor_index(base, ri, len(inc))
+		circle := CIRCLE16 // local copy (constant index rule)
+		mtier: u16 = bundles.bundle_tier[bi]
+		if int(ps) < len(topo.pipe_tier) {
+			mtier = topo.pipe_tier[ps]
+		}
+		append(&out, Anchor{
+			pos = nw + rl.Vector2{circle[idx][0], circle[idx][1]} * r,
+			idx = idx,
+			tier = mtier,
+		})
+	}
+	return
+}
+
+// end_apex — the bundle's ribbon START/END point for one end (world px): the
+// centroid of the member anchors, pushed radially outward to clear the puck
+// rim by the band half-width so the ribbon's visible edge touches the rim.
+// count=1 → exactly the single anchor (no fan).
+end_apex :: proc(v: ^View, topo: ^pp.Topology, bundles: ^pp.Bundles, bi: u32, end: u32, other_world: rl.Vector2, band_w: f32) -> (apex: rl.Vector2, anchors: [dynamic]Anchor) {
+	anchors = bundle_end_anchors(v, topo, bundles, bi, end, other_world)
+	if len(anchors) == 0 {
+		apex = other_world
+		return
+	}
+	if len(anchors) == 1 {
+		apex = anchors[0].pos
+		return
+	}
+	// fan: the centroid of the member anchors, then outward to the rim band
+	cx, cy: f32 = 0, 0
+	for a in anchors {
+		cx += a.pos.x
+		cy += a.pos.y
+	}
+	cx /= f32(len(anchors))
+	cy /= f32(len(anchors))
+	// push outward from the node center to rim + band/2
+	node_slot := u32(0)
+	if end == 0 {
+		node_slot, _ = pp.node_slot(topo, bundles.bundle_lo[bi])
+	} else {
+		node_slot, _ = pp.node_slot(topo, bundles.bundle_hi[bi])
+	}
+	nw := node_world(topo, node_slot, v.tile_px)
+	dc := rl.Vector2{cx - nw.x, cy - nw.y}
+	l := rl.Vector2Length(dc)
+	nt := node_type_of(topo, node_slot)
+	pc: i32 = 4
+	if int(nt) < len(v.catalogs.node_types) {
+		pc = v.catalogs.node_types[nt].port_capacity
+	}
+	r := puck_rim_world(v, pc)
+	target := r + band_w * 0.5
+	if l > 0.0001 {
+		apex = nw + dc / l * target
+	} else {
+		// degenerate centroid (opposite members) — face the far end
+		d := other_world - nw
+		dl := rl.Vector2Length(d)
+		if dl <= 0.0001 {
+			d = {1, 0}
+			dl = 1
+		}
+		apex = nw + d / dl * target
+	}
+	return
+}
+
+// --- obstacle scan + detour --------------------------------------------------
+
+// Obstacle — one path violation (the first in a deterministic scan wins).
+// `clear` is the required lateral clearance (world px) for the detour.
+Obstacle :: struct {
+	kind:     enum { Cross, Sprite, Edge },
+	seg:      int,   // polyline segment index holding the violation
+	t:        f32,   // parameter along that segment (0..1)
+	offset:   rl.Vector2, // unit offset direction for the detour (world px)
+	clear:    f32,   // how far the path must move to clear (world px)
+}
+
+// cross2 — 2D cross product (z). Deterministic IEEE.
+cross2 :: proc(a, b: rl.Vector2) -> f32 {
+	return a.x * b.y - a.y * b.x
+}
+
+// seg_cross — segment (a,b) vs (c,d): intersection point + t on (a,b).
+// Returns ok=false for parallel/non-intersecting (also excludes touching at
+// endpoints — an endpoint touch is a shared puck, not a crossing).
+seg_cross :: proc(a, b, c, d: rl.Vector2) -> (X: rl.Vector2, t: f32, ok: bool) {
+	r := b - a
+	s := d - c
+	den := cross2(r, s)
+	if abs(den) < 0.0001 {
+		return
+	}
+	cp := c - a
+	t = cross2(cp, s) / den
+	u := cross2(cp, r) / den
+	if t < 0.0001 || t > 0.9999 || u < 0.0001 || u > 0.9999 {
+		return
+	}
+	X = a + r * t
+	ok = true
+	return
+}
+
+// point_seg_param — the parameter of the closest point on (a,b) to P (0..1).
+point_seg_param :: proc(a, b, p: rl.Vector2) -> f32 {
+	d := b - a
+	l2 := d.x * d.x + d.y * d.y
+	if l2 <= 0.0001 {
+		return 0
+	}
+	t := ((p.x - a.x) * d.x + (p.y - a.y) * d.y) / l2
+	return max(0, min(1, t))
+}
+
+// scan_obstacles — the first violation of the CURRENT polyline (deterministic
+// order: crossings by other-bundle slot, then world edges, then node sprites
+// by node slot). Obstacles are the other bundles' STRAIGHT logical segments +
+// the inset world rect + node sprite discs. `skip_cross` (terminal stubs)
+// ignores pipe-crossing violations — the crossing is the right look for a
+// short drop, but sprites/edges still bend.
+scan_obstacles :: proc(v: ^View, topo: ^pp.Topology, bundles: ^pp.Bundles, path: ^Wire_Path, bi: u32, band_w: f32, skip_cross: bool) -> (o: Obstacle, found: bool) {
+	segs := max(1, path.n - 1)
+	// 1. crossings with other bundles' straight logical segments (slot order)
+	for j in 0..<int(bundles.n) {
+		if u32(j) == bi { continue }
+		loj, hlj := bundles.bundle_lo[j], bundles.bundle_hi[j]
+		sa, oka := pp.node_slot(topo, loj)
+		sb, okb := pp.node_slot(topo, hlj)
+		if !oka || !okb { continue }
+		c := node_world(topo, sa, v.tile_px)
+		d := node_world(topo, sb, v.tile_px)
+		for k in 0..<path.n - 1 {
+			a := path.pts[k]
+			b := path.pts[k+1]
+			X, t, ok := seg_cross(a, b, c, d)
+			if !ok { continue }
+			if skip_cross {
+				continue
+			}
+			// the crossed pipe's own band half (physical clearance: our half +
+			// their half + the slide gutter)
+			their_band := band_world(v, bundles.bundle_tier[j], int(bundles.bundle_count[j]))
+			// offset: perpendicular to the CROSSED pipe, the side determined by
+			// the cross-product sign (deterministic — same topology, same side)
+			dc := d - c
+			dl := rl.Vector2Length(dc)
+			if dl <= 0.0001 {
+				continue
+			}
+			uc := dc / dl
+			sign := cross2(b - a, uc)
+			if sign >= 0 {
+				sign = 1
+			} else {
+				sign = -1
+			}
+			// perpendicular of uc: (-uc.y, uc.x) × sign
+			n := rl.Vector2{-uc.y * sign, uc.x * sign}
+			o = Obstacle{kind = .Cross, seg = k, t = t, offset = n, clear = band_w * 0.5 + their_band * 0.5 + WIRE_SLIDE_GUTTER}
+			found = true
+			return
+		}
+	}
+	// 2. world edges (the inset rect — hugging the edge is a violation)
+	w := v.world_w
+	h := v.world_h
+	edges := [4][2]rl.Vector2{
+		{{WIRE_EDGE_MARGIN, WIRE_EDGE_MARGIN}, {w - WIRE_EDGE_MARGIN, WIRE_EDGE_MARGIN}}, // top
+		{{w - WIRE_EDGE_MARGIN, WIRE_EDGE_MARGIN}, {w - WIRE_EDGE_MARGIN, h - WIRE_EDGE_MARGIN}}, // right
+		{{w - WIRE_EDGE_MARGIN, h - WIRE_EDGE_MARGIN}, {WIRE_EDGE_MARGIN, h - WIRE_EDGE_MARGIN}}, // bottom
+		{{WIRE_EDGE_MARGIN, h - WIRE_EDGE_MARGIN}, {WIRE_EDGE_MARGIN, WIRE_EDGE_MARGIN}}, // left
+	}
+	for e in edges {
+		for k in 0..<path.n - 1 {
+			a := path.pts[k]
+			b := path.pts[k+1]
+			_, t, ok := seg_cross(a, b, e[0], e[1])
+			if !ok { continue }
+			// offset: inward normal of the crossed edge
+			inward: rl.Vector2
+			if e[0].y == e[1].y && e[0].y == WIRE_EDGE_MARGIN {
+				inward = {0, 1} // top edge → push down
+			} else if e[0].y == e[1].y {
+				inward = {0, -1} // bottom → push up
+			} else if e[0].x == e[1].x && e[0].x == WIRE_EDGE_MARGIN {
+				inward = {1, 0} // left → push right
+			} else {
+				inward = {-1, 0} // right → push left
+			}
+			o = Obstacle{kind = .Edge, seg = k, t = t, offset = inward, clear = (WIRE_EDGE_MARGIN - 0.0) + band_w * 0.5}
+			found = true
+			return
+		}
+	}
+	// 3. node/terminal sprites (node slot order, excluding the bundle's own
+	// endpoints — the endpoints attach AT their sprites by design)
+	lo_id, hi_id := bundles.bundle_lo[bi], bundles.bundle_hi[bi]
+	for ns in 0..<len(topo.node_alive) {
+		if !topo.node_alive[ns] { continue }
+		if topo.node_id[ns] == lo_id || topo.node_id[ns] == hi_id { continue }
+		c := node_world(topo, u32(ns), v.tile_px)
+		rad := node_sprite_radius_world(v, topo, u32(ns)) + WIRE_SPRITE_MARGIN
+		for k in 0..<path.n - 1 {
+			a := path.pts[k]
+			b := path.pts[k+1]
+			t := point_seg_param(a, b, c)
+			q := a + (b - a) * t
+			dist := rl.Vector2Length(q - c)
+			if dist >= rad { continue }
+			away := q - c
+			al := rl.Vector2Length(away)
+			if al <= 0.0001 {
+				away = {0, -1}
+				al = 1
+			}
+			o = Obstacle{kind = .Sprite, seg = k, t = t, offset = away / al, clear = rad - dist + band_w * 0.5}
+			found = true
+			return
+		}
+	}
+	return
+}
+
+// insert_bend — apply one obstacle detour: split the violating segment at the
+// violation and offset the crossing region laterally by `clear`, producing an
+// S-slide (entry point + exit point, both displaced — the middle run slides
+// alongside the obstacle). Returns false when the polyline is full (the caller
+// falls back to straight).
+insert_bend :: proc(path: ^Wire_Path, o: Obstacle) -> bool {
+	if path.n + 2 > MAX_WIRE_POINTS {
+		return false
+	}
+	if o.seg < 0 || o.seg >= path.n - 1 {
+		return false
+	}
+	a := path.pts[o.seg]
+	b := path.pts[o.seg+1]
+	seg_len := rl.Vector2Length(b - a)
+	if seg_len <= 0.0001 {
+		return false
+	}
+	u := (b - a) / seg_len
+	n := o.offset
+	// entry/exit straddling the violation, both displaced laterally — the
+	// slide window is `clear` long each side so the S reads as a gradual bend
+	win := max(o.clear, 0.5 * seg_len)
+	t1 := max(0, o.t - win / seg_len)
+	t2 := min(1, o.t + win / seg_len)
+	if t1 == t2 {
+		t1 = max(0, o.t - 0.01)
+		t2 = min(1, o.t + 0.01)
+	}
+	p1 := a + (b - a) * t1 + n * o.clear
+	p2 := a + (b - a) * t2 + n * o.clear
+	// rebuild: ... a → p1 → p2 → b ...
+	new_pts: [MAX_WIRE_POINTS]rl.Vector2
+	ni := 0
+	for i := 0; i <= o.seg; i += 1 {
+		new_pts[ni] = path.pts[i]
+		ni += 1
+	}
+	new_pts[ni] = p1
+	new_pts[ni+1] = p2
+	ni += 2
+	for i := o.seg + 1; i < path.n; i += 1 {
+		new_pts[ni] = path.pts[i]
+		ni += 1
+	}
+	path.n = ni
+	path.pts = new_pts
+	return true
+}
+
+// wire_paths_compute — every bundle's drawn path for this frame (temp arena;
+// NEVER delete — the per-frame/per-tick free_all reclaims it wholesale, the
+// temp-arena field-notes rule). Indexed by bundle slot; consumers thread it
+// through so the whole ribbon read shares ONE polyline per bundle.
+wire_paths_compute :: proc(v: ^View, topo: ^pp.Topology, bundles: ^pp.Bundles) -> [dynamic]Wire_Path {
+	paths := make([dynamic]Wire_Path, 0, max(1, int(bundles.n)), context.temp_allocator)
+	for bi in 0..<int(bundles.n) {
+		band := band_world(v, bundles.bundle_tier[bi], int(bundles.bundle_count[bi]))
+		append(&paths, wire_path_compute(v, topo, bundles, u32(bi), band))
+	}
+	return paths
+}
+
+// wire_path_compute — the deterministic drawn path for bundle bi (world px).
+// Straight by default; detours only when a bend beats the degradation
+// thresholds. Pure — reads (topo, bundles, view) only (ODN-1).
+wire_path_compute :: proc(v: ^View, topo: ^pp.Topology, bundles: ^pp.Bundles, bi: u32, band_w: f32) -> (p: Wire_Path) {
+	lo, hi := bundles.bundle_lo[bi], bundles.bundle_hi[bi]
+	sa, oka := pp.node_slot(topo, lo)
+	sb, okb := pp.node_slot(topo, hi)
+	if !oka || !okb {
+		return
+	}
+	// fan apexes (world px) — the ribbon's drawn endpoints
+	a_world := node_world(topo, sa, v.tile_px)
+	b_world := node_world(topo, sb, v.tile_px)
+	apex_a, _ := end_apex(v, topo, bundles, bi, 0, b_world, band_w)
+	apex_b, _ := end_apex(v, topo, bundles, bi, 1, a_world, band_w)
+	wire_path_straight(&p, apex_a, apex_b)
+
+	// terminal stubs skip pipe-crossing detours (crossing is the right look
+	// for a short drop); they still avoid sprites + edges (skip_cross=true).
+	is_terminal_end := node_kind_of(topo, sa) != .Junction || node_kind_of(topo, sb) != .Junction
+	stub := is_terminal_end && straight_len(apex_a, apex_b) < WIRE_STUB_TILES * v.tile_px
+
+	straight := straight_len(apex_a, apex_b)
+	bends := 0
+	for bends < WIRE_DETOUR_MAX_BENDS {
+		o, found := scan_obstacles(v, topo, bundles, &p, bi, band_w, stub)
+		if !found {
+			break
+		}
+		if !insert_bend(&p, o) {
+			wire_path_straight(&p, apex_a, apex_b)
+			return
+		}
+		bends += 1
+	}
+	// degradation: a detour longer than straight × ratio is abandoned
+	if straight > 0.0001 && path_len(&p) > straight * WIRE_DETOUR_MAX_LEN_RATIO {
+		wire_path_straight(&p, apex_a, apex_b)
+	}
+	return
+}
+
+// wire_to_screen — world-px → screen px (the view transform the path draws
+// through; mirrors node_screen for tile coords).
+wire_to_screen :: proc(v: ^View, w: rl.Vector2) -> rl.Vector2 {
+	return {v.off_x + w.x * v.scale, v.off_y + w.y * v.scale}
+}
+
+// wire_path_straight — the degenerate path: straight from anchor a to anchor b.
+wire_path_straight :: proc(p: ^Wire_Path, a, b: rl.Vector2) {
+	p.n = 2
+	p.pts[0] = a
+	p.pts[1] = b
+}
+
+// wire_path_point — the drawn position + tangent (unit) at arc-length
+// fraction t∈[0,1] along the polyline — the rider/measure sampler shared by
+// draw_bundles stripes and draw_packets riders (ONE definition so riders stay
+// on the ribbon). Deterministic (arc-length walk, IEEE float).
+wire_path_point :: proc(p: ^Wire_Path, t: f32) -> (pos, tangent: rl.Vector2) {
+	if p.n <= 1 {
+		return p.pts[0], {1, 0}
+	}
+	if t <= 0 {
+		a, b := p.pts[0], p.pts[1]
+		d := b - a
+		l := rl.Vector2Length(d)
+		if l <= 0.0001 {
+			return a, {1, 0}
+		}
+		return a, d / l
+	}
+	if t >= 1 {
+		a, b := p.pts[p.n-2], p.pts[p.n-1]
+		d := b - a
+		l := rl.Vector2Length(d)
+		if l <= 0.0001 {
+			return b, {1, 0}
+		}
+		return b, d / l
+	}
+	total := path_len(p)
+	if total <= 0.0001 {
+		return p.pts[0], {1, 0}
+	}
+	target := t * total
+	acc: f32 = 0
+	for i in 0..<p.n - 1 {
+		a, b := p.pts[i], p.pts[i+1]
+		d := b - a
+		l := rl.Vector2Length(d)
+		if l <= 0.0001 {
+			continue
+		}
+		if acc + l >= target || i == p.n - 2 {
+			frac: f32 = 0.0
+			if l > 0.0001 {
+				frac = min(f32(1), (target - acc) / l)
+			}
+			return a + d * frac, d / l
+		}
+		acc += l
+	}
+	return p.pts[p.n-1], {1, 0}
+}
+
+// band_world — the bundle's band width in WORLD px (the drawn-width basis for
+// detour clearances; mirrors band_width's screen formula ÷ scale).
+band_world :: proc(v: ^View, tier: u16, count: int) -> f32 {
+	return (tier_pipe_width(v, tier) + f32(max(0, count - 1)) * BUNDLE_EXTRA_WIDTH) * 2.2
+}
+
+// draw_path_band — draw a thick polyline along the path (each segment a
+// DrawLineEx + a joint circle so bends read as rounded corners — the same
+// two-end-cap pattern the straight render uses, per waypoint). ONE helper for
+// the band, the lane stripes, the selection halo, and the crisis outline so
+// every consumer follows the SAME polyline.
+draw_path_band :: proc(v: ^View, p: ^Wire_Path, width: f32, col: rl.Color) {
+	for i in 0..<p.n - 1 {
+		a := wire_to_screen(v, p.pts[i])
+		b := wire_to_screen(v, p.pts[i+1])
+		rl.DrawLineEx(a, b, width, col)
+		rl.DrawCircleV(a, width * 0.5, col)
+	}
+	last := wire_to_screen(v, p.pts[p.n-1])
+	rl.DrawCircleV(last, width * 0.5, col)
+}
+
+// draw_path_offset_band — draw a thick polyline LATERALLY OFFSET from the
+// path by `lateral` world px (the lane-stripe walk: each segment's endpoints
+// offset along its own normal, round caps at every waypoint). ONE helper for
+// all three lane stripes so they ride the SAME ribbon (3.3 canon preserved).
+draw_path_offset_band :: proc(v: ^View, p: ^Wire_Path, lateral: f32, width: f32, col: rl.Color) {
+	for i in 0..<p.n - 1 {
+		a, b := p.pts[i], p.pts[i+1]
+		d := b - a
+		l := rl.Vector2Length(d)
+		if l <= 0.0001 {
+			continue
+		}
+		nx, ny := -d.y / l, d.x / l
+		wa := rl.Vector2{a.x + nx * lateral, a.y + ny * lateral}
+		wb := rl.Vector2{b.x + nx * lateral, b.y + ny * lateral}
+		sa := wire_to_screen(v, wa)
+		sb := wire_to_screen(v, wb)
+		rl.DrawLineEx(sa, sb, width, col)
+		rl.DrawCircleV(sa, width * 0.5, col)
+	}
+	// the last waypoint's cap (the final segment's normal)
+	if p.n >= 2 {
+		a, b := p.pts[p.n-2], p.pts[p.n-1]
+		d := b - a
+		l := rl.Vector2Length(d)
+		if l > 0.0001 {
+			nx, ny := -d.y / l, d.x / l
+			wb := rl.Vector2{b.x + nx * lateral, b.y + ny * lateral}
+			sb := wire_to_screen(v, wb)
+			rl.DrawCircleV(sb, width * 0.5, col)
+		}
+	}
+}
diff --git a/app/render/wire_path_test.odin b/app/render/wire_path_test.odin
