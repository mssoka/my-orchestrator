diff --git a/harness/wire_preview.odin b/harness/wire_preview.odin
new file mode 100644
index 0000000..751650a
--- /dev/null
+++ b/harness/wire_preview.odin
@@ -0,0 +1,198 @@
+package main
+
+// wire_preview.odin — Story 7.5's lavish-gate tool: render the SAME settled
+// scene with wire routing ON vs OFF (the pre-7.5 straight look) side by side,
+// plus zoomed junction close-ups (anchor spread + ribbon fan). Scenes:
+//   juice   — the Story-7.1 dense core (13 nodes, 4 routers basic/mid/high,
+//             2 hosts, all three tiers, a 2-member bundle, QoS presets) — the
+//             busy-map moment.
+//   estate  — the Story-5.12 estates (3-campus cluster + an 8-home mesh on a
+//             shared 4-wide uplink bundle) — the grouped topology.
+// The topology is seed-independent (fixed positions, no growth), so the A/B
+// candidates differ ONLY in routing — the gate's like-for-like comparison.
+//
+// Usage: harness wire-preview [outdir]   (default outdir: bin/wire-preview)
+// Emits:
+//   <outdir>/juice_routed.png  <outdir>/juice_straight.png
+//   <outdir>/estate_routed.png <outdir>/estate_straight.png
+//   <outdir>/closeup_juice_routed.png   (2.4x zoom on the dense core)
+//   <outdir>/closeup_estate_routed.png  (2.4x zoom on the estate uplink)
+// The frames share the capture pipeline (draw_world + forecast/health/banner
+// like the game), so they are honest game moments, not wireframes.
+
+import "core:fmt"
+import "core:os"
+import "core:strings"
+import rl "vendor:raylib"
+import pp "../core"
+import rnd "../app/render"
+
+// estate_scene — the estate_surge.dem topology at its clean pre-surge moment
+// (t500): the 3-campus estate on router R1, the 4-wide shared uplink R1→R0,
+// the 8 residential sinks spread thin on R0. Fixed positions (the demo's,
+// lifted verbatim) — seed-independent by construction.
+estate_scene :: proc(state: ^pp.Run_State, cat: ^pp.Catalogs) {
+	rth, _ := pp.node_type_index(cat, "router_high")
+	campus, _ := pp.node_type_index(cat, "campus")
+	res, _ := pp.node_type_index(cat, "residential")
+	wide, _ := pp.pipe_tier_index(cat, "wide")
+
+	pp.topology_spawn_node(&state.topology, rth, {16, 15}, cat)  // 0: R0 mesh
+	pp.topology_spawn_node(&state.topology, rth, {30, 24}, cat)  // 1: R1 estate
+	pp.topology_spawn_node(&state.topology, campus, {26, 18}, cat) // 2
+	pp.topology_spawn_node(&state.topology, campus, {30, 18}, cat) // 3
+	pp.topology_spawn_node(&state.topology, campus, {34, 18}, cat) // 4
+	pp.topology_spawn_node(&state.topology, res, {6, 8}, cat)    // 5
+	pp.topology_spawn_node(&state.topology, res, {26, 8}, cat)   // 6
+	pp.topology_spawn_node(&state.topology, res, {6, 22}, cat)   // 7
+	pp.topology_spawn_node(&state.topology, res, {26, 22}, cat)  // 8
+	pp.topology_spawn_node(&state.topology, res, {10, 14}, cat)  // 9
+	pp.topology_spawn_node(&state.topology, res, {22, 14}, cat)  // 10
+	pp.topology_spawn_node(&state.topology, res, {10, 26}, cat)  // 11
+	pp.topology_spawn_node(&state.topology, res, {22, 26}, cat)  // 12
+
+	// campus drops (3 wide each = the 3-wide bundles) + the 4-wide uplink
+	draws := []pp.Command{
+		{kind = pp.Cmd_Draw_Pipe{a = 2, b = 1, tier = wide}},
+		{kind = pp.Cmd_Draw_Pipe{a = 2, b = 1, tier = wide}},
+		{kind = pp.Cmd_Draw_Pipe{a = 2, b = 1, tier = wide}},
+		{kind = pp.Cmd_Draw_Pipe{a = 3, b = 1, tier = wide}},
+		{kind = pp.Cmd_Draw_Pipe{a = 3, b = 1, tier = wide}},
+		{kind = pp.Cmd_Draw_Pipe{a = 3, b = 1, tier = wide}},
+		{kind = pp.Cmd_Draw_Pipe{a = 4, b = 1, tier = wide}},
+		{kind = pp.Cmd_Draw_Pipe{a = 4, b = 1, tier = wide}},
+		{kind = pp.Cmd_Draw_Pipe{a = 4, b = 1, tier = wide}},
+		{kind = pp.Cmd_Draw_Pipe{a = 1, b = 0, tier = wide}},
+		{kind = pp.Cmd_Draw_Pipe{a = 1, b = 0, tier = wide}},
+		{kind = pp.Cmd_Draw_Pipe{a = 1, b = 0, tier = wide}},
+		{kind = pp.Cmd_Draw_Pipe{a = 1, b = 0, tier = wide}},
+		{kind = pp.Cmd_Draw_Pipe{a = 5, b = 0, tier = wide}},
+		{kind = pp.Cmd_Draw_Pipe{a = 6, b = 0, tier = wide}},
+		{kind = pp.Cmd_Draw_Pipe{a = 7, b = 0, tier = wide}},
+		{kind = pp.Cmd_Draw_Pipe{a = 8, b = 0, tier = wide}},
+		{kind = pp.Cmd_Draw_Pipe{a = 9, b = 0, tier = wide}},
+		{kind = pp.Cmd_Draw_Pipe{a = 10, b = 0, tier = wide}},
+		{kind = pp.Cmd_Draw_Pipe{a = 11, b = 0, tier = wide}},
+		{kind = pp.Cmd_Draw_Pipe{a = 12, b = 0, tier = wide}},
+	}
+	for d in draws {
+		pp.topology_apply_edit(&state.topology, d, cat)
+	}
+	state.era = 3
+}
+
+// render_scene_frame — settle the scene to the given tick, then draw the full
+// world + HUD (like capture_frame) with the view's route_wires set per frame.
+// Returns the exported PNG path. The view transform is copied + mutated so the
+// caller can zoom (scale × z around a world point) for close-ups.
+render_scene_frame :: proc(rc: ^Render_Ctx, state: ^pp.Run_State, cat: ^pp.Catalogs, seed: u64, settle_tick: u64, route: bool, zoom: f32, center: [2]f32, out: string, anchors: bool = true) -> int {
+	rc.view.route_wires = route
+	rc.view.wire_anchors = anchors
+	if zoom != 1.0 {
+		// close-up: re-fit the camera around the world point at the zoom
+		old_scale := rc.view.scale
+		rc.view.scale = old_scale * zoom
+		rc.view.off_x = f32(rc.view.win_w) * 0.5 - center[0] * rc.view.scale
+		rc.view.off_y = f32(rc.view.win_h) * 0.5 - center[1] * rc.view.scale
+	}
+	rl.BeginDrawing()
+	rnd.draw_world(&rc.view, &state.topology, &state.bundles, &state.flow, &state.crisis, settle_tick, {}, -1, -1, seed)
+	rnd.draw_forecast_panel(&rc.view, &state.crisis, cat, state.era)
+	rnd.draw_health_meter(&rc.view, &state.health, cat, state.health_enabled)
+	rnd.draw_crisis_banner(&rc.view, &state.crisis, cat, state.era, 10)
+	rl.EndDrawing()
+	img := rl.LoadImageFromScreen()
+	rl.ImageFlipVertical(&img)
+	swizzle_rb(&img)
+	cpath := strings.clone_to_cstring(out, context.temp_allocator)
+	ok := rl.ExportImage(img, cpath)
+	rl.UnloadImage(img)
+	// restore the fit camera for the next frame
+	rc.view.scale = 0 // recomputed below
+	rnd.view_compute(&rc.view, 1280, 720, &cat.balance)
+	if !ok {
+		fmt.eprintfln("wire-preview: failed to write %s", out)
+		return 1
+	}
+	fmt.printfln("wire-preview: %s", out)
+	return 0
+}
+
+// run_wire_preview — the verb: render both scenes, routed + straight, plus
+// junction close-ups, into the outdir.
+run_wire_preview :: proc(outdir: string, cat: ^pp.Catalogs) -> int {
+	rl.SetTraceLogLevel(.ERROR)
+	rl.InitWindow(1280, 720, "pp-wire-preview")
+	defer rl.CloseWindow()
+
+	rc: Render_Ctx
+	render_setup(&rc, cat)
+	rnd.view_compute(&rc.view, 1280, 720, &cat.balance)
+
+	// the juice scene (dense core) at its calm 30s moment (600 ticks)
+	juice: pp.Run_State
+	pp.run_init(&juice, 7, cat.hash, cat.balance.logic_hz)
+	defer pp.run_destroy(&juice)
+	juice_scene(&juice, cat)
+	for t in u64(1)..=600 {
+		pp.step(&juice, t, {}, cat)
+		clear(&juice.events)
+	}
+
+	// the estate scene (5.12 grouped topology) at its clean t500 moment
+	estate: pp.Run_State
+	pp.run_init(&estate, 4243, cat.hash, cat.balance.logic_hz)
+	defer pp.run_destroy(&estate)
+	estate_scene(&estate, cat)
+	for t in u64(1)..=500 {
+		pp.step(&estate, t, {}, cat)
+		clear(&estate.events)
+	}
+
+	code := 0
+	j := fmt.aprintf("%s/juice_routed.png", outdir)
+	s := fmt.aprintf("%s/juice_straight.png", outdir)
+	code += render_scene_frame(&rc, &juice, cat, 7, 600, true, 1.0, {0, 0}, j)
+	code += render_scene_frame(&rc, &juice, cat, 7, 600, false, 1.0, {0, 0}, s, false)
+	// junction close-up: the dense core around router_mid (16,15) — the hub
+	// where the 2-member bundle + 4 pipes fan (world px center)
+	jc := fmt.aprintf("%s/closeup_juice_routed.png", outdir)
+	code += render_scene_frame(&rc, &juice, cat, 7, 600, true, 2.4, {16 * 26.0, 15 * 26.0}, jc)
+	jc2 := fmt.aprintf("%s/closeup_juice_straight.png", outdir)
+	code += render_scene_frame(&rc, &juice, cat, 7, 600, false, 2.4, {16 * 26.0, 15 * 26.0}, jc2, false)
+
+	ej := fmt.aprintf("%s/estate_routed.png", outdir)
+	es := fmt.aprintf("%s/estate_straight.png", outdir)
+	code += render_scene_frame(&rc, &estate, cat, 4243, 500, true, 1.0, {0, 0}, ej)
+	code += render_scene_frame(&rc, &estate, cat, 4243, 500, false, 1.0, {0, 0}, es, false)
+	// close-up: the estate uplink at R1 (30,24) — the 4-wide ribbon fan
+	ec := fmt.aprintf("%s/closeup_estate_routed.png", outdir)
+	code += render_scene_frame(&rc, &estate, cat, 4243, 500, true, 2.4, {30 * 26.0, 24 * 26.0}, ec)
+	ec2 := fmt.aprintf("%s/closeup_estate_straight.png", outdir)
+	code += render_scene_frame(&rc, &estate, cat, 4243, 500, false, 2.4, {30 * 26.0, 24 * 26.0}, ec2, false)
+	// the tight 5x close-up of the uplink fan (the ribbon splitting into the
+	// 4 member anchors) — the junction-shaping money shot
+	ec3 := fmt.aprintf("%s/fan_estate_routed.png", outdir)
+	code += render_scene_frame(&rc, &estate, cat, 4243, 500, true, 5.0, {30 * 26.0, 24 * 26.0}, ec3)
+	ec4 := fmt.aprintf("%s/fan_estate_straight.png", outdir)
+	code += render_scene_frame(&rc, &estate, cat, 4243, 500, false, 5.0, {30 * 26.0, 24 * 26.0}, ec4, false)
+	// r2 (user verdict 2026-08-19: "straight looks better for a network
+	// topology"): the REFINED candidate — straight wires + junction shaping
+	// (rim anchors + ribbon fan, NO detours). Re-render every pair with
+	// route=false, anchors=true so the gate can compare straight-vs-straight.
+	ja := fmt.aprintf("%s/juice_anchors.png", outdir)
+	code += render_scene_frame(&rc, &juice, cat, 7, 600, false, 1.0, {0, 0}, ja, true)
+	ea := fmt.aprintf("%s/estate_anchors.png", outdir)
+	code += render_scene_frame(&rc, &estate, cat, 4243, 500, false, 1.0, {0, 0}, ea, true)
+	cja := fmt.aprintf("%s/closeup_juice_anchors.png", outdir)
+	code += render_scene_frame(&rc, &juice, cat, 7, 600, false, 2.4, {16 * 26.0, 15 * 26.0}, cja, true)
+	fea := fmt.aprintf("%s/fan_estate_anchors.png", outdir)
+	code += render_scene_frame(&rc, &estate, cat, 4243, 500, false, 5.0, {30 * 26.0, 24 * 26.0}, fea, true)
+
+	if code != 0 {
+		fmt.eprintln("wire-preview: one or more frames failed")
+		return 1
+	}
+	fmt.printfln("wire-preview: gate frames in %s — compare routed vs straight + the close-ups", outdir)
+	return 0
+}
