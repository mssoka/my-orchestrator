+
+/// RC4.2 back-compat: an old server payload WITHOUT the additive
+/// `form_opened_at` key must still decode (the decoder defaults it to None).
+pub fn detail_decoder_tolerates_missing_form_opened_at_test() {
+  // An old server payload (no `form_opened_at` key - RC4.1 wire shape) must
+  // still decode; the decoder defaults the additive key to None.
+  let wire =
+    "{\"reference_call_id\":\"uuid-rc-3\",\"ref_slot\":\"landlord_ref\",\"owner_label\":\"primary\",\"status\":\"queued\",\"outcome\":null,\"attempt_count\":0,\"next_attempt_at\":null,\"attempts\":[],\"result\":null,\"display_disclaimer\":null,\"hooks\":{\"can_record_manual\":true,\"can_substitute_referee\":false,\"can_retry\":false}}"
+  // Map a decode failure to a sentinel so the assertion is total (no
+  // `should.fail` - gleeunit's fail takes no arguments in this version).
+  let opened = case json.parse(wire, reference_call.detail_decoder()) {
+    Ok(detail) -> detail.form_opened_at
+    Error(_) -> option.Some("decode-error")
+  }
+  opened |> should.equal(option.None)
+}
+
+/// RC4.2: the additive key round-trips when present.
+pub fn detail_form_opened_at_roundtrip_test() {
+  let detail =
+    ReferenceCallDetail(
+      reference_call_id: "uuid-rc-4",
+      ref_slot: LandlordRef,
+      owner_label: Primary,
+      status: ContactInitiated,
+      outcome: None,
+      attempt_count: 1,
+      next_attempt_at: Some("2026-08-02T10:00:00Z"),
+      form_opened_at: Some("2026-08-01T21:12:00Z"),
+      submitted_at: Some("2026-08-02T09:00:00Z"),
+      attempts: [],
+      result: None,
+      display_disclaimer: None,
+      hooks: sample_hooks(),
+    )
+  detail
+  |> reference_call.encode_detail
+  |> json.to_string
+  |> json.parse(reference_call.detail_decoder())
+  |> should.be_ok
+  |> should.equal(detail)
+}
