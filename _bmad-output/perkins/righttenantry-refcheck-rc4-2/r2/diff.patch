+    let dismissed = case storage.local() {
+      Ok(ls) ->
+        case storage.get_item(ls, "rt_refcheck_explainer_dismissed") {
+          Ok("1") -> True
+          _ -> False
+        }
+      Error(_) -> False
+    }
+    dispatch(UserHydratedRefcheckExplainerDismissed(dismissed))
+  })
+}
