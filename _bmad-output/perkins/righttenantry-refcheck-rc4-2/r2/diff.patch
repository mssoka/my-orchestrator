+fn save_refcheck_explainer_dismissed_effect() -> Effect(Msg) {
+  effect.from(fn(dispatch) {
+    case storage.local() {
+      Ok(ls) ->
+        case storage.set_item(ls, "rt_refcheck_explainer_dismissed", "1") {
+          Ok(_) -> Nil
+          Error(_) ->
+            io.println(
+              "refcheck: localStorage unavailable, dismissal in-memory only",
+            )
+        }
+      Error(_) ->
+        io.println(
+          "refcheck: localStorage unavailable, dismissal in-memory only",
+        )
+    }
+    dispatch(AppNoOp)
+  })
