+//// Reference panel — the landlord's per-reference workspace card (RC4.2).
+////
+//// Renders the RC4.1 `reference_calls[]` contract: every lifecycle state per
+//// UX §4.2/§7.4 verbatim, the completed-reference summary with honest framing
+//// (§7.5 "Worth knowing" as clues — never verdicts; "Not answered" for
+//// unanswered verification fields, never hidden, never guessed; the
+//// confidence line verbatim), the Off state for declined attestations, and
+//// the collapsed-by-default "What this tells you" explainer (§7.8 verbatim).
+////
+//// Display only (AR-RC13): state rules are server-computed (RC4.1); this
+//// module renders the payload and never re-derives state logic. Row ACTIONS
+//// (start/skip/take-over/correct/substitute — the ⋯ overflow menu) are
+//// RC4.3's delivery: the overflow control renders with its required testid
+//// on the rows that will carry actions (§7.3), but is deliberately not
+//// click-wired here (no dead menu, no placeholder items).
+
+import components/contact_chip
+import copy
+import gleam/dict.{type Dict}
+import gleam/dynamic.{type Dynamic}
+import gleam/dynamic/decode
+import gleam/int
+import gleam/json
+import gleam/list
+import gleam/option.{type Option, None, Some}
+import gleam/set.{type Set}
+import gleam/string
+import helpers/format
+import lustre/attribute.{attribute, class}
+import lustre/element.{type Element}
+import lustre/element/html
+import lustre/element/keyed
+import lustre/event
+import msg.{type Msg}
+import shared/application.{type Application}
+import shared/reference_call.{
+  type RefSlot, type ReferenceCallAttempt, type ReferenceCallDetail,
+  type ReferenceCallStatus, AwaitingCorrection, Calling, CharacterRef, Completed,
+  ContactInitiated, EmployerRef, Failed, FormCompleted, LandlordRef,
+  ManualRecorded, Objected, Partial, Queued, Refused, Scheduled, Skipped,
+  Unreachable,
+}
+
+// -- Public API ---------------------------------------------------------------
+
+/// Render the reference panel. Returns `element.none()` when the application
+/// has no reference surface (pre-v1 applications with no rows — the counsel
+/// posture for `attestation_on_file: false` + NULL choice, §11 Q5).
+///
+/// - `off` — `reference_contact_choice == "declined"`: the feature is off for
+///   this application; render the §7.4 Off block instead of rows.
+/// - `attestation_on_file` — per-application acknowledgement presence (RC4.1).
+/// - `expanded` — reference_call_ids the landlord has expanded.
+/// - `explainer_open` — the §7.8 explainer open/closed (collapsed by default).
+pub fn view(
+  calls calls: List(ReferenceCallDetail),
+  off off: Bool,
+  attestation_on_file attestation_on_file: Bool,
+  app app: Application,
+  expanded expanded: Set(String),
+  explainer_open explainer_open: Bool,
+) -> Element(Msg) {
+  case off || attestation_on_file || !list.is_empty(calls) {
+    False -> element.none()
+    True ->
+      html.div(
+        [
+          attribute("data-testid", "refcheck-card"),
+          attribute("role", "region"),
+          attribute("aria-label", copy.refcheck_aria_label),
+          class("bg-white rounded-xl shadow-xl shadow-navy/5 p-6"),
+        ],
+        [
+          html.h2([class("font-headline text-xl font-bold text-navy mb-1")], [
+            html.text(copy.refcheck_heading(list.length(calls))),
+          ]),
+          case off {
+            True -> element.none()
+            False ->
+              html.p([class("text-sm text-slate mb-3")], [
+                html.text(panel_subline(calls)),
+              ])
+          },
+          view_explainer(explainer_open, app.first_name),
+          case off {
+            True -> view_off(app)
+            False -> view_rows(calls, app, expanded)
+          },
+        ],
+      )
+  }
+}
+
+// -- Panel chrome -------------------------------------------------------------
+
+/// The state-tracking sub-line (§10.3 as amended): pre-trigger (no rows yet)
+/// uses the A5 viewing wording; in-flight while any row is live; terminal
+/// once every row is closed.
+fn panel_subline(calls: List(ReferenceCallDetail)) -> String {
+  // Empty first: `list.all` on [] is vacuously True and would mislabel the
+  // pre-trigger panel as "all references closed".
+  case list.is_empty(calls) {
+    True -> copy.refcheck_subline_pre_trigger
+    False ->
+      case list.all(calls, is_terminal) {
+        True -> copy.refcheck_subline_all_terminal
+        False -> copy.refcheck_subline_in_flight
+      }
+  }
+}
+
+/// Terminality comes from the server-computed hook the payload ships
+/// (AR-RC13 — the panel never re-derives state rules client-side). The
+/// server's terminal set includes the v2-reserved `completed`; a client-side
+/// re-implementation would drift (rc4-2 Perkins r1 B1).
+fn is_terminal(call: ReferenceCallDetail) -> Bool {
+  !call.hooks.can_record_manual
+}
+
+/// The "What this tells you" explainer (§7.8) — collapsed by default; the
+/// landlord toggles it in-session. Copy is verbatim (name interpolated).
+fn view_explainer(open: Bool, first_name: String) -> Element(Msg) {
+  html.div([class("mb-4")], [
+    html.button(
+      [
+        attribute("data-testid", "refcheck-explainer"),
+        attribute("type", "button"),
+        attribute("aria-expanded", case open {
+          True -> "true"
+          False -> "false"
+        }),
+        event.on_click(msg.UserToggledRefcheckExplainer),
+        class(
+          "text-sm text-navy font-medium hover:underline inline-flex items-center gap-1 focus:outline-none focus:ring-2 focus:ring-navy/40 rounded",
+        ),
+      ],
+      [
+        html.text(copy.refcheck_explainer_title),
+        html.span([class("text-slate/60")], [
+          html.text(case open {
+            True -> "▴"
+            False -> "▾"
+          }),
+        ]),
+      ],
+    ),
+    case open {
+      False -> element.none()
+      True ->
+        html.div(
+          [
+            class(
+              "mt-2 text-sm text-slate leading-relaxed bg-slate-50 rounded-lg p-3 space-y-2",
+            ),
+          ],
+          copy.refcheck_explainer_body(first_name)
+            |> string.split("\n\n")
+            |> list.map(fn(para) { html.p([], [html.text(para)]) }),
+        )
+    },
+  ])
+}
+
+// -- Off state (attestation declined) -----------------------------------------
+
+/// §7.4 Off state: honest decline branch, manual flow first-class. No re-ask
+/// button, no "convince them" affordance. Referee contact chips (the v2
+/// header chip treatment) for the slots that carry data.
+fn view_off(app: Application) -> Element(Msg) {
+  html.div([class("space-y-4")], [
+    html.p([class("font-semibold text-charcoal")], [
+      html.text(copy.refcheck_off_heading),
+    ]),
+    html.p([class("text-sm text-slate leading-relaxed")], [
+      html.text(copy.refcheck_off_body(app.first_name)),
+    ]),
+    html.div([class("space-y-4")], [
+      off_ref_block(
+        "landlord_ref",
+        app.landlord_ref_name,
+        app.landlord_ref_phone,
+        app.landlord_ref_email,
+      ),
+      off_ref_block(
+        "character_ref",
+        app.character_ref_name,
+        app.character_ref_phone,
+        app.character_ref_email,
+      ),
+      off_ref_block(
+        "employer_ref",
+        app.employer_ref_name,
+        app.employer_ref_phone,
+        app.employer_ref_email,
+      ),
+    ]),
+  ])
+}
+
+fn off_ref_block(
+  slot: String,
+  name: Option(String),
+  phone: Option(String),
+  email: Option(String),
+) -> Element(Msg) {
+  case name, phone, email {
+    None, None, None -> element.none()
+    _, _, _ ->
+      html.div([], [
+        html.p([class("text-sm font-semibold text-charcoal mb-1.5")], [
+          html.text(case name {
+            Some(n) -> n
+            None -> copy.refcheck_slot_label(slot)
+          }),
+        ]),
+        html.div([class("flex flex-wrap gap-2")], [
+          case phone {
+            Some(p) ->
+              contact_chip.view(
+                icon: contact_chip.phone_icon(),
+                value: p,
+                kind: "phone",
+                on_copy: msg.UserCopiedContact,
+                testid: "refcheck-off-phone-" <> slot,
+              )
+            None -> element.none()
+          },
+          case email {
+            Some(e) ->
+              contact_chip.view(
+                icon: contact_chip.email_icon(),
+                value: e,
+                kind: "email",
+                on_copy: msg.UserCopiedContact,
+                testid: "refcheck-off-email-" <> slot,
+              )
+            None -> element.none()
+          },
+        ]),
+      ])
+  }
+}
+
+// -- Rows ---------------------------------------------------------------------
+
+fn view_rows(
+  calls: List(ReferenceCallDetail),
+  app: Application,
+  expanded: Set(String),
+) -> Element(Msg) {
+  keyed.ul(
+    [attribute("role", "list"), class("divide-y divide-slate-100")],
+    list.map(calls, fn(call) {
+      #(call.reference_call_id, view_row(call, app, expanded))
+    }),
+  )
+}
+
+fn view_row(
+  call: ReferenceCallDetail,
+  app: Application,
+  expanded: Set(String),
+) -> Element(Msg) {
+  let slot = reference_call.encode_ref_slot(call.ref_slot)
+  let name = referee_name(app, call.ref_slot)
+  let is_expanded = set.contains(expanded, call.reference_call_id)
+  let #(pill_label, pill_class) = status_pill(call)
+  html.li([attribute("data-testid", "refcheck-row-" <> slot), class("py-4")], [
+    html.div([class("flex items-start gap-3")], [
+      // The row's main interactive surface (§12: rows are buttons with
+      // aria-expanded/aria-controls). The detail region is a sibling so the
+      // overflow control never nests inside the button.
+      html.button(
+        [
+          attribute("data-testid", "refcheck-expand-" <> slot),
+          attribute("type", "button"),
+          attribute("aria-expanded", case is_expanded {
+            True -> "true"
+            False -> "false"
+          }),
+          attribute(
+            "aria-controls",
+            "refcheck-detail-" <> call.reference_call_id,
+          ),
+          event.on_click(msg.UserToggledRefcheckRow(call.reference_call_id)),
+          class("flex-1 min-w-0 text-left"),
+        ],
+        [
+          html.div([class("flex items-center justify-between gap-2")], [
+            html.div([class("min-w-0")], [
+              html.p([class("text-sm font-semibold text-charcoal truncate")], [
+                html.text(name),
+              ]),
+              html.p([class("text-xs text-slate mt-0.5")], [
+                html.text(copy.refcheck_slot_label(slot)),
+              ]),
+            ]),
+            html.span([class("text-slate/60 text-xs flex-shrink-0")], [
+              html.text(case is_expanded {
+                True -> "▴"
+                False -> "▾"
+              }),
+            ]),
+          ]),
+          html.div([class("flex items-center gap-2 mt-2 flex-wrap")], [
+            html.span(
+              [
+                attribute("data-testid", "refcheck-status-" <> slot),
+                class(
+                  "px-2.5 py-0.5 rounded-full text-xs font-semibold "
+                  <> pill_class,
+                ),
+              ],
+              [html.text(pill_label)],
+            ),
+            case status_timestamp(call) {
+              Some(ts) ->
+                html.span([class("text-xs text-slate")], [html.text(ts)])
+              None -> element.none()
+            },
+          ]),
+        ],
+      ),
+      case row_has_overflow(call.status) {
+        True ->
+          html.button(
+            [
+              attribute("data-testid", "refcheck-overflow-" <> slot),
+              attribute("type", "button"),
+              attribute("aria-haspopup", "menu"),
+              attribute("aria-label", copy.refcheck_overflow_label(name)),
+              class(
+                "text-slate/40 hover:text-slate p-1 rounded flex-shrink-0 self-start focus:outline-none focus:ring-2 focus:ring-navy/40",
+              ),
+            ],
+            // RC4.3 (Row Actions) opens the menu and wires the actions;
+            // the control exists here because the RC4.2 acceptance matrix
+            // pins the testid. Deliberately no on_click yet.
+            [html.text("⋯")],
+          )
+        False -> element.none()
+      },
+    ]),
+    case is_expanded {
+      False -> element.none()
+      True ->
+        html.div(
+          [
+            attribute("id", "refcheck-detail-" <> call.reference_call_id),
+            class("mt-3 space-y-3"),
+          ],
+          [row_detail(call, app)],
+        )
+    },
+  ])
+}
+
+/// The referee's display name — from the application's referee trio for the
+/// row's slot (the RC4.1 payload carries no contact snapshot; the trio is the
+/// honest v1 source — substitution, which diverges the two, is RC4.3's).
+fn referee_name(app: Application, slot: RefSlot) -> String {
+  case slot {
+    LandlordRef ->
+      option.unwrap(
+        app.landlord_ref_name,
+        copy.refcheck_slot_label("landlord_ref"),
+      )
+    CharacterRef ->
+      option.unwrap(
+        app.character_ref_name,
+        copy.refcheck_slot_label("character_ref"),
+      )
+    EmployerRef ->
+      option.unwrap(
+        app.employer_ref_name,
+        copy.refcheck_slot_label("employer_ref"),
+      )
+  }
+}
+
+/// Which rows carry §7.3 overflow actions (start/skip/nudge/take-over/export/
+/// correct/substitute). Terminals without actions (received/partial/refused/
+/// objected/failed) render no overflow control.
+fn row_has_overflow(status: ReferenceCallStatus) -> Bool {
+  case status {
+    Queued | Skipped | ContactInitiated | AwaitingCorrection | Unreachable ->
+      True
+    _ -> False
+  }
+}
+
+/// The status pill: label per UX §4.2 + colour per §13 — received teal,
+/// waiting/queued slate, reminder/opened navy, needs-attention amber,
+/// declined/objected slate. Never red.
+fn status_pill(call: ReferenceCallDetail) -> #(String, String) {
+  case call.status {
+    Queued -> #(copy.refcheck_pill_queued, pill_slate)
+    Skipped -> #(copy.refcheck_pill_skipped, pill_slate)
+    ContactInitiated -> #(in_flight_label(call), pill_navy)
+    FormCompleted -> #(copy.refcheck_pill_received, pill_teal)
+    ManualRecorded -> #(copy.refcheck_pill_received, pill_teal)
+    Partial -> #(copy.refcheck_pill_partial, pill_amber)
+    AwaitingCorrection -> #(copy.refcheck_pill_awaiting_correction, pill_amber)
+    Unreachable -> #(copy.refcheck_pill_unreachable, pill_amber)
+    Refused -> #(copy.refcheck_pill_refused, pill_slate)
+    Objected -> #(copy.refcheck_pill_objected, pill_slate)
+    Failed -> #(copy.refcheck_pill_failed, pill_amber)
+    // v2-reserved voice lifecycle — never emitted by v1 servers; honest
+    // English renderings so a future payload still degrades gracefully.
+    Scheduled -> #(copy.refcheck_pill_scheduled, pill_slate)
+    Calling -> #(copy.refcheck_pill_calling, pill_navy)
+    Completed -> #(copy.refcheck_pill_received, pill_teal)
+  }
+}
+
+/// The in-flight label family (§4.2): Form opened (form link opened — the
+/// progress signal), Reminder sent (a reminder batch exists), else Invitation
+/// sent. The attempts batches (invite, co-nudge, reminder 1, reminder 2)
+/// position the row in the cadence: reminder 1 is batch 3.
+fn in_flight_label(call: ReferenceCallDetail) -> String {
+  case call.form_opened_at {
+    Some(_) -> copy.refcheck_pill_form_opened
+    None ->
+      case list.length(group_by_at(call.attempts)) >= 3 {
+        True -> copy.refcheck_pill_reminder_sent
+        False -> copy.refcheck_pill_invitation_sent
+      }
+  }
+}
+
+fn status_timestamp(call: ReferenceCallDetail) -> Option(String) {
+  case call.status {
+    ContactInitiated ->
+      case call.form_opened_at {
+        Some(ts) -> Some(format.format_timestamp_short(timestamp: ts))
+        None -> last_batch_at(call.attempts)
+      }
+    FormCompleted | ManualRecorded | Partial | Completed ->
+      case call.submitted_at {
+        Some(ts) -> Some(format.format_timestamp_short(timestamp: ts))
+        None -> None
+      }
+    _ -> None
+  }
+}
+
+/// The timestamp of the most recent attempt batch (the last send the referee
+/// received — the invite for a fresh row, the latest reminder otherwise).
+fn last_batch_at(attempts: List(ReferenceCallAttempt)) -> Option(String) {
+  case list.last(group_by_at(attempts)) {
+    Ok(#(at, _)) -> Some(format.format_timestamp_short(timestamp: at))
+    Error(_) -> None
+  }
+}
+
+const pill_teal: String = "bg-teal/10 text-teal"
+
+const pill_slate: String = "bg-slate/10 text-slate"
+
+const pill_navy: String = "bg-navy/10 text-navy"
+
+const pill_amber: String = "bg-amber/10 text-amber"
+
+// -- Row detail ---------------------------------------------------------------
+
+fn row_detail(call: ReferenceCallDetail, app: Application) -> Element(Msg) {
+  let first_name = app.first_name
+  case call.status {
+    Queued ->
+      html.p([class("text-sm text-slate leading-relaxed")], [
+        html.text(copy.refcheck_state_queued),
+      ])
+    Skipped ->
+      html.p([class("text-sm text-slate leading-relaxed")], [
+        html.text(copy.refcheck_state_skipped),
+      ])
+    AwaitingCorrection ->
+      html.p([class("text-sm text-amber leading-relaxed")], [
+        html.text(copy.refcheck_state_awaiting_correction(
+          referee_name(app, call.ref_slot),
+          first_name,
+        )),
+      ])
+    Unreachable ->
+      html.p([class("text-sm text-charcoal leading-relaxed")], [
+        html.text(copy.refcheck_state_unreachable(
+          referee_name(app, call.ref_slot),
+          first_name,
+        )),
+      ])
+    Refused ->
+      html.p([class("text-sm text-charcoal leading-relaxed")], [
+        html.text(copy.refcheck_state_refused(
+          referee_name(app, call.ref_slot),
+          first_name,
+        )),
+      ])
+    Objected ->
+      html.p([class("text-sm text-charcoal leading-relaxed")], [
+        html.text(copy.refcheck_state_objected(
+          referee_name(app, call.ref_slot),
+          first_name,
+        )),
+      ])
+    Failed ->
+      html.p([class("text-sm text-charcoal leading-relaxed")], [
+        html.text(copy.refcheck_state_failed(first_name)),
+      ])
+    ContactInitiated -> view_attempt_summary(call)
+    FormCompleted | ManualRecorded | Partial | Completed ->
+      view_completed(call, app)
+    // v2-reserved pre-result voice states: nothing to show until a result
+    // exists (the pill carries the state).
+    Scheduled | Calling -> element.none()
+  }
+}
+
+// -- Mini timeline (in-flight rows) -------------------------------------------
+
+/// What has happened so far (§7.4): the attempt batches (invite, co-nudge,
+/// reminders) rendered as a mini timeline, plus "what happens next" while a
+/// reminder is still pending. The attempts log is the payload's record of
+/// sends; batch positions are the cadence steps (batch 1 = invitation,
+/// batch 2 = the applicant co-nudge, batches 3+ = reminders).
+fn view_attempt_summary(call: ReferenceCallDetail) -> Element(Msg) {
+  let batches = group_by_at(call.attempts)
+  let batch_lines =
+    batches
+    |> list.index_map(fn(batch, i) { batch_line(i, batch) })
+  let lines =
+    case call.form_opened_at {
+      None -> batch_lines
+      Some(ts) -> [
+        TimelineLine(copy.refcheck_timeline_form_opened, ts),
+        ..batch_lines
+      ]
+    }
+    // Chronological by timestamp — the form can open AFTER a reminder (the
+    // link stays live), so the pinned-after-invite placement was wrong
+    // (rc4-2 Perkins r1 W4). All `at` values are UTC ISO strings (RFC3339
+    // from the sweep, PG `::text` for form_opened_at) — lexical sort is
+    // chronological.
+    |> list.sort(fn(a, b) { string.compare(a.at, b.at) })
+  let has_next_reminder = list.length(batches) < 4
+  html.div([class("space-y-2")], [
+    keyed.ul(
+      [attribute("role", "list"), class("space-y-1.5")],
+      list.map(lines, fn(line) {
+        #(
+          line.at <> "|" <> line.label,
+          html.li(
+            [attribute("role", "listitem"), class("flex items-start gap-2")],
+            [
+              html.span(
+                [
+                  class(
+                    "mt-1.5 w-1.5 h-1.5 rounded-full bg-amber flex-shrink-0",
+                  ),
+                ],
+                [],
+              ),
+              html.p([class("text-xs text-charcoal flex-1 min-w-0")], [
+                html.text(line.label),
+              ]),
+              html.time(
+                [
+                  // PG `::text` renders "2026-08-01 21:12:00+00" (space
+                  // separator — not valid HTML datetime); normalize to the
+                  // RFC3339 "T" separator (rc4-2 Perkins r1 N2).
+                  attribute("datetime", normalize_datetime(line.at)),
+                  class("text-xs text-slate flex-shrink-0"),
+                ],
+                [html.text(format.format_timestamp_short(timestamp: line.at))],
+              ),
+            ],
+          ),
+        )
+      }),
+    ),
+    case has_next_reminder {
+      True ->
+        html.p([class("text-xs text-slate")], [
+          html.text(copy.refcheck_what_happens_next),
+        ])
+      False -> element.none()
+    },
+  ])
+}
+
+type TimelineLine {
+  TimelineLine(label: String, at: String)
+}
+
+/// Normalize a timestamp for the HTML `datetime` attribute: RFC3339
+/// ("2026-08-01T10:04:00Z") passes through; Postgres `::text`
+/// ("2026-08-01 21:12:00+00") gets the space swapped for "T".
+fn normalize_datetime(at: String) -> String {
+  string.replace(at, " ", "T")
+}
+
+/// Label one attempt batch. Batch 1 is the invitation; batch 2 is the
+/// applicant co-nudge (single email — delivered, skipped on gate, or failed);
+/// batches 3+ are reminders. Channel names join into the "email + SMS" style.
+fn batch_line(
+  index: Int,
+  batch: #(String, List(ReferenceCallAttempt)),
+) -> TimelineLine {
+  let #(at, entries) = batch
+  let channels =
+    entries
+    |> list.map(fn(e) {
+      case e.channel {
+        "sms" -> copy.refcheck_channel_sms
+        _ -> copy.refcheck_channel_email
+      }
+    })
+    |> dedupe_keep_order
+    |> string.join(" + ")
+  let label = case index {
+    0 -> copy.refcheck_timeline_invitation
+    1 -> nudge_label(entries)
+    n -> copy.refcheck_timeline_reminder(n - 1)
+  }
+  TimelineLine(label <> " — " <> channels, at)
+}
+
+fn nudge_label(entries: List(ReferenceCallAttempt)) -> String {
+  case list.all(entries, fn(e) { e.outcome == "delivered" }) {
+    True -> copy.refcheck_timeline_nudge
+    False ->
+      case list.find(entries, fn(e) { e.outcome == "skipped" }) {
+        Ok(skipped) ->
+          copy.refcheck_timeline_nudge_skipped <> " — " <> skipped.detail
+        Error(_) -> copy.refcheck_timeline_nudge_failed
+      }
+  }
+}
+
+fn dedupe_keep_order(items: List(String)) -> List(String) {
+  list.fold(items, [], fn(acc, item) {
+    case list.contains(acc, item) {
+      True -> acc
+      // NB: `list.append`, not `++ [item]` — this gleam parser version
+      // rejects the `++` + list-literal combination (probe-verified).
+      False -> list.append(acc, [item])
+    }
+  })
+}
+
+/// Group the append-only attempts log into cadence batches by shared `at`
+/// (one sweep step stamps one timestamp for all its channel entries),
+/// preserving chronological order.
+fn group_by_at(
+  attempts: List(ReferenceCallAttempt),
+) -> List(#(String, List(ReferenceCallAttempt))) {
+  attempts
+  |> list.fold([], fn(groups, entry) {
+    case groups {
+      [] -> [#(entry.at, [entry])]
+      [#(at, entries), ..rest] if at == entry.at -> [
+        #(at, [entry, ..entries]),
+        ..rest
+      ]
+      _ -> [#(entry.at, [entry]), ..groups]
+    }
+  })
+  |> list.reverse
+  |> list.map(fn(group) {
+    let #(at, entries) = group
+    #(at, list.reverse(entries))
+  })
+}
+
+// -- Completed / partial reference summary ------------------------------------
+
+fn view_completed(call: ReferenceCallDetail, app: Application) -> Element(Msg) {
+  case call.result {
+    None -> element.none()
+    Some(text) ->
+      case json.parse(text, parsed_result_decoder()) {
+        Error(_) -> element.none()
+        Ok(parsed) -> view_parsed_summary(call, app, parsed)
+      }
+  }
+}
+
+fn view_parsed_summary(
+  call: ReferenceCallDetail,
+  app: Application,
+  parsed: ParsedResult,
+) -> Element(Msg) {
+  let slot = reference_call.encode_ref_slot(call.ref_slot)
+  let name = referee_name(app, call.ref_slot)
+  // The free-text renders as its own §9.3-flagged block below the table, so
+  // it stays OUT of the key-facts rows (§7.4's list doesn't include it) — but
+  // it still counts toward the partial line's answered/total.
+  let field_keys = slot_field_keys(slot)
+  let rows =
+    field_keys
+    |> list.filter(fn(key) { key != "free_text_signals" })
+    |> list.map(fn(key) {
+      #(
+        copy.refcheck_field_label(slot, key),
+        render_value(key, dict.get(parsed.verification, key)),
+      )
+    })
+    |> insert_relationship_other(parsed.verification, slot)
+  let free_text = free_text_value(parsed.verification)
+  let signals = worth_knowing_signals(parsed.fraud_signals)
+  html.div([class("space-y-4")], [
+    case call.status {
+      Partial ->
+        html.p([class("text-sm text-charcoal font-medium")], [
+          html.text(copy.refcheck_partial_line(
+            name: name,
+            answered: answered_count(parsed.verification, slot_count_keys(slot)),
+            total: list.length(slot_count_keys(slot)),
+          )),
+        ])
+      _ -> element.none()
+    },
+    case parsed.headline {
+      "" -> element.none()
+      headline ->
+        html.div([class("border-l-2 border-amber pl-4 py-1")], [
+          html.p([class("text-sm text-charcoal leading-relaxed")], [
+            html.text(headline),
+          ]),
+        ])
+    },
+    html.dl(
+      [class("grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3")],
+      list.map(rows, fn(row) {
+        let #(label, value) = row
+        html.div([class("min-w-0")], [
+          html.dt(
+            [
+              class(
+                "text-[10px] font-bold uppercase tracking-widest text-slate mb-0.5",
+              ),
+            ],
+            [html.text(label)],
+          ),
+          html.dd([class("text-sm text-charcoal font-medium break-words")], [
+            html.text(value),
+          ]),
+        ])
+      }),
+    ),
+    case free_text {
+      "" -> element.none()
+      text ->
+        html.div([class("bg-slate-50 rounded-lg p-3 space-y-1.5")], [
+          html.p(
+            [class("text-sm text-charcoal leading-relaxed whitespace-pre-wrap")],
+            [html.text(text)],
+          ),
+          html.p([class("text-xs text-slate")], [
+            html.text(copy.refcheck_unmoderated_flag),
+          ]),
+        ])
+    },
+    case parsed.notable_quotes {
+      [] -> element.none()
+      quotes ->
+        html.div(
+          [class("space-y-1.5")],
+          quotes
+            |> list.take(3)
+            |> list.map(fn(quote) {
+              html.blockquote(
+                [
+                  class(
+                    "text-sm text-charcoal italic leading-relaxed border-l-2 border-amber pl-4",
+                  ),
+                ],
+                [html.text(quote)],
+              )
+            }),
+        )
+    },
+    case signals {
+      [] -> element.none()
+      _ ->
+        html.div([class("border-l-2 border-amber-400 pl-4 space-y-1.5")], [
+          html.p([class("text-sm font-semibold text-charcoal")], [
+            html.text(copy.refcheck_worth_knowing_title),
+          ]),
+          html.p([class("text-xs text-slate")], [
+            html.text(copy.refcheck_worth_knowing_header),
+          ]),
+          html.div(
+            [class("space-y-1.5")],
+            signals
+              |> list.map(fn(signal) {
+                html.p([class("text-sm text-charcoal leading-relaxed")], [
+                  html.text(signal),
+                ])
+              }),
+          ),
+        ])
+    },
+    case parsed.confidence {
+      "" -> element.none()
+      level ->
+        html.p([class("text-xs text-slate")], [
+          html.text(copy.refcheck_confidence_line(level)),
+        ])
+    },
+    case call.display_disclaimer {
+      Some(disclaimer) ->
+        html.p([class("text-xs text-slate")], [html.text(disclaimer)])
+      None -> element.none()
+    },
+  ])
+}
+
+/// The canonical per-slot verification field order (result.gleam's §5.3 +
+/// A9 per-slot variants; `relationship_other` is inserted separately by
+/// `insert_relationship_other`, `free_text_signals` renders as its own
+/// flagged block, not a table row).
+fn slot_field_keys(slot: String) -> List(String) {
+  case slot {
+    "landlord_ref" -> [
+      "identity_confirmed",
+      "relationship_to_applicant",
+      "tenancy_confirmed",
+      "tenancy_period",
+      "rent_amount_confirmed",
+      "rent_payment_record",
+      "property_condition",
+      "notice_given_properly",
+      "deposit_returned",
+      "would_rent_again",
+      "free_text_signals",
+    ]
+    "employer_ref" -> [
+      "identity_confirmed",
+      "relationship_to_applicant",
+      "works_at_confirmed",
+      "employment_period",
+      "role_confirmed",
+      "salary_confirmed",
+      "would_rehire",
+      "free_text_signals",
+    ]
+    "character_ref" -> [
+      "identity_confirmed",
+      "relationship",
+      "capacity",
+      "known_duration",
+      "character_statement",
+      "would_stand_again",
+      "free_text_signals",
+    ]
+    _ -> []
+  }
+}
+
+/// The fields that count toward "answered {m} of {n}" (the partial line).
+/// Same as the display set, except the character slot's `free_text_signals`
+/// — the character form never asks it, so it can't be one of the "questions"
+/// (rc4-2 Perkins r1 W7). Landlord/employer free text IS a question (q11/q8).
+fn slot_count_keys(slot: String) -> List(String) {
+  case slot {
+    "character_ref" -> [
+      "identity_confirmed",
+      "relationship",
+      "capacity",
+      "known_duration",
+      "character_statement",
+      "would_stand_again",
+    ]
+    _ -> slot_field_keys(slot)
+  }
+}
+
+/// How many of the slot's fields carry an answer (the partial line's m).
+/// Mirrors the structurer's completeness notion: a field is answered when
+/// its verification value is a non-null string or object; the free-text
+/// array counts only when non-empty.
+/// How many of the slot's fields carry an answer (the partial line's m).
+/// The count mirrors the RENDERER exactly (a field counts when it renders
+/// something other than "Not answered") — so a content-less object can never
+/// inflate m (rc4-2 Perkins r1 N7). The character slot's count set excludes
+/// `free_text_signals` — the character form never asks it (AD-9 shape
+/// completeness), so it can't be part of "questions asked" (W7).
+fn answered_count(
+  verification: Dict(String, Dynamic),
+  field_keys: List(String),
+) -> Int {
+  field_keys
+  |> list.count(fn(key) {
+    render_value(key, dict.get(verification, key)) != copy.refcheck_not_answered
+  })
+}
+
+/// The referee's verbatim "Other" text (`relationship_other`) rides
+/// alongside `relationship == "other"`; render it as its own row so the
+/// custom answer isn't dropped (rc4-2 Perkins r1 W3). Inserted right after
+/// the Relationship row; no row when absent.
+fn insert_relationship_other(
+  rows: List(#(String, String)),
+  verification: Dict(String, Dynamic),
+  slot: String,
+) -> List(#(String, String)) {
+  case
+    render_value(
+      "relationship_other",
+      dict.get(verification, "relationship_other"),
+    )
+  {
+    text if text == copy.refcheck_not_answered -> rows
+    text ->
+      list.fold(rows, [], fn(acc, row) {
+        let #(label, _) = row
+        case
+          label == copy.refcheck_field_label(slot, "relationship_to_applicant")
+        {
+          True ->
+            list.append(acc, [
+              row,
+              #(copy.refcheck_field_label(slot, "relationship_other"), text),
+            ])
+          False -> list.append(acc, [row])
+        }
+      })
+  }
+}
+
+/// The free-text answer: `free_text_signals` is an array holding the
+/// referee's verbatim text ([] when absent). Returns "" when unanswered.
+fn free_text_value(verification: Dict(String, Dynamic)) -> String {
+  case dict.get(verification, "free_text_signals") {
+    Error(_) -> ""
+    Ok(value) ->
+      case decode.run(value, decode.list(decode.string)) {
+        Ok(items) ->
+          case items {
+            [text, ..] -> text
+            [] -> ""
+          }
+        Error(_) -> ""
+      }
+  }
+}
+
+/// Render one verification field's value in words. Unanswered (null, or a
+/// value of an unexpected shape) renders "Not answered" — never hidden,
+/// never guessed (§7.4).
+fn render_value(key: String, value: Result(Dynamic, Nil)) -> String {
+  case value {
+    Error(_) -> copy.refcheck_not_answered
+    Ok(dynamic_value) ->
+      case decode.run(dynamic_value, decode.optional(decode.string)) {
+        Ok(None) -> copy.refcheck_not_answered
+        Ok(Some(s)) -> copy.refcheck_choice_word(s)
+        Error(_) ->
+          case
+            decode.run(
+              dynamic_value,
+              decode.dict(decode.string, decode.dynamic),
+            )
+          {
+            Ok(obj) -> render_object_value(key, obj)
+            Error(_) ->
+              // JSON arrays decode as List(Dynamic), not dicts — the
+              // free-text array is the only array-shaped verification value.
+              case decode.run(dynamic_value, decode.list(decode.string)) {
+                Ok(items) ->
+                  case items {
+                    [text, ..] -> text
+                    [] -> copy.refcheck_not_answered
+                  }
+                Error(_) -> copy.refcheck_not_answered
+              }
+          }
+      }
+  }
+}
+
+fn render_object_value(key: String, obj: Dict(String, Dynamic)) -> String {
+  case key {
+    "tenancy_period" -> render_period(obj)
+    "rent_amount_confirmed" -> render_amount(obj)
+    "employment_period" | "role_confirmed" -> render_as_stated_text(obj)
+    "salary_confirmed" -> render_as_stated_amount(obj)
+    _ -> copy.refcheck_not_answered
+  }
+}
+
+/// {from, to} | {from, ongoing: true} — rendered as "Jan 2023 to Dec 2024"
+/// or "Jan 2023 to ongoing". Unanswered when either side is missing.
+fn render_period(obj: Dict(String, Dynamic)) -> String {
+  case obj_string(obj, "from") {
+    "" -> copy.refcheck_not_answered
+    from ->
+      case obj_bool(obj, "ongoing") {
+        True ->
+          copy.refcheck_month_year(from) <> " to " <> copy.refcheck_to_ongoing
+        False ->
+          case obj_string(obj, "to") {
+            "" -> copy.refcheck_not_answered
+            to ->
+              copy.refcheck_month_year(from)
+              <> " to "
+              <> copy.refcheck_month_year(to)
+          }
+      }
+  }
+}
+
+/// {amount_eur} | {dont_remember} | null — "€1,400" / "Don't remember".
+fn render_amount(obj: Dict(String, Dynamic)) -> String {
+  case obj_string(obj, "amount_eur") {
+    "" ->
+      case obj_bool(obj, "dont_remember") {
+        True -> copy.refcheck_dont_remember
+        False -> copy.refcheck_not_answered
+      }
+    amount -> euros(amount)
+  }
+}
+
+/// {as_stated} | {differs: text} | {stated: text} | null.
+fn render_as_stated_text(obj: Dict(String, Dynamic)) -> String {
+  case obj_bool(obj, "as_stated") {
+    True -> copy.refcheck_as_stated
+    False ->
+      case obj_string(obj, "differs") {
+        "" ->
+          case obj_string(obj, "stated") {
+            "" -> copy.refcheck_not_answered
+            stated -> stated
+          }
+        differs -> differs
+      }
+  }
+}
+
+/// {as_stated} | {different_amount_eur} | {dont_know} | null.
+fn render_as_stated_amount(obj: Dict(String, Dynamic)) -> String {
+  case obj_bool(obj, "as_stated") {
+    True -> copy.refcheck_as_stated
+    False ->
+      case obj_string(obj, "different_amount_eur") {
+        "" ->
+          case obj_bool(obj, "dont_know") {
+            True -> copy.refcheck_dont_know
+            False -> copy.refcheck_not_answered
+          }
+        amount -> euros(amount)
+      }
+  }
+}
+
+/// "1400" (euros, as the form stores it) -> "€1,400".
+fn euros(amount: String) -> String {
+  case int.parse(amount) {
+    Ok(euros_int) -> format.format_currency(cents: euros_int * 100)
+    Error(_) -> "€" <> amount
+  }
+}
+
+fn obj_string(obj: Dict(String, Dynamic), key: String) -> String {
+  case dict.get(obj, key) {
+    Error(_) -> ""
+    Ok(value) ->
+      case decode.run(value, decode.string) {
+        Ok(s) -> s
+        Error(_) -> ""
+      }
+  }
+}
+
+fn obj_bool(obj: Dict(String, Dynamic), key: String) -> Bool {
+  case dict.get(obj, key) {
+    Error(_) -> False
+    Ok(value) ->
+      case decode.run(value, decode.bool) {
+        Ok(b) -> b
+        Error(_) -> False
+      }
+  }
+}
+
+// -- "Worth knowing" (§7.5) ---------------------------------------------------
+
+/// The fraud-signal block, rendered ONLY when the payload carries ≥1 signal
+/// (AD-10 honesty: no signal, no invented signal). The `flags`/`geo` rows of
+/// the §7.5 table that v1 never emits (no flags field; geo is always
+/// "unknown") map here too, so a future payload fires them honestly.
+fn worth_knowing_signals(fraud_signals: Option(Dynamic)) -> List(String) {
+  case fraud_signals {
+    None -> []
+    Some(value) ->
+      case decode.run(value, signals_decoder()) {
+        Error(_) -> []
+        Ok(signals) ->
+          [
+            case signals.completion_seconds {
+              Some(seconds) if seconds < 120 ->
+                Some(copy.refcheck_signal_fast_completion)
+              _ -> None
+            },
+            case
+              signals.ip_matches_applicant,
+              signals.device_fingerprint_match
+            {
+              Some(True), _ | _, Some(True) ->
+                Some(copy.refcheck_signal_same_device)
+              _, _ -> None
+            },
+            case signals.geo_vs_claimed_property {
+              "inconsistent" -> Some(copy.refcheck_signal_geo_mismatch)
+              _ -> None
+            },
+            case signals.voip_or_burner {
+              True -> Some(copy.refcheck_signal_voip)
+              False -> None
+            },
+            case signals.contact_duplicate_of_applicant {
+              True -> Some(copy.refcheck_signal_duplicate_of_applicant)
+              False -> None
+            },
+            case signals.contact_reused_within_application {
+              True -> Some(copy.refcheck_signal_reused_within_application)
+              False -> None
+            },
+            case signals.contact_reused_across_applications {
+              True -> Some(copy.refcheck_signal_reused_across_applications)
+              False -> None
+            },
+          ]
+          |> list.filter_map(fn(s) {
+            case s {
+              Some(text) -> Ok(text)
+              None -> Error(Nil)
+            }
+          })
+      }
+  }
+}
+
+type Signals {
+  Signals(
+    completion_seconds: Option(Int),
+    ip_matches_applicant: Option(Bool),
+    device_fingerprint_match: Option(Bool),
+    geo_vs_claimed_property: String,
+    voip_or_burner: Bool,
+    contact_duplicate_of_applicant: Bool,
+    contact_reused_within_application: Bool,
+    contact_reused_across_applications: Bool,
+  )
+}
+
+fn signals_decoder() -> decode.Decoder(Signals) {
+  use form_session <- decode.optional_field(
+    "form_session",
+    None,
+    decode.optional(form_session_decoder()),
+  )
+  use geo_vs_claimed_property <- decode.optional_field(
+    "geo_vs_claimed_property",
+    "",
+    decode.string,
+  )
+  use voip_or_burner <- decode.optional_field(
+    "voip_or_burner",
+    False,
+    decode.bool,
+  )
+  use contact_duplicate_of_applicant <- decode.optional_field(
+    "contact_duplicate_of_applicant",
+    False,
+    decode.bool,
+  )
+  use contact_reused_within_application <- decode.optional_field(
+    "contact_reused_within_application",
+    False,
+    decode.bool,
+  )
+  use contact_reused_across_applications <- decode.optional_field(
+    "contact_reused_across_applications",
+    False,
+    decode.bool,
+  )
+  let completion_seconds = case form_session {
+    None -> None
+    Some(session) -> session.completion_seconds
+  }
+  let ip_matches_applicant = case form_session {
+    None -> None
+    Some(session) -> session.ip_matches_applicant
+  }
+  let device_fingerprint_match = case form_session {
+    None -> None
+    Some(session) -> session.device_fingerprint_match
+  }
+  decode.success(Signals(
+    completion_seconds:,
+    ip_matches_applicant:,
+    device_fingerprint_match:,
+    geo_vs_claimed_property:,
+    voip_or_burner:,
+    contact_duplicate_of_applicant:,
+    contact_reused_within_application:,
+    contact_reused_across_applications:,
+  ))
+}
+
+/// The `form_session` sub-block (AD-10): completion seconds + the two
+/// derived-match booleans. The raw referee IP/UA were stripped at the RC4.1
+/// read boundary and never reach the client.
+type FormSession {
+  FormSession(
+    completion_seconds: Option(Int),
+    ip_matches_applicant: Option(Bool),
+    device_fingerprint_match: Option(Bool),
+  )
+}
+
+fn form_session_decoder() -> decode.Decoder(FormSession) {
+  use completion_seconds <- decode.optional_field(
+    "completion_seconds",
+    None,
+    decode.optional(decode.int),
+  )
+  use ip_matches_applicant <- decode.optional_field(
+    "ip_matches_applicant",
+    None,
+    decode.optional(decode.bool),
+  )
+  use device_fingerprint_match <- decode.optional_field(
+    "device_fingerprint_match",
+    None,
+    decode.optional(decode.bool),
+  )
+  decode.success(FormSession(
+    completion_seconds:,
+    ip_matches_applicant:,
+    device_fingerprint_match:,
+  ))
+}
+
+// -- Result parsing -----------------------------------------------------------
+
+type ParsedResult {
+  ParsedResult(
+    verification: Dict(String, Dynamic),
+    headline: String,
+    confidence: String,
+    notable_quotes: List(String),
+    fraud_signals: Option(Dynamic),
+  )
+}
+
+fn parsed_result_decoder() -> decode.Decoder(ParsedResult) {
+  use verification <- decode.optional_field(
+    "verification",
+    dict.new(),
+    decode.dict(decode.string, decode.dynamic),
+  )
+  use ai_summary <- decode.optional_field(
+    "ai_summary",
+    None,
+    decode.optional(ai_summary_decoder()),
+  )
+  use fraud_signals <- decode.optional_field(
+    "fraud_signals",
+    None,
+    decode.optional(decode.dynamic),
+  )
+  let headline = case ai_summary {
+    None -> ""
+    Some(summary) -> summary.headline
+  }
+  let confidence = case ai_summary {
+    None -> ""
+    Some(summary) -> summary.confidence
+  }
+  let notable_quotes = case ai_summary {
+    None -> []
+    Some(summary) -> summary.notable_quotes
+  }
+  decode.success(ParsedResult(
+    verification:,
+    headline:,
+    confidence:,
+    notable_quotes:,
+    fraud_signals:,
+  ))
+}
+
+type AiSummary {
+  AiSummary(headline: String, confidence: String, notable_quotes: List(String))
+}
+
+fn ai_summary_decoder() -> decode.Decoder(AiSummary) {
+  use headline <- decode.optional_field("headline", "", decode.string)
+  use confidence <- decode.optional_field("confidence", "", decode.string)
+  use notable_quotes <- decode.optional_field(
+    "notable_quotes",
+    [],
+    decode.list(decode.string),
+  )
+  decode.success(AiSummary(headline:, confidence:, notable_quotes:))
+}
