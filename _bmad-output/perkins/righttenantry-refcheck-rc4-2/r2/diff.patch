+
+/// First occurrence of a needle in the serialized HTML (the timeline-ordering
+/// assertion needs positions, not just presence).
+fn first_index(haystack: String, needle: String) -> Int {
+  search_index(haystack, needle, 0)
+}
+
+fn search_index(haystack: String, needle: String, from: Int) -> Int {
+  let h = string.length(haystack)
+  let n = string.length(needle)
+  case from + n > h {
+    True -> -1
+    False ->
+      case string.slice(haystack, from, n) == needle {
+        True -> from
+        False -> search_index(haystack, needle, from + 1)
+      }
+  }
+}
