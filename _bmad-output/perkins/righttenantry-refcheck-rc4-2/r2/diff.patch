+/// Timeline stays chronological when the form opens after a reminder — the
+/// link stays live, so Form-opened can post-date Reminder 1 (Perkins r1 W4).
+pub fn timeline_orders_form_opened_after_reminder_test() {
+  let attempts = [
+    invite_attempt(),
+    sms_attempt(),
+    reference_call.ReferenceCallAttempt(
+      at: "2026-08-02T10:00:00Z",
+      channel: "email",
+      outcome: "delivered",
+      detail: "",
+    ),
+    ..reminder_batch("2026-08-03T10:00:00Z")
+  ]
+  let call =
+    reference_call.ReferenceCallDetail(
+      ..row("rc-1", ContactInitiated, None, attempts),
+      form_opened_at: Some("2026-08-03T18:00:00Z"),
+    )
+  let html =
+    render(calls: [call], off: False, attestation_on_file: False, expanded: [
+      "rc-1",
+    ])
+  // Named bindings (not a `(`-starting line — Gleam would continue the
+  // `let html =` expression into a call).
+  // Pin the TIMELINE lines (</p>), not the status pill (</span>) — the pill
+  // for this row is also "Form opened" and sits above the timeline in the DOM.
+  let invite = first_index(html, "Invitation sent</p>")
+  let reminder = first_index(html, "Reminder 1 sent — ")
+  let opened = first_index(html, "Form opened</p>")
+  // Bind the comparisons first — a line starting with `(` would continue
+  // the previous let-expression (Gleam line-continuation), and `|>` binds
+  // tighter than `<` in this version.
+  let invite_before_reminder = invite < reminder
+  let reminder_before_opened = reminder < opened
+  invite_before_reminder |> should.be_true
+  reminder_before_opened |> should.be_true
+}
