+/// A landlord-slotted row; status/result/attempts vary per test.
+fn row(
+  id id: String,
+  status status: ReferenceCallStatus,
+  result result: Option(String),
+  attempts attempts: List(ReferenceCallAttempt),
+) -> ReferenceCallDetail {
+  reference_call.ReferenceCallDetail(
+    reference_call_id: id,
+    ref_slot: LandlordRef,
+    owner_label: reference_call.Primary,
+    status: status,
+    outcome: None,
+    attempt_count: list.length(attempts),
+    next_attempt_at: None,
+    form_opened_at: None,
+    submitted_at: None,
+    attempts: attempts,
+    result: result,
+    display_disclaimer: None,
+    // Hooks mirror the server's terminal rule (can_record_manual =
+    // !terminal) so the panel's hook-driven terminality reads realistic
+    // fixtures.
+    hooks: reference_call.ReferenceCallHooks(
+      can_record_manual: !is_terminal_status(status),
+      can_substitute_referee: False,
+      can_retry: False,
+    ),
+  )
+}
+
+fn is_terminal_status(status: ReferenceCallStatus) -> Bool {
+  case status {
+    FormCompleted
+    | ManualRecorded
+    | Partial
+    | Unreachable
+    | Refused
+    | Objected
+    | Failed
+    | reference_call.Completed -> True
+    _ -> False
+  }
+}
