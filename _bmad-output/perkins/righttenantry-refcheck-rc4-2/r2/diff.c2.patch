+
+// -- Reference panel (RC4.2) handler tests ------------------------------------
+
+fn refcheck_call(
+  id: String,
+  status: reference_call.ReferenceCallStatus,
+) -> reference_call.ReferenceCallDetail {
+  reference_call.ReferenceCallDetail(
+    reference_call_id: id,
+    ref_slot: reference_call.LandlordRef,
+    owner_label: reference_call.Primary,
+    status: status,
+    outcome: option.None,
+    attempt_count: 0,
+    next_attempt_at: option.None,
+    form_opened_at: option.None,
+    submitted_at: option.None,
+    attempts: [],
+    result: option.None,
+    display_disclaimer: option.None,
+    hooks: reference_call.ReferenceCallHooks(
+      can_record_manual: True,
+      can_substitute_referee: False,
+      can_retry: False,
+    ),
+  )
+}
+
+/// Row toggle: expanding adds the call id to the set; collapsing removes it.
+pub fn refcheck_toggle_row_expands_and_collapses_test() {
+  let m = model.Model(..model.initial(), refcheck_expanded: set.new())
+  let #(expanded, _eff) = client.update(m, msg.UserToggledRefcheckRow("rc-1"))
+  expanded.refcheck_expanded |> set.contains("rc-1") |> should.be_true
+  let #(collapsed, _eff2) =
+    client.update(expanded, msg.UserToggledRefcheckRow("rc-1"))
+  collapsed.refcheck_expanded |> set.contains("rc-1") |> should.be_false
+}
+
+/// Collapsing the explainer records the §7.3 per-user dismissed state;
+/// re-opening never un-dismisses.
+pub fn refcheck_explainer_toggle_records_dismissal_test() {
+  let m =
+    model.Model(
+      ..model.initial(),
+      refcheck_explainer_open: True,
+      refcheck_explainer_dismissed: False,
+    )
+  let #(closed, _eff) = client.update(m, msg.UserToggledRefcheckExplainer)
+  closed.refcheck_explainer_open |> should.be_false
+  closed.refcheck_explainer_dismissed |> should.be_true
+  // Re-opening keeps the dismissal on record.
+  let #(reopened, _eff2) =
+    client.update(closed, msg.UserToggledRefcheckExplainer)
+  reopened.refcheck_explainer_open |> should.be_true
+  reopened.refcheck_explainer_dismissed |> should.be_true
+}
+
+/// Hydration of the persisted dismissal lands in the model.
+pub fn refcheck_explainer_hydration_lands_in_model_test() {
+  let m = model.initial()
+  let #(updated, _eff) =
+    client.update(m, msg.UserHydratedRefcheckExplainerDismissed(True))
+  updated.refcheck_explainer_dismissed |> should.be_true
+}
+
+/// First view of an application auto-expands rows carrying a summary
+/// (received / manual-recorded / partial) and marks the application so a
+/// return visit renders collapsed.
+pub fn refcheck_first_view_auto_expands_completed_rows_test() {
+  let detail =
+    application_detail.ApplicationDetail(..test_detail(), reference_calls: [
+      refcheck_call("rc-1", reference_call.FormCompleted),
+      refcheck_call("rc-2", reference_call.Queued),
+    ])
+  let m =
+    model.Model(
+      ..model.initial(),
+      application_detail_request_id: option.Some("uuid-app-1"),
+    )
+  let #(updated, _eff) =
+    client.update(m, msg.ApiReturnedApplicationDetail(Ok(detail)))
+  updated.refcheck_expanded |> set.contains("rc-1") |> should.be_true
+  updated.refcheck_expanded |> set.contains("rc-2") |> should.be_false
+  updated.refcheck_auto_expanded
+  |> set.contains("uuid-app-1")
+  |> should.be_true
+}
+
+/// A first view with NOTHING expandable consumes nothing — a later visit
+/// after a completion still gets the first-view expand (Perkins r1 N8).
+pub fn refcheck_auto_expand_not_consumed_without_summary_rows_test() {
+  let detail =
+    application_detail.ApplicationDetail(..test_detail(), reference_calls: [
+      refcheck_call("rc-1", reference_call.Queued),
+    ])
+  let m =
+    model.Model(
+      ..model.initial(),
+      application_detail_request_id: option.Some("uuid-app-1"),
+    )
+  let #(updated, _eff) =
+    client.update(m, msg.ApiReturnedApplicationDetail(Ok(detail)))
+  updated.refcheck_auto_expanded
+  |> set.contains("uuid-app-1")
+  |> should.be_false
+}
+
+/// Route change to a new applicant resets the expanded set (and the explainer
+/// view state) so rows don't leak across applicants; the auto-expanded marker
+/// survives so a return visit renders collapsed.
+pub fn refcheck_route_change_resets_expanded_rows_test() {
+  let m =
+    model.Model(
+      ..model.initial(),
+      refcheck_expanded: set.from_list(["rc-1"]),
+      refcheck_auto_expanded: set.from_list(["aid-1"]),
+      refcheck_explainer_open: True,
+      route: routes.ApplicationDetail("v1", "aid-1"),
+    )
+  let uri =
+    uri.Uri(
+      scheme: option.Some("http"),
+      userinfo: option.None,
+      host: option.Some("localhost"),
+      port: option.None,
+      path: "/vacancies/v1/applications/aid-2",
+      query: option.None,
+      fragment: option.None,
+    )
+  let #(updated, _eff) = client.update(m, msg.BrowserChangedUrl(uri))
+  updated.refcheck_expanded |> should.equal(set.new())
+  updated.refcheck_explainer_open |> should.be_false
+  updated.refcheck_auto_expanded |> set.contains("aid-1") |> should.be_true
+}
