+//// Reference panel tests (RC4.2) — the 12-state matrix, the §7.4/§7.5 copy
+//// verbatim, the completed-reference summary with honest framing, the Off
+//// state, and the a11y contract (role="region", aria-expanded, status never
+//// colour-only).
+////
+//// Assertion style per the field notes: Lustre's SERIALIZED render — pinned
+//// `data-testid="..."` strings, `&#39;` for apostrophes, attributes sorted.
+
+import components/reference_panel
+import copy
+import gleam/list
+import gleam/option.{type Option, None, Some}
+import gleam/set
+import gleam/string
+import gleeunit/should
+import lustre/element
+import shared/application.{type Application}
+import shared/reference_call.{
+  type ReferenceCallAttempt, type ReferenceCallDetail, type ReferenceCallStatus,
+  AwaitingCorrection, CharacterRef, ContactInitiated, EmployerRef, Failed,
+  FormCompleted, LandlordRef, ManualRecorded, Objected, Partial, Queued, Refused,
+  Skipped, Unreachable,
+}
+
+// -- Fixtures -----------------------------------------------------------------
+
+/// A landlord-slotted row; status/result/attempts vary per test.
+fn row(
+  id id: String,
+  status status: ReferenceCallStatus,
+  result result: Option(String),
+  attempts attempts: List(ReferenceCallAttempt),
+) -> ReferenceCallDetail {
+  reference_call.ReferenceCallDetail(
+    reference_call_id: id,
+    ref_slot: LandlordRef,
+    owner_label: reference_call.Primary,
+    status: status,
+    outcome: None,
+    attempt_count: list.length(attempts),
+    next_attempt_at: None,
+    form_opened_at: None,
+    submitted_at: None,
+    attempts: attempts,
+    result: result,
+    display_disclaimer: None,
+    // Hooks mirror the server's terminal rule (can_record_manual =
+    // !terminal) so the panel's hook-driven terminality reads realistic
+    // fixtures.
+    hooks: reference_call.ReferenceCallHooks(
+      can_record_manual: !is_terminal_status(status),
+      can_substitute_referee: False,
+      can_retry: False,
+    ),
+  )
+}
+
+fn is_terminal_status(status: ReferenceCallStatus) -> Bool {
+  case status {
+    FormCompleted
+    | ManualRecorded
+    | Partial
+    | Unreachable
+    | Refused
+    | Objected
+    | Failed
+    | reference_call.Completed -> True
+    _ -> False
+  }
+}
+
+fn invite_attempt() -> ReferenceCallAttempt {
+  reference_call.ReferenceCallAttempt(
+    at: "2026-08-01T10:04:00Z",
+    channel: "email",
+    outcome: "delivered",
+    detail: "",
+  )
+}
+
+fn sms_attempt() -> ReferenceCallAttempt {
+  reference_call.ReferenceCallAttempt(
+    at: "2026-08-01T10:04:00Z",
+    channel: "sms",
+    outcome: "delivered",
+    detail: "",
+  )
+}
+
+fn reminder_batch(at: String) -> List(ReferenceCallAttempt) {
+  [
+    reference_call.ReferenceCallAttempt(
+      at:,
+      channel: "email",
+      outcome: "delivered",
+      detail: "",
+    ),
+    reference_call.ReferenceCallAttempt(
+      at:,
+      channel: "sms",
+      outcome: "delivered",
+      detail: "",
+    ),
+  ]
+}
+
+/// The stored result for a completed landlord reference: full verification
+/// (the wire values the structurer emits), deterministic ai_summary, honest
+/// fraud_signals, per §6.2 (RC4.1-stripped shape).
+fn completed_result() -> String {
+  "{\"schema_version\":\"refcall-v1\",\"channel\":\"form\",\"outcome\":\"form_completed\",\"attempts\":[{\"at\":\"2026-08-01T10:04:00Z\",\"channel\":\"email\",\"outcome\":\"delivered\",\"detail\":\"\"}],\"verification\":{\"identity_confirmed\":\"yes\",\"relationship_to_applicant\":\"their_landlord\",\"tenancy_confirmed\":\"yes\",\"tenancy_period\":{\"from\":\"2023-01\",\"to\":\"2024-12\"},\"rent_amount_confirmed\":{\"amount_eur\":\"1400\"},\"rent_payment_record\":\"always_on_time\",\"property_condition\":\"good\",\"notice_given_properly\":\"yes\",\"deposit_returned\":\"in_full\",\"would_rent_again\":\"yes\",\"free_text_signals\":[\"They kept the garden lovely.\"]},\"fraud_signals\":{\"contact_reused_within_application\":false,\"contact_duplicate_of_applicant\":false,\"contact_reused_across_applications\":false,\"line_type\":\"mobile\",\"voip_or_burner\":false,\"form_session\":{\"completion_seconds\":95,\"ip_matches_applicant\":false,\"device_fingerprint_match\":false},\"geo_vs_claimed_property\":\"unknown\",\"coached_answer_score\":null},\"ai_summary\":{\"headline\":\"Tenancy confirmed; rent always on time.\",\"summary\":\"Identity confirmed. Payment record: always on time. Property: good.\",\"confidence\":\"high\"}}"
+}
+
+fn test_application() -> Application {
+  application.Application(
+    id: "uuid-app-1",
+    vacancy_id: "uuid-vac-1",
+    first_name: "Jane",
+    last_name: "Doe",
+    email: "jane@example.com",
+    phone: Some("+353851234567"),
+    current_address: Some("42 Oak Lane"),
+    current_city: Some("Dublin"),
+    current_county: Some("Dublin"),
+    eircode: Some("D02 XY45"),
+    current_living_situation: Some("Renting"),
+    reason_for_moving: Some("Closer to work"),
+    employment_status: "employed",
+    employer_name: Some("Acme Corp"),
+    job_title: Some("Software Engineer"),
+    employment_duration: Some("3 years"),
+    monthly_income_cents: 350_000,
+    landlord_ref_name: Some("Colm Byrne"),
+    landlord_ref_phone: Some("+353871111111"),
+    landlord_ref_email: Some("colm@example.com"),
+    employer_ref_name: Some("Sarah Daly"),
+    employer_ref_phone: Some("+353872222222"),
+    employer_ref_email: Some("sarah@example.com"),
+    num_occupants: Some(2),
+    has_pets: "no",
+    pet_details: None,
+    is_smoker: False,
+    has_eviction_history: False,
+    eviction_details: None,
+    has_ccjs: False,
+    desired_move_in_date: Some("2026-05-01"),
+    listing_source: Some("daft.ie"),
+    personal_statement: Some("I am a reliable tenant"),
+    status: application.Viewed,
+    created_at: "2026-03-29T00:00:00Z",
+    never_rented_before: False,
+    character_ref_name: None,
+    character_ref_phone: None,
+    character_ref_email: None,
+    has_guarantor: False,
+    guarantor_name: None,
+    guarantor_relationship: None,
+    guarantor_phone: None,
+    guarantor_email: None,
+    guarantor_monthly_income_cents: None,
+    guarantor_employer: None,
+    reference_contact_choice: Some("attested"),
+    household_monthly_income_cents: 350_000,
+    co_applicant_count: 0,
+  )
+}
+
+fn render(
+  calls calls: List(ReferenceCallDetail),
+  off off: Bool,
+  attestation_on_file attestation_on_file: Bool,
+  expanded expanded: List(String),
+) -> String {
+  reference_panel.view(
+    calls: calls,
+    off: off,
+    attestation_on_file: attestation_on_file,
+    app: test_application(),
+    expanded: set.from_list(expanded),
+    explainer_open: False,
+  )
+  |> element.to_string
+}
+
+fn render_explainer_open(calls: List(ReferenceCallDetail)) -> String {
+  reference_panel.view(
+    calls: calls,
+    off: False,
+    attestation_on_file: True,
+    app: test_application(),
+    expanded: set.new(),
+    explainer_open: True,
+  )
+  |> element.to_string
+}
+
+// -- Card visibility ----------------------------------------------------------
+
+/// Pre-v1 application (no attestation choice, no rows) renders nothing —
+/// the counsel posture for `attestation_on_file: false` (§11 Q5).
+pub fn card_hidden_for_pre_v1_without_rows_test() {
+  let html =
+    render(calls: [], off: False, attestation_on_file: False, expanded: [])
+  html |> string.contains("refcheck-card") |> should.be_false
+}
+
+/// Declined attestation renders the card even with zero rows (the Off block
+/// is the manual-flow surface).
+pub fn card_visible_when_attestation_declined_test() {
+  let html =
+    render(calls: [], off: True, attestation_on_file: False, expanded: [])
+  html |> string.contains("data-testid=\"refcheck-card\"") |> should.be_true
+}
+
+/// Attested + no rows yet = pre-trigger: A5 sub-line + explainer, heading
+/// with the honest count (0).
+pub fn pre_trigger_renders_a5_subline_test() {
+  let html =
+    render(calls: [], off: False, attestation_on_file: True, expanded: [])
+  html |> string.contains("data-testid=\"refcheck-card\"") |> should.be_true
+  html |> string.contains("Reference Checks (0)") |> should.be_true
+  html
+  |> string.contains("Starts automatically when you mark the viewing as done.")
+  |> should.be_true
+  html
+  |> string.contains("We invite, remind, and nudge")
+  |> should.be_false
+}
+
+// -- Panel chrome -------------------------------------------------------------
+
+/// Card is a region with the §12 aria-label; the explainer is collapsed by
+/// default.
+pub fn card_region_and_collapsed_explainer_test() {
+  let html =
+    render(
+      [row("rc-1", Queued, None, [])],
+      off: False,
+      attestation_on_file: False,
+      expanded: [],
+    )
+  html |> string.contains("role=\"region\"") |> should.be_true
+  html |> string.contains("aria-label=\"Reference checks\"") |> should.be_true
+  html |> string.contains("What this tells you") |> should.be_true
+  html
+  |> string.contains("A completed reference means the person")
+  |> should.be_false
+}
+
+/// Opening the explainer shows the §7.8 body verbatim (name interpolated).
+pub fn explainer_body_verbatim_when_open_test() {
+  let html = render_explainer_open([row("rc-1", Queued, None, [])])
+  html
+  |> string.contains("A completed reference means the person")
+  |> should.be_true
+  html
+  |> string.contains("the contact details Jane gave confirmed the facts shown")
+  |> should.be_true
+  html
+  |> string.contains("Nobody is called, and nothing is recorded.")
+  |> should.be_true
+}
+
+/// In-flight sub-line once a row exists but nothing is terminal.
+pub fn in_flight_subline_test() {
+  let html =
+    render(
+      [row("rc-1", ContactInitiated, None, [invite_attempt(), sms_attempt()])],
+      off: False,
+      attestation_on_file: False,
+      expanded: [],
+    )
+  html
+  |> string.contains("We invite, remind, and nudge — you watch it happen.")
+  |> should.be_true
+}
+
+/// All-terminal sub-line.
+pub fn all_terminal_subline_test() {
+  let html =
+    render(
+      calls: [row("rc-1", FormCompleted, Some(completed_result()), [])],
+      off: False,
+      attestation_on_file: False,
+      expanded: [],
+    )
+  html
+  |> string.contains("All references closed. Summaries and logs stay here.")
+  |> should.be_true
+}
+
+// -- The 12-state matrix ------------------------------------------------------
+
+/// Queued: slate pill, A5 row line on expand, no timestamp (nothing sent).
+pub fn queued_state_test() {
+  let html =
+    render(
+      [row("rc-1", Queued, None, [])],
+      off: False,
+      attestation_on_file: False,
+      expanded: ["rc-1"],
+    )
+  html |> string.contains("refcheck-row-landlord_ref") |> should.be_true
+  html |> string.contains("refcheck-status-landlord_ref") |> should.be_true
+  html |> string.contains("refcheck-expand-landlord_ref") |> should.be_true
+  html |> string.contains("Queued") |> should.be_true
+  html |> string.contains("bg-slate/10 text-slate") |> should.be_true
+  html
+  |> string.contains("Starts automatically when you mark the viewing as done.")
+  |> should.be_true
+  // Nothing was sent — no timestamp, no timeline.
+  html |> string.contains("Invitation sent") |> should.be_false
+}
+
+/// Invitation sent: navy pill + invite-batch timestamp (expanded).
+pub fn invitation_sent_state_test() {
+  let html =
+    render(
+      calls: [
+        row("rc-1", ContactInitiated, None, [invite_attempt(), sms_attempt()]),
+      ],
+      off: False,
+      attestation_on_file: False,
+      expanded: ["rc-1"],
+    )
+  html |> string.contains("Invitation sent") |> should.be_true
+  html |> string.contains("bg-navy/10 text-navy") |> should.be_true
+  html |> string.contains("01 Aug, 10:04") |> should.be_true
+  // Timeline: the invite batch joined as "email + SMS", then what-happens-next.
+  html |> string.contains("Invitation sent — email + SMS") |> should.be_true
+  html
+  |> string.contains("Next reminder in ~2 days if there&#39;s no reply")
+  |> should.be_true
+}
+
+/// Reminder sent: attempts past the co-nudge (batch 3) flip the pill.
+pub fn reminder_sent_state_test() {
