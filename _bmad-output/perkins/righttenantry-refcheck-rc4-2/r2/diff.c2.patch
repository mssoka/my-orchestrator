+
+/// Reference received: teal pill + submitted_at timestamp; summary renders
+/// when expanded.
+pub fn reference_received_state_test() {
+  let call =
+    reference_call.ReferenceCallDetail(
+      ..row("rc-1", FormCompleted, Some(completed_result()), []),
+      submitted_at: Some("2026-08-02T09:00:00Z"),
+    )
+  let html =
+    render(calls: [call], off: False, attestation_on_file: False, expanded: [
+      "rc-1",
+    ])
+  html |> string.contains("Reference received") |> should.be_true
+  html |> string.contains("bg-teal/10 text-teal") |> should.be_true
+  html |> string.contains("02 Aug, 09:00") |> should.be_true
+  // Summary: headline pull-quote + key facts in words + confidence verbatim.
+  html
+  |> string.contains("Tenancy confirmed; rent always on time.")
+  |> should.be_true
+  html |> string.contains("Payment record") |> should.be_true
+  html |> string.contains("Always on time") |> should.be_true
+  html |> string.contains("Jan 2023 to Dec 2024") |> should.be_true
+  html |> string.contains("€1,400") |> should.be_true
+  html
+  |> string.contains(
+    "Confidence: high · AI-generated summary — verify before relying on it.",
+  )
+  |> should.be_true
+}
+
+/// Collapsed received row hides the summary; expanded shows it (aria-expanded
+/// toggles with the state).
+pub fn received_row_collapsed_by_default_test() {
+  let html =
+    render(
+      calls: [row("rc-1", FormCompleted, Some(completed_result()), [])],
+      off: False,
+      attestation_on_file: False,
+      expanded: [],
+    )
+  html |> string.contains("aria-expanded=\"false\"") |> should.be_true
+  html
+  |> string.contains("Tenancy confirmed; rent always on time.")
+  |> should.be_false
+}
+
+/// Partially completed: amber pill + the §7.4 top line with answered/total
+/// (11 landlord fields, 10 answered here — free text is the missing one).
+pub fn partial_state_test() {
+  let partial_result =
+    "{\"schema_version\":\"refcall-v1\",\"outcome\":\"partial\",\"verification\":{\"identity_confirmed\":\"yes\",\"relationship_to_applicant\":\"their_landlord\",\"tenancy_confirmed\":\"yes\",\"tenancy_period\":{\"from\":\"2023-01\",\"to\":\"2024-12\"},\"rent_amount_confirmed\":{\"amount_eur\":\"1400\"},\"rent_payment_record\":\"always_on_time\",\"property_condition\":\"good\",\"notice_given_properly\":\"yes\",\"deposit_returned\":\"in_full\",\"would_rent_again\":\"yes\",\"free_text_signals\":[]},\"ai_summary\":{\"headline\":\"Tenancy confirmed; rent always on time.\",\"summary\":\"Identity confirmed. Payment record: always on time. Property: good.\",\"confidence\":\"medium\"}}"
+  let html =
+    render(
+      calls: [row("rc-1", Partial, Some(partial_result), [])],
+      off: False,
+      attestation_on_file: False,
+      expanded: ["rc-1"],
