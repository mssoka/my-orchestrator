+#!/usr/bin/env python3
+"""blur_gate.py — the node-clarity blur-test gate (packet-plumber-v2-node-clarity).
+
+Reproduces the design-audit's blur-test measurement (DIRECTION.md §1 / Q2a):
+Gaussian-blur the terminal-types capture at sigma 6 and measure the blurred
+signature (hue/saturation) at each node's screen position. The gate:
+
+  * every node-type PAIR must be hue-separated >= 15 degrees (circular delta)
+  * the saturation band across all node types must be <= 0.30 wide
+
+Usage:
+  tools/blur_gate.py [golden.png] [--sigma 6] [--out out.png]
+
+The capture's node layout is the terminal_types demo's known spawn table
+(world tiles -> screen via the exact view_compute fit: 40x30 tiles x 26px,
+min-fit into 1280x720 -> scale 12/13, off (160, 0)). Run on the CURRENT
+build's golden first: it must reproduce the audit's baseline deltas
+(residential<->small_biz ~3deg, residential<->campus ~13.8deg,
+router_mid<->content_host ~9.9deg) — that calibration proves the sampler
+matches the audit lens before the fix is measured.
+
+Exit code 0 = gate green, 1 = gate red, 2 = usage/setup error.
+"""
+
+import colorsys
+import math
+import sys
+
+from PIL import Image, ImageFilter
+
+# --- the terminal_types demo layout (demos/terminal_types.dem) --------------
+# spawn_node <type> <tx> <ty> at 5000ms (all six spawns are in by then).
+SPAWNS = [
+    ("router_mid", 20, 15),
+    ("residential", 8, 15),
+    ("content_host", 32, 15),
+    ("residential", 14, 22),
+    ("residential", 26, 22),
+    ("small_biz", 12, 10),
+    ("campus", 30, 10),
+]
+
+# the view_compute fit (app/render/view.odin): tile_px 26, world 40x30 tiles,
+# window 1280x720, scale = min fit, offsets centered.
+TILE_PX = 26
+WORLD_W_TILES, WORLD_H_TILES = 40, 30
+WIN_W, WIN_H = 1280, 720
+
+
+def node_screen(tx, ty):
+    wx, wy = tx * TILE_PX, ty * TILE_PX
+    world_w, world_h = WORLD_W_TILES * TILE_PX, WORLD_H_TILES * TILE_PX
+    scale = min(WIN_W / world_w, WIN_H / world_h)
+    off_x = (WIN_W - world_w * scale) / 2
+    off_y = (WIN_H - world_h * scale) / 2
+    return off_x + wx * scale, off_y + wy * scale
+
+
+def hue_sat(r, g, b):
+    h, l, s = colorsys.rgb_to_hls(r / 255.0, g / 255.0, b / 255.0)
+    return h * 360.0, s
+
+
+def hue_delta(a, b):
+    d = abs(a - b)
+    return min(d, 360.0 - d)
+
+
+def main():
+    path = sys.argv[1] if len(sys.argv) > 1 else "goldens/terminal_types/05000ms.png"
+    sigma = 6
+    out_path = None
+    for i, a in enumerate(sys.argv[2:], start=2):
+        if a == "--sigma" and i + 1 < len(sys.argv):
+            sigma = float(sys.argv[i + 1])
+        elif a == "--out" and i + 1 < len(sys.argv):
+            out_path = sys.argv[i + 1]
+
+    img = Image.open(path).convert("RGB")
+    blurred = img.filter(ImageFilter.GaussianBlur(sigma))
+
+    # sample each node at its exact screen position (the audit lens: the
+    # blurred signature at the node's position)
+    sigs = {}  # type -> list of (hue, sat)
+    for name, tx, ty in SPAWNS:
+        x, y = node_screen(tx, ty)
+        r, g, b = blurred.getpixel((int(round(x)), int(round(y))))
+        h, s = hue_sat(r, g, b)
+        sigs.setdefault(name, []).append((h, s, (int(round(x)), int(round(y))), (r, g, b)))
+
+    # per-type representative: the MEAN RGB of the type's blurred samples,
+    # then hue/sat of that mean (the audit lens compares one signature per
+    # type; the mean-RGB is stable across hue wrap and across the residential
+    # colorways — the fix's whole point is that all houses land in ONE family,
+    # so the mean converges to the family).
+    reps = {}
+    for name, lst in sigs.items():
+        rs = sum(rgb[0] for _, _, _, rgb in lst) / len(lst)
+        gs = sum(rgb[1] for _, _, _, rgb in lst) / len(lst)
+        bs = sum(rgb[2] for _, _, _, rgb in lst) / len(lst)
+        reps[name] = (hue_sat(rs, gs, bs)[0], hue_sat(rs, gs, bs)[1], lst)
+
+    names = list(reps.keys())
+    print(f"blur-gate: {path} sigma={sigma}")
+    print(f"{'type':<14} {'hue':>6} {'sat':>6}   samples (hue, sat, pos, rgb)")
+    for name in names:
+        h, s, lst = reps[name]
+        print(f"{name:<14} {h:6.1f} {s:6.3f}   " + "  ".join(
+            f"({hh:.1f},{ss:.3f},{p},{rgb})" for hh, ss, p, rgb in lst))
+
+    print("\npairwise hue deltas (>= 15 deg required):")
+    worst = 0.0
+    ok_pairs = True
+    for i in range(len(names)):
+        for j in range(i + 1, len(names)):
+            a, b = names[i], names[j]
+            d = hue_delta(reps[a][0], reps[b][0])
+            worst = max(worst, d)
+            mark = "OK " if d >= 15.0 else "FAIL"
+            if d < 15.0:
+                ok_pairs = False
+            print(f"  {a:<14} <-> {b:<14} {d:5.1f} deg  [{mark}]")
+
+    sats = [reps[n][1] for n in names]
+    band = max(sats) - min(sats)
+    print(f"\nsaturation band: {min(sats):.3f} .. {max(sats):.3f} (width {band:.3f}, <= 0.30 required)")
+    ok_band = band <= 0.30
+
+    if out_path:
+        blurred.save(out_path)
+        print(f"blurred frame written: {out_path}")
+
+    ok = ok_pairs and ok_band
+    print("\nGATE " + ("GREEN" if ok else "RED"))
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
