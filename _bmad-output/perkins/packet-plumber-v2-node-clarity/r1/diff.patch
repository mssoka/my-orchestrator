+// sprite_blit_dst — the DESTINATION RECT of a sprite blit (centered at `c`,
+// `target_w` wide, aspect from the content bbox). Shared by sprite_blit and
+// the node-clarity family wash (the wash must cover exactly the drawn
+// footprint). Returns ok=false when the bbox is degenerate (the blit then
+// draws nothing — the same guard the blit itself uses).
+sprite_blit_dst :: proc(sh: ^Sprite_Sheet, idx: int, c: rl.Vector2, target_w: f32) -> (rl.Rectangle, bool) {
+	cb := sh.bboxes[idx]
+	if cb[2] <= 0 || cb[3] <= 0 {
+		return {}, false
+	}
+	dh := target_w * cb[3] / cb[2]
+	return rl.Rectangle{c.x - target_w / 2, c.y - dh / 2, target_w, dh}, true
+}
