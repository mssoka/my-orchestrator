@@ -144,14 +144,29 @@ a11y_separation_check :: proc(cat: ^pp.Catalogs, base: ^rnd.Palette, mode: rnd.P
 // top-down render shows the ROOFS — the steep camera occludes the wall band,
 // so body hexes never enter the sprites (Perkins r2 W-B: the check must pin
 // what the design emits, not what the palette defines).
-HOUSE_ROOFS := [4]rl.Color{{122, 46, 38, 255}, {122, 84, 24, 255}, {44, 106, 52, 255}, {38, 80, 126, 255}}
-HOST_ROOF := rl.Color{38, 76, 142, 255}
-// 5.11 (Perkins r1 W1): the class-analogue sprites' dominant canon tones — the
-// office block's warm paper-tan + the campus's brick red (measured from the
-// committed #65 sprites; the bilinear blit keeps interior flat areas exact).
-SMALL_BIZ_TAN := rl.Color{99, 87, 65, 255}
-CAMPUS_BRICK := rl.Color{99, 43, 34, 255}
-LED_GREEN := rl.Color{46, 139, 87, 255}
+// v2-node-clarity (2026-08-22): the emitted hexes are now the WASHED tones —
+// the family wash recolors every terminal sprite at draw time (the token's
+// alpha byte is the wash strength: houses 0.80, others 0.72), so the pins
+// below are the wash-over-sprite composites (sprite_tone*(1-a) + family*a,
+// u8-truncated — the exact draw formula). Values MEASURED on the re-blessed
+// goldens (the flat interior areas stay exact through the bilinear blit;
+// each pin's floor keeps the B1 crop-canary job: a degenerate/cropped blit
+// or a reverted token fails the count).
+HOUSE_ROOFS := [4]rl.Color{{188, 82, 81, 255}, {188, 90, 78, 255}, {172, 94, 84, 255}, {171, 89, 98, 255}}
+HOST_ROOF := rl.Color{61, 114, 169, 255}
+// 5.11 (Perkins r1 W1): the class-analogue sprites' dominant canon tones —
