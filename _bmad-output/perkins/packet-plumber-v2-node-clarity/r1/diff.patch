+}
+
+@(test)
+family_tokens_separate_by_hue_fifteen_degrees :: proc(t: ^testing.T) {
+	// the token-level blur-test pin (the palcheck twin): the five families'
+	// anchor hues must sit >= 15 deg apart pairwise (the DIRECTION.md §1
+	// complementary-hue rule). The DRAWN result is the blur-gate's job
+	// (tools/blur_gate.py — the sigma-6 capture measurement); this pins the
+	// shipped TOKENS so a future token edit that re-collides fails here
+	// first. Saturation band is intentionally NOT pinned at token level (the
+	// anchors are wash inputs; the drawn band is what the blur test owns).
+	p := palette_load()
+	anchors := [5]rl.Color{
+		p.small_biz_family, p.campus_family, p.residential_family,
+		p.host_family, p.router_tier_mid,
+	}
+	hues: [5]f32
+	for c, i in anchors {
+		hues[i] = hue_degrees(c)
+	}
+	for i in 0..<5 {
+		for j in i + 1..<5 {
+			d := abs(hues[i] - hues[j])
+			d = min(d, 360 - d)
+			testing.expectf(t, d >= 15, "family pair %d<->%d hue delta %.1f deg < 15", i, j, d)
+		}
+	}
+}
+
+// hue_degrees — RGB -> HSL hue in degrees (0..360), pure f32 math (the
+// render-test convention: no raylib draw calls).
+hue_degrees :: proc(c: rl.Color) -> f32 {
+	maxc := max(f32(c.r), max(f32(c.g), f32(c.b))) / 255
+	minc := min(f32(c.r), min(f32(c.g), f32(c.b))) / 255
+	if maxc == minc {
+		return 0
+	}
+	d := maxc - minc
+	h: f32
+	if maxc == f32(c.r) / 255 {
+		h = ((f32(c.g) - f32(c.b)) / 255) / d
+	} else if maxc == f32(c.g) / 255 {
+		h = ((f32(c.b) - f32(c.r)) / 255) / d + 2
+	} else {
+		h = ((f32(c.r) - f32(c.g)) / 255) / d + 4
+	}
+	h *= 60
+	if h < 0 {
+		h += 360
+	}
+	return h
+}
