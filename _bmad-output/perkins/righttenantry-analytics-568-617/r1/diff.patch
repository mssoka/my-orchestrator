diff --git a/server/src/auth/first_touch_cookie.gleam b/server/src/auth/first_touch_cookie.gleam
new file mode 100644
index 00000000..465ee6fe
--- /dev/null
+++ b/server/src/auth/first_touch_cookie.gleam
@@ -0,0 +1,144 @@
+//// First-touch persistence across the Google OAuth redirect (issue #617).
+////
+//// The SPA captures UTM/click-id params off the landing URL and holds them
+//// in memory (#466). The Google OAuth flow is a full-page redirect to
+//// accounts.google.com and back that destroys that in-memory state, so:
+////
+////   1. the SPA appends the params to the `/auth/oauth/google` initiate URL,
+////   2. `auth_handler.handle_oauth_initiate` extracts them here and persists
+////      them in a short-lived signed cookie (`rt_first_touch`), and
+////   3. `auth_handler.complete_oauth_flow` reads the cookie back after the
+////      callback and records them as PostHog `$set_once` first-touch person
+////      properties — falling back to `provider=google` when nothing
+////      survived (an organic OAuth landing).
+////
+//// Consent-independent: same first-party URL-param basis as #466's capture.
+//// The cookie is signed (server-only write/read), short-lived (same max-age
+//// as the PKCE verifier), and cleared on every terminal OAuth response.
+
+import auth/attribution
+import auth/cookie_names
+import gleam/json
+import gleam/list
+import gleam/uri
+import wisp.{type Request, type Response}
+
+/// Max age for the first-touch cookie. Mirrors the PKCE verifier's window:
+/// both are single-flow values, and 5 minutes covers the slowest Google
+/// round-trip while expiring before any follow-up navigation could reuse
+/// stale attribution.
+pub const max_age: Int = 300
+
+/// Keys the first-touch cookie may carry — mirrors the client extractor
+/// (`client/src/helpers/first_touch.gleam`) and the signup body decoder
+/// (`auth_handler.signup_decoder`).
+const keys = [
+  "utm_source",
+  "utm_medium",
+  "utm_campaign",
+  "utm_content",
+  "utm_term",
+  "gclid",
+  "fbclid",
+  "msclkid",
+]
+
+/// Extract the first-touch params from the OAuth initiate request's query
+/// (the SPA appends the params it captured in memory). Only the keys the
+/// signup body understands are accepted; each value is trimmed and clamped
+/// to `attribution.max_value_len` (the same cap applied at `$set_once`
+/// write time) so an attacker-controlled `utm_campaign` can't bloat the
+/// signed cookie past the browser's ~4KB header budget. Blank values are
+/// dropped, mirroring the client extractor. Returns `[]` for an organic
+/// landing with no campaign params.
+pub fn from_initiate_query(
+  query: List(#(String, String)),
+) -> List(#(String, String)) {
+  list.filter_map(keys, fn(key) {
+    case list.find(query, fn(pair) { pair.0 == key }) {
+      Ok(#(_, raw)) ->
+        case attribution.clamp_value(raw) {
+          "" -> Error(Nil)
+          value -> Ok(#(key, value))
+        }
+      Error(_) -> Error(Nil)
+    }
+  })
+}
+
+/// Serialize first-touch pairs for the signed cookie payload. Stored as a
+/// percent-encoded query string — the same wire shape the landing URL
+/// used — so parsing back is exactly `uri.parse_query`.
+pub fn cookie_value(pairs: List(#(String, String))) -> String {
+  uri.query_to_string(pairs)
+}
+
+/// Read the first-touch cookie off the callback request and turn it into
+/// the `FirstTouch` the identify call needs. An absent / malformed /
+/// expired cookie reads as an all-empty `FirstTouch` (the caller's
+/// provider fallback then applies).
+pub fn read_cookie(req: Request) -> attribution.FirstTouch {
+  case wisp.get_cookie(req, cookie_names.first_touch(), wisp.Signed) {
+    Error(_) -> empty()
+    Ok(raw) ->
+      case uri.parse_query(raw) {
+        Error(_) -> empty()
+        Ok(pairs) -> from_pairs(pairs)
+      }
+  }
+}
+
+/// The `$set_once` first-touch properties for an OAuth sign-in, with the
+/// issue #617 fallback: when no first-touch param survived the redirect
+/// (organic landing, content-only marker, or absent/expired cookie), record
+/// what exists instead of nothing — `provider=google` — so every OAuth
+/// signup is at least attributable to its sign-in method rather than
+/// reading as fully unattributed. `$set_once` semantics make this a no-op
+/// for returning sign-ins (their original values are already locked).
+pub fn set_once_with_fallback(
+  first_touch: attribution.FirstTouch,
+) -> List(#(String, json.Json)) {
+  case attribution.first_touch_set_once(first_touch) {
+    [] -> [#("provider", json.string("google"))]
+    set_once -> set_once
+  }
+}
+
+/// Expire the first-touch cookie. Called on every terminal OAuth response
+/// (success and error alike) so a stale attribution can never leak into a
+/// later attempt inside the 5-minute window.
+pub fn clear_cookie(response: Response, req: Request) -> Response {
+  wisp.set_cookie(response, req, cookie_names.first_touch(), "", wisp.Signed, 0)
+}
+
+fn empty() -> attribution.FirstTouch {
+  attribution.FirstTouch(
+    utm_source: "",
+    utm_medium: "",
+    utm_campaign: "",
+    utm_content: "",
+    utm_term: "",
+    gclid: "",
+    fbclid: "",
+    msclkid: "",
+  )
+}
+
+fn from_pairs(pairs: List(#(String, String))) -> attribution.FirstTouch {
+  let value = fn(key) {
+    case list.key_find(pairs, key) {
+      Ok(v) -> v
+      Error(_) -> ""
+    }
+  }
+  attribution.FirstTouch(
+    utm_source: value("utm_source"),
+    utm_medium: value("utm_medium"),
+    utm_campaign: value("utm_campaign"),
+    utm_content: value("utm_content"),
+    utm_term: value("utm_term"),
+    gclid: value("gclid"),
+    fbclid: value("fbclid"),
+    msclkid: value("msclkid"),
+  )
+}
