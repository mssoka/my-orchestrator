+  // Returning sign-in WITH consent is a login, not a signup — the upsert
+  // conflicts (is_new = False) and CAPI must not fire (fire-once contract,
+  // issue #568). The PostHog capture becomes login_succeeded.
+  let second =
+    run_oauth_callback_with(
+      oauth_callback_request_with_consent(),
+      db,
+      token,
+      posthog,
+      meta,
+    )
+  second.status |> should.equal(303)
+  drain_meta(meta_subject, 1000) |> should.equal([])
+  let second_ph = posthog_client.drain_recording(ph_subject, 1000)
+  case second_ph {
+    [
+      posthog_client.Identify(_, _, _),
+      posthog_client.Capture(_, "login_succeeded", _),
+    ] -> Nil
+    _ -> should.fail()
+  }
+}
