+  first_touch_cookie.read_cookie(req)
+  |> should.equal(attribution.FirstTouch(
+    utm_source: "google",
+    utm_medium: "cpc",
+    utm_campaign: "spring 2026",
+    utm_content: "",
+    utm_term: "",
+    gclid: "abc.123",
+    fbclid: "",
+    msclkid: "",
+  ))
+}
+
+pub fn read_cookie_without_cookie_yields_empty_first_touch_test() {
+  let req = simulate.request(http.Get, "/auth/callback")
+  first_touch_cookie.read_cookie(req)
+  |> should.equal(empty_first_touch())
+}
+
+pub fn read_cookie_rejects_tampered_value_test() {
+  // A cookie whose signature doesn't verify must read as empty, never as
+  // attacker-supplied attribution.
+  let req =
+    simulate.request(http.Get, "/auth/callback")
+    |> simulate.header(
+      "cookie",
+      cookie_names.first_touch() <> "=utm_source=attacker",
+    )
+  first_touch_cookie.read_cookie(req)
+  |> should.equal(empty_first_touch())
+}
+
+// -- set_once_with_fallback ---------------------------------------------------
+
+pub fn set_once_with_fallback_records_provider_when_first_touch_empty_test() {
+  first_touch_cookie.set_once_with_fallback(empty_first_touch())
+  |> should.equal([#("provider", json.string("google"))])
+}
+
+pub fn set_once_with_fallback_keeps_real_first_touch_test() {
+  first_touch_cookie.set_once_with_fallback(attribution.FirstTouch(
+    utm_source: "google",
+    utm_medium: "cpc",
+    utm_campaign: "spring",
+    utm_content: "",
+    utm_term: "",
+    gclid: "abc",
+    fbclid: "",
+    msclkid: "",
+  ))
+  |> should.equal([
+    #("first_touch_utm_source", json.string("google")),
+    #("first_touch_utm_medium", json.string("cpc")),
+    #("first_touch_utm_campaign", json.string("spring")),
+    #("first_touch_gclid", json.string("abc")),
+  ])
+}
+
+pub fn set_once_with_fallback_falls_back_for_content_only_marker_test() {
+  // utm_source=content is masked server-side (it's a navigation, not an
+  // acquisition source) — so the fallback still applies.
+  first_touch_cookie.set_once_with_fallback(attribution.FirstTouch(
+    utm_source: "content",
+    utm_medium: "",
+    utm_campaign: "",
+    utm_content: "",
+    utm_term: "",
+    gclid: "",
+    fbclid: "",
+    msclkid: "",
+  ))
+  |> should.equal([#("provider", json.string("google"))])
+}
+
+// -- clear_cookie -------------------------------------------------------------
+
+pub fn clear_cookie_expires_the_cookie_test() {
+  let req = simulate.request(http.Get, "/auth/callback")
+  let resp =
+    wisp.redirect("/dashboard")
+    |> first_touch_cookie.clear_cookie(req)
+  let assert Ok(set_cookie) = find_set_cookie(resp, cookie_names.first_touch())
+  string.contains(set_cookie, "Max-Age=0")
+  |> should.be_true
+}
+
+// -- Helpers ------------------------------------------------------------------
+
+fn empty_first_touch() -> attribution.FirstTouch {
+  attribution.FirstTouch(
+    utm_source: "",
+    utm_medium: "",
+    utm_campaign: "",
+    utm_content: "",
+    utm_term: "",
+    gclid: "",
+    fbclid: "",
+    msclkid: "",
+  )
+}
+
+fn find_set_cookie(resp: wisp.Response, name: String) -> Result(String, Nil) {
+  resp.headers
+  |> list.find_map(fn(pair) {
+    let #(key, value) = pair
+    case
+      string.lowercase(key) == "set-cookie"
+      && string.starts_with(value, name <> "=")
+    {
+      True -> Ok(value)
+      False -> Error(Nil)
+    }
+  })
+}
