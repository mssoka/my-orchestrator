+// ============================================================================
+// META CAPI ON OAUTH SIGNUP — CompleteRegistration fires on insert only,
+// consent-gated (Plan §5), never on a returning sign-in (issue #568)
+// ============================================================================
+
+/// Browser-shaped marketing consent cookie (mirrors
+/// `payment_verify_integration_test.consent_cookie_value`).
+fn consent_cookie_value(marketing: Bool) -> String {
+  let marketing_str = case marketing {
+    True -> "true"
+    False -> "false"
+  }
+  let json =
+    "{\"version\":\""
+    <> compliance.cookie_policy_version
+    <> "\",\"ts\":1748419200000,\"token\":\"00000000-0000-0000-0000-000000000000\",\"analytics\":false,\"marketing\":"
+    <> marketing_str
+    <> "}"
+  uri.percent_encode(json)
+}
+
+fn oauth_callback_request_with_consent() -> wisp.Request {
+  simulate.request(http.Get, "/auth/callback")
+  |> simulate.header("cookie", "rt_consent=" <> consent_cookie_value(True))
+}
+
+fn drain_meta(
+  subject: process.Subject(meta_client.Event),
+  timeout_ms: Int,
+) -> List(meta_client.Event) {
+  meta_client.drain_recording(subject, timeout_ms)
+}
+
+pub fn oauth_insert_fires_meta_complete_registration_when_consented_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let ph_subject = process.new_subject()
+  let meta_subject = process.new_subject()
+  let posthog = posthog_client.Recording(ph_subject)
+  let meta = meta_client.Recording(meta_subject)
+  let auth_uuid = uuid.v4_string()
+
+  // A new Google sign-in with marketing consent → CAPI CompleteRegistration.
+  let resp =
+    run_oauth_callback_with(
+      oauth_callback_request_with_consent(),
+      db,
+      oauth_token_response(auth_uuid),
+      posthog,
+      meta,
+    )
+  resp.status |> should.equal(303)
+
+  let meta_events = drain_meta(meta_subject, 1000)
+  case meta_events {
+    [meta_client.CompleteRegistration(event_id, _)] -> {
+      // A fresh per-event UUID, never the landlord row id (matches the
+      // password path's `dispatch_signup_meta` contract).
+      let _ = uuid.from_string(event_id) |> should.be_ok
+      Nil
+    }
+    _ -> should.fail()
+  }
+}
