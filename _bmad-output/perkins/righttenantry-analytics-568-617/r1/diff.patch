+pub fn oauth_signin_with_first_touch_cookie_records_attribution_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let subject = process.new_subject()
+  let posthog = posthog_client.Recording(subject)
+  let auth_uuid = uuid.v4_string()
+
+  // The initiate step (pinned in auth_test) set the signed cookie from the
+  // landing URL; here the callback reads it back and records it as
+  // `$set_once` first-touch properties (issue #617).
+  let req =
+    simulate.request(http.Get, "/auth/callback")
+    |> simulate.cookie(
+      cookie_names.first_touch(),
+      "utm_source=google&utm_medium=cpc&utm_campaign=spring_2026&gclid=abc123",
+      wisp.Signed,
+    )
+  let resp =
+    run_oauth_callback_with(
+      req,
