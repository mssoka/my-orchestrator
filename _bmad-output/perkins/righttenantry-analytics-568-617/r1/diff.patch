+// -- from_initiate_query ------------------------------------------------------
+
+pub fn from_initiate_query_extracts_known_keys_in_key_order_test() {
+  // Output is in `keys` order (matches the signup body decoder), not query
+  // order; unknown keys (ref) are dropped; the first occurrence of a
+  // duplicate key wins.
+  let query = [
+    #("gclid", "Cj0KCA"),
+    #("ref", "some_friend"),
+    #("utm_source", "google"),
+    #("utm_source", "dup"),
+    #("utm_campaign", "spring_2026"),
+  ]
+  first_touch_cookie.from_initiate_query(query)
+  |> should.equal([
+    #("utm_source", "google"),
+    #("utm_campaign", "spring_2026"),
+    #("gclid", "Cj0KCA"),
+  ])
+}
+
+pub fn from_initiate_query_returns_empty_for_organic_landing_test() {
+  first_touch_cookie.from_initiate_query([])
+  |> should.equal([])
+  first_touch_cookie.from_initiate_query([#("ref", "friend")])
+  |> should.equal([])
+}
+
+pub fn from_initiate_query_drops_blank_values_test() {
+  first_touch_cookie.from_initiate_query([
+    #("utm_source", "   "),
+    #("utm_campaign", "spring"),
+  ])
+  |> should.equal([#("utm_campaign", "spring")])
+}
+
+pub fn from_initiate_query_clamps_values_to_max_value_len_test() {
+  let long = string.repeat("a", 300)
+  let result = first_touch_cookie.from_initiate_query([#("utm_campaign", long)])
+  result
+  |> should.equal([#("utm_campaign", string.repeat("a", 200))])
+}
+
+// -- cookie_value + read_cookie round-trip ------------------------------------
+
+pub fn cookie_round_trip_preserves_params_test() {
+  let pairs = [
+    #("utm_source", "google"),
+    #("utm_medium", "cpc"),
+    #("utm_campaign", "spring 2026"),
+    #("gclid", "abc.123"),
