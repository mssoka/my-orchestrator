+  }
+
+  // The cookie is cleaned up after the callback (issue #617 acceptance).
+  find_set_cookie(resp, cookie_names.first_touch())
+  |> should.be_ok
+  |> fn(cookie) { string.contains(cookie, "Max-Age=0") |> should.be_true }
