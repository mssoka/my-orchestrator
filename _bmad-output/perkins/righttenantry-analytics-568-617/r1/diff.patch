+pub fn oauth_returning_signin_fires_no_meta_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let ph_subject = process.new_subject()
+  let meta_subject = process.new_subject()
+  let posthog = posthog_client.Recording(ph_subject)
+  let meta = meta_client.Recording(meta_subject)
+  let auth_uuid = uuid.v4_string()
+  let token = oauth_token_response(auth_uuid)
+
+  // First sign-in, no consent — creates the row, no CAPI fire.
+  let first =
+    run_oauth_callback_with(
+      simulate.request(http.Get, "/auth/callback"),
+      db,
+      token,
+      posthog,
+      meta,
+    )
+  first.status |> should.equal(303)
+  drain_meta(meta_subject, 1000) |> should.equal([])
+  let first_ph = posthog_client.drain_recording(ph_subject, 1000)
+  case first_ph {
+    [
+      posthog_client.Identify(_, _, _),
+      posthog_client.Capture(_, "signup_completed", _),
+    ] -> Nil
+    _ -> should.fail()
+  }
