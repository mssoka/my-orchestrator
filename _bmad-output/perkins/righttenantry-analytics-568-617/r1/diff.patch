+fn find_set_cookie(resp: wisp.Response, name: String) -> Result(String, Nil) {
+  resp.headers
+  |> list.find_map(fn(pair) {
+    let #(key, value) = pair
+    case
+      string.lowercase(key) == "set-cookie"
+      && string.starts_with(value, name <> "=")
+    {
+      True -> Ok(value)
+      False -> Error(Nil)
+    }
+  })
+}
