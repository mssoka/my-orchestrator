+// -- First-touch cookie on the initiate redirect (issue #617) -----------------
+
+fn find_set_cookie(resp: wisp.Response, name: String) -> Result(String, Nil) {
+  resp.headers
+  |> list.find_map(fn(pair) {
+    let #(key, value) = pair
+    case
+      string.lowercase(key) == "set-cookie"
+      && string.starts_with(value, name <> "=")
+    {
+      True -> Ok(value)
+      False -> Error(Nil)
+    }
+  })
+}
+
+pub fn oauth_initiate_sets_first_touch_cookie_test() {
+  // The SPA appends the landing-URL first-touch params to the initiate URL
+  // (issue #617); the handler persists them in the signed cookie that
+  // survives the bounce to accounts.google.com.
+  let req =
+    simulate.request(
+      http.Get,
+      "/auth/oauth/google?utm_source=google&utm_campaign=spring&ref=friend",
+    )
+  let config =
+    SupabaseConfig(
+      url: "http://localhost",
+      anon_key: "test-key",
+      secret_key: "test-secret",
+    )
+  let response =
+    auth_handler.handle_oauth_initiate(
+      req,
+      config,
+      "http://localhost/callback",
+      "google",
+    )
+  response.status |> should.equal(303)
+  let assert Ok(cookie) = find_set_cookie(response, cookie_names.first_touch())
+  // Signed cookie — the value is base64url payload, not the raw params.
+  string.starts_with(cookie, cookie_names.first_touch() <> "=")
+  |> should.be_true
+  string.contains(cookie, "Max-Age=300")
+  |> should.be_true
+}
+
+pub fn oauth_initiate_omits_first_touch_cookie_for_organic_landing_test() {
+  // No params (organic landing) → no cookie; the callback falls back to
+  // `provider=google` rather than carrying stale or empty attribution.
+  let req = simulate.request(http.Get, "/auth/oauth/google")
+  let config =
+    SupabaseConfig(
+      url: "http://localhost",
+      anon_key: "test-key",
+      secret_key: "test-secret",
+    )
+  let response =
+    auth_handler.handle_oauth_initiate(
+      req,
+      config,
+      "http://localhost/callback",
+      "google",
+    )
+  response.status |> should.equal(303)
+  find_set_cookie(response, cookie_names.first_touch())
+  |> should.be_error
+  // The PKCE verifier cookie is still set — the flow is unchanged.
+  find_set_cookie(response, cookie_names.pkce())
+  |> should.be_ok
+}
