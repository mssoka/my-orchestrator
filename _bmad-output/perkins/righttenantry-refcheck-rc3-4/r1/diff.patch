+// -- Shared exit-route helpers ------------------------------------------------
+
+type ReferenceEvent {
+  ReferenceCompleted
+  ReferenceDeclined
+  ReferenceObjected
+}
+
+/// GET routing shared by the decline / stop / wrong-person confirm pages:
+/// a live or expired-open row renders the page; any other state redirects
+/// to the bare token URL (the GET classifier renders the truthful state).
+fn exit_get(config: ServerConfig, token: String, page: String) -> Response {
+  case lookup_context(config.db, token) {
+    Error(NotFound) -> render_not_found()
+    Error(LookupQueryFailed(msg)) -> {
+      wisp.log_error("reference exit GET: lookup failed: " <> msg)
+      wisp.internal_server_error()
+    }
+    Ok(row) ->
+      case classify_row(row) {
+        Live | ExpiredOpen -> page |> ssr_response.to_sensitive_response
+        _ -> wisp.redirect(to: "/reference/" <> token)
+      }
+  }
+}
+
+/// The client-reported focus seconds (the form's hidden _focus_seconds
+/// field); an unparseable/missing value is 0. rc3-7 builds the full
+/// form_session fraud block on top of this.
+fn parse_focus_seconds(values: List(#(String, String))) -> Int {
+  case application_handler.get_form_value(values, "_focus_seconds") {
+    "" -> 0
+    text ->
+      case int.parse(text) {
+        Ok(n) -> n
+        Error(_) -> 0
+      }
+  }
+}
+
+/// Art 21 objection evidence: the tap's IP + User-Agent, carried as a
+/// compact JSON blob in `reference_objection_log.payload_ref`. The
+/// reference_call_id FK already binds the row; this is the provenance a DPC
+/// Art 21 request would ask for. (rc3-4 has no separate evidence store, so
+/// the evidence rides the payload_ref directly.)
+fn objection_payload_ref(
+  req: Request,
+  _row: sql.GetFormContextByFormTokenRow,
+) -> String {
+  json.to_string(
+    json.object([
+      #("channel", json.string("web")),
+      #("ip", json.string(request_helpers.client_ip(req))),
+      #("user_agent", json.string(request_helpers.client_user_agent(req))),
+    ]),
+  )
+}
+
+/// Best-effort landlord notification for a reference terminal. A notification
+/// failure logs but never blocks the referee's exit (the status flip already
+/// happened). late_after_handoff is read from taken_over_at for the completed
+/// copy branch (§8.6).
+fn notify_reference_event(
+  config: ServerConfig,
+  row: sql.GetFormContextByFormTokenRow,
+  event: ReferenceEvent,
+) -> Nil {
+  case
+    uuid.from_string(row.landlord_id),
+    uuid.from_string(row.vacancy_id),
+    uuid.from_string(row.application_id),
+    uuid.from_string(row.id)
+  {
+    Ok(landlord_id), Ok(vacancy_id), Ok(application_id), Ok(reference_call_id) -> {
+      let referee_name = row.contact_name
+      let applicant = applicant_full_name(row)
+      let origin = domain_helpers.origin_from_domain(row.origin_domain)
+      let _ = case event {
+        ReferenceCompleted ->
+          notification_dispatch.notify_reference_completed(
+            db: config.db,
+            landlord_id:,
+            vacancy_id:,
+            application_id:,
+            reference_call_id:,
+            referee_name:,
+            applicant_full_name: applicant,
+            late_after_handoff: row.taken_over_at != "",
+            resend_api_key: config.resend_api_key,
+            origin_domain: origin,
+          )
+        ReferenceDeclined ->
+          notification_dispatch.notify_reference_declined(
+            db: config.db,
+            landlord_id:,
+            vacancy_id:,
+            application_id:,
+            reference_call_id:,
+            referee_name:,
+            applicant_full_name: applicant,
+            resend_api_key: config.resend_api_key,
+            origin_domain: origin,
+          )
+        ReferenceObjected ->
+          notification_dispatch.notify_reference_objected(
+            db: config.db,
+            landlord_id:,
+            vacancy_id:,
+            application_id:,
+            reference_call_id:,
+            referee_name:,
+            applicant_full_name: applicant,
+            resend_api_key: config.resend_api_key,
+            origin_domain: origin,
+          )
+      }
+      Nil
+    }
+    _, _, _, _ -> {
+      wisp.log_error(
+        "reference event: corrupt uuid in row, notification skipped",
+      )
+      Nil
+    }
+  }
+}
+
+/// Tier-2 audit write for a reference terminal: logs + Sentry-captures on
+/// failure, never strands the referee (the status flip already happened).
+/// Details carry NO free text (the decline reason lives in the result
+/// JSONB, not the audit row — the no-PII-in-audit posture, rc3-3 r2 N14).
+fn audit_terminal(
+  db: pog.Connection,
+  sentry: sentry_client.Sentry,
+  row: sql.GetFormContextByFormTokenRow,
+  event: event_type.AuditEvent,
+  details: json.Json,
+) -> Nil {
+  case uuid.from_string(row.id) {
+    Ok(id_uuid) ->
+      case
+        audit_log.create_system(
+          db,
+          event:,
+          entity_type: "reference_call",
+          entity_id: id_uuid,
+          details:,
+        )
+      {
+        Ok(_) -> Nil
+        Error(err) -> {
+          wisp.log_error(
+            "reference terminal: audit failed: " <> string.inspect(err),
+          )
+          sentry_client.capture(
+            sentry,
+            sentry_client.BackgroundEvent(
+              event_type: "ReferenceTerminalAuditFailed",
+              message: "reference-call terminal audit write failed",
+              level: sentry_client.LevelError,
+              tags: [#("entity_id", row.id)],
+            ),
+          )
+        }
+      }
+    Error(_) ->
+      wisp.log_error("reference terminal: corrupt row id, audit skipped")
+  }
+}
