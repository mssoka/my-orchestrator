diff --git a/server/test/reference_checks/result_test.gleam b/server/test/reference_checks/result_test.gleam
new file mode 100644
index 00000000..04ee72d8
--- /dev/null
+++ b/server/test/reference_checks/result_test.gleam
@@ -0,0 +1,243 @@
+//// Unit tests for the deterministic ReferenceCallResult v1 structurer
+//// (AD-9). Pure — no DB. Pins: schema/channel/outcome, per-slot verification
+//// blocks (A9), completeness-derived confidence, the minimal terminal result,
+//// attempts parsing, and em-dash-free copy.
+
+import gleam/json
+import gleam/option
+import gleam/string
+import gleeunit/should
+import reference_checks/questions
+import reference_checks/result
+import shared/reference_call.{CharacterRef, EmployerRef, LandlordRef}
+
+/// A complete landlord draft (all 10 required + free text).
+fn complete_landlord_draft() -> questions.Draft {
+  questions.decode_draft(
+    "{\"identity_confirmed\":\"yes\",\"relationship_to_applicant\":\"landlord\","
+    <> "\"tenancy_confirmed\":\"yes\","
+    <> "\"tenancy_period\":{\"from\":\"2023-01\",\"to\":\"2024-06\"},"
+    <> "\"rent_amount\":{\"amount_eur\":\"1500\"},"
+    <> "\"rent_payment_record\":\"always_on_time\",\"property_condition\":\"good\","
+    <> "\"notice_given_properly\":\"yes\",\"deposit_returned\":\"in_full\","
+    <> "\"would_rent_again\":\"yes\",\"free_text\":\"Paid on time, looked after the place.\"}",
+  )
+}
+
+/// A sparse landlord draft (only identity) — confidence should drop.
+fn sparse_landlord_draft() -> questions.Draft {
+  questions.decode_draft("{\"identity_confirmed\":\"yes\"}")
+}
+
+fn ctx() -> result.StructureContext {
+  result.StructureContext(
+    reference_call_id: "rc-1",
+    application_id: "app-1",
+    ref_slot: "landlord_ref",
+    owner_label: "primary",
+    attempts: "[]",
+    focus_seconds: 250,
+  )
+}
+
+fn as_text(result_json: json.Json) -> String {
+  json.to_string(result_json)
+}
+
+// -- Submit result: envelope + per-slot verification ----------------------------
+
+pub fn submit_result_has_refcall_v1_envelope_test() {
+  let #(result_json, _) =
+    result.structure_form_result(LandlordRef, complete_landlord_draft(), ctx())
+  let text = as_text(result_json)
+  text |> string.contains("\"schema_version\":\"refcall-v1\"") |> should.be_true
+  text |> string.contains("\"channel\":\"form\"") |> should.be_true
+  text
+  |> string.contains("\"outcome\":\"form_completed\"")
+  |> should.be_true
+  text |> string.contains("\"reference_call_id\":\"rc-1\"") |> should.be_true
+}
+
+pub fn landlord_verification_carries_all_fields_test() {
+  let #(result_json, _) =
+    result.structure_form_result(LandlordRef, complete_landlord_draft(), ctx())
+  let text = as_text(result_json)
+  // Per-slot fields (A9): the landlord set.
+  text |> string.contains("\"identity_confirmed\":\"yes\"") |> should.be_true
+  text
+  |> string.contains("\"relationship_to_applicant\":\"landlord\"")
+  |> should.be_true
+  text |> string.contains("\"tenancy_confirmed\":\"yes\"") |> should.be_true
+  text |> string.contains("\"from\":\"2023-01\"") |> should.be_true
+  text |> string.contains("\"to\":\"2024-06\"") |> should.be_true
+  text |> string.contains("\"amount_eur\":\"1500\"") |> should.be_true
+  text
+  |> string.contains("\"rent_amount_confirmed\":")
+  // renamed from draft rent_amount
+  |> should.be_true
+  text
+  |> string.contains("\"rent_payment_record\":\"always_on_time\"")
+  |> should.be_true
+  text |> string.contains("\"would_rent_again\":\"yes\"") |> should.be_true
+  // free_text_signals is a verbatim single-element array.
+  text
+  |> string.contains("\"free_text_signals\":[\"Paid on time")
+  |> should.be_true
+}
+
+pub fn employer_verification_uses_employer_variant_fields_test() {
+  let draft =
+    questions.decode_draft(
+      "{\"identity_confirmed\":\"yes\",\"relationship_to_applicant\":\"manager\","
+      <> "\"works_at_confirmed\":\"yes\","
+      <> "\"employment_period\":{\"as_stated\":true},"
+      <> "\"role_confirmed\":{\"as_stated\":true},"
+      <> "\"salary_confirmed\":{\"as_stated\":true},\"would_rehire\":\"yes\"}",
+    )
+  let #(result_json, _) =
+    result.structure_form_result(EmployerRef, draft, ctx())
+  let text = as_text(result_json)
+  text |> string.contains("\"works_at_confirmed\":\"yes\"") |> should.be_true
+  text
+  |> string.contains("\"employment_period\":{\"as_stated\":true}")
+  |> should.be_true
+  text
+  |> string.contains("\"salary_confirmed\":{\"as_stated\":true}")
+  |> should.be_true
+  text |> string.contains("\"would_rehire\":\"yes\"") |> should.be_true
+  // Tenancy fields are absent in the employer block.
+  text |> string.contains("tenancy_period") |> should.be_false
+}
+
+pub fn character_verification_uses_character_variant_fields_test() {
+  let draft =
+    questions.decode_draft(
+      "{\"identity_confirmed\":\"yes\",\"relationship\":\"Friend\","
+      <> "\"capacity\":\"Known personally\",\"known_duration\":\"y3_10\","
+      <> "\"character_statement\":\"Reliable and honest.\",\"would_stand_again\":\"yes\"}",
+    )
+  let #(result_json, _) =
+    result.structure_form_result(CharacterRef, draft, ctx())
+  let text = as_text(result_json)
+  text |> string.contains("\"relationship\":\"Friend\"") |> should.be_true
+  text |> string.contains("\"capacity\":\"Known personally\"") |> should.be_true
+  text |> string.contains("\"known_duration\":\"y3_10\"") |> should.be_true
+  text
+  |> string.contains("\"character_statement\":\"Reliable and honest.\"")
+  |> should.be_true
+  text |> string.contains("\"would_stand_again\":\"yes\"") |> should.be_true
+}
+
+// -- Confidence derives from required-answer completeness -----------------------
+
+pub fn complete_landlord_is_high_confidence_test() {
+  let #(result_json, _) =
+    result.structure_form_result(LandlordRef, complete_landlord_draft(), ctx())
+  as_text(result_json)
+  |> string.contains("\"confidence\":\"high\"")
+  |> should.be_true
+}
+
+pub fn sparse_landlord_is_low_confidence_test() {
+  let #(result_json, _) =
+    result.structure_form_result(LandlordRef, sparse_landlord_draft(), ctx())
+  let text = as_text(result_json)
+  // Only identity answered out of 10 required -> low.
+  text |> string.contains("\"confidence\":\"low\"") |> should.be_true
+  // Unanswered required fields render as null, never invented.
+  text |> string.contains("\"rent_payment_record\":null") |> should.be_true
+}
+
+// -- ai_summary is a deterministic rendering (no LLM) --------------------------
+
+pub fn ai_summary_present_and_em_dash_free_test() {
+  let #(result_json, _) =
+    result.structure_form_result(LandlordRef, complete_landlord_draft(), ctx())
+  let text = as_text(result_json)
+  text |> string.contains("\"ai_summary\":{") |> should.be_true
+  text |> string.contains("\"headline\":") |> should.be_true
+  text |> string.contains("\"summary\":") |> should.be_true
+  // The em-dash ban holds in the deterministic copy too.
+  text |> string.contains("\u{2014}") |> should.be_false
+}
+
+// -- compliance block ----------------------------------------------------------
+
+pub fn compliance_block_is_v1_shape_test() {
+  let #(result_json, _) =
+    result.structure_form_result(LandlordRef, complete_landlord_draft(), ctx())
+  let text = as_text(result_json)
+  text |> string.contains("\"gdpr_notice_given\":true") |> should.be_true
+  text
+  |> string.contains("\"recording_consent\":\"not_recorded\"")
+  |> should.be_true
+  // transcript is v2-reserved — absent, not a placeholder.
+  text |> string.contains("transcript") |> should.be_false
+}
+
+// -- Minimal terminal result (decline / objection) -----------------------------
+
+pub fn minimal_terminal_result_refused_has_null_verification_test() {
+  let text =
+    result.minimal_terminal_result(
+      outcome: "refused",
+      attempts: "[]",
+      note: option.None,
+    )
+    |> as_text
+  text |> string.contains("\"outcome\":\"refused\"") |> should.be_true
+  text |> string.contains("\"verification\":null") |> should.be_true
+  text |> string.contains("\"schema_version\":\"refcall-v1\"") |> should.be_true
+  // No decline_reason when note is None.
+  text |> string.contains("decline_reason") |> should.be_false
+}
+
+pub fn minimal_terminal_result_carries_decline_reason_test() {
+  let text =
+    result.minimal_terminal_result(
+      outcome: "refused",
+      attempts: "[]",
+      note: option.Some("No time right now"),
+    )
+    |> as_text
+  text
+  |> string.contains("\"decline_reason\":\"No time right now\"")
+  |> should.be_true
+}
+
+// -- Attempts parsing ----------------------------------------------------------
+
+pub fn attempts_empty_when_no_log_test() {
+  let #(result_json, _) =
+    result.structure_form_result(LandlordRef, complete_landlord_draft(), ctx())
+  as_text(result_json) |> string.contains("\"attempts\":[]") |> should.be_true
+}
+
+pub fn attempts_parsed_and_re_emitted_test() {
+  let ctx_with_attempts =
+    result.StructureContext(
+      ..ctx(),
+      attempts: "[{\"at\":\"2026-08-10T09:00:00Z\",\"channel\":\"email\",\"outcome\":\"delivered\",\"detail\":\"\"}]",
+    )
+  let #(result_json, _) =
+    result.structure_form_result(
+      LandlordRef,
+      complete_landlord_draft(),
+      ctx_with_attempts,
+    )
+  let text = as_text(result_json)
+  text |> string.contains("\"channel\":\"email\"") |> should.be_true
+  text |> string.contains("\"outcome\":\"delivered\"") |> should.be_true
+}
+
+// -- Malformed draft degrades to empty (the decode_draft contract) -------------
+
+pub fn malformed_draft_yields_null_verification_test() {
+  // decode_draft("") -> empty dict -> every verification field null, low conf.
+  let draft = questions.decode_draft("")
+  let #(result_json, _) =
+    result.structure_form_result(LandlordRef, draft, ctx())
+  let text = as_text(result_json)
+  text |> string.contains("\"identity_confirmed\":null") |> should.be_true
+  text |> string.contains("\"confidence\":\"low\"") |> should.be_true
+}
