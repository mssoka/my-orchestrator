+    title: form_copy.stop_confirmed_title,
+    body: [html.p([], [html.text(form_copy.stop_confirmed_body)])],
+    testid: "reference-stop-confirmed",
+  )
+}
+
+// -- Wrong-person (awaiting_correction; AD-7) ----------------------------------
+
+/// GET: the wrong-person page.
+pub fn view_wrong_person_page(token token: String) -> String {
