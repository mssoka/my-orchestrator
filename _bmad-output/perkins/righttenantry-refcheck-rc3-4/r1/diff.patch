+
+pub fn handle_decline_post(
+  req: Request,
+  config: ServerConfig,
+  token: String,
+) -> Response {
+  use form_data <- wisp.require_form(req)
+  let values = form_data.values
+  case lookup_context(config.db, token) {
+    Error(NotFound) -> render_not_found()
+    Error(LookupQueryFailed(msg)) -> {
+      wisp.log_error("reference decline: lookup failed: " <> msg)
+      wisp.internal_server_error()
+    }
+    Ok(row) ->
+      case classify_row(row) {
+        Live | ExpiredOpen ->
+          case
+            application_handler.is_honeypot_filled(values)
+            || is_resend_timing_suspicious(values)
+          {
+            // Fake success without the state change.
+            True ->
+              form_pages.view_decline_confirmed()
+              |> ssr_response.to_sensitive_response
+            False -> apply_decline(config, token, row, values)
+          }
+        _ -> wisp.redirect(to: "/reference/" <> token)
+      }
+  }
+}
+
+fn apply_decline(
+  config: ServerConfig,
+  token: String,
+  row: sql.GetFormContextByFormTokenRow,
+  values: List(#(String, String)),
+) -> Response {
+  let reason = application_handler.get_form_value(values, "decline_reason")
+  let note = case reason {
+    "" -> option.None
+    text -> option.Some(text)
+  }
+  let minimal =
+    result.minimal_terminal_result(
+      outcome: "refused",
+      attempts: row.attempts,
+      note:,
+    )
+  case uuid.from_string(row.id) {
+    Error(_) -> {
+      wisp.log_error("reference decline: corrupt row id")
+      wisp.internal_server_error()
+    }
+    Ok(id_uuid) ->
+      case
+        sql.terminalize_reference_call(
+          config.db,
+          id_uuid,
+          sql.Refused,
+          "refused",
+          "declined",
+          minimal,
+          sql.ContactInitiated,
+        )
+      {
+        Ok(pog.Returned(_, [_, ..])) -> {
+          audit_terminal(
+            config.db,
+            config.sentry,
+            row,
+            event_type.ReferenceCallDeclined,
+            json.null(),
+          )
+          notify_reference_event(config, row, ReferenceDeclined)
+          form_pages.view_decline_confirmed()
+          |> ssr_response.to_sensitive_response
+        }
+        // 0 rows: already terminal (sticky) — the GET tells the truth.
+        Ok(pog.Returned(_, [])) -> wisp.redirect(to: "/reference/" <> token)
+        Error(err) -> {
+          wisp.log_error(
+            "reference decline: terminalize failed: " <> string.inspect(err),
+          )
+          wisp.internal_server_error()
+        }
+      }
+  }
+}
+
+// -- Stop-link objection (GET/POST /reference/:token/stop -> objected, AD-6) ----
+
+/// GET is pre-fetch-safe: it renders the confirm page and mutates NOTHING
+/// (SMS/email link scanners prefetch GETs; a GET that objected would
+/// silently opt out referees who never tapped). The objection happens on
+/// POST.
+pub fn handle_stop_get(
+  _req: Request,
+  config: ServerConfig,
+  token: String,
+) -> Response {
+  exit_get(config, token, form_pages.view_stop_confirm(token:))
+}
+
+pub fn handle_stop_post(
+  req: Request,
+  config: ServerConfig,
+  token: String,
+) -> Response {
+  use form_data <- wisp.require_form(req)
+  let values = form_data.values
+  case lookup_context(config.db, token) {
+    Error(NotFound) -> render_not_found()
+    Error(LookupQueryFailed(msg)) -> {
+      wisp.log_error("reference stop: lookup failed: " <> msg)
+      wisp.internal_server_error()
+    }
+    Ok(row) ->
+      case classify_row(row) {
+        Live | ExpiredOpen ->
+          case
+            application_handler.is_honeypot_filled(values)
+            || is_resend_timing_suspicious(values)
+          {
+            // Fake success WITHOUT objecting — critical: a fake object on a
+            // leaked token would silently opt out a real referee. The row
+            // stays untouched; the bot sees only the confirmation page.
+            True ->
+              form_pages.view_stop_confirmed()
+              |> ssr_response.to_sensitive_response
+            False ->
+              apply_objection(
+                config,
+                token,
+                row,
+                "web",
+                objection_payload_ref(req, row),
+              )
+          }
+        // Already terminal (sticky objected / completed / ...): the GET
+        // renders the truthful state page.
+        _ -> wisp.redirect(to: "/reference/" <> token)
+      }
+  }
+}
+
+/// THE single writer of `reference_objection_log` (AD-6/§9.2). The guarded
+/// terminal UPDATE runs first; the Art 21 evidence row is inserted ONLY when
+/// that UPDATE returns a row (the real transition). So the log is written at
+/// most once, at objection time — a re-tap or a late bounce on an
+/// already-objected row is a 0-row no-op (AD-14 stickiness).
+fn apply_objection(
+  config: ServerConfig,
+  token: String,
+  row: sql.GetFormContextByFormTokenRow,
+  channel: String,
+  payload_ref: String,
+) -> Response {
+  let minimal =
+    result.minimal_terminal_result(
+      outcome: "objected",
+      attempts: row.attempts,
+      note: option.None,
+    )
+  case uuid.from_string(row.id), uuid.from_string(row.application_id) {
+    Error(_), _ | _, Error(_) -> {
+      wisp.log_error("reference objection: corrupt row id")
+      wisp.internal_server_error()
+    }
+    Ok(id_uuid), Ok(app_uuid) ->
+      case
+        sql.terminalize_reference_call(
+          config.db,
+          id_uuid,
+          sql.Objected,
+          "objected",
+          "objection_" <> channel,
+          minimal,
+          sql.ContactInitiated,
+        )
+      {
+        Ok(pog.Returned(_, [_, ..])) -> {
+          // The transition happened — write the Art 21 evidence (once).
+          insert_objection_evidence(
+            config.db,
+            config.sentry,
+            id_uuid,
+            app_uuid,
+            row.ref_slot,
+            channel,
+            payload_ref,
+          )
+          audit_terminal(
+            config.db,
+            config.sentry,
+            row,
+            event_type.ReferenceCallObjected,
+            json.object([#("channel", json.string(channel))]),
+          )
+          notify_reference_event(config, row, ReferenceObjected)
+          form_pages.view_stop_confirmed()
+          |> ssr_response.to_sensitive_response
+        }
+        // 0 rows: already terminal (sticky). No second evidence row. The
+        // GET renders the truthful state page.
+        Ok(pog.Returned(_, [])) -> wisp.redirect(to: "/reference/" <> token)
+        Error(err) -> {
+          wisp.log_error(
+            "reference objection: terminalize failed: " <> string.inspect(err),
+          )
+          wisp.internal_server_error()
+        }
+      }
+  }
+}
+
+/// Insert the Art 21 evidence row. A failed write captures to Sentry but
+/// does not strand the referee after a successful objection transition
+/// (the status flip already stops all sends; the evidence row is the
+/// compliance trail, best-effort alongside it).
+fn insert_objection_evidence(
+  db: pog.Connection,
+  sentry: sentry_client.Sentry,
+  reference_call_id: uuid.Uuid,
+  application_id: uuid.Uuid,
+  ref_slot: String,
+  channel: String,
+  payload_ref: String,
+) -> Nil {
+  case
+    sql.insert_reference_objection_log(
+      db,
+      reference_call_id,
+      application_id,
+      ref_slot,
+      channel,
+      payload_ref,
+    )
+  {
+    Ok(_) -> Nil
+    Error(err) -> {
+      wisp.log_error(
+        "reference objection: evidence log failed: " <> string.inspect(err),
+      )
+      sentry_client.capture(
+        sentry,
+        sentry_client.BackgroundEvent(
+          event_type: "ReferenceObjectionLogFailed",
+          message: "reference-call objection evidence log write failed",
+          level: sentry_client.LevelError,
+          tags: [#("entity_id", uuid.to_string(reference_call_id))],
+        ),
+      )
+    }
+  }
+}
+
