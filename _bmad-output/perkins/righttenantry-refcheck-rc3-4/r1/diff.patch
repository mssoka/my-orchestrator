+}
+
+fn apply_wrong_person(
+  config: ServerConfig,
+  token: String,
+  row: sql.GetFormContextByFormTokenRow,
+) -> Response {
+  case uuid.from_string(row.id) {
+    Error(_) -> {
+      wisp.log_error("reference wrong-person: corrupt row id")
+      wisp.internal_server_error()
+    }
+    Ok(id_uuid) ->
+      // AwaitingCorrection is non-terminal but NULLs next_attempt_at (the
+      // CASE now includes it, AD-7): the sweep never re-sends to the bad
+      // contact. No notification (the landlord sees the state in RC4); no
+      // applicant correction email (landlord-driven in v1, §8.3).
+      case
+        sql.update_reference_call_status(
+          config.db,
+          id_uuid,
+          sql.AwaitingCorrection,
+          "",
+          "contact_invalid",
+          sql.ContactInitiated,
+        )
+      {
+        Ok(pog.Returned(_, [_, ..])) -> {
+          audit_terminal(
+            config.db,
+            config.sentry,
+            row,
+            event_type.ReferenceCallWrongPerson,
+            json.null(),
+          )
+          form_pages.view_wrong_person_confirmed()
+          |> ssr_response.to_sensitive_response
+        }
+        Ok(pog.Returned(_, [])) -> wisp.redirect(to: "/reference/" <> token)
+        Error(err) -> {
+          wisp.log_error(
+            "reference wrong-person: status update failed: "
+            <> string.inspect(err),
+          )
+          wisp.internal_server_error()
+        }
+      }
+  }
+}
