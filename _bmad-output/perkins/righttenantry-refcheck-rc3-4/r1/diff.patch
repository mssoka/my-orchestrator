diff --git a/server/src/reference_checks/result.gleam b/server/src/reference_checks/result.gleam
new file mode 100644
index 00000000..f5f45d24
--- /dev/null
+++ b/server/src/reference_checks/result.gleam
@@ -0,0 +1,554 @@
+//// The deterministic `ReferenceCallResult v1` structurer (AD-9).
+////
+//// Pure server-side code: a completed referee form's `draft_answers` map
+//// directly onto the result's `verification` block, per slot (A9). No LLM in
+//// v1 — `ai_summary` is a templated rendering of the verification block and
+//// `confidence` derives from answer completeness. Voice-only fields are
+//// v2-reserved and absent (the AD-9 absence contract).
+////
+//// Two entry points:
+////   - `structure_form_result` — the full v1 result for a submitted form
+////     (channel: "form"), returning #(result, fraud_signals) so the handler
+////     writes both the `result` JSONB and the denormalised `fraud_signals`
+////     copy from one deterministic build.
+////   - `minimal_terminal_result` — the §4.6 shape for the decline (refused)
+////     and objection (objected) terminals: outcome + attempts, null
+////     `verification`. The §10 uniform-read rule wants every non-`failed`
+////     terminal to emit exactly one result entry.
+////
+//// Field names follow architecture §6.2 + §5.3 (the heist-535 schema of
+//// record, verbatim where it applies). Unanswered fields are null, never
+//// invented.
+
+import gleam/dict
+import gleam/dynamic/decode
+import gleam/int
+import gleam/json
+import gleam/list
+import gleam/option.{type Option, None, Some}
+import reference_checks/questions.{type Draft}
+import shared/reference_call.{
+  type RefSlot, CharacterRef, EmployerRef, LandlordRef,
+}
+
+/// What the structurer needs from the row + the request. Kept as a record so
+/// the call site reads clearly and the pure function stays testable.
+pub type StructureContext {
+  StructureContext(
+    reference_call_id: String,
+    application_id: String,
+    ref_slot: String,
+    owner_label: String,
+    attempts: String,
+    focus_seconds: Int,
+  )
+}
+
+/// Build the full v1 result for a submitted referee form. Returns
+/// `#(result_json, fraud_signals_json)` — the handler writes `result` and
+/// passes the same `fraud_signals` object to the denormalised column.
+pub fn structure_form_result(
+  slot slot: RefSlot,
+  draft draft: Draft,
+  ctx ctx: StructureContext,
+) -> #(json.Json, json.Json) {
+  let verification = verification_block(slot, draft)
+  let completeness = required_completeness(slot, draft)
+  let fraud_signals = form_session_fraud_signals(ctx)
+  let attempts = parse_attempts(ctx.attempts)
+  let result =
+    json.object([
+      #("schema_version", json.string("refcall-v1")),
+      #("reference_call_id", json.string(ctx.reference_call_id)),
+      #("application_id", json.string(ctx.application_id)),
+      #("ref_slot", json.string(ctx.ref_slot)),
+      #("owner_label", json.string(ctx.owner_label)),
+      #("channel", json.string("form")),
+      #("outcome", json.string("form_completed")),
+      #("attempts", attempts),
+      #("verification", verification),
+      #("fraud_signals", fraud_signals),
+      #("ai_summary", ai_summary(slot, draft, completeness)),
+      #(
+        "compliance",
+        json.object([
+          #("gdpr_notice_given", json.bool(True)),
+          #("referee_channel_preference", json.null()),
+          #("recording_consent", json.string("not_recorded")),
+        ]),
+      ),
+      // transcript is v2-reserved (voice) — absent, never placeholder.
+    ])
+  #(result, fraud_signals)
+}
+
+/// The §4.6 minimal terminal result (decline / objection): schema_version,
+/// outcome, attempts, and a null `verification` (no form answers structured).
+/// `note` carries the optional free-text decline reason (persisted in the
+/// result JSONB for the landlord's context; objection passes None).
+pub fn minimal_terminal_result(
+  outcome outcome: String,
+  attempts attempts: String,
+  note note: Option(String),
+) -> json.Json {
+  let note_entry = case note {
+    Some(text) -> [#("decline_reason", json.string(text))]
+    None -> []
+  }
+  json.object([
+    #("schema_version", json.string("refcall-v1")),
+    #("channel", json.string("form")),
+    #("outcome", json.string(outcome)),
+    #("attempts", parse_attempts(attempts)),
+    #("verification", json.null()),
+    ..note_entry
+  ])
+}
+
+// -- Per-slot verification blocks (A9) ----------------------------------------
+
+fn verification_block(slot: RefSlot, draft: Draft) -> json.Json {
+  case slot {
+    LandlordRef -> landlord_verification(draft)
+    EmployerRef -> employer_verification(draft)
+    CharacterRef -> character_verification(draft)
+  }
+}
+
+/// Landlord slot (§5.3): identity, relationship, tenancy, rent, payment
+/// record, property condition, notice, deposit, would-rent-again, free text.
+fn landlord_verification(draft: Draft) -> json.Json {
+  json.object([
+    #("identity_confirmed", str_or_null(draft, "identity_confirmed")),
+    #(
+      "relationship_to_applicant",
+      str_or_null(draft, "relationship_to_applicant"),
+    ),
+    // relationship_other rides alongside when relationship == "other".
+    #("relationship_other", str_or_null(draft, "relationship_other")),
+    #("tenancy_confirmed", str_or_null(draft, "tenancy_confirmed")),
+    #("tenancy_period", tenancy_period_value(draft)),
+    // The form's AmountOrDontRemember stores under "rent_amount"; the schema
+    // field is rent_amount_confirmed (§5.3).
+    #("rent_amount_confirmed", amount_value(draft, "rent_amount")),
+    #("rent_payment_record", str_or_null(draft, "rent_payment_record")),
+    #("property_condition", str_or_null(draft, "property_condition")),
+    #("notice_given_properly", str_or_null(draft, "notice_given_properly")),
+    #("deposit_returned", str_or_null(draft, "deposit_returned")),
+    #("would_rent_again", str_or_null(draft, "would_rent_again")),
+    #("free_text_signals", free_text_signals(draft)),
+  ])
+}
+
+/// Employer slot (§15 per-slot variants): identity, relationship,
+/// works-at, employment period, role, salary, would-rehire, free text.
+fn employer_verification(draft: Draft) -> json.Json {
+  json.object([
+    #("identity_confirmed", str_or_null(draft, "identity_confirmed")),
+    #(
+      "relationship_to_applicant",
+      str_or_null(draft, "relationship_to_applicant"),
+    ),
+    #("relationship_other", str_or_null(draft, "relationship_other")),
+    #("works_at_confirmed", str_or_null(draft, "works_at_confirmed")),
+    #("employment_period", as_stated_text_value(draft, "employment_period")),
+    #("role_confirmed", as_stated_text_value(draft, "role_confirmed")),
+    #("salary_confirmed", as_stated_amount_value(draft, "salary_confirmed")),
+    #("would_rehire", str_or_null(draft, "would_rehire")),
+    #("free_text_signals", free_text_signals(draft)),
+  ])
+}
+
+/// Character slot (§15): identity, relationship + capacity, known duration,
+/// character statement, would-stand-again.
+fn character_verification(draft: Draft) -> json.Json {
+  json.object([
+    #("identity_confirmed", str_or_null(draft, "identity_confirmed")),
+    #("relationship", str_or_null(draft, "relationship")),
+    #("capacity", str_or_null(draft, "capacity")),
+    #("known_duration", str_or_null(draft, "known_duration")),
+    #("character_statement", str_or_null(draft, "character_statement")),
+    #("would_stand_again", str_or_null(draft, "would_stand_again")),
+  ])
+}
+
+// -- Deterministic ai_summary + completeness-derived confidence ---------------
+
+/// Completeness over the slot's REQUIRED answers (free text is optional and
+/// does not cap confidence).
+fn required_completeness(slot: RefSlot, draft: Draft) -> Float {
+  let required = required_draft_keys(slot)
+  let total = list.length(required)
+  case total {
+    0 -> 1.0
+    n -> {
+      let answered =
+        required
+        |> list.count(fn(key) { has_draft_key(draft, key) })
+      int.to_float(answered) /. int.to_float(n)
+    }
+  }
+}
+
+fn ai_summary(slot: RefSlot, draft: Draft, completeness: Float) -> json.Json {
+  json.object([
+    #("headline", json.string(headline(slot, draft))),
+    #("summary", json.string(summary(slot, draft))),
+    #("confidence", json.string(confidence_label(completeness))),
+  ])
+}
+
+/// high = every required answer present; medium = at least half; low = below.
+fn confidence_label(completeness: Float) -> String {
+  case completeness >=. 0.9999 {
+    True -> "high"
+    False ->
+      case completeness >=. 0.5 {
+        True -> "medium"
+        False -> "low"
+      }
+  }
+}
+
+/// One-line templated headline from the slot's headline answers.
+fn headline(slot: RefSlot, draft: Draft) -> String {
+  case slot {
+    LandlordRef -> {
+      let tenancy = draft_str(draft, "tenancy_confirmed")
+      let pay = pretty_payment(draft_str(draft, "rent_payment_record"))
+      case tenancy, pay {
+        "yes", p if p != "" -> "Tenancy confirmed; rent " <> p <> "."
+        "no", _ -> "Tenancy not confirmed."
+        _, "" -> "Tenancy: " <> unknownish(tenancy) <> "."
+        _, _ -> "Tenancy: " <> unknownish(tenancy) <> "."
+      }
+    }
+    EmployerRef -> {
+      let works = draft_str(draft, "works_at_confirmed")
+      let rehire = draft_str(draft, "would_rehire")
+      case works, rehire {
+        "yes", "yes" -> "Employment confirmed; would rehire."
+        "yes", _ -> "Employment confirmed."
+        _, _ -> "Employment: " <> unknownish(works) <> "."
+      }
+    }
+    CharacterRef -> {
+      let again = draft_str(draft, "would_stand_again")
+      case again {
+        "yes" -> "Would stand as referee again."
+        _ -> "Character reference submitted."
+      }
+    }
+  }
+}
+
+/// Short prose rendering of the key fields.
+fn summary(slot: RefSlot, draft: Draft) -> String {
+  case slot {
+    LandlordRef ->
+      "Identity "
+      <> yes_no(draft_str(draft, "identity_confirmed"))
+      <> ". Payment record: "
+      <> unknownish(pretty_payment(draft_str(draft, "rent_payment_record")))
+      <> ". Property: "
+      <> unknownish(draft_str(draft, "property_condition"))
+      <> "."
+    EmployerRef ->
+      "Identity "
+      <> yes_no(draft_str(draft, "identity_confirmed"))
+      <> ". Role confirmed: "
+      <> as_stated_label(draft, "role_confirmed")
+      <> "."
+    CharacterRef ->
+      "Identity "
+      <> yes_no(draft_str(draft, "identity_confirmed"))
+      <> ". Known for "
+      <> unknownish(known_duration_label(draft_str(draft, "known_duration")))
+      <> "."
+  }
+}
+
+// -- Draft readers (self-contained — the draft is flat key -> JSON value) -----
+
+fn draft_str(draft: Draft, key: String) -> String {
+  case dict.get(draft, key) {
+    Ok(value) ->
+      case decode.run(value, decode.string) {
+        Ok(s) -> s
+        Error(_) -> ""
+      }
+    Error(_) -> ""
+  }
+}
+
+fn has_draft_key(draft: Draft, key: String) -> Bool {
+  case dict.get(draft, key) {
+    Error(_) -> False
+    Ok(value) -> {
+      // Answered = a non-empty string (Choice/Identity/FreeText) OR a
+      // non-null object (MonthYear/Amount/AsStated). The validate layer
+      // only writes a required key on a valid answer; a null would be a
+      // cleared conditional (relationship_other), not a required key.
+      case decode.run(value, decode.string) {
+        Ok(s) -> s != ""
+        Error(_) ->
+          // Not a string: an object counts as answered; null does not
+          // (decode.dict succeeds on an object, fails on null).
+          case decode.run(value, decode.dict(decode.string, decode.dynamic)) {
+            Ok(_) -> True
+            Error(_) -> False
+          }
+      }
+    }
+  }
+}
+
+fn draft_obj_str(draft: Draft, key: String, field: String) -> String {
+  case dict.get(draft, key) {
+    Ok(value) ->
+      case decode.run(value, decode.at([field], decode.string)) {
+        Ok(s) -> s
+        Error(_) -> ""
+      }
+    Error(_) -> ""
+  }
+}
+
+fn draft_obj_flag(draft: Draft, key: String, field: String) -> Bool {
+  case dict.get(draft, key) {
+    Ok(value) ->
+      case decode.run(value, decode.at([field], decode.bool)) {
+        Ok(b) -> b
+        Error(_) -> False
+      }
+    Error(_) -> False
+  }
+}
+
+fn str_or_null(draft: Draft, key: String) -> json.Json {
+  case draft_str(draft, key) {
+    "" -> json.null()
+    s -> json.string(s)
+  }
+}
+
+/// tenancy_period: {from, to} | {from, ongoing: true} | null.
+fn tenancy_period_value(draft: Draft) -> json.Json {
+  let from = draft_obj_str(draft, "tenancy_period", "from")
+  case from {
+    "" -> json.null()
+    _ ->
+      case draft_obj_flag(draft, "tenancy_period", "ongoing") {
+        True ->
+          json.object([
+            #("from", json.string(from)),
+            #("ongoing", json.bool(True)),
+          ])
+        False -> {
+          let to = draft_obj_str(draft, "tenancy_period", "to")
+          json.object([
+            #("from", json.string(from)),
+            #("to", json.string(to)),
+          ])
+        }
+      }
+  }
+}
+
+/// rent_amount / AmountOrDontRemember: {amount_eur} | {dont_remember} | null.
+fn amount_value(draft: Draft, key: String) -> json.Json {
+  case draft_obj_str(draft, key, "amount_eur") {
+    "" ->
+      case draft_obj_flag(draft, key, "dont_remember") {
+        True -> json.object([#("dont_remember", json.bool(True))])
+        False -> json.null()
+      }
+    amount -> json.object([#("amount_eur", json.string(amount))])
+  }
+}
+
+/// AsStatedText (employment_period / role_confirmed): {as_stated} |
+/// {differs: text} | {stated: text} | null.
+fn as_stated_text_value(draft: Draft, key: String) -> json.Json {
+  case draft_obj_flag(draft, key, "as_stated") {
+    True -> json.object([#("as_stated", json.bool(True))])
+    False -> {
+      let differs = draft_obj_str(draft, key, "differs")
+      case differs {
+        "" -> {
+          let stated = draft_obj_str(draft, key, "stated")
+          case stated {
+            "" -> json.null()
+            s -> json.object([#("stated", json.string(s))])
+          }
+        }
+        t -> json.object([#("differs", json.string(t))])
+      }
+    }
+  }
+}
+
+/// AsStatedAmount (salary_confirmed): {as_stated} | {different_amount_eur} |
+/// {dont_know} | null.
+fn as_stated_amount_value(draft: Draft, key: String) -> json.Json {
+  case draft_obj_flag(draft, key, "as_stated") {
+    True -> json.object([#("as_stated", json.bool(True))])
+    False -> {
+      let different = draft_obj_str(draft, key, "different_amount_eur")
+      case different {
+        "" ->
+          case draft_obj_flag(draft, key, "dont_know") {
+            True -> json.object([#("dont_know", json.bool(True))])
+            False -> json.null()
+          }
+        a -> json.object([#("different_amount_eur", json.string(a))])
+      }
+    }
+  }
+}
+
+/// free_text_signals: the optional free-text answer as a single-element array
+/// (verbatim), or [] when absent/empty (the special-category display warning
+/// is the landlord-display concern, RC4).
+fn free_text_signals(draft: Draft) -> json.Json {
+  case draft_str(draft, "free_text") {
+    "" -> json.array([], json.string)
+    text -> json.array([text], json.string)
+  }
+}
+
+// -- Attempts: parse the row's JSONB log and re-emit typed -------------------
+
+/// Parse the attempts JSON text into a typed array. Malformed -> []. Each
+/// entry is {at, channel, outcome, detail} (messages.AttemptEntry shape).
+fn parse_attempts(attempts_text: String) -> json.Json {
+  let entries = case attempts_text {
+    "" -> []
+    _ ->
+      case json.parse(attempts_text, decode.list(attempt_decoder())) {
+        Ok(rows) -> rows
+        Error(_) -> []
+      }
+  }
+  json.array(entries, fn(e) {
+    json.object([
+      #("at", json.string(e.at)),
+      #("channel", json.string(e.channel)),
+      #("outcome", json.string(e.outcome)),
+      #("detail", json.string(e.detail)),
+    ])
+  })
+}
+
+fn attempt_decoder() -> decode.Decoder(AttemptRow) {
+  use at <- decode.optional_field("at", "", decode.string)
+  use channel <- decode.optional_field("channel", "", decode.string)
+  use outcome <- decode.optional_field("outcome", "", decode.string)
+  use detail <- decode.optional_field("detail", "", decode.string)
+  decode.success(AttemptRow(at:, channel:, outcome:, detail:))
+}
+
+type AttemptRow {
+  AttemptRow(at: String, channel: String, outcome: String, detail: String)
+}
+
+// -- form_session fraud inputs (AD-10; rc3-7 enriches with line-type/DB) -----
+
+/// rc3-4 captures the client-reported focus seconds. completion_seconds and
+/// the line-type / DB-reuse signals are rc3-7's concern (the row's
+/// form_opened_at + submitted_at let rc3-7 compute completion_seconds later).
+fn form_session_fraud_signals(ctx: StructureContext) -> json.Json {
+  json.object([
+    #(
+      "form_session",
+      json.object([
+        #("focus_seconds_reported", json.int(ctx.focus_seconds)),
+        // completion_seconds is filled by rc3-7 from the row's timestamps.
+        #("completion_seconds", json.null()),
+      ]),
+    ),
+  ])
+}
+
+// -- The required-draft-keys registry per slot (completeness + nothing else) --
+
+fn required_draft_keys(slot: RefSlot) -> List(String) {
+  case slot {
+    LandlordRef -> [
+      "identity_confirmed",
+      "relationship_to_applicant",
+      "tenancy_confirmed",
+      "tenancy_period",
+      "rent_amount",
+      "rent_payment_record",
+      "property_condition",
+      "notice_given_properly",
+      "deposit_returned",
+      "would_rent_again",
+    ]
+    EmployerRef -> [
+      "identity_confirmed",
+      "relationship_to_applicant",
+      "works_at_confirmed",
+      "employment_period",
+      "role_confirmed",
+      "salary_confirmed",
+      "would_rehire",
+    ]
+    CharacterRef -> [
+      "identity_confirmed",
+      "relationship",
+      "capacity",
+      "known_duration",
+      "character_statement",
+      "would_stand_again",
+    ]
+  }
+}
+
+// -- Small copy-helpers for the deterministic summary (wire labels -> prose) --
+
+fn pretty_payment(wire: String) -> String {
+  case wire {
+    "always_on_time" -> "always on time"
+    "mostly_on_time" -> "mostly on time"
+    "often_late" -> "often late"
+    "dont_know" -> ""
+    _ -> ""
+  }
+}
+
+fn known_duration_label(wire: String) -> String {
+  case wire {
+    "lt_1_year" -> "under a year"
+    "y1_3" -> "1 to 3 years"
+    "y3_10" -> "3 to 10 years"
+    "gt_10_years" -> "over 10 years"
+    _ -> ""
+  }
+}
+
+fn as_stated_label(draft: Draft, key: String) -> String {
+  case draft_obj_flag(draft, key, "as_stated") {
+    True -> "yes"
+    False ->
+      case draft_obj_str(draft, key, "differs") {
+        "" -> "not answered"
+        _ -> "differs"
+      }
+  }
+}
+
+fn yes_no(wire: String) -> String {
+  case wire {
+    "yes" -> "confirmed"
+    _ -> "not confirmed"
+  }
+}
+
+fn unknownish(value: String) -> String {
+  case value {
+    "" -> "not answered"
+    _ -> value
+  }
+}
diff --git a/server/src/reference_checks/sql.gleam b/server/src/reference_checks/sql.gleam
index 66dc7a53..d0181514 100644
--- a/server/src/reference_checks/sql.gleam
+++ b/server/src/reference_checks/sql.gleam
@@ -59,6 +59,91 @@ RETURNING id::text;
   |> pog.execute(db)
 }
 
+/// A row you get from running the `complete_reference_call` query
+/// defined in `./src/reference_checks/sql/complete_reference_call.sql`.
+///
+/// > 🐿️ This type definition was generated automatically using v4.6.0 of the
+/// > [squirrel package](https://github.com/giacomocavalieri/squirrel).
+///
+pub type CompleteReferenceCallRow {
+  CompleteReferenceCallRow(id: String)
+}
+
+/// Guarded submit transition (AD-14): only from 'contact_initiated'. A
+/// concurrent terminal (or a late takeover race) yields 0 rows and the
+/// writer stands down — the GET tells the truth (the existing classifier
+/// renders the row's real state).
+/// 
+/// Writes the structured ReferenceCallResult v1 (AD-9) to `result`,
+/// denormalises `fraud_signals` for querying, stamps `submitted_at`, clears
+/// `next_attempt_at` (terminal), and stamps `purge_after` from the
+/// APPLICATION's `retention_due_at` when set (§9.3: referee data follows the
+/// application's retention schedule). terminal_reason 'form_submitted' is the
+/// machine slug (AD-16 audit + the §4.6 mapping).
