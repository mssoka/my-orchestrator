+/// Shared dispatch for the three reference events: in-app notification on the
+/// reference_call entity + a best-effort realtime email linking the landlord
+/// to the application detail (where the reference panel renders).
+fn dispatch_reference_notification(
+  db db: pog.Connection,
+  landlord_id landlord_id: Uuid,
+  vacancy_id vacancy_id: Uuid,
+  application_id application_id: Uuid,
+  reference_call_id reference_call_id: Uuid,
+  notif_type notif_type: sql.NotificationType,
+  title title: String,
+  body body: String,
+  resend_api_key resend_api_key: String,
+  origin_domain origin_domain: String,
+) -> Result(String, String) {
+  case
+    dispatch(
+      db,
+      landlord_id,
+      notif_type,
+      title,
+      body,
+      "reference_call",
+      reference_call_id,
+    )
+  {
+    Ok(notif_id) -> {
+      maybe_send_email(
+        db:,
+        landlord_id:,
+        resend_api_key:,
+        subject: title,
+        body_text: body,
+        cta_text: "View application",
+        cta_url: email_client.build_entity_url(
+          origin_domain:,
+          path: "/vacancies/"
+            <> uuid.to_string(vacancy_id)
+            <> "/applications/"
+            <> uuid.to_string(application_id),
+        ),
+      )
+      Ok(notif_id)
+    }
+    Error(err) -> Error(err)
+  }
+}
