+pub fn handle_wrong_person_post(
+  req: Request,
+  config: ServerConfig,
+  token: String,
+) -> Response {
+  use form_data <- wisp.require_form(req)
+  let values = form_data.values
+  case lookup_context(config.db, token) {
+    Error(NotFound) -> render_not_found()
+    Error(LookupQueryFailed(msg)) -> {
+      wisp.log_error("reference wrong-person: lookup failed: " <> msg)
+      wisp.internal_server_error()
+    }
+    Ok(row) ->
+      case classify_row(row) {
+        Live | ExpiredOpen ->
+          case
