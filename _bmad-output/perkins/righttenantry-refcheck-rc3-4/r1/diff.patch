+// -- RC3.4 exit routes: submit, decline, stop (objection), wrong-person ----------
+
+// -- Submit (POST /reference/:token) ------------------------------------------
+
+/// The completed-form submit: validate, structure the deterministic
+/// ReferenceCallResult v1 (AD-9), guarded-transition to form_completed,
+/// audit, notify, render the thank-you. A second POST on a terminal token
+/// redirects to the GET (the branded state page) — one submission (AD-3).
+pub fn handle_submit(
+  req: Request,
+  config: ServerConfig,
+  token: String,
+) -> Response {
+  use form_data <- wisp.require_form(req)
+  let values = form_data.values
+  case lookup_context(config.db, token) {
+    Error(NotFound) -> render_not_found()
+    Error(LookupQueryFailed(msg)) -> {
+      wisp.log_error("reference submit: lookup failed: " <> msg)
+      wisp.internal_server_error()
+    }
+    Ok(row) ->
+      case classify_row(row) {
+        Live ->
+          case
+            application_handler.is_honeypot_filled(values)
+            || is_resend_timing_suspicious(values)
+          {
+            // Fake success: the thank-you a clean referee would see, persisting
+            // nothing (a bot learns nothing; the row is untouched).
+            True ->
+              form_pages.view_thank_you(copy_vars(row))
+              |> ssr_response.to_sensitive_response
+            False -> save_submit(config, token, row, values)
+          }
+        // State moved (already completed / declined / expired / ...): the
+        // GET re-renders the truthful state page.
+        _ -> wisp.redirect(to: "/reference/" <> token)
+      }
+  }
+}
+
+fn save_submit(
+  config: ServerConfig,
+  token: String,
+  row: sql.GetFormContextByFormTokenRow,
+  values: List(#(String, String)),
+) -> Response {
+  let slot = reference_call.ref_slot_from_string(row.ref_slot)
+  let draft = questions.decode_draft(row.draft_answers)
+  case questions.next_unanswered(slot, dict.keys(draft)) {
+    // A crafted POST with required answers missing: re-render the form at
+    // the first unanswered question (mirrors the no-JS answer error path).
+    Some(missing) ->
+      render_form_page(
+        token:,
+        slot:,
+        vars: copy_vars(row),
+        draft:,
+        current_id: missing.id,
+        error_question: None,
+        error_message: "",
+        prefill_override: None,
+      )
+    None ->
+      case uuid.from_string(row.id) {
+        Error(_) -> {
+          wisp.log_error("reference submit: corrupt row id")
+          wisp.internal_server_error()
+        }
+        Ok(id_uuid) -> {
+          let ctx =
+            result.StructureContext(
+              reference_call_id: row.id,
+              application_id: row.application_id,
+              ref_slot: row.ref_slot,
+              // owner_label defaults to primary (co-applicant refs are
+              // deferred in v1, AD-13; get_form_context doesn't surface it).
+              owner_label: "primary",
+              attempts: row.attempts,
+              focus_seconds: parse_focus_seconds(values),
+            )
+          let #(result_json, fraud_json) =
+            result.structure_form_result(slot, draft, ctx)
+          case
+            sql.complete_reference_call(
+              config.db,
+              id_uuid,
+              result_json,
+              fraud_json,
+              row.retention_due_at,
+            )
+          {
+            Ok(pog.Returned(_, [_, ..])) -> {
+              audit_terminal(
+                config.db,
+                config.sentry,
+                row,
+                event_type.ReferenceCallCompleted,
+                json.null(),
+              )
+              notify_reference_event(config, row, ReferenceCompleted)
+              form_pages.view_thank_you(copy_vars(row))
+              |> ssr_response.to_sensitive_response
+            }
+            // 0 rows: state moved mid-submit (takeover/terminal race) — the
+            // GET tells the truth.
+            Ok(pog.Returned(_, [])) -> wisp.redirect(to: "/reference/" <> token)
+            Error(err) -> {
+              wisp.log_error(
+                "reference submit: complete failed: " <> string.inspect(err),
+              )
+              wisp.internal_server_error()
+            }
+          }
+        }
+      }
+  }
+}
+
+// -- Decline (GET/POST /reference/:token/decline -> refused) -------------------
