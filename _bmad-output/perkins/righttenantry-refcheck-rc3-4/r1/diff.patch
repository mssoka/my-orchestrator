+        action: "/reference/" <> token <> "/stop",
+        button_label: form_copy.stop_confirm_button,
+        form_testid: "reference-stop-form",
+        button_testid: "reference-stop-submit",
+        extra_fields: [],
+      ),
+    ],
+    testid: "reference-stop-confirm",
+  )
+}
+
+/// POST confirmation (§10.2).
+pub fn view_stop_confirmed() -> String {
