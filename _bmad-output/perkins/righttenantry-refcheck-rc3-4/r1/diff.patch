+//// RC3.4 exit-route integration tests — durable DB-level pins for the
+//// acceptance criteria: submit (deterministic result + guarded transition +
+//// one-submission), decline (refused), objection (sticky + Art 21 evidence
+//// once), wrong-person (awaiting_correction + no resend), and the route-
+//// registry coverage (AC8: every new /reference/* POST is public + CSRF-
+//// skipped + redacted through the full middleware stack).
+
+import application/form_view
+import auth/cookie_names
+import gleam/dynamic/decode
+import gleam/http
+import gleam/int
+import gleam/list
+import gleam/option
+import gleam/result
+import gleam/string
+import gleeunit/should
+import integration/helpers.{setup, test_server_config}
+import integration/test_db
+import middleware
+import pog
+import router
+import sentry/sentry_client
+import unitest
+import wisp
+import wisp/simulate
+
+// --- seed helpers (mirror reference_form_integration_test) -------------------
+
+fn seed_reference_call(
+  db: pog.Connection,
+  email: String,
+  status: String,
+  expiry_sql: String,
+) -> #(String, String) {
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 0)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let assert Ok(returned) =
+    pog.query(
+      "INSERT INTO application (
+         vacancy_id, first_name, last_name, email, phone,
+         employment_status, monthly_income_cents,
+         employer_name, job_title, employment_duration,
+         landlord_ref_name, landlord_ref_email, landlord_ref_phone,
+         never_rented_before, reference_contact_choice
+       )
+       VALUES (
+         $1::uuid, 'Aisling', 'O''Brien', $2, '+353861234567',
+         'employed', 350000,
+         'Acme Ltd', 'Senior Chef', '3 years',
+         'Colm Byrne', $2, '+353871111111',
+         false, 'attested'
+       )
+       RETURNING id::text",
+    )
+    |> pog.parameter(pog.text(vacancy_id))
+    |> pog.parameter(pog.text(email))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  let assert [application_id, ..] = returned.rows
+  let token = "rc34-exit-" <> email
+  let assert Ok(inserted) =
+    pog.query("INSERT INTO reference_call (
+         application_id, ref_slot, status, contact_name, contact_email,
+         contact_phone, form_token, form_token_expires_at, next_attempt_at
+       )
+       VALUES (
+         $1::uuid, 'landlord_ref', $2::reference_call_status, 'Colm Byrne',
+         'colm@example.com', '+353871111111', $3, " <> expiry_sql <> ", now()
+       )
+       RETURNING id::text")
+    |> pog.parameter(pog.text(application_id))
+    |> pog.parameter(pog.text(status))
+    |> pog.parameter(pog.text(token))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  let assert [row_id, ..] = inserted.rows
+  #(row_id, token)
+}
+
+/// Seed every required landlord answer into draft_answers (a complete form).
+fn seed_complete_landlord_draft(db: pog.Connection, token: String) -> Nil {
+  let draft =
+    "{\"identity_confirmed\":\"yes\",\"relationship_to_applicant\":\"landlord\","
+    <> "\"tenancy_confirmed\":\"yes\","
+    <> "\"tenancy_period\":{\"from\":\"2023-01\",\"to\":\"2024-06\"},"
+    <> "\"rent_amount\":{\"amount_eur\":\"1500\"},"
+    <> "\"rent_payment_record\":\"always_on_time\",\"property_condition\":\"good\","
+    <> "\"notice_given_properly\":\"yes\",\"deposit_returned\":\"in_full\","
+    <> "\"would_rent_again\":\"yes\",\"free_text\":\"Great tenant.\"}"
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE reference_call SET draft_answers = $2::jsonb WHERE form_token = $1",
+    )
+    |> pog.parameter(pog.text(token))
+    |> pog.parameter(pog.text(draft))
+    |> pog.returning(decode.at([0], decode.int))
+    |> pog.execute(db)
+  Nil
+}
+
+fn text_column(db: pog.Connection, token: String, column: String) -> String {
+  test_db.query_text(
+    db,
+    "SELECT COALESCE("
+      <> column
+      <> "::text, '') FROM reference_call WHERE form_token = '"
+      <> token
+      <> "'",
+  )
+  |> result.unwrap("missing")
+}
+
+fn result_field(db: pog.Connection, token: String, field: String) -> String {
+  test_db.query_text(
+    db,
+    "SELECT COALESCE(result->>'"
+      <> field
+      <> "', '') FROM reference_call WHERE form_token = '"
+      <> token
+      <> "'",
+  )
+  |> result.unwrap("missing")
+}
+
+fn objection_log_count(db: pog.Connection, row_id: String) -> Int {
+  test_db.query_text(
+    db,
+    "SELECT count(*)::text FROM reference_objection_log WHERE reference_call_id = '"
+      <> row_id
+      <> "'::uuid",
+  )
+  |> result.unwrap("0")
+  |> int.parse
+  |> result.unwrap(0)
+}
+
+fn timing_fields() -> List(#(String, String)) {
+  // 10s since page load: above every fast floor, below the stale cap.
+  let loaded = form_view.current_unix_ms() - 10_000
+  [#("_website", ""), #("_form_loaded_at", int.to_string(loaded))]
+}
+
+fn test_router_context(db: pog.Connection) -> router.Context {
+  router.Context(
+    config: test_server_config(db),
+    static_directory: "",
+    priv_directory: "",
+    spa_html: "<html>spa shell with analytics</html>",
+    bundle_hashes: router.BundleHashes(
+      client_js: option.None,
+      tailwind_css: option.None,
+    ),
+    secret: "",
+    sentry: sentry_client.Disabled,
+  )
+}
+
+// --- AC1: submit structures the result + guarded transition ------------------
+
+pub fn submit_completes_and_structures_result_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(_row_id, token) =
+    seed_reference_call(
+      db,
+      "rc34-submit@example.com",
+      "contact_initiated",
+      "now() + interval '10 days'",
+    )
+  seed_complete_landlord_draft(db, token)
+  let req =
+    simulate.request(http.Post, "/reference/" <> token)
+    |> simulate.form_body([#("_focus_seconds", "240"), ..timing_fields()])
+  let response = router.handle_request(test_router_context(db), req)
+  // The thank-you screen (200), not a 403/404/500.
+  response.status |> should.equal(200)
+  let body = simulate.read_body(response)
+  string.contains(body, "reference-thank-you") |> should.be_true
+  // Row transitioned to form_completed with a structured result + outcome.
+  text_column(db, token, "status") |> should.equal("form_completed")
+  text_column(db, token, "outcome") |> should.equal("form_completed")
+  // Structured result fields (extracted via ->> — JSONB re-serialises with
+  // spaced colons, so substring matches on the raw text are fragile).
+  result_field(db, token, "schema_version") |> should.equal("refcall-v1")
+  result_field(db, token, "channel") |> should.equal("form")
+  result_field(db, token, "outcome") |> should.equal("form_completed")
+  // The verification block is present (not null).
+  test_db.query_text(
+    db,
+    "SELECT (result->'verification' IS NOT NULL)::text FROM reference_call WHERE form_token = '"
+      <> token
+      <> "'",
+  )
+  |> result.unwrap("")
+  |> should.equal("true")
+  // next_attempt_at cleared (terminal).
+  text_column(db, token, "next_attempt_at") |> should.equal("")
+}
+
+// --- AC2: one submission only ------------------------------------------------
+
+pub fn second_submit_redirects_to_the_state_page_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(_row_id, token) =
+    seed_reference_call(
+      db,
+      "rc34-double@example.com",
+      "contact_initiated",
+      "now() + interval '10 days'",
+    )
+  seed_complete_landlord_draft(db, token)
+  let post = {
+    let req =
+      simulate.request(http.Post, "/reference/" <> token)
+      |> simulate.form_body([#("_focus_seconds", "240"), ..timing_fields()])
+    router.handle_request(test_router_context(db), req)
+  }
+  post.status |> should.equal(200)
+  // A second POST on the now-terminal row redirects to the GET (303) — the
+  // branded "already completed" state page renders, nothing re-persists.
+  let second = {
+    let req =
+      simulate.request(http.Post, "/reference/" <> token)
+      |> simulate.form_body([#("_focus_seconds", "240"), ..timing_fields()])
+    router.handle_request(test_router_context(db), req)
+  }
+  second.status |> should.equal(303)
+}
+
+// --- AC3: decline -> refused -------------------------------------------------
+
+pub fn decline_post_transitions_to_refused_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(_row_id, token) =
+    seed_reference_call(
+      db,
+      "rc34-decline@example.com",
+      "contact_initiated",
+      "now() + interval '10 days'",
+    )
+  let req =
+    simulate.request(http.Post, "/reference/" <> token <> "/decline")
+    |> simulate.form_body([
+      #("decline_reason", "No time right now"),
+      ..timing_fields()
+    ])
+  let response = router.handle_request(test_router_context(db), req)
+  response.status |> should.equal(200)
+  string.contains(simulate.read_body(response), "reference-decline-confirmed")
+  |> should.be_true
+  text_column(db, token, "status") |> should.equal("refused")
+  text_column(db, token, "outcome") |> should.equal("refused")
+  // Messages stop: next_attempt_at cleared.
+  text_column(db, token, "next_attempt_at") |> should.equal("")
+  // The optional reason rides the result JSONB (extracted via ->>).
+  result_field(db, token, "decline_reason")
+  |> should.equal("No time right now")
+  result_field(db, token, "outcome") |> should.equal("refused")
+  result_field(db, token, "verification") |> should.equal("")
+}
+
+// --- AC4: objection -> objected, Art 21 evidence written once ----------------
+
+pub fn stop_post_objects_and_writes_evidence_once_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(row_id, token) =
+    seed_reference_call(
+      db,
+      "rc34-stop@example.com",
+      "contact_initiated",
+      "now() + interval '10 days'",
+    )
+  let post = fn() {
+    let req =
+      simulate.request(http.Post, "/reference/" <> token <> "/stop")
+      |> simulate.form_body(timing_fields())
+    router.handle_request(test_router_context(db), req)
+  }
+  let response = post()
+  response.status |> should.equal(200)
+  string.contains(simulate.read_body(response), "reference-stop-confirmed")
+  |> should.be_true
+  text_column(db, token, "status") |> should.equal("objected")
+  text_column(db, token, "outcome") |> should.equal("objected")
+  text_column(db, token, "next_attempt_at") |> should.equal("")
+  // The Art 21 evidence row was written exactly once.
+  objection_log_count(db, row_id) |> should.equal(1)
+  // The channel is the new 'web' value (the rc3-4 migration widened the CHECK).
+  test_db.query_text(
+    db,
+    "SELECT channel FROM reference_objection_log WHERE reference_call_id = '"
+      <> row_id
+      <> "'::uuid",
+  )
+  |> result.unwrap("")
+  |> should.equal("web")
+  // A re-tap: the guarded UPDATE is a 0-row no-op — the row stays objected
+  // and the evidence log is NOT written a second time.
+  let second = post()
+  second.status |> should.equal(303)
+  text_column(db, token, "status") |> should.equal("objected")
+  objection_log_count(db, row_id) |> should.equal(1)
+}
+
+// --- AC5: objection stickiness vs a late submit ------------------------------
+
+pub fn objected_row_survives_a_late_submit_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(row_id, token) =
+    seed_reference_call(
+      db,
+      "rc34-sticky@example.com",
+      "contact_initiated",
+      "now() + interval '10 days'",
+    )
+  seed_complete_landlord_draft(db, token)
+  // Object first.
+  let stop_req =
+    simulate.request(http.Post, "/reference/" <> token <> "/stop")
+    |> simulate.form_body(timing_fields())
+  let _ = router.handle_request(test_router_context(db), stop_req)
+  text_column(db, token, "status") |> should.equal("objected")
+  objection_log_count(db, row_id) |> should.equal(1)
+  // A late submit arrives (a referee who objected then somehow POSTs submit).
+  // The guarded complete UPDATE is 0-rows (status != contact_initiated) — the
+  // row stays objected and no second evidence row appears.
+  let submit_req =
+    simulate.request(http.Post, "/reference/" <> token)
+    |> simulate.form_body([#("_focus_seconds", "240"), ..timing_fields()])
+  let late = router.handle_request(test_router_context(db), submit_req)
+  late.status |> should.equal(303)
+  text_column(db, token, "status") |> should.equal("objected")
+  text_column(db, token, "outcome") |> should.equal("objected")
+  // The submit must NOT have overwritten the result: it still reads as the
+  // objected minimal terminal (outcome objected, null verification).
+  result_field(db, token, "outcome") |> should.equal("objected")
+  result_field(db, token, "verification") |> should.equal("")
+  objection_log_count(db, row_id) |> should.equal(1)
+}
+
+// --- AC6: wrong-person -> awaiting_correction, no resend ---------------------
+
+pub fn wrong_person_transitions_to_awaiting_correction_and_stops_sends_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let #(_row_id, token) =
+    seed_reference_call(
+      db,
+      "rc34-wp@example.com",
+      "contact_initiated",
+      "now() + interval '10 days'",
+    )
+  let req =
+    simulate.request(http.Post, "/reference/" <> token <> "/wrong-person")
+    |> simulate.form_body(timing_fields())
+  let response = router.handle_request(test_router_context(db), req)
+  response.status |> should.equal(200)
+  string.contains(
+    simulate.read_body(response),
+    "reference-wrong-person-confirmed",
+  )
+  |> should.be_true
+  text_column(db, token, "status") |> should.equal("awaiting_correction")
+  // AD-7: next_attempt_at cleared — the sweep never re-sends the same details.
+  text_column(db, token, "next_attempt_at") |> should.equal("")
+}
+
+// --- AC8: route-registry coverage through the full middleware stack ----------
+
+/// A referee whose browser holds rt_session (a landlord testing their own
+/// invite link) must NOT 403 on any new exit-route POST — the form_token is
+/// the capability, the [\"reference\", ..] prefix skips CSRF. Pinned per route
+/// so a regression narrowing the prefix fails loudly.
+pub fn csrf_stack_skips_every_new_exit_route_post_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let post = fn(path: String) -> Int {
+    let req =
+      simulate.request(http.Post, path)
+      |> simulate.cookie(
+        cookie_names.session(),
+        "test-access-token",
+        wisp.Signed,
+      )
+      |> simulate.form_body(timing_fields())
+    router.handle_request(test_router_context(db), req).status
+  }
+  // Seed one live row; each POST must reach the handler (200/303), never 403.
+  let #(_, token) =
+    seed_reference_call(
+      db,
+      "rc34-csrf@example.com",
+      "contact_initiated",
+      "now() + interval '10 days'",
+    )
+  seed_complete_landlord_draft(db, token)
+  let submit = post("/reference/" <> token)
+  submit |> should.not_equal(403)
+  let decline = post("/reference/" <> token <> "/decline")
+  decline |> should.not_equal(403)
+  let stop = post("/reference/" <> token <> "/stop")
+  stop |> should.not_equal(403)
+  let wrong = post("/reference/" <> token <> "/wrong-person")
+  wrong |> should.not_equal(403)
+}
+
+// --- AC8 (pure): the prefix registries cover each new path segment -----------
+
+pub fn is_public_path_covers_each_exit_route_test() {
+  list.each(exit_route_paths(), fn(path) {
+    middleware.is_public_path(path) |> should.be_true
+  })
+}
+
+pub fn sentry_safe_path_redacts_each_exit_route_test() {
+  list.each(exit_route_paths(), fn(path) {
+    middleware.sentry_safe_path(path)
+    |> should.equal("/reference/<redacted>")
+  })
+}
+
+fn exit_route_paths() -> List(List(String)) {
+  [
+    ["reference", "token", "decline"],
+    ["reference", "token", "stop"],
+    ["reference", "token", "wrong-person"],
+    // The bare submit (POST /reference/:token).
+    ["reference", "token"],
+  ]
+}
