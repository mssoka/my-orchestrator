+  /// RC3.4 (Perkins r2 B2): the review submit form lives on the
+  /// `reference-review` page, where initBrowser correctly bails (no
+  /// `reference-form-page` element, no per-question autosave). This narrower
+  /// wiring populates the review form's `_focus_seconds` from the same
+  /// page-clock logic so the submit POST carries a real value (without it,
+  /// focus_seconds_reported was always 0 in production — the field shipped
+  /// inert). It does NOT preventDefault: the review submit is a native POST.
+  function initReviewSubmit(env) {
+    env = env || root;
+    var doc = env.document;
+    if (!doc) return;
+    var form = doc.querySelector("[data-testid='reference-review-form']");
+    if (!form) return;
+    var focusField = form.querySelector("[data-focus-seconds]");
+    if (!focusField) return;
+    var initMs = env.Date ? env.Date.now() : Date.now();
+    form.addEventListener("submit", function () {
+      var now = env.Date ? env.Date.now() : Date.now();
+      focusField.value = clampFocusSeconds(now - initMs);
+    });
+  }
+
   var api = {
     nextQuestionId: nextQuestionId,
     clampFocusSeconds: clampFocusSeconds,
     shouldStep: shouldStep,
     shouldNavigateToReview: shouldNavigateToReview,
     _initBrowser: initBrowser,
+    _initReviewSubmit: initReviewSubmit,
   };
 
   if (typeof module !== "undefined" && module.exports) {
@@ -225,9 +248,11 @@
     if (root.document.readyState === "loading") {
       root.document.addEventListener("DOMContentLoaded", function () {
         initBrowser(root);
+        initReviewSubmit(root);
       });
     } else {
       initBrowser(root);
+      initReviewSubmit(root);
     }
   }
 })(typeof window !== "undefined" ? window : this);
