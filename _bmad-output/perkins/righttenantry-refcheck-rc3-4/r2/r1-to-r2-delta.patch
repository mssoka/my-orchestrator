+
+/// Mark a row taken-over (the warm-handoff takeover, A7) — for the late-
+/// completion notification copy branch (§8.6).
+fn mark_taken_over(db: pog.Connection, token: String) -> Nil {
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE reference_call SET taken_over_at = now() WHERE form_token = $1",
+    )
+    |> pog.parameter(pog.text(token))
+    |> pog.returning(decode.at([0], decode.int))
+    |> pog.execute(db)
+  Nil
+}
