+fn honeypot_fields() -> List(#(String, String)) {
+  // A filled honeypot (_website non-empty) — the bot signature. Timing stays
+  // clean so the honeypot is the trip.
+  let loaded = form_view.current_unix_ms() - 10_000
+  [#("_website", "spam-link-here"), #("_form_loaded_at", int.to_string(loaded))]
+}
+
+fn notification_type_for(db: pog.Connection, row_id: String) -> String {
+  test_db.query_text(
+    db,
+    "SELECT notification_type FROM notification WHERE entity_id = '"
+      <> row_id
+      <> "'::uuid AND entity_type = 'reference_call' LIMIT 1",
+  )
+  |> result.unwrap("missing")
+}
+
+fn notification_body_for(db: pog.Connection, row_id: String) -> String {
