--- /dev/null
+++ b/core/ecmp_test.odin
@@ -0,0 +1,318 @@
+package core
+
+// ecmp_test.odin — the Story 2.2 contracts as durable tests (architecture §6.2,
+// ODN-9/ODN-10, the routing ruling lavish 2026-08-10). Pins:
+//   (a) the headline AC: a diamond yields TWO equal-cost next hops at the
+//       source toward the sink (count == 2), while a single-path leg stays
+//       count == 1 (backward-compat with slice 1/2.1);
+//   (b) the ECMP pick is a PURE hash — deterministic in (src, dst, class,
+//       pkt_id), never a sim-rng draw: forwarding packets through the diamond
+//       leaves state.rng BIT-IDENTICAL to a no-flow run (rule 2);
+//   (c) the hash SPREADS across the equal-cost paths (both buckets used +
+//       roughly balanced over many distinct packet ids — not a degenerate
+//       all-on-one hash);
+//   (d) FLOW AFFINITY: the same packet identity always picks the same next hop;
+//   (e) the T1 determinism keystone over an ECMP flow: re-step (seed, log,
+//       demand) twice -> byte-identical per-tick hash sequence [E10] — the
+//       per-packet paths ride the hash, so ECMP replay is non-vacuous.
+//
+// The self-review lens (bmad-review-edge-case-hunter) targets (b) hash purity
+// (no sim-rng in the routing path) + (e) determinism; the grep form of (b) is a
+// Perkins lens-guard (no rng_next/rng_range/state.rng in the routing path —
+// splitmix64 here is the sanctioned pure finalizer, NOT a draw). These tests
+// pin the BEHAVIOR (the rng is provably unperturbed by ECMP forwarding).
+
+import "core:testing"
+
+// ecmp_diamond_setup — a fresh run seeded with a DIAMOND: residential(res) at
+// the top, content_host(host) at the bottom, two routers m1/m2 in the middle.
+// Edges (drawn at tick 1): res-m1, res-m2, m1-host, m2-host. From `res` toward
+// `host` there are TWO equal-cost next hops (m1, m2) — the ECMP junction. Every
+// span is 13 (<= standard max 14). Terminals connect via routers only (E26), so
+// all four edges are legal. Returns (state, res, m1, m2, host) ids.
+ecmp_diamond_setup :: proc(cat: ^Catalogs) -> (Run_State, u32, u32, u32, u32) {
+	s: Run_State
+	run_init(&s, 1, cat.hash, TEST_LOGIC_HZ)
+	res_idx, _ := node_type_index(cat, "residential")
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	host_idx, _ := node_type_index(cat, "content_host")
+	res := topology_spawn_node(&s.topology, res_idx, {8, 15}, cat)
+	m1 := topology_spawn_node(&s.topology, rt_idx, {20, 9}, cat)
+	m2 := topology_spawn_node(&s.topology, rt_idx, {20, 21}, cat)
+	host := topology_spawn_node(&s.topology, host_idx, {32, 15}, cat)
+	return s, res, m1, m2, host
+}
+
+// ecmp_draw_diamond — log the four diamond draw-commands at apply_tick (each
+// span 13 <= standard max 14). Applied by the next step (the 4-rule rule-1
+// table rebuild converges at the step boundary).
+ecmp_draw_diamond :: proc(s: ^Run_State, apply_tick: u64, res, m1, m2, host: u32, std: u16) {
+	draw(s, apply_tick, res, m1, std)
+	draw(s, apply_tick, res, m2, std)
+	draw(s, apply_tick, m1, host, std)
+	draw(s, apply_tick, m2, host, std)
+}
+
+@(test)
+test_ecmp_diamond_two_equal_cost_next_hops :: proc(t: ^testing.T) {
+	// THE headline AC (Story 2.2): at the diamond's source toward the sink
+	// there are exactly TWO equal-cost next hops (m1, m2) — the ECMP set. A
+	// single-path leg (m1 -> host) stays count == 1 (backward-compat: slice 1
+	// / 2.1 single-hop forwarding is unchanged — hash mod 1 == 0).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	s, res, m1, m2, host := ecmp_diamond_setup(cat)
+	defer run_destroy(&s)
+	ecmp_draw_diamond(&s, 1, res, m1, m2, host, std)
+	step_n(&s, 1, cat) // apply the draws + rebuild the table (rule 1)
+
+	// (res, host): TWO equal-cost next hops — m1 and m2 (both one hop from res,
+	// both one hop from host -> dist 2 either way). count == 2 engages ECMP.
+	off, count, ok := routing_equal_cost_hops(&s.routing, &s.topology, res, host)
+	testing.expectf(t, ok, "(res,host) must resolve")
+	testing.expectf(t, count == 2, "diamond source has 2 equal-cost next hops, got %d", count)
+	// the two hops are exactly {m1, m2} (order is insertion-stable: res-m1 was
+	// drawn before res-m2, so hops[off+0].node == m1, hops[off+1].node == m2).
+	testing.expectf(t, s.routing.hops[int(off)].node == m1,
+		"first equal-cost hop is m1 (insertion order), got %d", s.routing.hops[int(off)].node)
+	testing.expectf(t, s.routing.hops[int(off + 1)].node == m2,
+		"second equal-cost hop is m2, got %d", s.routing.hops[int(off + 1)].node)
+
+	// backward-compat: a single-path leg is count == 1 (m1 -> host: host is the
+	// sole neighbor one hop closer; res is two hops back, not closer). ECMP's
+	// hash mod 1 == 0 reproduces slice-1/2.1's single-hop forwarding exactly.
+	_, count_m1, okm1 := routing_equal_cost_hops(&s.routing, &s.topology, m1, host)
+	testing.expectf(t, okm1 && count_m1 == 1, "(m1,host) is single-path (count 1), got ok=%v count=%d", okm1, count_m1)
+	nh, _, oknh := routing_next_hop(&s.routing, &s.topology, m1, host)
+	testing.expectf(t, oknh && nh == host, "m1's next hop toward host is host, got ok=%v nh=%d", oknh, nh)
+
+	// and the reverse direction also ECMPs (host -> res has two equal-cost hops
+	// through m1, m2) — the diamond is symmetric.
+	_, count_rev, okrev := routing_equal_cost_hops(&s.routing, &s.topology, host, res)
+	testing.expectf(t, okrev && count_rev == 2, "(host,res) is also 2 equal-cost hops (symmetric diamond), got %d", count_rev)
+}
+
+@(test)
+test_ecmp_hash_pure_and_deterministic :: proc(t: ^testing.T) {
+	// The ECMP hash is a PURE function of identity (ODN-9): same inputs ->
+	// same output, every call. Different packet ids (usually) differ. The hash
+	// is integer-only + target-independent (the spine, ODN-10).
+	for pkt_id in u64(1)..=64 {
+		h0 := ecmp_hash(7, 9, 0, pkt_id)
+		h1 := ecmp_hash(7, 9, 0, pkt_id) // identical args -> identical hash
+		testing.expectf(t, h0 == h1, "ecmp_hash must be deterministic for pkt_id %d", pkt_id)
+	}
+	// a different packet id almost always hashes differently (avalanche)
+	same := 0
+	for pkt_id in u64(1)..=64 {
+		if ecmp_hash(7, 9, 0, pkt_id) == ecmp_hash(7, 9, 0, pkt_id + 1) {
+			same += 1
+		}
+	}
+	testing.expectf(t, same < 8, "adjacent packet ids must usually hash differently (avalanche), %d/64 collided", same)
+	// the hash inputs are honored: a different src, dst, or class changes it.
+	h_base := ecmp_hash(7, 9, 0, 42)
+	testing.expect(t, ecmp_hash(8, 9, 0, 42) != h_base, "src must affect the hash")
+	testing.expect(t, ecmp_hash(7, 10, 0, 42) != h_base, "dst must affect the hash")
+	testing.expect(t, ecmp_hash(7, 9, 1, 42) != h_base, "class must affect the hash (slice 3 will use it)")
+	// ecmp_pick is the hash mod N; n == 1 always returns 0 (single-path).
+	testing.expectf(t, ecmp_pick(7, 9, 0, 42, 1) == 0, "ecmp_pick n=1 -> 0 (sole hop)")
+	testing.expectf(t, ecmp_pick(7, 9, 0, 42, 2) < 2, "ecmp_pick n=2 in range [0,2)")
+}
+
+@(test)
+test_ecmp_pick_distributes_across_paths :: proc(t: ^testing.T) {
+	// The hash SPREADS across the equal-cost paths: many distinct packet ids
+	// populate BOTH buckets of a 2-way ECMP, roughly balanced (not a degenerate
+	// all-on-one hash that would make ECMP pointless). This is the property
+	// that makes the diamond visibly split traffic.
+	bucket := [2]int{}
+	for pkt_id in u64(1)..=64 {
+		bucket[int(ecmp_pick(0, 3, 0, pkt_id, 2))] += 1
+	}
+	testing.expectf(t, bucket[0] > 0 && bucket[1] > 0,
+		"ECMP must use BOTH paths: bucket counts %d / %d", bucket[0], bucket[1])
+	// loose balance: neither bucket gets < 25% of the packets (a biased hash
+	// would concentrate nearly all on one side). 64 packets -> each >= 16.
+	testing.expectf(t, bucket[0] >= 16 && bucket[1] >= 16,
+		"ECMP must spread roughly evenly: bucket counts %d / %d (each must be >= 16)",
+		bucket[0], bucket[1])
+}
+
+@(test)
+test_ecmp_pick_is_pure_no_sim_rng :: proc(t: ^testing.T) {
+	// Rule 2 (the load-bearing guard): the ECMP pick is a PURE hash of packet
+	// identity — NOT a draw from the sim rng. Proven BEHAVIORALLY: two runs
+	// with the SAME seed + SAME diamond topology, one forwarding a batch of
+	// ECMP-split packets and one with NO flow, end with BIT-IDENTICAL rng state
+	// (state + inc). If any sim-rng draw sneaks into the routing path, the
+	// forwarding run's rng diverges from the no-flow run's and this goes red.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	std, _ := pipe_tier_index(cat, "standard")
+
+	// run A: diamond + a batch of ECMP-forwarded packets
+	a, resA, m1A, m2A, hostA := ecmp_diamond_setup(cat)
+	defer run_destroy(&a)
+	ecmp_draw_diamond(&a, 1, resA, m1A, m2A, hostA, std)
+	for i in 0..<24 {
+		flow_seed_demand(&a.flow, 1, resA, hostA) // 24 packets -> the diamond splits them
+	}
+	step_n(&a, 8, cat)
+
+	// run B: SAME seed + SAME diamond, but NO flow demand (no packets forward)
+	b, resB, m1B, m2B, hostB := ecmp_diamond_setup(cat)
+	defer run_destroy(&b)
+	ecmp_draw_diamond(&b, 1, resB, m1B, m2B, hostB, std)
+	step_n(&b, 8, cat)
+
+	// the packets in A actually traversed the ECMP junction (sanity: some
+	// delivered, so the routing path executed the pick >= once)
+	testing.expectf(t, count_arrived(&a) > 0, "run A must have delivered ECMP-forwarded packets, got %d", count_arrived(&a))
+	// THE guard: identical rng state despite A forwarding 24 split packets and
+	// B forwarding none. ECMP drew nothing from the owned rng.
+	testing.expectf(t, a.rng.state == b.rng.state,
+		"ECMP must not perturb the sim rng: state A %016x vs B %016x", a.rng.state, b.rng.state)
+	testing.expectf(t, a.rng.inc == b.rng.inc,
+		"ECMP must not perturb the sim rng: inc A %016x vs B %016x", a.rng.inc, b.rng.inc)
+}
+
+@(test)
+test_ecmp_flow_affinity_same_packet_same_path :: proc(t: ^testing.T) {
+	// FLOW AFFINITY: the same packet identity always takes the same path. Two
+	// independent runs (same seed, log, demand) forward the SAME single packet
+	// through the diamond; its first hop (the ECMP pick at the source) is
+	// identical in both. (The full per-tick path equality is pinned by the
+	// replay-keystone test below; this isolates the affinity property.)
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	std, _ := pipe_tier_index(cat, "standard")
+
+	// run A: one packet res -> host; capture its first hop after it forwards
+	a, resA, m1A, m2A, hostA := ecmp_diamond_setup(cat)
+	defer run_destroy(&a)
+	ecmp_draw_diamond(&a, 1, resA, m1A, m2A, hostA, std)
+	flow_seed_demand(&a.flow, 1, resA, hostA)
+	step_n(&a, 1, cat) // spawn + forward off the source this tick
+	testing.expectf(t, len(a.flow.packets) == 1, "one packet in flight, got %d", len(a.flow.packets))
+	testing.expectf(t, a.flow.packets[0].on_edge, "the packet forwarded off the source")
+	hop_a := a.flow.packets[0].heading
+	testing.expectf(t, hop_a == m1A || hop_a == m2A,
+		"first hop is one of the two equal-cost middles, got %d", hop_a)
+
+	// run B: fresh run, same seed + same log + same demand; the SAME packet id
+	// (next_packet_id is deterministic) -> the SAME first hop.
+	b, resB, m1B, m2B, hostB := ecmp_diamond_setup(cat)
+	defer run_destroy(&b)
+	ecmp_draw_diamond(&b, 1, resB, m1B, m2B, hostB, std)
+	flow_seed_demand(&b.flow, 1, resB, hostB)
+	step_n(&b, 1, cat)
+	testing.expectf(t, len(b.flow.packets) == 1, "replay: one packet in flight, got %d", len(b.flow.packets))
+	hop_b := b.flow.packets[0].heading
+	testing.expectf(t, hop_a == hop_b,
+		"FLOW AFFINITY: same packet id -> same first hop, got A=%d B=%d", hop_a, hop_b)
+}
+
+@(test)
+test_ecmp_flow_spreads_across_both_paths :: proc(t: ^testing.T) {
+	// End-to-end spread through the real flow: spawn a batch of packets res ->
+	// host; after they forward off the source, BOTH middle nodes carry traffic
+	// (the hash split the flow across the equal-cost paths). This exercises the
+	// integrated flow_step ECMP pick, not just the hash function in isolation.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	s, res, m1, m2, host := ecmp_diamond_setup(cat)
+	defer run_destroy(&s)
+	ecmp_draw_diamond(&s, 1, res, m1, m2, host, std)
+	for i in 0..<24 {
+		flow_seed_demand(&s.flow, 1, res, host) // 24 distinct packet ids
+	}
+	step_n(&s, 1, cat) // spawn + forward off the source this tick
+
+	via_m1, via_m2 := 0, 0
+	for p in s.flow.packets {
+		if p.on_edge && p.heading == m1 {
+			via_m1 += 1
+		} else if p.on_edge && p.heading == m2 {
+			via_m2 += 1
+		}
+	}
+	testing.expectf(t, via_m1 > 0 && via_m2 > 0,
+		"the flow must split across BOTH paths: via_m1=%d via_m2=%d", via_m1, via_m2)
+	testing.expectf(t, via_m1+via_m2 == 24,
+		"all 24 packets forwarded off the source this tick, got %d in flight on the diamond legs", via_m1+via_m2)
+}
+
+@(test)
+test_ecmp_replay_byte_identical :: proc(t: ^testing.T) {
+	// THE determinism keystone over an ECMP flow (Story 2.2's named golden,
+	// [E10, ODN-10]): re-step (seed, action_log, demand) twice -> byte-identical
+	// per-tick hash sequence. The packets' ECMP-chosen paths ride the T1 hash
+	// (the Packet.edge/heading fields are serialized), so a non-deterministic
+	// pick would diverge here. The diamond + a batch of split packets makes the
+	// ECMP path non-vacuous (count == 2 engages the hash on every forward).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	std, _ := pipe_tier_index(cat, "standard")
+
+	live: Run_State
+	defer run_destroy(&live)
+	run_init(&live, 7, cat.hash, TEST_LOGIC_HZ)
+	res_idx, _ := node_type_index(cat, "residential")
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	host_idx, _ := node_type_index(cat, "content_host")
+	res := topology_spawn_node(&live.topology, res_idx, {8, 15}, cat)
+	m1 := topology_spawn_node(&live.topology, rt_idx, {20, 9}, cat)
+	m2 := topology_spawn_node(&live.topology, rt_idx, {20, 21}, cat)
+	host := topology_spawn_node(&live.topology, host_idx, {32, 15}, cat)
+	ecmp_draw_diamond(&live, 1, res, m1, m2, host, std)
+	for i in 0..<12 {
+		flow_seed_demand(&live.flow, 1, res, host) // 12 ECMP-split packets
+	}
+	live_hashes := record_run(&live, 30, cat)
+	defer delete(live_hashes)
+
+	// sanity: the ECMP flow drove per-tick hash variation (packets moved)
+	testing.expectf(t, len(live_hashes) == 30, "30 ticks recorded, got %d", len(live_hashes))
+	vary := false
+	for i in 1..<len(live_hashes) {
+		if live_hashes[i] != live_hashes[i-1] {
+			vary = true
+		}
+	}
+	testing.expect(t, vary, "the ECMP flow must drive per-tick hash variation (packet motion)")
+	testing.expectf(t, !live.replay_error, "live run must not latch replay_error")
+
+	// replay: fresh run, same seed, SAME action log + SAME demand shape
+	replayed: Run_State
+	defer run_destroy(&replayed)
+	run_init(&replayed, 7, cat.hash, TEST_LOGIC_HZ)
+	// identical fixture (run setup, re-created on every replay)
+	topology_spawn_node(&replayed.topology, res_idx, {8, 15}, cat)
+	topology_spawn_node(&replayed.topology, rt_idx, {20, 9}, cat)
+	topology_spawn_node(&replayed.topology, rt_idx, {20, 21}, cat)
+	topology_spawn_node(&replayed.topology, host_idx, {32, 15}, cat)
+	delete(replayed.action_log)
+	replayed.action_log = clone_log(live.action_log)
+	for i in 0..<12 {
+		flow_seed_demand(&replayed.flow, 1, res, host) // identical demand (run setup)
+	}
+	replay_hashes := record_run(&replayed, 30, cat)
+	defer delete(replay_hashes)
+	testing.expectf(t, !replayed.replay_error, "replay must not latch replay_error")
+	testing.expectf(t, len(live_hashes) == len(replay_hashes), "tick count mismatch")
+	diverged := false
+	for i in 0..<len(live_hashes) {
+		if live_hashes[i] != replay_hashes[i] {
+			diverged = true
+		}
+	}
+	testing.expectf(t, !diverged, "REPLAY DIVERGENCE: the ECMP per-packet paths differ")
+}
