+// splitmix64(src, dst, class, pkt_id) mod N (ODN-9). n >= 1; n == 1 -> 0 (the
+// sole hop, so a single-path slot is backward-identical to slice 1/2.1). Pure:
+// the same packet always picks the same index, every replay.
+ecmp_pick :: proc(src, dst: u32, class: u8, pkt_id: u64, n: u32) -> u32 {
+	if n <= 1 do return 0
+	return ecmp_hash(src, dst, class, pkt_id) % n
