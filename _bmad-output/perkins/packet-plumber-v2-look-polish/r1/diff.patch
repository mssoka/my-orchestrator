+<title>v2 look polish — the bake-off gallery</title>
+<style>
+  :root{
+    --canvas:#EDE2C8; --canvas-2:#E4D7B8; --ink:#33414F; --ink-soft:#5C626A;
+    --amber:#E08A2E; --amber-soft:#F2B544; --steel:#78808C; --fiber:#2E5494;
+    --card:#F5EFE0; --line:#D8CBAB; --ok:#37D67A;
