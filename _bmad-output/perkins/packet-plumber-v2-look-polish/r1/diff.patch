+  .hero-strip .cap{font-size:12.5px;color:var(--ink-soft);padding:7px 2px}
+  .crops{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:14px 0}
+  .crops .frame{background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden}
