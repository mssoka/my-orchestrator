+// ============================================================================
+// OAUTH POSTHOG FUNNEL — Google sign-in must identify + capture server-side
+// ============================================================================
+
+/// A fabricated OAuth token exchange result. `complete_oauth_flow` is the
+/// seam below the PKCE exchange (which needs a live Supabase), so the
+/// funnel can be driven end-to-end against the real DB.
+fn oauth_token_response(auth_user_id: String) -> types.OAuthTokenResponse {
+  types.OAuthTokenResponse(
+    access_token: "access-token-" <> auth_user_id,
+    refresh_token: "refresh-token-" <> auth_user_id,
+    user_id: auth_user_id,
+    user_email: "oauth-" <> auth_user_id <> "@example.com",
+    user_name: "OAuth Landlord",
+  )
+}
+
+fn run_oauth_callback(
+  db: pog.Connection,
+  token: types.OAuthTokenResponse,
+  posthog: posthog_client.PostHog,
+) -> wisp.Response {
+  // resend_api_key is empty → the welcome email spawn is skipped.
+  auth_handler.complete_oauth_flow(
+    simulate.request(http.Get, "/auth/callback"),
+    db,
+    token,
+    sentry_client.Disabled,
+    "test-secret",
+    "",
+    posthog,
+  )
+}
