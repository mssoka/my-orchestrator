+pub fn oauth_first_signin_fires_identify_and_signup_completed_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let subject = process.new_subject()
+  let posthog = posthog_client.Recording(subject)
+  let auth_uuid = uuid.v4_string()
+
+  let resp = run_oauth_callback(db, oauth_token_response(auth_uuid), posthog)
+  resp.status |> should.equal(303)
+
+  // Landlord row exists; its id is the distinct_id for every fire below.
+  let assert Ok(row_id) =
+    test_db.query_text(
+      db,
+      "SELECT id::text FROM landlord WHERE auth_user_id = '"
+        <> auth_uuid
+        <> "'::uuid",
+    )
+
+  // Identify first (email `$set`, empty `$set_once` — no first-touch data
+  // survives the OAuth redirect), then the funnel capture. Order is
+  // deterministic: the Recording variant sends synchronously in call order.
+  let events = posthog_client.drain_recording(subject, 1000)
+  case events {
+    [
+      posthog_client.Identify(distinct_id, set_properties, set_once_properties),
+      posthog_client.Capture(capture_id, "signup_completed", _),
+    ] -> {
+      distinct_id |> should.equal(row_id)
+      let assert Ok(email_json) = list.key_find(set_properties, "email")
+      email_json
+      |> should.equal(json.string("oauth-" <> auth_uuid <> "@example.com"))
+      set_once_properties |> should.equal([])
+      capture_id |> should.equal(row_id)
+    }
+    _ -> should.fail()
+  }
+}
