+pub fn oauth_returning_signin_fires_login_succeeded_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let subject = process.new_subject()
+  let posthog = posthog_client.Recording(subject)
+  let auth_uuid = uuid.v4_string()
+  let token = oauth_token_response(auth_uuid)
+
+  // First sign-in creates the landlord row and fires the signup funnel.
+  let first = run_oauth_callback(db, token, posthog)
+  first.status |> should.equal(303)
+  let first_events = posthog_client.drain_recording(subject, 1000)
+  case first_events {
+    [
+      posthog_client.Identify(_, _, _),
+      posthog_client.Capture(_, "signup_completed", _),
+    ] -> Nil
+    _ -> should.fail()
+  }
+
+  // Second sign-in from the same Google account is a returning login:
+  // identify still fires (cohorts stay fresh), capture becomes
+  // login_succeeded.
+  let second = run_oauth_callback(db, token, posthog)
+  second.status |> should.equal(303)
+  let second_events = posthog_client.drain_recording(subject, 1000)
+  case second_events {
+    [
+      posthog_client.Identify(_, _, _),
+      posthog_client.Capture(_, "login_succeeded", _),
+    ] -> Nil
+    _ -> should.fail()
+  }
