+/// The real-mode PDF route must serve UN-watermarked bytes (Perkins r1 B1):
+/// the handler's `watermark: False` call site is otherwise unasserted — a
+/// one-token flip to True would DEMO-stamp every real landlord report while
+/// the suite stayed green. Pins the served body against the identical
+/// ReportData compiled both ways: it must equal the watermark=False render
+/// and differ from the watermark=True render.
+pub fn pdf_real_mode_route_serves_unwatermarked_report_test() {
+  use <- unitest.tag("integration")
+  case typst_available() {
+    False -> Nil
+    True -> {
+      let db = setup()
+      let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+      let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+      let assert Ok(app_id) =
+        test_db.seed_application(
+          db,
+          vacancy_id,
+          "pdf-unwatermarked@example.com",
+        )
+      let assert Ok(analysis_id) = test_db.seed_analysis_completed(db, app_id)
+
+      let assert Ok(priv_dir) = wisp.priv_directory("server")
+      let resp =
+        ai_report_handler.handle_get_pdf(
+          helpers.test_server_config(db),
+          priv_dir,
+          test_db.test_landlord(landlord_id),
+          analysis_id,
+        )
+      resp.status |> should.equal(200)
+
+      // Rebuild the identical ReportData the handler rendered, via its own
+      // public helpers + the same SQL loader.
+      let assert Ok(analysis_uuid) = uuid.from_string(analysis_id)
+      let assert Ok(landlord_uuid) = uuid.from_string(landlord_id)
+      let assert Ok(pog.Returned(_, [row])) =
+        ai_sql.get_analysis_for_pdf(db, analysis_uuid, landlord_uuid)
+      let overall_score = case row.overall_score {
+        option.Some(s) -> s
+        option.None -> panic as "seeded completed analysis has no overall_score"
+      }
+      let assert Ok(snapshot) =
+        ai_report_handler.load_application_snapshot(db, row, landlord_uuid)
+      let report_data =
+        ai_report_handler.build_report_data(row, overall_score, snapshot)
+
+      let assert Ok(unmarked) =
+        audit_report.generate(report_data, priv_dir, watermark: False)
+      let assert Ok(marked) =
+        audit_report.generate(report_data, priv_dir, watermark: True)
+
+      let served = case resp.body {
+        wisp.Bytes(tree) -> bytes_tree.to_bit_array(tree)
+        _ -> panic as "expected a bytes response body"
+      }
+      // The route serves exactly the real-mode render…
+      normalize_metadata(served) |> should.equal(normalize_metadata(unmarked))
+      // …and that render is NOT the watermarked one (flip the handler's
+      // flag and this assertion fails).
+      should.not_equal(normalize_metadata(served), normalize_metadata(marked))
+    }
+  }
+}
