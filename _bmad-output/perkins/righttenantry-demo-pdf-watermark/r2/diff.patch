+%% normalize_metadata(Bin) -> binary()
+%% Strips the compile-time-varying PDF metadata so two compiles of the same
+%% input can be compared byte-for-byte:
+%%   - CreationDate/ModDate (info dict + XMP) — varies per compile AND per
+%%     platform (macOS typst emits a timezone suffix `+01'00`; linux-musl
+%%     emits UTC with none, so the timestamps differ in LENGTH)
+%%   - the random document instance ID (XMP xmpMM:InstanceID + the trailer
+%%     /ID pair)
+%%   - xref offset bookkeeping (`\d{10} 00000 n` rows + `startxref`) — pure
+%%     file-position numbers that shift whenever the timestamp lengths or
+%%     any earlier byte change
+%% Everything else is deterministic for a given typst version, template and
+%% payload. Used by the golden byte-identity pins in audit_report_test.gleam
+%% and pdf_prebake_test.gleam.
+normalize_metadata(Bin) ->
+    R = fun(Input, Re, Repl) ->
+        re:replace(Input, Re, Repl, [global, {return, binary}])
+    end,
+    B1 = R(Bin, <<"/CreationDate \\(D:[^)]*\\)">>, <<"/CreationDate (D:0)" >>),
+    B2 = R(B1, <<"/ModDate \\(D:[^)]*\\)">>, <<"/ModDate (D:0)" >>),
+    B3 = R(B2, <<"<xmp:ModifyDate>[^<]*</xmp:ModifyDate>">>, <<"<xmp:ModifyDate>0</xmp:ModifyDate>" >>),
+    B4 = R(B3, <<"<xmp:CreateDate>[^<]*</xmp:CreateDate>">>, <<"<xmp:CreateDate>0</xmp:CreateDate>" >>),
+    B5 = R(B4, <<"<xmpMM:InstanceID>[^<]*</xmpMM:InstanceID>">>, <<"<xmpMM:InstanceID>0</xmpMM:InstanceID>" >>),
+    B6 = R(B5, <<"/ID \\[\\([^)]*\\) \\([^)]*\\)\\]">>, <<"/ID [(0) (0)]" >>),
+    B7 = R(B6, <<"\\d{10} 00000 n">>, <<"0000000000 00000 n" >>),
+    R(B7, <<"startxref\\r?\\n\\d+">>, <<"startxref\n0" >>).
+
