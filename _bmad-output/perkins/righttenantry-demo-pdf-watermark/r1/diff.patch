+// === Demo watermark + real-mode byte identity ===============================
+//
+// The watermark pins (user ruling 2026-08-24: demo PDFs must say DEMO):
+//
+// 1. `pdf_real_mode_render_matches_golden_test` — real-mode output is
+//    byte-identical to the pre-watermark pipeline. The golden fixture was
+//    rendered from the ORIGINAL template before the watermark block was
+//    added; `watermark: False` must reproduce it exactly (modulo the
+//    compile-time metadata the normalizer strips — creation timestamps and
+//    the random document instance ID). A legitimate template change that
+//    alters real-mode output requires a deliberate re-bless of the golden.
+//
+// 2. `pdf_demo_watermark_renders_test` — `watermark: True` adds real
+//    content the False render lacks: the same payload compiled with the
+//    flag differs beyond the metadata noise. The template attaches the
+//    watermark to the page background of every page (plus an explicit
+//    place on the cover, which paints a full-bleed block over the
+//    background), so a present-on-any-page watermark is present on every
+//    page by construction.
+
+@external(erlang, "ai@audit_report_ffi", "normalize_metadata")
+fn normalize_metadata(bytes: BitArray) -> BitArray
+
+fn golden_fixture_path() -> String {
+  "test/fixtures/real_mode_report_golden.pdf"
+}
+
+pub fn pdf_real_mode_render_matches_golden_test() {
+  case skip_if_no_typst() {
+    True -> Nil
+    False -> {
+      let assert Ok(pdf_bytes) =
+        audit_report.generate(
+          minimal_report_data(),
+          priv_dir(),
+          watermark: False,
+        )
+      case simplifile.read_bits(golden_fixture_path()) {
+        Ok(golden) ->
+          normalize_metadata(pdf_bytes)
+          |> should.equal(normalize_metadata(golden))
+        Error(err) -> {
+          let _ = err
+          // gleeunit's should.fail takes no message; the path is on the line above.
+          should.fail()
+        }
+      }
+    }
+  }
+}
+
+pub fn pdf_demo_watermark_renders_test() {
+  case skip_if_no_typst() {
+    True -> Nil
+    False -> {
+      let data = minimal_report_data()
+      let assert Ok(plain) =
+        audit_report.generate(data, priv_dir(), watermark: False)
+      let assert Ok(marked) =
+        audit_report.generate(data, priv_dir(), watermark: True)
+      // The watermark layer is real page content: after stripping the
+      // metadata noise the two renders must still differ.
+      should.not_equal(normalize_metadata(marked), normalize_metadata(plain))
+    }
+  }
+}
