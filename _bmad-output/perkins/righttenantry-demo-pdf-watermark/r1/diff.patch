+// === Demo watermark pins (2026-08-24 ruling) ================================
+//
+// Every PDF produced in demo mode must carry the diagonal DEMO watermark.
+// The demo's ONLY PDF path is the pre-baked report (`demo_api.download` →
+// `/static/demo/report-<id>.pdf`), baked by `pdf_prebake.main` through the
+// real Typst pipeline with `generate(watermark: True)`.
+//
+// These pins render TWO distinct demo report paths (a-aoife — the
+// showcase multi-page report; a-liam — a short report) with the watermark
+// on and off. The watermark must add real page content: after stripping
+// compile-time metadata noise, the marked render must differ from the
+// plain one. Real-mode byte identity is pinned separately in
+// `ai/audit_report_test.gleam` against the committed golden.
+
+fn skip_if_no_typst() -> Bool {
+  case typst_available() {
+    True -> False
+    False ->
+      case envoy.get("CI") {
+        Ok("true") ->
+          panic as "pdf_prebake_test: typst CLI missing in CI — install step in test.yml is broken"
+        _ -> {
+          wisp.log_warning(
+            "pdf_prebake_test: typst CLI not found on PATH — skipping watermark tests",
+          )
+          True
+        }
+      }
+  }
+}
+
+@external(erlang, "ai@audit_report_ffi", "available")
+fn typst_available() -> Bool
+
+@external(erlang, "ai@audit_report_ffi", "normalize_metadata")
+fn normalize_metadata(bytes: BitArray) -> BitArray
+
+fn priv_dir() -> String {
+  let assert Ok(p) = wisp.priv_directory("server")
+  p
+}
+
+fn payload_for(application_id: String) -> pdf_prebake.ReportPayload {
+  case
+    list.find(pdf_prebake.payloads(), fn(p) {
+      p.application_id == application_id
+    })
+  {
+    Ok(p) -> p
+    Error(_) -> {
+      let _ = application_id
+      panic as "demo payload missing"
+    }
+  }
+}
+
+pub fn demo_reports_carry_watermark_on_two_distinct_paths_test() {
+  case skip_if_no_typst() {
+    True -> Nil
+    False -> {
+      list.each(["a-aoife", "a-liam"], fn(application_id) {
+        let data = pdf_prebake.to_report_data(payload_for(application_id))
+        let assert Ok(plain) =
+          audit_report.generate(data, priv_dir(), watermark: False)
+        let assert Ok(marked) =
+          audit_report.generate(data, priv_dir(), watermark: True)
+        normalize_metadata(marked)
+        |> should.not_equal(normalize_metadata(plain))
+      })
+    }
+  }
+}
