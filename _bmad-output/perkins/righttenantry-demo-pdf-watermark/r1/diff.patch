+%% normalize_metadata(Bin) -> binary()
+%% Strips the compile-time-varying PDF metadata so two compiles of the same
+%% input can be compared byte-for-byte: CreationDate/ModDate (info dict +
+%% XMP), the random document instance ID (XMP xmpMM:InstanceID + the
+%% trailer /ID pair). Everything else is deterministic for a given typst
+%% version, template and payload. Used by the golden byte-identity pins in
+%% audit_report_test.gleam and pdf_prebake_test.gleam.
+normalize_metadata(Bin) ->
+    R = fun(Input, Re, Repl) ->
+        re:replace(Input, Re, Repl, [global, {return, binary}])
+    end,
+    B1 = R(Bin, <<"/CreationDate \\(D:[^)]*\\)">>, <<"/CreationDate (D:0)" >>),
+    B2 = R(B1, <<"/ModDate \\(D:[^)]*\\)">>, <<"/ModDate (D:0)" >>),
+    B3 = R(B2, <<"<xmp:ModifyDate>[^<]*</xmp:ModifyDate>">>, <<"<xmp:ModifyDate>0</xmp:ModifyDate>" >>),
+    B4 = R(B3, <<"<xmp:CreateDate>[^<]*</xmp:CreateDate>">>, <<"<xmp:CreateDate>0</xmp:CreateDate>" >>),
+    B5 = R(B4, <<"<xmpMM:InstanceID>[^<]*</xmpMM:InstanceID>">>, <<"<xmpMM:InstanceID>0</xmpMM:InstanceID>" >>),
+    R(B5, <<"/ID \\[\\([^)]*\\) \\([^)]*\\)\\]">>, <<"/ID [(0) (0)]" >>).
+
