+// --- 3.3: serialization + contention contracts (E7 / E9 / E22) ---------------
+// The 3.3 pins: the pure per-window WRR budget (E7 floor), no-starvation under
+// continuous Express at the flow level, the E9 drop ladder over every
+// emptiness combo, the E22 pool-exhaustion ladder, and the golden-stability
+// keystone — a lone packet in ANY lane crosses a standard pipe in 2 ticks
+// (full capacity via the cyclic windows; existing light-demo transits must
+// not shift).
+
+// queue_packet — white-box: park a packet directly in the in-flight array so
+// a test can build an exact queue state without paying spawn/forward ticks.
+// on_edge residents ride `edge` toward `heading`; their lane resolves from
+// the topology + lane overrides exactly like a live packet (qos_lane_of).
+queue_packet :: proc(s: ^Run_State, class: u16, src, dst: u32, on_edge: bool, edge: u32, heading: u32, progress: u32 = 0) -> u64 {
+	s.flow.next_packet_id += 1
+	append(&s.flow.packets, Packet{
+		id = s.flow.next_packet_id,
+		class = class,
+		src = src,
+		dst = dst,
+		on_edge = on_edge,
+		at_node = src,
+		edge = edge,
+		heading = heading,
+		progress_units = progress,
+		spawn_tick = 0,
+	})
+	return s.flow.next_packet_id
+}
+
+// count_drops — Packet_Dropped events for (class, reason) since run start.
+count_drops :: proc(s: ^Run_State, class: u16, reason: Drop_Reason) -> int {
+	n := 0
+	for e in s.events {
+		if e.tag == EVENT_TAG_PACKET_DROPPED && e.class == class && e.reason == u8(reason) {
+			n += 1
+		}
+	}
+	return n
+}
+
+// in_flight — whether a packet id is still in the in-flight array.
+in_flight :: proc(s: ^Run_State, id: u64) -> bool {
+	for p in s.flow.packets {
+		if p.id == id { return true }
+	}
+	return false
+}
