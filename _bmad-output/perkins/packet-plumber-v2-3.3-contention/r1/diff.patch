+// lane_pipe_setup — fixture + res->rt pipe + the player's per-pipe lane
+// categorizations as LOGGED commands (canon 2026-08-12: nothing auto-assigns;
+// every lane call is the player's): email -> Best-effort, streaming ->
+// Express on pipe 0. A third class ("bulk") rides Standard by default.
+lane_pipe_setup :: proc(s: ^Run_State, cat: ^Catalogs) -> (res, rt, host: u32) {
+	res, rt, host = test_seed_fixture(s, cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	append(&s.action_log, Command{apply_tick = 1, kind = Cmd_Draw_Pipe{a = res, b = rt, tier = std}})
+	email_idx, _ := class_index(cat, "email")
+	stream_idx, _ := class_index(cat, "streaming")
+	append(&s.action_log, Command{apply_tick = 1, kind = Cmd_Set_Lane{pipe = 0, class = u16(email_idx), lane = LANE_BEST_EFFORT}})
+	append(&s.action_log, Command{apply_tick = 1, kind = Cmd_Set_Lane{pipe = 0, class = u16(stream_idx), lane = LANE_EXPRESS}})
+	// "bulk": a Standard-riding droppable class (max_loss_pct 100) — the S
+	// lane needs a rider distinct from the overridden pair. default_lane must
+	// be Standard (the no-auto canon pin).
+	append(&cat.packet_types, Packet_Type{
+		id = "bulk", display = "Bulk", shape = .Tiny_Square, icon = "box",
+		color_rgba = {140, 90, 190, 255}, latency_tol_ms = 900, max_loss_pct = 100,
+		bandwidth_demand = 1, default_lane = LANE_STANDARD, demand_weight = 1, era_introduced = 1,
+	})
+	return
+}
