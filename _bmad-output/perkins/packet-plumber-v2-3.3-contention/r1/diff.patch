+// pool_newest_in_lane — the index of the newest (last array-order) in-flight
+// packet riding `lane`, or -1. On-edge packets ride their pipe's lane; at-node
+// packets their class default_lane (no pipe yet). The E22 shed target.
+pool_newest_in_lane :: proc(state: ^Run_State, cat: ^Catalogs, lane: u8) -> int {
+	f := &state.flow
+	for i := len(f.packets) - 1; i >= 0; i -= 1 {
+		p := &f.packets[i]
+		if p.delivered { continue }
+		l := u8(LANE_STANDARD)
+		if p.on_edge {
+			l = qos_lane_of(&state.topology, cat, p.edge, p.class)
+		} else if int(p.class) < len(cat.packet_types) {
+			l = cat.packet_types[p.class].default_lane
+		}
+		if l == lane { return i }
+	}
+	return -1
+}
