+// --- 3.3: per-bundle lane queues, serialization + the contention ladders -----
+// All 3.3 queue state is DERIVED (the golden-stability mechanism): a packet's
+// queue membership is (on_edge, edge); its lane is qos_lane_of(edge, class);
+// the per-lane budgets are the 3.2 lane_caps summed per bundle + qos_serialize.
+// Nothing new is serialized, so existing T1 manifests cannot shift unless a
+// run genuinely contends.
+
+// event_emit_drop — append a Packet_Dropped event with its payload (3.3,
+// ODN-14): the dropped class + the Drop_Reason. The serializer writes the
+// payload tag-conditionally, so pre-3.3 event streams stay byte-identical.
+event_emit_drop :: proc(state: ^Run_State, tick: u64, class: u16, reason: Drop_Reason) {
+	append(&state.events, Event{tick = tick, tag = EVENT_TAG_PACKET_DROPPED, class = class, reason = u8(reason)})
+}
+
+// bundle_of_pipe — the bundle slot a pipe belongs to (the derived view; the
+// representative pipe of a bundle resolves to the bundle itself).
+bundle_of_pipe :: proc(state: ^Run_State, pipe: u32) -> (u32, bool) {
+	ps, ok := pipe_slot(&state.topology, pipe)
+	if !ok {
+		return 0, false
+	}
+	if int(ps) >= len(state.bundles.pipe_bundle) {
+		return 0, false
+	}
+	b := state.bundles.pipe_bundle[ps]
+	if b == NO_BUNDLE {
+		return 0, false
+	}
+	return b, true
+}
+
+// bundle_lane_caps — the pooled WFQ allocation of a bundle: Σ member pipe
+// lane_caps (the pooled link carries the same 3 lanes — the bundle ruling).
+// Deterministic slot-order scan; pure function of the derived lane_caps.
+bundle_lane_caps :: proc(state: ^Run_State, bi: u32) -> (caps: [3]u32) {
+	for ps in 0..<len(state.topology.pipe_alive) {
+		if !state.topology.pipe_alive[ps] { continue }
+		if int(ps) >= len(state.bundles.pipe_bundle) { continue }
+		if state.bundles.pipe_bundle[ps] != bi { continue }
+		if int(ps) < len(state.flow.lane_caps) {
+			c := state.flow.lane_caps[ps]
+			caps[0] += c[0]
+			caps[1] += c[1]
+			caps[2] += c[2]
+		}
+	}
+	return
+}
+
+// bundle_lane_of — the lane a packet rides within a bundle: resolved from ITS
+// OWN representative pipe (per-pipe lane overrides hold per member — a bundle
+// can carry differently-classed members).
+bundle_lane_of :: proc(state: ^Run_State, cat: ^Catalogs, p: ^Packet) -> u8 {
+	return qos_lane_of(&state.topology, cat, p.edge, p.class)
+}
+
+// bundle_lane_count — the queue depth of a (bundle, lane): on-edge packets
+// whose pipe belongs to the bundle, resolved to the lane. Array-order walk
+// (deterministic, ODN-10). `exclude` holds indices already queued for removal
+// this tick (the E9 shed deferral) — a pending shed is not part of the queue
+// the next arrival sees (one packet can be shed by only ONE arrival; without
+// this, two same-tick arrivals into a full lane would shed the same packet
+// twice — a duplicated splice + a double-counted drop event).
+bundle_lane_count :: proc(state: ^Run_State, cat: ^Catalogs, bi: u32, lane: u8, exclude: []int = nil) -> u32 {
+	n: u32 = 0
+	for i in 0..<len(state.flow.packets) {
+		p := &state.flow.packets[i]
+		if p.delivered || !p.on_edge { continue }
+		if lane_drop_pending(exclude, i) { continue }
+		b, ok := bundle_of_pipe(state, p.edge)
+		if !ok || b != bi { continue }
+		if bundle_lane_of(state, cat, p) == lane { n += 1 }
+	}
+	return n
+}
+
+// lane_drop_pending — whether an in-flight index is already queued for
+// removal this tick (the E9 shed deferral — splices run after the forward
+// pass, so a shed target must be excluded from every later admission count
+// and shed search of the same pass).
+lane_drop_pending :: proc(drops: []int, idx: int) -> bool {
+	for d in drops {
+		if d == idx { return true }
+	}
+	return false
+}
+
+// newest_in_bundle_lane — the index of the NEWEST (last array-order) packet
+// queued on a bundle in a lane, or -1. Array order = spawn order = join order
+// for same-pipe arrivals (a packet that forwards later was spawned later), so
+// "newest" is the tail of the lane's FIFO — the E9 shed target. Skips
+// pending-drop indices (see bundle_lane_count).
+newest_in_bundle_lane :: proc(state: ^Run_State, cat: ^Catalogs, bi: u32, lane: u8, exclude: []int = nil) -> int {
+	for i := len(state.flow.packets) - 1; i >= 0; i -= 1 {
+		p := &state.flow.packets[i]
+		if p.delivered || !p.on_edge { continue }
+		if lane_drop_pending(exclude, i) { continue }
+		b, ok := bundle_of_pipe(state, p.edge)
+		if !ok || b != bi { continue }
+		if bundle_lane_of(state, cat, p) == lane { return i }
+	}
+	return -1
+}
+
+// bundle_lane_ready — which lanes of a bundle have queued packets this tick
+// (the E7 floor + gap-fill read). Array-order walk, early-out when all three.
+bundle_lane_ready :: proc(state: ^Run_State, cat: ^Catalogs, bi: u32) -> (ready: [LANE_COUNT]bool) {
+	for i in 0..<len(state.flow.packets) {
+		p := &state.flow.packets[i]
+		if p.delivered || !p.on_edge { continue }
+		b, ok := bundle_of_pipe(state, p.edge)
+		if !ok || b != bi { continue }
+		ready[bundle_lane_of(state, cat, p)] = true
+		if ready[0] && ready[1] && ready[2] { break }
+	}
+	return
+}
+
+// flow_remove_at — splice a packet out of the in-flight array, preserving
+// order (the drop path — no new Packet field, no `delivered` misuse). The
+// caller must pass indices collected against the CURRENT array and apply them
+// DESCENDING (earlier indices stay valid after later splices).
+flow_remove_at :: proc(f: ^Flow_State, idx: int) {
+	for i := idx; i < len(f.packets) - 1; i += 1 {
+		f.packets[i] = f.packets[i + 1]
+	}
+	pop(&f.packets)
+}
+
+// serve_bundle_lane — serve up to `avail` bandwidth-units to one lane queue
+// of a bundle (FIFO in array order): each queued packet consumes
+// min(need, avail); a packet whose need is met arrives at its heading
+// (delivered at dst → score + Packet_Arrived — the 1.3 arrival semantics).
+// `skip` holds the packet ids that forwarded THIS tick — they joined the
+// queue but do NOT consume bandwidth until next tick (the one-hop-per-tick
+// convention). Returns the units actually consumed (a packet with a small
+// residual need consumes less than the budget — the residual flows to the
+// next window).
+serve_bundle_lane :: proc(state: ^Run_State, cat: ^Catalogs, tick: u64, bi: u32, lane: u8, avail_in: u32, skip: []u64) -> u32 {
+	f := &state.flow
+	bandwidth := u32(cat.balance.packet_bandwidth)
+	served: u32 = 0
+	avail := avail_in
+	for i in 0..<len(f.packets) {
+		if avail == 0 { break }
+		p := &f.packets[i]
+		if p.delivered || !p.on_edge { continue }
+		joined_this_tick := false
+		for s in skip {
+			if s == p.id {
+				joined_this_tick = true
+				break
+			}
+		}
+		if joined_this_tick {
+			continue // forwarded this tick — consumes bandwidth from NEXT tick
+		}
+		b, ok := bundle_of_pipe(state, p.edge)
+		if !ok || b != bi { continue }
+		if bundle_lane_of(state, cat, p) != lane { continue }
+		need := bandwidth - p.progress_units // progress < bandwidth for a live on-edge packet
+		if need == 0 { continue } // defensive — arrived packets are flagged, never served
+		give := min(need, avail)
+		p.progress_units += give
+		avail -= give
+		served += give
+		if p.progress_units >= bandwidth {
+			// arrived at the far endpoint (the Packet_Arrived event emits from
+			// the CULL pass — array order, so the same-tick event stream keeps
+			// spawn order exactly like the 2.x single-pass model, F6)
+			p.at_node = p.heading
+			p.on_edge = false
+			p.progress_units = 0
+			if p.at_node == p.dst {
+				p.delivered = true
+				state.score += 1 // 1.4: a delivered packet scores (the win metric)
+			}
+		}
+	}
+	return served
+}
+
+// pool_newest_in_lane — the index of the newest (last array-order) in-flight
+// packet riding `lane`, or -1. On-edge packets ride their pipe's lane; at-node
