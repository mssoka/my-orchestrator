+	testing.expect_value(t, qos_serialize({0, 0, 0}, {true, true, true}, 15), [3]u32{1, 1, 1}) // E7 floors
+	testing.expect_value(t, qos_serialize({0, 0, 0}, {true, false, true}, 15), [3]u32{1, 0, 1})
+	testing.expect_value(t, qos_serialize({0, 0, 0}, {true, true, true}, 2), [3]u32{1, 1, 0}) // floors truncate E->S->B
+	testing.expect_value(t, qos_serialize({5, 5, 5}, {false, true, false}, 15), [3]u32{0, 5, 0}) // non-ready lanes get nothing
+}
+
+@(test)
+test_qos_lone_packet_full_capacity :: proc(t: ^testing.T) {
+	// the golden-stability keystone: a lone packet in ANY lane crosses a
+	// standard pipe (cap 15, bandwidth 30) in 2 on-edge ticks — the 3.2
+	// transit, unchanged. Measured per lane via the player's overrides.
+	classes := [3]u16{0, 1, 2}
+	for cls in classes {
+		lane := LANE_STANDARD
+		if cls == 0 { lane = LANE_BEST_EFFORT } // email overridden to Best-effort
+		else if cls == 1 { lane = LANE_EXPRESS } // streaming overridden to Express
+		// cls 2 (bulk) rides Standard
+		cat_storage: Catalogs
+		cat := test_catalog(&cat_storage)
+		defer catalogs_destroy(cat)
+		s: Run_State
+		defer run_destroy(&s)
+		run_init(&s, 1, cat.hash, TEST_LOGIC_HZ)
+		res, rt, _ := lane_pipe_setup(&s, cat)
+		queue_packet(&s, cls, res, rt, false, 0, 0)
+		// tick 1: join the queue (no consumption that tick). Ticks 2-3: the
+		// lone packet gets the FULL capacity (15/tick via the cyclic windows).
+		step_n(&s, 2, cat)
+		testing.expectf(t, s.score == 0, "lane %d: not delivered after 2 ticks (transit is 2 on-edge ticks)", lane)
+		step_n(&s, 1, cat)
+		testing.expectf(t, s.score == 1, "lane %d: lone packet crosses in 2 on-edge ticks — full capacity (work-conserving)", lane)
+	}
+}
