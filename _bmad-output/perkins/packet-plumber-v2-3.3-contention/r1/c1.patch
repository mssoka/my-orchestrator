+@(test)
+test_qos_drop_ladder_e9 :: proc(t: ^testing.T) {
+	// E9 — the full ladder, every emptiness combo: when a (bundle, lane) queue
+	// is at its bound, the pipe sheds the NEWEST packet of the LOWEST-priority
+	// NON-EMPTY lane (BE -> Standard -> Express); the arriving packet itself
+	// drops when it IS the shed target (its lane is the lowest non-empty). For
+	// every queued-lane subset and every arrival lane: fresh run, park the
+	// queue at the bound, park the arrival at res, step once, assert.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	bound := u32(cat.balance.lane_queue_packets) // 6
+	class_of := [3]u16{1, 2, 0} // lane -> class (E=streaming, S=bulk, BE=email)
+	for combo in u32(1)..<8 {
+		for arrival_lane in 0..<3 {
+			s: Run_State
+			defer run_destroy(&s)
+			run_init(&s, 1, cat.hash, TEST_LOGIC_HZ)
+			res, rt, _ := lane_pipe_setup(&s, cat)
+			// park `bound` queued packets per lane in the combo (on pipe 0)
+			for lane in 0..<3 {
+				if combo & (1 << u32(lane)) == 0 { continue }
+				for k in 0..<bound {
+					queue_packet(&s, class_of[lane], res, rt, true, 0, rt)
+				}
+			}
+			// the arrival: at res, about to join pipe 0 in `arrival_lane`
+			aid := queue_packet(&s, class_of[arrival_lane], res, rt, false, 0, 0)
+			step_n(&s, 1, cat)
+			// The ladder fires ONLY when the arrival's OWN lane queue is at the
+			// bound (the target lane is full). Shed target = the lowest-priority
+			// NON-EMPTY lane of the combo; the arrival itself drops when it IS
+			// the shed target. An arrival into a non-combo (empty) lane just
+			// joins — no drop at all.
+			in_combo := combo & (1 << u32(arrival_lane)) != 0
+			if !in_combo {
+				testing.expectf(t, in_flight(&s, aid), "combo %d arr %d: an arrival into an empty lane must join", combo, arrival_lane)
+				testing.expectf(t, count_drops(&s, class_of[arrival_lane], .Queue_Overflow) == 0,
+					"combo %d arr %d: no drop when the arrival's lane is not full", combo, arrival_lane)
+				continue
+			}
+			// the shed target: the lowest-priority NON-EMPTY lane of the combo
+			shed_lane := -1
+			for li in 0..<3 {
+				lane := 2 - li // BE -> S -> E
+				if combo & (1 << u32(lane)) != 0 {
+					shed_lane = lane
+					break
+				}
+			}
+			if arrival_lane == shed_lane {
+				// the arrival is the shed target — it drops, queue keeps bound
+				testing.expectf(t, count_drops(&s, class_of[arrival_lane], .Queue_Overflow) == 1,
+					"combo %d arr %d: the arrival (%d) must drop as the shed target", combo, arrival_lane, class_of[arrival_lane])
+				testing.expectf(t, !in_flight(&s, aid), "combo %d arr %d: the arrival must be gone", combo, arrival_lane)
+			} else {
+				// a lower-priority queued packet pays: its newest drops, the
+				// arrival joins (the per-lane bound may transiently overshoot by
+				// one — the arrival replaced a lower-priority packet, never grew
+				// the pipe's total)
+				testing.expectf(t, count_drops(&s, class_of[shed_lane], .Queue_Overflow) == 1,
+					"combo %d arr %d: the shed packet must be class %d (lane %d)", combo, arrival_lane, class_of[shed_lane], shed_lane)
+				testing.expectf(t, count_drops(&s, class_of[arrival_lane], .Queue_Overflow) == 0,
+					"combo %d arr %d: the arrival must NOT drop when a lower lane pays", combo, arrival_lane)
+				testing.expectf(t, in_flight(&s, aid), "combo %d arr %d: the arrival must join", combo, arrival_lane)
+			}
+			// the pipe's total occupancy: a shed REPLACES (net zero); only an
+			// arrival into an empty lane grows it (asserted above)
+			total := 0
+			for p in s.flow.packets {
+				if p.on_edge { total += 1 }
+			}
+			queued := 0
+			for lane in 0..<3 {
+				if combo & (1 << u32(lane)) != 0 { queued += 1 }
+			}
+			want := int(bound) * queued // bound per queued lane — replacement is net-zero
+			testing.expectf(t, total == want, "combo %d arr %d: queued count %d, want %d", combo, arrival_lane, total, want)
+		}
+	}
+}
+
+@(test)
+test_qos_pool_exhaustion_e22 :: proc(t: ^testing.T) {
+	// E22 — the global pool backstop: at pool_max_packets the spawn ladder
+	// sheds the NEWEST packet of the LOWEST-priority non-empty lane among
+	// in-flight packets (on-edge -> their pipe's lane; at-node -> the class
+	// default_lane — Standard, the no-auto canon). The arriving packet drops
+	// when its lane (Standard at spawn — no pipe yet) IS the shed target.
+	// Case A — displacement: a BE resident pays for a Standard arrival.
+	{
+		cat_storage: Catalogs
+		cat := test_catalog(&cat_storage)
+		defer catalogs_destroy(cat)
+		cat.balance.pool_max_packets = 2
+		s: Run_State
+		defer run_destroy(&s)
+		run_init(&s, 1, cat.hash, TEST_LOGIC_HZ)
+		res, rt, _ := lane_pipe_setup(&s, cat)
+		email_idx, _ := class_index(cat, "email")
+		bulk_idx, _ := class_index(cat, "bulk")
+		be_id := queue_packet(&s, u16(email_idx), res, rt, true, 0, rt) // BE resident (on pipe 0)
+		queue_packet(&s, u16(bulk_idx), res, rt, false, 0, 0)           // S resident (at-node at res)
+		flow_seed_demand(&s.flow, 1, res, rt, u16(email_idx))           // the arrival (S at spawn)
+		step_n(&s, 1, cat)
+		testing.expectf(t, count_drops(&s, u16(email_idx), .Pool_Exhaustion) == 1,
+			"E22 A: the BE resident must pay (email/Pool_Exhaustion)")
+		testing.expectf(t, !in_flight(&s, be_id), "E22 A: the BE resident must be gone")
+	}
+	// Case C — the inversion guard (review F2): a pool full of EXPRESS
+	// residents must NEVER shed Express for a Standard arrival — the arrival
+	// is the lowest-priority candidate present and drops itself.
+	{
+		cat_storage: Catalogs
+		cat := test_catalog(&cat_storage)
+		defer catalogs_destroy(cat)
+		cat.balance.pool_max_packets = 2
+		s: Run_State
+		defer run_destroy(&s)
+		run_init(&s, 1, cat.hash, TEST_LOGIC_HZ)
+		res, rt, _ := lane_pipe_setup(&s, cat)
+		email_idx, _ := class_index(cat, "email")
+		e1 := queue_packet(&s, 1, res, rt, true, 0, rt) // E resident (streaming on pipe 0)
+		e2 := queue_packet(&s, 1, res, rt, true, 0, rt) // E resident
+		flow_seed_demand(&s.flow, 1, res, rt, u16(email_idx)) // the arrival (Standard at spawn)
+		step_n(&s, 1, cat)
+		testing.expectf(t, count_drops(&s, u16(email_idx), .Pool_Exhaustion) == 1,
+			"E22 C: the Standard arrival must drop — Express residents never pay")
+		testing.expectf(t, count_drops(&s, 1, .Pool_Exhaustion) == 0,
+			"E22 C: no Express shed (inversion guard), got %d", count_drops(&s, 1, .Pool_Exhaustion))
+		testing.expectf(t, in_flight(&s, e1) && in_flight(&s, e2), "E22 C: both Express residents survive")
+	}
+	// Case B — self-shed: Standard is the lowest non-empty lane -> the arrival
+	// itself drops, never spawned.
+	{
+		cat_storage: Catalogs
+		cat := test_catalog(&cat_storage)
+		defer catalogs_destroy(cat)
+		cat.balance.pool_max_packets = 2
+		s: Run_State
+		defer run_destroy(&s)
+		run_init(&s, 1, cat.hash, TEST_LOGIC_HZ)
+		res, rt, _ := lane_pipe_setup(&s, cat)
+		email_idx, _ := class_index(cat, "email")
+		bulk_idx, _ := class_index(cat, "bulk")
+		queue_packet(&s, u16(bulk_idx), res, rt, false, 0, 0) // S resident
+		queue_packet(&s, u16(bulk_idx), res, rt, false, 0, 0) // S resident
+		flow_seed_demand(&s.flow, 1, res, rt, u16(email_idx)) // the arrival (S at spawn)
+		step_n(&s, 1, cat)
+		testing.expectf(t, count_drops(&s, u16(email_idx), .Pool_Exhaustion) == 1,
+			"E22 B: the arrival must drop when Standard is the shed target")
+		testing.expectf(t, len(s.flow.packets) == 2, "E22 B: no spawn — pool stays at 2, got %d", len(s.flow.packets))
+	}
+}
+
+@(test)
+test_qos_drop_ladder_e9_double_shed :: proc(t: ^testing.T) {
+	// the same-tick double-arrival guard: two Express arrivals into a full E
+	// lane (BE also full) must shed TWO DISTINCT Best-effort packets — one
+	// real shed per arrival. The shed is deferred (splices run after the
+	// forward pass), so without the pending-drop exclusion both arrivals would
+	// shed the SAME newest BE packet: a duplicated splice index (removes the
+	// WRONG packet) + a double-counted drop event. Pinned here.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	bound := u32(cat.balance.lane_queue_packets)
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 1, cat.hash, TEST_LOGIC_HZ)
+	res, rt, _ := lane_pipe_setup(&s, cat)
+	for k in 0..<bound {
+		queue_packet(&s, 1, res, rt, true, 0, rt) // E lane at the bound (streaming)
+		queue_packet(&s, 0, res, rt, true, 0, rt) // BE lane at the bound (email)
+	}
+	// two E arrivals + one BE arrival, all in the same tick
+	a1 := queue_packet(&s, 1, res, rt, false, 0, 0)
+	a2 := queue_packet(&s, 1, res, rt, false, 0, 0)
+	a3 := queue_packet(&s, 0, res, rt, false, 0, 0)
+	step_n(&s, 1, cat)
+	// two DISTINCT BE sheds (one per E arrival) — never one packet twice
+	testing.expectf(t, count_drops(&s, 0, .Queue_Overflow) == 2,
+		"two distinct BE sheds for two E arrivals, got %d", count_drops(&s, 0, .Queue_Overflow))
+	testing.expectf(t, count_drops(&s, 1, .Queue_Overflow) == 0,
+		"no Express drop — lower lanes still pay, got %d", count_drops(&s, 1, .Queue_Overflow))
+	// both E arrivals joined; the BE arrival joins too (the two sheds opened
+	// its lane below the bound — replacement, not self-shed)
+	testing.expectf(t, in_flight(&s, a1) && in_flight(&s, a2) && in_flight(&s, a3),
+		"all three arrivals must be in flight (a1=%v a2=%v a3=%v)", in_flight(&s, a1), in_flight(&s, a2), in_flight(&s, a3))
+	// queue totals: E 6+2, BE 6-2 -> 12 queued + 1 joined BE = 13 on the pipe
+	total := 0
+	for p in s.flow.packets {
+		if p.on_edge { total += 1 }
+	}
+	testing.expectf(t, total == 13, "queued total 13 (two sheds, three joins), got %d", total)
+}
