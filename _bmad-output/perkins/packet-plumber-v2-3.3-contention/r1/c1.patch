+// qos_serialize — the pure per-window WRR service budget (ODN-3 §6.3, story
+// 3.3): one window's worth of per-lane service entitlement over the pipe's
+// remaining capacity. Express → Standard → Best; a lane with no queued
+// packets is skipped (its entitlement flows to the next READY lane in the
+// walk — work-conserving gap-fill, the pipe is never idle while a packet
+// waits); a ready lane whose allocation is zero is floored to a 1-unit
+// quantum while capacity remains (E7 — ≥1 slot per non-empty lane per
+// window, no starvation under continuous Express); budgets clamp to the
+// remaining capacity (tiny pipes floor in lane order E→S→B, later lanes
+// truncate — the E6 truncation convention). The FLOW serves each lane's
+// budget FIFO and repeats windows until the bundle's capacity is consumed
+// (cyclic WRR — a lone packet in ANY lane gets the full capacity).
+qos_serialize :: proc(caps: [3]u32, ready: [3]bool, capacity: u32) -> (budget: [3]u32) {
+	remaining := capacity
+	for lane in 0..<LANE_COUNT {
+		if !ready[lane] {
+			continue // no packets queued — skip; the walk's gap-fill covers it
+		}
+		avail := caps[lane]
+		if avail == 0 {
+			avail = 1 // E7 WRR floor: a non-empty lane still gets a slot
+		}
+		if avail > remaining {
+			avail = remaining
+		}
+		budget[lane] = avail
+		remaining -= avail
+	}
+	return budget
+}
