diff --git a/server/test/integration/reference_checks_webhooks_integration_test.gleam b/server/test/integration/reference_checks_webhooks_integration_test.gleam
new file mode 100644
index 00000000..4f5ab3e3
--- /dev/null
+++ b/server/test/integration/reference_checks_webhooks_integration_test.gleam
@@ -0,0 +1,498 @@
+//// Integration tests for the reference-check delivery webhooks (RC3.6).
+////
+//// Pins the headline invariants against a real Postgres (Docker test DB):
+////   AC1 — svix-verified Resend bounce -> awaiting_correction + audit + in-app
+////         notification + NULL next_attempt_at
+////   AC2 — X-Twilio-Signature-verified SMS failure -> awaiting_correction
+////   AC3 — an unsigned / wrong-signature request mutates NOTHING (rejected)
+////   AC4 — re-delivering the same event id is idempotent (no double-apply)
+////   AC5 — a bounce on an already-objected row is a sticky no-op (AD-14)
+////   AC7 — an event for a contact on no live row is a 200 no-op
+////   AC8 — exactly one in-app notification, no email path exercised
+////
+//// The svix + Twilio signatures are built with the inverse of the verifiers
+//// (the same algorithms), so a passing test proves the handler accepts a
+//// genuinely-signed request and rejects every mutation (AC3).
+
+import config
+import gleam/bit_array
+import gleam/crypto
+import gleam/dynamic/decode
+import gleam/float
+import gleam/http
+import gleam/int
+import gleam/string
+import gleam/time/timestamp
+import gleeunit/should
+import integration/helpers
+import integration/test_db
+import notification/sms_client
+import notification/twilio_webhook
+import pog
+import reference_checks/webhooks
+import sentry/sentry_client
+import unitest
+import wisp
+import wisp/simulate
+
+const resend_secret = "whsec_dGVzdA=="
+
+const twilio_token = "rc3-6-twilio-test-token"
+
+const twilio_base = "https://righttenantry.ie"
+
+const email_id = "re-rc3-6-deadbeef"
+
+const message_sid = "SMdeadbeefdeadbeefdeadbeefdeadbeef"
+
+const svix_id = "msg_rc3_6_test_001"
+
+// ---------------------------------------------------------------------------
+// AC1 — svix-verified Resend bounce -> awaiting_correction + audit + notif
+// ---------------------------------------------------------------------------
+
+pub fn resend_bounce_moves_row_to_awaiting_correction_test() {
+  use <- unitest.tag("integration")
+  let db = helpers.setup()
+  let #(row_id, cfg) = seed_contact_initiated_row(db, email_id)
+
+  let body = resend_bounce_body(email_id, "colm@example.com")
+  let #(ts, sig) = svix_sign(body, resend_secret, svix_id)
+  let resp = post_resend(cfg, body, svix_id, ts, sig)
+
+  resp.status |> should.equal(200)
+
+  let assert Ok(#(status, reason, next_null)) = row_state(db, row_id)
+  status |> should.equal("awaiting_correction")
+  reason |> should.equal("email_bounced")
+  next_null |> should.equal(True)
+
+  // AD-16 audit row written.
+  audit_count(db, row_id, "reference_call_correction_requested")
+  |> should.equal(1)
+
+  // AC8 — exactly one in-app notification (Q3=B2), entity = reference_call.
+  notification_count(db, row_id, "reference_awaiting_correction")
+  |> should.equal(1)
+}
+
+// ---------------------------------------------------------------------------
+// AC3 — signature verification is load-bearing (no mutation on bad sig)
+// ---------------------------------------------------------------------------
+
+pub fn resend_wrong_signature_changes_nothing_test() {
+  use <- unitest.tag("integration")
+  let db = helpers.setup()
+  let #(row_id, cfg) = seed_contact_initiated_row(db, email_id)
+
+  let body = resend_bounce_body(email_id, "colm@example.com")
+  // Sign with a DIFFERENT secret — verification fails.
+  let #(_, sig) =
+    svix_sign(body, "whsec_ZGVmaW5pdGVseS1ub3QtdGhlLXNlY3JldA==", svix_id)
+  let resp = post_resend(cfg, body, svix_id, current_ts(), sig)
+
+  resp.status |> should.equal(401)
+
+  let assert Ok(#(status, reason, next_null)) = row_state(db, row_id)
+  status |> should.equal("contact_initiated")
+  reason |> should.equal("")
+  next_null |> should.equal(False)
+  audit_count(db, row_id, "reference_call_correction_requested")
+  |> should.equal(0)
+}
+
+pub fn resend_missing_signature_headers_changes_nothing_test() {
+  use <- unitest.tag("integration")
+  let db = helpers.setup()
+  let #(row_id, cfg) = seed_contact_initiated_row(db, email_id)
+
+  let resp =
+    simulate.request(http.Post, "/webhooks/resend-events")
+    |> simulate.string_body(resend_bounce_body(email_id, "colm@example.com"))
+    |> webhooks.handle_resend_webhook(cfg)
+
+  resp.status |> should.equal(401)
+  let assert Ok(#(status, _, _)) = row_state(db, row_id)
+  status |> should.equal("contact_initiated")
+}
+
+// ---------------------------------------------------------------------------
+// AC4 — idempotent re-delivery (same svix-id twice -> one transition)
+// ---------------------------------------------------------------------------
+
+pub fn resend_redelivery_is_idempotent_test() {
+  use <- unitest.tag("integration")
+  let db = helpers.setup()
+  let #(row_id, cfg) = seed_contact_initiated_row(db, email_id)
+
+  let body = resend_bounce_body(email_id, "colm@example.com")
+  let #(ts, sig) = svix_sign(body, resend_secret, svix_id)
+
+  // First delivery — transitions.
+  post_resend(cfg, body, svix_id, ts, sig) |> simulate.read_body |> ignore
+  // Re-delivery with the SAME svix-id — idempotent (claim 0 rows).
+  post_resend(cfg, body, svix_id, ts, sig) |> simulate.read_body |> ignore
+
+  audit_count(db, row_id, "reference_call_correction_requested")
+  |> should.equal(1)
+  notification_count(db, row_id, "reference_awaiting_correction")
+  |> should.equal(1)
+}
+
+// ---------------------------------------------------------------------------
+// AC5 — sticky: a bounce on an already-objected row is a no-op (AD-14)
+// ---------------------------------------------------------------------------
+
+pub fn bounce_on_objected_row_is_sticky_noop_test() {
+  use <- unitest.tag("integration")
+  let db = helpers.setup()
+  let #(row_id, cfg) = seed_objected_row(db, email_id)
+
+  let body = resend_bounce_body(email_id, "colm@example.com")
+  let #(ts, sig) = svix_sign(body, resend_secret, svix_id)
+  let resp = post_resend(cfg, body, svix_id, ts, sig)
+
+  resp.status |> should.equal(200)
+  // Objected is sticky — a late bounce changes nothing (AD-6/AD-14).
+  let assert Ok(#(status, _, _)) = row_state(db, row_id)
+  status |> should.equal("objected")
+  audit_count(db, row_id, "reference_call_correction_requested")
+  |> should.equal(0)
+}
+
+// ---------------------------------------------------------------------------
+// AC2 — X-Twilio-Signature-verified SMS failure -> awaiting_correction
+// ---------------------------------------------------------------------------
+
+pub fn twilio_failure_moves_row_to_awaiting_correction_test() {
+  use <- unitest.tag("integration")
+  let db = helpers.setup()
+  let #(row_id, cfg) = seed_contact_initiated_row(db, message_sid)
+
+  let params = [
+    #("MessageSid", message_sid),
+    #("MessageStatus", "failed"),
+    #("To", "+353871111111"),
+    #("AccountSid", "ACtest"),
+  ]
+  let resp = post_twilio(cfg, params)
+
+  resp.status |> should.equal(200)
+  let assert Ok(#(status, reason, _)) = row_state(db, row_id)
+  status |> should.equal("awaiting_correction")
+  reason |> should.equal("sms_failed")
+}
+
+pub fn twilio_wrong_signature_changes_nothing_test() {
+  use <- unitest.tag("integration")
+  let db = helpers.setup()
+  let #(row_id, cfg) = seed_contact_initiated_row(db, message_sid)
+
+  let params = [
+    #("MessageSid", message_sid),
+    #("MessageStatus", "failed"),
+    #("To", "+353871111111"),
+  ]
+  let sig = twilio_sign("wrong-token", sms_callback_url(), params)
+  let resp =
+    simulate.request(http.Post, "/webhooks/twilio-sms")
+    |> simulate.header("x-twilio-signature", sig)
+    |> simulate.form_body(params)
+    |> webhooks.handle_twilio_webhook(cfg)
+
+  resp.status |> should.equal(403)
+  let assert Ok(#(status, _, _)) = row_state(db, row_id)
+  status |> should.equal("contact_initiated")
+}
+
+// ---------------------------------------------------------------------------
+// AC7 — an event for a contact on no live row is a 200 no-op
+// ---------------------------------------------------------------------------
+
+pub fn resend_bounce_for_unknown_contact_is_noop_test() {
+  use <- unitest.tag("integration")
+  let db = helpers.setup()
+  let cfg = config_with_secrets(helpers.test_server_config(db))
+
+  // No row seeded — the bounce is for a contact on no live row.
+  let body = resend_bounce_body("re-unknown", "nobody@example.com")
+  let #(ts, sig) = svix_sign(body, resend_secret, "msg_unknown")
+  let resp = post_resend(cfg, body, "msg_unknown", ts, sig)
+
+  // 200 ack, no crash, no state (there was nothing to change).
+  resp.status |> should.equal(200)
+}
+
+// ---------------------------------------------------------------------------
+// Seeding
+// ---------------------------------------------------------------------------
+
+/// Seed a landlord + vacancy + application + a reference_call at
+/// `contact_initiated` whose attempts log carries a `delivered` send with the
+/// given message id (so find_reference_call_by_send_ref finds it). Returns the
+/// row id + a ServerConfig wired with the test webhook secrets / Twilio.
+fn seed_contact_initiated_row(
+  db: pog.Connection,
+  send_ref: String,
+) -> #(String, config.ServerConfig) {
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 0)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let app_id = insert_application(db, vacancy_id)
+  let row_id = insert_reference_call(db, app_id, "contact_initiated", send_ref)
+  #(row_id, config_with_secrets(helpers.test_server_config(db)))
+}
+
+fn seed_objected_row(
+  db: pog.Connection,
+  send_ref: String,
+) -> #(String, config.ServerConfig) {
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 0)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let app_id = insert_application(db, vacancy_id)
+  let row_id = insert_objected_reference_call(db, app_id, send_ref)
+  #(row_id, config_with_secrets(helpers.test_server_config(db)))
+}
+
+fn insert_application(db: pog.Connection, vacancy_id: String) -> String {
+  let assert Ok(pog.Returned(_, [app_id, ..])) =
+    pog.query(
+      "INSERT INTO application (
+         vacancy_id, first_name, last_name, email, phone,
+         employment_status, monthly_income_cents,
+         employer_name, job_title, employment_duration,
+         landlord_ref_name, landlord_ref_email, landlord_ref_phone,
+         never_rented_before, reference_contact_choice
+       )
+       VALUES (
+         $1::uuid, 'Aisling', 'O''Brien', 'applicant@example.com', '+353861234567',
+         'employed', 350000,
+         'Acme Ltd', 'Senior Chef', '3 years',
+         'Colm Byrne', 'colm@example.com', '+353871111111',
+         false, 'attested'
+       )
+       RETURNING id::text",
+    )
+    |> pog.parameter(pog.text(vacancy_id))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  app_id
+}
+
+fn insert_reference_call(
+  db: pog.Connection,
+  app_id: String,
+  status: String,
+  send_ref: String,
+) -> String {
+  // attempts carries the delivered send whose `detail` is the provider message
+  // id — find_reference_call_by_send_ref matches it via jsonb @> containment.
+  let attempt_entry =
+    "{\"at\":\"2026-08-12T09:00:00Z\",\"channel\":\"email\",\"outcome\":\"delivered\",\"detail\":\""
+    <> send_ref
+    <> "\"}"
+  let assert Ok(pog.Returned(_, [row_id, ..])) =
+    pog.query(
+      "INSERT INTO reference_call (
+         application_id, ref_slot, status, attempt_count,
+         contact_name, contact_email, contact_phone,
+         next_attempt_at, attempts
+       )
+       VALUES (
+         $1::uuid, 'landlord_ref', $2::reference_call_status, 1,
+         'Colm Byrne', 'colm@example.com', '+353871111111',
+         now() + interval '1 day',
+         jsonb_build_array($3::jsonb)
+       )
+       RETURNING id::text",
+    )
+    |> pog.parameter(pog.text(app_id))
+    |> pog.parameter(pog.text(status))
+    |> pog.parameter(pog.text(attempt_entry))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  row_id
+}
+
+fn insert_objected_reference_call(
+  db: pog.Connection,
+  app_id: String,
+  send_ref: String,
+) -> String {
+  let attempt_entry =
+    "{\"at\":\"2026-08-12T09:00:00Z\",\"channel\":\"email\",\"outcome\":\"delivered\",\"detail\":\""
+    <> send_ref
+    <> "\"}"
+  let assert Ok(pog.Returned(_, [row_id, ..])) =
+    pog.query(
+      "INSERT INTO reference_call (
+         application_id, ref_slot, status, outcome, attempt_count,
+         contact_name, contact_email, contact_phone,
+         next_attempt_at, attempts, objected_at
+       )
+       VALUES (
+         $1::uuid, 'landlord_ref', 'objected', 'objected', 1,
+         'Colm Byrne', 'colm@example.com', '+353871111111',
+         NULL, jsonb_build_array($2::jsonb), now()
+       )
+       RETURNING id::text",
+    )
+    |> pog.parameter(pog.text(app_id))
+    |> pog.parameter(pog.text(attempt_entry))
+    |> pog.returning(decode.at([0], decode.string))
+    |> pog.execute(db)
+  row_id
+}
+
+fn config_with_secrets(base: config.ServerConfig) -> config.ServerConfig {
+  config.ServerConfig(
+    ..base,
+    resend_webhook_secret: resend_secret,
+    twilio: sms_client.Enabled(sms_client.TwilioConfig(
+      account_sid: "ACtest",
+      auth_token: twilio_token,
+      alpha_sender: "RTenantry",
+      status_callback_base_url: twilio_base,
+    )),
+  )
+}
+
+// ---------------------------------------------------------------------------
+// DB assertions
+// ---------------------------------------------------------------------------
+
+fn row_state(
+  db: pog.Connection,
+  row_id: String,
+) -> Result(#(String, String, Bool), Nil) {
+  let decoder = {
+    use status <- decode.field(0, decode.string)
+    use reason <- decode.field(1, decode.string)
+    use next_null <- decode.field(2, decode.bool)
+    decode.success(#(status, reason, next_null))
+  }
+  pog.query(
+    "SELECT status::text, COALESCE(terminal_reason, ''), (next_attempt_at IS NULL)
+     FROM reference_call WHERE id = $1::uuid",
+  )
+  |> pog.parameter(pog.text(row_id))
+  |> pog.returning(decoder)
+  |> pog.execute(db)
+  |> first_row
+}
+
+fn audit_count(db: pog.Connection, row_id: String, event_type: String) -> Int {
+  let assert Ok(pog.Returned(_, [n, ..])) =
+    pog.query(
+      "SELECT COUNT(*)::int FROM audit_log
+       WHERE entity_type = 'reference_call' AND entity_id = $1::uuid AND event_type = $2",
+    )
+    |> pog.parameter(pog.text(row_id))
+    |> pog.parameter(pog.text(event_type))
+    |> pog.returning(decode.at([0], decode.int))
+    |> pog.execute(db)
+  n
+}
+
+fn notification_count(
+  db: pog.Connection,
+  row_id: String,
+  notification_type: String,
+) -> Int {
+  let assert Ok(pog.Returned(_, [n, ..])) =
+    pog.query(
+      "SELECT COUNT(*)::int FROM notification
+       WHERE entity_type = 'reference_call' AND entity_id = $1::uuid AND notification_type = $2",
+    )
+    |> pog.parameter(pog.text(row_id))
+    |> pog.parameter(pog.text(notification_type))
+    |> pog.returning(decode.at([0], decode.int))
+    |> pog.execute(db)
+  n
+}
+
+fn first_row(r: Result(pog.Returned(a), pog.QueryError)) -> Result(a, Nil) {
+  case r {
+    Ok(pog.Returned(_, [row, ..])) -> Ok(row)
+    _ -> Error(Nil)
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Request builders + signature helpers
+// ---------------------------------------------------------------------------
+
+fn resend_bounce_body(email_id: String, to: String) -> String {
+  "{\"type\":\"email.bounced\",\"created_at\":\"2026-08-12T10:00:00Z\",\"data\":{\"email_id\":\""
+  <> email_id
+  <> "\",\"to\":[\""
+  <> to
+  <> "\"],\"from\":\"references@righttenantry.ie\",\"subject\":\"Your reference\"}}"
+}
+
+/// Build a valid svix signature (the inverse of svix.verify_signature):
+/// signed = "{svix_id}.{ts}.{body}", HMAC-SHA256 with the base64-decoded secret,
+/// signature header = "v1," <> base64(hmac).
+fn svix_sign(body: String, secret: String, id: String) -> #(String, String) {
+  let ts = current_ts()
+  let secret_b64 = case string.starts_with(secret, "whsec_") {
+    True -> string.drop_start(secret, 6)
+    False -> secret
+  }
+  let assert Ok(secret_bytes) = bit_array.base64_decode(secret_b64)
+  let signed = id <> "." <> ts <> "." <> body
+  let sig =
+    crypto.hmac(<<signed:utf8>>, crypto.Sha256, secret_bytes)
+    |> bit_array.base64_encode(True)
+  #(ts, "v1," <> sig)
+}
+
+fn post_resend(
+  cfg: config.ServerConfig,
+  body: String,
+  id: String,
+  ts: String,
+  sig: String,
+) -> wisp.Response {
+  simulate.request(http.Post, "/webhooks/resend-events")
+  |> simulate.header("svix-id", id)
+  |> simulate.header("svix-timestamp", ts)
+  |> simulate.header("svix-signature", sig)
+  |> simulate.string_body(body)
+  |> webhooks.handle_resend_webhook(cfg)
+}
+
+fn post_twilio(
+  cfg: config.ServerConfig,
+  params: List(#(String, String)),
+) -> wisp.Response {
+  let sig = twilio_sign(twilio_token, sms_callback_url(), params)
+  simulate.request(http.Post, "/webhooks/twilio-sms")
+  |> simulate.header("x-twilio-signature", sig)
+  |> simulate.form_body(params)
+  |> webhooks.handle_twilio_webhook(cfg)
+}
+
+fn twilio_sign(
+  auth_token: String,
+  url: String,
+  params: List(#(String, String)),
+) -> String {
+  let signed = twilio_webhook.build_signed_payload(url, params)
+  crypto.hmac(<<signed:utf8>>, crypto.Sha256, <<auth_token:utf8>>)
+  |> bit_array.base64_encode(True)
+}
+
+fn sms_callback_url() -> String {
+  twilio_base <> "/webhooks/twilio-sms"
+}
+
+fn current_ts() -> String {
+  timestamp.system_time()
+  |> timestamp.to_unix_seconds
+  |> float.truncate
+  |> int.to_string
+}
+
+fn ignore(_a) -> Nil {
+  Nil
+}
diff --git a/server/test/notification/twilio_webhook_test.gleam b/server/test/notification/twilio_webhook_test.gleam
new file mode 100644
index 00000000..5a552528
--- /dev/null
+++ b/server/test/notification/twilio_webhook_test.gleam
@@ -0,0 +1,143 @@
+//// Unit tests for the Twilio webhook signature verifier (rc3-6, AD-15).
+////
+//// Signature verification is load-bearing — an unverified request must change
+//// NOTHING. These prove: (a) a correctly-computed signature is accepted, (b)
+//// ANY mutation to the auth_token / url / params is rejected (constant-time
+//// compare + the signed payload includes the full url + every param), and (c)
+//// the signed-payload builder sorts params by key per Twilio's spec. The
+//// algorithm mirrors the spec independently (crypto.hmac over the builder
+//// output) so the test isn't circular on the verifier itself.
+
+import gleam/bit_array
+import gleam/crypto
+import gleam/list
+import gleeunit/should
+import notification/twilio_webhook
+
+const test_auth_token = "rc3-6-test-auth-token-1234567890"
+
+const test_url = "https://righttenantry.ie/webhooks/twilio-sms"
+
+fn test_params() -> List(#(String, String)) {
+  // Deliberately out of key order — the builder sorts; the signed payload is
+  // order-independent of the input list.
+  [
+    #("MessageStatus", "failed"),
+    #("To", "+353861234567"),
+    #("MessageSid", "SMdeadbeefdeadbeefdeadbeefdeadbeef"),
+    #("AccountSid", "AC123"),
+  ]
+}
+
+/// Compute the expected signature independently (the same algorithm the
+/// verifier runs internally), so the accept test proves the wiring rather than
+/// asserting a magic string.
+fn expected_signature(
+  auth_token: String,
+  url: String,
+  params: List(#(String, String)),
+) -> String {
+  let signed = twilio_webhook.build_signed_payload(url, params)
+  crypto.hmac(<<signed:utf8>>, crypto.Sha256, <<auth_token:utf8>>)
+  |> bit_array.base64_encode(True)
+}
+
+pub fn verify_accepts_a_correctly_computed_signature_test() {
+  let sig = expected_signature(test_auth_token, test_url, test_params())
+  twilio_webhook.verify_signature(
+    auth_token: test_auth_token,
+    url: test_url,
+    params: test_params(),
+    provided_signature: sig,
+  )
+  |> should.equal(Ok(Nil))
+}
+
+pub fn verify_rejects_a_wrong_auth_token_test() {
+  let sig = expected_signature(test_auth_token, test_url, test_params())
+  twilio_webhook.verify_signature(
+    auth_token: "totally-different-token",
+    url: test_url,
+    params: test_params(),
+    provided_signature: sig,
+  )
+  |> should.be_error
+}
+
+pub fn verify_rejects_a_wrong_url_test() {
+  // The signed URL must match the StatusCallback URL sms_client configured — a
+  // proxy/host mismatch (e.g. the internal run.app URL vs the public origin)
+  // must fail, never silently pass.
+  let sig = expected_signature(test_auth_token, test_url, test_params())
+  twilio_webhook.verify_signature(
+    auth_token: test_auth_token,
+    url: "https://righttenantry.ie/api/v1/webhooks/twilio-sms",
+    params: test_params(),
+    provided_signature: sig,
+  )
+  |> should.be_error
+}
+
+pub fn verify_rejects_a_tampered_param_value_test() {
+  let sig = expected_signature(test_auth_token, test_url, test_params())
+  let tampered = [
+    #("MessageStatus", "delivered"),
+    ..list.drop(test_params(), 1)
+  ]
+  twilio_webhook.verify_signature(
+    auth_token: test_auth_token,
+    url: test_url,
+    params: tampered,
+    provided_signature: sig,
+  )
+  |> should.be_error
+}
+
+pub fn verify_rejects_a_missing_param_test() {
+  let sig = expected_signature(test_auth_token, test_url, test_params())
+  // Drop one param — the signed payload no longer matches.
+  let truncated = list.take(test_params(), 3)
+  twilio_webhook.verify_signature(
+    auth_token: test_auth_token,
+    url: test_url,
+    params: truncated,
+    provided_signature: sig,
+  )
+  |> should.be_error
+}
+
+pub fn verify_rejects_an_empty_signature_test() {
+  twilio_webhook.verify_signature(
+    auth_token: test_auth_token,
+    url: test_url,
+    params: test_params(),
+    provided_signature: "",
+  )
+  |> should.be_error
+}
+
+pub fn build_signed_payload_sorts_params_by_key_test() {
+  // URL first, then each param as key+value in ascending ASCII key order
+  // (A < M < M < T), regardless of input order.
+  twilio_webhook.build_signed_payload("URL", [
+    #("MessageStatus", "failed"),
+    #("AccountSid", "AC123"),
+    #("To", "+353"),
+  ])
+  |> should.equal("URLAccountSidAC123MessageStatusfailedTo+353")
+}
+
+pub fn build_signed_payload_handles_empty_params_test() {
+  twilio_webhook.build_signed_payload("URL", [])
+  |> should.equal("URL")
+}
+
+pub fn param_finds_a_value_test() {
+  twilio_webhook.param("MessageStatus", test_params())
+  |> should.equal(Ok("failed"))
+}
+
+pub fn param_returns_error_when_absent_test() {
+  twilio_webhook.param("Nonexistent", test_params())
+  |> should.be_error
+}
diff --git a/server/test/reference_checks/webhooks_test.gleam b/server/test/reference_checks/webhooks_test.gleam
