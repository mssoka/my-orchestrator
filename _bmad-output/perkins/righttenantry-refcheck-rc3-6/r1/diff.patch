+//// Reference-check delivery webhooks (rc3-6, AD-7 / AD-14 / AD-15).
+////
+//// Two signature-verified endpoints that HEAR back from the providers and feed
+//// delivery-failure signals into the reference lifecycle:
+////   - POST /webhooks/resend-events  — svix-verified email bounce/complaint/failure
+////   - POST /webhooks/twilio-sms     — X-Twilio-Signature-verified SMS failure
+//// Both move a live reference_call row to `awaiting_correction` (the state the
+//// landlord-driven correction flow in RC4.3 reads) + write an AD-16 audit row +
+//// an in-app `reference_awaiting_correction` notification (clarify Q3=B2:
+//// in-app only, no email).
+////
+//// Signature verification is load-bearing (AD-15): an unverified request changes
+//// NOTHING — no spoofed bounce can move a row. Idempotent (claim_webhook_event,
+//// NFR-RC5) and sticky (the guarded mark_awaiting_correction leaves terminal /
+//// already-awaiting rows untouched, AD-14). The webhooks never send anything
+//// (AD-14.4: the sweep owns every send).
+
+import audit/audit_log
+import audit/event_type
+import config.{type ServerConfig}
+import gleam/dynamic/decode
+import gleam/http/request
+import gleam/json
+import gleam/list
+import gleam/result
+import inbound_email/svix
+import notification/notification_dispatch
+import notification/sms_client
+import notification/twilio_webhook
+import pog
+import reference_checks/sql
+import response_helpers
+import sentry/sentry_client
+import shared/error_code
+import wisp.{type Request, type Response}
+import youid/uuid
+
+/// The two idempotency-source discriminators (processed_reference_webhook_event
+/// composite PK column). Exposed for tests.
+pub const source_resend = "resend"
+
+pub const source_twilio = "twilio"
+
+// ---------------------------------------------------------------------------
+// Resend webhook (email bounce / complaint / failure)
+// ---------------------------------------------------------------------------
+
+/// `POST /webhooks/resend-events` — svix-verified. Mirrors
+/// inbound_email/inbound_handler.handle_webhook: extract svix headers → read
+/// raw body → verify → process. An invalid/missing signature returns 401 with
+/// NO state change + a Sentry capture (AD-15, NFR-RC4).
+pub fn handle_resend_webhook(req: Request, config: ServerConfig) -> Response {
+  case svix.extract_headers(req) {
+    Error(reason) -> {
+      wisp.log_warning("resend-events webhook missing svix headers: " <> reason)
+      reject_unauthorized()
+    }
+    Ok(headers) -> {
+      use body <- wisp.require_string_body(req)
+      case
+        svix.verify_signature(
+          body,
+          headers.id,
+          headers.timestamp,
+          headers.signature,
+          config.resend_webhook_secret,
+        )
+      {
+        Error(_) -> {
+          wisp.log_warning(
+            "resend-events webhook signature verification failed",
+          )
+          sentry_client.capture(
+            config.sentry,
+            sentry_client.BackgroundEvent(
+              event_type: "ResendWebhookSignatureFailed",
+              message: "Svix signature verification failed on /webhooks/resend-events",
+              level: sentry_client.LevelWarning,
+              tags: [#("svix_id", headers.id)],
+            ),
+          )
+          reject_unauthorized()
+        }
+        Ok(_) -> {
+          // The svix message id is the idempotency key (svix re-delivers with
+          // the same id on retry). The body carries the event type + email_id.
+          process_resend_event(config.db, config.sentry, headers.id, body)
+          ack()
+        }
+      }
+    }
+  }
+}
+
+fn process_resend_event(
+  db: pog.Connection,
+  sentry: sentry_client.Sentry,
+  event_id: String,
+  body: String,
+) -> Nil {
+  case json.parse(body, resend_event_decoder()) {
+    Error(_) -> {
+      // A signature-verified body we can't decode means our decoder drifted
+      // from Resend's payload — capture it so we notice, but don't crash the
+      // webhook (200 ack; the provider won't retry-indefinitely).
+      capture(
+        sentry,
+        "ResendWebhookDecodeFailed",
+        "undecodable resend-events payload",
+        [#("svix_id", event_id)],
+      )
+      Nil
+    }
+    Ok(event) ->
+      case resend_terminal_reason(event.type_) {
+        "" -> Nil
+        reason -> {
+          let contact_email = list.first(event.to) |> result.unwrap("")
+          apply_delivery_failure(
+            db:,
+            sentry:,
+            source: source_resend,
+            event_id:,
+            send_ref: event.email_id,
+            contact_email:,
+            contact_phone: "",
+            terminal_reason: reason,
+          )
+        }
+      }
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Twilio webhook (SMS delivery failure)
+// ---------------------------------------------------------------------------
+
+/// `POST /webhooks/twilio-sms` — `X-Twilio-Signature`-verified. The signed URL
+/// is the StatusCallback URL sms_client configures (`status_callback_base_url`
+/// + the fixed `/webhooks/twilio-sms`). With Twilio `Disabled` (no auth_token),
+/// the signature cannot be verified → 403 (AD-15 forbids the unguarded path).
+pub fn handle_twilio_webhook(req: Request, config: ServerConfig) -> Response {
+  use form_data <- wisp.require_form(req)
+  let params = form_data.values
+  case config.twilio {
+    sms_client.Disabled -> {
+      wisp.log_warning("twilio-sms webhook received but Twilio is Disabled")
+      reject_forbidden()
+    }
+    sms_client.Enabled(cfg) -> {
+      let url = sms_client.status_callback_url(cfg.status_callback_base_url)
+      case request.get_header(req, "x-twilio-signature") {
+        Error(_) -> {
+          wisp.log_warning("twilio-sms webhook missing X-Twilio-Signature")
+          reject_forbidden()
+        }
+        Ok(provided) ->
+          case
+            twilio_webhook.verify_signature(
+              auth_token: cfg.auth_token,
+              url:,
+              params:,
+              provided_signature: provided,
+            )
+          {
+            Error(_) -> {
+              wisp.log_warning(
+                "twilio-sms webhook signature verification failed",
+              )
+              sentry_client.capture(
+                config.sentry,
+                sentry_client.BackgroundEvent(
+                  event_type: "TwilioWebhookSignatureFailed",
+                  message: "X-Twilio-Signature verification failed on /webhooks/twilio-sms",
+                  level: sentry_client.LevelWarning,
+                  tags: [],
+                ),
+              )
+              reject_forbidden()
+            }
+            Ok(_) -> {
+              process_twilio_event(config.db, config.sentry, params)
+              ack()
+            }
+          }
+      }
+    }
+  }
+}
+
+fn process_twilio_event(
+  db: pog.Connection,
+  sentry: sentry_client.Sentry,
+  params: List(#(String, String)),
+) -> Nil {
+  let message_sid =
+    twilio_webhook.param("MessageSid", params) |> result.unwrap("")
+  let status =
+    twilio_webhook.param("MessageStatus", params) |> result.unwrap("")
+  let to = twilio_webhook.param("To", params) |> result.unwrap("")
+  // Idempotency: MessageSid + status. Twilio re-sends the SAME status on retry;
+  // keying on sid+status means a NEW status for the same message is a fresh
+  // event (e.g. sent → failed are distinct).
+  let event_id = message_sid <> ":" <> status
+  case twilio_terminal_reason(status) {
+    "" -> Nil
+    reason ->
+      apply_delivery_failure(
+        db:,
+        sentry:,
+        source: source_twilio,
+        event_id:,
+        send_ref: message_sid,
+        contact_email: "",
+        contact_phone: to,
+        terminal_reason: reason,
+      )
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Shared pipeline: idempotency claim -> find row -> guarded transition ->
+// audit + in-app notification. Best-effort after the signature gate (a
+// processing error is Sentry-captured, never crashes the acked webhook).
+// ---------------------------------------------------------------------------
+
+fn apply_delivery_failure(
+  db db: pog.Connection,
+  sentry sentry: sentry_client.Sentry,
+  source source: String,
+  event_id event_id: String,
+  send_ref send_ref: String,
+  contact_email contact_email: String,
+  contact_phone contact_phone: String,
+  terminal_reason terminal_reason: String,
+) -> Nil {
+  // 1. Idempotency claim FIRST (a crash mid-handler never double-applies).
+  case sql.claim_webhook_event(db, event_id, source) {
+    Ok(pog.Returned(_, [_, ..])) -> Nil
+    Ok(_) -> {
+      // 0 rows = already processed (ON CONFLICT). Stand down.
+      wisp.log_info(
+        "reference webhook: duplicate event ignored ("
+        <> source
+        <> "/"
+        <> event_id
+        <> ")",
+      )
+      Nil
+    }
+    Error(err) -> {
+      capture(
+        sentry,
+        "ReferenceWebhookClaimFailed",
+        "claim_webhook_event failed: " <> query_error_to_string(err),
+        [#("source", source), #("event_id", event_id)],
+      )
+      Nil
+    }
+  }
+  // 2. Find the reference_call row this delivery-failure belongs to.
+  let send_ref_json =
+    json.to_string(
+      json.array(
+        [
+          json.object([
+            #("outcome", json.string("delivered")),
+            #("detail", json.string(send_ref)),
+          ]),
+        ],
+        fn(j) { j },
+      ),
+    )
+  case
+    sql.find_reference_call_by_send_ref(
+      db,
+      send_ref_json,
+      contact_email,
+      contact_phone,
+    )
+  {
+    Ok(pog.Returned(_, [row, ..])) ->
+      case uuid.from_string(row.id) {
+        Error(_) ->
+          capture(
+            sentry,
+            "ReferenceWebhookCorruptRowId",
+            "find_reference_call_by_send_ref returned a non-uuid id",
+            [#("id", row.id)],
+          )
+        Ok(reference_call_id) ->
+          // 3. Guarded transition (sticky + idempotent in one UPDATE).
+          case
+            sql.mark_awaiting_correction(db, reference_call_id, terminal_reason)
+          {
+            Ok(pog.Returned(_, [_, ..])) -> {
+              // 4. Real transition — write the AD-16 audit + the in-app
+              // notification. Both are best-effort (a failure here is
+              // captured but does not roll back the transition).
+              write_audit(
+                db,
+                sentry,
+                reference_call_id,
+                source,
+                terminal_reason,
+              )
+              case uuid.from_string(row.landlord_id) {
+                Ok(landlord_id) ->
+                  notification_dispatch.notify_reference_awaiting_correction(
+                    db,
+                    landlord_id,
+                    reference_call_id,
+                    row.contact_name,
+                    row.applicant_full_name,
+                  )
+                  |> ignore_result
+                Error(_) ->
+                  capture(
+                    sentry,
+                    "ReferenceWebhookCorruptLandlordId",
+                    "non-uuid landlord_id",
+                    [#("landlord_id", row.landlord_id)],
+                  )
+              }
+            }
+            _ ->
+              // 0 rows = the row was terminal / already awaiting_correction
+              // between find and mark (a concurrent writer). Sticky +
+              // idempotent — stand down, no audit/notification.
+              Nil
+          }
+      }
+    Ok(_) ->
+      // No live row for this contact / send-ref — an event for a contact not on
+      // any live reference_call (e.g. a co-nudge bounce for the applicant's own
+      // email, or an already-archived application). 200 no-op (rc3-2 doctrine).
+      Nil
+    Error(err) ->
+      capture(
+        sentry,
+        "ReferenceWebhookFindFailed",
+        "find_reference_call_by_send_ref failed: " <> query_error_to_string(err),
+        [#("source", source)],
+      )
+  }
+  Nil
+}
+
+fn write_audit(
+  db: pog.Connection,
+  sentry: sentry_client.Sentry,
+  reference_call_id: uuid.Uuid,
+  source: String,
+  terminal_reason: String,
+) -> Nil {
+  let details =
+    json.object([
+      #("source", json.string(source)),
+      #("terminal_reason", json.string(terminal_reason)),
+    ])
+  case
+    audit_log.create_system(
+      db,
+      event: event_type.ReferenceCallCorrectionRequested,
+      entity_type: "reference_call",
+      entity_id: reference_call_id,
+      details:,
+    )
+  {
+    Ok(_) -> Nil
+    Error(err) ->
+      capture(
+        sentry,
+        "ReferenceWebhookAuditFailed",
+        "audit_log.create_system failed: " <> query_error_to_string(err),
+        [],
+      )
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Event classification + decoders
+// ---------------------------------------------------------------------------
+
+/// Map a Resend event type to the terminal_reason slug, or "" if the event is
+/// not actionable (delivered / opened / clicked / delivery_delayed / sent / …).
+/// `delivery_delayed` is deliberately NOT actionable (transient — Resend
+/// retries; not a bad-contact signal). `suppressed` is not a delivery failure.
+pub fn resend_terminal_reason(type_: String) -> String {
+  case type_ {
+    "email.bounced" -> "email_bounced"
+    "email.complained" -> "email_complaint"
+    "email.failed" -> "email_failed"
+    _ -> ""
+  }
+}
+
+/// Map a Twilio MessageStatus to the terminal_reason slug, or "" if not a
+/// delivery failure (queued / sent / delivered / sending / received / …).
+pub fn twilio_terminal_reason(status: String) -> String {
+  case status {
+    "failed" -> "sms_failed"
+    "undelivered" -> "sms_undelivered"
+    _ -> ""
+  }
+}
+
+type ResendEvent {
+  ResendEvent(type_: String, email_id: String, to: List(String))
+}
+
+/// Decode the Resend webhook payload: top-level `type` + a `data` object with
+/// `email_id` (the send id the sweep stored in attempts) and `to` (recipient
+/// array — the contact fallback). Inner fields are optional_field-lenient so a
+/// payload variant that omits one (e.g. email.failed with no email_id when the
+/// send never created a message) does not fail the whole decode.
+fn resend_event_decoder() -> decode.Decoder(ResendEvent) {
+  use type_ <- decode.field("type", decode.string)
+  use data <- decode.field("data", resend_data_decoder())
+  decode.success(ResendEvent(type_:, email_id: data.email_id, to: data.to))
+}
+
+fn resend_data_decoder() -> decode.Decoder(ResendData) {
+  use email_id <- decode.optional_field("email_id", "", decode.string)
+  use to <- decode.optional_field("to", [], decode.list(decode.string))
+  decode.success(ResendData(email_id:, to:))
+}
+
+type ResendData {
+  ResendData(email_id: String, to: List(String))
+}
+
+// ---------------------------------------------------------------------------
+// Response + error helpers
+// ---------------------------------------------------------------------------
+
+/// 200 ack — both providers expect a 2xx or they retry.
+fn ack() -> Response {
+  wisp.json_response("{\"ok\":true}", 200)
+}
+
+fn reject_unauthorized() -> Response {
+  response_helpers.json_error(error_code.Unauthorized, "Invalid signature", 401)
+}
+
+fn reject_forbidden() -> Response {
+  response_helpers.json_error(error_code.Forbidden, "Invalid signature", 403)
+}
+
+fn ignore_result(_r: Result(a, b)) -> Nil {
+  Nil
+}
+
+fn capture(
+  sentry: sentry_client.Sentry,
+  event_type_: String,
+  message: String,
+  tags: List(#(String, String)),
+) -> Nil {
+  sentry_client.capture(
+    sentry,
+    sentry_client.BackgroundEvent(
+      event_type: event_type_,
+      message:,
+      level: sentry_client.LevelError,
+      tags:,
+    ),
+  )
+  Nil
+}
+
+/// Stringify a pog.QueryError for Sentry/logging (mirrors
+/// notification_dispatch.debug_query_error — local copy because that one is
+/// private).
+fn query_error_to_string(err: pog.QueryError) -> String {
+  case err {
+    pog.PostgresqlError(code, name, message) ->
+      "PostgreSQL " <> code <> " (" <> name <> "): " <> message
+    pog.ConnectionUnavailable -> "Connection unavailable"
+    pog.QueryTimeout -> "Query timeout"
+    _ -> "Unknown query error"
+  }
+}
