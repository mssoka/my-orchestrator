+//// Unit tests for the reference-check delivery-webhook event classifiers
+//// (rc3-6). Pure — no DB. Defends AC1/AC2 (which events trigger the correction
+//// path) and the deliberate exclusions (delivery_delayed is transient, not a
+//// bad-contact signal; delivered/opened are no-ops).
+
+import gleeunit/should
+import reference_checks/webhooks
+
+pub fn resend_bounced_is_actionable_test() {
+  webhooks.resend_terminal_reason("email.bounced")
+  |> should.equal("email_bounced")
+}
+
+pub fn resend_complained_is_actionable_test() {
+  webhooks.resend_terminal_reason("email.complained")
+  |> should.equal("email_complaint")
+}
+
+pub fn resend_failed_is_actionable_test() {
+  webhooks.resend_terminal_reason("email.failed")
+  |> should.equal("email_failed")
+}
+
+pub fn resend_delivery_delayed_is_not_actionable_test() {
+  // Transient — Resend retries; not a bad-contact signal (AD-7).
+  webhooks.resend_terminal_reason("email.delivery_delayed")
+  |> should.equal("")
+}
+
+pub fn resend_delivered_is_not_actionable_test() {
+  webhooks.resend_terminal_reason("email.delivered")
+  |> should.equal("")
+}
+
+pub fn resend_opened_is_not_actionable_test() {
+  webhooks.resend_terminal_reason("email.opened")
+  |> should.equal("")
+}
+
+pub fn resend_unknown_event_is_not_actionable_test() {
+  webhooks.resend_terminal_reason("email.sent")
+  |> should.equal("")
+}
+
+pub fn twilio_failed_is_actionable_test() {
+  webhooks.twilio_terminal_reason("failed")
+  |> should.equal("sms_failed")
+}
+
+pub fn twilio_undelivered_is_actionable_test() {
+  webhooks.twilio_terminal_reason("undelivered")
+  |> should.equal("sms_undelivered")
+}
+
+pub fn twilio_delivered_is_not_actionable_test() {
+  webhooks.twilio_terminal_reason("delivered")
+  |> should.equal("")
+}
+
+pub fn twilio_sent_is_not_actionable_test() {
+  webhooks.twilio_terminal_reason("sent")
+  |> should.equal("")
+}
+
+pub fn idempotency_source_constants_test() {
+  // The composite-PK discriminators (processed_reference_webhook_event).
+  webhooks.source_resend
+  |> should.equal("resend")
+  webhooks.source_twilio
+  |> should.equal("twilio")
+}
diff --git a/supabase/migrations/20260812060000_create_processed_reference_webhook_event.sql b/supabase/migrations/20260812060000_create_processed_reference_webhook_event.sql
new file mode 100644
index 00000000..bb1e75f4
--- /dev/null
+++ b/supabase/migrations/20260812060000_create_processed_reference_webhook_event.sql
@@ -0,0 +1,16 @@
+-- RC3.6: idempotency for the reference-check delivery webhooks (Resend + Twilio).
+-- Mirrors processed_stripe_event (20260509024546): a claimed (source, event_id)
+-- means the event was processed; a re-delivery hits ON CONFLICT DO NOTHING and
+-- claim_webhook_event returns 0 rows (the handler stands down, NFR-RC5 / AD-14
+-- exactly-once). (source, event_id) composite PK: a Resend event id and a
+-- Twilio MessageSid could theoretically collide; the source discriminator makes
+-- it safe.
+CREATE TABLE IF NOT EXISTS processed_reference_webhook_event (
+  source      TEXT NOT NULL CHECK (source IN ('resend', 'twilio')),
+  event_id    TEXT NOT NULL,
+  created_at  TIMESTAMPTZ NOT NULL DEFAULT now(),
+  PRIMARY KEY (source, event_id)
+);
+
+CREATE INDEX IF NOT EXISTS processed_reference_webhook_event_created_at_idx
+  ON processed_reference_webhook_event (created_at);
diff --git a/supabase/migrations/20260812060001_add_reference_awaiting_correction_notification_type.sql b/supabase/migrations/20260812060001_add_reference_awaiting_correction_notification_type.sql
new file mode 100644
index 00000000..41d4cad3
--- /dev/null
+++ b/supabase/migrations/20260812060001_add_reference_awaiting_correction_notification_type.sql
@@ -0,0 +1,10 @@
