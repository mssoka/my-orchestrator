index 00000000..6ec0335e
--- /dev/null
+++ b/server/src/notification/twilio_webhook.gleam
@@ -0,0 +1,69 @@
+//// Twilio webhook signature verification (rc3-6, AD-15).
+////
+//// Verifies the `X-Twilio-Signature` header on the `webhooks/twilio-sms`
+//// delivery-status callback. The signature is HMAC-SHA256(auth_token,
+//// url + sorted-params) base64-encoded — DIFFERENT from svix (which signs the
+//// raw body). The signed URL is the exact StatusCallback URL sms_client
+//// configures when sending (`status_callback_base_url` + the fixed
+//// `status_callback_path`); the params are the POST form values, sorted by key
+//// and concatenated as `keyvalue` pairs (no delimiters), per Twilio's spec:
+//// https://www.twilio.com/docs/usage/webhooks/webhooks-security
+////
+//// An unverified webhook is a state-mutation path guarded by nothing — it must
+//// change NOTHING (AD-15). Constant-time compare via `crypto.secure_compare`.
+//// Pure (no IO) so the algorithm is unit-testable with a reference vector; the
+//// handler extracts `auth_token` + `url` + params from the request + config.
+
+import gleam/bit_array
+import gleam/crypto
+import gleam/list
+import gleam/string
+
+/// Verify a Twilio `X-Twilio-Signature` against the recomputed HMAC.
+///
+/// `url` is the exact URL Twilio called back (the StatusCallback URL sms_client
+/// sent). `params` are the POST form values (decoded). `provided_signature` is
+/// the raw `X-Twilio-Signature` header value (base64). Returns `Ok(Nil)` on a
+/// match, `Error(Nil)` otherwise — the caller rejects + Sentry-captures on Error.
+///
+/// Exposed (pub) so the handler + unit tests call it directly.
+pub fn verify_signature(
+  auth_token auth_token: String,
+  url url: String,
+  params params: List(#(String, String)),
+  provided_signature provided_signature: String,
+) -> Result(Nil, Nil) {
+  let signed_payload = build_signed_payload(url, params)
+  let computed =
+    crypto.hmac(<<signed_payload:utf8>>, crypto.Sha256, <<auth_token:utf8>>)
+    |> bit_array.base64_encode(True)
+  case crypto.secure_compare(<<computed:utf8>>, <<provided_signature:utf8>>) {
+    True -> Ok(Nil)
+    False -> Error(Nil)
+  }
+}
+
+/// Build the string Twilio signs: the URL followed by every form param as
+/// `key` + `value`, with params sorted by key in ascending ASCII order. Pure so
+/// the ordering is unit-testable independent of the HMAC.
+pub fn build_signed_payload(
+  url url: String,
+  params params: List(#(String, String)),
+) -> String {
+  let sorted = list.sort(params, by: fn(a, b) { string.compare(a.0, b.0) })
+  let concat = list.fold(sorted, "", fn(acc, pair) { acc <> pair.0 <> pair.1 })
+  url <> concat
+}
+
+/// Look up a single value in a form-param list (first match wins). Returns
+/// `Ok(value)` or `Error(Nil)`. The handler uses this to pull `MessageSid`,
+/// `MessageStatus`, `To` from the verified params.
+pub fn param(
+  key key: String,
+  params params: List(#(String, String)),
+) -> Result(String, Nil) {
+  case list.find(params, fn(p) { p.0 == key }) {
+    Ok(pair) -> Ok(pair.1)
+    Error(Nil) -> Error(Nil)
+  }
+}
