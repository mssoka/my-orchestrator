+pub fn draft_erasure_confirms_then_deletes_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let code = vacancy_short_code(db, vacancy_id)
+  let token = seed_draft_with_token(db, vacancy_id, "tok-erase")
+
+  // GET renders the confirm page (prefetch-safe)…
+  let get_req =
+    simulate.request(http.Get, "/apply/" <> code <> "/draft-erasure/" <> token)
+  let confirm =
+    draft_handler.handle_erasure_confirm(
+      get_req,
+      test_server_config(db),
+      code,
+      token,
+    )
+  confirm.status |> should.equal(200)
+  simulate.read_body(confirm)
+  |> string.contains("draft-erasure-confirm-form")
+  |> should.be_true
+  draft_count(db) |> should.equal(1)
+
+  // …POST tombstones the draft (fields/token wiped, suppression key kept)…
+  let post_req =
+    simulate.request(http.Post, "/apply/" <> code <> "/draft-erasure/" <> token)
+  let deleted =
+    draft_handler.handle_erasure_delete(
+      post_req,
+      test_server_config(db),
+      code,
+      token,
+    )
+  deleted.status |> should.equal(200)
+  simulate.read_body(deleted)
+  |> string.contains("draft-erasure-success-message")
+  |> should.be_true
+  // Tombstone, not a hard delete: the row stays as the suppression record.
+  draft_count(db) |> should.equal(1)
+  draft_field(db, vacancy_id, "fields") |> should.equal("{}")
+  draft_field(db, vacancy_id, "continue_token") |> should.equal("")
+  draft_field(db, vacancy_id, "erased_at") |> should.not_equal("")
+  draft_field(db, vacancy_id, "email") |> should.equal("tenant@example.com")
+
+  // …and a replayed POST is the uniform 404 (token is gone).
+  let replay =
+    draft_handler.handle_erasure_delete(
+      post_req,
+      test_server_config(db),
+      code,
+      token,
+    )
+  replay.status |> should.equal(404)
+}
