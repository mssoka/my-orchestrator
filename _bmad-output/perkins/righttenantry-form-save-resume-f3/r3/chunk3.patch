diff --git a/server/test/integration/draft_integration_test.gleam b/server/test/integration/draft_integration_test.gleam
new file mode 100644
index 00000000..4d27b9be
--- /dev/null
+++ b/server/test/integration/draft_integration_test.gleam
@@ -0,0 +1,937 @@
+//// F3 save-and-resume integration tests — draft round-trip (save → token →
+//// resume), token scoping + uniformity, the 10-minute continue-link
+//// cooldown, strip-on-submit, self-service erasure, vacancy-close expiry
+//// (retention phase), and the vacancy FK cascade.
+
+import application/application_handler
+import application/draft_handler
+import application/form_view
+import application/sql as app_sql
+import gleam/http
+import gleam/int
+import gleam/json
+import gleam/list
+import gleam/result
+import gleam/string
+import gleeunit/should
+import integration/helpers.{setup, test_server_config}
+import integration/test_db
+import pog
+import retention/retention_job
+import sentry/sentry_client
+import test_helpers
+import unitest
+import wisp/simulate
+import youid/uuid
+
+// ============================================================================
+// Helpers
+// ============================================================================
+
+fn vacancy_short_code(db: pog.Connection, vacancy_id: String) -> String {
+  test_db.query_text(
+    db,
+    "SELECT short_code FROM vacancy WHERE id = '" <> vacancy_id <> "'::uuid",
+  )
+  |> result.unwrap("")
+}
+
+fn draft_field(db: pog.Connection, vacancy_id: String, column: String) -> String {
+  test_db.query_text(
+    db,
+    "SELECT COALESCE(" <> column <> "::text, '') FROM application_draft
+     WHERE vacancy_id = '" <> vacancy_id <> "'::uuid",
+  )
+  |> result.unwrap("")
+}
+
+fn draft_count(db: pog.Connection) -> Int {
+  test_db.query_int(db, "SELECT count(*)::int FROM application_draft")
+  |> result.unwrap(-1)
+}
+
+fn save_body() -> json.Json {
+  json.object([
+    #("email", json.string("Tenant@Example.com")),
+    #(
+      "fields",
+      json.object([
+        #("first_name", json.string("Ada")),
+        #("last_name", json.string("Byrne")),
+        #("email", json.string("Tenant@Example.com")),
+        #("_website", json.string("bot-bait")),
+        #("_form_loaded_at", json.string("123")),
+        #("gdpr_consent", json.string("on")),
+      ]),
+    ),
+  ])
+}
+
+fn save_draft(db: pog.Connection, code: String) {
+  let req =
+    simulate.request(http.Put, "/apply/" <> code <> "/draft")
+    |> simulate.json_body(save_body())
+  draft_handler.handle_save_draft(req, test_server_config(db), code)
+}
+
+/// Mint a draft + continue token straight through the SQL layer (bypasses
+/// the cooldown so tests can claim freely).
+fn seed_draft_with_token(
+  db: pog.Connection,
+  vacancy_id: String,
+  token: String,
+) -> String {
+  let assert Ok(uuid) = uuid.from_string(vacancy_id)
+  let assert Ok(_) =
+    app_sql.upsert_application_draft(
+      db,
+      uuid,
+      "tenant@example.com",
+      json.object([#("first_name", json.string("Ada"))]),
+      "tok-seed",
+    )
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE application_draft SET continue_token = $1
+       WHERE vacancy_id = $2::uuid",
+    )
+    |> pog.parameter(pog.text(token))
+    |> pog.parameter(pog.text(vacancy_id))
+    |> pog.execute(db)
+  token
+}
+
+// ============================================================================
+// Save (PUT/POST /apply/:code/draft)
+// ============================================================================
+
+pub fn save_draft_persists_filtered_fields_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let code = vacancy_short_code(db, vacancy_id)
+
+  let resp = save_draft(db, code)
+  resp.status |> should.equal(200)
+
+  // Row exists, email lowercased by the writer…
+  draft_count(db) |> should.equal(1)
+  draft_field(db, vacancy_id, "email") |> should.equal("tenant@example.com")
+  // …internals and consent stripped server-side…
+  let fields = draft_field(db, vacancy_id, "fields")
+  fields |> string.contains("first_name") |> should.be_true
+  fields |> string.contains("_website") |> should.be_false
+  fields |> string.contains("_form_loaded_at") |> should.be_false
+  fields |> string.contains("gdpr_consent") |> should.be_false
+  // …and no file content could ever land here (schema has no such column).
+}
+
+pub fn save_draft_rejects_invalid_email_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let code = vacancy_short_code(db, vacancy_id)
+
+  let req =
+    simulate.request(http.Put, "/apply/" <> code <> "/draft")
+    |> simulate.json_body(
+      json.object([
+        #("email", json.string("not-an-email")),
+        #("fields", json.object([#("first_name", json.string("Ada"))])),
+      ]),
+    )
+  draft_handler.handle_save_draft(req, test_server_config(db), code).status
+  |> should.equal(400)
+  draft_count(db) |> should.equal(0)
+}
+
+pub fn save_draft_on_closed_vacancy_refuses_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_closed_vacancy(db, landlord_id)
+  let code = vacancy_short_code(db, vacancy_id)
+
+  let resp = save_draft(db, code)
+  resp.status |> should.equal(200)
+  simulate.read_body(resp)
+  |> string.contains("\"closed\":true")
+  |> should.be_true
+  draft_count(db) |> should.equal(0)
+}
+
+// ============================================================================
+// Continue-link (POST /apply/:code/continue-link) — cooldown + no-leak
+// The Resend send itself is exercised by manual E2E, not here (the empty
+// test key would make a real api.resend.com call — same precedent as the
+// resend-confirmation tests).
+// ============================================================================
+
+pub fn claim_continue_link_send_mints_once_then_cools_down_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let _ = seed_draft_with_token(db, vacancy_id, "tok-seeded")
+  let assert Ok(uuid) = uuid.from_string(vacancy_id)
+
+  // Existing token is kept (previously emailed links keep working)…
+  let assert Ok(kept) =
+    app_sql.claim_continue_link_send(db, uuid, "tenant@example.com", "tok-new")
+  kept.rows |> list.length |> should.equal(1)
+  draft_field(db, vacancy_id, "continue_token") |> should.equal("tok-seeded")
+  draft_field(db, vacancy_id, "last_link_sent_at") |> should.not_equal("")
+
+  // …and an immediate re-claim is the cooldown's empty result.
+  let assert Ok(cooled) =
+    app_sql.claim_continue_link_send(db, uuid, "tenant@example.com", "tok-2")
+  cooled.rows |> list.length |> should.equal(0)
+}
+
+pub fn upsert_mints_the_token_at_save_time_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let assert Ok(uuid) = uuid.from_string(vacancy_id)
+  // W1: tokens mint at SAVE time, so every live draft — including the
+  // debounced auto-save cohort — is reachable by the stage-2 reminder's
+  // continue-link, not just explicit "email me a link" clicks.
+  let assert Ok(_) =
+    app_sql.upsert_application_draft(
+      db,
+      uuid,
+      "tenant@example.com",
+      json.object([#("first_name", json.string("Ada"))]),
+      "tok-minted",
+    )
+  draft_field(db, vacancy_id, "continue_token")
+  |> should.equal("tok-minted")
+
+  // A re-save keeps the minted token (previously emailed links keep
+  // working) — the candidate is only a fallback.
+  let assert Ok(_) =
+    app_sql.upsert_application_draft(
+      db,
+      uuid,
+      "tenant@example.com",
+      json.object([#("first_name", json.string("Adaeze"))]),
+      "tok-other",
+    )
+  draft_field(db, vacancy_id, "continue_token")
+  |> should.equal("tok-minted")
+  draft_field(db, vacancy_id, "fields")
+  |> string.contains("Adaeze")
+  |> should.be_true
+}
+
+pub fn clear_last_link_sent_re_arms_the_claim_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let _ = seed_draft_with_token(db, vacancy_id, "tok-clear")
+  let assert Ok(uuid) = uuid.from_string(vacancy_id)
+
+  // Claim → cooldown active → clear (the send-failure path) → re-claim wins.
+  let assert Ok(_) =
+    app_sql.claim_continue_link_send(db, uuid, "tenant@example.com", "tok-x")
+  let assert Ok(cleared) =
+    app_sql.clear_last_link_sent(db, uuid, "tenant@example.com")
+  cleared.rows |> list.length |> should.equal(1)
+  draft_field(db, vacancy_id, "last_link_sent_at") |> should.equal("")
+  let assert Ok(reclaimed) =
+    app_sql.claim_continue_link_send(db, uuid, "tenant@example.com", "tok-y")
+  reclaimed.rows |> list.length |> should.equal(1)
+}
+
+pub fn continue_link_on_cooldown_answers_uniform_200_without_send_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let code = vacancy_short_code(db, vacancy_id)
+  let _ = seed_draft_with_token(db, vacancy_id, "tok-cool")
+  // Pre-stamp the cooldown so the claim returns no row — the handler must
+  // answer a bare ok:true WITHOUT attempting a send, and the body must not
+  // carry any send/cooldown state (N14: a `sent` flag oracles the victim's
+  // draft state to an empty-fields poller).
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE application_draft SET last_link_sent_at = now()
+       WHERE vacancy_id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(vacancy_id))
+    |> pog.execute(db)
+
+  let resp =
+    simulate.request(http.Post, "/apply/" <> code <> "/continue-link")
+    |> simulate.json_body(save_body())
+    |> fn(req) {
+      draft_handler.handle_continue_link(req, test_server_config(db), code)
+    }
+  resp.status |> should.equal(200)
+  let body = simulate.read_body(resp)
+  body |> string.contains("\"ok\":true") |> should.be_true
+  body |> string.contains("sent") |> should.be_false
+  // The upsert half still ran — fields are fresh even when no email goes.
+  draft_field(db, vacancy_id, "fields")
+  |> string.contains("Byrne")
+  |> should.be_true
+}
+
+// ============================================================================
+// Resume (GET /apply/:code/resume/:token)
+// ============================================================================
+
+pub fn resume_restores_draft_without_stamping_get_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let code = vacancy_short_code(db, vacancy_id)
+  let token = seed_draft_with_token(db, vacancy_id, "tok-resume-1")
+
+  let req = simulate.request(http.Get, "/apply/" <> code <> "/resume/" <> token)
+  let resp =
+    draft_handler.handle_resume(req, test_server_config(db), code, token)
+  resp.status |> should.equal(200)
+  let body = simulate.read_body(resp)
+  body
+  |> string.contains("data-apply-page=\"form-resume\"")
+  |> should.be_true
+  body |> string.contains("draft-resume-banner") |> should.be_true
+  // Restored value threaded into the SSR form…
+  body |> string.contains("value=\"Ada\"") |> should.be_true
+  // …the analytics event contract rides along…
+  body |> string.contains("form_draft.js") |> should.be_true
+  // …and the page carries the token for the re-engagement stamp.
+  body
+  |> string.contains("data-resume-token=\"" <> token <> "\"")
+  |> should.be_true
+
+  // The GET itself must NOT stamp resumed_at (mail-scanner prefetch guard).
+  draft_field(db, vacancy_id, "resumed_at") |> should.equal("")
+}
+
+pub fn first_post_resume_save_stamps_resumed_at_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let code = vacancy_short_code(db, vacancy_id)
+  let token = seed_draft_with_token(db, vacancy_id, "tok-engage")
+
+  // A save carrying the resume token (what form_draft.js sends from the
+  // resume render) stamps resumed_at…
+  let req =
+    simulate.request(http.Post, "/apply/" <> code <> "/draft")
+    |> simulate.json_body(
+      json.object([
+        #("email", json.string("tenant@example.com")),
+        #("resume_token", json.string(token)),
+        #("fields", json.object([#("first_name", json.string("Adaeze"))])),
+      ]),
+    )
+  draft_handler.handle_save_draft(req, test_server_config(db), code).status
+  |> should.equal(200)
+  draft_field(db, vacancy_id, "resumed_at") |> should.not_equal("")
+
+  // …and a token from ANOTHER vacancy's draft stamps nothing here.
+  let assert Ok(other_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let other_code = vacancy_short_code(db, other_id)
+  let _ = seed_draft_with_token(db, other_id, "tok-other")
+  let forged =
+    simulate.request(http.Post, "/apply/" <> other_code <> "/draft")
+    |> simulate.json_body(
+      json.object([
+        #("email", json.string("tenant@example.com")),
+        #("resume_token", json.string("tok-engage")),
+        #("fields", json.object([#("first_name", json.string("X"))])),
+      ]),
+    )
+  draft_handler.handle_save_draft(forged, test_server_config(db), other_code).status
+  |> should.equal(200)
+  draft_field(db, other_id, "resumed_at") |> should.equal("")
+}
