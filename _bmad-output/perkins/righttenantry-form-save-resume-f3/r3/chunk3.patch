diff --git a/server/test/application/draft_handler_test.gleam b/server/test/application/draft_handler_test.gleam
new file mode 100644
index 00000000..909017ff
--- /dev/null
+++ b/server/test/application/draft_handler_test.gleam
@@ -0,0 +1,68 @@
+//// Unit tests for the F3 draft field filter — the server-side half of the
+//// "what may never persist in a draft" contract (the JS serializer is the
+//// client half; both are pinned).
+
+import application/draft_handler
+import gleam/dict
+import gleam/int
+import gleam/list
+import gleam/string
+import gleeunit/should
+
+pub fn filter_fields_drops_internal_and_consent_keys_test() {
+  let fields =
+    dict.from_list([
+      #("first_name", "Ada"),
+      #("_website", "bot-bait"),
+      #("_form_loaded_at", "123456"),
+      #("gdpr_consent", "on"),
+    ])
+  draft_handler.filter_fields(fields)
+  |> should.equal([#("first_name", "Ada")])
+}
+
+pub fn filter_fields_drops_upload_slot_keys_even_as_scalars_test() {
+  // W10: the "no documents in drafts" rule is a NAME-level guarantee too —
+  // a hand-crafted payload with a file slot's name (the serializer skips
+  // type=file controls client-side) must not park a string under a
+  // document slot's identity.
+  let fields =
+    dict.from_list([
+      #("landlord_ref_primary", "data:application/pdf;base64,xx"),
+      #("employer_ref_coapplicant_1", "fake"),
+      #("proof_of_income_coapplicant_0", "fake"),
+      #("additional_docs", "fake"),
+      #("landlord_reference_name", "Jane"),
+    ])
+  draft_handler.filter_fields(fields)
+  |> should.equal([#("landlord_reference_name", "Jane")])
+}
+
+pub fn filter_fields_caps_key_count_and_length_test() {
+  let long_key = string.repeat("k", 65)
+  let fields =
+    dict.from_list([#(long_key, "v"), #("ok", "v"), #("", "empty-key")])
+  draft_handler.filter_fields(fields)
+  |> should.equal([#("ok", "v")])
+}
+
+pub fn filter_fields_caps_entries_at_120_test() {
+  let fields =
+    int.range(1, 200, [], fn(acc, i) { [#("field_" <> pad(i), "v"), ..acc] })
+    |> dict.from_list
+  draft_handler.filter_fields(fields)
+  |> list.length
+  |> should.equal(120)
+}
+
+fn pad(i: Int) -> String {
+  let s = int.to_string(i)
+  string.repeat("0", 3 - string.length(s)) <> s
+}
+
+pub fn filter_fields_truncates_oversize_values_test() {
+  let fields =
+    dict.from_list([#("personal_statement", string.repeat("x", 5000))])
+  draft_handler.filter_fields(fields)
+  |> should.equal([#("personal_statement", string.repeat("x", 4000))])
+}
