+// ============================================================================
+// W6 — cross-vacancy fan-out bound (3 continue emails / recipient / hour)
+pub fn fan_out_bound_end_to_end_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  // Seed one draft per vacancy for the same victim, then stamp three sends.
+  let assert Ok(vacancies) = seed_n_vacancies(db, landlord_id, 4)
+  list.each(vacancies, fn(v) {
+    let assert Ok(u) = uuid.from_string(v)
+    let assert Ok(_) =
+      app_sql.upsert_application_draft(
+        db,
+        u,
+        "victim@example.com",
+        json.object([#("first_name", json.string("V"))]),
+        "tok-" <> v,
+      )
+  })
+  let claim = fn(v) {
+    let assert Ok(u) = uuid.from_string(v)
+    let assert Ok(returned) =
+      app_sql.claim_continue_link_send(db, u, "victim@example.com", "tx")
+    list.length(returned.rows)
+  }
+  // Sends 1–3 win; send 4 hits the cross-vacancy hourly bound.
+  let assert [v1, v2, v3, v4] = vacancies
+  claim(v1) |> should.equal(1)
+  claim(v2) |> should.equal(1)
+  claim(v3) |> should.equal(1)
+  claim(v4) |> should.equal(0)
+}
+
+fn seed_n_vacancies(
+  db: pog.Connection,
+  landlord_id: String,
+  n: Int,
+) -> Result(List(String), String) {
+  case n {
+    0 -> Ok([])
+    _ ->
+      case test_db.seed_vacancy(db, landlord_id, True) {
+        Error(e) -> Error(e)
+        Ok(v) ->
+          case seed_n_vacancies(db, landlord_id, n - 1) {
+            Error(e) -> Error(e)
+            Ok(rest) -> Ok([v, ..rest])
+          }
+      }
+  }
+}
