+  |> string.contains("draft-erasure-success-message")
+  |> should.be_true
+  draft_count(db) |> should.equal(0)
+
+  // …and a replayed POST is the uniform 404.
+  let replay =
+    draft_handler.handle_erasure_delete(
+      post_req,
+      test_server_config(db),
+      code,
+      token,
+    )
+  replay.status |> should.equal(404)
