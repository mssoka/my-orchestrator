+/// A row you get from running the `claim_continue_link_send` query
+/// defined in `./src/application/sql/claim_continue_link_send.sql`.
+///
+/// > 🐿️ This type definition was generated automatically using v4.6.0 of the
+/// > [squirrel package](https://github.com/giacomocavalieri/squirrel).
+///
+pub type ClaimContinueLinkSendRow {
+  ClaimContinueLinkSendRow(continue_token: String)
+}
+
+/// - claim_continue_link_send(vacancy_id: UUID, email: String, token: String)
+/// Atomically claim a continue-link send: mints the token lazily (keeping an
+/// existing one so previously emailed links keep working) and stamps the
+/// 10-minute resend cooldown in the same UPDATE, so concurrent clicks can't
+/// double-send. Zero rows returned = on cooldown, already submitted, or no
+/// draft for (vacancy, email) — the handler answers 200 without sending.
+///
+/// > 🐿️ This function was generated automatically using v4.6.0 of
+/// > the [squirrel package](https://github.com/giacomocavalieri/squirrel).
+///
+pub fn claim_continue_link_send(
+  db: pog.Connection,
+  arg_1: Uuid,
+  arg_2: String,
+  arg_3: String,
+) -> Result(pog.Returned(ClaimContinueLinkSendRow), pog.QueryError) {
+  let decoder = {
+    use continue_token <- decode.field(0, decode.string)
+    decode.success(ClaimContinueLinkSendRow(continue_token:))
+  }
+
+  "--- claim_continue_link_send(vacancy_id: UUID, email: String, token: String)
+-- Atomically claim a continue-link send: mints the token lazily (keeping an
+-- existing one so previously emailed links keep working) and stamps the
+-- 10-minute resend cooldown in the same UPDATE, so concurrent clicks can't
+-- double-send. Zero rows returned = on cooldown, already submitted, or no
+-- draft for (vacancy, email) — the handler answers 200 without sending.
+UPDATE application_draft
+SET continue_token = COALESCE(continue_token, $3),
+    last_link_sent_at = now(),
+    updated_at = now()
+WHERE vacancy_id = $1::uuid
+  AND email = lower($2)
+  AND submitted_at IS NULL
+  AND (
+    last_link_sent_at IS NULL
+    OR last_link_sent_at < now() - interval '10 minutes'
+  )
+RETURNING COALESCE(continue_token, '') AS continue_token;
+"
+  |> pog.query
+  |> pog.parameter(pog.text(uuid.to_string(arg_1)))
+  |> pog.parameter(pog.text(arg_2))
+  |> pog.parameter(pog.text(arg_3))
+  |> pog.returning(decoder)
+  |> pog.execute(db)
+}
