+/// > 🐿️ This function was generated automatically using v4.6.0 of
+/// > the [squirrel package](https://github.com/giacomocavalieri/squirrel).
+///
+pub fn delete_expired_application_drafts(
+  db: pog.Connection,
+) -> Result(pog.Returned(DeleteExpiredApplicationDraftsRow), pog.QueryError) {
+  let decoder = {
+    use id <- decode.field(0, decode.string)
+    decode.success(DeleteExpiredApplicationDraftsRow(id:))
+  }
+
+  "--- delete_expired_application_drafts()
+-- F3 draft expiry: drafts die at vacancy close (manual status='closed' or
+-- closes_at in the past — the latter also catches the daily lifecycle
+-- auto-close window) or at archive (an archived vacancy stops accepting via
+-- is_accepting_applications, so its drafts are unreachable dead PII). Runs
+-- inside the retention job's per-phase fail-open pattern.
+DELETE FROM application_draft d
+USING vacancy v
+WHERE d.vacancy_id = v.id
+  AND (
+    v.status = 'closed'
+    OR v.archived_at IS NOT NULL
+    OR (v.closes_at IS NOT NULL AND v.closes_at <= now())
+  )
+RETURNING d.id::text;
