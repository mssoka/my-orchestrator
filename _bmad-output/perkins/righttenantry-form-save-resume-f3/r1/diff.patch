+// Unit tests for server/priv/static/form_draft.js — run with
+// `node --test scripts/js-tests/*.test.js` (wired into `make test` as test-js).
+//
+// Pins the F3 draft contract: what may NEVER leave the page (files, the
+// consent checkbox, _-prefixed internals), the serializer's value semantics
+// (radios/checkboxes/email), the activation gate, and the debounce that
+// stands between the stepper's step-changed event and the "no per-keystroke
+// writes" rule. The browser choreography (fetch, beacon, button injection)
+// is covered E2E by the canonical bug-hunt scenario for save-and-resume.
+
+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+
+const draft = require("../../server/priv/static/form_draft.js");
+
+// ---------- Control factories ----------
+
+function ctl(overrides = {}) {
+  return {
+    name: "first_name",
+    type: "text",
+    value: "Moses",
+    disabled: false,
+    checked: false,
+    ...overrides,
+  };
+}
+
+function formOf(controls) {
+  return { elements: controls };
+}
+
+// ---------- Activation ----------
+
+test("shouldActivate covers pristine, resume, and error renders only", () => {
+  assert.equal(draft.shouldActivate("form"), true);
+  assert.equal(draft.shouldActivate("form-resume"), true);
+  assert.equal(draft.shouldActivate("form-errors"), true);
+  assert.equal(draft.shouldActivate("confirmation"), false);
+  assert.equal(draft.shouldActivate("duplicate"), false);
+  assert.equal(draft.shouldActivate(null), false);
+});
+
+// ---------- Email plausibility ----------
+
+test("validEmail accepts ordinary addresses, trims whitespace", () => {
+  assert.equal(draft.validEmail("tenant@example.com"), true);
+  assert.equal(draft.validEmail("  tenant@example.ie "), true);
+});
+
+test("validEmail rejects the near-misses that must not gate a save", () => {
+  assert.equal(draft.validEmail(""), false);
+  assert.equal(draft.validEmail("tenant"), false);
+  assert.equal(draft.validEmail("tenant@"), false);
+  assert.equal(draft.validEmail("tenant@example"), false);
+  assert.equal(draft.validEmail("two words@example.com"), false);
+  assert.equal(draft.validEmail(undefined), false);
+});
+
+// ---------- The never-leave-the-page contract ----------
+
+test("shouldSkipControl blocks file inputs — documents are never in drafts", () => {
+  assert.equal(
+    draft.shouldSkipControl(ctl({ name: "landlord_reference", type: "file" })),
+    true,
+  );
+});
+
+test("shouldSkipControl blocks the consent checkbox and _-prefixed internals", () => {
+  assert.equal(
+    draft.shouldSkipControl(ctl({ name: "gdpr_consent", type: "checkbox", checked: true })),
+    true,
+  );
+  assert.equal(draft.shouldSkipControl(ctl({ name: "_website" })), true);
+  assert.equal(draft.shouldSkipControl(ctl({ name: "_form_loaded_at" })), true);
+});
+
+test("shouldSkipControl blocks disabled, nameless, and non-data controls", () => {
+  assert.equal(draft.shouldSkipControl(ctl({ disabled: true })), true);
+  assert.equal(draft.shouldSkipControl(ctl({ name: "" })), true);
+  assert.equal(draft.shouldSkipControl(ctl({ type: "submit" })), true);
+  assert.equal(draft.shouldSkipControl(ctl({ type: "button" })), true);
+  assert.equal(draft.shouldSkipControl(ctl({ type: "fieldset" })), true);
+});
+
+test("shouldSkipControl lets ordinary data controls through", () => {
+  assert.equal(draft.shouldSkipControl(ctl({})), false);
+  assert.equal(draft.shouldSkipControl(ctl({ type: "radio", name: "has_pets" })), false);
+});
+
+// ---------- Serializer ----------
+
+test("serializeForm collects text/select values and extracts a trimmed email", () => {
+  const data = draft.serializeForm(
+    formOf([
+      ctl({ name: "first_name", value: "Ada" }),
+      ctl({ name: "email", type: "email", value: "  ada@example.com " }),
+      ctl({ name: "personal_statement", type: "textarea", value: "hello" }),
+    ]),
+  );
+  assert.equal(data.email, "ada@example.com");
+  assert.deepEqual(data.fields, {
+    first_name: "Ada",
+    email: "  ada@example.com ",
+    personal_statement: "hello",
+  });
+});
+
+test("serializeForm keeps only the checked radio of a group", () => {
+  const data = draft.serializeForm(
+    formOf([
+      ctl({ name: "has_pets", type: "radio", value: "yes", checked: false }),
+      ctl({ name: "has_pets", type: "radio", value: "no", checked: true }),
+      ctl({ name: "email", type: "email", value: "a@b.co" }),
+    ]),
+  );
+  assert.equal(data.fields.has_pets, "no");
+});
+
+test("serializeForm stores checked checkboxes as on, skips unticked", () => {
+  const data = draft.serializeForm(
+    formOf([
+      ctl({ name: "never_rented_before", type: "checkbox", value: "", checked: true }),
+      ctl({ name: "has_guarantor", type: "checkbox", checked: false }),
+      ctl({ name: "email", type: "email", value: "a@b.co" }),
+    ]),
+  );
+  assert.equal(data.fields.never_rented_before, "on");
+  assert.equal("has_guarantor" in data.fields, false);
+});
+
+test("serializeForm never serializes files, consent, or internals", () => {
+  const data = draft.serializeForm(
+    formOf([
+      ctl({ name: "landlord_reference", type: "file", value: "C:\\fake\\ref.pdf" }),
+      ctl({ name: "gdpr_consent", type: "checkbox", checked: true }),
+      ctl({ name: "_website", value: "bot-bait" }),
+      ctl({ name: "_form_loaded_at", value: "123" }),
+      ctl({ name: "email", type: "email", value: "a@b.co" }),
+    ]),
+  );
+  assert.deepEqual(data.fields, { email: "a@b.co" });
+});
+
+test("serializeForm first control wins on a shared name", () => {
+  const data = draft.serializeForm(
+    formOf([
+      ctl({ name: "phone", value: "111" }),
+      ctl({ name: "phone", value: "222" }),
+    ]),
+  );
+  assert.equal(data.fields.phone, "111");
+});
+
+// ---------- Payload ----------
+
+test("buildPayload is the {email, fields} JSON the server decodes", () => {
+  const parsed = JSON.parse(draft.buildPayload("a@b.co", { first_name: "Ada" }));
+  assert.deepEqual(parsed, { email: "a@b.co", fields: { first_name: "Ada" } });
+});
+
+// ---------- Debounce ----------
+
+function fakeTimers() {
+  const pending = new Map();
+  let seq = 0;
+  return {
+    pending,
+    set: (fn, ms) => {
+      const id = ++seq;
+      pending.set(id, { fn, ms });
+      return id;
+    },
+    clear: (id) => pending.delete(id),
+    runAll: () => {
+      [...pending.keys()].forEach((id) => {
+        const t = pending.get(id);
+        pending.delete(id);
+        if (t) t.fn();
+      });
+    },
+  };
+}
+
+test("debounce coalesces a burst of step changes into one save", () => {
+  const timers = fakeTimers();
+  let calls = 0;
+  const d = draft.createDebounced(() => calls++, 800, timers);
+  d.trigger();
+  d.trigger();
+  d.trigger();
+  assert.equal(d.pending(), true);
+  assert.equal(timers.pending.size, 1);
+  timers.runAll();
+  assert.equal(calls, 1);
+  assert.equal(d.pending(), false);
+});
+
+test("debounce cancel drops the pending save (pagehide takes over)", () => {
+  const timers = fakeTimers();
+  let calls = 0;
+  const d = draft.createDebounced(() => calls++, 800, timers);
+  d.trigger();
+  d.cancel();
+  assert.equal(d.pending(), false);
+  timers.runAll();
+  assert.equal(calls, 0);
+});
+
+test("debounce passes the configured delay", () => {
+  const timers = fakeTimers();
+  const d = draft.createDebounced(() => {}, 800, timers);
+  d.trigger();
+  const [{ ms }] = [...timers.pending.values()];
+  assert.equal(ms, 800);
+  assert.equal(draft.DEBOUNCE_MS, 800);
+});
+
+// ---------- Copy pins (sync with form_copy.gleam) ----------
+
+test("continue-link copy never blames the applicant and names no tech", () => {
+  assert.match(draft.CONTINUE_FAILED, /^Couldn\u2019t send/);
+  assert.ok(!/Error|Failed/i.test(draft.CONTINUE_FAILED));
+  assert.ok(draft.PREP_NOTE_SAVE.includes("save"));
+  assert.ok(draft.CONTINUE_NEEDS_EMAIL.includes("email"));
+});
+
+test("buildPayload includes resume_token only when present", () => {
+  const withToken = JSON.parse(
+    draft.buildPayload("a@b.co", { first_name: "Ada" }, "tok-123"),
+  );
+  assert.deepEqual(withToken, {
+    email: "a@b.co",
+    fields: { first_name: "Ada" },
+    resume_token: "tok-123",
+  });
+  const without = JSON.parse(draft.buildPayload("a@b.co", {}, ""));
+  assert.equal("resume_token" in without, false);
+  const undef = JSON.parse(draft.buildPayload("a@b.co", {}));
+  assert.equal("resume_token" in undef, false);
+});
