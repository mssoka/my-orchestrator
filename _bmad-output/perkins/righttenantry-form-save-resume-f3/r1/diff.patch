diff --git a/server/src/application/draft_handler.gleam b/server/src/application/draft_handler.gleam
new file mode 100644
index 00000000..94582815
--- /dev/null
+++ b/server/src/application/draft_handler.gleam
@@ -0,0 +1,487 @@
+//// F3 save-and-resume: public draft endpoints.
+////
+////   PUT/POST /apply/:code/draft            — debounced field-value upsert
+////   POST     /apply/:code/continue-link    — "email me a link to continue"
+////   GET      /apply/:code/resume/:token    — restore the draft into the form
+////   GET/POST /apply/:code/draft-erasure/:token — self-service draft delete
+////
+//// Security / abuse model (mirrors the erasure endpoint):
+////   - Drafts are keyed (vacancy, lower(email)); the 288-bit continue token
+////     IS the auth for resume/erasure — no session, no CSRF (should_skip).
+////   - The save endpoint writes but never reads back: worst case an attacker
+////     stores field values against an email they don't own, visible only to
+////     whoever holds that inbox (the continue link goes to the email, not
+////     the requester).
+////   - The continue-link endpoint always answers 200; the 10-minute
+////     per-draft cooldown (claimed atomically in SQL) bounds email spam.
+////   - Field values are filtered server-side: no `_`-prefixed internals
+////     (honeypot/timing), no `gdpr_consent` (consent is captured at submit
+////     only), caps on key count/length and value length, and never any
+////     file data (the JSON payload couldn't carry it anyway).
+
+import application/application_handler
+import application/draft_view
+import application/form_pages
+import application/form_view
+import application/sql
+import config.{type ServerConfig}
+import gleam/dict.{type Dict}
+import gleam/dynamic/decode
+import gleam/json
+import gleam/list
+import gleam/result
+import gleam/string
+import http_origin
+import notification/email_client
+import pog
+import posthog/posthog_client
+import shared/email
+import ssr_response
+import wisp.{type Request, type Response}
+import youid/uuid
+
+/// Server-side field-payload caps. The serializer sends ~40 fields for a
+/// full household form; 120 keys / 4000-char values leave generous room
+/// (personal_statement truncates at 2000 on submit) without allowing
+/// megabyte values against the 64 KB body gate.
+const max_field_keys = 120
+
+const max_key_length = 64
+
+const max_value_length = 4000
+
+pub type DraftPayload {
+  DraftPayload(
+    email: String,
+    fields: Dict(String, String),
+    /// Present only on the resume render (the page carries it so the first
+    /// post-resume save can stamp `resumed_at` — re-engagement, not the
+    /// prefetch-able GET, is what counts as a resume).
+    resume_token: String,
+  )
+}
+
+fn draft_payload_decoder() -> decode.Decoder(DraftPayload) {
+  use email <- decode.field("email", decode.string)
+  use fields <- decode.optional_field(
+    "fields",
+    dict.new(),
+    decode.dict(decode.string, decode.string),
+  )
+  use resume_token <- decode.optional_field("resume_token", "", decode.string)
+  decode.success(DraftPayload(email:, fields:, resume_token:))
+}
+
+/// Filter a client-sent field map down to what a draft may hold. Pure and
+/// pub for unit tests. Drops `_`-prefixed internals (`_website` honeypot,
+/// `_form_loaded_at` timing) and the consent checkbox; enforces the caps.
+pub fn filter_fields(fields: Dict(String, String)) -> List(#(String, String)) {
+  fields
+  |> dict.to_list
+  |> list.filter(fn(pair) {
+    let #(key, _) = pair
+    !string.starts_with(key, "_")
+    && key != "gdpr_consent"
+    && string.length(key) > 0
+    && string.length(key) <= max_key_length
+  })
+  |> list.take(max_field_keys)
+  |> list.map(fn(pair) {
+    let #(key, value) = pair
+    #(key, string.slice(value, 0, max_value_length))
+  })
+}
+
+fn fields_to_json(fields: List(#(String, String))) -> json.Json {
+  json.object(list.map(fields, fn(pair) { #(pair.0, json.string(pair.1)) }))
+}
+
+fn json_ok(ok: Bool) -> String {
+  json.object([#("ok", json.bool(ok))]) |> json.to_string
+}
+
+fn json_ok_with(pairs: List(#(String, json.Json))) -> String {
+  json.object([#("ok", json.bool(True)), ..pairs]) |> json.to_string
+}
+
+/// Resolve the vacancy for a JSON draft endpoint: the row plus its UUID,
+/// only when the vacancy exists AND is accepting applications (drafts must
+/// not accumulate against closed vacancies). Errors are JSON — these
+/// endpoints answer fetch/beacon calls, not browser navigations.
+fn lookup_accepting_vacancy(
+  db: pog.Connection,
+  code: String,
+) -> Result(#(sql.GetVacancyForFormRow, uuid.Uuid), Response) {
+  case sql.get_vacancy_for_form(db, code) {
+    Error(_) -> Error(wisp.internal_server_error())
+    Ok(pog.Returned(_, [])) -> Error(wisp.json_response(json_ok(False), 404))
+    Ok(pog.Returned(_, [vacancy, ..])) ->
+      case application_handler.is_accepting_applications(vacancy) {
+        False ->
+          Error(wisp.json_response(
+            json.object([
+              #("ok", json.bool(False)),
+              #("closed", json.bool(True)),
+            ])
+              |> json.to_string,
+            200,
+          ))
+        True ->
+          case uuid.from_string(vacancy.id) {
+            Error(_) -> Error(wisp.internal_server_error())
+            Ok(vacancy_uuid) -> Ok(#(vacancy, vacancy_uuid))
+          }
+      }
+  }
+}
+
+/// PUT/POST /apply/:code/draft — upsert the applicant's field values.
+/// POST is accepted alongside PUT because navigator.sendBeacon (the
+/// tab-close flush) only POSTs.
+pub fn handle_save_draft(
+  req: Request,
+  config: ServerConfig,
+  code: String,
+) -> Response {
+  use json_body <- wisp.require_json(req)
+  case decode.run(json_body, draft_payload_decoder()) {
+    Error(_) -> wisp.json_response(json_ok(False), 400)
+    Ok(payload) -> {
+      let applicant_email = string.trim(payload.email)
+      case email.is_valid(applicant_email) {
+        False -> wisp.json_response(json_ok(False), 400)
+        True ->
+          case lookup_accepting_vacancy(config.db, code) {
+            Error(resp) -> resp
+            Ok(#(_vacancy, vacancy_uuid)) -> {
+              let filtered = filter_fields(payload.fields)
+              case filtered {
+                // An empty/fully-filtered map must NOT wipe a real draft —
+                // upserting '{}' would erase the applicant's saved answers
+                // (an unauthenticated destructive write needing only the
+                // victim's email + the public vacancy code).
+                [] -> wisp.json_response(json_ok(True), 200)
+                _ ->
+                  case
+                    sql.upsert_application_draft(
+                      config.db,
+                      vacancy_uuid,
+                      applicant_email,
+                      fields_to_json(filtered),
+                    )
+                  {
+                    Ok(_) -> {
+                      // First save after a resume stamps resumed_at (honest
+                      // metric: re-engagement, never the prefetch-able GET).
+                      // Fail-open.
+                      case payload.resume_token {
+                        "" -> Nil
+                        token -> {
+                          let _ =
+                            sql.mark_draft_resumed_by_token(
+                              config.db,
+                              token,
+                              vacancy_uuid,
+                            )
+                          Nil
+                        }
+                      }
+                      wisp.json_response(json_ok(True), 200)
+                    }
+                    Error(err) -> {
+                      wisp.log_error(
+                        "draft upsert failed: " <> string.inspect(err),
+                      )
+                      wisp.internal_server_error()
+                    }
+                  }
+              }
+            }
+          }
+      }
+    }
+  }
+}
+
+/// POST /apply/:code/continue-link — save current state, then email the
+/// tokenized continue link (with the erasure link riding along). Always 200
+/// on well-formed payloads: the response never reveals whether a draft or
+/// mailbox exists, and the SQL-side cooldown claim makes concurrent clicks
+/// single-send.
+pub fn handle_continue_link(
+  req: Request,
+  config: ServerConfig,
+  code: String,
+) -> Response {
+  use json_body <- wisp.require_json(req)
+  case decode.run(json_body, draft_payload_decoder()) {
+    Error(_) -> wisp.json_response(json_ok(False), 400)
+    Ok(payload) -> {
+      let applicant_email = string.trim(payload.email)
+      case email.is_valid(applicant_email) {
+        False -> wisp.json_response(json_ok(False), 400)
+        True ->
+          case lookup_accepting_vacancy(config.db, code) {
+            Error(resp) -> resp
+            Ok(#(vacancy, vacancy_uuid)) -> {
+              // Save-then-send: the link must never restore less than what
+              // was on screen when the applicant asked for it. An empty
+              // field map (defensive client) must NOT wipe a real draft, so
+              // the upsert only runs when fields actually arrived — and a
+              // FAILED upsert aborts before the claim (a stale-state link
+              // is worse than no link).
+              let filtered = filter_fields(payload.fields)
+              let upserted = case filtered {
+                [] -> Ok(Nil)
+                _ ->
+                  sql.upsert_application_draft(
+                    config.db,
+                    vacancy_uuid,
+                    applicant_email,
+                    fields_to_json(filtered),
+                  )
+                  |> result.replace(Nil)
+                  |> result.map_error(fn(err) {
+                    wisp.log_error(
+                      "draft upsert (continue-link) failed: "
+                      <> string.inspect(err),
+                    )
+                    Nil
+                  })
+              }
+              case upserted {
+                Error(_) -> wisp.json_response(json_ok(False), 200)
+                Ok(_) -> {
+                  // Same re-engagement stamp as the plain save path.
+                  case payload.resume_token {
+                    "" -> Nil
+                    token -> {
+                      let _ =
+                        sql.mark_draft_resumed_by_token(
+                          config.db,
+                          token,
+                          vacancy_uuid,
+                        )
+                      Nil
+                    }
+                  }
+                  case
+                    sql.claim_continue_link_send(
+                      config.db,
+                      vacancy_uuid,
+                      applicant_email,
+                      wisp.random_string(48),
+                    )
+                  {
+                    Error(err) -> {
+                      wisp.log_error(
+                        "continue-link claim failed: " <> string.inspect(err),
+                      )
+                      wisp.internal_server_error()
+                    }
+                    // Cooldown (or already submitted, or the empty-fields call
+                    // found no draft): 200 without a send — indistinguishable
+                    // by design.
+                    Ok(pog.Returned(_, [])) ->
+                      wisp.json_response(
+                        json_ok_with([#("sent", json.bool(False))]),
+                        200,
+                      )
+                    Ok(pog.Returned(_, [row, ..])) -> {
+                      let origin = http_origin.canonical_origin(req)
+                      let base = origin <> "/apply/" <> vacancy.short_code
+                      case
+                        email_client.send_draft_continue_link(
+                          config.resend_api_key,
+                          applicant_email,
+                          vacancy.property_name,
+                          base <> "/resume/" <> row.continue_token,
+                          base <> "/draft-erasure/" <> row.continue_token,
+                          vacancy.closes_at,
+                          vacancy.id,
+                        )
+                      {
+                        Ok(_) ->
+                          wisp.json_response(
+                            json_ok_with([#("sent", json.bool(True))]),
+                            200,
+                          )
+                        Error(err) -> {
+                          wisp.log_error("continue-link send failed: " <> err)
+                          // The claim stamped the cooldown before the send;
+                          // clear it or the applicant's retry would be
+                          // cooldown-skipped while the UI says "try again".
+                          // Fail-open (the stamp self-heals in 10 minutes).
+                          let _ =
+                            sql.clear_last_link_sent(
+                              config.db,
+                              vacancy_uuid,
+                              applicant_email,
+                            )
+                          wisp.json_response(json_ok(False), 200)
+                        }
+                      }
+                    }
+                  }
+                }
+              }
+            }
+          }
+      }
+    }
+  }
+}
+
+/// Shared token lookup for the resume + erasure handlers: the draft row for
+/// (token, code), rendered as the uniform friendly 404 when absent.
+fn lookup_draft(
+  req: Request,
+  config: ServerConfig,
+  code: String,
+  token: String,
+) -> Result(sql.GetDraftByContinueTokenRow, Response) {
+  case sql.get_draft_by_continue_token(config.db, token, code) {
+    Error(err) -> {
+      wisp.log_error("draft token lookup failed: " <> string.inspect(err))
+      Error(wisp.internal_server_error())
+    }
+    Ok(pog.Returned(_, [])) ->
+      Error(
+        draft_view.view_not_found(http_origin.canonical_origin(req))
+        |> ssr_response.to_not_found_response,
+      )
+    Ok(pog.Returned(_, [row, ..])) -> Ok(row)
+  }
+}
+
+/// GET /apply/:code/resume/:token — restore the draft into the SSR form.
+pub fn handle_resume(
+  req: Request,
+  config: ServerConfig,
+  code: String,
+  token: String,
+) -> Response {
+  case sql.get_vacancy_for_form(config.db, code) {
+    Error(_) -> wisp.internal_server_error()
+    Ok(pog.Returned(_, [])) ->
+      form_pages.view_not_found_page() |> form_view.to_html_404_response
+    Ok(pog.Returned(_, [vacancy, ..])) -> {
+      case lookup_draft(req, config, code, token) {
+        Error(resp) -> resp
+        Ok(draft) -> {
+          case application_handler.is_accepting_applications(vacancy) {
+            False ->
+              form_pages.view_closed_vacancy_page(
+                vacancy,
+                posthog_client.public_capture_key(config.posthog),
+              )
+              |> form_view.to_html_response
+            True ->
+              case draft.submitted_at {
+                // A submitted draft is stripped (fields '{}', token NULL) —
+                // nothing honest to restore. Same friendly 404 as a bad
+                // token rather than an empty form with a welcome banner.
+                s if s != "" ->
+                  draft_view.view_not_found(http_origin.canonical_origin(req))
+                  |> ssr_response.to_not_found_response
+                _ ->
+                  case
+                    json.parse(
+                      draft.fields,
+                      decode.dict(decode.string, decode.string),
+                    )
+                  {
+                    Error(_) -> {
+                      wisp.log_error(
+                        "draft fields decode failed for draft " <> draft.id,
+                      )
+                      wisp.internal_server_error()
+                    }
+                    Ok(field_map) -> {
+                      // resumed_at is NOT stamped here: the GET is
+                      // prefetch-able (mail scanners), so re-engagement is
+                      // what counts — the first post-resume save stamps it
+                      // via mark_draft_resumed_by_token (the resume page
+                      // carries the token in data-resume-token for that).
+                      form_pages.view_resume_page(
+                        vacancy,
+                        dict.to_list(field_map),
+                        token,
+                        posthog_client.public_capture_key(config.posthog),
+                      )
+                      |> ssr_response.to_sensitive_response
+                    }
+                  }
+              }
+          }
+        }
+      }
+    }
+  }
+}
+
+/// GET /apply/:code/draft-erasure/:token — confirm page (prefetch-safe).
+pub fn handle_erasure_confirm(
+  req: Request,
+  config: ServerConfig,
+  code: String,
+  token: String,
+) -> Response {
+  case sql.get_vacancy_for_form(config.db, code) {
+    Error(_) -> wisp.internal_server_error()
+    Ok(pog.Returned(_, [])) ->
+      form_pages.view_not_found_page() |> form_view.to_html_404_response
+    Ok(pog.Returned(_, [vacancy, ..])) -> {
+      case lookup_draft(req, config, code, token) {
+        Error(resp) -> resp
+        Ok(draft) ->
+          draft_view.view_erasure_confirm(
+            code,
+            token,
+            draft.email,
+            vacancy.property_name,
+            http_origin.canonical_origin(req),
+          )
+          |> ssr_response.to_sensitive_response
+      }
+    }
+  }
+}
+
+/// POST /apply/:code/draft-erasure/:token — actually delete the draft.
+pub fn handle_erasure_delete(
+  req: Request,
+  config: ServerConfig,
+  code: String,
+  token: String,
+) -> Response {
+  case sql.get_vacancy_for_form(config.db, code) {
+    Error(_) -> wisp.internal_server_error()
+    Ok(pog.Returned(_, [])) ->
+      form_pages.view_not_found_page() |> form_view.to_html_404_response
+    Ok(pog.Returned(_, [vacancy, ..])) -> {
+      case lookup_draft(req, config, code, token) {
+        Error(resp) -> resp
+        Ok(_) ->
+          case sql.delete_draft_by_token(config.db, token, code) {
+            Error(err) -> {
+              wisp.log_error(
+                "draft erasure delete failed: " <> string.inspect(err),
+              )
+              wisp.internal_server_error()
+            }
+            Ok(pog.Returned(_, [])) ->
+              // Raced double-POST: the first delete won. Friendly 404.
+              draft_view.view_not_found(http_origin.canonical_origin(req))
+              |> ssr_response.to_not_found_response
+            Ok(pog.Returned(_, [_, ..])) ->
+              draft_view.view_erasure_success(
+                http_origin.canonical_origin(req),
+                vacancy.property_name,
+              )
+              |> ssr_response.to_sensitive_response
+          }
+      }
+    }
+  }
+}
