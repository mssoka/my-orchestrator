+// -- Resume page (F3 save-and-resume) -----------------------------------------
+
+/// Render the form pre-filled from a saved draft (GET /apply/:code/resume/:token).
+/// Distinct marker from both the pristine GET and the error re-render:
+///   * "form"         — fresh visit, section funnel runs
+///   * "form-errors"  — failed submit, funnel suppressed
+///   * "form-resume"  — draft restore, funnel suppressed (pre-filled values
+///     would fake section completions), `application_draft_resumed` fires
+/// The stepper starts at the first incomplete section; the banner sets the
+/// one expectation a draft can't meet (documents are never stored).
+pub fn view_resume_page(
+  vacancy: sql.GetVacancyForFormRow,
+  values: List(#(String, String)),
+  resume_token: String,
+  posthog_api_key: String,
+) -> String {
+  html.html([attribute("lang", "en")], [
+    form_view.view_head(vacancy.property_name),
+    html.body(
+      [
+        attribute("data-apply-page", "form-resume"),
+        attribute("data-vacancy-short-code", vacancy.short_code),
+        // Lets the draft saver stamp resumed_at on the first post-resume
+        // SAVE (re-engagement), never on this prefetch-able GET.
+        attribute("data-resume-token", resume_token),
+      ],
+      [
+        form_view.view_form_header(vacancy),
+        html.main([attribute.class("form-container")], [
+          draft_view.view_resume_banner(),
+          html.form(
+            [
+              attribute.method("POST"),
+              attribute.action("/apply/" <> vacancy.short_code),
+              attribute("enctype", "multipart/form-data"),
+              attribute("novalidate", ""),
+              attribute("data-testid", "application-form"),
+            ],
+            [
+              form_sections.view_section_about_you(values:, errors: []),
+              form_sections.view_section_your_situation(values:, errors: []),
+              form_sections.view_section_work_income(values:, errors: []),
+              form_sections.view_section_references(values:, errors: []),
+              form_sections.view_section_guarantor(values:, errors: []),
+              form_sections.view_section_tell_us_more(values:, errors: []),
+              form_sections.view_section_documents(values:, errors: []),
+              form_sections.view_section_review_consent(errors: []),
+              form_view.view_honeypot_field(),
+              // Backdate the anti-bot timing stamp: a fully-restored draft
+              // can honestly reach Submit inside the < 2 s suspicion window
+              // (consent + click from the review step). The 288-bit token
+              // that gated this render IS the abuse proof — the timing
+              // check exists for tokenless form loads.
+              form_view.view_timing_field(
+                loaded_at_ms: form_view.current_unix_ms() - 10_000,
+              ),
+            ],
+          ),
+        ]),
+        form_view.view_footer(),
+        form_view.view_posthog_snippet(vacancy.short_code, posthog_api_key),
+        element.element(
+          "script",
+          [attribute("src", "/static/form.js"), attribute("defer", "")],
+          [],
+        ),
+        element.element(
+          "script",
+          [attribute("src", "/static/form_stepper.js"), attribute("defer", "")],
+          [],
+        ),
+        form_view.view_apply_analytics_script(),
+        form_view.view_draft_saver_script(),
       ],
     ),
   ])
