+--- claim_continue_link_send(vacancy_id: UUID, email: String, token: String)
+-- Atomically claim a continue-link send: mints the token lazily (keeping an
+-- existing one so previously emailed links keep working) and stamps the
+-- 10-minute resend cooldown in the same UPDATE, so concurrent clicks can't
+-- double-send. Zero rows returned = on cooldown, already submitted, or no
+-- draft for (vacancy, email) — the handler answers 200 without sending.
+UPDATE application_draft
+SET continue_token = COALESCE(continue_token, $3),
+    last_link_sent_at = now(),
+    updated_at = now()
+WHERE vacancy_id = $1::uuid
+  AND email = lower($2)
+  AND submitted_at IS NULL
+  AND (
+    last_link_sent_at IS NULL
+    OR last_link_sent_at < now() - interval '10 minutes'
+  )
+RETURNING COALESCE(continue_token, '') AS continue_token;
