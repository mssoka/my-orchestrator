+// ============================================================================
+// Expiry (retention sweep) + cascade
+// ============================================================================
+
+pub fn retention_sweep_expires_drafts_at_vacancy_close_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  // Active vacancy (draft must survive)…
+  let assert Ok(active_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let _ = seed_draft_with_token(db, active_id, "tok-active")
+  // Manually closed vacancy (status='closed')…
+  let assert Ok(closed_id) = test_db.seed_closed_vacancy(db, landlord_id)
+  let _ = seed_draft_with_token(db, closed_id, "tok-closed")
+  // Still-active status but closes_at already passed (auto-close window)…
+  let assert Ok(past_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let _ = seed_draft_with_token(db, past_id, "tok-past")
+  let assert Ok(_) =
+    pog.query(
+      "UPDATE vacancy SET closes_at = now() - interval '1 hour'
+       WHERE id = $1::uuid",
+    )
+    |> pog.parameter(pog.text(past_id))
+    |> pog.execute(db)
+  // Archived (stops accepting via is_accepting_applications → dead PII)…
+  let assert Ok(archived_id) = test_db.seed_archived_vacancy(db, landlord_id)
+  let _ = seed_draft_with_token(db, archived_id, "tok-archived")
+
+  let assert Ok(summary) =
+    retention_job.run(db, "", "", "", "", sentry_client.Disabled)
+  summary.application_drafts_expired |> should.equal(3)
+
+  draft_count(db) |> should.equal(1)
+  draft_field(db, active_id, "continue_token") |> should.equal("tok-active")
+}
+
+pub fn vacancy_delete_cascades_drafts_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let _ = seed_draft_with_token(db, vacancy_id, "tok-cascade")
+
+  // landlord.free_vacancy_id points at the seeded vacancy — clear it so
+  // the delete exercises only the draft cascade (as a landlord-account
+  // deletion would, after nulling its own references).
+  let assert Ok(_) =
+    pog.query("UPDATE landlord SET free_vacancy_id = NULL WHERE id = $1::uuid")
+    |> pog.parameter(pog.text(landlord_id))
+    |> pog.execute(db)
+  let assert Ok(_) =
+    pog.query("DELETE FROM vacancy WHERE id = $1::uuid")
+    |> pog.parameter(pog.text(vacancy_id))
+    |> pog.execute(db)
+  draft_count(db) |> should.equal(0)
+}
