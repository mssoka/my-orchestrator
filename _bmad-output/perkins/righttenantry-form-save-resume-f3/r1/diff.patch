+pub fn strip_on_submit_empties_payload_keeps_metric_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let _ = seed_draft_with_token(db, vacancy_id, "tok-strip")
+
+  let assert Ok(uuid) = uuid.from_string(vacancy_id)
+  let assert Ok(returned) =
+    app_sql.strip_draft_on_submit(db, uuid, "TENANT@example.com")
+  // Case-insensitive match (writer lowercases).
+  returned.rows |> list_length |> should.equal(1)
+
+  draft_field(db, vacancy_id, "fields") |> should.equal("{}")
+  draft_field(db, vacancy_id, "continue_token") |> should.equal("")
+  draft_field(db, vacancy_id, "submitted_at") |> should.not_equal("")
+}
+
+fn list_length(l: List(a)) -> Int {
+  case l {
+    [] -> 0
+    [_, ..rest] -> 1 + list_length(rest)
+  }
+}
