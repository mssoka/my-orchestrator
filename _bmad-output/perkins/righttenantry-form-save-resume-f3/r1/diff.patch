@@ -0,0 +1,65 @@
+//// Unit tests for the F3 draft field filter — the server-side half of the
+//// "what may never persist in a draft" contract (the JS serializer is the
+//// client half; both are pinned).
+
+import application/draft_handler
+import gleam/dict
+import gleam/int
+import gleam/list
+import gleam/string
+import gleeunit/should
+
+pub fn filter_fields_drops_internal_and_consent_keys_test() {
+  let fields =
+    dict.from_list([
+      #("first_name", "Ada"),
+      #("_website", "bot-bait"),
+      #("_form_loaded_at", "123456"),
+      #("gdpr_consent", "on"),
+    ])
+  draft_handler.filter_fields(fields)
+  |> should.equal([#("first_name", "Ada")])
+}
+
+pub fn filter_fields_never_keeps_a_file_shaped_key_test() {
+  // Defense in depth: even if a client hand-crafts a file input's name into
+  // the JSON (the serializer already skips file controls), the values are
+  // plain strings — but the filter must also let ordinary reference CONTACT
+  // fields through while never carrying document content. What pins this is
+  // simpler: only scalar strings ever survive, capped at 4000 chars.
+  let fields =
+    dict.from_list([
+      #("landlord_reference_name", "Jane"),
+      #("personal_statement", string.repeat("x", 5000)),
+    ])
+  let filtered = draft_handler.filter_fields(fields)
+  filtered
+  |> list.key_find("landlord_reference_name")
+  |> should.equal(Ok("Jane"))
+  filtered
+  |> list.key_find("personal_statement")
+  |> should.equal(Ok(string.repeat("x", 4000)))
+}
+
+pub fn filter_fields_caps_key_count_and_length_test() {
+  let long_key = string.repeat("k", 65)
+  let fields =
+    dict.from_list([#(long_key, "v"), #("ok", "v"), #("", "empty-key")])
+  draft_handler.filter_fields(fields)
+  |> should.equal([#("ok", "v")])
+}
+
+pub fn filter_fields_caps_entries_at_120_test() {
+  let fields =
+    list.range(1, 200)
+    |> list.map(fn(i) { #("field_" <> pad(i), "v") })
+    |> dict.from_list
+  draft_handler.filter_fields(fields)
+  |> list.length
+  |> should.equal(120)
+}
+
+fn pad(i: Int) -> String {
+  let s = int.to_string(i)
+  string.repeat("0", 3 - string.length(s)) <> s
+}
