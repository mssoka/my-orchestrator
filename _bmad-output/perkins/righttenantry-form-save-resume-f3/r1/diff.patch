+//// Applicant-facing pages and fragments for F3 save-and-resume drafts:
+////   1. `view_resume_banner` — the "welcome back" strip on the restored
+////      form (rendered inside the resume page, above the stepper).
+////   2. `view_erasure_confirm` — GET /apply/:code/draft-erasure/:token.
+////      Split confirm so an email-scanner prefetch can't delete (same
+////      posture as erasure_view for submitted applications).
+////   3. `view_erasure_success` — after the POST deletes the row.
+////   4. `view_not_found` — uniform friendly 404 for unknown/used/expired
+////      tokens (never leaks whether a token was ever valid).
+
+import application/form_copy
+import legal/layout
+import lustre/attribute.{attribute}
+import lustre/element
+import lustre/element/html
+
+/// Banner on the resume page: confirms the restore and sets the one
+/// expectation a draft can't meet (documents are never stored).
+pub fn view_resume_banner() -> element.Element(a) {
+  html.aside(
+    [
+      attribute.class("prep-block draft-resume-banner"),
+      attribute("data-testid", "draft-resume-banner"),
+      attribute("role", "status"),
+    ],
+    [
+      html.p([attribute.class("prep-note")], [
+        html.text(form_copy.draft_resume_banner),
+      ]),
+    ],
+  )
+}
+
+/// Confirmation page: "Delete your saved draft?" — POSTs back to the same
+/// URL to actually delete.
+pub fn view_erasure_confirm(
+  code: String,
+  token: String,
+  email: String,
+  property_name: String,
+  canonical_origin: String,
+) -> String {
+  html.html([attribute("lang", "en")], [
+    layout.view_head(
+      title: "Delete your saved draft",
+      canonical_origin: canonical_origin,
+      // Transient capability page — canonical at the apply form, never a
+      // token-bearing path (the success page's own precedent).
+      canonical_path: "/apply/" <> code,
+    ),
+    html.body([], [
+      layout.view_header("Delete your saved draft"),
+      html.main([attribute.class("form-container")], [
+        html.article([attribute.class("legal-document")], [
+          html.section([], [
+            html.p([attribute.class("legal-lede")], [
+              html.text(form_copy.draft_erasure_lede_before_email),
+              html.strong([], [html.text(property_name)]),
+              html.text(" using the email "),
+              html.strong([], [html.text(email)]),
+              html.text("."),
+            ]),
+          ]),
+          html.section([], [
+            html.h2([], [html.text("What gets deleted")]),
+            html.ul([], [
+              html.li([], [
+                html.text(
+                  "The answers you saved for this application. Nothing has been submitted yet, so there is no application on file for this draft.",
+                ),
+              ]),
+            ]),
+          ]),
+          html.section([], [
+            html.p([], [
+              html.text(
+                "Deletion cannot be undone. If you still want to apply, you can start again from the application link — the landlord won't be notified either way.",
+              ),
+            ]),
+            html.form(
+              [
+                attribute.method("POST"),
+                attribute.action(
+                  "/apply/" <> code <> "/draft-erasure/" <> token,
+                ),
+                attribute("data-testid", "draft-erasure-confirm-form"),
+              ],
+              [
+                html.button(
+                  [
+                    attribute.type_("submit"),
+                    attribute.class("btn-submit"),
+                    attribute("data-testid", "draft-erasure-confirm-submit"),
+                  ],
+                  [html.text("Delete my saved draft")],
+                ),
+              ],
+            ),
+          ]),
+        ]),
+      ]),
+      layout.view_footer(),
+    ]),
+  ])
+  |> element.to_string
+}
+
+/// Success page shown after the POST completes.
+pub fn view_erasure_success(
+  canonical_origin: String,
+  property_name: String,
+) -> String {
+  html.html([attribute("lang", "en")], [
+    // Transient page — canonical at the landing page, as on the
+    // application-erasure success page.
+    layout.view_head(
+      title: "Draft deleted",
+      canonical_origin: canonical_origin,
+      canonical_path: "/",
+    ),
+    html.body([], [
+      layout.view_header("Draft deleted"),
+      html.main([attribute.class("form-container")], [
+        html.article([attribute.class("legal-document")], [
+          html.section([], [
+            html.p(
+              [
+                attribute.class("legal-lede"),
+                attribute("data-testid", "draft-erasure-success-message"),
+              ],
+              [
+                html.text(form_copy.draft_erasure_success_before_property),
+                html.strong([], [html.text(property_name)]),
+                html.text(form_copy.draft_erasure_success_after_property),
+              ],
+            ),
+          ]),
+        ]),
+      ]),
+      layout.view_footer(),
+    ]),
+  ])
+  |> element.to_string
+}
+
+/// Uniform 404 for unknown, already-used, or expired draft tokens — also
+/// the resume page for a draft whose application was already submitted.
+pub fn view_not_found(canonical_origin: String) -> String {
+  html.html([attribute("lang", "en")], [
+    layout.view_head(
+      title: "We couldn't find this link",
+      canonical_origin: canonical_origin,
+      canonical_path: "/",
+    ),
+    html.body([], [
+      layout.view_header("We couldn't find this link"),
+      html.main([attribute.class("form-container")], [
+        html.article([attribute.class("legal-document")], [
+          html.section([], [
+            html.p(
+              [
+                attribute.class("legal-lede"),
+                attribute("data-testid", "draft-not-found"),
+              ],
+              [html.text(form_copy.draft_not_found)],
+            ),
+            html.p([], [
+              html.text("If you're sure this should work, email "),
+              html.a([attribute.href("mailto:privacy@righttenantry.ie")], [
+                html.text("privacy@righttenantry.ie"),
+              ]),
+              html.text(" and we'll look into it."),
+            ]),
+          ]),
+        ]),
+      ]),
+      layout.view_footer(),
+    ]),
+  ])
+  |> element.to_string
+}
