+  html
+  |> string.contains("data-apply-page=\"form-resume\"")
+  |> should.be_true
+  html |> string.contains("draft-resume-banner") |> should.be_true
+  html
+  |> string.contains("data-resume-token=\"tok-resume\"")
+  |> should.be_true
+  html |> string.contains("form_draft.js") |> should.be_true
+  // No error machinery — a resume is not a failed submit.
+  html |> string.contains("error-summary") |> should.be_false
+  html |> string.contains("data-first-error-field") |> should.be_false
+}
+
+pub fn resume_page_backdates_the_timing_field_test() {
+  // The <2s anti-bot window must not swallow an honest resumed submit: the
+  // token-gated render stamps _form_loaded_at ~10s in the past.
+  let vacancy = test_helpers.test_vacancy_row()
+  let before = form_view.current_unix_ms() - 9000
+  let html = form_pages.view_resume_page(vacancy, [], "tok-resume", "phc_test")
+  let stamped = timing_field_value(html)
+  case stamped {
+    Some(v) -> should.be_true(v < before)
+    None -> panic as "no _form_loaded_at value on the resume page"
+  }
+}
+
+fn timing_field_value(html: String) -> Option(Int) {
+  case string.split(html, "name=\"_form_loaded_at\"") {
+    [_, rest, ..] ->
+      case string.split(rest, "value=\"") {
+        [_, digits_rest, ..] ->
+          case string.split(digits_rest, "\"") {
+            [digits, ..] -> int.parse(digits) |> option.from_result
+            _ -> None
+          }
+        _ -> None
+      }
+    _ -> None
+  }
+}
