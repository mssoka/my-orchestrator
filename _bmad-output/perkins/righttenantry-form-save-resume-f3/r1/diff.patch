+// form_draft.js — F3 save-and-resume draft saver for the public /apply/:code
+// form (Wave 1 build pack, 2026-07 application-completion problem-solving
+// session).
+//
+// Progressive enhancement ONLY: without this file the form is the honest
+// one-visit form the SSR prep-note describes. When active it:
+//   1. Saves the applicant's FIELD VALUES (never files, never the consent
+//      checkbox, never _-prefixed internals) to the server-side draft —
+//      debounced on every `rt:form-step-changed` from form_stepper.js, plus
+//      a navigator.sendBeacon flush on pagehide (tab-close abandonment is
+//      the dominant mobile pattern this feature exists for).
+//   2. Swaps the prep-block's one-visit line for the save-and-continue
+//      promise (only once the capability is real — the SSR line stays for
+//      no-JS) and injects the "Email me a link to continue" button, which
+//      save-then-sends the tokenized magic link.
+//   3. Announces the first successful save per page life via
+//      `rt:draft-saved` — apply_analytics.js turns that into the
+//      consent-gated PostHog `application_draft_saved` event.
+//
+// Drafts are keyed (vacancy, email): nothing saves until the email field
+// holds a plausible address. Drafts expire at vacancy close; the continue
+// email carries the self-service erasure link. No localStorage — the draft
+// lives server-side so the link works across devices.
+//
+// Testability: the pure internals are exported (CommonJS) for `node --test`;
+// browser wiring runs only when a document is present. Mirrors
+// apply_analytics.js's module pattern.
+
+(function (root) {
+  "use strict";
+
+  var EVENT_STEP_CHANGED = "rt:form-step-changed";
+  // Outbound DOM event — consumed by apply_analytics.js (consent gate owns
+  // the actual PostHog capture; this file never touches PostHog).
+  var EVENT_DRAFT_SAVED = "rt:draft-saved";
+  var DEBOUNCE_MS = 800;
+
+  // Applicant-facing copy — KEEP IN SYNC with server/src/application/
+  // form_copy.gleam (same precedent as REVIEW_HINT_STEPPER in
+  // form_stepper.js: plain static JS can't import Gleam constants).
+  var PREP_NOTE_SAVE =
+    "Complete applications are reviewed first. You don’t have to finish in one visit — once your email is in, your answers save as you go, and you can email yourself a link to pick up where you left off.";
+  var CONTINUE_BUTTON_LABEL = "Email me a link to continue";
+  var CONTINUE_SENT =
+    "Link sent — check your inbox. You can keep going here too.";
+  var CONTINUE_NEEDS_EMAIL =
+    "Add your email in the About you section first — that’s where we’ll send the link.";
+  var CONTINUE_FAILED =
+    "Couldn’t send the link just now — your answers are still safe on this page. Try again in a moment.";
+
+  // ---------- Pure internals (exported for tests) ----------
+
+  // Activation gate: the pristine form, the draft-resume render, and the
+  // validation-error re-render (a failed submit is exactly the moment a
+  // draft is worth having).
+  function shouldActivate(marker) {
+    return (
+      marker === "form" || marker === "form-resume" || marker === "form-errors"
+    );
+  }
+
+  // Client-side plausibility only — the server re-validates with the real
+  // rule (shared/email.is_valid). Loose on purpose: a near-miss email still
+  // saves (server rejects), it just won't gate the save locally.
+  function validEmail(s) {
+    return typeof s === "string" && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s.trim());
+  }
+
+  // The draft contract in one predicate: what may NEVER leave this page.
+  function shouldSkipControl(el) {
+    if (!el || el.disabled) return true;
+    var name = el.name || "";
+    if (!name) return true;
+    // _website honeypot, _form_loaded_at timing — server-side internals.
+    if (name.charAt(0) === "_") return true;
+    // Consent is captured at submit (with its own record), never in drafts.
+    if (name === "gdpr_consent") return true;
+    var type = (el.type || "").toLowerCase();
+    // Documents are only ever transmitted at the final POST.
+    if (type === "file") return true;
+    if (type === "submit" || type === "button" || type === "fieldset") {
+      return true;
+    }
+    return false;
+  }
+
+  // serializeForm(form) → { email, fields } — the name→value map the draft
+  // stores. Radios contribute only their checked member's value; checkboxes
+  // only when ticked (as "on", matching the server's get_form_bool); first
+  // control wins on a shared name.
+  function serializeForm(form) {
+    var fields = {};
+    var email = "";
+    var els = form && form.elements ? form.elements : [];
+    for (var i = 0; i < els.length; i++) {
+      var el = els[i];
+      if (shouldSkipControl(el)) continue;
+      var type = (el.type || "").toLowerCase();
+      if (type === "radio" && !el.checked) continue;
+      if (type === "checkbox" && !el.checked) continue;
+      var name = el.name;
+      if (Object.prototype.hasOwnProperty.call(fields, name)) continue;
+      var value =
+        type === "checkbox"
+          ? el.value || "on"
+          : String(el.value == null ? "" : el.value);
+      fields[name] = value;
+      if (name === "email") email = String(value).trim();
+    }
+    return { email: email, fields: fields };
+  }
+
+  function buildPayload(email, fields, resumeToken) {
+    var body = { email: email, fields: fields };
+    if (resumeToken) body.resume_token = resumeToken;
+    return JSON.stringify(body);
+  }
+
+  // createDebounced(fn, ms, timers) → { trigger, cancel, pending }.
+  // timers injectable for node tests ({set, clear} default to the real ones).
+  function createDebounced(fn, ms, timers) {
+    var t = timers || { set: root.setTimeout, clear: root.clearTimeout };
+    var id = null;
+    return {
+      trigger: function () {
+        if (id !== null) t.clear(id);
+        id = t.set(function () {
+          id = null;
+          fn();
+        }, ms);
+      },
+      cancel: function () {
+        if (id !== null) t.clear(id);
+        id = null;
+      },
+      pending: function () {
+        return id !== null;
+      },
+    };
+  }
+
+  // ---------- Browser wiring ----------
+
+  function initBrowser() {
+    var doc = root.document;
+    var body = doc && doc.body;
+    if (!body) return;
+    var marker = body.getAttribute("data-apply-page");
+    if (!shouldActivate(marker)) return;
+    var shortCode = body.getAttribute("data-vacancy-short-code") || "";
+    var form = doc.querySelector('[data-testid="application-form"]');
+    if (!shortCode || !form) return;
+
+    var draftUrl = "/apply/" + shortCode + "/draft";
+    var continueUrl = "/apply/" + shortCode + "/continue-link";
+    // Present only on the resume render — rides every save so the server
+    // can stamp resumed_at on re-engagement (never on the resume GET).
+    var resumeToken = body.getAttribute("data-resume-token") || "";
+
+    var lastSentPayload = null;
+    var announcedSave = false;
+    // Terminal state (vacancy closed mid-session): stop saving — retries
+    // and the beacon would only re-learn the same closed answer.
+    var saverDisabled = false;
+
+    function currentPayload() {
+      var data = serializeForm(form);
+      if (!validEmail(data.email)) return null;
+      return buildPayload(data.email, data.fields, resumeToken);
+    }
+
+    function announceSaved() {
+      if (announcedSave) return;
+      announcedSave = true;
+      try {
+        doc.dispatchEvent(new root.CustomEvent(EVENT_DRAFT_SAVED, {
+          detail: { vacancy_short_code: shortCode },
+        }));
+      } catch (_) {
+        // Analytics must never break the saver — ignore.
+      }
+    }
+
+    // saveNow(reason) → the debounced saver's inner call. Dedupes against
+    // the last acknowledged payload; failures leave state dirty so the next
+    // trigger (or the pagehide beacon) retries. Silent by design — the form
+    // itself never depends on the save succeeding.
+    function saveNow() {
+      if (saverDisabled) return;
+      var payload = currentPayload();
+      if (!payload || payload === lastSentPayload) return;
+      root
+        .fetch(draftUrl, {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: payload,
+          keepalive: true,
+        })
+        .then(function (res) {
+          if (!res || !res.ok) return;
+          return res.json();
+        })
+        .then(function (body) {
+          if (!body) return;
+          // HTTP 200 is not enough — the closed-vacancy arm answers 200
+          // with ok:false; only a body-level ok marks the save acknowledged.
+          if (body.ok === true) {
+            lastSentPayload = payload;
+            announceSaved();
+          } else if (body.closed === true) {
+            saverDisabled = true;
+          }
+        })
+        .catch(function () {
+          // Silent — the applicant loses nothing on this page.
+        });
+    }
+
+    var debounced = createDebounced(saveNow, DEBOUNCE_MS);
+
+    doc.addEventListener(EVENT_STEP_CHANGED, function () {
+      debounced.trigger();
+    });
+
+    // Tab close / background kill: one last flush. sendBeacon only POSTs —
+    // the route accepts POST beside PUT for exactly this reason.
+    root.addEventListener("pagehide", function () {
+      debounced.cancel();
+      if (saverDisabled) return;
+      var payload = currentPayload();
+      if (!payload || payload === lastSentPayload) return;
+      if (root.navigator && typeof root.navigator.sendBeacon === "function") {
+        root.navigator.sendBeacon(
+          draftUrl,
+          new root.Blob([payload], { type: "application/json" })
+        );
+      }
+    });
+
+    // ---- Prep-block swap + continue-link button ----
+    var prepBlock = doc.querySelector('[data-testid="apply-prep-block"]');
+    if (prepBlock) {
+      var note = prepBlock.querySelector('[data-testid="prep-note"]');
+      if (note) note.textContent = PREP_NOTE_SAVE;
+
+      var holder = doc.createElement("div");
+      holder.className = "draft-continue";
+      var button = doc.createElement("button");
+      button.type = "button";
+      button.className = "btn-step-back draft-continue-button";
+      button.setAttribute("data-testid", "draft-continue-link");
+      button.textContent = CONTINUE_BUTTON_LABEL;
+      var status = doc.createElement("p");
+      status.className = "draft-continue-status";
+      status.setAttribute("data-testid", "draft-continue-status");
+      status.setAttribute("role", "status");
+      status.setAttribute("aria-live", "polite");
+      holder.appendChild(button);
+      holder.appendChild(status);
+      prepBlock.appendChild(holder);
+
+      button.addEventListener("click", function () {
+        var data = serializeForm(form);
+        if (!validEmail(data.email)) {
+          status.textContent = CONTINUE_NEEDS_EMAIL;
+          return;
+        }
+        button.disabled = true;
+        var sentPayload = buildPayload(data.email, data.fields, resumeToken);
+        root
+          .fetch(continueUrl, {
+            method: "POST",
+            headers: { "Content-Type": "application/json" },
+            body: sentPayload,
+          })
+          .then(function (res) {
+            return res && res.json ? res.json() : {};
+          })
+          .then(function (body) {
+            // sent:true and the cooldown's sent:false both read as "on its
+            // way" — the copy never leaks send timing (and the first email
+            // genuinely is in the inbox on cooldown).
+            status.textContent =
+              body && body.ok === false ? CONTINUE_FAILED : CONTINUE_SENT;
+            if (body && body.ok !== false) {
+              // The server just upserted this exact state save-side — the
+              // pagehide beacon doesn't need to repeat it.
+              lastSentPayload = sentPayload;
+              announceSaved();
+            }
+          })
+          .catch(function () {
+            status.textContent = CONTINUE_FAILED;
+          })
+          .finally(function () {
+            button.disabled = false;
+          });
+      });
+    }
+  }
+
+  // ---------- Exports ----------
+
+  var api = {
+    EVENT_STEP_CHANGED: EVENT_STEP_CHANGED,
+    EVENT_DRAFT_SAVED: EVENT_DRAFT_SAVED,
+    DEBOUNCE_MS: DEBOUNCE_MS,
+    PREP_NOTE_SAVE: PREP_NOTE_SAVE,
+    CONTINUE_BUTTON_LABEL: CONTINUE_BUTTON_LABEL,
+    CONTINUE_SENT: CONTINUE_SENT,
+    CONTINUE_NEEDS_EMAIL: CONTINUE_NEEDS_EMAIL,
+    CONTINUE_FAILED: CONTINUE_FAILED,
+    shouldActivate: shouldActivate,
+    validEmail: validEmail,
+    shouldSkipControl: shouldSkipControl,
+    serializeForm: serializeForm,
+    buildPayload: buildPayload,
+    createDebounced: createDebounced,
+  };
+
+  if (typeof module !== "undefined" && module.exports) {
+    module.exports = api;
+  }
+
+  if (
+    typeof root.document !== "undefined" &&
+    root.document &&
+    root.document.body
+  ) {
+    if (root.document.readyState === "loading") {
+      root.document.addEventListener("DOMContentLoaded", initBrowser);
+    } else {
+      initBrowser();
+    }
+  }
+})(typeof window !== "undefined" ? window : this);
