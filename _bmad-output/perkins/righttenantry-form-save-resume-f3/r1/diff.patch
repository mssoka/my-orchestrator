+
+/// Prep-block note once the draft saver is active (JS swaps the SSR
+/// one-visit line for this — the promise is only true when JS runs).
+pub const draft_prep_note: String = "Complete applications are reviewed first. You don\u{2019}t have to finish in one visit \u{2014} once your email is in, your answers save as you go, and you can email yourself a link to pick up where you left off."
+
+/// Continue-link button label, injected into the prep block by form_draft.js.
+pub const draft_continue_button: String = "Email me a link to continue"
+
+/// Button outcome: link sent (or already on its way \u{2014} the cooldown
+/// path deliberately reads the same so sends never leak timing).
+pub const draft_continue_sent: String = "Link sent \u{2014} check your inbox. You can keep going here too."
+
+/// Button outcome: the email field is empty/invalid (draft is email-keyed).
+pub const draft_continue_needs_email: String = "Add your email in the About you section first \u{2014} that\u{2019}s where we\u{2019}ll send the link."
+
+/// Button outcome: send failed (Resend/network). Never blames the applicant.
+pub const draft_continue_failed: String = "Couldn\u{2019}t send the link just now \u{2014} your answers are still safe on this page. Try again in a moment."
+
+/// Resume-page banner lead: the draft restored successfully.
+pub const draft_resume_banner: String = "Welcome back \u{2014} your saved answers are in. For your security we never save uploaded documents, so please re-attach them in the Documents step."
+
+/// Draft-erasure confirm page lede (property + email interpolated).
+pub const draft_erasure_lede_before_email: String = "This will permanently delete the draft saved for "
+
+/// Draft-erasure success line (property interpolated).
+pub const draft_erasure_success_before_property: String = "Your saved draft for "
+
+pub const draft_erasure_success_after_property: String = " has been deleted. Thanks for letting us know."
+
+/// Draft-erasure / resume 404 lede (bad token, already deleted, expired).
+pub const draft_not_found: String = "We couldn\u{2019}t find a saved draft for this link. It may already have been used or deleted, or the vacancy may have closed."
