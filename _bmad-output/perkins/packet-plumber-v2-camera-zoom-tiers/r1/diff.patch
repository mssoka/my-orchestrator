+camera_cluster_center_is_the_source_cluster_home :: proc(t: ^testing.T) {
+	// v2-camera-zoom-tiers: camera_set_default's home anchor is the centroid
+	// of the freshly seeded fixture — the "source terminal / first cluster"
+	// (the buildings + links the player meets on entry). The REAL fixture
+	// positions (seed_fixture: residential (8,15), router (20,15), host
+	// (32,15)) centroid at (20,15) tiles = (520, 390) world px @ 26px.
+	cat_storage: pp.Catalogs
+	cat := &cat_storage
+	defer pp.catalogs_destroy(cat)
+	cat.balance.tile_px = 26
+	append(&cat.node_types,
+		pp.Node_Type{id = "residential", display = "res", kind = .Terminal, terminal_role = .Residential, port_capacity = 0},
+		pp.Node_Type{id = "router_basic", display = "rt", kind = .Junction, port_capacity = 4},
+		pp.Node_Type{id = "content_host", display = "host", kind = .Terminal, terminal_role = .Content_Host, port_capacity = 0},
+	)
+	topo: pp.Topology
+	ri, _ := pp.node_type_index(cat, "residential")
+	rti, _ := pp.node_type_index(cat, "router_basic")
+	hi, _ := pp.node_type_index(cat, "content_host")
+	// the seed_fixture positions (the fixed first cluster)
+	pp.topology_spawn_node(&topo, ri, {8, 15}, cat)
+	pp.topology_spawn_node(&topo, rti, {20, 15}, cat)
+	pp.topology_spawn_node(&topo, hi, {32, 15}, cat)
+	cx, cy := camera_cluster_center(&topo, 26)
+	testing.expect(t, abs(cx - 520) < TOL && abs(cy - 390) < TOL, "the fixture centroid is the source-cluster home (20,15) tiles -> (520,390) px")
+	// a dead node id must not skew the centroid (the live-only walk)
+	topo.node_alive[0] = false
+	cx1, _ := camera_cluster_center(&topo, 26)
+	testing.expect(t, abs(cx1 - 676.0) < TOL, "dead nodes are excluded from the centroid ((20+32)/2 tiles -> 676 px)")
+	// the empty-topology defensive guard (never divide by zero)
+	empty: pp.Topology
+	ex, ey := camera_cluster_center(&empty, 26)
+	testing.expect(t, ex == 0 && ey == 0, "an empty topology yields a zero home (defensive)")
 }
 
