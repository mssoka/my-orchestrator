+camera_default_zoom_is_the_resting_tier :: proc(t: ^testing.T) {
+	// v2-camera-zoom-tiers: the three zoom tiers are explicit and
+	// non-overlapping — default (DEFAULT_ZOOM, the resting home) < focus
+	// (node 2.3 / link 2.6 — camera_set_selection, unchanged) < max, with the
+	// 1.0 fit as the manual wheel-out floor BELOW the default.
+	testing.expect(t, DEFAULT_ZOOM == 2.0, "DEFAULT_ZOOM is the 2.0 cluster/default zoom")
+	testing.expect(t, CAM_ZOOM_MIN < DEFAULT_ZOOM, "the whole-map out floor (1.0) sits below the default")
+	testing.expect(t, DEFAULT_ZOOM < 2.3, "the node focus (2.3) is an extra zoom-in above the default")
+	testing.expect(t, 2.3 < 2.6, "the link focus (2.6) is the deepest focus tier")
+	testing.expect(t, 2.6 < CAM_ZOOM_MAX, "the focus tiers sit inside the 4.0 max")
+}
