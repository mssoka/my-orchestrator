+			verb = "reroutes"
+		}
+		return fmt.aprintf("%d %s %s to node %d", r.count, flow_word(r.count), verb, r.node, allocator = context.temp_allocator)
+	case .Split:
+		return fmt.aprintf("%d %s split - equal cost", r.count, flow_word(r.count), allocator = context.temp_allocator)
+	case .Merge:
+		verb := "consolidate"
+		if r.count == 1 {
+			verb = "consolidates"
+		}
+		return fmt.aprintf("%d %s %s on node %d", r.count, flow_word(r.count), verb, r.node, allocator = context.temp_allocator)
+	case:
+		return "?"
+	}
+}
+
+// flow_word — the singular/plural noun for a flow count ("1 flow" / "2 flows").
+flow_word :: proc(n: i32) -> string {
+	if n == 1 {
+		return "flow"
+	}
+	return "flows"
+}
diff --git a/core/forecast_shift.odin b/core/forecast_shift.odin
new file mode 100644
index 0000000..ba9e3b8
--- /dev/null
+++ b/core/forecast_shift.odin
@@ -0,0 +1,204 @@
+package core
+
+// forecast_shift.odin — Job C / R4: the forecast flow-shift PREDICTIVE HELPER
+// (canon: _bmad-output/problem-solution-2026-08-13.md, R4 — "this upgrade
+// attracts everything"). The thundering-herd trap defused by prediction: given
+// the current Topology + a hypothetical tier change on ONE pipe, this computes
+// the predicted post-upgrade routing (Job A's Dijkstra re-run against the
+// hypothetical tier view) and the predicted flow shift (the per-pair
+// next-hop-set deltas between the current routing and the predicted routing).
+//
+// CONTRACT — a LOOK, never a write (acceptance 1: PURE):
+//   • reads the Topology + Catalogs; mutates NOTHING passed in (no gen bump,
+//     no action log, no Run_State involvement — the app calls this straight
+//     from the render path; a preview never becomes a command);
+//   • no rng (ODN-9), integer-only (ODN-10), array-only — no map iteration
+//     (ODN-10);
+//   • deterministic: identical (Topology, pipe, new_tier) -> identical shifts
+//     on every target + every call (pair scan in slot order — insertion
+//     order);
+//   • the before/after tables are BOTH built by routing_rebuild_with_tiers —
+//     the SAME Dijkstra the sim runs (routing_rebuild is a one-line wrapper
+//     over it), so prediction == actual is constructional; the empirical pin
+//     (test_forecast_honest_prediction_pin) proves it through the real edit
+//     path (demolish + redraw) anyway.
+//
+// The predicted flow shift is the routing-table delta, pair by pair: for every
+// (from, dst) live node pair whose equal-cost next-hop SET changes, one
+// Route_Shift entry. Reachability cannot change (the graph is identical — only
+// a pipe cost changed), so a shift is exactly one of:
+//   Split   — the ECMP set GREW (new_count > old_count): an equal-cost tie
+//             appeared — "equal-cost — flow will split" (acceptance 2).
+//   Merge   — the ECMP set SHRANK (new_count < old_count): a tie broke —
+//             flows consolidate on the surviving path.
+//   Reroute — the set changed with equal counts: flows move to a different
+//             next hop — "traffic will reroute to X" (acceptance 2).
+// The entry carries the representative next hop (node + pipe) on each side so
+// the panel can name the target node AND spot flows whose new first hop rides
+// the upgraded pipe itself (the magnet telegraph — "this upgrade attracts N
+// flows").
+//
+// Scope (the canon's scope guard): routing/path-choice shift ONLY. The
+// capacity effect of a tier change (a fatter bundle carries packets faster) is
+// the bundles view (2.1), not a routing shift — out of R4's prediction, by
+// canon. No auto-routing, no new player command: the app treats this as a
+// view-only preview (never lowered into the action log).
+
+// Forecast_Error — the typed rejections (§7.1: never silent). Mirrors the
+// edit errors a real upgrade would hit: an unknown/missing pipe or tier, or a
+// hypothetical tier whose max_span is below the pipe's span (the real draw
+// would reject it, so a prediction for it would be a lie).
+Forecast_Error :: enum u8 {
+	None,
+	Missing_Pipe,      // pipe id does not resolve to a live pipe
+	Unknown_Tier,      // new_tier index out of catalog range
+	Span_Exceeds_Tier, // the hypothetical tier's max_span < the pipe's span (validate_draw would reject)
+}
+
+// Shift_Kind — the three possible next-hop-set deltas (see the header: the
+// graph is unchanged, so a shift is exactly Split / Merge / Reroute).
+Shift_Kind :: enum u8 {
+	Reroute, // the set changed, counts equal — flows move to a different next hop
+	Split,   // the set GREW — an equal-cost tie appeared ("flow will split")
+	Merge,   // the set SHRANK — a tie broke (flows consolidate)
+}
+
+// Route_Shift — one (from, dst) pair whose predicted post-upgrade next-hop set
+// differs from the current one. `new_*` describe the PREDICTED state; the
+// panel renders the acceptance's messages from kind + new_next, and the
+// magnet telegraph ("this upgrade attracts N flows") from `attract`.
+Route_Shift :: struct {
+	from:      u32, // pair source node id
+	dst:       u32, // pair destination node id
+	kind:      Shift_Kind,
+	old_next:  u32, // representative next-hop NODE before (0 = unroutable)
+	new_next:  u32, // representative next-hop NODE after (0 = unroutable)
+	old_count: u32, // ECMP set size before
+	new_count: u32, // ECMP set size after
+	old_pipe:  u32, // representative pipe id before (0 = none)
+	new_pipe:  u32, // representative pipe id after (0 = none)
+	attract:   bool, // any member of the NEW set rides the UPGRADED pipe (the magnet telegraph — first-hop signal, never overcounts)
+}
+
+// forecast_shift — the R4 predictive helper. Given the current Topology + a
+// hypothetical tier change on one live pipe, the predicted post-upgrade
+// routing and the predicted flow shift. See the header contract: PURE look,
+// deterministic, integer-only, array-only. Returns the shift list (caller
+// owns + frees) or the typed rejection. An empty list is an honest
+// "no routing change" (the hypothetical does not move any next-hop set).
+forecast_shift :: proc(t: ^Topology, cat: ^Catalogs, pipe: u32, new_tier: u16,
+                       allocator := context.allocator) -> (shifts: [dynamic]Route_Shift, err: Forecast_Error) {
+	context.allocator = allocator
+	shifts = make([dynamic]Route_Shift, 0, 8)
+	ps, ok := pipe_slot(t, pipe)
+	if !ok {
+		return shifts, .Missing_Pipe
+	}
+	if u32(new_tier) >= u32(len(cat.pipe_tiers)) {
+		return shifts, .Unknown_Tier
+	}
+	if cat.pipe_tiers[new_tier].max_span < t.pipe_span[ps] {
+		// the real draw would reject this tier for this pipe's span — a
+		// prediction for an illegal upgrade would be a lie (honest prediction)
+		return shifts, .Span_Exceeds_Tier
+	}
+	if new_tier == t.pipe_tier[ps] {
+		// the identical tier: the look is a no-op by construction (the same
+		// cost on the same edge -> the identical routing; a same-cost
+		// DIFFERENT tier is handled honestly by the diff below — it can only
+		// produce an empty list, since the tables only read costs).
+		return shifts, .None
+	}
+
+	// the hypothetical tier view: copy the live per-slot tiers, patch ONE slot
+	// (the look's scratch — array-only, ODN-10; freed on return).
+	tiers := make([]u16, len(t.pipe_alive))
+	defer delete(tiers)
+	for i in 0..<len(t.pipe_tier) {
+		tiers[i] = t.pipe_tier[i]
+	}
+	tiers[ps] = new_tier
+
+	// before + after tables — the SAME Dijkstra core (the honest-prediction
+	// construction: the prediction runs the sim's own algorithm).
+	before: Routing_Table
+	after: Routing_Table
+	routing_make(&before)
+	routing_make(&after)
+	defer {
+		routing_destroy(&before)
+		routing_destroy(&after)
+	}
+	routing_rebuild_with_tiers(&before, t, cat, t.pipe_tier[:])
+	routing_rebuild_with_tiers(&after, t, cat, tiers)
+
+	// the per-pair diff (slot-order scan — deterministic, array-only):
+	// a pair shifts iff its next-hop NODE set changed (nodes are the routing
+	// behavior; pipe ids are display refs carried by the reps).
+	n := len(t.node_alive)
+	for fs in 0..<n {
+		if !t.node_alive[fs] {
+			continue
+		}
+		for ds in 0..<n {
+			if ds == fs || !t.node_alive[ds] {
+				continue
+			}
+			from_id := t.node_id[fs]
+			dst_id := t.node_id[ds]
+			bo, bc, _ := routing_equal_cost_hops(&before, t, from_id, dst_id)
+			ao, ac, _ := routing_equal_cost_hops(&after, t, from_id, dst_id)
+			same := bc == ac
+			if same {
+				for k in 0..<int(bc) {
+					if before.hops[int(bo)+k].node != after.hops[int(ao)+k].node {
+						same = false
+						break
+					}
+				}
+			}
+			if same {
+				continue
+			}
+			kind := Shift_Kind.Reroute
+			if ac > bc {
+				kind = .Split
+			} else if ac < bc {
+				kind = .Merge
+			}
+			old_next, old_pipe := shift_rep(&before, bo, bc)
+			new_next, new_pipe := shift_rep(&after, ao, ac)
+			attract := false
+			for k in 0..<int(ac) {
+				if after.hops[int(ao)+k].pipe == pipe {
+					attract = true
+					break
+				}
+			}
+			append(&shifts, Route_Shift{
+				from = from_id,
+				dst = dst_id,
+				kind = kind,
+				old_next = old_next,
+				new_next = new_next,
+				old_count = bc,
+				new_count = ac,
+				old_pipe = old_pipe,
+				new_pipe = new_pipe,
+				attract = attract,
+			})
+		}
+	}
+	return shifts, .None
+}
+
+// shift_rep — the representative (node, pipe) of a hop set: the FIRST member
+// (insertion order — slot order — the same representative routing_next_hop
+// resolves). Zeroes when the set is empty (unroutable).
+shift_rep :: proc(r: ^Routing_Table, offset, count: u32) -> (node, pipe: u32) {
+	if count == 0 {
+		return 0, 0
+	}
+	h := r.hops[int(offset)]
+	return h.node, h.pipe
+}
diff --git a/core/forecast_shift_test.odin b/core/forecast_shift_test.odin
new file mode 100644
index 0000000..cdcf957
--- /dev/null
+++ b/core/forecast_shift_test.odin
@@ -0,0 +1,376 @@
+package core
+
+// forecast_shift_test.odin — Job C / R4: the forecast flow-shift PREDICTION
+// pinned as durable tests (canon: problem-solution-2026-08-13.md R4). Pins:
+//   (a) SPLIT — a hypothetical one-pipe upgrade creates an equal-cost tie:
+//       "equal-cost — flow will split" (acceptance 2's message, verbatim);
+//   (b) REROUTE — a hypothetical upgrade flips the unique path onto the
+//       upgraded pipe: "traffic will reroute to X" (acceptance 2, verbatim),
+//       with the magnet signal (attract == true);
+//   (c) MERGE — a hypothetical upgrade breaks a true tie: flows consolidate;
+//   (d) THE HONEST-PREDICTION PIN (acceptance 3): the helper's predicted
+//       post-upgrade routing == the sim's ACTUAL post-upgrade routing after
+//       the upgrade is applied FOR REAL (demolish + redraw at the higher tier
+//       through the real edit path — the player's actual upgrade action, no
+//       new command per the scope guard), asserted per-pair next-hop set,
+//       PLUS a flow-level proof (a packet spawned after the real upgrade
+//       departs over the predicted path);
+//   (e) PURITY — the helper mutates nothing it is given (topology + catalog
+//       byte-unchanged, no gen bump) and is deterministic (twice-called ->
+//       identical shifts);
+//   (f) error + no-change cases: missing pipe / unknown tier / span-exceeds
+//       (a hypothetical the real draw would reject), the identical tier
+//       (idempotent look), and a single-path topology (honest "no routing
+//       change" — nothing to reroute).
+//
+// Geometry: the compact cost diamond (res(8,15), m1(16,11), m2(16,19),
+// host(24,15); spans 9 <= narrow max 10) shared with routing_cost_test.
+// Ladder 20/10/5 (narrow/standard/wide). Cost sums used here:
+//   std+narrow = 30   narrow+narrow = 40   wide+narrow = 25
+//   std+wide   = 15 (not used)             wide+wide = 10 (not used)
+
+import "core:testing"
+
+// shift_by_pair — find a shift entry by its (from, dst) pair.
+shift_by_pair :: proc(shifts: []Route_Shift, from, dst: u32) -> (^Route_Shift, bool) {
+	for i in 0..<len(shifts) {
+		if shifts[i].from == from && shifts[i].dst == dst {
+			return &shifts[i], true
+		}
+	}
+	return nil, false
+}
+
+// forecast_shift_setup — the cost diamond with a custom per-leg tier pattern
+// (the stock cost_draw_diamond mirrors tiers per side; these pins need
+// asymmetric legs). Draws at apply_tick 1 + steps once (table built).
+// Returns the run + the four node ids + the pipe ids (0=res-m1, 1=res-m2,
+// 2=m1-host, 3=m2-host — draw order).
+forecast_shift_setup :: proc(cat: ^Catalogs, t_a, t_b, t_c, t_d: u16) -> (Run_State, u32, u32, u32, u32) {
+	s, res, m1, m2, host := cost_diamond_setup(cat)
+	draw(&s, 1, res, m1, t_a) // pipe 0
+	draw(&s, 1, res, m2, t_b) // pipe 1
+	draw(&s, 1, m1, host, t_c) // pipe 2
+	draw(&s, 1, m2, host, t_d) // pipe 3
+	step_n(&s, 1, cat)
+	return s, res, m1, m2, host
+}
+
+@(test)
+test_forecast_split_equal_cost :: proc(t: ^testing.T) {
+	// SPLIT: a-side std(10)+narrow(20) = 30 (unique m1); b-side
+	// narrow(20)+narrow(20) = 40. Upgrade res->m2 narrow->STANDARD: b-side
+	// becomes 10+20 = 30 == 30 -> an equal-cost tie appears where there was a
+	// unique hop: "equal-cost — flow will split" (acceptance 2).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	narrow, _ := pipe_tier_index(cat, "narrow")
+	s, res, m1, m2, host := forecast_shift_setup(cat, std, narrow, narrow, narrow)
+	defer run_destroy(&s)
+
+	shifts, err := forecast_shift(&s.topology, cat, 1, std) // pipe 1 = res->m2 -> standard
+	defer delete(shifts)
+	testing.expectf(t, err == .None, "upgrade must be accepted, got err %d", err)
+	testing.expectf(t, len(shifts) == 2, "exactly the two symmetric pairs shift, got %d", len(shifts))
+
+	rs, ok := shift_by_pair(shifts[:], res, host)
+	testing.expectf(t, ok, "(res,host) must have a shift")
+	if ok {
+		testing.expectf(t, rs.kind == .Split, "(res,host) kind must be Split, got %d", rs.kind)
+		testing.expectf(t, rs.old_count == 1 && rs.new_count == 2,
+			"(res,host) count must grow 1 -> 2, got %d -> %d", rs.old_count, rs.new_count)
+		testing.expectf(t, rs.old_next == m1, "(res,host) old unique hop must be m1, got %d", rs.old_next)
+		// the predicted set is {m1, m2} — the flow will split across BOTH paths
+		testing.expectf(t, rs.new_next == m1, "(res,host) new set starts at m1 (slot order), got %d", rs.new_next)
+	}
+	hs, okh := shift_by_pair(shifts[:], host, res)
+	testing.expectf(t, okh, "(host,res) must have the symmetric shift")
+	if okh {
+		testing.expectf(t, hs.kind == .Split && hs.old_count == 1 && hs.new_count == 2,
+			"(host,res) symmetric split, got kind %d count %d -> %d", hs.kind, hs.old_count, hs.new_count)
+	}
+}
+
+@(test)
+test_forecast_reroute_to_upgraded :: proc(t: ^testing.T) {
+	// REROUTE: a-side std(10)+narrow(20) = 30 (unique m1); b-side
+	// narrow(20)+narrow(20) = 40. Upgrade res->m2 narrow->WIDE: b-side becomes
+	// 5+20 = 25 < 30 -> the unique path FLIPS onto the upgraded pipe: "traffic
+	// will reroute to X" (acceptance 2) + the magnet signal (attract).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	narrow, _ := pipe_tier_index(cat, "narrow")
+	wide, _ := pipe_tier_index(cat, "wide")
+	s, res, m1, m2, host := forecast_shift_setup(cat, std, narrow, narrow, narrow)
+	defer run_destroy(&s)
+
+	shifts, err := forecast_shift(&s.topology, cat, 1, wide) // pipe 1 = res->m2 -> wide
+	defer delete(shifts)
+	testing.expectf(t, err == .None, "upgrade must be accepted, got err %d", err)
+	testing.expectf(t, len(shifts) == 2, "exactly the two symmetric pairs shift, got %d", len(shifts))
+
+	rs, ok := shift_by_pair(shifts[:], res, host)
+	testing.expectf(t, ok, "(res,host) must have a shift")
+	if ok {
+		testing.expectf(t, rs.kind == .Reroute, "(res,host) kind must be Reroute, got %d", rs.kind)
+		testing.expectf(t, rs.old_count == 1 && rs.new_count == 1, "(res,host) stays unique, got %d -> %d", rs.old_count, rs.new_count)
+		testing.expectf(t, rs.old_next == m1 && rs.new_next == m2,
+			"(res,host) must reroute m1 -> m2, got %d -> %d", rs.old_next, rs.new_next)
+		testing.expectf(t, rs.new_pipe == 1, "(res,host) new first hop must ride the upgraded pipe (id 1), got %d", rs.new_pipe)
+		testing.expectf(t, rs.attract, "(res,host) must carry the magnet signal (upgraded pipe in the new set)")
+	}
+	hs, okh := shift_by_pair(shifts[:], host, res)
+	testing.expectf(t, okh, "(host,res) must have the symmetric shift")
+	if okh {
+		testing.expectf(t, hs.kind == .Reroute && hs.new_next == m2,
+			"(host,res) symmetric reroute to m2, got kind %d next %d", hs.kind, hs.new_next)
+		// host's first hop toward res rides the m2->host leg (pipe 3) — NOT the
+		// upgraded pipe: the magnet signal must stay honest per side
+		testing.expectf(t, !hs.attract, "(host,res) must NOT claim the upgraded pipe (it rides pipe 3)")
+	}
+}
+
+@(test)
+test_forecast_merge_tie_breaks :: proc(t: ^testing.T) {
+	// MERGE: a-side std(10)+narrow(20) = 30; b-side narrow(20)+std(10) = 30 —
+	// a TRUE different-tier tie (ECMP 2, the "3+8 vs 8+3" shape). Upgrade
+	// res->m1 std->WIDE: a-side becomes 5+20 = 25 < 30 -> the tie breaks, flows
+	// consolidate on m1 (count 2 -> 1).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	narrow, _ := pipe_tier_index(cat, "narrow")
+	wide, _ := pipe_tier_index(cat, "wide")
+	s, res, m1, m2, host := forecast_shift_setup(cat, std, narrow, narrow, std)
+	defer run_destroy(&s)
+
+	// sanity: the pre-upgrade state IS the tie (the Job A pin's shape)
+	off, count, ok := routing_equal_cost_hops(&s.routing, &s.topology, res, host)
+	testing.expectf(t, ok && count == 2, "pre-upgrade must be an ECMP tie (count 2), got ok=%v count=%d", ok, count)
+	_ = off
+
+	shifts, err := forecast_shift(&s.topology, cat, 0, wide) // pipe 0 = res->m1 -> wide
+	defer delete(shifts)
+	testing.expectf(t, err == .None, "upgrade must be accepted, got err %d", err)
+	// FOUR pairs shift: (res,host)+(host,res) — the tie to host breaks — AND
+	// (m1,m2)+(m2,m1) — the mid-router tie ALSO breaks (both routes to the
+	// other mid router go via res at 5+20=25 instead of the 30 tie). All four
+	// are honest predictions of the same cost drop.
+	testing.expectf(t, len(shifts) == 4, "four pairs shift (host + mid-router ties break), got %d", len(shifts))
+
+	rs, okr := shift_by_pair(shifts[:], res, host)
+	testing.expectf(t, okr, "(res,host) must have a shift")
+	if okr {
+		testing.expectf(t, rs.kind == .Merge, "(res,host) kind must be Merge, got %d", rs.kind)
+		testing.expectf(t, rs.old_count == 2 && rs.new_count == 1,
+			"(res,host) count must shrink 2 -> 1, got %d -> %d", rs.old_count, rs.new_count)
+		testing.expectf(t, rs.new_next == m1, "(res,host) must consolidate on m1, got %d", rs.new_next)
+	}
+	// the mid-router tie breaks the same way: unique via res (the wide leg)
+	mm, okm := shift_by_pair(shifts[:], m1, m2)
+	testing.expectf(t, okm, "(m1,m2) must have a shift (its tie breaks)")
+	if okm {
+		testing.expectf(t, mm.kind == .Merge && mm.new_next == res,
+			"(m1,m2) must merge onto res, got kind %d next %d", mm.kind, mm.new_next)
+	}
+}
+
+@(test)
+test_forecast_honest_prediction_pin :: proc(t: ^testing.T) {
+	// ACCEPTANCE 3 — the honest-prediction pin (the determinism twin of
+	// `expect hash stable`): the helper's predicted post-upgrade routing equals
+	// the sim's ACTUAL post-upgrade routing after the upgrade is applied FOR
+	// REAL. The real action today = demolish the pipe + redraw it at the higher
+	// tier (logged commands through the real edit path — the same lowering the
+	// demo/replay gate uses); the helper never saw the edit.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	narrow, _ := pipe_tier_index(cat, "narrow")
+	wide, _ := pipe_tier_index(cat, "wide")
+	s, res, m1, m2, host := forecast_shift_setup(cat, std, narrow, narrow, narrow)
+	defer run_destroy(&s)
+	pipe_b1 := u32(1) // res->m2 (narrow) — the pipe the player upgrades
+
+	// --- the prediction (a look — the topology is untouched) ---
+	shifts, err := forecast_shift(&s.topology, cat, pipe_b1, wide)
+	defer delete(shifts)
+	testing.expectf(t, err == .None, "forecast_shift must accept the upgrade, got err %d", err)
+	rs, ok := shift_by_pair(shifts[:], res, host)
+	testing.expectf(t, ok && rs.new_next == m2, "prediction must name m2 as the new hop, got ok=%v next=%d", ok, rs.new_next)
+
+	// the PREDICTED post-upgrade table, built via the same seam the helper
+	// uses (a tier-view rebuild on the PRE-EDIT topology — one slot patched)
+	tiers := make([]u16, len(s.topology.pipe_alive))
+	defer delete(tiers)
+	for i in 0..<len(s.topology.pipe_tier) {
+		tiers[i] = s.topology.pipe_tier[i]
+	}
+	tiers[1] = wide // pipe slot 1 (res->m2) becomes wide
+	predicted: Routing_Table
+	routing_make(&predicted)
+	defer routing_destroy(&predicted)
+	routing_rebuild_with_tiers(&predicted, &s.topology, cat, tiers)
+
+	// --- apply the upgrade FOR REAL (the player's action, the real path) ---
+	// demolish the narrow res->m2 pipe at tick 2; redraw it WIDE at tick 3
+	append(&s.action_log, Command{apply_tick = 2, kind = Cmd_Demolish_Pipe{pipe = pipe_b1}})
+	draw(&s, 3, res, m2, wide)
+	step_n(&s, 2, cat)
+	testing.expectf(t, !s.replay_error, "the real edit must replay clean (no replay_error)")
+	new_pipe := u32(4) // next_pipe_id: ids 0..3 drawn, the redraw mints 4
+
+	// --- ACTUAL == PREDICTED, per-pair next-hop NODE sets (the pin) ---
+	n := len(s.topology.node_alive)
+	mismatches := 0
+	for fs in 0..<n {
+		if !s.topology.node_alive[fs] {
+			continue
+		}
+		for ds in 0..<n {
+			if ds == fs || !s.topology.node_alive[ds] {
+				continue
+			}
+			from_id := s.topology.node_id[fs]
+			dst_id := s.topology.node_id[ds]
+			po, pc, _ := routing_equal_cost_hops(&predicted, &s.topology, from_id, dst_id)
+			ao, ac, _ := routing_equal_cost_hops(&s.routing, &s.topology, from_id, dst_id)
+			if pc != ac {
+				mismatches += 1
+				testing.expectf(t, false, "pair (%d->%d): predicted count %d != actual %d", from_id, dst_id, pc, ac)
+				continue
+			}
+			for k in 0..<int(pc) {
+				pn := predicted.hops[int(po)+k].node
+				an := s.routing.hops[int(ao)+k].node
+				if pn != an {
+					mismatches += 1
+					testing.expectf(t, false, "pair (%d->%d): predicted hop %d = node %d, actual %d",
+						from_id, dst_id, k, pn, an)
+				}
+			}
+		}
+	}
+	testing.expectf(t, mismatches == 0, "PREDICTION != ACTUAL: %d pair mismatches (the honest-prediction pin)", mismatches)
+
+	// --- the flow-level proof: a packet spawned AFTER the real upgrade
+	// departs over the PREDICTED path (the new wide pipe toward m2) ---
+	flow_seed_demand(&s.flow, 6, res, host)
+	step_n(&s, 3, cat) // ticks 4, 5, 6: the demand fires at 6 (spawn + forward onto the fresh table)
+	found := false
+	for i in 0..<len(s.flow.packets) {
+		p := &s.flow.packets[i]
+		if p.src != res || p.dst != host || p.delivered {
+			continue
+		}
+		if !p.on_edge {
+			continue
+		}
+		testing.expectf(t, p.heading == m2, "post-upgrade packet %d must head to m2 (the prediction), got %d", p.id, p.heading)
+		testing.expectf(t, p.edge == new_pipe, "post-upgrade packet %d must ride the new wide pipe %d, got %d", p.id, new_pipe, p.edge)
+		found = true
+	}
+	testing.expectf(t, found, "no in-flight res->host packet after the real upgrade")
+}
+
+@(test)
+test_forecast_pure_no_mutation_and_deterministic :: proc(t: ^testing.T) {
+	// PURITY + determinism (acceptance 1): the helper mutates NOTHING it is
+	// given (topology + catalog untouched, no gen bump) and is a pure function
+	// (twice-called -> byte-identical shift lists).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	narrow, _ := pipe_tier_index(cat, "narrow")
+	wide, _ := pipe_tier_index(cat, "wide")
+	s, res, m1, m2, host := forecast_shift_setup(cat, std, narrow, narrow, narrow)
+	defer run_destroy(&s)
+
+	// snapshot the topology + catalog (contents, not just lengths)
+	gen_before := s.topology.gen
+	alive_before := len(s.topology.pipe_alive)
+	tiers_before := make([]u16, len(s.topology.pipe_tier))
+	defer delete(tiers_before)
+	for i in 0..<len(s.topology.pipe_tier) {
+		tiers_before[i] = s.topology.pipe_tier[i]
+	}
+	cost_before := cat.pipe_tiers[int(wide)].cost
+
+	a, err_a := forecast_shift(&s.topology, cat, 1, wide)
+	defer delete(a)
+	b, err_b := forecast_shift(&s.topology, cat, 1, wide)
+	defer delete(b)
+	testing.expectf(t, err_a == .None && err_b == .None, "both calls must succeed")
+
+	// no mutation
+	testing.expectf(t, s.topology.gen == gen_before, "PURITY: topology.gen moved (a write!) — %d -> %d", gen_before, s.topology.gen)
+	testing.expectf(t, len(s.topology.pipe_alive) == alive_before, "PURITY: pipe count changed")
+	for i in 0..<len(s.topology.pipe_tier) {
+		testing.expectf(t, s.topology.pipe_tier[i] == tiers_before[i], "PURITY: pipe tier %d changed", i)
+	}
+	testing.expectf(t, cat.pipe_tiers[int(wide)].cost == cost_before, "PURITY: catalog mutated")
+
+	// determinism: identical outputs
+	testing.expectf(t, len(a) == len(b), "determinism: shift count differs across calls (%d vs %d)", len(a), len(b))
+	for i in 0..<min(len(a), len(b)) {
+		testing.expectf(t, a[i] == b[i], "determinism: shift %d differs across calls", i)
+	}
+	// the pair domain + kind sanity on one call
+	_, ok := shift_by_pair(a[:], res, host)
+	_, okm := shift_by_pair(a[:], m1, host)
+	testing.expectf(t, ok, "(res,host) must shift")
+	testing.expectf(t, !okm, "(m1,host) must NOT shift (its path is untouched)")
+}
+
+@(test)
+test_forecast_errors_and_no_change :: proc(t: ^testing.T) {
+	// ERROR + no-change cases: the look fails loudly on a missing pipe /
+	// unknown tier / span-exceeding hypothetical (the real draw would reject
+	// it, so a prediction would be a lie), is idempotent on the identical
+	// tier, and honestly reports "no routing change" on a single-path network.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	narrow, _ := pipe_tier_index(cat, "narrow")
+	wide, _ := pipe_tier_index(cat, "wide")
+
+	// the fixture line: res(8,15) -> rt(20,15) -> host(32,15), span 12 each
+	s, res, rt, host := flow_setup(cat)
+	defer run_destroy(&s)
+	draw(&s, 1, res, rt, std) // pipe 0, span 12 (> narrow max_span 10)
+	draw(&s, 1, rt, host, std) // pipe 1
+	step_n(&s, 1, cat)
+
+	// missing pipe / unknown tier
+	sh, e1 := forecast_shift(&s.topology, cat, 999, wide)
+	defer delete(sh)
+	testing.expectf(t, e1 == .Missing_Pipe, "unknown pipe must reject with .Missing_Pipe, got %d", e1)
+	sh2, e2 := forecast_shift(&s.topology, cat, 0, 99)
+	defer delete(sh2)
+	testing.expectf(t, e2 == .Unknown_Tier, "unknown tier must reject with .Unknown_Tier, got %d", e2)
+	// a hypothetical the real draw would reject: standard(12-span) down to
+	// narrow (max_span 10) — the helper must refuse to predict a lie
+	sh3, e3 := forecast_shift(&s.topology, cat, 0, narrow)
+	defer delete(sh3)
+	testing.expectf(t, e3 == .Span_Exceeds_Tier, "span-exceeding tier must reject with .Span_Exceeds_Tier, got %d", e3)
+
+	// the identical tier: idempotent look (zero shifts, no error)
+	sh4, e4 := forecast_shift(&s.topology, cat, 0, std)
+	defer delete(sh4)
+	testing.expectf(t, e4 == .None && len(sh4) == 0, "identical tier must be a zero-shift no-op, got err %d shifts %d", e4, len(sh4))
+
+	// single-path network: upgrading a pipe on the ONLY path changes no next-
+	// hop set — the honest "no routing change" (nothing to reroute)
+	sh5, e5 := forecast_shift(&s.topology, cat, 0, wide)
+	defer delete(sh5)
+	testing.expectf(t, e5 == .None && len(sh5) == 0, "single-path upgrade must predict no routing change, got err %d shifts %d", e5, len(sh5))
+	_ = host
+}
