+// update_preview — recompute the R4 upgrade preview when its inputs changed:
+// the selected pipe, its next tier, or the topology (an edit this frame bumps
+// gen — the fresh table the helper reads is the CURRENT topology, so a stale
+// preview would be a lie). A pure look: forecast_shift reads the topology +
+// catalog and writes nothing; the result never enters the action log. The
+// preview disarms itself when the selection clears, the pipe dies, or the
+// pipe is already the widest tier (nothing to preview).
+update_preview :: proc(app: ^App) {
+	if !app.preview_active || app.sel_pipe < 0 {
+		app.preview_active = false
+		return
+	}
+	pipe := u32(app.sel_pipe)
+	ps, ok := pp.pipe_slot(&app.state.topology, pipe)
+	if !ok {
+		app.preview_active = false // the selected pipe is gone — drop the preview
+		return
+	}
+	cur := app.state.topology.pipe_tier[ps]
+	if u32(cur) + 1 >= u32(len(app.cat.pipe_tiers)) {
+		app.preview_active = false // already the widest tier — nothing to preview
+		return
+	}
+	to := u16(cur) + 1
+	if app.preview_gen == app.state.topology.gen && app.preview_pipe == pipe && app.preview_to_tier == to {
+		return // inputs unchanged — the computed shifts stay fresh
+	}
+	sh, err := pp.forecast_shift(&app.state.topology, &app.cat, pipe, to)
+	if err != .None {
+		delete(sh) // the look refused (an illegal hypothetical) — disarm, never guess
+		app.preview_active = false
+		return
+	}
+	delete(app.preview_shifts) // swap in the fresh look (app-owned storage)
+	app.preview_shifts = sh
+	app.preview_pipe = pipe
+	app.preview_from_tier = cur
+	app.preview_to_tier = to
+	app.preview_gen = app.state.topology.gen
+}
