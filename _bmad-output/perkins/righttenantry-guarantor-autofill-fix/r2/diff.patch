 //// Pass value: "" and error: "" for clean (initial) form rendering.
 
 import gleam/list
+import gleam/result
+import gleam/string
 import lustre/attribute.{attribute}
 import lustre/element
 import lustre/element/html
 
+/// HTML `autocomplete` token for a text field, per the WHATWG autofill
+/// spec. Exact names first — they outrank the suffix rules where a bare
+/// `_name` suffix would lie (`employer_name` is an organisation, not a
+/// person) — then suffix rules for the repeated contact-trio patterns,
+/// then `"off"` for fields with no standard token (dates, counts, free
+/// text).
+///
+/// `"off"` must never be stamped on name/phone/email-like fields: it is an
+/// explicit autofill opt-out that makes browsers show heuristic
+/// suggestions without filling them (the guarantor autofill bug, 2026-08
+/// — the whitelist's `_ -> "off"` fallback swallowed every non-whitelisted
+/// field, guarantor and siblings alike).
+///
+/// Bracket-prefixed names (`co_applicant[0][employer_ref_name]`,
+/// `additional_income[1][amount]`) normalize to their inner field name so
+/// one rule set covers both shapes.
+///
+/// Co-applicant phone fields get `tel-national` (not `tel`) on purpose:
+/// Chromium caps autofill at 9 fields per type per fill
+/// (`kTypeValueFormFillingLimit`, counted across the whole form in DOM
+/// order), and the three co-applicant cards push the primary guarantor
+/// phone to the 11th `tel` instance — past the cap — so it never fills.
+/// `tel` and `tel-national` are separate type buckets, so splitting the
+/// phone fields across both standard phone tokens keeps every phone in the
+/// form fillable (primary block at 5 `tel`, co-applicant blocks at 6
+/// `tel-national`). National format is a legitimate standard value for a
+/// phone field.
 pub fn autocomplete_for(name: String) -> String {
-  case name {
-    "first_name" -> "given-name"
-    "last_name" -> "family-name"
-    "email" -> "email"
-    "phone" -> "tel"
-    "current_address" -> "street-address"
-    "current_city" -> "address-level2"
-    "current_county" -> "address-level1"
-    "eircode" -> "postal-code"
-    _ -> "off"
+  // Bracketed co-applicant phones end with `_phone]` — checked before the
+  // suffix rules so `co_applicant[N][..._phone]` never falls into `tel`.
+  case
+    string.contains(name, "co_applicant[") && string.ends_with(name, "_phone]")
+  {
+    True -> "tel-national"
+    False -> {
+      let inner = inner_field_name(name)
+      case inner {
+        "first_name" -> "given-name"
+        "last_name" -> "family-name"
+        "email" -> "email"
+        "phone" -> "tel"
+        "current_address" -> "street-address"
+        "current_city" -> "address-level2"
+        "current_county" -> "address-level1"
+        "eircode" -> "postal-code"
+        "job_title" -> "organization-title"
+        "employer_name" -> "organization"
+        "guarantor_employer" -> "organization"
+        "monthly_income_cents" -> "transaction-amount"
+        "guarantor_monthly_income_cents" -> "transaction-amount"
+        "amount" -> "transaction-amount"
+        _ -> autocomplete_for_suffix(inner)
+      }
+    }
   }
 }
 
+/// Normalize a bracket-index-prefixed name (`co_applicant[0][first_name]`
+/// → `first_name`) to its inner field name. Bare names pass through
+/// unchanged; anything that doesn't split into exactly two segments is
+/// left alone (defensive — every prefixed name in this form is
+/// `prefix[index][field]`).
+fn inner_field_name(name: String) -> String {
+  case string.split(name, "][") {
+    [_, inner] -> string.drop_end(inner, 1)
+    _ -> name
+  }
+}
+
+fn autocomplete_for_suffix(name: String) -> String {
+  // First matching suffix wins; the list is ordered most-specific first.
+  let rules = [
+    #(string.ends_with(name, "_monthly_income_cents"), "transaction-amount"),
+    #(string.ends_with(name, "_employer"), "organization"),
+    #(string.ends_with(name, "_phone"), "tel"),
+    #(string.ends_with(name, "_email"), "email"),
+    #(string.ends_with(name, "_name"), "name"),
+  ]
+  list.find(rules, fn(pair) { pair.0 })
+  |> result.map(fn(pair) { pair.1 })
+  |> result.unwrap("off")
+}
