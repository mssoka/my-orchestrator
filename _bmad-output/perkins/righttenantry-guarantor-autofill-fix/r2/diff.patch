+//// Autocomplete-token pins for the SSR application form fields
+//// (2026-08-05 — guarantor autofill fix). Every text field must carry a
+//// standard WHATWG autocomplete token; `"off"` is allowed only where no
+//// token exists (dates, counts, free text). These pins are the grep-proof
+//// audit: they enumerate every field name the form renders.
+
+import application/form_fields
+import gleam/string
+import gleeunit/should
+import lustre/element
+
+pub fn bare_contact_and_address_fields_test() {
+  // The original whitelist — unchanged behavior.
+  form_fields.autocomplete_for("first_name") |> should.equal("given-name")
+  form_fields.autocomplete_for("last_name") |> should.equal("family-name")
+  form_fields.autocomplete_for("email") |> should.equal("email")
+  form_fields.autocomplete_for("phone") |> should.equal("tel")
+  form_fields.autocomplete_for("current_address")
+  |> should.equal("street-address")
+  form_fields.autocomplete_for("current_city") |> should.equal("address-level2")
+  form_fields.autocomplete_for("current_county")
+  |> should.equal("address-level1")
+  form_fields.autocomplete_for("eircode") |> should.equal("postal-code")
+}
+
+pub fn guarantor_fields_get_real_tokens_test() {
+  // The reported bug: these fell into the `_ -> "off"` fallback.
+  form_fields.autocomplete_for("guarantor_name") |> should.equal("name")
+  form_fields.autocomplete_for("guarantor_phone") |> should.equal("tel")
+  form_fields.autocomplete_for("guarantor_email") |> should.equal("email")
+  form_fields.autocomplete_for("guarantor_employer")
+  |> should.equal("organization")
+  form_fields.autocomplete_for("guarantor_monthly_income_cents")
+  |> should.equal("transaction-amount")
+}
+
+pub fn sibling_sections_get_real_tokens_test() {
+  // References trios — audit finding: same fallback bug as the guarantor.
+  form_fields.autocomplete_for("landlord_ref_name") |> should.equal("name")
+  form_fields.autocomplete_for("landlord_ref_phone") |> should.equal("tel")
+  form_fields.autocomplete_for("landlord_ref_email") |> should.equal("email")
+  form_fields.autocomplete_for("character_ref_name") |> should.equal("name")
+  form_fields.autocomplete_for("character_ref_phone") |> should.equal("tel")
+  form_fields.autocomplete_for("character_ref_email") |> should.equal("email")
+  form_fields.autocomplete_for("employer_ref_name") |> should.equal("name")
+  form_fields.autocomplete_for("employer_ref_phone") |> should.equal("tel")
+  form_fields.autocomplete_for("employer_ref_email") |> should.equal("email")
+  // Work & income.
+  form_fields.autocomplete_for("job_title")
+  |> should.equal("organization-title")
+  form_fields.autocomplete_for("employer_name") |> should.equal("organization")
+  form_fields.autocomplete_for("monthly_income_cents")
+  |> should.equal("transaction-amount")
+}
+
+pub fn bracket_prefixed_fields_normalize_test() {
+  // Co-applicant cards — `co_applicant[N][field]` shapes.
+  form_fields.autocomplete_for("co_applicant[0][first_name]")
+  |> should.equal("given-name")
+  form_fields.autocomplete_for("co_applicant[0][last_name]")
+  |> should.equal("family-name")
+  form_fields.autocomplete_for("co_applicant[0][employer_name]")
+  |> should.equal("organization")
+  form_fields.autocomplete_for("co_applicant[0][employer_ref_name]")
+  |> should.equal("name")
+  form_fields.autocomplete_for("co_applicant[0][employer_ref_phone]")
+  |> should.equal("tel-national")
+  form_fields.autocomplete_for("co_applicant[0][employer_ref_email]")
+  |> should.equal("email")
+  form_fields.autocomplete_for("co_applicant[0][monthly_income_cents]")
+  |> should.equal("transaction-amount")
+  // Co-applicant guarantor blocks — the same trio as the primary block.
+  form_fields.autocomplete_for("co_applicant[0][guarantor_name]")
+  |> should.equal("name")
+  form_fields.autocomplete_for("co_applicant[2][guarantor_phone]")
+  |> should.equal("tel-national")
+  form_fields.autocomplete_for("co_applicant[2][guarantor_email]")
+  |> should.equal("email")
+  form_fields.autocomplete_for("co_applicant[2][guarantor_employer]")
+  |> should.equal("organization")
+  form_fields.autocomplete_for(
+    "co_applicant[2][guarantor_monthly_income_cents]",
