diff --git a/supabase/migrations/20260731220000_add_reference_contact_attestation_enum.sql b/supabase/migrations/20260731220000_add_reference_contact_attestation_enum.sql
new file mode 100644
index 00000000..9557d58f
--- /dev/null
+++ b/supabase/migrations/20260731220000_add_reference_contact_attestation_enum.sql
@@ -0,0 +1,11 @@
+-- Add the 'reference_contact_attestation' consent_type enum value so an
+-- applicant's explicit attestation that their referees expect to be
+-- contacted can be recorded on acknowledgement_record (AD-2; the
+-- 20260420000003 guarantor_attestation precedent). Wording is
+-- attestation/acknowledgement framing — lawful basis is Art 6(1)(f)
+-- legitimate interest; the row evidences transparency.
+--
+-- PostgreSQL enum value additions run outside transactions, so IF NOT EXISTS
+-- is used to make the migration replay-safe.
+
+ALTER TYPE consent_type ADD VALUE IF NOT EXISTS 'reference_contact_attestation';
diff --git a/supabase/migrations/20260731220100_add_application_capture_columns.sql b/supabase/migrations/20260731220100_add_application_capture_columns.sql
new file mode 100644
index 00000000..1fa3892b
--- /dev/null
+++ b/supabase/migrations/20260731220100_add_application_capture_columns.sql
@@ -0,0 +1,29 @@
+-- Add the reference-checking v1 capture columns to application (AD-10 +
+-- amendment A4):
+--
+--   submitted_ip_text / submitted_user_agent — the applicant-submission
+--   fraud comparator, written at submission time from the request headers
+--   (request_helpers.client_ip / client_user_agent, both bounded). These
+--   are internal-only evidentiary columns: never exposed on the landlord
+--   payload (AD-11). Empty string means "no capture" (header absent or
+--   pre-v1 row). Bounds match the cookie_consent_log /
+--   payment_terms_acceptance precedent (64 / 512).
+--   Trust note: client_ip reads the first x-forwarded-for hop, which is
+--   only trustworthy because production ingress is Cloudflare-only —
+--   direct origin hits could spoof it. The comparator feeds display-only,
+--   honestly-labelled-weak signals (AD-10); it never auto-rejects.
+--
+--   reference_contact_choice — the applicant's explicit attestation choice
+--   at submission ('attested' = referees expect contact, 'declined' = do
+--   not contact automatically). Nullable so pre-v1 applications stay NULL
+--   and the panel can distinguish "declined" from "never saw the choice"
+--   (A4). No default: a fabricated value would misrecord a choice the
+--   applicant never made.
+--
+-- Expand-only and idempotent; existing rows are untouched (DEFAULT ''
+-- applies to new writes, NULL choice untouched).
+
+ALTER TABLE application
+  ADD COLUMN IF NOT EXISTS submitted_ip_text TEXT NOT NULL DEFAULT '' CHECK (length(submitted_ip_text) <= 64),
+  ADD COLUMN IF NOT EXISTS submitted_user_agent TEXT NOT NULL DEFAULT '' CHECK (length(submitted_user_agent) <= 512),
+  ADD COLUMN IF NOT EXISTS reference_contact_choice TEXT CHECK (reference_contact_choice IN ('attested','declined'));
