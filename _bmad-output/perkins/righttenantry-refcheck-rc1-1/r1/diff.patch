+/// Over-long headers: the helpers slice to the CHECK bounds (64 / 512)
+/// before write, so an adversarial header can never trip the constraint
+/// and 500 the submission path.
+pub fn apply_submission_overlong_headers_truncated_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let short_code = fetch_vacancy_short_code(db, vacancy_id)
+  let email = "apply-ack-overlong@example.com"
+
+  let values = apply_form_fixture_values(email: email, has_guarantor: False)
+  let file =
+    simulate.FileUpload(
+      file_name: "reference.pdf",
+      content_type: "application/pdf",
+      content: <<"%PDF-1.4 fake reference body":utf8>>,
+    )
+  let resp =
+    simulate.request(http.Post, "/apply/" <> short_code)
+    |> simulate.multipart_body(values, [#("landlord_ref_primary", file)])
+    |> simulate.header("x-forwarded-for", string.repeat("9", 500))
+    |> simulate.header("user-agent", string.repeat("U", 600))
+    |> application_handler.handle_post_form(test_server_config(db), short_code)
+  resp.status |> should.equal(200)
+
+  let app_id = fetch_application_id_by_email(db, email)
+  let assert Ok(ip_len) =
+    test_db.query_int(
+      db,
+      "SELECT length(submitted_ip_text)::int FROM application WHERE id = '"
+        <> app_id
+        <> "'::uuid",
+    )
+  ip_len |> should.equal(64)
+  let assert Ok(ua_len) =
+    test_db.query_int(
+      db,
+      "SELECT length(submitted_user_agent)::int FROM application WHERE id = '"
+        <> app_id
+        <> "'::uuid",
+    )
+  ua_len |> should.equal(512)
+}
