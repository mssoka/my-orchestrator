+// ============================================================================
+// RC1.1 — reference-contact attestation choice + submission capture (AD-2,
+// AD-10, amendment A4)
+// ============================================================================
+
+/// Attested path: the fourth acknowledgement_record write lands in the same
+/// submission transaction with the current policy_version, the choice is
+/// recorded on the application row, and the request's IP / User-Agent are
+/// captured (bounded) as the later fraud-signal comparator.
+pub fn apply_submission_attested_writes_reference_attestation_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let short_code = fetch_vacancy_short_code(db, vacancy_id)
+  let email = "apply-ack-attested@example.com"
+
+  let values =
+    apply_form_fixture_values(email: email, has_guarantor: False)
+    |> list.map(fn(pair) {
+      case pair.0 == "reference_contact_choice" {
+        True -> #("reference_contact_choice", "attested")
+        False -> pair
+      }
+    })
+  let file =
+    simulate.FileUpload(
+      file_name: "reference.pdf",
+      content_type: "application/pdf",
+      content: <<"%PDF-1.4 fake reference body":utf8>>,
+    )
+  let resp =
+    simulate.request(http.Post, "/apply/" <> short_code)
+    |> simulate.multipart_body(values, [#("landlord_ref_primary", file)])
+    |> simulate.header("x-forwarded-for", "203.0.113.99, 10.0.0.1")
+    |> simulate.header("user-agent", "RC11-Test-Agent/1.0")
+    |> application_handler.handle_post_form(test_server_config(db), short_code)
+  resp.status |> should.equal(200)
+
+  let app_id = fetch_application_id_by_email(db, email)
+
+  // data_processing + ai_analysis + reference_contact_attestation = 3 rows.
+  let assert Ok(row_count) =
+    test_db.query_int(
+      db,
+      "SELECT count(*)::int FROM acknowledgement_record WHERE application_id = '"
+        <> app_id
+        <> "'::uuid",
+    )
+  row_count |> should.equal(3)
+
+  // The attestation row exists, stamped with the current policy_version.
+  let assert Ok(rc_count) =
+    test_db.query_int(db, "SELECT count(*)::int FROM acknowledgement_record
+       WHERE application_id = '" <> app_id <> "'::uuid
+         AND record_type = 'reference_contact_attestation'::consent_type
+         AND policy_version = '" <> compliance.policy_version <> "'")
+  rc_count |> should.equal(1)
+
+  // Choice recorded on the application row (A4).
+  let assert Ok(choice) =
+    test_db.query_text(
+      db,
+      "SELECT reference_contact_choice FROM application WHERE id = '"
+        <> app_id
+        <> "'::uuid",
+    )
+  choice |> should.equal("attested")
+
+  // Capture columns carry the request's client IP (first XFF hop) and UA.
+  let assert Ok(ip) =
+    test_db.query_text(
+      db,
+      "SELECT submitted_ip_text FROM application WHERE id = '"
+        <> app_id
+        <> "'::uuid",
+    )
+  ip |> should.equal("203.0.113.99")
+  let assert Ok(ua) =
+    test_db.query_text(
+      db,
+      "SELECT submitted_user_agent FROM application WHERE id = '"
+        <> app_id
+        <> "'::uuid",
+    )
+  ua |> should.equal("RC11-Test-Agent/1.0")
+}
