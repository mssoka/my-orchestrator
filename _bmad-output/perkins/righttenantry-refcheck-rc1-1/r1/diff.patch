+title: 'RC1.1: Attestation & capture schema + submission write path'
+type: 'feature'
+created: '2026-07-31'
+status: 'done'
+baseline_commit: '80ed48f08241d3653b77938ef7b592a8c8b9fb47'
+review_loop_iteration: 0
+context: []
