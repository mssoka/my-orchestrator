+	dispatch_frame(&ictx, []Device_Event{Device_Event(Mouse_Release{pos = {280, 300}, button = .Left})})
+	dispatch_frame(&ictx, []Device_Event{Device_Event(Mouse_Press{pos = {600, 600}, button = .Left})})
+	testing.expect(t, ictx.panning, "re-armed before the modal")
+	dispatch_frame(&ictx, []Device_Event{Device_Event(Key_Press{key = .S})})
+	testing.expect(t, !ictx.panning, "opening the settings modal clears the pan latch (W1)")
+	// the modal's suppress branch also drops it (belt+braces)
+	dispatch_frame(&ictx, []Device_Event{Device_Event(Mouse_Press{pos = {600, 600}, button = .Left})})
+	testing.expect(t, !ictx.panning, "a press under the modal never arms the latch")
+}
