+	testing.expect(t, app.cam_zoom_to < 4.0, "the pullback eases OUT (zoom target drops)")
+	testing.expect(t, app.cam_zoom_to >= 1.0, "the target stays inside the fit floor")
+	// the "just enough" contract: the district + margin fits the TARGET
+	// viewport (the converged frame includes it)
+	fit := camera_fit(&app.view)
+	half_w := (f32(app.view.win_w) / 2) / (fit * app.cam_zoom_to)
+	half_h := (f32(app.view.win_h) / 2) / (fit * app.cam_zoom_to)
+	dx := abs(f32(23) * app.view.tile_px - app.cam_wx_to)
+	dy := abs(f32(10) * app.view.tile_px - app.cam_wy_to)
+	margin := 2 * app.view.tile_px
+	testing.expect(t, dx + margin <= half_w + 1e-3 && dy + margin <= half_h + 1e-3, "the converged viewport includes the district + margin")
+}
+
+@(test)
+pullback_walk_skips_interleaved_router_ids :: proc(t: ^testing.T) {
+	// Perkins r2 W4: a fast-path router placement consumes a node id with NO
+	// spawn event — the old next_node_id-1 walk-back pointed at the router
+	// and silently skipped the real seed. The terminal-filtered walk
+	// (camera_newest_terminals) maps the event to the seed.
+	app: App
+	pullback_test_app(&app)
+	defer pp.run_destroy(&app.state)
+	defer pp.catalogs_destroy(&app.cat) // N6
+
+	place_router(&app, {30, 10}) // id 6: a junction, no event (the skewer)
+	spawn_with_event(&app, {23, 10}) // id 7: the seed, >= 10 tiles from every terminal
+	pullback_feed(&app, app.state.events[:])
+	testing.expect(t, app.pullback, "the event maps to the TERMINAL past the interleaved router (W4)")
+	testing.expect(t, app.cam_zoom_to < 4.0, "the pullback target moved")
+}
+
+@(test)
+pullback_yields_to_every_user_camera_input :: proc(t: ^testing.T) {
+	// Perkins r2 W8: "any user camera input yields the pullback instantly" —
+	// all SEVEN clear sites pinned (wheel, pan, node-select, pipe-select,
+	// alerts-as-nav focus, ESC home, the settings toggle).
+	arm_pullback :: proc(app: ^App) {
+		clear(&app.state.events)
+		spawn_with_event(app, {23, 10})
+		pullback_feed(app, app.state.events[:])
+		if !app.pullback {
+			panic("pullback test: the pullback failed to arm")
+		}
+	}
+
+	// wheel
+	app: App
+	pullback_test_app(&app)
+	defer pp.run_destroy(&app.state)
+	defer pp.catalogs_destroy(&app.cat) // N6
+	arm_pullback(&app)
+	camera_zoom_at(&app, 1, {640, 360})
+	testing.expect(t, !app.pullback, "the wheel yields the pullback")
+
+	// pan
+	app2: App
+	pullback_test_app(&app2)
+	defer pp.run_destroy(&app2.state)
+	defer pp.catalogs_destroy(&app2.cat)
+	arm_pullback(&app2)
+	effect_pan(&app2, &app2.input, 50, 0)
+	testing.expect(t, !app2.pullback, "the drag-pan yields the pullback")
+
+	// node-select (the junction at (11,14) is the fixture router)
+	app3: App
+	pullback_test_app(&app3)
+	defer pp.run_destroy(&app3.state)
+	defer pp.catalogs_destroy(&app3.cat)
+	arm_pullback(&app3)
+	app3.input.sel_node = i64(app3.rt_id)
+	app3.input.sel_pipe = -1
+	app3.last_sel_node = -1 // force the selection diff
+	camera_set_selection(&app3)
+	testing.expect(t, !app3.pullback, "the node-selection focus yields the pullback")
+
+	// pipe-select (draw terminal -> router, then select the pipe)
+	app4: App
+	pullback_test_app(&app4)
+	defer pp.run_destroy(&app4.state)
+	defer pp.catalogs_destroy(&app4.cat)
+	arm_pullback(&app4)
+	cmd := pp.Command{kind = pp.Cmd_Draw_Pipe{a = app4.res_id, b = app4.rt_id, tier = 0}}
+	_, e := pp.topology_apply_edit(&app4.state.topology, cmd, &app4.cat)
+	testing.expect(t, e == .None, "the fixture draw is valid")
+	app4.input.sel_node = -1
+	app4.input.sel_pipe = 0
+	app4.last_sel_pipe = -1 // force the selection diff
+	camera_set_selection(&app4)
+	testing.expect(t, !app4.pullback, "the pipe-selection focus yields the pullback (W3)")
+
+	// alerts-as-nav (crisis banner focus)
+	app5: App
+	pullback_test_app(&app5)
+	defer pp.run_destroy(&app5.state)
+	defer pp.catalogs_destroy(&app5.cat)
+	arm_pullback(&app5)
+	camera_focus_pair(&app5, app5.res_id, app5.rt_id)
+	testing.expect(t, !app5.pullback, "alerts-as-nav focus yields the pullback (W3)")
+
+	// ESC home
+	app6: App
+	pullback_test_app(&app6)
+	defer pp.run_destroy(&app6.state)
+	defer pp.catalogs_destroy(&app6.cat)
+	arm_pullback(&app6)
+	camera_set_fit(&app6)
+	testing.expect(t, !app6.pullback, "ESC home yields the pullback")
+
+	// the settings toggle
+	app7: App
+	pullback_test_app(&app7)
+	defer pp.run_destroy(&app7.state)
+	defer pp.catalogs_destroy(&app7.cat)
+	arm_pullback(&app7)
+	effect_settings_adjust(&app7, &app7.input, rnd.SETTINGS_ROW_PULLBACK, 0)
+	testing.expect(t, !app7.pullback && !app7.a11y.auto_pullback, "the settings toggle OFF ends an in-flight pullback")
+}
+
+@(test)
+effect_zoom_and_pan_respect_the_wheel_policy_and_modal :: proc(t: ^testing.T) {
+	// Perkins r2 B2: the composition-level routing — the wheel over the NOC
+	// panel scrolls-not-zooms, the settings modal blocks zoom + pan,
+	// elsewhere the wheel zooms (the pinned policy drives the effects).
+	app: App
+	pullback_test_app(&app)
+	defer pp.run_destroy(&app.state)
+	defer pp.catalogs_destroy(&app.cat) // N6
+	// the wheel elsewhere: zooms (delta -1 — the fixture sits at the 4.0 max,
+	// a +1 notch would clamp and look like a no-op)
+	before := app.cam_zoom_to
+	effect_zoom(&app, &app.input, -1, {100, 100})
+	testing.expect(t, app.cam_zoom_to != before, "a wheel off the panel zooms the map")
+	// the wheel over the NOC panel with the overlay on: scrolls-not-zooms
+	// (the scroll WRITE is PP_DEBUG-gated; the ROUTING — no zoom — is pinned
+	// in every build)
+	app.overlay_on = true
+	before = app.cam_zoom_to
+	effect_zoom(&app, &app.input, 1, {rnd.NOC_PANEL_X + 20, rnd.NOC_PANEL_Y + 20})
+	testing.expect(t, app.cam_zoom_to == before, "a wheel over the NOC panel never zooms (B2)")
+	// the settings modal blocks the zoom
+	app.input.panel_open = true
+	effect_zoom(&app, &app.input, 1, {100, 100})
+	testing.expect(t, app.cam_zoom_to == before, "the modal blocks the zoom")
+	// and the pan
+	nx, ny := app.cam_wx_to, app.cam_wy_to
+	effect_pan(&app, &app.input, 100, 0)
+	testing.expect(t, app.cam_wx_to == nx && app.cam_wy_to == ny, "the modal blocks the pan (B2)")
+}
+
+@(test)
+pullback_feed_ignores_attach_spawns :: proc(t: ^testing.T) {
+	app: App
+	pullback_test_app(&app)
+	defer pp.run_destroy(&app.state)
+	defer pp.catalogs_destroy(&app.cat) // N6
+
+	spawn_with_event(&app, {10, 14}) // 4 tiles from the estate — an ATTACH
+	pullback_feed(&app, app.state.events[:])
+	testing.expect(t, !app.pullback, "an ATTACH spawn never arms the pullback")
+	testing.expect(t, app.cam_zoom_to == 4.0, "the camera targets stay untouched")
+}
+
+@(test)
+pullback_feed_respects_the_toggle_and_the_already_visible_view :: proc(t: ^testing.T) {
+	app: App
+	pullback_test_app(&app)
+	defer pp.run_destroy(&app.state)
+	defer pp.catalogs_destroy(&app.cat) // N6
+
+	// toggle OFF: a SEED spawn changes nothing
+	app.a11y.auto_pullback = false
+	spawn_with_event(&app, {23, 10})
+	pullback_feed(&app, app.state.events[:])
+	testing.expect(t, !app.pullback && app.cam_zoom_to == 4.0, "the toggle OFF disables the pullback")
+	app.a11y.auto_pullback = true // the settings struct is the single source (N11)
+
+	// already visible: at the fit the whole world is in view — nothing to do
+	app.cam_zoom = 1.0
+	app.cam_zoom_to = 1.0
+	clear(&app.state.events)
+	spawn_with_event(&app, {23, 10})
+	pullback_feed(&app, app.state.events[:])
+	testing.expect(t, !app.pullback && app.cam_zoom_to == 1.0, "an in-view district holds the camera")
+}
+
+@(test)
+pullback_eases_no_snap_and_converges :: proc(t: ^testing.T) {
+	app: App
+	pullback_test_app(&app)
+	defer pp.run_destroy(&app.state)
+	defer pp.catalogs_destroy(&app.cat) // N6
+
+	spawn_with_event(&app, {23, 10})
+	pullback_feed(&app, app.state.events[:])
+	start := app.cam_zoom
+	target := app.cam_zoom_to
+	testing.expect(t, app.pullback && target < start, "the pullback armed")
+	// ONE frame: the zoom moves partway — a snap would land on the target
+	// immediately (the #82 no-snap doctrine)
+	camera_update(&app)
+	testing.expect(t, app.cam_zoom > target && app.cam_zoom < start, "frame 1 eases partway (no snap)")
+	// the ease rate is the pullback band: ~1-2 s at 60 fps — after 30 frames
+	// (0.5 s) the zoom has moved but NOT converged
+	for i in 0 ..< 30 {
+		camera_update(&app)
+	}
+	testing.expect(t, app.cam_zoom > target, "after 0.5 s the ease is still in flight (~1-2 s total)")
+	// and it converges: the pullback clears itself on arrival
+	for i in 0 ..< 600 {
+		camera_update(&app)
+	}
+	testing.expect(t, app.cam_zoom == app.cam_zoom_to, "the ease converges on the target")
+	testing.expect(t, !app.pullback, "the pullback clears on convergence")
+}
diff --git a/app/render/camera.odin b/app/render/camera.odin
new file mode 100644
index 00000000..89eb9247
--- /dev/null
+++ b/app/render/camera.odin
@@ -0,0 +1,232 @@
+package render
+
+// camera.odin — the interactive camera math (packet-plumber-v2-camera-zoom):
+// wheel zoom-to-point + drag pan, implemented on the 7.1 camera model (the
+// eased cam_zoom/cam_wx/cam_wy targets on App — camera_update derives the
+// view scale/off from them every frame; the harness pins the DEFAULT camera
+// by never running camera_update, so T2 goldens are byte-identical by
+// construction).
+//
+// This file holds ONLY the pure float math — no App, no View, no raylib
+// state — so the zoom anchor, the pan delta, and the bounds clamp are
+// pin-testable at the lowest layer (camera_test.odin). The app's effects
+// (main.odin effect_zoom/effect_pan) translate wheel/pan intents into these
+// helpers against the live camera targets.
+//
+// The transform the math serves (view_compute + camera_update):
+//   screen = win/2 + (world - center) * fit * zoom        (fit = the camera-fit
+//   scale — min(win_w/world_w, win_h/world_h); center = the camera's world
+//   position at the window center). All IEEE f32, no transcendentals (the
+//   §10.4 rasterized-path rule — the zoom factor is integer-notch
+//   multiplication, never a pow()).
+
+import pp "../../core"
+
+// CAM_ZOOM_MIN — the bird's-eye fit (zoom 1.0 = the current fit-to-window
+// view; the user directive's "out for the overall bird view of the city" —
+// the fit ALREADY frames the whole city, so 1.0 is the out-limit).
+CAM_ZOOM_MIN :: 1.0
+
+// CAM_ZOOM_MAX — enough to read individual nodes/links clearly: at 4.0x the
+// 26px design tile renders ~96px and a basic puck ~110px (sprite targets
+// scale with the camera; the 7.1 selection focus sits at 2.3/2.6 inside the
+// band). Higher zooms show sprite-pixel upscaling with no new information.
+CAM_ZOOM_MAX :: 4.0
+
+// CAM_ZOOM_STEP — the per-wheel-notch zoom factor (1.25 in, 0.8 out —
+// 4 notches ≈ 2.4x, the selection-focus band; wheel deltas are integral
+// notches in practice, so the step is integer-multiplication exact).
+CAM_ZOOM_STEP :: 1.25
+
+// camera_zoom_step — z scaled by one wheel notch of `delta` (positive = in).
+// Integer-notch exponential WITHOUT libm (repeated multiply — the §10.4
+// no-transcendentals rule; a fractional delta truncates to whole notches,
+// which is what raylib delivers per frame anyway).
+camera_zoom_step :: proc(z, delta: f32) -> f32 {
+	f := f32(1)
+	for d := i32(delta); d > 0; d -= 1 {
+		f *= CAM_ZOOM_STEP
+	}
+	for d := i32(delta); d < 0; d += 1 {
+		f /= CAM_ZOOM_STEP
+	}
+	return z * f
+}
+
+// camera_anchor_center — the camera center (world px) that pins the world
+// point `anchor_wx, anchor_wy` (the point under the cursor BEFORE the zoom)
+// to the cursor position `cursor_x, cursor_y` at the TARGET zoom `z_to`:
+//   center = anchor - (cursor - win_center) / (fit * z_to)
+// This is zoom-to-POINT (not zoom-to-center): the map region under the wheel
+// cursor stays put while the zoom scales around it. `fit` is the camera-fit
+// scale (min(win_w/world_w, win_h/world_h)); win_w/win_h are the window dims.
+camera_anchor_center :: proc(anchor_wx, anchor_wy, cursor_x, cursor_y, win_w, win_h, fit, z_to: f32) -> (f32, f32) {
+	s := fit * z_to
+	if s <= 0 {
+		return anchor_wx, anchor_wy
+	}
+	cx := anchor_wx - (cursor_x - win_w / 2) / s
+	cy := anchor_wy - (cursor_y - win_h / 2) / s
+	return cx, cy
+}
+
+// camera_pan_center — a screen-space drag delta (dx, dy px) mapped to a world
+// center delta at the CURRENT view scale (fit * z): dragging right by dx px
+// moves the content with the cursor — the center shifts LEFT by dx/scale
+// (screen = win/2 + (world - center)*scale ⇒ dcenter = -dscreen/scale).
+camera_pan_center :: proc(cx, cy, dx, dy, fit, z: f32) -> (f32, f32) {
+	s := fit * z
+	if s <= 0 {
+		return cx, cy
+	}
+	return cx - dx / s, cy - dy / s
+}
+
+// CAMERA_PULLBACK_EASE — the auto-pullback's eased approach rate (per-frame
+// exponential factor; the normal camera ease is 0.14 ≈ 0.5 s to converge).
+// 0.05 converges in ~90-120 frames ≈ 1.5-2 s at 60 fps — the ruling's
+// "~1-2s, no snap" band (the #82 motion doctrine: the pullback reads as a
+// deliberate camera breathe-out, never a cut).
+CAMERA_PULLBACK_EASE :: 0.05
+
+// camera_newest_terminals — map `n` NODE_SPAWNED events to the node ids
+// they belong to (Perkins r2 W4): the events are zero-payload, so the ids
+// are recovered from the topology — the n NEWEST live TERMINAL ids
+// (newest first). The kind filter is what makes the walk exact: growth
+// spawns are terminals ONLY (the 5.1 canon — "the player places every
+// router") and fast-path placements are junctions ONLY, so a router that
+// consumed an id between the spawn and the feed can never skew the mapping
+// (the old next_node_id-remaining walk-back pointed at the router and
+// silently skipped the real seed). Pure read of the topology.
+camera_newest_terminals :: proc(topo: ^pp.Topology, n: u32, ids: []u32) -> u32 {
+	found: u32 = 0
+	for id := topo.next_node_id; id > 0 && found < n; id -= 1 {
+		if int(found) >= len(ids) {
+			break
+		}
+		slot, ok := pp.node_slot(topo, id - 1)
+		if !ok || topo.node_kind[slot] != .Terminal {
+			continue
+		}
+		ids[found] = id - 1
+		found += 1
+	}
+	return found
+}
+
+// camera_spawn_is_seed — the derived SEED classification (the mid-flight
+// ruling: the pullback fires on growth SEED events). The NODE_SPAWNED event
+// is zero-payload, so the family is DERIVED on the view side: a spawned
+// terminal is a SEED iff it sits >= growth_groups.new_area_seed_tiles (the
+// data floor) from every OTHER live terminal — the exact mirror of the
+// core's own estate doctrine (growth_seed_sep_ok, minus the candidate
+// itself, which is live by the time the view sees it). The classification
+// is exact by the 08-21 strict doctrine: ATTACH spawns sit within
+// radius_tiles (5) of a member, SEED spawns >= new_area_seed_tiles (10) —
+// the gap leaves no third class. Pure read of (topology, catalog) — the
+// sim never sees this (ODN-1); deterministic (same spawn -> same family on
+// every path).
+//
+// `window_lo`/`window_hi` (half-open, node ids) exclude a SAME-WINDOW
+// sibling set from the distance test (Perkins r2 W7): the core classifies
+// a candidate at PLAN time (before its window siblings exist), while the
+// view classifies after the whole catch-up window landed — a younger
+// same-window attach (within 10 tiles of the seed) would otherwise flip a
+// genuine seed to attach and the pullback would be silently missed. The
+// feed passes the frame's spawn-id window; the exclusion restores the
+// plan-time view. (0,0) = no exclusion.
+camera_spawn_is_seed :: proc(topo: ^pp.Topology, cat: ^pp.Catalogs, node_id: u32, window_lo: u32 = 0, window_hi: u32 = 0) -> bool {
+	slot, ok := pp.node_slot(topo, node_id)
+	if !ok {
+		return false
+	}
+	if topo.node_kind[slot] != .Terminal {
+		return false // defensive — growth spawns terminals only
+	}
+	floor := i64(cat.balance.growth_groups.new_area_seed_tiles)
+	if floor < 1 {
+		return false // the core's fail-closed degenerate guard
+	}
+	d2 := floor * floor
+	pos := topo.node_pos[slot]
+	for i in 0 ..< len(topo.node_alive) {
+		if !topo.node_alive[i] || topo.node_kind[i] != .Terminal || i == int(slot) {
+			continue
+		}
+		if window_hi > window_lo && topo.node_id[i] >= window_lo && topo.node_id[i] < window_hi {
+			continue // a same-window sibling — invisible to the plan-time core
+		}
+		d := topo.node_pos[i] - pos
+		if i64(d[0]) * i64(d[0]) + i64(d[1]) * i64(d[1]) < d2 {
+			return false
+		}
+	}
+	return true
+}
+
+// camera_pullback_target — the auto-pullback's target (the mid-flight
+// ruling: "ease out just enough to include the new district, or to the
+// fit-view floor if beyond"). Given the new district's world position and
+// the CURRENT camera (center + zoom), returns the smallest zoom change that
+// brings the district inside the viewport with `margin` world px of padding
+// at the CURRENT center (the minimal intervention: the player keeps their
+// context, the district enters at the edge). The fit (1.0) is the floor —
+// at the fit the whole world rect is visible, so a clamp to the floor
+// always includes the district (the center pin does the rest). Returns
+// active=false when the district is already inside (no pullback needed).
+// Pure f32 math — no libm (the §10.4 rule).
+camera_pullback_target :: proc(
+	center_x, center_y, zoom, node_x, node_y, win_w, win_h, fit, margin, world_w, world_h: f32,
+) -> (z_to, cx_to, cy_to: f32, active: bool) {
+	if zoom <= 0 || fit <= 0 {
+		return zoom, center_x, center_y, false
+	}
+	dx := abs(node_x - center_x)
+	dy := abs(node_y - center_y)
+	half_w := (win_w / 2) / (fit * zoom)
+	half_h := (win_h / 2) / (fit * zoom)
+	if dx + margin <= half_w && dy + margin <= half_h {
+		return zoom, center_x, center_y, false // already included — nothing to pull back
+	}
+	// the largest zoom whose viewport holds the district with the margin
+	// (the tighter axis binds — the min of the two per-axis limits)
+	z_x := (win_w / 2) / (fit * (dx + margin))
+	z_y := (win_h / 2) / (fit * (dy + margin))
+	z_to = clamp(min(z_x, z_y), CAM_ZOOM_MIN, CAM_ZOOM_MAX)
+	// the fit floor: at 1.0 the full world rect is visible ONLY when the
+	// center pins to the world center — so the returned center runs through
+	// the bounds clamp at the TARGET zoom (Perkins r2 B1: an off-center
+	// camera floor-clamped to 1.0 would otherwise keep its off-center center
+	// and cut off a world band — the district could stay off-screen at the
+	// converged "fit", breaking the ruling's floor contract). At z_to=1.0
+	// the clamp pins both axes to the world center; at any z_to the clamp is
+	// a no-op for a zoom-out (the target half-extents are wider), so the
+	// "just enough to include" framing is preserved.
+	cx_to, cy_to = camera_clamp_center(center_x, center_y, win_w, win_h, fit, z_to, world_w, world_h)
+	if z_to >= zoom {
+		return zoom, center_x, center_y, false // the clamp already covers it
+	}
+	return z_to, cx_to, cy_to, true
+}
+
+// camera_clamp_center — keep the camera center inside the world rect at the
+// TARGET zoom (the zoomed-in view may never fly off into the paper void; the
+// visible half-extent is (win/2)/(fit*z) world px). When the viewport is
+// larger than the world (zoom near the 1.0 fit) the center pins to the world
+// center — pan is a no-op at the fit, exactly the briefing's min-zoom frame.
+camera_clamp_center :: proc(cx, cy, win_w, win_h, fit, z, world_w, world_h: f32) -> (f32, f32) {
+	nx, ny := cx, cy // Odin params are immutable — work on locals
+	half_w := (win_w / 2) / (fit * z)
+	half_h := (win_h / 2) / (fit * z)
+	if half_w >= world_w / 2 {
+		nx = world_w / 2
+	} else {
+		nx = clamp(nx, half_w, world_w - half_w)
+	}
+	if half_h >= world_h / 2 {
+		ny = world_h / 2
+	} else {
+		ny = clamp(ny, half_h, world_h - half_h)
+	}
+	return nx, ny
+}
diff --git a/app/render/camera_test.odin b/app/render/camera_test.odin
new file mode 100644
index 00000000..78819298
--- /dev/null
+++ b/app/render/camera_test.odin
@@ -0,0 +1,231 @@
+package render
+
+// camera_test.odin — the interactive-camera math pins (camera.odin). The
+// zoom anchor, the pan delta, and the bounds clamp are the load-bearing
+// geometry of the wheel-zoom/drag-pan story — pinned at the lowest layer so
+// a regression (e.g. a zoom that drifts off the cursor point, or a pan that
+// flies into the paper void) fails CI before Perkins ever sees it.
+
+import "core:testing"
+import rl "vendor:raylib"
+import pp "../../core"
+
+// TOL — the comparison slack (the anchor math is exact IEEE arithmetic; any
+// tolerance here just absorbs test-computation order — the invariants hold
+// to ~1e-4 even so).
+TOL :: 1e-3
+
+// FIT42 — the 1280×720 fit over the 40×30-tile / 26px world (the design
+// grid): min(1280/1040, 720/780).
+FIT42 :: f32(720.0 / 780.0)
+WORLD_W42 :: f32(1040)
+WORLD_H42 :: f32(780)
+
+@(test)
+camera_spawn_is_seed_classifies_the_estate_families :: proc(t: ^testing.T) {
