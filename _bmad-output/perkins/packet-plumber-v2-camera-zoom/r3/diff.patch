+@(test)
+settings_v1_file_loads_with_pullback_default_on :: proc(t: ^testing.T) {
+	// the pre-pullback format (version 1, 6 bytes): the a11y values load
+	// normally and auto_pullback takes the ruling's DEFAULT ON — an existing
+	// player's settings file must never reset their palette/motion/scale on
+	// upgrade.
+	path := tmp_settings_path(t)
+	defer os.remove(path)
+	buf := [6]u8{SETTINGS_MAGIC, 1, u8(rnd.Palette_Mode.Tritan), 1, 2, 0} // tritan + motion + 150%%
+	buf[5] = buf[2] + buf[3] + buf[4]
+	write_settings_bytes(path, buf[:])
+	got := settings_load_at(path)
+	testing.expect(t, got.palette == .Tritan && got.reduced_motion && got.scale_step == 2, "v1 a11y values load unchanged")
+	testing.expect(t, got.auto_pullback == true, "v1 files default auto-pullback ON (the MM default)")
+	// a corrupt v1 checksum still falls back
+	path2 := tmp_settings_path(t)
+	defer os.remove(path2)
+	buf2 := [6]u8{SETTINGS_MAGIC, 1, 0, 0, 0, 9}
+	write_settings_bytes(path2, buf2[:])
+	got2 := settings_load_at(path2)
+	testing.expect(t, got2 == DEFAULT_A11Y(), "a corrupt v1 checksum falls back to defaults")
+}
