+// --- v2-camera-zoom: the wheel-zoom + drag-pan input effects (view-layer
+// only — the camera is presentation state, ODN-1; the sim never sees a byte;
+// the harness pins the DEFAULT camera by never running camera_update, so T2
+// goldens are byte-identical by construction). The math lives in
+// app/render/camera.odin (pin-tested); these effects translate the raw
+// intents against the live camera targets.
+
+// camera_fit — the current camera-fit scale (min of the window/world ratios;
+// the same derivation view_compute + camera_update use — ONE source).
+camera_fit :: proc(v: ^rnd.View) -> f32 {
+	return min(f32(v.win_w)/v.world_w, f32(v.win_h)/v.world_h)
+}
+
+// effect_zoom — the wheel: zoom-to-point around the cursor, clamped to
+// [1.0 fit, 4.0]. The wheel-ownership POLICY is the pinned pure decision
+// (rnd.camera_wheel_policy — Perkins r2 B2): the NOC panel owns the wheel
+// while the pointer is over it (the drop log scrolls ONLY there), the
+// settings modal blocks the zoom, everywhere else the map zooms (the
+// release-build default). The NOC scroll write itself is PP_DEBUG-gated (the
+// overlay is a debug surface); the routing is NOT — the policy decides in
+// every build.
+effect_zoom :: proc(user: rawptr, ictx: ^inp.Input, delta: f32, pos: rl.Vector2) {
+	app := cast(^App)user
+	#partial switch rnd.camera_wheel_policy(app.overlay_on, app.input.panel_open, pos) {
+	case .Noc_Scroll:
+		when #config(PP_DEBUG, false) {
+			app.noc_scroll = max(0, app.noc_scroll - i32(delta))
+		}
+		return
+	case .Blocked:
+		return
+	case .Zoom:
+	}
+	camera_zoom_at(app, delta, pos)
+}
+
+// camera_zoom_at — wheel zoom-to-point: the world point under the cursor is
+// the anchor; the target zoom steps by CAM_ZOOM_STEP per notch (clamped to
+// the [CAM_ZOOM_MIN, CAM_ZOOM_MAX] band); the target center is re-anchored
+// so the cursor point stays put at the target zoom (the eased camera then
+// converges on the exact anchor — the 7.1 ease model). The anchor is
+// computed from the CURRENT transform (from_screen), so fast flicks anchor
+// against the live view and the converged frame holds the cursor point.
+camera_zoom_at :: proc(app: ^App, delta: f32, pos: rl.Vector2) {
+	v := &app.view
+	fit := camera_fit(v)
+	wx, wy := rnd.from_screen(v, pos.x, pos.y)
+	z_to := clamp(rnd.camera_zoom_step(app.cam_zoom_to, delta), rnd.CAM_ZOOM_MIN, rnd.CAM_ZOOM_MAX)
+	cx, cy := rnd.camera_anchor_center(wx, wy, pos.x, pos.y, f32(v.win_w), f32(v.win_h), fit, z_to)
+	cx, cy = rnd.camera_clamp_center(cx, cy, f32(v.win_w), f32(v.win_h), fit, z_to, v.world_w, v.world_h)
+	app.cam_zoom_to = z_to
+	app.cam_wx_to = cx
+	app.cam_wy_to = cy
+	app.pullback = false // the wheel owns the camera — a pullback yields to the player
+}
+
+// effect_pan — the drag-pan (mouse empty-ground drag via mouse_map's pan
+// branch, or the two-finger touch Pan intent — ONE executor, both devices).
+// The screen delta converts to a world center delta against the LIVE scale
+// (the current eased zoom — the same transform the player sees; Perkins r2
+// W5: the target zoom would mis-track mid-ease); the clamped target keeps
+// the viewport inside the world rect. The settings modal blocks it
+// (belt+braces: the mappings already suppress pan presses under the modal).
+effect_pan :: proc(user: rawptr, ictx: ^inp.Input, dx, dy: f32) {
+	app := cast(^App)user
+	if app.input.panel_open {
+		return
+	}
+	v := &app.view
+	fit := camera_fit(v)
+	nx, ny := rnd.camera_pan_center(app.cam_wx_to, app.cam_wy_to, dx, dy, fit, app.cam_zoom)
+	nx, ny = rnd.camera_clamp_center(nx, ny, f32(v.win_w), f32(v.win_h), fit, app.cam_zoom, v.world_w, v.world_h)
+	app.cam_wx_to = nx
+	app.cam_wy_to = ny
+	app.pullback = false // the pan owns the camera — a pullback yields to the player
+}
+
