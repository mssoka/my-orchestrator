+// pullback_test.odin — v2-camera-zoom (the mid-flight ruling): the MM-style
+// auto-pullback pins. The FEED chain (NODE_SPAWNED event -> derived SEED
+// family -> camera targets) is app-owned, so these tests drive the REAL
+// pullback_feed + camera_update against a minimal App (the settings_effect
+// precedent) — the seed/attach discrimination, the toggle, the already-
+// visible no-op, and the ~1-2 s no-snap ease (the #82 motion doctrine).
+//
+// The harness immunity (the ruling's hard rule) is BY CONSTRUCTION: the
+// pullback state lives ONLY on App (never the View), the feed runs only in
+// the app frame loop, and the harness capture path never calls it nor
+// camera_update — the 48/48 harness run proves the zero-drift claim.
+
+import "core:testing"
+import pp "../core"
+import rnd "./render"
+
+// pullback_test_app — the minimal fixture App: a 64x36-tile / 26px world
+// (the 1280x720 fit), a two-terminal estate at (10,10)+(13,10) + a router,
+// the camera zoomed 4x on the estate (a SEED at (23,10) sits far outside
+// the viewport). The caller owns the App + its Run_State.
+pullback_test_app :: proc(app: ^App) {
+	app^ = {}
+	// the catalog: the estate doctrine floor (10) + the node roster
+	app.cat.balance.map_w_tiles = 64
+	app.cat.balance.map_h_tiles = 36
+	app.cat.balance.tile_px = 26
+	app.cat.balance.growth_groups.new_area_seed_tiles = 10
+	append(&app.cat.node_types,
+		pp.Node_Type{id = "residential", display = "res", kind = .Terminal, terminal_role = .Residential, port_capacity = 0},
+		pp.Node_Type{id = "router_basic", display = "rt", kind = .Junction, port_capacity = 4},
+	)
+	append(&app.cat.pipe_tiers, pp.Pipe_Tier{id = "test", display = "test", max_span = 20, cost_per_tile = 1}) // the W8 pipe-select leg needs a valid draw
+	pp.run_init(&app.state, 42, app.cat.hash, 20)
+	ti, _ := pp.node_type_index(&app.cat, "residential")
+	ri, _ := pp.node_type_index(&app.cat, "router_basic")
+	app.res_id = pp.topology_spawn_node(&app.state.topology, ti, {10, 10}, &app.cat)
+	pp.topology_spawn_node(&app.state.topology, ti, {13, 10}, &app.cat)
+	app.rt_id = pp.topology_spawn_node(&app.state.topology, ri, {11, 14}, &app.cat)
+	rnd.view_compute(&app.view, 1280, 720, &app.cat.balance)
+	app.a11y.auto_pullback = true // the settings struct is the single source (N11)
+	// the camera: 4x on the estate's center (world px (260, 260))
+	app.cam_zoom = 4.0
+	app.cam_zoom_to = 4.0
+	app.cam_wx = 260
+	app.cam_wx_to = 260
+	app.cam_wy = 260
+	app.cam_wy_to = 260
+}
+
+// spawn_with_event — spawn a terminal + append the NODE_SPAWNED event the
+// growth director would have emitted for it (the feed's input slice).
+spawn_with_event :: proc(app: ^App, pos: [2]i32) -> u32 {
+	ti, _ := pp.node_type_index(&app.cat, "residential")
+	id := pp.topology_spawn_node(&app.state.topology, ti, pos, &app.cat)
+	append(&app.state.events, pp.Event{tick = app.tick, tag = pp.EVENT_TAG_NODE_SPAWNED})
+	return id
+}
+
+// place_router — a fast-path router placement (W4: consumes a node id with
+// NO spawn event — the junction that used to skew the walk-back).
+place_router :: proc(app: ^App, pos: [2]i32) -> u32 {
+	ti, _ := pp.node_type_index(&app.cat, "router_basic")
+	return pp.topology_spawn_node(&app.state.topology, ti, pos, &app.cat)
+}
