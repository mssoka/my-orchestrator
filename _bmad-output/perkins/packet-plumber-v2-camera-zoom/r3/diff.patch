+	outside := rl.Vector2{100, 100}
+	// the overlay on + pointer over the panel -> the drop log scrolls
+	testing.expect(t, camera_wheel_policy(true, false, inside) == .Noc_Scroll, "overlay on + over the panel -> scroll")
+	// the overlay on + pointer elsewhere -> the map zooms
