+camera_wheel_policy_pins_the_ownership_decision :: proc(t: ^testing.T) {
+	// Perkins r2 B2: the wheel-ownership POLICY is a pure decision — one
+	// tested source for the PP_DEBUG scroll branch AND the release always-
+	// zoom default.
