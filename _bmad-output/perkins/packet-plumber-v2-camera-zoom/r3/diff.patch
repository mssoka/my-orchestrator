+// pullback_feed — the auto-pullback trigger (the mid-flight ruling): scan
+// this frame's NEW event slice (the spawn_fx/audio-mark discipline — the
+// buffer is never drained, the 4.2 tripwire) for NODE_SPAWNED events, derive
+// the growth family (camera_spawn_is_seed — the zero-payload event's family
+// is a pure function of the topology, the exact mirror of the core's estate
+// doctrine), and on a SEED ease the camera out just enough to include the
+// new district (camera_pullback_target — the fit-view floor if beyond).
+// View-layer only: the camera targets are presentation state (ODN-1); the
+// sim, the action log, and the T1 hashes never see a byte. THE HARNESS
+// IMMUNITY (the hard rule): this feed lives on the App and runs only in the
+// app's frame loop — the harness capture path never calls it (nor
+// camera_update), so the default camera stays pinned and T2 goldens stay
+// byte-identical (proven by the 48/48 harness run, not asserted here).
+pullback_feed :: proc(app: ^App, events: []pp.Event) {
+	// N11 (Perkins r2): the settings struct is the single source of the
+	// toggle — App has no mirrored field to drift.
+	if !app.a11y.auto_pullback {
+		return
+	}
+	n_spawns: u32 = 0
+	for e in events {
+		if e.tag == pp.EVENT_TAG_NODE_SPAWNED {
+			n_spawns += 1
+		}
+	}
+	if n_spawns == 0 {
+		return
+	}
+	v := &app.view
+	fit := camera_fit(v)
+	margin := 2 * v.tile_px // the district's readable padding (2 design tiles)
+	// W4 (Perkins r2): the event -> id mapping is the terminal-filtered
+	// newest-first walk (camera_newest_terminals — growth spawns are
+	// terminals only, placements are junctions only, so the kind filter is
+	// exact; the old next_node_id - remaining walk-back was skewed by a
+	// router placement sharing the frame and silently skipped the seed).
+	// The walk returns newest-first; the events are oldest-first, so event i
+	// maps to ids[n_spawns - 1 - i].
+	ids: [8]u32
+	found := rnd.camera_newest_terminals(&app.state.topology, n_spawns, ids[:])
+	if found != n_spawns {
+		return // defensive — every spawn event has a live terminal by construction
+	}
+	// W7: the same-window ids (the whole frame's spawn set) are excluded from
+	// the SEED test — the core classified each at plan time, before its
+	// window siblings existed.
+	window_lo := ids[n_spawns - 1]
+	window_hi := ids[0] + 1
+	spawn_i: u32 = 0
+	for e in events {
+		if e.tag != pp.EVENT_TAG_NODE_SPAWNED {
+			continue
+		}
+		id := ids[n_spawns - 1 - spawn_i]
+		spawn_i += 1
+		if !rnd.camera_spawn_is_seed(&app.state.topology, &app.cat, id, window_lo, window_hi) {
+			continue
+		}
+		slot, ok := pp.node_slot(&app.state.topology, id)
+		if !ok {
+			continue
+		}
+		pos := app.state.topology.node_pos[slot]
+		nx := f32(pos[0]) * v.tile_px
+		ny := f32(pos[1]) * v.tile_px
+		z_to, cx_to, cy_to, active := rnd.camera_pullback_target(
+			app.cam_wx, app.cam_wy, app.cam_zoom,
+			nx, ny, f32(v.win_w), f32(v.win_h), fit, margin, v.world_w, v.world_h)
+		if !active {
+			continue // the district is already in view — nothing to pull back
+		}
+		// B1 (Perkins r2): the target center is CLAMPED at the target zoom
+		// inside camera_pullback_target (the fit floor pins the world center)
+		// — the assigned targets are always converged-valid.
+		app.cam_zoom_to = z_to
+		app.cam_wx_to = cx_to
+		app.cam_wy_to = cy_to
+		app.pullback = true
+	}
+}
