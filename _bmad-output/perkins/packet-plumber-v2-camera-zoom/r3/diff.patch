+@(test)
+settings_pullback_byte_round_trips_and_validates :: proc(t: ^testing.T) {
+	// the v2 byte: OFF round-trips OFF (the default is ON — an explicit off
+	// must persist)
+	path := tmp_settings_path(t)
+	defer os.remove(path)
+	settings_save_at(path, A11y_Settings{auto_pullback = false})
+	got := settings_load_at(path)
+	testing.expect(t, got.auto_pullback == false, "an explicit pullback OFF round-trips")
+	// ON round-trips ON
+	path2 := tmp_settings_path(t)
+	defer os.remove(path2)
+	settings_save_at(path2, A11y_Settings{auto_pullback = true})
+	got2 := settings_load_at(path2)
+	testing.expect(t, got2.auto_pullback == true, "pullback ON round-trips")
+	// an out-of-range pullback byte falls back to DEFAULTS (ON)
+	path3 := tmp_settings_path(t)
+	defer os.remove(path3)
+	buf := [7]u8{SETTINGS_MAGIC, SETTINGS_VERSION, 0, 0, 0, 7, 0} // pullback 7 != 0/1
+	buf[6] = buf[2] + buf[3] + buf[4] + buf[5]
+	write_settings_bytes(path3, buf[:])
+	got3 := settings_load_at(path3)
+	testing.expect(t, got3 == DEFAULT_A11Y(), "an out-of-range pullback byte must fall back to defaults")
+	// W6 (Perkins r2): MIXED corruption with a VALID pullback=0 byte — the
+	// pullback applies only after EVERY validation, so any corrupt sibling
+	// byte falls back to defaults IN FULL (never defaults-except-pullback)
+	path4 := tmp_settings_path(t)
+	defer os.remove(path4)
+	buf4 := [7]u8{SETTINGS_MAGIC, SETTINGS_VERSION, 0, 0, 9, 0, 0} // scale 9 OOR + pullback 0 (valid)
+	buf4[6] = buf4[2] + buf4[3] + buf4[4] + buf4[5]
+	write_settings_bytes(path4, buf4[:])
+	got4 := settings_load_at(path4)
+	testing.expect(t, got4 == DEFAULT_A11Y(), "mixed corruption falls back to defaults in full (pullback included)")
+}
