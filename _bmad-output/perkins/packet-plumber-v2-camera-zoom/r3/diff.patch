+package input
+
+// camera_input_test.odin — v2-camera-zoom: the input-layer pins for the wheel
+// zoom + drag-pan wiring (the chain mouse_map -> intent -> executor -> effect
+// hook). The noc_key_test precedent: drive the REAL pipeline
+// (dispatch_frame: mouse_map -> execute_all) with scripted Device_Events and
+// assert the effects fire with the exact payloads — plus the two gesture
+// CONFLICT pins that the briefing gates on: a pan never starts a draw and a
+// pan release never click-selects, while a node press still draws and a
+// plain click still selects (the 5.5 surface survives).
+
+import "core:testing"
+import rl "vendor:raylib"
+import pp "../../core"
+import rnd "../render"
+
+// cam_test_events — the recording hooks (the effect-hook contract: counters
+// via `user`, no package globals). Pan records the summed screen delta; Zoom
+// records the notch count + the anchor.
+cam_test_effects :: struct {
+	pans:   int,
+	pan_dx: f32,
+	pan_dy: f32,
+	zooms:  int,
+	zoom_d: f32,
+	zoom_x: f32,
+	zoom_y: f32,
+}
+
+cam_test_on_pan :: proc(user: rawptr, inp: ^Input, dx, dy: f32) {
+	rec := cast(^cam_test_effects)user
+	rec.pans += 1
+	rec.pan_dx += dx
+	rec.pan_dy += dy
+}
+
+cam_test_on_zoom :: proc(user: rawptr, inp: ^Input, delta: f32, pos: rl.Vector2) {
+	rec := cast(^cam_test_effects)user
+	rec.zooms += 1
+	rec.zoom_d = delta
+	rec.zoom_x = pos.x
+	rec.zoom_y = pos.y
+}
+
+// cam_test_ctx — the shared fixture: a 3-node topology (the wire_test_topo
+// shape) + a FIT view over a 64x36-tile / 26px world (1280x720 fits it
+// exactly — off_x/off_y = 0, scale = 720/936). Node 0 (residential) at screen
+// (160, 300), node 1 (the router) at (280, 300); (600, 600) is empty ground
+// far from every snap radius. The caller owns every buffer (the exec_test
+// pattern — no returned copies).
+cam_test_ctx :: proc(t: ^testing.T, ictx: ^Input, cat: ^pp.Catalogs, st: ^pp.Run_State, log: ^[dynamic]pp.Command, rec: ^cam_test_effects) {
+	wire_test_cat(cat)
+	cat.balance.tile_px = 26
+	pp.run_init(st, 42, cat.hash, TEST_LOGIC_HZ)
+	wire_test_topo(&st.topology, cat)
+	ictx.topo = &st.topology
+	ictx.cat = cat
+	ictx.log = log
+	ictx.tick = 0
+	ictx.view = new(rnd.View)
+	ictx.view.catalogs = cat // tray_chip_count/rect read it (the release_ui_hit path)
+	rnd.view_compute(ictx.view, 1280, 720, &cat.balance)
+	ictx.user = rec
+	ictx.on_pan = cam_test_on_pan
+	ictx.on_zoom = cam_test_on_zoom
+	init(ictx)
+	testing.expect(t, ictx.view.scale > 0.7 && ictx.view.scale < 0.8, "the fixture fit scale")
+}
+
+@(test)
+wheel_zoom_maps_through_the_intent_chain :: proc(t: ^testing.T) {
+	cat_storage: pp.Catalogs
+	st: pp.Run_State
+	log: [dynamic]pp.Command
+	rec: cam_test_effects
+	ictx: Input
+	cam_test_ctx(t, &ictx, &cat_storage, &st, &log, &rec)
+	defer destroy(&ictx)
+	defer pp.run_destroy(&st)
+	defer pp.catalogs_destroy(&cat_storage) // N6
+	defer delete(log)
+
+	// the same Mouse_Wheel the poll emits for a real +3-notch flick at an
+	// off-center anchor
+	dispatch_frame(&ictx, []Device_Event{Device_Event(Mouse_Wheel{delta = 3, pos = {900, 360}})})
+	testing.expect(t, rec.zooms == 1, "wheel -> Zoom -> on_zoom fires")
+	testing.expect(t, rec.zoom_d == 3, "the notch delta is carried verbatim")
+	testing.expect(t, rec.zoom_x == 900 && rec.zoom_y == 360, "the anchor position is carried verbatim")
+	testing.expect(t, len(log) == 0, "a zoom produces no commands (view-layer only)")
+}
+
+@(test)
+empty_ground_drag_pans_and_never_selects_or_draws :: proc(t: ^testing.T) {
+	cat_storage: pp.Catalogs
+	st: pp.Run_State
+	log: [dynamic]pp.Command
+	rec: cam_test_effects
+	ictx: Input
+	cam_test_ctx(t, &ictx, &cat_storage, &st, &log, &rec)
+	defer destroy(&ictx)
+	defer pp.run_destroy(&st)
+	defer pp.catalogs_destroy(&cat_storage) // N6
+	defer delete(log)
+
+	// N3 (Perkins r2): the "panned release never click-selects" claim needs
+	// a PRE-EXISTING selection to be non-vacuous — select the router first
+	// (a 2-frame click), then pan, and assert the selection SURVIVES.
+	dispatch_frame(&ictx, []Device_Event{Device_Event(Mouse_Press{pos = {280, 300}, button = .Left})})
+	dispatch_frame(&ictx, []Device_Event{Device_Event(Mouse_Move{pos = {280, 300}}), Device_Event(Mouse_Release{pos = {280, 300}, button = .Left})})
+	testing.expect(t, ictx.sel_node == 1, "the router is selected first")
+
+	// frame 1: the press on empty ground (no node snapped -> the pan latch)
+	dispatch_frame(&ictx, []Device_Event{Device_Event(Mouse_Press{pos = {600, 600}, button = .Left})})
+	testing.expect(t, ictx.panning, "an empty-ground press arms the pan latch")
+	testing.expect(t, !ictx.drag.active, "an empty-ground press never starts a draw")
+	// frame 2: the drag move (screen delta vs the press anchor)
+	dispatch_frame(&ictx, []Device_Event{Device_Event(Mouse_Move{pos = {750, 550}})})
+	testing.expect(t, rec.pans == 1 && rec.pan_dx == 150 && rec.pan_dy == -50, "the move becomes a Pan intent with the exact screen delta")
+	// frame 3: the release closes the latch
+	dispatch_frame(&ictx, []Device_Event{Device_Event(Mouse_Release{pos = {750, 550}, button = .Left})})
+	testing.expect(t, !ictx.panning, "the release closes the pan latch")
+	testing.expect(t, len(log) == 0, "the pan produced no commands")
+	testing.expect(t, ictx.sel_node == 1, "a panned release never click-selects (the selection survives — N3)")
+}
+
+@(test)
+plain_click_still_selects_through_the_pan_surface :: proc(t: ^testing.T) {
+	cat_storage: pp.Catalogs
+	st: pp.Run_State
+	log: [dynamic]pp.Command
+	rec: cam_test_effects
+	ictx: Input
+	cam_test_ctx(t, &ictx, &cat_storage, &st, &log, &rec)
+	defer destroy(&ictx)
+	defer pp.run_destroy(&st)
+	defer pp.catalogs_destroy(&cat_storage) // N6
+	defer delete(log)
+
+	// click the router (a 2-frame click: press, then release at the same pos)
+	dispatch_frame(&ictx, []Device_Event{Device_Event(Mouse_Press{pos = {280, 300}, button = .Left})})
+	// a node press -> Begin_Draw (no pan latch)
+	testing.expect(t, ictx.drag.active, "a node press still starts the draw drag")
+	testing.expect(t, !ictx.panning, "a node press never arms the pan")
+	dispatch_frame(&ictx, []Device_Event{Device_Event(Mouse_Move{pos = {280, 300}}), Device_Event(Mouse_Release{pos = {280, 300}, button = .Left})})
+	// the drag branch commits-or-selects: no move past the threshold -> select
+	testing.expect(t, ictx.sel_node == 1, "the click on the router selects it (the 5.5 surface survives)")
+	// then a plain click on empty ground (2 frames, no movement) deselects
+	dispatch_frame(&ictx, []Device_Event{Device_Event(Mouse_Press{pos = {600, 600}, button = .Left})})
+	testing.expect(t, ictx.panning, "the empty press arms the pan again")
+	dispatch_frame(&ictx, []Device_Event{Device_Event(Mouse_Move{pos = {600, 600}}), Device_Event(Mouse_Release{pos = {600, 600}, button = .Left})})
+	testing.expect(t, !ictx.panning, "the release closes the latch")
+	testing.expect(t, ictx.sel_node == -1, "a click (no movement) on empty ground still deselects — the pan gate never eats a click")
+	testing.expect(t, rec.pans == 2 && rec.pan_dx == 0 && rec.pan_dy == 0, "the click frames emit only zero-delta pans (the per-frame move + the trailing release)")
+}
+
+@(test)
+draw_drag_on_a_node_never_pans :: proc(t: ^testing.T) {
+	cat_storage: pp.Catalogs
+	st: pp.Run_State
+	log: [dynamic]pp.Command
+	rec: cam_test_effects
+	ictx: Input
+	cam_test_ctx(t, &ictx, &cat_storage, &st, &log, &rec)
+	defer destroy(&ictx)
+	defer pp.run_destroy(&st)
+	defer pp.catalogs_destroy(&cat_storage) // N6
+	defer delete(log)
+
+	// press node 0 (residential, screen (160, 300)) then drag to node 1
+	// (280, 300) and release — a REAL draw gesture: the drag branch owns it.
+	dispatch_frame(&ictx, []Device_Event{Device_Event(Mouse_Press{pos = {160, 300}, button = .Left})})
+	dispatch_frame(&ictx, []Device_Event{Device_Event(Mouse_Move{pos = {280, 300}})})
+	dispatch_frame(&ictx, []Device_Event{Device_Event(Mouse_Release{pos = {280, 300}, button = .Left})})
+	testing.expect(t, rec.pans == 0, "a node-anchored draw never pans")
+	testing.expect(t, len(log) == 1, "the draw committed exactly one command")
+}
+
+@(test)
+two_finger_pan_delivers_the_exact_screen_deltas :: proc(t: ^testing.T) {
+	// Perkins r2 W9: the touch pan POSITIVE pin — deleting touch.odin's Pan
+	// emission (or the executor's routing) must fail here.
+	cat_storage: pp.Catalogs
+	st: pp.Run_State
+	log: [dynamic]pp.Command
+	rec: cam_test_effects
+	ictx: Input
+	cam_test_ctx(t, &ictx, &cat_storage, &st, &log, &rec)
+	defer destroy(&ictx)
+	defer pp.run_destroy(&st)
+	defer pp.catalogs_destroy(&cat_storage) // N6
+	defer delete(log)
+
+	dispatch_frame(&ictx, []Device_Event{Device_Event(Two_Finger_Pan{dx = 12, dy = -4})})
+	dispatch_frame(&ictx, []Device_Event{Device_Event(Two_Finger_Pan{dx = 8, dy = -2})})
+	testing.expect(t, rec.pans == 2, "each two-finger pan frame reaches on_pan")
+	testing.expect(t, rec.pan_dx == 20 && rec.pan_dy == -6, "the exact screen deltas arrive (12-4 then 8-2)")
+	testing.expect(t, len(log) == 0, "a touch pan produces no commands")
+}
+
+@(test)
+wheel_accumulate_fires_whole_notches_from_fractional_deltas :: proc(t: ^testing.T) {
+	// Perkins r2 W2: smooth trackpads deliver fractional per-frame deltas —
+	// the residue must accumulate and fire whole notches (a plain truncation
+	// starves slow scrolling forever).
+	n, r := wheel_accumulate(0, 0.3)
+	testing.expect(t, n == 0 && abs(r - 0.3) < 1e-4, "0.3 accumulates, no notch yet")
+	n, r = wheel_accumulate(r, 0.3)
+	testing.expect(t, n == 0 && abs(r - 0.6) < 1e-4, "0.6 accumulates")
+	n, r = wheel_accumulate(r, 0.3)
+	testing.expect(t, n == 0 && abs(r - 0.9) < 1e-4, "0.9 accumulates")
+	n, r = wheel_accumulate(r, 0.3)
+	testing.expect(t, n == 1 && abs(r - 0.2) < 1e-4, "1.2 fires ONE notch, keeps the residue")
+	// a fast flick: one big delta fires multiple notches in one frame
+	n, r = wheel_accumulate(0, 4)
+	testing.expect(t, n == 4 && r == 0, "a +4 flick fires four notches")
+	// negative (scroll down) accumulates symmetrically
+	n, r = wheel_accumulate(0, -0.4)
+	n, r = wheel_accumulate(r, -0.4)
+	n, r = wheel_accumulate(r, -0.4)
+	testing.expect(t, n == -1 && abs(r + 0.2) < 1e-4, "-1.2 fires ONE negative notch")
+	n, r = wheel_accumulate(0, -3)
+	testing.expect(t, n == -3 && r == 0, "a -3 flick fires three notches")
+}
+
+@(test)
+pan_latch_lifecycle_pins_stale_guard_and_modal_clear :: proc(t: ^testing.T) {
+	// Perkins r2 W10 + W1: the stale-latch predicate + the lifecycle
+	// transitions (release closes, begin_draw clears, the settings modal
+	// clears).
+	testing.expect(t, !pan_latch_stale(false, false), "no latch, no guard")
+	testing.expect(t, !pan_latch_stale(false, true), "no latch, button down")
+	testing.expect(t, !pan_latch_stale(true, true), "latched + button down: the pan is live")
