+// is a pure function of the topology, the exact mirror of the core's estate
+// doctrine), and on a SEED ease the camera out just enough to include the
+// new district (camera_pullback_target — the fit-view floor if beyond).
+// View-layer only: the camera targets are presentation state (ODN-1); the
+// sim, the action log, and the T1 hashes never see a byte. THE HARNESS
+// IMMUNITY (the hard rule): this feed lives on the App and runs only in the
+// app's frame loop — the harness capture path never calls it (nor
+// camera_update), so the default camera stays pinned and T2 goldens stay
+// byte-identical (proven by the 48/48 harness run, not asserted here).
+pullback_feed :: proc(app: ^App, events: []pp.Event) {
+	if !app.auto_pullback {
+		return
+	}
+	n_spawns: u32 = 0
+	for e in events {
+		if e.tag == pp.EVENT_TAG_NODE_SPAWNED {
+			n_spawns += 1
+		}
+	}
+	if n_spawns == 0 {
+		return
+	}
+	v := &app.view
+	fit := camera_fit(v)
+	margin := 2 * v.tile_px // the district's readable padding (2 design tiles)
+	// newest-first walk-back (the spawn_fx precedent): the LAST spawn event
+	// in the slice is the newest node (next_node_id-1); a SEED retargets the
+	// pullback (a catch-up burst keeps the newest district; the eased camera
+	// converges on the last trigger).
+	remaining := n_spawns
+	for e in events {
+		if e.tag != pp.EVENT_TAG_NODE_SPAWNED {
+			continue
+		}
+		id := app.state.topology.next_node_id - remaining
+		remaining -= 1
+		if !rnd.camera_spawn_is_seed(&app.state.topology, &app.cat, id) {
+			continue
+		}
+		slot, ok := pp.node_slot(&app.state.topology, id)
+		if !ok {
+			continue
+		}
+		pos := app.state.topology.node_pos[slot]
+		nx := f32(pos[0]) * v.tile_px
+		ny := f32(pos[1]) * v.tile_px
+		z_to, cx_to, cy_to, active := rnd.camera_pullback_target(
+			app.cam_wx, app.cam_wy, app.cam_zoom,
+			nx, ny, f32(v.win_w), f32(v.win_h), fit, margin, v.world_w, v.world_h)
+		if !active {
+			continue // the district is already in view — nothing to pull back
+		}
+		app.cam_zoom_to = z_to
+		app.cam_wx_to = cx_to
+		app.cam_wy_to = cy_to
+		app.pullback = true
+	}
+}
+
+// --- v2-camera-zoom: the wheel-zoom + drag-pan input effects (view-layer
+// only — the camera is presentation state, ODN-1; the sim never sees a byte;
+// the harness pins the DEFAULT camera by never running camera_update, so T2
+// goldens are byte-identical by construction). The math lives in
+// app/render/camera.odin (pin-tested); these effects translate the raw
+// intents against the live camera targets.
+
+// camera_fit — the current camera-fit scale (min of the window/world ratios;
+// the same derivation view_compute + camera_update use — ONE source).
+camera_fit :: proc(v: ^rnd.View) -> f32 {
+	return min(f32(v.win_w)/v.world_w, f32(v.win_h)/v.world_h)
+}
+
+// effect_zoom — the wheel: zoom-to-point around the cursor, clamped to
+// [1.0 fit, 4.0]. The NOC panel owns the wheel while the pointer is over it
+// (the drop log scrolls ONLY there — the briefing's wheel-ownership rule;
+// the old render block's unconditional wheel read is folded into this
+// branch). The settings modal blocks the zoom (it owns the surface); the
+// NOC scroll is deliberately checked FIRST so the debug log keeps scrolling
+// under the modal exactly like the old render block.
+effect_zoom :: proc(user: rawptr, ictx: ^inp.Input, delta: f32, pos: rl.Vector2) {
+	app := cast(^App)user
+	when #config(PP_DEBUG, false) {
+		if app.overlay_on && rnd.noc_panel_hit(pos) {
+			app.noc_scroll = max(0, app.noc_scroll - i32(delta))
+			return
+		}
+	}
+	if app.input.panel_open {
+		return
+	}
+	camera_zoom_at(app, delta, pos)
+}
+
+// camera_zoom_at — wheel zoom-to-point: the world point under the cursor is
+// the anchor; the target zoom steps by CAM_ZOOM_STEP per notch (clamped to
+// the [CAM_ZOOM_MIN, CAM_ZOOM_MAX] band); the target center is re-anchored
+// so the cursor point stays put at the target zoom (the eased camera then
+// converges on the exact anchor — the 7.1 ease model). The anchor is
+// computed from the CURRENT transform (from_screen), so fast flicks anchor
+// against the live view and the converged frame holds the cursor point.
+camera_zoom_at :: proc(app: ^App, delta: f32, pos: rl.Vector2) {
+	v := &app.view
+	fit := camera_fit(v)
+	wx, wy := rnd.from_screen(v, pos.x, pos.y)
+	z_to := clamp(rnd.camera_zoom_step(app.cam_zoom_to, delta), rnd.CAM_ZOOM_MIN, rnd.CAM_ZOOM_MAX)
+	cx, cy := rnd.camera_anchor_center(wx, wy, pos.x, pos.y, f32(v.win_w), f32(v.win_h), fit, z_to)
+	cx, cy = rnd.camera_clamp_center(cx, cy, f32(v.win_w), f32(v.win_h), fit, z_to, v.world_w, v.world_h)
+	app.cam_zoom_to = z_to
+	app.cam_wx_to = cx
+	app.cam_wy_to = cy
+	app.pullback = false // the wheel owns the camera — a pullback yields to the player
+}
+
+// effect_pan — the drag-pan (mouse empty-ground drag via mouse_map's pan
+// branch, or the two-finger touch Pan intent — ONE executor, both devices).
+// The screen delta converts to a world center delta against the live scale;
+// the clamped target keeps the viewport inside the world rect (the fit
+// pins the center — pan is a no-op at the min zoom, by the clamp's
+// construction). The settings modal blocks it (belt+braces: the mappings
+// already suppress pan presses under the modal).
+effect_pan :: proc(user: rawptr, ictx: ^inp.Input, dx, dy: f32) {
+	app := cast(^App)user
+	if app.input.panel_open {
+		return
+	}
+	v := &app.view
+	fit := camera_fit(v)
+	nx, ny := rnd.camera_pan_center(app.cam_wx_to, app.cam_wy_to, dx, dy, fit, app.cam_zoom_to)
+	nx, ny = rnd.camera_clamp_center(nx, ny, f32(v.win_w), f32(v.win_h), fit, app.cam_zoom_to, v.world_w, v.world_h)
+	app.cam_wx_to = nx
+	app.cam_wy_to = ny
+	app.pullback = false // the pan owns the camera — a pullback yields to the player
+}
+
 // banner_y — the crisis banner's top edge (below the health meter card when
 // the meter is live). Shared by the HUD draw + the alerts-as-nav hit-test.
 banner_y :: proc(app: ^App) -> i32 {
diff --git a/app/pullback_test.odin b/app/pullback_test.odin
new file mode 100644
index 00000000..afb77c36
--- /dev/null
+++ b/app/pullback_test.odin
@@ -0,0 +1,143 @@
+package main
+
+// pullback_test.odin — v2-camera-zoom (the mid-flight ruling): the MM-style
+// auto-pullback pins. The FEED chain (NODE_SPAWNED event -> derived SEED
+// family -> camera targets) is app-owned, so these tests drive the REAL
+// pullback_feed + camera_update against a minimal App (the settings_effect
+// precedent) — the seed/attach discrimination, the toggle, the already-
+// visible no-op, and the ~1-2 s no-snap ease (the #82 motion doctrine).
+//
+// The harness immunity (the ruling's hard rule) is BY CONSTRUCTION: the
+// pullback state lives ONLY on App (never the View), the feed runs only in
+// the app frame loop, and the harness capture path never calls it nor
+// camera_update — the 48/48 harness run proves the zero-drift claim.
+
+import "core:testing"
+import pp "../core"
+import rnd "./render"
+
+// pullback_test_app — the minimal fixture App: a 64x36-tile / 26px world
+// (the 1280x720 fit), a two-terminal estate at (10,10)+(13,10) + a router,
+// the camera zoomed 4x on the estate (a SEED at (23,10) sits far outside
+// the viewport). The caller owns the App + its Run_State.
+pullback_test_app :: proc(app: ^App) {
+	app^ = {}
+	// the catalog: the estate doctrine floor (10) + the node roster
+	app.cat.balance.map_w_tiles = 64
+	app.cat.balance.map_h_tiles = 36
+	app.cat.balance.tile_px = 26
+	app.cat.balance.growth_groups.new_area_seed_tiles = 10
+	append(&app.cat.node_types,
+		pp.Node_Type{id = "residential", display = "res", kind = .Terminal, terminal_role = .Residential, port_capacity = 0},
+		pp.Node_Type{id = "router_basic", display = "rt", kind = .Junction, port_capacity = 4},
+	)
+	pp.run_init(&app.state, 42, app.cat.hash, 20)
+	ti, _ := pp.node_type_index(&app.cat, "residential")
+	ri, _ := pp.node_type_index(&app.cat, "router_basic")
+	pp.topology_spawn_node(&app.state.topology, ti, {10, 10}, &app.cat)
+	pp.topology_spawn_node(&app.state.topology, ti, {13, 10}, &app.cat)
+	pp.topology_spawn_node(&app.state.topology, ri, {11, 14}, &app.cat)
+	rnd.view_compute(&app.view, 1280, 720, &app.cat.balance)
+	app.auto_pullback = true
+	// the camera: 4x on the estate's center (world px (260, 260))
+	app.cam_zoom = 4.0
+	app.cam_zoom_to = 4.0
+	app.cam_wx = 260
+	app.cam_wx_to = 260
+	app.cam_wy = 260
+	app.cam_wy_to = 260
+}
+
+// spawn_with_event — spawn a terminal + append the NODE_SPAWNED event the
+// growth director would have emitted for it (the feed's input slice).
+spawn_with_event :: proc(app: ^App, pos: [2]i32) -> u32 {
+	ti, _ := pp.node_type_index(&app.cat, "residential")
+	id := pp.topology_spawn_node(&app.state.topology, ti, pos, &app.cat)
+	append(&app.state.events, pp.Event{tick = app.tick, tag = pp.EVENT_TAG_NODE_SPAWNED})
+	return id
+}
+
+@(test)
+pullback_feed_triggers_on_a_seed_spawn :: proc(t: ^testing.T) {
+	app: App
+	pullback_test_app(&app)
+	defer pp.run_destroy(&app.state)
+
+	spawn_with_event(&app, {23, 10}) // >= 10 tiles from every terminal — a fresh area
+	pullback_feed(&app, app.state.events[:])
+	testing.expect(t, app.pullback, "a SEED spawn arms the pullback")
+	testing.expect(t, app.cam_zoom_to < 4.0, "the pullback eases OUT (zoom target drops)")
+	testing.expect(t, app.cam_zoom_to >= 1.0, "the target stays inside the fit floor")
+	// the "just enough" contract: the district + margin fits the TARGET
+	// viewport (the converged frame includes it)
+	fit := camera_fit(&app.view)
+	half_w := (f32(app.view.win_w) / 2) / (fit * app.cam_zoom_to)
+	half_h := (f32(app.view.win_h) / 2) / (fit * app.cam_zoom_to)
+	dx := abs(f32(23) * app.view.tile_px - app.cam_wx_to)
+	dy := abs(f32(10) * app.view.tile_px - app.cam_wy_to)
+	margin := 2 * app.view.tile_px
+	testing.expect(t, dx + margin <= half_w + 1e-3 && dy + margin <= half_h + 1e-3, "the converged viewport includes the district + margin")
+}
+
+@(test)
+pullback_feed_ignores_attach_spawns :: proc(t: ^testing.T) {
+	app: App
+	pullback_test_app(&app)
+	defer pp.run_destroy(&app.state)
+
+	spawn_with_event(&app, {10, 14}) // 4 tiles from the estate — an ATTACH
+	pullback_feed(&app, app.state.events[:])
+	testing.expect(t, !app.pullback, "an ATTACH spawn never arms the pullback")
+	testing.expect(t, app.cam_zoom_to == 4.0, "the camera targets stay untouched")
+}
+
+@(test)
+pullback_feed_respects_the_toggle_and_the_already_visible_view :: proc(t: ^testing.T) {
+	app: App
+	pullback_test_app(&app)
+	defer pp.run_destroy(&app.state)
+
+	// toggle OFF: a SEED spawn changes nothing
+	app.auto_pullback = false
+	spawn_with_event(&app, {23, 10})
+	pullback_feed(&app, app.state.events[:])
+	testing.expect(t, !app.pullback && app.cam_zoom_to == 4.0, "the toggle OFF disables the pullback")
+	app.auto_pullback = true
+
+	// already visible: at the fit the whole world is in view — nothing to do
+	app.cam_zoom = 1.0
+	app.cam_zoom_to = 1.0
+	clear(&app.state.events)
+	spawn_with_event(&app, {23, 10})
+	pullback_feed(&app, app.state.events[:])
+	testing.expect(t, !app.pullback && app.cam_zoom_to == 1.0, "an in-view district holds the camera")
+}
+
+@(test)
+pullback_eases_no_snap_and_converges :: proc(t: ^testing.T) {
+	app: App
+	pullback_test_app(&app)
+	defer pp.run_destroy(&app.state)
+
+	spawn_with_event(&app, {23, 10})
+	pullback_feed(&app, app.state.events[:])
+	start := app.cam_zoom
+	target := app.cam_zoom_to
+	testing.expect(t, app.pullback && target < start, "the pullback armed")
+	// ONE frame: the zoom moves partway — a snap would land on the target
+	// immediately (the #82 no-snap doctrine)
+	camera_update(&app)
+	testing.expect(t, app.cam_zoom > target && app.cam_zoom < start, "frame 1 eases partway (no snap)")
+	// the ease rate is the pullback band: ~1-2 s at 60 fps — after 30 frames
+	// (0.5 s) the zoom has moved but NOT converged
+	for i in 0 ..< 30 {
+		camera_update(&app)
+	}
+	testing.expect(t, app.cam_zoom > target, "after 0.5 s the ease is still in flight (~1-2 s total)")
+	// and it converges: the pullback clears itself on arrival
+	for i in 0 ..< 600 {
+		camera_update(&app)
+	}
+	testing.expect(t, app.cam_zoom == app.cam_zoom_to, "the ease converges on the target")
+	testing.expect(t, !app.pullback, "the pullback clears on convergence")
+}
