new file mode 100644
index 00000000..010da84f
--- /dev/null
+++ b/app/render/camera.odin
@@ -0,0 +1,188 @@
+package render
+
+// camera.odin — the interactive camera math (packet-plumber-v2-camera-zoom):
+// wheel zoom-to-point + drag pan, implemented on the 7.1 camera model (the
+// eased cam_zoom/cam_wx/cam_wy targets on App — camera_update derives the
+// view scale/off from them every frame; the harness pins the DEFAULT camera
+// by never running camera_update, so T2 goldens are byte-identical by
+// construction).
+//
+// This file holds ONLY the pure float math — no App, no View, no raylib
+// state — so the zoom anchor, the pan delta, and the bounds clamp are
+// pin-testable at the lowest layer (camera_test.odin). The app's effects
+// (main.odin effect_zoom/effect_pan) translate wheel/pan intents into these
+// helpers against the live camera targets.
+//
+// The transform the math serves (view_compute + camera_update):
+//   screen = win/2 + (world - center) * fit * zoom        (fit = the camera-fit
+//   scale — min(win_w/world_w, win_h/world_h); center = the camera's world
+//   position at the window center). All IEEE f32, no transcendentals (the
+//   §10.4 rasterized-path rule — the zoom factor is integer-notch
+//   multiplication, never a pow()).
+
+import pp "../../core"
+
+// CAM_ZOOM_MIN — the bird's-eye fit (zoom 1.0 = the current fit-to-window
+// view; the user directive's "out for the overall bird view of the city" —
+// the fit ALREADY frames the whole city, so 1.0 is the out-limit).
+CAM_ZOOM_MIN :: 1.0
+
+// CAM_ZOOM_MAX — enough to read individual nodes/links clearly: at 4.0x the
+// 26px design tile renders ~96px and a basic puck ~110px (sprite targets
+// scale with the camera; the 7.1 selection focus sits at 2.3/2.6 inside the
+// band). Higher zooms show sprite-pixel upscaling with no new information.
+CAM_ZOOM_MAX :: 4.0
+
+// CAM_ZOOM_STEP — the per-wheel-notch zoom factor (1.25 in, 0.8 out —
+// 4 notches ≈ 2.4x, the selection-focus band; wheel deltas are integral
+// notches in practice, so the step is integer-multiplication exact).
+CAM_ZOOM_STEP :: 1.25
+
+// camera_zoom_step — z scaled by one wheel notch of `delta` (positive = in).
+// Integer-notch exponential WITHOUT libm (repeated multiply — the §10.4
+// no-transcendentals rule; a fractional delta truncates to whole notches,
+// which is what raylib delivers per frame anyway).
+camera_zoom_step :: proc(z, delta: f32) -> f32 {
+	f := f32(1)
+	for d := i32(delta); d > 0; d -= 1 {
+		f *= CAM_ZOOM_STEP
+	}
+	for d := i32(delta); d < 0; d += 1 {
+		f /= CAM_ZOOM_STEP
+	}
+	return z * f
+}
+
+// camera_anchor_center — the camera center (world px) that pins the world
+// point `anchor_wx, anchor_wy` (the point under the cursor BEFORE the zoom)
+// to the cursor position `cursor_x, cursor_y` at the TARGET zoom `z_to`:
+//   center = anchor - (cursor - win_center) / (fit * z_to)
+// This is zoom-to-POINT (not zoom-to-center): the map region under the wheel
+// cursor stays put while the zoom scales around it. `fit` is the camera-fit
+// scale (min(win_w/world_w, win_h/world_h)); win_w/win_h are the window dims.
+camera_anchor_center :: proc(anchor_wx, anchor_wy, cursor_x, cursor_y, win_w, win_h, fit, z_to: f32) -> (f32, f32) {
+	s := fit * z_to
+	if s <= 0 {
+		return anchor_wx, anchor_wy
+	}
+	cx := anchor_wx - (cursor_x - win_w / 2) / s
+	cy := anchor_wy - (cursor_y - win_h / 2) / s
+	return cx, cy
+}
+
+// camera_pan_center — a screen-space drag delta (dx, dy px) mapped to a world
+// center delta at the CURRENT view scale (fit * z): dragging right by dx px
+// moves the content with the cursor — the center shifts LEFT by dx/scale
+// (screen = win/2 + (world - center)*scale ⇒ dcenter = -dscreen/scale).
+camera_pan_center :: proc(cx, cy, dx, dy, fit, z: f32) -> (f32, f32) {
+	s := fit * z
+	if s <= 0 {
+		return cx, cy
+	}
+	return cx - dx / s, cy - dy / s
+}
+
+// CAMERA_PULLBACK_EASE — the auto-pullback's eased approach rate (per-frame
+// exponential factor; the normal camera ease is 0.14 ≈ 0.5 s to converge).
+// 0.05 converges in ~90-120 frames ≈ 1.5-2 s at 60 fps — the ruling's
+// "~1-2s, no snap" band (the #82 motion doctrine: the pullback reads as a
+// deliberate camera breathe-out, never a cut).
+CAMERA_PULLBACK_EASE :: 0.05
+
+// camera_spawn_is_seed — the derived SEED classification (the mid-flight
+// ruling: the pullback fires on growth SEED events). The NODE_SPAWNED event
+// is zero-payload, so the family is DERIVED on the view side: a spawned
+// terminal is a SEED iff it sits >= growth_groups.new_area_seed_tiles (the
+// data floor) from EVERY other live terminal — the exact mirror of the
+// core's own estate doctrine (growth_seed_sep_ok, minus the candidate
+// itself, which is live by the time the view sees it). The classification
+// is exact by the 08-21 strict doctrine: ATTACH spawns sit within
+// radius_tiles (5) of a member, SEED spawns >= new_area_seed_tiles (10) —
+// the gap leaves no third class. Pure read of (topology, catalog) — the
+// sim never sees this (ODN-1); deterministic (same spawn -> same family on
+// every path).
+camera_spawn_is_seed :: proc(topo: ^pp.Topology, cat: ^pp.Catalogs, node_id: u32) -> bool {
+	slot, ok := pp.node_slot(topo, node_id)
+	if !ok {
+		return false
+	}
+	if topo.node_kind[slot] != .Terminal {
+		return false // defensive — growth spawns terminals only
+	}
+	floor := i64(cat.balance.growth_groups.new_area_seed_tiles)
+	if floor < 1 {
+		return false // the core's fail-closed degenerate guard
+	}
+	d2 := floor * floor
+	pos := topo.node_pos[slot]
+	for i in 0 ..< len(topo.node_alive) {
+		if !topo.node_alive[i] || topo.node_kind[i] != .Terminal || i == int(slot) {
+			continue
+		}
+		d := topo.node_pos[i] - pos
+		if i64(d[0]) * i64(d[0]) + i64(d[1]) * i64(d[1]) < d2 {
+			return false
+		}
+	}
+	return true
+}
+
+// camera_pullback_target — the auto-pullback's target (the mid-flight
+// ruling: "ease out just enough to include the new district, or to the
+// fit-view floor if beyond"). Given the new district's world position and
+// the CURRENT camera (center + zoom), returns the smallest zoom change that
+// brings the district inside the viewport with `margin` world px of padding
+// at the CURRENT center (the minimal intervention: the player keeps their
+// context, the district enters at the edge). The fit (1.0) is the floor —
+// at the fit the whole world rect is visible, so a clamp to the floor
+// always includes the district (the center pin does the rest). Returns
+// active=false when the district is already inside (no pullback needed).
+// Pure f32 math — no libm (the §10.4 rule).
+camera_pullback_target :: proc(
+	center_x, center_y, zoom, node_x, node_y, win_w, win_h, fit, margin, world_w, world_h: f32,
+) -> (z_to, cx_to, cy_to: f32, active: bool) {
+	if zoom <= 0 || fit <= 0 {
+		return zoom, center_x, center_y, false
+	}
+	dx := abs(node_x - center_x)
+	dy := abs(node_y - center_y)
+	half_w := (win_w / 2) / (fit * zoom)
+	half_h := (win_h / 2) / (fit * zoom)
+	if dx + margin <= half_w && dy + margin <= half_h {
+		return zoom, center_x, center_y, false // already included — nothing to pull back
+	}
+	// the largest zoom whose viewport holds the district with the margin
+	// (the tighter axis binds — the min of the two per-axis limits)
+	z_x := (win_w / 2) / (fit * (dx + margin))
+	z_y := (win_h / 2) / (fit * (dy + margin))
+	z_to = clamp(min(z_x, z_y), CAM_ZOOM_MIN, CAM_ZOOM_MAX)
+	// the fit floor: at 1.0 the full world rect is visible (the center pins
+	// to the world center), so a floor-clamped target always includes the
+	// district — the "fit-view floor if beyond" clause.
+	if z_to >= zoom {
+		return zoom, center_x, center_y, false // the clamp already covers it
+	}
+	return z_to, center_x, center_y, true
+}
+
+// camera_clamp_center — keep the camera center inside the world rect at the
+// TARGET zoom (the zoomed-in view may never fly off into the paper void; the
+// visible half-extent is (win/2)/(fit*z) world px). When the viewport is
+// larger than the world (zoom near the 1.0 fit) the center pins to the world
+// center — pan is a no-op at the fit, exactly the briefing's min-zoom frame.
+camera_clamp_center :: proc(cx, cy, win_w, win_h, fit, z, world_w, world_h: f32) -> (f32, f32) {
+	nx, ny := cx, cy // Odin params are immutable — work on locals
+	half_w := (win_w / 2) / (fit * z)
+	half_h := (win_h / 2) / (fit * z)
+	if half_w >= world_w / 2 {
+		nx = world_w / 2
+	} else {
+		nx = clamp(nx, half_w, world_w - half_w)
+	}
+	if half_h >= world_h / 2 {
+		ny = world_h / 2
+	} else {
+		ny = clamp(ny, half_h, world_h - half_h)
+	}
+	return nx, ny
+}
diff --git a/app/render/camera_test.odin b/app/render/camera_test.odin
new file mode 100644
index 00000000..7cf2c122
--- /dev/null
+++ b/app/render/camera_test.odin
@@ -0,0 +1,166 @@
+package render
+
+// camera_test.odin — the interactive-camera math pins (camera.odin). The
+// zoom anchor, the pan delta, and the bounds clamp are the load-bearing
+// geometry of the wheel-zoom/drag-pan story — pinned at the lowest layer so
+// a regression (e.g. a zoom that drifts off the cursor point, or a pan that
+// flies into the paper void) fails CI before Perkins ever sees it.
+
+import "core:testing"
+import pp "../../core"
+
+// TOL — the comparison slack (the anchor math is exact IEEE arithmetic; any
+// tolerance here just absorbs test-computation order — the invariants hold
+// to ~1e-4 even so).
+TOL :: 1e-3
+
+// FIT42 — the 1280×720 fit over the 40×30-tile / 26px world (the design
+// grid): min(1280/1040, 720/780).
+FIT42 :: f32(720.0 / 780.0)
+WORLD_W42 :: f32(1040)
+WORLD_H42 :: f32(780)
+
+@(test)
+camera_spawn_is_seed_classifies_the_estate_families :: proc(t: ^testing.T) {
+	cat_storage: pp.Catalogs
+	cat := &cat_storage
+	cat.balance.growth_groups.new_area_seed_tiles = 10
+	cat.balance.tile_px = 26
+	cat.balance.map_w_tiles = 64
+	cat.balance.map_h_tiles = 36
+	// terminals only (the estate doctrine: routers are NOT in the set)
+	append(&cat.node_types,
+		pp.Node_Type{id = "residential", display = "res", kind = .Terminal, terminal_role = .Residential, port_capacity = 0},
+		pp.Node_Type{id = "router_basic", display = "rt", kind = .Junction, port_capacity = 4},
+	)
+	topo: pp.Topology
+	ti, _ := pp.node_type_index(cat, "residential")
+	ri, _ := pp.node_type_index(cat, "router_basic")
+	// the existing estate: two terminals 3 tiles apart (an ATTACH cluster)
+	pp.topology_spawn_node(&topo, ti, {10, 10}, cat)
+	pp.topology_spawn_node(&topo, ti, {13, 10}, cat)
+	// a router between them (must not count as a terminal in the set)
+	pp.topology_spawn_node(&topo, ri, {11, 14}, cat)
+
+	// ATTACH: 4 tiles from the nearest terminal — inside radius 5 -> NOT a seed
+	a := pp.topology_spawn_node(&topo, ti, {10, 14}, cat)
+	testing.expect(t, !camera_spawn_is_seed(&topo, cat, a), "an attach-distance spawn is not a seed")
+	// SEED: >= 10 tiles from EVERY terminal (10 from (13,10), 13 from (10,10),
+	// 13.6 from the attach at (10,14); the router at (11,14) is not in the set)
+	s := pp.topology_spawn_node(&topo, ti, {23, 10}, cat)
+	testing.expect(t, camera_spawn_is_seed(&topo, cat, s), "a fresh-area spawn is a seed")
+	// the boundary: exactly 10 tiles from the nearest terminal -> seed (>=)
+	b := pp.topology_spawn_node(&topo, ti, {10, 24}, cat)
+	testing.expect(t, camera_spawn_is_seed(&topo, cat, b), "the floor boundary (exactly 10) is a seed")
+	// a dead id classifies false (defensive)
+	testing.expect(t, !camera_spawn_is_seed(&topo, cat, 999), "a dead id never classifies as a seed")
+}
+
+@(test)
+camera_pullback_target_includes_the_district_or_holds :: proc(t: ^testing.T) {
+	win_w, win_h := f32(1280), f32(720)
+	fit := FIT42
+	margin := f32(52) // 2 design tiles of padding
+	// already inside (the district at the center of a 2x view) -> no pullback
+	z0, cx0, cy0, act := camera_pullback_target(520, 390, 2.0, 520, 390, win_w, win_h, fit, margin, WORLD_W42, WORLD_H42)
+	testing.expect(t, !act && z0 == 2.0 && cx0 == 520 && cy0 == 390, "an in-view district never triggers a pullback")
+	// far right of the current view at 4x -> the largest zoom that includes it
+	// with the margin; the converged viewport must hold the node + margin
+	z1, _, _, act1 := camera_pullback_target(520, 390, 4.0, 900, 390, win_w, win_h, fit, margin, WORLD_W42, WORLD_H42)
+	testing.expect(t, act1, "an out-of-view district triggers the pullback")
+	testing.expect(t, z1 < 4.0 && z1 >= 1.0, "the target eases OUT within the band")
+	half_w := (win_w / 2) / (fit * z1)
+	testing.expect(t, abs(900-520)+margin <= half_w + TOL, "the converged viewport includes the district + margin (x)")
+	// the fit floor: a district beyond the fit's half-extent from the current
+	// center clamps to 1.0 (the ruling's "fit-view floor if beyond") — the
+	// fit pins the center to the world center, which always includes it
+	z2, _, _, act2 := camera_pullback_target(100, 390, 4.0, 1000, 700, win_w, win_h, fit, margin, WORLD_W42, WORLD_H42)
+	testing.expect(t, act2, "a far district still triggers")
+	testing.expect(t, z2 == 1.0, "the floor clamps to the fit view")
+	// the district exactly at the margin boundary of the viewport: no pullback
+	// (the half-extent at zoom 2.0 — the test's own viewport math, not the
+	// z1-derived variable)
+	half_w2 := (win_w / 2) / (fit * 2.0)
+	z3, _, _, act3 := camera_pullback_target(520, 390, 2.0, 520 + half_w2 - margin, 390, win_w, win_h, fit, margin, WORLD_W42, WORLD_H42)
+	testing.expect(t, !act3 && z3 == 2.0, "a district exactly at the margin edge holds the view")
+}
+
+@(test)
+camera_zoom_step_compounds_without_libm :: proc(t: ^testing.T) {
+	testing.expect(t, abs(camera_zoom_step(1.0, 0) - 1.0) < TOL, "delta 0 = identity")
+	testing.expect(t, abs(camera_zoom_step(1.0, 1) - 1.25) < TOL, "+1 notch = 1.25x")
+	testing.expect(t, abs(camera_zoom_step(1.25, -1) - 1.0) < TOL, "-1 notch = 0.8x (round-trips)")
+	testing.expect(t, abs(camera_zoom_step(1.0, 2) - 1.5625) < TOL, "+2 notches compound (1.25^2)")
+	testing.expect(t, abs(camera_zoom_step(4.0, -4) - (4.0 * 0.4096)) < TOL, "-4 notches = 0.8^4 (symmetric)")
+	// the notch band: 4 notches in ≈ 2.44x — the selection-focus band (2.3/2.6)
+	testing.expect(t, abs(camera_zoom_step(1.0, 4) - 2.44140625) < TOL, "4 notches ~ the focus band")
+}
+
+@(test)
+camera_anchor_center_pins_the_cursor_point :: proc(t: ^testing.T) {
+	// the invariant: the world point under the cursor BEFORE the zoom sits
+	// under the cursor AFTER the zoom, at the target zoom. Screen math:
+	// screen = win/2 + (world - center) * fit * z.
+	win_w, win_h := f32(1280), f32(720)
+	cursor_x, cursor_y := f32(900), f32(360) // off-center — a naive zoom-to-center would drift
+	// the anchor: whatever world point the cursor was over at zoom 1.0
+	// centered on the world center
+	anchor_x := WORLD_W42 / 2 + (cursor_x - win_w / 2) / (FIT42 * 1.0)
+	anchor_y := WORLD_H42 / 2 + (cursor_y - win_h / 2) / (FIT42 * 1.0)
+	z_to := f32(3.0)
+	cx, cy := camera_anchor_center(anchor_x, anchor_y, cursor_x, cursor_y, win_w, win_h, FIT42, z_to)
+	// the anchor maps back to the cursor at the target zoom
+	sx := win_w / 2 + (anchor_x - cx) * (FIT42 * z_to)
+	sy := win_h / 2 + (anchor_y - cy) * (FIT42 * z_to)
+	testing.expect(t, abs(sx - cursor_x) < TOL, "anchor stays under the cursor (x)")
+	testing.expect(t, abs(sy - cursor_y) < TOL, "anchor stays under the cursor (y)")
+	// zooming out to the fit keeps the anchor pinned too
+	cx1, cy1 := camera_anchor_center(anchor_x, anchor_y, cursor_x, cursor_y, win_w, win_h, FIT42, 1.0)
+	sx1 := win_w / 2 + (anchor_x - cx1) * FIT42
+	sy1 := win_h / 2 + (anchor_y - cy1) * FIT42
+	testing.expect(t, abs(sx1 - cursor_x) < TOL && abs(sy1 - cursor_y) < TOL, "anchor pinned at the out-limit")
+}
+
+@(test)
+camera_pan_center_moves_content_with_the_cursor :: proc(t: ^testing.T) {
+	// the invariant: a world point under the cursor tracks the cursor through
+	// a drag (content follows the pointer): center -= drag / scale.
+	cx, cy := WORLD_W42 / 2, WORLD_H42 / 2
+	z := f32(2.0)
+	dx, dy := f32(120), f32(-40)
+	nx, ny := camera_pan_center(cx, cy, dx, dy, FIT42, z)
+	scale := FIT42 * z
+	testing.expect(t, abs(nx - (cx - dx / scale)) < TOL, "pan x maps screen px to world px")
+	testing.expect(t, abs(ny - (cy - dy / scale)) < TOL, "pan y maps screen px to world px")
+	// and the world point that was under the cursor before the drag lands
+	// under the cursor shifted by the full drag delta (content follows)
+	px := f32(360) // the cursor's screen x before the drag (world point = cx)
+	sx_after := px + (cx - nx) * scale // the same world point after the pan
+	testing.expect(t, abs(sx_after - (px + dx)) < TOL, "content tracks the drag (x)")
+}
+
+@(test)
+camera_clamp_center_pins_the_fit_and_holds_the_world :: proc(t: ^testing.T) {
+	win_w, win_h := f32(1280), f32(720)
+	// at the fit (z=1) the viewport is larger than the world in x? no — the
+	// world is 1040 wide vs the 960px viewport, so x is free; y (720 viewport
+	// vs 780 world) pins. At z < 1.08 both pin. The min-zoom contract: the
+	// fit is the OUT limit, so the fit center is the world center.
+	cx, cy := camera_clamp_center(9999, -9999, win_w, win_h, FIT42, 1.0, WORLD_W42, WORLD_H42)
+	testing.expect(t, abs(cx - WORLD_W42 / 2) < TOL && abs(cy - WORLD_H42 / 2) < TOL, "fit clamps to the world center")
+	// zoomed in, panning to the corner clamps at the world edge — the
+	// viewport's half-extent never leaves the world rect
+	cx2, cy2 := camera_clamp_center(-9999, -9999, win_w, win_h, FIT42, 4.0, WORLD_W42, WORLD_H42)
+	half_w := (win_w / 2) / (FIT42 * 4.0)
+	half_h := (win_h / 2) / (FIT42 * 4.0)
+	testing.expect(t, abs(cx2 - half_w) < TOL && abs(cy2 - half_h) < TOL, "zoomed-in clamp holds the left/top world edge")
+	cx3, cy3 := camera_clamp_center(9999, 9999, win_w, win_h, FIT42, 4.0, WORLD_W42, WORLD_H42)
+	testing.expect(t, abs(cx3 - (WORLD_W42 - half_w)) < TOL && abs(cy3 - (WORLD_H42 - half_h)) < TOL, "zoomed-in clamp holds the right/bottom world edge")
+	// an interior center passes through untouched
+	cx4, cy4 := camera_clamp_center(500, 400, win_w, win_h, FIT42, 4.0, WORLD_W42, WORLD_H42)
+	testing.expect(t, abs(cx4 - 500) < TOL && abs(cy4 - 400) < TOL, "interior centers are not clamped")
+	// at z=1.5 the viewport is narrower than the world on BOTH axes — the
+	// clamp must let interior centers pass (only the fit pins to the center)
+	cx5, cy5 := camera_clamp_center(500, 400, win_w, win_h, FIT42, 1.5, WORLD_W42, WORLD_H42)
+	testing.expect(t, abs(cx5 - 500) < TOL && abs(cy5 - 400) < TOL, "interior centers pass when the viewport is narrower than the world")
+}
