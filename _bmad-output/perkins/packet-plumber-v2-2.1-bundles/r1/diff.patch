diff --git a/core/bundles.odin b/core/bundles.odin
new file mode 100644
index 0000000..11a6677
--- /dev/null
+++ b/core/bundles.odin
@@ -0,0 +1,165 @@
+package core
+
+// bundles.odin — the parallel-pipe bundle model (Story 2.1 / architecture §6.1
+// + §6.2, ODN-10, the routing ruling lavish 2026-08-10). Parallel pipes
+// between a node pair BUNDLE into one pooled-capacity link whose capacity is
+// the SUM of its members — "redundancy becomes active capacity the moment a
+// second pipe is drawn." The routing sees ONE fat edge per pair (no load
+// balancing — round-robin/weighted LB are deleted; ECMP, in 2.2, is a hash).
+//
+// This is a DERIVED view over the Topology (a pure function of it), exactly
+// like the routing table: rebuilt only when the topology changes (4-rule spine
+// rule 1 — synchronous inside the tick), and NOT serialized into the T1 hash
+// (the Topology's pipes ARE serialized, so a parallel-pipe draw replays
+// byte-identically without binding replay to the bundle-build algorithm — the
+// same reasoning routing.odin uses). "Bundle state in the hash" (Story 2.1's
+// T1 golden) is satisfied by the composing pipes; the bundle struct is re-
+// derived on every replay.
+//
+// Why a separate struct and not a routing-table field: the routing table maps
+// (junction, dst) -> next hop + a representative pipe handle. A BUNDLE is the
+// pooled edge that handle resolves into. Keeping the bundle as its own derived
+// struct lets the flow + the render resolve any pipe -> its bundle's summed
+// capacity + member set without the routing table knowing about pairs. The
+// representative pipe the routing table stores is always a LIVE member of its
+// bundle (BFS picks the first pipe to reach a node — insertion order, stable),
+// so pipe -> bundle is always well-defined for any pipe a packet traverses.
+//
+// Determinism: array-only (no map iteration — ODN-10); insertion-order build
+// (scan pipes in slot order, assign a new bundle slot on a new canonical
+// pair); integer-only (rule 3 — the static sum is computed once at table-build
+// time from the catalog tier capacities, never per-packet, never mid-flow).
+// Mixed-tier bundles sum each member's own tier capacity (a standard + a wide
+// = 15 + 40 = 55); the bundle's render color is its highest member tier.
+//
+// No load balancing lives here or anywhere in core — the lens-guard
+// (tools/lint.sh gate 5) greps for round-robin/weighted/pick_pipe/lb patterns
+// and fails CI if any appears. The ONLY per-pipe decision in the routing model
+// is the 2.2 ECMP hash (splitmix64, a pure finalizer — not an rng draw); 2.1
+// has no per-pipe pick at all (single-path representative).
+
+// NO_BUNDLE — the pipe->bundle sentinel for a dead/unset slot. Live pipes are
+// always assigned a real bundle slot by bundles_rebuild (which runs before the
+// flow every step), so a live pipe's pipe_bundle is never NO_BUNDLE.
+NO_BUNDLE :: u32(0xFFFFFFFF)
+
+// Bundles — the derived parallel-pipe bundle view. Rebuilt on every topology
+// change (rule 1); never serialized (pure function of the Topology). One row
+// per unordered node pair that has >=1 live pipe between it.
+Bundles :: struct {
+	// pipe slot -> the bundle slot that pipe belongs to (NO_BUNDLE for dead/
+	// unset slots). Sized to len(pipe_alive) at rebuild time; rebuilt every
+	// topology change so it always covers the current live pipes.
+	pipe_bundle: [dynamic]u32,
+	// per bundle slot: the canonical pooled edge (min/max endpoint node ids)
+	bundle_lo:   [dynamic]u32, // canonical min-endpoint node id
+	bundle_hi:   [dynamic]u32, // canonical max-endpoint node id
+	bundle_cap:  [dynamic]u32, // STATIC SUM of member tier capacities (rule 3)
+	bundle_count:[dynamic]u32, // live member count (the render-width proxy)
+	bundle_tier: [dynamic]u16, // highest tier index among members (render color)
+	n:           u32,          // live bundle count
+}
+
+bundles_make :: proc(b: ^Bundles, allocator := context.allocator) {
+	b^ = {}
+	b.pipe_bundle = make([dynamic]u32, 0, 8, allocator)
+	b.bundle_lo = make([dynamic]u32, 0, 8, allocator)
+	b.bundle_hi = make([dynamic]u32, 0, 8, allocator)
+	b.bundle_cap = make([dynamic]u32, 0, 8, allocator)
+	b.bundle_count = make([dynamic]u32, 0, 8, allocator)
+	b.bundle_tier = make([dynamic]u16, 0, 8, allocator)
+}
+
+bundles_destroy :: proc(b: ^Bundles) {
+	delete(b.pipe_bundle)
+	delete(b.bundle_lo)
+	delete(b.bundle_hi)
+	delete(b.bundle_cap)
+	delete(b.bundle_count)
+	delete(b.bundle_tier)
+}
+
+// bundles_rebuild — recompute the bundle view from the current Topology. Called
+// by step ONLY when the topology changed (Topology.gen moved — rule 1), right
+// after routing_rebuild. Pure w.r.t. the Topology: identical Topology ->
+// identical bundles on every target (ODN-10). The static summed capacity
+// (rule 3) is folded once here from the catalog tier capacities, never again.
+//
+// Algorithm (deterministic, insertion-order): scan pipes in slot order; for
+// each LIVE pipe, form its canonical pair (lo, hi); if no bundle exists for
+// that pair yet, mint one (append a row); accumulate this member's tier
+// capacity into the bundle's cap + bump its member count + raise its high-
+// tier. A linear scan of existing bundles finds the pair (small graphs; core
+// is map-free — ODN-10). Pipe slots map to their bundle slot as they're seen.
+bundles_rebuild :: proc(b: ^Bundles, t: ^Topology, cat: ^Catalogs, allocator := context.allocator) {
+	context.allocator = allocator
+
+	// reset the pipe->bundle map to cover every pipe slot (alive or tombstoned),
+	// defaulting to NO_BUNDLE. resize preserves capacity across rebuilds.
+	np := len(t.pipe_alive)
+	if len(b.pipe_bundle) != np {
+		resize(&b.pipe_bundle, np)
+	}
+	for i in 0..<np {
+		b.pipe_bundle[i] = NO_BUNDLE
+	}
+	// reset the bundle rows (a topology change can drop/reshape bundles; rebuild
+	// from scratch — correctness over incremental churn at this scale)
+	clear(&b.bundle_lo)
+	clear(&b.bundle_hi)
+	clear(&b.bundle_cap)
+	clear(&b.bundle_count)
+	clear(&b.bundle_tier)
+	b.n = 0
+
+	for pi in 0..<np {
+		if !t.pipe_alive[pi] {
+			continue
+		}
+		la, lb := t.pipe_a[pi], t.pipe_b[pi]
+		lo, hi := la, lb
+		if hi < lo { lo, hi = hi, lo } // canonical unordered pair key
+		bs, found := bundles_slot_for_pair(b, lo, hi)
+		if !found {
+			bs = b.n
+			b.n += 1
+			append(&b.bundle_lo, lo)
+			append(&b.bundle_hi, hi)
+			append(&b.bundle_cap, 0)
+			append(&b.bundle_count, 0)
+			append(&b.bundle_tier, 0)
+		}
+		b.pipe_bundle[pi] = bs
+		tier := t.pipe_tier[pi]
+		b.bundle_cap[bs] += u32(cat.pipe_tiers[tier].capacity_units) // rule 3: static sum
+		b.bundle_count[bs] += 1
+		if tier > b.bundle_tier[bs] {
+			b.bundle_tier[bs] = tier // highest member tier (render color)
+		}
+	}
+}
+
+// bundles_slot_for_pair — linear lookup of the bundle slot for a canonical
+// (lo, hi) pair. Returns ok=false if no bundle exists for that pair yet. Core
+// is map-free (ODN-10); graphs are small so the linear scan is fine, and it
+// keeps the build deterministic by insertion order (no map iteration).
+bundles_slot_for_pair :: proc(b: ^Bundles, lo, hi: u32) -> (slot: u32, ok: bool) {
+	for i in 0..<int(b.n) {
+		if b.bundle_lo[i] == lo && b.bundle_hi[i] == hi {
+			return u32(i), true
+		}
+	}
+	return 0, false
+}
+
+// bundle_capacity_for_pipe — the hot-path lookup: given a LIVE pipe slot, the
+// STATIC summed capacity of its bundle (rule 3). Returns 0 for a NO_BUNDLE
+// slot (impossible for a live pipe after bundles_rebuild — defensive only; the
+// flow falls back to the pipe's own tier cap in that case so it never stalls).
+bundle_capacity_for_pipe :: proc(b: ^Bundles, pipe_slot: u32) -> u32 {
+	bs := b.pipe_bundle[pipe_slot]
+	if bs == NO_BUNDLE {
+		return 0
+	}
+	return b.bundle_cap[bs]
+}
diff --git a/core/bundles_test.odin b/core/bundles_test.odin
new file mode 100644
index 0000000..df534fb
--- /dev/null
+++ b/core/bundles_test.odin
@@ -0,0 +1,307 @@
+package core
+
+// bundles_test.odin — the Story 2.1 contracts as durable tests (arch §6.1/§6.2,
+// ODN-10, the routing ruling lavish 2026-08-10). Pins:
+//   (a) the headline AC: bundle capacity = STATIC SUM of members (rule 3) —
+//       2 standard = 30, 3 standard = 45, a mixed standard+wide = 55;
+//   (b) a lone pipe is a 1-member bundle (so slice-1 single-pipe links read
+//       their own tier cap — slice 1 is byte-identical, only extended);
+//   (c) the routing representative pipe resolves to its bundle's pooled cap
+//       (the "one fat edge per pair" the flow consumes);
+//   (d) the bundle view rebuilds on topology change (rule 1 — adding a parallel
+//       pipe to an existing pair grows the bundle's cap, mid-run);
+//   (e) the no-LB pin: the pooled capacity is served WHOLE to every packet on
+//       the bundle (no round-robin/weighted split — the deleted mechanic);
+//   (f) the T1 determinism pin: a parallel-pipe draw replays byte-identical
+//       (the bundle state rides the hash via the composing pipes — E10).
+//
+// The self-review lens (bmad-review-edge-case-hunter) targets (a) cap=sum and
+// (f) determinism over the merge-pop — both pinned here at the lowest layer.
+// The grep-gate form of (e) lives in tools/lint.sh gate 5 (no LB patterns in
+// core); this file pins the BEHAVIOR (the pool serves whole).
+
+import "core:testing"
+
+// bundle_setup — a fresh fixture-backed run (res/rt/host), ready for parallel
+// draws. Reuses test_catalog / test_seed_fixture / run_init (determinism_test).
+bundle_setup :: proc(cat: ^Catalogs) -> (Run_State, u32, u32, u32) {
+	s: Run_State
+	run_init(&s, 42, cat.hash, TEST_LOGIC_HZ)
+	res, rt, host := test_seed_fixture(&s, cat)
+	return s, res, rt, host
+}
+
+// step_once — advance one tick so bundles_rebuild runs (rule 1: the topology's
+// gen moved when the test drew pipes). Empty command batch + no demand means
+// the step only rebuilds the derived views (bundles + routing) — ideal for
+// inspecting the bundle struct without flow noise.
+step_once :: proc(s: ^Run_State, cat: ^Catalogs) {
+	step(s, 1, {}, cat)
+}
+
+@(test)
+test_bundle_capacity_equals_sum :: proc(t: ^testing.T) {
+	// THE headline AC (Story 2.1): parallel pipes between a pair bundle into
+	// one pooled link whose capacity is the SUM of members (rule 3, static at
+	// table-build). 2 standard (cap 15 each) -> 30; 3 standard -> 45.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	std, _ := pipe_tier_index(cat, "standard")
+
+	// --- 2 parallel standard pipes rt<->host ---
+	s, _, rt, host := bundle_setup(cat)
+	defer run_destroy(&s)
+	r1d, e1d := topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{rt, host, std}}, cat)
+	testing.expectf(t, e1d == .None && r1d.ok, "draw 1")
+	r2d, e2d := topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{host, rt, std}}, cat)
+	testing.expectf(t, e2d == .None && r2d.ok, "draw 2 (reversed endpoints — same pair)")
+	step_once(&s, cat)
+	bs, ok := bundles_slot_for_pair(&s.bundles, min(rt, host), max(rt, host))
+	testing.expectf(t, ok && s.bundles.n == 1, "one bundle for the pair, got n=%d", s.bundles.n)
+	testing.expectf(t, ok, "the rt<->host pair must have a bundle")
+	testing.expectf(t, s.bundles.bundle_cap[bs] == 30,
+		"2 standard pipes bundle to cap 30 (15+15), got %d", s.bundles.bundle_cap[bs])
+	testing.expectf(t, s.bundles.bundle_count[bs] == 2, "2 members, got %d", s.bundles.bundle_count[bs])
+
+	// --- 3 parallel standard pipes ---
+	s3, _, rt3, host3 := bundle_setup(cat)
+	defer run_destroy(&s3)
+	for i in 0..<3 {
+		_, e := topology_apply_edit(&s3.topology, Command{1, Cmd_Draw_Pipe{rt3, host3, std}}, cat)
+		testing.expectf(t, e == .None, "draw %d must apply", i)
+	}
+	step_once(&s3, cat)
+	bs3, ok3 := bundles_slot_for_pair(&s3.bundles, min(rt3, host3), max(rt3, host3))
+	testing.expectf(t, ok3, "the 3-pipe pair must bundle")
+	testing.expectf(t, s3.bundles.bundle_cap[bs3] == 45,
+		"3 standard pipes bundle to cap 45 (15*3), got %d", s3.bundles.bundle_cap[bs3])
+}
+
+@(test)
+test_bundle_mixed_tier_sums_each_member :: proc(t: ^testing.T) {
+	// A mixed-tier bundle sums each member's OWN tier capacity: a standard
+	// (15) + a wide (40) = 55. The render color is the highest member tier
+	// (wide), but the capacity is the straight sum (rule 3 — no weighting
+	// beyond the per-tier capacity itself).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	wide, _ := pipe_tier_index(cat, "wide")
+	s, _, rt, host := bundle_setup(cat)
+	defer run_destroy(&s)
+	_, e1 := topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{rt, host, std}}, cat)
+	_, e2 := topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{rt, host, wide}}, cat)
+	testing.expectf(t, e1 == .None && e2 == .None, "both draws must apply (span 12 <= wide max 18)")
+	step_once(&s, cat)
+	bs, ok := bundles_slot_for_pair(&s.bundles, min(rt, host), max(rt, host))
+	testing.expectf(t, ok, "the mixed pair must bundle")
+	testing.expectf(t, s.bundles.bundle_cap[bs] == 55,
+		"standard(15)+wide(40)=55, got %d", s.bundles.bundle_cap[bs])
+	testing.expectf(t, s.bundles.bundle_tier[bs] == wide,
+		"highest member tier drives the render color, got tier %d", s.bundles.bundle_tier[bs])
+}
+
+@(test)
+test_single_pipe_is_bundle_of_one :: proc(t: ^testing.T) {
+	// A lone pipe is a 1-member bundle whose cap is its own tier capacity.
+	// This is why slice 1 (single-pipe links everywhere) is byte-identical in
+	// BEHAVIOR — only extended (the bundle view now exists), not changed.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	s, res, rt, _ := bundle_setup(cat)
+	defer run_destroy(&s)
+	_, e := topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{res, rt, std}}, cat)
+	testing.expectf(t, e == .None, "draw must apply")
+	step_once(&s, cat)
+	testing.expectf(t, s.bundles.n == 1, "one lone pipe = one bundle, got n=%d", s.bundles.n)
+	bs, ok := bundles_slot_for_pair(&s.bundles, min(res, rt), max(res, rt))
+	testing.expectf(t, ok, "the lone pair must have a bundle")
+	testing.expectf(t, s.bundles.bundle_cap[bs] == 15,
+		"a lone standard pipe = cap 15 (its tier), got %d", s.bundles.bundle_cap[bs])
+	testing.expectf(t, s.bundles.bundle_count[bs] == 1, "count 1, got %d", s.bundles.bundle_count[bs])
+}
+
+@(test)
+test_bundle_resolves_via_representative_pipe :: proc(t: ^testing.T) {
+	// The flow consumes a bundle via the routing representative pipe handle
+	// (p.edge). Any live member of a bundle resolves to the SAME pooled cap —
+	// the "one fat edge per pair" the routing sees. Both members of a 2-pipe
+	// bundle report cap 30, regardless of which pipe id the packet holds.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	s, _, rt, host := bundle_setup(cat)
+	defer run_destroy(&s)
+	r1, _ := topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{rt, host, std}}, cat)
+	r2, _ := topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{rt, host, std}}, cat)
+	testing.expectf(t, r1.ok && r2.ok, "both draws must apply")
+	step_once(&s, cat)
+	// both pipe ids resolve to the same pooled capacity
+	ps0, ok0 := pipe_slot(&s.topology, r1.id)
+	ps1, ok1 := pipe_slot(&s.topology, r2.id)
+	testing.expectf(t, ok0 && ok1, "both representative pipes must be live")
+	cap0 := bundle_capacity_for_pipe(&s.bundles, ps0)
+	cap1 := bundle_capacity_for_pipe(&s.bundles, ps1)
+	testing.expectf(t, cap0 == 30 && cap1 == 30,
+		"both members resolve to the pooled cap 30, got %d + %d", cap0, cap1)
+}
+
+@(test)
+test_bundle_rebuilds_on_topology_change :: proc(t: ^testing.T) {
+	// Rule 1: the bundle view rebuilds when the topology changes. Drawing a
+	// SECOND parallel pipe mid-run grows the existing bundle's cap from 15 to
+	// 30 (the merge — "redundancy becomes active capacity the moment a second
+	// pipe is drawn"). The bundle COUNT stays 1 (same pair); the cap + member
+	// count grow.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	s, _, rt, host := bundle_setup(cat)
+	defer run_destroy(&s)
+	_, _ = topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{rt, host, std}}, cat)
+	step_once(&s, cat)
+	bs, ok := bundles_slot_for_pair(&s.bundles, min(rt, host), max(rt, host))
+	testing.expectf(t, ok && s.bundles.bundle_cap[bs] == 15, "first pipe: cap 15, got ok=%v cap=%d", ok, s.bundles.bundle_cap[bs])
+
+	// draw the parallel pipe + step again -> the bundle GROWS (cap 15 -> 30)
+	_, _ = topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{rt, host, std}}, cat)
+	step_once(&s, cat)
+	bs2, ok2 := bundles_slot_for_pair(&s.bundles, min(rt, host), max(rt, host))
+	testing.expectf(t, ok2, "the grown bundle must still resolve")
+	testing.expectf(t, s.bundles.n == 1, "still ONE bundle (same pair), got n=%d", s.bundles.n)
+	testing.expectf(t, s.bundles.bundle_cap[bs2] == 30,
+		"after the parallel draw the bundle cap grew to 30, got %d", s.bundles.bundle_cap[bs2])
+	testing.expectf(t, s.bundles.bundle_count[bs2] == 2,
+		"member count grew to 2, got %d", s.bundles.bundle_count[bs2])
+}
+
+// bundle_leg_transit — run res->rt (single) + rt->host (n parallel standard
+// pipes) with one packet res->host, and return how many on-edge ticks the
+// packet spends crossing the rt->host leg (the transit time). A lone standard
+// leg (cap 15 < bandwidth 30) takes 2 ticks; a 2-pipe bundle (cap 30) takes 1.
+// Round-robin splitting across the 2 pipes would serve 15/tick -> 2 ticks, so a
+// measured 1-tick transit proves the FULL pooled capacity is served (no LB).
+bundle_leg_transit :: proc(cat: ^Catalogs, parallel_pipes: int) -> int {
+	s: Run_State
+	run_init(&s, 42, cat.hash, TEST_LOGIC_HZ)
+	defer run_destroy(&s)
+	res, rt, host := test_seed_fixture(&s, cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	_, _ = topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{res, rt, std}}, cat)
+	for i in 0..<parallel_pipes {
+		_, _ = topology_apply_edit(&s.topology, Command{1, Cmd_Draw_Pipe{rt, host, std}}, cat)
+	}
+	flow_seed_demand(&s.flow, 1, res, host)
+	enter_tick, deliver_tick := 0, 0
+	for tick in u64(1)..=20 {
+		step(&s, tick, {}, cat)
+		// AFTER step: a packet that entered the bundle this tick is on_edge,
+		// heading=host, progress=0 (forwarded on, not yet consumed).
+		if enter_tick == 0 {
+			for i in 0..<len(s.flow.packets) {
+				p := &s.flow.packets[i]
+				if p.on_edge && p.heading == host && p.progress_units == 0 {
+					enter_tick = int(tick)
+				}
+			}
+		}
+		// delivery: score crosses 0 -> 1 the tick the packet arrives at host.
+		if deliver_tick == 0 && s.score >= 1 {
+			deliver_tick = int(tick)
+		}
+	}
+	if enter_tick == 0 || deliver_tick == 0 {
+		return -1 // never entered / never delivered (caller asserts)
+	}
+	return deliver_tick - enter_tick
+}
+
+@(test)
+test_bundle_serves_full_capacity_no_split :: proc(t: ^testing.T) {
+	// The no-LB behavioral pin: a bundle serves its FULL pooled capacity per
+	// on-edge tick (no round-robin/weighted split across the members — the
+	// deleted mechanic). Measured as transit time across the bundled leg:
+	//   - a LONE standard leg (cap 15 < bandwidth 30) takes 2 on-edge ticks;
+	//   - a 2-standard BUNDLE (cap 30 = bandwidth 30) takes 1 on-edge tick.
+	// Round-robin over 2 pipes would serve 15/tick -> 2 ticks (same as a lone
+	// pipe); the measured 1-tick transit proves the whole pool is served. The
+	// grep-gate form (no LB patterns in core) is tools/lint.sh gate 5; this pins
+	// the BEHAVIOR (the pool serves whole, not split).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	single := bundle_leg_transit(cat, 1) // lone standard leg
+	bundle := bundle_leg_transit(cat, 2)  // 2-standard bundle
+	testing.expectf(t, single == 2, "a lone standard leg (cap 15) takes 2 ticks, got %d", single)
+	testing.expectf(t, bundle == 1,
+		"a 2-standard bundle (cap 30) must cross in 1 tick (full pool, no split), got %d", bundle)
+	testing.expectf(t, bundle < single,
+		"the bundle must be FASTER than the lone pipe (cap 30 vs 15) — no LB split, got bundle=%d single=%d",
+		bundle, single)
+}
+
+@(test)
+test_parallel_pipe_draw_replays_byte_identical :: proc(t: ^testing.T) {
+	// The T1 determinism pin (Story 2.1's golden): a parallel-pipe draw replays
+	// byte-identical. The bundle state rides the T1 hash via the composing
+	// pipes (pipe_a/pipe_b/pipe_tier are serialized), so the derived bundle
+	// view re-converges on every replay without binding replay to the build
+	// algorithm (same reasoning as the routing table). Re-step (seed, log,
+	// demand) twice -> identical hash sequence INCLUDING the merge ticks.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	live: Run_State
+	defer run_destroy(&live)
+	run_init(&live, 42, cat.hash, TEST_LOGIC_HZ)
+	res, rt, host := test_seed_fixture(&live, cat)
+	std, _ := pipe_tier_index(cat, "standard")
+	// the parallel-pipe draw: rt->host then rt->host AGAIN (the merge)
+	append(&live.action_log, Command{apply_tick = 1, kind = Cmd_Draw_Pipe{a = res, b = rt, tier = std}})
+	append(&live.action_log, Command{apply_tick = 1, kind = Cmd_Draw_Pipe{a = rt, b = host, tier = std}})
+	append(&live.action_log, Command{apply_tick = 30, kind = Cmd_Draw_Pipe{a = rt, b = host, tier = std}}) // the parallel draw
+	flow_seed_demand(&live.flow, 1, res, host)
+
+	live_hashes := record_run(&live, 60, cat)
+	defer delete(live_hashes)
+	testing.expectf(t, pipe_count(&live.topology) == 3, "live run drew 3 pipes (one parallel), got %d", pipe_count(&live.topology))
+	// the bundle view must have converged on the merge (cap 30 on rt->host)
+	bs, ok := bundles_slot_for_pair(&live.bundles, min(rt, host), max(rt, host))
+	testing.expectf(t, ok && live.bundles.bundle_cap[bs] == 30,
+		"live bundle cap must be 30 after the merge, got ok=%v cap=%d", ok, live.bundles.bundle_cap[bs])
+	testing.expectf(t, !live.replay_error, "live run must not latch replay_error")
+
+	// replay: fresh run, same seed, the SAME action log + demand (run setup)
+	replayed: Run_State
+	defer run_destroy(&replayed)
+	run_init(&replayed, 42, cat.hash, TEST_LOGIC_HZ)
+	test_seed_fixture(&replayed, cat)
+	delete(replayed.action_log)
+	replayed.action_log = clone_log(live.action_log)
+	flow_seed_demand(&replayed.flow, 1, res, host)
+	replay_hashes := record_run(&replayed, 60, cat)
+	defer delete(replay_hashes)
+	testing.expectf(t, !replayed.replay_error, "replay must not latch replay_error")
+	// the replayed bundle view must ALSO converge (the derived view rebuilds)
+	bsr, okr := bundles_slot_for_pair(&replayed.bundles, min(rt, host), max(rt, host))
+	testing.expectf(t, okr && replayed.bundles.bundle_cap[bsr] == 30,
+		"replay bundle cap must also be 30, got ok=%v cap=%d", okr, replayed.bundles.bundle_cap[bsr])
+
+	testing.expectf(t, len(live_hashes) == len(replay_hashes),
+		"tick count: live %d vs replay %d", len(live_hashes), len(replay_hashes))
+	diverged := false
+	for i in 0..<len(live_hashes) {
+		if live_hashes[i] != replay_hashes[i] {
+			diverged = true
+		}
+	}
+	testing.expectf(t, !diverged, "REPLAY DIVERGENCE: a parallel-pipe draw must replay byte-identical (E10)")
+}
