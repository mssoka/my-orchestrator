@@ -25,5 +25,21 @@ echo "-- gate 4: no bare '_' discards of fallible calls in core/"
 HITS=$(grep -rnE '^\s*_ = ' core/*.odin | grep -v '_test\.odin' || true)
 if [ -n "$HITS" ]; then echo "$HITS"; echo "FAIL: dropped return in core/"; FAIL=1; fi
 
+echo "-- gate 5: no load-balancing mechanic in core (routing ruling, lavish 2026-08-10)"
+# Round-robin / weighted per-pipe LB are DELETED — parallel pipes BUNDLE (cap =
+# sum) and ECMP (2.2) is a pure hash. This grep-gate is the Perkins lens-guard:
+# it fails if any LB mechanic identifier is ported into core. Comments are
+# stripped first (// ...) so the prohibition's own explanatory prose doesn't
+# false-positive. The behavioral pin (the pool serves whole, not split) is
+# core/bundles_test.odin::test_bundle_serves_full_capacity_no_split.
+LB_PAT='pick_pipe|lb_mode|lb_weighted|node_lb_weighted|Lb_Mode|load[ _-]?balanc|round[ _-]?robin'
+LB_HITS=""
+for _f in core/*.odin; do
+	case "$_f" in *_test.odin) continue;; esac
+	_found=$(sed 's://.*::' "$_f" | grep -nE "$LB_PAT" | sed "s|^|$_f:|")
+	[ -n "$_found" ] && LB_HITS="$LB_HITS$_found"$'\n'
+done
+if [ -n "$LB_HITS" ]; then echo "$LB_HITS"; echo "FAIL: load-balancing mechanic in core/ (routing ruling: bundles pool, no LB)"; FAIL=1; fi
+
 if [ "$FAIL" -ne 0 ]; then exit 1; fi
 echo "lint: all gates green"
