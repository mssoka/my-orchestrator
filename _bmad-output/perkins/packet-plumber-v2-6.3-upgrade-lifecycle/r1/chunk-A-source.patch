diff --git a/core/legacy_test.odin b/core/legacy_test.odin
new file mode 100644
index 0000000..5deb957
--- /dev/null
+++ b/core/legacy_test.odin
@@ -0,0 +1,416 @@
+package core
+
+// legacy_test.odin — Story 6.3's durable contracts (the upgrade lifecycle,
+// GDD M4 / stories-v2 6.3): the legacy-decay model, the modernize tier-up,
+// the demolish restoration, the gate↔lifecycle agreement (the 6.2 seam's
+// cross-test), the era-flip engagement, and the replay determinism of every
+// new path. The decay authority is pipe_effective_capacity (era.odin) — a
+// pure function of serialized state (era + tier) + catalogs, so the derived
+// capacity views (bundles + lane caps) recompute identically on replay and
+// no per-pipe state rides the T1 hash.
+
+import "core:testing"
+
+// --- the predicate + decay math ----------------------------------------------
+
+@(test)
+test_legacy_predicate_and_decay_math :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage) // eras 1-3: permilles 1000/500/500 (mirrors data/eras.json)
+	defer catalogs_destroy(cat)
+
+	na, _ := pipe_tier_index(cat, "narrow")
+	std, _ := pipe_tier_index(cat, "standard")
+	wd, _ := pipe_tier_index(cat, "wide")
+
+	// the predicate is the 6.2 seam's definition: tier < the era's newest.
+	testing.expect(t, era_pipe_is_legacy(cat, 2, na), "era 2: narrow is legacy (below standard)")
+	testing.expect(t, !era_pipe_is_legacy(cat, 2, std), "era 2: standard is NOT legacy (the newest)")
+	testing.expect(t, era_pipe_is_legacy(cat, 3, na), "era 3: narrow is legacy (below wide)")
+	testing.expect(t, era_pipe_is_legacy(cat, 3, std), "era 3: standard is legacy (below wide)")
+	testing.expect(t, !era_pipe_is_legacy(cat, 3, wd), "era 3: wide is NOT legacy (the newest)")
+	// era 0 has no row — nothing is legacy (every legacy run stays unchanged).
+	testing.expect(t, !era_pipe_is_legacy(cat, 0, na), "era 0: no era row — nothing is legacy")
+
+	// the decay math: raw × permille / 1000, floored (ODN-10).
+	// era 1's factor is 1000 — a below-newest pipe does NOT decay (the
+	// foundation era leaves nothing behind — decay is a LATER-era phenomenon).
+	testing.expect_value(t, pipe_effective_capacity(cat, 1, na), u32(10))
+	// era 2: narrow at 500 permille.
+	testing.expect_value(t, pipe_effective_capacity(cat, 2, na), u32(5))
+	testing.expect_value(t, pipe_effective_capacity(cat, 2, std), u32(15))
+	// era 3: narrow + standard at 500 permille, wide untouched.
+	testing.expect_value(t, pipe_effective_capacity(cat, 3, na), u32(5))
+	testing.expect_value(t, pipe_effective_capacity(cat, 3, std), u32(7)) // 15 × 500 / 1000
+	testing.expect_value(t, pipe_effective_capacity(cat, 3, wd), u32(40))
+	// era 0: no row — full raw capacity.
+	testing.expect_value(t, pipe_effective_capacity(cat, 0, na), u32(10))
+}
+
+// --- the derived capacity views fold the decay ---------------------------------
+
+@(test)
+test_legacy_decay_in_lane_caps_and_bundle_cap :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 1, cat.hash, TEST_LOGIC_HZ)
+	s.era = 3 // era 3: standard is legacy (7 u/s effective), wide is modern (40)
+	res_idx, _ := node_type_index(cat, "residential")
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	r0 := topology_spawn_node(&s.topology, res_idx, {8, 15}, cat)
+	r1 := topology_spawn_node(&s.topology, res_idx, {14, 15}, cat)
+	g := topology_spawn_node(&s.topology, rt_idx, {20, 15}, cat)
+	// parallel bundle: a legacy standard + a modern wide between the same pair
+	sla_draw(&s, cat, r0, g, "standard", 1)
+	sla_draw(&s, cat, r0, g, "wide", 1)
+	sla_draw(&s, cat, r1, g, "wide", 1)
+
+	step_n(&s, 1, cat) // the rule-1 rebuilds fold the era-relative capacities
+
+	// the per-pipe lane caps: the decayed standard's allocation sums to 7
+	// (unconfigured = 100% Standard — the 08-19 default); the wide's to 40.
+	caps_std := qos_pipe_caps(&s.topology, cat, 0, s.topology.pipe_id[0], s.era)
+	total_std := caps_std[0] + caps_std[1] + caps_std[2]
+	testing.expect_value(t, total_std, u32(7))
+	caps_wide := qos_pipe_caps(&s.topology, cat, 1, s.topology.pipe_id[1], s.era)
+	testing.expect_value(t, caps_wide[0] + caps_wide[1] + caps_wide[2], u32(40))
+
+	// the pooled bundle: 7 + 40 = 47 (a legacy member contributes its DECAYED
+	// share — never a view-only illusion; the service pass serves from this).
+	testing.expect_value(t, s.bundles.bundle_cap[0], u32(47))
+	// the modern bundle (r1->g): 40.
+	testing.expect_value(t, s.bundles.bundle_cap[1], u32(40))
+}
+
+// --- the era flip engages the decay -------------------------------------------
+
+@(test)
+test_legacy_era_flip_engages_decay :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 2, cat.hash, TEST_LOGIC_HZ)
+	s.era = 2 // era 2: standard is the newest — NOT legacy, full 15 u/s
+	res_idx, _ := node_type_index(cat, "residential")
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	r0 := topology_spawn_node(&s.topology, res_idx, {8, 15}, cat)
+	r1 := topology_spawn_node(&s.topology, res_idx, {14, 15}, cat)
+	g := topology_spawn_node(&s.topology, rt_idx, {20, 15}, cat)
+	sla_draw(&s, cat, r0, g, "standard", 1)
+	sla_draw(&s, cat, r1, g, "standard", 1)
+	step_n(&s, 1, cat)
+	testing.expect_value(t, s.bundles.bundle_cap[0], u32(15)) // era 2: full
+
+	// the era flip (a scripted advance — the gate-off 6.1 path): the standard
+	// pipes are left behind by era 3 (its newest is wide) -> the NEXT tick
+	// serves at the decayed rate. The derived views rebuild at the fire (the
+	// flip is not a topology mutation — the gen trigger alone would leave
+	// them stale).
+	append(&s.action_log, Command{apply_tick = 10, kind = Cmd_Era_Advance{to_era = 3}})
+	step_n(&s, 10, cat)
+	testing.expect_value(t, s.era, u8(3))
+	testing.expect_value(t, s.bundles.bundle_cap[0], u32(7)) // decayed: 15 × 500/1000
+	testing.expect_value(t, s.flow.lane_caps[0][LANE_STANDARD], u32(7))
+
+	// and a modernize RESTORES the full capacity through the SAME view.
+	append(&s.action_log, Command{apply_tick = 12, kind = Cmd_Set_Pipe_Tier{pipe = 0, tier = 2}}) // wide
+	step_n(&s, 12, cat)
+	testing.expect_value(t, s.bundles.bundle_cap[0], u32(40))
+	testing.expect(t, !era_pipe_is_legacy(cat, s.era, s.topology.pipe_tier[0]), "a modernized pipe is never legacy")
+}
+
+// --- the modernize command (validate + apply) ---------------------------------
+
+@(test)
+test_modernize_validate_and_apply :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 3, cat.hash, TEST_LOGIC_HZ)
+	s.era = 3
+	res_idx, _ := node_type_index(cat, "residential")
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	r0 := topology_spawn_node(&s.topology, res_idx, {8, 15}, cat)
+	r1 := topology_spawn_node(&s.topology, res_idx, {14, 15}, cat)
+	g := topology_spawn_node(&s.topology, rt_idx, {20, 15}, cat)
+	sla_draw(&s, cat, r0, g, "standard", 1) // pipe 0 — legacy at era 3
+	sla_draw(&s, cat, r1, g, "narrow", 1)   // pipe 1 — legacy at era 3
+	step_n(&s, 1, cat) // apply the draws (the action log is the fixture)
+
+	// rejections: unknown pipe, unknown tier, same tier, downgrade.
+	testing.expect_value(t, validate_set_pipe_tier(&s.topology, Cmd_Set_Pipe_Tier{pipe = 99, tier = 2}, cat), Edit_Error.Missing_Pipe)
+	testing.expect_value(t, validate_set_pipe_tier(&s.topology, Cmd_Set_Pipe_Tier{pipe = 0, tier = 9}, cat), Edit_Error.Unknown_Tier)
+	testing.expect_value(t, validate_set_pipe_tier(&s.topology, Cmd_Set_Pipe_Tier{pipe = 0, tier = 1}, cat), Edit_Error.Not_An_Upgrade) // same tier
+	testing.expect_value(t, validate_set_pipe_tier(&s.topology, Cmd_Set_Pipe_Tier{pipe = 1, tier = 0}, cat), Edit_Error.Not_An_Upgrade) // downgrade
+
+	// a valid modernize: narrow -> standard (a tier-up that clears legacy).
+	gen_before := s.topology.gen
+	res, err := topology_apply_edit(&s.topology, Command{kind = Cmd_Set_Pipe_Tier{pipe = 1, tier = 1}}, cat)
+	testing.expect(t, err == .None, "a valid tier-up must apply")
+	testing.expect_value(t, res.id, u32(1))
+	testing.expect_value(t, s.topology.pipe_tier[1], u16(1))
+	testing.expect(t, s.topology.gen == gen_before + 1, "a tier change bumps gen (rule 1 — routing costs + capacity rebuild)")
+	// standard at era 3 is STILL legacy (below wide) — modernize to wide too.
+	res2, err2 := topology_apply_edit(&s.topology, Command{kind = Cmd_Set_Pipe_Tier{pipe = 1, tier = 2}}, cat)
+	testing.expect(t, err2 == .None, "a second tier-up must apply")
+	testing.expect_value(t, res2.id, u32(1))
+	testing.expect(t, !era_pipe_is_legacy(cat, s.era, s.topology.pipe_tier[1]), "wide is never legacy at era 3")
+}
+
+// --- the modernize command rides the action log (replay determinism) ----------
+
+@(test)
+test_modernize_replay_identity :: proc(t: ^testing.T) {
+	// The story's determinism pin: a run whose log carries the modernize
+	// tier-up reproduces byte-identical T1 hashes on replay — the tier bytes,
+	// the derived capacity views and the flow all agree (E10).
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	live: Run_State
+	defer run_destroy(&live)
+	run_init(&live, 5, cat.hash, TEST_LOGIC_HZ)
+	live.era = 3
+	res_idx, _ := node_type_index(cat, "residential")
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	r0 := topology_spawn_node(&live.topology, res_idx, {8, 15}, cat)
+	r1 := topology_spawn_node(&live.topology, res_idx, {14, 15}, cat)
+	g := topology_spawn_node(&live.topology, rt_idx, {20, 15}, cat)
+	sla_draw(&live, cat, r0, g, "standard", 1)
+	sla_draw(&live, cat, r1, g, "standard", 1)
+	append(&live.action_log, Command{apply_tick = 40, kind = Cmd_Set_Pipe_Tier{pipe = 0, tier = 2}})
+	append(&live.action_log, Command{apply_tick = 50, kind = Cmd_Set_Pipe_Tier{pipe = 1, tier = 2}})
+	live_hashes := record_run(&live, 100, cat)
+	defer delete(live_hashes)
+	testing.expect(t, !live.replay_error, "live run must not latch replay_error")
+
+	replayed: Run_State
+	defer run_destroy(&replayed)
+	run_init(&replayed, 5, cat.hash, TEST_LOGIC_HZ)
+	replayed.era = 3
+	r0r := topology_spawn_node(&replayed.topology, res_idx, {8, 15}, cat) // identical fixture (run setup)
+	r1r := topology_spawn_node(&replayed.topology, res_idx, {14, 15}, cat)
+	gr := topology_spawn_node(&replayed.topology, rt_idx, {20, 15}, cat)
+	sla_draw(&replayed, cat, r0r, gr, "standard", 1)
+	sla_draw(&replayed, cat, r1r, gr, "standard", 1)
+	delete(replayed.action_log)
+	replayed.action_log = clone_log(live.action_log)
+	replay_hashes := record_run(&replayed, 100, cat)
+	defer delete(replay_hashes)
+
+	testing.expect(t, !replayed.replay_error, "replay must not latch replay_error (ODN-11 critical)")
+	diverged := false
+	for i in 0..<len(live_hashes) {
+		if live_hashes[i] != replay_hashes[i] {
+			diverged = true
+		}
+	}
+	testing.expectf(t, !diverged, "REPLAY DIVERGENCE with the modernize command: live vs replay hashes differ")
+}
+
+// --- the wire round-trip (the log tag) -----------------------------------------
+
+@(test)
+test_modernize_log_round_trip :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 7, cat.hash, TEST_LOGIC_HZ)
+	s.era = 2
+	append(&s.action_log, Command{apply_tick = 5, kind = Cmd_Set_Pipe_Tier{pipe = 3, tier = 2}})
+	log := log_write(&s, context.temp_allocator, s.era)
+	h, cmds, ok := log_read(log, context.temp_allocator)
+	testing.expect(t, ok, "the modernize log must parse")
+	testing.expect(t, ok && len(cmds) == 1, "one command must round-trip")
+	if ok && len(cmds) == 1 {
+		testing.expect_value(t, h.era, u8(2))
+		c, is_tier := cmds[0].kind.(Cmd_Set_Pipe_Tier)
+		testing.expect(t, is_tier, "the round-tripped command must be Cmd_Set_Pipe_Tier")
+		testing.expect_value(t, c.pipe, u32(3))
+		testing.expect_value(t, c.tier, u16(2))
+	}
+}
+
+// --- demolish clears legacy -----------------------------------------------------
+
+@(test)
+test_demolish_clears_legacy :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 11, cat.hash, TEST_LOGIC_HZ)
+	s.era = 3
+	res_idx, _ := node_type_index(cat, "residential")
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	r0 := topology_spawn_node(&s.topology, res_idx, {8, 15}, cat)
+	r1 := topology_spawn_node(&s.topology, res_idx, {14, 15}, cat)
+	g := topology_spawn_node(&s.topology, rt_idx, {14, 8}, cat)
+	sla_draw(&s, cat, r0, g, "narrow", 1) // pipe 0 — decayed to 5 at era 3 (span 7 <= narrow max 10)
