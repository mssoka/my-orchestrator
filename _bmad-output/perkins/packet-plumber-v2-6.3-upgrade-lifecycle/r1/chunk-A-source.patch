 	state.era_advance_to = 0
+	// 6.3: the era flip ENGAGES the decay — every pipe the new era leaves
+	// behind (below its newest unlocked tier) is legacy NOW. The derived
+	// capacity views (bundle static sums + per-pipe lane caps) are gen-gated
+	// (rule 1), and the era flip is NOT a topology mutation, so rebuild them
+	// HERE: the next tick's flow serves at the decayed rates. Deterministic —
+	// replay re-runs the identical flip + rebuild (the views are derived,
+	// never serialized). The routing table is untouched (tier costs don't
+	// change at a flip — only effective capacities do).
+	bundles_rebuild(&state.bundles, &state.topology, cat, state.era)
+	state.bundles_gen = state.topology.gen
+	flow_lane_caps_rebuild(state, cat)
 	event_emit_era(state, tick, new_era)
 }
