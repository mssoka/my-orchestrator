+
+// --- the 6.2-seam cross-test: the gate and the lifecycle agree ------------------
+
+@(test)
+test_legacy_gate_lifecycle_agreement :: proc(t: ^testing.T) {
+	// The briefing's deliverable-3 cross-test: the legacy-pipe predicate the
+	// 6.2 gate blocks on IS the definition the decay applies — for every
+	// in-service pipe at every era, "the gate names it legacy" == "the
+	// lifecycle decays it" (effective < raw). One predicate, two consumers —
+	// the agreement is by construction; this pins it.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+
+	na, _ := pipe_tier_index(cat, "narrow")
+	std, _ := pipe_tier_index(cat, "standard")
+	wd, _ := pipe_tier_index(cat, "wide")
+	tiers := [3]u16{na, std, wd}
+
+	// The agreement holds wherever the decay factor is ACTIVE (era >= 2): the
+	// gate's legacy name and the decay are the same predicate, same set. Era 1
+	// is the one documented split: its factor is 1000 (the foundation era
+	// leaves nothing behind — no decay), while the predicate still names
+	// below-newest pipes as legacy (the GATE's modernization bar: narrows are
+	// "baseline legacy" [GDD M1] and must be modernized before the 1->2
+	// advance — if the player neglects them, era 2's factor decays them). The
+	// era-1 split is pinned explicitly so it can never silently drift.
+	for era in u8(0)..=3 {
+		for tier in tiers {
+			legacy := era_pipe_is_legacy(cat, era, tier)
+			raw := u32(cat.pipe_tiers[tier].capacity_units)
+			eff := pipe_effective_capacity(cat, era, tier)
+			decayed := eff < raw
+			if era >= 2 && legacy != decayed {
+				testing.expectf(t, false,
+					"gate/lifecycle disagreement at era %d tier %d: legacy=%v decayed=%v (raw %d eff %d)",
+					era, tier, legacy, decayed, raw, eff)
+			}
+			if era == 1 && legacy && !decayed {
+				// the documented split: named legacy (the gate bar), factor 1000 (no decay)
+				continue
+			}
+		}
+	}
+
+	// the gate's blocking set is the decayed set, on a live mixed topology:
+	// era 2 with a narrow + standard in service -> the gate names exactly the
+	// narrow (the 6.2 golden advance_block_legacy's shape).
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 13, cat.hash, TEST_LOGIC_HZ)
+	s.era = 2
+	s.advance_gate_enabled = true
+	res_idx, _ := node_type_index(cat, "residential")
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	r0 := topology_spawn_node(&s.topology, res_idx, {8, 15}, cat)
+	r1 := topology_spawn_node(&s.topology, res_idx, {14, 15}, cat)
+	g := topology_spawn_node(&s.topology, rt_idx, {20, 15}, cat)
+	sla_draw(&s, cat, r0, g, "standard", 1)
+	sla_draw(&s, cat, r1, g, "narrow", 1) // the legacy stub (advance_block_legacy shape)
+	step_n(&s, 1, cat) // apply the draws
+	testing.expect(t, !era_gate_legacy_ok(&s, cat), "the gate must block on the legacy narrow")
+	testing.expect_value(t, pipe_effective_capacity(cat, s.era, s.topology.pipe_tier[1]), u32(5))
+	// modernize the stub (tier-up to standard): the gate unblocks AND the
+	// decay clears — the same flip.
+	_, err := topology_apply_edit(&s.topology, Command{kind = Cmd_Set_Pipe_Tier{pipe = 1, tier = 1}}, cat)
+	testing.expect(t, err == .None, "the modernize must apply")
+	testing.expect(t, era_gate_legacy_ok(&s, cat), "after the modernize the gate must unblock")
+	testing.expect_value(t, pipe_effective_capacity(cat, s.era, s.topology.pipe_tier[1]), u32(15))
+}
+
+// --- the story's GWT: decayed vs modernized throughput (measurable) -------------
+
+@(test)
+test_legacy_decayed_vs_modernized_throughput :: proc(t: ^testing.T) {
+	// The story's Given/When/Then: "legacy decay is MEASURABLE (effective
+	// throughput decays); modernizing restores full throughput". The SAME
+	// topology + the SAME demand, era 3: the decayed run (standard pipes —
+	// legacy) sheds; the modernized run (tier-up to wide) delivers it all.
+	// The contrast is the measurement. The era-3 DIRECTOR demand (the credit-
+	// gated streaming + the surge set-piece) is cleared first — the two runs
+	// then carry EXACTLY the seeded 20 packets, so the delivered/dropped
+	// contrast is the decay's, not the director's.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	defer catalogs_destroy(cat)
+	clear(&cat.demand.eras[2].entries)
+	clear(&cat.demand.eras[2].set_pieces)
+
+	build :: proc(cat: ^Catalogs, seed: u64, modernize: bool) -> (delivered: u64, dropped: u64) {
+		s: Run_State
+		defer run_destroy(&s)
+		run_init(&s, seed, cat.hash, TEST_LOGIC_HZ)
+		s.era = 3
+		res_idx, _ := node_type_index(cat, "residential")
+		rt_idx, _ := node_type_index(cat, "router_basic")
+		host_idx, _ := node_type_index(cat, "content_host")
+		r0 := topology_spawn_node(&s.topology, res_idx, {8, 15}, cat)
+		g := topology_spawn_node(&s.topology, rt_idx, {16, 15}, cat)
+		h := topology_spawn_node(&s.topology, host_idx, {24, 15}, cat)
+		// the streaming path: host -> router -> res over STANDARD pipes.
+		// (The era-3 spec also spawns email; the seeded demand below is the
+		// measurement's own — deterministic, no rng.)
+		sla_draw(&s, cat, h, g, "standard", 1)
+		sla_draw(&s, cat, g, r0, "standard", 1)
+		if modernize {
+			append(&s.action_log, Command{apply_tick = 1, kind = Cmd_Set_Pipe_Tier{pipe = 0, tier = 2}})
+			append(&s.action_log, Command{apply_tick = 1, kind = Cmd_Set_Pipe_Tier{pipe = 1, tier = 2}})
+		}
+		// 20 streaming packets, one per tick (30 u each) — the same demand
+		// in both runs.
+		for i in u64(1)..=20 {
+			flow_seed_demand(&s.flow, i, h, r0, 1)
+		}
+		for tick in u64(1)..=400 {
+			batch := make([dynamic]Command, 0, 4, context.temp_allocator)
+			for cmd in s.action_log {
+				if cmd.apply_tick == tick {
+					append(&batch, cmd)
+				}
+			}
+			step(&s, tick, batch[:], cat)
+			clear(&s.events)
+			free_all(context.temp_allocator)
+		}
+		testing.expectf(nil, !s.replay_error, "no draw may be rejected")
+		return s.flow.sla[1].delivered, s.flow.sla[1].dropped
+	}
+
+	decayed_delivered, decayed_dropped := build(cat, 42, false)
+	modern_delivered, modern_dropped := build(cat, 42, true)
+
+	// the measurement: the modernized run carries everything the decayed run
+	// sheds (and delivers at least the same).
+	testing.expectf(t, modern_delivered == 20, "the modernized path must deliver all 20 packets, got %d", modern_delivered)
+	testing.expectf(t, decayed_delivered < 20, "the decayed path must shed (measurable decay), delivered %d", decayed_delivered)
+	testing.expectf(t, decayed_dropped > 0, "the decayed path must drop, got %d", decayed_dropped)
+	testing.expectf(t, modern_dropped == 0, "the modernized path must not drop, got %d", modern_dropped)
+}
