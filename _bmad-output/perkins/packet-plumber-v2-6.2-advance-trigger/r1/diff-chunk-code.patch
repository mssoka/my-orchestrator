+package core
+
+// advance_gate_test.odin — Story 6.2's durable contracts (arch §6.6, GDD M4):
+// the era-advance modernization gate. Pins:
+//   (a) the FIRE path — all three conditions hold (sustained windowed SLA
+//       >= 95% across the era's active classes, all in-service legacy pipes
+//       modernized, no active crisis) -> the advance fires (era+1, the gate
+//       is the trigger — no scripted request needed);
+//   (b) each BLOCK path — the SLA term (windowed ratio < 95%), the legacy
+//       term (an in-service pipe below the era's newest tier), and the E15
+//       crisis term (an active crisis blocks; the gate re-evaluates when the
+//       crisis clears) — each observable via Era_Advance_Blocked{reason};
+//   (c) the milestone-window SLA MEASUREMENT itself (the E30 ring: windowed
+//       delivery ratio, E24 zero-completion neutrality, the window-elapsed
+//       precondition);
+//   (d) replay determinism — the gate is a pure function of serialized state,
+//       so a gate-fired live run replays byte-identically;
+//   (e) the last-era inertness (a real 3-era table: era 3 has no forward
+//       target — the gate emits nothing).
+
+import "core:testing"
+
+
+// era_test_catalog_3 — the test table WITHOUT era 4 (the real catalog's shape:
+// eras 1-3, era 3 terminal). The fire tests use this so a fired advance to era
+// 3 leaves the gate INERT (no post-fire legacy artifact from a test-only era 4).
+era_test_catalog_3 :: proc(cat: ^Catalogs, allocator := context.allocator) -> ^Catalogs {
+	cat3 := era_test_catalog(cat, allocator)
+	pop(&cat3.eras) // era 4 was the last row — drop it
+	return cat3
+}
+
+// gate_fixture — a healthy era-2 network: residential(0) @{8,15},
+// residential(1) @{14,15} (the res->res email sink set), router(2) @{20,15}
+// (the fixture's router; the director needs a junction for routing), all
+// drawn STANDARD (the era-2 newest tier — NOT legacy). The era-2 email
+// spec (res->res volume 2) flows with zero drops -> windowed SLA 100%.
+gate_fixture :: proc(s: ^Run_State, cat: ^Catalogs) {
+	res_idx, _ := node_type_index(cat, "residential")
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	r0 := topology_spawn_node(&s.topology, res_idx, {8, 15}, cat)
+	r1 := topology_spawn_node(&s.topology, res_idx, {14, 15}, cat)
+	g := topology_spawn_node(&s.topology, rt_idx, {20, 15}, cat)
+	sla_draw(s, cat, r0, g, "standard", 1)
+	sla_draw(s, cat, r1, g, "standard", 1)
+}
+
+// gate_record_run — step a run collecting the FULL event stream + the
+// per-tick hashes (the ODN-14 drain convention — collect as you step). The
+// gate tests need the Era_Advance_Blocked + Era_Advanced events.
+gate_record_run :: proc(s: ^Run_State, ticks: u64, cat: ^Catalogs) -> ([dynamic]u64, [dynamic]Event) {
+	hashes := make([dynamic]u64, 0, ticks)
+	events := make([dynamic]Event, 0, 8)
+	start := s.tick + 1
+	for tick in start ..< start + ticks {
+		before := len(s.events)
+		batch := make([dynamic]Command, 0, 4, context.temp_allocator)
+		for cmd in s.action_log {
+			if cmd.apply_tick == tick {
+				append(&batch, cmd)
+			}
+		}
+		step(s, tick, batch[:], cat)
+		for e in s.events[before:] {
+			append(&events, e)
+		}
+		append(&hashes, state_hash(s, s.events[before:], cat, context.temp_allocator))
+		clear(&s.events)
+		free_all(context.temp_allocator)
+	}
+	return hashes, events
+}
+
+// gate_advance_events — the era gate's own events (Era_Advance_Blocked +
+// Era_Advanced), in order.
+gate_advance_events :: proc(evs: []Event, allocator := context.allocator) -> [dynamic]Event {
+	out := make([dynamic]Event, 0, 4, allocator)
+	for e in evs {
+		if e.tag == EVENT_TAG_ERA_ADVANCE_BLOCKED || e.tag == EVENT_TAG_ERA_ADVANCED {
+			append(&out, e)
+		}
+	}
+	return out
+}
+
+@(test)
+test_advance_gate_fires_when_conditions_hold :: proc(t: ^testing.T) {
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	era_test_catalog_3(cat) // eras 1-3 only — a fired era 2->3 leaves the gate inert
+	defer catalogs_destroy(cat)
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 42, cat.hash, TEST_LOGIC_HZ)
+	s.era = 2
+	s.advance_gate_enabled = true
+	gate_fixture(&s, cat)
+
+	// healthy era-2 email flow; the milestone window (600) elapses at tick 600
+	// with 100% windowed SLA -> the gate fires era 2->3 on its own (the gate
+	// is the trigger — no scripted request in the log).
+	_, evs := gate_record_run(&s, 700, cat)
+	defer delete(evs)
+
+	ga := gate_advance_events(evs[:])
+	defer delete(ga)
+	testing.expect(t, len(ga) >= 1, "the gate must emit an advance event")
+	testing.expect_value(t, s.era, u8(3))
+	testing.expect_value(t, s.era_advance_to, u8(0))
+	testing.expect(t, !s.replay_error, "an honest gate-fired advance must not latch replay_error")
+	// exactly one fire, no block (the healthy run never enters a blocked state)
+	fires := 0
+	blocks := 0
+	for e in ga {
+		if e.tag == EVENT_TAG_ERA_ADVANCED { fires += 1 }
+		if e.tag == EVENT_TAG_ERA_ADVANCE_BLOCKED { blocks += 1 }
+	}
+	testing.expect_value(t, fires, 1)
+	testing.expect_value(t, blocks, 0)
+}
+
+@(test)
+test_advance_gate_replay_identity :: proc(t: ^testing.T) {
+	// the story's determinism pin: a gate-fired live run and its replay (same
+	// seed + setup + log, gate enabled in BOTH paths — the flag is run setup)
+	// reproduce byte-identical per-tick hashes. The gate is a pure function of
+	// serialized state (flow.sla accumulators + topology + crisis registry +
+	// era + tick) + catalogs; the milestone ring is derived, never serialized.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	era_test_catalog_3(cat) // eras 1-3 only
+	defer catalogs_destroy(cat)
+
+	live: Run_State
+	defer run_destroy(&live)
+	run_init(&live, 7, cat.hash, TEST_LOGIC_HZ)
+	live.era = 2
+	live.advance_gate_enabled = true
+	gate_fixture(&live, cat)
+	live_hashes, _ := gate_record_run(&live, 700, cat)
+	defer delete(live_hashes)
+	testing.expect_value(t, live.era, u8(3))
+	testing.expect(t, !live.replay_error, "live run must not latch replay_error")
+
+	replayed: Run_State
+	defer run_destroy(&replayed)
+	run_init(&replayed, 7, cat.hash, TEST_LOGIC_HZ)
+	replayed.era = 2
+	replayed.advance_gate_enabled = true // run setup — re-created identically on replay
+	gate_fixture(&replayed, cat)
+	delete(replayed.action_log)
+	replayed.action_log = clone_log(live.action_log)
+	replay_hashes, _ := gate_record_run(&replayed, 700, cat)
+	defer delete(replay_hashes)
+
+	testing.expect_value(t, replayed.era, u8(3))
+	testing.expect(t, !replayed.replay_error, "replay must not latch replay_error (ODN-11 critical)")
+	diverged := false
+	for i in 0..<len(live_hashes) {
+		if live_hashes[i] != replay_hashes[i] {
+			diverged = true
+		}
+	}
+	testing.expectf(t, !diverged, "REPLAY DIVERGENCE with the advance gate: live vs replay hashes differ")
+}
+
+@(test)
+test_advance_gate_sla_block :: proc(t: ^testing.T) {
+	// the SLA block path: a healthy-LEGACY topology flooded hard enough that
+	// the windowed delivery ratio sits below 95% — the gate reports .Sla and
+	// never fires. Standard pipes (era-2 newest tier) keep the legacy term out
+	// of the way; no crisis. E24: a zero-completion window measures nothing —
+	// we flood, so demand exists.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	era_test_catalog(cat)
+	defer catalogs_destroy(cat)
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 11, cat.hash, TEST_LOGIC_HZ)
+	s.era = 2
+	s.advance_gate_enabled = true
+	res_idx, _ := node_type_index(cat, "residential")
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	// ONE standard pipe res0->router + res1->router: the shared router pipe
+	// (res1->router) is the bottleneck — flood email res1->router with 6/tick
+	// (the E9 lane bound is 6, so the queue saturates and sheds).
+	r0 := topology_spawn_node(&s.topology, res_idx, {8, 15}, cat)
+	r1 := topology_spawn_node(&s.topology, res_idx, {14, 15}, cat)
+	g := topology_spawn_node(&s.topology, rt_idx, {20, 15}, cat)
+	sla_draw(&s, cat, r0, g, "standard", 1)
+	sla_draw(&s, cat, r1, g, "standard", 1)
+	for tick in u64(2)..=400 {
+		flow_seed_demand(&s.flow, tick, r1, g, u16(0)) // legacy path — floods bypass the credit cap
+	}
+
+	_, evs := gate_record_run(&s, 700, cat)
+	defer delete(evs)
+
+	ga := gate_advance_events(evs[:])
+	defer delete(ga)
+	testing.expect(t, s.era == u8(2), "the SLA-blocked advance must never fire")
+	testing.expect(t, !s.replay_error, "the SLA block must not latch replay_error")
+	saw_sla := false
+	for e in ga {
+		if e.tag == EVENT_TAG_ERA_ADVANCE_BLOCKED && Advance_Block_Reason(e.reason) == .Sla {
+			saw_sla = true
+		}
+	}
+	testing.expect(t, saw_sla, "the gate must emit Era_Advance_Blocked{Sla}")
+}
+
+@(test)
+test_advance_gate_legacy_block_and_modernize :: proc(t: ^testing.T) {
+	// the legacy block path + the modernization recovery: a NARROW pipe in
+	// service in era 2 (era 2's newest tier is standard) blocks the advance;
+	// demolishing the narrow + redrawing standard modernizes -> the gate
+	// re-evaluates and fires. The healthy-email flow keeps the SLA term out
+	// of the way; no crisis.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	era_test_catalog(cat)
+	defer catalogs_destroy(cat)
+
+	s: Run_State
+	defer run_destroy(&s)
+	run_init(&s, 5, cat.hash, TEST_LOGIC_HZ)
+	s.era = 2
+	s.advance_gate_enabled = true
+	res_idx, _ := node_type_index(cat, "residential")
+	rt_idx, _ := node_type_index(cat, "router_basic")
+	r0 := topology_spawn_node(&s.topology, res_idx, {8, 15}, cat)
+	r1 := topology_spawn_node(&s.topology, res_idx, {14, 15}, cat)
+	g := topology_spawn_node(&s.topology, rt_idx, {20, 15}, cat)
+	// the traffic path: standard (modern). The legacy pipe: a NARROW stub
+	// r1->router (6 tiles — within narrow max_span 10; tier 0 < era-2 newest
+	// standard) — in service, unmodernized.
+	sla_draw(&s, cat, r0, g, "standard", 1)
+	sla_draw(&s, cat, r1, g, "standard", 1)
+	sla_draw(&s, cat, r1, g, "narrow", 2) // parallel narrow stub — LEGACY in era 2
+
+	// modernize at tick 400: demolish the narrow stub (pipe 2), redraw standard.
+	append(&s.action_log, Command{apply_tick = 400, kind = Cmd_Demolish_Pipe{pipe = 2}})
+	append(&s.action_log, Command{apply_tick = 401, kind = Cmd_Draw_Pipe{a = r1, b = g, tier = 1}}) // standard
+
+	_, evs := gate_record_run(&s, 700, cat)
+	defer delete(evs)
+
+	ga := gate_advance_events(evs[:])
+	defer delete(ga)
+	testing.expect(t, s.era == u8(3), "after modernization the gate must fire")
+	testing.expect(t, !s.replay_error, "the modernize path must not latch replay_error")
+	saw_legacy := false
+	for e in ga {
+		if e.tag == EVENT_TAG_ERA_ADVANCE_BLOCKED && Advance_Block_Reason(e.reason) == .Legacy {
+			saw_legacy = true
+		}
+	}
+	testing.expect(t, saw_legacy, "the gate must emit Era_Advance_Blocked{Legacy} while the narrow is in service")
+}
+
+@(test)
+test_advance_gate_crisis_block_e15 :: proc(t: ^testing.T) {
+	// E15 — an active crisis BLOCKS the advance (the headline contract). The
+	// test-table era 4 gives era 3 a forward target; the real surge set-piece
+	// + the saturated narrow fixture fire a REAL crisis (the 6.1 E14 scenario).
+	// While the crisis is active the gate reports .Crisis and never fires; when
+	// the crisis clears (the wides fix lands), the SLA window recovers and the
+	// gate re-evaluates and fires era 3->4 — deterministic.
+	cat_storage: Catalogs
+	cat := test_catalog(&cat_storage)
+	era_test_catalog(cat)
