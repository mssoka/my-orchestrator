diff --git a/server/test/reference_checks/schema_migration_test.gleam b/server/test/reference_checks/schema_migration_test.gleam
new file mode 100644
index 00000000..2fbdce03
--- /dev/null
+++ b/server/test/reference_checks/schema_migration_test.gleam
@@ -0,0 +1,157 @@
+//// Pins the reference_call schema migration's load-bearing invariants by
+//// reading the migration FILE (audit_log_schema_test precedent) — DB-free
+//// CI catches a future edit that quietly reintroduces a correction_token,
+//// drops 'skipped' from the live-slot semantics, or couples the objection
+//// log to its parents with a foreign key.
+
+import gleam/list
+import gleam/string
+import gleeunit/should
+import simplifile
+
+const migration_path = "../supabase/migrations/20260731222000_create_reference_call.sql"
+
+const notification_migration_path = "../supabase/migrations/20260731222001_add_reference_notification_types.sql"
+
+fn read_migration() -> String {
+  let assert Ok(contents) = simplifile.read(migration_path)
+  contents
+}
+
+/// The migration with `--` comment lines stripped — invariant checks run
+/// against the DDL only, so prose explaining an absence (e.g. "NO
+/// correction_token") can't trip the check that enforces the absence.
+fn read_ddl() -> String {
+  strip_comments(read_migration())
+}
+
+fn strip_comments(contents: String) -> String {
+  contents
+  |> string.split("\n")
+  |> list.filter(fn(line) { !string.starts_with(string.trim_start(line), "--") })
+  |> string.join("\n")
+}
+
+/// Everything from `CREATE TABLE reference_objection_log` onwards — the
+/// block that must stay FK-free.
+fn objection_log_block() -> String {
+  let contents = read_ddl()
+  let assert Ok(#(_, block)) =
+    string.split_once(contents, "CREATE TABLE reference_objection_log")
+  block
+}
+
+pub fn no_correction_token_anywhere_test() {
+  // A1: correction/substitution is landlord-driven — no token column,
+  // no index, not even a mention in the DDL.
+  read_ddl()
+  |> string.contains("correction_token")
+  |> should.be_false
+}
+
+pub fn skipped_in_status_enum_test() {
+  read_ddl()
+  |> string.contains("'skipped'")
+  |> should.be_true
+}
+
+pub fn skipped_not_in_live_index_exclusion_test() {
+  // A6: a skipped row still occupies its slot. The live index's NOT IN
+  // list must name every terminal status but never 'skipped'.
+  let contents = read_ddl()
+  let assert Ok(#(_, index_block)) =
+    string.split_once(contents, "CREATE UNIQUE INDEX idx_reference_call_live")
+  let assert Ok(#(exclusion, _)) = string.split_once(index_block, ";")
+  exclusion |> string.contains("'skipped'") |> should.be_false
+  // …and the eight terminal values must all be there.
+  let terminals = [
+    "'form_completed'", "'unreachable'", "'refused'", "'objected'",
+    "'manual_recorded'", "'failed'", "'completed'", "'partial'",
+  ]
+  list_each_true(terminals, fn(t) { string.contains(exclusion, t) })
+}
+
+pub fn amended_columns_present_test() {
+  let contents = read_ddl()
+  list_each_true(
+    ["draft_answers", "taken_over_at", "corrected_email", "corrected_phone"],
+    fn(c) { string.contains(contents, c) },
+  )
+}
+
+pub fn outcome_enum_has_v1_amendments_test() {
+  let contents = read_ddl()
+  let assert Ok(#(_, outcome_block)) =
+    string.split_once(contents, "CREATE TYPE reference_call_outcome")
+  let assert Ok(#(outcomes, _)) = string.split_once(outcome_block, ";")
+  list_each_true(
+    ["'unreachable'", "'form_completed'", "'manual_recorded'"],
+    fn(v) { string.contains(outcomes, v) },
+  )
+}
+
+pub fn objection_log_has_no_foreign_keys_test() {
+  let block = objection_log_block()
+  block |> string.contains("REFERENCES") |> should.be_false
+  block |> string.contains("FOREIGN KEY") |> should.be_false
+}
+
+pub fn objection_log_retention_default_test() {
+  objection_log_block()
+  |> string.contains("DEFAULT 'objection_evidence'")
+  |> should.be_true
+}
+
+pub fn objection_log_purge_index_test() {
+  objection_log_block()
+  |> string.contains("idx_reference_objection_log_purge")
+  |> should.be_true
+}
+
+pub fn updated_at_uses_existing_trigger_function_test() {
+  let contents = read_ddl()
+  contents
+  |> string.contains("EXECUTE FUNCTION update_updated_at_column()")
+  |> should.be_true
+  // The generic function already exists (20260409000001) — this migration
+  // must not redefine it.
+  contents
+  |> string.contains("CREATE OR REPLACE FUNCTION update_updated_at_column")
+  |> should.be_false
+}
+
+pub fn required_indexes_present_test() {
+  let contents = read_ddl()
+  list_each_true(
+    [
+      "idx_reference_call_live", "idx_reference_call_form_token",
+      "idx_reference_call_sweep", "idx_reference_call_application",
+      "idx_reference_call_contact_phone", "idx_reference_call_purge",
+    ],
+    fn(i) { string.contains(contents, i) },
+  )
+}
+
+pub fn notification_types_migration_test() {
+  let assert Ok(contents) = simplifile.read(notification_migration_path)
+  // Strip comments here too — the ALTER TYPE statements must carry the
+  // values, not the header prose.
+  let ddl = strip_comments(contents)
+  list_each_true(
+    [
+      "'reference_completed'", "'reference_unreachable'", "'reference_objected'",
+      "'reference_declined'",
+    ],
+    fn(v) { string.contains(ddl, v) },
+  )
+}
+
+fn list_each_true(xs: List(String), f: fn(String) -> Bool) -> Nil {
+  case xs {
+    [] -> Nil
+    [x, ..rest] -> {
+      f(x) |> should.be_true
+      list_each_true(rest, f)
+    }
+  }
+}
diff --git a/shared/src/shared/reference_call.gleam b/shared/src/shared/reference_call.gleam
new file mode 100644
index 00000000..49ac642f
--- /dev/null
+++ b/shared/src/shared/reference_call.gleam
@@ -0,0 +1,381 @@
+//// Reference-call lifecycle types and JSON codecs — the shared contract for
+//// the `reference_call` table (architecture-reference-checking-v1 §4.1 as
+//// amended by the epics doc's A-register). Wire strings are snake_case and
+//// match the Postgres enums / TEXT+CHECK values exactly.
+////
+//// v2-reserved variants (voice lifecycle) are part of the contract now so a
+//// stored row from any future version still decodes; v1 code paths never
+//// construct them.
+
+import gleam/dynamic/decode
+import gleam/json
+
+/// Mirrors the `reference_call_status` PG enum (14 values).
+/// `partial` is v1-active (A2: abandoned-with-draft-answers terminal);
+/// `skipped` is v1-active (A6) and occupies its live slot.
+pub type ReferenceCallStatus {
+  Queued
+  Skipped
+  ContactInitiated
+  AwaitingCorrection
+  /// v2-reserved (voice)
+  Scheduled
+  /// v2-reserved (voice)
+  Calling
+  /// v2-reserved (voice)
+  Completed
+  Partial
+  FormCompleted
+  Unreachable
+  Refused
+  Objected
+  ManualRecorded
+  Failed
+}
+
+/// Mirrors the `reference_call_outcome` PG enum (15 values, incl. the §6.4
+/// additions `unreachable`, `form_completed`, `manual_recorded`).
+/// Constructors are `Outcome`-prefixed: Gleam constructor names are
+/// module-global and would otherwise collide with the status variants.
+pub type ReferenceCallOutcome {
+  OutcomeCompleted
+  OutcomePartial
+  OutcomeVoicemail
+  OutcomeNoAnswer
+  OutcomeBusy
+  OutcomeRefused
+  OutcomeWrongNumber
+  OutcomeInvalidNumber
+  OutcomeDeclinedAi
+  OutcomeLanguageBarrier
+  OutcomeGatekeeperBlocked
+  OutcomeObjected
+  OutcomeUnreachable
+  OutcomeFormCompleted
+  OutcomeManualRecorded
+}
+
+/// Mirrors the `ref_slot` TEXT+CHECK set.
+pub type RefSlot {
+  LandlordRef
+  CharacterRef
+  EmployerRef
+}
+
+/// Mirrors the `owner_label` TEXT+CHECK set.
+pub type OwnerLabel {
+  Primary
+  CoApplicant0
+  CoApplicant1
+  CoApplicant2
+}
+
+/// Mirrors the `channel` TEXT+CHECK set on `reference_call` (the result
+/// channel). `Manual` is the v1 WoZ channel (AD-8); `Voice` is v2-reserved.
+/// NOTE: `reference_objection_log.channel` is a DIFFERENT domain — the
+/// channel the objection ARRIVED on — use `ObjectionChannel` for that table.
+pub type Channel {
+  Form
+  Manual
+  Voice
+}
+
+/// Mirrors the `reference_objection_log.channel` TEXT+CHECK set — how the
+/// Art 21 objection arrived, not how the reference was collected.
+pub type ObjectionChannel {
+  ObjectionForm
+  ObjectionSms
+  ObjectionEmail
+}
+
+// -- Status codecs ------------------------------------------------------------
+
+pub fn encode_status(status: ReferenceCallStatus) -> String {
+  case status {
+    Queued -> "queued"
+    Skipped -> "skipped"
+    ContactInitiated -> "contact_initiated"
+    AwaitingCorrection -> "awaiting_correction"
+    Scheduled -> "scheduled"
+    Calling -> "calling"
+    Completed -> "completed"
+    Partial -> "partial"
+    FormCompleted -> "form_completed"
+    Unreachable -> "unreachable"
+    Refused -> "refused"
+    Objected -> "objected"
+    ManualRecorded -> "manual_recorded"
+    Failed -> "failed"
+  }
+}
+
+pub fn encode_status_json(status: ReferenceCallStatus) -> json.Json {
+  json.string(encode_status(status))
+}
+
+/// Total inverse of `encode_status` for trusted DB strings (the
+/// `reference_call_status` enum is NOT NULL and constrained to these values).
+/// Unknown input falls back to `Failed` — deliberately the most INERT value
+/// (terminal, never sweep-actionable): forward compatibility must never
+/// silently reinterpret an unrecognised value as live work. Callers reading
+/// COALESCE'd query results must branch on '' BEFORE calling this.
+pub fn status_from_string(value: String) -> ReferenceCallStatus {
+  case value {
+    "queued" -> Queued
+    "skipped" -> Skipped
+    "contact_initiated" -> ContactInitiated
+    "awaiting_correction" -> AwaitingCorrection
+    "scheduled" -> Scheduled
+    "calling" -> Calling
+    "completed" -> Completed
+    "partial" -> Partial
+    "form_completed" -> FormCompleted
+    "unreachable" -> Unreachable
+    "refused" -> Refused
+    "objected" -> Objected
+    "manual_recorded" -> ManualRecorded
+    "failed" -> Failed
+    _ -> Failed
+  }
+}
+
+/// Dynamic decoder — unknown strings FAIL (unlike `status_from_string`), so
+/// malformed API payloads surface as decode errors rather than silent
+/// coercions (ai_analysis.gleam precedent).
+pub fn status_decoder() -> decode.Decoder(ReferenceCallStatus) {
+  use value <- decode.then(decode.string)
+  case value {
+    "queued" -> decode.success(Queued)
+    "skipped" -> decode.success(Skipped)
+    "contact_initiated" -> decode.success(ContactInitiated)
+    "awaiting_correction" -> decode.success(AwaitingCorrection)
+    "scheduled" -> decode.success(Scheduled)
+    "calling" -> decode.success(Calling)
+    "completed" -> decode.success(Completed)
+    "partial" -> decode.success(Partial)
+    "form_completed" -> decode.success(FormCompleted)
+    "unreachable" -> decode.success(Unreachable)
+    "refused" -> decode.success(Refused)
+    "objected" -> decode.success(Objected)
+    "manual_recorded" -> decode.success(ManualRecorded)
+    "failed" -> decode.success(Failed)
+    _ -> decode.failure(Queued, "ReferenceCallStatus")
+  }
+}
+
+// -- Outcome codecs -----------------------------------------------------------
+
+pub fn encode_outcome(outcome: ReferenceCallOutcome) -> String {
+  case outcome {
+    OutcomeCompleted -> "completed"
+    OutcomePartial -> "partial"
+    OutcomeVoicemail -> "voicemail"
+    OutcomeNoAnswer -> "no_answer"
+    OutcomeBusy -> "busy"
+    OutcomeRefused -> "refused"
+    OutcomeWrongNumber -> "wrong_number"
+    OutcomeInvalidNumber -> "invalid_number"
+    OutcomeDeclinedAi -> "declined_ai"
+    OutcomeLanguageBarrier -> "language_barrier"
+    OutcomeGatekeeperBlocked -> "gatekeeper_blocked"
+    OutcomeObjected -> "objected"
+    OutcomeUnreachable -> "unreachable"
+    OutcomeFormCompleted -> "form_completed"
+    OutcomeManualRecorded -> "manual_recorded"
+  }
+}
+
+pub fn encode_outcome_json(outcome: ReferenceCallOutcome) -> json.Json {
+  json.string(encode_outcome(outcome))
+}
+
+/// Total inverse of `encode_outcome` for trusted DB strings. Unknown input
+/// falls back to `OutcomeUnreachable` — deliberately NOT a success value:
+/// §10 frames unreachability as neutral-absence, so an unrecognised value
+/// can never be silently reinterpreted as a completed reference. Callers
+/// reading COALESCE'd query results must branch on '' BEFORE calling this.
+pub fn outcome_from_string(value: String) -> ReferenceCallOutcome {
+  case value {
+    "completed" -> OutcomeCompleted
+    "partial" -> OutcomePartial
+    "voicemail" -> OutcomeVoicemail
+    "no_answer" -> OutcomeNoAnswer
+    "busy" -> OutcomeBusy
+    "refused" -> OutcomeRefused
+    "wrong_number" -> OutcomeWrongNumber
+    "invalid_number" -> OutcomeInvalidNumber
+    "declined_ai" -> OutcomeDeclinedAi
+    "language_barrier" -> OutcomeLanguageBarrier
+    "gatekeeper_blocked" -> OutcomeGatekeeperBlocked
+    "objected" -> OutcomeObjected
+    "unreachable" -> OutcomeUnreachable
+    "form_completed" -> OutcomeFormCompleted
+    "manual_recorded" -> OutcomeManualRecorded
+    _ -> OutcomeUnreachable
+  }
+}
+
+pub fn outcome_decoder() -> decode.Decoder(ReferenceCallOutcome) {
+  use value <- decode.then(decode.string)
+  case value {
+    "completed" -> decode.success(OutcomeCompleted)
+    "partial" -> decode.success(OutcomePartial)
+    "voicemail" -> decode.success(OutcomeVoicemail)
+    "no_answer" -> decode.success(OutcomeNoAnswer)
+    "busy" -> decode.success(OutcomeBusy)
+    "refused" -> decode.success(OutcomeRefused)
+    "wrong_number" -> decode.success(OutcomeWrongNumber)
+    "invalid_number" -> decode.success(OutcomeInvalidNumber)
+    "declined_ai" -> decode.success(OutcomeDeclinedAi)
+    "language_barrier" -> decode.success(OutcomeLanguageBarrier)
+    "gatekeeper_blocked" -> decode.success(OutcomeGatekeeperBlocked)
+    "objected" -> decode.success(OutcomeObjected)
+    "unreachable" -> decode.success(OutcomeUnreachable)
+    "form_completed" -> decode.success(OutcomeFormCompleted)
+    "manual_recorded" -> decode.success(OutcomeManualRecorded)
+    _ -> decode.failure(OutcomeCompleted, "ReferenceCallOutcome")
+  }
+}
+
+// -- RefSlot codecs -----------------------------------------------------------
+
+pub fn encode_ref_slot(slot: RefSlot) -> String {
+  case slot {
+    LandlordRef -> "landlord_ref"
+    CharacterRef -> "character_ref"
+    EmployerRef -> "employer_ref"
+  }
+}
+
+pub fn encode_ref_slot_json(slot: RefSlot) -> json.Json {
+  json.string(encode_ref_slot(slot))
+}
+
+/// Total inverse of `encode_ref_slot`; unknown input falls back to
+/// `LandlordRef` (unreachable given the CHECK constraint).
+pub fn ref_slot_from_string(value: String) -> RefSlot {
+  case value {
+    "landlord_ref" -> LandlordRef
+    "character_ref" -> CharacterRef
+    "employer_ref" -> EmployerRef
+    _ -> LandlordRef
+  }
+}
+
+pub fn ref_slot_decoder() -> decode.Decoder(RefSlot) {
+  use value <- decode.then(decode.string)
+  case value {
+    "landlord_ref" -> decode.success(LandlordRef)
+    "character_ref" -> decode.success(CharacterRef)
+    "employer_ref" -> decode.success(EmployerRef)
+    _ -> decode.failure(LandlordRef, "RefSlot")
+  }
+}
+
+// -- OwnerLabel codecs --------------------------------------------------------
+
+pub fn encode_owner_label(owner: OwnerLabel) -> String {
+  case owner {
+    Primary -> "primary"
+    CoApplicant0 -> "co_applicant_0"
+    CoApplicant1 -> "co_applicant_1"
+    CoApplicant2 -> "co_applicant_2"
+  }
+}
+
+pub fn encode_owner_label_json(owner: OwnerLabel) -> json.Json {
+  json.string(encode_owner_label(owner))
+}
+
+/// Total inverse of `encode_owner_label`; unknown input falls back to
+/// `Primary` (unreachable given the CHECK constraint).
+pub fn owner_label_from_string(value: String) -> OwnerLabel {
+  case value {
+    "primary" -> Primary
+    "co_applicant_0" -> CoApplicant0
+    "co_applicant_1" -> CoApplicant1
+    "co_applicant_2" -> CoApplicant2
+    _ -> Primary
+  }
+}
+
+pub fn owner_label_decoder() -> decode.Decoder(OwnerLabel) {
+  use value <- decode.then(decode.string)
+  case value {
+    "primary" -> decode.success(Primary)
+    "co_applicant_0" -> decode.success(CoApplicant0)
+    "co_applicant_1" -> decode.success(CoApplicant1)
+    "co_applicant_2" -> decode.success(CoApplicant2)
+    _ -> decode.failure(Primary, "OwnerLabel")
+  }
+}
+
+// -- Channel codecs -----------------------------------------------------------
+
+pub fn encode_channel(channel: Channel) -> String {
+  case channel {
+    Form -> "form"
+    Manual -> "manual"
+    Voice -> "voice"
+  }
+}
+
+pub fn encode_channel_json(channel: Channel) -> json.Json {
+  json.string(encode_channel(channel))
+}
+
+/// Total inverse of `encode_channel`; unknown input falls back to `Form`
+/// (unreachable given the CHECK constraint).
+pub fn channel_from_string(value: String) -> Channel {
+  case value {
+    "form" -> Form
+    "manual" -> Manual
+    "voice" -> Voice
+    _ -> Form
+  }
+}
+
+pub fn channel_decoder() -> decode.Decoder(Channel) {
+  use value <- decode.then(decode.string)
+  case value {
+    "form" -> decode.success(Form)
+    "manual" -> decode.success(Manual)
+    "voice" -> decode.success(Voice)
+    _ -> decode.failure(Form, "Channel")
+  }
+}
+
+// -- ObjectionChannel codecs --------------------------------------------------
+
+pub fn encode_objection_channel(channel: ObjectionChannel) -> String {
+  case channel {
+    ObjectionForm -> "form"
+    ObjectionSms -> "sms"
+    ObjectionEmail -> "email"
+  }
+}
+
+pub fn encode_objection_channel_json(channel: ObjectionChannel) -> json.Json {
+  json.string(encode_objection_channel(channel))
+}
+
+/// Total inverse of `encode_objection_channel`; unknown input falls back to
+/// `ObjectionForm` (unreachable given the CHECK constraint).
+pub fn objection_channel_from_string(value: String) -> ObjectionChannel {
+  case value {
+    "form" -> ObjectionForm
+    "sms" -> ObjectionSms
+    "email" -> ObjectionEmail
+    _ -> ObjectionForm
+  }
+}
+
+pub fn objection_channel_decoder() -> decode.Decoder(ObjectionChannel) {
+  use value <- decode.then(decode.string)
+  case value {
+    "form" -> decode.success(ObjectionForm)
+    "sms" -> decode.success(ObjectionSms)
+    "email" -> decode.success(ObjectionEmail)
+    _ -> decode.failure(ObjectionForm, "ObjectionChannel")
+  }
+}
diff --git a/shared/test/reference_call_test.gleam b/shared/test/reference_call_test.gleam
new file mode 100644
index 00000000..8a732b9e
--- /dev/null
+++ b/shared/test/reference_call_test.gleam
@@ -0,0 +1,241 @@
+//// Round-trip tests for the reference_call shared codecs. The
+//// `every_variant_*` tests enumerate ALL variants explicitly — adding a new
+//// variant without a matching encode/from_string arm fails here, the same
+//// net as error_code_test.
+
+import gleam/json
+import gleam/list
+import gleeunit/should
+import shared/reference_call.{
+  type Channel, type ObjectionChannel, type OwnerLabel, type RefSlot,
+  type ReferenceCallOutcome, type ReferenceCallStatus, AwaitingCorrection,
+  Calling, CharacterRef, CoApplicant0, CoApplicant1, CoApplicant2, Completed,
+  ContactInitiated, EmployerRef, Failed, Form, FormCompleted, LandlordRef,
+  Manual, ManualRecorded, Objected, ObjectionEmail, ObjectionForm, ObjectionSms,
+  OutcomeBusy, OutcomeCompleted, OutcomeDeclinedAi, OutcomeFormCompleted,
+  OutcomeGatekeeperBlocked, OutcomeInvalidNumber, OutcomeLanguageBarrier,
+  OutcomeManualRecorded, OutcomeNoAnswer, OutcomeObjected, OutcomePartial,
+  OutcomeRefused, OutcomeUnreachable, OutcomeVoicemail, OutcomeWrongNumber,
+  Partial, Primary, Queued, Refused, Scheduled, Skipped, Unreachable, Voice,
+}
+
+fn all_statuses() -> List(ReferenceCallStatus) {
+  [
+    Queued,
+    Skipped,
+    ContactInitiated,
+    AwaitingCorrection,
+    Scheduled,
+    Calling,
+    Completed,
+    Partial,
+    FormCompleted,
+    Unreachable,
+    Refused,
+    Objected,
+    ManualRecorded,
+    Failed,
+  ]
+}
+
+fn all_outcomes() -> List(ReferenceCallOutcome) {
+  [
+    OutcomeCompleted,
+    OutcomePartial,
+    OutcomeVoicemail,
+    OutcomeNoAnswer,
+    OutcomeBusy,
+    OutcomeRefused,
+    OutcomeWrongNumber,
+    OutcomeInvalidNumber,
+    OutcomeDeclinedAi,
+    OutcomeLanguageBarrier,
+    OutcomeGatekeeperBlocked,
+    OutcomeObjected,
+    OutcomeUnreachable,
+    OutcomeFormCompleted,
+    OutcomeManualRecorded,
