diff --git a/server/test/integration/reference_checks_integration_test.gleam b/server/test/integration/reference_checks_integration_test.gleam
new file mode 100644
index 00000000..60a5b255
--- /dev/null
+++ b/server/test/integration/reference_checks_integration_test.gleam
@@ -0,0 +1,306 @@
+//// Integration tests for the reference_call schema contract (RC2.1) —
+//// durable versions of the story's DB-level acceptance criteria:
+//// live-slot uniqueness, skipped-occupies-slot (A6), terminal-frees-slot,
+//// objection-log orphan survival (Art 21, no FKs), NULL-vs-'' insert
+//// discipline, guarded status transitions that preserve outcome and clear
+//// next_attempt_at, and the atomic attempt append (AD-14).
+
+import gleam/dynamic/decode
+import gleam/json
+import gleam/option
+import gleam/result
+import gleam/string
+import gleeunit/should
+import integration/helpers.{setup}
+import integration/test_db
+import pog
+import reference_checks/sql as rc_sql
+import unitest
+import youid/uuid
+
+fn seed_app(db: pog.Connection) -> String {
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 0)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let assert Ok(application_id) =
+    test_db.seed_application(db, vacancy_id, "rc-app@example.com")
+  application_id
+}
+
+fn insert_call(db: pog.Connection, application_id: String) -> String {
+  let assert Ok(app_uuid) = uuid.from_string(application_id)
+  let assert Ok(returned) =
+    rc_sql.insert_reference_call(
+      db,
+      app_uuid,
+      "landlord_ref",
+      "primary",
+      "Colm Ref",
+      "colm@example.com",
+      "+353861111111",
+    )
+  case returned.rows {
+    [row, ..] -> row.id
+    _ -> panic as "insert_reference_call returned no id"
+  }
+}
+
+fn count_rows(db: pog.Connection, table: String) -> Int {
+  let assert Ok(returned) =
+    pog.query("SELECT COUNT(*)::int FROM " <> table)
+    |> pog.returning(decode.at([0], decode.int))
+    |> pog.execute(db)
+  case returned.rows {
+    [n, ..] -> n
+    _ -> -1
+  }
+}
+
+pub fn live_slot_unique_index_rejects_duplicate_live_row_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let app_id = seed_app(db)
+  let _ = insert_call(db, app_id)
+
+  // Second live row for the same (application, slot, owner) must be rejected.
+  let assert Ok(app_uuid) = uuid.from_string(app_id)
+  rc_sql.insert_reference_call(
+    db,
+    app_uuid,
+    "landlord_ref",
+    "primary",
+    "Duplicate",
+    "",
+    "",
+  )
+  |> result.is_error
+  |> should.be_true
+}
+
+pub fn skipped_row_still_occupies_its_slot_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let app_id = seed_app(db)
+  let call_id = insert_call(db, app_id)
+
+  // queued → skipped via the guarded transition.
+  let assert Ok(call_uuid) = uuid.from_string(call_id)
+  let assert Ok(_) =
+    rc_sql.update_reference_call_status(
+      db,
+      call_uuid,
+      rc_sql.Skipped,
+      "",
+      "",
+      rc_sql.Queued,
+    )
+
+  // A6: skipped is NOT a terminal status for the live-slot index — the
+  // slot is still occupied.
+  let assert Ok(app_uuid) = uuid.from_string(app_id)
+  rc_sql.insert_reference_call(
+    db,
+    app_uuid,
+    "landlord_ref",
+    "primary",
+    "Duplicate",
+    "",
+    "",
+  )
+  |> result.is_error
+  |> should.be_true
+
+  // …and skipping cleared next_attempt_at so the sweep never sees the row.
+  let assert Ok(returned) = rc_sql.get_reference_call_by_id(db, call_uuid)
+  case returned.rows {
+    [row, ..] -> {
+      row.status |> should.equal("skipped")
+      row.next_attempt_at |> should.equal("")
+    }
+    _ -> panic as "row not found"
+  }
+}
+
+pub fn terminal_row_frees_the_slot_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let app_id = seed_app(db)
+  let call_id = insert_call(db, app_id)
+
+  let assert Ok(call_uuid) = uuid.from_string(call_id)
+  let assert Ok(_) =
+    rc_sql.update_reference_call_status(
+      db,
+      call_uuid,
+      rc_sql.Unreachable,
+      "unreachable",
+      "sequence_exhausted",
+      rc_sql.Queued,
+    )
+
+  // Substitution path: a new live row for the same slot now succeeds.
+  let assert Ok(app_uuid) = uuid.from_string(app_id)
+  rc_sql.insert_reference_call(
+    db,
+    app_uuid,
+    "landlord_ref",
+    "primary",
+    "Substitute",
+    "",
+    "",
+  )
+  |> result.is_ok
+  |> should.be_true
+}
+
+pub fn objection_log_survives_parent_deletion_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let app_id = seed_app(db)
+  let call_id = insert_call(db, app_id)
+
+  let assert Ok(call_uuid) = uuid.from_string(call_id)
+  let assert Ok(app_uuid) = uuid.from_string(app_id)
+  let assert Ok(_) =
+    rc_sql.insert_reference_objection_log(
+      db,
+      call_uuid,
+      app_uuid,
+      "landlord_ref",
+      "sms",
+      "",
+    )
+
+  // Deleting the application cascades to reference_call…
+  let assert Ok(_) =
+    pog.query("DELETE FROM application WHERE id = $1::uuid")
+    |> pog.parameter(pog.text(app_id))
+    |> pog.execute(db)
+  count_rows(db, "reference_call") |> should.equal(0)
+  // …but the Art 21 evidence survives (no foreign keys by design).
+  count_rows(db, "reference_objection_log") |> should.equal(1)
+}
+
+pub fn insert_stores_null_not_empty_string_for_absent_contacts_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let app_id = seed_app(db)
+  let assert Ok(app_uuid) = uuid.from_string(app_id)
+  let assert Ok(returned) =
+    rc_sql.insert_reference_call(
+      db,
+      app_uuid,
+      "employer_ref",
+      "primary",
+      "No Contacts",
+      "",
+      "",
+    )
+  let assert [row, ..] = returned.rows
+  let assert Ok(call_uuid) = uuid.from_string(row.id)
+  let assert Ok(read) = rc_sql.get_reference_call_by_id(db, call_uuid)
+  case read.rows {
+    [r, ..] -> {
+      r.contact_email |> should.equal(option.None)
+      r.contact_phone |> should.equal(option.None)
+    }
+    _ -> panic as "row not found"
+  }
+}
+
+pub fn status_only_transition_preserves_outcome_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let app_id = seed_app(db)
+  let call_id = insert_call(db, app_id)
+  let assert Ok(call_uuid) = uuid.from_string(call_id)
+
+  // Drive to a terminal with an outcome…
+  let assert Ok(_) =
+    rc_sql.update_reference_call_status(
+      db,
+      call_uuid,
+      rc_sql.ContactInitiated,
+      "",
+      "",
+      rc_sql.Queued,
+    )
+  let assert Ok(_) =
+    rc_sql.update_reference_call_status(
+      db,
+      call_uuid,
+      rc_sql.FormCompleted,
+      "form_completed",
+      "",
+      rc_sql.ContactInitiated,
+    )
+
+  let assert Ok(read) = rc_sql.get_reference_call_by_id(db, call_uuid)
+  case read.rows {
+    [r, ..] -> {
+      r.status |> should.equal("form_completed")
+      r.outcome |> should.equal("form_completed")
+      // Terminal clears the sweep clock.
+      r.next_attempt_at |> should.equal("")
+    }
+    _ -> panic as "row not found"
+  }
+}
+
+pub fn guarded_transition_wrong_source_status_is_noop_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let app_id = seed_app(db)
+  let call_id = insert_call(db, app_id)
+  let assert Ok(call_uuid) = uuid.from_string(call_id)
+
+  // Guard names the wrong expected status: zero rows updated (sticky).
+  let assert Ok(returned) =
+    rc_sql.update_reference_call_status(
+      db,
+      call_uuid,
+      rc_sql.Objected,
+      "objected",
+      "stop_received",
+      rc_sql.ContactInitiated,
+    )
+  returned.rows |> should.equal([])
+
+  let assert Ok(read) = rc_sql.get_reference_call_by_id(db, call_uuid)
+  case read.rows {
+    [r, ..] -> r.status |> should.equal("queued")
+    _ -> panic as "row not found"
+  }
+}
+
+pub fn append_attempt_is_atomic_and_guarded_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let app_id = seed_app(db)
+  let call_id = insert_call(db, app_id)
+  let assert Ok(call_uuid) = uuid.from_string(call_id)
+
+  let attempt =
+    json.object([
+      #("at", json.string("2026-07-31T22:00:00Z")),
+      #("channel", json.string("email")),
+      #("outcome", json.string("sent")),
+    ])
+  let assert Ok(_) =
+    rc_sql.append_reference_call_attempt(
+      db,
+      call_uuid,
+      attempt,
+      "2026-08-01 10:00:00+00",
+      rc_sql.Queued,
+    )
+
+  let assert Ok(read) = rc_sql.get_reference_call_by_id(db, call_uuid)
+  case read.rows {
+    [r, ..] -> {
+      r.attempt_count |> should.equal(1)
+      r.attempts |> string.contains("\"channel\": \"email\"") |> should.be_true
+      r.next_attempt_at |> should.equal("2026-08-01 10:00:00+00")
+    }
+    _ -> panic as "row not found"
+  }
+}
