+       COALESCE(form_opened_at::text, '') AS form_opened_at,
+       COALESCE(submitted_at::text, '') AS submitted_at,
+       COALESCE(draft_answers::text, '') AS draft_answers,
+       COALESCE(taken_over_at::text, '') AS taken_over_at,
+       channel,
+       COALESCE(result::text, '') AS result,
+       COALESCE(fraud_signals::text, '') AS fraud_signals,
+       COALESCE(objected_at::text, '') AS objected_at,
