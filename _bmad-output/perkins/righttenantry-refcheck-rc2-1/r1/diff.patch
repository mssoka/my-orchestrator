+/// Atomic attempt append (AD-14): one guarded statement applies the
+/// attempts || append, the attempt_count bump, and the next cadence step.
+/// Pass '' for next_attempt_at to NULL it (terminal / objected rows).
+///
+/// > 🐿️ This function was generated automatically using v4.6.0 of
+/// > the [squirrel package](https://github.com/giacomocavalieri/squirrel).
+///
+pub fn append_reference_call_attempt(
+  db: pog.Connection,
+  arg_1: Uuid,
