+"
+  |> pog.query
+  |> pog.parameter(pog.text(uuid.to_string(arg_1)))
+  |> pog.parameter(reference_call_status_encoder(arg_2))
+  |> pog.parameter(pog.text(arg_3))
+  |> pog.parameter(pog.text(arg_4))
+  |> pog.parameter(reference_call_status_encoder(arg_5))
+  |> pog.returning(decoder)
+  |> pog.execute(db)
+}
