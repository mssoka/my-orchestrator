+///
+pub fn update_reference_call_status(
+  db: pog.Connection,
+  arg_1: Uuid,
+  arg_2: ReferenceCallStatus,
+  arg_3: String,
+  arg_4: String,
+  arg_5: ReferenceCallStatus,
+) -> Result(pog.Returned(UpdateReferenceCallStatusRow), pog.QueryError) {
+  let decoder = {
