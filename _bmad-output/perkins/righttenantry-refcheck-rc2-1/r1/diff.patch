diff --git a/supabase/migrations/20260731222000_create_reference_call.sql b/supabase/migrations/20260731222000_create_reference_call.sql
new file mode 100644
index 00000000..8a9d3464
--- /dev/null
+++ b/supabase/migrations/20260731222000_create_reference_call.sql
@@ -0,0 +1,180 @@
+-- reference_call + reference_objection_log: the AI reference-checking v1
+-- system of record (architecture-reference-checking-v1 §4.1, as amended by
+-- the epics doc's 2026-07-30 A-register).
+--
+-- reference_call is the lifecycle table every later story builds on: the
+-- RC2.3 trigger inserts `queued` rows with an immutable `contact_*` snapshot
+-- of who was actually contacted; the RC3 sweep owns ALL sends against
+-- `next_attempt_at`; terminal rows carry the ReferenceCallResult v1 payload
+-- in `result` (fraud_signals denormalised alongside for query access).
+--
+-- Amendments applied on top of §4.1 (the A-register binds this migration):
+--   A1  NO `correction_token` column (and no token index) — correction and
+--       substitution are landlord-driven in v1; `corrected_email`/
+--       `corrected_phone` record the effective contact while the snapshot
+--       stays immutable.
+--   A2  `draft_answers` JSONB — referee form server-side autosave; an
+--       abandoned form with answers terminates as `partial` (v1-active).
+--   A3  `form_token_expires_at` carries a 10-day TTL — enforced by the
+--       token-issuing story (RC3.x), the column is policy-free.
+--   A6  `reference_call_status` gains `'skipped'` (landlord excludes a
+--       reference at/before trigger; re-enable returns to `queued`). A
+--       skipped row still OCCUPIES its slot: it is deliberately absent
+--       from the live-row index's terminal exclusion list.
+--   A7  `taken_over_at` — warm-handoff takeover marker; the sweep skips
+--       taken-over rows while the form link stays live.
+--   §6.4 outcome enum gains 'unreachable', 'form_completed',
+--       'manual_recorded' (v1 collection terminals).
+--
+-- Type-system note (owned deviation, §4.1): `ref_slot`, `owner_label`,
+-- `channel`, `retention_class` are TEXT+CHECK — they mirror values inside
+-- the cross-repo JSON contract, and TEXT+CHECK keeps the DDL in lockstep
+-- with that contract without a second enum-migration path. True state
+-- fields (`status`, `outcome`) are PG enums as canonical requires.
+-- retention_class values per §9.3: referee submissions follow the
+-- application's retention schedule; objection evidence may outlive it.
+--
+-- reference_objection_log is Art 21 evidence (§9.2): written AT OBJECTION
+-- TIME by the objection handler — its only writer. It has NO foreign keys
+-- BY DESIGN: the DPC can ask for the objection trail after the application
+-- (and the reference_call row) is gone, so both parent ids are plain UUIDs.
+--
+-- RLS: no migration content needed — the `ensure_rls` event trigger
+-- (20260512175704) auto-enables RLS on every new public table and the app
+-- talks via service_role; per repo convention zero policies are written.
+
+CREATE TYPE reference_call_status AS ENUM (
+  'queued',              -- created, not yet contacted            [v1]
+  'skipped',             -- landlord excluded this reference      [v1, A6 — re-enables to queued]
+  'contact_initiated',   -- invite sent, awaiting form            [v1]
+  'awaiting_correction', -- bad contact; landlord correcting      [v1]
+  'scheduled',           -- referee booked a call                 [v2-reserved]
+  'calling',             -- voice attempt in flight               [v2-reserved]
+  'completed',           -- voice call completed                  [v2-reserved]
+  'partial',             -- abandoned with draft answers          [v1, terminal, A2]
+  'form_completed',      -- structured form submitted             [v1, terminal]
+  'unreachable',         -- sequence exhausted                    [v1, terminal]
+  'refused',             -- referee declined (non-objection)      [v1, terminal, A8]
+  'objected',            -- Art 21 objection / STOP               [v1, terminal]
+  'manual_recorded',     -- WoZ/landlord manual outcome recorded  [v1, terminal]
+  'failed'               -- system failure, no referee contact    [v1, terminal]
+);
+
+CREATE TYPE reference_call_outcome AS ENUM (
+  -- ReferenceCallResult outcome values (heist-535) + three v1 amendments (§6.4).
+  -- v1 emits: form_completed, unreachable, objected, manual_recorded
+  -- (and leaves outcome NULL for status 'failed' — system failure, no referee contact).
+  'completed', 'partial', 'voicemail', 'no_answer', 'busy',
+  'refused', 'wrong_number', 'invalid_number', 'declined_ai',
+  'language_barrier', 'gatekeeper_blocked', 'objected',
+  'unreachable', 'form_completed', 'manual_recorded'
+);
+
+CREATE TABLE reference_call (
+  id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+  application_id  UUID NOT NULL REFERENCES application(id) ON DELETE CASCADE,
+  ref_slot        TEXT NOT NULL
+                  CHECK (ref_slot IN ('landlord_ref', 'character_ref', 'employer_ref')),
+  owner_label     TEXT NOT NULL DEFAULT 'primary'
+                  CHECK (owner_label IN ('primary','co_applicant_0','co_applicant_1','co_applicant_2')),
+
+  status          reference_call_status NOT NULL DEFAULT 'queued',
+  outcome         reference_call_outcome,              -- set at terminal (and mid-flight for voice later)
+  terminal_reason TEXT,                                -- short machine slug, e.g. 'sequence_exhausted', 'stop_received', 'correction_failed'
+
+  -- Contact snapshot (immutable copy of the trio at creation; survives
+  -- later EDITS of the application row — note the row itself dies with the
+  -- application via CASCADE, so "survives erasure" is not its job)
+  contact_name    TEXT NOT NULL,
+  contact_email   TEXT,
+  contact_phone   TEXT,
+  -- Landlord-correction loop (AD-7 as amended, A1): the corrected contact
+  -- lives here; the snapshot above is NEVER overwritten. Sends and fraud
+  -- joins use the EFFECTIVE contact (corrected value when present, else
+  -- snapshot).
+  corrected_email TEXT,
+  corrected_phone TEXT,
+
+  -- Attempt accounting (AD-4)
+  attempt_count   INT NOT NULL DEFAULT 0,
+  next_attempt_at TIMESTAMPTZ,                         -- set to now() at creation; sweep owns ALL sends (AD-14)
+  attempts        JSONB NOT NULL DEFAULT '[]',         -- [{at, channel, outcome, detail}] append-only, atomic || (AD-14)
+  correction_cycles INT NOT NULL DEFAULT 0,            -- AD-7: max 1
+
+  -- Capability token (AD-3) + form session
+  form_token        TEXT,                              -- referee form link (~288-bit; internal-only, §4.2)
+  form_token_expires_at TIMESTAMPTZ,                   -- 10-day TTL (A3) stamped by the token-issuing story
+  form_opened_at    TIMESTAMPTZ,                       -- first GET of the form; completion_seconds input (AD-10)
+  submitted_at      TIMESTAMPTZ,
+  draft_answers     JSONB,                             -- A2: server-side autosave, per-answer PUT, resume support
+
+  -- Warm-handoff takeover (A7): set when the landlord takes over manually;
+  -- the sweep skips taken-over rows, the form link stays live, and a late
+  -- completion still guarded-transitions to form_completed.
+  taken_over_at   TIMESTAMPTZ,
+
+  -- The handoff payload (AD-9)
+  channel         TEXT CHECK (channel IN ('form','manual','voice')),
+  result          JSONB,                               -- ReferenceCallResult v1, schema_version embedded
+  fraud_signals   JSONB,                               -- denormalised copy of result.fraud_signals for querying
+
+  -- Objection evidence (AD-6)
+  objected_at     TIMESTAMPTZ,
+  objection_detail JSONB,                              -- {channel, received_at, payload_ref}
+
+  -- Retention (§9.3)
+  retention_class TEXT NOT NULL DEFAULT 'referee_submission'
+                  CHECK (retention_class IN ('referee_submission','objection_evidence','attempt_metadata')),
+  purge_after     TIMESTAMPTZ,                         -- stamped at terminal: follows the application's retention schedule
+
+  created_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
+  updated_at      TIMESTAMPTZ NOT NULL DEFAULT now()
+);
+
+-- One live row per (application, slot, owner): a substituted referee creates a
+-- new row only after the prior row is terminal. 'skipped' is NOT in the
+-- exclusion list (A6) — a skipped row still occupies its slot until re-enabled
+-- or terminal.
+CREATE UNIQUE INDEX idx_reference_call_live
+  ON reference_call(application_id, ref_slot, owner_label)
+  WHERE status NOT IN ('form_completed','unreachable','refused','objected','manual_recorded','failed','completed','partial');
+
+CREATE UNIQUE INDEX idx_reference_call_form_token
+  ON reference_call(form_token) WHERE form_token IS NOT NULL;
+CREATE INDEX idx_reference_call_sweep
+  ON reference_call(next_attempt_at) WHERE next_attempt_at IS NOT NULL;
+CREATE INDEX idx_reference_call_application
+  ON reference_call(application_id);
+CREATE INDEX idx_reference_call_contact_phone
+  ON reference_call(contact_phone);   -- cross-application reuse fraud check
+CREATE INDEX idx_reference_call_purge
+  ON reference_call(purge_after) WHERE purge_after IS NOT NULL;
+
+-- updated_at maintained by the repo's existing generic trigger function
+-- (20260409000001, ai_analysis pattern) — bump on any row modification.
+DROP TRIGGER IF EXISTS update_reference_call_updated_at ON reference_call;
+CREATE TRIGGER update_reference_call_updated_at
+  BEFORE UPDATE ON reference_call
+  FOR EACH ROW
+  EXECUTE FUNCTION update_updated_at_column();
+
+-- Art 21 objection evidence (AD-6): written AT OBJECTION TIME by the objection
+-- handler — its only writer. Deliberately NOT CASCADE-coupled (no foreign
+-- keys): the DPC can ask for the objection trail after the application is gone.
+CREATE TABLE reference_objection_log (
+  id                UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+  reference_call_id UUID,                              -- plain UUID, no FK: must survive both parent deletions
+  application_id    UUID,                              -- same
+  ref_slot          TEXT NOT NULL
+                    CHECK (ref_slot IN ('landlord_ref', 'character_ref', 'employer_ref')),
+  objected_at       TIMESTAMPTZ NOT NULL,
+  channel           TEXT NOT NULL
+                    CHECK (channel IN ('form','sms','email')),
+  payload_ref       TEXT,                              -- pointer to raw evidence (internal-only, §4.2)
+  retention_class   TEXT NOT NULL DEFAULT 'objection_evidence'
+                    CHECK (retention_class IN ('referee_submission','objection_evidence','attempt_metadata')),
+  purge_after       TIMESTAMPTZ,
+  created_at        TIMESTAMPTZ NOT NULL DEFAULT now()
+);
+CREATE INDEX idx_reference_objection_log_purge
+  ON reference_objection_log(purge_after) WHERE purge_after IS NOT NULL;
diff --git a/supabase/migrations/20260731222001_add_reference_notification_types.sql b/supabase/migrations/20260731222001_add_reference_notification_types.sql
new file mode 100644
index 00000000..c56d123e
--- /dev/null
+++ b/supabase/migrations/20260731222001_add_reference_notification_types.sql
@@ -0,0 +1,14 @@
+-- Reference-check notification types (FR-RC15, A8): every later emitting
+-- story (sweep terminals, form completion/decline, late completion after
+-- warm-handoff takeover) needs these values to exist up front.
+--   reference_completed   — form submitted or manual outcome recorded
+--   reference_unreachable — correction cycle exhausted (T+144h silent
+--                           exhaustion is covered by the warm handoff)
+--   reference_objected    — Art 21 objection / STOP on any channel
+--   reference_declined    — form decline route (A8: distinct from objected)
+-- One enum-addition migration per the 20260423100001 precedent; no code
+-- references the new values in this migration's transaction.
+ALTER TYPE notification_type ADD VALUE IF NOT EXISTS 'reference_completed';
+ALTER TYPE notification_type ADD VALUE IF NOT EXISTS 'reference_unreachable';
+ALTER TYPE notification_type ADD VALUE IF NOT EXISTS 'reference_objected';
+ALTER TYPE notification_type ADD VALUE IF NOT EXISTS 'reference_declined';
