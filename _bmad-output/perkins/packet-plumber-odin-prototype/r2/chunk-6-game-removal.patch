-## E2.3 — per-junction TRIAGE order + TIER-DETERMINED load-balancing (GDD M3).
-##
-## Per the user's design correction: LB mode is NOT a player choice — basic
-## routers round-robin, smart routers (mid/high tier) do capacity-proportional
-## weighted LB. The player's junction decision is the TRAFFIC-CLASS triage
-## order (which class wins contention THROUGH the junction) — the QoS call.
-extends TestSuite
-
-
-## content_host (1) --(narrow [+wide])--> router (2) --(standard)--> house (3).
-func _build(router_type: StringName, parallel: bool) -> TopologySnapshot:
-	var c := GameCatalogs.load_default()
-	var g := TopologyGraph.new(c, Economy.new(100000), BalanceData.new())
-	g.spawn_node(CoreConst.NodeKind.TERMINAL, &"content_host",
-		CoreConst.TerminalRole.CONTENT_HOST, Vector2i(0, 0), 40, 0)   # id 1
-	g.spawn_node(CoreConst.NodeKind.JUNCTION, router_type, -1,
-		Vector2i(10, 0), 60, 0)                                        # id 2
-	g.spawn_node(CoreConst.NodeKind.TERMINAL, &"residential",
-		CoreConst.TerminalRole.RESIDENTIAL, Vector2i(20, 0), 5, 0)     # id 3
-	g.apply_edit(Command.DrawPipeCmd.new(0, 1, 2, &"narrow"))
-	if parallel:
-		g.apply_edit(Command.DrawPipeCmd.new(0, 1, 2, &"wide"))
-	g.apply_edit(Command.DrawPipeCmd.new(0, 2, 3, &"standard"))
-	return g.snapshot()
-
