-## Nodes due to spawn this tick (usually empty). Deterministic given the run's
-## (seed, tick, topology): roles from the balance catalog in order, positions
-## from the bootstrap-drawn pool skipping slots too close to existing nodes.
-func plan_growth(topology: TopologySnapshot, _era_id: int, tick: int,
-				 _rng: RandomNumberGenerator) -> Array[NodeSpawn]:
-	var out: Array[NodeSpawn] = []
-	if _growth_balance == null or _growth_roles.is_empty():
-		return out
-	if _growth_done >= _growth_roles.size():
-		return out
-	if tick < _growth_next_tick:
-		return out
-	var role: StringName = _growth_roles[_growth_done]
-	var pos: Vector2i = _next_growth_pos(topology)
-	out.append(NodeSpawn.new(role, pos, tick))
-	_growth_done += 1
-	# cadence: the second half of the run's growth comes faster (the internet
-	# "takes off" — rate scales with growth progress, not era, so it stays a
-	# pure function of the schedule; balance-tunable).
-	var interval: int = _growth_balance.growth_interval_ticks
-	if _growth_done >= (_growth_roles.size() + 1) / 2:
-		interval = _growth_balance.growth_interval_short_ticks
-	_growth_next_tick = tick + maxi(1, interval)
-	return out
-
-
-func _next_growth_pos(topology: TopologySnapshot) -> Vector2i:
-	var min_d: int = _growth_balance.growth_min_dist_tiles if _growth_balance != null else 7
-	var pool: int = _growth_pool.size()
-	for i: int in pool:
-		var cand: Vector2i = _growth_pool[(_growth_pool_idx + i) % pool]
-		if _pos_free(cand, min_d, topology):
-			_growth_pool_idx = (_growth_pool_idx + i + 1) % pool
-			return cand
-	# fallback: exhaustive deterministic row-major scan of the map box with the
-	# FULL check (min-dist + near a junction). NEVER use sparse rings here — a
-	# ring scan skips valid cells and strands the spawn far from the network
-	# (seen 2026-08-08: a house landed 20+ tiles from every router).
-	print("[growth] pool exhausted — full-scan fallback (pool_idx=%d)" % _growth_pool_idx)
-	for y: int in range(4, 27):
-		for x: int in range(6, 35):
-			var cand := Vector2i(x, y)
-			if _pos_free(cand, min_d, topology):
-				return cand
-	print("[growth] full-scan fallback failed too — min-dist-only scan")
-	for y: int in range(4, 27):
-		for x: int in range(6, 35):
-			var cand := Vector2i(x, y)
-			if _min_dist_ok(cand, min_d, topology):
-				return cand
-	return Vector2i(20, 15)
-
-
-func _min_dist_ok(cand: Vector2i, min_d: int, topology: TopologySnapshot) -> bool:
-	for nid: int in topology.nodes:
-		var n: NetNode = topology.nodes.get(nid)
-		if n != null and absi(n.pos.x - cand.x) + absi(n.pos.y - cand.y) < min_d:
-			return false
-	return true
-
-
-func _pos_free(cand: Vector2i, min_d: int, topology: TopologySnapshot) -> bool:
-	# New nodes must be (a) not too close to any existing node AND (b) near the
-	# existing network — specifically within growth_spawn_near_junction of a
-	# JUNCTION. The internet grows OUTWARD from its routers (Mini Motorways:
-	# new houses appear near existing infrastructure), which is also what keeps
-	# every spawn reachable with a pipe the player can actually draw.
-	var near_junction: bool = false
-	var near_radius: int = _growth_balance.growth_spawn_near_junction \
-		if _growth_balance != null else 12
-	for nid: int in topology.nodes:
-		var n: NetNode = topology.nodes.get(nid)
-		if n == null:
-			continue
-		var d: int = absi(n.pos.x - cand.x) + absi(n.pos.y - cand.y)
-		if d < min_d:
-			return false
-		if n.is_junction() and d <= near_radius:
-			near_junction = true
-	return near_junction
