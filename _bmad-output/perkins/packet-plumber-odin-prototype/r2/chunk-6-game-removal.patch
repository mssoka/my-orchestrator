-var bandwidth_demand: int = 1     # cached from the catalog at spawn (hot-loop)
-var accrued_latency_ms: int = 0
-var vis_dist: float = 0.0        # visual distance along the route (edge-fractions); cosmetic, decoupled from bandwidth (ADR-9 exception — deterministic fixed rate)
-var dropped: bool = false
-var drop_reason: StringName = &""
-var delivered: bool = false
-
-
-func _init(p_id: int = -1, p_class: StringName = &"", p_src: int = -1, p_dst: int = -1,
