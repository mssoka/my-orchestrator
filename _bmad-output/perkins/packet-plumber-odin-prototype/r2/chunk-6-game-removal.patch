-## Per-class SLA accumulators (architecture §6.2, E2.4/E6.1).
-##
-## Tracks delivered/dropped counts + total latency (ms) per packet class. Uptime =
-## delivered / (delivered + dropped); a class with ZERO demand is NEUTRAL
-## (neither breach nor credit) — guards the division (AC-E24). All int (ADR-10).
-class_name SlaAccumulator
-extends RefCounted
-
-var class_id: StringName = &""
-var delivered: int = 0
-var dropped: int = 0
-var total_latency_ms: int = 0
-var breach_windows: int = 0
-var demand_seen: int = 0        # packets spawned for this class (for zero-demand detection)
-
-
-func _init(p_class: StringName = &"") -> void:
-	class_id = p_class
-
-
-func record_delivered(latency_ms: int) -> void:
-	delivered += 1
-	total_latency_ms += latency_ms
-
-
-func record_dropped() -> void:
-	dropped += 1
-
-
-func record_demand() -> void:
-	demand_seen += 1
-
-
-## Uptime pct [0..100]. NEUTRAL (returns -1) when zero demand this window — the
-## caller treats -1 as "no credit, no breach" (AC-E24).
-func uptime_pct() -> int:
-	var total: int = delivered + dropped
-	if total <= 0:
-		return -1
-	return (delivered * 100) / total
-
-
-func avg_latency_ms() -> int:
-	if delivered <= 0:
-		return 0
-	return total_latency_ms / delivered
-
-
-func reset() -> void:
-	delivered = 0
-	dropped = 0
-	total_latency_ms = 0
-	breach_windows = 0
-	demand_seen = 0
