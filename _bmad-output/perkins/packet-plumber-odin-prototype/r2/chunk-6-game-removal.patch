-## Schema for the balance catalog (GDD § Numerical Design, ADR-5, NFR5).
-##
-## The single source for every tunable number. Scripts never restate these as
-## literals (NFR5). All state-affecting values are int (ADR-10); the only floats
-## are render-only (not here).
-class_name BalanceData
-extends Resource
-
-var logic_hz: int = 20                       # ADR-2 fixed logic tick
-var snap_radius: int = 36                    # draw snap (inclusive, AC-E4)
-var win_uptime_pct: int = 90                 # MVP win threshold (FR12, prototype tuning)
-var grace_window_ticks: int = 200            # ~10 s breach grace before meter drains
-var meter_drain_per_tick_max: int = 2        # drain cap -> always recoverable (AC-E16)
-var meter_recharge_per_tick: int = 1         # recharge when healthy
-var meter_start_pct: int = 100
-var health_strain_threshold_pct: int = 70    # node util -> STRAINED (FR8, FR11)
-var health_critical_threshold_pct: int = 90  # node util -> CRITICAL
-var queue_drop_depth: int = 20               # per-pipe FIFO backlog before overflow drops
-# (prototype iterate-1: the catalog ships 40 — the grown map's lumpy sink spread
-# + chained router spines need the headroom; the old 20 was tuned for 4 houses.)
-var strain_lead_ticks: int = 600             # ~30 s warning lead (GDD M5)
-var critical_lead_ticks: int = 200           # ~10 s warning lead (GDD M5)
-var default_lane_weights: Vector3i = Vector3i(1, 4, 1)   # x=Express,y=Std,z=Best (AC-E5)
-var default_budget: int = 1000               # action/capacity budget (FR1, S7 MVP)
-# NOTE (prototype iterate-1): the catalog ships 4000 — the map-growth feature
-# makes the run ~2.2x bigger (4 -> 9 houses + router mesh), and the fun-test
-# budget had to scale with it (3000 was tuned for the 4-house map).
-# --- Map growth (E3.2, prototype iterate-1) -----------------------------------
