-		var mode: int = _mode_from_string(d.get("selection", "weighted_random"))
-		out.append(DemandSpec.new(
-			StringName(d["class_id"]),
-			TerminalSelector.new(StringName(d.get("source_role", &"")), int(d.get("source_card", -1))),
-			TerminalSelector.new(StringName(d.get("sink_role", &"")), int(d.get("sink_card", -1))),
-			SelectionRule.new(mode, &"demand_weight"),
-			int(d.get("volume", 0)),
-			int(d.get("default_lane", CoreConst.Lane.STANDARD)),
-			int(d.get("demand_weight", 1))
-		))
-	return out
-
-
-func _parse_set_pieces(arr: Array) -> Array[SetPiece]:
-	var out: Array[SetPiece] = []
-	for e: Variant in arr:
-		var d: Dictionary = e
-		out.append(SetPiece.new(
-			StringName(d["id"]),
-			StringName(d["class_id"]),
-			int(d.get("multiplier", 1)),
-			int(d.get("start_tick", 0)),
-			int(d.get("duration_ticks", 0)),
-			int(d.get("forecast_lead_ticks", 0))
-		))
-	return out
-
-
-static func _mode_from_string(s: String) -> int:
-	match s:
-		"weighted_random":
-			return CoreConst.SelectionMode.WEIGHTED_RANDOM
-		"round_robin":
-			return CoreConst.SelectionMode.ROUND_ROBIN
-		"nearest_hops":
-			return CoreConst.SelectionMode.NEAREST_HOPS
