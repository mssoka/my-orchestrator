--- a/game/scripts/core/packet_flow.gd
+++ /dev/null
@@ -1,495 +0,0 @@
-## S2 Packet-Flow Simulation (GDD § M2, architecture §6.2, ADR-1).
-##
-## The deterministic tick loop that moves traffic: SPAWN from demand (DemandResolver)
-## -> ROUTE (BFS, round-robin at parallel pipes E1.5) -> TRAVERSE (bandwidth-shared
-## per pipe: a packet crosses an edge over ceil(demand/capacity) ticks) -> DELIVER
-## at the sink (record latency) or DROP (latency_tol exceeded -> SLA loss; or
-## unreachable -> visible unmet demand, E1.4). Packets are pooled DATA (ADR-8).
-##
-## Lanes (Express/Standard/Best) are S3: in S1 every packet uses the pipe's full
-## capacity (contention = over-subscription drops). No global RNG (ADR-9); integer
-## math (ADR-10). Pure RefCounted.
-class_name PacketFlow
-extends RefCounted
-
-const IN_FLIGHT_CAP: int = 6000
-const QUEUE_DROP_DEPTH: int = 20      # per-pipe FIFO backlog before oldest drops (fallback; the Balance catalog tunes it)
-const VISUAL_RATE: float = 0.25       # edge-fractions/tick — cosmetic flow speed (deterministic)
-const ROLLING_WINDOW: int = 100      # recent-uptime window in ticks (~10s at 10Hz)
-var _roll_idx: int = 0
-var _roll: Dictionary = {}          # class -> {del:Array[int], drop:Array[int], ds:int, dps:int}
-var _tick_del: Dictionary = {}      # class -> int delivered this tick
-var _tick_drop: Dictionary = {}     # class -> int dropped this tick
-var _queue_drop_depth: int = QUEUE_DROP_DEPTH
-
-var packets: Array[Packet] = []
-var sla: Dictionary = {}            # StringName class_id -> SlaAccumulator
-var catalogs: GameCatalogs = null
-var balance: BalanceData = null
-var ms_per_tick: int = 50
-var _next_packet_id: int = 1
-var _rr_state: Dictionary = {}      # "a<b" -> int (round-robin cursor, deterministic)
-var _node_load: Dictionary = {}    # int node_id -> int bandwidth units incident this tick
-var _node_flow: Dictionary = {}    # int node_id -> {class_id -> in-flight count} (inspect panel)
-
-
-func _init(p_catalogs: GameCatalogs = null, p_balance: BalanceData = null) -> void:
-	catalogs = p_catalogs
-	balance = p_balance
-	if balance != null and balance.logic_hz > 0:
-		ms_per_tick = 1000 / balance.logic_hz
-	if balance != null and balance.queue_drop_depth > 0:
-		_queue_drop_depth = balance.queue_drop_depth
-
-
-func _sla_for(class_id: StringName) -> SlaAccumulator:
-	if not sla.has(class_id):
-		sla[class_id] = SlaAccumulator.new(class_id)
-	return sla[class_id]
-
-
-## Advance the flow one tick. Deterministic given (rng, topology, era, plan).
-func step(tick: int, rng: RandomNumberGenerator, topology: TopologySnapshot,
-		  era_id: int, plan: PressurePlan) -> FlowReport:
-	var report := FlowReport.new()
-	report.tick = tick
-	_tick_del.clear()
-	_tick_drop.clear()
-
-	# 1. SPAWN from demand.
-	for spec: DemandSpec in plan.entries:
-		var volume: int = plan.effective_volume(spec.class_id, spec.volume_units_per_tick)
-		if volume <= 0:
-			continue
-		var triples: Array[SpawnTriple] = DemandResolver.resolve(spec, volume, topology, rng)
-		var acc: SlaAccumulator = _sla_for(spec.class_id)
-		if triples.is_empty():
-			report.unmet_demand += volume        # visible, never silent (E1.4)
-			acc.record_demand()
-			continue
-		for triple: SpawnTriple in triples:
-			_spawn_packet(triple, tick, topology)
-			acc.record_demand()
-			report.spawned += 1
-
-	# 2. ADVANCE in-flight packets (bandwidth-shared per pipe).
-	_advance(tick, topology, report)
-
-	report.sla = sla
-	_push_rolling()
-	return report
-
-
-func _spawn_packet(triple: SpawnTriple, tick: int, topology: TopologySnapshot) -> void:
-	var ptype: PacketTypeData = catalogs.packet_type(triple.class_id) if catalogs != null else null
-	var demand: int = ptype.bandwidth_demand if ptype != null else 1
-	var p := Packet.new(_next_packet_id, triple.class_id, triple.src_node_id,
-						triple.dst_node_id, triple.lane, tick)
-	_next_packet_id += 1
-	p.bandwidth_demand = maxi(1, demand)
-	p.route = _compute_route(triple.src_node_id, triple.dst_node_id, topology)
-	# deterministic phase offset so packets spread along their route at spawn
-	# (cosmetic; derived from id, no rng consumed -> sim determinism untouched)
-	if not p.route.is_empty():
-		p.vis_dist = float(p.id % 64) / 64.0 * float(p.route.size())
-	packets.append(p)
-
-
-# --- routing (BFS shortest path; round-robin at parallel pipes, E1.5) ---------
-
-func _compute_route(src: int, dst: int, topology: TopologySnapshot) -> Array[int]:
-	if src == dst:
-		return []
-	var node_path: Array[int] = _node_path(src, dst, topology)
-	if node_path.is_empty():
-		return []   # unreachable -> caller handles (drop "unreachable")
-	var pipe_ids: Array[int] = []
-	for i: int in node_path.size() - 1:
-		var a: int = node_path[i]
-		var b: int = node_path[i + 1]
-		var pipes: Array = topology.pipes_between(a, b)
-		if pipes.is_empty():
-			return []   # shouldn't happen (adjacency implies a pipe)
-		var pick: int = _pick_pipe(a, b, pipes, topology)
-		pipe_ids.append(pick)
-	return pipe_ids
-
-
-# BFS over the topology adjacency (insertion-ordered -> deterministic, ADR-10).
-func _node_path(src: int, dst: int, topology: TopologySnapshot) -> Array[int]:
-	var prev: Dictionary = {}     # node -> predecessor
-	var queue: Array[int] = [src]
-	prev[src] = -1
-	while not queue.is_empty():
-		var cur: int = queue.pop_front()
-		if cur == dst:
-			break
-		for nb: int in topology.neighbors(cur):
-			if not prev.has(nb):
-				prev[nb] = cur
-				queue.append(nb)
-	if not prev.has(dst):
-		return []   # unreachable
-	var path: Array[int] = []
-	var n: int = dst
-	while n != -1:
-		path.push_front(n)
-		n = int(prev[n])
-	return path
-
-
-# Pick among parallel pipes connecting a-b (E1.5/E2.3). LB mode is TIER-
-# DETERMINED (GDD M3 — never a player toggle): basic routers = round-robin
-# (deterministic per-pair cursor on the flow, replay-safe); smart routers
-# (lb_weighted) = capacity-proportional weighted — every packet takes the
-# highest-capacity pipe, and pipes TIED at max capacity share the load evenly
-# (an equal-tier bundle must not collapse onto one pipe). Deterministic (ADR-10).
-func _pick_pipe(a: int, b: int, pipes: Array, topology: TopologySnapshot) -> int:
-	if pipes.size() == 1:
-		return (pipes[0] as NetPipe).id
-	var junc: NetNode = _junction_between(a, b, topology)
-	if junc != null and junc.lb_weighted:
-		var best_cap: int = -1
-		for p: NetPipe in pipes:
-			best_cap = maxi(best_cap, p.capacity_units)
-		var best: Array = []
-		for p: NetPipe in pipes:
-			if p.capacity_units == best_cap:
-				best.append(p)
-		if best.size() == 1:
-			return (best[0] as NetPipe).id
-		pipes = best   # tied best set -> spread via the round-robin cursor below
-	var key: String = TopologySnapshot._pair_key(a, b)
-	var idx: int = int(_rr_state.get(key, 0))
-	_rr_state[key] = (idx + 1) % pipes.size()
-	return (pipes[idx % pipes.size()] as NetPipe).id
-
-
-## The junction endpoint of a hop (a-b), if any (a terminal's own hop -> null).
-func _junction_between(a: int, b: int, topology: TopologySnapshot) -> NetNode:
-	var na: NetNode = topology.nodes.get(a)
-	if na != null and na.is_junction():
-		return na
-	var nb: NetNode = topology.nodes.get(b)
-	if nb != null and nb.is_junction():
-		return nb
-	return null
-
-
-# Per-lane capacity for a pipe (S3 E2.2). A pipe with its OWN priority dial
-# (right-click) or whose junction triages a class gets Express-heavy weights so
-# the promoted class has a guaranteed share; otherwise the pipe's own weights
-# apply (default Standard-heavy).
-func _pipe_lane_caps(pipe: NetPipe, junc: NetNode) -> Vector3i:
-	var weights: Vector3i = pipe.lane_weights
-	var triaged: bool = pipe.priority_class == &"streaming" or pipe.priority_class == &"email"
-	if not triaged and junc != null and junc.triage_class != &"":
-		triaged = true
-	if triaged:
-		weights = Vector3i(4, 1, 1)
-	var def_w: Vector3i = balance.default_lane_weights if balance != null else CoreConst.DEFAULT_LANE_WEIGHTS
-	return QoSEngine.allocate(pipe.capacity_units, weights, def_w)
-
-
-# The lane a packet's class rides on a given pipe. The pipe's OWN dial wins;
-# otherwise the junction's triage order applies (triage_class -> Express, the
-# other classes -> Best); neutral -> Standard for all (the game-wide default).
-func _effective_lane(pipe: NetPipe, class_id: StringName, junc: NetNode) -> int:
-	if pipe.priority_class == &"streaming":
-		return CoreConst.Lane.EXPRESS if class_id == &"streaming" else CoreConst.Lane.BEST
-	if pipe.priority_class == &"email":
-		return CoreConst.Lane.EXPRESS if class_id == &"email" else CoreConst.Lane.BEST
-	if junc != null and junc.triage_class != &"":
-		return CoreConst.Lane.EXPRESS if class_id == junc.triage_class else CoreConst.Lane.BEST
-	return CoreConst.Lane.STANDARD
-
-
-# --- traversal (bandwidth-shared; S1: full pipe capacity, S3 adds lanes) ------
-
-func _advance(tick: int, topology: TopologySnapshot, report: FlowReport) -> void:
-	# track per-node load (the warning surface, S2 E3.3) + per-class flow counts
-	# (the router inspect panel, E2.3).
-	_node_load.clear()
-	_node_flow.clear()
-	for p: Packet in packets:
-		if p.delivered or p.dropped:
-			continue
-		if p.route.is_empty():
-			_accum_load(p.src, p.bandwidth_demand)
-			_accum_flow(p.src, p.class_id)
-		else:
-			var pipe: NetPipe = topology.pipes.get(p.route[p.edge_idx])
-			if pipe != null:
-				_accum_load(pipe.a_id, p.bandwidth_demand)
-				_accum_load(pipe.b_id, p.bandwidth_demand)
-				_accum_flow(pipe.a_id, p.class_id)
-				_accum_flow(pipe.b_id, p.class_id)
-	# group in-flight packets by their current pipe (deterministic insertion order)
-	var by_pipe: Dictionary = {}   # pipe_id -> Array[Packet]
-	var arrived: Array[Packet] = []
-	for p: Packet in packets:
-		if p.delivered or p.dropped:
-			continue
-		if p.route.is_empty():
-			# unreachable since spawn -> drop now (visible, E1.4)
-			p.dropped = true
-			p.drop_reason = &"unreachable"
-			arrived.append(p)
-			continue
-		var pid: int = p.route[p.edge_idx]
-		if not by_pipe.has(pid):
-			by_pipe[pid] = []
-		(by_pipe[pid] as Array).append(p)
-
-	# serve each pipe's backlog by QoS lane (S3 E2.2): Express -> Standard -> Best,
-	# each lane using its allocated capacity (QoSEngine.allocate). A pipe's
-	# priority_class promotes one class to Express (guaranteed) and demotes the
-	# other to Best (drops first under contention) — the differentiator.
-	for pid: int in by_pipe:
-		var pipe: NetPipe = topology.pipes.get(pid)
-		if pipe == null:
-			_handle_severed(pid, by_pipe[pid], topology, arrived)
-			continue
-		var junc: NetNode = _junction_between(pipe.a_id, pipe.b_id, topology)
-		var caps: Vector3i = _pipe_lane_caps(pipe, junc)
-		var backlog: Array = by_pipe[pid]
-		var lane_caps: Array[int] = [caps.x, caps.y, caps.z]
-		for lane: int in [CoreConst.Lane.EXPRESS, CoreConst.Lane.STANDARD, CoreConst.Lane.BEST]:
-			var cap: int = lane_caps[lane]
-			var idx_in_lane: int = 0
-			for p: Packet in backlog:
-				if p.delivered or p.dropped:
-					continue
-				if _effective_lane(pipe, p.class_id, junc) != lane:
-					continue
-				idx_in_lane += 1
-				if idx_in_lane > _queue_drop_depth:
-					_drop(p, &"queue_overflow", arrived)
-					continue
-				if cap <= 0:
-					continue   # this lane exhausted this tick; packet waits
-				var need: int = p.bandwidth_demand - p.progress_units
-				var served: int = mini(need, cap)
-				p.progress_units += served
-				cap -= served
-				if served > 0:
-					# flow forward visually ONLY when served -> congestion piles along the
-					# pipe (stuck packets), not at sink nodes (the readable panic)
-					p.vis_dist = minf(p.vis_dist + VISUAL_RATE, float(p.route.size()))
-				if p.progress_units >= p.bandwidth_demand:
-					p.progress_units = 0
-					p.edge_idx += 1
-					if p.edge_idx >= p.route.size():
-						_deliver(p, tick, arrived)
-			lane_caps[lane] = cap
-
-	# latency accrual (SLA metric — late != lost; packets only DROP on contention/
-	# queue-overflow/unreachable/severance, never on latency alone) + cull delivered/dropped
-	var survivors: Array[Packet] = []
-	for p: Packet in packets:
-		if p.delivered or p.dropped:
-			continue
-		p.accrued_latency_ms += ms_per_tick
-		survivors.append(p)
-	# account the arrived (delivered/dropped) packets
-	for p: Packet in arrived:
-		_account(p, report)
-	packets = survivors
-
-
-func _deliver(p: Packet, tick: int, arrived: Array) -> void:
-	p.delivered = true
-	arrived.append(p)
-
-
-func _drop(p: Packet, reason: StringName, arrived: Array) -> void:
-	p.dropped = true
-	p.drop_reason = reason
-	arrived.append(p)
-
-
-func _handle_severed(pipe_id: int, backlog: Array, topology: TopologySnapshot,
-					 arrived: Array) -> void:
-	# A pipe was demolished while packets were on it (E1). Try to reroute from
-	# the packet's current node; if no path to dst, drop with "severance".
-	for p: Packet in backlog:
-		if p.delivered or p.dropped:
-			continue
-		# current node = the node the packet has reached (start of its current edge)
-		var cur_node: int = _current_node(p, topology)
-		var new_route: Array[int] = _compute_route(cur_node, p.dst, topology)
-		if new_route.is_empty():
-			_drop(p, &"severance", arrived)
-		else:
-			p.route = new_route
-			p.edge_idx = 0
-			p.progress_units = 0
-
-
-# The node a packet has reached = src walked through every COMPLETED edge.
-func _current_node(p: Packet, topology: TopologySnapshot) -> int:
-	var node: int = p.src
-	for i: int in p.edge_idx:
-		var pipe: NetPipe = topology.pipes.get(p.route[i])
-		if pipe == null:
-			return node
-		node = pipe.other_end(node)
-	return node
-
-
-func _account(p: Packet, report: FlowReport) -> void:
-	var acc: SlaAccumulator = _sla_for(p.class_id)
-	if p.delivered:
-		acc.record_delivered(p.accrued_latency_ms)
