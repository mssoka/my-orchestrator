+# .github/workflows/ci.yml — the §16.3 gates (ODN-17: the harness is a
+# release-gated CI citizen). Every job: purity + grep gates, odin test (T1
+# contracts), app build, harness run (T1 hashes + T2 pixels via the software
+# renderer + the replay gate). Matrix: linux + macos; goldens are platform-
+# independent because T2 is software-rendered.
+name: ci
+
+on:
+  push:
+  pull_request:
+
+jobs:
+  verify:
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-latest, macos-latest]
+    runs-on: ${{ matrix.os }}
+    steps:
+      - uses: actions/checkout@v4
+
+      # The pin (.odin-version) is an upstream RELEASE TAG; nightlies are
+      # release artifacts, not git branches — fetch the pinned tarball.
+      - name: Install Odin (pinned release artifact)
+        shell: bash
+        run: |
+          set -euo pipefail
+          PIN="$(cat .odin-version)"
+          case "${{ runner.os }}-${{ runner.arch }}" in
+            Linux-X64)   ASSET="odin-linux-amd64-${PIN}.tar.gz" ;;
+            Linux-ARM64) ASSET="odin-linux-arm64-${PIN}.tar.gz" ;;
+            macOS-ARM64) ASSET="odin-macos-arm64-${PIN}.tar.gz" ;;
+            macOS-X64)   ASSET="odin-macos-amd64-${PIN}.tar.gz" ;;
+            *) echo "unsupported runner ${{ runner.os }}/${{ runner.arch }}"; exit 1 ;;
+          esac
+          URL="https://github.com/odin-lang/Odin/releases/download/${PIN}/${ASSET}"
+          echo "fetching $URL"
+          curl -fsSL "$URL" -o "$RUNNER_TEMP/odin.tar.gz"
+          mkdir -p "$RUNNER_TEMP/odin"
+          tar -xzf "$RUNNER_TEMP/odin.tar.gz" -C "$RUNNER_TEMP/odin"
+          tar -xzf "$RUNNER_TEMP/odin.tar.gz" -C "$RUNNER_TEMP/odin"
+          ODIN_BIN="$(find "$RUNNER_TEMP/odin" -maxdepth 3 -name odin -type f | head -1 | xargs dirname || true)"
+          if [ -z "${ODIN_BIN:-}" ] || [ ! -x "$ODIN_BIN/odin" ]; then
+            echo "odin binary not found; artifact layout:"
+            find "$RUNNER_TEMP/odin" -maxdepth 2 | head -20
+            exit 1
+          fi
+          # $GITHUB_PATH applies to LATER steps; in THIS step invoke by full path
+          echo "$ODIN_BIN" >> "$GITHUB_PATH"
+          xattr -dr com.apple.quarantine "$ODIN_BIN" 2>/dev/null || true
+          "$ODIN_BIN/odin" version
+
+      # the stock vendor:raylib desktop build links system X11/GL on linux
+      - name: Linux GUI link deps
+        if: runner.os == 'Linux'
+        run: |
+          sudo apt-get update -qq
+          sudo apt-get install -y -qq libx11-dev libxcursor-dev libxrandr-dev libxinerama-dev libxi-dev libgl1-mesa-dev
+
+      - name: Purity + grep gates
+        run: |
+          odin build core -build-mode:obj -out:"$RUNNER_TEMP/core.obj"
+          tools/lint.sh
+
+      - name: Core unit tests (T1 contracts)
+        run: odin test core
+
+      - name: Orchestration-layer tests (driver/snap/bus)
+        run: odin test app/run
+
+      - name: Game builds (the shipped artifact compiles)
+        run: odin build app -out:"$RUNNER_TEMP/packet-plumber"
+
+      - name: Golden harness (T1 hashes + T2 software pixels + replay gate)
+        run: |
+          tools/harness.sh run || {
+            if [ "$(uname -s)" = Linux ]; then
+              echo "== harness crashed on linux; installing gdb for the backtrace"
+              sudo apt-get update -qq && sudo apt-get install -y -qq gdb
+              ODIN_ROOT=tools/raylib-sw/shadow gdb -batch -ex run -ex bt -ex "info registers rip" --args bin/harness run || true
+            fi
+            exit 1
+          }
+
+      - name: Upload diff bundles on failure
+        if: failure()
+        uses: actions/upload-artifact@v4
+        with:
+          name: golden-reports-${{ matrix.os }}
+          path: goldens/_reports/
+          if-no-files-found: ignore
