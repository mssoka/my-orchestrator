diff --git a/tools/build_raylib_sw.sh b/tools/build_raylib_sw.sh
new file mode 100755
index 0000000..b60b002
--- /dev/null
+++ b/tools/build_raylib_sw.sh
@@ -0,0 +1,77 @@
+#!/usr/bin/env bash
+# tools/build_raylib_sw.sh — build raylib 6.0 with the software renderer
+# (rlsw) + PLATFORM_MEMORY backend for the golden-image harness (architecture
+# §10.4): bit-exact pixels on every machine, no GPU, no display. Pinned to the
+# raylib 6.0 release tarball; cached under tools/raylib-sw/ (gitignored).
+#
+# Produces tools/raylib-sw/shadow/ — an ODIN_ROOT shadow where everything is
+# symlinked to the real toolchain EXCEPT vendor/raylib/{raylib.odin copy,
+# <platform>/libraylib.a = the SW build}. Build the harness with:
+#   ODIN_ROOT=tools/raylib-sw/shadow odin build harness -out:bin/harness
+set -euo pipefail
+
+RAYLIB_TAG="6.0"
+WORK="$(cd "$(dirname "$0")" && pwd)/raylib-sw"
+SRC="$WORK/src"
+OBJ="$WORK/obj"
+SHADOW="$WORK/shadow"
+
+REAL_ROOT="$(odin root)"
+echo "== raylib-sw build (tag $RAYLIB_TAG) =="
+
+if [ ! -d "$SRC" ]; then
+  mkdir -p "$WORK"
+  echo "-- fetching raylib $RAYLIB_TAG source"
+  git clone --depth 1 --branch "$RAYLIB_TAG" https://github.com/raysan5/raylib.git "$SRC"
+fi
+
+mkdir -p "$OBJ"
+echo "-- compiling (PLATFORM_MEMORY + GRAPHICS_API_OPENGL_SOFTWARE)"
+for f in rcore rshapes rtext rtextures rmodels; do
+  # -ffp-contract=off: NO fused multiply-add — clang fuses on arm64 but
+  # baseline x86-64 has no FMA instruction, so the rasterizer's barycentric
+  # float math rounds differently per platform and T2 pixel goldens drift
+  # (the ubuntu-vs-macOS ocean-coastline divergence). Unfused IEEE mul+add
+  # is identical everywhere.
+  cc -c "$SRC/src/$f.c" -o "$OBJ/$f.o" \
+     -DPLATFORM_MEMORY -DGRAPHICS_API_OPENGL_SOFTWARE \
+     -I"$SRC/src" -O2 -w -ffp-contract=off
+done
+ar rcs "$OBJ/libraylib_sw.a" "$OBJ"/rcore.o "$OBJ"/rshapes.o "$OBJ"/rtext.o "$OBJ"/rtextures.o "$OBJ"/rmodels.o
+
+# --- the ODIN_ROOT shadow ------------------------------------------------------
+echo "-- generating shadow root at $SHADOW"
+rm -rf "$SHADOW"
+mkdir -p "$SHADOW/vendor/raylib"
+for d in core base; do ln -sfn "$REAL_ROOT/$d" "$SHADOW/$d"; done
+# link every vendor package dir except raylib
+for pkg in "$REAL_ROOT"/vendor/*; do
+  name="$(basename "$pkg")"
+  if [ "$name" != "raylib" ]; then ln -sfn "$pkg" "$SHADOW/vendor/$name"; fi
+done
+# raylib: symlink everything except the platform lib dirs + the binding file
+for f in "$REAL_ROOT"/vendor/raylib/*; do
+  name="$(basename "$f")"
+  case "$name" in
+    macos|linux|linux-arm64|windows|wasm|raylib.odin) ;;
+    *) ln -sfn "$f" "$SHADOW/vendor/raylib/$name" ;;
+  esac
+done
+cp "$REAL_ROOT/vendor/raylib/raylib.odin" "$SHADOW/vendor/raylib/raylib.odin"
+
+# vendored raylib.odin binds per-os/arch dirs: macos, linux (amd64), linux-arm64
+case "$(uname -s)-$(uname -m)" in
+  Darwin-*)                PLATDIR=macos ;;
+  Linux-x86_64)            PLATDIR=linux ;;
+  Linux-aarch64|Linux-arm64) PLATDIR=linux-arm64 ;;
+  *)      echo "unsupported host platform for the shadow: $(uname -s)-$(uname -m)" >&2; exit 1 ;;
+esac
+mkdir -p "$SHADOW/vendor/raylib/$PLATDIR"
+for f in "$REAL_ROOT"/vendor/raylib/"$PLATDIR"/*; do
+  name="$(basename "$f")"
+  if [ "$name" != "libraylib.a" ]; then ln -sfn "$f" "$SHADOW/vendor/raylib/$PLATDIR/$name"; fi
+done
+cp "$OBJ/libraylib_sw.a" "$SHADOW/vendor/raylib/$PLATDIR/libraylib.a"
+
+echo "== done. Build the harness with:"
+echo "   ODIN_ROOT=$SHADOW odin build harness -out:bin/harness"
diff --git a/tools/harness.sh b/tools/harness.sh
new file mode 100755
index 0000000..76f6958
--- /dev/null
+++ b/tools/harness.sh
@@ -0,0 +1,14 @@
+#!/usr/bin/env bash
+# tools/harness.sh — build + run the golden-image harness against the
+# software-rendered raylib shadow (see tools/build_raylib_sw.sh).
+# Usage: tools/harness.sh run [demo...] | save [demo...] | replay <demo> <log>
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+cd "$ROOT"
+SHADOW="$ROOT/tools/raylib-sw/shadow"
+if [ ! -d "$SHADOW" ]; then
+  "$ROOT/tools/build_raylib_sw.sh"
+fi
+mkdir -p bin
+ODIN_ROOT="$SHADOW" odin build harness -out:bin/harness -debug
+exec ./bin/harness "$@"
diff --git a/tools/lint.sh b/tools/lint.sh
new file mode 100755
index 0000000..8536103
--- /dev/null
+++ b/tools/lint.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+# tools/lint.sh — the §16.3 grep gates (CI-enforced consistency rules).
+#  1. core purity: core/ imports whitelisted core:* only (never vendor:*,
+#     core:os, core:time) — the structural determinism rule (ODN-1).
+#  2. no file-scope mutable state in core (ODN-13: no globals).
+#  3. no map iteration in core (ODN-10: arrays only).
+#  4. no dropped error returns in core (§7.1).
+set -uo pipefail
+cd "$(dirname "$0")/.."
+FAIL=0
+
+echo "-- gate 1: core import purity"
+HITS=$(grep -rn '^import ' core/*.odin | grep -v '_test\.odin' | grep -E 'import "(vendor:[^"]*|core:os|core:time)"' || true)
+if [ -n "$HITS" ]; then echo "$HITS"; echo "FAIL: forbidden import in core/"; FAIL=1; fi
+
+echo "-- gate 2: no file-scope var in core/"
+HITS=$(grep -rnE '^[a-z_][a-z0-9_]*[ ]*:[ ]' core/*.odin | grep -v '_test\.odin' | grep -v '::' || true)
+if [ -n "$HITS" ]; then echo "$HITS"; echo "FAIL: file-scope state in core/"; FAIL=1; fi
+
+echo "-- gate 3: no map iteration in core/"
+HITS=$(grep -rnE 'for .* in .*(map|_by_id|_by_)' core/*.odin | grep -v '_test\.odin' | grep -vE 'for .* in [a-z_]+\.(nodes|pipes|entries)' || true)
+if [ -n "$HITS" ]; then echo "$HITS"; echo "FAIL: possible map iteration in core/"; FAIL=1; fi
+
+echo "-- gate 4: no bare '_' discards of fallible calls in core/"
+HITS=$(grep -rnE '^\s*_ = ' core/*.odin | grep -v '_test\.odin' || true)
+if [ -n "$HITS" ]; then echo "$HITS"; echo "FAIL: dropped return in core/"; FAIL=1; fi
+
+if [ "$FAIL" -ne 0 ]; then exit 1; fi
+echo "lint: all gates green"

