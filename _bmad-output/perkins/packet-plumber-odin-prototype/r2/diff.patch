-
-
-func _record(passed: bool, msg: String = "") -> void:
-	results.append({"name": _current, "passed": passed, "msg": msg})
-
-
-func check(cond: bool, msg: String = "") -> void:
-	_record(bool(cond), msg)
-
-
-func eq(actual: Variant, expected: Variant, msg: String = "") -> void:
-	var ok: bool = actual == expected
-	if not ok:
-		_record(false, "%s — got %s, expected %s" % [msg, str(actual), str(expected)])
-	else:
-		_record(true)
-
-
-func fail(msg: String = "") -> void:
-	_record(false, msg)
-
-
-func pass_(msg: String = "") -> void:
-	_record(true, msg)
