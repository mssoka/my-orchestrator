--- /dev/null
+++ b/harness/demo_parse.odin
@@ -0,0 +1,362 @@
+package main
+
+// demo_parse.odin — the scripted demo format (§10.3). A demo is a header
+// (seed, map fixture) + an intent script playing through the REAL Input ->
+// Command_Bus -> core path; the validated command stream IS the action log.
+// Times quantize by floor-to-frame (frame = floor(ms * 60 / 1000)) — intents
+// AND captures alike.
+//
+// Strict by contract (review r1): unknown tiers/classes/fixtures/expectations
+// are PARSE ERRORS, never silent coercions — a typo'd demo must fail loudly,
+// because its goldens define "correct".
+
+import "core:fmt"
+import "core:strconv"
+import "core:strings"
+import pp "../core"
+
+parse_demo :: proc(name, text: string) -> (Demo, string) {
+	d: Demo
+	d.name = name
+	d.seed = 42
+	d.map_fixture = "demo_six_nodes"
+	lines := strings.split(text, "\n", context.temp_allocator)
+	last_frame: i64 = -1
+	for raw, ln in lines {
+		line := strings.trim_space(raw)
+		if len(line) == 0 || strings.has_prefix(line, "#") { continue }
+		if idx := strings.index(line, " #"); idx >= 0 {
+			line = strings.trim_space(line[:idx])
+		}
+		fields := strings.fields(line)
+		if len(fields) == 0 { continue }
+		switch fields[0] {
+		case "seed":
+			v, ok := parse_u64(fields, 1)
+			if !ok { return d, fmt.tprintf("line %d: bad seed", ln+1) }
+			d.seed = v
+		case "map":
+			if len(fields) < 2 { return d, fmt.tprintf("line %d: map needs a fixture", ln+1) }
+			if fields[1] != "demo_six_nodes" && fields[1] != "bare" {
+				return d, fmt.tprintf("line %d: unknown map fixture %q", ln+1, fields[1])
+			}
+			d.map_fixture = strings.clone(fields[1])
+		case "boot_wire":
+			d.boot_wire = true
+		case "autopilot":
+			d.autopilot = len(fields) > 1 && fields[1] == "on"
+		case "run":
+			ms, ok := parse_ms(fields, 1)
+			if !ok { return d, fmt.tprintf("line %d: bad run time", ln+1) }
+			d.run_ms = ms
+		case "capture":
+			rest := strings.join(fields[1:], " ", context.temp_allocator)
+			rest = strings.trim_prefix(rest, "at")
+			for part in strings.split(rest, ",", context.temp_allocator) {
+				p := strings.trim_space(part)
+				if len(p) == 0 { continue }
+				ms, ok := parse_ms_str(p)
+				if !ok { return d, fmt.tprintf("line %d: bad capture time %q", ln+1, p) }
+				// floor-to-frame quantization (§10.3) — captures land on
+				// unambiguous frames regardless of author arithmetic
+				frame := ms * FRAME_HZ / 1000
+				append(&d.capture_frames, frame)
+			}
+		case "at":
+			ms, ok := parse_ms(fields, 1)
+			if !ok { return d, fmt.tprintf("line %d: bad at time", ln+1) }
+			frame := ms * FRAME_HZ / 1000
+			if frame < last_frame {
+				return d, fmt.tprintf("line %d: intents out of order (frame %d after %d)", ln+1, frame, last_frame)
+			}
+			last_frame = frame
+			intent, ierr := parse_intent(fields[2:], frame, ln+1)
+			if ierr != "" { return d, ierr }
+			append(&d.intents, intent)
+		case "expect":
+			exp, eerr := parse_expect(fields[1:], ln+1)
+			if eerr != "" { return d, eerr }
+			append(&d.expects, exp)
+		case:
+			return d, fmt.tprintf("line %d: unknown directive %q", ln+1, fields[0])
+		}
+	}
+	if d.run_ms == 0 { return d, "no run <ms> directive" }
+	return d, ""
+}
+
+parse_u64 :: proc(fields: []string, i: int) -> (u64, bool) {
+	if i >= len(fields) { return 0, false }
+	v, ok := strconv.parse_int(fields[i], 10)
+	if !ok || v < 0 { return 0, false }
+	return u64(v), ok
+}
+
+parse_ms :: proc(fields: []string, i: int) -> (i64, bool) {
+	if i >= len(fields) { return 0, false }
+	return parse_ms_str(fields[i])
+}
+
+parse_ms_str :: proc(s: string) -> (i64, bool) {
+	t := strings.trim_suffix(s, "ms")
+	v, ok := strconv.parse_int(t, 10)
+	if !ok || v < 0 { return 0, false }
+	return i64(v), ok
+}
+
+// intents (nodes by NAME; resolved against the live name table at apply):
+//   draw_pipe <a> <b> <tier>
+//   upgrade_pipe <a>-<b> <tier>
+//   demolish <a>-<b> | node <name>
+//   set_priority <a>-<b> <class|none>
+//   set_triage <node> <class|none>
+// trailing "-> <error_name|ok>" asserts the typed edit result.
+parse_intent :: proc(fields_in: []string, frame: i64, ln: int) -> (Demo_Intent, string) {
+	fields := fields_in
+	it: Demo_Intent
+	it.frame = frame
+	if len(fields) == 0 { return it, fmt.tprintf("line %d: empty intent", ln) }
+	it.verb = strings.clone(fields[0])
+	it.label = strings.clone(strings.join(fields, " "))
+	if len(fields) >= 2 && fields[len(fields)-2] == "->" {
+		it.expect_err = strings.clone(fields[len(fields)-1])
+		fields = fields[:len(fields)-2]
+	}
+	pair :: proc(s: string) -> (string, string) {
+		if idx := strings.index(s, "-"); idx >= 0 { return s[:idx], s[idx+1:] }
+		return s, ""
+	}
+	switch it.verb {
+	case "draw_pipe":
+		if len(fields) < 4 { return it, fmt.tprintf("line %d: draw_pipe a b tier", ln) }
+		it.a = strings.clone(fields[1])
+		it.b = strings.clone(fields[2])
+		if !valid_tier(fields[3]) { return it, fmt.tprintf("line %d: unknown tier %q", ln, fields[3]) }
+		it.arg = strings.clone(fields[3])
+	case "place_router":
+		if len(fields) < 4 { return it, fmt.tprintf("line %d: place_router type x y", ln) }
+		it.a = strings.clone(fields[1])
+		it.x, _ = strconv.parse_i64(fields[2])
+		it.y, _ = strconv.parse_i64(fields[3])
+	case "upgrade_pipe":
+		if len(fields) < 3 { return it, fmt.tprintf("line %d: upgrade_pipe a-b tier", ln) }
+		a, b := pair(fields[1])
+		it.a = strings.clone(a)
+		it.b = strings.clone(b)
+		if !valid_tier(fields[2]) { return it, fmt.tprintf("line %d: unknown tier %q", ln, fields[2]) }
+		it.arg = strings.clone(fields[2])
+	case "demolish":
+		if len(fields) < 2 { return it, fmt.tprintf("line %d: demolish a-b|node name", ln) }
+		if fields[1] == "node" {
+			it.verb = "demolish_node"
+			it.a = strings.clone(fields[2])
+		} else {
+			a, b := pair(fields[1])
+			it.a = strings.clone(a)
+			it.b = strings.clone(b)
+		}
+	case "set_priority":
+		if len(fields) < 3 { return it, fmt.tprintf("line %d: set_priority a-b class", ln) }
+		a, b := pair(fields[1])
+		it.a = strings.clone(a)
+		it.b = strings.clone(b)
+		if !valid_class(fields[2]) { return it, fmt.tprintf("line %d: unknown class %q", ln, fields[2]) }
+		it.arg = strings.clone(fields[2])
+	case "set_triage":
+		if len(fields) < 3 { return it, fmt.tprintf("line %d: set_triage node class", ln) }
+		it.a = strings.clone(fields[1])
+		if !valid_class(fields[2]) { return it, fmt.tprintf("line %d: unknown class %q", ln, fields[2]) }
+		it.arg = strings.clone(fields[2])
+	case:
+		return it, fmt.tprintf("line %d: unknown intent %q", ln, it.verb)
+	}
+	return it, ""
+}
+
+valid_tier :: proc(s: string) -> bool {
+	return s == "narrow" || s == "standard" || s == "wide"
+}
+
+valid_class :: proc(s: string) -> bool {
+	return s == "email" || s == "streaming" || s == "none"
+}
+
+tier_ref :: proc(s: string) -> u16 {
+	switch s {
+	case "narrow": return 0
+	case "standard": return 1
+	case "wide": return 2
+	}
+	return 1
+}
+
+class_ref :: proc(s: string) -> i32 {
+	switch s {
+	case "email": return 0
+	case "streaming": return 1
+	}
+	return -1
+}
+
+// Build the command at apply time, resolving names EXACTLY (no hashes — the
+// determinism tool never iterates maps or approximates names).
+intent_command :: proc(it: ^Demo_Intent, names: map[string]u32, t: ^pp.Topology, cat: ^pp.Catalogs) -> pp.Command {
+	cmd: pp.Command
+	node := proc(n: string, names: map[string]u32) -> u32 {
+		return names[n] // 0 (missing) -> loud validation rejection downstream
+	}
+	pipe := proc(a, b: string, names: map[string]u32, t: ^pp.Topology) -> u32 {
+		na := names[a]
+		nb := names[b]
+		if na == 0 || nb == 0 { return 0 }
+		buf: [8]u32
+		n := pp.pipes_between(t, na, nb, buf[:])
+		if n > 0 { return buf[0] }
+		return 0
+	}
+	switch it.verb {
+	case "draw_pipe":
+		cmd.kind = pp.Cmd_Draw_Pipe{a = node(it.a, names), b = node(it.b, names), tier = tier_ref(it.arg)}
+	case "upgrade_pipe":
+		cmd.kind = pp.Cmd_Upgrade_Pipe{pipe = pipe(it.a, it.b, names, t), to_tier = tier_ref(it.arg)}
+	case "demolish":
+		cmd.kind = pp.Cmd_Demolish{target = pipe(it.a, it.b, names, t), is_node = false}
+	case "demolish_node":
+		cmd.kind = pp.Cmd_Demolish{target = node(it.a, names), is_node = true}
+	case "set_priority":
+		cmd.kind = pp.Cmd_Set_Pipe_Priority{pipe = pipe(it.a, it.b, names, t), priority = class_ref(it.arg)}
+	case "set_triage":
+		cmd.kind = pp.Cmd_Set_Junction_Triage{junction = node(it.a, names), triage = class_ref(it.arg)}
+	case "place_router":
+		ti, okt := pp.node_type_index(cat, it.a)
+		if !okt {
+			fmt.eprintf("demo: unknown router type %q (place_router)\n", it.a)
+		} else {
+			cmd.kind = pp.Cmd_Place_Router{type_idx = ti, pos = {i32(it.x), i32(it.y)}}
+		}
+	}
+	return cmd
+}
+
+parse_expect :: proc(fields: []string, ln: int) -> (Demo_Expect, string) {
+	e: Demo_Expect
+	if len(fields) == 0 { return e, fmt.tprintf("line %d: empty expect", ln) }
+	switch fields[0] {
+	case "event":
+		if len(fields) < 2 { return e, "expect event <name>" }
+		e.kind = .Event
+		if !valid_event_name(fields[1]) {
+			return e, fmt.tprintf("line %d: unknown event %q", ln, fields[1])
+		}
+		e.event_name = strings.clone(fields[1])
+		rest := fields[2:]
+		if len(rest) > 0 && rest[0] != "within" {
+			if rest[0] != "surge" { return e, fmt.tprintf("line %d: unknown archetype %q", ln, rest[0]) }
+			e.event_arg = strings.clone(rest[0])
+			rest = rest[1:]
+		}
+		if len(rest) >= 2 && rest[0] == "within" {
+			range := strings.split(rest[1], "..", context.temp_allocator)
+			if len(range) == 2 {
+				lo, ok1 := parse_ms_str(range[0])
+				hi, ok2 := parse_ms_str(range[1])
+				if !ok1 || !ok2 { return e, fmt.tprintf("line %d: bad window", ln) }
+				e.lo_ms = lo
+				e.hi_ms = hi
+			}
+		}
+	case "terminal":
+		if len(fields) < 2 { return e, "expect terminal won|lost" }
+		if fields[1] != "won" && fields[1] != "lost" {
+			return e, fmt.tprintf("line %d: unknown terminal state %q", ln, fields[1])
+		}
+		e.kind = .Terminal
+		e.terminal = strings.clone(fields[1])
+	case "hash":
+		e.kind = .Hash_Stable
+	case:
+		return e, fmt.tprintf("line %d: unknown expect %q", ln, fields[0])
+	}
+	return e, ""
+}
+
+valid_event_name :: proc(s: string) -> bool {
+	switch s {
+	case "packet_arrived", "packet_dropped", "forecast_issued", "warning_raised",
+		 "crisis_triggered", "crisis_resolved", "grace_started", "grace_expired",
+		 "run_won", "run_lost", "node_spawned", "meter_changed", "warning_cleared":
+		return true
+	}
+	return false
+}
+
+edit_error_name :: proc(err: pp.Edit_Error) -> string {
+	switch err {
+	case .None: return "ok"
+	case .Self_Loop: return "self_loop"
+	case .Missing_Node: return "missing_node"
+	case .Missing_Pipe: return "missing_pipe"
+	case .Missing_Junction: return "missing_junction"
+	case .Not_A_Junction: return "not_a_junction"
+	case .Terminal_To_Terminal: return "terminal_to_terminal"
+	case .Terminal_Demolish: return "terminal_demolish"
+	case .Router_Ports_Full: return "router_ports_full"
+	case .Span_Exceeds_Tier: return "span_exceeds_tier"
+	case .Out_Of_Links: return "out_of_links"
+	case .Out_Of_Routers: return "out_of_routers"
+	case .Invalid_Placement: return "invalid_placement"
+	case .Unknown_Tier: return "unknown_tier"
+	case .Negative_Weight: return "negative_weight"
+	case .Invalid_Weights: return "invalid_weights"
+	case .Invalid_Triage: return "invalid_triage"
+	case .Unknown_Command: return "unknown_command"
+	}
+	return "?"
+}
+
+event_matches :: proc(e: pp.Event, exp: Demo_Expect) -> bool {
+	switch exp.event_name {
+	case "packet_arrived":
+		_, ok := e.kind.(pp.Ev_Packet_Arrived)
+		return ok
+	case "packet_dropped":
+		_, ok := e.kind.(pp.Ev_Packet_Dropped)
+		return ok
+	case "forecast_issued":
+		_, ok := e.kind.(pp.Ev_Forecast_Issued)
+		return ok
+	case "warning_raised":
+		_, ok := e.kind.(pp.Ev_Warning_Raised)
+		return ok
+	case "warning_cleared":
+		_, ok := e.kind.(pp.Ev_Warning_Cleared)
+		return ok
+	case "crisis_triggered":
+		if c, ok := e.kind.(pp.Ev_Crisis_Triggered); ok {
+			if exp.event_arg == "" { return true }
+			if exp.event_arg == "surge" && c.archetype == .Surge { return true }
+		}
+	case "crisis_resolved":
+		_, ok := e.kind.(pp.Ev_Crisis_Resolved)
+		return ok
+	case "grace_started":
+		_, ok := e.kind.(pp.Ev_Grace_Started)
+		return ok
+	case "grace_expired":
+		_, ok := e.kind.(pp.Ev_Grace_Expired)
+		return ok
+	case "run_won":
+		_, ok := e.kind.(pp.Ev_Run_Won)
+		return ok
+	case "run_lost":
+		_, ok := e.kind.(pp.Ev_Run_Lost)
+		return ok
+	case "node_spawned":
+		_, ok := e.kind.(pp.Ev_Node_Spawned)
+		return ok
+	case "meter_changed":
+		_, ok := e.kind.(pp.Ev_Meter_Changed)
+		return ok
+	}
+	return false
+}
diff --git a/harness/goldens.odin b/harness/goldens.odin
new file mode 100644
index 0000000..ff87427
--- /dev/null
+++ b/harness/goldens.odin
@@ -0,0 +1,273 @@
+package main
+
+// goldens.odin — T1 (state-hash manifests) + T2 (pixel goldens) compare and
+// bless, and the agent-readable diff bundles (§10.5). Zero-tolerance compare
+// on DECODED pixels (never file bytes); the rlsw readback is normalized
+// (vertical flip + BGR->RGB swizzle) before compare/export.
+
+import "core:fmt"
+import "core:os"
+import "core:strconv"
+import "core:strings"
+import rl "vendor:raylib"
+import pp "../core"
+import rnd "../app/render"
+import prun "../app/run"
+
+Report :: struct {
+	demo:      string,
+	diff_dirs: [dynamic]string,
+}
+
+// --- T2 capture -----------------------------------------------------------------
+
+// Render the game frame (world + HUD, no popovers/toasts) headless and read
+// back normalized RGBA pixels.
+capture_frame :: proc(v: ^rnd.View, rc: ^prun.Run_Context, mg: ^rnd.Map_Gen, time_ms: i64) -> rl.Image {
+	rl.BeginDrawing()
+	rnd.draw_world(v, &rc.snapshot, mg, time_ms, {}, {})
+	rnd.draw_hud(v, &rc.snapshot, rnd.Hud_State{hint = "", onboarding = false, time_ms = time_ms})
+	rl.EndDrawing()
+	img := rl.LoadImageFromScreen()
+	rl.ImageFlipVertical(&img)          // framebuffer readback is bottom-up
+	swizzle_rb(&img)                    // rlsw framebuffer is BGRA
+	return img
+}
+
+swizzle_rb :: proc(img: ^rl.Image) {
+	px := rl.LoadImageColors(img^)
+	n := int(img.width) * int(img.height)
+	for i in 0 ..< n {
+		px[i].r, px[i].b = px[i].b, px[i].r
+	}
+	// build the normalized image struct around the swizzled pixels
+	new_img: rl.Image
+	new_img.data = raw_data(px)
+	new_img.width = img.width
+	new_img.height = img.height
+	new_img.mipmaps = 1
+	new_img.format = .UNCOMPRESSED_R8G8B8A8
+	rl.UnloadImage(img^) // frees the old buffer only (we keep px)
+	img^ = new_img
+}
+
+golden_path :: proc(demo: string, ms: i64) -> string {
+	return fmt.tprintf("goldens/%s/%05dms.png", demo, ms)
+}
+
+write_golden :: proc(demo: string, ms: i64, img: rl.Image) {
+	dir := fmt.tprintf("goldens/%s", demo)
+	mkdir_p(dir)
+	path := golden_path(demo, ms)
+	cpath := strings.clone_to_cstring(path, context.temp_allocator)
+	ok := rl.ExportImage(img, cpath)
+	if !ok {
+		fmt.eprintfln("harness: failed to write %s", path)
+	}
+	rl.UnloadImage(img)
+}
+
+check_golden :: proc(demo: string, ms: i64, img: rl.Image, report: ^Report, fails: ^[dynamic]string) {
+	path := golden_path(demo, ms)
+	if !os.exists(path) {
+		append(fails, fmt.tprintf("T2 %dms: no golden (run `harness save %s` to bless)", ms, demo))
+		append(&report.diff_dirs, save_diff_bundle(demo, ms, img, {}))
+		rl.UnloadImage(img)
+		return
+	}
+	if !os.exists(path) { /* handled above */ }
+	golden := rl.LoadImage(strings.clone_to_cstring(path, context.temp_allocator))
+	mismatch, total, bbox := compare_images(golden, img)
+	if mismatch < 0 {
+		// undecodable or dimension-drifted golden — the pixel tier must fail
+		// loudly, never pass on nothing (review r1 blocker)
+		dir := save_diff_bundle(demo, ms, img, {})
+		append(&report.diff_dirs, dir)
+		append(fails, fmt.tprintf("T2 %dms: golden corrupt or wrong size — cannot compare (re-bless deliberately)", ms))
+	} else if mismatch > 0 {
+		dir := save_diff_bundle(demo, ms, img, golden)
+		append(&report.diff_dirs, dir)
+		append(fails, fmt.tprintf("T2 %dms: %d pixels differ (bbox %v) — diff bundle at %s",
+			ms, mismatch, bbox, dir))
+	} else {
+		rl.UnloadImage(img)
+	}
+	rl.UnloadImage(golden)
+}
+
+compare_images :: proc(a, b: rl.Image) -> (mismatched: int, total: int, bbox: [4]int) {
+	if a.width != b.width || a.height != b.height {
+		return -1, 0, {}
+	}
+	pa := rl.LoadImageColors(a)
+	pb := rl.LoadImageColors(b)
+	defer rl.UnloadImageColors(pa)
+	defer rl.UnloadImageColors(pb)
+	total = int(a.width) * int(a.height)
+	bbox = {1 << 30, 1 << 30, -1, -1}
+	for i in 0 ..< total {
+		if pa[i] != pb[i] {
+			mismatched += 1
+			x := i % int(a.width)
+			y := i / int(a.width)
+			bbox[0] = min(bbox[0], x)
+			bbox[1] = min(bbox[1], y)
+			bbox[2] = max(bbox[2], x)
+			bbox[3] = max(bbox[3], y)
+		}
+	}
+	return mismatched, total, bbox
+}
+
+// expected/actual/diff + diff.json (§10.5 — the agent's entry point)
+save_diff_bundle :: proc(demo: string, ms: i64, actual: rl.Image, expected: rl.Image) -> string {
+	dir := fmt.tprintf("goldens/_reports/%s/latest", demo)
+	mkdir_p(dir)
+	base := fmt.tprintf("%05dms", ms)
+	mkdir_p(fmt.tprintf("%s/%s", dir, base))
+	rl.ExportImage(actual, strings.clone_to_cstring(fmt.tprintf("%s/%s/actual.png", dir, base), context.temp_allocator))
+	mismatch: int
+	total: int
+	bbox: [4]int
+	if expected.width > 0 {
+		rl.ExportImage(expected, strings.clone_to_cstring(fmt.tprintf("%s/%s/expected.png", dir, base), context.temp_allocator))
+		// amplified per-pixel delta
+		pa := rl.LoadImageColors(expected)
+		pb := rl.LoadImageColors(actual)
+		n := int(expected.width) * int(expected.height)
+		out := make([]rl.Color, n, context.temp_allocator)
+		mismatch, total, bbox = compare_images(expected, actual)
+		for i in 0 ..< n {
+			if pa[i] != pb[i] {
+				out[i] = {255, 0, 0, 255} // red overlay on change
+			} else {
+				out[i] = {u8(u16(pa[i].r)/3), u8(u16(pa[i].g)/3), u8(u16(pa[i].b)/3), 255}
+			}
+		}
+		dimg: rl.Image
+		dimg.data = raw_data(out)
+		dimg.width = expected.width
+		dimg.height = expected.height
+		dimg.mipmaps = 1
+		dimg.format = .UNCOMPRESSED_R8G8B8A8
+		rl.ExportImage(dimg, strings.clone_to_cstring(fmt.tprintf("%s/%s/diff.png", dir, base), context.temp_allocator))
+		// NOTE: never UnloadImage(dimg) — dimg.data is the Odin temp arena's,
+		// not raylib's; unloading would free a non-raylib pointer (the ubuntu
+		// CI SIGABRT / macOS malloc abort in the diff path)
+		rl.UnloadImageColors(pa)
+		rl.UnloadImageColors(pb)
+		js := fmt.tprintf(`{{"frame_ms": %d, "mismatched_pixels": %d, "total_pixels": %d, "bounding_box": [%d, %d, %d, %d]}}`,
+			ms, mismatch, total, bbox[0], bbox[1], bbox[2], bbox[3])
+		write_file(fmt.tprintf("%s/%s/diff.json", dir, base), transmute([]u8)js)
+	} else {
+		js := fmt.tprintf(`{{"frame_ms": %d, "note": "no golden existed"}}`, ms)
+		write_file(fmt.tprintf("%s/%s/diff.json", dir, base), transmute([]u8)js)
+	}
+	return fmt.tprintf("%s/%s", dir, base)
+}
+
+write_report :: proc(report: ^Report, fails: [dynamic]string) {
+	if len(report.diff_dirs) == 0 && len(fails) == 0 { return }
+	dir := fmt.tprintf("goldens/_reports/%s", report.demo)
+	mkdir_p(dir)
+	sb := strings.builder_make(context.temp_allocator)
+	strings.write_string(&sb, "# harness report\n")
+	for f in fails {
+		strings.write_string(&sb, "- ")
+		strings.write_string(&sb, f)
+		strings.write_string(&sb, "\n")
+	}
+	write_file(fmt.tprintf("%s/REPORT.txt", dir), transmute([]u8)strings.to_string(sb))
+}
+
+// --- T1 manifests -----------------------------------------------------------------
+
+manifest_path :: proc(demo: string) -> string {
+	return fmt.tprintf("goldens/%s.t1", demo)
+}
+
+check_hashes :: proc(demo_name: string, demo: Demo, catalogs: ^pp.Catalogs, hashes: []u64, save: bool, report: ^Report, fails: ^[dynamic]string) -> bool {
+	path := manifest_path(demo_name)
+	if save {
+		sb := strings.builder_make(context.temp_allocator)
+		fmt.sbprintf(&sb, "# t1 manifest — per-tick FNV-1a-64 state hashes (full sim state)\n")
+		fmt.sbprintf(&sb, "t1 1\ndemo %s\nseed %d\nlogic_hz %d\ncatalog_hash %016x\nticks %d\n",
+			demo_name, demo.seed, catalogs.balance.logic_hz, catalogs.hash, len(hashes))
+		for h, i in hashes {
+			fmt.sbprintf(&sb, "%d %016x\n", i + 1, h)
+		}
+		write_file(path, transmute([]u8)strings.to_string(sb))
+		return true
+	}
+	if !os.exists(path) {
+		append(fails, fmt.tprintf("T1: no manifest (run `harness save %s` to bless)", demo_name))
+		return false
+	}
+	m, okm := read_manifest(path)
+	if !okm {
+		append(fails, "T1: unreadable manifest")
+		return false
+	}
+	golden := m.hashes
+	ok := true
+	if m.version != 1 {
+		append(fails, fmt.tprintf("T1: manifest version %d (want 1)", m.version))
+		ok = false
+	}
+	if m.seed != demo.seed {
+		append(fails, fmt.tprintf("T1: seed drift — manifest %d vs demo %d", m.seed, demo.seed))
+		ok = false
+	}
+	if m.catalog_hash != catalogs.hash {
+		append(fails, fmt.tprintf("T1: catalog drift — manifest %016x vs current %016x (re-bless deliberately)",
+			m.catalog_hash, catalogs.hash))
+		ok = false
+	}
+	if m.logic_hz != i64(catalogs.balance.logic_hz) {
+		append(fails, fmt.tprintf("T1: logic_hz drift — manifest %d vs current %d", m.logic_hz, catalogs.balance.logic_hz))
+		ok = false
+	}
+	if m.ticks != i64(len(m.hashes)) {
+		append(fails, fmt.tprintf("T1: manifest corrupt — ticks header %d but %d hash lines", m.ticks, len(m.hashes)))
+		ok = false
+	}
+	if len(golden) != len(hashes) {
+		append(fails, fmt.tprintf("T1: tick count %d vs golden %d", len(hashes), len(golden)))
+		ok = false
+	} else {
+		for i in 0 ..< len(hashes) {
+			if hashes[i] != golden[i] {
+				append(fails, fmt.tprintf("T1: STATE DIVERGENCE at tick %d: %016x != golden %016x",
+					i + 1, hashes[i], golden[i]))
+				ok = false
+				break
+			}
+		}
+	}
+	return ok
+}
+
+// os.write_entire_file with the error checked-and-logged (never dropped)
+write_file :: proc(path: string, data: []byte) {
+	if err := os.write_entire_file(path, data); err != nil {
+		fmt.eprintfln("harness: write failed %s: %v", path, err)
+	}
+}
+
+// recursive mkdir (os.make_directory is single-level)
+mkdir_p :: proc(path: string) {
+	parts := strings.split(path, "/", context.temp_allocator)
+	cur: [dynamic]u8
+	for part, i in parts {
+		if i > 0 { append(&cur, '/') }
+		for c in part { append(&cur, u8(c)) }
+		os.make_directory(string(cur[:]))
+	}
+}
+
+// os.write_entire_file with the error checked-and-logged (never dropped)
+write_log :: proc(path: string, data: []byte) {
+	if err := os.write_entire_file(path, data); err != nil {
+		fmt.eprintfln("harness: write failed %s: %v", path, err)
+	}
+}
diff --git a/harness/main.odin b/harness/main.odin
new file mode 100644
index 0000000..cdd8e34
--- /dev/null
+++ b/harness/main.odin
@@ -0,0 +1,338 @@
+package main
+
+// harness/main.odin — the golden-image test harness (ODN-17, architecture
+// §10). The agent's eyes: scripted demos + virtual-clock test frames +
+// render-to-framebuffer + golden compare + agent-readable diffs + deliberate
+// re-bless. Two tiers: T1 per-tick state-hash goldens (the determinism
+// spine; covers ALL sim state incl. in-flight packets + rng + events) and T2
+// pixel goldens (rlsw software renderer + PLATFORM_MEMORY — bit-exact, no
+// GPU/display).
+//
+// Usage:
+//   harness run [demo...]    — replay demos; T1+T2+expect+replay; non-zero on any failure
+//   harness save [demo...]   — re-bless goldens (deliberate; PR-reviewed)
+//   harness replay <demo> <log.bin> — re-run from an action log; manifest must match
+
+import "core:fmt"
+import "core:os"
+import "core:strings"
+import rl "vendor:raylib"
+import pp "../core"
+import rnd "../app/render"
+import prun "../app/run"
+
+FRAME_HZ :: 60
+
+Demo :: struct {
+	name:        string,
+	seed:        u64,
+	map_fixture: string, // "demo_six_nodes" (default boot) | "bare"
+	boot_wire:   bool,
+	autopilot:   bool,
+	run_ms:      i64,
+	intents:     [dynamic]Demo_Intent,
+	capture_frames: [dynamic]i64, // floor-to-frame quantized at parse (§10.3)
+	expects:     [dynamic]Demo_Expect,
+}
+
+Demo_Intent :: struct {
+	frame: i64,
+	verb:  string,
+	a:     string,
+	b:     string,
+	arg:   string,
+	x, y:  i64, // tile coords (place_router)
+	expect_err: string, // "" = must succeed; "any" = don't check
+	label: string,
+}
+
+Expect_Kind :: enum u8 { Event, Terminal, Hash_Stable }
+
+Demo_Expect :: struct {
+	kind:       Expect_Kind,
+	event_name: string,
+	event_arg:  string,
+	lo_ms:      i64,
+	hi_ms:      i64,
+	terminal:   string,
+}
+
+main :: proc() {
+	args := os.args[1:]
+	if len(args) == 0 {
+		usage()
+	}
+	verb := args[0]
+	rest := args[1:]
+
+	if verb == "replay" {
+		if len(rest) != 2 { usage() }
+		os.exit(int(run_replay(rest[0], rest[1])))
+	}
+	if verb != "run" && verb != "save" {
+		usage()
+	}
+
+	names := rest
+	collected: [dynamic]string
+	if len(names) == 0 {
+		entries: []os.File_Info
+		derr: os.Error
+		dir_handle, derr2 := os.open("demos")
+		if derr2 == nil {
+			entries, derr = os.read_dir(dir_handle, -1, context.temp_allocator)
+			os.close(dir_handle)
+		} else {
+			derr = derr2
+		}
+		if derr != nil {
+			fmt.eprintln("harness: no demos/ directory")
+			os.exit(2)
+		}
+		for e in entries {
+			if strings.has_suffix(e.name, ".dem") {
+				append(&collected, strings.clone(e.name[:len(e.name)-4]))
+			}
+		}
+		names = collected[:]
+	}
+
+	// headless software renderer, once for the whole run
+	rl.SetTraceLogLevel(.ERROR)
+	rl.InitWindow(1280, 720, "pp-harness")
+
+	failures := 0
+	for name in names {
+		ok := run_demo(name, verb == "save")
+		if !ok { failures += 1 }
+		free_all(context.temp_allocator)
+	}
+	rl.CloseWindow()
+	if verb == "save" {
+		if failures > 0 {
+			fmt.printf("harness: %d demo(s) FAILED during bless\n", failures)
+			os.exit(1)
+		}
+		fmt.printf("harness: blessed %d demo(s)\n", len(names))
+		os.exit(0)
+	}
+	if failures > 0 {
+		fmt.printf("harness: %d demo(s) FAILED\n", failures)
+		os.exit(1)
+	}
+	fmt.printf("harness: %d demo(s) green\n", len(names))
+}
+
+usage :: proc() -> ! {
+	fmt.eprintln("usage: harness run|save [demo...] | replay <demo> <log.bin>")
+	os.exit(2)
+}
+
+run_demo :: proc(name: string, save: bool) -> bool {
+	path := fmt.tprintf("demos/%s.dem", name)
+	data, err := os.read_entire_file_from_path(path, context.temp_allocator)
+	if err != nil {
+		fmt.eprintfln("harness: cannot read %s", path)
+		return false
+	}
+	demo, perr := parse_demo(name, string(data))
+	if perr != "" {
+		fmt.eprintfln("harness: %s: parse error: %s", path, perr)
+		return false
+	}
+
+	catalogs, cerr := prun.load_catalogs("data")
+	if cerr.file != "" {
+		fmt.eprintfln("harness: %s", pp.catalog_error_string(cerr))
+		return false
+	}
+	// the virtual clock needs an integer frames-per-tick (W2 review)
+	hz := int(catalogs.balance.logic_hz)
+	if hz <= 0 || hz > FRAME_HZ || FRAME_HZ % hz != 0 {
+		fmt.eprintfln("harness: logic_hz %d must divide %d for the virtual clock", hz, FRAME_HZ)
+		return false
+	}
+
+	palette := rnd.palette_load()
+	for pt, i in catalogs.packet_types {
+		if i < len(palette.packet) {
+			palette.packet[i] = {pt.color[0], pt.color[1], pt.color[2], pt.color[3]}
+		}
+	}
+	view: rnd.View
+	view.palette = &palette
+	view.catalogs = catalogs
+	view.font = rl.GetFontDefault()
+	rnd.view_compute(&view, 1280, 720, &catalogs.balance)
+
+	rc: prun.Run_Context
+	if demo.map_fixture == "bare" {
+		prun.run_context_create_bare(&rc, demo.seed, catalogs)
+	} else {
+		prun.run_context_create(&rc, demo.seed, catalogs)
+	}
+	mg := rnd.map_generate(demo.seed, view.world_w, view.world_h)
+
+	// bootstrap name aliases; growth names arrive in spawn order
+	names := make(map[string]u32)
+	if demo.map_fixture != "bare" {
+		names["host"] = 1
+		names["house_a"] = 2
+		names["house_b"] = 3
+		names["house_c"] = 4
+		names["house_d"] = 5
+		names["router"] = 6
+	}
+	growth_router_idx := 2
+	growth_house_idx := 'e'
+
+	frames_per_tick := FRAME_HZ / hz
+	total_frames := demo.run_ms * FRAME_HZ / 1000
+
+	hashes := make([dynamic]u64)
+	events_log := make([dynamic]pp.Event)
+	fail_msgs := make([dynamic]string)
+	captures_done := make(map[i64]bool)
+
+	if demo.boot_wire {
+		prun.autopilot_boot(&rc)
+	}
+
+	report := Report{demo = name}
+	frame: i64 = 0
+	intent_idx := 0
+	for frame <= total_frames {
+		// this frame's intents, through the real bus (the player path)
+		for intent_idx < len(demo.intents) && demo.intents[intent_idx].frame <= frame {
+			it := &demo.intents[intent_idx]
+			intent_idx += 1
+			cmd := intent_command(it, names, &rc.state.topology, rc.state.catalogs)
+			err := prun.bus_submit(&rc, cmd)
+			got := "ok" if err == .None else edit_error_name(err)
+			if it.expect_err != "any" {
+				exp := it.expect_err
+				ok := (exp == "" && err == .None) || (exp != "" && got == exp)
+				if !ok {
+					append(&fail_msgs, fmt.tprintf("intent %q at frame %d: got %s, want %s",
+						it.label, it.frame, got, exp == "" ? "ok" : exp))
+				}
+			}
+		}
+		// step on tick frames (integer frame counting — the rational clock)
+		if frame > 0 && frame % i64(frames_per_tick) == 0 && !rc.ended {
+			rc.driver.tick += 1
+			pp.step(rc.state, rc.driver.tick, {})
+			if rc.state.health.won || rc.state.health.lost { rc.ended = true }
+			// T1: hash at the step boundary (post-step, BEFORE fast-path edits
+			// like the autopilot's — they carry apply_tick = tick+1 and belong
+			// to the next boundary; this is the replay-matched convention)
+			append(&hashes, pp.state_hash(rc.state, rc.state.events[:], context.temp_allocator))
+			// collect + name growth, then drain the event buffer (ODN-14)
+			for e in rc.state.events {
+				append(&events_log, e)
+				if ns, ok := e.kind.(pp.Ev_Node_Spawned); ok {
+					type_id := catalogs.node_types[ns.type_idx].id
+					if type_id == "router_basic" {
+						names[fmt.tprintf("router_%d", growth_router_idx)] = ns.node
+						growth_router_idx += 1
+					} else if type_id == "residential" {
+						names[fmt.tprintf("house_%c", growth_house_idx)] = ns.node
+						growth_house_idx += 1
+					}
+				}
+			}
+			clear(&rc.state.events)
+			if demo.autopilot {
+				prun.autopilot_tick(&rc)
+			}
+			prun.resnapshot(&rc)
+		}
+		// captures (T2)
+		for cap_frame in demo.capture_frames {
+			if cap_frame == frame && !captures_done[cap_frame] {
+				captures_done[cap_frame] = true
+				time_ms := frame * 1000 / FRAME_HZ
+				img := capture_frame(&view, &rc, &mg, time_ms)
+				if save {
+					write_golden(name, time_ms, img)
+				} else {
+					check_golden(name, time_ms, img, &report, &fail_msgs)
+				}
+			}
+		}
+		frame += 1
+	}
+	prun.resnapshot(&rc)
+
+	// audit: every scripted capture fired, every intent applied (review r1 —
+	// silent coverage loss is the harness's own trap)
+	for cap_frame in demo.capture_frames {
+		if !captures_done[cap_frame] {
+			append(&fail_msgs, fmt.tprintf("capture at frame %d never fired (past run end?)", cap_frame))
+		}
+	}
+	if intent_idx != len(demo.intents) {
+		append(&fail_msgs, fmt.tprintf("%d intent(s) never applied (past run end?)", len(demo.intents) - intent_idx))
+	}
+
+	// expectations
+	for exp in demo.expects {
+		switch exp.kind {
+		case .Event:
+			lo_tick := u64(exp.lo_ms * i64(hz) / 1000)
+			hi_tick := u64(exp.hi_ms * i64(hz) / 1000)
+			found := false
+			for e in events_log {
+				if e.tick < lo_tick || e.tick > hi_tick { continue }
+				if event_matches(e, exp) { found = true; break }
+			}
+			if !found {
+				append(&fail_msgs, fmt.tprintf("expect event %s within %d..%dms — not seen",
+					exp.event_name, exp.lo_ms, exp.hi_ms))
+			}
+		case .Terminal:
+			if exp.terminal == "won" && !rc.state.health.won {
+				append(&fail_msgs, "expect terminal won — run was not won")
+			}
+			if exp.terminal == "lost" && !rc.state.health.lost {
+				append(&fail_msgs, "expect terminal lost — run was not lost")
+			}
+		case .Hash_Stable:
+			// the manifest compare below is the substance
+		}
+	}
+
+	check_hashes(name, demo, catalogs, hashes[:], save, &report, &fail_msgs)
+	if rc.state.replay_error {
+		append(&fail_msgs, "replay_error latched during the run (ODN-11 critical)")
+	}
+
+	if save {
+		write_log(fmt.tprintf("goldens/%s.log.bin", name), pp.log_write(rc.state, context.temp_allocator))
+	} else if len(fail_msgs) == 0 {
+		// the replay gate: the blessed action log must re-sim the blessed
+		// manifest bit-for-bit, through the FULL recorded run (ODN-11)
+		log_path := fmt.tprintf("goldens/%s.log.bin", name)
+		if !os.exists(log_path) {
+			append(&fail_msgs, fmt.tprintf("no blessed log at %s (re-bless with `harness save %s`)", log_path, name))
+		} else {
+			rep_ok := verify_replay(name, log_path, catalogs, hashes[:])
+			if !rep_ok {
+				append(&fail_msgs, "replay of the blessed log diverges from the manifest")
+			}
+		}
+	}
+
+	ok := len(fail_msgs) == 0
+	if save {
+		fmt.printf("  save %-20s ticks=%d captures=%d\n", name, len(hashes), len(demo.capture_frames))
+	} else if ok {
+		fmt.printf("  PASS %-20s ticks=%d\n", name, len(hashes))
+	} else {
+		fmt.printf("  FAIL %s\n", name)
+		for m in fail_msgs { fmt.printf("    - %s\n", m) }
+		write_report(&report, fail_msgs)
+	}
+	prun.run_context_destroy(&rc)
+	return ok || save
+}
diff --git a/harness/replay.odin b/harness/replay.odin
new file mode 100644
index 0000000..fd32043
--- /dev/null
+++ b/harness/replay.odin
@@ -0,0 +1,169 @@
+package main
+
+// replay.odin — the ODN-11 replay gate. `harness replay <demo> <log.bin>`
+// re-runs the scenario from its action log alone and requires the FULL
+// manifest to match (every recorded tick — the terminal states included).
+// `verify_replay` is the same check folded into `harness run` after the T1
+// compare, so the blessed log can never drift from the blessed manifest.
+
+import "core:fmt"
+import "core:os"
+import "core:strconv"
+import "core:strings"
+import pp "../core"
+import prun "../app/run"
+
+Manifest :: struct {
+	seed:         u64,
+	logic_hz:     i64,
+	catalog_hash: u64,
+	ticks:        i64,
+	hashes:       [dynamic]u64,
+	version:      i64,
+}
+
+read_manifest :: proc(path: string) -> (Manifest, bool) {
+	m: Manifest
+	m.version = -1
+	if !os.exists(path) { return m, false }
+	data, err := os.read_entire_file_from_path(path, context.temp_allocator)
+	if err != nil { return m, false }
+	for raw_line in strings.split(string(data), "\n", context.temp_allocator) {
+		line := strings.trim_space(raw_line)
+		if len(line) == 0 || line[0] == '#' { continue }
+		fields := strings.fields(line)
+		if len(fields) != 2 { continue }
+		switch fields[0] {
+		case "t1":
+			v, _ := strconv.parse_int(fields[1], 10)
+			m.version = i64(v)
+		case "seed":
+			v, _ := strconv.parse_int(fields[1], 10)
+			m.seed = u64(v)
+		case "logic_hz":
+			v, _ := strconv.parse_int(fields[1], 10)
+			m.logic_hz = i64(v)
+		case "catalog_hash":
+			v, _ := strconv.parse_uint(fields[1], 16)
+			m.catalog_hash = u64(v)
+		case "ticks":
+			v, _ := strconv.parse_int(fields[1], 10)
+			m.ticks = i64(v)
+		case "demo":
+		case:
+			v, okv := strconv.parse_uint(fields[1], 16)
+			if okv { append(&m.hashes, u64(v)) }
+		}
+	}
+	return m, true
+}
+
+// Replay a log and return its per-tick hashes. bare selects the empty-map
+// fixture (the log doesn't record the fixture; the demo does).
+replay_hashes :: proc(log_path: string, catalogs: ^pp.Catalogs, ticks: u64, bare: bool, fails: ^[dynamic]string) -> ([dynamic]u64, bool) {
+	out := make([dynamic]u64)
+	data, err := os.read_entire_file_from_path(log_path, context.temp_allocator)
+	if err != nil {
+		append(fails, fmt.tprintf("replay: cannot read %s", log_path))
+		return out, false
+	}
+	header, cmds, ok := pp.log_read(data, context.allocator)
+	if !ok {
+		append(fails, fmt.tprintf("replay: corrupt log %s", log_path))
+		return out, false
+	}
+	if header.catalog_hash != catalogs.hash {
+		append(fails, fmt.tprintf("replay: catalog drift — log %016x vs current %016x (defined rejection, ODN-11)",
+			header.catalog_hash, catalogs.hash))
+		return out, false
+	}
+	if header.logic_hz != catalogs.balance.logic_hz {
+		append(fails, "replay: logic_hz drift (defined rejection, ODN-11)")
+		return out, false
+	}
+	if header.era != 3 {
+		append(fails, fmt.tprintf("replay: era %d — PROTO runs era 3", header.era))
+		return out, false
+	}
+
+	rc: prun.Run_Context
+	if bare {
+		prun.run_context_create_bare(&rc, header.seed, catalogs)
+	} else {
+		prun.run_context_create(&rc, header.seed, catalogs)
+	}
+	for tick in u64(1) ..= ticks {
+		batch := make([dynamic]pp.Command, context.temp_allocator)
+		for c in cmds {
+			if c.apply_tick == tick { append(&batch, c) }
+		}
+		pp.step(rc.state, tick, batch[:])
+		append(&out, pp.state_hash(rc.state, rc.state.events[:], context.temp_allocator))
+		clear(&rc.state.events)
+		free_all(context.temp_allocator)
+	}
+	if rc.state.replay_error {
+		append(fails, "replay: REPLAY ERROR — a logged command failed validation (ODN-11 critical)")
+		return out, false
+	}
+	prun.run_context_destroy(&rc)
+	return out, true
+}
+
+// the in-run gate: the blessed log must reproduce the live-recorded hashes
+verify_replay :: proc(demo_name, log_path: string, catalogs: ^pp.Catalogs, live_hashes: []u64) -> bool {
+	fails := make([dynamic]string)
+	// the fixture flag is carried by the demo; bare demos don't reach here
+	// with commands, but replay the same way
+	bar := false
+	_ = bar
+	replayed, ok := replay_hashes(log_path, catalogs, u64(len(live_hashes)), false, &fails)
+	if !ok {
+		for f in fails { fmt.printf("    - %s\n", f) }
+		return false
+	}
+	if len(replayed) != len(live_hashes) {
+		fmt.printfln("    - replay length %d != manifest %d", len(replayed), len(live_hashes))
+		return false
+	}
+	for i in 0 ..< len(live_hashes) {
+		if replayed[i] != live_hashes[i] {
+			fmt.printfln("    - replay FIRST DIVERGENCE at tick %d: %016x != %016x", i + 1, replayed[i], live_hashes[i])
+			return false
+		}
+	}
+	return true
+}
+
+// standalone: `harness replay <demo> <log.bin>` — manifest-driven, full length.
+run_replay :: proc(demo_name, log_path: string) -> i32 {
+	catalogs, cerr := prun.load_catalogs("data")
+	if cerr.file != "" {
+		fmt.eprintfln("harness replay: %s", pp.catalog_error_string(cerr))
+		return 2
+	}
+	man, okm := read_manifest(manifest_path(demo_name))
+	if !okm {
+		fmt.eprintfln("harness replay: no manifest for %s (nothing to verify against)", demo_name)
+		return 1
+	}
+	if man.ticks != i64(len(man.hashes)) {
+		fmt.eprintfln("harness replay: manifest corrupt — ticks header %d but %d hash lines", man.ticks, len(man.hashes))
+		return 1
+	}
+	fails := make([dynamic]string)
+	replayed, ok := replay_hashes(log_path, catalogs, u64(man.ticks), false, &fails)
+	if !ok {
+		for f in fails { fmt.eprintfln("harness replay: %s", f) }
+		return 1
+	}
+	for i in 0 ..< min(len(replayed), len(man.hashes)) {
+		if replayed[i] != man.hashes[i] {
+			fmt.eprintfln("harness replay: FIRST DIVERGENCE at tick %d: %016x != golden %016x",
+				i + 1, replayed[i], man.hashes[i])
+			return 1
+		}
+	}
+	fmt.printf("harness replay: %d ticks verified against the manifest — bit-for-bit (ODN-11)\n", man.ticks)
+	return 0
+}
diff --git a/tools/build_raylib_sw.sh b/tools/build_raylib_sw.sh
new file mode 100755
index 0000000..b60b002
--- /dev/null
+++ b/tools/build_raylib_sw.sh
@@ -0,0 +1,77 @@
+#!/usr/bin/env bash
+# tools/build_raylib_sw.sh — build raylib 6.0 with the software renderer
+# (rlsw) + PLATFORM_MEMORY backend for the golden-image harness (architecture
+# §10.4): bit-exact pixels on every machine, no GPU, no display. Pinned to the
+# raylib 6.0 release tarball; cached under tools/raylib-sw/ (gitignored).
+#
+# Produces tools/raylib-sw/shadow/ — an ODIN_ROOT shadow where everything is
+# symlinked to the real toolchain EXCEPT vendor/raylib/{raylib.odin copy,
+# <platform>/libraylib.a = the SW build}. Build the harness with:
+#   ODIN_ROOT=tools/raylib-sw/shadow odin build harness -out:bin/harness
+set -euo pipefail
+
+RAYLIB_TAG="6.0"
+WORK="$(cd "$(dirname "$0")" && pwd)/raylib-sw"
+SRC="$WORK/src"
+OBJ="$WORK/obj"
+SHADOW="$WORK/shadow"
+
+REAL_ROOT="$(odin root)"
+echo "== raylib-sw build (tag $RAYLIB_TAG) =="
+
+if [ ! -d "$SRC" ]; then
+  mkdir -p "$WORK"
+  echo "-- fetching raylib $RAYLIB_TAG source"
+  git clone --depth 1 --branch "$RAYLIB_TAG" https://github.com/raysan5/raylib.git "$SRC"
+fi
+
+mkdir -p "$OBJ"
+echo "-- compiling (PLATFORM_MEMORY + GRAPHICS_API_OPENGL_SOFTWARE)"
+for f in rcore rshapes rtext rtextures rmodels; do
+  # -ffp-contract=off: NO fused multiply-add — clang fuses on arm64 but
+  # baseline x86-64 has no FMA instruction, so the rasterizer's barycentric
+  # float math rounds differently per platform and T2 pixel goldens drift
+  # (the ubuntu-vs-macOS ocean-coastline divergence). Unfused IEEE mul+add
+  # is identical everywhere.
+  cc -c "$SRC/src/$f.c" -o "$OBJ/$f.o" \
+     -DPLATFORM_MEMORY -DGRAPHICS_API_OPENGL_SOFTWARE \
+     -I"$SRC/src" -O2 -w -ffp-contract=off
+done
+ar rcs "$OBJ/libraylib_sw.a" "$OBJ"/rcore.o "$OBJ"/rshapes.o "$OBJ"/rtext.o "$OBJ"/rtextures.o "$OBJ"/rmodels.o
+
+# --- the ODIN_ROOT shadow ------------------------------------------------------
+echo "-- generating shadow root at $SHADOW"
+rm -rf "$SHADOW"
+mkdir -p "$SHADOW/vendor/raylib"
+for d in core base; do ln -sfn "$REAL_ROOT/$d" "$SHADOW/$d"; done
+# link every vendor package dir except raylib
+for pkg in "$REAL_ROOT"/vendor/*; do
+  name="$(basename "$pkg")"
+  if [ "$name" != "raylib" ]; then ln -sfn "$pkg" "$SHADOW/vendor/$name"; fi
+done
+# raylib: symlink everything except the platform lib dirs + the binding file
+for f in "$REAL_ROOT"/vendor/raylib/*; do
+  name="$(basename "$f")"
+  case "$name" in
+    macos|linux|linux-arm64|windows|wasm|raylib.odin) ;;
+    *) ln -sfn "$f" "$SHADOW/vendor/raylib/$name" ;;
+  esac
+done
+cp "$REAL_ROOT/vendor/raylib/raylib.odin" "$SHADOW/vendor/raylib/raylib.odin"
+
+# vendored raylib.odin binds per-os/arch dirs: macos, linux (amd64), linux-arm64
+case "$(uname -s)-$(uname -m)" in
+  Darwin-*)                PLATDIR=macos ;;
+  Linux-x86_64)            PLATDIR=linux ;;
+  Linux-aarch64|Linux-arm64) PLATDIR=linux-arm64 ;;
+  *)      echo "unsupported host platform for the shadow: $(uname -s)-$(uname -m)" >&2; exit 1 ;;
+esac
+mkdir -p "$SHADOW/vendor/raylib/$PLATDIR"
+for f in "$REAL_ROOT"/vendor/raylib/"$PLATDIR"/*; do
+  name="$(basename "$f")"
+  if [ "$name" != "libraylib.a" ]; then ln -sfn "$f" "$SHADOW/vendor/raylib/$PLATDIR/$name"; fi
+done
+cp "$OBJ/libraylib_sw.a" "$SHADOW/vendor/raylib/$PLATDIR/libraylib.a"
+
+echo "== done. Build the harness with:"
+echo "   ODIN_ROOT=$SHADOW odin build harness -out:bin/harness"
diff --git a/tools/harness.sh b/tools/harness.sh
new file mode 100755
index 0000000..76f6958
--- /dev/null
+++ b/tools/harness.sh
@@ -0,0 +1,14 @@
+#!/usr/bin/env bash
+# tools/harness.sh — build + run the golden-image harness against the
+# software-rendered raylib shadow (see tools/build_raylib_sw.sh).
+# Usage: tools/harness.sh run [demo...] | save [demo...] | replay <demo> <log>
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+cd "$ROOT"
+SHADOW="$ROOT/tools/raylib-sw/shadow"
+if [ ! -d "$SHADOW" ]; then
+  "$ROOT/tools/build_raylib_sw.sh"
+fi
+mkdir -p bin
+ODIN_ROOT="$SHADOW" odin build harness -out:bin/harness -debug
+exec ./bin/harness "$@"
diff --git a/tools/lint.sh b/tools/lint.sh
new file mode 100755
index 0000000..8536103
--- /dev/null
+++ b/tools/lint.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+# tools/lint.sh — the §16.3 grep gates (CI-enforced consistency rules).
+#  1. core purity: core/ imports whitelisted core:* only (never vendor:*,
+#     core:os, core:time) — the structural determinism rule (ODN-1).
+#  2. no file-scope mutable state in core (ODN-13: no globals).
+#  3. no map iteration in core (ODN-10: arrays only).
+#  4. no dropped error returns in core (§7.1).
+set -uo pipefail
+cd "$(dirname "$0")/.."
+FAIL=0
+
+echo "-- gate 1: core import purity"
+HITS=$(grep -rn '^import ' core/*.odin | grep -v '_test\.odin' | grep -E 'import "(vendor:[^"]*|core:os|core:time)"' || true)
+if [ -n "$HITS" ]; then echo "$HITS"; echo "FAIL: forbidden import in core/"; FAIL=1; fi
+
+echo "-- gate 2: no file-scope var in core/"
+HITS=$(grep -rnE '^[a-z_][a-z0-9_]*[ ]*:[ ]' core/*.odin | grep -v '_test\.odin' | grep -v '::' || true)
+if [ -n "$HITS" ]; then echo "$HITS"; echo "FAIL: file-scope state in core/"; FAIL=1; fi
+
+echo "-- gate 3: no map iteration in core/"
+HITS=$(grep -rnE 'for .* in .*(map|_by_id|_by_)' core/*.odin | grep -v '_test\.odin' | grep -vE 'for .* in [a-z_]+\.(nodes|pipes|entries)' || true)
+if [ -n "$HITS" ]; then echo "$HITS"; echo "FAIL: possible map iteration in core/"; FAIL=1; fi
+
+echo "-- gate 4: no bare '_' discards of fallible calls in core/"
+HITS=$(grep -rnE '^\s*_ = ' core/*.odin | grep -v '_test\.odin' || true)
+if [ -n "$HITS" ]; then echo "$HITS"; echo "FAIL: dropped return in core/"; FAIL=1; fi
+
+if [ "$FAIL" -ne 0 ]; then exit 1; fi
+echo "lint: all gates green"
