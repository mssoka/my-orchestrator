index 0000000..8bed4a1
--- /dev/null
+++ b/core/flow_test.odin
@@ -0,0 +1,232 @@
+package core
+
+// flow_test.odin — flow-level behavior contracts (Perkins r1 blocker #2: QoS
+// promote/demote + drop behavior were untested in Godot) and the fun-test
+// loop's terminal states as FULL SIM RUNS (surge win with a real build; Error
+// 404 on an idle map).
+
+import "core:testing"
+
+// A contended link where the QoS dial decides who suffers. Purpose-built
+// bare topology: host --standard--> router --legs--> h1,h2 — every terminal
+// routable, the spine the only contended link (15 u/s standard).
+flow_fixture :: proc(t: ^testing.T, priority: i32, tier_name: string = "standard") -> ^Run_State {
+	cat, cerr := must_catalogs()
+	if cerr.file != "" { tfail(t, "catalogs") }
+	state := new(Run_State)
+	run_init_bare(state, 9, cat, context.allocator)
+	host_t, _ := node_type_index(cat, "content_host")
+	res_t, _ := node_type_index(cat, "residential")
+	mid_t, _ := node_type_index(cat, "router_mid")
+	host := spawn_node(&state.topology, host_t, {20, 10}, 0, cat)
+	router := spawn_node(&state.topology, mid_t, {14, 10}, 0, cat)
+	h1 := spawn_node(&state.topology, res_t, {8, 10}, 0, cat)
+	h2 := spawn_node(&state.topology, res_t, {8, 14}, 0, cat)
+	tier, _ := tier_index(cat, tier_name)
+	_, err := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Draw_Pipe{a = host, b = router, tier = tier}}, cat, state.inventory, 0)
+	if err != .None { tfailf(t, "draw spine: %v", err) }
+	// The contention point is the LEGS (email flows house->router->house; the
+	// spine carries only streaming) — the dial goes on the legs.
+	houses := [2]u32{h1, h2}
+	for h in houses {
+		leg, err3 := topology_apply_edit(&state.topology,
+			Command{kind = Cmd_Draw_Pipe{a = router, b = h, tier = tier}}, cat, state.inventory, 0)
+		if err3 != .None { tfailf(t, "draw leg: %v", err3) }
+		if priority >= 0 {
+			_, err4 := topology_apply_edit(&state.topology,
+				Command{kind = Cmd_Set_Pipe_Priority{pipe = leg.pipe, priority = priority}}, cat, state.inventory, 0)
+			if err4 != .None { tfailf(t, "priority: %v", err4) }
+		}
+	}
+	return state
+}
+
+// A synthetic flood: 40 email + 5 streaming per tick over a STANDARD spine
+// (15 u/s). Neutral: the email flood hogs the shared Standard lane and
+// streaming drowns. Prioritized (streaming -> Express): streaming owns its
+// lane and ALL of it flows; email demotes to Best-effort and sheds first.
+flood_plan :: proc(state: ^Run_State) -> Pressure_Plan {
+	plan: Pressure_Plan
+	streaming, _ := class_index(state.catalogs, "streaming")
+	email, _ := class_index(state.catalogs, "email")
+	entries := make([dynamic]Demand_Entry, context.temp_allocator)
+	append(&entries, Demand_Entry{class = email, source_role = .Residential, sink_role = .Residential, volume = 40, default_lane = .Standard})
+	append(&entries, Demand_Entry{class = streaming, source_role = .Content_Host, sink_role = .Residential, volume = 5, default_lane = .Standard})
+	plan.entries = entries[:]
+	plan.set_pieces = make([dynamic]u16, context.temp_allocator)
+	return plan
+}
+
+@(test)
+test_qos_priority_protects_its_class :: proc(t: ^testing.T) {
+	// The differentiator (FORGE #4), flow level: the dial decides WHO SUFFERS
+	// when the link contends. Standard spine (15 u/s): neutral caps
+	// {3,10,2} — the email flood eats Standard and streaming never rides;
+	// emphasis {4,1,1} -> {10,4,1} — streaming owns Express.
+	streaming := u16(1) // catalog order: email, streaming
+
+	neutral := flow_fixture(t, -1)
+	plan_n := flood_plan(neutral)
+	for tick in u64(1) ..= 40 { flow_step(neutral, tick, &plan_n) }
+	n_s := neutral.flow.sla[streaming]
+	n_e := neutral.flow.sla[0] // email is class 0 in the catalog
+
+	prio := flow_fixture(t, i32(streaming))
+	plan_p := flood_plan(prio)
+	for tick in u64(1) ..= 40 { flow_step(prio, tick, &plan_p) }
+	p_s := prio.flow.sla[streaming]
+	p_e := prio.flow.sla[0]
+
+	// neutral: streaming drowns in the email flood (a handful slip through the
+	// drop-depth churn; demand is 5/tick = 200 over the window)
+	if n_s.delivered >= 40 { tfailf(t, "neutral: streaming should drown, got %d deliveries", n_s.delivered) }
+	if p_s.delivered == 0 { tfail(t, "prioritized streaming must flow") }
+	if p_s.delivered <= n_s.delivered {
+		tfailf(t, "the dial must rescue its class: prio %d vs neutral %d", p_s.delivered, n_s.delivered)
+	}
+	// the demoted class does WORSE with the dial on (it owns the small lane)
+	if p_e.delivered >= n_e.delivered {
+		tfailf(t, "demoted email should deliver less under priority: %d vs %d", p_e.delivered, n_e.delivered)
+	}
+	// no-starvation (E7): Best-effort still slips through the gaps
+	if p_e.delivered == 0 { tfail(t, "E7: Best-effort must not starve") }
+}
+
+@(test)
+test_unroutable_demand_accrues_visibly :: proc(t: ^testing.T) {
+	// E28: no pipes -> nothing spawns; demand accrues as SLA loss (feeds the
+	// health drain) with an Unreachable drop event, never a phantom packet.
+	state := test_boot_state(t)
+	plan := scripted_plan_pressure(state.catalogs, 1, context.temp_allocator)
+	report := flow_step(state, 1, &plan)
+	if report.spawned != 0 { tfailf(t, "no pipes must spawn nothing, got %d", report.spawned) }
+	if report.unmet == 0 { tfail(t, "unroutable demand must be visible") }
+	email, _ := class_index(state.catalogs, "email")
+	if state.flow.sla[email].dropped == 0 { tfail(t, "unroutable accrues as SLA loss") }
+	found := false
+	for e in state.events {
+		if d, ok := e.kind.(Ev_Packet_Dropped); ok && d.reason == .Unreachable { found = true }
+	}
+	if !found { tfail(t, "Unreachable drop event expected") }
+}
+
+@(test)
+test_severance_reroute_or_drop :: proc(t: ^testing.T) {
+	// E1: demolishing an in-flight pipe reroutes via an alternative path, or
+	// drops with Severance when none exists.
+	state := test_boot_state(t)
+	cat := state.catalogs
+	wide, _ := tier_index(cat, "wide")
+	host := node_id_by_role(state, .Content_Host, 0)
+	router := first_junction(state)
+	h1 := node_id_by_role(state, .Residential, 0)
+	h2 := node_id_by_role(state, .Residential, 1)
+	// direct leg + an alternative path via a second junction
+	submit_c(state, Command{kind = Cmd_Draw_Pipe{a = host, b = router, tier = wide}}, 0)
+	direct, _ := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Draw_Pipe{a = router, b = h1, tier = wide}}, cat, state.inventory, 0)
+	rt, _ := node_type_index(cat, "router_mid")
+	j2 := spawn_node(&state.topology, rt, {12, 19}, 0, cat)
+	submit_c(state, Command{kind = Cmd_Draw_Pipe{a = router, b = j2, tier = wide}}, 0)
+	submit_c(state, Command{kind = Cmd_Draw_Pipe{a = j2, b = h1, tier = wide}}, 0)
+	submit_c(state, Command{kind = Cmd_Draw_Pipe{a = h2, b = router, tier = wide}}, 0)
+	// run traffic until the direct leg is in use, then demolish it
+	plan := scripted_plan_pressure(cat, 0, context.temp_allocator)
+	for tick in u64(1) ..= 20 { flow_step(state, tick, &plan) }
+	dem := Command{kind = Cmd_Demolish{target = direct.pipe, is_node = false}}
+	_, err := topology_apply_edit(&state.topology, dem, cat, state.inventory, 20)
+	if err != .None { tfailf(t, "demolish: %v", err) }
+	delivered_before := state.flow.sla[0].delivered + state.flow.sla[1].delivered
+	for tick in u64(21) ..= 60 { flow_step(state, tick, &plan) }
+	// the alternative path must carry traffic (no full severance collapse)
+	delivered_after := state.flow.sla[0].delivered + state.flow.sla[1].delivered
+	if delivered_after <= delivered_before { tfail(t, "reroute must keep deliveries flowing") }
+}
+
+submit_c :: proc(state: ^Run_State, cmd: Command, tick: u64) {
+	topology_apply_edit(&state.topology, cmd, state.catalogs, state.inventory, tick + 1)
+}
+
+@(test)
+test_full_surge_win_and_idle_loss :: proc(t: ^testing.T) {
+	// THE fun gate, as full sim runs (Perkins r1 blocker #1 — terminal states
+	// must be tested):
+	//   (a) boot-wired + autowired run SURVIVES the surge -> won
+	//   (b) idle run (no pipes) drains the meter -> Error 404 -> lost
+	cat, _ := must_catalogs()
+
+	win := new(Run_State)
+	run_init(win, 42, cat, context.allocator)
+	wired := make(map[u32]bool)
+	testkit_wire_boot(win, 0)
+	for i in 0 ..< len(win.topology.node_alive) { wired[win.topology.node_id[i]] = true }
+	saw_surge := false
+	for tick in u64(1) ..= 3100 {
+		if win.health.won || win.health.lost { break }
+		step(win, tick, {})
+		testkit_autowire(win, tick, &wired)
+		for e in win.events {
+			if c, ok := e.kind.(Ev_Crisis_Triggered); ok && c.archetype == .Surge { saw_surge = true }
+		}
+		clear(&win.events)
+		free_all(context.temp_allocator)
+	}
+	if !saw_surge { tfail(t, "the surge must fire (Crisis_Triggered{Surge})") }
+	if !win.health.won { tfailf(t, "a good build must survive the surge; won=%v lost=%v meter=%d",
+		win.health.won, win.health.lost, win.health.meter_pct) }
+
+	idle := new(Run_State)
+	run_init(idle, 42, cat, context.allocator)
+	lost_tick: u64 = 0
+	for tick in u64(1) ..= 3100 {
+		step(idle, tick, {})
+		clear(&idle.events)
+		free_all(context.temp_allocator)
+		if idle.health.lost { lost_tick = tick; break }
+	}
+	if !idle.health.lost { tfail(t, "an idle network must die (Error 404)") }
+	if lost_tick == 0 { tfail(t, "unreachable") }
+	tlogf(t, "idle loss at tick %d; surge survived with meter %d", lost_tick, win.health.meter_pct)
+}
+
+@(test)
+test_growth_is_deterministic_and_valid :: proc(t: ^testing.T) {
+	// E31: growth positions are seeded-deterministic and every spawn respects
+	// min separation + near-junction growth (outward from the router mesh).
+	cat, _ := must_catalogs()
+	a := new(Run_State)
+	run_init(a, 7, cat, context.allocator)
+	b := new(Run_State)
+	run_init(b, 7, cat, context.allocator)
+	bal := &cat.balance
+	// wire the boot network so the runs survive past the growth window (an
+	// idle run dies ~tick 250 and the E17 barrier freezes it there)
+	testkit_wire_boot(a, 0)
+	testkit_wire_boot(b, 0)
+	for tick in u64(1) ..= 2000 {
+		step(a, tick, {})
+		step(b, tick, {})
+		clear(&a.events)
+		clear(&b.events)
+		free_all(context.temp_allocator)
+	}
+	na := node_count(&a.topology)
+	if na <= 6 { tfail(t, "growth must have spawned nodes") }
+	if na != node_count(&b.topology) { tfail(t, "same seed -> same growth") }
+	for i in 0 ..< len(a.topology.node_alive) {
+		if a.topology.node_alive[i] != b.topology.node_alive[i] { tfail(t, "growth liveness diverges") }
+		if a.topology.node_pos[i] != b.topology.node_pos[i] { tfail(t, "growth position diverges") }
+	}
+	// validity at spawn: min separation from all pre-existing nodes
+	ta := &a.topology
+	for i in 0 ..< len(ta.node_alive) {
+		if !ta.node_alive[i] { continue }
+		for j in i+1 ..< len(ta.node_alive) {
+			if !ta.node_alive[j] { continue }
+			if manhattan(ta.node_pos[i], ta.node_pos[j]) < bal.growth_min_dist_tiles {
+				tfailf(t, "nodes %d and %d violate min separation", ta.node_id[i], ta.node_id[j])
+			}
+		}
+	}
+}
