-## S1 TopologyGraph — the authoritative network model (GDD § M1/M3, ADR-1).
-##
-## Owns nodes + pipes + adjacency + span budget + the LB mode of each junction.
-## apply_edit validates (snap is an Input/CommandBus concern — this graph works
-## on resolved node ids; span/self-loop/budget/era-unlock/terminal-demolish are
-## validated HERE). apply_all is validate-all-then-apply (AC-E23). Ids are
-## monotonic — never recycled within a run (AC-E11).
-##
-## Pure RefCounted — no Node (ADR-1). Integer math throughout (ADR-10).
-class_name TopologyGraph
-extends RefCounted
-
-var _nodes: Dictionary = {}            # int -> NetNode
-var _pipes: Dictionary = {}            # int -> NetPipe
-var _adjacency: Dictionary = {}        # int -> Array[int]
-var _next_node_id: int = 1             # monotonic, never recycled (AC-E11)
-var _next_pipe_id: int = 1
-
-var catalogs: GameCatalogs = null
-var economy: Economy = null
-var balance: BalanceData = null
-
-
-func _init(p_catalogs: GameCatalogs = null, p_economy: Economy = null,
-		   p_balance: BalanceData = null) -> void:
-	catalogs = p_catalogs
-	economy = p_economy
-	balance = p_balance
-
-
-# --- read accessors -----------------------------------------------------------
-
-func node_count() -> int:
-	return _nodes.size()
-
-
-func pipe_count() -> int:
-	return _pipes.size()
-
-
-func get_node(id: int) -> NetNode:
-	return _nodes.get(id)
-
-
-func get_pipe(id: int) -> NetPipe:
-	return _pipes.get(id)
-
-
-func all_node_ids() -> Array:
-	return _nodes.keys()
-
-
-func neighbors(node_id: int) -> Array:
-	return _adjacency.get(node_id, [])
-
-
-func has_edge(a: int, b: int) -> bool:
-	var adj: Array = _adjacency.get(a, [])
-	return b in adj
-
-
-# --- span (integer distance, ADR-10) ------------------------------------------
-# A single rounded-Euclidean on integer inputs is bit-identical across platforms
-# (IEEE-754 sqrt is correctly-rounded; round() is deterministic). No float
-# accumulation -> honors the spirit of ADR-10 (no drift).
-static func span_between(a: Vector2i, b: Vector2i) -> int:
-	var dx: int = absi(a.x - b.x)
-	var dy: int = absi(a.y - b.y)
-	return int(round(sqrt(float(dx * dx + dy * dy))))
-
-
-# --- internal spawn (map bootstrap + growth) ----------------------------------
-
-func spawn_node(kind: int, type_id: StringName, role: int, pos: Vector2i,
-				throughput: int, tick: int) -> NetNode:
-	var n := NetNode.new()
-	n.id = _next_node_id
-	_next_node_id += 1
-	n.kind = kind
-	n.type_id = type_id
-	n.terminal_role = role
-	n.pos = pos
-	n.throughput_units = throughput
-	n.spawn_tick = tick
-	# port capacity + LB mode come from the node-type catalog (EXPERIMENT:
-	# tier-scaled router ports; LB is tier-determined per GDD M3 — basic routers
-	# round-robin, smart routers weighted. 0 ports = unlimited (terminals).
-	var nt: NodeTypeData = catalogs.node_type(type_id) if catalogs != null else null
-	n.port_capacity = nt.port_capacity if nt != null else 0
-	n.lb_weighted = nt.lb_mode_capable if nt != null else false
-	_nodes[n.id] = n
-	_adjacency[n.id] = []
-	return n
-
-
-## Spawn a node purely from its catalog type id (ADR-5 — kind/role/throughput/
-## ports all data-driven). Used by map growth (E3.2) so new content is JSON.
-func spawn_node_by_type(type_id: StringName, pos: Vector2i, tick: int) -> NetNode:
-	var nt: NodeTypeData = catalogs.node_type(type_id) if catalogs != null else null
-	if nt == null:
-		push_error("[TopologyGraph] spawn_node_by_type: unknown type %s" % type_id)
-		return null
-	return spawn_node(nt.kind, type_id, nt.terminal_role, pos, nt.throughput_units, tick)
-
-
-## Pipes incident to a node (a port is consumed per CONNECTED PIPE, so parallel
-## pipes each take a port — adjacency size is NOT the right count).
-func incident_pipe_count(node_id: int) -> int:
-	var count: int = 0
-	for p: NetPipe in _pipes.values():
-		if p.a_id == node_id or p.b_id == node_id:
-			count += 1
-	return count
-
-
-func _add_pipe_internal(a_id: int, b_id: int, tier_id: StringName, tick: int) -> NetPipe:
-	var tier: PipeTierData = catalogs.pipe_tier(tier_id) if catalogs != null else null
-	var p := NetPipe.new()
-	p.id = _next_pipe_id
-	_next_pipe_id += 1
-	p.a_id = a_id
-	p.b_id = b_id
-	p.tier_id = tier_id
-	p.capacity_units = tier.capacity_units if tier != null else 0
-	p.span_tiles = span_between(_nodes[a_id].pos, _nodes[b_id].pos)
-	p.lane_weights = balance.default_lane_weights if balance != null else CoreConst.DEFAULT_LANE_WEIGHTS
-	p.lb_mode = 0
-	p.spawn_tick = tick
-	_pipes[p.id] = p
-	_add_adjacency(a_id, b_id)
-	return p
-
-
-func _add_adjacency(a: int, b: int) -> void:
-	if not (_adjacency.get(a, []) as Array).has(b):
-		(_adjacency[a] as Array).append(b)
-	if not (_adjacency.get(b, []) as Array).has(a):
-		(_adjacency[b] as Array).append(a)
-
-
-func _remove_adjacency(a: int, b: int) -> void:
-	(_adjacency[a] as Array).erase(b)
-	(_adjacency[b] as Array).erase(a)
-
-
-# --- edit validation (the contract — architecture §6.1, §10.5) ----------------
-# Returns EditResult WITHOUT mutating. apply_all runs this on every cmd first.
-
-func _validate(cmd: Command) -> EditResult:
-	match cmd.type:
-		Command.Type.DRAW_PIPE:
-			return _validate_draw(cmd)
-		Command.Type.UPGRADE_PIPE:
-			return _validate_upgrade(cmd)
-		Command.Type.DEMOLISH:
-			return _validate_demolish(cmd)
-		Command.Type.SET_LANE_WEIGHTS:
-			return _validate_set_weights(cmd)
-		Command.Type.SET_PIPE_PRIORITY:
-			return _validate_set_priority(cmd)
-		Command.Type.SET_JUNCTION_TRIAGE:
-			return _validate_set_junction_triage(cmd)
-		Command.Type.PAUSE, Command.Type.RESUME:
-			return EditResult.applied()   # flow-control, always valid
-	return EditResult.rejected(&"unknown_command")
-
-
-func _validate_draw(cmd: Command) -> EditResult:
-	var draw: Command.DrawPipeCmd = cmd as Command.DrawPipeCmd
-	if draw.a_id == draw.b_id:
-		return EditResult.rejected(&"self_loop")            # AC-E3
-	var a: NetNode = _nodes.get(draw.a_id)
-	var b: NetNode = _nodes.get(draw.b_id)
-	if a == null or b == null:
-		return EditResult.rejected(&"missing_node")
-	# "Play the internet" topology (Finding 47 fix, prototype iterate-1): the game
-	# models end devices -> infrastructure -> end devices. Terminals connect ONLY
-	# to junctions (never terminal-to-terminal); junctions connect to terminals
-	# and other junctions. Enforced at the GRAPH (the source of truth), so BFS
-	# routing naturally goes house -> router -> house (email P2P is authentic).
-	if a.is_terminal() and b.is_terminal():
-		return EditResult.rejected(&"terminal_to_terminal")
-	var tier: PipeTierData = catalogs.pipe_tier(draw.tier_id) if catalogs != null else null
-	if tier == null:
-		return EditResult.rejected(&"unknown_tier")
-	# Port limits (EXPERIMENT, prototype iterate-1): a junction with a finite
-	# port count consumes one port PER CONNECTED PIPE (parallel pipes each count).
-	if not _ports_available(a):
-		return EditResult.rejected(&"router_ports_full")
-	if not _ports_available(b):
-		return EditResult.rejected(&"router_ports_full")
-	var span: int = span_between(a.pos, b.pos)
-	if span > tier.max_span:
-		return EditResult.rejected(&"span_exceeds_tier")    # E1.1 span-limit
-	var cost: int = Economy.draw_cost(span, tier.cost_per_tile)
-	if economy != null and not economy.can_afford(cost):
-		return EditResult.rejected(&"over_budget")          # E1.2 / S7
-	return EditResult.applied()
-
-
-## Port check: 0 = unlimited (terminals); otherwise incident pipes < capacity.
-func _ports_available(n: NetNode) -> bool:
-	if n.port_capacity <= 0:
-		return true
-	return incident_pipe_count(n.id) < n.port_capacity
-
-
-func _validate_upgrade(cmd: Command) -> EditResult:
-	var up: Command.UpgradePipeCmd = cmd as Command.UpgradePipeCmd
-	var p: NetPipe = _pipes.get(up.pipe_id)
-	if p == null:
-		return EditResult.rejected(&"missing_pipe")
-	var tier: PipeTierData = catalogs.pipe_tier(up.to_tier_id) if catalogs != null else null
-	if tier == null:
-		return EditResult.rejected(&"unknown_tier")
-	# upgrade cost = delta of capacity cost proxy (tier.cost_per_tile × current span)
-	var cost: int = Economy.draw_cost(p.span_tiles, tier.cost_per_tile)
-	if economy != null and not economy.can_afford(cost):
-		return EditResult.rejected(&"over_budget")
-	return EditResult.applied()
-
-
-func _validate_demolish(cmd: Command) -> EditResult:
-	var dem: Command.DemolishCmd = cmd as Command.DemolishCmd
-	if dem.is_node:
-		var n: NetNode = _nodes.get(dem.target_id)
-		if n == null:
-			return EditResult.rejected(&"missing_node")
-		if n.is_terminal():
-			return EditResult.rejected(&"terminal_forbidden")   # AC-E2
-		# junction: ensure no pipes still attached (or we cascade-remove them)
-		return EditResult.applied()
-	else:
-		if not _pipes.has(dem.target_id):
-			return EditResult.rejected(&"missing_pipe")
