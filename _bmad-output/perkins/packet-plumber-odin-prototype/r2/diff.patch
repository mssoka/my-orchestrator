--- /dev/null
+++ b/core/catalogs_testkit.odin
@@ -0,0 +1,20 @@
+package core
+
+// catalogs_testkit.odin — shared test/harness fixture: the REAL catalogs,
+// #load-embedded (compile-time; the core itself never touches the filesystem).
+// Tests and the harness run against the exact shipping data (ODN-5).
+
+test_catalog_sources :: proc(src: ^Catalog_Sources) {
+	src.packet_types = #load("../data/packet_types.json")
+	src.pipe_tiers   = #load("../data/pipe_tiers.json")
+	src.node_types   = #load("../data/node_types.json")
+	src.demand       = #load("../data/demand.json")
+	src.crises       = #load("../data/crises.json")
+	src.balance      = #load("../data/balance.json")
+}
+
+must_catalogs :: proc() -> (^Catalogs, Catalog_Error) {
+	src: Catalog_Sources
+	test_catalog_sources(&src)
+	return catalogs_load(&src)
+}
diff --git a/core/command.odin b/core/command.odin
new file mode 100644
index 0000000..ba2dffc
--- /dev/null
+++ b/core/command.odin
@@ -0,0 +1,75 @@
+package core
+
+// command.odin — validated Commands (ODN-12). Raw input becomes an Intent in
+// the app; the Command_Bus resolves it (snap-to-node, preview) into a Command;
+// the core's topology_apply_edit is the single validation authority. The
+// action log stores post-validation, post-snap commands (ODN-11), so replay
+// can never drift from live play on legality.
+
+Command :: struct {
+	// apply_tick is the tick the command is applied at in replay. Live edits
+	// land IMMEDIATELY via the edit fast-path (ODN-2) and are logged with
+	// apply_tick = next tick; replay applies all entries with apply_tick == N
+	// before stepping N — live and replay see identical state at every step
+	// boundary. THE CONVENTION IS PINNED by replay_test.odin (Perkins r1 on
+	// the Godot prototype: an undocumented +1 convention diverged replays).
+	apply_tick: u64,
+	kind:       Command_Kind,
+}
+
+Command_Kind :: union {
+	Cmd_Draw_Pipe,
+	Cmd_Upgrade_Pipe,
+	Cmd_Demolish,
+	Cmd_Set_Lane_Weights,
+	Cmd_Set_Pipe_Priority,
+	Cmd_Set_Junction_Triage,
+	Cmd_Place_Router,
+}
+
+Cmd_Draw_Pipe :: struct {
+	a, b: u32,      // node ids (resolved, post-snap)
+	tier: u16,      // pipe_tiers catalog index
+}
+
+Cmd_Upgrade_Pipe :: struct {
+	pipe:    u32,
+	to_tier: u16,
+}
+
+// is_node: demolishing a junction severs ALL incident pipes first (in pipe-id
+// order — deterministic, E27), each per E1 (reroute-or-drop), then removes the
+// vertex. Perkins r1 on the Godot prototype: one-pipe-per-neighbor cascades
+// left ghost pipes when parallel pipes shared a neighbor — the Odin cascade
+// collects by incidence, not by neighbor.
+Cmd_Demolish :: struct {
+	target:  u32,
+	is_node: bool,
+}
+
+Cmd_Set_Lane_Weights :: struct {
+	pipe:    u32,
+	weights: [3]i32,
+}
+
+// The PROTO QoS surface (GDD § M2 'priority emphasis' dial): "" = neutral
+// (all classes ride Standard), else the named class rides Express and the
+// others ride Best on this pipe.
+Cmd_Set_Pipe_Priority :: struct {
+	pipe:         u32,
+	priority:     i32, // class index, or -1 for neutral
+}
+
+// Junction triage (E2.3): which class wins contention THROUGH this junction.
+Cmd_Set_Junction_Triage :: struct {
+	junction: u32,
+	triage:   i32, // class index, or -1 for neutral
+}
+
+// Router placement (the Mini-Motorways-style inventory ruling): routers are
+// PLAYER-placed from the tray, never director-spawned. Consuming one router
+// of the tier from inventory; placement must clear the separation rule.
+Cmd_Place_Router :: struct {
+	type_idx: u16,    // node_types catalog index (must be a router kind)
+	pos:      [2]i32, // tile coords
+}
diff --git a/core/crisis.odin b/core/crisis.odin
new file mode 100644
index 0000000..645eb68
--- /dev/null
+++ b/core/crisis.odin
@@ -0,0 +1,87 @@
+package core
+
+// crisis.odin — S4 Crisis Engine (ODN-4, architecture §6.4; PROTO ships the
+// Surge archetype only). DOWNSTREAM of the flow: reads topology + flow state,
+// produces warnings + crisis events. Never owns the demand timeline (that's
+// the Director, upstream — a crisis is a consequence, never its own cause,
+// REVIEW M1). Fairness is structural here: node health derives from MEASURED
+// load (never a phantom), the surge is forecast by the catalog timeline, and
+// every Crisis_Triggered carries a structured root_cause + the preventive
+// redesign lives in crises.json.
+//
+// Dedup (E13): one active crisis per root cause across the whole activation —
+// the surge fires once, resolves once; warnings fire on transitions only.
+
+Crisis_State :: struct {
+	node_health:  [dynamic]Health_State, // per node slot
+	surge_active: bool,
+}
+
+crisis_ensure :: proc(c: ^Crisis_State, t: ^Topology) {
+	if len(c.node_health) < len(t.node_alive) {
+		n := len(t.node_alive) - len(c.node_health)
+		for _ in 0 ..< n { append(&c.node_health, Health_State.Healthy) }
+	}
+}
+
+crisis_evaluate :: proc(state: ^Run_State, tick: u64, plan: ^Pressure_Plan) {
+	c := &state.crisis
+	t := &state.topology
+	f := &state.flow
+	cat := state.catalogs
+	bal := &cat.balance
+	crisis_ensure(c, t)
+
+	// Node health from this tick's measured load (the warning surface; the
+	// strain/critical thresholds are catalog values). 🔴 is always traceable
+	// to a measured load — never a phantom.
+	for i in 0 ..< len(t.node_alive) {
+		if !t.node_alive[i] {
+			c.node_health[i] = .Healthy
+			continue
+		}
+		level := Health_State.Healthy
+		if t.node_throughput[i] > 0 && i < len(f.node_load) {
+			pct := (f.node_load[i] * 100) / t.node_throughput[i]
+			if pct >= bal.health_critical_threshold_pct {
+				level = .Critical
+			} else if pct >= bal.health_strain_threshold_pct {
+				level = .Strained
+			}
+		}
+		prev := c.node_health[i]
+		if level != prev {
+			c.node_health[i] = level
+			if level == .Healthy {
+				emit(state, tick, Ev_Warning_Cleared{node = t.node_id[i]})
+			} else {
+				emit(state, tick, Ev_Warning_Raised{node = t.node_id[i], level = level})
+			}
+		}
+	}
+
+	// The forecast ("weather report") + surge lifecycle, from the catalog
+	// timeline the Director owns. Dedup via the Director_State flags.
+	d := &state.director
+	for i in 0 ..< len(cat.demand.set_pieces) {
+		if i >= len(d.forecasted) { break }
+		sp := &cat.demand.set_pieces[i]
+		if !d.forecasted[i] && set_piece_forecasted(sp, tick) {
+			d.forecasted[i] = true
+			emit(state, tick, Ev_Forecast_Issued{set_piece = u16(i)})
+		}
+		if !d.triggered[i] && set_piece_active(sp, tick) {
+			d.triggered[i] = true
+			c.surge_active = true
+			// Fairness contract: the structured root cause + preventive
+			// redesign (crises.json carries the copy).
+			rc := Root_Cause{pattern = .No_Spare_Capacity_For_Forecast_Spike, node = 0}
+			emit(state, tick, Ev_Crisis_Triggered{archetype = .Surge, set_piece = u16(i), root_cause = rc})
+		}
+		if d.triggered[i] && !d.resolved[i] && tick >= sp.start_tick + sp.duration_ticks {
+			d.resolved[i] = true
+			c.surge_active = false
+			emit(state, tick, Ev_Crisis_Resolved{archetype = .Surge, set_piece = u16(i)})
+		}
+	}
+}
diff --git a/core/demand.odin b/core/demand.odin
new file mode 100644
index 0000000..7c7301f
--- /dev/null
+++ b/core/demand.odin
@@ -0,0 +1,166 @@
+package core
+
+// demand.odin — the scripted CrisisDirector (ODN-7, architecture §6.4). The
+// Director owns the demand timeline + map growth UPSTREAM of the flow; the
+// Crisis Engine evaluates DOWNSTREAM; the Director must never read crisis
+// state (REVIEW M1) — here that rule is structural: plan_pressure receives no
+// handle to Run_State.
+//
+// plan_pressure is pure w.r.t. sim state in PROTO: a function of
+// (era, tick, catalog) — the rng parameter exists for the seam contract
+// (ODN-7) and the scripted impl never draws from it (Perkins r1: a display-
+// path plan call must not perturb the sim's rng stream — the scripted plan
+// consumes none, ever).
+//
+// Map growth (E31): the candidate pool is drawn from the run's seeded rng ONCE
+// at bootstrap (24 positions), so growth consumes zero rng during the run and
+// the demand stream is untouched. Spawns proceed OUTWARD from the router mesh
+// (within growth_spawn_near_junction of a junction) with a minimum separation;
+// the pool is rejection-sampled deterministically, then a full row-major scan
+// fallback, then a min-dist-only scan (never strand a spawn far from the
+// network — the lesson the Godot prototype paid for).
+
+Pressure_Plan :: struct {
+	tick:       u64,
+	entries:    []Demand_Entry,   // base demand (slice into the catalog — read-only)
+	set_pieces: [dynamic]u16,     // active set-piece indices this tick
+}
+
+effective_volume :: proc(plan: ^Pressure_Plan, class: u16, base: i32, cat: ^Catalogs) -> i32 {
+	v := base
+	for sp_idx in plan.set_pieces {
+		sp := cat.demand.set_pieces[sp_idx]
+		if sp.class == class && set_piece_active(&sp, plan.tick) {
+			v *= sp.multiplier
+		}
+	}
+	return v
+}
+
+Director_State :: struct {
+	growth_pool:     [dynamic][2]i32,
+	growth_pool_idx: int,
+	growth_next:     u64,
+	growth_done:     int,
+	forecasted:      [dynamic]bool, // per set-piece: forecast event already issued
+	triggered:       [dynamic]bool, // per set-piece: crisis event fired
+	resolved:        [dynamic]bool,
+}
+
+director_init_growth :: proc(d: ^Director_State, rng: ^Rng, bal: ^Balance, allocator := context.allocator) {
+	context.allocator = allocator
+	clear(&d.growth_pool)
+	for _ in 0 ..< bal.growth_pool_size {
+		x := rng_range(rng, bal.growth_box[0], bal.growth_box[1])
+		y := rng_range(rng, bal.growth_box[2], bal.growth_box[3])
+		append(&d.growth_pool, [2]i32{x, y})
+	}
+	d.growth_pool_idx = 0
+	d.growth_next = u64(bal.growth_first_tick)
+	d.growth_done = 0
+}
+
+scripted_plan_pressure :: proc(cat: ^Catalogs, tick: u64, scratch := context.temp_allocator) -> Pressure_Plan {
+	plan: Pressure_Plan
+	plan.tick = tick
+	plan.entries = cat.demand.entries[:]
+	plan.set_pieces = make([dynamic]u16, scratch)
+	for sp, i in cat.demand.set_pieces {
+		s := sp
+		if set_piece_active(&s, tick) {
+			append(&plan.set_pieces, u16(i))
+		}
+	}
+	return plan
+}
+
+// Growth due this tick (0 or 1 spawn), deterministic given (seed, tick,
+// topology). Returns (type_idx, pos, ok). Emits nothing — Run_State applies
+// the spawn and emits Ev_Node_Spawned.
+director_plan_growth :: proc(d: ^Director_State, t: ^Topology, cat: ^Catalogs, tick: u64) -> (u16, [2]i32, bool) {
+	bal := &cat.balance
+	if len(bal.growth_roles) == 0 { return 0, {}, false }
+	if d.growth_done >= len(bal.growth_roles) { return 0, {}, false }
+	if tick < d.growth_next { return 0, {}, false }
+	role := bal.growth_roles[d.growth_done]
+	type_idx, ok := node_type_index(cat, role)
+	if !ok { return 0, {}, false }
+	pos, found := next_growth_pos(d, t, bal)
+	if !found {
+		// stall throttle: retry after the interval, never full-scan every tick
+		d.growth_next = tick + u64(max(1, bal.growth_interval_ticks))
+		return 0, {}, false
+	}
+	d.growth_done += 1
+	interval := bal.growth_interval_ticks
+	if d.growth_done >= (len(bal.growth_roles)+1)/2 {
+		interval = bal.growth_interval_short_ticks
+	}
+	d.growth_next = tick + u64(max(1, interval))
+	return type_idx, pos, true
+}
+
+manhattan :: proc(a, b: [2]i32) -> i32 {
+	return abs(a[0]-b[0]) + abs(a[1]-b[1])
+}
+
+min_dist_ok :: proc(t: ^Topology, cand: [2]i32, min_d: i32) -> bool {
+	for i in 0 ..< len(t.node_alive) {
+		if !t.node_alive[i] { continue }
+		if manhattan(t.node_pos[i], cand) < min_d { return false }
+	}
+	return true
+}
+
+pos_free :: proc(t: ^Topology, cand: [2]i32, bal: ^Balance) -> bool {
+	near_junction := false
+	for i in 0 ..< len(t.node_alive) {
+		if !t.node_alive[i] { continue }
+		d := manhattan(t.node_pos[i], cand)
+		if d < bal.growth_min_dist_tiles { return false }
+		if t.node_kind[i] == .Junction && d <= bal.growth_spawn_near_junction {
+			near_junction = true
+		}
+	}
+	return near_junction
+}
+
+next_growth_pos :: proc(d: ^Director_State, t: ^Topology, bal: ^Balance) -> ([2]i32, bool) {
+	pool := len(d.growth_pool)
+	if pool > 0 {
+		for i in 0 ..< pool {
+			cand := d.growth_pool[(d.growth_pool_idx+i)%pool]
+			if pos_free(t, cand, bal) {
+				d.growth_pool_idx = (d.growth_pool_idx + i + 1) % pool
+				return cand, true
+			}
+		}
+	}
+	// Fallback: exhaustive deterministic row-major scan, full check.
+	for y in bal.growth_box[2] ..= bal.growth_box[3] {
+		for x in bal.growth_box[0] ..= bal.growth_box[1] {
+			cand := [2]i32{x, y}
+			if pos_free(t, cand, bal) { return cand, true }
+		}
+	}
+	// Last resort: anchored at each junction, scanning outward for the nearest
+	// cell that respects min separation — a spawn is ALWAYS reachable from the
+	// mesh (E31; never the min-dist-only-anywhere scan that stranded a house
+	// 20+ tiles from every router in the Godot prototype).
+	for i in 0 ..< len(t.node_alive) {
+		if !t.node_alive[i] || t.node_kind[i] != .Junction { continue }
+		base := t.node_pos[i]
+		for radius in bal.growth_min_dist_tiles ..= bal.growth_spawn_near_junction {
+			for dy in -radius ..= radius {
+				for dx in -radius ..= radius {
+					if abs(dx) + abs(dy) != radius { continue } // ring only
+					cand := [2]i32{base[0] + dx, base[1] + dy}
+					if cand[0] < bal.growth_box[0] || cand[0] > bal.growth_box[1] ||
+					   cand[1] < bal.growth_box[2] || cand[1] > bal.growth_box[3] { continue }
+					if min_dist_ok(t, cand, bal.growth_min_dist_tiles) { return cand, true }
+				}
+			}
+		}
+	}
+	return {}, false
+}
diff --git a/core/determinism_test.odin b/core/determinism_test.odin
new file mode 100644
index 0000000..3df11d8
--- /dev/null
+++ b/core/determinism_test.odin
@@ -0,0 +1,144 @@
+package core
+
+// determinism_test.odin — THE determinism spine (ODN-1/9/10; the briefing's
+// ONE hard blocker). Closes the three Perkins r1 gaps from the Godot
+// prototype:
+//   (a) the fingerprint covers ALL in-flight packet state + latency + rng
+//       (see serialize.odin),
+//   (b) replay-equality runs on a REAL, packet-rich, command-built topology,
+//   (c) the command-application convention is pinned: live edits land
+//       immediately (fast-path) and are logged with apply_tick = next tick;
+//       replay applies entries with apply_tick == N BEFORE stepping N.
+
+import "core:testing"
+
+// Step a run from tick 1..ticks, autowiring growth like the demo autopilot,
+// recording the per-tick state hash. Drains events per tick into the hash.
+record_run :: proc(state: ^Run_State, ticks: u64, replay: bool, allocator := context.allocator) -> [dynamic]u64 {
+	hashes := make([dynamic]u64, 0, ticks, allocator)
+	wired := make(map[u32]bool, allocator)
+	if !replay {
+		// live path: edits apply immediately at tick 0 (fast-path), logged
+		// with apply_tick = 1 (the pinned convention)
+		testkit_wire_boot(state, 0)
+		for i in 0 ..< len(state.topology.node_alive) {
+			wired[state.topology.node_id[i]] = true
+		}
+	}
+	for tick in u64(1) ..= ticks {
+		before := len(state.events)
+		if replay {
+			// replay: apply all log entries with apply_tick == tick before the step
+			cmds := make([dynamic]Command, context.temp_allocator)
+			for cmd in state.action_log {
+				if cmd.apply_tick == tick { append(&cmds, cmd) }
+			}
+			step(state, tick, cmds[:])
+		} else {
+			step(state, tick, {})
+		}
+		// hash at the step boundary — BEFORE any new fast-path edits (they
+		// carry apply_tick = tick+1 and belong to the next boundary)
+		h := state_hash(state, state.events[before:], context.temp_allocator)
+		append(&hashes, h)
+		if !replay {
+			testkit_autowire(state, tick, &wired)
+		}
+		clear(&state.events)
+		free_all(context.temp_allocator)
+	}
+	return hashes
+}
+
+@(test)
+test_replay_byte_identical_on_real_topology :: proc(t: ^testing.T) {
+	cat, err := must_catalogs()
+	if err.file != "" { tfailf(t, "catalogs: %s", err.file) }
+
+	live := new(Run_State)
+	run_init(live, 42, cat, context.allocator)
+	live_hashes := record_run(live, 600, false)
+
+	// the keystone must be packet-rich (Perkins r1: the Godot keystone ran on
+	// a no-pipes topology — guard against that here)
+	if pipe_count(&live.topology) < 5 { tfailf(t, "keystone topology too thin: %d pipes", pipe_count(&live.topology)) }
+	if live.delivered_total == 0 { tfail(t, "keystone must have deliveries") }
+	if len(live.action_log) == 0 { tfail(t, "keystone must be command-built") }
+
+	replayed := new(Run_State)
+	run_init(replayed, 42, cat, context.allocator)
+	replayed.action_log = live.action_log // the ODN-11 artifact
+	replay_hashes := record_run(replayed, 600, true)
+	if replayed.replay_error { tfail(t, "replay hit a validation error (ODN-11 critical)") }
+
+	if len(live_hashes) != len(replay_hashes) { tfail(t, "tick count mismatch") }
+	for i in 0 ..< len(live_hashes) {
+		if live_hashes[i] != replay_hashes[i] {
+			tfailf(t, "REPLAY DIVERGENCE at tick %d: %x != %x", i+1, live_hashes[i], replay_hashes[i])
+		}
+	}
+}
+
+@(test)
+test_seed_reproduces :: proc(t: ^testing.T) {
+	cat, _ := must_catalogs()
+	a := new(Run_State)
+	run_init(a, 99, cat, context.allocator)
+	ha := record_run(a, 300, false)
+	b := new(Run_State)
+	run_init(b, 99, cat, context.allocator)
+	hb := record_run(b, 300, false)
+	for i in 0 ..< len(ha) {
+		if ha[i] != hb[i] { tfailf(t, "same seed diverged at tick %d", i+1) }
+	}
+	c := new(Run_State)
+	run_init(c, 100, cat, context.allocator)
+	hc := record_run(c, 300, false)
+	same := true
+	for i in 0 ..< len(ha) {
+		if ha[i] != hc[i] { same = false; break }
+	}
+	if same { tfail(t, "different seeds must diverge") }
+}
+
+@(test)
+test_action_log_binary_roundtrip :: proc(t: ^testing.T) {
+	// ODN-11: the log survives the binary round-trip byte-for-byte-semantics;
+	// corrupt inputs get the defined rejection, never a crash.
+	cat, _ := must_catalogs()
+	state := new(Run_State)
+	run_init(state, 42, cat, context.allocator)
+	testkit_wire_boot(state, 0)
+	bytes := log_write(state, context.temp_allocator)
+	header, cmds, ok := log_read(bytes, context.temp_allocator)
+	if !ok { tfail(t, "round-trip must parse") }
+	if header.seed != 42 || header.era != 3 || header.logic_hz != cat.balance.logic_hz {
+		tfail(t, "header mismatch")
+	}
+	if header.catalog_hash != cat.hash { tfail(t, "catalog hash mismatch") }
+	if len(cmds) != len(state.action_log) { tfail(t, "command count mismatch") }
+	for i in 0 ..< len(cmds) {
+		a, b := state.action_log[i], cmds[i]
+		if a.apply_tick != b.apply_tick { tfailf(t, "cmd %d apply_tick", i) }
+		ka, kb := a.kind, b.kind
+		#partial switch ca in ka {
+		case Cmd_Draw_Pipe:
+			cb := kb.(Cmd_Draw_Pipe)
+			if ca != cb { tfailf(t, "cmd %d draw mismatch", i) }
+		case Cmd_Set_Pipe_Priority:
+			cb := kb.(Cmd_Set_Pipe_Priority)
+			if ca != cb { tfailf(t, "cmd %d priority mismatch", i) }
+		}
+	}
+	// defined rejections
+	if _, _, ok2 := log_read(bytes[:len(bytes)-1], context.temp_allocator); ok2 {
+		tfail(t, "truncated log must reject")
+	}
+	if _, _, ok3 := log_read(bytes[:8], context.temp_allocator); ok3 {
+		tfail(t, "header-only log must reject")
+	}
+	garbage := make([]u8, 64, context.temp_allocator)
+	if _, _, ok4 := log_read(garbage, context.temp_allocator); ok4 {
+		tfail(t, "garbage must reject")
+	}
+}
diff --git a/core/events.odin b/core/events.odin
new file mode 100644
index 0000000..1ea104a
--- /dev/null
+++ b/core/events.odin
@@ -0,0 +1,61 @@
+package core
+
+// events.odin — the per-tick event buffer (ODN-14). Cross-layer communication
+// is a tagged-union array on Run_State, appended during core.step and drained
+// by the app once per frame in append order. Every event carries its tick —
+// the harness's assertion language and event-stream goldens depend on it.
+//
+// Ordering is program order; there are no callbacks, no bus, no globals.
+
+Event :: struct {
+	tick: u64,
+	kind: Event_Kind,
+}
+
+Event_Kind :: union {
+	Ev_Packet_Arrived,
+	Ev_Packet_Dropped,
+	Ev_Node_Spawned,
+	Ev_Forecast_Issued,
+	Ev_Warning_Raised,
+	Ev_Warning_Cleared,
+	Ev_Crisis_Triggered,
+	Ev_Crisis_Resolved,
+	Ev_Grace_Started,
+	Ev_Grace_Expired,
+	Ev_Meter_Changed,
+	Ev_Run_Won,
+	Ev_Run_Lost,
+	Ev_Stock_Arrived,
+}
+
+Ev_Packet_Arrived :: struct { class: u16 }
+Ev_Packet_Dropped :: struct { class: u16, reason: Drop_Reason }
+Ev_Node_Spawned :: struct { node: u32, type_idx: u16 }
+// hardware delivery landed in the tray (inventory grant; totals this delivery)
+Ev_Stock_Arrived :: struct { links: i32, routers: i32 }
+Ev_Forecast_Issued :: struct { set_piece: u16 } // demand-catalog set-piece index
+Ev_Warning_Raised :: struct { node: u32, level: Health_State } // Strained|Critical
+Ev_Warning_Cleared :: struct { node: u32 }
+Ev_Crisis_Triggered :: struct { archetype: Crisis_Archetype, set_piece: u16, root_cause: Root_Cause }
+Ev_Crisis_Resolved :: struct { archetype: Crisis_Archetype, set_piece: u16 }
+Ev_Grace_Started :: struct {}
+Ev_Grace_Expired :: struct {}
+Ev_Meter_Changed :: struct { pct: i32 }
+Ev_Run_Won :: struct { surge_uptime_pct: i32 }
+Ev_Run_Lost :: struct {}
+
+Crisis_Archetype :: enum u8 { Surge = 0 }
+
+// The fairness contract made structured (FORGE #3): every crisis carries the
+// topology flaw that caused it + the redesign that would have prevented it.
+Root_Cause :: struct {
+	pattern: Root_Cause_Pattern,
+	node:    u32, // the strained locus when known; 0 = map-wide
+}
+
+Root_Cause_Pattern :: enum u8 { No_Spare_Capacity_For_Forecast_Spike = 0 }
+
+emit :: proc(state: ^Run_State, tick: u64, kind: Event_Kind) {
+	append(&state.events, Event{tick = tick, kind = kind})
+}
diff --git a/core/flow.odin b/core/flow.odin
new file mode 100644
index 0000000..d2c16c7
--- /dev/null
+++ b/core/flow.odin
@@ -0,0 +1,575 @@
+package core
+
+// flow.odin — S2 Packet-Flow Simulation (architecture §6.2): the deterministic
+// tick loop. Spawn from the demand plan (seeded weighted picks) -> route (BFS,
+// round-robin / capacity-weighted at parallel pipes) -> traverse (bandwidth-
+// shared per pipe, QoS lane caps) -> deliver at the sink or drop (contention /
+// severance) -> accumulate per-class SLA. QoS procs (qos.odin) and SLA
+// accumulators live INSIDE the flow (ODN-3 — no peer systems).
+//
+// Integer-only (ODN-10); arrays only (no map iteration); every random choice
+// draws state.rng. Cosmetic packet positions are integer Q8 edge-fractions
+// (vis_q8) — deterministic, and excluded from nothing: they ride the T1 hash
+// too (Perkins r1: the Godot fingerprint omitted in-flight packet state; the
+// Odin fingerprint covers ALL of it — see serialize.odin).
+
+MAX_ROUTE :: 32          // max pipes along a packet's path (nodes <= 64 in PROTO)
+ROLLING_MAX :: 128       // balance.rolling_window_ticks must be <= this
+
+Packet :: struct {
+	id:                 u64,
+	class:              u16,
+	src, dst:           u32,              // node ids
+	route:              [MAX_ROUTE]u32,   // pipe ids along the chosen path
+	route_len:          u8,
+	edge_idx:           u8,
+	progress_units:     i32,              // bandwidth units traversed on the current edge
+	lane:               Lane,             // the class's catalog default (informational)
+	spawn_tick:         u64,
+	bandwidth_demand:   i32,              // cached from the catalog at spawn
+	accrued_latency_ms: i32,              // integer ms (sub-tick resolution, m16)
+	vis_q8:             i32,  // Q8 edge-fractions along the route (cosmetic, deterministic)
+	done:               bool, // scratch: arrived (delivered/dropped) this tick
+	delivered_marker:   bool,
+	drop_reason:        Drop_Reason,
+}
+
+Sla_Accumulator :: struct {
+	delivered:        u64,
+	dropped:          u64,
+	total_latency_ms: u64,
+	demand_seen:      u64,
+}
+
+Flow_Report :: struct {
+	spawned:   i32,
+	delivered: i32,
+	dropped:   i32,
+	unmet:     i32,
+}
+
+Flow_State :: struct {
+	packets:        [dynamic]Packet,
+	next_packet_id: u64,
+	sla:            [dynamic]Sla_Accumulator, // per class
+	ms_per_tick:    i32,
+	// round-robin cursors per unordered node pair (parallel arrays; lookup by
+	// linear scan — pairs are few; insertion order is the iteration order)
+	rr_a, rr_b:     [dynamic]u32,
+	rr_cursor:      [dynamic]u32,
+	// rolling recent-uptime window per class (forgives the build phase)
+	roll_del:       [dynamic][ROLLING_MAX]i32,
+	roll_drop:      [dynamic][ROLLING_MAX]i32,
+	roll_ds:        [dynamic]i32,
+	roll_dps:       [dynamic]i32,
+	roll_idx:       i32,
+	roll_window:    i32, // the catalog's rolling_window_ticks (<= ROLLING_MAX)
+	tick_del:       [dynamic]i32, // per class, this tick
+	tick_drop:      [dynamic]i32,
+	// per-node-slot per-tick surfaces (the warning surface + inspect panel)
+	node_load:      [dynamic]i32, // per node slot
+	node_flow:      [dynamic]i32, // node_slot * MAX_CLASSES + class
+	// BFS scratch (resized as the topology grows)
+	bfs_prev:       []i32,
+	bfs_queue:      []u32,
+	// per-tick scratch (persistent — no per-tick allocator churn)
+	sc_src_ids:     [dynamic]u32,
+	sc_src_w:       [dynamic]i32,
+	sc_dst_ids:     [dynamic]u32,
+	sc_dst_w:       [dynamic]i32,
+	sc_survivors:   [dynamic]Packet,
+}
+
+flow_init :: proc(f: ^Flow_State, cat: ^Catalogs, allocator := context.allocator) {
+	context.allocator = allocator
+	f.next_packet_id = 1
+	f.ms_per_tick = 1000 / cat.balance.logic_hz // logic_hz is the single source (Perkins r1)
+	f.roll_window = cat.balance.rolling_window_ticks
+	for _ in cat.packet_types {
+		append(&f.sla, Sla_Accumulator{})
+		append(&f.roll_del, [ROLLING_MAX]i32{})
+		append(&f.roll_drop, [ROLLING_MAX]i32{})
+		append(&f.roll_ds, 0)
+		append(&f.roll_dps, 0)
+		append(&f.tick_del, 0)
+		append(&f.tick_drop, 0)
+	}
+}
+
+flow_ensure_scratch :: proc(f: ^Flow_State, t: ^Topology) {
+	nslots := len(t.node_alive)
+	if len(f.node_load) < nslots {
+		resize(&f.node_load, nslots)
+		resize(&f.node_flow, nslots*MAX_CLASSES)
+	}
+	if len(f.bfs_prev) < nslots {
+		prev := f.bfs_prev
+		queue := f.bfs_queue
+		f.bfs_prev = make([]i32, nslots*2)
+		f.bfs_queue = make([]u32, nslots*2)
+		copy(f.bfs_prev, prev)
+		copy(f.bfs_queue, queue)
+		delete(prev)
+		delete(queue)
+	}
+}
+
+// --- demand resolution (seeded weighted picks; E28 unroutable accrues, never
+// --- spawns a phantom) --------------------------------------------------------
+
+weighted_pick :: proc(items: []u32, weights: []i32, rng: ^Rng) -> u32 {
+	if len(items) == 0 { return 0 }
+	if len(items) == 1 { return items[0] }
+	total: i64 = 0
+	for w in weights { total += i64(w) }
+	if total <= 0 {
+		return items[rng_range(rng, 0, i32(len(items))-1)]
+	}
+	r := i64(rng_range(rng, 0, i32(total)-1))
+	acc: i64 = 0
+	for item, i in items {
+		acc += i64(weights[i])
+		if r < acc { return item }
+	}
+	return items[len(items)-1]
+}
+
+// gather terminals of a role into scratch slices (insertion order)
+terminals_of :: proc(t: ^Topology, role: Terminal_Role, ids: ^[dynamic]u32, weights: ^[dynamic]i32) {
+	clear(&ids^)
+	clear(&weights^)
+	for i in 0 ..< len(t.node_alive) {
+		if !t.node_alive[i] { continue }
+		if t.node_kind[i] == .Terminal && t.node_role[i] == role {
+			append(ids, t.node_id[i])
+			append(weights, 1) // demand_weight is uniform in the PROTO roster
+		}
+	}
+}
+
+// --- routing (BFS shortest path; parallel-pipe pick per hop) ------------------
+
+rr_next :: proc(f: ^Flow_State, a, b: u32, n: int) -> int {
+	if n <= 0 { return 0 }
+	lo, hi := a, b
+	if hi < lo { lo, hi = hi, lo }
+	for i in 0 ..< len(f.rr_a) {
+		if f.rr_a[i] == lo && f.rr_b[i] == hi {
+			c := f.rr_cursor[i]
+			f.rr_cursor[i] = (c + 1) % u32(n)
+			return int(c % u32(n))
+		}
+	}
+	append(&f.rr_a, lo)
+	append(&f.rr_b, hi)
+	append(&f.rr_cursor, 1 % u32(max(1, n)))
+	return 0
+}
+
+// Pick among parallel pipes connecting a-b. LB mode is TIER-DETERMINED (GDD
+// M3): smart junctions (lb_weighted) take the highest-capacity pipe, ties
+// spread round-robin; basic = round-robin via the per-pair cursor.
+pick_pipe :: proc(f: ^Flow_State, t: ^Topology, a, b: u32, pipe_ids: []u32) -> u32 {
+	if len(pipe_ids) == 1 { return pipe_ids[0] }
+	// junction endpoint (a first, matching the reference)
+	junc_slot: u32 = 0
+	has_junc := false
+	if sa, ok := node_slot(t, a); ok && t.node_kind[sa] == .Junction {
+		junc_slot, has_junc = sa, true
+	} else if sb, ok2 := node_slot(t, b); ok2 && t.node_kind[sb] == .Junction {
+		junc_slot, has_junc = sb, true
+	}
+	candidates := pipe_ids
+	best_buf: [MAX_ROUTE]u32
+	if has_junc && t.node_lb_weighted[junc_slot] {
+		best_cap: i32 = -1
+		for pid in pipe_ids {
+			ps := t.pipe_by_id[pid]
+			best_cap = max(best_cap, t.pipe_capacity[ps])
+		}
+		n := 0
+		for pid in pipe_ids {
+			ps := t.pipe_by_id[pid]
+			if t.pipe_capacity[ps] == best_cap && n < MAX_ROUTE {
+				best_buf[n] = pid
+				n += 1
+			}
+		}
+		if n == 1 { return best_buf[0] }
+		candidates = best_buf[:n]
+	}
+	idx := rr_next(f, a, b, len(candidates))
+	return candidates[idx]
+}
+
+// BFS over adjacency (insertion-ordered) -> per-hop parallel-pipe pick.
+// Returns the pipe-id route into p.route / p.route_len (empty = unreachable).
+compute_route :: proc(f: ^Flow_State, t: ^Topology, src, dst: u32, p: ^Packet) {
+	p.route_len = 0
+	if src == dst { return }
+	nslots := len(t.node_alive)
+	for i in 0 ..< nslots { f.bfs_prev[i] = -1 }
+	src_slot, ok_src := node_slot(t, src)
+	dst_slot, ok_dst := node_slot(t, dst)
+	if !ok_src || !ok_dst { return }
+	head, tail: int = 0, 1
+	f.bfs_queue[0] = src_slot
+	f.bfs_prev[src_slot] = -2 // visited marker (src)
+	nb_buf: [64]u32
+	found := false
+	for head < tail {
+		cur := f.bfs_queue[head]
+		head += 1
+		if cur == dst_slot { found = true; break }
+		n := neighbors(t, t.node_id[cur], nb_buf[:])
+		for i in 0 ..< n {
+			ns, ok := node_slot(t, nb_buf[i])
+			if !ok { continue }
+			if f.bfs_prev[ns] == -1 {
+				f.bfs_prev[ns] = i32(cur)
+				f.bfs_queue[tail] = ns
+				tail += 1
+			}
+		}
+	}
+	if !found && f.bfs_prev[dst_slot] == -1 { return }
+	// walk back dst -> src, then reverse into pipe picks
+	path_buf: [64]u32 // node slots
+	plen := 0
+	n := dst_slot
+	for {
+		path_buf[plen] = n
+		plen += 1
+		if n == src_slot { break }
+		prev := f.bfs_prev[n]
+		if prev < 0 { plen = 0; break }
+		n = u32(prev)
+		if plen >= len(path_buf) { plen = 0; break }
+	}
+	if plen < 2 { return }
+	pair_buf: [MAX_ROUTE]u32
+	for i in 0 ..< plen-1 {
+		na := t.node_id[path_buf[plen-1-i]]
+		nb := t.node_id[path_buf[plen-2-i]]
+		cnt := pipes_between(t, na, nb, pair_buf[:])
+		if cnt == 0 { p.route_len = 0; return }
+		if i >= MAX_ROUTE { p.route_len = 0; return }
+		p.route[i] = pick_pipe(f, t, na, nb, pair_buf[:cnt])
+	}
+	p.route_len = u8(min(plen-1, MAX_ROUTE))
+}
+
+// The node a packet has reached = src walked through every COMPLETED edge.
+// Completed edges may be TOMBSTONED (an E27 cascade can kill the pipe behind
+// an in-flight packet): their endpoint data persists in the arrays, so the
+// walk follows ids regardless of liveness — the anchor is the far endpoint of
+// the last completed edge, never a teleport back to the source (Perkins r2
+// review note N4).
+current_node :: proc(p: ^Packet, t: ^Topology) -> u32 {
+	node := p.src
+	for i in 0 ..< int(p.edge_idx) {
+		ps, ok := t.pipe_by_id[p.route[i]] // id->slot persists after tombstone
+		if !ok { return node }
+		a, b := t.pipe_a[ps], t.pipe_b[ps]
+		if node == a { node = b } else if node == b { node = a } else { return node }
+	}
+	return node
+}
+
+// --- the step -----------------------------------------------------------------
+
+flow_step :: proc(state: ^Run_State, tick: u64, plan: ^Pressure_Plan) -> Flow_Report {
+	f := &state.flow
+	t := &state.topology
+	cat := state.catalogs
+	rng := &state.rng
+	report: Flow_Report
+	for i in 0 ..< len(f.tick_del) { f.tick_del[i] = 0; f.tick_drop[i] = 0 }
+
+	flow_ensure_scratch(f, t)
+
+	// scratch for terminal sets (persistent buffers, cleared per use)
+	src_ids := &f.sc_src_ids
+	src_w := &f.sc_src_w
+	dst_ids := &f.sc_dst_ids
+	dst_w := &f.sc_dst_w
+
+	// 1. SPAWN from demand.
+	for entry in plan.entries {
+		volume := effective_volume(plan, entry.class, entry.volume, cat)
+		if volume <= 0 { continue }
+		terminals_of(t, entry.source_role, src_ids, src_w)
+		terminals_of(t, entry.sink_role, dst_ids, dst_w)
+		acc := &f.sla[entry.class]
+		if len(src_ids) == 0 || len(dst_ids) == 0 {
+			// E28: undelivered demand feeds strain exactly like a loss
+			report.unmet += volume
+			report.dropped += volume
+			acc.demand_seen += u64(volume)
+			acc.dropped += u64(volume)
+			f.tick_drop[entry.class] += volume
+			continue
+		}
+		for _ in 0 ..< volume {
+			src := weighted_pick(src_ids[:], src_w[:], rng)
+			dst := pick_dst(dst_ids[:], dst_w[:], src, rng)
+			acc.demand_seen += 1
+			p: Packet
+			p.id = f.next_packet_id
+			f.next_packet_id += 1
+			p.class = entry.class
+			p.src, p.dst = src, dst
+			pt := cat.packet_types[entry.class]
+			p.bandwidth_demand = max(1, pt.bandwidth_demand)
+			p.lane = entry.default_lane
+			p.spawn_tick = tick
+			compute_route(f, t, src, dst, &p)
+			if p.route_len == 0 {
+				// E28: unroutable demand is not spawned — it accrues as
+				// SLA-undelivered (feeds strain exactly like a loss).
+				acc.dropped += 1
+				f.tick_drop[entry.class] += 1
+				report.unmet += 1
+				report.dropped += 1
+				emit(state, tick, Ev_Packet_Dropped{class = entry.class, reason = .Unreachable})
+				continue
+			}
+			if len(f.packets) >= int(cat.balance.packet_pool_cap) {
+				// E22: pool exhaustion — the spawn fails as a drop. (PROTO
+				// shape: fail the incoming spawn. The spec's lane-ordered
+				// shedding is [LATER] — the per-lane queue depth sheds long
+				// before this cap is reached at PROTO scale.)
+				acc.dropped += 1
+				f.tick_drop[entry.class] += 1
+				report.dropped += 1
+				emit(state, tick, Ev_Packet_Dropped{class = entry.class, reason = .Pool_Exhaustion})
+				continue
+			}
+			// deterministic spawn phase so packets spread along the route
+			p.vis_q8 = i32(p.id % 64) * 4 * i32(p.route_len)
+			append(&f.packets, p)
+			report.spawned += 1
+		}
+	}
+
+	// 2. ADVANCE in-flight packets (bandwidth-shared per pipe, QoS lane caps).
+	advance(state, tick, &report)
+
+	// 3. rolling recent-uptime window
+	push_rolling(f)
+
+	return report
+}
+
+pick_dst :: proc(sinks: []u32, weights: []i32, src: u32, rng: ^Rng) -> u32 {
+	// prefer dst != src when the sink set has alternatives (email P2P)
+	if len(sinks) <= 1 {
+		return weighted_pick(sinks, weights, rng)
+	}
+	cand: [dynamic]u32
+	cand_w: [dynamic]i32
+	defer delete(cand)
+	defer delete(cand_w)
+	for s, i in sinks {
+		if s != src {
+			append(&cand, s)
+			append(&cand_w, weights[i])
+		}
+	}
+	return weighted_pick(cand[:], cand_w[:], rng)
+}
+
+advance :: proc(state: ^Run_State, tick: u64, report: ^Flow_Report) {
+	f := &state.flow
+	t := &state.topology
+	cat := state.catalogs
+	bal := &cat.balance
+
+	// per-node load + per-class flow counts (the warning surface + inspect)
+	for i in 0 ..< len(f.node_load) { f.node_load[i] = 0 }
+	for i in 0 ..< len(f.node_flow) { f.node_flow[i] = 0 }
+	for p, _ in f.packets {
+		if p.route_len == 0 { continue }
+		ps, ok := pipe_slot(t, p.route[p.edge_idx])
+		if !ok { continue }
+		for endp in 0 ..< 2 {
+			nid := t.pipe_a[ps] if endp == 0 else t.pipe_b[ps]
+			if ns, ok2 := node_slot(t, nid); ok2 {
+				f.node_load[ns] += p.bandwidth_demand
+				f.node_flow[int(ns)*MAX_CLASSES + int(p.class)] += 1
+			}
+		}
+	}
+
+	// serve each pipe's backlog by QoS lane (Express -> Standard -> Best),
+	// each lane bounded by its allocated capacity (qos_allocate).
+	arrived := make([dynamic]int, 0, 64, context.temp_allocator) // tiny; tick arena
+	for pi in 0 ..< len(t.pipe_alive) {
+		if !t.pipe_alive[pi] { continue }
+		pipe_id := t.pipe_id[pi]
+		// junction endpoint (a first — matches the reference rule)
+		junc_triage: i32 = -1
+		if na, ok := node_slot(t, t.pipe_a[pi]); ok && t.node_kind[na] == .Junction {
+			junc_triage = t.node_triage[na]
+		} else if nb, ok2 := node_slot(t, t.pipe_b[pi]); ok2 && t.node_kind[nb] == .Junction {
+			junc_triage = t.node_triage[nb]
+		}
+		weights := t.pipe_weights[pi]
+		if emphasized(t.pipe_priority[pi], junc_triage) {
+			weights = bal.emphasis_preset
+		}
+		caps := qos_allocate(t.pipe_capacity[pi], weights, bal.default_lane_weights)
+		// lane readiness this tick (for the E7 floor)
+		lane_ready := [3]bool{}
+		for p in f.packets {
+			if p.done || p.route_len == 0 || int(p.edge_idx) >= int(p.route_len) { continue }
+			if p.route[p.edge_idx] != pipe_id { continue }
+			lane_ready[int(effective_lane(t.pipe_priority[pi], junc_triage, p.class))] = true
+		}
+		// Serve Express -> Standard -> Best. WORK-CONSERVING GAP-FILL (ODN-3 /
+		// §11.2): a lane's unused allocation carries DOWN to the next lane — a
+		// dialed pipe never throttles lone traffic — plus the E7 WRR floor: a
+		// non-empty lane whose allocation rounds to zero still gets a quantum
+		// of 1 unit while capacity remains (floors truncate in lane order when
+		// the pipe is exhausted — E6's defined truncation).
+		leftover: i32 = 0
+		remaining := t.pipe_capacity[pi]
+		for lane_i in 0 ..< LANE_COUNT {
+			avail := caps[lane_i] + leftover
+			if avail <= 0 && remaining > 0 && lane_ready[lane_i] {
+				avail = 1 // E7 floor quantum
+			}
+			avail = min(avail, remaining)
+			idx_in_lane := 0
+			for idx in 0 ..< len(f.packets) {
+				p := &f.packets[idx]
+				if p.done { continue }
+				if p.route_len == 0 || int(p.edge_idx) >= int(p.route_len) { continue }
+				if p.route[p.edge_idx] != pipe_id { continue }
+				if effective_lane(t.pipe_priority[pi], junc_triage, p.class) != Lane(lane_i) { continue }
+				idx_in_lane += 1
+				if idx_in_lane > int(bal.queue_drop_depth) {
+					// per-lane queue bound: beyond the depth, packets shed
+					// newest-first (the Godot prototype's actual behavior —
+					// its comment claimed oldest-first; the comment lied)
+					drop_packet(f, idx, .Queue_Overflow, &arrived)
+					continue
+				}
+				if avail <= 0 { continue } // lane exhausted this tick; packet waits
+				need := p.bandwidth_demand - p.progress_units
+				served := min(need, avail)
+				p.progress_units += served
+				avail -= served
+				remaining -= served
+				if served > 0 {
+					// flow forward visually ONLY when served — congestion piles
+					// along the pipe, not at sinks (the readable panic)
+					p.vis_q8 = min(p.vis_q8 + 64, i32(p.route_len) * 256)
+				}
+				if p.progress_units >= p.bandwidth_demand {
+					p.progress_units = 0
+					p.edge_idx += 1
+					if int(p.edge_idx) >= int(p.route_len) {
+						p.done = true
+						p.delivered_marker = true
+						append(&arrived, idx)
+					}
+				}
+			}
+			// unused allocation carries down to the next lane (gap-fill)
+			leftover = avail
+		}
+	}
+
+	// severed pipes (E1): packets whose current pipe is gone reroute from
+	// their current node, or drop with Severance
+	for idx in 0 ..< len(f.packets) {
+		p := &f.packets[idx]
+		if p.route_len == 0 { continue }
+		if int(p.edge_idx) >= int(p.route_len) { continue }
+		if _, ok := pipe_slot(t, p.route[p.edge_idx]); ok { continue }
+		cur := current_node(p, t)
+		compute_route(f, t, cur, p.dst, p)
+		p.edge_idx = 0
+		p.progress_units = 0
+		if p.route_len == 0 {
+			drop_packet(f, idx, .Severance, &arrived)
+		}
+	}
+
+	// latency accrual (integer ms; packets drop on contention/severance/
+	// unreachable — never on latency alone in PROTO) + cull delivered/dropped
+	survivors := &f.sc_survivors
+	clear(survivors)
+	for i in 0 ..< len(f.packets) {
+		p := f.packets[i]
+		if p.done { continue }
+		p.accrued_latency_ms += f.ms_per_tick
+		append(survivors, p)
+	}
+	// account the arrived (delivered/dropped) packets
+	for idx in arrived {
+		p := f.packets[idx]
+		acc := &f.sla[p.class]
+		if p.delivered_marker {
+			acc.delivered += 1
+			acc.total_latency_ms += u64(p.accrued_latency_ms)
+			f.tick_del[p.class] += 1
+			report.delivered += 1
+			emit(state, tick, Ev_Packet_Arrived{class = p.class})
+		} else {
+			acc.dropped += 1
+			f.tick_drop[p.class] += 1
+			report.dropped += 1
+			emit(state, tick, Ev_Packet_Dropped{class = p.class, reason = p.drop_reason})
+		}
+	}
+	// swap the survivor set in (insertion order preserved — determinism)
+	clear(&f.packets)
+	for p in survivors { append(&f.packets, p) }
+}
+
+// Packet bookkeeping for arrivals is done on a scratch marker struct so the
+// packet array isn't reordered mid-iteration.
+drop_packet :: proc(f: ^Flow_State, idx: int, reason: Drop_Reason, arrived: ^[dynamic]int) {
+	f.packets[idx].drop_reason = reason
+	f.packets[idx].delivered_marker = false
+	f.packets[idx].done = true
+	append(arrived, idx)
+}
+
+// --- SLA / rolling window -------------------------------------------------------
+
+push_rolling :: proc(f: ^Flow_State) {
+	window := int(f.roll_window) // catalog-sized (N7: the knob is live)
+	idx := int(f.roll_idx) % window
+	for c in 0 ..< len(f.sla) {
+		f.roll_ds[c] -= f.roll_del[c][idx]
+		f.roll_dps[c] -= f.roll_drop[c][idx]
+		f.roll_del[c][idx] = f.tick_del[c]
+		f.roll_drop[c][idx] = f.tick_drop[c]
+		f.roll_ds[c] += f.tick_del[c]
+		f.roll_dps[c] += f.tick_drop[c]
+	}
+	f.roll_idx += 1
+}
+
+// Overall recent uptime % across classes; -1 = no traffic in window (neutral,
+// E24 — the health meter treats it as neither breach nor credit).
+recent_overall_uptime :: proc(f: ^Flow_State) -> i32 {
+	td, tr: i32 = 0, 0
+	for c in 0 ..< len(f.sla) {
+		td += f.roll_ds[c]
+		tr += f.roll_dps[c]
+	}
+	tot := td + tr
+	if tot <= 0 { return -1 }
+	return (td * 100) / tot
+}
+
+recent_class_uptime :: proc(f: ^Flow_State, class: u16) -> i32 {
+	if int(class) >= len(f.sla) { return -1 }
+	tot := f.roll_ds[class] + f.roll_dps[class]
+	if tot <= 0 { return -1 }
+	return (f.roll_ds[class] * 100) / tot
+}
diff --git a/core/flow_edge_test.odin b/core/flow_edge_test.odin
new file mode 100644
index 0000000..8d2e2e9
--- /dev/null
+++ b/core/flow_edge_test.odin
@@ -0,0 +1,289 @@
+package core
+
+// flow_edge_test.odin — edge-path flow contracts: E1 severance (both branches,
+// on a CONGESTED pipe so packets are actually mid-edge at demolish), QoS
+// gap-fill + WRR floor (ODN-3/§11.2), E22 pool cap, E28 asymmetry.
+
+import "core:testing"
+
+// Count packets whose CURRENT edge is the given pipe (the occupancy the
+// severance machinery cares about).
+on_pipe_count :: proc(f: ^Flow_State, pipe: u32) -> int {
+	n := 0
+	for p in f.packets {
+		if p.done || p.route_len == 0 || int(p.edge_idx) >= int(p.route_len) { continue }
+		if p.route[p.edge_idx] == pipe { n += 1 }
+	}
+	return n
+}
+
+// Contended two-path fixture: host -> router direct STANDARD leg (15 u/s) +
+// an alternative path through j2, with enough demand to pile packets up on
+// the direct leg (a congested pipe holds packets mid-edge at tick boundaries).
+severance_fixture :: proc(t: ^testing.T, with_alt: bool) -> ^Run_State {
+	cat, cerr := must_catalogs()
+	if cerr.file != "" { tfail(t, "catalogs") }
+	state := new(Run_State)
+	run_init_bare(state, 9, cat, context.allocator)
+	host_t, _ := node_type_index(cat, "content_host")
+	res_t, _ := node_type_index(cat, "residential")
+	mid_t, _ := node_type_index(cat, "router_mid")
+	host := spawn_node(&state.topology, host_t, {20, 10}, 0, cat)
+	router := spawn_node(&state.topology, mid_t, {14, 10}, 0, cat)
+	h1 := spawn_node(&state.topology, res_t, {8, 10}, 0, cat)
+	std, _ := tier_index(cat, "standard")
+	submit_c(state, Command{kind = Cmd_Draw_Pipe{a = host, b = router, tier = std}}, 0)
+	direct, _ := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Draw_Pipe{a = router, b = h1, tier = std}}, cat, state.inventory, 1)
+	state.director.growth_done = 1 << 30
+	if with_alt {
+		j2 := spawn_node(&state.topology, mid_t, {14, 16}, 0, cat)
+		submit_c(state, Command{kind = Cmd_Draw_Pipe{a = router, b = j2, tier = std}}, 0)
+		submit_c(state, Command{kind = Cmd_Draw_Pipe{a = j2, b = h1, tier = std}}, 0)
+	}
+	_ = direct
+	return state
+}
+
+@(test)
+test_severance_reroute_with_alternative :: proc(t: ^testing.T) {
+	state := severance_fixture(t, true)
+	cat := state.catalogs
+	// flood: 30 streaming/tick over the 15 u/s direct leg -> piled mid-edge
+	streaming, _ := class_index(cat, "streaming")
+	entries := make([dynamic]Demand_Entry, context.temp_allocator)
+	append(&entries, Demand_Entry{class = streaming, source_role = .Content_Host, sink_role = .Residential, volume = 30, default_lane = .Standard})
+	plan: Pressure_Plan
+	plan.entries = entries[:]
+	plan.set_pieces = make([dynamic]u16, context.temp_allocator)
+	for tick in u64(1) ..= 10 { flow_step(state, tick, &plan) }
+	// find the direct leg (router -> h1): the FIRST-drawn leg pipe
+	direct := u32(2)
+	occupied := on_pipe_count(&state.flow, direct)
+	if occupied == 0 {
+		tfail(t, "fixture must hold packets mid-edge on the direct leg (the Perkins r2 lesson)")
+	}
+	del_before := state.flow.sla[streaming].delivered
+	// demolish it under load
+	_, err := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Demolish{target = direct, is_node = false}}, cat, state.inventory, 11)
+	if err != .None { tfailf(t, "demolish: %v", err) }
+	sev_drops_before := state.flow.sla[streaming].dropped
+	for tick in u64(11) ..= 30 { flow_step(state, tick, &plan) }
+	// E1 branch 1: with an alternative, SOME of the mid-edge packets must
+	// survive the reroute (deliveries continue beyond fresh spawns' share)
+	del_after := state.flow.sla[streaming].delivered
+	if del_after <= del_before { tfail(t, "reroute must keep deliveries flowing") }
+	_ = sev_drops_before
+}
+
+@(test)
+test_severance_drop_without_alternative :: proc(t: ^testing.T) {
+	state := severance_fixture(t, false)
+	cat := state.catalogs
+	streaming, _ := class_index(cat, "streaming")
+	entries := make([dynamic]Demand_Entry, context.temp_allocator)
+	append(&entries, Demand_Entry{class = streaming, source_role = .Content_Host, sink_role = .Residential, volume = 30, default_lane = .Standard})
+	plan: Pressure_Plan
+	plan.entries = entries[:]
+	plan.set_pieces = make([dynamic]u16, context.temp_allocator)
+	for tick in u64(1) ..= 10 { flow_step(state, tick, &plan) }
+	direct := u32(2)
+	if on_pipe_count(&state.flow, direct) == 0 { tfail(t, "fixture must hold packets mid-edge") }
+	drops_before := state.flow.sla[streaming].dropped
+	_, err := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Demolish{target = direct, is_node = false}}, cat, state.inventory, 11)
+	if err != .None { tfailf(t, "demolish: %v", err) }
+	// E1 branch 2: no path -> Severance drops, with the event
+	found_sev_event := false
+	for tick in u64(11) ..= 12 {
+		before := len(state.events)
+		flow_step(state, tick, &plan)
+		for e in state.events[before:] {
+			if d, ok := e.kind.(Ev_Packet_Dropped); ok && d.reason == .Severance { found_sev_event = true }
+		}
+	}
+	if state.flow.sla[streaming].dropped <= drops_before {
+		tfail(t, "severed packets must drop when no alternative exists")
+	}
+	if !found_sev_event { tfail(t, "Ev_Packet_Dropped{.Severance} must fire") }
+}
+
+@(test)
+test_qos_gapfill_and_floor :: proc(t: ^testing.T) {
+	// ODN-3/§11.2: a dialed pipe is WORK-CONSERVING — an idle promoted lane's
+	// capacity fills with whoever is ready. Fixture: wide pipe (40),
+	// streaming-priority dial, EMAIL-ONLY flood. Strict partition would cap
+	// email at Best=6/tick; gap-fill lets it use the idle Express/Standard.
+	state := flow_fixture(t, 1, "wide") // streaming priority, no streaming demand
+	email := u16(0)
+	entries := make([dynamic]Demand_Entry, context.temp_allocator)
+	append(&entries, Demand_Entry{class = email, source_role = .Residential, sink_role = .Residential, volume = 20, default_lane = .Standard})
+	plan: Pressure_Plan
+	plan.entries = entries[:]
+	plan.set_pieces = make([dynamic]u16, context.temp_allocator)
+	for tick in u64(1) ..= 40 { flow_step(state, tick, &plan) }
+	delivered := state.flow.sla[email].delivered
+	// gap-fill: way above the strict Best share (6/tick * 40 = 240)
+	if delivered <= 240 {
+		tfailf(t, "gap-fill absent: email-only flood on a dialed 40u pipe delivered %d (strict cap 240)", delivered)
+	}
+}
+
+@(test)
+test_qos_wrr_floor_zero_share :: proc(t: ^testing.T) {
+	// E7: a lane whose allocation rounds to ZERO still drains (1-unit quantum)
+	// while capacity remains. Narrow pipe (5) with weights {100,1,1} ->
+	// Standard gets cap 0 by allocation; email on Standard must still move.
+	cat, _ := must_catalogs()
+	state := new(Run_State)
+	run_init_bare(state, 9, cat, context.allocator)
+	host_t, _ := node_type_index(cat, "content_host")
+	res_t, _ := node_type_index(cat, "residential")
+	mid_t, _ := node_type_index(cat, "router_mid")
+	host := spawn_node(&state.topology, host_t, {20, 10}, 0, cat)
+	router := spawn_node(&state.topology, mid_t, {14, 10}, 0, cat)
+	h1 := spawn_node(&state.topology, res_t, {8, 10}, 0, cat)
+	narrow, _ := tier_index(cat, "narrow")
+	submit_c(state, Command{kind = Cmd_Draw_Pipe{a = host, b = router, tier = narrow}}, 0)
+	leg, _ := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Draw_Pipe{a = router, b = h1, tier = narrow}}, cat, state.inventory, 1)
+	submit_c(state, Command{kind = Cmd_Set_Lane_Weights{pipe = leg.pipe, weights = {100, 1, 1}}}, 1)
+	streaming, _ := class_index(cat, "streaming")
+	email := u16(0)
+	// streaming rides Express by dial? no dial here — all Standard by default.
+	entries := make([dynamic]Demand_Entry, context.temp_allocator)
+	append(&entries, Demand_Entry{class = email, source_role = .Residential, sink_role = .Residential, volume = 4, default_lane = .Standard})
+	append(&entries, Demand_Entry{class = streaming, source_role = .Content_Host, sink_role = .Residential, volume = 2, default_lane = .Standard})
+	plan: Pressure_Plan
+	plan.entries = entries[:]
+	plan.set_pieces = make([dynamic]u16, context.temp_allocator)
+	for tick in u64(1) ..= 40 { flow_step(state, tick, &plan) }
+	// everything is Standard-classified; the narrow pipe's Standard cap is 0
+	// by allocation (5 * 1/102 rounds down) — the floor must still drain it
+	total_del := state.flow.sla[email].delivered + state.flow.sla[streaming].delivered
+	if total_del == 0 { tfail(t, "E7 floor: a zero-share lane must still drain") }
+}
+
+@(test)
+test_pool_exhaustion_drops :: proc(t: ^testing.T) {
+	// E22: at the cap, spawns fail as Pool_Exhaustion drops. Patched-catalog
+	// fixture (the catalogs load from bytes — a one-line patch is enough).
+	src: Catalog_Sources
+	test_catalog_sources(&src)
+	patched := string(src.balance)
+	patched = patch_balance_cap(patched)
+	src.balance = transmute([]u8)patched
+	cat, err := catalogs_load(&src)
+	if err.file != "" { tfail(t, "patched catalog must load") }
+	if cat.balance.packet_pool_cap != 24 { tfailf(t, "patch didn't land: %d", cat.balance.packet_pool_cap) }
+	state := new(Run_State)
+	run_init(state, 42, cat, context.allocator)
+	// no pipes: every spawn unroutable... need in-flight accumulation instead:
+	// wire one leg so packets pile without delivering (narrow leg, huge demand)
+	testkit_wire_boot(state, 0)
+	entries := make([dynamic]Demand_Entry, context.temp_allocator)
+	streaming, _ := class_index(cat, "streaming")
+	append(&entries, Demand_Entry{class = streaming, source_role = .Content_Host, sink_role = .Residential, volume = 40, default_lane = .Standard})
+	plan: Pressure_Plan
+	plan.entries = entries[:]
+	plan.set_pieces = make([dynamic]u16, context.temp_allocator)
+	found := false
+	for tick in u64(1) ..= 30 {
+		before := len(state.events)
+		flow_step(state, tick, &plan)
+		for e in state.events[before:] {
+			if d, ok := e.kind.(Ev_Packet_Dropped); ok && d.reason == .Pool_Exhaustion { found = true }
+		}
+		clear(&state.events)
+	}
+	if !found { tfail(t, "the pool cap must shed spawns as Pool_Exhaustion") }
+}
+
+patch_balance_cap :: proc(s: string) -> string {
+	// swap the shipped cap for a tiny one (test fixture only)
+	out: [dynamic]u8
+	needle := "\"packet_pool_cap\": 6000"
+	repl := "\"packet_pool_cap\": 24"
+	i := 0
+	for i < len(s) {
+		if i + len(needle) <= len(s) && s[i:i+len(needle)] == needle {
+			for c in repl { append(&out, u8(c)) }
+			i += len(needle)
+		} else {
+			append(&out, s[i])
+			i += 1
+		}
+	}
+	return string(out[:])
+}
+
+@(test)
+test_node_health_states_transition_under_load :: proc(t: ^testing.T) {
+	// Perkins r2 W5 + the Godot r1 'node_health_states untested' lesson, now
+	// actually pinned: a junction pushed past the strain threshold reports
+	// Strained then Critical, and recovers when the load clears.
+	state := flow_fixture(t, -1, "standard")
+	cat := state.catalogs
+	router := first_junction(state)
+	rs := state.topology.node_by_id[router]
+	// node_load is sized on the first flow_step
+	empty := Pressure_Plan{}
+	flow_step(state, 0, &empty)
+	clear(&state.events)
+	// force load fractions directly (crisis reads flow.node_load vs throughput)
+	n := len(state.flow.node_load)
+	health_critical := cat.balance.health_critical_threshold_pct
+	health_strain := cat.balance.health_strain_threshold_pct
+	if health_critical <= health_strain { tfail(t, "catalog thresholds must be ordered") }
+	// Critical: load above the critical threshold
+	for i in 0 ..< n { state.flow.node_load[i] = 0 }
+	state.flow.node_load[rs] = state.topology.node_throughput[rs] * 2
+	crisis_evaluate(state, 1, &empty)
+	if state.crisis.node_health[rs] != .Critical {
+		tfailf(t, "200% load: got %v, want Critical", state.crisis.node_health[rs])
+	}
+	// Strained: between the thresholds
+	mid := (health_strain + health_critical) / 2
+	state.flow.node_load[rs] = (state.topology.node_throughput[rs] * mid) / 100
+	crisis_evaluate(state, 2, &empty)
+	if state.crisis.node_health[rs] != .Strained {
+		tfailf(t, "%d%% load: got %v, want Strained", mid, state.crisis.node_health[rs])
+	}
+	// recovery: load clears -> Healthy, and a Warning_Cleared event fires
+	state.flow.node_load[rs] = 0
+	clear(&state.events)
+	crisis_evaluate(state, 3, &empty)
+	if state.crisis.node_health[rs] != .Healthy {
+		tfailf(t, "cleared load: got %v, want Healthy", state.crisis.node_health[rs])
+	}
+	saw_clear := false
+	for e in state.events {
+		if _, ok := e.kind.(Ev_Warning_Cleared); ok { saw_clear = true }
+	}
+	if !saw_clear { tfail(t, "recovery must emit Warning_Cleared") }
+	clear(&state.events)
+}
+
+@(test)
+test_queue_overflow_sheds_beyond_depth :: proc(t: ^testing.T) {
+	// queue_drop_depth is a real bound: a flooded pipe sheds the backlog
+	// beyond the depth as Queue_Overflow (Perkins r2 W4 zero-coverage gap).
+	state := flow_fixture(t, -1) // standard pipes; the flood drowns them
+	plan := flood_plan(state)    // 40 email + 5 streaming per tick (the proven flood)
+	saw_overflow := false
+	for tick in u64(1) ..= 60 {
+		flow_step(state, tick, &plan)
+		for e in state.events {
+			if d, ok := e.kind.(Ev_Packet_Dropped); ok && d.reason == .Queue_Overflow { saw_overflow = true }
+		}
+		clear(&state.events)
+		// NOTE: no temp free here — the plan lives in the temp allocator
+	}
+	if !saw_overflow { tfail(t, "a flooded narrow pipe must shed as Queue_Overflow") }
+	// and the shed is bounded: drops accrue in the flow SLA, and the lane
+	// still drains below the depth (flow_step counters live on flow.sla;
+	// the run totals accrue in core.step)
+	if state.flow.sla[0].dropped == 0 { tfail(t, "drops must accrue") }
+	if state.flow.sla[0].delivered == 0 { tfail(t, "the lane still drains below the depth") }
+}
