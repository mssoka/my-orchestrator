-
-# --- public batch / single apply ----------------------------------------------
-
-## Validate-all-then-apply (AC-E23): any invalid command rejects the WHOLE batch
-## with NO partial state mutation. Returns the first rejection, or applied().
-func apply_all(cmds: Array) -> EditResult:
-	# Phase 1: validate every command against the CURRENT (un-mutated) topology.
-	for cmd: Command in cmds:
-		var r: EditResult = _validate(cmd)
-		if not r.ok:
-			return r
-	# Phase 2: all valid -> apply all.
-	for cmd: Command in cmds:
-		_apply(cmd)
-	return EditResult.applied()
-
-
-## Single-command apply (validate then mutate). Convenience for tests/Input.
-func apply_edit(cmd: Command) -> EditResult:
-	var r: EditResult = _validate(cmd)
-	if not r.ok:
-		return r
-	_apply(cmd)
-	return EditResult.applied()
-
-
-# --- immutable snapshot --------------------------------------------------------
-
-func snapshot() -> TopologySnapshot:
-	var snap := TopologySnapshot.new()
-	# Shallow-copy node/pipe refs (the objects themselves are treated read-only
-	# by readers; the graph never hands out mutating refs to the snapshot's maps).
-	snap.nodes = _nodes.duplicate()
-	snap.pipes = _pipes.duplicate()
-	snap.adjacency = {}
-	for k: int in _adjacency:
-		snap.adjacency[k] = (_adjacency[k] as Array).duplicate()
-	# terminals grouped by role NAME (demand selectors are StringName; map-agnostic)
-	for n_id: int in _nodes:
-		var n: NetNode = _nodes[n_id]
-		if n.is_terminal():
-			var role: StringName = CoreConst.role_name(n.terminal_role)
-			if not snap.terminals_by_role.has(role):
-				snap.terminals_by_role[role] = []
-			(snap.terminals_by_role[role] as Array).append(n_id)
-	# pipe-by-pair index (Array per pair -> parallel pipes supported, E1.5)
-	for p_id: int in _pipes:
-		var p: NetPipe = _pipes[p_id]
-		var key: String = TopologySnapshot._pair_key(p.a_id, p.b_id)
-		if not snap.pipes_by_pair.has(key):
-			snap.pipes_by_pair[key] = []
-		(snap.pipes_by_pair[key] as Array).append(p)
-	return snap
