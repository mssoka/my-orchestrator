-# --- rolling recent-uptime window (forgives the build phase; reflects CURRENT
-# --- performance so the meter recharges once the network is built) ---
-func _roll_for(class_id: StringName) -> Dictionary:
-	if not _roll.has(class_id):
-		var r: Dictionary = {"del": [], "drop": [], "ds": 0, "dps": 0}
-		(r["del"] as Array).resize(ROLLING_WINDOW); (r["del"] as Array).fill(0)
-		(r["drop"] as Array).resize(ROLLING_WINDOW); (r["drop"] as Array).fill(0)
-		_roll[class_id] = r
-	return _roll[class_id]
-
-
-func _push_rolling() -> void:
-	var classes: Array = []
-	for c: StringName in _roll:
-		classes.append(c)
-	for c: StringName in _tick_del:
-		if not classes.has(c):
-			classes.append(c)
-	for c: StringName in _tick_drop:
-		if not classes.has(c):
-			classes.append(c)
-	var idx: int = _roll_idx % ROLLING_WINDOW
-	for c: StringName in classes:
-		var r: Dictionary = _roll_for(c)
-		r["ds"] = int(r["ds"]) - int(r["del"][idx])
-		r["dps"] = int(r["dps"]) - int(r["drop"][idx])
-		var td: int = int(_tick_del.get(c, 0))
-		var tdr: int = int(_tick_drop.get(c, 0))
-		r["del"][idx] = td
-		r["drop"][idx] = tdr
-		r["ds"] = int(r["ds"]) + td
-		r["dps"] = int(r["dps"]) + tdr
-	_roll_idx += 1
-
-
-func recent_overall_uptime_pct() -> int:
-	var td: int = 0
-	var tr: int = 0
-	for c: StringName in _roll:
-		var r: Dictionary = _roll[c]
-		td += int(r["ds"])
-		tr += int(r["dps"])
-	var tot: int = td + tr
-	if tot <= 0:
-		return -1
-	return (td * 100) / tot
