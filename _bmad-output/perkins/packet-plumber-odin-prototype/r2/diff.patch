-## The director owns the growth TIMELINE like it owns the demand timeline (the
-## "internet grows" schedule is part of the same seam; V2 impls keep the seam).
-## Deterministic: same (seed, era, tick, topology) -> identical spawn set (NFR1).
-## The returned spawns are APPLIED by SimDriver before the tick's flow steps, so
-## newly appeared nodes immediately join demand (unconnected = visible pressure).
-func plan_growth(_topology: TopologySnapshot, _era_id: int, _tick: int,
-				 _rng: RandomNumberGenerator) -> Array[NodeSpawn]:
-	assert(false, "CrisisDirector.plan_growth must be overridden by a subclass")
