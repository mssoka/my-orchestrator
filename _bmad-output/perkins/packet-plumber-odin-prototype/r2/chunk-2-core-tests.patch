diff --git a/core/determinism_test.odin b/core/determinism_test.odin
new file mode 100644
index 0000000..3df11d8
--- /dev/null
+++ b/core/determinism_test.odin
@@ -0,0 +1,144 @@
+package core
+
+// determinism_test.odin — THE determinism spine (ODN-1/9/10; the briefing's
+// ONE hard blocker). Closes the three Perkins r1 gaps from the Godot
+// prototype:
+//   (a) the fingerprint covers ALL in-flight packet state + latency + rng
+//       (see serialize.odin),
+//   (b) replay-equality runs on a REAL, packet-rich, command-built topology,
+//   (c) the command-application convention is pinned: live edits land
+//       immediately (fast-path) and are logged with apply_tick = next tick;
+//       replay applies entries with apply_tick == N BEFORE stepping N.
+
+import "core:testing"
+
+// Step a run from tick 1..ticks, autowiring growth like the demo autopilot,
+// recording the per-tick state hash. Drains events per tick into the hash.
+record_run :: proc(state: ^Run_State, ticks: u64, replay: bool, allocator := context.allocator) -> [dynamic]u64 {
+	hashes := make([dynamic]u64, 0, ticks, allocator)
+	wired := make(map[u32]bool, allocator)
+	if !replay {
+		// live path: edits apply immediately at tick 0 (fast-path), logged
+		// with apply_tick = 1 (the pinned convention)
+		testkit_wire_boot(state, 0)
+		for i in 0 ..< len(state.topology.node_alive) {
+			wired[state.topology.node_id[i]] = true
+		}
+	}
+	for tick in u64(1) ..= ticks {
+		before := len(state.events)
+		if replay {
+			// replay: apply all log entries with apply_tick == tick before the step
+			cmds := make([dynamic]Command, context.temp_allocator)
+			for cmd in state.action_log {
+				if cmd.apply_tick == tick { append(&cmds, cmd) }
+			}
+			step(state, tick, cmds[:])
+		} else {
+			step(state, tick, {})
+		}
+		// hash at the step boundary — BEFORE any new fast-path edits (they
+		// carry apply_tick = tick+1 and belong to the next boundary)
+		h := state_hash(state, state.events[before:], context.temp_allocator)
+		append(&hashes, h)
+		if !replay {
+			testkit_autowire(state, tick, &wired)
+		}
+		clear(&state.events)
+		free_all(context.temp_allocator)
+	}
+	return hashes
+}
+
+@(test)
+test_replay_byte_identical_on_real_topology :: proc(t: ^testing.T) {
+	cat, err := must_catalogs()
+	if err.file != "" { tfailf(t, "catalogs: %s", err.file) }
+
+	live := new(Run_State)
+	run_init(live, 42, cat, context.allocator)
+	live_hashes := record_run(live, 600, false)
+
+	// the keystone must be packet-rich (Perkins r1: the Godot keystone ran on
+	// a no-pipes topology — guard against that here)
+	if pipe_count(&live.topology) < 5 { tfailf(t, "keystone topology too thin: %d pipes", pipe_count(&live.topology)) }
+	if live.delivered_total == 0 { tfail(t, "keystone must have deliveries") }
+	if len(live.action_log) == 0 { tfail(t, "keystone must be command-built") }
+
+	replayed := new(Run_State)
+	run_init(replayed, 42, cat, context.allocator)
+	replayed.action_log = live.action_log // the ODN-11 artifact
+	replay_hashes := record_run(replayed, 600, true)
+	if replayed.replay_error { tfail(t, "replay hit a validation error (ODN-11 critical)") }
+
+	if len(live_hashes) != len(replay_hashes) { tfail(t, "tick count mismatch") }
+	for i in 0 ..< len(live_hashes) {
+		if live_hashes[i] != replay_hashes[i] {
+			tfailf(t, "REPLAY DIVERGENCE at tick %d: %x != %x", i+1, live_hashes[i], replay_hashes[i])
+		}
+	}
+}
+
+@(test)
+test_seed_reproduces :: proc(t: ^testing.T) {
+	cat, _ := must_catalogs()
+	a := new(Run_State)
+	run_init(a, 99, cat, context.allocator)
+	ha := record_run(a, 300, false)
+	b := new(Run_State)
+	run_init(b, 99, cat, context.allocator)
+	hb := record_run(b, 300, false)
+	for i in 0 ..< len(ha) {
+		if ha[i] != hb[i] { tfailf(t, "same seed diverged at tick %d", i+1) }
+	}
+	c := new(Run_State)
+	run_init(c, 100, cat, context.allocator)
+	hc := record_run(c, 300, false)
+	same := true
+	for i in 0 ..< len(ha) {
+		if ha[i] != hc[i] { same = false; break }
+	}
+	if same { tfail(t, "different seeds must diverge") }
+}
+
+@(test)
+test_action_log_binary_roundtrip :: proc(t: ^testing.T) {
+	// ODN-11: the log survives the binary round-trip byte-for-byte-semantics;
+	// corrupt inputs get the defined rejection, never a crash.
+	cat, _ := must_catalogs()
+	state := new(Run_State)
+	run_init(state, 42, cat, context.allocator)
+	testkit_wire_boot(state, 0)
+	bytes := log_write(state, context.temp_allocator)
+	header, cmds, ok := log_read(bytes, context.temp_allocator)
+	if !ok { tfail(t, "round-trip must parse") }
+	if header.seed != 42 || header.era != 3 || header.logic_hz != cat.balance.logic_hz {
+		tfail(t, "header mismatch")
+	}
+	if header.catalog_hash != cat.hash { tfail(t, "catalog hash mismatch") }
+	if len(cmds) != len(state.action_log) { tfail(t, "command count mismatch") }
+	for i in 0 ..< len(cmds) {
+		a, b := state.action_log[i], cmds[i]
+		if a.apply_tick != b.apply_tick { tfailf(t, "cmd %d apply_tick", i) }
+		ka, kb := a.kind, b.kind
+		#partial switch ca in ka {
+		case Cmd_Draw_Pipe:
+			cb := kb.(Cmd_Draw_Pipe)
+			if ca != cb { tfailf(t, "cmd %d draw mismatch", i) }
+		case Cmd_Set_Pipe_Priority:
+			cb := kb.(Cmd_Set_Pipe_Priority)
+			if ca != cb { tfailf(t, "cmd %d priority mismatch", i) }
+		}
+	}
+	// defined rejections
+	if _, _, ok2 := log_read(bytes[:len(bytes)-1], context.temp_allocator); ok2 {
+		tfail(t, "truncated log must reject")
+	}
+	if _, _, ok3 := log_read(bytes[:8], context.temp_allocator); ok3 {
+		tfail(t, "header-only log must reject")
+	}
+	garbage := make([]u8, 64, context.temp_allocator)
+	if _, _, ok4 := log_read(garbage, context.temp_allocator); ok4 {
+		tfail(t, "garbage must reject")
+	}
+}
diff --git a/core/flow_edge_test.odin b/core/flow_edge_test.odin
new file mode 100644
index 0000000..8d2e2e9
--- /dev/null
+++ b/core/flow_edge_test.odin
@@ -0,0 +1,289 @@
+package core
+
+// flow_edge_test.odin — edge-path flow contracts: E1 severance (both branches,
+// on a CONGESTED pipe so packets are actually mid-edge at demolish), QoS
+// gap-fill + WRR floor (ODN-3/§11.2), E22 pool cap, E28 asymmetry.
+
+import "core:testing"
+
+// Count packets whose CURRENT edge is the given pipe (the occupancy the
+// severance machinery cares about).
+on_pipe_count :: proc(f: ^Flow_State, pipe: u32) -> int {
+	n := 0
+	for p in f.packets {
+		if p.done || p.route_len == 0 || int(p.edge_idx) >= int(p.route_len) { continue }
+		if p.route[p.edge_idx] == pipe { n += 1 }
+	}
+	return n
+}
+
+// Contended two-path fixture: host -> router direct STANDARD leg (15 u/s) +
+// an alternative path through j2, with enough demand to pile packets up on
+// the direct leg (a congested pipe holds packets mid-edge at tick boundaries).
+severance_fixture :: proc(t: ^testing.T, with_alt: bool) -> ^Run_State {
+	cat, cerr := must_catalogs()
+	if cerr.file != "" { tfail(t, "catalogs") }
+	state := new(Run_State)
+	run_init_bare(state, 9, cat, context.allocator)
+	host_t, _ := node_type_index(cat, "content_host")
+	res_t, _ := node_type_index(cat, "residential")
+	mid_t, _ := node_type_index(cat, "router_mid")
+	host := spawn_node(&state.topology, host_t, {20, 10}, 0, cat)
+	router := spawn_node(&state.topology, mid_t, {14, 10}, 0, cat)
+	h1 := spawn_node(&state.topology, res_t, {8, 10}, 0, cat)
+	std, _ := tier_index(cat, "standard")
+	submit_c(state, Command{kind = Cmd_Draw_Pipe{a = host, b = router, tier = std}}, 0)
+	direct, _ := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Draw_Pipe{a = router, b = h1, tier = std}}, cat, state.inventory, 1)
+	state.director.growth_done = 1 << 30
+	if with_alt {
+		j2 := spawn_node(&state.topology, mid_t, {14, 16}, 0, cat)
+		submit_c(state, Command{kind = Cmd_Draw_Pipe{a = router, b = j2, tier = std}}, 0)
+		submit_c(state, Command{kind = Cmd_Draw_Pipe{a = j2, b = h1, tier = std}}, 0)
+	}
+	_ = direct
+	return state
+}
+
+@(test)
+test_severance_reroute_with_alternative :: proc(t: ^testing.T) {
+	state := severance_fixture(t, true)
+	cat := state.catalogs
+	// flood: 30 streaming/tick over the 15 u/s direct leg -> piled mid-edge
+	streaming, _ := class_index(cat, "streaming")
+	entries := make([dynamic]Demand_Entry, context.temp_allocator)
+	append(&entries, Demand_Entry{class = streaming, source_role = .Content_Host, sink_role = .Residential, volume = 30, default_lane = .Standard})
+	plan: Pressure_Plan
+	plan.entries = entries[:]
+	plan.set_pieces = make([dynamic]u16, context.temp_allocator)
+	for tick in u64(1) ..= 10 { flow_step(state, tick, &plan) }
+	// find the direct leg (router -> h1): the FIRST-drawn leg pipe
+	direct := u32(2)
+	occupied := on_pipe_count(&state.flow, direct)
+	if occupied == 0 {
+		tfail(t, "fixture must hold packets mid-edge on the direct leg (the Perkins r2 lesson)")
+	}
+	del_before := state.flow.sla[streaming].delivered
+	// demolish it under load
+	_, err := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Demolish{target = direct, is_node = false}}, cat, state.inventory, 11)
+	if err != .None { tfailf(t, "demolish: %v", err) }
+	sev_drops_before := state.flow.sla[streaming].dropped
+	for tick in u64(11) ..= 30 { flow_step(state, tick, &plan) }
+	// E1 branch 1: with an alternative, SOME of the mid-edge packets must
+	// survive the reroute (deliveries continue beyond fresh spawns' share)
+	del_after := state.flow.sla[streaming].delivered
+	if del_after <= del_before { tfail(t, "reroute must keep deliveries flowing") }
+	_ = sev_drops_before
+}
+
+@(test)
+test_severance_drop_without_alternative :: proc(t: ^testing.T) {
+	state := severance_fixture(t, false)
+	cat := state.catalogs
+	streaming, _ := class_index(cat, "streaming")
+	entries := make([dynamic]Demand_Entry, context.temp_allocator)
+	append(&entries, Demand_Entry{class = streaming, source_role = .Content_Host, sink_role = .Residential, volume = 30, default_lane = .Standard})
+	plan: Pressure_Plan
+	plan.entries = entries[:]
+	plan.set_pieces = make([dynamic]u16, context.temp_allocator)
+	for tick in u64(1) ..= 10 { flow_step(state, tick, &plan) }
+	direct := u32(2)
+	if on_pipe_count(&state.flow, direct) == 0 { tfail(t, "fixture must hold packets mid-edge") }
+	drops_before := state.flow.sla[streaming].dropped
+	_, err := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Demolish{target = direct, is_node = false}}, cat, state.inventory, 11)
+	if err != .None { tfailf(t, "demolish: %v", err) }
+	// E1 branch 2: no path -> Severance drops, with the event
+	found_sev_event := false
+	for tick in u64(11) ..= 12 {
+		before := len(state.events)
+		flow_step(state, tick, &plan)
+		for e in state.events[before:] {
+			if d, ok := e.kind.(Ev_Packet_Dropped); ok && d.reason == .Severance { found_sev_event = true }
+		}
+	}
+	if state.flow.sla[streaming].dropped <= drops_before {
+		tfail(t, "severed packets must drop when no alternative exists")
+	}
+	if !found_sev_event { tfail(t, "Ev_Packet_Dropped{.Severance} must fire") }
+}
+
+@(test)
+test_qos_gapfill_and_floor :: proc(t: ^testing.T) {
+	// ODN-3/§11.2: a dialed pipe is WORK-CONSERVING — an idle promoted lane's
+	// capacity fills with whoever is ready. Fixture: wide pipe (40),
+	// streaming-priority dial, EMAIL-ONLY flood. Strict partition would cap
+	// email at Best=6/tick; gap-fill lets it use the idle Express/Standard.
+	state := flow_fixture(t, 1, "wide") // streaming priority, no streaming demand
+	email := u16(0)
+	entries := make([dynamic]Demand_Entry, context.temp_allocator)
+	append(&entries, Demand_Entry{class = email, source_role = .Residential, sink_role = .Residential, volume = 20, default_lane = .Standard})
+	plan: Pressure_Plan
+	plan.entries = entries[:]
+	plan.set_pieces = make([dynamic]u16, context.temp_allocator)
+	for tick in u64(1) ..= 40 { flow_step(state, tick, &plan) }
+	delivered := state.flow.sla[email].delivered
+	// gap-fill: way above the strict Best share (6/tick * 40 = 240)
+	if delivered <= 240 {
+		tfailf(t, "gap-fill absent: email-only flood on a dialed 40u pipe delivered %d (strict cap 240)", delivered)
+	}
+}
+
+@(test)
+test_qos_wrr_floor_zero_share :: proc(t: ^testing.T) {
+	// E7: a lane whose allocation rounds to ZERO still drains (1-unit quantum)
+	// while capacity remains. Narrow pipe (5) with weights {100,1,1} ->
+	// Standard gets cap 0 by allocation; email on Standard must still move.
+	cat, _ := must_catalogs()
+	state := new(Run_State)
+	run_init_bare(state, 9, cat, context.allocator)
+	host_t, _ := node_type_index(cat, "content_host")
+	res_t, _ := node_type_index(cat, "residential")
+	mid_t, _ := node_type_index(cat, "router_mid")
+	host := spawn_node(&state.topology, host_t, {20, 10}, 0, cat)
+	router := spawn_node(&state.topology, mid_t, {14, 10}, 0, cat)
+	h1 := spawn_node(&state.topology, res_t, {8, 10}, 0, cat)
+	narrow, _ := tier_index(cat, "narrow")
+	submit_c(state, Command{kind = Cmd_Draw_Pipe{a = host, b = router, tier = narrow}}, 0)
+	leg, _ := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Draw_Pipe{a = router, b = h1, tier = narrow}}, cat, state.inventory, 1)
+	submit_c(state, Command{kind = Cmd_Set_Lane_Weights{pipe = leg.pipe, weights = {100, 1, 1}}}, 1)
+	streaming, _ := class_index(cat, "streaming")
+	email := u16(0)
+	// streaming rides Express by dial? no dial here — all Standard by default.
+	entries := make([dynamic]Demand_Entry, context.temp_allocator)
+	append(&entries, Demand_Entry{class = email, source_role = .Residential, sink_role = .Residential, volume = 4, default_lane = .Standard})
+	append(&entries, Demand_Entry{class = streaming, source_role = .Content_Host, sink_role = .Residential, volume = 2, default_lane = .Standard})
+	plan: Pressure_Plan
+	plan.entries = entries[:]
+	plan.set_pieces = make([dynamic]u16, context.temp_allocator)
+	for tick in u64(1) ..= 40 { flow_step(state, tick, &plan) }
+	// everything is Standard-classified; the narrow pipe's Standard cap is 0
+	// by allocation (5 * 1/102 rounds down) — the floor must still drain it
+	total_del := state.flow.sla[email].delivered + state.flow.sla[streaming].delivered
+	if total_del == 0 { tfail(t, "E7 floor: a zero-share lane must still drain") }
+}
+
+@(test)
+test_pool_exhaustion_drops :: proc(t: ^testing.T) {
+	// E22: at the cap, spawns fail as Pool_Exhaustion drops. Patched-catalog
+	// fixture (the catalogs load from bytes — a one-line patch is enough).
+	src: Catalog_Sources
+	test_catalog_sources(&src)
+	patched := string(src.balance)
+	patched = patch_balance_cap(patched)
+	src.balance = transmute([]u8)patched
+	cat, err := catalogs_load(&src)
+	if err.file != "" { tfail(t, "patched catalog must load") }
+	if cat.balance.packet_pool_cap != 24 { tfailf(t, "patch didn't land: %d", cat.balance.packet_pool_cap) }
+	state := new(Run_State)
+	run_init(state, 42, cat, context.allocator)
+	// no pipes: every spawn unroutable... need in-flight accumulation instead:
+	// wire one leg so packets pile without delivering (narrow leg, huge demand)
+	testkit_wire_boot(state, 0)
+	entries := make([dynamic]Demand_Entry, context.temp_allocator)
+	streaming, _ := class_index(cat, "streaming")
+	append(&entries, Demand_Entry{class = streaming, source_role = .Content_Host, sink_role = .Residential, volume = 40, default_lane = .Standard})
+	plan: Pressure_Plan
+	plan.entries = entries[:]
+	plan.set_pieces = make([dynamic]u16, context.temp_allocator)
+	found := false
+	for tick in u64(1) ..= 30 {
+		before := len(state.events)
+		flow_step(state, tick, &plan)
+		for e in state.events[before:] {
+			if d, ok := e.kind.(Ev_Packet_Dropped); ok && d.reason == .Pool_Exhaustion { found = true }
+		}
+		clear(&state.events)
+	}
+	if !found { tfail(t, "the pool cap must shed spawns as Pool_Exhaustion") }
+}
+
+patch_balance_cap :: proc(s: string) -> string {
+	// swap the shipped cap for a tiny one (test fixture only)
+	out: [dynamic]u8
+	needle := "\"packet_pool_cap\": 6000"
+	repl := "\"packet_pool_cap\": 24"
+	i := 0
+	for i < len(s) {
+		if i + len(needle) <= len(s) && s[i:i+len(needle)] == needle {
+			for c in repl { append(&out, u8(c)) }
+			i += len(needle)
+		} else {
+			append(&out, s[i])
+			i += 1
+		}
+	}
+	return string(out[:])
+}
+
+@(test)
+test_node_health_states_transition_under_load :: proc(t: ^testing.T) {
+	// Perkins r2 W5 + the Godot r1 'node_health_states untested' lesson, now
+	// actually pinned: a junction pushed past the strain threshold reports
+	// Strained then Critical, and recovers when the load clears.
+	state := flow_fixture(t, -1, "standard")
+	cat := state.catalogs
+	router := first_junction(state)
+	rs := state.topology.node_by_id[router]
+	// node_load is sized on the first flow_step
+	empty := Pressure_Plan{}
+	flow_step(state, 0, &empty)
+	clear(&state.events)
+	// force load fractions directly (crisis reads flow.node_load vs throughput)
+	n := len(state.flow.node_load)
+	health_critical := cat.balance.health_critical_threshold_pct
+	health_strain := cat.balance.health_strain_threshold_pct
+	if health_critical <= health_strain { tfail(t, "catalog thresholds must be ordered") }
+	// Critical: load above the critical threshold
+	for i in 0 ..< n { state.flow.node_load[i] = 0 }
+	state.flow.node_load[rs] = state.topology.node_throughput[rs] * 2
+	crisis_evaluate(state, 1, &empty)
+	if state.crisis.node_health[rs] != .Critical {
+		tfailf(t, "200% load: got %v, want Critical", state.crisis.node_health[rs])
+	}
+	// Strained: between the thresholds
+	mid := (health_strain + health_critical) / 2
+	state.flow.node_load[rs] = (state.topology.node_throughput[rs] * mid) / 100
+	crisis_evaluate(state, 2, &empty)
+	if state.crisis.node_health[rs] != .Strained {
+		tfailf(t, "%d%% load: got %v, want Strained", mid, state.crisis.node_health[rs])
+	}
+	// recovery: load clears -> Healthy, and a Warning_Cleared event fires
+	state.flow.node_load[rs] = 0
+	clear(&state.events)
+	crisis_evaluate(state, 3, &empty)
+	if state.crisis.node_health[rs] != .Healthy {
+		tfailf(t, "cleared load: got %v, want Healthy", state.crisis.node_health[rs])
+	}
+	saw_clear := false
+	for e in state.events {
+		if _, ok := e.kind.(Ev_Warning_Cleared); ok { saw_clear = true }
+	}
+	if !saw_clear { tfail(t, "recovery must emit Warning_Cleared") }
+	clear(&state.events)
+}
+
+@(test)
+test_queue_overflow_sheds_beyond_depth :: proc(t: ^testing.T) {
+	// queue_drop_depth is a real bound: a flooded pipe sheds the backlog
+	// beyond the depth as Queue_Overflow (Perkins r2 W4 zero-coverage gap).
+	state := flow_fixture(t, -1) // standard pipes; the flood drowns them
+	plan := flood_plan(state)    // 40 email + 5 streaming per tick (the proven flood)
+	saw_overflow := false
+	for tick in u64(1) ..= 60 {
+		flow_step(state, tick, &plan)
+		for e in state.events {
+			if d, ok := e.kind.(Ev_Packet_Dropped); ok && d.reason == .Queue_Overflow { saw_overflow = true }
+		}
+		clear(&state.events)
+		// NOTE: no temp free here — the plan lives in the temp allocator
+	}
+	if !saw_overflow { tfail(t, "a flooded narrow pipe must shed as Queue_Overflow") }
+	// and the shed is bounded: drops accrue in the flow SLA, and the lane
+	// still drains below the depth (flow_step counters live on flow.sla;
+	// the run totals accrue in core.step)
+	if state.flow.sla[0].dropped == 0 { tfail(t, "drops must accrue") }
+	if state.flow.sla[0].delivered == 0 { tfail(t, "the lane still drains below the depth") }
+}
diff --git a/core/flow_test.odin b/core/flow_test.odin
new file mode 100644
index 0000000..8bed4a1
--- /dev/null
+++ b/core/flow_test.odin
@@ -0,0 +1,232 @@
+package core
+
+// flow_test.odin — flow-level behavior contracts (Perkins r1 blocker #2: QoS
+// promote/demote + drop behavior were untested in Godot) and the fun-test
+// loop's terminal states as FULL SIM RUNS (surge win with a real build; Error
+// 404 on an idle map).
+
+import "core:testing"
+
+// A contended link where the QoS dial decides who suffers. Purpose-built
+// bare topology: host --standard--> router --legs--> h1,h2 — every terminal
+// routable, the spine the only contended link (15 u/s standard).
+flow_fixture :: proc(t: ^testing.T, priority: i32, tier_name: string = "standard") -> ^Run_State {
+	cat, cerr := must_catalogs()
+	if cerr.file != "" { tfail(t, "catalogs") }
+	state := new(Run_State)
+	run_init_bare(state, 9, cat, context.allocator)
+	host_t, _ := node_type_index(cat, "content_host")
+	res_t, _ := node_type_index(cat, "residential")
+	mid_t, _ := node_type_index(cat, "router_mid")
+	host := spawn_node(&state.topology, host_t, {20, 10}, 0, cat)
+	router := spawn_node(&state.topology, mid_t, {14, 10}, 0, cat)
+	h1 := spawn_node(&state.topology, res_t, {8, 10}, 0, cat)
+	h2 := spawn_node(&state.topology, res_t, {8, 14}, 0, cat)
+	tier, _ := tier_index(cat, tier_name)
+	_, err := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Draw_Pipe{a = host, b = router, tier = tier}}, cat, state.inventory, 0)
+	if err != .None { tfailf(t, "draw spine: %v", err) }
+	// The contention point is the LEGS (email flows house->router->house; the
+	// spine carries only streaming) — the dial goes on the legs.
+	houses := [2]u32{h1, h2}
+	for h in houses {
+		leg, err3 := topology_apply_edit(&state.topology,
+			Command{kind = Cmd_Draw_Pipe{a = router, b = h, tier = tier}}, cat, state.inventory, 0)
+		if err3 != .None { tfailf(t, "draw leg: %v", err3) }
+		if priority >= 0 {
+			_, err4 := topology_apply_edit(&state.topology,
+				Command{kind = Cmd_Set_Pipe_Priority{pipe = leg.pipe, priority = priority}}, cat, state.inventory, 0)
+			if err4 != .None { tfailf(t, "priority: %v", err4) }
+		}
+	}
+	return state
+}
+
+// A synthetic flood: 40 email + 5 streaming per tick over a STANDARD spine
+// (15 u/s). Neutral: the email flood hogs the shared Standard lane and
+// streaming drowns. Prioritized (streaming -> Express): streaming owns its
+// lane and ALL of it flows; email demotes to Best-effort and sheds first.
+flood_plan :: proc(state: ^Run_State) -> Pressure_Plan {
+	plan: Pressure_Plan
+	streaming, _ := class_index(state.catalogs, "streaming")
+	email, _ := class_index(state.catalogs, "email")
+	entries := make([dynamic]Demand_Entry, context.temp_allocator)
+	append(&entries, Demand_Entry{class = email, source_role = .Residential, sink_role = .Residential, volume = 40, default_lane = .Standard})
+	append(&entries, Demand_Entry{class = streaming, source_role = .Content_Host, sink_role = .Residential, volume = 5, default_lane = .Standard})
+	plan.entries = entries[:]
+	plan.set_pieces = make([dynamic]u16, context.temp_allocator)
+	return plan
+}
+
+@(test)
+test_qos_priority_protects_its_class :: proc(t: ^testing.T) {
+	// The differentiator (FORGE #4), flow level: the dial decides WHO SUFFERS
+	// when the link contends. Standard spine (15 u/s): neutral caps
+	// {3,10,2} — the email flood eats Standard and streaming never rides;
+	// emphasis {4,1,1} -> {10,4,1} — streaming owns Express.
+	streaming := u16(1) // catalog order: email, streaming
+
+	neutral := flow_fixture(t, -1)
+	plan_n := flood_plan(neutral)
+	for tick in u64(1) ..= 40 { flow_step(neutral, tick, &plan_n) }
+	n_s := neutral.flow.sla[streaming]
+	n_e := neutral.flow.sla[0] // email is class 0 in the catalog
+
+	prio := flow_fixture(t, i32(streaming))
+	plan_p := flood_plan(prio)
+	for tick in u64(1) ..= 40 { flow_step(prio, tick, &plan_p) }
+	p_s := prio.flow.sla[streaming]
+	p_e := prio.flow.sla[0]
+
+	// neutral: streaming drowns in the email flood (a handful slip through the
+	// drop-depth churn; demand is 5/tick = 200 over the window)
+	if n_s.delivered >= 40 { tfailf(t, "neutral: streaming should drown, got %d deliveries", n_s.delivered) }
+	if p_s.delivered == 0 { tfail(t, "prioritized streaming must flow") }
+	if p_s.delivered <= n_s.delivered {
+		tfailf(t, "the dial must rescue its class: prio %d vs neutral %d", p_s.delivered, n_s.delivered)
+	}
+	// the demoted class does WORSE with the dial on (it owns the small lane)
+	if p_e.delivered >= n_e.delivered {
+		tfailf(t, "demoted email should deliver less under priority: %d vs %d", p_e.delivered, n_e.delivered)
+	}
+	// no-starvation (E7): Best-effort still slips through the gaps
+	if p_e.delivered == 0 { tfail(t, "E7: Best-effort must not starve") }
+}
+
+@(test)
+test_unroutable_demand_accrues_visibly :: proc(t: ^testing.T) {
+	// E28: no pipes -> nothing spawns; demand accrues as SLA loss (feeds the
+	// health drain) with an Unreachable drop event, never a phantom packet.
+	state := test_boot_state(t)
+	plan := scripted_plan_pressure(state.catalogs, 1, context.temp_allocator)
+	report := flow_step(state, 1, &plan)
+	if report.spawned != 0 { tfailf(t, "no pipes must spawn nothing, got %d", report.spawned) }
+	if report.unmet == 0 { tfail(t, "unroutable demand must be visible") }
+	email, _ := class_index(state.catalogs, "email")
+	if state.flow.sla[email].dropped == 0 { tfail(t, "unroutable accrues as SLA loss") }
+	found := false
+	for e in state.events {
+		if d, ok := e.kind.(Ev_Packet_Dropped); ok && d.reason == .Unreachable { found = true }
+	}
+	if !found { tfail(t, "Unreachable drop event expected") }
+}
+
+@(test)
+test_severance_reroute_or_drop :: proc(t: ^testing.T) {
+	// E1: demolishing an in-flight pipe reroutes via an alternative path, or
+	// drops with Severance when none exists.
+	state := test_boot_state(t)
+	cat := state.catalogs
+	wide, _ := tier_index(cat, "wide")
+	host := node_id_by_role(state, .Content_Host, 0)
+	router := first_junction(state)
+	h1 := node_id_by_role(state, .Residential, 0)
+	h2 := node_id_by_role(state, .Residential, 1)
+	// direct leg + an alternative path via a second junction
+	submit_c(state, Command{kind = Cmd_Draw_Pipe{a = host, b = router, tier = wide}}, 0)
+	direct, _ := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Draw_Pipe{a = router, b = h1, tier = wide}}, cat, state.inventory, 0)
+	rt, _ := node_type_index(cat, "router_mid")
+	j2 := spawn_node(&state.topology, rt, {12, 19}, 0, cat)
+	submit_c(state, Command{kind = Cmd_Draw_Pipe{a = router, b = j2, tier = wide}}, 0)
+	submit_c(state, Command{kind = Cmd_Draw_Pipe{a = j2, b = h1, tier = wide}}, 0)
+	submit_c(state, Command{kind = Cmd_Draw_Pipe{a = h2, b = router, tier = wide}}, 0)
+	// run traffic until the direct leg is in use, then demolish it
+	plan := scripted_plan_pressure(cat, 0, context.temp_allocator)
+	for tick in u64(1) ..= 20 { flow_step(state, tick, &plan) }
+	dem := Command{kind = Cmd_Demolish{target = direct.pipe, is_node = false}}
+	_, err := topology_apply_edit(&state.topology, dem, cat, state.inventory, 20)
+	if err != .None { tfailf(t, "demolish: %v", err) }
+	delivered_before := state.flow.sla[0].delivered + state.flow.sla[1].delivered
+	for tick in u64(21) ..= 60 { flow_step(state, tick, &plan) }
+	// the alternative path must carry traffic (no full severance collapse)
+	delivered_after := state.flow.sla[0].delivered + state.flow.sla[1].delivered
+	if delivered_after <= delivered_before { tfail(t, "reroute must keep deliveries flowing") }
+}
+
+submit_c :: proc(state: ^Run_State, cmd: Command, tick: u64) {
+	topology_apply_edit(&state.topology, cmd, state.catalogs, state.inventory, tick + 1)
+}
+
+@(test)
+test_full_surge_win_and_idle_loss :: proc(t: ^testing.T) {
+	// THE fun gate, as full sim runs (Perkins r1 blocker #1 — terminal states
+	// must be tested):
+	//   (a) boot-wired + autowired run SURVIVES the surge -> won
+	//   (b) idle run (no pipes) drains the meter -> Error 404 -> lost
+	cat, _ := must_catalogs()
+
+	win := new(Run_State)
+	run_init(win, 42, cat, context.allocator)
+	wired := make(map[u32]bool)
+	testkit_wire_boot(win, 0)
+	for i in 0 ..< len(win.topology.node_alive) { wired[win.topology.node_id[i]] = true }
+	saw_surge := false
+	for tick in u64(1) ..= 3100 {
+		if win.health.won || win.health.lost { break }
+		step(win, tick, {})
+		testkit_autowire(win, tick, &wired)
+		for e in win.events {
+			if c, ok := e.kind.(Ev_Crisis_Triggered); ok && c.archetype == .Surge { saw_surge = true }
+		}
+		clear(&win.events)
+		free_all(context.temp_allocator)
+	}
+	if !saw_surge { tfail(t, "the surge must fire (Crisis_Triggered{Surge})") }
+	if !win.health.won { tfailf(t, "a good build must survive the surge; won=%v lost=%v meter=%d",
+		win.health.won, win.health.lost, win.health.meter_pct) }
+
+	idle := new(Run_State)
+	run_init(idle, 42, cat, context.allocator)
+	lost_tick: u64 = 0
+	for tick in u64(1) ..= 3100 {
+		step(idle, tick, {})
+		clear(&idle.events)
+		free_all(context.temp_allocator)
+		if idle.health.lost { lost_tick = tick; break }
+	}
+	if !idle.health.lost { tfail(t, "an idle network must die (Error 404)") }
+	if lost_tick == 0 { tfail(t, "unreachable") }
+	tlogf(t, "idle loss at tick %d; surge survived with meter %d", lost_tick, win.health.meter_pct)
+}
+
+@(test)
+test_growth_is_deterministic_and_valid :: proc(t: ^testing.T) {
+	// E31: growth positions are seeded-deterministic and every spawn respects
+	// min separation + near-junction growth (outward from the router mesh).
+	cat, _ := must_catalogs()
+	a := new(Run_State)
+	run_init(a, 7, cat, context.allocator)
+	b := new(Run_State)
+	run_init(b, 7, cat, context.allocator)
+	bal := &cat.balance
+	// wire the boot network so the runs survive past the growth window (an
+	// idle run dies ~tick 250 and the E17 barrier freezes it there)
+	testkit_wire_boot(a, 0)
+	testkit_wire_boot(b, 0)
+	for tick in u64(1) ..= 2000 {
+		step(a, tick, {})
+		step(b, tick, {})
+		clear(&a.events)
+		clear(&b.events)
+		free_all(context.temp_allocator)
+	}
+	na := node_count(&a.topology)
+	if na <= 6 { tfail(t, "growth must have spawned nodes") }
+	if na != node_count(&b.topology) { tfail(t, "same seed -> same growth") }
+	for i in 0 ..< len(a.topology.node_alive) {
+		if a.topology.node_alive[i] != b.topology.node_alive[i] { tfail(t, "growth liveness diverges") }
+		if a.topology.node_pos[i] != b.topology.node_pos[i] { tfail(t, "growth position diverges") }
+	}
+	// validity at spawn: min separation from all pre-existing nodes
+	ta := &a.topology
+	for i in 0 ..< len(ta.node_alive) {
+		if !ta.node_alive[i] { continue }
+		for j in i+1 ..< len(ta.node_alive) {
+			if !ta.node_alive[j] { continue }
+			if manhattan(ta.node_pos[i], ta.node_pos[j]) < bal.growth_min_dist_tiles {
+				tfailf(t, "nodes %d and %d violate min separation", ta.node_id[i], ta.node_id[j])
+			}
+		}
+	}
+}
diff --git a/core/health_test.odin b/core/health_test.odin
new file mode 100644
index 0000000..a2db9e6
--- /dev/null
+++ b/core/health_test.odin
@@ -0,0 +1,212 @@
+package core
+
+// health_test.odin — Network Health win/lose/drain/grace/recharge contracts
+// (Perkins r1 blocker #1: the Godot prototype shipped these UNTESTED). Driven
+// standalone with synthetic flow reports — health_update is a pure function of
+// (report, plan, recent_uptime).
+
+import "core:testing"
+
+health_fixture :: proc(t: ^testing.T) -> ^Run_State {
+	cat, err := must_catalogs()
+	if err.file != "" { tfailf(t, "catalogs: %s", err.file) }
+	state := new(Run_State)
+	run_init(state, 5, cat, context.allocator)
+	return state
+}
+
+empty_plan :: proc(surge: bool) -> Pressure_Plan {
+	plan: Pressure_Plan
+	plan.set_pieces = make([dynamic]u16, context.temp_allocator)
+	if surge { append(&plan.set_pieces, 0) }
+	return plan
+}
+
+has_event :: proc(state: ^Run_State, tag: u8) -> bool {
+	for e in state.events {
+		#partial switch k in e.kind {
+		case Ev_Grace_Started: if tag == 1 { return true }
+		case Ev_Grace_Expired: if tag == 2 { return true }
+		case Ev_Run_Won:       if tag == 3 { return true }
+		case Ev_Run_Lost:      if tag == 4 { return true }
+		case Ev_Meter_Changed: if tag == 5 { return true }
+		}
+	}
+	return false
+}
+
+@(test)
+test_health_grace_then_drain_then_loss :: proc(t: ^testing.T) {
+	state := health_fixture(t)
+	report := Flow_Report{}
+	plan := empty_plan(false)
+	bal := &state.catalogs.balance
+
+	// breach at 50% uptime: the grace window must absorb the first 200 ticks
+	for tick in u64(1) ..= u64(bal.grace_window_ticks) {
+		health_update(state, tick, &report, &plan, 50)
+		if state.health.meter_pct != bal.meter_start_pct {
+			tfailf(t, "meter drained during grace at tick %d", tick)
+		}
+	}
+	if !has_event(state, 1) { tfail(t, "Grace_Started must fire") }
+	if !has_event(state, 2) { tfail(t, "Grace_Expired must fire when the window empties") }
+	// then drain: severity 90-50=40 -> 40/10=4 capped at 2 per tick (E16)
+	health_update(state, 300, &report, &plan, 50)
+	if state.health.meter_pct != bal.meter_start_pct - 2 {
+		tfailf(t, "drain: got %d, want %d", state.health.meter_pct, bal.meter_start_pct - 2)
+	}
+	// run it to empty -> Error 404
+	for tick in u64(301) ..= 400 {
+		health_update(state, tick, &report, &plan, 50)
+	}
+	if !state.health.lost { tfail(t, "meter empty must lose the run") }
+	if !has_event(state, 4) { tfail(t, "Run_Lost must fire") }
+	if state.health.won { tfail(t, "won and lost are mutually exclusive (E17)") }
+}
+
+@(test)
+test_health_recharge_and_grace_reset :: proc(t: ^testing.T) {
+	state := health_fixture(t)
+	report := Flow_Report{}
+	plan := empty_plan(false)
+	bal := &state.catalogs.balance
+	// breach partway through grace, then recover
+	for tick in u64(1) ..= 100 { health_update(state, tick, &report, &plan, 50) }
+	// healthy stretch: grace resets, meter recharges (already full here)
+	for tick in u64(101) ..= 200 { health_update(state, tick, &report, &plan, 97) }
+	if state.health.grace_ticks_left != bal.grace_window_ticks {
+		tfail(t, "grace must reset when healthy")
+	}
+	if state.health.in_grace { tfail(t, "in_grace must clear") }
+	// drain some, then recharge (past grace but well short of flatline)
+	for tick in u64(201) ..= 430 { health_update(state, tick, &report, &plan, 10) }
+	drained := state.health.meter_pct
+	if drained >= 100 { tfail(t, "expected drain") }
+	for tick in u64(431) ..= 460 { health_update(state, tick, &report, &plan, 100) }
+	if state.health.meter_pct <= drained { tfail(t, "meter must recharge when healthy") }
+	if state.health.lost { tfail(t, "this path must stay alive") }
+}
+
+@(test)
+test_health_win_on_surge_survival :: proc(t: ^testing.T) {
+	state := health_fixture(t)
+	// surge active with 95% delivery, then ends -> win
+	surge := empty_plan(true)
+	for tick in u64(1) ..= 10 {
+		report := Flow_Report{delivered = 95, dropped = 5}
+		health_update(state, tick, &report, &surge, 95)
+	}
+	calm := empty_plan(false)
+	report := Flow_Report{delivered = 0, dropped = 0}
+	health_update(state, 11, &report, &calm, 95)
+	if !state.health.won { tfail(t, "surge survived at 95% must win (>= 90)") }
+	if !has_event(state, 3) { tfail(t, "Run_Won must fire") }
+	// terminal: further updates are no-ops
+	meter := state.health.meter_pct
+	health_update(state, 12, &report, &calm, 10)
+	if state.health.meter_pct != meter { tfail(t, "terminal state is frozen") }
+}
+
+@(test)
+test_health_no_win_below_threshold :: proc(t: ^testing.T) {
+	state := health_fixture(t)
+	surge := empty_plan(true)
+	for tick in u64(1) ..= 10 {
+		report := Flow_Report{delivered = 80, dropped = 20} // 80% < 90
+		health_update(state, tick, &report, &surge, 85)
+	}
+	calm := empty_plan(false)
+	report := Flow_Report{}
+	health_update(state, 11, &report, &calm, 85)
+	if state.health.won { tfail(t, "80% < 90% must not win") }
+}
+
+@(test)
+test_health_grace_single_episode :: proc(t: ^testing.T) {
+	// E30: a re-breach during an active grace window is a no-op — one
+	// Grace_Started per episode.
+	state := health_fixture(t)
+	report := Flow_Report{}
+	plan := empty_plan(false)
+	count := 0
+	for tick in u64(1) ..= 50 {
+		health_update(state, tick, &report, &plan, 40)
+		for e in state.events {
+			if _, ok := e.kind.(Ev_Grace_Started); ok { count += 1 }
+		}
+		clear(&state.events)
+	}
+	if count != 1 { tfailf(t, "Grace_Started fired %d times, want 1", count) }
+}
+
+@(test)
+test_health_flapping_does_not_rearm_grace :: proc(t: ^testing.T) {
+	// the never-lose exploit (review W1): alternating breach/healthy ticks must
+	// NOT keep refilling the whole window — hysteresis + gradual refill.
+	state := health_fixture(t)
+	report := Flow_Report{}
+	plan := empty_plan(false)
+	bal := &state.catalogs.balance
+	// flap: 1 breach tick (50%), 1 healthy tick (97% >= exit 93 => episode exits)
+	// E30: after a healthy tick above exit, the episode CLOSES; the next breach
+	// re-enters with the grace left where it was (gradual refill only).
+	start_grace := bal.grace_window_ticks
+	for tick in u64(1) ..= 40 {
+		up: i32 = 50 if tick % 2 == 1 else 97
+		health_update(state, tick, &report, &plan, up)
+	}
+	// flapping (no 50-tick streak) never refills: 20 breach ticks burned 20
+	expected := start_grace - 20
+	if state.health.grace_ticks_left != expected {
+		tfailf(t, "grace after flap: got %d, want %d", state.health.grace_ticks_left, expected)
+	}
+	// and a sustained breach must still flatline even with perfect alternation
+	for tick in u64(41) ..= 2000 {
+		up: i32 = 50 if tick % 2 == 1 else 97
+		health_update(state, tick, &report, &plan, up)
+		if state.health.lost { break }
+	}
+	if !state.health.lost { tfail(t, "a chronically flapping run must still be losable") }
+}
+
+@(test)
+test_health_second_surge_window_resets :: proc(t: ^testing.T) {
+	// Perkins r1 (Godot): a second surge double-counted the first's traffic.
+	state := health_fixture(t)
+	surge := empty_plan(true)
+	calm := empty_plan(false)
+	// surge 1: 80% uptime (below the win bar)
+	for tick in u64(1) ..= 10 {
+		report := Flow_Report{delivered = 80, dropped = 20}
+		health_update(state, tick, &report, &surge, 85)
+	}
+	health_update(state, 11, &Flow_Report{}, &calm, 95) // surge 1 ends, no win
+	if state.health.won { tfail(t, "80% must not win") }
+	// surge 2: a CLEAN 100% window — must be judged fresh
+	for tick in u64(12) ..= 21 {
+		report := Flow_Report{delivered = 10, dropped = 0}
+		health_update(state, tick, &report, &surge, 100)
+	}
+	health_update(state, 22, &Flow_Report{}, &calm, 100)
+	if !state.health.won { tfail(t, "surge 2 at 100% must win (fresh window)") }
+}
+
+@(test)
+test_terminal_barrier_freezes :: proc(t: ^testing.T) {
+	// E17: post-terminal steps are no-ops — no events, no drift.
+	state := health_fixture(t)
+	report := Flow_Report{}
+	plan := empty_plan(false)
+	for tick in u64(1) ..= 400 { health_update(state, tick, &report, &plan, 10) }
+	if !state.health.lost { tfail(t, "fixture must lose") }
+	// now drive whole core steps past the terminal state
+	before_events := len(state.events)
+	h1 := state_hash(state, {}, context.temp_allocator)
+	for tick in u64(401) ..= 500 {
+		step(state, tick, {})
+	}
+	if len(state.events) != before_events { tfail(t, "no events after terminal") }
+	h2 := state_hash(state, {}, context.temp_allocator)
+	if h1 != h2 { tfail(t, "state must freeze after terminal (replay tails)") }
+}
diff --git a/core/qos_test.odin b/core/qos_test.odin
new file mode 100644
index 0000000..90ae327
--- /dev/null
+++ b/core/qos_test.odin
@@ -0,0 +1,54 @@
+package core
+
+// qos_test.odin — the QoS contracts (ODN-3, §6.3): largest-remainder integer
+// distribution (E8), all-zero fallback (E5), Express>Standard>Best tie order,
+// the emphasis preset, and the effective-lane rules (pipe dial > junction
+// triage > all-Standard).
+
+import "core:testing"
+
+@(test)
+test_qos_allocate_largest_remainder :: proc(t: ^testing.T) {
+	// 15 x (1,4,1): exact = (2.5, 10, 2.5) -> floors (2,10,2), remainder 1,
+	// fractional tie (0.5 = 0.5) resolves Express first (E8).
+	caps := qos_allocate(15, {1, 4, 1}, {1, 4, 1})
+	if caps != {3, 10, 2} { tfailf(t, "got %v, want {3,10,2}", caps) }
+	// nothing vanishes to truncation
+	if caps[0]+caps[1]+caps[2] != 15 { tfail(t, "allocation must conserve capacity") }
+}
+
+@(test)
+test_qos_allocate_emphasis :: proc(t: ^testing.T) {
+	// 40 x (4,1,1) (the emphasis preset): exact = (26.67, 6.67, 6.67) ->
+	// floors (26,6,6), remainder 2, fractional ties resolve E then S.
+	caps := qos_allocate(40, {4, 1, 1}, {1, 4, 1})
+	if caps != {27, 7, 6} { tfailf(t, "got %v, want {27,7,6}", caps) }
+	if caps[0]+caps[1]+caps[2] != 40 { tfail(t, "allocation must conserve capacity") }
+}
+
+@(test)
+test_qos_allocate_all_zero_falls_back :: proc(t: ^testing.T) {
+	// E5: all-zero weights -> the catalog default preset.
+	caps := qos_allocate(15, {0, 0, 0}, {1, 4, 1})
+	if caps != {3, 10, 2} { tfailf(t, "got %v, want default-preset {3,10,2}", caps) }
+}
+
+@(test)
+test_qos_allocate_degenerate :: proc(t: ^testing.T) {
+	if qos_allocate(0, {1, 4, 1}, {1, 4, 1}) != {0, 0, 0} { tfail(t, "zero capacity") }
+	if qos_allocate(10, {0, 0, 0}, {0, 0, 0}) != {0, 0, 0} { tfail(t, "zero weights + zero default") }
+}
+
+@(test)
+test_effective_lane_precedence :: proc(t: ^testing.T) {
+	streaming := u16(1)
+	email := u16(0)
+	// neutral pipe, neutral junction -> all Standard
+	if effective_lane(-1, -1, streaming) != .Standard { tfail(t, "neutral must ride Standard") }
+	// pipe dial wins over junction triage
+	if effective_lane(1, 0, streaming) != .Express { tfail(t, "pipe dial promotes its class") }
+	if effective_lane(1, 0, email) != .Best { tfail(t, "pipe dial demotes the other class") }
+	// junction triage when the pipe is neutral
+	if effective_lane(-1, 1, streaming) != .Express { tfail(t, "junction triage promotes") }
+	if effective_lane(-1, 1, email) != .Best { tfail(t, "junction triage demotes others") }
+}
diff --git a/core/rng_test.odin b/core/rng_test.odin
new file mode 100644
index 0000000..37b0114
--- /dev/null
+++ b/core/rng_test.odin
@@ -0,0 +1,55 @@
+package core
+
+// rng_test.odin — the pinned PRNG conformance vectors (ODN-9). Generated once
+// from the canonical PCG32 XSH-RR reference (the algorithm implemented in
+// rng.odin, constants in source). Any future port (server validator, wasm)
+// must reproduce these — the cross-language determinism contract.
+
+import "core:testing"
+
+@(test)
+test_rng_pinned_vectors :: proc(t: ^testing.T) {
+	r: Rng
+	rng_seed(&r, 0)
+	expected := [8]u32{2196338726, 1832588393, 3253730937, 2647056997,
+	                   2191141068, 1480505347, 3030956019, 209995402}
+	for e, i in expected {
+		if got := rng_next(&r); got != e {
+			tfailf(t, "seed 0 output %d: got %d, want %d", i, got, e)
+		}
+	}
+}
+
+@(test)
+test_rng_seed42_pinned :: proc(t: ^testing.T) {
+	r: Rng
+	rng_seed(&r, 42)
+	expected := [4]u32{2399007886, 4293122540, 1743717038, 2217374311}
+	for e, i in expected {
+		if got := rng_next(&r); got != e {
+			tfailf(t, "seed 42 output %d: got %d, want %d", i, got, e)
+		}
+	}
+}
+
+@(test)
+test_rng_range_bounds :: proc(t: ^testing.T) {
+	r: Rng
+	rng_seed(&r, 7)
+	for _ in 0 ..< 10000 {
+		v := rng_range(&r, 6, 34)
+		if v < 6 || v > 34 { tfailf(t, "rng_range out of bounds: %d", v) }
+	}
+	if rng_range(&r, 5, 5) != 5 { tfail(t, "degenerate span must return lo") }
+}
+
+@(test)
+test_rng_streams_independent :: proc(t: ^testing.T) {
+	// same seed => identical stream (the determinism keystone)
+	a, b: Rng
+	rng_seed(&a, 1337)
+	rng_seed(&b, 1337)
+	for _ in 0 ..< 100 {
+		if rng_next(&a) != rng_next(&b) { tfail(t, "same seed must reproduce the stream") }
+	}
+}
diff --git a/core/testutil_test.odin b/core/testutil_test.odin
new file mode 100644
index 0000000..332e7c2
--- /dev/null
+++ b/core/testutil_test.odin
@@ -0,0 +1,19 @@
+package core
+
+// testutil_test.odin — fatal-style assertions over core:testing (expectf +
+// fail_now), so contract tests read as asserts.
+
+import "core:testing"
+
+tfail :: proc(t: ^testing.T, msg: string) -> ! {
+	testing.fail_now(t, msg)
+}
+
+tfailf :: proc(t: ^testing.T, format: string, args: ..any) -> ! {
+	testing.expectf(t, false, format, ..args)
+	testing.fail_now(t)
+}
+
+tlogf :: proc(t: ^testing.T, format: string, args: ..any) {
+	testing.expectf(t, true, format, ..args) // log via the passing-expectation channel
+}
diff --git a/core/topology_test.odin b/core/topology_test.odin
new file mode 100644
index 0000000..778b772
--- /dev/null
+++ b/core/topology_test.odin
@@ -0,0 +1,340 @@
+package core
+
+// topology_test.odin — the edit contracts (§6.1, E1/E2/E3/E26/E27 + canon
+// #14 port limits + the Perkins r1 fixes: ghost-pipe demolish, upgrade delta
+// pricing, upgrade span check).
+
+import "core:testing"
+
+test_boot_state :: proc(t: ^testing.T) -> ^Run_State {
+	cat, err := must_catalogs()
+	if err.file != "" { tfailf(t, "catalogs: %s %s %s", err.file, err.field, err.rule) }
+	state := new(Run_State)
+	run_init(state, 1337, cat, context.allocator)
+	return state
+}
+
+node_id_by_role :: proc(state: ^Run_State, role: Terminal_Role, n: int) -> u32 {
+	count := 0
+	tp := &state.topology
+	for i in 0 ..< len(tp.node_alive) {
+		if tp.node_alive[i] && tp.node_role[i] == role {
+			if count == n { return tp.node_id[i] }
+			count += 1
+		}
+	}
+	return 0
+}
+
+first_junction :: proc(state: ^Run_State) -> u32 {
+	tp := &state.topology
+	for i in 0 ..< len(tp.node_alive) {
+		if tp.node_alive[i] && tp.node_kind[i] == .Junction { return tp.node_id[i] }
+	}
+	return 0
+}
+
+@(test)
+test_draw_rejects_terminal_to_terminal :: proc(t: ^testing.T) {
+	state := test_boot_state(t)
+	h1 := node_id_by_role(state, .Residential, 0)
+	h2 := node_id_by_role(state, .Residential, 1)
+	standard, _ := tier_index(state.catalogs, "standard")
+	cmd := Command{kind = Cmd_Draw_Pipe{a = h1, b = h2, tier = standard}}
+	if e := validate_command(&state.topology, cmd, state.catalogs, state.inventory); e != .Terminal_To_Terminal {
+		tfailf(t, "E26: got %v, want Terminal_To_Terminal", e)
+	}
+}
+
+@(test)
+test_draw_rejects_self_loop_and_span :: proc(t: ^testing.T) {
+	state := test_boot_state(t)
+	h1 := node_id_by_role(state, .Residential, 0)
+	router := first_junction(state)
+	standard, _ := tier_index(state.catalogs, "standard")
+	narrow, _ := tier_index(state.catalogs, "narrow")
+	if e := validate_command(&state.topology, Command{kind = Cmd_Draw_Pipe{a = h1, b = h1, tier = standard}},
+		state.catalogs, state.inventory); e != .Self_Loop {
+		tfailf(t, "E3: got %v", e)
+	}
+	// house(8,5) to router(18,14): span = round(sqrt(100+81)) = 13 > narrow max 10
+	if e := validate_command(&state.topology, Command{kind = Cmd_Draw_Pipe{a = h1, b = router, tier = narrow}},
+		state.catalogs, state.inventory); e != .Span_Exceeds_Tier {
+		tfailf(t, "span: got %v, want Span_Exceeds_Tier", e)
+	}
+}
+
+@(test)
+test_span_metric :: proc(t: ^testing.T) {
+	// rounded Euclidean, integer-only (the pinned metric)
+	if got := span_between({8, 5}, {18, 14}); got != 13 { tfailf(t, "span 13? got %d", got) }
+	if got := span_between({0, 0}, {3, 4}); got != 5 { tfailf(t, "3-4-5: got %d", got) }
+	if got := span_between({0, 0}, {0, 0}); got != 0 { tfailf(t, "zero: got %d", got) }
+	if got := span_between({30, 14}, {18, 14}); got != 12 { tfailf(t, "straight: got %d", got) }
+}
+
+@(test)
+test_port_limits :: proc(t: ^testing.T) {
+	// canon #14: a basic router has 4 ports — one per connected pipe.
+	state := test_boot_state(t)
+	cat := state.catalogs
+	basic, _ := tier_index(cat, "standard")
+	_ = basic
+	// spawn a basic router + 5 houses in span
+	rt, _ := node_type_index(cat, "router_basic")
+	res, _ := node_type_index(cat, "residential")
+	rid := spawn_node(&state.topology, rt, {20, 20}, 0, cat)
+	std, _ := tier_index(cat, "standard")
+	wide, _ := tier_index(cat, "wide")
+	_ = std
+	drew := 0
+	for i in 0 ..< 5 {
+		hid := spawn_node(&state.topology, res, {16 + i32(i) * 2, 25}, 0, cat)
+		cmd := Command{kind = Cmd_Draw_Pipe{a = rid, b = hid, tier = wide}}
+		err := validate_command(&state.topology, cmd, cat, rich_inv(cat))
+		if i < 4 {
+			if err != .None { tfailf(t, "pipe %d should validate, got %v", i, err) }
+			topology_apply_edit(&state.topology, cmd, cat, rich_inv(cat), 0)
+			drew += 1
+		} else {
+			if err != .Router_Ports_Full { tfailf(t, "5th pipe must hit the port cap, got %v", err) }
+		}
+	}
+	if drew != 4 { tfailf(t, "drew %d, want 4", drew) }
+}
+
+// a bottomless tray for validation fixtures that are not ABOUT the tray
+rich_inv :: proc(cat: ^Catalogs) -> Inventory {
+	inv: Inventory
+	inv.links = make([]i32, len(cat.pipe_tiers), context.temp_allocator)
+	inv.routers = make([]i32, len(cat.node_types), context.temp_allocator)
+	for i in 0 ..< len(inv.links) { inv.links[i] = 99 }
+	for i in 0 ..< len(inv.routers) { inv.routers[i] = 99 }
+	return inv
+}
+
+// total items in a tray (for before/after comparisons)
+inv_total :: proc(inv: Inventory) -> i32 {
+	n: i32 = 0
+	for v in inv.links { n += v }
+	for v in inv.routers { n += v }
+	return n
+}
+
+@(test)
+test_junction_demolish_severs_ALL_incident_pipes :: proc(t: ^testing.T) {
+	// Perkins r1 ghost-pipe regression: parallel pipes to the same neighbor
+	// must ALL go. E27: atomic batch, pipe-id order, refunds.
+	state := test_boot_state(t)
+	cat := state.catalogs
+	router := first_junction(state)
+	host := node_id_by_role(state, .Content_Host, 0)
+	wide, _ := tier_index(cat, "wide")
+	// two parallel wide pipes host<->router + one leg to a house
+	for _ in 0 ..< 2 {
+		_, err := topology_apply_edit(&state.topology,
+			Command{kind = Cmd_Draw_Pipe{a = host, b = router, tier = wide}}, cat, state.inventory, 0)
+		if err != .None { tfailf(t, "draw: %v", err) }
+	}
+	h1 := node_id_by_role(state, .Residential, 0)
+	_, err := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Draw_Pipe{a = router, b = h1, tier = wide}}, cat, state.inventory, 0)
+	if err != .None { tfailf(t, "draw leg: %v", err) }
+	if pipe_count(&state.topology) != 3 { tfailf(t, "pipes %d, want 3", pipe_count(&state.topology)) }
+	links_before := state.inventory.links[wide]
+	mid_t, _ := node_type_index(cat, "router_mid")
+	routers_before: i32
+	if int(mid_t) < len(state.inventory.routers) { routers_before = state.inventory.routers[mid_t] }
+
+	res, err2 := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Demolish{target = router, is_node = true}}, cat, state.inventory, 0)
+	if err2 != .None || !res.applied { tfailf(t, "demolish: %v", err2) }
+	if pipe_count(&state.topology) != 0 {
+		tfailf(t, "ghost pipes remain: %d", pipe_count(&state.topology))
+	}
+	if _, ok := node_slot(&state.topology, router); ok { tfail(t, "junction must be tombstoned") }
+	// redesign is the game: every severed link AND the router return to the tray
+	if state.inventory.links[wide] != links_before + 3 {
+		tfailf(t, "links returned: got %d, want %d", state.inventory.links[wide], links_before + 3)
+	}
+	if state.inventory.routers[mid_t] != routers_before + 1 {
+		tfailf(t, "router returned: got %d, want %d", state.inventory.routers[mid_t], routers_before + 1)
+	}
+}
+
+@(test)
+test_terminal_demolish_forbidden :: proc(t: ^testing.T) {
+	state := test_boot_state(t)
+	h1 := node_id_by_role(state, .Residential, 0)
+	if e := validate_command(&state.topology, Command{kind = Cmd_Demolish{target = h1, is_node = true}},
+		state.catalogs, state.inventory); e != .Terminal_Demolish {
+		tfailf(t, "E2: got %v", e)
+	}
+}
+
+@(test)
+test_upgrade_charges_delta_and_checks_span :: proc(t: ^testing.T) {
+	// Perkins r1: the Godot version validated the FULL new-tier price but
+	// charged the delta; and skipped the span check. Both pinned here.
+	state := test_boot_state(t)
+	cat := state.catalogs
+	router := first_junction(state)
+	h1 := node_id_by_role(state, .Residential, 0) // (8,5); router (18,14) span 13
+	narrow, _ := tier_index(cat, "narrow")
+	standard, _ := tier_index(cat, "standard")
+	wide, _ := tier_index(cat, "wide")
+	// h1->router span 13: narrow (max 10) illegal; standard (max 14) ok
+	draw_res, err := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Draw_Pipe{a = h1, b = router, tier = standard}}, cat, state.inventory, 0)
+	if err != .None { tfailf(t, "draw: %v", err) }
+	pipe := draw_res.pipe
+	// upgrade to wide (max 18) — span 13 ok; exchange: standard back, wide out
+	std_before := state.inventory.links[standard]
+	wide_before := state.inventory.links[wide]
+	_, err2 := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Upgrade_Pipe{pipe = pipe, to_tier = wide}}, cat, state.inventory, 0)
+	if err2 != .None { tfailf(t, "upgrade: %v", err2) }
+	if state.inventory.links[standard] != std_before + 1 { tfail(t, "old tier link must return to the tray") }
+	if state.inventory.links[wide] != wide_before - 1 { tfail(t, "new tier link must leave the tray") }
+	// now place a long pipe and try to DOWNGRADE into over-span:
+	// host(30,14) -> router(18,14) span 12; wide ok, standard max 14 ok too...
+	// use a fresh far pair: spawn a junction at (26,26) -> router span ~14.4->14? use wide first
+	rt, _ := node_type_index(cat, "router_basic")
+	far := spawn_node(&state.topology, rt, {30, 26}, 0, cat)
+	// router(18,14) to (30,26): dx12 dy12 span ~17
+	res3, err3 := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Draw_Pipe{a = router, b = far, tier = wide}}, cat, state.inventory, 0)
+	if err3 != .None { tfailf(t, "draw wide: %v", err3) }
+	if e := validate_command(&state.topology,
+		Command{kind = Cmd_Upgrade_Pipe{pipe = res3.pipe, to_tier = standard}}, cat, state.inventory); e != .Span_Exceeds_Tier {
+		tfailf(t, "over-span upgrade must reject: got %v", e)
+	}
+}
+
+@(test)
+test_out_of_links_rejection :: proc(t: ^testing.T) {
+	// the tray is the budget: an empty tier shelf rejects the draw
+	state := test_boot_state(t)
+	cat := state.catalogs
+	router := first_junction(state)
+	host := node_id_by_role(state, .Content_Host, 0)
+	wide, _ := tier_index(cat, "wide")
+	state.inventory.links[wide] = 0
+	if e := validate_command(&state.topology,
+		Command{kind = Cmd_Draw_Pipe{a = host, b = router, tier = wide}}, cat, state.inventory); e != .Out_Of_Links {
+		tfailf(t, "got %v, want Out_Of_Links", e)
+	}
+	// restock and the same draw validates
+	state.inventory.links[wide] = 1
+	if e := validate_command(&state.topology,
+		Command{kind = Cmd_Draw_Pipe{a = host, b = router, tier = wide}}, cat, state.inventory); e != .None {
+		tfailf(t, "restocked tray must validate, got %v", e)
+	}
+}
+
+@(test)
+test_place_router_rules :: proc(t: ^testing.T) {
+	state := test_boot_state(t)
+	cat := state.catalogs
+	basic, _ := node_type_index(cat, "router_basic")
+	res, _ := node_type_index(cat, "residential")
+	// empty router shelf rejects
+	state.inventory.routers[basic] = 0
+	if e := validate_command(&state.topology,
+		Command{kind = Cmd_Place_Router{type_idx = basic, pos = {24, 6}}}, cat, state.inventory); e != .Out_Of_Routers {
+		tfailf(t, "empty shelf: got %v, want Out_Of_Routers", e)
+	}
+	state.inventory.routers[basic] = 1
+	// a terminal type is not placeable hardware
+	if e := validate_command(&state.topology,
+		Command{kind = Cmd_Place_Router{type_idx = res, pos = {24, 6}}}, cat, state.inventory); e != .Not_A_Junction {
+		tfailf(t, "terminal type: got %v, want Not_A_Junction", e)
+	}
+	// too close to an existing node (house at (8,5))
+	if e := validate_command(&state.topology,
+		Command{kind = Cmd_Place_Router{type_idx = basic, pos = {9, 6}}}, cat, state.inventory); e != .Invalid_Placement {
+		tfailf(t, "crowded spot: got %v, want Invalid_Placement", e)
+	}
+	// out of bounds
+	if e := validate_command(&state.topology,
+		Command{kind = Cmd_Place_Router{type_idx = basic, pos = {-2, 6}}}, cat, state.inventory); e != .Invalid_Placement {
+		tfailf(t, "off-map: got %v, want Invalid_Placement", e)
+	}
+	// legal spot: applies, consumes one router, spawns a live junction
+	nodes_before := len(state.topology.node_alive)
+	plc, err := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Place_Router{type_idx = basic, pos = {24, 6}}}, cat, state.inventory, 7)
+	if err != .None || !plc.applied { tfailf(t, "place: %v", err) }
+	if state.inventory.routers[basic] != 0 { tfail(t, "placement must consume the router") }
+	if len(state.topology.node_alive) != nodes_before + 1 { tfail(t, "node must spawn") }
+	ns, ok := node_slot(&state.topology, plc.pipe) // Edit_Result.pipe carries the new id
+	if !ok || !state.topology.node_alive[ns] { tfail(t, "placed router must be live") }
+	if state.topology.node_spawn_tick[ns] != 7 { tfail(t, "spawn tick must be the apply tick") }
+}
+
+@(test)
+test_batch_validate_all_then_apply :: proc(t: ^testing.T) {
+	// E23: one bad command rejects the WHOLE batch with no partial mutation.
+	state := test_boot_state(t)
+	cat := state.catalogs
+	router := first_junction(state)
+	host := node_id_by_role(state, .Content_Host, 0)
+	h1 := node_id_by_role(state, .Residential, 0)
+	wide, _ := tier_index(cat, "standard")
+	cmds := []Command{
+		{kind = Cmd_Draw_Pipe{a = host, b = router, tier = wide}},
+		{kind = Cmd_Draw_Pipe{a = h1, b = h1, tier = wide}}, // self-loop
+	}
+	pipes_before := pipe_count(&state.topology)
+	tray_before := inv_total(state.inventory)
+	err := topology_apply_all(&state.topology, cmds, cat, state.inventory, 0)
+	if err == .None { tfail(t, "batch must reject") }
+	if pipe_count(&state.topology) != pipes_before { tfail(t, "E23: partial mutation happened") }
+	if inv_total(state.inventory) != tray_before { tfail(t, "E23: the tray moved") }
+}
+
+@(test)
+test_batch_running_inventory_and_intrabatch_deps :: proc(t: ^testing.T) {
+	// E23 hardened: the batch validates against a running tray (no count goes
+	// negative) and each command sees the prior commands' effects.
+	state := test_boot_state(t)
+	cat := state.catalogs
+	router := first_junction(state)
+	host := node_id_by_role(state, .Content_Host, 0)
+	wide, _ := tier_index(cat, "wide")
+	// two wide draws but only ONE wide link on the shelf -> the pair rejects
+	state.inventory.links[wide] = 1
+	cmds := []Command{
+		{kind = Cmd_Draw_Pipe{a = host, b = router, tier = wide}},
+		{kind = Cmd_Draw_Pipe{a = host, b = router, tier = wide}},
+	}
+	pipes_before := pipe_count(&state.topology)
+	err := topology_apply_all(&state.topology, cmds, cat, state.inventory, 0)
+	if err != .Out_Of_Links { tfailf(t, "running tray: got %v, want Out_Of_Links", err) }
+	if pipe_count(&state.topology) != pipes_before { tfail(t, "rejected batch must not partially apply") }
+	state.inventory.links[wide] = 8 // restock for the rest of the test
+	// intra-batch dependency: draw then prioritize the new pipe in one batch
+	rt, _ := node_type_index(cat, "router_basic")
+	j2 := spawn_node(&state.topology, rt, {24, 20}, 0, cat)
+	// first, learn the id the draw will get: next_pipe_id
+	new_pipe := state.topology.next_pipe_id
+	batch := []Command{
+		{kind = Cmd_Draw_Pipe{a = j2, b = router, tier = wide}},
+		{kind = Cmd_Set_Pipe_Priority{pipe = new_pipe, priority = 1}},
+	}
+	err2 := topology_apply_all(&state.topology, batch, cat, state.inventory, 0)
+	if err2 != .None { tfailf(t, "draw+priority batch: %v", err2) }
+	ps, ok := pipe_slot(&state.topology, new_pipe)
+	if !ok { tfail(t, "pipe must exist") }
+	if state.topology.pipe_priority[ps] != 1 { tfail(t, "priority must land on the same-batch pipe") }
+	// demolish + redraw in one batch must not corrupt (the hunter's W6 case)
+	junctions := first_junction(state)
+	batch2 := []Command{
+		{kind = Cmd_Demolish{target = junctions, is_node = true}},
+		{kind = Cmd_Draw_Pipe{a = j2, b = junctions, tier = wide}}, // must reject: node gone
+	}
+	pipes_before2 := pipe_count(&state.topology)
+	err3 := topology_apply_all(&state.topology, batch2, cat, state.inventory, 0)
+	if err3 == .None { tfail(t, "demolish+draw-to-dead-node must reject") }
+	if pipe_count(&state.topology) != pipes_before2 { tfail(t, "rejected batch mutated state") }
+}
