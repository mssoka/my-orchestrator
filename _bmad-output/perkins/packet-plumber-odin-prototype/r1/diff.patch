+@(test)
+test_severance_reroute_or_drop :: proc(t: ^testing.T) {
+	// E1: demolishing an in-flight pipe reroutes via an alternative path, or
+	// drops with Severance when none exists.
+	state := test_boot_state(t)
+	cat := state.catalogs
+	wide, _ := tier_index(cat, "wide")
+	host := node_id_by_role(state, .Content_Host, 0)
