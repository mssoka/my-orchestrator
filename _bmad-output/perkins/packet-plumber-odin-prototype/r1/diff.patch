+++ b/core/types.odin
@@ -0,0 +1,56 @@
+package core
+
+// types.odin — shared enums and small value types for the sim core.
+// Pure data; no behavior. Naming per project-context (Ada_Case types).
+
+// The 3 DiffServ lanes (ODN-3). Order is load-bearing: the contention drop
+// ladder (E9) sheds Best first; serialization serves Express first.
+Lane :: enum u8 { Express = 0, Standard = 1, Best = 2 }
+LANE_COUNT :: 3
+
+Node_Kind :: enum u8 { Terminal = 0, Junction = 1 }
+
+// Terminal roles (typed demand selectors). `none` for junctions.
+Terminal_Role :: enum i32 {
+	None         = -1,
+	Residential  = 0,
+	Content_Host = 1,
+}
+
+// Node health states — the warning surface (GDD § M5). Never color alone in
+// the view (ring pulse + icon pair with the state).
+Health_State :: enum u8 { Healthy = 0, Strained = 1, Critical = 2 }
+
+Drop_Reason :: enum u8 {
+	None = 0,
+	Queue_Overflow,  // per-lane backlog beyond the catalog depth sheds newest-first
+	Unreachable,     // no route at spawn/advance time (E28 accrues as SLA-undelivered)
+	Severance,       // pipe demolished under the packet, no reroute (E1)
+	Pool_Exhaustion, // global pool cap hit (E22)
+}
+
+Edit_Error :: enum u8 {
+	None = 0,
+	Self_Loop,
+	Missing_Node,
+	Missing_Pipe,
+	Missing_Junction,
+	Not_A_Junction,
+	Terminal_To_Terminal, // E26 — the 'play the internet' topology rule
+	Terminal_Demolish,    // E2
+	Router_Ports_Full,    // canon #14: one port per connected pipe
+	Span_Exceeds_Tier,
+	Over_Budget,
+	Unknown_Tier,
+	Negative_Weight,
+	Invalid_Weights, // over MAX_WEIGHT
+	Invalid_Triage,
+	Unknown_Command,
+}
+
+Edit_Result :: struct {
+	applied: bool,
+	pipe:    u32, // meaningful when applied && the command was a draw
+}
+
+App_Mode :: enum u8 { Boot, Menu, Run, Paused, Game_Over }
