+submit_c :: proc(state: ^Run_State, cmd: Command, tick: u64) {
+	nb, _, err := topology_apply_edit(&state.topology, cmd, state.catalogs, state.budget, tick + 1)
+	if err == .None { state.budget = nb }
+}
