-	add_child(timer)
-	timer.start()
-	
-	# Initial scan of open scenes
-	_update_watched_files()
-	
-	print("[Godot MCP - AutoReload] Plugin activated - watching for external changes")
-
-func _exit_tree() -> void:
-	if timer:
-		timer.stop()
