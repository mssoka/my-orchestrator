+package main
+
+// app/main.odin - the game executable (architecture §9.3/§9.5): window, raw
+// input -> validated Commands (ODN-12), the App/mode FSM (ODN-13), event
+// drain -> toasts + stings (ODN-14/15). Mouse-only prototype, desktop-first
+// (user rulings 2026-08-08). The sim never sees wall clock; the view never
+// touches the sim.
+
+import "core:crypto"
+import "core:fmt"
+import "core:mem"
+import rl "vendor:raylib"
+import pp "../core"
+import rnd "./render"
+import prun "./run"
+
+App :: struct {
+	mode:       prun.App_Mode,
+	catalogs:   ^pp.Catalogs,
+	palette:    rnd.Palette,
+	view:       rnd.View,
+	rc:         prun.Run_Context,
+	map_gen:    rnd.Map_Gen,
+	seed:       u64,
+	sel:        rnd.Selection,
+	drag:       rnd.Drag_State,
+	press:      rl.Vector2,
+	press_node: u32,
+	press_valid: bool,
+	hint:       string,
+	hint_until: i64,
+	onboarding: bool,
+	autopilot:  bool,
+	autopilot_wired: map[u32]bool,
+	tier:       u16,
+	sting_crisis: rl.Sound,
+	sting_win:    rl.Sound,
+	audio_ok:   bool,
+	cosmetic_rng: pp.Rng, // ODN-15 - cosmetics only, never the sim's
+}
+
+main :: proc() {
+	app: App
+	app.mode = .Boot
+
+	catalogs, cerr := prun.load_catalogs("data")
+	if cerr.file != "" {
+		fmt.eprintln(pp.catalog_error_string(cerr))
+		return
+	}
+	app.catalogs = catalogs
+	app.palette = rnd.palette_load()
+	// packet colors mirror the catalog (cosmetic)
+	for pt, i in catalogs.packet_types {
+		app.palette.packet[i] = {pt.color[0], pt.color[1], pt.color[2], pt.color[3]}
+	}
+
+	rl.SetConfigFlags({.WINDOW_RESIZABLE, .MSAA_4X_HINT})
+	rl.InitWindow(1280, 720, "Packet Plumber - Odin prototype")
+	rl.SetTargetFPS(60)
+	app.view.palette = &app.palette
+	app.view.catalogs = catalogs
+	app.view.font = load_hud_font()
+	pp.rng_seed(&app.cosmetic_rng, fresh_seed() ~ 0xC05E)
+
+	app.audio_ok = init_audio(&app)
+	start_run(&app)
+
+	for !rl.WindowShouldClose() {
+		frame_ms := i64(rl.GetTime() * 1000)
+		free_all(context.temp_allocator) // frame arena discipline (ODN-18)
+		handle_input(&app, frame_ms)
+		dt := rl.GetFrameTime()
+		if app.autopilot && !app.rc.paused && !app.rc.ended {
+			prun.autopilot_tick(&app.rc)
+		}
+		prun.run_update(&app.rc, f64(dt))
+		drain_events(&app, frame_ms)
+		draw_frame(&app, frame_ms)
+	}
+	if app.audio_ok {
+		rl.UnloadSound(app.sting_crisis)
+		rl.UnloadSound(app.sting_win)
+		rl.CloseAudioDevice()
+	}
+	if rl.IsFontValid(app.view.font) && app.view.font.texture.id != rl.GetFontDefault().texture.id {
+		rl.UnloadFont(app.view.font)
+	}
+	prun.run_context_destroy(&app.rc)
+	rl.CloseWindow()
+}
+
+fresh_seed :: proc() -> u64 {
+	// E32: fresh-run seeds from app-layer OS entropy - never the sim rng.
+	b: [8]u8
+	crypto.rand_bytes(b[:])
+	v: u64
+	for i in 0 ..< 8 { v |= u64(b[i]) << (8 * uint(i)) }
+	return v
+}
+
+start_run :: proc(app: ^App) {
+	if app.rc.state != nil {
+		prun.run_context_destroy(&app.rc)
+	}
+	app.seed = fresh_seed()
+	prun.run_context_create(&app.rc, app.seed, app.catalogs)
+	app.map_gen = rnd.map_generate(app.seed, app.view.world_w == 0 ? 1040 : app.view.world_w, app.view.world_h == 0 ? 780 : app.view.world_h)
+	app.sel = {}
+	app.drag = {}
+	app.onboarding = true
+	app.rc.paused = true // the briefing card is up
+	app.autopilot = false
+	clear(&app.autopilot_wired)
+	app.tier = 1 // standard
+	app.mode = .Run
+}
+
+// --- input ---------------------------------------------------------------------
+
+handle_input :: proc(app: ^App, frame_ms: i64) {
+	if rl.IsWindowResized() {
+		rnd.view_compute(&app.view, rl.GetScreenWidth(), rl.GetScreenHeight(), &app.catalogs.balance)
+	}
+	if app.view.scale == 0 {
+		rnd.view_compute(&app.view, rl.GetScreenWidth(), rl.GetScreenHeight(), &app.catalogs.balance)
+	}
+	mouse := rl.GetMousePosition()
+	wx, wy := rnd.from_screen(&app.view, mouse.x, mouse.y)
+
+	// onboarding dismiss consumes the click entirely (Perkins r1: the Godot
+	// prototype let the same click start a phantom drag / draw a pipe)
+	if app.onboarding {
+		if rl.IsMouseButtonPressed(.LEFT) || rl.IsKeyPressed(.SPACE) {
+			app.onboarding = false
+			app.rc.paused = false
+		}
+		return
+	}
+
+	if app.rc.ended {
+		if rl.IsMouseButtonPressed(.LEFT) || rl.IsKeyPressed(.R) {
+			start_run(app)
+		}
+		return
+	}
+
+	if rl.IsKeyPressed(.SPACE) {
+		app.rc.paused = !app.rc.paused
+	}
+	if rl.IsKeyPressed(.R) {
+		start_run(app)
+		return
+	}
+	if rl.IsKeyPressed(.A) {
+		app.autopilot = !app.autopilot
+		if app.autopilot {
+			prun.autopilot_boot(&app.rc)
+			for i in 0 ..< len(app.rc.state.topology.node_alive) {
+				app.autopilot_wired[app.rc.state.topology.node_id[i]] = true
+			}
+			set_hint(app, "autopilot ON - the demo build plays itself", frame_ms)
+		}
+	}
+	if rl.IsKeyPressed(.ONE)   { app.tier = tier_by_name(app, "narrow") }
+	if rl.IsKeyPressed(.TWO)   { app.tier = tier_by_name(app, "standard") }
+	if rl.IsKeyPressed(.THREE) { app.tier = tier_by_name(app, "wide") }
+	if rl.IsKeyPressed(.ESCAPE) {
+		app.sel = {}
+		app.drag.active = false
+	}
+
+	// hover affordance for pipes
+	app.sel.hover_pipe = 0
+	if pid, ok := prun.nearest_pipe(&app.rc, f64(wx), f64(wy), 12); ok {
+		app.sel.hover_pipe = pid
+	}
+
+	// right-click a pipe: cycle its QoS priority (the fast dial)
+	if rl.IsMouseButtonPressed(.RIGHT) {
+		if pid, ok := prun.nearest_pipe(&app.rc, f64(wx), f64(wy), 12); ok {
+			cycle_priority(app, pid, frame_ms)
+		} else if nid, ok2 := prun.snap_node(&app.rc, f64(wx), f64(wy)); ok2 {
+			// right-click a router: same inspect popover (discoverability)
+			slot := app.rc.state.topology.node_by_id[nid]
+			if app.rc.state.topology.node_kind[slot] == .Junction {
+				app.sel = {node = nid}
+				app.drag = {}
+			}
+		}
+	}
+
+	// left press: popover buttons first (they swallow the click)
+	if rl.IsMouseButtonPressed(.LEFT) {
+		app.press = mouse
+		app.press_node = 0
+		app.press_valid = false
+		if popover_click(app, mouse, frame_ms) {
+			return // swallowed
+		}
+		if nid, ok := prun.snap_node(&app.rc, f64(wx), f64(wy)); ok {
+			app.press_node = nid
+			app.press_valid = true
+			app.drag.active = true
+			app.drag.from_node = nid
+		}
+	}
+	if app.drag.active {
+		app.drag.wx = wx
+		app.drag.wy = wy
+		// live ghost validity + cost
+		app.drag.valid = .None
+		app.drag.cost = 0
+		if target, ok := prun.snap_node(&app.rc, f64(wx), f64(wy)); ok && target != app.drag.from_node {
+			cmd := pp.Command{kind = pp.Cmd_Draw_Pipe{a = app.drag.from_node, b = target, tier = app.tier}}
+			app.drag.valid = prun.bus_preview(&app.rc, cmd)
+			if app.drag.valid == .None {
+				sa := app.rc.state.topology.node_by_id[app.drag.from_node]
+				sb := app.rc.state.topology.node_by_id[target]
+				span := pp.span_between(app.rc.state.topology.node_pos[sa], app.rc.state.topology.node_pos[sb])
+				app.drag.cost = pp.draw_cost(span, app.catalogs.pipe_tiers[app.tier].cost_per_tile)
+			}
+		}
+	}
+	if rl.IsMouseButtonReleased(.LEFT) && app.drag.active {
+		app.drag.active = false
+		moved := rl.Vector2Distance(mouse, app.press) > 6
+		if target, ok := prun.snap_node(&app.rc, f64(wx), f64(wy)); ok {
+			if target != app.press_node {
+				cmd := pp.Command{kind = pp.Cmd_Draw_Pipe{a = app.press_node, b = target, tier = app.tier}}
+				if err := prun.bus_submit(&app.rc, cmd); err != .None {
+					set_hint(app, reject_copy(err), frame_ms)
+				}
+				return
+			}
+		}
+		if !moved {
+			// a click, not a drag: select
+			handle_click_select(app, mouse, frame_ms)
+		}
+	}
+}
+
+handle_click_select :: proc(app: ^App, mouse: rl.Vector2, frame_ms: i64) {
+	wx, wy := rnd.from_screen(&app.view, mouse.x, mouse.y)
+	if nid, ok := prun.snap_node(&app.rc, f64(wx), f64(wy)); ok {
+		slot := app.rc.state.topology.node_by_id[nid]
+		if app.rc.state.topology.node_kind[slot] == .Junction {
+			app.sel = {node = nid}
+			app.drag = {}
+			return
+		}
+	}
+	if pid, ok := prun.nearest_pipe(&app.rc, f64(wx), f64(wy), 10); ok {
+		app.sel = {pipe = pid}
+		app.drag = {}
+		return
+	}
+	app.sel = {} // empty ground closes the popover
+}
+
+// popover buttons; returns true when the click was swallowed by a popover
+popover_click :: proc(app: ^App, mouse: rl.Vector2, frame_ms: i64) -> bool {
+	if app.sel.node != 0 {
+		anchor := anchor_of_node(app, app.sel.node)
+		pop := rnd.popover_rect(&app.view, anchor)
+		labels := [3]string{"none", "stream", "email"}
+		for i in 0 ..< 3 {
+			r := rnd.triage_button_rect(pop, i)
+			if rl.CheckCollisionPointRec(mouse, r) {
+				triage := i32(i - 1)
+				err := prun.bus_submit(&app.rc, pp.Command{kind = pp.Cmd_Set_Junction_Triage{
+					junction = app.sel.node, triage = triage}})
+				if err != .None {
+					set_hint(app, reject_copy(err), frame_ms)
+				} else {
+					set_hint(app, "triage set - that class wins contention here", frame_ms)
+				}
+				return true
+			}
+		}
+		if rl.CheckCollisionPointRec(mouse, pop) { return true }
+		return false
+	}
+	if app.sel.pipe != 0 {
+		anchor := anchor_of_pipe(app, app.sel.pipe)
+		pop := rnd.popover_rect(&app.view, anchor)
+		if rl.CheckCollisionPointRec(mouse, rnd.pipe_button_rect(pop, 0)) {
+			cycle_priority(app, app.sel.pipe, frame_ms)
+			return true
+		}
+		if rl.CheckCollisionPointRec(mouse, rnd.pipe_button_rect(pop, 1)) {
+			err := prun.bus_submit(&app.rc, pp.Command{kind = pp.Cmd_Demolish{target = app.sel.pipe, is_node = false}})
+			if err != .None {
+				set_hint(app, reject_copy(err), frame_ms)
+			} else {
+				set_hint(app, "pipe demolished - refund banked", frame_ms)
+			}
+			app.sel = {}
+			return true
+		}
+		if rl.CheckCollisionPointRec(mouse, {pop.x, pop.y, pop.width, rnd.POPOVER_H_PIPE}) { return true }
+		return false
+	}
+	return false
+}
+
+anchor_of_node :: proc(app: ^App, id: u32) -> rl.Vector2 {
+	slot := app.rc.state.topology.node_by_id[id]
+	return rnd.node_screen(&app.view, app.rc.state.topology.node_pos[slot])
+}
+
+anchor_of_pipe :: proc(app: ^App, id: u32) -> rl.Vector2 {
+	slot := app.rc.state.topology.pipe_by_id[id]
+	pa := app.rc.state.topology.node_by_id[app.rc.state.topology.pipe_a[slot]]
+	pb := app.rc.state.topology.node_by_id[app.rc.state.topology.pipe_b[slot]]
+	a := rnd.node_screen(&app.view, app.rc.state.topology.node_pos[pa])
+	b := rnd.node_screen(&app.view, app.rc.state.topology.node_pos[pb])
+	return {(a.x + b.x) / 2, (a.y + b.y) / 2}
+}
+
+cycle_priority :: proc(app: ^App, pipe: u32, frame_ms: i64) {
+	slot, ok := app.rc.state.topology.pipe_by_id[pipe]
+	if !ok { return }
+	cur := app.rc.state.topology.pipe_priority[slot]
+	next: i32 = 0 if cur < 0 else (1 if cur == 0 else -1)
+	err := prun.bus_submit(&app.rc, pp.Command{kind = pp.Cmd_Set_Pipe_Priority{pipe = pipe, priority = next}})
+	if err != .None {
+		set_hint(app, reject_copy(err), frame_ms)
+		return
+	}
+	if next < 0 {
+		set_hint(app, "pipe neutral - everything rides Standard", frame_ms)
+	} else {
+		name := app.catalogs.packet_types[next].display
+		set_hint(app, fmt.tprintf("%s gets the Express lane on this pipe", name), frame_ms)
+	}
+}
+
+tier_by_name :: proc(app: ^App, name: string) -> u16 {
+	idx, _ := pp.tier_index(app.catalogs, name)
+	return idx
+}
+
+// --- events -> toasts + stings (ODN-14/15) ---------------------------------------
+
+drain_events :: proc(app: ^App, frame_ms: i64) {
+	for e in app.rc.state.events {
+		#partial switch k in e.kind {
+		case pp.Ev_Crisis_Triggered:
+			set_hint(app, "YOU_TUNE: 10x SURGE - hold the pipes", frame_ms, 6000)
+			if app.audio_ok { rl.PlaySound(app.sting_crisis) }
+		case pp.Ev_Forecast_Issued:
+			if app.audio_ok { rl.PlaySound(app.sting_crisis) }
+		case pp.Ev_Run_Won:
+			if app.audio_ok { rl.PlaySound(app.sting_win) }
+		case pp.Ev_Run_Lost:
+			if app.audio_ok { rl.PlaySound(app.sting_crisis) }
+		case pp.Ev_Warning_Raised:
+			if k.level == .Critical {
+				set_hint(app, "a router is CRITICAL - reroute or widen its pipes", frame_ms, 3500)
+			}
+		}
+	}
+	clear(&app.rc.state.events)
+}
+
+set_hint :: proc(app: ^App, msg: string, frame_ms: i64, ttl_ms: i64 = 2600) {
+	app.hint = msg
+	app.hint_until = frame_ms + ttl_ms
+}
+
+reject_copy :: proc(err: pp.Edit_Error) -> string {
+	switch err {
+	case .Self_Loop: return "that pipe goes nowhere (literally)"
+	case .Terminal_To_Terminal: return "houses don't talk to houses - go through a router"
+	case .Span_Exceeds_Tier: return "that tier can't reach - upgrade or hop a router"
+	case .Over_Budget: return "budget's dry - demolish something for the refund"
+	case .Router_Ports_Full: return "that router is out of ports - free one or mesh onward"
+	case .Terminal_Demolish: return "you can't demolish a neighborhood"
+	case .Missing_Node, .Missing_Pipe, .Missing_Junction: return "gone already"
+	case .Not_A_Junction: return "triage lives on routers"
+	case .Unknown_Tier, .Unknown_Command: return "unknown hardware"
+	case .Negative_Weight: return "negative bandwidth isn't a thing"
+	case .Invalid_Weights: return "those weights exceed hardware limits"
+	case .Invalid_Triage: return "no such traffic class"
+	case .None: return ""
+	}
+	return "nope."
+}
+
+// --- the frame -------------------------------------------------------------------
+
+draw_frame :: proc(app: ^App, frame_ms: i64) {
+	rl.BeginDrawing()
+	hint := app.hint
+	if frame_ms > app.hint_until { hint = "" }
+	rnd.draw_world(&app.view, &app.rc.snapshot, &app.map_gen, frame_ms, app.sel, app.drag)
+	if app.sel.node != 0 {
+		pop := rnd.popover_rect(&app.view, anchor_of_node(app, app.sel.node))
+		rnd.draw_router_popover(&app.view, &app.rc.snapshot, app.sel.node, pop, {"none", "stream", "email"})
+	}
+	if app.sel.pipe != 0 {
+		pop := rnd.popover_rect(&app.view, anchor_of_pipe(app, app.sel.pipe))
+		rnd.draw_pipe_popover(&app.view, &app.rc.snapshot, app.sel.pipe, pop)
+	}
+	rnd.draw_hud(&app.view, &app.rc.snapshot, rnd.Hud_State{
+		hint = hint, onboarding = app.onboarding, time_ms = frame_ms, seed = app.seed,
+	})
+	rl.EndDrawing()
+}
+
+// the HUD font: raylib's bitmap default is illegible at HUD sizes — load a
+// system TTF (placeholder doctrine allows system fonts; the HARNESS stays on
+// the embedded default so goldens stay bit-exact on every platform).
+load_hud_font :: proc() -> rl.Font {
+	candidates := [?]string{
+		"/System/Library/Fonts/Geneva.ttf",                  // macOS
+		"/System/Library/Fonts/Helvetica.ttc",
+		"/System/Library/Fonts/Menlo.ttc",
+		"/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",   // Linux
+		"/usr/share/fonts/dejavu/DejaVuSans.ttf",
+		"C:\\Windows\\Fonts\\segoeui.ttf",               // Windows
+		"C:\\Windows\\Fonts\\arial.ttf",
+	}
+	for path in candidates {
+		f := rl.LoadFontEx(fmt.ctprintf("%s", path), 64, nil, 400)
+		if rl.IsFontValid(f) {
+			rl.SetTextureFilter(f.texture, .BILINEAR)
+			return f
+		}
+	}
+	return rl.GetFontDefault()
+}
diff --git a/app/render/hud.odin b/app/render/hud.odin
new file mode 100644
index 0000000..cbc3180
--- /dev/null
+++ b/app/render/hud.odin
@@ -0,0 +1,320 @@
+package render
+
+// hud.odin - the HUD chrome (architecture §9.2, art §8): the map IS the UI;
+// the HUD adds only what the map cannot show at scale - Network Health meter,
+// SLA chips, budget, forecast ("weather report"), alerts, and the win/lose
+// lockups. Screen space; reads only the snapshot + app-provided ui state.
+
+import pp "../../core"
+import rl "vendor:raylib"
+
+Hud_State :: struct {
+	hint:        string,  // transient rejection/UX hint (typed errors -> copy)
+	onboarding:  bool,
+	time_ms:     i64,
+	seed:        u64,
+}
+
+// the satirical-brand alert voice (narrative L2 leads on screen)
+forecast_copy :: proc(sp_name: string) -> string {
+	return "YOU_TUNE TRAFFIC INCOMING"
+}
+
+draw_hud :: proc(v: ^View, snap: ^pp.Snapshot, hud: Hud_State) {
+	p := v.palette
+	draw_health_meter(v, snap)
+	draw_sla_chips(v, snap)
+	// budget, top-right
+	{
+		buf: [64]u8
+		txt := fmt_bprintf(buf[:], "BUDGET %d", int(snap.budget))
+		draw_text_right(v, txt, {f32(v.win_w) - 18, 14}, 17, p.ink)
+	}
+	// era stamp, top-left
+	{
+		buf: [64]u8
+		txt := fmt_bprintf(buf[:], "ERA 3 - THE STREAMING SURGE", 0)
+		draw_text(v, txt, {18, 14}, 15, p.ink_soft)
+	}
+	if snap.surge_active {
+		draw_surge_banner(v, snap)
+	} else if len(snap.forecasts) > 0 {
+		draw_forecast(v, snap)
+	}
+	if len(hud.hint) > 0 {
+		w := measure(v, hud.hint, 16)
+		panel(v, {f32(v.win_w)/2 - w/2 - 14, f32(v.win_h) - 52, w + 28, 32})
+		draw_text(v, hud.hint, {f32(v.win_w)/2 - w/2, f32(v.win_h) - 44}, 16, p.ink)
+	}
+	if snap.won { draw_win_overlay(v, snap) }
+	if snap.lost { draw_lose_overlay(v, snap) }
+	if hud.onboarding { draw_onboarding(v) }
+}
+
+draw_health_meter :: proc(v: ^View, snap: ^pp.Snapshot) {
+	p := v.palette
+	w := f32(320)
+	h := f32(18)
+	x := (f32(v.win_w) - w) / 2
+	y := f32(14)
+	panel(v, {x - 12, y - 6, w + 24, h + 30})
+	label_w := measure(v, "NETWORK HEALTH", 13)
+	draw_text(v, "NETWORK HEALTH", {x + (w - label_w) / 2, y + h + 8}, 13, p.ink_soft)
+	rl.DrawRectangleV({x, y}, {w, h}, rl.Color{210, 198, 170, 255})
+	fill := w * f32(snap.meter_pct) / 100
+	col := p.state_healthy
+	if snap.meter_pct < 35 { col = p.state_critical } else if snap.meter_pct < 70 { col = p.state_strain }
+	rl.DrawRectangleV({x, y}, {fill, h}, col)
+	rl.DrawRectangleLinesEx({x, y, w, h}, 1.5, p.chrome_border)
+	// grace countdown pip
+	if snap.in_grace {
+		buf: [32]u8
+		secs := snap.grace_ticks_left * i32(v.catalogs.balance.logic_hz)
+		_ = secs
+		txt := fmt_bprintf(buf[:], "!", 0)
+		draw_text(v, txt, {x + w + 8, y}, 18, p.state_critical)
+	}
+}
+
+draw_sla_chips :: proc(v: ^View, snap: ^pp.Snapshot) {
+	p := v.palette
+	y := f32(40)
+	for cls, i in snap.classes {
+		pt := v.catalogs.packet_types[i]
+		chip := rl.Rectangle{18, y, 150, 34}
+		panel(v, chip)
+		draw_class_shape(v, i32(i), {chip.x + 16, chip.y + 17}, 6, p.packet[i])
+		up := cls.uptime_pct
+		buf: [48]u8
+		txt: string
+		if up < 0 {
+			txt = fmt_bprintf(buf[:], " idle", 0)
+		} else {
+			txt = fmt_bprintf(buf[:], " %d%% up", int(up))
+		}
+		col := p.state_healthy
+		if up >= 0 && up < 90 { col = p.state_strain }
+		if up >= 0 && up < 70 { col = p.state_critical }
+		draw_text(v, pt.display, {chip.x + 30, chip.y + 4}, 13, p.ink)
+		draw_text(v, txt, {chip.x + 30, chip.y + 18}, 13, col)
+		y += 40
+	}
+}
+
+draw_forecast :: proc(v: ^View, snap: ^pp.Snapshot) {
+	p := v.palette
+	hz := v.catalogs.balance.logic_hz
+	for fc in snap.forecasts {
+		secs := i32(fc.ticks_until) / hz
+		w := f32(300)
+		rect := rl.Rectangle{18, f32(v.win_h) - 96, w, 66}
+		// pulsing amber edge (the warning channel)
+		panel(v, rect)
+		rl.DrawRectangleLinesEx(rect, 2, p.state_strain)
+		draw_text(v, "FORECAST", {rect.x + 12, rect.y + 8}, 12, p.ink_soft)
+		draw_text(v, forecast_copy(""), {rect.x + 12, rect.y + 22}, 15, p.ink)
+		buf: [32]u8
+		txt := fmt_bprintf(buf[:], "~%ds out - build capacity NOW", int(secs))
+		draw_text(v, txt, {rect.x + 12, rect.y + 42}, 14, p.state_strain)
+	}
+}
+
+draw_surge_banner :: proc(v: ^View, snap: ^pp.Snapshot) {
+	p := v.palette
+	hz := v.catalogs.balance.logic_hz
+	w := f32(360)
+	rect := rl.Rectangle{f32(v.win_w)/2 - w/2, 56, w, 40}
+	panel(v, rect)
+	rl.DrawRectangleLinesEx(rect, 2, p.state_critical)
+	draw_text(v, "SURGE ACTIVE - YOU_TUNE IS 10x", {rect.x + 14, rect.y + 7}, 15, p.state_critical)
+	buf: [32]u8
+	txt := fmt_bprintf(buf[:], "ends in %ds", int(snap.surge_ends_in) / int(hz))
+	draw_text(v, txt, {rect.x + 14, rect.y + 24}, 13, p.ink_soft)
+}
+
+draw_win_overlay :: proc(v: ^View, snap: ^pp.Snapshot) {
+	p := v.palette
+	w, h := f32(430), f32(190)
+	rect := rl.Rectangle{f32(v.win_w)/2 - w/2, f32(v.win_h)/2 - h/2, w, h}
+	panel(v, rect)
+	rl.DrawRectangleLinesEx(rect, 2.5, p.state_healthy)
+	title := "THE INTERNET HOLDS"
+	tw := measure(v, title, 24)
+	draw_text(v, title, {rect.x + (w - tw)/2, rect.y + 18}, 24, p.state_healthy)
+	sub := "the surge recedes - gauges swing green"
+	sw := measure(v, sub, 14)
+	draw_text(v, sub, {rect.x + (w - sw)/2, rect.y + 52}, 14, p.ink_soft)
+	buf: [96]u8
+	stats := fmt_bprintf(buf[:], "delivered %d · dropped %d", int(snap.delivered_total), int(snap.dropped_total))
+	stw := measure(v, stats, 15)
+	draw_text(v, stats, {rect.x + (w - stw)/2, rect.y + 86}, 15, p.ink)
+	hint := "press R (or click) for a fresh seed"
+	hw := measure(v, hint, 14)
+	draw_text(v, hint, {rect.x + (w - hw)/2, rect.y + 128}, 14, p.ink_soft)
+}
+
+draw_lose_overlay :: proc(v: ^View, snap: ^pp.Snapshot) {
+	p := v.palette
+	// bleach-to-white (art §8.5): the vivid field washes flat, then the lockup
+	rl.DrawRectangle(0, 0, v.win_w, v.win_h, rl.Color{p.canvas_wash.r, p.canvas_wash.g, p.canvas_wash.b, 215})
+	w, h := f32(430), f32(200)
+	rect := rl.Rectangle{f32(v.win_w)/2 - w/2, f32(v.win_h)/2 - h/2, w, h}
+	panel(v, rect)
+	rl.DrawRectangleLinesEx(rect, 2.5, p.state_critical)
+	title := "ERROR 404"
+	tw := measure(v, title, 34)
+	draw_text(v, title, {rect.x + (w - tw)/2, rect.y + 16}, 34, p.state_critical)
+	sub := "the internet went down on your watch"
+	sw := measure(v, sub, 14)
+	draw_text(v, sub, {rect.x + (w - sw)/2, rect.y + 62}, 14, p.ink_soft)
+	quote := "\"Network's gone down... it happens, engineer.\""
+	qw := measure(v, quote, 13)
+	draw_text(v, quote, {rect.x + (w - qw)/2, rect.y + 92}, 13, p.ink_faint)
+	buf: [96]u8
+	stats := fmt_bprintf(buf[:], "survived %ds · delivered %d", int(snap.tick) / int(v.catalogs.balance.logic_hz), int(snap.delivered_total))
+	stw := measure(v, stats, 15)
+	draw_text(v, stats, {rect.x + (w - stw)/2, rect.y + 122}, 15, p.ink)
+	hint := "press R (or click) to pull it back together"
+	hw := measure(v, hint, 14)
+	draw_text(v, hint, {rect.x + (w - hw)/2, rect.y + 156}, 14, p.ink_soft)
+}
+
+draw_onboarding :: proc(v: ^View) {
+	p := v.palette
+	w, h := f32(520), f32(250)
+	rect := rl.Rectangle{f32(v.win_w)/2 - w/2, f32(v.win_h)/2 - h/2, w, h}
+	panel(v, rect)
+	rl.DrawRectangleLinesEx(rect, 2, p.ink_soft)
+	title := "PACKET PLUMBER - EARLY ODIN PROTOTYPE"
+	tw := measure(v, title, 19)
+	draw_text(v, title, {rect.x + (w - tw)/2, rect.y + 16}, 19, p.ink)
+	lines := [?]string{
+		"Drag house -> router -> host to lay pipes (1/2/3 = tier).",
+		"A streaming surge is coming - watch the forecast.",
+		"One pipe is never enough for 10x. Build wide. Build double.",
+		"Right-click a pipe to give streaming the Express lane.",
+		"Click a router to inspect ports + set triage.",
+		"WIN: hold 90% uptime through the surge.",
+		"LOSE: the Network Health meter empties - Error 404.",
+	}
+	y := rect.y + 52
+	for line, i in lines {
+		col := p.ink_soft
+		if i == 6 { col = p.state_critical }
+		if i == 5 { col = p.state_healthy }
+		draw_text(v, line, {rect.x + 26, y}, 14, col)
+		y += 24
+	}
+	go := "click anywhere to take the shift"
+	gw := measure(v, go, 14)
+	draw_text(v, go, {rect.x + (w - gw)/2, rect.y + h - 26}, 14, p.ink)
+}
+
+// --- popover (progressive disclosure, UX-DR1) -----------------------------------
+// Layout is owned HERE so the app and any capture agree on the rects.
+
+POPOVER_W :: 210
+POPOVER_H_ROUTER :: 148
+POPOVER_H_PIPE :: 118
+
+popover_rect :: proc(v: ^View, anchor: rl.Vector2) -> rl.Rectangle {
+	x := anchor.x + 18
+	y := anchor.y - 20
+	if x + POPOVER_W > f32(v.win_w) { x = anchor.x - POPOVER_W - 18 }
+	if x < 8 { x = 8 }
+	if y + POPOVER_H_ROUTER > f32(v.win_h) { y = f32(v.win_h) - POPOVER_H_ROUTER - 8 }
+	if y < 8 { y = 8 }
+	return {x, y, POPOVER_W, POPOVER_H_ROUTER}
+}
+
+triage_button_rect :: proc(pop: rl.Rectangle, i: int) -> rl.Rectangle {
+	return {pop.x + 10 + f32(i) * 64, pop.y + 104, 60, 26}
+}
+
+pipe_button_rect :: proc(pop: rl.Rectangle, i: int) -> rl.Rectangle {
+	return {pop.x + 10 + f32(i) * 96, pop.y + 76, 90, 26}
+}
+
+// router inspect popover (canon #14): ports, per-class flows, triage buttons
+draw_router_popover :: proc(v: ^View, snap: ^pp.Snapshot, node_id: u32, pop: rl.Rectangle, triage_labels: [3]string) {
+	p := v.palette
+	panel(v, pop)
+	n: ^pp.Snap_Node
+	for i in 0 ..< len(snap.nodes) {
+		if snap.nodes[i].id == node_id { n = &snap.nodes[i]; break }
+	}
+	if n == nil { return }
+	name := v.catalogs.node_types[n.type_idx].display
+	draw_text(v, name, {pop.x + 10, pop.y + 8}, 15, p.ink)
+	buf: [64]u8
+	ports := fmt_bprintf(buf[:], "ports %d/%d used", int(n.ports_used), int(n.ports))
+	draw_text(v, ports, {pop.x + 10, pop.y + 28}, 13, p.ink_soft)
+	// per-class in-flight counts through this router (the flows readout)
+	y := pop.y + 48
+	for pt, i in v.catalogs.packet_types {
+		fbuf: [24]u8
+		count := fmt_bprintf(fbuf[:], "x%d", int(n.flow_counts[i]))
+		draw_class_shape(v, i32(i), {pop.x + 16, y + 6}, 5, p.packet[i])
+		draw_text(v, pt.display, {pop.x + 28, y}, 12, p.ink_soft)
+		draw_text(v, count, {pop.x + 100, y}, 12, p.ink)
+		y += 16
+	}
+	draw_text(v, "triage:", {pop.x + 10, pop.y + 86}, 12, p.ink_soft)
+	// buttons are DRAWN here; the app re-uses triage_button_rect for hit-tests
+	for label, i in triage_labels {
+		r := triage_button_rect(pop, i)
+		active := (i == 0 && n.triage < 0) || (i > 0 && n.triage == i32(i - 1))
+		draw_button(v, r, label, active)
+	}
+}
+
+// pipe popover: the QoS dial (cycle priority) + demolish
+draw_pipe_popover :: proc(v: ^View, snap: ^pp.Snapshot, pipe_id: u32, pop: rl.Rectangle) {
+	p := v.palette
+	panel(v, {pop.x, pop.y, pop.width, POPOVER_H_PIPE})
+	sp: ^pp.Snap_Pipe
+	for i in 0 ..< len(snap.pipes) {
+		if snap.pipes[i].id == pipe_id { sp = &snap.pipes[i]; break }
+	}
+	if sp == nil { return }
+	tier := v.catalogs.pipe_tiers[sp.tier]
+	draw_text(v, tier.display, {pop.x + 10, pop.y + 8}, 15, p.ink)
+	buf: [64]u8
+	info := fmt_bprintf(buf[:], "cap %d u/s · span %d", int(sp.capacity), int(sp.span))
+	draw_text(v, info, {pop.x + 10, pop.y + 28}, 13, p.ink_soft)
+	prio := "priority: none"
+	if sp.priority >= 0 { prio = v.catalogs.packet_types[sp.priority].display }
+	draw_text(v, prio, {pop.x + 10, pop.y + 46}, 13, p.ink)
+	r0 := pipe_button_rect(pop, 0)
+	draw_button(v, r0, "cycle QoS", false)
+	r1 := pipe_button_rect(pop, 1)
+	draw_button(v, r1, "demolish", false)
+}
+
+draw_button :: proc(v: ^View, r: rl.Rectangle, label: string, active: bool) {
+	p := v.palette
+	bg := rl.Color{238, 230, 210, 255}
+	if active { bg = rl.Color{210, 226, 196, 255} }
+	rl.DrawRectangleRec(r, bg)
+	rl.DrawRectangleLinesEx(r, 1, p.chrome_border)
+	lw := measure(v, label, 13)
+	draw_text(v, label, {r.x + (r.width - lw)/2, r.y + 6}, 13, p.ink)
+}
+
+panel :: proc(v: ^View, r: rl.Rectangle) {
+	rl.DrawRectangleRec(r, v.palette.chrome_panel)
+	rl.DrawRectangleLinesEx(r, 1, v.palette.chrome_border)
+}
+
+measure :: proc(v: ^View, txt: string, size: f32) -> f32 {
+	cbuf: [256]u8
+	n := min(len(txt), 250)
+	for i in 0 ..< n { cbuf[i] = txt[i] }
+	cbuf[n] = 0
+	return rl.MeasureTextEx(v.font, cstring(&cbuf[0]), size, 1).x
+}
+
+draw_text_right :: proc(v: ^View, txt: string, pos: rl.Vector2, size: f32, col: rl.Color) {
+	w := measure(v, txt, size)
+	draw_text(v, txt, {pos.x - w, pos.y}, size, col)
+}
diff --git a/app/render/map.odin b/app/render/map.odin
new file mode 100644
index 0000000..38e531a
--- /dev/null
+++ b/app/render/map.odin
@@ -0,0 +1,89 @@
+package render
+
+// map.odin — the procedural land/ocean/parks map (art amendment A5). Generated
+// once per run at run creation from a DEDICATED derived stream
+// (splitmix64(run_seed ^ MAP_TAG)) — never state.rng (would perturb the sim),
+// never the cosmetic stream (ODN-15). Geography is cosmetic-only: it never
+// constrains topology (the canon is an abstract map; keeping map-gen out of
+// the core keeps the re-sim story clean).
+//
+// The descriptors are computed once and drawn fresh each frame (~40 draw
+// calls — trivially cheap on both the GPU and rlsw paths; no RenderTexture
+// cache — the memory platform has no FBO readback).
+
+import pp "../../core"
+import rl "vendor:raylib"
+
+MAP_TAG :: 0x5EED5EED5EED  // domain separator for the derived map stream
+
+Blob :: struct { x, y, r: f32 }
+
+Map_Gen :: struct {
+	ocean:    [6]Blob,  // big soft-blue masses off the bottom-left coastline
+	parks:    [3]Blob,  // green park blobs
+	speckles: [24]Blob, // faint city-tint texture
+}
+
+map_generate :: proc(seed: u64, world_w, world_h: f32) -> Map_Gen {
+	m: Map_Gen
+	s := seed ~ u64(MAP_TAG)
+	rnd :: proc(s: ^u64, lo, hi: f32) -> f32 {
+		v := pp.splitmix64(s)
+		f := f32(v >> 40) / f32(u64(1) << 24) // 24 bits of fraction
+		return lo + f * (hi - lo)
+	}
+	// ocean masses entering from the bottom-left corner (a coastline, not a void)
+	// hug the bottom-left corner — a coastline, mostly OFF the playfield
+	m.ocean[0] = {-world_w * 0.28, world_h * 1.22, world_h * 0.66}
+	m.ocean[1] = {world_w * 0.05, world_h * 1.32, world_h * 0.58}
+	m.ocean[2] = {-world_w * 0.30, world_h * 0.72, world_h * 0.40}
+	for i in 3 ..< 6 {
+		m.ocean[i] = {rnd(&s, -0.25, 0.15) * world_w, rnd(&s, 1.05, 1.35) * world_h, rnd(&s, 0.25, 0.45) * world_h}
+	}
+	for i in 0 ..< 3 {
+		m.parks[i] = {rnd(&s, 0.15, 0.9) * world_w, rnd(&s, 0.1, 0.75) * world_h, rnd(&s, 30, 80)}
+	}
+	for i in 0 ..< 24 {
+		m.speckles[i] = {rnd(&s, 0, world_w), rnd(&s, 0, world_h), rnd(&s, 2, 5)}
+	}
+	return m
+}
+
+map_draw :: proc(m: ^Map_Gen, v: ^View) {
+	p := v.palette
+	// cream land base
+	rl.DrawRectangle(0, 0, v.win_w, v.win_h, p.canvas)
+	// the snap lattice (faint)
+	// grid lines blended 55% toward the canvas (the lattice stays subtle)
+	g := p.grid
+	c := p.canvas
+	grid_soft := rl.Color{
+		u8((u16(g.r)*45 + u16(c.r)*55) / 100),
+		u8((u16(g.g)*45 + u16(c.g)*55) / 100),
+		u8((u16(g.b)*45 + u16(c.b)*55) / 100), 255}
+	tile := v.tile_px * v.scale
+	x := v.off_x
+	for x < f32(v.win_w) {
+		rl.DrawLine(i32(x), 0, i32(x), v.win_h, grid_soft)
+		x += tile
+	}
+	y := v.off_y
+	for y < f32(v.win_h) {
+		rl.DrawLine(0, i32(y), v.win_w, i32(y), grid_soft)
+		y += tile
+	}
+	// parks then ocean then speckle (back-to-front, value-only layers)
+	for b in m.parks {
+		c := to_screen(v, b.x, b.y)
+		rl.DrawCircleV(c, b.r * v.scale, p.park)
+	}
+	for b in m.ocean {
+		c := to_screen(v, b.x, b.y)
+		rl.DrawCircleV(c, b.r * v.scale, p.ocean)
+	}
+	speckle := p.grid
+	for b in m.speckles {
+		c := to_screen(v, b.x, b.y)
+		rl.DrawCircleV(c, b.r * v.scale, speckle)
+	}
+}
diff --git a/app/render/palette.odin b/app/render/palette.odin
new file mode 100644
index 0000000..9598eb9
--- /dev/null
+++ b/app/render/palette.odin
@@ -0,0 +1,138 @@
+package render
+
+// palette.odin — the light-canvas canon as DATA (look-book v1 / art-direction
+// v1.2). All values cosmetic; loaded from data/palette.json (ODN-5 — art
+// tuning is data; the core never reads it).
+
+import "core:encoding/json"
+import rl "vendor:raylib"
+
+Palette :: struct {
+	canvas:         rl.Color,
+	grid:           rl.Color,
+	ocean:          rl.Color,
+	park:           rl.Color,
+	ink:            rl.Color,
+	ink_soft:       rl.Color,
+	ink_faint:      rl.Color,
+	chrome_panel:   rl.Color,
+	chrome_border:  rl.Color,
+	state_healthy:  rl.Color,
+	state_strain:   rl.Color,
+	state_critical: rl.Color,
+	house_bodies:   [4]rl.Color,
+	house_roofs:    [4]rl.Color,
+	host_body:      rl.Color,
+	host_roof:      rl.Color,
+	router_body:    rl.Color,
+	router_dark:    rl.Color,
+	router_led:     rl.Color,
+	pipe_copper:    rl.Color,
+	pipe_steel:     rl.Color,
+	pipe_fiber:     rl.Color,
+	pipe_core:      rl.Color,
+	pipe_unalloc:   rl.Color,
+	canvas_wash:    rl.Color,
+	packet:         [12]rl.Color, // per class (mirrors packet_types color_rgba; MAX_CLASSES)
+}
+
+DEFAULT_PALETTE_JSON :: #load("../../data/palette.json")
+
+palette_load :: proc(source: []byte = DEFAULT_PALETTE_JSON) -> Palette {
+	p: Palette
+	v, err := json.parse(source, parse_integers = true)
+	if err != nil { return fallback_palette() }
+	obj, okm := v.(json.Object)
+	if !okm { return fallback_palette() }
+	p.canvas = jcol(obj, "canvas", {232, 221, 194, 255})
+	p.grid = jcol(obj, "grid", {194, 182, 148, 255})
+	p.ocean = jcol(obj, "ocean", {168, 197, 216, 255})
+	p.park = jcol(obj, "park", {166, 196, 138, 255})
+	p.ink = jcol(obj, "ink", {51, 65, 79, 255})
+	p.ink_soft = jcol(obj, "ink_soft", {106, 112, 120, 255})
+	p.ink_faint = jcol(obj, "ink_faint", {154, 160, 168, 255})
+	p.chrome_panel = jcol(obj, "chrome_panel", {245, 239, 223, 226})
+	p.chrome_border = jcol(obj, "chrome_border", {194, 182, 148, 255})
+	p.state_healthy = jcol(obj, "state_healthy", {55, 214, 122, 255})
+	p.state_strain = jcol(obj, "state_strain", {242, 181, 68, 255})
+	p.state_critical = jcol(obj, "state_critical", {232, 69, 69, 255})
+	if arr, ok := obj["house_bodies"].(json.Array); ok && len(arr) == 4 {
+		for i in 0 ..< 4 {
+			if q, okq := arr[i].(json.Array); okq { p.house_bodies[i] = jcol_arr(q, {232, 90, 74, 255}) }
+		}
+	}
+	if arr, ok := obj["house_roofs"].(json.Array); ok && len(arr) == 4 {
+		for i in 0 ..< 4 {
+			if q, okq := arr[i].(json.Array); okq { p.house_roofs[i] = jcol_arr(q, {122, 46, 38, 255}) }
+		}
+	}
+	p.host_body = jcol(obj, "host_body", {62, 120, 208, 255})
+	p.host_roof = jcol(obj, "host_roof", {38, 76, 142, 255})
+	p.router_body = jcol(obj, "router_body", {94, 110, 128, 255})
+	p.router_dark = jcol(obj, "router_dark", {62, 74, 92, 255})
+	p.router_led = jcol(obj, "router_led", {46, 139, 87, 255})
+	p.pipe_copper = jcol(obj, "pipe_copper", {142, 94, 46, 255})
+	p.pipe_steel = jcol(obj, "pipe_steel", {120, 128, 140, 255})
+	p.pipe_fiber = jcol(obj, "pipe_fiber", {46, 84, 148, 255})
+	p.pipe_core = jcol(obj, "pipe_core", {122, 168, 230, 255})
+	p.pipe_unalloc = jcol(obj, "pipe_unalloc", {58, 74, 92, 255})
+	p.canvas_wash = jcol(obj, "canvas_wash", {250, 246, 238, 255})
+	p.packet[0] = {90, 98, 112, 255}   // email grey (overridden by packet_types colors at boot)
+	p.packet[1] = {30, 74, 152, 255}   // streaming blue
+	return p
+}
+
+fallback_palette :: proc() -> Palette {
+	return palette_load_from_fallback()
+}
+
+// used when the JSON is somehow unreadable — the look-book hexes, inline
+palette_load_from_fallback :: proc() -> Palette {
+	p: Palette
+	p.canvas = {232, 221, 194, 255}
+	p.grid = {194, 182, 148, 255}
+	p.ocean = {168, 197, 216, 255}
+	p.park = {166, 196, 138, 255}
+	p.ink = {51, 65, 79, 255}
+	p.ink_soft = {106, 112, 120, 255}
+	p.ink_faint = {154, 160, 168, 255}
+	p.chrome_panel = {245, 239, 223, 226}
+	p.chrome_border = {194, 182, 148, 255}
+	p.state_healthy = {55, 214, 122, 255}
+	p.state_strain = {242, 181, 68, 255}
+	p.state_critical = {232, 69, 69, 255}
+	p.house_bodies = {{232, 90, 74, 255}, {242, 201, 76, 255}, {94, 203, 107, 255}, {74, 155, 226, 255}}
+	p.house_roofs = {{122, 46, 38, 255}, {122, 84, 24, 255}, {44, 106, 52, 255}, {38, 80, 126, 255}}
+	p.host_body = {62, 120, 208, 255}
+	p.host_roof = {38, 76, 142, 255}
+	p.router_body = {94, 110, 128, 255}
+	p.router_dark = {62, 74, 92, 255}
+	p.router_led = {46, 139, 87, 255}
+	p.pipe_copper = {142, 94, 46, 255}
+	p.pipe_steel = {120, 128, 140, 255}
+	p.pipe_fiber = {46, 84, 148, 255}
+	p.pipe_core = {122, 168, 230, 255}
+	p.pipe_unalloc = {58, 74, 92, 255}
+	p.canvas_wash = {250, 246, 238, 255}
+	p.packet[0] = {90, 98, 112, 255}
+	p.packet[1] = {30, 74, 152, 255}
+	return p
+}
+
+jcol :: proc(o: json.Object, key: string, def: rl.Color) -> rl.Color {
+	if arr, ok := o[key].(json.Array); ok {
+		return jcol_arr(arr, def)
+	}
+	return def
+}
+
+jcol_arr :: proc(arr: json.Array, def: rl.Color) -> rl.Color {
+	if len(arr) != 4 { return def }
+	c: rl.Color
+	for i in 0 ..< 4 {
+		n, ok := arr[i].(json.Integer)
+		if !ok { return def }
+		c[i] = u8(n)
+	}
+	return c
+}
diff --git a/app/render/view.odin b/app/render/view.odin
new file mode 100644
index 0000000..7b963d5
--- /dev/null
+++ b/app/render/view.odin
@@ -0,0 +1,429 @@
+package render
+
+// view.odin — the View layer (architecture §9.1): camera-fit + the light-
+// canvas world pass. Reads ONLY the immutable snapshot (ODN-1). All animation
+// phases derive from the passed-in time_ms (virtual in the harness — render
+// determinism rule §10.4); pulse shapes are a pinned triangle wave (no libm
+// transcendentals anywhere in the render path).
+
+import "core:math"
+import pp "../../core"
+import prun "../run"
+import rl "vendor:raylib"
+
+View :: struct {
+	palette:  ^Palette,
+	catalogs: ^pp.Catalogs,
+	win_w:    i32,
+	win_h:    i32,
+	scale:    f32,
+	off_x:    f32,
+	off_y:    f32,
+	tile_px:  f32,
+	world_w:  f32,
+	world_h:  f32,
+	font:     rl.Font,
+}
+
+// Selection/drag UI state lives in the app; the view only reads it.
+Selection :: struct {
+	node: u32,
+	pipe: u32,
+	hover_pipe: u32, // affordance: the pipe under the cursor gets a soft lift
+}
+
+Drag_State :: struct {
+	active:    bool,
+	from_node: u32,
+	wx, wy:    f32, // current world px
+	valid:     pp.Edit_Error,
+	cost:      i32,
+}
+
+view_compute :: proc(v: ^View, win_w, win_h: i32, bal: ^pp.Balance) {
+	v.win_w = win_w
+	v.win_h = win_h
+	v.tile_px = f32(bal.tile_px)
+	v.world_w = f32(bal.map_w_tiles) * v.tile_px
+	v.world_h = f32(bal.map_h_tiles) * v.tile_px
+	sx := f32(win_w) / v.world_w
+	sy := f32(win_h) / v.world_h
+	v.scale = min(sx, sy)
+	v.off_x = (f32(win_w) - v.world_w * v.scale) / 2
+	v.off_y = (f32(win_h) - v.world_h * v.scale) / 2
+}
+
+to_screen :: proc(v: ^View, wx, wy: f32) -> rl.Vector2 {
+	return {v.off_x + wx * v.scale, v.off_y + wy * v.scale}
+}
+
+from_screen :: proc(v: ^View, sx, sy: f32) -> (f32, f32) {
+	if v.scale <= 0 { return 0, 0 } // minimized window guard
+	return (sx - v.off_x) / v.scale, (sy - v.off_y) / v.scale
+}
+
+node_screen :: proc(v: ^View, pos: [2]i32) -> rl.Vector2 {
+	return to_screen(v, f32(pos[0]) * v.tile_px, f32(pos[1]) * v.tile_px)
+}
+
+// pinned triangle wave in [0,1] with the given period — the pulse shape
+triangle_pulse :: proc(time_ms: i64, period_ms: i64) -> f32 {
+	if period_ms <= 0 { return 0 }
+	phase := time_ms % period_ms
+	half := period_ms / 2
+	if phase < half {
+		return f32(phase) / f32(half)
+	}
+	return f32(period_ms - phase) / f32(half)
+}
+
+// --- the world pass -------------------------------------------------------------
+
+draw_world :: proc(v: ^View, snap: ^pp.Snapshot, mg: ^Map_Gen, time_ms: i64,
+				   sel: Selection, drag: Drag_State) {
+	map_draw(mg, v)
+	draw_pipes(v, snap, sel.hover_pipe)
+	draw_packets(v, snap)
+	draw_nodes(v, snap, time_ms, sel)
+	if drag.active { draw_ghost(v, snap, drag) }
+}
+
+// the control point lives in the run package (shared with the hit-test) —
+// one formula, so pixels and picking can't drift apart
+pipe_control :: proc(a, b: rl.Vector2, pair_idx: int) -> rl.Vector2 {
+	cx, cy := prun.pipe_control_point(a.x, a.y, b.x, b.y, pair_idx)
+	return {cx, cy}
+}
+
+draw_pipes :: proc(v: ^View, snap: ^pp.Snapshot, sel_hover: u32 = 0) {
+	p := v.palette
+	for pipe in snap.pipes {
+		na, oka := snap_node_pos(snap, pipe.a)
+		nb, okb := snap_node_pos(snap, pipe.b)
+		if !oka || !okb { continue }
+		a := node_screen(v, na)
+		b := node_screen(v, nb)
+		// pair index (how many earlier pipes share this unordered pair)
+		pair_idx := 0
+		for other in snap.pipes {
+			if other.id == pipe.id { break }
+			if (other.a == pipe.a && other.b == pipe.b) || (other.a == pipe.b && other.b == pipe.a) {
+				pair_idx += 1
+			}
+		}
+		ctrl := pipe_control(a, b, pair_idx)
+		pts := [3]rl.Vector2{a, ctrl, b}
+		tier_color := tier_pipe_color(v, pipe.tier)
+		width := tier_pipe_width(v, pipe.tier) * v.scale
+		rl.DrawSplineSegmentBezierQuadratic(pts[0], pts[1], pts[2], width, tier_color)
+		// the glowing core on fiber (the modernization read, A4)
+		if v.catalogs.pipe_tiers[pipe.tier].id == "wide" {
+			rl.DrawSplineSegmentBezierQuadratic(pts[0], pts[1], pts[2], width * 0.45, p.pipe_core)
+		}
+		// hover affordance (the pipe is clickable)
+		if sel_hover == pipe.id {
+			rl.DrawSplineSegmentBezierQuadratic(pts[0], pts[1], pts[2], width + 4 * v.scale, rl.Color{255, 252, 240, 110})
+		}
+		// the QoS dial marker at the visual midpoint (the decision, on the pipe)
+		if pipe.priority >= 0 {
+			mid := bezier_point(a, ctrl, b, 0.5)
+			cls := p.packet[pipe.priority]
+			rl.DrawCircleV(mid, 9 * v.scale, rl.Color{245, 239, 223, 240})
+			rl.DrawCircleLinesV(mid, 9 * v.scale, p.ink_soft)
+			draw_class_shape(v, i32(pipe.priority), {mid.x, mid.y - 1}, 5 * v.scale, cls)
+		}
+	}
+}
+
+bezier_point :: proc(a, c, b: rl.Vector2, t: f32) -> rl.Vector2 {
+	u := 1 - t
+	return {
+		u*u*a.x + 2*u*t*c.x + t*t*b.x,
+		u*u*a.y + 2*u*t*c.y + t*t*b.y,
+	}
+}
+
+snap_node_pos :: proc(snap: ^pp.Snapshot, id: u32) -> ([2]i32, bool) {
+	for n in snap.nodes {
+		if n.id == id { return n.pos, true }
+	}
+	return {}, false
+}
+
+tier_pipe_color :: proc(v: ^View, tier: u16) -> rl.Color {
+	id := v.catalogs.pipe_tiers[tier].id
+	switch id {
+	case "narrow": return v.palette.pipe_copper
+	case "standard": return v.palette.pipe_steel
+	case "wide": return v.palette.pipe_fiber
+	}
+	return v.palette.pipe_unalloc
+}
+
+tier_pipe_width :: proc(v: ^View, tier: u16) -> f32 {
+	id := v.catalogs.pipe_tiers[tier].id
+	switch id {
+	case "narrow": return 3.5
+	case "standard": return 5.5
+	case "wide": return 8.5
+	}
+	return 4.5
+}
+
+draw_nodes :: proc(v: ^View, snap: ^pp.Snapshot, time_ms: i64, sel: Selection) {
+	for n in snap.nodes {
+		c := node_screen(v, n.pos)
+		if n.kind == .Junction {
+			draw_router(v, n, c, time_ms, sel.node == n.id)
+		} else {
+			draw_building(v, n, c)
+		}
+		draw_health_ring(v, n, c, time_ms)
+	}
+}
+
+draw_building :: proc(v: ^View, n: pp.Snap_Node, c: rl.Vector2) {
+	p := v.palette
+	s := v.tile_px * v.scale
+	if n.role == .Content_Host {
+		// server/broadcast block + darker roof strip + play glyph (YouTune)
+		w := s * 1.15
+		h := s * 0.95
+		rl.DrawRectangleV({c.x - w/2, c.y - h/2 + s*0.12}, {w, h - s*0.12}, p.host_body)
+		rl.DrawRectangleV({c.x - w/2, c.y - h/2}, {w, s * 0.28}, p.host_roof)
+		// play triangle (brand glyph)
+		g := s * 0.22
+		v1 := rl.Vector2{c.x - g * 0.6, c.y - g * 0.8}
+		v2 := rl.Vector2{c.x - g * 0.6, c.y + g * 0.8}
+		v3 := rl.Vector2{c.x + g, c.y}
+		rl.DrawTriangle(v3, v2, v1, rl.Color{250, 246, 238, 255})
+		return
+	}
+	// residential: peaked-roof house, varied cheerful body + dark roof (A2)
+	variant := int(n.id) % 4
+	body := p.house_bodies[variant]
+	roof := p.house_roofs[variant]
+	w := s * 0.92
+	h := s * 0.62
+	left := c.x - w/2
+	top := c.y - h * 0.15
+	rl.DrawRectangleV({left, top}, {w, h}, body)
+	// roof triangle (ridge toward camera)
+	r1 := rl.Vector2{left - s * 0.06, top}
+	r2 := rl.Vector2{left + w + s * 0.06, top}
+	r3 := rl.Vector2{c.x, top - s * 0.42}
+	rl.DrawTriangle(r1, r3, r2, roof)
+	// door
+	dw := s * 0.16
+	rl.DrawRectangleV({c.x - dw/2, top + h - s * 0.3}, {dw, s * 0.3}, roof)
+}
+
+draw_router :: proc(v: ^View, n: pp.Snap_Node, c: rl.Vector2, time_ms: i64, selected: bool) {
+	p := v.palette
+	// capacity-scaled puck (A3): ports -> size
+	base := v.tile_px * v.scale * 0.5
+	r := base * (0.85 + 0.15 * f32(max(1, n.ports) / 4))
+	if n.ports >= 16 { r = base * 1.35 } else if n.ports >= 8 { r = base * 1.1 }
+	rl.DrawCircleV(c, r, p.router_body)
+	rl.DrawCircleV(c, r * 0.45, p.router_dark) // the glowing core
+	// the LED ring = the ports (lit = free, dim = used) — canon #14 made visible
+	// LED positions on a pinned 16-gon (4/8/16 ports all divide 16) — no
+	// transcendentals in rendered geometry (the §10.4 render rule)
+	leds := max(4, int(n.ports))
+	stride := 16 / leds
+	circle := CIRCLE16
+	for i in 0 ..< leds {
+		k := (i * stride + 12) % 16 // start at the top
+		pos := rl.Vector2{
+			c.x + circle[k][0] * r * 0.78,
+			c.y + circle[k][1] * r * 0.78,
+		}
+		col := p.router_led
+		if i < int(n.ports_used) { col = rl.Color{90, 98, 104, 255} } // used = dim
+		rl.DrawCircleV(pos, max(1.5, r * 0.09), col)
+	}
+	if n.lb_weighted {
+		// smart LB marker: a second inner ring hint
+		rl.DrawRingLines(c, r*0.55, r*0.62, 0, 360, 24, p.router_led)
+	}
+	if n.triage >= 0 {
+		// triage badge: the prioritized class glyph above the puck
+		draw_class_shape(v, n.triage, {c.x, c.y - r - 8 * v.scale}, 5 * v.scale, p.packet[n.triage])
+	}
+	if selected {
+		rl.DrawRingLines(c, r + 2, r + 4, 0, 360, 32, p.ink)
+	}
+}
+
+draw_health_ring :: proc(v: ^View, n: pp.Snap_Node, c: rl.Vector2, time_ms: i64) {
+	if n.health == .Healthy { return }
+	p := v.palette
+	col := p.state_strain
+	period := i64(833) // ~1.2 Hz
+	glyph := "!"
+	if n.health == .Critical {
+		col = p.state_critical
+		period = 400 // ~2.5 Hz
+		glyph = "!!"
+	}
+	pulse := triangle_pulse(time_ms, period)
+	base := v.tile_px * v.scale * 0.75
+	r := base + pulse * 3 * v.scale
+	rl.DrawRingLines(c, r, r + 2.5, 0, 360, 32, col)
+	// the icon channel (never color alone, UX-DR4)
+	buf: [8]u8
+	copy(buf[:], glyph)
+	draw_text(v, string(buf[:len(glyph)]), {c.x + base + 2, c.y - base - 6}, 15 * v.scale, col)
+}
+
+draw_packets :: proc(v: ^View, snap: ^pp.Snapshot) {
+	for pkt in snap.packets {
+		c: rl.Vector2
+		if pkt.pipe == 0 {
+			np, ok := snap_node_pos(snap, pkt.node)
+			if !ok { continue }
+			c = node_screen(v, np)
+		} else {
+			// ride the same bezier the pipe renders as (A4) — dots follow the curve
+			found := false
+			for pipe in snap.pipes {
+				if pipe.id != pkt.pipe { continue }
+				na, oka := snap_node_pos(snap, pipe.a)
+				nb, okb := snap_node_pos(snap, pipe.b)
+				if !oka || !okb { break }
+				a := node_screen(v, na)
+				b := node_screen(v, nb)
+				pair_idx := 0
+				for other in snap.pipes {
+					if other.id == pipe.id { break }
+					if (other.a == pipe.a && other.b == pipe.b) || (other.a == pipe.b && other.b == pipe.a) {
+						pair_idx += 1
+					}
+				}
+				ctrl := pipe_control(a, b, pair_idx)
+				c = bezier_point(a, ctrl, b, f32(pkt.frac_q8) / 256)
+				found = true
+				break
+			}
+			if !found { continue }
+		}
+		col := v.palette.packet[pkt.class]
+		size: f32 = 4.2
+		if pkt.class == 1 { size = 6.4 } // streaming reads as the flood
+		draw_class_shape(v, i32(pkt.class), c, size * v.scale, col)
+	}
+}
+
+// shape + color (never color alone, §5): email = circle, streaming = triangle
+draw_class_shape :: proc(v: ^View, class: i32, c: rl.Vector2, r: f32, col: rl.Color) {
+	// (class shapes beyond the PROTO roster draw as circles — shape system is [LATER])
+	if class == 1 {
+		v1 := rl.Vector2{c.x, c.y - r}
+		v2 := rl.Vector2{c.x - r * 0.9, c.y + r * 0.7}
+		v3 := rl.Vector2{c.x + r * 0.9, c.y + r * 0.7}
+		rl.DrawTriangle(v1, v2, v3, col)
+		return
+	}
+	rl.DrawCircleV(c, r, col)
+}
+
+draw_ghost :: proc(v: ^View, snap: ^pp.Snapshot, drag: Drag_State) {
+	p := v.palette
+	from_pos, ok := snap_node_pos(snap, drag.from_node)
+	if !ok { return }
+	a := node_screen(v, from_pos)
+	b := to_screen(v, drag.wx, drag.wy)
+	ctrl := pipe_control(a, b, 0)
+	col := p.pipe_steel
+	if drag.valid != .None { col = p.state_critical }
+	rl.DrawSplineSegmentBezierQuadratic(a, ctrl, b, 5 * v.scale, {col.r, col.g, col.b, 190})
+	if drag.valid == .None && drag.cost > 0 {
+		buf: [32]u8
+		txt := fmt_bprintf(buf[:], "-%d", drag.cost)
+		draw_text(v, txt, {b.x + 10, b.y - 14}, 14, p.ink_soft)
+	}
+}
+
+draw_text :: proc(v: ^View, txt: string, pos: rl.Vector2, size: f32, col: rl.Color) {
+	cbuf: [256]u8
+	n := min(len(txt), 250)
+	for i in 0 ..< n { cbuf[i] = txt[i] }
+	cbuf[n] = 0
+	rl.DrawTextEx(v.font, cstring(&cbuf[0]), pos, size, 1, col)
+}
+
+fmt_bprintf :: proc(buf: []u8, format: string, args: ..any) -> string {
+	n := 0
+	// minimal: supports %d only (HUD numerals)
+	ai := 0
+	i := 0
+	for i < len(format) {
+		if format[i] == '%' && i + 1 < len(format) && format[i+1] == '%' {
+			buf[n] = '%'
+			n += 1
+			i += 2
+			continue
+		}
+		if format[i] == '%' && i + 1 < len(format) && format[i+1] == 'd' {
+			if ai < len(args) {
+				if val, ok := args[ai].(int); ok {
+					n += write_int(buf[n:], val)
+				} else if val32, ok2 := args[ai].(i32); ok2 {
+					n += write_int(buf[n:], int(val32))
+				} else if valu, ok3 := args[ai].(u64); ok3 {
+					n += write_uint(buf[n:], valu)
+				}
+				ai += 1
+			}
+			i += 2
+		} else {
+			buf[n] = format[i]
+			n += 1
+			i += 1
+		}
+	}
+	return string(buf[:n])
+}
+
+write_int :: proc(buf: []u8, v: int) -> int {
+	if v < 0 {
+		buf[0] = '-'
+		return 1 + write_uint(buf[1:], u64(-v))
+	}
+	return write_uint(buf, u64(v))
+}
+
+write_uint :: proc(buf: []u8, v: u64) -> int {
+	tmp: [20]u8
+	n := 0
+	x := v
+	if x == 0 { tmp[0] = '0'; n = 1 }
+	for x > 0 {
+		tmp[n] = u8('0' + x % 10)
+		x /= 10
+		n += 1
+	}
+	for i in 0 ..< n { buf[i] = tmp[n-1-i] }
+	return n
+}
+
+// unit circle, 16 points (k * 22.5 deg), correctly-rounded decimal constants —
+// identical on every platform (no libm cos/sin anywhere in the render path)
+CIRCLE16 :: [16][2]f32{
+	{ 1.00000000,  0.00000000},
+	{ 0.92387954,  0.38268343},
+	{ 0.70710678,  0.70710678},
+	{ 0.38268343,  0.92387954},
+	{ 0.00000000,  1.00000000},
+	{-0.38268343,  0.92387954},
+	{-0.70710678,  0.70710678},
+	{-0.92387954,  0.38268343},
+	{-1.00000000,  0.00000000},
+	{-0.92387954, -0.38268343},
+	{-0.70710678, -0.70710678},
+	{-0.38268343, -0.92387954},
+	{ 0.00000000, -1.00000000},
+	{ 0.38268343, -0.92387954},
+	{ 0.70710678, -0.70710678},
+	{ 0.92387954, -0.38268343},
+}
diff --git a/app/run/autopilot.odin b/app/run/autopilot.odin
new file mode 100644
index 0000000..5a1d215
--- /dev/null
+++ b/app/run/autopilot.odin
@@ -0,0 +1,22 @@
+package run
+
+// autopilot.odin — the demo autopilot (app-side convenience + harness demos):
+// wires the boot network, then meshes each growth spawn (routers first, then
+// houses) through the command bus — the exact player path, so autopilot runs
+// land in the action log and replay bit-for-bit.
+
+import pp "../../core"
+
+App_Mode :: pp.App_Mode
+
+autopilot_boot :: proc(rc: ^Run_Context) {
+	pp.testkit_wire_boot(rc.state, rc.state.tick)
+	for i in 0 ..< len(rc.state.topology.node_alive) {
+		rc.autopilot_wired[rc.state.topology.node_id[i]] = true
+	}
+	resnapshot(rc)
+}
+
+autopilot_tick :: proc(rc: ^Run_Context) {
+	pp.testkit_autowire(rc.state, rc.state.tick, &rc.autopilot_wired)
+}
diff --git a/app/run/catalogs.odin b/app/run/catalogs.odin
new file mode 100644
index 0000000..e7f9b40
--- /dev/null
+++ b/app/run/catalogs.odin
@@ -0,0 +1,42 @@
+package run
+
+// catalogs.odin — catalog loading at the APP layer (ODN-5): release builds use
+// the #load-embedded bytes; dev builds prefer data/ on disk when present
+// (edit -> restart -> test). The core only ever sees bytes.
+
+import "core:fmt"
+import "core:os"
+import pp "../../core"
+
+embedded_sources :: proc(src: ^pp.Catalog_Sources) {
+	src.packet_types = #load("../../data/packet_types.json")
+	src.pipe_tiers   = #load("../../data/pipe_tiers.json")
+	src.node_types   = #load("../../data/node_types.json")
+	src.demand       = #load("../../data/demand.json")
+	src.crises       = #load("../../data/crises.json")
+	src.balance      = #load("../../data/balance.json")
+}
+
+DATA_DIR :: "../../data" // resolved at runtime from the executable's cwd in dev
+
+// Load catalogs: data/ files when the directory exists (dev), else embedded.
+// Fail-fast: a catalog error aborts startup with a named error (ODN-5).
+load_catalogs :: proc(data_dir: string = "data") -> (^pp.Catalogs, pp.Catalog_Error) {
+	src: pp.Catalog_Sources
+	embedded_sources(&src)
+	read_or_keep :: proc(dir, name: string, dst: ^[]byte) {
+		path := fmt.tprintf("%s/%s", dir, name)
+		if data, err := os.read_entire_file_from_path(path, context.allocator); err == nil {
+			dst^ = data
+		}
+	}
+	if os.is_dir(data_dir) {
+		read_or_keep(data_dir, "packet_types.json", &src.packet_types)
+		read_or_keep(data_dir, "pipe_tiers.json", &src.pipe_tiers)
+		read_or_keep(data_dir, "node_types.json", &src.node_types)
+		read_or_keep(data_dir, "demand.json", &src.demand)
+		read_or_keep(data_dir, "crises.json", &src.crises)
+		read_or_keep(data_dir, "balance.json", &src.balance)
+	}
+	return pp.catalogs_load(&src)
+}
diff --git a/app/run/driver_test.odin b/app/run/driver_test.odin
new file mode 100644
index 0000000..6a62b13
--- /dev/null
+++ b/app/run/driver_test.odin
@@ -0,0 +1,91 @@
+package run
+
+// driver_test.odin — the fixed-timestep accumulator contracts (ODN-2/E21):
+// exact pacing, catch-up capped, bounded debt (slow-mo, never skip), and the
+// paused/ended gates. Plus the E4 snap inclusivity and paused-state edits
+// (pause-and-plan doctrine: edits land while the sim is frozen).
+
+import "core:testing"
+import pp "../../core"
+
+driver_fixture :: proc(t: ^testing.T) -> ^Run_Context {
+	cat, cerr := pp.must_catalogs()
+	if cerr.file != "" { tfail(t, "catalogs") }
+	rc := new(Run_Context)
+	run_context_create(rc, 42, cat)
+	return rc
+}
+
+@(test)
+test_driver_exact_pacing :: proc(t: ^testing.T) {
+	rc := driver_fixture(t)
+	// ten 100ms frames at 10 Hz = exactly 10 ticks
+	for _ in 0 ..< 10 { sim_driver_update(&rc.driver, rc.state, 0.1) }
+	if rc.driver.tick != 10 { tfailf(t, "tick %d, want 10", rc.driver.tick) }
+}
+
+@(test)
+test_driver_catchup_capped_and_bounded :: proc(t: ^testing.T) {
+	rc := driver_fixture(t)
+	// a 0.25s stall (the clamp) = 2.5 ticks of debt; cap is 5 steps — fine
+	sim_driver_update(&rc.driver, rc.state, 0.25)
+	if rc.driver.tick != 2 { tfailf(t, "tick %d, want 2 (clamped)", rc.driver.tick) }
+	// synthetic 10s stall: clamped to 0.25 per call... call directly with a
+	// huge dt to prove the clamp engages
+	sim_driver_update(&rc.driver, rc.state, 10.0)
+	if rc.driver.tick > 2 + 5 { tfailf(t, "catch-up exceeded the cap: %d", rc.driver.tick) }
+	// bounded debt: never more than one tick carried after a capped frame
+	if rc.driver.accumulator > rc.driver.tick_seconds {
+		tfailf(t, "accumulator %f exceeds one tick (slow-mo, never skip)", rc.driver.accumulator)
+	}
+}
+
+@(test)
+test_run_update_gates :: proc(t: ^testing.T) {
+	rc := driver_fixture(t)
+	rc.paused = true
+	run_update(rc, 0.1)
+	if rc.driver.tick != 0 { tfail(t, "paused must not step") }
+	rc.paused = false
+	run_update(rc, 0.1)
+	if rc.driver.tick != 1 { tfail(t, "unpaused steps") }
+	rc.ended = true
+	run_update(rc, 0.1)
+	if rc.driver.tick != 1 { tfail(t, "ended must not step") }
+}
+
+@(test)
+test_snap_inclusive_boundary :: proc(t: ^testing.T) {
+	// E4: the snap radius is INCLUSIVE (<=); ties break to the lower id.
+	rc := driver_fixture(t)
+	tp := &rc.state.topology
+	tile := f64(rc.catalogs.balance.tile_px)
+	radius := f64(rc.catalogs.balance.snap_radius) * 1.6
+	// node id 2 at (8,5): world px (208, 130). Integer metric: radius rounds to 58.
+	nx := f64(tp.node_pos[1][0]) * tile
+	ny := f64(tp.node_pos[1][1]) * tile
+	ri := f64(i64(radius + 0.5))
+	id, ok := snap_node(rc, nx + ri, ny)
+	if !ok || id != 2 { tfailf(t, "boundary must snap (inclusive): got %d %v", id, ok) }
+	_, ok2 := snap_node(rc, nx + ri + 1.0, ny)
+	if ok2 { tfail(t, "past the radius must not snap") }
+}
+
+@(test)
+test_paused_edits_apply_immediately :: proc(t: ^testing.T) {
+	// pause-and-plan: a draw while paused lands NOW (fast-path), is logged
+	// with apply_tick = next tick, and replays identically.
+	rc := driver_fixture(t)
+	rc.paused = true
+	run_update(rc, 0.1) // no step while paused
+	wide, _ := pp.tier_index(rc.catalogs, "wide")
+	cmd := pp.Command{kind = pp.Cmd_Draw_Pipe{a = 1, b = 6, tier = wide}}
+	err := bus_submit(rc, cmd)
+	if err != .None { tfailf(t, "paused draw: %v", err) }
+	if len(rc.state.action_log) != 1 { tfail(t, "logged") }
+	if rc.state.action_log[0].apply_tick != 1 { tfail(t, "apply_tick = next tick") }
+	// visible immediately (sim frozen at tick 0)
+	pipes := 0
+	for a in rc.state.topology.pipe_alive { if a { pipes += 1 } }
+	if pipes != 1 { tfail(t, "the edit must land while paused") }
+}
diff --git a/app/run/run.odin b/app/run/run.odin
new file mode 100644
index 0000000..e2748ee
--- /dev/null
+++ b/app/run/run.odin
@@ -0,0 +1,137 @@
+package run
+
+// run.odin — the orchestration layer (architecture §4): owns the Run context
+// (core state + fixed-timestep driver + command bus + action log), the ODN-2
+// edit fast-path, and catalog loading. No raylib imports here — this package
+// is shared by the game (app/) and the golden harness (harness/).
+
+import "core:mem"
+import pp "../../core"
+
+TICK_SECONDS :: 0.1 // derived from balance.logic_hz at boot (catalog is the single source)
+MAX_STEPS_PER_FRAME :: 5
+MAX_FRAME_DELTA :: 0.25
+
+// Sim_Driver — the ONLY code that knows about real time (ODN-2). Fixed-tick
+// accumulator; slow-mo under overload, never tick-skipping (E21).
+Sim_Driver :: struct {
+	accumulator: f64,
+	tick:        u64,
+	tick_seconds: f64,
+}
+
+sim_driver_update :: proc(d: ^Sim_Driver, state: ^pp.Run_State, frame_dt: f64) {
+	dt := min(frame_dt, MAX_FRAME_DELTA)
+	d.accumulator += dt
+	steps := 0
+	for d.accumulator >= d.tick_seconds && steps < MAX_STEPS_PER_FRAME {
+		d.tick += 1
+		pp.step(state, d.tick, {})
+		d.accumulator -= d.tick_seconds
+		steps += 1
+	}
+	// bounded catch-up debt: excess time carries as slow-mo (E21), never
+	// discarded ticks
+	d.accumulator = min(d.accumulator, d.tick_seconds)
+}
+
+// Run_Context — one run's whole world (ODN-13: created per run, destroyed per
+// run; reset is "make a new one").
+Run_Context :: struct {
+	state:    ^pp.Run_State,
+	driver:   Sim_Driver,
+	snapshot: pp.Snapshot,
+	catalogs: ^pp.Catalogs,
+	arena:    mem.Arena,
+	arena_buf: []u8,
+	paused:   bool,
+	ended:    bool, // health.won || health.lost latched
+	autopilot_wired: map[u32]bool,
+}
+
+ARENA_SIZE :: 16 * 1024 * 1024
+
+run_context_create :: proc(rc: ^Run_Context, seed: u64, catalogs: ^pp.Catalogs) {
+	rc.arena_buf = make([]u8, ARENA_SIZE)
+	mem.arena_init(&rc.arena, rc.arena_buf)
+	alloc := mem.arena_allocator(&rc.arena)
+	rc.state = new(pp.Run_State, alloc)
+	pp.run_init(rc.state, seed, catalogs, alloc)
+	rc.catalogs = catalogs
+	rc.driver.tick = 0
+	rc.driver.accumulator = 0
+	rc.driver.tick_seconds = 1.0 / f64(catalogs.balance.logic_hz)
+	rc.paused = false
+	rc.ended = false
+	rc.autopilot_wired = make(map[u32]bool)
+	resnapshot(rc)
+}
+
+// bare fixture (harness demos with `map bare`): no bootstrap map, no growth.
+run_context_create_bare :: proc(rc: ^Run_Context, seed: u64, catalogs: ^pp.Catalogs) {
+	rc.arena_buf = make([]u8, ARENA_SIZE)
+	mem.arena_init(&rc.arena, rc.arena_buf)
+	alloc := mem.arena_allocator(&rc.arena)
+	rc.state = new(pp.Run_State, alloc)
+	pp.run_init_bare(rc.state, seed, catalogs, alloc)
+	rc.catalogs = catalogs
+	rc.driver.tick = 0
+	rc.driver.accumulator = 0
+	rc.driver.tick_seconds = 1.0 / f64(catalogs.balance.logic_hz)
+	rc.paused = false
+	rc.ended = false
+	rc.autopilot_wired = make(map[u32]bool)
+	resnapshot(rc)
+}
+
+run_context_destroy :: proc(rc: ^Run_Context) {
+	delete(rc.snapshot.nodes)
+	delete(rc.snapshot.pipes)
+	delete(rc.snapshot.packets)
+	delete(rc.snapshot.classes)
+	delete(rc.snapshot.forecasts)
+	delete(rc.autopilot_wired)
+	delete(rc.arena_buf)
+	rc.state = nil
+}
+
+resnapshot :: proc(rc: ^Run_Context) {
+	// permanent allocator: the snapshot must survive per-tick temp resets
+	pp.snapshot_write(&rc.snapshot, rc.state, context.allocator)
+}
+
+// Advance by a wall-clock frame (the app's path). Drains nothing; the caller
+// drains events after the frame's steps (ODN-14).
+run_update :: proc(rc: ^Run_Context, frame_dt: f64) {
+	if rc.paused || rc.ended { return }
+	sim_driver_update(&rc.driver, rc.state, frame_dt)
+	if rc.state.health.won || rc.state.health.lost {
+		rc.ended = true
+	}
+	resnapshot(rc)
+}
+
+// --- the command bus (ODN-12 + the ODN-2 edit fast-path) ----------------------
+//
+// THE PINNED CONVENTION (Perkins r1 replay-divergence lesson): a live edit
+// applies IMMEDIATELY (even paused) with apply_tick = state.tick + 1 — the
+// next tick the sim will execute — and is logged with that apply_tick. Replay
+// applies all entries with apply_tick == N before stepping N, so live play
+// and replay see identical state at every step boundary.
+
+bus_submit :: proc(rc: ^Run_Context, cmd: pp.Command) -> pp.Edit_Error {
+	apply_tick := rc.state.tick + 1
+	nb, _, err := pp.topology_apply_edit(&rc.state.topology, cmd, rc.state.catalogs, rc.state.budget, apply_tick)
+	if err != .None { return err }
+	rc.state.budget = nb
+	logged := cmd
+	logged.apply_tick = apply_tick
+	append(&rc.state.action_log, logged)
+	resnapshot(rc) // the player sees the edit land instantly
+	return .None
+}
+
+// Validation preview (UI hints / draw ghost) without mutating.
+bus_preview :: proc(rc: ^Run_Context, cmd: pp.Command) -> pp.Edit_Error {
+	return pp.validate_command(&rc.state.topology, cmd, rc.state.catalogs, rc.state.budget)
+}
diff --git a/app/run/snap.odin b/app/run/snap.odin
new file mode 100644
index 0000000..6f852a9
--- /dev/null
+++ b/app/run/snap.odin
@@ -0,0 +1,132 @@
+package run
+
+// snap.odin — the Command_Bus's snap-to-node (ODN-12): pointer positions
+// resolve to node ids HERE (the bus), inclusive at the snap radius (E4), so
+// core commands always carry resolved ids and the action log stores
+// post-snap truth. Integer Euclidean² metric (the pinned distance metric).
+
+import pp "../../core"
+
+// Find the nearest live node to a world-pixel point within the snap radius
+// (INCLUSIVE, E4). The metric is integer-pixel Euclidean^2 (rounded) — exact
+// at the boundary, no float-ulp fragility. Ties break to the lower id.
+snap_node :: proc(rc: ^Run_Context, wx_px, wy_px: f64) -> (u32, bool) {
+	t := &rc.state.topology
+	tile := f64(rc.catalogs.balance.tile_px)
+	// the reference's screen-space generosity factor (1.6x), rounded to int px
+	radius_i := i64(f64(rc.catalogs.balance.snap_radius) * 1.6 + 0.5)
+	r2 := radius_i * radius_i
+	best: u32 = 0
+	best_d2 := r2
+	found := false
+	for i in 0 ..< len(t.node_alive) {
+		if !t.node_alive[i] { continue }
+		nx := f64(t.node_pos[i][0]) * tile
+		ny := f64(t.node_pos[i][1]) * tile
+		dx := i64(nx - wx_px + 0.5) if nx >= wx_px else i64(nx - wx_px - 0.5)
+		dy := i64(ny - wy_px + 0.5) if ny >= wy_px else i64(ny - wy_px - 0.5)
+		d2 := dx*dx + dy*dy
+		if d2 <= best_d2 {
+			if d2 == best_d2 && found && t.node_id[i] > best { continue }
+			best = t.node_id[i]
+			best_d2 = d2
+			found = true
+		}
+	}
+	return best, found
+}
+
+// Nearest live pipe to a world-pixel point (for select/priority/demolish).
+// Distance to the RENDERED bezier (sampled polyline), not the straight chord —
+// clicking the visible curve is what hits (the chord can be 30+ px away).
+nearest_pipe :: proc(rc: ^Run_Context, wx_px, wy_px: f64, tolerance_px: f64) -> (u32, bool) {
+	t := &rc.state.topology
+	tile := f64(rc.catalogs.balance.tile_px)
+	best: u32 = 0
+	best_d := tolerance_px
+	found := false
+	for i in 0 ..< len(t.pipe_alive) {
+		if !t.pipe_alive[i] { continue }
+		sa, oka := t.node_by_id[t.pipe_a[i]]
+		sb, okb := t.node_by_id[t.pipe_b[i]]
+		if !oka || !okb { continue }
+		ax := f32(f64(t.node_pos[sa][0]) * tile)
+		ay := f32(f64(t.node_pos[sa][1]) * tile)
+		bx := f32(f64(t.node_pos[sb][0]) * tile)
+		by := f32(f64(t.node_pos[sb][1]) * tile)
+		// pair index (how many earlier live pipes share this unordered pair)
+		pair_idx := 0
+		for j in 0 ..< i {
+			if !t.pipe_alive[j] { continue }
+			if (t.pipe_a[j] == t.pipe_a[i] && t.pipe_b[j] == t.pipe_b[i]) ||
+			   (t.pipe_a[j] == t.pipe_b[i] && t.pipe_b[j] == t.pipe_a[i]) {
+				pair_idx += 1
+			}
+		}
+		cx, cy := pipe_control_point(ax, ay, bx, by, pair_idx)
+		// sample the curve; min distance over the polyline
+		px0, py0 := ax, ay
+		SEG :: 16
+		for s_i in 1 ..= SEG {
+			px1, py1 := bezier_eval(ax, ay, cx, cy, bx, by, f32(s_i) / SEG)
+			d := point_seg_dist(wx_px, wy_px, f64(px0), f64(py0), f64(px1), f64(py1))
+			if d <= best_d {
+				if d == best_d && found && t.pipe_id[i] > best { } else {
+					best = t.pipe_id[i]
+					best_d = d
+					found = true
+				}
+			}
+			px0, py0 = px1, py1
+		}
+	}
+	return best, found
+}
+
+// The bezier control point every pipe renders with (shared with the view —
+// ONE formula, so the hit-test path and the pixel path can't drift apart).
+// Side/magnitude derive from the pair index so parallel pipes curve apart.
+pipe_control_point :: proc(ax, ay, bx, by: f32, pair_idx: int) -> (f32, f32) {
+	mx := (ax + bx) / 2
+	my := (ay + by) / 2
+	dx := bx - ax
+	dy := by - ay
+	length := f32(sqrt_f64(f64(dx*dx + dy*dy)))
+	if length <= 0 { return mx, my }
+	side: f32 = 1 if pair_idx % 2 == 0 else -1
+	mag := length * 0.10 * side * f32(1 + pair_idx / 2)
+	return mx + (-dy / length) * mag, my + (dx / length) * mag
+}
+
+bezier_eval :: proc(ax, ay, cx, cy, bx, by, t: f32) -> (f32, f32) {
+	u := 1 - t
+	return u*u*ax + 2*u*t*cx + t*t*bx, u*u*ay + 2*u*t*cy + t*t*by
+}
+
+point_seg_dist :: proc(px, py, ax, ay, bx, by: f64) -> f64 {
+	dx := bx - ax
+	dy := by - ay
+	l2 := dx*dx + dy*dy
+	if l2 <= 0 { return sqrt_f64((px-ax)*(px-ax) + (py-ay)*(py-ay)) }
+	t := ((px-ax)*dx + (py-ay)*dy) / l2
+	t = clamp_f64(t, 0, 1)
+	cx := ax + t*dx
+	cy := ay + t*dy
+	return sqrt_f64((px-cx)*(px-cx) + (py-cy)*(py-cy))
+}
+
+// View-side float math (never sim state).
+sqrt_f64 :: proc(x: f64) -> f64 {
+	if x <= 0 { return 0 }
+	g := x
+	for _ in 0 ..< 32 {
+		g = (g + x/g) / 2
+	}
+	return g
+}
+
+clamp_f64 :: proc(v, lo, hi: f64) -> f64 {
+	if v < lo { return lo }
+	if v > hi { return hi }
+	return v
+}
diff --git a/app/run/testutil_test.odin b/app/run/testutil_test.odin
new file mode 100644
index 0000000..a3eedbc
--- /dev/null
+++ b/app/run/testutil_test.odin
@@ -0,0 +1,12 @@
+package run
+
+import "core:testing"
+
+tfail :: proc(t: ^testing.T, msg: string) -> ! {
+	testing.fail_now(t, msg)
+}
+
+tfailf :: proc(t: ^testing.T, format: string, args: ..any) -> ! {
+	testing.expectf(t, false, format, ..args)
+	testing.fail_now(t)
+}
diff --git a/core/catalog.odin b/core/catalog.odin
new file mode 100644
index 0000000..4303375
--- /dev/null
+++ b/core/catalog.odin
@@ -0,0 +1,495 @@
+package core
+
+// catalog.odin — data-driven content catalogs (ODN-5). JSON single source,
+// loaded once, fail-fast validated (unknown fields, out-of-range values,
+// cross-reference errors abort with a named error), read-only after load.
+// Sim-relevant values are integers only. The core parses from BYTES — the
+// app/harness own file IO (#load-embedded or disk in dev), so the core never
+// touches core:os.
+
+import "core:encoding/json"
+import "core:fmt"
+
+Packet_Type :: struct {
+	id:               string,
+	display:          string,
+	color:            [4]u8,  // cosmetic
+	shape:            string, // cosmetic — "circle" | "triangle" | ...
+	latency_tol_ms:   i32,
+	max_loss_pct:     i32,
+	bandwidth_demand: i32,
+	default_lane:     Lane,
+	era_introduced:   i32,
+	sla_fail_effect:  string,
+	demand_weight:    i32,
+}
+
+Pipe_Tier :: struct {
+	id:             string,
+	display:        string,
+	capacity_units: i32,
+	clean_span:     i32,
+	max_span:       i32,
+	cost_per_tile:  i32,
+	era_introduced: i32,
+}
+
+Node_Type :: struct {
+	id:               string,
+	display:          string,
+	kind:             Node_Kind,
+	terminal_role:    Terminal_Role,
+	throughput_units: i32,
+	lb_mode_capable:  bool,
+	era_introduced:   i32,
+	port_capacity:    i32, // 0 = unlimited (terminals); 4/8/16 for router tiers
+}
+
+// A per-source-class demand entry: WHAT traffic flows and WHERE it wants to
+// go; the player's topology decides HOW it routes.
+Demand_Entry :: struct {
+	class:         u16, // packet_types index (resolved at load)
+	source_role:   Terminal_Role,
+	sink_role:     Terminal_Role,
+	volume:        i32, // packets per tick (base)
+	default_lane:  Lane,
+	demand_weight: i32,
+}
+
+Set_Piece :: struct {
+	id:                 string,
+	class:              u16,
+	multiplier:         i32,
+	start_tick:         u64,
+	duration_ticks:     u64,
+	forecast_lead_ticks: u64,
+}
+
+set_piece_active :: proc(sp: ^Set_Piece, tick: u64) -> bool {
+	return tick >= sp.start_tick && tick < sp.start_tick + sp.duration_ticks
+}
+
+set_piece_forecasted :: proc(sp: ^Set_Piece, tick: u64) -> bool {
+	return sp.forecast_lead_ticks <= sp.start_tick &&
+	       tick >= sp.start_tick - sp.forecast_lead_ticks && tick < sp.start_tick
+}
+
+Demand_Catalog :: struct {
+	entries:    [dynamic]Demand_Entry, // era-3 base entries (PROTO runs era 3)
+	set_pieces: [dynamic]Set_Piece,
+}
+
+Balance :: struct {
+	logic_hz:                     i32,
+	snap_radius:                  i32,
+	win_uptime_pct:               i32,
+	breach_exit_pct:              i32, // E30 hysteresis: recovery threshold (> enter)
+	grace_window_ticks:           i32,
+	grace_refill_per_tick:        i32, // gradual refill — no instant re-arm
+	grace_refill_streak_ticks:    i32, // recovery-streak gate before refill starts
+	meter_drain_per_tick_max:     i32,
+	meter_recharge_per_tick:      i32,
+	meter_start_pct:              i32,
+	health_strain_threshold_pct:  i32,
+	health_critical_threshold_pct: i32,
+	queue_drop_depth:             i32,
+	default_lane_weights:         [3]i32,
+	emphasis_preset:              [3]i32,
+	default_budget:               i32,
+	packet_pool_cap:              i32,
+	rolling_window_ticks:         i32,
+	growth_first_tick:            i32,
+	growth_interval_ticks:        i32,
+	growth_interval_short_ticks:  i32,
+	growth_min_dist_tiles:        i32,
+	growth_spawn_near_junction:   i32,
+	growth_pool_size:             i32,
+	growth_box:                   [4]i32, // x0, x1, y0, y1 (inclusive)
+	growth_roles:                 [dynamic]string, // node_type ids, in spawn order
+	map_w_tiles:                  i32,
+	map_h_tiles:                  i32,
+	tile_px:                      i32,
+}
+
+Crisis_Def :: struct {
+	archetype:           string,
+	display:             string,
+	root_cause_pattern:  string,
+	preventive_redesign: string,
+	lead_time_ticks:     i32,
+	failure_effect:      string,
+}
+
+Catalogs :: struct {
+	packet_types: [dynamic]Packet_Type,
+	pipe_tiers:   [dynamic]Pipe_Tier,
+	node_types:   [dynamic]Node_Type,
+	demand:       Demand_Catalog,
+	crises:       [dynamic]Crisis_Def,
+	balance:      Balance,
+	hash:         u64, // FNV-1a-64 over the exact source bytes, fixed order
+}
+
+Catalog_Sources :: struct {
+	packet_types: []byte,
+	pipe_tiers:   []byte,
+	node_types:   []byte,
+	demand:       []byte,
+	crises:       []byte,
+	balance:      []byte,
+}
+
+catalogs_hash_sources :: proc(src: ^Catalog_Sources) -> u64 {
+	h: u64 = 14695981039346656037
+	mix := proc(h: ^u64, bytes: []byte) {
+		for b in bytes {
+			h^ = (h^ ~ u64(b)) * 1099511628211
+		}
+	}
+	mix(&h, src.packet_types)
+	mix(&h, src.pipe_tiers)
+	mix(&h, src.node_types)
+	mix(&h, src.demand)
+	mix(&h, src.crises)
+	mix(&h, src.balance)
+	return h
+}
+
+fnv1a64 :: proc(bytes: []byte) -> u64 {
+	h: u64 = 14695981039346656037
+	for b in bytes {
+		h = (h ~ u64(b)) * 1099511628211
+	}
+	return h
+}
+
+// --- load-time validation helpers --------------------------------------------
+// Fail-fast with a named error (ODN-5): which file, which field, what rule.
+
+Catalog_Error :: struct {
+	file:  string,
+	field: string,
+	rule:  string,
+}
+
+catalogs_load :: proc(src: ^Catalog_Sources, allocator := context.allocator) -> (cat: ^Catalogs, err: Catalog_Error) {
+	context.allocator = allocator
+	cat = new(Catalogs)
+	cat.hash = catalogs_hash_sources(src)
+
+	root: json.Value
+
+	// packet_types
+	{
+		v, e := json.parse(src.packet_types, parse_integers = true)
+		if e != nil { return cat, {"packet_types.json", "$", "invalid JSON"} }
+		root = v
+		obj, ok := root.(json.Object)
+		if !ok { return cat, {"packet_types.json", "$", "root must be an object"} }
+		entries, ok2 := obj["entries"].(json.Array)
+		if !ok2 { return cat, {"packet_types.json", "entries", "missing array"} }
+		for ev in entries {
+			eo := ev.(json.Object) or_continue
+			pt: Packet_Type
+			pt.id = jstr(eo, "id")
+			pt.display = jstr(eo, "display_name")
+			c := jarr_i(eo, "color_rgba")
+			if len(c) == 4 { pt.color = {u8(c[0]), u8(c[1]), u8(c[2]), u8(c[3])} }
+			pt.shape = jstr(eo, "shape")
+			pt.latency_tol_ms = jint(eo, "latency_tol_ms", 500)
+			pt.max_loss_pct = jint(eo, "max_loss_pct", 30)
+			pt.bandwidth_demand = jint(eo, "bandwidth_demand", 1)
+			pt.default_lane = Lane(clamp(jint(eo, "default_lane", 1), 0, 2))
+			pt.era_introduced = jint(eo, "era_introduced", 1)
+			pt.sla_fail_effect = jstr(eo, "sla_fail_effect")
+			pt.demand_weight = jint(eo, "demand_weight", 1)
+			if pt.id == "" { return cat, {"packet_types.json", "id", "empty id"} }
+			if pt.bandwidth_demand < 1 { return cat, {"packet_types.json", pt.id, "bandwidth_demand must be >= 1"} }
+			append(&cat.packet_types, pt)
+		}
+		if len(cat.packet_types) == 0 { return cat, {"packet_types.json", "entries", "empty"} }
+		if len(cat.packet_types) > MAX_CLASSES { return cat, {"packet_types.json", "entries", "too many classes"} }
+	}
+
+	// pipe_tiers
+	{
+		v, e := json.parse(src.pipe_tiers, parse_integers = true)
+		if e != nil { return cat, {"pipe_tiers.json", "$", "invalid JSON"} }
+		obj, okp := v.(json.Object)
+		if !okp { return cat, {"pipe_tiers.json", "$", "root must be an object"} }
+		entries, oke := obj["entries"].(json.Array)
+		if !oke { return cat, {"pipe_tiers.json", "entries", "missing array"} }
+		for ev in entries {
+			eo := ev.(json.Object) or_continue
+			t: Pipe_Tier
+			t.id = jstr(eo, "id")
+			t.display = jstr(eo, "display_name")
+			t.capacity_units = jint(eo, "capacity_units", 0)
+			t.clean_span = jint(eo, "clean_span", 0)
+			t.max_span = jint(eo, "max_span", 0)
+			t.cost_per_tile = jint(eo, "cost_per_tile", 0)
+			t.era_introduced = jint(eo, "era_introduced", 1)
+			if t.id == "" || t.capacity_units <= 0 || t.max_span <= 0 {
+				return cat, {"pipe_tiers.json", t.id, "id/capacity/max_span invalid"}
+			}
+			append(&cat.pipe_tiers, t)
+		}
+		if len(cat.pipe_tiers) == 0 { return cat, {"pipe_tiers.json", "entries", "empty"} }
+	}
+
+	// node_types
+	{
+		v, e := json.parse(src.node_types, parse_integers = true)
+		if e != nil { return cat, {"node_types.json", "$", "invalid JSON"} }
+		obj, okn := v.(json.Object)
+		if !okn { return cat, {"node_types.json", "$", "root must be an object"} }
+		entries, okn2 := obj["entries"].(json.Array)
+		if !okn2 { return cat, {"node_types.json", "entries", "missing array"} }
+		for ev in entries {
+			eo := ev.(json.Object) or_continue
+			nt: Node_Type
+			nt.id = jstr(eo, "id")
+			nt.display = jstr(eo, "display_name")
+			kind := jstr(eo, "kind")
+			switch kind {
+			case "terminal": nt.kind = .Terminal
+			case "junction": nt.kind = .Junction
+			case: return cat, {"node_types.json", nt.id, "kind must be terminal|junction"}
+			}
+			nt.terminal_role = role_from_name(jstr(eo, "terminal_role"))
+			nt.throughput_units = jint(eo, "throughput_units", 0)
+			nt.lb_mode_capable = jbool(eo, "lb_mode_capable")
+			nt.era_introduced = jint(eo, "era_introduced", 1)
+			nt.port_capacity = jint(eo, "port_capacity", 0)
+			if nt.id == "" { return cat, {"node_types.json", "id", "empty id"} }
+			if nt.kind == .Terminal && nt.terminal_role == .None {
+				return cat, {"node_types.json", nt.id, "terminal without a role"}
+			}
+			append(&cat.node_types, nt)
+		}
+		if len(cat.node_types) == 0 { return cat, {"node_types.json", "entries", "empty"} }
+	}
+
+	// demand (PROTO reads era "3" — the surge slice)
+	{
+		v, e := json.parse(src.demand, parse_integers = true)
+		if e != nil { return cat, {"demand.json", "$", "invalid JSON"} }
+		obj, okd := v.(json.Object)
+		if !okd { return cat, {"demand.json", "$", "root must be an object"} }
+		eras, oker := obj["eras"].(json.Object)
+		if !oker { return cat, {"demand.json", "eras", "missing"} }
+		era3, oke3 := eras["3"].(json.Object)
+		if !oke3 { return cat, {"demand.json", "eras.3", "PROTO requires the era-3 demand set"} }
+		entries, oke4 := era3["entries"].(json.Array)
+		if !oke4 { return cat, {"demand.json", "eras.3.entries", "missing array"} }
+		for ev in entries {
+			eo := ev.(json.Object) or_continue
+			de: Demand_Entry
+			cls, okc := class_index(cat, jstr(eo, "class_id"))
+			if !okc { return cat, {"demand.json", jstr(eo, "class_id"), "unknown class"} }
+			de.class = cls
+			de.source_role = role_from_name(jstr(eo, "source_role"))
+			de.sink_role = role_from_name(jstr(eo, "sink_role"))
+			de.volume = jint(eo, "volume", 0)
+			de.default_lane = Lane(clamp(jint(eo, "default_lane", 1), 0, 2))
+			de.demand_weight = jint(eo, "demand_weight", 1)
+			append(&cat.demand.entries, de)
+		}
+		if sps, oks := era3["set_pieces"].(json.Array); oks {
+			for sv in sps {
+				so := sv.(json.Object) or_continue
+				sp: Set_Piece
+				sp.id = jstr(so, "id")
+				cls, okc := class_index(cat, jstr(so, "class_id"))
+				if !okc { return cat, {"demand.json", sp.id, "set-piece unknown class"} }
+				sp.class = cls
+				sp.multiplier = jint(so, "multiplier", 1)
+				sp.start_tick = u64(jint(so, "start_tick", 0))
+				sp.duration_ticks = u64(jint(so, "duration_ticks", 0))
+				sp.forecast_lead_ticks = u64(jint(so, "forecast_lead_ticks", 0))
+				append(&cat.demand.set_pieces, sp)
+			}
+		}
+	}
+
+	// crises (PROTO ships Surge only; the frame takes the rest as content)
+	{
+		v, e := json.parse(src.crises, parse_integers = true)
+		if e != nil { return cat, {"crises.json", "$", "invalid JSON"} }
+		obj, okc := v.(json.Object)
+		if !okc { return cat, {"crises.json", "$", "root must be an object"} }
+		entries, oke := obj["entries"].(json.Array)
+		if !oke { return cat, {"crises.json", "entries", "missing array"} }
+		for ev in entries {
+			eo := ev.(json.Object) or_continue
+			cd: Crisis_Def
+			cd.archetype = jstr(eo, "archetype")
+			cd.display = jstr(eo, "display_name")
+			cd.root_cause_pattern = jstr(eo, "root_cause_pattern")
+			cd.preventive_redesign = jstr(eo, "preventive_redesign")
+			cd.lead_time_ticks = jint(eo, "lead_time_ticks", 0)
+			cd.failure_effect = jstr(eo, "failure_effect")
+			if cd.archetype == "" { return cat, {"crises.json", "archetype", "empty"} }
+			append(&cat.crises, cd)
+		}
+	}
+
+	// balance
+	{
+		v, e := json.parse(src.balance, parse_integers = true)
+		if e != nil { return cat, {"balance.json", "$", "invalid JSON"} }
+		obj, okb := v.(json.Object)
+		if !okb { return cat, {"balance.json", "$", "root must be an object"} }
+		b: Balance
+		b.logic_hz = jint(obj, "logic_hz", 0)
+		if b.logic_hz <= 0 || 1000 % b.logic_hz != 0 {
+			return cat, {"balance.json", "logic_hz", "must be > 0 and divide 1000 (single source of tick timing — Perkins r1)"}
+		}
+		b.snap_radius = jint(obj, "snap_radius", 36)
+		b.win_uptime_pct = jint(obj, "win_uptime_pct", 90)
+		b.breach_exit_pct = jint(obj, "breach_exit_pct", 93)
+		b.grace_window_ticks = jint(obj, "grace_window_ticks", 200)
+		b.grace_refill_per_tick = jint(obj, "grace_refill_per_tick", 5)
+		b.grace_refill_streak_ticks = jint(obj, "grace_refill_streak_ticks", 50)
+		b.meter_drain_per_tick_max = jint(obj, "meter_drain_per_tick_max", 2)
+		b.meter_recharge_per_tick = jint(obj, "meter_recharge_per_tick", 1)
+		b.meter_start_pct = jint(obj, "meter_start_pct", 100)
+		b.health_strain_threshold_pct = jint(obj, "health_strain_threshold_pct", 70)
+		b.health_critical_threshold_pct = jint(obj, "health_critical_threshold_pct", 90)
+		b.queue_drop_depth = jint(obj, "queue_drop_depth", 60)
+		b.default_lane_weights = jw3(obj, "default_lane_weights", {1, 4, 1})
+		b.emphasis_preset = jw3(obj, "emphasis_preset", {4, 1, 1})
+		b.default_budget = jint(obj, "default_budget", 5200)
+		b.packet_pool_cap = jint(obj, "packet_pool_cap", 6000)
+		b.rolling_window_ticks = jint(obj, "rolling_window_ticks", 100)
+		b.growth_first_tick = jint(obj, "growth_first_tick", 400)
+		b.growth_interval_ticks = jint(obj, "growth_interval_ticks", 400)
+		b.growth_interval_short_ticks = jint(obj, "growth_interval_short_ticks", 260)
+		b.growth_min_dist_tiles = jint(obj, "growth_min_dist_tiles", 7)
+		b.growth_spawn_near_junction = jint(obj, "growth_spawn_near_junction", 12)
+		b.growth_pool_size = jint(obj, "growth_pool_size", 24)
+		if gb, okg := obj["growth_box"].(json.Object); okg {
+			b.growth_box = {jint(gb, "x0", 6), jint(gb, "x1", 34), jint(gb, "y0", 4), jint(gb, "y1", 26)}
+		}
+		if gr, okg := obj["growth_roles"].(json.Array); okg {
+			for rv in gr {
+				role := rv.(json.String) or_continue
+				if _, okn := node_type_index(cat, role); !okn {
+					return cat, {"balance.json", role, "growth role names an unknown node type"}
+				}
+				append(&b.growth_roles, role)
+			}
+		}
+		if mp, okg := obj["map"].(json.Object); okg {
+			b.map_w_tiles = jint(mp, "w_tiles", 40)
+			b.map_h_tiles = jint(mp, "h_tiles", 30)
+			b.tile_px = jint(mp, "tile_px", 26)
+		}
+		if b.rolling_window_ticks <= 0 || b.rolling_window_ticks > ROLLING_MAX {
+			return cat, {"balance.json", "rolling_window_ticks", "must be 1..ROLLING_MAX"}
+		}
+		if b.breach_exit_pct < b.win_uptime_pct || b.breach_exit_pct > 100 {
+			return cat, {"balance.json", "breach_exit_pct", "must be >= win_uptime_pct and <= 100 (E30 hysteresis)"}
+		}
+		if b.health_critical_threshold_pct <= b.health_strain_threshold_pct {
+			return cat, {"balance.json", "health_critical_threshold_pct", "must exceed the strain threshold"}
+		}
+		if b.map_w_tiles <= 0 || b.map_h_tiles <= 0 || b.tile_px <= 0 {
+			return cat, {"balance.json", "map", "map dims/tile_px must be > 0"}
+		}
+		cat.balance = b
+	}
+
+	// cross-reference + required-content checks (ODN-5 fail-fast)
+	if _, ok := node_type_index(cat, "content_host"); !ok {
+		return cat, {"node_types.json", "content_host", "PROTO requires the content_host type"}
+	}
+	if _, ok := node_type_index(cat, "residential"); !ok {
+		return cat, {"node_types.json", "residential", "PROTO requires the residential type"}
+	}
+	if _, ok := node_type_index(cat, "router_mid"); !ok {
+		return cat, {"node_types.json", "router_mid", "PROTO requires the router_mid type"}
+	}
+	if _, ok := class_index(cat, "email"); !ok {
+		return cat, {"packet_types.json", "email", "PROTO requires the email class"}
+	}
+	if _, ok := class_index(cat, "streaming"); !ok {
+		return cat, {"packet_types.json", "streaming", "PROTO requires the streaming class"}
+	}
+	return cat, {}
+}
+
+MAX_CLASSES :: 12
+
+class_index :: proc(cat: ^Catalogs, id: string) -> (u16, bool) {
+	for pt, i in cat.packet_types {
+		if pt.id == id { return u16(i), true }
+	}
+	return 0, false
+}
+
+tier_index :: proc(cat: ^Catalogs, id: string) -> (u16, bool) {
+	for t, i in cat.pipe_tiers {
+		if t.id == id { return u16(i), true }
+	}
+	return 0, false
+}
+
+node_type_index :: proc(cat: ^Catalogs, id: string) -> (u16, bool) {
+	for nt, i in cat.node_types {
+		if nt.id == id { return u16(i), true }
+	}
+	return 0, false
+}
+
+role_from_name :: proc(name: string) -> Terminal_Role {
+	switch name {
+	case "residential":  return .Residential
+	case "content_host": return .Content_Host
+	}
+	return .None
+}
+
+// --- tiny JSON accessors (parse_integers = true => numbers are json.Integer) --
+
+jstr :: proc(o: json.Object, key: string) -> string {
+	if v, ok := o[key].(json.String); ok { return v }
+	return ""
+}
+
+jint :: proc(o: json.Object, key: string, def: i32) -> i32 {
+	if v, ok := o[key]; ok {
+		#partial switch x in v {
+		case json.Integer: return i32(x)
+		case json.Float:   return i32(x)
+		}
+	}
+	return def
+}
+
+jbool :: proc(o: json.Object, key: string) -> bool {
+	if v, ok := o[key].(json.Boolean); ok { return bool(v) }
+	return false
+}
+
+jarr_i :: proc(o: json.Object, key: string) -> [dynamic]i64 {
+	out: [dynamic]i64
+	if v, ok := o[key].(json.Array); ok {
+		for x in v {
+			if n, okn := x.(json.Integer); okn { append(&out, i64(n)) }
+		}
+	}
+	return out
+}
+
+jw3 :: proc(o: json.Object, key: string, def: [3]i32) -> [3]i32 {
+	a := jarr_i(o, key)
+	if len(a) == 3 { return {i32(a[0]), i32(a[1]), i32(a[2])} }
+	return def
+}
+
+// Catalog errors stringify through here (the app surfaces them at startup;
+// core never touches fmt-for-side-effects, so this stays a pure formatter).
+catalog_error_string :: proc(err: Catalog_Error, allocator := context.allocator) -> string {
+	return fmt.aprintf("catalog %s: field %r — %s", err.file, err.field, err.rule, allocator = allocator)
+}
diff --git a/core/catalogs_testkit.odin b/core/catalogs_testkit.odin
new file mode 100644
index 0000000..832b7e2
--- /dev/null
+++ b/core/catalogs_testkit.odin
@@ -0,0 +1,20 @@
+package core
+
+// catalogs_testkit.odin — shared test/harness fixture: the REAL catalogs,
+// #load-embedded (compile-time; the core itself never touches the filesystem).
+// Tests and the harness run against the exact shipping data (ODN-5).
+
+test_catalog_sources :: proc(src: ^Catalog_Sources) {
+	src.packet_types = #load("../data/packet_types.json")
+	src.pipe_tiers   = #load("../data/pipe_tiers.json")
+	src.node_types   = #load("../data/node_types.json")
+	src.demand       = #load("../data/demand.json")
+	src.crises       = #load("../data/crises.json")
+	src.balance      = #load("../data/balance.json")
+}
+
+must_catalogs :: proc() -> (^Catalogs, Catalog_Error) {
+	src: Catalog_Sources
+	test_catalog_sources(&src)
+	return catalogs_load(&src)
+}
diff --git a/core/command.odin b/core/command.odin
new file mode 100644
index 0000000..583ee13
--- /dev/null
+++ b/core/command.odin
@@ -0,0 +1,66 @@
+package core
+
+// command.odin — validated Commands (ODN-12). Raw input becomes an Intent in
+// the app; the Command_Bus resolves it (snap-to-node, preview) into a Command;
+// the core's topology_apply_edit is the single validation authority. The
+// action log stores post-validation, post-snap commands (ODN-11), so replay
+// can never drift from live play on legality.
+
+Command :: struct {
+	// apply_tick is the tick the command is applied at in replay. Live edits
+	// land IMMEDIATELY via the edit fast-path (ODN-2) and are logged with
+	// apply_tick = next tick; replay applies all entries with apply_tick == N
+	// before stepping N — live and replay see identical state at every step
+	// boundary. THE CONVENTION IS PINNED by replay_test.odin (Perkins r1 on
+	// the Godot prototype: an undocumented +1 convention diverged replays).
+	apply_tick: u64,
+	kind:       Command_Kind,
+}
+
+Command_Kind :: union {
+	Cmd_Draw_Pipe,
+	Cmd_Upgrade_Pipe,
+	Cmd_Demolish,
+	Cmd_Set_Lane_Weights,
+	Cmd_Set_Pipe_Priority,
+	Cmd_Set_Junction_Triage,
+}
+
+Cmd_Draw_Pipe :: struct {
+	a, b: u32,      // node ids (resolved, post-snap)
+	tier: u16,      // pipe_tiers catalog index
+}
+
+Cmd_Upgrade_Pipe :: struct {
+	pipe:    u32,
+	to_tier: u16,
+}
+
+// is_node: demolishing a junction severs ALL incident pipes first (in pipe-id
+// order — deterministic, E27), each per E1 (reroute-or-drop), then removes the
+// vertex. Perkins r1 on the Godot prototype: one-pipe-per-neighbor cascades
+// left ghost pipes when parallel pipes shared a neighbor — the Odin cascade
+// collects by incidence, not by neighbor.
+Cmd_Demolish :: struct {
+	target:  u32,
+	is_node: bool,
+}
+
+Cmd_Set_Lane_Weights :: struct {
+	pipe:    u32,
+	weights: [3]i32,
+}
+
+// The PROTO QoS surface (GDD § M2 'priority emphasis' dial): "" = neutral
+// (all classes ride Standard), else the named class rides Express and the
+// others ride Best on this pipe.
+Cmd_Set_Pipe_Priority :: struct {
+	pipe:         u32,
+	priority:     i32, // class index, or -1 for neutral
+}
+
+// Junction triage (E2.3): which class wins contention THROUGH this junction.
+Cmd_Set_Junction_Triage :: struct {
+	junction: u32,
+	triage:   i32, // class index, or -1 for neutral
+}
diff --git a/core/crisis.odin b/core/crisis.odin
new file mode 100644
index 0000000..645eb68
--- /dev/null
+++ b/core/crisis.odin
@@ -0,0 +1,87 @@
+package core
+
+// crisis.odin — S4 Crisis Engine (ODN-4, architecture §6.4; PROTO ships the
+// Surge archetype only). DOWNSTREAM of the flow: reads topology + flow state,
+// produces warnings + crisis events. Never owns the demand timeline (that's
+// the Director, upstream — a crisis is a consequence, never its own cause,
+// REVIEW M1). Fairness is structural here: node health derives from MEASURED
+// load (never a phantom), the surge is forecast by the catalog timeline, and
+// every Crisis_Triggered carries a structured root_cause + the preventive
+// redesign lives in crises.json.
+//
+// Dedup (E13): one active crisis per root cause across the whole activation —
+// the surge fires once, resolves once; warnings fire on transitions only.
+
+Crisis_State :: struct {
+	node_health:  [dynamic]Health_State, // per node slot
+	surge_active: bool,
+}
+
+crisis_ensure :: proc(c: ^Crisis_State, t: ^Topology) {
+	if len(c.node_health) < len(t.node_alive) {
+		n := len(t.node_alive) - len(c.node_health)
+		for _ in 0 ..< n { append(&c.node_health, Health_State.Healthy) }
+	}
+}
+
+crisis_evaluate :: proc(state: ^Run_State, tick: u64, plan: ^Pressure_Plan) {
+	c := &state.crisis
+	t := &state.topology
+	f := &state.flow
+	cat := state.catalogs
+	bal := &cat.balance
+	crisis_ensure(c, t)
+
+	// Node health from this tick's measured load (the warning surface; the
+	// strain/critical thresholds are catalog values). 🔴 is always traceable
+	// to a measured load — never a phantom.
+	for i in 0 ..< len(t.node_alive) {
+		if !t.node_alive[i] {
+			c.node_health[i] = .Healthy
+			continue
+		}
+		level := Health_State.Healthy
+		if t.node_throughput[i] > 0 && i < len(f.node_load) {
+			pct := (f.node_load[i] * 100) / t.node_throughput[i]
+			if pct >= bal.health_critical_threshold_pct {
+				level = .Critical
+			} else if pct >= bal.health_strain_threshold_pct {
+				level = .Strained
+			}
+		}
+		prev := c.node_health[i]
+		if level != prev {
+			c.node_health[i] = level
+			if level == .Healthy {
+				emit(state, tick, Ev_Warning_Cleared{node = t.node_id[i]})
+			} else {
+				emit(state, tick, Ev_Warning_Raised{node = t.node_id[i], level = level})
+			}
+		}
+	}
+
+	// The forecast ("weather report") + surge lifecycle, from the catalog
+	// timeline the Director owns. Dedup via the Director_State flags.
+	d := &state.director
+	for i in 0 ..< len(cat.demand.set_pieces) {
+		if i >= len(d.forecasted) { break }
+		sp := &cat.demand.set_pieces[i]
+		if !d.forecasted[i] && set_piece_forecasted(sp, tick) {
+			d.forecasted[i] = true
+			emit(state, tick, Ev_Forecast_Issued{set_piece = u16(i)})
+		}
+		if !d.triggered[i] && set_piece_active(sp, tick) {
+			d.triggered[i] = true
+			c.surge_active = true
+			// Fairness contract: the structured root cause + preventive
+			// redesign (crises.json carries the copy).
+			rc := Root_Cause{pattern = .No_Spare_Capacity_For_Forecast_Spike, node = 0}
+			emit(state, tick, Ev_Crisis_Triggered{archetype = .Surge, set_piece = u16(i), root_cause = rc})
+		}
+		if d.triggered[i] && !d.resolved[i] && tick >= sp.start_tick + sp.duration_ticks {
+			d.resolved[i] = true
+			c.surge_active = false
+			emit(state, tick, Ev_Crisis_Resolved{archetype = .Surge, set_piece = u16(i)})
+		}
+	}
+}
diff --git a/core/demand.odin b/core/demand.odin
new file mode 100644
index 0000000..7c7301f
--- /dev/null
+++ b/core/demand.odin
@@ -0,0 +1,166 @@
+package core
+
+// demand.odin — the scripted CrisisDirector (ODN-7, architecture §6.4). The
+// Director owns the demand timeline + map growth UPSTREAM of the flow; the
+// Crisis Engine evaluates DOWNSTREAM; the Director must never read crisis
+// state (REVIEW M1) — here that rule is structural: plan_pressure receives no
+// handle to Run_State.
+//
+// plan_pressure is pure w.r.t. sim state in PROTO: a function of
+// (era, tick, catalog) — the rng parameter exists for the seam contract
+// (ODN-7) and the scripted impl never draws from it (Perkins r1: a display-
+// path plan call must not perturb the sim's rng stream — the scripted plan
+// consumes none, ever).
+//
+// Map growth (E31): the candidate pool is drawn from the run's seeded rng ONCE
+// at bootstrap (24 positions), so growth consumes zero rng during the run and
+// the demand stream is untouched. Spawns proceed OUTWARD from the router mesh
+// (within growth_spawn_near_junction of a junction) with a minimum separation;
+// the pool is rejection-sampled deterministically, then a full row-major scan
+// fallback, then a min-dist-only scan (never strand a spawn far from the
+// network — the lesson the Godot prototype paid for).
+
+Pressure_Plan :: struct {
+	tick:       u64,
+	entries:    []Demand_Entry,   // base demand (slice into the catalog — read-only)
+	set_pieces: [dynamic]u16,     // active set-piece indices this tick
+}
+
+effective_volume :: proc(plan: ^Pressure_Plan, class: u16, base: i32, cat: ^Catalogs) -> i32 {
+	v := base
+	for sp_idx in plan.set_pieces {
+		sp := cat.demand.set_pieces[sp_idx]
+		if sp.class == class && set_piece_active(&sp, plan.tick) {
+			v *= sp.multiplier
+		}
+	}
+	return v
+}
+
+Director_State :: struct {
+	growth_pool:     [dynamic][2]i32,
+	growth_pool_idx: int,
+	growth_next:     u64,
+	growth_done:     int,
+	forecasted:      [dynamic]bool, // per set-piece: forecast event already issued
+	triggered:       [dynamic]bool, // per set-piece: crisis event fired
+	resolved:        [dynamic]bool,
+}
+
+director_init_growth :: proc(d: ^Director_State, rng: ^Rng, bal: ^Balance, allocator := context.allocator) {
+	context.allocator = allocator
+	clear(&d.growth_pool)
+	for _ in 0 ..< bal.growth_pool_size {
+		x := rng_range(rng, bal.growth_box[0], bal.growth_box[1])
+		y := rng_range(rng, bal.growth_box[2], bal.growth_box[3])
+		append(&d.growth_pool, [2]i32{x, y})
+	}
+	d.growth_pool_idx = 0
+	d.growth_next = u64(bal.growth_first_tick)
+	d.growth_done = 0
+}
+
+scripted_plan_pressure :: proc(cat: ^Catalogs, tick: u64, scratch := context.temp_allocator) -> Pressure_Plan {
+	plan: Pressure_Plan
+	plan.tick = tick
+	plan.entries = cat.demand.entries[:]
+	plan.set_pieces = make([dynamic]u16, scratch)
+	for sp, i in cat.demand.set_pieces {
+		s := sp
+		if set_piece_active(&s, tick) {
+			append(&plan.set_pieces, u16(i))
+		}
+	}
+	return plan
+}
+
+// Growth due this tick (0 or 1 spawn), deterministic given (seed, tick,
+// topology). Returns (type_idx, pos, ok). Emits nothing — Run_State applies
+// the spawn and emits Ev_Node_Spawned.
+director_plan_growth :: proc(d: ^Director_State, t: ^Topology, cat: ^Catalogs, tick: u64) -> (u16, [2]i32, bool) {
+	bal := &cat.balance
+	if len(bal.growth_roles) == 0 { return 0, {}, false }
+	if d.growth_done >= len(bal.growth_roles) { return 0, {}, false }
+	if tick < d.growth_next { return 0, {}, false }
+	role := bal.growth_roles[d.growth_done]
+	type_idx, ok := node_type_index(cat, role)
+	if !ok { return 0, {}, false }
+	pos, found := next_growth_pos(d, t, bal)
+	if !found {
+		// stall throttle: retry after the interval, never full-scan every tick
+		d.growth_next = tick + u64(max(1, bal.growth_interval_ticks))
+		return 0, {}, false
+	}
+	d.growth_done += 1
+	interval := bal.growth_interval_ticks
+	if d.growth_done >= (len(bal.growth_roles)+1)/2 {
+		interval = bal.growth_interval_short_ticks
+	}
+	d.growth_next = tick + u64(max(1, interval))
+	return type_idx, pos, true
+}
+
+manhattan :: proc(a, b: [2]i32) -> i32 {
+	return abs(a[0]-b[0]) + abs(a[1]-b[1])
+}
+
+min_dist_ok :: proc(t: ^Topology, cand: [2]i32, min_d: i32) -> bool {
+	for i in 0 ..< len(t.node_alive) {
+		if !t.node_alive[i] { continue }
+		if manhattan(t.node_pos[i], cand) < min_d { return false }
+	}
+	return true
+}
+
+pos_free :: proc(t: ^Topology, cand: [2]i32, bal: ^Balance) -> bool {
+	near_junction := false
+	for i in 0 ..< len(t.node_alive) {
+		if !t.node_alive[i] { continue }
+		d := manhattan(t.node_pos[i], cand)
+		if d < bal.growth_min_dist_tiles { return false }
+		if t.node_kind[i] == .Junction && d <= bal.growth_spawn_near_junction {
+			near_junction = true
+		}
+	}
+	return near_junction
+}
+
+next_growth_pos :: proc(d: ^Director_State, t: ^Topology, bal: ^Balance) -> ([2]i32, bool) {
+	pool := len(d.growth_pool)
+	if pool > 0 {
+		for i in 0 ..< pool {
+			cand := d.growth_pool[(d.growth_pool_idx+i)%pool]
+			if pos_free(t, cand, bal) {
+				d.growth_pool_idx = (d.growth_pool_idx + i + 1) % pool
+				return cand, true
+			}
+		}
+	}
+	// Fallback: exhaustive deterministic row-major scan, full check.
+	for y in bal.growth_box[2] ..= bal.growth_box[3] {
+		for x in bal.growth_box[0] ..= bal.growth_box[1] {
+			cand := [2]i32{x, y}
+			if pos_free(t, cand, bal) { return cand, true }
+		}
+	}
+	// Last resort: anchored at each junction, scanning outward for the nearest
+	// cell that respects min separation — a spawn is ALWAYS reachable from the
+	// mesh (E31; never the min-dist-only-anywhere scan that stranded a house
+	// 20+ tiles from every router in the Godot prototype).
+	for i in 0 ..< len(t.node_alive) {
+		if !t.node_alive[i] || t.node_kind[i] != .Junction { continue }
+		base := t.node_pos[i]
+		for radius in bal.growth_min_dist_tiles ..= bal.growth_spawn_near_junction {
+			for dy in -radius ..= radius {
+				for dx in -radius ..= radius {
+					if abs(dx) + abs(dy) != radius { continue } // ring only
+					cand := [2]i32{base[0] + dx, base[1] + dy}
+					if cand[0] < bal.growth_box[0] || cand[0] > bal.growth_box[1] ||
+					   cand[1] < bal.growth_box[2] || cand[1] > bal.growth_box[3] { continue }
+					if min_dist_ok(t, cand, bal.growth_min_dist_tiles) { return cand, true }
+				}
+			}
+		}
+	}
+	return {}, false
+}
diff --git a/core/determinism_test.odin b/core/determinism_test.odin
new file mode 100644
index 0000000..3df11d8
--- /dev/null
+++ b/core/determinism_test.odin
@@ -0,0 +1,144 @@
+package core
+
+// determinism_test.odin — THE determinism spine (ODN-1/9/10; the briefing's
+// ONE hard blocker). Closes the three Perkins r1 gaps from the Godot
+// prototype:
+//   (a) the fingerprint covers ALL in-flight packet state + latency + rng
+//       (see serialize.odin),
+//   (b) replay-equality runs on a REAL, packet-rich, command-built topology,
+//   (c) the command-application convention is pinned: live edits land
+//       immediately (fast-path) and are logged with apply_tick = next tick;
+//       replay applies entries with apply_tick == N BEFORE stepping N.
+
+import "core:testing"
+
+// Step a run from tick 1..ticks, autowiring growth like the demo autopilot,
+// recording the per-tick state hash. Drains events per tick into the hash.
+record_run :: proc(state: ^Run_State, ticks: u64, replay: bool, allocator := context.allocator) -> [dynamic]u64 {
+	hashes := make([dynamic]u64, 0, ticks, allocator)
+	wired := make(map[u32]bool, allocator)
+	if !replay {
+		// live path: edits apply immediately at tick 0 (fast-path), logged
+		// with apply_tick = 1 (the pinned convention)
+		testkit_wire_boot(state, 0)
+		for i in 0 ..< len(state.topology.node_alive) {
+			wired[state.topology.node_id[i]] = true
+		}
+	}
+	for tick in u64(1) ..= ticks {
+		before := len(state.events)
+		if replay {
+			// replay: apply all log entries with apply_tick == tick before the step
+			cmds := make([dynamic]Command, context.temp_allocator)
+			for cmd in state.action_log {
+				if cmd.apply_tick == tick { append(&cmds, cmd) }
+			}
+			step(state, tick, cmds[:])
+		} else {
+			step(state, tick, {})
+		}
+		// hash at the step boundary — BEFORE any new fast-path edits (they
+		// carry apply_tick = tick+1 and belong to the next boundary)
+		h := state_hash(state, state.events[before:], context.temp_allocator)
+		append(&hashes, h)
+		if !replay {
+			testkit_autowire(state, tick, &wired)
+		}
+		clear(&state.events)
+		free_all(context.temp_allocator)
+	}
+	return hashes
+}
+
+@(test)
+test_replay_byte_identical_on_real_topology :: proc(t: ^testing.T) {
+	cat, err := must_catalogs()
+	if err.file != "" { tfailf(t, "catalogs: %s", err.file) }
+
+	live := new(Run_State)
+	run_init(live, 42, cat, context.allocator)
+	live_hashes := record_run(live, 600, false)
+
+	// the keystone must be packet-rich (Perkins r1: the Godot keystone ran on
+	// a no-pipes topology — guard against that here)
+	if pipe_count(&live.topology) < 5 { tfailf(t, "keystone topology too thin: %d pipes", pipe_count(&live.topology)) }
+	if live.delivered_total == 0 { tfail(t, "keystone must have deliveries") }
+	if len(live.action_log) == 0 { tfail(t, "keystone must be command-built") }
+
+	replayed := new(Run_State)
+	run_init(replayed, 42, cat, context.allocator)
+	replayed.action_log = live.action_log // the ODN-11 artifact
+	replay_hashes := record_run(replayed, 600, true)
+	if replayed.replay_error { tfail(t, "replay hit a validation error (ODN-11 critical)") }
+
+	if len(live_hashes) != len(replay_hashes) { tfail(t, "tick count mismatch") }
+	for i in 0 ..< len(live_hashes) {
+		if live_hashes[i] != replay_hashes[i] {
+			tfailf(t, "REPLAY DIVERGENCE at tick %d: %x != %x", i+1, live_hashes[i], replay_hashes[i])
+		}
+	}
+}
+
+@(test)
+test_seed_reproduces :: proc(t: ^testing.T) {
+	cat, _ := must_catalogs()
+	a := new(Run_State)
+	run_init(a, 99, cat, context.allocator)
+	ha := record_run(a, 300, false)
+	b := new(Run_State)
+	run_init(b, 99, cat, context.allocator)
+	hb := record_run(b, 300, false)
+	for i in 0 ..< len(ha) {
+		if ha[i] != hb[i] { tfailf(t, "same seed diverged at tick %d", i+1) }
+	}
+	c := new(Run_State)
+	run_init(c, 100, cat, context.allocator)
+	hc := record_run(c, 300, false)
+	same := true
+	for i in 0 ..< len(ha) {
+		if ha[i] != hc[i] { same = false; break }
+	}
+	if same { tfail(t, "different seeds must diverge") }
+}
+
+@(test)
+test_action_log_binary_roundtrip :: proc(t: ^testing.T) {
+	// ODN-11: the log survives the binary round-trip byte-for-byte-semantics;
+	// corrupt inputs get the defined rejection, never a crash.
+	cat, _ := must_catalogs()
+	state := new(Run_State)
+	run_init(state, 42, cat, context.allocator)
+	testkit_wire_boot(state, 0)
+	bytes := log_write(state, context.temp_allocator)
+	header, cmds, ok := log_read(bytes, context.temp_allocator)
+	if !ok { tfail(t, "round-trip must parse") }
+	if header.seed != 42 || header.era != 3 || header.logic_hz != cat.balance.logic_hz {
+		tfail(t, "header mismatch")
+	}
+	if header.catalog_hash != cat.hash { tfail(t, "catalog hash mismatch") }
+	if len(cmds) != len(state.action_log) { tfail(t, "command count mismatch") }
+	for i in 0 ..< len(cmds) {
+		a, b := state.action_log[i], cmds[i]
+		if a.apply_tick != b.apply_tick { tfailf(t, "cmd %d apply_tick", i) }
+		ka, kb := a.kind, b.kind
+		#partial switch ca in ka {
+		case Cmd_Draw_Pipe:
+			cb := kb.(Cmd_Draw_Pipe)
+			if ca != cb { tfailf(t, "cmd %d draw mismatch", i) }
+		case Cmd_Set_Pipe_Priority:
+			cb := kb.(Cmd_Set_Pipe_Priority)
+			if ca != cb { tfailf(t, "cmd %d priority mismatch", i) }
+		}
+	}
+	// defined rejections
+	if _, _, ok2 := log_read(bytes[:len(bytes)-1], context.temp_allocator); ok2 {
+		tfail(t, "truncated log must reject")
+	}
+	if _, _, ok3 := log_read(bytes[:8], context.temp_allocator); ok3 {
+		tfail(t, "header-only log must reject")
+	}
+	garbage := make([]u8, 64, context.temp_allocator)
+	if _, _, ok4 := log_read(garbage, context.temp_allocator); ok4 {
+		tfail(t, "garbage must reject")
+	}
+}
diff --git a/core/events.odin b/core/events.odin
new file mode 100644
index 0000000..3c730bd
--- /dev/null
+++ b/core/events.odin
@@ -0,0 +1,58 @@
+package core
+
+// events.odin — the per-tick event buffer (ODN-14). Cross-layer communication
+// is a tagged-union array on Run_State, appended during core.step and drained
+// by the app once per frame in append order. Every event carries its tick —
+// the harness's assertion language and event-stream goldens depend on it.
+//
+// Ordering is program order; there are no callbacks, no bus, no globals.
+
+Event :: struct {
+	tick: u64,
+	kind: Event_Kind,
+}
+
+Event_Kind :: union {
+	Ev_Packet_Arrived,
+	Ev_Packet_Dropped,
+	Ev_Node_Spawned,
+	Ev_Forecast_Issued,
+	Ev_Warning_Raised,
+	Ev_Warning_Cleared,
+	Ev_Crisis_Triggered,
+	Ev_Crisis_Resolved,
+	Ev_Grace_Started,
+	Ev_Grace_Expired,
+	Ev_Meter_Changed,
+	Ev_Run_Won,
+	Ev_Run_Lost,
+}
+
+Ev_Packet_Arrived :: struct { class: u16 }
+Ev_Packet_Dropped :: struct { class: u16, reason: Drop_Reason }
+Ev_Node_Spawned :: struct { node: u32, type_idx: u16 }
+Ev_Forecast_Issued :: struct { set_piece: u16 } // demand-catalog set-piece index
+Ev_Warning_Raised :: struct { node: u32, level: Health_State } // Strained|Critical
+Ev_Warning_Cleared :: struct { node: u32 }
+Ev_Crisis_Triggered :: struct { archetype: Crisis_Archetype, set_piece: u16, root_cause: Root_Cause }
+Ev_Crisis_Resolved :: struct { archetype: Crisis_Archetype, set_piece: u16 }
+Ev_Grace_Started :: struct {}
+Ev_Grace_Expired :: struct {}
+Ev_Meter_Changed :: struct { pct: i32 }
+Ev_Run_Won :: struct { surge_uptime_pct: i32 }
+Ev_Run_Lost :: struct {}
+
+Crisis_Archetype :: enum u8 { Surge = 0 }
+
+// The fairness contract made structured (FORGE #3): every crisis carries the
+// topology flaw that caused it + the redesign that would have prevented it.
+Root_Cause :: struct {
+	pattern: Root_Cause_Pattern,
+	node:    u32, // the strained locus when known; 0 = map-wide
+}
+
+Root_Cause_Pattern :: enum u8 { No_Spare_Capacity_For_Forecast_Spike = 0 }
+
+emit :: proc(state: ^Run_State, tick: u64, kind: Event_Kind) {
+	append(&state.events, Event{tick = tick, kind = kind})
+}
diff --git a/core/flow.odin b/core/flow.odin
new file mode 100644
index 0000000..d2c16c7
--- /dev/null
+++ b/core/flow.odin
@@ -0,0 +1,575 @@
+package core
+
+// flow.odin — S2 Packet-Flow Simulation (architecture §6.2): the deterministic
+// tick loop. Spawn from the demand plan (seeded weighted picks) -> route (BFS,
+// round-robin / capacity-weighted at parallel pipes) -> traverse (bandwidth-
+// shared per pipe, QoS lane caps) -> deliver at the sink or drop (contention /
+// severance) -> accumulate per-class SLA. QoS procs (qos.odin) and SLA
+// accumulators live INSIDE the flow (ODN-3 — no peer systems).
+//
+// Integer-only (ODN-10); arrays only (no map iteration); every random choice
+// draws state.rng. Cosmetic packet positions are integer Q8 edge-fractions
+// (vis_q8) — deterministic, and excluded from nothing: they ride the T1 hash
+// too (Perkins r1: the Godot fingerprint omitted in-flight packet state; the
+// Odin fingerprint covers ALL of it — see serialize.odin).
+
+MAX_ROUTE :: 32          // max pipes along a packet's path (nodes <= 64 in PROTO)
+ROLLING_MAX :: 128       // balance.rolling_window_ticks must be <= this
+
+Packet :: struct {
+	id:                 u64,
+	class:              u16,
+	src, dst:           u32,              // node ids
+	route:              [MAX_ROUTE]u32,   // pipe ids along the chosen path
+	route_len:          u8,
+	edge_idx:           u8,
+	progress_units:     i32,              // bandwidth units traversed on the current edge
+	lane:               Lane,             // the class's catalog default (informational)
+	spawn_tick:         u64,
+	bandwidth_demand:   i32,              // cached from the catalog at spawn
+	accrued_latency_ms: i32,              // integer ms (sub-tick resolution, m16)
+	vis_q8:             i32,  // Q8 edge-fractions along the route (cosmetic, deterministic)
+	done:               bool, // scratch: arrived (delivered/dropped) this tick
+	delivered_marker:   bool,
+	drop_reason:        Drop_Reason,
+}
+
+Sla_Accumulator :: struct {
+	delivered:        u64,
+	dropped:          u64,
+	total_latency_ms: u64,
+	demand_seen:      u64,
+}
+
+Flow_Report :: struct {
+	spawned:   i32,
+	delivered: i32,
+	dropped:   i32,
+	unmet:     i32,
+}
+
+Flow_State :: struct {
+	packets:        [dynamic]Packet,
+	next_packet_id: u64,
+	sla:            [dynamic]Sla_Accumulator, // per class
+	ms_per_tick:    i32,
+	// round-robin cursors per unordered node pair (parallel arrays; lookup by
+	// linear scan — pairs are few; insertion order is the iteration order)
+	rr_a, rr_b:     [dynamic]u32,
+	rr_cursor:      [dynamic]u32,
+	// rolling recent-uptime window per class (forgives the build phase)
+	roll_del:       [dynamic][ROLLING_MAX]i32,
+	roll_drop:      [dynamic][ROLLING_MAX]i32,
+	roll_ds:        [dynamic]i32,
+	roll_dps:       [dynamic]i32,
+	roll_idx:       i32,
+	roll_window:    i32, // the catalog's rolling_window_ticks (<= ROLLING_MAX)
+	tick_del:       [dynamic]i32, // per class, this tick
+	tick_drop:      [dynamic]i32,
+	// per-node-slot per-tick surfaces (the warning surface + inspect panel)
+	node_load:      [dynamic]i32, // per node slot
+	node_flow:      [dynamic]i32, // node_slot * MAX_CLASSES + class
+	// BFS scratch (resized as the topology grows)
+	bfs_prev:       []i32,
+	bfs_queue:      []u32,
+	// per-tick scratch (persistent — no per-tick allocator churn)
+	sc_src_ids:     [dynamic]u32,
+	sc_src_w:       [dynamic]i32,
+	sc_dst_ids:     [dynamic]u32,
+	sc_dst_w:       [dynamic]i32,
+	sc_survivors:   [dynamic]Packet,
+}
+
+flow_init :: proc(f: ^Flow_State, cat: ^Catalogs, allocator := context.allocator) {
+	context.allocator = allocator
+	f.next_packet_id = 1
+	f.ms_per_tick = 1000 / cat.balance.logic_hz // logic_hz is the single source (Perkins r1)
+	f.roll_window = cat.balance.rolling_window_ticks
+	for _ in cat.packet_types {
+		append(&f.sla, Sla_Accumulator{})
+		append(&f.roll_del, [ROLLING_MAX]i32{})
+		append(&f.roll_drop, [ROLLING_MAX]i32{})
+		append(&f.roll_ds, 0)
+		append(&f.roll_dps, 0)
+		append(&f.tick_del, 0)
+		append(&f.tick_drop, 0)
+	}
+}
+
+flow_ensure_scratch :: proc(f: ^Flow_State, t: ^Topology) {
+	nslots := len(t.node_alive)
+	if len(f.node_load) < nslots {
+		resize(&f.node_load, nslots)
+		resize(&f.node_flow, nslots*MAX_CLASSES)
+	}
+	if len(f.bfs_prev) < nslots {
+		prev := f.bfs_prev
+		queue := f.bfs_queue
+		f.bfs_prev = make([]i32, nslots*2)
+		f.bfs_queue = make([]u32, nslots*2)
+		copy(f.bfs_prev, prev)
+		copy(f.bfs_queue, queue)
+		delete(prev)
+		delete(queue)
+	}
+}
+
+// --- demand resolution (seeded weighted picks; E28 unroutable accrues, never
+// --- spawns a phantom) --------------------------------------------------------
+
+weighted_pick :: proc(items: []u32, weights: []i32, rng: ^Rng) -> u32 {
+	if len(items) == 0 { return 0 }
+	if len(items) == 1 { return items[0] }
+	total: i64 = 0
+	for w in weights { total += i64(w) }
+	if total <= 0 {
+		return items[rng_range(rng, 0, i32(len(items))-1)]
+	}
+	r := i64(rng_range(rng, 0, i32(total)-1))
+	acc: i64 = 0
+	for item, i in items {
+		acc += i64(weights[i])
+		if r < acc { return item }
+	}
+	return items[len(items)-1]
+}
+
+// gather terminals of a role into scratch slices (insertion order)
+terminals_of :: proc(t: ^Topology, role: Terminal_Role, ids: ^[dynamic]u32, weights: ^[dynamic]i32) {
+	clear(&ids^)
+	clear(&weights^)
+	for i in 0 ..< len(t.node_alive) {
+		if !t.node_alive[i] { continue }
+		if t.node_kind[i] == .Terminal && t.node_role[i] == role {
+			append(ids, t.node_id[i])
+			append(weights, 1) // demand_weight is uniform in the PROTO roster
+		}
+	}
+}
+
+// --- routing (BFS shortest path; parallel-pipe pick per hop) ------------------
+
+rr_next :: proc(f: ^Flow_State, a, b: u32, n: int) -> int {
+	if n <= 0 { return 0 }
+	lo, hi := a, b
+	if hi < lo { lo, hi = hi, lo }
+	for i in 0 ..< len(f.rr_a) {
+		if f.rr_a[i] == lo && f.rr_b[i] == hi {
+			c := f.rr_cursor[i]
+			f.rr_cursor[i] = (c + 1) % u32(n)
+			return int(c % u32(n))
+		}
+	}
+	append(&f.rr_a, lo)
+	append(&f.rr_b, hi)
+	append(&f.rr_cursor, 1 % u32(max(1, n)))
+	return 0
+}
+
+// Pick among parallel pipes connecting a-b. LB mode is TIER-DETERMINED (GDD
+// M3): smart junctions (lb_weighted) take the highest-capacity pipe, ties
+// spread round-robin; basic = round-robin via the per-pair cursor.
+pick_pipe :: proc(f: ^Flow_State, t: ^Topology, a, b: u32, pipe_ids: []u32) -> u32 {
+	if len(pipe_ids) == 1 { return pipe_ids[0] }
+	// junction endpoint (a first, matching the reference)
+	junc_slot: u32 = 0
+	has_junc := false
+	if sa, ok := node_slot(t, a); ok && t.node_kind[sa] == .Junction {
+		junc_slot, has_junc = sa, true
+	} else if sb, ok2 := node_slot(t, b); ok2 && t.node_kind[sb] == .Junction {
+		junc_slot, has_junc = sb, true
+	}
+	candidates := pipe_ids
+	best_buf: [MAX_ROUTE]u32
+	if has_junc && t.node_lb_weighted[junc_slot] {
+		best_cap: i32 = -1
+		for pid in pipe_ids {
+			ps := t.pipe_by_id[pid]
+			best_cap = max(best_cap, t.pipe_capacity[ps])
+		}
+		n := 0
+		for pid in pipe_ids {
+			ps := t.pipe_by_id[pid]
+			if t.pipe_capacity[ps] == best_cap && n < MAX_ROUTE {
+				best_buf[n] = pid
+				n += 1
+			}
+		}
+		if n == 1 { return best_buf[0] }
+		candidates = best_buf[:n]
+	}
+	idx := rr_next(f, a, b, len(candidates))
+	return candidates[idx]
+}
+
+// BFS over adjacency (insertion-ordered) -> per-hop parallel-pipe pick.
+// Returns the pipe-id route into p.route / p.route_len (empty = unreachable).
+compute_route :: proc(f: ^Flow_State, t: ^Topology, src, dst: u32, p: ^Packet) {
+	p.route_len = 0
+	if src == dst { return }
+	nslots := len(t.node_alive)
+	for i in 0 ..< nslots { f.bfs_prev[i] = -1 }
+	src_slot, ok_src := node_slot(t, src)
+	dst_slot, ok_dst := node_slot(t, dst)
+	if !ok_src || !ok_dst { return }
+	head, tail: int = 0, 1
+	f.bfs_queue[0] = src_slot
+	f.bfs_prev[src_slot] = -2 // visited marker (src)
+	nb_buf: [64]u32
+	found := false
+	for head < tail {
+		cur := f.bfs_queue[head]
+		head += 1
+		if cur == dst_slot { found = true; break }
+		n := neighbors(t, t.node_id[cur], nb_buf[:])
+		for i in 0 ..< n {
+			ns, ok := node_slot(t, nb_buf[i])
+			if !ok { continue }
+			if f.bfs_prev[ns] == -1 {
+				f.bfs_prev[ns] = i32(cur)
+				f.bfs_queue[tail] = ns
+				tail += 1
+			}
+		}
+	}
+	if !found && f.bfs_prev[dst_slot] == -1 { return }
+	// walk back dst -> src, then reverse into pipe picks
+	path_buf: [64]u32 // node slots
+	plen := 0
+	n := dst_slot
+	for {
+		path_buf[plen] = n
+		plen += 1
+		if n == src_slot { break }
+		prev := f.bfs_prev[n]
+		if prev < 0 { plen = 0; break }
+		n = u32(prev)
+		if plen >= len(path_buf) { plen = 0; break }
+	}
+	if plen < 2 { return }
+	pair_buf: [MAX_ROUTE]u32
+	for i in 0 ..< plen-1 {
+		na := t.node_id[path_buf[plen-1-i]]
+		nb := t.node_id[path_buf[plen-2-i]]
+		cnt := pipes_between(t, na, nb, pair_buf[:])
+		if cnt == 0 { p.route_len = 0; return }
+		if i >= MAX_ROUTE { p.route_len = 0; return }
+		p.route[i] = pick_pipe(f, t, na, nb, pair_buf[:cnt])
+	}
+	p.route_len = u8(min(plen-1, MAX_ROUTE))
+}
+
+// The node a packet has reached = src walked through every COMPLETED edge.
+// Completed edges may be TOMBSTONED (an E27 cascade can kill the pipe behind
+// an in-flight packet): their endpoint data persists in the arrays, so the
+// walk follows ids regardless of liveness — the anchor is the far endpoint of
+// the last completed edge, never a teleport back to the source (Perkins r2
+// review note N4).
+current_node :: proc(p: ^Packet, t: ^Topology) -> u32 {
+	node := p.src
+	for i in 0 ..< int(p.edge_idx) {
+		ps, ok := t.pipe_by_id[p.route[i]] // id->slot persists after tombstone
+		if !ok { return node }
+		a, b := t.pipe_a[ps], t.pipe_b[ps]
+		if node == a { node = b } else if node == b { node = a } else { return node }
+	}
+	return node
+}
+
+// --- the step -----------------------------------------------------------------
+
+flow_step :: proc(state: ^Run_State, tick: u64, plan: ^Pressure_Plan) -> Flow_Report {
+	f := &state.flow
+	t := &state.topology
+	cat := state.catalogs
+	rng := &state.rng
+	report: Flow_Report
+	for i in 0 ..< len(f.tick_del) { f.tick_del[i] = 0; f.tick_drop[i] = 0 }
+
+	flow_ensure_scratch(f, t)
+
+	// scratch for terminal sets (persistent buffers, cleared per use)
+	src_ids := &f.sc_src_ids
+	src_w := &f.sc_src_w
+	dst_ids := &f.sc_dst_ids
+	dst_w := &f.sc_dst_w
+
+	// 1. SPAWN from demand.
+	for entry in plan.entries {
+		volume := effective_volume(plan, entry.class, entry.volume, cat)
+		if volume <= 0 { continue }
+		terminals_of(t, entry.source_role, src_ids, src_w)
+		terminals_of(t, entry.sink_role, dst_ids, dst_w)
+		acc := &f.sla[entry.class]
+		if len(src_ids) == 0 || len(dst_ids) == 0 {
+			// E28: undelivered demand feeds strain exactly like a loss
+			report.unmet += volume
+			report.dropped += volume
+			acc.demand_seen += u64(volume)
+			acc.dropped += u64(volume)
+			f.tick_drop[entry.class] += volume
+			continue
+		}
+		for _ in 0 ..< volume {
+			src := weighted_pick(src_ids[:], src_w[:], rng)
+			dst := pick_dst(dst_ids[:], dst_w[:], src, rng)
+			acc.demand_seen += 1
+			p: Packet
+			p.id = f.next_packet_id
+			f.next_packet_id += 1
+			p.class = entry.class
+			p.src, p.dst = src, dst
+			pt := cat.packet_types[entry.class]
+			p.bandwidth_demand = max(1, pt.bandwidth_demand)
+			p.lane = entry.default_lane
+			p.spawn_tick = tick
+			compute_route(f, t, src, dst, &p)
+			if p.route_len == 0 {
+				// E28: unroutable demand is not spawned — it accrues as
+				// SLA-undelivered (feeds strain exactly like a loss).
+				acc.dropped += 1
+				f.tick_drop[entry.class] += 1
+				report.unmet += 1
+				report.dropped += 1
+				emit(state, tick, Ev_Packet_Dropped{class = entry.class, reason = .Unreachable})
+				continue
+			}
+			if len(f.packets) >= int(cat.balance.packet_pool_cap) {
+				// E22: pool exhaustion — the spawn fails as a drop. (PROTO
+				// shape: fail the incoming spawn. The spec's lane-ordered
+				// shedding is [LATER] — the per-lane queue depth sheds long
+				// before this cap is reached at PROTO scale.)
+				acc.dropped += 1
+				f.tick_drop[entry.class] += 1
+				report.dropped += 1
+				emit(state, tick, Ev_Packet_Dropped{class = entry.class, reason = .Pool_Exhaustion})
+				continue
+			}
+			// deterministic spawn phase so packets spread along the route
+			p.vis_q8 = i32(p.id % 64) * 4 * i32(p.route_len)
+			append(&f.packets, p)
+			report.spawned += 1
+		}
+	}
+
+	// 2. ADVANCE in-flight packets (bandwidth-shared per pipe, QoS lane caps).
+	advance(state, tick, &report)
+
+	// 3. rolling recent-uptime window
+	push_rolling(f)
+
+	return report
+}
+
+pick_dst :: proc(sinks: []u32, weights: []i32, src: u32, rng: ^Rng) -> u32 {
+	// prefer dst != src when the sink set has alternatives (email P2P)
+	if len(sinks) <= 1 {
+		return weighted_pick(sinks, weights, rng)
+	}
+	cand: [dynamic]u32
+	cand_w: [dynamic]i32
+	defer delete(cand)
+	defer delete(cand_w)
+	for s, i in sinks {
+		if s != src {
+			append(&cand, s)
+			append(&cand_w, weights[i])
+		}
+	}
+	return weighted_pick(cand[:], cand_w[:], rng)
+}
+
+advance :: proc(state: ^Run_State, tick: u64, report: ^Flow_Report) {
+	f := &state.flow
+	t := &state.topology
+	cat := state.catalogs
+	bal := &cat.balance
+
+	// per-node load + per-class flow counts (the warning surface + inspect)
+	for i in 0 ..< len(f.node_load) { f.node_load[i] = 0 }
+	for i in 0 ..< len(f.node_flow) { f.node_flow[i] = 0 }
+	for p, _ in f.packets {
+		if p.route_len == 0 { continue }
+		ps, ok := pipe_slot(t, p.route[p.edge_idx])
+		if !ok { continue }
+		for endp in 0 ..< 2 {
+			nid := t.pipe_a[ps] if endp == 0 else t.pipe_b[ps]
+			if ns, ok2 := node_slot(t, nid); ok2 {
+				f.node_load[ns] += p.bandwidth_demand
+				f.node_flow[int(ns)*MAX_CLASSES + int(p.class)] += 1
+			}
+		}
+	}
+
+	// serve each pipe's backlog by QoS lane (Express -> Standard -> Best),
+	// each lane bounded by its allocated capacity (qos_allocate).
+	arrived := make([dynamic]int, 0, 64, context.temp_allocator) // tiny; tick arena
+	for pi in 0 ..< len(t.pipe_alive) {
+		if !t.pipe_alive[pi] { continue }
+		pipe_id := t.pipe_id[pi]
+		// junction endpoint (a first — matches the reference rule)
+		junc_triage: i32 = -1
+		if na, ok := node_slot(t, t.pipe_a[pi]); ok && t.node_kind[na] == .Junction {
+			junc_triage = t.node_triage[na]
+		} else if nb, ok2 := node_slot(t, t.pipe_b[pi]); ok2 && t.node_kind[nb] == .Junction {
+			junc_triage = t.node_triage[nb]
+		}
+		weights := t.pipe_weights[pi]
+		if emphasized(t.pipe_priority[pi], junc_triage) {
+			weights = bal.emphasis_preset
+		}
+		caps := qos_allocate(t.pipe_capacity[pi], weights, bal.default_lane_weights)
+		// lane readiness this tick (for the E7 floor)
+		lane_ready := [3]bool{}
+		for p in f.packets {
+			if p.done || p.route_len == 0 || int(p.edge_idx) >= int(p.route_len) { continue }
+			if p.route[p.edge_idx] != pipe_id { continue }
+			lane_ready[int(effective_lane(t.pipe_priority[pi], junc_triage, p.class))] = true
+		}
+		// Serve Express -> Standard -> Best. WORK-CONSERVING GAP-FILL (ODN-3 /
+		// §11.2): a lane's unused allocation carries DOWN to the next lane — a
+		// dialed pipe never throttles lone traffic — plus the E7 WRR floor: a
+		// non-empty lane whose allocation rounds to zero still gets a quantum
+		// of 1 unit while capacity remains (floors truncate in lane order when
+		// the pipe is exhausted — E6's defined truncation).
+		leftover: i32 = 0
+		remaining := t.pipe_capacity[pi]
+		for lane_i in 0 ..< LANE_COUNT {
+			avail := caps[lane_i] + leftover
+			if avail <= 0 && remaining > 0 && lane_ready[lane_i] {
+				avail = 1 // E7 floor quantum
+			}
+			avail = min(avail, remaining)
+			idx_in_lane := 0
+			for idx in 0 ..< len(f.packets) {
+				p := &f.packets[idx]
+				if p.done { continue }
+				if p.route_len == 0 || int(p.edge_idx) >= int(p.route_len) { continue }
+				if p.route[p.edge_idx] != pipe_id { continue }
+				if effective_lane(t.pipe_priority[pi], junc_triage, p.class) != Lane(lane_i) { continue }
+				idx_in_lane += 1
+				if idx_in_lane > int(bal.queue_drop_depth) {
+					// per-lane queue bound: beyond the depth, packets shed
+					// newest-first (the Godot prototype's actual behavior —
+					// its comment claimed oldest-first; the comment lied)
+					drop_packet(f, idx, .Queue_Overflow, &arrived)
+					continue
+				}
+				if avail <= 0 { continue } // lane exhausted this tick; packet waits
+				need := p.bandwidth_demand - p.progress_units
+				served := min(need, avail)
+				p.progress_units += served
+				avail -= served
+				remaining -= served
+				if served > 0 {
+					// flow forward visually ONLY when served — congestion piles
+					// along the pipe, not at sinks (the readable panic)
+					p.vis_q8 = min(p.vis_q8 + 64, i32(p.route_len) * 256)
+				}
+				if p.progress_units >= p.bandwidth_demand {
+					p.progress_units = 0
+					p.edge_idx += 1
+					if int(p.edge_idx) >= int(p.route_len) {
+						p.done = true
+						p.delivered_marker = true
+						append(&arrived, idx)
+					}
+				}
+			}
+			// unused allocation carries down to the next lane (gap-fill)
+			leftover = avail
+		}
+	}
+
+	// severed pipes (E1): packets whose current pipe is gone reroute from
+	// their current node, or drop with Severance
+	for idx in 0 ..< len(f.packets) {
+		p := &f.packets[idx]
+		if p.route_len == 0 { continue }
+		if int(p.edge_idx) >= int(p.route_len) { continue }
+		if _, ok := pipe_slot(t, p.route[p.edge_idx]); ok { continue }
+		cur := current_node(p, t)
+		compute_route(f, t, cur, p.dst, p)
+		p.edge_idx = 0
+		p.progress_units = 0
+		if p.route_len == 0 {
+			drop_packet(f, idx, .Severance, &arrived)
+		}
+	}
+
+	// latency accrual (integer ms; packets drop on contention/severance/
+	// unreachable — never on latency alone in PROTO) + cull delivered/dropped
+	survivors := &f.sc_survivors
+	clear(survivors)
+	for i in 0 ..< len(f.packets) {
+		p := f.packets[i]
+		if p.done { continue }
+		p.accrued_latency_ms += f.ms_per_tick
+		append(survivors, p)
+	}
+	// account the arrived (delivered/dropped) packets
+	for idx in arrived {
+		p := f.packets[idx]
+		acc := &f.sla[p.class]
+		if p.delivered_marker {
+			acc.delivered += 1
+			acc.total_latency_ms += u64(p.accrued_latency_ms)
+			f.tick_del[p.class] += 1
+			report.delivered += 1
+			emit(state, tick, Ev_Packet_Arrived{class = p.class})
+		} else {
+			acc.dropped += 1
+			f.tick_drop[p.class] += 1
+			report.dropped += 1
+			emit(state, tick, Ev_Packet_Dropped{class = p.class, reason = p.drop_reason})
+		}
+	}
+	// swap the survivor set in (insertion order preserved — determinism)
+	clear(&f.packets)
+	for p in survivors { append(&f.packets, p) }
+}
+
+// Packet bookkeeping for arrivals is done on a scratch marker struct so the
+// packet array isn't reordered mid-iteration.
+drop_packet :: proc(f: ^Flow_State, idx: int, reason: Drop_Reason, arrived: ^[dynamic]int) {
+	f.packets[idx].drop_reason = reason
+	f.packets[idx].delivered_marker = false
+	f.packets[idx].done = true
+	append(arrived, idx)
+}
+
+// --- SLA / rolling window -------------------------------------------------------
+
+push_rolling :: proc(f: ^Flow_State) {
+	window := int(f.roll_window) // catalog-sized (N7: the knob is live)
+	idx := int(f.roll_idx) % window
+	for c in 0 ..< len(f.sla) {
+		f.roll_ds[c] -= f.roll_del[c][idx]
+		f.roll_dps[c] -= f.roll_drop[c][idx]
+		f.roll_del[c][idx] = f.tick_del[c]
+		f.roll_drop[c][idx] = f.tick_drop[c]
+		f.roll_ds[c] += f.tick_del[c]
+		f.roll_dps[c] += f.tick_drop[c]
+	}
+	f.roll_idx += 1
+}
+
+// Overall recent uptime % across classes; -1 = no traffic in window (neutral,
+// E24 — the health meter treats it as neither breach nor credit).
+recent_overall_uptime :: proc(f: ^Flow_State) -> i32 {
+	td, tr: i32 = 0, 0
+	for c in 0 ..< len(f.sla) {
+		td += f.roll_ds[c]
+		tr += f.roll_dps[c]
+	}
+	tot := td + tr
+	if tot <= 0 { return -1 }
+	return (td * 100) / tot
+}
+
+recent_class_uptime :: proc(f: ^Flow_State, class: u16) -> i32 {
+	if int(class) >= len(f.sla) { return -1 }
+	tot := f.roll_ds[class] + f.roll_dps[class]
+	if tot <= 0 { return -1 }
+	return (f.roll_ds[class] * 100) / tot
+}
diff --git a/core/flow_edge_test.odin b/core/flow_edge_test.odin
new file mode 100644
index 0000000..fb3b6d7
--- /dev/null
+++ b/core/flow_edge_test.odin
@@ -0,0 +1,223 @@
+package core
+
+// flow_edge_test.odin — edge-path flow contracts: E1 severance (both branches,
+// on a CONGESTED pipe so packets are actually mid-edge at demolish), QoS
+// gap-fill + WRR floor (ODN-3/§11.2), E22 pool cap, E28 asymmetry.
+
+import "core:testing"
+
+// Count packets whose CURRENT edge is the given pipe (the occupancy the
+// severance machinery cares about).
+on_pipe_count :: proc(f: ^Flow_State, pipe: u32) -> int {
+	n := 0
+	for p in f.packets {
+		if p.done || p.route_len == 0 || int(p.edge_idx) >= int(p.route_len) { continue }
+		if p.route[p.edge_idx] == pipe { n += 1 }
+	}
+	return n
+}
+
+// Contended two-path fixture: host -> router direct STANDARD leg (15 u/s) +
+// an alternative path through j2, with enough demand to pile packets up on
+// the direct leg (a congested pipe holds packets mid-edge at tick boundaries).
+severance_fixture :: proc(t: ^testing.T, with_alt: bool) -> ^Run_State {
+	cat, cerr := must_catalogs()
+	if cerr.file != "" { tfail(t, "catalogs") }
+	state := new(Run_State)
+	run_init_bare(state, 9, cat, context.allocator)
+	host_t, _ := node_type_index(cat, "content_host")
+	res_t, _ := node_type_index(cat, "residential")
+	mid_t, _ := node_type_index(cat, "router_mid")
