-## ScriptedDirector — the MVP CrisisDirector impl (S0.5, ADR-7).
-##
-## Data-driven + deterministic: turns the era demand catalog (res://data/demand.json)
-## into a per-tick PressurePlan. The same seam the V2 AiAuditorDirector will
-## satisfy (forge weak #4) — only the impl differs. Deterministic: same
-## (era, tick) -> identical PressurePlan (S0.5 AC). plan_pressure never spawns a
-## crisis/set-piece that doesn't trace to the catalog (fair + predictable, FORGE #3).
-##
-## Pure RefCounted (ADR-1). The rng param is accepted (interface contract) but
-## unused in the MVP — demand RESOLUTION (dst pick) consumes it in PacketFlow.
-class_name ScriptedDirector
-extends CrisisDirector
-
-var _era_demand: Dictionary = {}        # int era_id -> Array[DemandSpec]
-var _era_set_pieces: Dictionary = {}    # int era_id -> Array[SetPiece]
-var load_ok: bool = true
-
-# --- Map growth state (E3.2, prototype iterate-1) -----------------------------
-# The growth schedule is owned by the director (the CrisisDirector seam drives
-# the timeline). The candidate-position POOL is drawn from the run's SEEDED rng
-# at bootstrap (init_growth) — so growth is seeded/deterministic (ADR-9) and
-# consumes ZERO rng during the run (the demand stream is untouched, AC-E10).
-var _growth_pool: Array[Vector2i] = []
-var _growth_pool_idx: int = 0
-var _growth_roles: Array[StringName] = []
-var _growth_balance: BalanceData = null
-var _growth_next_tick: int = 0
-var _growth_done: int = 0
-
-
-## Seed the growth schedule from the run's rng + balance catalog. Called once
-## at RunState.bootstrap (after the rng is seeded) — positions are a pure
-## function of (seed, balance) from here on.
-func init_growth(rng: RandomNumberGenerator, balance: BalanceData) -> void:
-	_growth_balance = balance
-	_growth_roles.clear()
-	if balance != null:
-		for r: StringName in balance.growth_roles:
-			_growth_roles.append(r)
-	_growth_pool.clear()
-	for _i: int in 24:
-		_growth_pool.append(Vector2i(rng.randi_range(6, 34), rng.randi_range(4, 26)))
-	_growth_pool_idx = 0
-	_growth_next_tick = balance.growth_first_tick if balance != null else 400
-	_growth_done = 0
-
-
-## Nodes due to spawn this tick (usually empty). Deterministic given the run's
-## (seed, tick, topology): roles from the balance catalog in order, positions
-## from the bootstrap-drawn pool skipping slots too close to existing nodes.
-func plan_growth(topology: TopologySnapshot, _era_id: int, tick: int,
-				 _rng: RandomNumberGenerator) -> Array[NodeSpawn]:
-	var out: Array[NodeSpawn] = []
-	if _growth_balance == null or _growth_roles.is_empty():
-		return out
-	if _growth_done >= _growth_roles.size():
-		return out
-	if tick < _growth_next_tick:
-		return out
-	var role: StringName = _growth_roles[_growth_done]
-	var pos: Vector2i = _next_growth_pos(topology)
-	out.append(NodeSpawn.new(role, pos, tick))
-	_growth_done += 1
-	# cadence: the second half of the run's growth comes faster (the internet
-	# "takes off" — rate scales with growth progress, not era, so it stays a
-	# pure function of the schedule; balance-tunable).
-	var interval: int = _growth_balance.growth_interval_ticks
-	if _growth_done >= (_growth_roles.size() + 1) / 2:
-		interval = _growth_balance.growth_interval_short_ticks
-	_growth_next_tick = tick + maxi(1, interval)
-	return out
-
-
-func _next_growth_pos(topology: TopologySnapshot) -> Vector2i:
-	var min_d: int = _growth_balance.growth_min_dist_tiles if _growth_balance != null else 7
-	var pool: int = _growth_pool.size()
-	for i: int in pool:
-		var cand: Vector2i = _growth_pool[(_growth_pool_idx + i) % pool]
-		if _pos_free(cand, min_d, topology):
-			_growth_pool_idx = (_growth_pool_idx + i + 1) % pool
-			return cand
-	# fallback: exhaustive deterministic row-major scan of the map box with the
-	# FULL check (min-dist + near a junction). NEVER use sparse rings here — a
-	# ring scan skips valid cells and strands the spawn far from the network
-	# (seen 2026-08-08: a house landed 20+ tiles from every router).
-	print("[growth] pool exhausted — full-scan fallback (pool_idx=%d)" % _growth_pool_idx)
-	for y: int in range(4, 27):
-		for x: int in range(6, 35):
-			var cand := Vector2i(x, y)
-			if _pos_free(cand, min_d, topology):
-				return cand
-	print("[growth] full-scan fallback failed too — min-dist-only scan")
-	for y: int in range(4, 27):
-		for x: int in range(6, 35):
-			var cand := Vector2i(x, y)
-			if _min_dist_ok(cand, min_d, topology):
-				return cand
-	return Vector2i(20, 15)
-
-
-func _min_dist_ok(cand: Vector2i, min_d: int, topology: TopologySnapshot) -> bool:
-	for nid: int in topology.nodes:
-		var n: NetNode = topology.nodes.get(nid)
-		if n != null and absi(n.pos.x - cand.x) + absi(n.pos.y - cand.y) < min_d:
-			return false
-	return true
-
-
-func _pos_free(cand: Vector2i, min_d: int, topology: TopologySnapshot) -> bool:
-	# New nodes must be (a) not too close to any existing node AND (b) near the
-	# existing network — specifically within growth_spawn_near_junction of a
-	# JUNCTION. The internet grows OUTWARD from its routers (Mini Motorways:
-	# new houses appear near existing infrastructure), which is also what keeps
-	# every spawn reachable with a pipe the player can actually draw.
-	var near_junction: bool = false
-	var near_radius: int = _growth_balance.growth_spawn_near_junction \
-		if _growth_balance != null else 12
-	for nid: int in topology.nodes:
-		var n: NetNode = topology.nodes.get(nid)
-		if n == null:
-			continue
-		var d: int = absi(n.pos.x - cand.x) + absi(n.pos.y - cand.y)
-		if d < min_d:
-			return false
-		if n.is_junction() and d <= near_radius:
-			near_junction = true
-	return near_junction
-
-
-static func load_from(path: String) -> ScriptedDirector:
-	var d := ScriptedDirector.new()
-	d._load(path)
-	return d
-
-
-func _load(path: String) -> void:
-	if not FileAccess.file_exists(path):
-		push_error("[ScriptedDirector] missing %s" % path)
-		load_ok = false
-		return
-	var f := FileAccess.open(path, FileAccess.READ)
-	var text := f.get_as_text()
-	f.close()
-	var parsed: Variant = JSON.parse_string(text)
-	if parsed == null or not parsed is Dictionary:
-		push_error("[ScriptedDirector] invalid JSON in %s" % path)
-		load_ok = false
-		return
-	var eras: Dictionary = parsed["eras"]
-	for era_key: Variant in eras:
-		var era_id: int = int(era_key)
-		var era_obj: Dictionary = eras[era_key]
-		_era_demand[era_id] = _parse_entries(era_obj.get("entries", []))
-		_era_set_pieces[era_id] = _parse_set_pieces(era_obj.get("set_pieces", []))
-
-
-func _parse_entries(arr: Array) -> Array[DemandSpec]:
-	var out: Array[DemandSpec] = []
-	for e: Variant in arr:
-		var d: Dictionary = e
-		var mode: int = _mode_from_string(d.get("selection", "weighted_random"))
-		out.append(DemandSpec.new(
-			StringName(d["class_id"]),
-			TerminalSelector.new(StringName(d.get("source_role", &"")), int(d.get("source_card", -1))),
-			TerminalSelector.new(StringName(d.get("sink_role", &"")), int(d.get("sink_card", -1))),
-			SelectionRule.new(mode, &"demand_weight"),
-			int(d.get("volume", 0)),
-			int(d.get("default_lane", CoreConst.Lane.STANDARD)),
-			int(d.get("demand_weight", 1))
-		))
-	return out
-
-
-func _parse_set_pieces(arr: Array) -> Array[SetPiece]:
-	var out: Array[SetPiece] = []
-	for e: Variant in arr:
-		var d: Dictionary = e
-		out.append(SetPiece.new(
-			StringName(d["id"]),
-			StringName(d["class_id"]),
-			int(d.get("multiplier", 1)),
-			int(d.get("start_tick", 0)),
-			int(d.get("duration_ticks", 0)),
-			int(d.get("forecast_lead_ticks", 0))
-		))
-	return out
-
-
-static func _mode_from_string(s: String) -> int:
-	match s:
-		"weighted_random":
-			return CoreConst.SelectionMode.WEIGHTED_RANDOM
-		"round_robin":
-			return CoreConst.SelectionMode.ROUND_ROBIN
-		"nearest_hops":
-			return CoreConst.SelectionMode.NEAREST_HOPS
-	return CoreConst.SelectionMode.WEIGHTED_RANDOM
-
-
-func entries_for_era(era_id: int) -> Array[DemandSpec]:
-	return _era_demand.get(era_id, [])
-
-
-func set_pieces_for_era(era_id: int) -> Array[SetPiece]:
-	return _era_set_pieces.get(era_id, [])
-
-
-## Plan pressure for one tick: the era's base DemandSpecs + the SetPieces active
-## at this tick. Deterministic (a pure function of era + tick).
-func plan_pressure(_topology: TopologySnapshot, era_id: int, tick: int,
-				   _rng: RandomNumberGenerator) -> PressurePlan:
-	var all_set_pieces: Array[SetPiece] = _era_set_pieces.get(era_id, [])
-	var active: Array[SetPiece] = []
-	for sp: SetPiece in all_set_pieces:
-		if sp.is_active(tick):
-			active.append(sp)
-	return PressurePlan.new(tick, entries_for_era(era_id), active)
-
-
-## Forecast (set-pieces not yet active but within their lead time) — for the
-## "weather report" panel (sprint-plan §3.4). Pure function of era + tick.
-func forecast_for_era(era_id: int, tick: int) -> Array[SetPiece]:
-	var out: Array[SetPiece] = []
-	for sp: SetPiece in _era_set_pieces.get(era_id, []):
-		if sp.is_forecasted(tick):
-			out.append(sp)
-	return out
