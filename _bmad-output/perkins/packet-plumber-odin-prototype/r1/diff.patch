+@(test)
+test_growth_is_deterministic_and_valid :: proc(t: ^testing.T) {
+	// E31: growth positions are seeded-deterministic and every spawn respects
+	// min separation + near-junction growth (outward from the router mesh).
+	cat, _ := must_catalogs()
+	a := new(Run_State)
+	run_init(a, 7, cat, context.allocator)
+	b := new(Run_State)
+	run_init(b, 7, cat, context.allocator)
+	bal := &cat.balance
+	// wire the boot network so the runs survive past the growth window (an
+	// idle run dies ~tick 250 and the E17 barrier freezes it there)
+	testkit_wire_boot(a, 0)
+	testkit_wire_boot(b, 0)
+	for tick in u64(1) ..= 2000 {
+		step(a, tick, {})
+		step(b, tick, {})
+		clear(&a.events)
+		clear(&b.events)
+		free_all(context.temp_allocator)
+	}
+	na := node_count(&a.topology)
+	if na <= 6 { tfail(t, "growth must have spawned nodes") }
+	if na != node_count(&b.topology) { tfail(t, "same seed -> same growth") }
+	for i in 0 ..< len(a.topology.node_alive) {
+		if a.topology.node_alive[i] != b.topology.node_alive[i] { tfail(t, "growth liveness diverges") }
+		if a.topology.node_pos[i] != b.topology.node_pos[i] { tfail(t, "growth position diverges") }
+	}
+	// validity at spawn: min separation from all pre-existing nodes
+	ta := &a.topology
+	for i in 0 ..< len(ta.node_alive) {
+		if !ta.node_alive[i] { continue }
+		for j in i+1 ..< len(ta.node_alive) {
+			if !ta.node_alive[j] { continue }
+			if manhattan(ta.node_pos[i], ta.node_pos[j]) < bal.growth_min_dist_tiles {
+				tfailf(t, "nodes %d and %d violate min separation", ta.node_id[i], ta.node_id[j])
+			}
+		}
+	}
+}
diff --git a/core/health.odin b/core/health.odin
new file mode 100644
index 0000000..b1221c3
--- /dev/null
+++ b/core/health.odin
@@ -0,0 +1,114 @@
+package core
+
+// health.odin — S5 Network Health (architecture §6.5): the aggregate loss
+// condition. Drains while the rolling overall uptime breaches the threshold
+// (after a grace countdown), recharges when healthy; empty meter = Error 404.
+// Win = hold surge-window uptime >= threshold through the surge.
+//
+// Carried contracts: drain = severity-proportional + per-tick cap (E16, never
+// instant); Run_Lost supersedes (E17); hysteresis (E30): breach ENTER at
+// win_uptime_pct, EXIT at breach_exit_pct — an oscillating class can't flap
+// the episode every tick, and a re-breach during an active grace window is a
+// no-op (one countdown per episode); grace refills GRADUALLY on recovery
+// (+grace_refill_per_tick, capped) — a single healthy tick must not re-arm
+// the whole window (the never-lose exploit the Godot prototype carried);
+// surge-window accumulators reset when a new surge starts (Perkins r1).
+
+Health_Meter :: struct {
+	meter_pct:        i32,
+	grace_ticks_left: i32,
+	in_grace:         bool,
+	in_breach:        bool, // E30 hysteresis band state
+	healthy_streak:   i32,  // sustained-recovery gate for grace refill
+	won:              bool,
+	lost:             bool,
+	surge_delivered:  u64,
+	surge_dropped:    u64,
+	prev_in_surge:    bool,
+}
+
+health_init :: proc(h: ^Health_Meter, bal: ^Balance) {
+	h.meter_pct = bal.meter_start_pct
+	h.grace_ticks_left = bal.grace_window_ticks
+}
+
+health_update :: proc(state: ^Run_State, tick: u64, report: ^Flow_Report, plan: ^Pressure_Plan, recent_uptime: i32) {
+	h := &state.health
+	if h.won || h.lost { return } // terminal — frozen
+	bal := &state.catalogs.balance
+	in_surge := len(plan.set_pieces) > 0
+
+	if in_surge && !h.prev_in_surge {
+		// a new surge starts a fresh window (never double-count)
+		h.surge_delivered = 0
+		h.surge_dropped = 0
+	}
+	if in_surge {
+		h.surge_delivered += u64(report.delivered)
+		h.surge_dropped += u64(report.dropped)
+	}
+
+	// E30 hysteresis: enter the breach episode below the enter threshold;
+	// exit only above the exit threshold. Zero-demand (uptime -1) is neutral.
+	if recent_uptime < 0 {
+		// neutral: no breach, no credit — but an open episode stays open
+	} else if !h.in_breach && recent_uptime < bal.win_uptime_pct {
+		h.in_breach = true
+	} else if h.in_breach && recent_uptime >= bal.breach_exit_pct {
+		h.in_breach = false
+	}
+
+	if h.in_breach {
+		h.healthy_streak = 0
+		if !h.in_grace && h.grace_ticks_left > 0 {
+			h.in_grace = true
+			emit(state, tick, Ev_Grace_Started{})
+		}
+		if h.grace_ticks_left > 0 {
+			h.grace_ticks_left -= 1
+			if h.grace_ticks_left == 0 {
+				emit(state, tick, Ev_Grace_Expired{})
+			}
+		} else {
+			severity := bal.win_uptime_pct - recent_uptime
+			drain := clamp(severity / 10, 1, bal.meter_drain_per_tick_max) // E16
+			h.meter_pct = max(0, h.meter_pct - drain)
+			emit(state, tick, Ev_Meter_Changed{pct = h.meter_pct})
+		}
+	} else {
+		h.in_grace = false
+		h.healthy_streak += 1
+		// grace refills gradually and ONLY after a sustained recovery streak —
+		// never an instant re-arm, and a flapping line (streak never reaches
+		// the gate) never refills at all (the never-lose exploit, review W1)
+		if h.healthy_streak >= bal.grace_refill_streak_ticks &&
+		   h.grace_ticks_left < bal.grace_window_ticks {
+			h.grace_ticks_left = min(bal.grace_window_ticks, h.grace_ticks_left + bal.grace_refill_per_tick)
+		}
+		if h.meter_pct < 100 {
+			h.meter_pct = min(100, h.meter_pct + bal.meter_recharge_per_tick)
+			emit(state, tick, Ev_Meter_Changed{pct = h.meter_pct})
+		}
+	}
+
+	// win: the surge JUST ended -> check the surge-window uptime
+	if h.prev_in_surge && !in_surge && !h.lost {
+		total := h.surge_delivered + h.surge_dropped
+		// a zero-traffic window is NEUTRAL (no win, no credit) — the win must
+		// be earned against real surge traffic
+		if total > 0 {
+			uptime := i32((h.surge_delivered * 100) / total)
+			if uptime >= bal.win_uptime_pct {
+				h.won = true
+				emit(state, tick, Ev_Run_Won{surge_uptime_pct = uptime})
+			}
+		}
+	}
+	h.prev_in_surge = in_surge
+
+	// lose: meter empty -> Error 404 (Run_Lost supersedes everything, E17)
+	if h.meter_pct <= 0 && !h.won && !h.lost {
+		h.lost = true
+		emit(state, tick, Ev_Run_Lost{})
+	}
+}
diff --git a/core/health_test.odin b/core/health_test.odin
new file mode 100644
index 0000000..a2db9e6
--- /dev/null
+++ b/core/health_test.odin
@@ -0,0 +1,212 @@
+package core
+
+// health_test.odin — Network Health win/lose/drain/grace/recharge contracts
+// (Perkins r1 blocker #1: the Godot prototype shipped these UNTESTED). Driven
+// standalone with synthetic flow reports — health_update is a pure function of
+// (report, plan, recent_uptime).
+
+import "core:testing"
+
+health_fixture :: proc(t: ^testing.T) -> ^Run_State {
+	cat, err := must_catalogs()
+	if err.file != "" { tfailf(t, "catalogs: %s", err.file) }
+	state := new(Run_State)
+	run_init(state, 5, cat, context.allocator)
+	return state
+}
+
+empty_plan :: proc(surge: bool) -> Pressure_Plan {
+	plan: Pressure_Plan
+	plan.set_pieces = make([dynamic]u16, context.temp_allocator)
+	if surge { append(&plan.set_pieces, 0) }
+	return plan
+}
+
+has_event :: proc(state: ^Run_State, tag: u8) -> bool {
+	for e in state.events {
+		#partial switch k in e.kind {
+		case Ev_Grace_Started: if tag == 1 { return true }
+		case Ev_Grace_Expired: if tag == 2 { return true }
+		case Ev_Run_Won:       if tag == 3 { return true }
+		case Ev_Run_Lost:      if tag == 4 { return true }
+		case Ev_Meter_Changed: if tag == 5 { return true }
+		}
+	}
+	return false
+}
+
+@(test)
+test_health_grace_then_drain_then_loss :: proc(t: ^testing.T) {
+	state := health_fixture(t)
+	report := Flow_Report{}
+	plan := empty_plan(false)
+	bal := &state.catalogs.balance
+
+	// breach at 50% uptime: the grace window must absorb the first 200 ticks
+	for tick in u64(1) ..= u64(bal.grace_window_ticks) {
+		health_update(state, tick, &report, &plan, 50)
+		if state.health.meter_pct != bal.meter_start_pct {
+			tfailf(t, "meter drained during grace at tick %d", tick)
+		}
+	}
+	if !has_event(state, 1) { tfail(t, "Grace_Started must fire") }
+	if !has_event(state, 2) { tfail(t, "Grace_Expired must fire when the window empties") }
+	// then drain: severity 90-50=40 -> 40/10=4 capped at 2 per tick (E16)
+	health_update(state, 300, &report, &plan, 50)
+	if state.health.meter_pct != bal.meter_start_pct - 2 {
+		tfailf(t, "drain: got %d, want %d", state.health.meter_pct, bal.meter_start_pct - 2)
+	}
+	// run it to empty -> Error 404
+	for tick in u64(301) ..= 400 {
+		health_update(state, tick, &report, &plan, 50)
+	}
+	if !state.health.lost { tfail(t, "meter empty must lose the run") }
+	if !has_event(state, 4) { tfail(t, "Run_Lost must fire") }
+	if state.health.won { tfail(t, "won and lost are mutually exclusive (E17)") }
+}
+
+@(test)
+test_health_recharge_and_grace_reset :: proc(t: ^testing.T) {
+	state := health_fixture(t)
+	report := Flow_Report{}
+	plan := empty_plan(false)
+	bal := &state.catalogs.balance
+	// breach partway through grace, then recover
+	for tick in u64(1) ..= 100 { health_update(state, tick, &report, &plan, 50) }
+	// healthy stretch: grace resets, meter recharges (already full here)
+	for tick in u64(101) ..= 200 { health_update(state, tick, &report, &plan, 97) }
+	if state.health.grace_ticks_left != bal.grace_window_ticks {
+		tfail(t, "grace must reset when healthy")
+	}
+	if state.health.in_grace { tfail(t, "in_grace must clear") }
+	// drain some, then recharge (past grace but well short of flatline)
+	for tick in u64(201) ..= 430 { health_update(state, tick, &report, &plan, 10) }
+	drained := state.health.meter_pct
+	if drained >= 100 { tfail(t, "expected drain") }
+	for tick in u64(431) ..= 460 { health_update(state, tick, &report, &plan, 100) }
+	if state.health.meter_pct <= drained { tfail(t, "meter must recharge when healthy") }
+	if state.health.lost { tfail(t, "this path must stay alive") }
+}
+
+@(test)
+test_health_win_on_surge_survival :: proc(t: ^testing.T) {
+	state := health_fixture(t)
+	// surge active with 95% delivery, then ends -> win
+	surge := empty_plan(true)
+	for tick in u64(1) ..= 10 {
+		report := Flow_Report{delivered = 95, dropped = 5}
+		health_update(state, tick, &report, &surge, 95)
+	}
+	calm := empty_plan(false)
+	report := Flow_Report{delivered = 0, dropped = 0}
+	health_update(state, 11, &report, &calm, 95)
+	if !state.health.won { tfail(t, "surge survived at 95% must win (>= 90)") }
+	if !has_event(state, 3) { tfail(t, "Run_Won must fire") }
+	// terminal: further updates are no-ops
+	meter := state.health.meter_pct
+	health_update(state, 12, &report, &calm, 10)
+	if state.health.meter_pct != meter { tfail(t, "terminal state is frozen") }
+}
+
+@(test)
+test_health_no_win_below_threshold :: proc(t: ^testing.T) {
+	state := health_fixture(t)
+	surge := empty_plan(true)
+	for tick in u64(1) ..= 10 {
+		report := Flow_Report{delivered = 80, dropped = 20} // 80% < 90
+		health_update(state, tick, &report, &surge, 85)
+	}
+	calm := empty_plan(false)
+	report := Flow_Report{}
+	health_update(state, 11, &report, &calm, 85)
+	if state.health.won { tfail(t, "80% < 90% must not win") }
+}
+
+@(test)
+test_health_grace_single_episode :: proc(t: ^testing.T) {
+	// E30: a re-breach during an active grace window is a no-op — one
+	// Grace_Started per episode.
+	state := health_fixture(t)
+	report := Flow_Report{}
+	plan := empty_plan(false)
+	count := 0
+	for tick in u64(1) ..= 50 {
+		health_update(state, tick, &report, &plan, 40)
+		for e in state.events {
+			if _, ok := e.kind.(Ev_Grace_Started); ok { count += 1 }
+		}
+		clear(&state.events)
+	}
+	if count != 1 { tfailf(t, "Grace_Started fired %d times, want 1", count) }
+}
+
+@(test)
+test_health_flapping_does_not_rearm_grace :: proc(t: ^testing.T) {
+	// the never-lose exploit (review W1): alternating breach/healthy ticks must
+	// NOT keep refilling the whole window — hysteresis + gradual refill.
+	state := health_fixture(t)
+	report := Flow_Report{}
+	plan := empty_plan(false)
+	bal := &state.catalogs.balance
+	// flap: 1 breach tick (50%), 1 healthy tick (97% >= exit 93 => episode exits)
+	// E30: after a healthy tick above exit, the episode CLOSES; the next breach
+	// re-enters with the grace left where it was (gradual refill only).
+	start_grace := bal.grace_window_ticks
+	for tick in u64(1) ..= 40 {
+		up: i32 = 50 if tick % 2 == 1 else 97
+		health_update(state, tick, &report, &plan, up)
+	}
+	// flapping (no 50-tick streak) never refills: 20 breach ticks burned 20
+	expected := start_grace - 20
+	if state.health.grace_ticks_left != expected {
+		tfailf(t, "grace after flap: got %d, want %d", state.health.grace_ticks_left, expected)
+	}
+	// and a sustained breach must still flatline even with perfect alternation
+	for tick in u64(41) ..= 2000 {
+		up: i32 = 50 if tick % 2 == 1 else 97
+		health_update(state, tick, &report, &plan, up)
+		if state.health.lost { break }
+	}
+	if !state.health.lost { tfail(t, "a chronically flapping run must still be losable") }
+}
+
+@(test)
+test_health_second_surge_window_resets :: proc(t: ^testing.T) {
+	// Perkins r1 (Godot): a second surge double-counted the first's traffic.
+	state := health_fixture(t)
+	surge := empty_plan(true)
+	calm := empty_plan(false)
+	// surge 1: 80% uptime (below the win bar)
+	for tick in u64(1) ..= 10 {
+		report := Flow_Report{delivered = 80, dropped = 20}
+		health_update(state, tick, &report, &surge, 85)
+	}
+	health_update(state, 11, &Flow_Report{}, &calm, 95) // surge 1 ends, no win
+	if state.health.won { tfail(t, "80% must not win") }
+	// surge 2: a CLEAN 100% window — must be judged fresh
+	for tick in u64(12) ..= 21 {
+		report := Flow_Report{delivered = 10, dropped = 0}
+		health_update(state, tick, &report, &surge, 100)
+	}
+	health_update(state, 22, &Flow_Report{}, &calm, 100)
+	if !state.health.won { tfail(t, "surge 2 at 100% must win (fresh window)") }
+}
+
+@(test)
+test_terminal_barrier_freezes :: proc(t: ^testing.T) {
+	// E17: post-terminal steps are no-ops — no events, no drift.
+	state := health_fixture(t)
+	report := Flow_Report{}
+	plan := empty_plan(false)
+	for tick in u64(1) ..= 400 { health_update(state, tick, &report, &plan, 10) }
+	if !state.health.lost { tfail(t, "fixture must lose") }
+	// now drive whole core steps past the terminal state
+	before_events := len(state.events)
+	h1 := state_hash(state, {}, context.temp_allocator)
+	for tick in u64(401) ..= 500 {
+		step(state, tick, {})
+	}
+	if len(state.events) != before_events { tfail(t, "no events after terminal") }
+	h2 := state_hash(state, {}, context.temp_allocator)
+	if h1 != h2 { tfail(t, "state must freeze after terminal (replay tails)") }
+}
diff --git a/core/qos.odin b/core/qos.odin
new file mode 100644
index 0000000..438f5e7
--- /dev/null
+++ b/core/qos.odin
@@ -0,0 +1,66 @@
+package core
+
+MAX_WEIGHT :: 64 // §6.3 weight-domain bound (Command_Bus validation)
+
+// qos.odin — S3 QoS lane model (ODN-3, architecture §6.3): pure procs inside
+// the flow, NOT a system. Per-pipe 3-lane bandwidth partition (WFQ weights,
+// largest-remainder integers) + serialization order. Stateless; weights live
+// on pipes (Topology owns the data).
+//
+// PROTO control surface: the single "priority emphasis" dial per pipe (a pipe
+// priority or junction triage switches the pipe to the emphasis preset from
+// balance.json — catalog data, never a literal; Perkins r1: the Godot (4,1,1)
+// preset was hardcoded).
+
+// Partition a pipe's capacity across its 3 lanes by WFQ weights. Largest-
+// remainder method (no bandwidth vanishes to truncation, E8); ties resolve
+// Express -> Standard -> Best. All-zero weights fall back to the catalog
+// default preset (E5). Sums/remainders in i64 (weight domain is bounded at
+// the Command_Bus).
+qos_allocate :: proc(capacity: i32, w: [3]i32, default_w: [3]i32) -> (caps: [3]i32) {
+	ww := w
+	total := i64(ww[0]) + i64(ww[1]) + i64(ww[2])
+	if total == 0 {
+		ww = default_w
+		total = i64(ww[0]) + i64(ww[1]) + i64(ww[2])
+	}
+	if total <= 0 || capacity <= 0 { return {} }
+	nums := [3]i64{i64(capacity) * i64(ww[0]), i64(capacity) * i64(ww[1]), i64(capacity) * i64(ww[2])}
+	caps = {i32(nums[0] / total), i32(nums[1] / total), i32(nums[2] / total)}
+	remainder := i32(i64(capacity) - (nums[0]/total + nums[1]/total + nums[2]/total))
+	// largest fractional remainder; tie order = lane order (E,S,B) — selection
+	// sort, deterministic.
+	order := [3]int{0, 1, 2}
+	for i in 0 ..< 2 {
+		for j in i+1 ..< 3 {
+			fi := nums[order[i]] % total
+			fj := nums[order[j]] % total
+			if fj > fi {
+				order[i], order[j] = order[j], order[i]
+			}
+		}
+	}
+	for i in 0 ..< int(remainder) {
+		caps[order[i]] += 1
+	}
+	return caps
+}
+
+// The lane a packet's class rides on a given pipe (the Godot-prototype rule,
+// carried): the pipe's OWN dial wins; else the junction's triage order applies
+// (triaged class -> Express, the others -> Best); neutral -> all Standard.
+effective_lane :: proc(pipe_priority: i32, junction_triage: i32, class: u16) -> Lane {
+	if pipe_priority >= 0 {
+		return .Express if i32(class) == pipe_priority else .Best
+	}
+	if junction_triage >= 0 {
+		return .Express if i32(class) == junction_triage else .Best
+	}
+	return .Standard
+}
+
+// Whether this pipe runs the emphasis preset (its own dial or its junction's
+// triage) — the promoted class gets a guaranteed share (the differentiator).
+emphasized :: proc(pipe_priority: i32, junction_triage: i32) -> bool {
+	return pipe_priority >= 0 || junction_triage >= 0
+}
diff --git a/core/qos_test.odin b/core/qos_test.odin
new file mode 100644
index 0000000..90ae327
--- /dev/null
+++ b/core/qos_test.odin
@@ -0,0 +1,54 @@
+package core
+
+// qos_test.odin — the QoS contracts (ODN-3, §6.3): largest-remainder integer
+// distribution (E8), all-zero fallback (E5), Express>Standard>Best tie order,
+// the emphasis preset, and the effective-lane rules (pipe dial > junction
+// triage > all-Standard).
+
+import "core:testing"
+
+@(test)
+test_qos_allocate_largest_remainder :: proc(t: ^testing.T) {
+	// 15 x (1,4,1): exact = (2.5, 10, 2.5) -> floors (2,10,2), remainder 1,
+	// fractional tie (0.5 = 0.5) resolves Express first (E8).
+	caps := qos_allocate(15, {1, 4, 1}, {1, 4, 1})
+	if caps != {3, 10, 2} { tfailf(t, "got %v, want {3,10,2}", caps) }
+	// nothing vanishes to truncation
+	if caps[0]+caps[1]+caps[2] != 15 { tfail(t, "allocation must conserve capacity") }
+}
+
+@(test)
+test_qos_allocate_emphasis :: proc(t: ^testing.T) {
+	// 40 x (4,1,1) (the emphasis preset): exact = (26.67, 6.67, 6.67) ->
+	// floors (26,6,6), remainder 2, fractional ties resolve E then S.
+	caps := qos_allocate(40, {4, 1, 1}, {1, 4, 1})
+	if caps != {27, 7, 6} { tfailf(t, "got %v, want {27,7,6}", caps) }
+	if caps[0]+caps[1]+caps[2] != 40 { tfail(t, "allocation must conserve capacity") }
+}
+
+@(test)
+test_qos_allocate_all_zero_falls_back :: proc(t: ^testing.T) {
+	// E5: all-zero weights -> the catalog default preset.
+	caps := qos_allocate(15, {0, 0, 0}, {1, 4, 1})
+	if caps != {3, 10, 2} { tfailf(t, "got %v, want default-preset {3,10,2}", caps) }
+}
+
+@(test)
+test_qos_allocate_degenerate :: proc(t: ^testing.T) {
+	if qos_allocate(0, {1, 4, 1}, {1, 4, 1}) != {0, 0, 0} { tfail(t, "zero capacity") }
+	if qos_allocate(10, {0, 0, 0}, {0, 0, 0}) != {0, 0, 0} { tfail(t, "zero weights + zero default") }
+}
+
+@(test)
+test_effective_lane_precedence :: proc(t: ^testing.T) {
+	streaming := u16(1)
+	email := u16(0)
+	// neutral pipe, neutral junction -> all Standard
+	if effective_lane(-1, -1, streaming) != .Standard { tfail(t, "neutral must ride Standard") }
+	// pipe dial wins over junction triage
+	if effective_lane(1, 0, streaming) != .Express { tfail(t, "pipe dial promotes its class") }
+	if effective_lane(1, 0, email) != .Best { tfail(t, "pipe dial demotes the other class") }
+	// junction triage when the pipe is neutral
+	if effective_lane(-1, 1, streaming) != .Express { tfail(t, "junction triage promotes") }
+	if effective_lane(-1, 1, email) != .Best { tfail(t, "junction triage demotes others") }
+}
diff --git a/core/rng.odin b/core/rng.odin
new file mode 100644
index 0000000..217bec2
--- /dev/null
+++ b/core/rng.odin
@@ -0,0 +1,57 @@
+package core
+
+// rng.odin — the owned PRNG (ODN-9). PCG32 XSH-RR (64-bit state, 32-bit output)
+// with seed expansion via splitmix64. Explicit integer code; the algorithm's
+// constants are written in the source (the canonical pcg-random.org PCG32).
+// NOT core:math/rand — the stdlib implementation may drift between Odin
+// releases; the determinism guarantee must not depend on the toolchain.
+//
+// Test vectors: seed 0's first 8 outputs are pinned in rng_test.odin. Any
+// future port (server validator, wasm) must reproduce them — this is the
+// cross-language determinism conformance test (REVIEW m6).
+
+Rng :: struct {
+	state: u64,
+	inc:   u64, // odd (the PCG stream selector)
+}
+
+PCG32_MULT :: 6364136223846793005  // the PCG32 multiplier (pinned)
+PCG32_INC  :: 1442695040888963407  // default stream (only used as a base constant)
+
+splitmix64 :: proc(s: ^u64) -> u64 {
+	s^ += 0x9E3779B97F4A7C15
+	z := s^
+	z = (z ~ (z >> 30)) * 0xBF58476D1CE4E5B9
+	z = (z ~ (z >> 27)) * 0x94D049BB133111EB
+	return z ~ (z >> 31)
+}
+
+// Seed from a single u64: splitmix64 expands the seed into the PCG state and
+// an odd stream selector, then two advances mix before first output.
+rng_seed :: proc(r: ^Rng, seed: u64) {
+	s := seed
+	r.state = splitmix64(&s)
+	r.inc = splitmix64(&s) | 1
+	rng_next(r)
+	r.state += splitmix64(&s)
+	rng_next(r)
+}
+
+// pcg32 XSH-RR: output is a function of the OLD state, then the state advances.
+rng_next :: proc(r: ^Rng) -> u32 {
+	old := r.state
+	r.state = old * PCG32_MULT + r.inc
+	xorshifted := u32(((old >> 18) ~ old) >> 27)
+	rot := u32(old >> 59)
+	return (xorshifted >> rot) | (xorshifted << ((-rot) & 31))
+}
+
+// Bounded draw in [lo, hi] INCLUSIVE. Multiply-shift (Lemire) instead of
+// modulo: bias is < 2^-32 and the draw is a single multiply — the bias-
+// avoidance note ODN-9 asks to keep with the code. Callers pass span-ordered
+// (lo <= hi) bounds; a degenerate span returns lo.
+rng_range :: proc(r: ^Rng, lo, hi: i32) -> i32 {
+	if hi <= lo { return lo }
+	span := u64(u32(hi - lo)) + 1
+	return lo + i32((u64(rng_next(r)) * span) >> 32)
+}
diff --git a/core/rng_test.odin b/core/rng_test.odin
new file mode 100644
index 0000000..37b0114
--- /dev/null
+++ b/core/rng_test.odin
@@ -0,0 +1,55 @@
+package core
+
+// rng_test.odin — the pinned PRNG conformance vectors (ODN-9). Generated once
+// from the canonical PCG32 XSH-RR reference (the algorithm implemented in
+// rng.odin, constants in source). Any future port (server validator, wasm)
+// must reproduce these — the cross-language determinism contract.
+
+import "core:testing"
+
+@(test)
+test_rng_pinned_vectors :: proc(t: ^testing.T) {
+	r: Rng
+	rng_seed(&r, 0)
+	expected := [8]u32{2196338726, 1832588393, 3253730937, 2647056997,
+	                   2191141068, 1480505347, 3030956019, 209995402}
+	for e, i in expected {
+		if got := rng_next(&r); got != e {
+			tfailf(t, "seed 0 output %d: got %d, want %d", i, got, e)
+		}
+	}
+}
+
+@(test)
+test_rng_seed42_pinned :: proc(t: ^testing.T) {
+	r: Rng
+	rng_seed(&r, 42)
+	expected := [4]u32{2399007886, 4293122540, 1743717038, 2217374311}
+	for e, i in expected {
+		if got := rng_next(&r); got != e {
+			tfailf(t, "seed 42 output %d: got %d, want %d", i, got, e)
+		}
+	}
+}
+
+@(test)
+test_rng_range_bounds :: proc(t: ^testing.T) {
+	r: Rng
+	rng_seed(&r, 7)
+	for _ in 0 ..< 10000 {
+		v := rng_range(&r, 6, 34)
+		if v < 6 || v > 34 { tfailf(t, "rng_range out of bounds: %d", v) }
+	}
+	if rng_range(&r, 5, 5) != 5 { tfail(t, "degenerate span must return lo") }
+}
+
+@(test)
+test_rng_streams_independent :: proc(t: ^testing.T) {
+	// same seed => identical stream (the determinism keystone)
+	a, b: Rng
+	rng_seed(&a, 1337)
+	rng_seed(&b, 1337)
+	for _ in 0 ..< 100 {
+		if rng_next(&a) != rng_next(&b) { tfail(t, "same seed must reproduce the stream") }
+	}
+}
diff --git a/core/run.odin b/core/run.odin
new file mode 100644
index 0000000..78a3d16
--- /dev/null
+++ b/core/run.odin
@@ -0,0 +1,165 @@
+package core
+
+// run.odin — Run_State: the whole authoritative sim state (ODN-1/13), the
+// bootstrap (fixed seed map + seeded growth pool), and core.step — the ONLY
+// entry point that advances the simulation.
+//
+// Step order (the §4 data flow, pinned):
+//   1. topology_apply_all (replay/tooling commands; live edits already landed
+//      via the ODN-2 fast-path)
+//   2. map growth (Director, deterministic spawn validity E31)
+//   3. director.plan_pressure (scripted, upstream)
+//   4. flow_step (QoS + SLA inside)
+//   5. crisis_evaluate (downstream of flow)
+//   6. health_update (downstream of SLA)
+//   Terminal-event barrier (E17): once Run_Lost is appended, the remaining
+//   systems in the tick are skipped — one terminal event per run.
+
+Run_State :: struct {
+	seed:      u64,
+	tick:      u64,
+	rng:       Rng,
+	catalogs:  ^Catalogs,
+	topology:  Topology,
+	flow:      Flow_State,
+	crisis:    Crisis_State,
+	health:    Health_Meter,
+	director:  Director_State,
+	era:       u8, // PROTO pins era 3 (the surge slice); the Era FSM is [LATER]
+	budget:    i32,
+	events:    [dynamic]Event,
+	// cumulative run counters (deterministic; part of the T1 fingerprint)
+	spawned_total:   u64,
+	delivered_total: u64,
+	dropped_total:   u64,
+	unmet_total:     u64,
+	// the action log (ODN-11): post-validation, post-snap commands with
+	// apply_tick; replay reproduces the run bit-for-bit
+	action_log: [dynamic]Command,
+	// set when a replayed command fails validation — CRITICAL (ODN-11); the
+	// harness treats it as a failed run
+	replay_error: bool,
+	// allocator for all run-lifetime growth (the run arena's)
+	allocator: mem.Allocator,
+}
+
+import "core:mem"
+
+// The fixed seed map (the Godot prototype's proven-fun 6-node start): one
+// content host, four residentials, one MID router. Positions are integer tile
+// coords on the catalog map grid. All stats come from the node-types catalog
+// (numbers single-source — Perkins r1: the Godot bootstrap hardcoded the
+// content host's throughput).
+bootstrap_map :: proc(state: ^Run_State) {
+	t := &state.topology
+	cat := state.catalogs
+	host, _ := node_type_index(cat, "content_host")
+	res, _ := node_type_index(cat, "residential")
+	mid, _ := node_type_index(cat, "router_mid")
+	spawn_node(t, host, {30, 14}, 0, cat)
+	spawn_node(t, res, {8, 5}, 0, cat)
+	spawn_node(t, res, {8, 14}, 0, cat)
+	spawn_node(t, res, {8, 22}, 0, cat)
+	spawn_node(t, res, {14, 24}, 0, cat)
+	spawn_node(t, mid, {18, 14}, 0, cat)
+}
+
+run_init :: proc(state: ^Run_State, seed: u64, cat: ^Catalogs, allocator: mem.Allocator) {
+	run_init_bare(state, seed, cat, allocator)
+	bootstrap_map(state)
+	// Seed the growth pool from the run rng AFTER the fixed map and BEFORE the
+	// first demand draw — growth consumes exactly pool-size draws at bootstrap,
+	// then none during the run (the demand stream is untouched).
+	director_init_growth(&state.director, &state.rng, &cat.balance)
+}
+
+// Bare init (no seed map, no growth schedule) — test/harness fixtures that
+// build their own topology. Growth is disabled (schedule exhausted).
+run_init_bare :: proc(state: ^Run_State, seed: u64, cat: ^Catalogs, allocator: mem.Allocator) {
+	state.allocator = allocator
+	context.allocator = allocator
+	state.seed = seed
+	state.tick = 0
+	rng_seed(&state.rng, seed)
+	state.catalogs = cat
+	state.era = 3
+	state.budget = cat.balance.default_budget
+	topology := Topology{
+		node_by_id = make(map[u32]u32),
+		pipe_by_id = make(map[u32]u32),
+		next_node_id = 1, // ids are 1-based: 0 is the 'none' sentinel everywhere
+		next_pipe_id = 1,
+	}
+	state.topology = topology
+	flow_init(&state.flow, cat)
+	health_init(&state.health, &cat.balance)
+	// director flags per set-piece
+	for _ in cat.demand.set_pieces {
+		append(&state.director.forecasted, false)
+		append(&state.director.triggered, false)
+		append(&state.director.resolved, false)
+	}
+	state.director.growth_done = 1 << 30 // bare: no growth
+}
+
+run_destroy :: proc(state: ^Run_State) {
+	delete(state.topology.node_by_id)
+	delete(state.topology.pipe_by_id)
+}
+
+// The ONLY entry point that advances the simulation (ODN-1).
+step :: proc(state: ^Run_State, tick: u64, commands: []Command) {
+	context.allocator = state.allocator
+	// Terminal-event barrier (E17): a won/lost run never steps again — no
+	// growth, no flow, no events, not even the tick counter; the state hash
+	// freezes for replay tails.
+	if state.health.won || state.health.lost { return }
+	state.tick = tick
+
+	// 1. replay/tooling commands. The action log is a STREAM of individually
+	//    validated commands (each live edit validated against the state of its
+	//    moment), so replay applies entries IN ORDER, each validated against
+	//    the state the previous entries produced — NOT as one atomic E23 batch
+	//    (a tick's log can legitimately hold draw+priority on the same pipe;
+	//    atomic validation would reject the priority against the un-drawn
+	//    pipe). Live edits already landed via the ODN-2 fast-path and are NOT
+	//    re-applied here.
+	if len(commands) > 0 {
+		for cmd in commands {
+			nb, _, err := topology_apply_edit(&state.topology, cmd, state.catalogs, state.budget, cmd.apply_tick)
+			if err != .None {
+				// a command that fails validation during replay is a CRITICAL
+				// error (ODN-11) — play and replay can never drift on legality
+				state.replay_error = true
+			} else {
+				state.budget = nb
+			}
+		}
+	}
+
+	// 2. map growth (deterministic; applied before demand so new nodes join
+	//    immediately — unconnected = visible pressure)
+	if type_idx, pos, ok := director_plan_growth(&state.director, &state.topology, state.catalogs, tick); ok {
+		id := spawn_node(&state.topology, type_idx, pos, tick, state.catalogs)
+		emit(state, tick, Ev_Node_Spawned{node = id, type_idx = type_idx})
+	}
+
+	// 3. Director plans pressure (pure function of catalog + tick in PROTO;
+	//    the rng is passed for the seam contract and never drawn — REVIEW M1).
+	plan := scripted_plan_pressure(state.catalogs, tick, context.temp_allocator)
+
+	// 4. flow (QoS + SLA inside)
+	report := flow_step(state, tick, &plan)
+	state.spawned_total += u64(report.spawned)
+	state.delivered_total += u64(report.delivered)
+	state.dropped_total += u64(report.dropped)
+	state.unmet_total += u64(report.unmet)
+
+	// 5. crisis (downstream of flow)
+	crisis_evaluate(state, tick, &plan)
+
+	// 6. health (downstream of SLA)
+	health_update(state, tick, &report, &plan, recent_overall_uptime(&state.flow))
+
+	// (Era FSM / Economy score — [LATER] layers; the slots are reserved here.)
+}
diff --git a/core/serialize.odin b/core/serialize.odin
new file mode 100644
index 0000000..142d8b6
--- /dev/null
+++ b/core/serialize.odin
@@ -0,0 +1,330 @@
+package core
+
+// serialize.odin — the canonical serialized form (ODN-11/T1). Field-wise
+// little-endian, lengths-not-capacities, no padding, no pointers — INCLUDING
+// rng state, in-flight packet internals (route/edge/progress/latency/vis),
+// rolling windows, rr cursors, growth state, and the tick's event stream.
+// (Perkins r1 on the Godot prototype: the fingerprint omitted in-flight packet
+// state + latency, so replay-equality could pass while packet internals
+// diverged. Here the fingerprint covers ALL sim state.)
+//
+// Also the action-log binary format (ODN-11): versioned little-endian header
+// (magic, version, seed, era, catalog_hash, logic_hz) + length-prefixed
+// records of post-validation commands. "Byte-identical replay" = mem.compare.
+
+Writer :: struct {
+	buf: [dynamic]u8,
+}
+
+w_u8 :: proc(w: ^Writer, v: u8) { append(&w.buf, v) }
+
+w_u16 :: proc(w: ^Writer, v: u16) {
+	append(&w.buf, u8(v), u8(v >> 8))
+}
+
+w_u32 :: proc(w: ^Writer, v: u32) {
+	append(&w.buf, u8(v), u8(v >> 8), u8(v >> 16), u8(v >> 24))
+}
+
+w_i32 :: proc(w: ^Writer, v: i32) { w_u32(w, u32(v)) }
+
+w_u64 :: proc(w: ^Writer, v: u64) {
+	for i in 0 ..< 8 { append(&w.buf, u8(v >> (8 * uint(i)))) }
+}
+
+w_i64 :: proc(w: ^Writer, v: i64) { w_u64(w, u64(v)) }
+
+w_bool :: proc(w: ^Writer, v: bool) { w_u8(w, 1 if v else 0) }
+
+// --- the T1 state hash ---------------------------------------------------------
+
+// Serialize the full sim state and FNV-1a-64 it. Called per tick by the
+// harness (and by the replay-equality unit test).
+state_dump :: proc(state: ^Run_State, tick_events: []Event, scratch := context.temp_allocator) -> []u8 {
+	w := state_writer(state, tick_events, scratch)
+	return w.buf[:]
+}
+
+state_hash :: proc(state: ^Run_State, tick_events: []Event, scratch := context.temp_allocator) -> u64 {
+	w := state_writer(state, tick_events, scratch)
+	return fnv1a64(w.buf[:])
+}
+
+state_writer :: proc(state: ^Run_State, tick_events: []Event, scratch := context.temp_allocator) -> Writer {
+	w: Writer
+	w.buf = make([dynamic]u8, 0, 4096, scratch)
+
+	w_u64(&w, state.seed)
+	w_u64(&w, state.tick)
+	w_u64(&w, state.rng.state)
+	w_u64(&w, state.rng.inc)
+	w_u8(&w, state.era)
+	w_i32(&w, state.budget)
+	w_u64(&w, state.spawned_total)
+	w_u64(&w, state.delivered_total)
+	w_u64(&w, state.dropped_total)
+	w_u64(&w, state.unmet_total)
+
+	// topology — arrays in insertion order (deterministic, ODN-10)
+	t := &state.topology
+	w_u32(&w, t.next_node_id)
+	w_u32(&w, t.next_pipe_id)
+	w_u32(&w, u32(len(t.node_alive)))
+	for i in 0 ..< len(t.node_alive) {
+		w_bool(&w, t.node_alive[i])
+		w_u32(&w, t.node_id[i])
+		w_u16(&w, t.node_type[i])
+		w_u8(&w, u8(t.node_kind[i]))
+		w_i32(&w, i32(t.node_role[i]))
+		w_i32(&w, t.node_pos[i][0])
+		w_i32(&w, t.node_pos[i][1])
+		w_i32(&w, t.node_throughput[i])
+		w_i32(&w, t.node_ports[i])
+		w_bool(&w, t.node_lb_weighted[i])
+		w_i32(&w, t.node_triage[i])
+		w_u64(&w, t.node_spawn_tick[i])
+	}
+	w_u32(&w, u32(len(t.pipe_alive)))
+	for i in 0 ..< len(t.pipe_alive) {
+		w_bool(&w, t.pipe_alive[i])
+		w_u32(&w, t.pipe_id[i])
+		w_u32(&w, t.pipe_a[i])
+		w_u32(&w, t.pipe_b[i])
+		w_u16(&w, t.pipe_tier[i])
+		w_i32(&w, t.pipe_capacity[i])
+		w_i32(&w, t.pipe_span[i])
+		w_i32(&w, t.pipe_weights[i][0])
+		w_i32(&w, t.pipe_weights[i][1])
+		w_i32(&w, t.pipe_weights[i][2])
+		w_i32(&w, t.pipe_priority[i])
+		w_u64(&w, t.pipe_spawn_tick[i])
+	}
+
+	// flow — ALL packet internals (the Perkins r1 gap closed)
+	f := &state.flow
+	w_u64(&w, f.next_packet_id)
+	w_i32(&w, f.ms_per_tick)
+	w_u32(&w, u32(len(f.packets)))
+	for p in f.packets {
+		w_u64(&w, p.id)
+		w_u16(&w, p.class)
+		w_u32(&w, p.src)
+		w_u32(&w, p.dst)
+		w_u8(&w, p.route_len)
+		for i in 0 ..< int(p.route_len) { w_u32(&w, p.route[i]) }
+		w_u8(&w, p.edge_idx)
+		w_i32(&w, p.progress_units)
+		w_u8(&w, u8(p.lane))
+		w_u64(&w, p.spawn_tick)
+		w_i32(&w, p.bandwidth_demand)
+		w_i32(&w, p.accrued_latency_ms)
+		w_i32(&w, p.vis_q8)
+	}
+	for acc in f.sla {
+		w_u64(&w, acc.delivered)
+		w_u64(&w, acc.dropped)
+		w_u64(&w, acc.total_latency_ms)
+		w_u64(&w, acc.demand_seen)
+	}
+	w_u32(&w, u32(len(f.rr_a)))
+	for i in 0 ..< len(f.rr_a) {
+		w_u32(&w, f.rr_a[i])
+		w_u32(&w, f.rr_b[i])
+		w_u32(&w, f.rr_cursor[i])
+	}
+	w_i32(&w, f.roll_idx)
+	for c in 0 ..< len(f.sla) {
+		w_i32(&w, f.roll_ds[c])
+		w_i32(&w, f.roll_dps[c])
+		window := len(f.roll_del[c])
+		w_u32(&w, u32(window))
+		for i in 0 ..< window {
+			w_i32(&w, f.roll_del[c][i])
+			w_i32(&w, f.roll_drop[c][i])
+		}
+	}
+
+	// crisis + health + director
+	c := &state.crisis
+	w_u32(&w, u32(len(c.node_health)))
+	for h in c.node_health { w_u8(&w, u8(h)) }
+	w_bool(&w, c.surge_active)
+	h := &state.health
+	w_i32(&w, h.meter_pct)
+	w_i32(&w, h.grace_ticks_left)
+	w_bool(&w, h.in_grace)
+	w_bool(&w, h.won)
+	w_bool(&w, h.lost)
+	w_u64(&w, h.surge_delivered)
+	w_u64(&w, h.surge_dropped)
+	w_bool(&w, h.prev_in_surge)
+	d := &state.director
+	w_u32(&w, u32(d.growth_pool_idx))
+	w_u64(&w, d.growth_next)
+	w_u32(&w, u32(d.growth_done))
+	for v in d.growth_pool { w_i32(&w, v[0]); w_i32(&w, v[1]) }
+	for v in d.forecasted { w_bool(&w, v) }
+	for v in d.triggered { w_bool(&w, v) }
+	for v in d.resolved { w_bool(&w, v) }
+
+	// the tick's event stream
+	w_u32(&w, u32(len(tick_events)))
+	for e in tick_events {
+		w_u64(&w, e.tick)
+		switch k in e.kind {
+		case Ev_Packet_Arrived:
+			w_u8(&w, 1); w_u16(&w, k.class)
+		case Ev_Packet_Dropped:
+			w_u8(&w, 2); w_u16(&w, k.class); w_u8(&w, u8(k.reason))
+		case Ev_Node_Spawned:
+			w_u8(&w, 3); w_u32(&w, k.node); w_u16(&w, k.type_idx)
+		case Ev_Forecast_Issued:
+			w_u8(&w, 4); w_u16(&w, k.set_piece)
+		case Ev_Warning_Raised:
+			w_u8(&w, 5); w_u32(&w, k.node); w_u8(&w, u8(k.level))
+		case Ev_Warning_Cleared:
+			w_u8(&w, 6); w_u32(&w, k.node)
+		case Ev_Crisis_Triggered:
+			w_u8(&w, 7); w_u8(&w, u8(k.archetype)); w_u16(&w, k.set_piece)
+			w_u8(&w, u8(k.root_cause.pattern)); w_u32(&w, k.root_cause.node)
+		case Ev_Crisis_Resolved:
+			w_u8(&w, 8); w_u8(&w, u8(k.archetype)); w_u16(&w, k.set_piece)
+		case Ev_Grace_Started:
+			w_u8(&w, 9)
+		case Ev_Grace_Expired:
+			w_u8(&w, 10)
+		case Ev_Meter_Changed:
+			w_u8(&w, 11); w_i32(&w, k.pct)
+		case Ev_Run_Won:
+			w_u8(&w, 12); w_i32(&w, k.surge_uptime_pct)
+		case Ev_Run_Lost:
+			w_u8(&w, 13)
+		}
+	}
+
+	return w
+}
+
+// --- the action log (ODN-11 binary) --------------------------------------------
+
+LOG_MAGIC   :: 0x314C5050 // "PPL1" little-endian
+LOG_VERSION :: 1
+
+log_write :: proc(state: ^Run_State, scratch := context.temp_allocator) -> []u8 {
+	w: Writer
+	w.buf = make([dynamic]u8, 0, 256, scratch)
+	w_u32(&w, LOG_MAGIC)
+	w_u32(&w, LOG_VERSION)
+	w_u64(&w, state.seed)
+	w_u8(&w, state.era)
+	w_u64(&w, state.catalogs.hash)
+	w_i32(&w, state.catalogs.balance.logic_hz)
+	w_u32(&w, u32(len(state.action_log)))
+	for cmd in state.action_log {
+		w_u64(&w, cmd.apply_tick)
+		switch c in cmd.kind {
+		case Cmd_Draw_Pipe:
+			w_u8(&w, 1); w_u32(&w, c.a); w_u32(&w, c.b); w_u16(&w, c.tier)
+		case Cmd_Upgrade_Pipe:
+			w_u8(&w, 2); w_u32(&w, c.pipe); w_u16(&w, c.to_tier)
+		case Cmd_Demolish:
+			w_u8(&w, 3); w_u32(&w, c.target); w_bool(&w, c.is_node)
+		case Cmd_Set_Lane_Weights:
+			w_u8(&w, 4); w_u32(&w, c.pipe)
+			w_i32(&w, c.weights[0]); w_i32(&w, c.weights[1]); w_i32(&w, c.weights[2])
+		case Cmd_Set_Pipe_Priority:
+			w_u8(&w, 5); w_u32(&w, c.pipe); w_i32(&w, c.priority)
+		case Cmd_Set_Junction_Triage:
+			w_u8(&w, 6); w_u32(&w, c.junction); w_i32(&w, c.triage)
+		}
+	}
+	return w.buf[:]
+}
+
+// --- log reader (the replay half) ------------------------------------------------
+
+Reader :: struct {
+	data: []u8,
+	pos:  int,
+	bad:  bool, // set on any past-end read (truncation = corrupt, never silent)
+}
+
+r_u8 :: proc(r: ^Reader) -> u8 {
+	if r.pos >= len(r.data) {
+		r.bad = true
+		return 0
+	}
+	v := r.data[r.pos]
+	r.pos += 1
+	return v
+}
+
+r_u16 :: proc(r: ^Reader) -> u16 {
+	return u16(r_u8(r)) | u16(r_u8(r)) << 8
+}
+
+r_u32 :: proc(r: ^Reader) -> u32 {
+	return u32(r_u8(r)) | u32(r_u8(r)) << 8 | u32(r_u8(r)) << 16 | u32(r_u8(r)) << 24
+}
+
+r_i32 :: proc(r: ^Reader) -> i32 { return i32(r_u32(r)) }
+
+r_u64 :: proc(r: ^Reader) -> u64 {
+	v: u64 = 0
+	for i in 0 ..< 8 { v |= u64(r_u8(r)) << (8 * uint(i)) }
+	return v
+}
+
+Log_Header :: struct {
+	seed:         u64,
+	era:          u8,
+	catalog_hash: u64,
+	logic_hz:     i32,
+}
+
+// Parse an action log; validates magic/version. ok=false on corruption
+// (critical error handling, ODN-11).
+log_read :: proc(data: []u8, allocator := context.allocator) -> (Log_Header, []Command, bool) {
+	cmds: []Command
+	r := Reader{data = data}
+	if r_u32(&r) != LOG_MAGIC { return {}, nil, false }
+	if r_u32(&r) != LOG_VERSION { return {}, nil, false }
+	h: Log_Header
+	h.seed = r_u64(&r)
+	h.era = r_u8(&r)
+	h.catalog_hash = r_u64(&r)
+	h.logic_hz = r_i32(&r)
+	n := r_u32(&r)
+	// bounds sanity before allocation: the smallest record is 9 bytes
+	// (apply_tick u64 + tag u8); a count beyond the remaining bytes is corrupt
+	if u64(n) * 9 > u64(len(r.data) - r.pos) { return {}, nil, false }
+	cmds = make([]Command, n, allocator)
+	for i in 0 ..< int(n) {
+		cmd: Command
+		cmd.apply_tick = r_u64(&r)
+		switch r_u8(&r) {
+		case 1:
+			cmd.kind = Cmd_Draw_Pipe{a = r_u32(&r), b = r_u32(&r), tier = r_u16(&r)}
+		case 2:
+			cmd.kind = Cmd_Upgrade_Pipe{pipe = r_u32(&r), to_tier = r_u16(&r)}
+		case 3:
+			target := r_u32(&r)
+			is_node := r_u8(&r)
+			if is_node > 1 { return {}, nil, false }
+			cmd.kind = Cmd_Demolish{target = target, is_node = is_node == 1}
+		case 4:
+			pipe := r_u32(&r)
+			w := [3]i32{r_i32(&r), r_i32(&r), r_i32(&r)}
+			cmd.kind = Cmd_Set_Lane_Weights{pipe = pipe, weights = w}
+		case 5:
+			cmd.kind = Cmd_Set_Pipe_Priority{pipe = r_u32(&r), priority = r_i32(&r)}
+		case 6:
+			cmd.kind = Cmd_Set_Junction_Triage{junction = r_u32(&r), triage = r_i32(&r)}
+		case:
+			return {}, nil, false
+		}
+		cmds[i] = cmd
+	}
+	if r.bad || r.pos != len(r.data) { return {}, nil, false } // truncation/trailing = corrupt
+	return h, cmds, true
+}
diff --git a/core/snapshot.odin b/core/snapshot.odin
new file mode 100644
index 0000000..755ce94
--- /dev/null
+++ b/core/snapshot.odin
@@ -0,0 +1,237 @@
+package core
+
+// snapshot.odin — the sole contract between Core and Presentation (ODN-1).
+// The view reads only the immutable snapshot; it can never perturb the sim.
+// PROTO renders at sim rate (the Godot reference's cadence — its vis-dist
+// smoothness is carried as vis_q8), so a single live snapshot rewritten per
+// tick (and topology-only on edit fast-path) replaces the ping-pong pair.
+
+Snap_Node :: struct {
+	id:          u32,
+	type_idx:    u16,
+	kind:        Node_Kind,
+	role:        Terminal_Role,
+	pos:         [2]i32,
+	throughput:  i32,
+	load:        i32,
+	ports:       i32,
+	ports_used:  i32,
+	lb_weighted: bool,
+	triage:      i32,
+	health:      Health_State,
+	flow_counts: [MAX_CLASSES]i32, // in-flight packets of each class through this node
+}
+
+Snap_Pipe :: struct {
+	id:        u32,
+	a, b:      u32,
+	tier:      u16,
+	span:      i32,
+	capacity:  i32,
+	weights:   [3]i32,
+	lane_caps: [3]i32, // this tick's effective allocation (emphasis applied)
+	priority:  i32,
+	on_pipe:   i32,    // in-flight packets currently traversing (pressure)
+}
+
+Snap_Packet :: struct {
+	class: u16,
+	lane:  Lane,
+	pipe:  u32, // the pipe the packet is visually ON (0 = at a node)
+	frac_q8: i32, // Q8 fraction along that pipe (0..256), a->b direction
+	node:  u32, // when pipe == 0: the node it sits at
+}
+
+Snap_Class :: struct {
+	delivered:  u64,
+	dropped:    u64,
+	uptime_pct: i32, // recent rolling uptime; -1 = neutral (no traffic)
+	avg_latency_ms: i32,
+}
+
+Snap_Forecast :: struct {
+	set_piece:   u16,
+	ticks_until: i64, // until start (forecast) — the countdown numeral
+}
+
+Snapshot :: struct {
+	tick:            u64,
+	era:             u8,
+	meter_pct:       i32,
+	grace_ticks_left: i32,
+	in_grace:        bool,
+	won:             bool,
+	lost:            bool,
+	uptime_pct:      i32, // overall recent; -1 = neutral
+	in_flight:       i32,
+	budget:          i32,
+	spawned_total:   u64,
+	delivered_total: u64,
+	dropped_total:   u64,
+	unmet_total:     u64,
+	nodes:           [dynamic]Snap_Node,
+	pipes:           [dynamic]Snap_Pipe,
+	packets:         [dynamic]Snap_Packet,
+	classes:         [dynamic]Snap_Class,
+	forecasts:       [dynamic]Snap_Forecast,
+	surge_active:    bool,
+	surge_ends_in:   i64, // ticks until the active surge ends; -1 if none
+}
+
+snapshot_write :: proc(snap: ^Snapshot, state: ^Run_State, allocator := context.temp_allocator) {
+	t := &state.topology
+	f := &state.flow
+	cat := state.catalogs
+	snap.tick = state.tick
+	snap.era = state.era
+	snap.meter_pct = state.health.meter_pct
+	snap.grace_ticks_left = state.health.grace_ticks_left
+	snap.in_grace = state.health.in_grace
+	snap.won = state.health.won
+	snap.lost = state.health.lost
+	snap.uptime_pct = recent_overall_uptime(f)
+	snap.in_flight = i32(len(f.packets))
+	snap.budget = state.budget
+	snap.spawned_total = state.spawned_total
+	snap.delivered_total = state.delivered_total
+	snap.dropped_total = state.dropped_total
+	snap.unmet_total = state.unmet_total
+	snap.surge_active = state.crisis.surge_active
+	snap.surge_ends_in = -1
+
+	clear(&snap.nodes)
+	for i in 0 ..< len(t.node_alive) {
+		if !t.node_alive[i] { continue }
+		load: i32 = 0
+		if i < len(f.node_load) { load = f.node_load[i] }
+		health: Health_State = .Healthy
+		if i < len(state.crisis.node_health) { health = state.crisis.node_health[i] }
+		fc: [MAX_CLASSES]i32
+		if i < len(f.node_load) {
+			for c in 0 ..< len(cat.packet_types) {
+				fc[c] = f.node_flow[i*MAX_CLASSES + c]
+			}
+		}
+		append(&snap.nodes, Snap_Node{
+			id = t.node_id[i],
+			type_idx = t.node_type[i],
+			kind = t.node_kind[i],
+			role = t.node_role[i],
+			pos = t.node_pos[i],
+			throughput = t.node_throughput[i],
+			load = load,
+			ports = t.node_ports[i],
+			ports_used = i32(incident_pipe_count(t, t.node_id[i])),
+			lb_weighted = t.node_lb_weighted[i],
+			triage = t.node_triage[i],
+			health = health,
+			flow_counts = fc,
+		})
+	}
+
+	clear(&snap.pipes)
+	for i in 0 ..< len(t.pipe_alive) {
+		if !t.pipe_alive[i] { continue }
+		junc_triage: i32 = -1
+		if na, ok := node_slot(t, t.pipe_a[i]); ok && t.node_kind[na] == .Junction {
+			junc_triage = t.node_triage[na]
+		} else if nb, ok2 := node_slot(t, t.pipe_b[i]); ok2 && t.node_kind[nb] == .Junction {
+			junc_triage = t.node_triage[nb]
+		}
+		weights := t.pipe_weights[i]
+		if emphasized(t.pipe_priority[i], junc_triage) {
+			weights = cat.balance.emphasis_preset
+		}
+		on_pipe: i32 = 0
+		for p in f.packets {
+			if p.route_len > 0 && int(p.edge_idx) < int(p.route_len) && p.route[p.edge_idx] == t.pipe_id[i] {
+				on_pipe += 1
+			}
+		}
+		append(&snap.pipes, Snap_Pipe{
+			id = t.pipe_id[i],
+			a = t.pipe_a[i], b = t.pipe_b[i],
+			tier = t.pipe_tier[i],
+			span = t.pipe_span[i],
+			capacity = t.pipe_capacity[i],
+			weights = t.pipe_weights[i],
+			lane_caps = qos_allocate(t.pipe_capacity[i], weights, cat.balance.default_lane_weights),
+			priority = t.pipe_priority[i],
+			on_pipe = on_pipe,
+		})
+	}
+
+	clear(&snap.packets)
+	for p in f.packets {
+		pipe, frac, node := packet_edge_pos(p, t)
+		append(&snap.packets, Snap_Packet{class = p.class, lane = p.lane, pipe = pipe, frac_q8 = frac, node = node})
+	}
+
+	clear(&snap.classes)
+	for acc, i in f.sla {
+		avg: i32 = 0
+		if acc.delivered > 0 { avg = i32(acc.total_latency_ms / acc.delivered) }
+		append(&snap.classes, Snap_Class{
+			delivered = acc.delivered,
+			dropped = acc.dropped,
+			uptime_pct = recent_class_uptime(f, u16(i)),
+			avg_latency_ms = avg,
+		})
+	}
+
+	clear(&snap.forecasts)
+	for sp, i in cat.demand.set_pieces {
+		s := sp
+		if set_piece_forecasted(&s, state.tick) {
+			append(&snap.forecasts, Snap_Forecast{
+				set_piece = u16(i),
+				ticks_until = i64(s.start_tick) - i64(state.tick),
+			})
+		}
+		if set_piece_active(&s, state.tick) {
+			snap.surge_ends_in = i64(s.start_tick + s.duration_ticks) - i64(state.tick)
+		}
+	}
+}
+
+// Integer walk of the route consuming vis_q8 (Q8 edge-fractions): which pipe
+// the packet visually rides + the fraction along it. The view maps (pipe,
+// frac) onto the pipe's BEZIER so dots follow the rendered curve. Direction
+// matters: frac runs from the packet's FROM node toward its TO node.
+packet_edge_pos :: proc(p: Packet, t: ^Topology) -> (pipe: u32, frac_q8: i32, node: u32) {
+	if p.route_len == 0 { return 0, 0, p.src }
+	remaining := p.vis_q8
+	for i in 0 ..< int(p.route_len) {
+		pid := p.route[i]
+		if remaining <= 256 {
+			// orient: frac measured from the traversal direction's start
+			ps, ok := pipe_slot(t, pid)
+			if !ok { return 0, 0, p.src }
+			a := t.pipe_a[ps]
+			b := t.pipe_b[ps]
+			// the packet's direction along the pipe: from src-side to dst-side.
+			// The route walk tracks the node it came from; recompute quickly:
+			// for edge i the entry node is the entry node.
+			entry := route_entry_node(p, t, i)
+			rem := max(0, remaining)
+			if entry == b {
+				rem = 256 - rem // frac always a->b; flip when traversing b->a
+			}
+			return pid, rem, 0
+		}
+		remaining -= 256
+	}
+	return 0, 0, p.dst
+}
+
+// the node the packet ENTERED edge i from (src walked through completed edges)
+route_entry_node :: proc(p: Packet, t: ^Topology, edge: int) -> u32 {
+	node := p.src
+	for i in 0 ..< edge {
+		ps, ok := pipe_slot(t, p.route[i])
+		if !ok { return node }
+		a, b := t.pipe_a[ps], t.pipe_b[ps]
+		node = b if a == node else (a if b == node else node)
+	}
+	return node
+}
diff --git a/core/testkit.odin b/core/testkit.odin
new file mode 100644
index 0000000..41635c3
--- /dev/null
+++ b/core/testkit.odin
@@ -0,0 +1,124 @@
+package core
+
+// testkit.odin — harness/test tooling (NOT used by the game). The demo
+// autopilot: wires the network the way a good player does — junctions mesh
+// first (router-to-router links), then houses attach to the nearest router
+// with a free port; standard legs escalating to wide when span demands. Every
+// command goes through topology_apply_edit — the single authority — and lands
+// in the action log, so autopilot runs replay bit-for-bit.
+
+// Apply the boot network (the Godot prototype's demo wiring): 2 parallel wide
+// content<->router pipes (the LAG bundle) + wide legs to every house, one
+// content pipe set to streaming priority. Returns the number of pipes drawn.
+testkit_wire_boot :: proc(state: ^Run_State, tick: u64) -> int {
+	t := &state.topology
+	cat := state.catalogs
+	wide, _ := tier_index(cat, "wide")
+	host: u32 = 0
+	router: u32 = 0
+	houses: [dynamic]u32
+	defer delete(houses)
+	for i in 0 ..< len(t.node_alive) {
+		if !t.node_alive[i] { continue }
+		if t.node_kind[i] == .Junction {
+			router = t.node_id[i]
+		} else if t.node_role[i] == .Content_Host {
+			host = t.node_id[i]
+		} else if t.node_role[i] == .Residential {
+			append(&houses, t.node_id[i])
+		}
+	}
+	drawn := 0
+	submit := proc(state: ^Run_State, cmd: Command, tick: u64) -> bool {
+		// the pinned convention: apply with apply_tick = next tick, both for
+		// the entity spawn ticks and the log record (live == replay)
+		apply_tick := tick + 1
+		nb, res, err := topology_apply_edit(&state.topology, cmd, state.catalogs, state.budget, apply_tick)
+		if err != .None { return false }
+		state.budget = nb
+		logged := cmd
+		logged.apply_tick = apply_tick
+		append(&state.action_log, logged)
+		return res.applied
+	}
+	if host != 0 && router != 0 {
+		for _ in 0 ..< 2 {
+			if submit(state, Command{kind = Cmd_Draw_Pipe{a = host, b = router, tier = wide}}, tick) {
+				drawn += 1
+			}
+		}
+	}
+	for h in houses {
+		if router != 0 && submit(state, Command{kind = Cmd_Draw_Pipe{a = router, b = h, tier = wide}}, tick) {
+			drawn += 1
+		}
+	}
+	// streaming priority on the first content<->router pipe (the QoS dial)
+	if host != 0 && router != 0 {
+		pair: [8]u32
+		n := pipes_between(&state.topology, host, router, pair[:])
+		if n > 0 {
+			streaming, _ := class_index(cat, "streaming")
+			submit(state, Command{kind = Cmd_Set_Pipe_Priority{pipe = pair[0], priority = i32(streaming)}}, tick)
+		}
+	}
+	return drawn
+}
+
+// Wire newly spawned nodes (growth): routers mesh to the nearest junction with
+// free ports (wide), houses to the nearest junction (standard, wide on span
+// rejection). Call once per tick after step. Tracks wired nodes in `wired`
+// (caller-owned scratch map).
+testkit_autowire :: proc(state: ^Run_State, tick: u64, wired: ^map[u32]bool) {
+	t := &state.topology
+	cat := state.catalogs
+	wide, _ := tier_index(cat, "wide")
+	standard, _ := tier_index(cat, "standard")
+
+	submit := proc(state: ^Run_State, a, b: u32, tier: u16, tick: u64) -> bool {
+		apply_tick := tick + 1 // the pinned convention, for the apply AND the log
+		cmd := Command{kind = Cmd_Draw_Pipe{a = a, b = b, tier = tier}}
+		nb, _, err := topology_apply_edit(&state.topology, cmd, state.catalogs, state.budget, apply_tick)
+		if err != .None { return false }
+		state.budget = nb
+		logged := cmd
+		logged.apply_tick = apply_tick
+		append(&state.action_log, logged)
+		return true
+	}
+
+	// junctions first (mesh before houses), then houses
+	for pass in 0 ..< 2 {
+		for i in 0 ..< len(t.node_alive) {
+			if !t.node_alive[i] { continue }
+			id := t.node_id[i]
+			if wired[id] { continue }
+			is_j := t.node_kind[i] == .Junction
+			if pass == 0 && !is_j { continue }
+			if pass == 1 && (is_j || t.node_role[i] != .Residential) { continue }
+			// candidate hubs: live junctions with a free port, nearest first
+			// (insertion-order scan is deterministic; distances break ties by id)
+			best: u32 = 0
+			best_d: i64 = 1 << 62
+			for j in 0 ..< len(t.node_alive) {
+				if !t.node_alive[j] || j == i { continue }
+				if t.node_kind[j] != .Junction { continue }
+				if !ports_available(t, u32(j)) { continue }
+				d := dist2(t.node_pos[i], t.node_pos[j])
+				if d < best_d || (d == best_d && t.node_id[j] < best) {
+					best_d = d
+					best = t.node_id[j]
+				}
+			}
+			if best == 0 { continue }
+			tiers := [2]u16{wide, wide}
+			if !is_j { tiers = {standard, wide} }
+			for tier in tiers {
+				if submit(state, id, best, tier, tick) {
+					wired[id] = true
+					break
+				}
+			}
+		}
+	}
+}
diff --git a/core/testutil_test.odin b/core/testutil_test.odin
new file mode 100644
index 0000000..332e7c2
--- /dev/null
+++ b/core/testutil_test.odin
@@ -0,0 +1,19 @@
+package core
+
+// testutil_test.odin — fatal-style assertions over core:testing (expectf +
+// fail_now), so contract tests read as asserts.
+
+import "core:testing"
+
+tfail :: proc(t: ^testing.T, msg: string) -> ! {
+	testing.fail_now(t, msg)
+}
+
+tfailf :: proc(t: ^testing.T, format: string, args: ..any) -> ! {
+	testing.expectf(t, false, format, ..args)
+	testing.fail_now(t)
+}
+
+tlogf :: proc(t: ^testing.T, format: string, args: ..any) {
+	testing.expectf(t, true, format, ..args) // log via the passing-expectation channel
+}
diff --git a/core/topology.odin b/core/topology.odin
new file mode 100644
index 0000000..8495584
--- /dev/null
+++ b/core/topology.odin
@@ -0,0 +1,404 @@
+package core
+
+import "core:slice"
+
+// topology.odin — S1 Topology Graph (ODN-1, architecture §6.1). The
+// authoritative network model: terminal nodes (residential / content host) and
+// junction nodes (routers: merge/split/repeater + port limits), and pipes
+// (tier / span / lane weights / priority). Owns adjacency and edit
+// application; does not route (flow.odin) or read input (Command_Bus).
+//
+// Data layout: parallel arrays indexed by slot (insertion-ordered — core
+// iterates ARRAYS only, ODN-10); maps are lookup-only, never iterated. Ids are
+// monotonic per run, never recycled (E11): a demolished entity's id is never
+// reused; slots are tombstoned, not compacted, so live ids stay stable.
+//
+// The 'play the internet' rule (E26, art amendment A6): terminals connect via
+// routers only — never terminal-to-terminal.
+
+Topology :: struct {
+	// nodes (parallel arrays; index = slot; tombstones keep ids stable)
+	node_alive:      [dynamic]bool,
+	node_id:         [dynamic]u32,
+	node_type:       [dynamic]u16, // node_types catalog index
+	node_kind:       [dynamic]Node_Kind,
+	node_role:       [dynamic]Terminal_Role,
+	node_pos:        [dynamic][2]i32, // integer tile grid (ODN-10)
+	node_throughput: [dynamic]i32,
+	node_ports:      [dynamic]i32,      // port capacity; 0 = unlimited (terminals)
+	node_lb_weighted:[dynamic]bool,
+	node_triage:     [dynamic]i32,      // class index, -1 = neutral
+	node_spawn_tick: [dynamic]u64,
+	node_by_id:      map[u32]u32,       // id -> slot (lookup only)
+	next_node_id:    u32,
+
+	// pipes (parallel arrays; index = slot)
+	pipe_alive:    [dynamic]bool,
+	pipe_id:       [dynamic]u32,
+	pipe_a:        [dynamic]u32, // node ids
+	pipe_b:        [dynamic]u32,
+	pipe_tier:     [dynamic]u16,
+	pipe_capacity: [dynamic]i32,  // cached from the tier at draw/upgrade (hot loop)
+	pipe_span:     [dynamic]i32,  // integer Euclidean (rounded) — span/cost/snap metric
+	pipe_weights:  [dynamic][3]i32,
+	pipe_priority: [dynamic]i32,  // class index, -1 = neutral (the QoS dial)
+	pipe_spawn_tick: [dynamic]u64,
+	pipe_by_id:    map[u32]u32,
+	next_pipe_id:  u32,
+}
+
+node_count :: proc(t: ^Topology) -> int {
+	n := 0
+	for alive in t.node_alive { if alive { n += 1 } }
+	return n
+}
+
+pipe_count :: proc(t: ^Topology) -> int {
+	n := 0
+	for alive in t.pipe_alive { if alive { n += 1 } }
+	return n
+}
+
+node_slot :: proc(t: ^Topology, id: u32) -> (u32, bool) {
+	s, ok := t.node_by_id[id]
+	return s, ok && t.node_alive[s]
+}
+
+pipe_slot :: proc(t: ^Topology, id: u32) -> (u32, bool) {
+	s, ok := t.pipe_by_id[id]
+	return s, ok && t.pipe_alive[s]
+}
+
+// Integer Euclidean span, rounded (span/cost/snap metric — pinned). A single
+// correctly-rounded isqrt-free computation: we avoid sqrt entirely by
+// comparing squares where possible; where a length is needed (cost), use the
+// integer Newton isqrt — deterministic on every target (ODN-10).
+isqrt :: proc(x: i64) -> i64 {
+	if x <= 0 { return 0 }
+	r := x
+	y := (r + 1) / 2
+	for y < r {
+		r = y
+		y = (r + x / r) / 2
+	}
+	return r
+}
+
+// Rounded Euclidean distance between two grid points (matches the proven-fun
+// reference's round(sqrt(dx^2+dy^2)), computed integer-only).
+span_between :: proc(a, b: [2]i32) -> i32 {
+	dx := i64(abs(a[0] - b[0]))
+	dy := i64(abs(a[1] - b[1]))
+	d2 := dx*dx + dy*dy
+	r := isqrt(d2)
+	// round half up: isqrt floors; bump when d2 - r*r > r (i.e. frac >= .5)
+	if d2 - r*r > r { r += 1 }
+	return i32(r)
+}
+
+dist2 :: proc(a, b: [2]i32) -> i64 {
+	dx := i64(a[0] - b[0])
+	dy := i64(a[1] - b[1])
+	return dx*dx + dy*dy
+}
+
+spawn_node :: proc(t: ^Topology, type_idx: u16, pos: [2]i32, tick: u64, cat: ^Catalogs) -> u32 {
+	nt := cat.node_types[type_idx]
+	slot := u32(len(t.node_alive))
+	id := t.next_node_id
+	t.next_node_id += 1
+	append(&t.node_alive, true)
+	append(&t.node_id, id)
+	append(&t.node_type, type_idx)
+	append(&t.node_kind, nt.kind)
+	append(&t.node_role, nt.terminal_role)
+	append(&t.node_pos, pos)
+	append(&t.node_throughput, nt.throughput_units)
+	append(&t.node_ports, nt.port_capacity)
+	append(&t.node_lb_weighted, nt.lb_mode_capable)
+	append(&t.node_triage, -1)
+	append(&t.node_spawn_tick, tick)
+	t.node_by_id[id] = slot
+	return id
+}
+
+is_terminal :: proc(t: ^Topology, slot: u32) -> bool {
+	return t.node_kind[slot] == .Terminal
+}
+
+// Pipes incident to a node — a port is consumed per CONNECTED PIPE, so
+// parallel pipes each take a port (canon #14).
+incident_pipe_count :: proc(t: ^Topology, node_id: u32) -> int {
+	n := 0
+	for i in 0 ..< len(t.pipe_alive) {
+		if !t.pipe_alive[i] { continue }
+		if t.pipe_a[i] == node_id || t.pipe_b[i] == node_id { n += 1 }
+	}
+	return n
+}
+
+ports_available :: proc(t: ^Topology, node_slot_idx: u32) -> bool {
+	cap := t.node_ports[node_slot_idx]
+	if cap <= 0 { return true }
+	return incident_pipe_count(t, t.node_id[node_slot_idx]) < int(cap)
+}
+
+// All live pipes between a node pair, in pipe-id (insertion) order.
+// `out` is caller scratch (slice into it); deterministic.
+pipes_between :: proc(t: ^Topology, a, b: u32, out: []u32) -> int {
+	n := 0
+	for i in 0 ..< len(t.pipe_alive) {
+		if !t.pipe_alive[i] { continue }
+		pa, pb := t.pipe_a[i], t.pipe_b[i]
+		if (pa == a && pb == b) || (pa == b && pb == a) {
+			if n < len(out) { out[n] = t.pipe_id[i] }
+			n += 1
+		}
+	}
+	return n
+}
+
+// Neighbors of a node (insertion order = pipe insertion order).
+neighbors :: proc(t: ^Topology, node_id: u32, out: []u32) -> int {
+	n := 0
+	for i in 0 ..< len(t.pipe_alive) {
+		if !t.pipe_alive[i] { continue }
+		other: u32 = 0
+		if t.pipe_a[i] == node_id { other = t.pipe_b[i] } else if t.pipe_b[i] == node_id { other = t.pipe_a[i] } else { continue }
+		seen := false
+		for j in 0 ..< n { if out[j] == other { seen = true; break } }
+		if !seen && n < len(out) { out[n] = other; n += 1 }
+	}
+	return n
+}
+
+draw_cost :: proc(span_tiles, cost_per_tile: i32) -> i32 {
+	return span_tiles * cost_per_tile
+}
+
+// --- validation (the single authority; the Command_Bus merely previews it) ---
+
+validate_command :: proc(t: ^Topology, cmd: Command, cat: ^Catalogs, budget: i32) -> Edit_Error {
+	switch c in cmd.kind {
+	case Cmd_Draw_Pipe:
+		if c.a == c.b { return .Self_Loop }
+		sa, oka := node_slot(t, c.a)
+		sb, okb := node_slot(t, c.b)
+		if !oka || !okb { return .Missing_Node }
+		if is_terminal(t, sa) && is_terminal(t, sb) { return .Terminal_To_Terminal } // E26
+		if int(c.tier) >= len(cat.pipe_tiers) { return .Unknown_Tier }
+		if !ports_available(t, sa) || !ports_available(t, sb) { return .Router_Ports_Full }
+		tier := cat.pipe_tiers[c.tier]
+		span := span_between(t.node_pos[sa], t.node_pos[sb])
+		if span > tier.max_span { return .Span_Exceeds_Tier }
+		if draw_cost(span, tier.cost_per_tile) > budget { return .Over_Budget }
+		return .None
+	case Cmd_Upgrade_Pipe:
+		ps, ok := pipe_slot(t, c.pipe)
+		if !ok { return .Missing_Pipe }
+		if int(c.to_tier) >= len(cat.pipe_tiers) { return .Unknown_Tier }
+		tier := cat.pipe_tiers[c.to_tier]
+		// An upgrade may not produce an over-span pipe (Perkins r1: the Godot
+		// version skipped the span check on upgrades).
+		if t.pipe_span[ps] > tier.max_span { return .Span_Exceeds_Tier }
+		// Charge the tier DELTA at validation exactly as apply charges it
+		// (Perkins r1: Godot validated full price but charged the delta).
+		old := cat.pipe_tiers[t.pipe_tier[ps]]
+		delta := max(0, draw_cost(t.pipe_span[ps], tier.cost_per_tile) - draw_cost(t.pipe_span[ps], old.cost_per_tile))
+		if delta > budget { return .Over_Budget }
+		return .None
+	case Cmd_Demolish:
+		if c.is_node {
+			ns, ok := node_slot(t, c.target)
+			if !ok { return .Missing_Node }
+			if is_terminal(t, ns) { return .Terminal_Demolish } // E2
+			return .None
+		}
+		if _, ok := pipe_slot(t, c.target); !ok { return .Missing_Pipe }
+		return .None
+	case Cmd_Set_Lane_Weights:
+		if _, ok := pipe_slot(t, c.pipe); !ok { return .Missing_Pipe }
+		if c.weights[0] < 0 || c.weights[1] < 0 || c.weights[2] < 0 { return .Negative_Weight }
+		if c.weights[0] > MAX_WEIGHT || c.weights[1] > MAX_WEIGHT || c.weights[2] > MAX_WEIGHT { return .Invalid_Weights }
+		return .None
+	case Cmd_Set_Pipe_Priority:
+		if _, ok := pipe_slot(t, c.pipe); !ok { return .Missing_Pipe }
+		if c.priority >= i32(len(cat.packet_types)) { return .Unknown_Command }
+		return .None
+	case Cmd_Set_Junction_Triage:
+		ns, ok := node_slot(t, c.junction)
+		if !ok { return .Missing_Junction }
+		if !is_terminal(t, ns) && t.node_kind[ns] == .Junction {
+			if c.triage >= i32(len(cat.packet_types)) { return .Invalid_Triage }
+			return .None
+		}
+		return .Not_A_Junction
+	}
+	return .Unknown_Command
+}
+
+// --- apply (assumes validated by validate_command / topology_apply_edit) ------
+// Returns the budget delta (negative = spend, positive = refund) so the caller
+// (Run_State.economy) stays the single owner of the budget.
+
+apply_command :: proc(t: ^Topology, cmd: Command, cat: ^Catalogs, tick: u64) -> (delta: i32, res: Edit_Result) {
+	switch c in cmd.kind {
+	case Cmd_Draw_Pipe:
+		sa := t.node_by_id[c.a]
+		sb := t.node_by_id[c.b]
+		tier := cat.pipe_tiers[c.tier]
+		span := span_between(t.node_pos[sa], t.node_pos[sb])
+		slot := u32(len(t.pipe_alive))
+		id := t.next_pipe_id
+		t.next_pipe_id += 1
+		append(&t.pipe_alive, true)
+		append(&t.pipe_id, id)
+		append(&t.pipe_a, c.a)
+		append(&t.pipe_b, c.b)
+		append(&t.pipe_tier, c.tier)
+		append(&t.pipe_capacity, tier.capacity_units)
+		append(&t.pipe_span, span)
+		append(&t.pipe_weights, cat.balance.default_lane_weights)
+		append(&t.pipe_priority, -1)
+		append(&t.pipe_spawn_tick, tick)
+		t.pipe_by_id[id] = slot
+		return -draw_cost(span, tier.cost_per_tile), {true, id}
+	case Cmd_Upgrade_Pipe:
+		ps := t.pipe_by_id[c.pipe]
+		old := cat.pipe_tiers[t.pipe_tier[ps]]
+		tier := cat.pipe_tiers[c.to_tier]
+		t.pipe_tier[ps] = c.to_tier
+		t.pipe_capacity[ps] = tier.capacity_units
+		delta_cost := max(0, draw_cost(t.pipe_span[ps], tier.cost_per_tile) - draw_cost(t.pipe_span[ps], old.cost_per_tile))
+		return -delta_cost, {true, 0}
+	case Cmd_Demolish:
+		refund: i32 = 0
+		if c.is_node {
+			// Junction demolish (E27): sever ALL incident pipes in pipe-id
+			// order (deterministic), refunding each; then tombstone the node.
+			// (Perkins r1 ghost-pipe fix: collect by INCIDENCE — parallel
+			// pipes to the same neighbor are all severed.)
+			target := c.target
+			victims: [dynamic]u32
+			defer delete(victims)
+			for i in 0 ..< len(t.pipe_alive) {
+				if !t.pipe_alive[i] { continue }
+				if t.pipe_a[i] == target || t.pipe_b[i] == target {
+					victims = append_victim(victims, t.pipe_id[i])
+				}
+			}
+			for pid in victims {
+				refund += remove_pipe(t, pid, cat)
+			}
+			ns := t.node_by_id[target]
+			t.node_alive[ns] = false
+			// the id->slot entry SURVIVES the tombstone (E11 monotonic ids;
+			// the severance anchor walk in flow reads endpoint data of dead
+			// pipes); liveness is guarded by node_alive everywhere
+			return refund, {true, 0}
+		}
+		refund = remove_pipe(t, c.target, cat)
+		return refund, {true, 0}
+	case Cmd_Set_Lane_Weights:
+		ps := t.pipe_by_id[c.pipe]
+		w := c.weights
+		if w[0] + w[1] + w[2] == 0 { w = cat.balance.default_lane_weights } // E5
+		t.pipe_weights[ps] = w
+		return 0, {true, 0}
+	case Cmd_Set_Pipe_Priority:
+		ps := t.pipe_by_id[c.pipe]
+		t.pipe_priority[ps] = c.priority
+		return 0, {true, 0}
+	case Cmd_Set_Junction_Triage:
+		ns := t.node_by_id[c.junction]
+		t.node_triage[ns] = c.triage
+		return 0, {true, 0}
+	}
+	return 0, {false, 0}
+}
+
+append_victim :: proc(v: [dynamic]u32, id: u32) -> [dynamic]u32 {
+	// keep pipe-id (insertion) order: victims are collected by array scan,
+	// which is already id-ordered; append preserves it.
+	vv := v
+	append(&vv, id)
+	return vv
+}
+
+// Remove one pipe; returns the refund (full draw cost — redesign is the game,
+// GDD Player Assistance; no punishment for tearing up a bad route).
+remove_pipe :: proc(t: ^Topology, id: u32, cat: ^Catalogs) -> i32 {
+	ps, ok := pipe_slot(t, id)
+	if !ok { return 0 }
+	tier := cat.pipe_tiers[t.pipe_tier[ps]]
+	refund := draw_cost(t.pipe_span[ps], tier.cost_per_tile)
+	t.pipe_alive[ps] = false
+	// id->slot entry survives (see demolish note)
+	return refund
+}
+
+// Validate-all-then-apply (E23): a rejected batch mutates NOTHING. Each
+// command validates against the state the PRIOR batch commands produce (a
+// speculative clone — batch sizes are tiny), so intra-batch dependencies
+// (demolish-then-redraw) validate truthfully, and the budget is checked as a
+// RUNNING total (a batch can never drive it negative).
+topology_apply_all :: proc(t: ^Topology, cmds: []Command, cat: ^Catalogs, budget: i32, tick: u64, scratch := context.temp_allocator) -> (new_budget: i32, err: Edit_Error) {
+	if len(cmds) == 0 { return budget, .None }
+	shadow := topology_clone(t, scratch)
+	b := budget
+	for cmd in cmds {
+		if e := validate_command(&shadow, cmd, cat, b); e != .None { return budget, e }
+		delta, _ := apply_command(&shadow, cmd, cat, tick)
+		b += delta
+	}
+	for cmd in cmds {
+		apply_command(t, cmd, cat, tick)
+	}
+	return b, .None
+}
+
+topology_clone :: proc(t: ^Topology, allocator := context.temp_allocator) -> Topology {
+	c: Topology
+	c.node_alive = slice.clone_to_dynamic(t.node_alive[:], allocator)
+	c.node_id = slice.clone_to_dynamic(t.node_id[:], allocator)
+	c.node_type = slice.clone_to_dynamic(t.node_type[:], allocator)
+	c.node_kind = slice.clone_to_dynamic(t.node_kind[:], allocator)
+	c.node_role = slice.clone_to_dynamic(t.node_role[:], allocator)
+	c.node_pos = slice.clone_to_dynamic(t.node_pos[:], allocator)
+	c.node_throughput = slice.clone_to_dynamic(t.node_throughput[:], allocator)
+	c.node_ports = slice.clone_to_dynamic(t.node_ports[:], allocator)
+	c.node_lb_weighted = slice.clone_to_dynamic(t.node_lb_weighted[:], allocator)
+	c.node_triage = slice.clone_to_dynamic(t.node_triage[:], allocator)
+	c.node_spawn_tick = slice.clone_to_dynamic(t.node_spawn_tick[:], allocator)
+	c.next_node_id = t.next_node_id
+	// rebuild the lookup maps from the arrays (array iteration only, ODN-10) —
+	// a shared map would take the speculative inserts
+	c.node_by_id = make(map[u32]u32, allocator)
+	for i in 0 ..< len(t.node_alive) {
+		c.node_by_id[t.node_id[i]] = u32(i)
+	}
+	c.pipe_alive = slice.clone_to_dynamic(t.pipe_alive[:], allocator)
+	c.pipe_id = slice.clone_to_dynamic(t.pipe_id[:], allocator)
+	c.pipe_a = slice.clone_to_dynamic(t.pipe_a[:], allocator)
+	c.pipe_b = slice.clone_to_dynamic(t.pipe_b[:], allocator)
+	c.pipe_tier = slice.clone_to_dynamic(t.pipe_tier[:], allocator)
+	c.pipe_capacity = slice.clone_to_dynamic(t.pipe_capacity[:], allocator)
+	c.pipe_span = slice.clone_to_dynamic(t.pipe_span[:], allocator)
+	c.pipe_weights = slice.clone_to_dynamic(t.pipe_weights[:], allocator)
+	c.pipe_priority = slice.clone_to_dynamic(t.pipe_priority[:], allocator)
+	c.pipe_spawn_tick = slice.clone_to_dynamic(t.pipe_spawn_tick[:], allocator)
+	c.next_pipe_id = t.next_pipe_id
+	c.pipe_by_id = make(map[u32]u32, allocator)
+	for i in 0 ..< len(t.pipe_alive) {
+		c.pipe_by_id[t.pipe_id[i]] = u32(i)
+	}
+	return c
+}
+
+topology_apply_edit :: proc(t: ^Topology, cmd: Command, cat: ^Catalogs, budget: i32, tick: u64) -> (i32, Edit_Result, Edit_Error) {
+	if e := validate_command(t, cmd, cat, budget); e != .None {
+		return budget, {}, e
+	}
+	delta, res := apply_command(t, cmd, cat, tick)
+	return budget + delta, res, .None
+}
diff --git a/core/topology_test.odin b/core/topology_test.odin
new file mode 100644
index 0000000..a8a06a2
--- /dev/null
+++ b/core/topology_test.odin
@@ -0,0 +1,271 @@
+package core
+
+// topology_test.odin — the edit contracts (§6.1, E1/E2/E3/E26/E27 + canon
+// #14 port limits + the Perkins r1 fixes: ghost-pipe demolish, upgrade delta
+// pricing, upgrade span check).
+
+import "core:testing"
+
+test_boot_state :: proc(t: ^testing.T) -> ^Run_State {
+	cat, err := must_catalogs()
+	if err.file != "" { tfailf(t, "catalogs: %s %s %s", err.file, err.field, err.rule) }
+	state := new(Run_State)
+	run_init(state, 1337, cat, context.allocator)
+	return state
+}
+
+node_id_by_role :: proc(state: ^Run_State, role: Terminal_Role, n: int) -> u32 {
+	count := 0
+	tp := &state.topology
+	for i in 0 ..< len(tp.node_alive) {
+		if tp.node_alive[i] && tp.node_role[i] == role {
+			if count == n { return tp.node_id[i] }
+			count += 1
+		}
+	}
+	return 0
+}
+
+first_junction :: proc(state: ^Run_State) -> u32 {
+	tp := &state.topology
+	for i in 0 ..< len(tp.node_alive) {
+		if tp.node_alive[i] && tp.node_kind[i] == .Junction { return tp.node_id[i] }
+	}
+	return 0
+}
+
+@(test)
+test_draw_rejects_terminal_to_terminal :: proc(t: ^testing.T) {
+	state := test_boot_state(t)
+	h1 := node_id_by_role(state, .Residential, 0)
+	h2 := node_id_by_role(state, .Residential, 1)
+	standard, _ := tier_index(state.catalogs, "standard")
+	cmd := Command{kind = Cmd_Draw_Pipe{a = h1, b = h2, tier = standard}}
+	if e := validate_command(&state.topology, cmd, state.catalogs, state.budget); e != .Terminal_To_Terminal {
+		tfailf(t, "E26: got %v, want Terminal_To_Terminal", e)
+	}
+}
+
+@(test)
+test_draw_rejects_self_loop_and_span :: proc(t: ^testing.T) {
+	state := test_boot_state(t)
+	h1 := node_id_by_role(state, .Residential, 0)
+	router := first_junction(state)
+	standard, _ := tier_index(state.catalogs, "standard")
+	narrow, _ := tier_index(state.catalogs, "narrow")
+	if e := validate_command(&state.topology, Command{kind = Cmd_Draw_Pipe{a = h1, b = h1, tier = standard}},
+		state.catalogs, state.budget); e != .Self_Loop {
+		tfailf(t, "E3: got %v", e)
+	}
+	// house(8,5) to router(18,14): span = round(sqrt(100+81)) = 13 > narrow max 10
+	if e := validate_command(&state.topology, Command{kind = Cmd_Draw_Pipe{a = h1, b = router, tier = narrow}},
+		state.catalogs, state.budget); e != .Span_Exceeds_Tier {
+		tfailf(t, "span: got %v, want Span_Exceeds_Tier", e)
+	}
+}
+
+@(test)
+test_span_metric :: proc(t: ^testing.T) {
+	// rounded Euclidean, integer-only (the pinned metric)
+	if got := span_between({8, 5}, {18, 14}); got != 13 { tfailf(t, "span 13? got %d", got) }
+	if got := span_between({0, 0}, {3, 4}); got != 5 { tfailf(t, "3-4-5: got %d", got) }
+	if got := span_between({0, 0}, {0, 0}); got != 0 { tfailf(t, "zero: got %d", got) }
+	if got := span_between({30, 14}, {18, 14}); got != 12 { tfailf(t, "straight: got %d", got) }
+}
+
+@(test)
+test_port_limits :: proc(t: ^testing.T) {
+	// canon #14: a basic router has 4 ports — one per connected pipe.
+	state := test_boot_state(t)
+	cat := state.catalogs
+	basic, _ := tier_index(cat, "standard")
+	_ = basic
+	// spawn a basic router + 5 houses in span
+	rt, _ := node_type_index(cat, "router_basic")
+	res, _ := node_type_index(cat, "residential")
+	rid := spawn_node(&state.topology, rt, {20, 20}, 0, cat)
+	std, _ := tier_index(cat, "standard")
+	wide, _ := tier_index(cat, "wide")
+	_ = std
+	drew := 0
+	for i in 0 ..< 5 {
+		hid := spawn_node(&state.topology, res, {16 + i32(i) * 2, 25}, 0, cat)
+		cmd := Command{kind = Cmd_Draw_Pipe{a = rid, b = hid, tier = wide}}
+		err := validate_command(&state.topology, cmd, cat, 99999)
+		if i < 4 {
+			if err != .None { tfailf(t, "pipe %d should validate, got %v", i, err) }
+			nb, _, _ := topology_apply_edit(&state.topology, cmd, cat, 99999, 0)
+			state.budget = nb
+			drew += 1
+		} else {
+			if err != .Router_Ports_Full { tfailf(t, "5th pipe must hit the port cap, got %v", err) }
+		}
+	}
+	if drew != 4 { tfailf(t, "drew %d, want 4", drew) }
+}
+
+@(test)
+test_junction_demolish_severs_ALL_incident_pipes :: proc(t: ^testing.T) {
+	// Perkins r1 ghost-pipe regression: parallel pipes to the same neighbor
+	// must ALL go. E27: atomic batch, pipe-id order, refunds.
+	state := test_boot_state(t)
+	cat := state.catalogs
+	router := first_junction(state)
+	host := node_id_by_role(state, .Content_Host, 0)
+	wide, _ := tier_index(cat, "wide")
+	// two parallel wide pipes host<->router + one leg to a house
+	for _ in 0 ..< 2 {
+		nb, _, err := topology_apply_edit(&state.topology,
+			Command{kind = Cmd_Draw_Pipe{a = host, b = router, tier = wide}}, cat, state.budget, 0)
+		if err != .None { tfailf(t, "draw: %v", err) }
+		state.budget = nb
+	}
+	h1 := node_id_by_role(state, .Residential, 0)
+	nb, _, err := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Draw_Pipe{a = router, b = h1, tier = wide}}, cat, state.budget, 0)
+	if err != .None { tfailf(t, "draw leg: %v", err) }
+	state.budget = nb
+	if pipe_count(&state.topology) != 3 { tfailf(t, "pipes %d, want 3", pipe_count(&state.topology)) }
+	budget_before := state.budget
+
+	nb2, res, err2 := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Demolish{target = router, is_node = true}}, cat, state.budget, 0)
+	if err2 != .None || !res.applied { tfailf(t, "demolish: %v", err2) }
+	state.budget = nb2
+	if pipe_count(&state.topology) != 0 {
+		tfailf(t, "ghost pipes remain: %d", pipe_count(&state.topology))
+	}
+	if _, ok := node_slot(&state.topology, router); ok { tfail(t, "junction must be tombstoned") }
+	if state.budget <= budget_before { tfail(t, "demolish must refund (redesign is the game)") }
+}
+
+@(test)
+test_terminal_demolish_forbidden :: proc(t: ^testing.T) {
+	state := test_boot_state(t)
+	h1 := node_id_by_role(state, .Residential, 0)
+	if e := validate_command(&state.topology, Command{kind = Cmd_Demolish{target = h1, is_node = true}},
+		state.catalogs, state.budget); e != .Terminal_Demolish {
+		tfailf(t, "E2: got %v", e)
+	}
+}
+
+@(test)
+test_upgrade_charges_delta_and_checks_span :: proc(t: ^testing.T) {
+	// Perkins r1: the Godot version validated the FULL new-tier price but
+	// charged the delta; and skipped the span check. Both pinned here.
+	state := test_boot_state(t)
+	cat := state.catalogs
+	router := first_junction(state)
+	h1 := node_id_by_role(state, .Residential, 0) // (8,5); router (18,14) span 13
+	narrow, _ := tier_index(cat, "narrow")
+	standard, _ := tier_index(cat, "standard")
+	wide, _ := tier_index(cat, "wide")
+	// h1->router span 13: narrow (max 10) illegal; standard (max 14) ok
+	nb, res, err := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Draw_Pipe{a = h1, b = router, tier = standard}}, cat, state.budget, 0)
+	if err != .None { tfailf(t, "draw: %v", err) }
+	state.budget = nb
+	pipe := res.pipe
+	// upgrade to wide (max 18) — span 13 ok; cost = delta (30-12)*13 = 234
+	before := state.budget
+	nb2, _, err2 := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Upgrade_Pipe{pipe = pipe, to_tier = wide}}, cat, state.budget, 0)
+	if err2 != .None { tfailf(t, "upgrade: %v", err2) }
+	state.budget = nb2
+	spent := before - state.budget
+	if spent != 234 { tfailf(t, "delta cost: got %d, want 234", spent) }
+	// now place a long pipe and try to DOWNGRADE into over-span:
+	// host(30,14) -> router(18,14) span 12; wide ok, standard max 14 ok too...
+	// use a fresh far pair: spawn a junction at (26,26) -> router span ~14.4->14? use wide first
+	rt, _ := node_type_index(cat, "router_basic")
+	far := spawn_node(&state.topology, rt, {30, 26}, 0, cat)
+	// router(18,14) to (30,26): dx12 dy12 span ~17
+	nb3, res3, err3 := topology_apply_edit(&state.topology,
+		Command{kind = Cmd_Draw_Pipe{a = router, b = far, tier = wide}}, cat, state.budget, 0)
+	if err3 != .None { tfailf(t, "draw wide: %v", err3) }
+	state.budget = nb3
+	if e := validate_command(&state.topology,
+		Command{kind = Cmd_Upgrade_Pipe{pipe = res3.pipe, to_tier = standard}}, cat, state.budget); e != .Span_Exceeds_Tier {
+		tfailf(t, "over-span upgrade must reject: got %v", e)
+	}
+}
+
+@(test)
+test_over_budget_rejection :: proc(t: ^testing.T) {
+	state := test_boot_state(t)
+	cat := state.catalogs
+	router := first_junction(state)
+	host := node_id_by_role(state, .Content_Host, 0)
+	wide, _ := tier_index(cat, "wide")
+	// host->router span 12, wide cost 12*30 = 360; budget 10 -> reject
+	if e := validate_command(&state.topology,
+		Command{kind = Cmd_Draw_Pipe{a = host, b = router, tier = wide}}, cat, 10); e != .Over_Budget {
+		tfailf(t, "got %v, want Over_Budget", e)
+	}
+}
+
+@(test)
+test_batch_validate_all_then_apply :: proc(t: ^testing.T) {
+	// E23: one bad command rejects the WHOLE batch with no partial mutation.
+	state := test_boot_state(t)
+	cat := state.catalogs
+	router := first_junction(state)
+	host := node_id_by_role(state, .Content_Host, 0)
+	h1 := node_id_by_role(state, .Residential, 0)
+	wide, _ := tier_index(cat, "standard")
+	cmds := []Command{
+		{kind = Cmd_Draw_Pipe{a = host, b = router, tier = wide}},
+		{kind = Cmd_Draw_Pipe{a = h1, b = h1, tier = wide}}, // self-loop
+	}
+	pipes_before := pipe_count(&state.topology)
+	budget_before := state.budget
+	_, err := topology_apply_all(&state.topology, cmds, cat, state.budget, 0)
+	if err == .None { tfail(t, "batch must reject") }
+	if pipe_count(&state.topology) != pipes_before { tfail(t, "E23: partial mutation happened") }
+	if state.budget != budget_before { tfail(t, "E23: budget moved") }
+}
+
+@(test)
+test_batch_running_budget_and_intrabatch_deps :: proc(t: ^testing.T) {
+	// E23 hardened: the batch validates against a running budget (never
+	// negative) and each command sees the prior commands' effects.
+	state := test_boot_state(t)
+	cat := state.catalogs
+	router := first_junction(state)
+	host := node_id_by_role(state, .Content_Host, 0)
+	wide, _ := tier_index(cat, "wide")
+	// two wide draws, each 360; budget 500 -> the pair must reject (running total)
+	cmds := []Command{
+		{kind = Cmd_Draw_Pipe{a = host, b = router, tier = wide}},
+		{kind = Cmd_Draw_Pipe{a = host, b = router, tier = wide}},
+	}
+	pipes_before := pipe_count(&state.topology)
+	_, err := topology_apply_all(&state.topology, cmds, cat, 500, 0)
+	if err != .Over_Budget { tfailf(t, "running budget: got %v, want Over_Budget", err) }
+	if pipe_count(&state.topology) != pipes_before { tfail(t, "rejected batch must not partially apply") }
+	// intra-batch dependency: draw then prioritize the new pipe in one batch
+	rt, _ := node_type_index(cat, "router_basic")
+	j2 := spawn_node(&state.topology, rt, {24, 20}, 0, cat)
+	// first, learn the id the draw will get: next_pipe_id
+	new_pipe := state.topology.next_pipe_id
+	batch := []Command{
+		{kind = Cmd_Draw_Pipe{a = j2, b = router, tier = wide}},
+		{kind = Cmd_Set_Pipe_Priority{pipe = new_pipe, priority = 1}},
+	}
+	nb, err2 := topology_apply_all(&state.topology, batch, cat, state.budget, 0)
+	if err2 != .None { tfailf(t, "draw+priority batch: %v", err2) }
+	state.budget = nb
+	ps, ok := pipe_slot(&state.topology, new_pipe)
+	if !ok { tfail(t, "pipe must exist") }
+	if state.topology.pipe_priority[ps] != 1 { tfail(t, "priority must land on the same-batch pipe") }
+	// demolish + redraw in one batch must not corrupt (the hunter's W6 case)
+	junctions := first_junction(state)
+	batch2 := []Command{
+		{kind = Cmd_Demolish{target = junctions, is_node = true}},
+		{kind = Cmd_Draw_Pipe{a = j2, b = junctions, tier = wide}}, // must reject: node gone
+	}
+	pipes_before2 := pipe_count(&state.topology)
+	_, err3 := topology_apply_all(&state.topology, batch2, cat, state.budget, 0)
+	if err3 == .None { tfail(t, "demolish+draw-to-dead-node must reject") }
+	if pipe_count(&state.topology) != pipes_before2 { tfail(t, "rejected batch mutated state") }
+}
