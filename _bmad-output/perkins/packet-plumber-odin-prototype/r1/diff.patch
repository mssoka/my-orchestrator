-## S3 QoS Lane Engine (GDD § M2, ADR-3, FORGE #4 — the differentiator).
-##
-## Per-pipe 3-lane (Express/Standard/Best-effort) bandwidth partition via WFQ
-## weights, + per-node work-conserving serialization. `allocate` is the pure
-## integer partition (largest-remainder, E8; all-zero fallback, E5); `serialize`
-## (Express->Standard->Best gap-fill, no-starvation WRR floor, E7) is fleshed in
-## S3. Stateless over ticks except weights/policies stored on the Topology.
-##
-## Pure RefCounted (ADR-1). Integer math (ADR-10).
-class_name QoSEngine
-extends RefCounted
-
-
-## Partition a pipe's capacity across its 3 lanes by WFQ weights. Largest-
-## remainder method (no bandwidth vanishes to truncation, E8); Express->Standard-
-## >Best tie order. All-zero weights fall back to defaults (E5). Returns a
-## Vector3i (x=Express, y=Standard, z=Best) of per-lane capacity units.
-static func allocate(capacity: int, weights: Vector3i,
-					 default_weights: Vector3i) -> Vector3i:
-	var w: Vector3i = weights
-	var total: int = w.x + w.y + w.z
-	if total == 0:                                   # AC-E5 all-zero fallback
-		w = default_weights
-		total = w.x + w.y + w.z
-	if total <= 0:
-		return Vector3i.ZERO
-	if capacity <= 0:
-		return Vector3i.ZERO
-	# exact numerators = capacity * weight; floor each; remainder distributed by
-	# largest fractional remainder (no bandwidth vanishes, E8), tie Express>Std>Best
-	var numerators: Array[int] = [capacity * w.x, capacity * w.y, capacity * w.z]
-	var caps: Array[int] = [numerators[0] / total, numerators[1] / total, numerators[2] / total]
-	var remainder: int = capacity - (caps[0] + caps[1] + caps[2])
-	if remainder > 0:
-		# order lane indices by (fractional remainder desc, then idx asc for tie)
-		var order: Array[int] = [0, 1, 2]
-		order.sort_custom(func(a: int, b: int) -> bool:
-			var fa: int = numerators[a] % total
-			var fb: int = numerators[b] % total
-			if fa != fb:
-				return fa > fb
-			return a < b)
-		for i: int in remainder:
-			caps[order[i]] += 1
-	return Vector3i(caps[0], caps[1], caps[2])   # caps[0]=Express, [1]=Standard, [2]=Best
-
-
-## Lane-capacity for a single pipe from its current weights + tier capacity.
-static func allocate_pipe(pipe: NetPipe, default_weights: Vector3i) -> Vector3i:
-	return allocate(pipe.capacity_units, pipe.lane_weights, default_weights)
-
-
-## Serialize ready packets at a node by lane (Express -> Standard -> Best), gap-
-## filling so lower priority waits but progresses (no starvation, E7). Full WRR
-## floor + contention drop ladder (E9) fleshed in S3; this is the base orderer.
-static func serialize_by_lane(ready_by_lane: Array) -> Array:
-	# ready_by_lane: Array[Array[Packet]] indexed by CoreConst.Lane (0=Express..)
-	var out: Array = []
-	for lane: int in [CoreConst.Lane.EXPRESS, CoreConst.Lane.STANDARD, CoreConst.Lane.BEST]:
-		var q: Array = ready_by_lane[lane] if lane < ready_by_lane.size() else []
-		out.append_array(q)
-	return out
