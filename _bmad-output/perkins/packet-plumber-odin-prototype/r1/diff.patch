+#!/usr/bin/env bash
+# tools/lint.sh — the §16.3 grep gates (CI-enforced consistency rules).
+#  1. core purity: core/ imports whitelisted core:* only (never vendor:*,
+#     core:os, core:time) — the structural determinism rule (ODN-1).
+#  2. no file-scope mutable state in core (ODN-13: no globals).
+#  3. no map iteration in core (ODN-10: arrays only).
+#  4. no dropped error returns in core (§7.1).
+set -uo pipefail
+cd "$(dirname "$0")/.."
+FAIL=0
+
+echo "-- gate 1: core import purity"
+HITS=$(grep -rn '^import ' core/*.odin | grep -v '_test\.odin' | grep -E 'import "(vendor:[^"]*|core:os|core:time)"' || true)
+if [ -n "$HITS" ]; then echo "$HITS"; echo "FAIL: forbidden import in core/"; FAIL=1; fi
+
+echo "-- gate 2: no file-scope var in core/"
+HITS=$(grep -rnE '^[a-z_][a-z0-9_]*[ ]*:[ ]' core/*.odin | grep -v '_test\.odin' | grep -v '::' || true)
+if [ -n "$HITS" ]; then echo "$HITS"; echo "FAIL: file-scope state in core/"; FAIL=1; fi
+
+echo "-- gate 3: no map iteration in core/"
+HITS=$(grep -rnE 'for .* in .*(map|_by_id|_by_)' core/*.odin | grep -v '_test\.odin' | grep -vE 'for .* in [a-z_]+\.(nodes|pipes|entries)' || true)
+if [ -n "$HITS" ]; then echo "$HITS"; echo "FAIL: possible map iteration in core/"; FAIL=1; fi
+
+echo "-- gate 4: no bare '_' discards of fallible calls in core/"
+HITS=$(grep -rnE '^\s*_ = ' core/*.odin | grep -v '_test\.odin' || true)
+if [ -n "$HITS" ]; then echo "$HITS"; echo "FAIL: dropped return in core/"; FAIL=1; fi
+
+if [ "$FAIL" -ne 0 ]; then exit 1; fi
+echo "lint: all gates green"
