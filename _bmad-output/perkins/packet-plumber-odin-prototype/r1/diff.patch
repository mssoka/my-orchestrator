-	while fname != "":
-		if fname.ends_with(".gd"):
-			var base_type: String = _script_base_type("res://scripts/core/" + fname)
-			# The Core must extend RefCounted (or a Core class_name), NEVER a Node.
-			if base_type != "" and ClassDB.class_exists(base_type) \
-					and ClassDB.is_parent_class(base_type, "Node"):
-				offenders.append("%s (extends %s)" % [fname, base_type])
