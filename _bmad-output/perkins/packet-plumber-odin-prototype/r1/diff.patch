+# .github/workflows/ci.yml — the §16.3 gates (ODN-17: the harness is a
+# release-gated CI citizen). Every job: purity + grep gates, odin test (T1
+# contracts), harness run (T1 hashes + T2 pixels via the software renderer).
+# Matrix: linux + macos (arm64 + amd64 where the runners provide it); goldens
+# are platform-independent because T2 is software-rendered.
+name: ci
+
+on:
+  push:
+  pull_request:
+
+jobs:
+  verify:
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-latest, macos-latest]
+    runs-on: ${{ matrix.os }}
+    steps:
+      - uses: actions/checkout@v4
+
+      # Odin has no apt/brew pin channel for exact nightly pins; build the
+      # pinned toolchain from source (the .odin-version pin moves only
+      # deliberately — see project-context.md).
+      - name: Build Odin (pinned)
+        run: |
+          set -e
+          PIN="$(cat .odin-version)"
+          git clone --depth 1 --branch "$PIN" https://github.com/odin-lang/Odin.git "$RUNNER_TEMP/odin-src"
+          cd "$RUNNER_TEMP/odin-src"
+          make -j4 release 2>/dev/null || make -j4
+          echo "$RUNNER_TEMP/odin-src" >> "$GITHUB_PATH"
+          odin version
+
+      - name: Purity + grep gates
+        run: |
+          odin build core -build-mode:obj -out:"$RUNNER_TEMP/core.obj"
+          tools/lint.sh
+
+      - name: Core unit tests (T1 contracts)
+        run: odin test core
+
+      - name: Orchestration-layer tests (driver/snap/bus)
+        run: odin test app/run
+
+      - name: Game builds (the shipped artifact compiles)
+        run: odin build app -out:"$RUNNER_TEMP/packet-plumber"
+
+      - name: Golden harness (T1 hashes + T2 software pixels + replay gate)
+        run: tools/harness.sh run
+
+      - name: Upload diff bundles on failure
+        if: failure()
+        uses: actions/upload-artifact@v4
+        with:
+          name: golden-reports-${{ matrix.os }}
+          path: goldens/_reports/
+          if-no-files-found: ignore
