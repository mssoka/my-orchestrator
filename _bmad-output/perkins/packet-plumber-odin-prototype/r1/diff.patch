@@ -0,0 +1,17 @@
+# draw_and_reject.dem — the edit contract, exercised through the real bus:
+# valid draws land; every rejection class returns its typed error (E3/E26 +
+# span + ports + budget). Terminal-terminal is the 'play the internet' rule.
+seed 42
+map demo_six_nodes
+at 100ms draw_pipe router house_a standard -> ok
+at 200ms draw_pipe router house_b standard -> ok
+at 300ms draw_pipe house_c house_d standard -> terminal_to_terminal
+at 400ms draw_pipe house_a house_a standard -> self_loop
+at 500ms draw_pipe host router narrow -> span_exceeds_tier
+at 600ms draw_pipe host router wide -> ok
+at 700ms draw_pipe router house_c standard -> ok
+at 800ms draw_pipe router house_d standard -> ok
+at 900ms draw_pipe host router wide -> ok
+run 3000ms
+capture at 1200ms, 2500ms
+expect hash stable
