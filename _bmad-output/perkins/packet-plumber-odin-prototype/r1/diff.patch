+++ b/app/audio.odin
@@ -0,0 +1,74 @@
+package main
+
+// audio.odin — the 1-2 juice stings (user ruling 2026-08-08; ODN-15 keeps
+// them on the cosmetic stream). PROTO synthesizes its stings in code (PCM ->
+// WAV in memory): owned audio, zero assets, and nothing to license — the Suno
+// pipeline slots in later without a wiring change.
+
+import rl "vendor:raylib"
+
+init_audio :: proc(app: ^App) -> bool {
+	rl.InitAudioDevice()
+	if !rl.IsAudioDeviceReady() { return false }
+	app.sting_crisis = synth_sting({660, 415}, 0.16, true)
+	app.sting_win = synth_sting({523, 659, 784, 1046}, 0.09, false)
+	return true
+}
+
+// A tiny two/four-tone synth -> PCM16 WAV bytes -> rl.Sound.
+synth_sting :: proc(freqs: []f32, note_seconds: f32, descending_alarm: bool) -> rl.Sound {
+	rate :: 22050
+	per := int(f32(rate) * note_seconds)
+	total := per * len(freqs)
+	samples := make([]i16, total)
+	amp :: 8000
+	for i in 0 ..< total {
+		f := freqs[i / per]
+		phase := f32(i % rate) / f32(rate)
+		// sine approximation via the pinned 16-gon table would be coarse at
+		// audio rates; a triangle wave is clean, buzzy enough for a sting, and
+		// needs no libm
+		cyc := phase * f
+		frac := cyc - f32(int(cyc))
+		tri: f32
+		if frac < 0.5 {
+			tri = 4*frac - 1
+		} else {
+			tri = 3 - 4*frac
+		}
+		// simple decay envelope per note
+		note_pos := f32(i % per) / f32(per)
+		env := 1 - note_pos*note_pos
+		samples[i] = i16(f32(amp) * tri * env * 0.5)
+	}
+	// hand-roll a minimal PCM16 mono WAV
+	data_size := u32(total * 2)
+	buf: [dynamic]u8
+	append_u32 :: proc(b: ^[dynamic]u8, v: u32) {
+		append(b, u8(v), u8(v >> 8), u8(v >> 16), u8(v >> 24))
+	}
+	append_u16 :: proc(b: ^[dynamic]u8, v: u16) {
+		append(b, u8(v), u8(v >> 8))
+	}
+	append(&buf, 'R', 'I', 'F', 'F')
+	append_u32(&buf, 36 + data_size)
+	append(&buf, 'W', 'A', 'V', 'E', 'f', 'm', 't', ' ')
+	append_u32(&buf, 16)
+	append_u16(&buf, 1) // PCM
+	append_u16(&buf, 1) // mono
+	append_u32(&buf, rate)
+	append_u32(&buf, rate * 2)
+	append_u16(&buf, 2)
+	append_u16(&buf, 16)
+	append(&buf, 'd', 'a', 't', 'a')
+	append_u32(&buf, data_size)
+	for s in samples {
+		append_u16(&buf, u16(s))
+	}
+	wave := rl.LoadWaveFromMemory(".wav", raw_data(buf), i32(len(buf)))
+	snd := rl.LoadSoundFromWave(wave)
+	rl.UnloadWave(wave)
+	delete(samples)
+	delete(buf)
+	return snd
+}
