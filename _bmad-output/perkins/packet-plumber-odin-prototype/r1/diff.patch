-func _test_no_global_rng_in_core() -> void:
-	_start("core: no global RNG (ADR-9)")
-	var dir := DirAccess.open("res://scripts/core")
-	if dir == null:
-		fail("cannot open res://scripts/core")
-		return
-	var offenders: Array[String] = []
-	# Global RNG calls are FORBIDDEN in the Core (ADR-9). The legit seeded form is
-	# `rng.randi()` (a method on the passed RandomNumberGenerator), which contains
-	# the substring `randi()` — so we only flag a call whose token is NOT preceded
-	# by a `.` (i.e. the bare global). `.pick_random()` is ALWAYS forbidden.
-	var banned_global: Array[String] = ["randi()", "randf()", "randf_range(",
-		"randi_range(", "rand_from_seed("]
-	dir.list_dir_begin()
-	var fname: String = dir.get_next()
-	while fname != "":
-		if fname.ends_with(".gd"):
-			var path: String = "res://scripts/core/" + fname
-			var f := FileAccess.open(path, FileAccess.READ)
-			if f != null:
-				var text := f.get_as_text()
-				f.close()
-				for line: String in text.split("\n"):
-					var trimmed: String = line.strip_edges()
-					if trimmed.begins_with("#"):
-						continue
-					if line.contains(".pick_random()"):
-						offenders.append("%s: pick_random" % fname)
-						continue
-					for ban: String in banned_global:
-						var idx: int = line.find(ban)
-						while idx >= 0:
-							var prev: String = " " if idx == 0 else line.substr(idx - 1, 1)
-							if prev != ".":
-								offenders.append("%s: %s" % [fname, ban])
-								break
-							idx = line.find(ban, idx + 1)
-		fname = dir.get_next()
-	dir.list_dir_end()
-	if offenders.is_empty():
-		pass_()
-	else:
-		fail("global-RNG usage in core: " + ", ".join(offenders))
