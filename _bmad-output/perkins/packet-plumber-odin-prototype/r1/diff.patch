-## S5 NetworkHealth — the loss meter (GDD § Win/Loss, FR12, ADR).
-##
-## Drains while overall SLA uptime is below the win threshold (after a grace
-## countdown), recharges when healthy; meter empty -> Error 404 (run lost). drain
-## is severity-proportional + capped -> always recoverable (AC-E16); run_lost
-## supersedes grace_expired (AC-E17). Win = hold surge-window uptime >= threshold
-## through the surge (the MVP win condition, FR12).
-##
-## Pure RefCounted (ADR-1); deterministic (no rng — a pure function of state).
-class_name NetworkHealth
-extends RefCounted
-
-var meter_pct: int = 100
-var grace_ticks_left: int = 0
-var won: bool = false
-var lost: bool = false
-var balance: BalanceData = null
-
-# surge-window accumulators (for the win condition)
-var surge_delivered: int = 0
-var surge_dropped: int = 0
-var _prev_in_surge: bool = false
-
-
-func _init(p_balance: BalanceData = null) -> void:
-	balance = p_balance
-	if balance != null:
-		meter_pct = balance.meter_start_pct
-		grace_ticks_left = balance.grace_window_ticks
-
-
-## Update from the tick's flow report + plan. AC-E16 (drain = max severity + cap),
-## AC-E17 (run_lost supersedes). Win on surge-end if surge-window uptime >= threshold.
-func update(tick: int, report: FlowReport, plan: PressurePlan, recent_uptime: int) -> void:
-	if won or lost:
-		return   # terminal — frozen
-	var in_surge: bool = not plan.set_pieces.is_empty()
-
-	# accumulate the surge window (delivered/dropped while the surge is active)
-	if in_surge:
-		surge_delivered += report.delivered
-		surge_dropped += report.dropped
-
-	# breach uses the ROLLING recent uptime (forgives the build phase; reflects
-	# current performance so the meter recharges once the network is built).
-	var breach: bool = recent_uptime >= 0 and recent_uptime < balance.win_uptime_pct
-	if breach:
-		if grace_ticks_left > 0:
-			grace_ticks_left -= 1
-		else:
-			# severity = how far below threshold; drain proportional, capped (AC-E16)
-			var severity: int = balance.win_uptime_pct - recent_uptime
-			var drain: int = clampi(severity / 10, 1, balance.meter_drain_per_tick_max)
-			meter_pct = maxi(0, meter_pct - drain)
-	else:
-		# healthy (or idle): recharge + reset the grace window
-		meter_pct = mini(100, meter_pct + balance.meter_recharge_per_tick)
-		grace_ticks_left = balance.grace_window_ticks
-
-	# win: the surge JUST ended -> check the surge-window uptime (FR12)
-	if _prev_in_surge and not in_surge and not lost:
-		var surge_total: int = surge_delivered + surge_dropped
-		var surge_uptime: int = 100 if surge_total <= 0 else (surge_delivered * 100) / surge_total
-		if surge_uptime >= balance.win_uptime_pct:
-			won = true
-	_prev_in_surge = in_surge
-
-	# lose: meter empty -> run_lost supersedes everything (AC-E17)
-	if meter_pct <= 0 and not won:
-		lost = true
-
-
-func is_terminal() -> bool:
-	return won or lost
-
-
-func reset_window() -> void:
-	surge_delivered = 0
-	surge_dropped = 0
-	_prev_in_surge = false
