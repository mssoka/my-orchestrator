-## Shared constants & enums for the Packet Plumber Simulation Core.
-##
-## Pure GDScript (RefCounted) — NO Godot Node imports (parse-gate enforced,
-## ADR-1). Every value here is a compile-time constant or enum: deterministic
-## and free of any RNG (ADR-9) or float state-affecting math (ADR-10).
-class_name CoreConst
-extends RefCounted
-
-# --- Lanes (ADR-3: 3 DiffServ lanes per pipe) ---------------------------------
-# Order matters for the drop ladder (E9: Best -> Standard -> Express) and for
-# the serialization order (Express -> Standard -> Best). Index into the
-# Vector3i lane_weights: x=Express, y=Standard, z=Best.
-enum Lane { EXPRESS = 0, STANDARD = 1, BEST = 2 }
-
-# Lane count is a fixed game constant (not tunable balance).
-const LANE_COUNT: int = 3
-
-# Default lane weights (Standard-heavy: all traffic STARTS on Standard per the
-# game-wide decision, sprint-plan §8 #7). A pipe with all-zero weights falls
-# back to this (AC-E5). Vector3i: x=Express, y=Standard, z=Best.
-const DEFAULT_LANE_WEIGHTS: Vector3i = Vector3i(1, 4, 1)
-
-# --- Node kinds (GDD § M3) ----------------------------------------------------
-enum NodeKind { TERMINAL = 0, JUNCTION = 1 }
-
-# Terminal roles (typed demand selectors, sprint-plan §3.1). StringName keys are
-# used in catalogs and DemandSpec selectors so new roles are pure data.
-enum TerminalRole { RESIDENTIAL = 0, CONTENT_HOST = 1, FINANCIAL_HUB = 2, DATA_CENTER = 3 }
-
-# Role name <-> enum (demand selectors use StringName names; nodes store the int).
-static func role_name(role: int) -> StringName:
-	match role:
-		TerminalRole.RESIDENTIAL: return &"residential"
-		TerminalRole.CONTENT_HOST: return &"content_host"
-		TerminalRole.FINANCIAL_HUB: return &"financial_hub"
-		TerminalRole.DATA_CENTER: return &"data_center"
-	return &""
-
-static func role_from_name(name: StringName) -> int:
-	if name == &"residential": return TerminalRole.RESIDENTIAL
-	if name == &"content_host": return TerminalRole.CONTENT_HOST
-	if name == &"financial_hub": return TerminalRole.FINANCIAL_HUB
-	if name == &"data_center": return TerminalRole.DATA_CENTER
-	return -1
-
-# --- Health states (the warning surface, GDD § M5) ----------------------------
-enum HealthState { HEALTHY = 0, STRAINED = 1, CRITICAL = 2 }
-
-# --- Selection-rule modes (sprint-plan §3.3) ----------------------------------
-enum SelectionMode { WEIGHTED_RANDOM = 0, ROUND_ROBIN = 1, NEAREST_HOPS = 2 }
-
-# --- Logic tick (ADR-2) -------------------------------------------------------
-# Fixed logic rate (20 Hz -> 50 ms/tick). Tunable via the Balance catalog at
-# load time; this is the fallback default before catalogs load.
-const DEFAULT_LOGIC_HZ: int = 20
-
-# Clamp wall-clock deltas to avoid the spiral-of-death ([FinLT] trap:
-# frame-delta accumulators MUST be float and clamped).
-const MAX_FRAME_DELTA: float = 0.25
-
-# --- Snap (draw) precision (FR1, AC-E4) ---------------------------------------
-# Snap radius is inclusive at the boundary (<=). Default in integer grid units;
-# the Balance catalog overrides.
-const DEFAULT_SNAP_RADIUS: int = 36
-
-# --- SLA / Win-Lose (FR12, GDD Win/Loss MVP) ----------------------------------
-# MVP win = hold overall uptime >= this through the surge window (prototype
-# tuning ballpark; retune via catalogs during S4, sprint-plan §8 OQ-1).
-const DEFAULT_WIN_UPTIME_PCT: int = 90
-
-# --- Surge (sprint-plan §3.1, GDD § M5) ---------------------------------------
-# Streaming-Surge set-piece defaults (prototype tuning ballparks).
-const SURGE_MULTIPLIER: int = 10
-const SURGE_FORECAST_LEAD_TICKS: int = 600      # 30 s at 20 Hz
-
-# --- Era ids (catalog content) ------------------------------------------------
-const ERA_FOUNDATIONS: int = 1
-const ERA_EMAIL_WEB: int = 2
-const ERA_STREAMING_SURGE: int = 3
