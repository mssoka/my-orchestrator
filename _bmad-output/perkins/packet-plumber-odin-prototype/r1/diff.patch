-## RunController — Presentation/orchestration layer (ADR-2, architecture §9).
-##
-## Holds the RunState + SimDriver and drives the fixed-timestep accumulator in
-## _process: clamp delta ([FinLT]), step the sim N times to catch up, capped to
-## avoid spiral-of-death. Slow-mo: if it can't keep up it falls behind (never
-## skips ticks, AC-E21). Player commands queue for the next step (validate-all-
-## then-apply happens in the Core, AC-E23). Emits snapshot_ready each step.
-##
-## This is a Godot Node (Presentation) — the ONLY Node that touches the Core's
-## RunState. Pause freezes stepping (E7.4); resume continues deterministically.
-class_name RunController
-extends Node
-
-const MAX_STEPS_PER_FRAME: int = 5      # catch-up cap; excess carries (slow-mo, AC-E21)
-
-var seed_value: int = 1337
-var state: RunState = null
-var driver: SimDriver = null
-var catalogs: GameCatalogs = null
-var balance: BalanceData = null
-var director: ScriptedDirector = null
-
-var accumulator: float = 0.0
-var tick_len: float = 0.05            # seconds per logic tick (1/logic_hz)
-var paused: bool = false
-var _cmd_queue: Array = []            # Array[Command] for the next step
-var _logic_tick: int = 0
-var demo_mode: bool = false
-var time_scale: float = 1.0          # demo: compress real-time so the surge hits sooner
-
-var latest_snapshot: SimSnapshot = null
-var _demo_wired: Dictionary = {}   # demo autopilot bookkeeping: wired terminal ids
-
-signal snapshot_ready(snap: SimSnapshot)
-signal run_ended(won: bool)
-
-
-func _ready() -> void:
-	if _has_arg("demo"):
-		demo_mode = true
-		time_scale = 4.0   # ~4x: surge at 60s sim -> ~15s real
-	boot()
-
-
-static func _has_arg(name: String) -> bool:
-	for a: String in OS.get_cmdline_args():
-		if a == name:
-			return true
-	for a: String in OS.get_cmdline_user_args():
-		if a == name:
-			return true
-	return false
-
-
-func boot() -> void:
-	catalogs = GameCatalogs.load_default()
-	balance = catalogs.balance
-	director = ScriptedDirector.load_from("res://data/demand.json")
-	if catalogs.has_errors() or not director.load_ok:
-		push_error("[RunController] catalog/director load failed — running with partial data")
-	state = RunState.bootstrap(seed_value, catalogs, balance, director)
-	driver = SimDriver.new()
-	tick_len = 1.0 / float(balance.logic_hz) if balance.logic_hz > 0 else 0.05
-	accumulator = 0.0
-	_logic_tick = 0
-	paused = false
-	_cmd_queue.clear()
-	if demo_mode:
-		_apply_demo_network()
-	# emit an initial snapshot so the View can render before the first step
-	latest_snapshot = _snapshot_now()
-	snapshot_ready.emit(latest_snapshot)
-
-
-# Demo: auto-build a survivable starter network so a capture run shows flow + the
-# surge without human input. Manual play (no --demo arg) starts with NO pipes.
-func _apply_demo_network() -> void:
-	var ids: Array = state.topology.all_node_ids()
-	var content_id: int = -1
-	var router_id: int = -1
-	var residentials: Array[int] = []
-	for nid: int in ids:
-		var n: NetNode = state.topology.get_node(nid)
-		if n == null:
-			continue
-		if n.terminal_role == CoreConst.TerminalRole.CONTENT_HOST:
-			content_id = nid
-		elif n.is_junction():
-			router_id = nid
-		elif n.terminal_role == CoreConst.TerminalRole.RESIDENTIAL:
-			residentials.append(nid)
-	if content_id >= 0 and router_id >= 0:
-		# 2 parallel wide pipes content->router (E1.5 redundancy — the LAG bundle
-		# the demo shows). The retuned surge (40u/tick, demand.json volume 2)
-		# clears the pair's effective ~53u with the priority dial; a THIRD pipe
-		# is the player's mid-game option, not the boot requirement.
-		state.topology.apply_edit(Command.DrawPipeCmd.new(0, content_id, router_id, &"wide"))
-		state.topology.apply_edit(Command.DrawPipeCmd.new(0, content_id, router_id, &"wide"))
-	for rid: int in residentials:
-		if router_id >= 0:
-			# WIDE boot legs: the surge's sink spread is LUMPY (weighted-random
-			# over 7-9 sinks) and a 15u standard leg overflows whenever its house
-			# draws an unlucky streak (seen 2026-08-08: 20+ packets backed up on
-			# one leg). Wide absorbs the variance; the budget covers it.
-			state.topology.apply_edit(Command.DrawPipeCmd.new(0, router_id, rid, &"wide"))
-	# set one content->router pipe to STREAMING priority so a capture shows the label
-	if content_id >= 0 and router_id >= 0:
-		var snap := state.topology.snapshot()
-		var pair: Array = snap.pipes_between(content_id, router_id)
-		if not pair.is_empty():
-			state.topology.apply_edit(Command.SetPipePriorityCmd.new(0, (pair[0] as NetPipe).id, &"streaming"))
-	# record the terminals + the root router the boot network wired (autopilot
-	# bookkeeping). NO mixed narrow leg here: the mid router's last ports belong
-	# to the growth houses + the router-to-router mesh link (the port squeeze IS
-	# the demo's lesson).
-	_demo_wired.clear()
-	for rid: int in residentials:
-		_demo_wired[rid] = true
-	if router_id >= 0:
-		_demo_wired[router_id] = true
-
-
-func _process(delta: float) -> void:
-	if paused or state == null:
-		return
-	delta = minf(delta, CoreConst.MAX_FRAME_DELTA) * time_scale   # [FinLT] clamp
-	accumulator += delta
-	var steps: int = 0
-	while accumulator >= tick_len and steps < MAX_STEPS_PER_FRAME:
-		_do_step()
-		accumulator -= tick_len
-		steps += 1
-	# slow-mo: if still behind after the cap, drop excess so accumulator can't
-	# grow unbounded (the sim simply runs slow — AC-E21: never skips ticks).
-	if accumulator > tick_len * float(MAX_STEPS_PER_FRAME):
-		accumulator = tick_len * float(MAX_STEPS_PER_FRAME)
-
-
-func _do_step() -> void:
-	_logic_tick += 1
-	var cmds: Array = _cmd_queue
-	_cmd_queue = []
-	latest_snapshot = driver.step(state, _logic_tick, cmds)
-	snapshot_ready.emit(latest_snapshot)
-	if demo_mode:
-		_demo_autopilot()
-	if state.health.is_terminal():
-		run_ended.emit(state.health.won)
-		paused = true
-
-
-## Demo autopilot — plays the "play the internet" rule the way a good player
-## does: (1) wire each newly spawned ROUTER into the network mesh (junction-to-
-## junction link — an unlinked router is an island, and its houses' email can't
-## reach the rest of the internet); (2) wire each newly spawned residential to
-## the nearest router with a free port. Both escalate to WIDE when standard's
-## span can't reach. A spawn that fits nowhere stays unwired: that pressure IS
-## the feature (unconnected demand drains Network Health).
-func _demo_autopilot() -> void:
-	if latest_snapshot == null or latest_snapshot.topology == null:
-		return
-	var topo: TopologySnapshot = latest_snapshot.topology
-	# junctions FIRST (mesh before houses — links consume ports on both ends)
-	for nid: int in topo.nodes:
-		var n: NetNode = topo.nodes.get(nid)
-		if n == null or not n.is_junction() or _demo_wired.has(nid):
-			continue
-		_demo_wire(nid, topo, true)
-	# then houses
-	for nid: int in topo.nodes:
-		var n: NetNode = topo.nodes.get(nid)
-		if n == null or not n.is_terminal() \
-				or n.terminal_role != CoreConst.TerminalRole.RESIDENTIAL:
-			continue
-		if _demo_wired.has(nid):
-			continue
-		_demo_wire(nid, topo, false)
-
-
-## Try candidate hubs in distance order — the nearest may be out of span, so a
-## rejection must fall through to the next candidate (the player picks whichever
-## endpoint the pipe actually reaches). HOUSE legs start STANDARD and escalate
-## to WIDE only when span demands it (the surge's 6.7u/house fits a 15u leg;
-## a wide-everything build blows the budget). JUNCTION mesh links are WIDE from
-## the start: the spine carries the AGGREGATE traffic of every satellite house
-## — a standard spine chokes exactly like a single content pipe would.
-func _demo_wire(nid: int, topo: TopologySnapshot, is_junction: bool) -> void:
-	var tiers: Array[StringName] = []
-	if is_junction:
-		tiers.append(&"wide")
-	else:
-		tiers.append(&"standard")
-		tiers.append(&"wide")
-	for hid: int in _demo_hubs_sorted(nid, topo, is_junction == false):
-		for tier: StringName in tiers:
-			var r: EditResult = submit_command(Command.DrawPipeCmd.new(0, nid, hid, tier))
-			if r.ok:
-				_demo_wired[nid] = true
-				return
-
-
-func _demo_hubs_sorted(nid: int, topo: TopologySnapshot, reserve: bool) -> Array[int]:
-	var n: NetNode = topo.nodes.get(nid)
-	if n == null:
-		return []
-	var scored: Array = []   # [dist, node_id]
-	var fallback: Array = []
-	for hid: int in topo.nodes:
-		var h: NetNode = topo.nodes.get(hid)
-		if h == null or hid == nid:
-			continue
-		# "play the internet": terminals connect ONLY to junctions (never
-		# terminal-to-terminal, never direct to the host) — the autopilot
-		# honors the same graph rule the player must.
-		if not h.is_junction():
-			continue
-		var free: int = h.port_capacity - _incident_count(hid, topo)
-		if free <= 0:
-			continue
