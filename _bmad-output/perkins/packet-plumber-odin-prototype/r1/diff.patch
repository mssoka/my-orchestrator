-
-	match message.get("type", ""):
-		"ping":
-			_send_message({"type": "pong"})
-
-		"tool_invoke":
-			var request_id: String = message.get("id", "")
-			var tool_name: String = message.get("tool", "")
-			var args: Dictionary = message.get("args", {})
-			tool_requested.emit(request_id, tool_name, args)
-
-		_:
-			pass
-
-
