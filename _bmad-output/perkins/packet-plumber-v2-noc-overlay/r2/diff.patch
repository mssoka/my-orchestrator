+package input
+
+// noc_key_test.odin — the D-lesson chain pin (user ruling 2026-08-22): the
+// 5.7 D overlay "never worked" because its launch path was unreachable — the
+// chain itself was never pinned (the root cause: no run path ever builds with
+// PP_DEBUG, not a broken binding). This test drives the REAL pipeline
+// (dispatch_frame: mouse_map -> execute_all) with the exact Device_Event a
+// real D press creates (poll.odin's PP_DEBUG gate), asserting the intent
+// maps and the effect fires. A render function that never gets called is not
+// a feature — the chain is pinned here, and the app e2e drive (PP_NOC_E2E=1)
+// proves it in a real windowed run.
+//
+// Each test uses its OWN counter (passed via `user`, the effect-hook
+// contract) — no package globals, so the tests are race-proof and order-
+// independent under any test runner.
+
+import "core:testing"
+
+// noc_test_effect — the recording effect (mirrors effect_overlay's contract:
+// the app flips its flag when the effect fires). Counts into the caller's
+// local via `user` (the same mechanism effect_overlay uses for the App).
+noc_test_effect :: proc(user: rawptr, inp: ^Input) {
+	flips := cast(^int)user
+	flips^ += 1
+}
+
+@(test)
+noc_key_d_fires_the_overlay_effect :: proc(t: ^testing.T) {
+	flips := 0
+	inp: Input
+	init(&inp)
+	defer destroy(&inp)
+	inp.user = &flips
+	inp.on_overlay = noc_test_effect
+
+	// the same Device_Event poll.odin emits for a real D press (PP_DEBUG)
+	events := []Device_Event{Device_Event(Key_Press{key = .D})}
+	dispatch_frame(&inp, events)
+	testing.expect(t, flips == 1, "D key press -> Toggle_Overlay -> effect fires")
+}
