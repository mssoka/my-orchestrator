diff --git a/tools/run-dev.sh b/tools/run-dev.sh
new file mode 100755
index 00000000..246ed931
--- /dev/null
+++ b/tools/run-dev.sh
@@ -0,0 +1,42 @@
+#!/usr/bin/env bash
+# tools/run-dev.sh — the v2-noc dev launch (the D-lesson root-cause fix):
+# the 5.7 D overlay "never worked" because NO run path ever built with the
+# PP_DEBUG define — every launch compiled the overlay out entirely (the
+# wiring was complete; the launch path was dead). This is the first-class
+# dev option the briefing's "--dev launch" named: build + run the app WITH
+# the debug surface (D key), plus the PP_NOC_E2E=1 mechanical key-toggle
+# proof when asked.
+#
+#   tools/run-dev.sh                 # build + run the PP_DEBUG app (D = the NOC panel)
+#   tools/run-dev.sh --e2e           # the mechanical proof run: injects real
+#                                    # D presses through the input pipeline and
+#                                    # captures bin/noc-e2e-on.png / -off.png
+#                                    # (panel ON / OFF), then exits
+#   tools/run-dev.sh --stats-out <p> # pass-through (the app's telemetry flag)
+#
+# Release builds carry zero overlay code — normal runs are untouched.
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+cd "$ROOT"
+
+E2E=0
+ARGS=()
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --e2e) E2E=1 ;;
+    *) ARGS+=("$1") ;;
+  esac
+  shift
+done
+
+mkdir -p bin
+echo "run-dev: building the PP_DEBUG app (the debug surface is compile-gated to this define)..."
+odin build app -define:PP_DEBUG=true -out:bin/app-dev "${ARGS[@]+}" 2>&1 | head -20
+
+if [ "$E2E" = "1" ]; then
+  echo "run-dev: e2e drive — real windowed run, scripted D presses, ON/OFF captures (bin/noc-e2e-*.png)"
+  PP_NOC_E2E=1 ./bin/app-dev
+  echo "run-dev: e2e done — bin/noc-e2e-on.png (panel) vs bin/noc-e2e-off.png (no panel)"
+else
+  ./bin/app-dev
+fi
