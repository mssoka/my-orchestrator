new file mode 100644
index 00000000..6b0d6405
--- /dev/null
+++ b/app/render/noc_overlay.odin
@@ -0,0 +1,905 @@
+package render
+
+// noc_overlay.odin — the v2 NOC-style debug dashboard (user directive
+// 2026-08-22 + the same-day D-lesson ruling): the ONE debug surface, toggled
+// by `D` (the established 5.7 debug-key slot, user-ruled 2026-08-22; PP_DEBUG
+// builds only). The 5.7 D-key overlay is ABSORBED here — its unique content
+// (map heat tints, per-class SLA table, per-pipe select readout, all-tag
+// event tail, score/meter line) folds into the NOC panel (drop counters +
+// per-class rolling rates, crisis root causes, rejections, queue-depth bars
+// vs the E9 bound, pool utilization vs the E22 cap, pipes at/over 100%, and
+// a scrollable last-drop alarm feed). One key, one surface, zero dead code.
+//
+// Readability ruling (2026-08-22, user): the dashboard must be easy to read —
+// (1) tabular figures, right-aligned numerals in fixed columns (zero width
+// jitter as counters tick — the HUD font's digits ARE tabular: Open Sans
+// equal advances, verified); (2) hierarchy: small-caps labels, large numerals,
+// the drop-reason counters are the headline row; (3) a dark semi-opaque
+// backing plate so text reads over ANY map state; (4) threshold colors from
+// game canon (balance.json warnings.pipe_amber_pct=70 / pipe_red_pct=90) for
+// the utilization + queue bars; (5) zebra-striped drop log with fixed
+// columns; (6) readable at the 1280x720 window (>= 14px body — the 5.8 QoS
+// panel's legibility convention; labels 10px uppercase); (7) KYLE
+// visual-verification on the live capture (acceptance).
+//
+// Golden safety — the 5.7 doctrine, unchanged: the DRAW code is compile-gated
+// by `when #config(PP_DEBUG, false)` — a build without `-define:PP_DEBUG=true`
+// (release app, EVERY harness build) compiles an empty surface, so the overlay
+// cannot exist in the harness capture path; the overlay is OFF by default (the
+// D key toggles it); the capture path never calls this — only the app's HUD
+// pass and the PP_DEBUG `overlay-check` harness verb do. AC4 by construction.
+//
+// The FEED (below) is UNGATED: a pure, fixed-array accumulator over the
+// serialized event stream (Packet_Dropped / Crisis_Triggered) with tick-keyed
+// rolling rings. No raylib, no sim access, no allocation — the @(test) file
+// pins its purity/determinism in the standard gate-2 build; release builds
+// carry an inert ~13 KB struct. The feed NEVER reads per-tick scratch
+// (drop_sites) — events are the replayable record, so the app and the harness
+// `overlay-check` verb reach identical feed states from the same stream.
+//
+// The draw takes explicit params (not an app handle) so the PP_DEBUG harness
+// verb can render the SAME overlay over a demo frame. All strings ASCII (the
+// byte-truncating draw_text_c — lint gate 6). Read-only: never drains events,
+// never steps, never mutates sim state (ODN-1).
+
+import "core:fmt"
+import "core:strings"
+import pp "../../core"
+import rl "vendor:raylib"
+
+// ---------------------------------------------------------------------------
+// The NOC feed (ungated — pure accumulator over events)
+// ---------------------------------------------------------------------------
+
+NOC_RATE_WINDOW :: 60  // ticks (~3 s @ 20 Hz) — the rolling rate window
+NOC_LOG_CAP     :: 256 // drop-log ring capacity (user ruling Q4)
+NOC_MAX_CLASSES :: 64  // per-class table bound (the catalog roster is small)
+NOC_MAX_REASONS :: 32  // rejection-kind bound (Edit_Error < 32)
+
+// Drop_Log_Entry — one drop-log row (the NOC alarm feed). Carries the RAW
+// event payload (tick/class/reason/bundle slot); endpoint/pipe/lane ids are
+// resolved READ-ONLY at draw time (bundle slots renumber on topology change,
+// and the feed must stay topology-free to be pure + replayable).
+Drop_Log_Entry :: struct {
+	tick:   u64,
+	class:  u16,
+	reason: u8,  // Drop_Reason byte (unclassified bytes render honestly as "??")
+	bundle: u32, // Event.target: the shed bundle slot; NO_BUNDLE for E22
+}
+
+// Noc_Feed — run-scoped counters + rings. RESET on every run start
+// (since-start labels); folded by noc_feed_scan (incremental or one-shot —
+// tick-keyed rings make both orders land in the same state).
+Noc_Feed :: struct {
+	// drop counters by reason (the taxonomy: E9/E22/other — 1:1 with the
+	// Drop_Reason enum; an unknown reason byte lands in other, never mislabeled)
+	drop_e9:    u64,
+	drop_pool:  u64,
+	drop_other: u64,
+	// per-class cumulative drops (bounded index; out-of-roster classes also
+	// land in drop_other — an unclassified class is a finding, not a guess)
+	per_class: [NOC_MAX_CLASSES]u64,
+	// crisis root-cause counters (EVENT_TAG_CRISIS_TRIGGERED by cause) + the
+	// latest Saturated_Bundle target (the actionable why)
+	crisis_sat:      u32,
+	crisis_pool:     u32,
+	crisis_other:    u32,
+	crisis_last_cause: u8,
+	crisis_last_class: u16,
+	crisis_last_bundle: u32,
+	crisis_last_pipe: u32,
+	// rejections (app-fed from input.last_reject transitions; "rejected, not
+	// dropped" — the sim never emits these as drops)
+	reject_total: u64,
+	reject_kind:  [NOC_MAX_REASONS]u64,
+	reject_last_kind: u8, // the freshest rejection kind (for the label)
+	// 60-tick rolling rate rings (tick-keyed: slot = tick % 60, zero-filled on
+	// roll — frame/tick interleave cannot corrupt the window)
+	ring_tick:  u64,
+	ring_total: [NOC_RATE_WINDOW]u16,
+	ring_class: [NOC_RATE_WINDOW][NOC_MAX_CLASSES]u16,
+	// drop-log ring (newest-first display; head = next write)
+	log:      [NOC_LOG_CAP]Drop_Log_Entry,
+	log_head: u32,
+	log_n:    u32,
+}
+
+// noc_feed_reset — zero the whole feed (called at every run start).
+noc_feed_reset :: proc(f: ^Noc_Feed) {
+	f^ = {}
+}
+
+// noc_feed_reject — count one edit rejection (app-side only; the harness
+// replay never rejects, so overlay-check shows 0 — honest).
+noc_feed_reject :: proc(f: ^Noc_Feed, err: pp.Edit_Error) {
+	f.reject_total += 1
+	f.reject_last_kind = u8(err)
+	if u32(err) < NOC_MAX_REASONS {
+		f.reject_kind[err] += 1
+	}
+}
+
+// noc_feed_scan — fold an event slice into the feed. PURE: reads the slice,
+// mutates only the feed (never the sim, never the slice). The caller owns the
+// mark (the app scans events[noc_mark:] per frame; the harness scans the full
+// buffer once — both reach the same state, pinned by @(test)).
+noc_feed_scan :: proc(f: ^Noc_Feed, events: []pp.Event) {
+	for e in events {
+		switch e.tag {
+		case pp.EVENT_TAG_PACKET_DROPPED:
+			noc_feed_fold_drop(f, e)
+		case pp.EVENT_TAG_CRISIS_TRIGGERED:
+			noc_feed_fold_crisis(f, e)
+		}
+	}
+}
+
+// noc_feed_fold_drop — one Packet_Dropped event into the counters/rings/log.
+noc_feed_fold_drop :: proc(f: ^Noc_Feed, e: pp.Event) {
+	noc_feed_ring_roll(f, e.tick)
+	slot := u32(e.tick % NOC_RATE_WINDOW)
+	// the reason bucket (1:1 with Drop_Reason — unknown bytes land in other)
+	switch pp.Drop_Reason(e.reason) {
+	case .Queue_Overflow:
+		f.drop_e9 += 1
+	case .Pool_Exhaustion:
+		f.drop_pool += 1
+	case:
+		f.drop_other += 1
+	}
+	// the class bucket (bounded; out-of-roster classes are a finding)
+	if u32(e.class) < NOC_MAX_CLASSES {
+		f.per_class[e.class] += 1
+		if f.ring_class[slot][e.class] < max(u16) {
+			f.ring_class[slot][e.class] += 1
+		}
+	} else {
+		f.drop_other += 1
+	}
+	// the ring total + the log row (every drop event, classified or not)
+	if f.ring_total[slot] < max(u16) {
+		f.ring_total[slot] += 1
+	}
+	f.log[f.log_head] = Drop_Log_Entry{tick = e.tick, class = e.class, reason = e.reason, bundle = e.target}
+	f.log_head = (f.log_head + 1) % NOC_LOG_CAP
+	if f.log_n < NOC_LOG_CAP {
+		f.log_n += 1
+	}
+}
+
+// noc_feed_fold_crisis — one Crisis_Triggered event into the cause counters.
+noc_feed_fold_crisis :: proc(f: ^Noc_Feed, e: pp.Event) {
+	#partial switch pp.Root_Cause_Kind(e.cause) {
+	case .Saturated_Bundle:
+		f.crisis_sat += 1
+		f.crisis_last_cause = e.cause
+		f.crisis_last_class = e.class
+		f.crisis_last_bundle = e.target // the bundle slot (renumbering handled at draw)
+		f.crisis_last_pipe = e.pipe
+	case .Pool_Exhaustion:
+		f.crisis_pool += 1
+	case:
+		f.crisis_other += 1
+	}
+}
+
+// noc_feed_ring_roll — advance the tick-keyed rings to `tick`, zero-filling
+// the slots for the ticks in (ring_tick, tick]. Any gap >= the window clears
+// every slot exactly once (60 consecutive residue classes); same-tick folds
+// and out-of-order events (defensive — the stream is append-ordered) roll
+// nothing.
+noc_feed_ring_roll :: proc(f: ^Noc_Feed, tick: u64) {
+	if tick == f.ring_tick {
+		return
+	}
+	if f.ring_tick != 0 && tick < f.ring_tick {
+		return
+	}
+	lo := f.ring_tick + 1
+	hi := min(tick, f.ring_tick + NOC_RATE_WINDOW)
+	for t := lo; t <= hi; t += 1 {
+		s := u32(t % NOC_RATE_WINDOW)
+		f.ring_total[s] = 0
+		for c in 0..<NOC_MAX_CLASSES {
+			f.ring_class[s][c] = 0
+		}
+	}
+	f.ring_tick = tick
+}
+
+// noc_feed_rate_total — drops in the last 60 ticks (the /3 s live rate).
+noc_feed_rate_total :: proc(f: ^Noc_Feed) -> u32 {
+	sum: u32 = 0
+	for s in 0..<NOC_RATE_WINDOW {
+		sum += u32(f.ring_total[s])
+	}
+	return sum
+}
+
+// noc_feed_rate_class — one class's drops in the last 60 ticks.
+noc_feed_rate_class :: proc(f: ^Noc_Feed, class: u16) -> u32 {
+	if u32(class) >= NOC_MAX_CLASSES {
+		return 0
+	}
+	sum: u32 = 0
+	for s in 0..<NOC_RATE_WINDOW {
+		sum += u32(f.ring_class[s][class])
+	}
+	return sum
+}
+
+// noc_feed_drop_ratio — drops / (delivered + drops) as an integer percent
+// (the Q3 drop-ratio line; 0 when nothing completed).
+noc_feed_drop_ratio :: proc(f: ^Noc_Feed, delivered: u64) -> u32 {
+	total := f.drop_e9 + f.drop_pool + f.drop_other
+	den := delivered + total
+	if den == 0 {
+		return 0
+	}
+	return u32(total * 100 / den)
+}
+
+// noc_log_at — entry `i` of the drop log (0 = newest), ring-safe.
+noc_log_at :: proc(f: ^Noc_Feed, i: u32) -> Drop_Log_Entry {
+	idx := (f.log_head + NOC_LOG_CAP - 1 - (i % NOC_LOG_CAP)) % NOC_LOG_CAP
+	return f.log[idx]
+}
+
+// noc_reason_label — the Drop_Reason enum -> ASCII label (the 1:1 taxonomy
+// pin; an unknown byte renders "??" — the raw reason is never mislabeled).
+noc_reason_label :: proc(reason: u8) -> string {
+	switch pp.Drop_Reason(reason) {
+	case .Queue_Overflow:
+		return "E9"
+	case .Pool_Exhaustion:
+		return "E22"
+	}
+	return "??"
+}
+
+// noc_lane_letter — lane 0..2 -> the E/S/B one-letter label (ASCII).
+noc_lane_letter :: proc(lane: u8) -> string {
+	switch lane {
+	case pp.LANE_EXPRESS:
+		return "E"
+	case pp.LANE_STANDARD:
+		return "S"
+	case pp.LANE_BEST_EFFORT:
+		return "B"
+	}
+	return "?"
+}
+
+// Noc_Level — the canon threshold ladder (balance.json warnings: amber at
+// pipe_amber_pct, red at pipe_red_pct — the game's warning telegraph). The
+// overlay's bars/tints derive EVERY color from this (a dev tool that invents
+// its own thresholds would contradict the game's own "see it coming" canon).
+Noc_Level :: enum u8 {
+	Normal,
+	Amber,
+	Red,
+}
+
+// noc_level — classify a utilization fraction (permille, 1000 = 100%) against
+// the canon amber/red percents. Pure + ungated so the @(test) pins the ladder
+// (70/90 from balance.json warnings — the same numbers the T1 pins).
+noc_level :: proc(frac_permille: u32, amber_pct: i32, red_pct: i32) -> Noc_Level {
+	if red_pct > 0 && frac_permille >= u32(red_pct) * 10 {
+		return .Red
+	}
+	if amber_pct > 0 && frac_permille >= u32(amber_pct) * 10 {
+		return .Amber
+	}
+	return .Normal
+}
+
+// ---------------------------------------------------------------------------
+// The merged overlay surface (gated — PP_DEBUG builds only)
+// ---------------------------------------------------------------------------
+
+when #config(PP_DEBUG, false) {
+
+// NOC_PANEL_* — the panel geometry (the 5.7 anchor: the right column below
+// the forecast panel; the run HUD owns the left/top/bottom). The whole panel
+// scrolls as ONE column (wheel) — the drop log is its last section.
+NOC_PANEL_X :: 908
+NOC_PANEL_Y :: 96
+NOC_PANEL_W :: 360
+NOC_PANEL_H :: 600
+NOC_ROW_H   :: 16 // >= 14px body text + breathing (the 5.8 legibility rule)
+
+// The dark semi-opaque backing plate (readability ruling #3): text reads over
+// ANY map state — terrain, wires, packets. The 5.7 debug-plate look.
+NOC_PLATE      :: rl.Color{20, 24, 30, 200}
+NOC_PLATE_EDGE :: rl.Color{120, 140, 165, 90}
+
+// Panel text palette (light-on-dark — the plate's ink):
+NOC_TXT       :: rl.Color{240, 244, 248, 255} // body
+NOC_TXT_DIM   :: rl.Color{180, 192, 206, 255} // body numbers
+NOC_LABEL     :: rl.Color{150, 162, 178, 255} // small-caps labels
+NOC_LABEL_DIM :: rl.Color{110, 122, 138, 255} // section rules
+NOC_RED       :: rl.Color{240, 110, 100, 255} // canon red (warm-danger family)
+NOC_AMBER     :: rl.Color{240, 170, 90, 255}  // canon amber
+NOC_BAR_BG    :: rl.Color{255, 255, 255, 26}  // bar track on the plate
+NOC_BAR_OK    :: rl.Color{140, 160, 180, 255} // normal bar fill
+NOC_ZEBRA     :: rl.Color{255, 255, 255, 7}   // drop-log zebra stripe
+
+// draw_noc_overlay — the whole surface. Called from the app's render pass
+// (after draw_hud, in the PP_DEBUG block) and the harness `overlay-check`
+// verb. `sel_pipe` is the selected pipe id or -1 (the harness passes -1 — the
+// readout section draws nothing); `pool` is the live in-flight packet count
+// (len(state.flow.packets)); `scroll` is the panel wheel offset (clamped).
+draw_noc_overlay :: proc(v: ^View, feed: ^Noc_Feed, stats: ^pp.Stats_Record,
+	topo: ^pp.Topology, bundles: ^pp.Bundles, cat: ^pp.Catalogs,
+	events: []pp.Event, sel_pipe: i64, pool: u32, scroll: i32) {
+	draw_heat_tints(v, topo, stats, cat)
+	draw_noc_panel(v, feed, stats, topo, bundles, cat, events, sel_pipe, pool, scroll)
+}
+
+// noc_util_level — the canon ladder for a util_pct (0..100, the stats value).
+noc_util_level :: proc(util_pct: u32, cat: ^pp.Catalogs) -> Noc_Level {
+	return noc_level(util_pct * 10, cat.balance.warnings.pipe_amber_pct, cat.balance.warnings.pipe_red_pct)
+}
+
+// heat_color — the canon heat ladder: < amber clear, amber..red amber, >= red
+// red (balance.json warnings 70/90 — the game's own telegraph, per the
+// readability ruling #4; the 5.7 custom 50/70/90 ladder is superseded).
+heat_color :: proc(level: Noc_Level) -> rl.Color {
+	#partial switch level {
+	case .Amber:
+		return {240, 170, 90, 170}
+	case .Red:
+		return {230, 70, 60, 170}
+	}
+	return {0, 0, 0, 0} // clear — no tint below the canon amber
+}
+
+// draw_heat_tints — the 5.7 congestion heat (absorbed): translucent strokes
+// over every live pipe whose bundle crossed the CANON amber threshold + the
+// util% label on congested pipes (numbers, not color alone — the telegraph
+// discipline).
+draw_heat_tints :: proc(v: ^View, topo: ^pp.Topology, stats: ^pp.Stats_Record, cat: ^pp.Catalogs) {
+	for p in stats.pipes {
+		col := heat_color(noc_util_level(p.util_pct, cat))
+		if col.a == 0 {
+			continue // healthy — no tint
+		}
+		ps, ok := pp.pipe_slot(topo, p.pipe)
+		if !ok {
+			continue
+		}
+		// R2-N7 (Perkins r2): guard node_slot's ok like pipe_slot's — a dead/
+		// tombstoned endpoint must skip the tint, never index node_pos on a
+		// missing slot (the selected pipe can die under a junction batch).
+		sa, oka := pp.node_slot(topo, topo.pipe_a[ps])
+		sb, okb := pp.node_slot(topo, topo.pipe_b[ps])
+		if !oka || !okb {
+			continue
+		}
+		ax := node_screen(v, topo.node_pos[sa])
+		bx := node_screen(v, topo.node_pos[sb])
+		rl.DrawLineEx(ax, bx, 10, col)
+		// the util% label at the pipe's midpoint (only when congested)
+		mid := rl.Vector2{(ax.x + bx.x) / 2, (ax.y + bx.y) / 2}
+		label := fmt.tprintf("%d%%", p.util_pct)
+		draw_text_c(v, label, i32(mid.x) + 4, i32(mid.y) - 8, 12, NOC_TXT)
+	}
+}
+
+// --- the panel row cursor ---------------------------------------------------
+
+// noc_row_visible — is absolute row `cur` inside the viewport? (the custom
+// bar/zebra rows use this before drawing their rects).
+noc_row_visible :: proc(cur, scroll, visible: i32) -> bool {
+	return cur >= scroll && cur < scroll + visible
+}
+
+// noc_row_y — the viewport y of absolute row `cur`.
+noc_row_y :: proc(cur, scroll: i32) -> i32 {
+	return NOC_PANEL_Y + 6 + (cur - scroll) * NOC_ROW_H
+}
+
+// noc_row — emit one text row through the cursor; returns the next row index.
+// `size` is the font size (>= 14 body, 10 labels — the hierarchy ladder).
+noc_row :: proc(v: ^View, cur, scroll, visible: i32, txt: string, size: i32, col: rl.Color) -> i32 {
+	if noc_row_visible(cur, scroll, visible) {
+		draw_text_c(v, txt, NOC_PANEL_X + 6, noc_row_y(cur, scroll), size, col)
+	}
+	return cur + 1
+}
+
+// noc_row_right — right-aligned row (the tabular-figures rule: numerals hold
+// a FIXED right edge so counters never width-jitter as they tick). `w` is the
+// column width measured from the panel's right edge.
+noc_row_right :: proc(v: ^View, cur, scroll, visible: i32, txt: string, size: i32, col: rl.Color, w: i32) -> i32 {
+	if noc_row_visible(cur, scroll, visible) {
+		x := NOC_PANEL_X + NOC_PANEL_W - 6 - w
+		draw_text_c(v, txt, x, noc_row_y(cur, scroll), size, col)
+	}
+	return cur + 1
+}
+
+// noc_col — right-aligned numeral in a fixed column (the ledger rule: the
+// units digit stays at `x_right` — counters never width-jitter as they tick;
+// the HUD font's digits are tabular, so every digit lands on a fixed pixel).
+noc_col :: proc(v: ^View, txt: string, size: i32, col: rl.Color, x_right: i32, y: i32) {
+	w := i32(rl.MeasureTextEx(v.font, strings_clone_cstr_noc(txt, v), f32(size), 1).x)
+	draw_text_c(v, txt, x_right - w, y, size, col)
+}
+
+// strings_clone_cstr_noc — clone into the temp arena for MeasureTextEx (the
+// per-frame temp arena dies with the frame — the HUD-string convention).
+strings_clone_cstr_noc :: proc(s: string, v: ^View) -> cstring {
+	return strings.clone_to_cstring(s, context.temp_allocator)
+}
+
+// noc_section — a small-caps section label + a hairline rule under it
+// (hierarchy: labels are small + dim, never compete with the numerals).
+noc_section :: proc(v: ^View, cur, scroll, visible: i32, label: string) -> i32 {
+	if noc_row_visible(cur, scroll, visible) {
+		y := noc_row_y(cur, scroll)
+		draw_text_c(v, label, NOC_PANEL_X + 6, y, 10, NOC_LABEL)
+		rl.DrawLine(NOC_PANEL_X + 6, y + 13, NOC_PANEL_X + NOC_PANEL_W - 6, y + 13, rl.Color{255, 255, 255, 24})
+	}
+	return cur + 1
+}
+
+// noc_bar — a compact 6px bar on the plate; color from the CANON ladder
+// (readability ruling #4): Normal fill, amber at >= pipe_amber_pct, red at >=
+// pipe_red_pct. `frac` clamped 0..1; `level` precomputed by the caller.
+noc_bar :: proc(v: ^View, x, y, w: i32, frac: f32, level: Noc_Level) {
+	col := NOC_BAR_OK
+	#partial switch level {
+	case .Amber:
+		col = NOC_AMBER
+	case .Red:
+		col = NOC_RED
+	}
+	rl.DrawRectangle(x, y, w, 6, NOC_BAR_BG)
+	f := clamp(frac, 0.0, 1.0)
+	if f > 0 {
+		rl.DrawRectangle(x, y, max(1, i32(f32(w) * f)), 6, col)
+	}
+}
+
+// --- panel measure + draw ---------------------------------------------------
+
+// noc_panel_rows — the total row count (the scroll clamp's measure pass).
+// MUST agree with draw_noc_panel row-for-row (same count predicates).
+noc_panel_rows :: proc(stats: ^pp.Stats_Record, events: []pp.Event, sel_pipe: i64, log_n: u32) -> i32 {
+	rows := i32(3) // header: title + global line + hash
+	rows += 4      // DROPS: section + labels + numerals + ratio
+	rows += 4      // CRISIS: section + sat + pool + rejections
+	rows += 2      // PER-CLASS: section + column header
+	rows += i32(min(9, len(stats.classes)))
+	rows += 1 + noc_queue_rows(stats) // QUEUES: section + rows
+	rows += 2                         // POOL: section + row
+	rows += 1 + noc_pipe_rows(stats)  // PIPES: section + rows
+	if sel_pipe >= 0 {
+		rows += 4 // section + offered + carried + drops
+	}
+	rows += 1 // EVENTS section
+	rows += i32(min(8, len(events)))
+	if len(events) == 0 {
+		rows += 1 // the "(no events yet)" fallback row
+	}
+	rows += 1 // DROP LOG section
+	rows += i32(min(12, log_n))
+	if log_n == 0 {
+		rows += 1 // the "(no drops yet)" fallback row
+	}
+	return rows
+}
+
+// noc_queue_rows — live pipes worth a queue row (any lane queued or >= the
+// canon amber).
+noc_queue_rows :: proc(stats: ^pp.Stats_Record) -> i32 {
+	n := 0
+	for p in stats.pipes {
+		if p.q[0] + p.q[1] + p.q[2] > 0 || p.util_pct >= 70 {
+			n += 1
+		}
+	}
+	return i32(min(8, n))
+}
+
+// noc_pipe_rows — pipes at/over 100% RAW utilization (carried >= cap — the
+// stats util_pct is clamped at 100 and cannot show overload).
+noc_pipe_rows :: proc(stats: ^pp.Stats_Record) -> i32 {
+	n := 0
+	for p in stats.pipes {
+		if p.cap_units > 0 && p.carried >= u64(p.cap_units) {
+			n += 1
+		}
+	}
+	return i32(min(8, n))
+}
+
+// draw_noc_panel — the merged panel on the dark plate: D-content (global
+// line, per-class SLA table, select readout, event tail) + the NOC sections,
+// one scroll column. All numerals right-aligned in fixed columns (tabular
+// Open Sans digits — no width jitter); colors from the canon ladder.
+draw_noc_panel :: proc(v: ^View, feed: ^Noc_Feed, stats: ^pp.Stats_Record,
+	topo: ^pp.Topology, bundles: ^pp.Bundles, cat: ^pp.Catalogs,
+	events: []pp.Event, sel_pipe: i64, pool: u32, scroll_in: i32) {
+	total := noc_panel_rows(stats, events, sel_pipe, feed.log_n)
+	visible := i32(NOC_PANEL_H / NOC_ROW_H)
+	scroll := clamp(scroll_in, 0, max(0, total - visible))
+	cur: i32 = 0
+	right := NOC_PANEL_X + NOC_PANEL_W - 6
+
+	// the dark semi-opaque backing plate (readability ruling #3)
+	rl.DrawRectangle(NOC_PANEL_X - 8, NOC_PANEL_Y - 10, NOC_PANEL_W + 16, NOC_PANEL_H + 20, NOC_PLATE)
+	rl.DrawRectangleLines(NOC_PANEL_X - 8, NOC_PANEL_Y - 10, NOC_PANEL_W + 16, NOC_PANEL_H + 20, NOC_PLATE_EDGE)
+
+	// --- header: title + global line ----------------------------------------
+	cur = noc_row(v, cur, scroll, visible, "DEBUG OVERLAY (D)", 14, NOC_TXT)
+	glob := fmt.tprintf("tick %d  gen %d  score %d  meter %d%%", stats.tick, stats.gen, stats.score, stats.meter)
+	cur = noc_row(v, cur, scroll, visible, glob, 14, NOC_TXT_DIM)
+	hash := fmt.tprintf("hash %016x", stats.sim_hash)
+	cur = noc_row(v, cur, scroll, visible, hash, 12, NOC_LABEL_DIM)
+
+	// --- DROPS headline (the headline row: large numerals, small labels) ----
+	cur = noc_section(v, cur, scroll, visible, "DROPS SINCE START")
+	head_lbl_r := i32(NOC_PANEL_X + 168)
+	if noc_row_visible(cur, scroll, visible) {
+		y := noc_row_y(cur, scroll)
+		draw_text_c(v, "E9 lane-shed", NOC_PANEL_X + 6, y, 10, NOC_LABEL)
+		draw_text_c(v, "E22 pool", head_lbl_r, y, 10, NOC_LABEL)
+	}
+	cur += 1
+	if noc_row_visible(cur, scroll, visible) {
+		y := noc_row_y(cur, scroll)
+		noc_col(v, fmt.tprintf("%d", feed.drop_e9), 22, NOC_RED, head_lbl_r + 8, y)
+		noc_col(v, fmt.tprintf("%d", feed.drop_pool), 22, NOC_AMBER, NOC_PANEL_X + NOC_PANEL_W - 6, y)
+	}
+	cur += 1
+	total_drops := feed.drop_e9 + feed.drop_pool + feed.drop_other
+	delivered: u64 = 0
+	for c in stats.classes {
+		delivered += c.delivered
+	}
+	ratio := noc_feed_drop_ratio(feed, delivered)
+	ratio_line := fmt.tprintf("ratio %d%%  other %d  /3s %d", ratio, feed.drop_other, noc_feed_rate_total(feed))
+	cur = noc_row(v, cur, scroll, visible, ratio_line, 14, NOC_TXT_DIM)
+
+	// --- crisis root causes + rejections ------------------------------------
+	cur = noc_section(v, cur, scroll, visible, "CRISIS ROOT CAUSES")
+	if feed.crisis_sat > 0 {
+		line := fmt.tprintf("Saturated_Bundle %d  b%d p%d", feed.crisis_sat, feed.crisis_last_bundle, feed.crisis_last_pipe)
+		cur = noc_row(v, cur, scroll, visible, line, 14, NOC_RED)
+	} else {
+		cur = noc_row(v, cur, scroll, visible, "Saturated_Bundle 0", 14, NOC_TXT_DIM)
+	}
+	pool_line := fmt.tprintf("Pool_Exhaustion %d  other %d", feed.crisis_pool, feed.crisis_other)
+	cur = noc_row(v, cur, scroll, visible, pool_line, 14, NOC_TXT_DIM)
+	rej := fmt.tprintf("REJECTED, not dropped: %d (%s)", feed.reject_total, noc_reject_kind_label(feed))
+	cur = noc_row(v, cur, scroll, visible, rej, 14, NOC_LABEL)
+
+	// --- per-class table (5.7 columns + the /3 s rate; fixed right-aligned) --
+	cur = noc_section(v, cur, scroll, visible, "PER-CLASS (CUM | /3S)")
+	// ledger columns: name left; del/drop/loss/rate right-aligned at fixed
+	// right edges (tabular digits — the units stay put as counters tick)
+	name_x := i32(NOC_PANEL_X + 6)
+	del_r := name_x + 84
+	drop_r := del_r + 50
+	loss_r := drop_r + 46
+	sla_x := loss_r + 8
+	rate_r := sla_x + 72
+	if noc_row_visible(cur, scroll, visible) {
+		y := noc_row_y(cur, scroll)
+		draw_text_c(v, "class", name_x, y, 12, NOC_LABEL)
+		draw_text_c(v, "del", del_r, y, 12, NOC_LABEL)
+		draw_text_c(v, "drop", drop_r, y, 12, NOC_LABEL)
+		draw_text_c(v, "loss", loss_r, y, 12, NOC_LABEL)
+		draw_text_c(v, "SLA", sla_x, y, 12, NOC_LABEL)
+		draw_text_c(v, "/3s", rate_r, y, 12, NOC_LABEL)
+	}
+	cur += 1
+	shown := 0
+	for c in stats.classes {
+		if shown >= 9 {
+			break
+		}
+		if int(c.class) >= len(cat.packet_types) {
+			continue
+		}
+		name := cat.packet_types[c.class].display
+		sla := "ok"
+		col := NOC_TXT_DIM
+		if c.sla_lat && c.sla_loss {
+			sla = "LAT+LOSS"
+			col = NOC_RED
+		} else if c.sla_lat {
+			sla = "LAT"
+			col = NOC_AMBER
+		} else if c.sla_loss {
+			sla = "LOSS"
+			col = NOC_AMBER
+		}
+		if noc_row_visible(cur, scroll, visible) {
+			y := noc_row_y(cur, scroll)
+			draw_text_c(v, name, name_x, y, 14, NOC_TXT)
+			noc_col(v, fmt.tprintf("%d", c.delivered), 14, col, del_r, y)
+			noc_col(v, fmt.tprintf("%d", c.dropped), 14, col, drop_r, y)
+			noc_col(v, fmt.tprintf("%d%%", c.loss_pct), 14, col, loss_r, y)
+			draw_text_c(v, sla, sla_x, y, 14, col)
+			noc_col(v, fmt.tprintf("%d", noc_feed_rate_class(feed, c.class)), 14, col, rate_r, y)
+		}
+		cur += 1
+		shown += 1
+	}
+
+	// --- queue depth vs the E9 bound (canon-colored bars) --------------------
+	cur = noc_section(v, cur, scroll, visible, "QUEUES VS E9 BOUND (6)")
+	bound := u32(max(1, cat.balance.lane_queue_packets))
+	amber_pct := cat.balance.warnings.pipe_amber_pct
+	red_pct := cat.balance.warnings.pipe_red_pct
+	qshown := 0
+	for p in stats.pipes {
+		if qshown >= 8 {
+			break
+		}
+		if p.q[0] + p.q[1] + p.q[2] == 0 && p.util_pct < 70 {
+			continue
+		}
+		if noc_row_visible(cur, scroll, visible) {
+			ty := noc_row_y(cur, scroll)
+			draw_text_c(v, fmt.tprintf("P%d", p.pipe), NOC_PANEL_X + 6, ty, 14, NOC_TXT_DIM)
+			for lane in 0..<3 {
+				lane_name := noc_lane_letter(u8(lane))
+				bx := NOC_PANEL_X + 48 + i32(lane) * 84
+				draw_text_c(v, lane_name, bx, ty, 12, NOC_LABEL)
+				q := p.q[lane]
+				level := noc_level(q * 1000 / bound, amber_pct, red_pct)
+				noc_bar(v, bx + 14, ty + 5, 60, f32(q) / f32(bound), level)
+				draw_text_c(v, fmt.tprintf("%d", q), bx + 14 + 60, ty, 14, NOC_TXT_DIM)
+			}
+		}
+		cur += 1
+		qshown += 1
+	}
+
+	// --- pool utilization vs the E22 cap (canon-colored bar) -----------------
+	cur = noc_section(v, cur, scroll, visible, "POOL VS E22 CAP")
+	cap := u32(max(1, cat.balance.pool_max_packets))
+	pool_line2 := fmt.tprintf("in-flight %d / %d  %d%%", pool, cap, u32(pool) * 100 / cap)
+	if noc_row_visible(cur, scroll, visible) {
+		ty := noc_row_y(cur, scroll)
+		draw_text_c(v, pool_line2, NOC_PANEL_X + 6, ty, 14, NOC_TXT_DIM)
+		level := noc_level(pool * 1000 / cap, amber_pct, red_pct)
+		noc_bar(v, NOC_PANEL_X + 150, ty + 5, 200, f32(pool) / f32(cap), level)
+	}
+	cur += 1
+
+	// --- pipes at/over 100% (raw) --------------------------------------------
+	cur = noc_section(v, cur, scroll, visible, "PIPES AT/OVER 100% (RAW)")
+	pshown := 0
+	for p in stats.pipes {
+		if pshown >= 8 {
+			break
+		}
+		if p.cap_units <= 0 || p.carried < u64(p.cap_units) {
+			continue
+		}
+		raw := p.carried * 100 / u64(p.cap_units)
+		line := fmt.tprintf("P%d tier%d  raw %d%%  (%d/%d)", p.pipe, p.tier, raw, p.carried, p.cap_units)
+		cur = noc_row(v, cur, scroll, visible, line, 14, NOC_RED)
+		pshown += 1
+	}
+
+	// --- selected-pipe readout (5.7, absorbed) -------------------------------
+	if sel_pipe >= 0 {
+		ps, ok := pp.pipe_slot(topo, u32(sel_pipe))
+		if ok {
+			cur = noc_section(v, cur, scroll, visible, fmt.tprintf("PIPE %d (TIER %d)", u32(sel_pipe), topo.pipe_tier[ps]))
+			for p in stats.pipes {
+				if p.pipe != u32(sel_pipe) {
+					continue
+				}
+				cur = noc_row(v, cur, scroll, visible, fmt.tprintf("offered %d / cap %d  util %d%%", p.offered, p.cap_units, p.util_pct), 14, NOC_TXT_DIM)
+				cur = noc_row(v, cur, scroll, visible, fmt.tprintf("carried %d  dropped %d  q [%d %d %d]", p.carried, p.dropped, p.q[0], p.q[1], p.q[2]), 14, NOC_TXT_DIM)
+				drops_line := ""
+				first := true
+				for d in stats.drops {
+					if d.pipe != p.pipe {
+						continue
+					}
+					if !first {
+						drops_line = fmt.tprintf("%s, ", drops_line)
+					}
+					first = false
+					cls := "?"
+					if int(d.class) < len(cat.packet_types) {
+						cls = cat.packet_types[d.class].display
+					}
+					drops_line = fmt.tprintf("%s%s %s x%d", drops_line, cls, noc_reason_label(d.reason), d.count)
+				}
+				if first {
+					drops_line = "no drops this tick"
+				}
+				cur = noc_row(v, cur, scroll, visible, fmt.tprintf("drops: %s", drops_line), 14, NOC_AMBER)
+				break
+			}
+		}
+	}
+
+	// --- live event tail (5.7, absorbed — all tags, newest first) ------------
+	cur = noc_section(v, cur, scroll, visible, "EVENTS (TAIL)")
+	n := len(events)
+	shown_events := 0
+	for i := n - 1; i >= 0 && shown_events < 8; i -= 1 {
+		cur = noc_row(v, cur, scroll, visible, event_tail_line(cat, events[i]), 14, NOC_TXT_DIM)
+		shown_events += 1
+	}
+	if shown_events == 0 {
+		cur = noc_row(v, cur, scroll, visible, "(no events yet - draw pipes, deliver packets)", 14, NOC_LABEL)
+	}
+
+	// --- the drop log (the NOC alarm feed — last section, zebra, scroll) ----
+	cur = noc_section(v, cur, scroll, visible, fmt.tprintf("DROP LOG (LAST %d, WHEEL)", feed.log_n))
+	shown_log := 0
+	for i in 0..<min(12, feed.log_n) {
+		if noc_row_visible(cur, scroll, visible) {
+			ty := noc_row_y(cur, scroll)
+			// zebra striping (readability ruling #5): alternate-row tint
+			if shown_log % 2 == 0 {
+				rl.DrawRectangle(NOC_PANEL_X + 2, ty - 2, NOC_PANEL_W - 4, NOC_ROW_H, NOC_ZEBRA)
+			}
+			draw_text_c(v, noc_log_line(topo, bundles, cat, feed, u32(i)), NOC_PANEL_X + 6, ty, 14, NOC_AMBER)
+		}
+		cur += 1
+		shown_log += 1
+	}
+	if feed.log_n == 0 {
+		cur = noc_row(v, cur, scroll, visible, "(no drops yet)", 14, NOC_LABEL)
+	}
+}
+
+// noc_reject_kind_label — the freshest rejection kind's compact label (or
+// "none"). The feed tracks reject_last_kind at feed time (kind buckets are
+// not ordered by recency). ASCII dev-tool labels — the app's reject_label
+// prose lives in main.odin, out of the render package's reach.
+noc_reject_kind_label :: proc(feed: ^Noc_Feed) -> string {
+	if feed.reject_total == 0 {
+		return "none"
+	}
+	return noc_edit_error_label(pp.Edit_Error(feed.reject_last_kind))
+}
+
+// noc_edit_error_label — Edit_Error -> ASCII label (the dev-tool subset).
+noc_edit_error_label :: proc(err: pp.Edit_Error) -> string {
+	#partial switch err {
+	case .Router_Ports_Full: return "ports-full"
+	case .Span_Exceeds_Tier: return "span"
+	case .Terminal_To_Terminal: return "term-term"
+	case .Missing_Node: return "missing-node"
+	case .Self_Loop: return "self-loop"
+	case .Unknown_Tier: return "tier"
+	case .Missing_Pipe: return "missing-pipe"
+	case .Terminal_Demolish: return "term-demolish"
+	case .Invalid_Placement: return "placement"
+	case .Invalid_Weights: return "weights"
+	case .Not_An_Upgrade: return "not-upgrade"
+	case .Invalid_Era_Advance: return "era-advance"
+	case .Unknown_Class: return "class"
+	case .Invalid_Lane: return "lane"
+	case .Unknown_Node_Type: return "node-type"
+	case .Not_A_Junction: return "not-junction"
+	case .Unknown_Command: return "unknown-cmd"
+	}
+	return "reject"
+}
+
+// noc_log_line — format one drop-log row (fixed leading columns: tick, class,
+// reason — the right side resolves the bundle READ-ONLY at draw time): first
+// live pipe of the bundle (pipe id + the class's lane on it) + the canonical
+// endpoint node ids (bundle_lo/hi). E22 rows (no bundle) show "map-wide"; a
+// renumbered/vanished slot renders "gone" rather than misanchoring (the 5.7
+// slot-rebuild doctrine).
+noc_log_line :: proc(topo: ^pp.Topology, bundles: ^pp.Bundles, cat: ^pp.Catalogs, feed: ^Noc_Feed, i: u32) -> string {
+	e := noc_log_at(feed, i)
+	cls := "?"
+	if int(e.class) < len(cat.packet_types) {
+		cls = cat.packet_types[e.class].display
+	}
+	reason := noc_reason_label(e.reason)
+	if e.bundle == pp.NO_BUNDLE || int(e.bundle) >= len(bundles.bundle_lo) {
+		return fmt.tprintf("t%-6d %-5s %2s map-wide", e.tick, cls, reason)
+	}
+	// the first live pipe of this bundle (slot order — deterministic)
+	pipe := "p?"
+	lo := bundles.bundle_lo[e.bundle]
+	hi := bundles.bundle_hi[e.bundle]
+	pipe_id: u32 = 0
+	found := false
+	n := min(len(topo.pipe_alive), len(bundles.pipe_bundle))
+	for ps in 0..<n {
+		if topo.pipe_alive[ps] && bundles.pipe_bundle[ps] == e.bundle {
+			pipe_id = topo.pipe_id[ps]
+			pipe = fmt.tprintf("p%d", pipe_id)
+			found = true
+			break
+		}
+	}
+	if !found {
+		pipe = "gone"
+	}
+	// the dropped class's lane on this pipe (read-only; E/S/B)
+	lane := "?"
+	if found {
+		lane = noc_lane_letter(pp.qos_lane_of(topo, cat, pipe_id, e.class))
+	}
+	return fmt.tprintf("t%-6d %-5s %2s b%d %s (%d<->%d) L%s", e.tick, cls, reason, e.bundle, pipe, lo, hi, lane)
+}
+
+// event_tail_line — a human-readable one-liner for one event (5.7, absorbed;
+// ASCII only). The event payload fields are tag-conditional (types.odin) —
+// the switch maps each tag to its fields, never reading payload that isn't
+// there.
+event_tail_line :: proc(cat: ^pp.Catalogs, e: pp.Event) -> string {
+	cls := "?"
+	if int(e.class) < len(cat.packet_types) {
+		cls = cat.packet_types[e.class].display
+	}
+	switch e.tag {
+	case pp.EVENT_TAG_PACKET_ARRIVED:
+		return fmt.tprintf("t%d arrived", e.tick)
+	case pp.EVENT_TAG_RUN_WON:
+		return fmt.tprintf("t%d RUN WON", e.tick)
+	case pp.EVENT_TAG_RUN_LOST:
+		return fmt.tprintf("t%d RUN LOST", e.tick)
+	case pp.EVENT_TAG_PACKET_DROPPED:
+		return fmt.tprintf("t%d DROP %s %s", e.tick, cls, noc_reason_label(e.reason))
+	case pp.EVENT_TAG_SLA_THRESHOLD_CROSSED:
+		metric := "lat"
+		if e.metric == u8(pp.Sla_Metric.Loss) {
+			metric = "loss"
+		}
+		dir := "exit"
+		if e.direction == u8(pp.Sla_Direction.Enter) {
+			dir = "enter"
+		}
+		return fmt.tprintf("t%d SLA %s %s %s", e.tick, cls, metric, dir)
+	case pp.EVENT_TAG_WARNING_RAISED:
+		return fmt.tprintf("t%d warn %s #%d", e.tick, warning_sign_name(e.sign), e.target)
+	case pp.EVENT_TAG_WARNING_CLEARED:
+		return fmt.tprintf("t%d clear %s #%d", e.tick, warning_sign_name(e.sign), e.target)
+	case pp.EVENT_TAG_CRISIS_TRIGGERED:
+		arch := "?"
+		if int(e.archetype) < len(cat.crises) {
+			arch = cat.crises[e.archetype].display_name
+		}
+		return fmt.tprintf("t%d CRISIS %s cls=%s", e.tick, arch, cls)
+	case pp.EVENT_TAG_CRISIS_RESOLVED:
+		arch := "?"
+		if int(e.archetype) < len(cat.crises) {
+			arch = cat.crises[e.archetype].display_name
+		}
+		return fmt.tprintf("t%d resolve %s", e.tick, arch)
+	case pp.EVENT_TAG_GRACE_STARTED:
+		return fmt.tprintf("t%d grace %s", e.tick, cls)
+	case pp.EVENT_TAG_GRACE_EXPIRED:
+		return fmt.tprintf("t%d grace-out %s", e.tick, cls)
+	case pp.EVENT_TAG_METER_CHANGED:
+		return fmt.tprintf("t%d meter %d%%", e.tick, e.meter)
+	case pp.EVENT_TAG_PIPE_DRAWN:
+		return fmt.tprintf("t%d wire placed", e.tick)
+	case pp.EVENT_TAG_NODE_SPAWNED:
+		return fmt.tprintf("t%d node spawned", e.tick)
+	}
+	return fmt.tprintf("t%d evt %d", e.tick, e.tag)
+}
+
+// warning_sign_name — the Warning_Sign enum -> ASCII name (5.7, absorbed).
+warning_sign_name :: proc(sign: u8) -> string {
+	switch pp.Warning_Sign(sign) {
+	case .Node_Congested: return "node-amber"
+	case .Node_Critical: return "node-red"
+	case .Pipe_Congested: return "pipe-amber"
+	case .Pipe_Critical: return "pipe-red"
+	}
+	return "warn?"
+}
+
+} // when #config(PP_DEBUG, false)
diff --git a/app/render/noc_overlay_test.odin b/app/render/noc_overlay_test.odin
new file mode 100644
index 00000000..5aa0ac41
--- /dev/null
+++ b/app/render/noc_overlay_test.odin
@@ -0,0 +1,222 @@
+package render
+
+// noc_overlay_test.odin — the NOC feed's contract pins (the overlay's data
+// layer is UNGATED so these run in the standard gate-2 build):
+//
+//  1. Purity: noc_feed_scan never mutates its input slice (a render function
+//     that touches sim data is not a feature — the D-lesson ruling).
+//  2. Determinism: the same events -> the same feed, and incremental scans
+//     (the app's per-frame mark slices) == one-shot scans (the harness's
+//     full-buffer replay) — the app/harness parity contract.
+//  3. The 60-tick rolling window rolls and zero-fills across gaps.
+//  4. The 256-entry drop log wraps, newest-first.
+//  5. The taxonomy maps 1:1 to the code enums (unknown reason bytes land in
+//     "other", never mislabeled) + the drop ratio + rejection counting.
+
+import "core:testing"
+import pp "../../core"
+
+// noc_drop_event — a Packet_Dropped event with the payload fields the feed
+// reads (the tag-conditional payload contract, types.odin).
+noc_drop_event :: proc(tick: u64, class: u16, reason: pp.Drop_Reason, bundle: u32) -> pp.Event {
+	return pp.Event{tick = tick, tag = pp.EVENT_TAG_PACKET_DROPPED, class = class, reason = u8(reason), target = bundle}
+}
+
+@(test)
+noc_feed_scan_is_pure :: proc(t: ^testing.T) {
+	events := []pp.Event{
+		noc_drop_event(10, 0, .Queue_Overflow, 3),
+		noc_drop_event(10, 1, .Pool_Exhaustion, pp.NO_BUNDLE),
+		noc_drop_event(11, 0, .Queue_Overflow, 3),
+	}
+	before := make([]pp.Event, len(events))
+	defer delete(before)
+	copy(before, events)
+	f: Noc_Feed
+	noc_feed_scan(&f, events)
+	// the input slice must be byte-identical (read-only contract)
+	testing.expect(t, len(before) == len(events), "purity: slice length changed")
+	for i in 0..<len(events) {
+		testing.expectf(t, before[i] == events[i], "purity: event %d mutated", i)
+	}
+	// and the feed saw everything
+	testing.expect(t, f.drop_e9 == 2, "two E9 drops counted")
+	testing.expect(t, f.drop_pool == 1, "one E22 drop counted")
+	testing.expect(t, f.log_n == 3, "three log rows")
+}
+
+@(test)
+noc_feed_counts_by_reason :: proc(t: ^testing.T) {
+	events := []pp.Event{
+		noc_drop_event(1, 0, .Queue_Overflow, 3),
+		noc_drop_event(1, 0, .Queue_Overflow, 3),
+		noc_drop_event(1, 1, .Pool_Exhaustion, pp.NO_BUNDLE),
+		noc_drop_event(1, 2, .Pool_Exhaustion, pp.NO_BUNDLE),
+		noc_drop_event(1, 2, .Pool_Exhaustion, pp.NO_BUNDLE),
+		noc_drop_event(1, 0, pp.Drop_Reason(99), 3), // an unknown reason byte
+	}
+	f: Noc_Feed
+	noc_feed_scan(&f, events)
+	testing.expect(t, f.drop_e9 == 2, "E9 counter")
+	testing.expect(t, f.drop_pool == 3, "E22 counter")
+	testing.expect(t, f.drop_other == 1, "unknown reason -> other (never mislabeled)")
+	testing.expect(t, f.per_class[0] == 3, "class 0 cumulative")
+	testing.expect(t, f.per_class[1] == 1, "class 1 cumulative")
+	testing.expect(t, f.per_class[2] == 2, "class 2 cumulative")
+	testing.expect(t, noc_feed_rate_total(&f) == 6, "ring total == all 6 drops")
+	// the log: newest first, raw reason byte preserved
+	testing.expect(t, f.log_n == 6, "log holds all rows")
+	latest := noc_log_at(&f, 0)
+	testing.expect(t, latest.reason == 99, "unknown reason preserved raw in the log")
+	testing.expect(t, latest.tick == 1 && latest.bundle == 3, "newest row payload")
+	oldest := noc_log_at(&f, 5)
+	testing.expect(t, oldest.class == 0, "oldest row is the first drop")
+}
+
+@(test)
+noc_feed_incremental_equals_oneshot :: proc(t: ^testing.T) {
+	events := []pp.Event{
+		noc_drop_event(10, 0, .Queue_Overflow, 3),
+		noc_drop_event(10, 1, .Pool_Exhaustion, pp.NO_BUNDLE),
+		noc_drop_event(50, 0, .Queue_Overflow, 3),
+		noc_drop_event(50, 0, .Queue_Overflow, 3),
+		noc_drop_event(120, 1, .Pool_Exhaustion, pp.NO_BUNDLE),
+	}
+	// the app's per-frame mark slices (the split lands mid-tick, mid-gap)
+	inc: Noc_Feed
+	noc_feed_scan(&inc, events[:2])
+	noc_feed_scan(&inc, events[2:4])
+	noc_feed_scan(&inc, events[4:])
+	one: Noc_Feed
+	noc_feed_scan(&one, events)
+	testing.expect(t, inc == one, "incremental scan == one-shot scan (app/harness parity)")
+}
+
+@(test)
+noc_feed_ring_rolls_60 :: proc(t: ^testing.T) {
+	events := []pp.Event{
+		noc_drop_event(1, 0, .Queue_Overflow, 3),
+		noc_drop_event(70, 0, .Queue_Overflow, 3),
+	}
+	f: Noc_Feed
+	noc_feed_scan(&f, events)
+	// tick 1 fell out of the 60-tick window; tick 70's drop remains
+	testing.expect(t, noc_feed_rate_total(&f) == 1, "rate window holds only the last 60 ticks")
+	testing.expect(t, f.ring_tick == 70, "ring advanced to the newest tick")
+	testing.expect(t, noc_feed_rate_class(&f, 0) == 1, "class rate matches the window")
+	// cumulative counters are NOT windowed (since-start)
+	testing.expect(t, f.drop_e9 == 2, "cumulative counters keep the full run")
+}
+
+@(test)
+noc_feed_ring_gap_clears_all :: proc(t: ^testing.T) {
+	events := []pp.Event{
+		noc_drop_event(1, 0, .Queue_Overflow, 3),
+		noc_drop_event(100, 0, .Queue_Overflow, 3),
+	}
+	f: Noc_Feed
+	noc_feed_scan(&f, events)
+	testing.expect(t, noc_feed_rate_total(&f) == 1, "a >60-tick gap clears every ring slot exactly once")
+	testing.expect(t, f.drop_e9 == 2, "cumulative counters survive the gap")
+}
+
+@(test)
+noc_feed_log_wraps_256 :: proc(t: ^testing.T) {
+	events := make([dynamic]pp.Event, 0, 300)
+	defer delete(events)
+	for i in 0..<300 {
+		append(&events, noc_drop_event(u64(1 + i), u16(i % 3), .Queue_Overflow, 3))
+	}
+	f: Noc_Feed
+	noc_feed_scan(&f, events[:])
+	testing.expect(t, f.log_n == NOC_LOG_CAP, "log capped at 256")
+	// newest first: row 0 == event 299, row 255 == event 44 (300 - 256)
+	n := noc_log_at(&f, 0)
+	testing.expect(t, n.tick == 300, "newest row is the last drop")
+	o := noc_log_at(&f, 255)
+	testing.expect(t, o.tick == 45, "oldest retained row is event 44 (1-based 45)")
+}
+
+@(test)
+noc_feed_taxonomy_labels :: proc(t: ^testing.T) {
+	// the 1:1 mapping to the Drop_Reason enum (acceptance: taxonomy maps to
+	// code enums — an unknown byte is a finding, rendered "??")
+	testing.expect(t, noc_reason_label(u8(pp.Drop_Reason.Queue_Overflow)) == "E9", "Queue_Overflow -> E9")
+	testing.expect(t, noc_reason_label(u8(pp.Drop_Reason.Pool_Exhaustion)) == "E22", "Pool_Exhaustion -> E22")
+	testing.expect(t, noc_reason_label(99) == "??", "unknown reason -> ??")
+	testing.expect(t, noc_lane_letter(pp.LANE_EXPRESS) == "E", "lane 0 -> E")
+	testing.expect(t, noc_lane_letter(pp.LANE_STANDARD) == "S", "lane 1 -> S")
+	testing.expect(t, noc_lane_letter(pp.LANE_BEST_EFFORT) == "B", "lane 2 -> B")
+	testing.expect(t, noc_lane_letter(7) == "?", "out-of-domain lane -> ?")
+}
+
+@(test)
+noc_feed_drop_ratio_math :: proc(t: ^testing.T) {
+	f: Noc_Feed
+	f.drop_e9 = 2
+	f.drop_pool = 1
+	testing.expect(t, noc_feed_drop_ratio(&f, 7) == 30, "3 drops / 10 completed = 30%")
+	testing.expect(t, noc_feed_drop_ratio(&f, 0) == 100, "all demand dropped = 100%")
+	empty: Noc_Feed
+	testing.expect(t, noc_feed_drop_ratio(&empty, 0) == 0, "nothing completed -> 0, no div-by-zero")
+}
+
+@(test)
+noc_feed_rejections :: proc(t: ^testing.T) {
+	f: Noc_Feed
+	noc_feed_reject(&f, .Router_Ports_Full)
+	noc_feed_reject(&f, .Router_Ports_Full)
+	noc_feed_reject(&f, .Span_Exceeds_Tier)
+	testing.expect(t, f.reject_total == 3, "rejection total")
+	testing.expect(t, f.reject_kind[12] == 2, "Router_Ports_Full bucket (enum value 12)")
+	testing.expect(t, f.reject_kind[6] == 1, "Span_Exceeds_Tier bucket (enum value 6)")
+	testing.expect(t, f.reject_last_kind == 6, "freshest kind tracked")
+}
+
+@(test)
+noc_feed_class_beyond_table :: proc(t: ^testing.T) {
+	events := []pp.Event{
+		noc_drop_event(1, 200, .Queue_Overflow, 3), // out-of-roster class
+		noc_drop_event(1, 0, .Queue_Overflow, 3),
+	}
+	f: Noc_Feed
+	noc_feed_scan(&f, events)
+	testing.expect(t, f.drop_other == 1, "out-of-roster class -> other (a finding, not a crash)")
+	testing.expect(t, f.per_class[0] == 1, "in-roster class still counted")
+	testing.expect(t, f.log_n == 2, "both rows logged")
+}
+
+@(test)
+noc_feed_crisis_counts :: proc(t: ^testing.T) {
+	events := []pp.Event{
+		{tick = 100, tag = pp.EVENT_TAG_CRISIS_TRIGGERED, cause = u8(pp.Root_Cause_Kind.Saturated_Bundle), class = 1, target = 3, pipe = 9},
+		{tick = 200, tag = pp.EVENT_TAG_CRISIS_TRIGGERED, cause = u8(pp.Root_Cause_Kind.Pool_Exhaustion)},
+		{tick = 300, tag = pp.EVENT_TAG_CRISIS_RESOLVED, cause = u8(pp.Root_Cause_Kind.Saturated_Bundle)},
+	}
+	f: Noc_Feed
+	noc_feed_scan(&f, events)
+	testing.expect(t, f.crisis_sat == 1, "Saturated_Bundle triggers counted")
+	testing.expect(t, f.crisis_pool == 1, "Pool_Exhaustion triggers counted")
+	testing.expect(t, f.crisis_last_bundle == 3 && f.crisis_last_pipe == 9, "latest Saturated_Bundle target captured")
+	testing.expect(t, f.crisis_last_class == 1, "latest crisis class captured")
+	testing.expect(t, f.drop_e9 == 0 && f.log_n == 0, "crisis events are not drops")
+}
+
+@(test)
+noc_level_uses_the_canon_ladder :: proc(t: ^testing.T) {
+	// the readability ruling #4: bars/tints color from balance.json warnings
+	// (pipe_amber_pct=70 / pipe_red_pct=90 — the game's own telegraph), never
+	// a dev-tool-invented ladder. 1000 permille = 100%.
+	amber :: 70
+	red :: 90
+	testing.expect(t, noc_level(0, amber, red) == .Normal, "0% is normal")
+	testing.expect(t, noc_level(699, amber, red) == .Normal, "69.9% is normal (below the canon amber)")
+	testing.expect(t, noc_level(700, amber, red) == .Amber, "70% is amber (the canon threshold)")
+	testing.expect(t, noc_level(899, amber, red) == .Amber, "89.9% is still amber")
+	testing.expect(t, noc_level(900, amber, red) == .Red, "90% is red (the canon critical threshold)")
+	testing.expect(t, noc_level(1000, amber, red) == .Red, "100% (the bound) is red")
+	// a disabled threshold never trips its tier (the catalog -1 default)
+	testing.expect(t, noc_level(1000, -1, 90) == .Red, "amber disabled: 100% still red")
+	testing.expect(t, noc_level(1000, 70, -1) == .Amber, "red disabled: amber still trips at 100%")
+	testing.expect(t, noc_level(1000, -1, -1) == .Normal, "both disabled: nothing trips")
+}
