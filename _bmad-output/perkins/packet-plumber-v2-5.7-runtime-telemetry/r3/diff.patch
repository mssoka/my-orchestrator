+package main
+
+// stats.odin — Story 5.7's harness-side pin: `stats-check <demo>` proves the
+// per-tick stats stream is REPLAY-IDENTICAL by running the demo through the
+// REAL live path (run_demo) and the REAL replay path (run_replay, from the
+// blessed log), then byte-comparing the two streams. This is the AC1 pin — the
+// "two runs of the same demo produce byte-identical files" contract, exercised
+// through the actual sim loops (no duplicate loop, no hand-rolled comparison —
+// the derivation must survive the real replay gate).
+//
+// Live == replay is the strongest form of "two runs identical": the replay
+// re-creates the run setup identically (fixture + spawns + session + pause
+// schedule), re-applies the blessed log, and steps the same sim ticks — so a
+// byte-difference means the stats derivation is NOT a pure function of state
+// (e.g. a map iteration, a temp-arena string, a clock read). Fail loud.
+
+import "core:fmt"
+import "core:os"
+import pp "../core"
+
+// stats_check — run <demo> live + replay, both writing stats streams to temp
+// files, byte-compare. Returns 0 on identical, 1 on difference/failure.
+stats_check :: proc(demo: string, cat: ^pp.Catalogs) -> i32 {
+	// the paths must be DEFAULT-allocated (aprintf, not tprintf): run_demo's
+	// per-tick free_all recycles the temp arena, and the stream write is a
+	// DEFER (runs after the loop) — a temp path would be recycled garbage.
+	// N2 (Perkins r1): write under gitignored bin/ (not predictable /tmp —
+	// symlink/collision, and not portable to the Windows target).
+	live_path := fmt.aprintf("bin/pp-stats-%s-live.csv", demo)
+	replay_path := fmt.aprintf("bin/pp-stats-%s-replay.csv", demo)
+	defer delete(live_path)
+	defer delete(replay_path)
+	defer os.remove(live_path)
+	defer os.remove(replay_path)
+
+	// the live half: run_demo with a ZERO Render_Ctx (rc.ready=false skips the
+	// T2 captures — the pin only needs the sim + the stream) + the stats path.
+	// run_demo also runs the in-run replay gate + the manifest check — a green
+	// run_demo is the precondition; a red one is a real failure, not a pin skip.
+	rc: Render_Ctx
+	if !run_demo(demo, false, cat, &rc, live_path) {
+		fmt.eprintfln("stats-check: %s: live run failed (see above)", demo)
+		return 1
+	}
+
+	// the replay half: from the BLESSED log (the real replay path, ODN-11).
+	man, okm := read_manifest(manifest_path(demo))
+	if !okm {
+		fmt.eprintfln("stats-check: %s: no manifest (bless first)", demo)
+		return 1
+	}
+	if code := run_replay(demo, log_path(demo), cat, replay_path); code != 0 {
+		fmt.eprintfln("stats-check: %s: replay failed (see above)", demo)
+		return 1
+	}
+
+	live, lerr := os.read_entire_file_from_path(live_path, context.temp_allocator)
+	if lerr != nil {
+		fmt.eprintfln("stats-check: %s: cannot read live stream: %v", demo, lerr)
+		return 1
+	}
+	replay, rerr := os.read_entire_file_from_path(replay_path, context.temp_allocator)
+	if rerr != nil {
+		fmt.eprintfln("stats-check: %s: cannot read replay stream: %v", demo, rerr)
+		return 1
+	}
+	_ = man // the manifest was the replay precondition; its hashes pin the state
+
+	if len(live) != len(replay) {
+		fmt.eprintfln("stats-check: %s: FAIL — live %d bytes vs replay %d bytes (stream lengths differ)",
+			demo, len(live), len(replay))
+		return 1
+	}
+	for i in 0..<len(live) {
+		if live[i] != replay[i] {
+			fmt.eprintfln("stats-check: %s: FAIL — first divergence at byte %d (live %02x vs replay %02x)",
+				demo, i, live[i], replay[i])
+			return 1
+		}
+	}
+	fmt.printf("  stats %-20s live == replay (%d bytes, byte-identical)\n", demo, len(live))
+	return 0
+}
