+	testing.expect(t, len(stream_a) > len("# pp stats stream"), "the stream must carry data rows")
+}
+
+@(test)
+test_stats_replay_identity :: proc(t: ^testing.T) {
+	cat: Catalogs
+	test_catalog(&cat)
+	defer catalogs_destroy(&cat)
+
+	// live run: congested, stepped 1..20
+	live: Run_State
+	run_init(&live, 7, TEST_CATALOG_HASH, TEST_LOGIC_HZ)
+	test_congested_run(&live, &cat)
+	live_stream := stats_stream_of(&live, 20, &cat)
+	defer delete(live_stream)
+
+	// replay: fresh state, the SAME action log (the replay gate convention) —
+	// the run setup (fixture + demand) is re-created identically, commands
+	// re-applied from the log. Note: test_congested_run also LOWERS the log,
+	// so the replay applies the same commands at the same ticks.
+	log_clone := clone_log(live.action_log)
+	run_destroy(&live)
+
+	replay: Run_State
+	run_init(&replay, 7, TEST_CATALOG_HASH, TEST_LOGIC_HZ)
+	// re-create the run setup WITHOUT re-lowering the log (fresh demand)
+	r, g, h := test_seed_fixture(&replay, &cat)
+	for i in 0..<20 {
+		flow_seed_demand(&replay.flow, u64(1+i*2), r, h, 0)
+		flow_seed_demand(&replay.flow, u64(2+i*2), h, r, 1)
+	}
+	for cmd in log_clone {
+		append(&replay.action_log, cmd)
+	}
+	delete(log_clone)
+	replay_stream := stats_stream_of(&replay, 20, &cat)
+	defer delete(replay_stream)
+	run_destroy(&replay)
+
+	testing.expect(t, live_stream == replay_stream, "live and replay must produce byte-identical stats streams")
+}
+
+@(test)
+test_stats_absent_when_empty :: proc(t: ^testing.T) {
+	cat: Catalogs
+	test_catalog(&cat)
+	defer catalogs_destroy(&cat)
+	state: Run_State
+	run_init(&state, 1, TEST_CATALOG_HASH, TEST_LOGIC_HZ)
+	defer run_destroy(&state)
+	// NO fixture, NO demand, NO draws — an idle seeded run (the boot shape)
+	stream := stats_stream_of(&state, 5, &cat)
+	defer delete(stream)
+	// only G rows: no C/P/D lines
+	lines := strings.split_lines(stream)
+	defer delete(lines)
+	for line in lines {
+		if len(line) == 0 || line[0] == '#' {
+			continue
+		}
