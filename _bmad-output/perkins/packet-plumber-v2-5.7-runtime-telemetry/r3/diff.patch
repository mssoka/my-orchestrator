+
+// test_stats_csv_literal_rows — R2-N9 (Perkins r2): pin one LITERAL CSV row of
+// each kind (G/C/P/D) against a known record — a column swap or field-order
+// drift changes the literal and fails even though both live + replay carry the
+// same (wrong) bytes. The values are hand-built (not derived) so the pin is
+// the FORMAT + passthroughs (gen/score/meter ride the G row unmodified).
+@(test)
+test_stats_csv_literal_rows :: proc(t: ^testing.T) {
+	// a hand-built record with recognizable field values
+	rec: Stats_Record
+	rec.tick = 7
+	rec.gen = 11
