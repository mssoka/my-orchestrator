@@ -0,0 +1,289 @@
+package render
+
+// debug_overlay.odin — Story 5.7's debug overlay (arch §7.6): toggled by `D`
+// (regular key; PP_DEBUG builds only). Drawn ON TOP of the normal HUD, so the
+// player sees the sim's numbers live: per-pipe readout (on select), per-class
+// table, congestion heat (pipes tinted by utilization %), the global line,
+// and the live event tail. The DATA is the SAME per-step stats record the
+// --stats-out stream pins (core/stats.odin) — the numbers under `D` are the
+// numbers the harness byte-compares. Read-only: never drains events, never
+// steps, never mutates sim state (ODN-1).
+//
+// Golden safety — THREE layers: (1) the whole file is compile-gated by
+// `when #config(PP_DEBUG, false)` — a build without `-define:PP_DEBUG=true`
+// (release app, EVERY harness build) compiles an EMPTY file, so the overlay
+// cannot exist in the harness capture path; (2) the overlay is OFF by default
+// (the D key toggles it); (3) the capture path (capture_frame) never calls
+// this — only the app's HUD pass and the PP_DEBUG `overlay-check` harness
+// verb do. AC4 by construction.
+//
+// The params are explicit (not an app handle) so the PP_DEBUG harness verb
+// `overlay-check` can render the SAME overlay over a demo frame — the AC3
+// verification (real numbers against a congested run) uses the shipped code.
+// All strings ASCII (the byte-truncating draw_text_c — lint gate 6).
+
+import "core:fmt"
+import pp "../../core"
+import rl "vendor:raylib"
+
+when #config(PP_DEBUG, false) {
+
+// OVERLAY_PANEL — the overlay's right-column panel geometry (the run HUD owns
+// the left/top/bottom; the overlay takes the right column below the forecast
+// panel). Monospace-ish 12-14px text, translucent dark panel for legibility.
+OVERLAY_PANEL_X :: 1280 - 372
+OVERLAY_PANEL_Y :: 96
+OVERLAY_PANEL_W :: 360
+OVERLAY_PANEL_H :: 600
+OVERLAY_ROW_H :: 14
+
+// heat_color — map a pipe's util_pct to its heat color (the threshold ladder
+// the briefing names: <50 clear, 50-69 amber, 70-89 orange, >=90 red — the
+// congested link pops at a glance). Colors are a fixed debug ladder; alpha
+// blends over the light canvas.
+heat_color :: proc(util_pct: u32) -> rl.Color {
+	switch {
+	case util_pct >= 90:
+		return {230, 70, 60, 170} // critical red
+	case util_pct >= 70:
+		return {240, 140, 50, 160} // orange
+	case util_pct >= 50:
+		return {230, 190, 60, 150} // amber
+	}
+	return {0, 0, 0, 0} // clear — no tint below 50%
+}
+
+// draw_debug_overlay — the whole surface. Called from the app's render pass
+// (after draw_hud) and the harness `overlay-check` verb (a PP_DEBUG demo
+// render). `sel_pipe` is the selected pipe id or -1 (the harness passes -1 —
+// the readout section draws nothing).
+draw_debug_overlay :: proc(v: ^View, topo: ^pp.Topology, cat: ^pp.Catalogs,
+	stats: ^pp.Stats_Record, events: []pp.Event, sel_pipe: i64) {
+	draw_heat_tints(v, topo, stats)
+	draw_overlay_panel(v, topo, cat, stats, events, sel_pipe)
+}
+
+// draw_heat_tints — the congestion heat: translucent strokes over every live
+// pipe whose bundle's util_pct crossed the ladder. Draws the util% label on
+// congested pipes too (numbers, not color alone — the telegraph discipline).
+draw_heat_tints :: proc(v: ^View, topo: ^pp.Topology, stats: ^pp.Stats_Record) {
+	for p in stats.pipes {
+		col := heat_color(p.util_pct)
+		if col.a == 0 {
+			continue // healthy — no tint
+		}
+		ps, ok := pp.pipe_slot(topo, p.pipe)
+		if !ok {
+			continue
+		}
+		// R2-N7 (Perkins r2): guard node_slot's ok like pipe_slot's — a dead/
+		// tombstoned endpoint must skip the tint, never index node_pos on a
+		// missing slot (the selected pipe can die under a junction batch).
+		sa, oka := pp.node_slot(topo, topo.pipe_a[ps])
+		sb, okb := pp.node_slot(topo, topo.pipe_b[ps])
+		if !oka || !okb {
+			continue
+		}
+		ax := node_screen(v, topo.node_pos[sa])
+		bx := node_screen(v, topo.node_pos[sb])
+		rl.DrawLineEx(ax, bx, 10, col)
+		// the util% label at the pipe's midpoint (only when congested)
+		mid := rl.Vector2{(ax.x + bx.x) / 2, (ax.y + bx.y) / 2}
+		label := fmt.tprintf("%d%%", p.util_pct)
+		draw_text_c(v, label, i32(mid.x) + 4, i32(mid.y) - 8, 12, rl.Color{40, 40, 40, 255})
+	}
+}
+
+// draw_overlay_panel — the right-column panel: global line, per-class table,
+// the selected pipe's readout, and the event tail.
+draw_overlay_panel :: proc(v: ^View, topo: ^pp.Topology, cat: ^pp.Catalogs,
+	stats: ^pp.Stats_Record, events: []pp.Event, sel_pipe: i64) {
+	x := i32(OVERLAY_PANEL_X)
+	y := i32(OVERLAY_PANEL_Y)
+	// the translucent panel behind everything (legibility over the map)
+	rl.DrawRectangle(x - 8, y - 10, OVERLAY_PANEL_W + 16, OVERLAY_PANEL_H + 20, rl.Color{20, 24, 30, 190})
+
+	draw_text_c(v, "DEBUG OVERLAY (D)", x, y, 14, rl.Color{240, 240, 240, 255})
+	y += 22
+
+	// --- global line: tick, gen, sim hash, score, meter --------------------
+	glob := fmt.tprintf("tick %d  gen %d  score %d  meter %d%%",
+		stats.tick, stats.gen, stats.score, stats.meter)
+	draw_text_c(v, glob, x, y, 13, rl.Color{210, 220, 230, 255})
+	y += OVERLAY_ROW_H
+	hash := fmt.tprintf("hash %016x", stats.sim_hash)
+	draw_text_c(v, hash, x, y, 12, rl.Color{160, 170, 185, 255})
+	y += OVERLAY_ROW_H + 4
+
+	// --- per-class table -----------------------------------------------------
+	draw_text_c(v, "class   dem  del  drop loss%  avgms  SLA", x, y, 12, rl.Color{150, 160, 175, 255})
+	y += OVERLAY_ROW_H
+	// cap the rows like the SLA gauges do — the catalog roster is data-driven
+	// and the panel is fixed-size; a fuller roster gets a proper panel later.
+	shown_classes := 0
+	for c in stats.classes {
+		if shown_classes >= 8 {
+			break
+		}
+		if int(c.class) >= len(cat.packet_types) {
+			continue
+		}
+		name := cat.packet_types[c.class].display
+		sla := "ok"
+		col := rl.Color{210, 220, 230, 255}
+		if c.sla_lat && c.sla_loss {
+			sla = "LAT+LOSS"
+			col = rl.Color{240, 110, 100, 255}
+		} else if c.sla_lat {
+			sla = "LAT"
+			col = rl.Color{240, 170, 90, 255}
+		} else if c.sla_loss {
+			sla = "LOSS"
+			col = rl.Color{240, 170, 90, 255}
+		}
+		row := fmt.tprintf("%-6s %4d %4d %4d %4d%% %5dms %s",
+			name, c.demand, c.delivered, c.dropped, c.loss_pct, c.avg_latency_ms, sla)
+		draw_text_c(v, row, x, y, 12, col)
+		y += OVERLAY_ROW_H
+		shown_classes += 1
+	}
+	y += 4
+
+	// --- per-pipe readout (on select) ---------------------------------------
+	if sel_pipe >= 0 {
+		ps, ok := pp.pipe_slot(topo, u32(sel_pipe))
+		if ok {
+			draw_text_c(v, fmt.tprintf("PIPE %d (tier %d)", u32(sel_pipe), topo.pipe_tier[ps]),
+				x, y, 13, rl.Color{240, 240, 240, 255})
+			y += OVERLAY_ROW_H
+			for p in stats.pipes {
+				if p.pipe != u32(sel_pipe) {
+					continue
+				}
+				draw_text_c(v, fmt.tprintf("offered %d / cap %d  util %d%%", p.offered, p.cap_units, p.util_pct),
+					x, y, 12, rl.Color{220, 230, 240, 255})
+				y += OVERLAY_ROW_H
+				draw_text_c(v, fmt.tprintf("carried %d  dropped %d  q [%d %d %d]", p.carried, p.dropped, p.q[0], p.q[1], p.q[2]),
+					x, y, 12, rl.Color{200, 210, 225, 255})
+				y += OVERLAY_ROW_H
+				draw_text_c(v, fmt.tprintf("lanes w [%d %d %d]  caps [%d %d %d]", p.w[0], p.w[1], p.w[2], p.c[0], p.c[1], p.c[2]),
+					x, y, 12, rl.Color{180, 190, 205, 255})
+				y += OVERLAY_ROW_H
+				// this pipe's drops by class + reason (the D rows)
+				drops_line := ""
+				first := true
+				for d in stats.drops {
+					if d.pipe != p.pipe {
+						continue
+					}
+					if !first {
+						drops_line = fmt.tprintf("%s, ", drops_line)
+					}
+					first = false
+					cls := "?"
+					if int(d.class) < len(cat.packet_types) {
+						cls = cat.packet_types[d.class].display
+					}
+					reason := "overflow"
+					if d.reason == u8(pp.Drop_Reason.Pool_Exhaustion) {
+						reason = "pool"
+					}
+					drops_line = fmt.tprintf("%s%s %s x%d", drops_line, cls, reason, d.count)
+				}
+				if first {
+					drops_line = "no drops this tick"
+				}
+				draw_text_c(v, fmt.tprintf("drops: %s", drops_line), x, y, 12, rl.Color{230, 180, 140, 255})
+				y += OVERLAY_ROW_H
+				break
+			}
+			y += 4
+		}
+	}
+
+	// --- live event tail (last 8, newest first; read-only tail scan) --------
+	draw_text_c(v, "events", x, y, 12, rl.Color{150, 160, 175, 255})
+	y += OVERLAY_ROW_H
+	n := len(events)
+	shown := 0
+	for i := n - 1; i >= 0 && shown < 8; i -= 1 {
+		e := events[i]
+		line := event_tail_line(cat, e)
+		draw_text_c(v, line, x, y, 12, rl.Color{200, 210, 225, 255})
+		y += OVERLAY_ROW_H
+		shown += 1
+	}
+	if shown == 0 {
+		draw_text_c(v, "(no events yet - draw pipes, deliver packets)", x, y, 12, rl.Color{150, 160, 175, 255})
+	}
+}
+
+// event_tail_line — a human-readable one-liner for one event (ASCII only).
+// The event payload fields are tag-conditional (types.odin) — the switch maps
+// each tag to its fields, never reading payload that isn't there.
+event_tail_line :: proc(cat: ^pp.Catalogs, e: pp.Event) -> string {
+	cls := "?"
+	if int(e.class) < len(cat.packet_types) {
+		cls = cat.packet_types[e.class].display
+	}
+	switch e.tag {
+	case pp.EVENT_TAG_PACKET_ARRIVED:
+		return fmt.tprintf("t%d arrived", e.tick)
+	case pp.EVENT_TAG_RUN_WON:
+		return fmt.tprintf("t%d RUN WON", e.tick)
+	case pp.EVENT_TAG_RUN_LOST:
+		return fmt.tprintf("t%d RUN LOST", e.tick)
+	case pp.EVENT_TAG_PACKET_DROPPED:
+		reason := "overflow"
+		if e.reason == u8(pp.Drop_Reason.Pool_Exhaustion) {
+			reason = "pool"
+		}
+		return fmt.tprintf("t%d DROP %s %s", e.tick, cls, reason)
+	case pp.EVENT_TAG_SLA_THRESHOLD_CROSSED:
+		metric := "lat"
+		if e.metric == u8(pp.Sla_Metric.Loss) {
+			metric = "loss"
+		}
+		dir := "exit"
+		if e.direction == u8(pp.Sla_Direction.Enter) {
+			dir = "enter"
+		}
+		return fmt.tprintf("t%d SLA %s %s %s", e.tick, cls, metric, dir)
+	case pp.EVENT_TAG_WARNING_RAISED:
+		return fmt.tprintf("t%d warn %s #%d", e.tick, warning_sign_name(e.sign), e.target)
+	case pp.EVENT_TAG_WARNING_CLEARED:
+		return fmt.tprintf("t%d clear %s #%d", e.tick, warning_sign_name(e.sign), e.target)
+	case pp.EVENT_TAG_CRISIS_TRIGGERED:
+		arch := "?"
+		if int(e.archetype) < len(cat.crises) {
+			arch = cat.crises[e.archetype].display_name
+		}
+		return fmt.tprintf("t%d CRISIS %s cls=%s", e.tick, arch, cls)
+	case pp.EVENT_TAG_CRISIS_RESOLVED:
+		arch := "?"
+		if int(e.archetype) < len(cat.crises) {
+			arch = cat.crises[e.archetype].display_name
+		}
+		return fmt.tprintf("t%d resolve %s", e.tick, arch)
+	case pp.EVENT_TAG_GRACE_STARTED:
+		return fmt.tprintf("t%d grace %s", e.tick, cls)
+	case pp.EVENT_TAG_GRACE_EXPIRED:
+		return fmt.tprintf("t%d grace-out %s", e.tick, cls)
+	case pp.EVENT_TAG_METER_CHANGED:
+		return fmt.tprintf("t%d meter %d%%", e.tick, e.meter)
+	}
+	return fmt.tprintf("t%d evt %d", e.tick, e.tag)
+}
+
+// warning_sign_name — the Warning_Sign enum -> ASCII name (the tail lines).
+warning_sign_name :: proc(sign: u8) -> string {
+	switch pp.Warning_Sign(sign) {
+	case .Node_Strained: return "node-amber"
+	case .Node_Critical: return "node-red"
+	case .Pipe_Pressure: return "pipe-amber"
+	case .Pipe_Critical: return "pipe-red"
+	}
+	return "warn?"
+}
+
+} // when #config(PP_DEBUG, false)
diff --git a/core/stats.odin b/core/stats.odin
new file mode 100644
index 0000000..844a865
--- /dev/null
+++ b/core/stats.odin
@@ -0,0 +1,316 @@
+package core
+
+import "core:fmt"
+import "core:strings"
+
+// stats.odin — Story 5.7: the deterministic per-tick stats record (§7.6
+// "runtime telemetry"). This module EXPORTS what the sim already captures —
+// the flow's SLA accumulators, the bundle view (the pooled-link capacity
+// unit), the per-tick drop sites, the health meter, and the T1 state hash —
+// shaped into a per-tick record that the harness AND the app serialize
+// byte-identically (`--stats-out <path>`, CSV). The debug overlay (Part B)
+// reads the same record, so the numbers the player sees under `D` are exactly
+// the numbers the stream pins.
+//
+// The determinism contract (the briefing's spine): every field is a pure
+// function of the EXISTING deterministic state — no new capture semantics, no
+// wall-clock, no render sampling, no RNG draws. A same-seed + same-commands
+// run reproduces the identical stream; the harness `stats-check` verb pins it
+// through the real replay path.
+//
+// Integer-only (ODN-10); arrays only (ODN-10 — no map iteration anywhere);
+// no file/clock reads (ODN-1). The serializer is `stats_write_csv` — the ONE
+// writer both binaries share, so byte-identity is by construction.
+
+// --- row kinds ---------------------------------------------------------------
+
+// Stats_Class_Row — one per class with a demand row in flow.sla (0..len-1,
+// class-id order). All cumulative from the serialized SLA accumulators
+// (3.4): the loss% + avg-latency math is IDENTICAL to sla_evaluate (integer
+// division, monotone loss — an Exit cannot fire for Loss by contract); the
+// breach latches are the DERIVED per-class latch (rebuilt identically on
+// replay). Absent-when-empty: a run with no demand events emits no C rows.
+Stats_Class_Row :: struct {
+	class:     u16,
+	demand:    u64, // demand_seen (every spawn attempt — admitted or pool-dropped)
+	delivered: u64, // reached its dst (score ++)
+	dropped:   u64, // every loss: E9 sheds, E22 pool drops, the 2.3 silent cull
+	loss_pct:  u32, // dropped*100/(delivered+dropped), integer (0 when no completed demand)
+	avg_latency_ms: u64, // total_latency_ms/delivered, integer (0 when none delivered)
+	sla_lat:   bool, // the DERIVED breach latch: avg latency > latency_tol_ms
+	sla_loss:  bool, // the DERIVED breach latch: loss_pct > max_loss_pct
+}
+
+// Stats_Pipe_Row — one per LIVE pipe (slot order). The load columns (cap /
+// offered / carried / dropped / util / per-lane queues) are the pipe's
+// BUNDLE — the pooled link is the honest capacity unit (2.1): a parallel-pipe
+// bundle's members SHARE the same capacity, load, and queues, so every member
+// row reports the bundle's numbers (identical across members — the pool, not
+// the individual pipe, is what the flow serves). The lane columns (w, c) are
+// the pipe's OWN weights + the flow's derived per-pipe allocation.
+//
+// Metric definitions (documented in the PR body):
+//   carried  = queued packets on the bundle × packet_bandwidth (the in-flight
+//              load on the link at the step boundary — what it carries now).
+//   offered  = carried + this tick's drops on the bundle × packet_bandwidth
+//              (the demand that presented itself — on the link + shed).
+//   util_pct = min(100, carried × 100 / bundle_cap) — the congestion-heat
+//              number (a full lane bound reads 100%).
+//   dropped  = this tick's E9 drop count on the bundle (the D rows carry the
+//              class × reason breakdown).
+Stats_Pipe_Row :: struct {
+	pipe:     u32,  // pipe id (E11-stable)
+	tier:     u16,  // pipe_tiers index
+	cap_units: u32, // bundle_cap — the pooled STATIC capacity (rule 3)
+	offered:  u64,  // carried + dropped_units (bandwidth units)
+	carried:  u64,  // queued × packet_bandwidth (in-flight units)
+	dropped:  u32,  // this tick's E9 drops on the bundle
+	util_pct: u32,  // min(100, carried × 100 / cap_units)
+	// lane columns (this pipe's own dial + the flow's derived allocation):
+	w: [3]i32, // pipe_weights — the emphasis-dial weights (3.2)
+	c: [3]u32, // flow.lane_caps[ps] — the per-pipe WFQ allocation (3.3)
+	// per-lane queue depth on the BUNDLE (the pooled link's queue state):
+	q: [3]u32,
+}
+
+// Stats_Drop_Row — one per (live member pipe, class, reason) for THIS tick's
+// E9 bundle drops (drop_sites — the per-tick scratch the crisis engine reads,
+// appended during flow_step, cleared at the top of the next). A shed bundle's
+// drops replicate to every live member (the pooled link shed them); the row's
+// `count` is the AGGREGATED count of same-(pipe,class,reason) sheds this tick
+// (multiple sheds of one kind sum into one row). E22 pool drops are map-wide
+// (bundle == NO_BUNDLE) and ride the class rows only —
+// they are not attributable to a pipe. reason: 0 = Queue_Overflow (E9),
+// 1 = Pool_Exhaustion (E22 — never in a D row by construction).
+Stats_Drop_Row :: struct {
+	pipe:   u32,
+	class:  u16,
+	reason: u8,
+	count:  u32,
+}
+
+// Stats_Record — one per STEPPED sim tick. The harness emits one record after
+// each step (paused 5.3 wall ticks emit none — the state is stable, and the
+// drop sites are per-step scratch, so a paused record would be a lie).
+Stats_Record :: struct {
+	tick:     u64, // the sim tick (state.tick)
+	gen:      u32, // Topology.gen (edit counter)
+	sim_hash: u64, // the T1 state hash (the harness already computes it per tick)
+	score:    u32, // delivered-packet count (1.4)
+	meter:    u32, // health.meter_pct (raw — the health module pins the disabled state at 100)
+	classes:  [dynamic]Stats_Class_Row,
+	pipes:    [dynamic]Stats_Pipe_Row,
+	drops:    [dynamic]Stats_Drop_Row,
+}
+
+// stats_compute — derive the per-tick record from the EXISTING state (pure;
+// the caller passes the per-tick sim hash it already computed — the harness's
+// per-tick hash, the app's own state_hash — so the stream never re-derives
+// it). Deterministic: identical state + identical hash → identical record.
+stats_compute :: proc(state: ^Run_State, cat: ^Catalogs, sim_hash: u64,
+                      allocator := context.allocator) -> Stats_Record {
+	rec: Stats_Record
+	rec.tick = state.tick
+	rec.gen = state.topology.gen
+	rec.sim_hash = sim_hash
+	rec.score = state.score
+	// the meter rides raw: health.odin pins "the disabled state reads 100 too"
+	// (an inert FULL meter — 0 would falsely read as the loss condition). The
+	// health_enabled flag is the honest discriminator; the value is the meter's.
+	rec.meter = state.health.meter_pct
+	rec.classes = make([dynamic]Stats_Class_Row, 0, 8, allocator)
+	rec.pipes = make([dynamic]Stats_Pipe_Row, 0, 8, allocator)
+	rec.drops = make([dynamic]Stats_Drop_Row, 0, 4, allocator)
+
+	// --- per-class rows (class-id order; one per flow.sla row) --------------
+	for c in 0..<len(state.flow.sla) {
+		acc := &state.flow.sla[c]
+		row: Stats_Class_Row
+		row.class = u16(c)
+		row.demand = acc.demand_seen
+		row.delivered = acc.delivered
+		row.dropped = acc.dropped
+		demand := acc.delivered + acc.dropped // completed demand (E24 numerator)
+		if demand > 0 {
+			row.loss_pct = u32(acc.dropped * 100 / demand)
+		}
+		if acc.delivered > 0 {
+			row.avg_latency_ms = acc.total_latency_ms / acc.delivered
+		}
+		if int(c) < len(state.flow.sla_breach) {
+			row.sla_lat = state.flow.sla_breach[c][u8(Sla_Metric.Latency)]
+			row.sla_loss = state.flow.sla_breach[c][u8(Sla_Metric.Loss)]
+		}
+		append(&rec.classes, row)
+	}
+
+	// --- per-pipe rows (live pipes, slot order) ------------------------------
+	bw := u64(cat.balance.packet_bandwidth)
+	// this tick's E9 drop count per bundle (drop_sites is per-tick scratch —
+	// valid right after flow_step; E22 sites (NO_BUNDLE) are excluded — they
+	// ride the class rows). Iterating bundles by slot keeps the aggregation
+	// deterministic (ODN-10); the site order within a bundle is append order.
+	bundle_drops := make([dynamic]u32, state.bundles.n, state.bundles.n, allocator)
+	defer delete(bundle_drops)
+	for site in state.flow.drop_sites {
+		if site.bundle == NO_BUNDLE || int(site.bundle) >= len(bundle_drops) {
+			continue
+		}
+		bundle_drops[site.bundle] += 1
+	}
+	for ps in 0..<len(state.topology.pipe_alive) {
+		if !state.topology.pipe_alive[ps] {
+			continue
+		}
+		bs := u32(NO_BUNDLE)
+		if int(ps) < len(state.bundles.pipe_bundle) {
+			bs = state.bundles.pipe_bundle[ps]
+		}
+		row: Stats_Pipe_Row
+		row.pipe = state.topology.pipe_id[ps]
+		row.tier = state.topology.pipe_tier[ps]
+		if bs != NO_BUNDLE && int(bs) < len(state.bundles.bundle_cap) {
+			row.cap_units = state.bundles.bundle_cap[bs]
+		}
+		// per-lane queue depth on the bundle (the pooled link's queue state):
+		if bs != NO_BUNDLE {
+			for lane in 0..<LANE_COUNT {
+				row.q[lane] = bundle_lane_count(state, cat, bs, u8(lane))
+			}
+		}
+		queued := u64(row.q[0]) + u64(row.q[1]) + u64(row.q[2])
+		row.carried = queued * bw
+		dropped := u32(0)
+		if bs != NO_BUNDLE && int(bs) < len(bundle_drops) {
+			dropped = bundle_drops[bs]
+		}
+		row.dropped = dropped
+		row.offered = row.carried + u64(dropped) * bw
+		if row.cap_units > 0 {
+			pct := row.carried * 100 / u64(row.cap_units)
+			row.util_pct = u32(min(pct, 100))
+		}
+		// lane columns: this pipe's dial + the flow's derived per-pipe caps
+		if int(ps) < len(state.topology.pipe_weights) {
+			row.w = state.topology.pipe_weights[ps]
+		}
+		if int(ps) < len(state.flow.lane_caps) {
+			row.c = state.flow.lane_caps[ps]
+		}
+		append(&rec.pipes, row)
+	}
+
+	// --- per-tick E9 drop rows (aggregated per member pipe, class, reason) --
+	// drop_sites append order (deterministic); a shed bundle replicates to
+	// every live member (the pooled link shed them). E22 (NO_BUNDLE) sites are
+	// skipped — map-wide, class rows own them. Aggregated: one row per
+	// (pipe, class, reason) with the real count (multiple same-kind sheds in
+	// one tick sum into one row — the legend's `count` column is meaningful).
+	// Map-free (ODN-10): a linear find-or-append over the accumulating array
+	// (small per-tick sets; first-seen site order is deterministic).
+	for site in state.flow.drop_sites {
+		if site.bundle == NO_BUNDLE || int(site.bundle) >= int(state.bundles.n) {
+			continue
+		}
+		for ps in 0..<len(state.topology.pipe_alive) {
+			if !state.topology.pipe_alive[ps] {
+				continue
+			}
+			if int(ps) >= len(state.bundles.pipe_bundle) || state.bundles.pipe_bundle[ps] != site.bundle {
+				continue
+			}
+			pipe := state.topology.pipe_id[ps]
+			found := false
+			for i in 0..<len(rec.drops) {
+				d := &rec.drops[i]
+				if d.pipe == pipe && d.class == site.class && d.reason == u8(site.reason) {
+					d.count += 1
+					found = true
+					break
+				}
+			}
+			if !found {
+				append(&rec.drops, Stats_Drop_Row{
+					pipe = pipe,
+					class = site.class,
+					reason = u8(site.reason),
+					count = 1,
+				})
+			}
+		}
+	}
+
+	return rec
+}
+
+// stats_destroy — free the record's owned buffers (mirrors run_init/destroy
+// discipline — ODN-18).
+stats_destroy :: proc(rec: ^Stats_Record) {
+	delete(rec.classes)
+	delete(rec.pipes)
+	delete(rec.drops)
+	rec^ = {}
+}
+
+// stats_emit — the ONE per-step emission path (W9, Perkins r1): compute the
+// per-tick record from the just-stepped state + the per-tick sim hash, and
+// append its CSV rows to the stream builder. BOTH drivers call this — the
+// harness (run_demo / replay_hashes) and the app's step loop — so the app
+// loop's emission is pinned by the same code the harness runs (no divergent
+// twin). `sb` may be NIL (compute-only: the app with the overlay on but no
+// --stats-out still needs the record; nothing is appended). Returns the record
+// (the caller owns + destroys it: the harness destroys immediately after the
+// append; the app keeps it for the overlay).
+stats_emit :: proc(state: ^Run_State, cat: ^Catalogs, sim_hash: u64,
+                   sb: ^strings.Builder, allocator := context.allocator) -> Stats_Record {
+	rec := stats_compute(state, cat, sim_hash, allocator)
+	if sb != nil {
+		stats_write_csv(sb, &rec)
+	}
+	return rec
+}
+
+// --- the ONE CSV serializer (harness + app share it — byte-identity) --------
+
+// stats_write_header — the stream preamble: the row-schema legend as `#`
+// comment lines. Written once at the start of every stream (deterministic).
+stats_write_header :: proc(sb: ^strings.Builder) {
+	write_str(sb, "# pp stats stream v1 - deterministic per-tick stats (story 5.7; same seed + commands -> identical bytes)\n")
+	write_str(sb, "# G <tick>,<gen>,<sim_hash_hex>,<score>,<meter_pct>\n")
+	write_str(sb, "# C <tick>,<class>,<demand>,<delivered>,<dropped>,<loss_pct>,<avg_latency_ms>,<sla_lat>,<sla_loss>\n")
+	write_str(sb, "# P <tick>,<pipe>,<tier>,<cap_units>,<offered>,<carried>,<dropped>,<util_pct>,<wE>,<wS>,<wB>,<cE>,<cS>,<cB>,<qE>,<qS>,<qB>\n")
+	write_str(sb, "# D <tick>,<pipe>,<class>,<reason>,<count>   (E9 bundle drops; reason 0=Queue_Overflow)\n")
+}
+
+// stats_write_csv — append a record's rows to the builder (G, then C rows in
+// class order, then P rows in pipe-slot order, then D rows in site order).
+// Integer formatting only (ODN-10) — byte-deterministic by construction.
+stats_write_csv :: proc(sb: ^strings.Builder, rec: ^Stats_Record) {
+	fmt.sbprintf(sb, "G,%d,%d,%016x,%d,%d\n",
+		rec.tick, rec.gen, rec.sim_hash, rec.score, rec.meter)
+	for c in rec.classes {
+		fmt.sbprintf(sb, "C,%d,%d,%d,%d,%d,%d,%d,%d,%d\n",
+			rec.tick, c.class, c.demand, c.delivered, c.dropped,
+			c.loss_pct, c.avg_latency_ms, bool_to_u8(c.sla_lat), bool_to_u8(c.sla_loss))
+	}
+	for p in rec.pipes {
+		fmt.sbprintf(sb, "P,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d\n",
+			rec.tick, p.pipe, p.tier, p.cap_units, p.offered, p.carried, p.dropped, p.util_pct,
+			p.w[0], p.w[1], p.w[2], p.c[0], p.c[1], p.c[2], p.q[0], p.q[1], p.q[2])
+	}
+	for d in rec.drops {
+		fmt.sbprintf(sb, "D,%d,%d,%d,%d,%d\n",
+			rec.tick, d.pipe, d.class, d.reason, d.count)
+	}
+}
+
+// bool_to_u8 — 0/1 for the CSV (integers only).
+bool_to_u8 :: proc(b: bool) -> u8 {
+	return 1 if b else 0
+}
+
+// write_str — strings.write_string through the Builder (the CSV writer's tiny
+// escape hatch; fmt.sbprintf handles the rest).
+write_str :: proc(sb: ^strings.Builder, s: string) {
+	strings.write_string(sb, s)
+}
