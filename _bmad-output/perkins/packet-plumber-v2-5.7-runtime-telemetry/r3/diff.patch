diff --git a/harness/overlay.odin b/harness/overlay.odin
new file mode 100644
index 0000000..4b77c69
--- /dev/null
+++ b/harness/overlay.odin
@@ -0,0 +1,139 @@
+package main
+
+// overlay.odin — Story 5.7's AC3 verification verb: `overlay-check <demo> <ms>`
+// renders a demo frame WITH the debug overlay drawn on top (the SAME shipped
+// overlay code the app shows under `D` — render/debug_overlay.odin) and writes
+// a PNG to `bin/overlay-<demo>-<ms>.png` (gitignored — a verification artifact,
+// never committed) for the user to look at.
+// PP_DEBUG builds only: the whole file is compile-gated, so the plain harness
+// build (every golden run) carries zero overlay code — AC4 by construction.
+//
+// The overlay's DATA is the per-step stats record + the event tail — derived
+// through the REAL sim loop (the app's exact stepping shape: batch from the
+// action log at each tick's apply boundary). The overlay renders whatever the
+// sim produced; on a congested demo the panel shows real utilization + drops.
+
+import "core:fmt"
+import "core:os"
+import "core:strings"
+import pp "../core"
+import rnd "../app/render"
+import rl "vendor:raylib"
+
+when #config(PP_DEBUG, false) {
+
+// overlay_check — play <demo> up to the capture ms, render the frame + the
+// overlay, export the PNG. Returns 0 on success.
+overlay_check :: proc(demo: string, cap_ms: i64, cat: ^pp.Catalogs, rc: ^Render_Ctx) -> i32 {
+	path := fmt.tprintf("demos/%s.dem", demo)
+	text_bytes, rerr := os.read_entire_file_from_path(path, context.temp_allocator)
+	if rerr != nil {
+		fmt.eprintfln("overlay-check: cannot read %s", path)
+		return 1
+	}
+	d, perr := parse_demo(demo, string(text_bytes))
+	if perr != "" {
+		fmt.eprintfln("overlay-check: %s: %s", path, perr)
+		return 1
+	}
+	defer demo_destroy(&d) // N5: the shared teardown (same lifetime rules as
+	// run_demo — the parse-time clones + every dynamic slice)
+
+	state: pp.Run_State
+	defer pp.run_destroy(&state)
+	pp.run_init(&state, d.seed, cat.hash, cat.balance.logic_hz)
+	state.era = d.era
+	cfg := Demo_Replay{
+		name = d.name,
+		use_fixture = d.use_fixture,
+		qos_fixture = d.qos_fixture,
+		session = {goal = d.win_goal, cap_ms = d.lose_cap_ms, health_on = d.health_on, surge_win_pct = d.surge_win_pct},
+	}
+	defer { delete(cfg.nodes); delete(cfg.spawns); delete(cfg.pauses) }
+	for n in d.nodes { append(&cfg.nodes, n) }
+	for s in d.spawns { append(&cfg.spawns, s) }
+	for p in d.pauses { append(&cfg.pauses, p) }
+	if e := demo_apply_setup(&state, &cfg, cat); e != "" {
+		fmt.eprintfln("overlay-check: %s", e)
+		return 1
+	}
+	if e := lower_intents(&state, &d, cat); e != "" {
+		fmt.eprintfln("overlay-check: %s", e)
+		return 1
+	}
+
+	hz := cat.balance.logic_hz
+	// run to the capture ms (wall ticks; paused wall ticks step nothing — the
+	// same driver the run path uses). The overlay renders the LAST stepped
+	// tick's state + its stats record + the event tail (the app's behavior).
+	// The wall clock is bounded by the demo's run length (an out-of-range
+	// capture ms clamps to the run end — never steps past the demo's horizon).
+	sim_tick: u64 = 0
+	total_wall := demo_run_ticks(&d, hz)
+	wall_max := min(u64(max(0, i64(cap_ms) * i64(hz) / 1000)), total_wall)
+	stats: pp.Stats_Record
+	stats_valid := false
+	for w in u64(1)..=wall_max {
+		before := len(state.events)
+		if paused_at(cfg.pauses[:], w, hz) {
+			free_all(context.temp_allocator)
+			continue // a paused wall tick steps nothing
+		}
+		sim_tick += 1
+		batch := make([dynamic]pp.Command, 0, 4, context.temp_allocator)
+		for cmd in state.action_log {
+			if cmd.apply_tick == sim_tick {
+				append(&batch, cmd)
+			}
+		}
+		pp.step(&state, sim_tick, batch[:], cat)
+		if stats_valid {
+			pp.stats_destroy(&stats)
+		}
+		h := pp.state_hash(&state, state.events[before:], cat, context.temp_allocator)
+		stats = pp.stats_compute(&state, cat, h)
+		stats_valid = true
+		free_all(context.temp_allocator)
+	}
+
+	// N4 (Perkins r1): a capture with ZERO stepped ticks (e.g. cap_ms=0) would
+	// silently render an overlay-free PNG — the artifact would lie. Fail loud:
+	// the overlay needs a stepped tick's data.
+	if !stats_valid {
+		fmt.eprintfln("overlay-check: %s: no stepped tick before %dms (a paused/frozen window or cap_ms=0) — nothing to overlay", demo, cap_ms)
+		return 1
+	}
+
+	// render the world + the overlay (the shipped overlay code, explicit
+	// params — the harness passes no selection; the readout section is off).
+	rl.BeginDrawing()
+	rnd.draw_world(&rc.view, &state.topology, &state.bundles, &state.flow, &state.crisis, sim_tick, {})
+	rnd.draw_forecast_panel(&rc.view, &state.crisis, cat, state.era)
+	rnd.draw_health_meter(&rc.view, &state.health, cat, state.health_enabled)
+	rnd.draw_crisis_banner(&rc.view, &state.crisis, cat, state.era, 10)
+	rnd.draw_debug_overlay(&rc.view, &state.topology, cat, &stats, state.events[:], -1)
+	rl.EndDrawing()
+	img := rl.LoadImageFromScreen()
+	rl.ImageFlipVertical(&img)
+	swizzle_rb(&img)
+
+	out := fmt.aprintf("bin/overlay-%s-%dms.png", demo, cap_ms)
+	if ok := rl.ExportImage(img, strings_clone_cstr(out)); !ok {
+		fmt.eprintfln("overlay-check: failed to write %s", out)
+		delete(out)
+		pp.stats_destroy(&stats)
+		return 1
+	}
+	fmt.printfln("overlay-check: %s written (tick %d, %d events)", out, sim_tick, len(state.events))
+	delete(out)
+	pp.stats_destroy(&stats)
+	return 0
+}
+
+// strings_clone_cstr — clone a string into a cstring (raylib's ExportImage
+// takes a cstring; the temp arena is fine for the call's lifetime).
+strings_clone_cstr :: proc(s: string) -> cstring {
+	return strings.clone_to_cstring(s, context.temp_allocator)
+}
+
+} // when #config(PP_DEBUG, false)
