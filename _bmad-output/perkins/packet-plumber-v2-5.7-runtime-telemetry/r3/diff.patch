+package core
+
+// stats_test.odin — Story 5.7: the stats-stream pins at the LOWEST layer (the
+// durable-tests convention). Pins:
+//   (a) derivation — util_pct/offered/carried/class loss% + latency math match
+//       the sim's own numbers on a congested run (the formulas are pinned, not
+//       prose);
+//   (b) byte-identity — two serializations of the SAME state produce
+//       identical CSV bytes (the serializer is the one the harness + app
+//       share);
+//   (c) replay-identity — two identical runs (same seed + commands) produce
+//       identical STREAMS (the determinism contract the harness `stats-check`
+//       pins end-to-end);
+//   (d) absent-when-empty — an idle run emits G rows only (no C/P/D rows
+//       until real state exists — the golden-stability rule).
+
+import "core:fmt"
+import "core:testing"
+import "core:strings"
+
+// stats_stream_of — build a run, step it 1..ticks (the record_run convention),
+// and serialize the full per-tick stats stream. Returns the stream bytes on
+// the DEFAULT allocator (the caller frees). Mirrors what the harness/app do:
+// per STEPPED tick, compute the record + append its rows.
+stats_stream_of :: proc(state: ^Run_State, ticks: u64, cat: ^Catalogs, allocator := context.allocator) -> string {
+	sb := strings.builder_make(allocator)
+	stats_write_header(&sb)
+	for tick in u64(1)..=ticks {
+		before := len(state.events)
+		batch := make([dynamic]Command, 0, 4, context.temp_allocator)
+		for cmd in state.action_log {
+			if cmd.apply_tick == tick {
+				append(&batch, cmd)
+			}
+		}
+		step(state, tick, batch[:], cat)
+		h := state_hash(state, state.events[before:], cat, context.temp_allocator)
+		// W9 (Perkins r1): the emission goes through the SHARED stats_emit proc
+		// (the exact path both the harness drivers AND the app loop call) —
+		// this unit mirror pins the app-loop emission, not a divergent twin.
+		rec := stats_emit(state, cat, h, &sb)
+		stats_destroy(&rec)
+		clear(&state.events)
+		free_all(context.temp_allocator)
+	}
+	return strings.to_string(sb)
+}
+
+// test_stats_emit_path — W9's direct pin: stats_emit is the ONE per-step
+// emission proc shared by the harness (run_demo/replay_hashes) and the app's
+// step loop. This test proves it appends EXACTLY the header + the record's
+// CSV rows to the builder (compute + write in one call), so the app loop has
+// value-level coverage of the code it actually runs.
+@(test)
+test_stats_emit_path :: proc(t: ^testing.T) {
+	cat: Catalogs
+	test_catalog(&cat)
+	defer catalogs_destroy(&cat)
+	state: Run_State
+	run_init(&state, 5, TEST_CATALOG_HASH, TEST_LOGIC_HZ)
+	defer run_destroy(&state)
+	test_congested_run(&state, &cat)
+	// one step (tick 1 — draws land, demand starts)
+	before := len(state.events)
+	batch := make([dynamic]Command, 0, 4, context.temp_allocator)
+	for cmd in state.action_log {
+		if cmd.apply_tick == 1 {
+			append(&batch, cmd)
+		}
+	}
+	step(&state, 1, batch[:], &cat)
+	h := state_hash(&state, state.events[before:], &cat, context.temp_allocator)
+
+	sb := strings.builder_make(context.allocator)
+	defer delete(strings.to_string(sb))
+	pp_emit := stats_emit(&state, &cat, h, &sb)
+	defer stats_destroy(&pp_emit)
+	out := strings.to_string(sb)
+
+	// the emit wrote the record's rows: a G row for tick 1 + the pipe rows the
+	// record carries (the header is NOT written by emit — callers write it once)
+	testing.expect(t, strings.contains(out, fmt.tprintf("G,1,")), "emit writes the G row for the stepped tick")
+	testing.expect(t, strings.contains(out, "P,"), "emit writes the pipe rows")
+	testing.expect(t, !strings.contains(out, "# pp stats stream"), "emit appends only the record, not the header")
+	// the record itself is the same object the serialization just wrote
+	testing.expect_value(t, pp_emit.tick, u64(1))
+	testing.expect_value(t, pp_emit.sim_hash, h)
+}
+
+// test_congested_run — the qos_contention shape at unit scale: the fixture +
+// a standard pipe oversubscribed with email -> Best-effort + streaming ->
+// Express (the 3.3 contention ladder canon — the PLAYER categorizes, nothing
+// auto). 40 packets (20 each way, 50ms apart) saturate pipe 0 (cap 15 vs
+// 30/edge — the E9 bound fills, the ladder sheds). Returns the run with the
+// action log lowered; the caller steps it.
+test_congested_run :: proc(state: ^Run_State, cat: ^Catalogs) {
+	r, g, h := test_seed_fixture(state, cat)
+	// draw source->router + router->sink (standard), apply-tick 1
+	append(&state.action_log, Command{apply_tick = 1, kind = Cmd_Draw_Pipe{a = r, b = g, tier = 1}})
+	append(&state.action_log, Command{apply_tick = 1, kind = Cmd_Draw_Pipe{a = g, b = h, tier = 1}})
+	// categorize pipe 0 (source->router): email -> BE, streaming -> E
+	append(&state.action_log, Command{apply_tick = 1, kind = Cmd_Set_Lane{pipe = 0, class = 0, lane = LANE_BEST_EFFORT}})
+	append(&state.action_log, Command{apply_tick = 1, kind = Cmd_Set_Lane{pipe = 0, class = 1, lane = LANE_EXPRESS}})
+	// demand: alternating 0->2 email / 2->0 streaming, 50ms apart
+	for i in 0..<20 {
+		flow_seed_demand(&state.flow, u64(1+i*2), r, h, 0)
+		flow_seed_demand(&state.flow, u64(2+i*2), h, r, 1)
+	}
+}
+
+@(test)
+test_stats_derivation_congested :: proc(t: ^testing.T) {
+	cat: Catalogs
+	test_catalog(&cat)
+	defer catalogs_destroy(&cat)
+	state: Run_State
+	run_init(&state, 4242, TEST_CATALOG_HASH, TEST_LOGIC_HZ)
+	defer run_destroy(&state)
+	state.era = 3 // the streaming era (director demand active — the surge)
+	test_congested_run(&state, &cat)
+	// step enough ticks for the first deliveries + the first drops (tick 1..12)
+	// — the contention ladder fires once pipe 0's lane queue hits the bound.
+	for tick in u64(1)..=12 {
+		batch := make([dynamic]Command, 0, 4, context.temp_allocator)
+		for cmd in state.action_log {
+			if cmd.apply_tick == tick {
+				append(&batch, cmd)
+			}
+		}
+		step(&state, tick, batch[:], &cat)
+		clear(&state.events)
+		free_all(context.temp_allocator)
+	}
+	rec := stats_compute(&state, &cat, 0xDEADBEEF)
+	defer stats_destroy(&rec)
+
+	// the run has drawn pipes + demand -> class + pipe rows exist
+	testing.expect(t, len(rec.classes) >= 2, "congested run must have class rows")
+	testing.expect(t, len(rec.pipes) >= 2, "congested run must have pipe rows (the 3 drawn pipes: 0,1,2)")
+	// carried is queued x bandwidth; util is min(100, carried*100/cap)
+	found_pipe0 := false
+	for p in rec.pipes {
+		if p.pipe == 0 {
+			found_pipe0 = true
+			// pipe 0 is standard (cap 15); the lane caps allocate the budget
+			testing.expect(t, p.cap_units == 15, "pipe 0 standard cap = 15")
+			queued := u64(p.q[0]) + u64(p.q[1]) + u64(p.q[2])
+			testing.expect(t, p.carried == queued * 30, "carried = queued * packet_bandwidth(30)")
+			// util must be a clamped integer percent of carried/cap
+			want := u32(min(p.carried * 100 / 15, 100))
+			testing.expect_value(t, p.util_pct, want)
+			testing.expect(t, p.offered >= p.carried, "offered (carried + drops) >= carried")
+			// the 3 lanes sum to the budget allocation
+			total_caps := u64(p.c[0]) + u64(p.c[1]) + u64(p.c[2])
+			testing.expect(t, total_caps > 0, "the WFQ allocation must be non-zero")
+		}
+	}
+	testing.expect(t, found_pipe0, "pipe 0 must have a stats row")
+
+	// B1 (Perkins r1): the CLASS rows must be value-pinned — loss_pct and
+	// avg_latency_ms are the sla_evaluate formulas, the demand/delivered/
+	// dropped columns are the flow.sla accumulator copies, and the SLA latches
+	// are the flow.sla_breach copies. Byte-identity passes on identically-wrong
+	// values (both live + replay carry the same wrong formula) — the pin is
+	// the formula, not the bytes.
+	testing.expect(t, len(rec.classes) >= 2, "class rows exist for the demand classes")
+	for c in rec.classes {
+		if int(c.class) >= len(state.flow.sla) {
+			continue
+		}
+		acc := state.flow.sla[c.class]
+		testing.expect_value(t, c.demand, acc.demand_seen)
+		testing.expect_value(t, c.delivered, acc.delivered)
+		testing.expect_value(t, c.dropped, acc.dropped)
+		// loss_pct = dropped*100/(delivered+dropped), integer (the sla_evaluate
+		// formula — monotone cumulative loss, no Exit by contract)
+		completed := acc.delivered + acc.dropped
+		want_loss := u32(0)
+		if completed > 0 {
+			want_loss = u32(acc.dropped * 100 / completed)
+		}
+		testing.expect_value(t, c.loss_pct, want_loss)
+		// avg_latency_ms = total_latency_ms/delivered, integer (0 when none)
+		want_avg := u64(0)
+		if acc.delivered > 0 {
+			want_avg = acc.total_latency_ms / acc.delivered
+		}
+		testing.expect_value(t, c.avg_latency_ms, want_avg)
+		// the breach latches are the derived sla_breach copies
+		if int(c.class) < len(state.flow.sla_breach) {
+			testing.expect_value(t, c.sla_lat, state.flow.sla_breach[c.class][u8(Sla_Metric.Latency)])
+			testing.expect_value(t, c.sla_loss, state.flow.sla_breach[c.class][u8(Sla_Metric.Loss)])
+		}
+	}
+
+	// W7 (Perkins r1): the per-pipe accounting invariant — offered == carried
+	// + this tick's drops x bandwidth (the demand-presented decomposition).
+	// Every live pipe row must satisfy it (E9 drops ride the pipe's bundle;
+	// E22 pool drops are class-level, excluded from the pipe rows by design).
+	for p in rec.pipes {
+		testing.expect(t, p.offered == p.carried + u64(p.dropped) * 30,
+			"offered == carried + dropped*bandwidth for every pipe row")
+	}
+
+	// W7: the D rows — every D row names a LIVE pipe with a real class, an E9
+	// reason (0 = Queue_Overflow), and a count >= 1; the pipe's `dropped`
+	// column equals the SUM of its D-row counts (bundle-attributed drops
+	// replicate to every member, so the sum matches the bundle total).
+	for d in rec.drops {
+		testing.expect(t, d.reason == u8(Drop_Reason.Queue_Overflow), "D rows are E9 only (E22 excluded)")
+		testing.expect(t, d.count >= 1, "D-row counts are >= 1")
+		found := false
+		for p in rec.pipes {
+			if p.pipe == d.pipe {
+				found = true
+				break
+			}
+		}
+		testing.expect(t, found, "every D row names a live pipe")
+	}
+	// per-pipe: dropped column == sum of its D-row counts (the replication)
+	for p in rec.pipes {
+		sum_d := u32(0)
+		for d in rec.drops {
+			if d.pipe == p.pipe {
+				sum_d += d.count
+			}
+		}
+		testing.expect_value(t, p.dropped, sum_d)
+	}
+
+	// R2-B1 (Perkins r2): the AGGREGATION SHAPE must be pinned — the r1 per-
+	// event shape (two count=1 rows) and the r2 aggregated shape (one count=2
+	// row) pass every accounting assertion above identically. The discriminator:
+	// (a) no two rec.drops rows share (pipe,class,reason) — the find-or-append
+	// aggregates same-kind sheds into ONE row;
+	// (b) the KNOWN tick-12 shape — the congested fixture's record at tick 12
+	// emits exactly one D row: pipe 1, class 1 (streaming), reason 0
+	// (Queue_Overflow), count 2 (two streaming sheds aggregated). Pin the tuple,
+	// so a regression back to per-event rows (or a wrong aggregation key) fails.
+	for a in 0..<len(rec.drops) {
+		for b in a + 1..<len(rec.drops) {
+			d1, d2 := rec.drops[a], rec.drops[b]
+			testing.expect(t, !(d1.pipe == d2.pipe && d1.class == d2.class && d1.reason == d2.reason),
+				"D rows are aggregated: no two rows share (pipe,class,reason)")
+		}
+	}
+	found_agg := false
+	for d in rec.drops {
+		if d.pipe == 1 && d.class == 1 && d.reason == u8(Drop_Reason.Queue_Overflow) && d.count == 2 {
+			found_agg = true
+		}
+	}
+	testing.expect(t, found_agg, "tick-12 shape pinned: one aggregated D row (pipe 1, class 1, Queue_Overflow, count 2)")
+}
+
+@(test)
+test_stats_bundle_member_replication :: proc(t: ^testing.T) {
+	// W8 (Perkins r1): a PARALLEL-PIPE bundle — two pipes between the same
+	// endpoints pool into ONE link (cap = static sum, 2.1). Every member pipe
+	// row must carry the SAME load columns (capacity, offered, carried,
+	// dropped, util, per-lane queues — the pooled link is the capacity unit)
+	// while the lane columns (weights, caps) stay per-pipe.
+	cat: Catalogs
+	test_catalog(&cat)
+	defer catalogs_destroy(&cat)
+	state: Run_State
+	run_init(&state, 99, TEST_CATALOG_HASH, TEST_LOGIC_HZ)
+	defer run_destroy(&state)
+	r, g, h := test_seed_fixture(&state, &cat)
+	// draw res->router TWICE (a 2-member bundle, pooled cap 15+15=30)
+	append(&state.action_log, Command{apply_tick = 1, kind = Cmd_Draw_Pipe{a = r, b = g, tier = 1}})
+	append(&state.action_log, Command{apply_tick = 1, kind = Cmd_Draw_Pipe{a = r, b = g, tier = 1}})
+	append(&state.action_log, Command{apply_tick = 1, kind = Cmd_Draw_Pipe{a = g, b = h, tier = 1}})
+	// demand through the bundle
+	for i in 0..<10 {
+		flow_seed_demand(&state.flow, u64(1+i), r, h, 0)
+	}
+	// R2-W1 (Perkins r2): compute the record MID-FLIGHT (tick <= 8), NOT at tick
+	// 20 — the late record is all-zeros (both members drained), so the load-
+	// column equalities would compare 0==0 (vacuous; only cap_units bites). At
+	// tick 3 the bundle carries a real load (probed: offered=30 carried=30
+	// util=100 q=[0,1,0] on BOTH members) — identical AND non-zero.
+	for tick in u64(1)..=3 {
+		batch := make([dynamic]Command, 0, 4, context.temp_allocator)
+		for cmd in state.action_log {
+			if cmd.apply_tick == tick {
+				append(&batch, cmd)
+			}
+		}
+		step(&state, tick, batch[:], &cat)
+		clear(&state.events)
+		free_all(context.temp_allocator)
+	}
+	rec := stats_compute(&state, &cat, 0xBEEF)
+	defer stats_destroy(&rec)
+
+	// find the two bundle-member rows (pipes 0 and 1 — the res->router pair)
+	m0: Stats_Pipe_Row
+	m1: Stats_Pipe_Row
+	found0, found1 := false, false
+	for p in rec.pipes {
+		if p.pipe == 0 {
+			m0, found0 = p, true
+		}
+		if p.pipe == 1 {
+			m1, found1 = p, true
+		}
+	}
+	testing.expect(t, found0 && found1, "both bundle members have pipe rows")
+	if found0 && found1 {
+		// pooled capacity = static sum (15+15)
+		testing.expect_value(t, m0.cap_units, u32(30))
+		testing.expect_value(t, m1.cap_units, u32(30))
+		// identical load columns (the pooled link)
+		testing.expect_value(t, m0.offered, m1.offered)
+		testing.expect_value(t, m0.carried, m1.carried)
+		testing.expect_value(t, m0.dropped, m1.dropped)
+		testing.expect_value(t, m0.util_pct, m1.util_pct)
+		testing.expect_value(t, m0.q, m1.q)
+		// R2-W1: the loads must be NON-ZERO mid-flight — the equality above is
+		// vacuous on the drained tick-20 record (0==0); tick 3 carries a real
+		// load (offered=30 carried=30 util=100 q=[0,1,0]) that must replicate.
+		testing.expect(t, m0.carried > 0, "mid-flight bundle members carry a real load")
+		testing.expect(t, m0.util_pct == 100, "mid-flight bundle is saturated (util 100)")
+		testing.expect(t, m1.carried == m0.carried && m0.carried == 30, "member carried = 30 (one packet x bandwidth)")
+		// lane columns are per-pipe but the flow allocates the same default
+		// preset to both (balanced 1:1:1) — the caps are identical here
+		testing.expect(t, m0.w == m1.w, "default weights are per-pipe but identical")
+		// the offered==carried+drops invariant holds for members too
+		testing.expect(t, m0.offered == m0.carried + u64(m0.dropped) * 30, "member offered invariant")
+		testing.expect(t, m1.offered == m1.carried + u64(m1.dropped) * 30, "member offered invariant")
+	}
+}
+
+@(test)
+test_stats_byte_identity_same_state :: proc(t: ^testing.T) {
+	cat: Catalogs
+	test_catalog(&cat)
+	defer catalogs_destroy(&cat)
+
+	// run A: congested run stepped 1..20
+	state_a: Run_State
+	run_init(&state_a, 42, TEST_CATALOG_HASH, TEST_LOGIC_HZ)
+	test_congested_run(&state_a, &cat)
+	stream_a := stats_stream_of(&state_a, 20, &cat)
+	defer delete(stream_a)
+
