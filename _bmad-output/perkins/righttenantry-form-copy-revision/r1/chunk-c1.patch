+/// Label/message join for error-summary rows. Question- and exclamation-
+/// terminated labels take a plain space ("Where did you find this listing?"
+/// + message), everything else the colon join — the old em-dash join
+/// handled both, so the replacement must not produce ":?" or ":!".
+fn join_label_message(label: String, message: String) -> String {
+  case string.ends_with(label, "?") || string.ends_with(label, "!") {
+    True -> label <> " " <> message
+    False -> label <> ": " <> message
+  }
+}
