diff --git a/app/render/map.odin b/app/render/map.odin
new file mode 100644
index 0000000..bccb246
--- /dev/null
+++ b/app/render/map.odin
@@ -0,0 +1,211 @@
+package render
+
+// map.odin — Story 7.4 / canon D9: the procedural land/ocean/parks background
+// map (look-book §2 "Canvas / map": "noise-driven landmasses with coastlines +
+// green park blobs over soft-blue water", MM-style — user verdict 2026-08-08:
+// "a map background, just like Mini Motorways"). The play surface stops being
+// a flat void.
+//
+// PRESENTATION ONLY (the briefing's hard requirement 1): the map derives from
+// the RUN SEED, lives entirely in the View layer, and perturbs NOTHING in the
+// sim (ODN-1 — the view never perturbs sim state). No snapshot fields, no
+// LOG_VERSION bump, no replay impact: T1 state hashes ignore it by
+// construction (state_hash never reads the render layer), and the replay gate
+// re-sims the blessed action log without the map. T2 goldens re-bless
+// deliberately — the map changes every frame (cause-documented in the PR).
+//
+// Determinism (the §10.4 no-transcendentals rule — no libm anywhere): the
+// generator is pure integer + IEEE-f32 arithmetic. A per-seed per-pixel
+// classification is cached in the View (`map_cells`); same seed + same world
+// dims → byte-identical cells, pinned by the harness palcheck map-identity
+// section (a deliberate map change re-blesses the pin). The palette colors
+// come from data/palette.json (water/coast/park — the look-book §2 oracle).
+
+import rl "vendor:raylib"
+
+// Map_Kind — the per-world-pixel classification. One color per cell (flat
+// fills; the map is a soft backdrop — no gradients, no textures, per the
+// MM flat-2D canon). Coast beats Park at the water ring (a park blob never
+// touches the coast), and both beat Land.
+Map_Kind :: enum u8 {
+	Water, // the sea base (soft blue)
+	Land,  // the interior cream (palette.canvas — the canon play surface)
+	Coast, // the sand edge band between land and water
+	Park,  // a green blob (interior only)
+}
+
+// --- art-tuning constants (the D9 style dial; the lavish gate tuned these) --
+// Cell sizes in WORLD px: the land lattice (72px ≈ 2.8 tiles) gives
+// landmasses a few tiles across with 1px-precise organic coastlines; the
+// park lattice (120px) is coarser so parks read as soft blobs, not noise.
+// Thresholds: 0.46 → ~60% land (the play surface stays usable — terrain does
+// not gate placement in v1); 0.72 → only the strongest park-noise peaks
+// (~10% of land). MAP_COAST_RADIUS (world px) is the water dilation — the
+// visible sand band width on screen.
+MAP_LAND_CELL_PX :: 72
+MAP_PARK_CELL_PX :: 120
+MAP_LAND_LEVEL   :: 0.38 // land threshold: noise >= this is land (tuned 2026-08-18 —
+                       // 0.46 measured only ~40-49% world land; 0.38 → ~65-70%,
+                       // keeping the play surface usable — placement is not
+                       // terrain-aware in v1)
+MAP_PARK_LEVEL   :: 0.72
+MAP_COAST_RADIUS :: 1 // the water dilation radius in world px — a 2px sand band
+                      // (radius 2 measured too chunky — two hard edges 5px
+                      // apart read as banding, not a coastline)
+
+// map_hash — splitmix64-style integer mixing of (seed, x, y). Deterministic,
+// no libm. x and y mix through DIFFERENT multiply constants so (x,y) and
+// (y,x) cannot collide trivially; the finalizer avalanche decorrelates
+// neighboring lattice points. (Constants pinned u64 — the core splitmix64
+// precedent, core/rng.odin.)
+MAP_HASH_DELTA  :: u64(0x9E3779B97F4A7C15)
+MAP_HASH_GAMMA1 :: u64(0xBF58476D1CE4E5B9)
+MAP_HASH_GAMMA2 :: u64(0x94D049BB133111EB)
+
+map_hash :: proc(seed: u64, x, y: i32) -> u64 {
+	z := seed ~ (u64(x) * MAP_HASH_DELTA) ~ (u64(y) * MAP_HASH_GAMMA2)
+	z = (z ~ (z >> 30)) * MAP_HASH_GAMMA1
+	z = (z ~ (z >> 27)) * MAP_HASH_GAMMA2
+	return z ~ (z >> 31)
+}
+
+// hash_unit — [0,1) from the top 24 bits of a hash. The u64→f32 conversion of
+// a 24-bit value + division by a power of two are exact — deterministic on
+// every platform.
+hash_unit :: proc(z: u64) -> f32 {
+	return f32(z >> 40) / f32(1 << 24)
+}
+
+// value_noise — bilinear value noise with smoothstep interpolation over an
+// integer lattice. All math is integer grid ops + IEEE f32 (deterministic;
+// smoothstep is polynomial, not transcendental).
+value_noise :: proc(seed: u64, x, y, cell_px: i32) -> f32 {
+	gx := x / cell_px
+	gy := y / cell_px
+	fx := f32(x - gx * cell_px) / f32(cell_px)
+	fy := f32(y - gy * cell_px) / f32(cell_px)
+	sx := fx * fx * (3.0 - 2.0 * fx)
+	sy := fy * fy * (3.0 - 2.0 * fy)
+	h00 := hash_unit(map_hash(seed, gx, gy))
+	h10 := hash_unit(map_hash(seed, gx + 1, gy))
+	h01 := hash_unit(map_hash(seed, gx, gy + 1))
+	h11 := hash_unit(map_hash(seed, gx + 1, gy + 1))
+	top := h00 + (h10 - h00) * sx
+	bot := h01 + (h11 - h01) * sx
+	return top + (bot - top) * sy
+}
+
+// map_generate — fill the per-pixel classification cache for `seed`. Four
+// passes: (1) land vs water via the land value noise; (2) dilate the water by
+// MAP_COAST_RADIUS into a near-water mask; (3) park blobs on land via a
+// SECOND noise domain (seed xor — decorrelated from the land noise); (4)
+// assemble: Water / Coast (near-water ring) / Park (interior peaks) / Land.
+// Cache lifecycle: v.map_cells is owned (context.allocator); a new seed or a
+// world resize regenerates in place (delete + make). The scratch masks ride
+// the caller's temp arena (freed by the frame's free_all).
+map_generate :: proc(v: ^View, seed: u64) {
+	w := i32(v.world_w)
+	h := i32(v.world_h)
+	n := w * h
+	if n <= 0 {
+		return
+	}
+	if len(v.map_cells) != int(n) {
+		delete(v.map_cells)
+		v.map_cells = make([dynamic]u8, n)
+	}
+	water := make([]u8, n, context.temp_allocator)
+	near := make([]u8, n, context.temp_allocator)
+	// NOTE: no delete on the scratch — they ride the caller's TEMP arena
+	// (freed wholesale by the frame's free_all; a per-slice delete here would
+	// free an arena interior pointer with the heap allocator — the 2026-08-18
+	// map-preview abort trap).
+
+	// pass 1 — land vs water
+	for y in 0..<h {
+		for x in 0..<w {
+			if value_noise(seed, x, y, MAP_LAND_CELL_PX) < MAP_LAND_LEVEL {
+				water[y * w + x] = 1
+			}
+		}
+	}
+	// pass 2 — the water dilation (the coast band mask)
+	rad: i32 = MAP_COAST_RADIUS
+	for y in 0..<h {
+		for x in 0..<w {
+			if water[y * w + x] == 0 {
+				continue
+			}
+			for dy: i32 = -rad; dy <= rad; dy += 1 {
+				yy := y + dy
+				if yy < 0 || yy >= h {
+					continue
+				}
+				for dx: i32 = -rad; dx <= rad; dx += 1 {
+					xx := x + dx
+					if xx < 0 || xx >= w {
+						continue
+					}
+					near[yy * w + xx] = 1
+				}
+			}
+		}
+	}
+	// pass 3 + 4 — assemble: Water / Coast (the dilated ring) / Land, then
+	// parks stamped on interior land. Pass 4 overwrites EVERY cell (a stale
+	// cache from a prior seed must never survive — the 2026-08-18 multi-demo
+	// save kept prior-seed park/coast cells: the generator must be total).
+	park_seed := seed ~ MAP_HASH_DELTA
+	for y in 0..<h {
+		for x in 0..<w {
+			i := y * w + x
+			if water[i] == 1 {
+				v.map_cells[i] = u8(Map_Kind.Water)
+			} else if near[i] == 1 {
+				v.map_cells[i] = u8(Map_Kind.Coast)
+			} else if value_noise(park_seed, x, y, MAP_PARK_CELL_PX) >= MAP_PARK_LEVEL {
+				v.map_cells[i] = u8(Map_Kind.Park)
+			} else {
+				v.map_cells[i] = u8(Map_Kind.Land)
+			}
+		}
+	}
+	v.map_seed = seed
+	v.map_gen_w = w
+	v.map_gen_h = h
+}
+
+// map_ensure — regenerate the cache when the seed or the world dims change
+// (called from map_draw; the app's restart mints a fresh seed → a fresh map).
+map_ensure :: proc(v: ^View, seed: u64) {
+	if v.map_seed == seed && v.map_gen_w == i32(v.world_w) && v.map_gen_h == i32(v.world_h) && len(v.map_cells) > 0 {
+		return
+	}
+	map_generate(v, seed)
+}
+
+// map_cells_hash — FORCE a regeneration and hash the cells (FNV-1a-64). The
+// palcheck map-identity pin: same seed + same world → byte-identical cells
+// forever; a deliberate map change re-blesses the pin constant in palcheck.
+map_cells_hash :: proc(v: ^View, seed: u64) -> u64 {
+	map_generate(v, seed)
+	h := u64(14695981039346656037) // FNV-1a offset basis (fits u64 only — pinned)
+	for b in v.map_cells {
+		h = (h ~ u64(b)) * u64(0x100000001B3)
+	}
+	return h
+}
+
+// map_color — the palette color for a map cell (Land = the canon cream
+// canvas; the map is flat fills — no gradients, per the MM minimalism canon).
+map_color :: proc(p: ^Palette, k: Map_Kind) -> rl.Color {
+	#partial switch k {
+	case .Water:
+		return p.water
+	case .Coast:
+		return p.coast
+	case .Park:
+		return p.park
+	}
+	return p.canvas // Land + any defensive fallback = the canon cream
+}
