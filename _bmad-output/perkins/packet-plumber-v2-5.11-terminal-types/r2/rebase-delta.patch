diff --git a/harness/map_preview.odin b/harness/map_preview.odin
new file mode 100644
index 0000000..eabcafc
--- /dev/null
+++ b/harness/map_preview.odin
@@ -0,0 +1,125 @@
+package main
+
+// map_preview.odin — Story 7.4 / canon D9: the map-preview scratch render (the
+// lavish-gate tool). Renders the Story-7.1 JUICE scene (the 13-node network:
+// 7 houses, 4 routers basic/mid/high, 2 hosts, all three pipe tiers + a
+// 2-member bundle, two QoS presets — the settled 30s moment, with the
+// forecast + health + crisis HUD like the real game) on an ARBITRARY run
+// seed's procedural map, exported to a PNG. The topology is seed-independent
+// (all spawns/draws are FIXED positions — the juice demo's, no growth), so
+// the A/B candidates differ ONLY in the map: the lavish gate's like-for-like
+// comparison (2-3 candidate map seeds side by side against the vista
+// reference, per the briefing's HARD GATE).
+//
+// Usage: harness map-preview <seed> [out.png]   (default out:
+// bin/map-preview-<seed>.png)
+
+import "core:fmt"
+import "core:os"
+import "core:strconv"
+import "core:strings"
+import rl "vendor:raylib"
+import pp "../core"
+import rnd "../app/render"
+
+// juice_scene — the juice.dem topology at its 30s calm moment (the demo's
+// spawn/draw verbs, lifted verbatim so the preview == the shipped golden's
+// scene minus the map). Fixed positions — seed-independent by construction.
+juice_scene :: proc(state: ^pp.Run_State, cat: ^pp.Catalogs) {
+	res, _ := pp.node_type_index(cat, "residential")
+	rtb, _ := pp.node_type_index(cat, "router_basic")
+	rtm, _ := pp.node_type_index(cat, "router_mid")
+	rth, _ := pp.node_type_index(cat, "router_high")
+	host, _ := pp.node_type_index(cat, "content_host")
+	narrow, _ := pp.pipe_tier_index(cat, "narrow")
+	std, _ := pp.pipe_tier_index(cat, "standard")
+	wide, _ := pp.pipe_tier_index(cat, "wide")
+
+	pp.topology_spawn_node(&state.topology, res, {4, 6}, cat)
+	pp.topology_spawn_node(&state.topology, res, {7, 12}, cat)
+	pp.topology_spawn_node(&state.topology, res, {3, 17}, cat)
+	pp.topology_spawn_node(&state.topology, res, {10, 21}, cat)
+	pp.topology_spawn_node(&state.topology, res, {15, 24}, cat)
+	pp.topology_spawn_node(&state.topology, res, {27, 23}, cat)
+	pp.topology_spawn_node(&state.topology, res, {35, 13}, cat)
+	pp.topology_spawn_node(&state.topology, rtb, {8, 9}, cat)
+	pp.topology_spawn_node(&state.topology, rtm, {16, 15}, cat)
+	pp.topology_spawn_node(&state.topology, rth, {25, 10}, cat)
+	pp.topology_spawn_node(&state.topology, rtb, {28, 17}, cat)
+	pp.topology_spawn_node(&state.topology, host, {31, 6}, cat)
+	pp.topology_spawn_node(&state.topology, host, {33, 20}, cat)
+
+	draws := [13]pp.Command{
+		{kind = pp.Cmd_Draw_Pipe{a = 0, b = 7, tier = narrow}},
+		{kind = pp.Cmd_Draw_Pipe{a = 1, b = 7, tier = narrow}},
+		{kind = pp.Cmd_Draw_Pipe{a = 2, b = 8, tier = std}},
+		{kind = pp.Cmd_Draw_Pipe{a = 3, b = 8, tier = std}},
+		{kind = pp.Cmd_Draw_Pipe{a = 4, b = 8, tier = narrow}},
+		{kind = pp.Cmd_Draw_Pipe{a = 7, b = 8, tier = std}},
+		{kind = pp.Cmd_Draw_Pipe{a = 7, b = 8, tier = std}},
+		{kind = pp.Cmd_Draw_Pipe{a = 8, b = 9, tier = wide}},
+		{kind = pp.Cmd_Draw_Pipe{a = 9, b = 11, tier = wide}},
+		{kind = pp.Cmd_Draw_Pipe{a = 9, b = 10, tier = std}},
+		{kind = pp.Cmd_Draw_Pipe{a = 10, b = 12, tier = std}},
+		{kind = pp.Cmd_Draw_Pipe{a = 5, b = 10, tier = narrow}},
+		{kind = pp.Cmd_Draw_Pipe{a = 6, b = 10, tier = narrow}},
+	}
+	for d in draws {
+		pp.topology_apply_edit(&state.topology, d, cat)
+	}
+	// the QoS emphases (Express-heavy on pipe 7, Best-effort-heavy on pipe 2)
+	pp.topology_apply_edit(&state.topology, pp.Command{kind = pp.Cmd_Set_Weights{pipe = 7, weights = {9, 1, 0}}}, cat)
+	pp.topology_apply_edit(&state.topology, pp.Command{kind = pp.Cmd_Set_Weights{pipe = 2, weights = {1, 1, 8}}}, cat)
+	// era 3 (the streaming-surge demand director) — the demo sets it on state;
+	// the director derives the demand plan from (era, topology) deterministically.
+	state.era = 3
+}
+
+run_map_preview :: proc(seed_text: string, out: string, cat: ^pp.Catalogs) -> int {
+	seed: u64
+	ok := false
+	if v, e := strconv.parse_uint(seed_text, 10); e {
+		seed = u64(v)
+		ok = true
+	}
+	if !ok {
+		fmt.eprintfln("map-preview: bad seed %q (need an unsigned integer)", seed_text)
+		return 2
+	}
+
+	rl.SetTraceLogLevel(.ERROR)
+	rl.InitWindow(1280, 720, "pp-map-preview")
+	defer rl.CloseWindow()
+
+	rc: Render_Ctx
+	render_setup(&rc, cat)
+
+	state: pp.Run_State
+	pp.run_init(&state, seed, cat.hash, cat.balance.logic_hz)
+	defer pp.run_destroy(&state)
+	juice_scene(&state, cat)
+	// settle to the 30s calm moment (the juice demo's first capture tick)
+	for t in u64(1)..=600 {
+		pp.step(&state, t, {}, cat)
+		clear(&state.events)
+	}
+
+	rl.BeginDrawing()
+	rnd.draw_world(&rc.view, &state.topology, &state.bundles, &state.flow, &state.crisis, 600, {}, -1, -1, seed)
+	rnd.draw_forecast_panel(&rc.view, &state.crisis, cat, state.era)
+	rnd.draw_health_meter(&rc.view, &state.health, cat, state.health_enabled)
+	rnd.draw_crisis_banner(&rc.view, &state.crisis, cat, state.era, 10)
+	rl.EndDrawing()
+	img := rl.LoadImageFromScreen()
+	rl.ImageFlipVertical(&img)
+	swizzle_rb(&img)
+	cpath := strings.clone_to_cstring(out, context.temp_allocator)
+	ok = rl.ExportImage(img, cpath)
+	rl.UnloadImage(img)
+	if !ok {
+		fmt.eprintfln("map-preview: failed to write %s", out)
+		return 1
+	}
+	fmt.printfln("map-preview: seed %d map rendered to %s", seed, out)
+	return 0
+}
