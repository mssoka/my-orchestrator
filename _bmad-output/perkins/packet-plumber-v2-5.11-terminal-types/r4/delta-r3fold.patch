diff --git a/harness/fold_check.odin b/harness/fold_check.odin
new file mode 100644
index 0000000..9df9073
--- /dev/null
+++ b/harness/fold_check.odin
@@ -0,0 +1,73 @@
+package main
+
+// fold_check.odin — the FOLD-SPLICE VERIFIER (Perkins r3 N11): a re-runnable,
+// mechanical check that a golden re-bless is FOLD-ONLY for the canonical
+// era-0 boot demo. The 4.3 discipline's splice proof was PR-prose only; this
+// subcommand makes it a gate: a re-bless must pass
+//
+//	harness fold-check <prev-catalog-hash-hex> <prev-tick1-hex>
+//
+// where the prev values come from the PRE-re-bless golden's manifest header
+// (git show <old>:goldens/boot.t1). It re-derives boot's tick-1 state dump
+// under the CURRENT catalogs, FNV's it (the NEW tick-1 — cross-checked against
+// the blessed manifest), splices the PREVIOUS hash at the fold position
+// (bytes 33..40 — the catalog_hash field of the state dump), and verifies the
+// spliced FNV equals the PREVIOUS tick-1 EXACTLY. Any non-fold shift — a
+// mid-list type insert, an enum reorder, an era-0 sim change — fails it.
+
+import "core:fmt"
+import "core:os"
+import "core:strconv"
+import pp "../core"
+
+FOLD_SPLICE_OFFSET :: 33 // the state dump's catalog_hash field (after seed/tick/rng/era)
+
+run_fold_check :: proc(prev_hash_hex: string, prev_tick1_hex: string) -> i32 {
+	cat: pp.Catalogs
+	defer pp.catalogs_destroy(&cat)
+	if e := load_catalogs(&cat); e != "" {
+		fmt.eprintfln("fold-check: %s", e)
+		return 2
+	}
+	prev_hash_raw, okh := strconv.parse_uint(prev_hash_hex, 16) // uint in this Odin
+	prev_tick1_raw, okt := strconv.parse_uint(prev_tick1_hex, 16)
+	prev_hash_u := u64(prev_hash_raw)
+	prev_tick1_u := u64(prev_tick1_raw)
+	if !okh || !okt {
+		fmt.eprintfln("fold-check: want <prev-catalog-hash-hex> <prev-tick1-hex> (16-digit hex)")
+		return 2
+	}
+
+	// boot's run setup: seed 42, era 0 (no demand, no growth, no commands —
+	// the canonical fold-only demo), the fixture.
+	state: pp.Run_State
+	defer pp.run_destroy(&state)
+	pp.run_init(&state, 42, cat.hash, cat.balance.logic_hz)
+	state.era = 0
+	seed_fixture(&state, &cat)
+	before := len(state.events)
+	pp.step(&state, 1, {}, &cat)
+	dump := pp.state_dump(&state, state.events[before:], &cat)
+	if len(dump) < FOLD_SPLICE_OFFSET + 8 {
+		fmt.eprintfln("fold-check: state dump too short (%d bytes) — layout changed?", len(dump))
+		return 1
+	}
+	new_tick1 := pp.fnv1a64(dump)
+	spliced := make([]u8, len(dump))
+	defer delete(spliced)
+	copy(spliced, dump)
+	for i in 0..<8 {
+		spliced[FOLD_SPLICE_OFFSET + i] = u8(prev_hash_u >> u32(8 * i))
+	}
+	spliced_hash := pp.fnv1a64(spliced)
+	fmt.printfln("fold-check: current catalog_hash %016x", cat.hash)
+	fmt.printfln("fold-check: new tick-1        %016x  (the blessed manifest must match)", new_tick1)
+	fmt.printfln("fold-check: spliced prev      %016x  (must equal the prev tick-1)", spliced_hash)
+	if spliced_hash == prev_tick1_u {
+		fmt.println("fold-check: PASS — the tick-1 shift is the catalog fold alone (bytes 33..40)")
+		return 0
+	}
+	fmt.eprintfln("fold-check: FAIL — the tick-1 state differs BEYOND the catalog_hash fold")
+	fmt.eprintfln("  (a mid-list type insert, an enum reorder, or an era-0 sim change — check the diff)")
+	return 1
+}
