@@ -19,6 +19,9 @@ package main
 //   odin run harness -- stats-check <demo>      Story 5.7: live stream == replay stream byte-compare
 //   odin run harness -- map-preview <seed>      Story 7.4: render the juice scene on a seed's
 //                                               procedural map (the lavish-gate candidate tool)
+//   odin run harness -- fold-check <prev-hash> <prev-tick1>
+//                                               r3 N11: prove a re-bless is the catalog fold
+//                                               alone (boot's tick-1 splice; re-runnable gate)
 
 import "core:fmt"
 import "core:os"
@@ -134,6 +137,15 @@ main :: proc() {
 		pp.catalogs_destroy(&cat)
 		os.exit(int(code))
 	}
+	// r3 N11: the fold-splice verifier — `fold-check <prev-hash> <prev-tick1>`
+	// proves a re-bless is the catalog fold alone (boot's tick-1 splice).
+	if verb == "fold-check" {
+		if len(rest) != 2 {
+			usage()
+		}
+		code := run_fold_check(rest[0], rest[1])
+		os.exit(int(code))
+	}
 	// 5.7 AC3: the PP_DEBUG-only overlay render (compile-gated — a plain
 	// harness build carries no overlay code, so goldens cannot shift).
 	when #config(PP_DEBUG, false) {
