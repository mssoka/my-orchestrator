index 00000000..49a2d4cc
--- /dev/null
+++ b/scripts/js-tests/form_guarantor_cohort.test.js
@@ -0,0 +1,153 @@
+// Pins form.js's guarantor cohort module (2026-08-04 final policy ruling):
+// the cohort derivation, the required rule, and the fields-open rule that
+// drive the `_guarantor_*` synthetic hidden inputs — which in turn drive
+// the declared-required Guarantor step (per-cohort notice, fields
+// auto-expanded, no checkbox gate) via the data-condition engine.
+// MUST STAY IN SYNC with form_sections/common.guarantor_cohort (Gleam).
+
+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+
+const FORM_JS = require.resolve("../../server/priv/static/form.js");
+
+function loadModule() {
+  delete require.cache[FORM_JS];
+  // form.js runs its IIFEs at require time against globals; a minimal
+  // document whose lookups all miss keeps every wiring block inert.
+  global.document = {
+    readyState: "complete",
+    body: { getAttribute: () => null },
+    querySelector: () => null,
+    querySelectorAll: () => [],
+    addEventListener: () => {},
+    createElement: () => ({ style: {}, setAttribute() {}, appendChild() {} }),
+  };
+  global.window = global;
+  return require(FORM_JS);
+}
+
+test("cohort derivation: never_rented wins over every employment status", () => {
+  const m = loadModule();
+  assert.equal(m.computeGuarantorCohort(true, "employed"), "first_rental");
+  assert.equal(m.computeGuarantorCohort(true, "student"), "first_rental");
+  assert.equal(m.computeGuarantorCohort(true, "retired"), "first_rental");
+  assert.equal(m.computeGuarantorCohort(true, ""), "first_rental");
+});
+
+test("cohort derivation: employment cohorts when never_rented is off", () => {
+  const m = loadModule();
+  assert.equal(m.computeGuarantorCohort(false, "student"), "student");
+  assert.equal(m.computeGuarantorCohort(false, "unemployed"), "unemployed");
+  assert.equal(m.computeGuarantorCohort(false, "retired"), "retired");
+  assert.equal(m.computeGuarantorCohort(false, "employed"), "");
+  assert.equal(m.computeGuarantorCohort(false, "self-employed"), "");
+  assert.equal(m.computeGuarantorCohort(false, ""), "");
+});
+
+test("required rule: first_rental + student + unemployed only", () => {
+  const m = loadModule();
+  assert.equal(m.guarantorCohortIsRequired("first_rental"), true);
+  assert.equal(m.guarantorCohortIsRequired("student"), true);
+  assert.equal(m.guarantorCohortIsRequired("unemployed"), true);
+  // Retired is a cohort only for the hint — never required.
+  assert.equal(m.guarantorCohortIsRequired("retired"), false);
+  assert.equal(m.guarantorCohortIsRequired(""), false);
+});
+
+test("fields-open rule: required OR the box ticked", () => {
+  const m = loadModule();
+  assert.equal(m.guarantorFieldsOpen(true, false), true);
+  assert.equal(m.guarantorFieldsOpen(true, true), true);
+  assert.equal(m.guarantorFieldsOpen(false, true), true);
+  assert.equal(m.guarantorFieldsOpen(false, false), false);
+});
+
+test("wiring: converge stamps the synthetics from the source controls", () => {
+  delete require.cache[FORM_JS];
+  const listeners = {};
+  function fakeInput(name, value, checked) {
+    return {
+      name,
+      value: value || "",
+      checked: !!checked,
+      dispatched: [],
+      addEventListener: (ev, cb) => {
+        (listeners[name] = listeners[name] || []).push(cb);
+      },
+      dispatchEvent(ev) {
+        this.dispatched.push(ev);
+        (listeners[this.name] || []).forEach((cb) => cb(ev));
+      },
+      setAttribute() {},
+      removeAttribute() {},
+      getAttribute: () => null,
+    };
+  }
+  const neverRented = fakeInput("never_rented_before", "on", false);
+  const employment = fakeInput("employment_status", "", false);
+  const hasGuarantor = fakeInput("has_guarantor", "on", false);
+  const cohort = fakeInput("_guarantor_cohort", "", false);
+  const required = fakeInput("_guarantor_required", "", false);
+  const fieldsOpen = fakeInput("_guarantor_fields_open", "", false);
+  const byName = {
+    never_rented_before: neverRented,
+    employment_status: employment,
+    has_guarantor: hasGuarantor,
+    _guarantor_cohort: cohort,
+    _guarantor_required: required,
+    _guarantor_fields_open: fieldsOpen,
+  };
+  global.document = {
+    readyState: "complete",
+    body: { getAttribute: () => null },
+    querySelector: (sel) => {
+      const m2 = sel.match(/\[name="([^"]+)"\]/);
+      return m2 ? byName[m2[1]] || null : null;
+    },
+    querySelectorAll: () => [],
+    addEventListener: () => {},
+    createElement: () => ({ style: {}, setAttribute() {}, appendChild() {} }),
+  };
+  global.window = global;
+  global.Event = class {
+    constructor(type) {
+      this.type = type;
+    }
+  };
+  require(FORM_JS);
+
+  // Pristine optional render: everything blank, no flips dispatched.
+  assert.equal(cohort.value, "");
+  assert.equal(required.value, "");
+  assert.equal(fieldsOpen.value, "");
+
+  // Pick student → required cohort, fields open, change announced on the
+  // synthetics so the condition engine re-applies.
+  employment.value = "student";
+  employment.dispatchEvent(new Event("change"));
+  assert.equal(cohort.value, "student");
+  assert.equal(required.value, "on");
+  assert.equal(fieldsOpen.value, "on");
+  assert.ok(cohort.dispatched.length >= 1);
+  assert.ok(required.dispatched.length >= 1);
+  assert.ok(fieldsOpen.dispatched.length >= 1);
+
+  // Untick back to employed → optional again; fields close (box unticked).
+  employment.value = "employed";
+  employment.dispatchEvent(new Event("change"));
+  assert.equal(cohort.value, "");
+  assert.equal(required.value, "");
+  assert.equal(fieldsOpen.value, "");
+
+  // Optional path: ticking the box opens the fields without a requirement.
+  hasGuarantor.checked = true;
+  hasGuarantor.dispatchEvent(new Event("change"));
+  assert.equal(required.value, "");
+  assert.equal(fieldsOpen.value, "on");
+
+  // never_rented beats the employment cohort (precedence).
+  neverRented.checked = true;
+  neverRented.dispatchEvent(new Event("change"));
+  assert.equal(cohort.value, "first_rental");
+  assert.equal(required.value, "on");
+});
