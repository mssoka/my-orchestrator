+/// Required-cohort persistence alignment (2026-08-04 policy ruling): the
+/// required cohorts' SSR path renders NO checkbox, so a student submits
+/// full guarantor details with NO has_guarantor flag posted. Validation
+/// passes via force_required — and the insert null-out MUST honor the same
+/// rule or the validated guarantor silently vanishes (has_guarantor=false,
+/// fields NULL) while the landlord's dashboard shows a guaranteed
+/// application. Also pins the guarantor_attestation consent record firing
+/// off the same rule (the applicant named a guarantor — the third-party
+/// PII attestation must exist).
+pub fn apply_submission_persists_guarantor_for_required_cohort_without_checkbox_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, True)
+  let short_code = fetch_vacancy_short_code(db, vacancy_id)
+  let email = "apply-ack-required-cohort@example.com"
+
+  // Student (required cohort) with landlord refs and FULL guarantor
+  // details but NO has_guarantor key at all — the exact POST shape the
+  // declared-required path produces.
+  let values = [
+    #("first_name", "Aoife"),
+    #("last_name", "O'Neill"),
+    #("email", email),
+    #("phone", "+353851234567"),
+    #("current_address", "1 Test Street, Dublin 2"),
+    #("employment_status", "student"),
+    #("monthly_income_cents", "3500"),
+    #("desired_move_in_date", test_helpers.near_future_iso_date()),
+    #("num_occupants", "1"),
+    #("has_pets", "no"),
+    #("is_smoker", "no"),
+    #("never_rented_before", "false"),
+    #("has_eviction_history", "no"),
+    #("has_ccjs", "no"),
+    #("co_applicant_sharing", "no"),
+    #("landlord_ref_name", "Previous Landlord"),
+    #("landlord_ref_phone", "+353871234567"),
+    #("landlord_ref_email", "landlord@example.com"),
+    #("personal_statement", "I'm a quiet student looking for a long-term let."),
+    #("gdpr_consent", "on"),
+    #("reference_contact_choice", "declined"),
+    #("guarantor_name", "Seamus O'Neill"),
+    #("guarantor_relationship", "parent"),
+    #("guarantor_phone", "+353872345678"),
+    #("guarantor_email", "guarantor@example.com"),
+    #("guarantor_monthly_income_cents", "500000"),
+    #("guarantor_employer", "Acme Ltd"),
+    #("_website", ""),
+    #("_form_loaded_at", int.to_string(recent_form_loaded_ms())),
+  ]
+  let resp = submit_apply_form(db, short_code, values)
+  resp.status |> should.equal(200)
+
+  let app_id = fetch_application_id_by_email(db, email)
+
+  // The guarantor persisted — flag true, fields intact (NOT nulled).
+  let assert Ok(flag) =
+    test_db.query_text(
+      db,
+      "SELECT has_guarantor::text FROM application WHERE id = '"
+        <> app_id
+        <> "'::uuid",
+    )
+  flag |> should.equal("true")
+  let assert Ok(gname) =
+    test_db.query_text(
+      db,
+      "SELECT COALESCE(guarantor_name, '') FROM application WHERE id = '"
+        <> app_id
+        <> "'::uuid",
+    )
+  gname |> should.equal("Seamus O'Neill")
+
+  // The attestation consent record fired off the same rule.
+  let assert Ok(g_count) =
+    test_db.query_int(db, "SELECT count(*)::int FROM acknowledgement_record
+       WHERE application_id = '" <> app_id <> "'::uuid
+         AND record_type = 'guarantor_attestation'::consent_type")
+  g_count |> should.equal(1)
+}
