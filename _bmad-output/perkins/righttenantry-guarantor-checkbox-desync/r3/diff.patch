new file mode 100644
index 00000000..7cb22e44
--- /dev/null
+++ b/server/test/application/guarantor_section_test.gleam
@@ -0,0 +1,139 @@
+//// SSR pins for the Guarantor section's two-path rendering (2026-08-04
+//// final policy ruling):
+////   - REQUIRED cohorts (first-time renters, students, unemployed): the
+////     `_guarantor_*` synthetics stamp required/on + fields open, the
+////     matching declared-required notice is armed, and the checkbox is
+////     NEVER pre-ticked — the optional-checkbox gate is hidden in this path.
+////   - OPTIONAL cohorts (retired, employed/self-employed renters): plain
+////     checkbox, painted exactly from posted/restored values.
+////
+//// Lustre serializes attributes sorted by name with empty-valued ones bare,
+//// so the checked shape is `<input checked id="field-has_guarantor" …` —
+//// pin `checked id=` (never a bare `checked`: page copy can contain the
+//// word).
+
+import application/form_sections/common
+import application/form_sections/guarantor
+import gleam/string
+import gleeunit/should
+import lustre/element
+
+const checked_shape = "checked id=\"field-has_guarantor\""
+
+fn render(values: List(#(String, String))) -> String {
+  guarantor.view(values: values, errors: []) |> element.to_string
+}
+
+fn synthetic(html: String, name: String, value: String) -> Bool {
+  // Attributes serialize sorted by name (name, type, value — value last);
+  // an EMPTY value renders bare (`value>`), a non-empty one as `value="…"`.
+  let shape = case value {
+    "" -> "name=\"" <> name <> "\" type=\"hidden\" value>"
+    _ -> "name=\"" <> name <> "\" type=\"hidden\" value=\"" <> value <> "\""
+  }
+  html |> string.contains(shape)
+}
+
+pub fn pristine_render_is_optional_and_unticked_test() {
+  let html = render([])
+  html |> synthetic("_guarantor_cohort", "") |> should.be_true
+  html |> synthetic("_guarantor_required", "") |> should.be_true
+  html |> synthetic("_guarantor_fields_open", "") |> should.be_true
+  html
+  |> string.contains("id=\"field-has_guarantor\"")
+  |> should.be_true
+  html |> string.contains(checked_shape) |> should.be_false
+}
+
+pub fn never_rented_values_render_required_without_pretick_test() {
+  let html = render([#("never_rented_before", "on")])
+  html |> synthetic("_guarantor_cohort", "first_rental") |> should.be_true
+  html |> synthetic("_guarantor_required", "on") |> should.be_true
+  html |> synthetic("_guarantor_fields_open", "on") |> should.be_true
+  // Nothing is ever pre-ticked — the required path carries no check at all.
+  html |> string.contains(checked_shape) |> should.be_false
+}
+
+pub fn student_values_render_required_test() {
+  let html = render([#("employment_status", "student")])
+  html |> synthetic("_guarantor_cohort", "student") |> should.be_true
+  html |> synthetic("_guarantor_required", "on") |> should.be_true
+  html |> synthetic("_guarantor_fields_open", "on") |> should.be_true
+  html |> string.contains(checked_shape) |> should.be_false
+}
+
+pub fn unemployed_values_render_required_test() {
+  let html = render([#("employment_status", "unemployed")])
+  html |> synthetic("_guarantor_cohort", "unemployed") |> should.be_true
+  html |> synthetic("_guarantor_required", "on") |> should.be_true
+}
+
+pub fn retired_values_render_optional_with_hint_cohort_test() {
+  // Retired = OPTIONAL (hint cohort, never required, never pre-ticked).
+  let html = render([#("employment_status", "retired")])
+  html |> synthetic("_guarantor_cohort", "retired") |> should.be_true
+  html |> synthetic("_guarantor_required", "") |> should.be_true
+  html |> synthetic("_guarantor_fields_open", "") |> should.be_true
+  html |> string.contains(checked_shape) |> should.be_false
+}
+
+pub fn retired_first_timer_is_required_via_first_rental_precedence_test() {
+  // Cohort precedence: first_rental beats retired — a retired first-timer
+  // gets the first-rental notice, not the optional hint.
+  let html =
+    render([
+      #("never_rented_before", "on"),
+      #("employment_status", "retired"),
+    ])
+  html |> synthetic("_guarantor_cohort", "first_rental") |> should.be_true
+  html |> synthetic("_guarantor_required", "on") |> should.be_true
+}
+
+pub fn optional_path_posted_check_roundtrips_test() {
+  // Error re-render fidelity: an optional-cohort applicant's posted check
+  // paints checked (this fidelity was correct and must survive), and the
+  // fields stay open for their errors.
+  let html =
+    render([
+      #("employment_status", "employed"),
+      #("has_guarantor", "on"),
+    ])
+  html |> synthetic("_guarantor_required", "") |> should.be_true
+  html |> synthetic("_guarantor_fields_open", "on") |> should.be_true
+  html |> string.contains(checked_shape) |> should.be_true
+}
+
+pub fn optional_path_posted_uncheck_roundtrips_test() {
+  // The desync kill: an optional applicant's UNCHECK stays uncheck on the
+  // re-render — even for cohorts the retired default-check used to re-mark.
+  let html =
+    render([
+      #("employment_status", "student"),
+      #("guarantor_name", "St Casey"),
+    ])
+  html |> string.contains(checked_shape) |> should.be_false
+}
+
+pub fn cohort_mirror_agrees_with_required_rule_test() {
+  // The view mirror and the render derivation must never drift apart.
+  common.guarantor_cohort_is_required(common.guarantor_cohort_first_rental)
+  |> should.be_true
+  common.guarantor_cohort_is_required(common.guarantor_cohort_student)
+  |> should.be_true
+  common.guarantor_cohort_is_required(common.guarantor_cohort_unemployed)
+  |> should.be_true
+  common.guarantor_cohort_is_required(common.guarantor_cohort_retired)
+  |> should.be_false
+  common.guarantor_cohort_is_required(common.guarantor_cohort_none)
+  |> should.be_false
+  common.guarantor_cohort(
+    never_rented_before: True,
+    employment_status: "student",
+  )
+  |> should.equal(common.guarantor_cohort_first_rental)
+  common.guarantor_cohort(
+    never_rented_before: False,
+    employment_status: "retired",
+  )
+  |> should.equal(common.guarantor_cohort_retired)
+}
