+## S0.2/S0.6 — replay-equality: re-step (seed, action_log) twice -> byte-identical
+## SimSnapshot (AC-E10, ADR-11). The determinism spine's keystone test.
+extends TestSuite
+
+
+func run() -> Array:
+	_test_replay_equality()
+	_test_seed_changes_stream()
+	return results
+
+
+func _bootstrap(seed: int) -> RunState:
+	var c := GameCatalogs.load_default()
+	var b: BalanceData = c.balance
+	var d := ScriptedDirector.load_from("res://data/demand.json")
+	return RunState.bootstrap(seed, c, b, d)
+
+
+func _step_n(state: RunState, n: int) -> SimSnapshot:
+	var driver := SimDriver.new()
+	var snap: SimSnapshot = null
+	for i: int in n:
+		snap = driver.step(state, i + 1, [])   # empty action log
+	return snap
+
+
+func _test_replay_equality() -> void:
+	_start("replay: same seed -> byte-identical snapshot fingerprint (AC-E10)")
+	var a := _bootstrap(12345)
+	var b := _bootstrap(12345)
+	var sa := _step_n(a, 40)
+	var sb := _step_n(b, 40)
+	# demand is flowing (the map + era-3 demand produce spawns) -> non-trivial state
+	check(a.spawned_total > 0, "demand flowing (spawned=%d)" % a.spawned_total)
+	eq(a.spawned_total, b.spawned_total, "spawned totals match")
+	var fa: String = sa.to_fingerprint()
+	var fb: String = sb.to_fingerprint()
+	eq(fa, fb, "fingerprints differ")
+
+
+func _test_seed_changes_stream() -> void:
+	_start("replay: different seed -> divergent rng stream (sanity)")
+	var a := _bootstrap(12345)
+	var b := _bootstrap(99999)
+	_step_n(a, 40)
+	_step_n(b, 40)
+	# Both runs consumed the SAME amount of rng (identical spawn volumes), but from
+	# different seeds -> their stream states MUST diverge (proves the seed propagates).
+	# (Fingerprints can converge in the degenerate no-pipes case because the rng-
+	# dependent dst picks don't affect the drop aggregates, so rng state is the honest
+	# signal here.)
+	check(a.rng.state != b.rng.state, "rng states identical across different seeds")
