+## Headless test runner (FinLit `extends SceneTree` pattern, project-context).
+## Runs every S0 suite, prints failures + a summary, quits non-zero on any fail.
+## Invoke:  godot --headless --path game --script res://tests/run_tests.gd
+extends SceneTree
+
+
+func _init() -> void:
+	var suite_paths: Array[String] = [
+		"res://tests/core/test_parse_gate.gd",
+		"res://tests/core/test_catalogs.gd",
+		"res://tests/core/test_qos.gd",
+		"res://tests/core/test_demand.gd",
+		"res://tests/core/test_director.gd",
+		"res://tests/core/test_topology.gd",
+		"res://tests/core/test_routing.gd",
+		"res://tests/core/test_replay.gd",
+	]
+	var total_pass: int = 0
+	var total_fail: int = 0
+	for path: String in suite_paths:
+		var suite: TestSuite = load(path).new()
+		suite.run()
+		print("\n— %s —" % path)
+		var sp: int = 0
+		var sf: int = 0
+		for r: Dictionary in suite.results:
+			if bool(r["passed"]):
+				sp += 1
+				total_pass += 1
+			else:
+				sf += 1
+				total_fail += 1
+				print("  ✗ FAIL: %s — %s" % [r["name"], r["msg"]])
+		print("  %d/%d passed" % [sp, sp + sf])
+	print("\n=========================")
+	print("TOTAL: %d passed, %d failed" % [total_pass, total_fail])
+	print("=========================")
+	quit(1 if total_fail > 0 else 0)
