--- /dev/null
+++ b/game/tests/test_suite.gd
@@ -0,0 +1,41 @@
+## Minimal headless test base (the FinLit `extends SceneTree` runner pattern,
+## project-context mandate). Each suite extends this; the runner collects results.
+## Pure RefCounted — never a Node (so suites are themselves headless-safe).
+class_name TestSuite
+extends RefCounted
+
+var results: Array = []          # Array[Dictionary{name, passed, msg}]
+var _current: String = ""
+
+
+func run() -> Array:
+	# Subclasses override: call test methods here.
+	return results
+
+
+func _start(name: String) -> void:
+	_current = name
+
+
+func _record(passed: bool, msg: String = "") -> void:
+	results.append({"name": _current, "passed": passed, "msg": msg})
+
+
+func check(cond: bool, msg: String = "") -> void:
+	_record(bool(cond), msg)
+
+
+func eq(actual: Variant, expected: Variant, msg: String = "") -> void:
+	var ok: bool = actual == expected
+	if not ok:
+		_record(false, "%s — got %s, expected %s" % [msg, str(actual), str(expected)])
+	else:
+		_record(true)
+
+
+func fail(msg: String = "") -> void:
+	_record(false, msg)
+
+
