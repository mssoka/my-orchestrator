+++ b/game/tests/core/test_demand.gd
@@ -0,0 +1,83 @@
+## S0.4 — dst-selection determinism + weighted distribution (sprint-plan §3.3, AC-E10).
+extends TestSuite
+
+
+func run() -> Array:
+	_test_dst_selection_determinism()
+	_test_weighted_distribution()
+	_test_empty_sink_unmet()
+	return results
+
+
+func _build_topo() -> TopologySnapshot:
+	var g := TopologyGraph.new()
+	for i: int in 4:
+		g.spawn_node(CoreConst.NodeKind.TERMINAL, &"residential",
+			CoreConst.TerminalRole.RESIDENTIAL, Vector2i(i * 4, 0), 5, 0)
+	g.spawn_node(CoreConst.NodeKind.TERMINAL, &"content_host",
+		CoreConst.TerminalRole.CONTENT_HOST, Vector2i(20, 0), 40, 0)
+	return g.snapshot()
+
+
+func _test_dst_selection_determinism() -> void:
+	_start("demand: dst-selection byte-identical across same-seed runs (AC-E10)")
+	var topo := _build_topo()
+	var spec := DemandSpec.new(&"streaming",
+		TerminalSelector.new(&"content_host"), TerminalSelector.new(&"residential"),
+		SelectionRule.new(CoreConst.SelectionMode.WEIGHTED_RANDOM), 200, CoreConst.Lane.STANDARD, 1)
+	var rng1 := RandomNumberGenerator.new()
+	rng1.seed = 777
+	var rng2 := RandomNumberGenerator.new()
+	rng2.seed = 777
+	var t1: Array[SpawnTriple] = DemandResolver.resolve(spec, 200, topo, rng1)
+	var t2: Array[SpawnTriple] = DemandResolver.resolve(spec, 200, topo, rng2)
+	eq(t1.size(), t2.size(), "same count")
+	var identical: bool = t1.size() == t2.size()
+	for i: int in t1.size():
+		if not t1[i].equals(t2[i]):
+			identical = false
+			break
+	check(identical, "spawn triples differ across same-seed runs")
+
+
+func _test_weighted_distribution() -> void:
+	_start("demand: dst distribution tracks sink weights (sprint-plan §3.3)")
+	# Build a topology where residential sink #1 has weight 4, others 1 -> total 7.
+	var g := TopologyGraph.new()
+	for i: int in 4:
+		var n := g.spawn_node(CoreConst.NodeKind.TERMINAL, &"residential",
+			CoreConst.TerminalRole.RESIDENTIAL, Vector2i(i * 4, 0), 5, 0)
+		if i == 1:
+			n.demand_weight = 4
+	g.spawn_node(CoreConst.NodeKind.TERMINAL, &"content_host",
+		CoreConst.TerminalRole.CONTENT_HOST, Vector2i(20, 0), 40, 0)
+	var topo := g.snapshot()
+	var spec := DemandSpec.new(&"streaming",
+		TerminalSelector.new(&"content_host"), TerminalSelector.new(&"residential"),
+		SelectionRule.new(CoreConst.SelectionMode.WEIGHTED_RANDOM), 4000, CoreConst.Lane.STANDARD, 1)
+	var rng := RandomNumberGenerator.new()
+	rng.seed = 4242
+	var triples: Array[SpawnTriple] = DemandResolver.resolve(spec, 4000, topo, rng)
+	var hits: Dictionary = {}
+	for t: SpawnTriple in triples:
+		hits[t.dst_node_id] = int(hits.get(t.dst_node_id, 0)) + 1
+	# weighted sink (the 2nd residential, node id 2) should attract ~4/7 (~57%).
+	var weighted_id: int = 2
+	var frac: float = float(hits.get(weighted_id, 0)) / float(triples.size())
+	check(frac > 0.50 and frac < 0.64, "weighted sink frac=%.3f (expected ~0.57)" % frac)
+
+
+func _test_empty_sink_unmet() -> void:
+	_start("demand: no eligible sinks -> empty triples (visible unmet, E1.4)")
+	var g := TopologyGraph.new()
+	# only a content_host, no residential sinks
+	g.spawn_node(CoreConst.NodeKind.TERMINAL, &"content_host",
+		CoreConst.TerminalRole.CONTENT_HOST, Vector2i(0, 0), 40, 0)
+	var topo := g.snapshot()
+	var spec := DemandSpec.new(&"streaming",
+		TerminalSelector.new(&"content_host"), TerminalSelector.new(&"residential"),
+		SelectionRule.new(CoreConst.SelectionMode.WEIGHTED_RANDOM), 50, CoreConst.Lane.STANDARD, 1)
+	var rng := RandomNumberGenerator.new()
+	rng.seed = 1
+	var triples: Array[SpawnTriple] = DemandResolver.resolve(spec, 50, topo, rng)
+	eq(triples.size(), 0, "no sinks -> no triples (unmet demand surfaced)")
