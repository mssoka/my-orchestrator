+++ b/game/tests/core/test_catalogs.gd
@@ -0,0 +1,63 @@
+## S0.3 — catalog load + JSON round-trip (ints re-cast, [FinLT] trap; NFR5).
+extends TestSuite
+
+
+func run() -> Array:
+	_test_loads_without_errors()
+	_test_mvp_packet_types()
+	_test_pipe_tiers()
+	_test_node_types()
+	_test_balance_recast_ints()
+	return results
+
+
+func _test_loads_without_errors() -> void:
+	_start("catalogs: load_default has no errors")
+	var c := GameCatalogs.load_default()
+	check(not c.has_errors(), "load_errors=%s" % str(c.load_errors))
+
+
+func _test_mvp_packet_types() -> void:
+	_start("catalogs: MVP packet types (email + streaming)")
+	var c := GameCatalogs.load_default()
+	check(c.packet_types.has(&"email"), "missing email")
+	check(c.packet_types.has(&"streaming"), "missing streaming")
+	var email: PacketTypeData = c.packet_type(&"email")
+	# game-wide default lane = Standard (sprint-plan §8 #7)
+	eq(email.default_lane, CoreConst.Lane.STANDARD, "email default lane")
+	# int re-cast: latency_tol_ms must be an int (not a float from JSON)
+	eq(typeof(email.latency_tol_ms), TYPE_INT, "email latency type is int")
+	eq(email.bandwidth_demand, 1, "email bandwidth")
+	var stream: PacketTypeData = c.packet_type(&"streaming")
+	eq(stream.default_lane, CoreConst.Lane.STANDARD, "streaming default lane")
+	eq(typeof(stream.bandwidth_demand), TYPE_INT, "streaming bandwidth type is int")
+
+
+func _test_pipe_tiers() -> void:
+	_start("catalogs: pipe tiers (narrow/standard/wide)")
+	var c := GameCatalogs.load_default()
+	check(c.pipe_tiers.has(&"narrow") and c.pipe_tiers.has(&"standard") and c.pipe_tiers.has(&"wide"))
+	var wide: PipeTierData = c.pipe_tier(&"wide")
+	eq(typeof(wide.capacity_units), TYPE_INT, "wide capacity int")
+	check(wide.max_span > 0, "wide max_span set")
+
+
+func _test_node_types() -> void:
+	_start("catalogs: node types (residential/content_host/router)")
+	var c := GameCatalogs.load_default()
+	check(c.node_types.has(&"residential") and c.node_types.has(&"content_host") and c.node_types.has(&"router"))
+	var r: NodeTypeData = c.node_type(&"router")
+	eq(r.kind, CoreConst.NodeKind.JUNCTION, "router is junction")
+	var ch: NodeTypeData = c.node_type(&"content_host")
+	eq(ch.kind, CoreConst.NodeKind.TERMINAL, "content_host is terminal")
+
+
+func _test_balance_recast_ints() -> void:
+	_start("catalogs: balance ints re-cast after JSON load ([FinLT])")
+	var c := GameCatalogs.load_default()
+	var b: BalanceData = c.balance
+	check(b != null, "balance loaded")
+	eq(typeof(b.logic_hz), TYPE_INT, "logic_hz is int")
+	eq(b.logic_hz, 10, "logic_hz == 10")
+	eq(typeof(b.snap_radius), TYPE_INT, "snap_radius is int")
+	eq(b.default_lane_weights, Vector3i(1, 4, 1), "default lane weights")
