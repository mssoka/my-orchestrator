+## S1/E1.4/E1.5 — routing: flow reaches connected sinks; round-robin at parallel
+## pipes; unreachable demand is visible (drops, never silent). Plus determinism
+## of the routing+traversal (replay-safe).
+extends TestSuite
+
+
+func _wired_topo(parallel: bool) -> TopologySnapshot:
+	var c := GameCatalogs.load_default()
+	var b := BalanceData.new()
+	var e := Economy.new(100000)
+	var g := TopologyGraph.new(c, e, b)
+	g.spawn_node(CoreConst.NodeKind.TERMINAL, &"content_host",
+		CoreConst.TerminalRole.CONTENT_HOST, Vector2i(20, 10), 40, 0)   # id 1
+	g.spawn_node(CoreConst.NodeKind.JUNCTION, &"router", -1,
+		Vector2i(12, 10), 60, 0)                                        # id 2
+	g.spawn_node(CoreConst.NodeKind.TERMINAL, &"residential",
+		CoreConst.TerminalRole.RESIDENTIAL, Vector2i(4, 4), 5, 0)       # id 3
+	g.spawn_node(CoreConst.NodeKind.TERMINAL, &"residential",
+		CoreConst.TerminalRole.RESIDENTIAL, Vector2i(4, 16), 5, 0)      # id 4
+	g.apply_edit(Command.DrawPipeCmd.new(0, 1, 2, &"standard"))         # content-router
+	if parallel:
+		g.apply_edit(Command.DrawPipeCmd.new(0, 1, 2, &"standard"))     # 2nd parallel
+	g.apply_edit(Command.DrawPipeCmd.new(0, 2, 3, &"standard"))         # router-res1
+	g.apply_edit(Command.DrawPipeCmd.new(0, 2, 4, &"standard"))         # router-res2
+	return g.snapshot()
+
+
+func run() -> Array:
+	_test_flow_reaches_sinks()
+	_test_round_robin_parallel()
+	_test_unreachable_visible()
+	return results
+
+
+func _test_flow_reaches_sinks() -> void:
+	_start("routing: packets deliver to connected sinks (E1.4)")
+	var topo := _wired_topo(false)
+	var c := GameCatalogs.load_default()
+	var flow := PacketFlow.new(c, c.balance)
+	var spec := DemandSpec.new(&"streaming",
+		TerminalSelector.new(&"content_host"), TerminalSelector.new(&"residential"),
+		SelectionRule.new(CoreConst.SelectionMode.WEIGHTED_RANDOM), 5, CoreConst.Lane.STANDARD, 1)
+	var rng := RandomNumberGenerator.new()
+	rng.seed = 7
+	var plan := PressurePlan.new(0, [spec], [])
+	var delivered: int = 0
+	for tick: int in 30:
+		var report: FlowReport = flow.step(tick + 1, rng, topo, 3, plan)
+		delivered += report.delivered
+	check(delivered > 0, "no packets delivered (delivered=%d)" % delivered)
+
+
+func _test_round_robin_parallel() -> void:
+	_start("routing: round-robin splits parallel pipes (E1.5)")
+	var topo := _wired_topo(true)
+	var c := GameCatalogs.load_default()
+	var flow := PacketFlow.new(c, c.balance)
+	# two packets, same src/dst -> first edge should pick DIFFERENT parallel pipes
+	var r1: Array[int] = flow._compute_route(1, 3, topo)
+	var r2: Array[int] = flow._compute_route(1, 3, topo)
+	check(r1.size() > 0 and r2.size() > 0, "routes computed")
+	if r1.size() > 0 and r2.size() > 0:
+		check(r1[0] != r2[0], "parallel pipes not round-robin'd (both=%d)" % r1[0])
+
+
+func _test_unreachable_visible() -> void:
+	_start("routing: unreachable demand drops visibly (E1.4)")
+	# content_host with NO pipes to residential -> every packet drops "unreachable"
+	var c := GameCatalogs.load_default()
+	var b := BalanceData.new()
+	var g := TopologyGraph.new(c, Economy.new(100000), b)
+	g.spawn_node(CoreConst.NodeKind.TERMINAL, &"content_host",
+		CoreConst.TerminalRole.CONTENT_HOST, Vector2i(0, 0), 40, 0)
+	g.spawn_node(CoreConst.NodeKind.TERMINAL, &"residential",
+		CoreConst.TerminalRole.RESIDENTIAL, Vector2i(10, 0), 5, 0)
+	var topo := g.snapshot()
+	var flow := PacketFlow.new(c, c.balance)
+	var spec := DemandSpec.new(&"streaming",
+		TerminalSelector.new(&"content_host"), TerminalSelector.new(&"residential"),
+		SelectionRule.new(CoreConst.SelectionMode.WEIGHTED_RANDOM), 5, CoreConst.Lane.STANDARD, 1)
+	var rng := RandomNumberGenerator.new()
+	rng.seed = 3
+	var plan := PressurePlan.new(0, [spec], [])
+	var dropped: int = 0
+	for tick: int in 10:
+		var report: FlowReport = flow.step(tick + 1, rng, topo, 3, plan)
+		dropped += report.dropped
+	check(dropped > 0, "unreachable packets should drop visibly (dropped=%d)" % dropped)
