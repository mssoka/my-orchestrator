+## A per-source-class demand entry (sprint-plan §3.1).
+##
+## Names the packet class, the typed source set, the typed sink set, the
+## destination-selection rule, and a volume curve. Demand says WHAT KIND of
+## traffic flows and WHERE it wants to go; the player's drawn topology decides
+## HOW it routes. Tunable per-era content (ADR-5) driven through the
+## CrisisDirector seam (ADR-7) — not hard-coded src→dst pairs.
+class_name DemandSpec
+extends RefCounted
+
+var class_id: StringName = &""                  # packet type (email, streaming, ...)
+var source_selector: TerminalSelector = null     # WHICH terminals originate it
+var sink_selector: TerminalSelector = null       # the eligible sink set
+var selection_rule: SelectionRule = null         # how dst is chosen from the sink set
+var volume_units_per_tick: int = 0               # base demand volume (packets/tick)
+var default_lane: int = CoreConst.Lane.STANDARD  # Express/Standard/Best start lane
+var demand_weight: int = 1                       # relative weight vs siblings (tunable)
+
+
+func _init(p_class: StringName = &"",
+		   p_source: TerminalSelector = null,
+		   p_sink: TerminalSelector = null,
+		   p_rule: SelectionRule = null,
+		   p_volume: int = 0,
+		   p_lane: int = CoreConst.Lane.STANDARD,
+		   p_weight: int = 1) -> void:
+	class_id = p_class
+	source_selector = p_source if p_source != null else TerminalSelector.new()
+	sink_selector = p_sink if p_sink != null else TerminalSelector.new()
+	selection_rule = p_rule if p_rule != null else SelectionRule.new()
+	volume_units_per_tick = p_volume
+	default_lane = p_lane
+	demand_weight = p_weight
