new file mode 100644
index 0000000..0cc8473
--- /dev/null
+++ b/game/scripts/core/demand_resolver.gd
@@ -0,0 +1,93 @@
+## Deterministic demand resolution (sprint-plan §3.3 — the destination-selection rule).
+##
+## Turns a DemandSpec into SpawnTriples over the live topology: pick a source
+## (seeded, by demand_weight), pick each packet's dst from the eligible sink set
+## per the selection rule (WEIGHTED_RANDOM by demand_weight, seeded, ties by rng).
+## Every choice goes through the seeded rng -> the whole spawn sequence reproduces
+## from (seed, era, tick) (ADR-9/10, AC-E10). Pure + headless (no Node, ADR-1).
+##
+## MVP default rule = WEIGHTED_RANDOM. ROUND_ROBIN is supported (designer mode).
+## NEAREST_HOPS is REJECTED for the MVP (it hides the routing puzzle) — left in
+## the enum but not implemented here (would need player-topology hop analysis).
+class_name DemandResolver
+extends RefCounted
+
+
+## Resolve `volume` packets for `spec` this tick. Returns SpawnTriples (may be
+## fewer than volume if sources/sinks are empty — that unmet demand is VISIBLE,
+## never silently lost, E1.4).
+static func resolve(spec: DemandSpec, volume: int, topology: TopologySnapshot,
+					rng: RandomNumberGenerator) -> Array[SpawnTriple]:
+	var out: Array[SpawnTriple] = []
+	if volume <= 0:
+		return out
+	var sources: Array = topology.terminals(spec.source_selector.node_role)
+	var sinks: Array = topology.terminals(spec.sink_selector.node_role)
+	if sources.is_empty() or sinks.is_empty():
+		return out   # unmet demand — caller (PacketFlow) surfaces it as visible loss
+
+	var src_weights: Array[int] = _weights_for(sources, topology, spec.selection_rule)
+	var sink_weights: Array[int] = _weights_for(sinks, topology, spec.selection_rule)
+
+	for _i: int in volume:
+		var src_id: int = _weighted_pick(sources, src_weights, rng)
+		# dst: pick from sinks, preferring dst != src when alternatives exist (email P2P).
+		var dst_id: int = _pick_dst(sinks, sink_weights, src_id, spec.selection_rule.mode, rng)
+		out.append(SpawnTriple.new(spec.class_id, src_id, dst_id, spec.default_lane))
+	return out
+
+
+static func _weights_for(ids: Array, topology: TopologySnapshot,
+						 rule: SelectionRule) -> Array[int]:
+	var w: Array[int] = []
+	if rule.weight_by == &"uniform":
+		w.resize(ids.size())
+		w.fill(1)
+		return w
+	# weight_by == "demand_weight" -> read each terminal's demand_weight
+	for nid: int in ids:
+		var n: NetNode = topology.nodes.get(nid)
+		w.append(n.demand_weight if n != null else 1)
+	return w
+
+
+## Weighted pick over items with int weights, via the seeded rng. Uniform if all
+## weights are zero. Ties resolve by rng, never by container order (ADR-10 corollary).
+static func _weighted_pick(items: Array, weights: Array[int],
+						   rng: RandomNumberGenerator) -> int:
+	if items.is_empty():
+		return -1
+	if items.size() == 1:
+		return items[0]
+	var total: int = 0
+	for wgt: int in weights:
+		total += wgt
+	if total <= 0:
+		return items[rng.randi() % items.size()]
+	var r: int = rng.randi_range(0, total - 1)
+	var acc: int = 0
+	for i: int in items.size():
+		acc += weights[i]
+		if r < acc:
+			return items[i]
+	return items[items.size() - 1]
+
+
+## Pick a destination, preferring dst != src (email P2P) when the sink set allows.
+static func _pick_dst(sinks: Array, weights: Array[int], src_id: int,
+					  mode: int, rng: RandomNumberGenerator) -> int:
+	# ROUND_ROBIN (designer mode, NOT the MVP default) needs a per-spec cursor that
+	# is part of sim state; true round-robin is full-game plumbing. MVP impl: a
+	# deterministic seeded pick (reproducible; not perfectly even). WEIGHTED_RANDOM
+	# is the MVP default and what the fun-test runs.
+	# WEIGHTED_RANDOM (MVP default). Exclude src when the sink set has >1 option.
+	var cand: Array = sinks
+	var cand_w: Array[int] = weights
+	if sinks.size() > 1:
+		cand = []
+		cand_w = []
+		for i: int in sinks.size():
+			if sinks[i] != src_id:
+				cand.append(sinks[i])
+				cand_w.append(weights[i])
+	return _weighted_pick(cand, cand_w, rng)
