diff --git a/game/scripts/core/command.gd b/game/scripts/core/command.gd
new file mode 100644
index 0000000..1d3b615
--- /dev/null
+++ b/game/scripts/core/command.gd
@@ -0,0 +1,112 @@
+## Command value objects (ADR-12: unified InputMap action -> Command intent).
+##
+## The Input Layer (Presentation, Node-based) produces raw intent; the
+## CommandBus (Core) validates + snaps + applies these. Batches are
+## validate-all-then-apply (AC-E23): any invalid command rejects the whole
+## batch, so no partial-tick state ever exists.
+##
+## Commands are pure data (RefCounted) — never Nodes (ADR-1). Each carries the
+## `tick` it was issued at, so the action log (ADR-11) is replayable.
+##
+## Subclasses are inner classes off the `Command` base; use the `type` field to
+## dispatch, or `instance_from_dict` / typed casts.
+class_name Command
+extends RefCounted
+
+enum Type {
+	DRAW_PIPE = 0,
+	UPGRADE_PIPE = 1,
+	DEMOLISH = 2,
+	SET_LANE_WEIGHTS = 3,
+	SET_JUNCTION_POLICY = 4,
+	SET_PIPE_PRIORITY = 7,
+	PAUSE = 5,
+	RESUME = 6,
+}
+
+var tick: int = 0
+var type: int = Type.PAUSE
+
+
+# --- Draw a pipe between two (already-snapped) node ids -----------------------
+class DrawPipeCmd:
+	extends Command
+	var a_id: int = -1
+	var b_id: int = -1
+	var tier_id: StringName = &""
+	func _init(p_tick: int = 0, p_a: int = -1, p_b: int = -1, p_tier: StringName = &"") -> void:
+		tick = p_tick
+		type = Type.DRAW_PIPE
+		a_id = p_a
+		b_id = p_b
+		tier_id = p_tier
+
+
+# --- Upgrade an existing pipe to a new tier -----------------------------------
+class UpgradePipeCmd:
+	extends Command
+	var pipe_id: int = -1
+	var to_tier_id: StringName = &""
+	func _init(p_tick: int = 0, p_pipe: int = -1, p_tier: StringName = &"") -> void:
+		tick = p_tick
+		type = Type.UPGRADE_PIPE
+		pipe_id = p_pipe
+		to_tier_id = p_tier
+
+
+# --- Demolish a pipe OR a junction node (terminals forbidden, AC-E2) ----------
+class DemolishCmd:
+	extends Command
+	var target_id: int = -1
+	var is_node: bool = false
+	func _init(p_tick: int = 0, p_target: int = -1, p_is_node: bool = false) -> void:
+		tick = p_tick
+		type = Type.DEMOLISH
+		target_id = p_target
+		is_node = p_is_node
+
+
+# --- Set a pipe's lane weights (the QoS decision, ADR-3) ----------------------
+# weights is Vector3i: x=Express, y=Standard, z=Best (integer, ADR-10).
+class SetLaneWeightsCmd:
+	extends Command
+	var pipe_id: int = -1
+	var weights: Vector3i = Vector3i(1, 4, 1)
+	func _init(p_tick: int = 0, p_pipe: int = -1, p_weights: Vector3i = Vector3i(1, 4, 1)) -> void:
+		tick = p_tick
+		type = Type.SET_LANE_WEIGHTS
+		pipe_id = p_pipe
+		weights = p_weights
+
+
+# --- Pause / resume the run (E7.4) --------------------------------------------
+class PauseCmd:
+	extends Command
+	func _init(p_tick: int = 0) -> void:
+		tick = p_tick
+		type = Type.PAUSE
+
+
+class ResumeCmd:
+	extends Command
+	func _init(p_tick: int = 0) -> void:
+		tick = p_tick
+		type = Type.RESUME
+
+
+# Set a pipe's QoS priority class (S3 E2.2): "" balanced | "streaming" | "email".
+# Promotes one class to the Express lane (guaranteed bandwidth) and demotes the
+# other to Best-effort (drops first under contention) on THAT pipe.
+class SetPipePriorityCmd:
+	extends Command
+	var pipe_id: int = -1
+	var priority_class: StringName = &""
+	func _init(p_tick: int = 0, p_pipe: int = -1, p_priority: StringName = &"") -> void:
+		tick = p_tick
+		type = Type.SET_PIPE_PRIORITY
+		pipe_id = p_pipe
+		priority_class = p_priority
+
+
+func _to_string() -> String:
+	return "Cmd[tick=%d type=%d]" % [tick, type]
