+## An immutable topology snapshot (S1.1, architecture §6.1).
+##
+## The only Topology view PacketFlow / CrisisEngine / the View read. Produced by
+## TopologyGraph.snapshot(); never mutated after creation. Carries terminals-by-
+## role (for demand source/sink selection) + the node/pipe maps + adjacency.
+class_name TopologySnapshot
+extends RefCounted
+
+var nodes: Dictionary = {}              # int -> NetNode
+var pipes: Dictionary = {}              # int -> NetPipe
+var adjacency: Dictionary = {}          # int -> Array[int] (neighbor node ids)
+var terminals_by_role: Dictionary = {}  # StringName role name -> Array[int] node ids
+var pipes_by_pair: Dictionary = {}      # canonical "a<b" -> Array[NetPipe] (E1.5 parallel)
+
+
+func neighbors(node_id: int) -> Array:
+	return adjacency.get(node_id, [])
+
+
+func pipe_between(a: int, b: int) -> NetPipe:
+	var arr: Array = pipes_by_pair.get(_pair_key(a, b), [])
+	return arr[0] if not arr.is_empty() else null
+
+
+## All pipes connecting a node pair (for round-robin LB, E1.5).
+func pipes_between(a: int, b: int) -> Array:
+	return pipes_by_pair.get(_pair_key(a, b), [])
+
+
+func terminals(role: StringName) -> Array:
+	return terminals_by_role.get(role, [])
+
+
+static func _pair_key(a: int, b: int) -> String:
+	# Canonical order so A->B and B->A resolve to the same pipe.
+	if a <= b:
+		return "%d<%d" % [a, b]
+	return "%d<%d" % [b, a]
+
+
+func _to_string() -> String:
+	return "TopologySnapshot(nodes=%d pipes=%d)" % [nodes.size(), pipes.size()]
