+## A resolved spawn triple — (class, source_node_id, destination_node_id).
+##
+## Produced deterministically from a DemandSpec over the live topology (the
+## destination-selection rule, sprint-plan §3.3). The dst-selection determinism
+## test (S0.4) asserts the spawn-triple sequence is byte-identical across runs.
+class_name SpawnTriple
+extends RefCounted
+
+var class_id: StringName = &""
+var src_node_id: int = -1
+var dst_node_id: int = -1
+var lane: int = CoreConst.Lane.STANDARD
+
+
+func _init(p_class: StringName = &"", p_src: int = -1, p_dst: int = -1,
+		   p_lane: int = CoreConst.Lane.STANDARD) -> void:
+	class_id = p_class
+	src_node_id = p_src
+	dst_node_id = p_dst
+	lane = p_lane
+
+
+func equals(other: SpawnTriple) -> bool:
+	return class_id == other.class_id and src_node_id == other.src_node_id \
+		and dst_node_id == other.dst_node_id and lane == other.lane
