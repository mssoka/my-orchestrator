+## A typed source/sink selector (sprint-plan §3.1).
+##
+## Selects terminals by ROLE (map-agnostic), never by hard node-id, so the same
+## demand works on any seeded map. cardinality -1 = all matching; n = pick n
+## (seeded) — usually -1 (all).
+class_name TerminalSelector
+extends RefCounted
+
+var node_role: StringName = &""    # e.g. &"residential", &"content_host"
+var cardinality: int = -1          # -1 = all matching; n = pick n via seeded rng
+
+
+func _init(p_role: StringName = &"", p_card: int = -1) -> void:
+	node_role = p_role
+	cardinality = p_card
