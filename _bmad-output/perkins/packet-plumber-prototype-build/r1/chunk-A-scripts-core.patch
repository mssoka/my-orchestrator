+## Schema for a node-type catalog entry (GDD § M3, ADR-5).
+class_name NodeTypeData
+extends Resource
+
+var id: StringName = &""
+var display_name: String = ""
+var kind: int = 0                   # CoreConst.NodeKind (TERMINAL | JUNCTION)
+var terminal_role: int = -1         # CoreConst.TerminalRole (-1 for junctions)
+var throughput_units: int = 0       # node throughput ceiling (FR8)
+var lb_mode_capable: bool = false   # supports bandwidth-aware LB (full-game unlock)
+var era_introduced: int = 1
