+## The destination-selection rule (sprint-plan §3.3 — DECIDED + pinned).
+##
+## MVP default = WEIGHTED_RANDOM over the eligible sink set, weighted by each
+## terminal's demand_weight, seeded, ties by rng (AC-E10). NEAREST_HOPS is
+## REJECTED for the MVP (it hides the routing puzzle — distance is a
+## player-topology consequence, not a demand property). ROUND_ROBIN is left in
+## the enum for designer use but is not the default.
+class_name SelectionRule
+extends RefCounted
+
+var mode: int = CoreConst.SelectionMode.WEIGHTED_RANDOM
+var weight_by: StringName = &"demand_weight"   # &"demand_weight" | &"uniform"
+
+
+func _init(p_mode: int = CoreConst.SelectionMode.WEIGHTED_RANDOM,
+		   p_weight_by: StringName = &"demand_weight") -> void:
+	mode = p_mode
+	weight_by = p_weight_by
