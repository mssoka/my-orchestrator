+## Typed Result for recoverable Core operations (architecture §7.1).
+##
+## Every fallible Core op returns an EditResult; the caller decides. Nothing is
+## swallowed (never catch-and-ignore, project-context.md). `reason` is a
+## StringName so comparisons are cheap and stable (AC-E3 self_loop etc.).
+##
+## Pure RefCounted — no Node (ADR-1).
+class_name EditResult
+extends RefCounted
+
+var ok: bool = false
+var reason: StringName = &""   # empty when ok; e.g. &"self_loop", &"over_budget"
+
+static func applied() -> EditResult:
+	var r := EditResult.new()
+	r.ok = true
+	return r
+
+static func rejected(why: StringName) -> EditResult:
+	var r := EditResult.new()
+	r.ok = false
+	r.reason = why
+	return r
+
+func _to_string() -> String:
+	if ok:
+		return "EditResult.ok"
+	return "EditResult.rejected(%s)" % reason
