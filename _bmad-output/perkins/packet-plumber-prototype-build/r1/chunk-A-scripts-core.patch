diff --git a/game/scripts/core/scripted_director.gd b/game/scripts/core/scripted_director.gd
new file mode 100644
index 0000000..3e11c78
--- /dev/null
+++ b/game/scripts/core/scripted_director.gd
@@ -0,0 +1,116 @@
+## ScriptedDirector — the MVP CrisisDirector impl (S0.5, ADR-7).
+##
+## Data-driven + deterministic: turns the era demand catalog (res://data/demand.json)
+## into a per-tick PressurePlan. The same seam the V2 AiAuditorDirector will
+## satisfy (forge weak #4) — only the impl differs. Deterministic: same
+## (era, tick) -> identical PressurePlan (S0.5 AC). plan_pressure never spawns a
+## crisis/set-piece that doesn't trace to the catalog (fair + predictable, FORGE #3).
+##
+## Pure RefCounted (ADR-1). The rng param is accepted (interface contract) but
+## unused in the MVP — demand RESOLUTION (dst pick) consumes it in PacketFlow.
+class_name ScriptedDirector
+extends CrisisDirector
+
+var _era_demand: Dictionary = {}        # int era_id -> Array[DemandSpec]
+var _era_set_pieces: Dictionary = {}    # int era_id -> Array[SetPiece]
+var load_ok: bool = true
+
+
+static func load_from(path: String) -> ScriptedDirector:
+	var d := ScriptedDirector.new()
+	d._load(path)
+	return d
+
+
+func _load(path: String) -> void:
+	if not FileAccess.file_exists(path):
+		push_error("[ScriptedDirector] missing %s" % path)
+		load_ok = false
+		return
+	var f := FileAccess.open(path, FileAccess.READ)
+	var text := f.get_as_text()
+	f.close()
+	var parsed: Variant = JSON.parse_string(text)
+	if parsed == null or not parsed is Dictionary:
+		push_error("[ScriptedDirector] invalid JSON in %s" % path)
+		load_ok = false
+		return
+	var eras: Dictionary = parsed["eras"]
+	for era_key: Variant in eras:
+		var era_id: int = int(era_key)
+		var era_obj: Dictionary = eras[era_key]
+		_era_demand[era_id] = _parse_entries(era_obj.get("entries", []))
+		_era_set_pieces[era_id] = _parse_set_pieces(era_obj.get("set_pieces", []))
+
+
+func _parse_entries(arr: Array) -> Array[DemandSpec]:
+	var out: Array[DemandSpec] = []
+	for e: Variant in arr:
+		var d: Dictionary = e
+		var mode: int = _mode_from_string(d.get("selection", "weighted_random"))
+		out.append(DemandSpec.new(
+			StringName(d["class_id"]),
+			TerminalSelector.new(StringName(d.get("source_role", &"")), int(d.get("source_card", -1))),
+			TerminalSelector.new(StringName(d.get("sink_role", &"")), int(d.get("sink_card", -1))),
+			SelectionRule.new(mode, &"demand_weight"),
+			int(d.get("volume", 0)),
+			int(d.get("default_lane", CoreConst.Lane.STANDARD)),
+			int(d.get("demand_weight", 1))
+		))
+	return out
+
+
+func _parse_set_pieces(arr: Array) -> Array[SetPiece]:
+	var out: Array[SetPiece] = []
+	for e: Variant in arr:
+		var d: Dictionary = e
+		out.append(SetPiece.new(
+			StringName(d["id"]),
+			StringName(d["class_id"]),
+			int(d.get("multiplier", 1)),
+			int(d.get("start_tick", 0)),
+			int(d.get("duration_ticks", 0)),
+			int(d.get("forecast_lead_ticks", 0))
+		))
+	return out
+
+
+static func _mode_from_string(s: String) -> int:
+	match s:
+		"weighted_random":
+			return CoreConst.SelectionMode.WEIGHTED_RANDOM
+		"round_robin":
+			return CoreConst.SelectionMode.ROUND_ROBIN
+		"nearest_hops":
+			return CoreConst.SelectionMode.NEAREST_HOPS
+	return CoreConst.SelectionMode.WEIGHTED_RANDOM
+
+
+func entries_for_era(era_id: int) -> Array[DemandSpec]:
+	return _era_demand.get(era_id, [])
+
+
+func set_pieces_for_era(era_id: int) -> Array[SetPiece]:
+	return _era_set_pieces.get(era_id, [])
+
+
+## Plan pressure for one tick: the era's base DemandSpecs + the SetPieces active
+## at this tick. Deterministic (a pure function of era + tick).
+func plan_pressure(_topology: TopologySnapshot, era_id: int, tick: int,
+				   _rng: RandomNumberGenerator) -> PressurePlan:
+	var all_set_pieces: Array[SetPiece] = _era_set_pieces.get(era_id, [])
+	var active: Array[SetPiece] = []
+	for sp: SetPiece in all_set_pieces:
+		if sp.is_active(tick):
+			active.append(sp)
+	return PressurePlan.new(tick, entries_for_era(era_id), active)
+
+
+## Forecast (set-pieces not yet active but within their lead time) — for the
+## "weather report" panel (sprint-plan §3.4). Pure function of era + tick.
+func forecast_for_era(era_id: int, tick: int) -> Array[SetPiece]:
+	var out: Array[SetPiece] = []
+	for sp: SetPiece in _era_set_pieces.get(era_id, []):
+		if sp.is_forecasted(tick):
+			out.append(sp)
+	return out
