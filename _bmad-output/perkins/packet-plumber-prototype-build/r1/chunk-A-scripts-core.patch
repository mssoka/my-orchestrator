+## Schema for a packet-type catalog entry (GDD § M2, ADR-5).
+##
+## In-memory model is a custom Resource (the architecture's intent); JSON is the
+## single-source, human-editable truth loaded at runtime (the hot-iterate loop,
+## forge weak #1). Ints are re-cast after JSON load ([FinLT] JSON trap).
+class_name PacketTypeData
+extends Resource
+
+var id: StringName = &""
+var display_name: String = ""
+var color_hex: String = "#FFFFFF"   # cosmetic only; never the sole encoder (UX-DR4)
+var icon: String = "?"              # emoji/symbol for graybox (UX-DR4)
+var latency_tol_ms: int = 0         # SLA latency tolerance (0 = unconstrained)
+var max_loss_pct: Variant = 0       # null = NEVER drop (Banking); int 0..100 otherwise
+var bandwidth_demand: int = 1       # units this packet consumes per traversal
+var default_lane: int = 1           # CoreConst.Lane (game-wide: STANDARD, sprint-plan §8 #7)
+var era_introduced: int = 1
+var sla_fail_effect: String = ""    # descriptive (what breaching this SLA does)
+var demand_weight: int = 1          # relative spawn weight (tunable per era content)
