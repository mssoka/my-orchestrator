new file mode 100644
index 0000000..4d0b5d0
--- /dev/null
+++ b/game/scripts/core/sim_snapshot.gd
@@ -0,0 +1,98 @@
+## SimSnapshot — the immutable per-tick projection (ADR-1, architecture §10.1.1).
+##
+## The ONLY contract between the Simulation Core and the Presentation layer: each
+## tick the Core emits one; the View reads only it (never mutates). Carries the
+## salient scalar state + the topology snapshot (read-only). to_fingerprint()
+## produces a deterministic primitives-only string for replay-equality (AC-E10).
+##
+## Pure RefCounted (ADR-1).
+class_name SimSnapshot
+extends RefCounted
+
+var tick: int = 0
+var era_id: int = 1
+var health_pct: int = 100
+var won: bool = false
+var lost: bool = false
+var overall_uptime_pct: int = -1
+var in_flight: int = 0
+var spawned_total: int = 0
+var delivered_total: int = 0
+var dropped_total: int = 0
+var unmet_demand_total: int = 0
+var budget_remaining: int = 0
+var active_warning_count: int = 0
+var forecast_ids: Array[StringName] = []
+var active_set_piece_ids: Array[StringName] = []
+var sla_summary: Dictionary = {}        # StringName -> Dictionary {delivered,dropped,demand,uptime}
+var topology: TopologySnapshot = null
+var packet_render: Array = []           # Array[Dictionary{class,x,y,lane}] — cosmetic, NOT in fingerprint
+var node_health: Dictionary = {}        # int node_id -> int HealthState (warning surface, S2 E3.3)
+
+
+## A deterministic, primitives-only fingerprint of the whole snapshot. Two runs
+## from the same (seed, action_log) MUST produce identical fingerprints (AC-E10).
+func to_fingerprint() -> String:
+	var d: Dictionary = {}
+	d["tick"] = tick
+	d["era"] = era_id
+	d["health"] = health_pct
+	d["won"] = won
+	d["lost"] = lost
+	d["uptime"] = overall_uptime_pct
+	d["in_flight"] = in_flight
+	d["spawned"] = spawned_total
+	d["delivered"] = delivered_total
+	d["dropped"] = dropped_total
+	d["unmet"] = unmet_demand_total
+	d["budget"] = budget_remaining
+	d["warnings"] = active_warning_count
+	d["forecast"] = _sorted_stringnames(forecast_ids)
+	d["active_sp"] = _sorted_stringnames(active_set_piece_ids)
+	# NOTE: packet_render is deliberately EXCLUDED — it is cosmetic View-only data
+	# (float positions), not sim state; including it would couple the fingerprint
+	# to render interpolation. The topology + sla + counts above ARE the sim state.
+	# SLA summary, sorted by class id for stable output
+	var sla_keys: Array = sla_summary.keys()
+	sla_keys.sort()
+	var sla_arr: Array = []
+	for k: StringName in sla_keys:
+		var s: Dictionary = sla_summary[k]
+		sla_arr.append({"class": String(k), "d": int(s["delivered"]), "dr": int(s["dropped"]),
+						"demand": int(s["demand"]), "up": int(s["uptime"])})
+	d["sla"] = sla_arr
+	d["topo"] = _topo_fingerprint()
+	return var_to_str(d)
+
+
+func _sorted_stringnames(arr: Array[StringName]) -> Array:
+	var out: Array = []
+	for s: StringName in arr:
+		out.append(String(s))
+	out.sort()
+	return out
+
+
+func _topo_fingerprint() -> Dictionary:
+	var t: Dictionary = {}
+	if topology == null:
+		return t
+	var node_ids: Array = topology.nodes.keys()
+	node_ids.sort()
+	var nodes_arr: Array = []
+	for nid: int in node_ids:
+		var n: NetNode = topology.nodes[nid]
+		nodes_arr.append({"id": nid, "type": String(n.type_id), "role": n.terminal_role,
+						  "pos": [n.pos.x, n.pos.y], "util": n.utilization_units,
+						  "health": n.health_state})
+	var pipe_ids: Array = topology.pipes.keys()
+	pipe_ids.sort()
+	var pipes_arr: Array = []
+	for pid: int in pipe_ids:
+		var p: NetPipe = topology.pipes[pid]
+		pipes_arr.append({"id": pid, "a": p.a_id, "b": p.b_id, "tier": String(p.tier_id),
+						  "cap": p.capacity_units, "span": p.span_tiles,
+						  "w": [p.lane_weights.x, p.lane_weights.y, p.lane_weights.z]})
+	t["nodes"] = nodes_arr
+	t["pipes"] = pipes_arr
+	return t
