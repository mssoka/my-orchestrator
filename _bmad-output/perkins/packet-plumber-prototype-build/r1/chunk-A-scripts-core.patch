+++ b/game/scripts/core/run_state.gd
@@ -0,0 +1,105 @@
+## RunState — pure authoritative sim state (ADR-1, architecture §8.2).
+##
+## Owns the SEEDED rng (single generator, ADR-9) + every Core system + tick +
+## seed + action_log. The spine of the determinism contract: re-create from
+## (seed, action_log) and re-step -> byte-identical run (AC-E10, ADR-11).
+## Pure RefCounted — no Node.
+class_name RunState
+extends RefCounted
+
+var seed: int = 0
+var rng: RandomNumberGenerator = null
+var tick: int = 0
+var action_log: Array = []          # Array[Command] — canonical save form (ADR-11)
+
+var catalogs: GameCatalogs = null
+var balance: BalanceData = null
+var topology: TopologyGraph = null
+var flow: PacketFlow = null
+var crisis: CrisisEngine = null
+var health: NetworkHealth = null
+var era: EraStateMachine = null
+var economy: Economy = null
+var director: ScriptedDirector = null
+
+# cumulative run counters (deterministic; part of the snapshot fingerprint)
+var spawned_total: int = 0
+var delivered_total: int = 0
+var dropped_total: int = 0
+var unmet_total: int = 0
+
+
+## Wire every system + seed the rng + place the deterministic MVP map.
+static func bootstrap(p_seed: int, p_catalogs: GameCatalogs, p_balance: BalanceData,
+					  p_director: ScriptedDirector,
+					  p_start_era: int = CoreConst.ERA_STREAMING_SURGE) -> RunState:
+	var s := RunState.new()
+	s.seed = p_seed
+	s.rng = RandomNumberGenerator.new()
+	s.rng.seed = p_seed                 # single seeded generator (ADR-9)
+	s.catalogs = p_catalogs
+	s.balance = p_balance
+	s.economy = Economy.new(p_balance.default_budget)
+	s.topology = TopologyGraph.new(p_catalogs, s.economy, p_balance)
+	s.flow = PacketFlow.new(p_catalogs)
+	s.crisis = CrisisEngine.new(p_catalogs, p_balance)
+	s.health = NetworkHealth.new(p_balance)
+	s.era = EraStateMachine.new(p_catalogs, p_start_era)
+	s.director = p_director
+	_bootstrap_map(s)
+	return s
+
+
+# Fixed MVP map (6 nodes: 1 Content host + 4 Residential + 1 Router). Deterministic
+# placement (map GROWTH is E3.2/S2; the initial seed map is fixed). Positions are
+# integer tile coords on a ~40x30 grid (rendered later at ~32px/tile -> 1280x960-
+# ish; the View centers/scales). Tunable via a future map catalog.
+static func _bootstrap_map(s: RunState) -> void:
+	s.topology.spawn_node(CoreConst.NodeKind.TERMINAL, &"content_host",
+		CoreConst.TerminalRole.CONTENT_HOST, Vector2i(30, 14), 40, 0)
+	s.topology.spawn_node(CoreConst.NodeKind.TERMINAL, &"residential",
+		CoreConst.TerminalRole.RESIDENTIAL, Vector2i(8, 5), 5, 0)
+	s.topology.spawn_node(CoreConst.NodeKind.TERMINAL, &"residential",
+		CoreConst.TerminalRole.RESIDENTIAL, Vector2i(8, 14), 5, 0)
+	s.topology.spawn_node(CoreConst.NodeKind.TERMINAL, &"residential",
+		CoreConst.TerminalRole.RESIDENTIAL, Vector2i(8, 22), 5, 0)
+	s.topology.spawn_node(CoreConst.NodeKind.TERMINAL, &"residential",
+		CoreConst.TerminalRole.RESIDENTIAL, Vector2i(14, 24), 5, 0)
+	s.topology.spawn_node(CoreConst.NodeKind.JUNCTION, &"router", -1,
+		Vector2i(18, 14), 60, 0)
+
+
+## Build the immutable snapshot from current state + the tick's reports.
+func snapshot(crisis_report: CrisisReport, report: FlowReport,
+			  plan: PressurePlan) -> SimSnapshot:
+	var snap := SimSnapshot.new()
+	snap.tick = tick
+	snap.era_id = era.era_id
+	snap.health_pct = health.meter_pct
+	snap.won = health.won
+	snap.lost = health.lost
+	snap.overall_uptime_pct = report.overall_uptime_pct()
+	snap.in_flight = flow.in_flight_count()
+	snap.spawned_total = spawned_total
+	snap.delivered_total = delivered_total
+	snap.dropped_total = dropped_total
+	snap.unmet_demand_total = unmet_total
+	snap.budget_remaining = economy.budget_remaining
+	snap.active_warning_count = crisis_report.warning_count()
+	for sp: SetPiece in crisis_report.forecast:
+		snap.forecast_ids.append(sp.id)
+	for sp: SetPiece in plan.set_pieces:
+		snap.active_set_piece_ids.append(sp.id)
+	# SLA summary (primitives) — sorted keys for a stable fingerprint
+	var keys: Array = flow.sla.keys()
+	keys.sort()
+	for k: StringName in keys:
+		var acc: SlaAccumulator = flow.sla[k]
+		snap.sla_summary[k] = {
+			"delivered": acc.delivered, "dropped": acc.dropped,
+			"demand": acc.demand_seen, "uptime": flow.recent_class_uptime(k)
+		}
+	snap.topology = topology.snapshot()
+	snap.packet_render = flow.render_positions(snap.topology)
+	snap.node_health = flow.node_health_states(snap.topology)
+	return snap
