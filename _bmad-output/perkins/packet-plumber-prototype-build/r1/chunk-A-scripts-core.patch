diff --git a/game/scripts/core/catalogs.gd b/game/scripts/core/catalogs.gd
new file mode 100644
index 0000000..9117a97
--- /dev/null
+++ b/game/scripts/core/catalogs.gd
@@ -0,0 +1,172 @@
+## Loads + owns the data catalogs (ADR-5: data-driven content).
+##
+## JSON is the single-source, human-editable truth in res://data/ (the hot-iterate
+## loop, forge weak #1). The in-memory model is typed Resource subclasses (the
+## architecture's "custom Resource" intent). Int fields are re-cast after load
+## ([FinLT] JSON trap + S0.3 AC). Errors are logged + surfaced (never swallowed).
+##
+## Pure RefCounted — FileAccess/JSON are NOT Nodes, so this is Core-safe (ADR-1).
+class_name GameCatalogs
+extends RefCounted
+
+var packet_types: Dictionary = {}        # StringName -> PacketTypeData
+var pipe_tiers: Dictionary = {}          # StringName -> PipeTierData
+var node_types: Dictionary = {}          # StringName -> NodeTypeData
+var eras: Dictionary = {}                # int -> EraData
+var balance: BalanceData = null
+var load_errors: Array[String] = []
+
+
+## Load all MVP catalogs from res://data/. Returns a GameCatalogs (check load_errors).
+static func load_default() -> GameCatalogs:
+	var c := GameCatalogs.new()
+	c._load_packet_types("res://data/packet_types.json")
+	c._load_pipe_tiers("res://data/pipe_tiers.json")
+	c._load_node_types("res://data/node_types.json")
+	c._load_eras("res://data/eras.json")
+	c._load_balance("res://data/balance.json")
+	return c
+
+
+func has_errors() -> bool:
+	return not load_errors.is_empty()
+
+
+static func _read_json(path: String) -> Variant:
+	if not FileAccess.file_exists(path):
+		push_error("[Catalogs] missing file: %s" % path)
+		return null
+	var f := FileAccess.open(path, FileAccess.READ)
+	if f == null:
+		push_error("[Catalogs] cannot open %s (err %d)" % [path, FileAccess.get_open_error()])
+		return null
+	var text := f.get_as_text()
+	f.close()
+	var parsed: Variant = JSON.parse_string(text)
+	if parsed == null or not parsed is Dictionary:
+		push_error("[Catalogs] invalid JSON (expected object) in %s" % path)
+		return null
+	return parsed
+
+
+func _load_packet_types(path: String) -> void:
+	var data: Variant = _read_json(path)
+	if data == null:
+		load_errors.append("packet_types")
+		return
+	var arr: Array = data["entries"]
+	for entry: Variant in arr:
+		var d: Dictionary = entry
+		var pt := PacketTypeData.new()
+		pt.id = StringName(d["id"])
+		pt.display_name = d.get("display_name", String(pt.id))
+		pt.color_hex = d.get("color_hex", "#FFFFFF")
+		pt.icon = d.get("icon", "?")
+		pt.latency_tol_ms = int(d.get("latency_tol_ms", 0))
+		pt.max_loss_pct = d.get("max_loss_pct", 0)   # null passes through (never-drop)
+		pt.bandwidth_demand = int(d.get("bandwidth_demand", 1))
+		pt.default_lane = int(d.get("default_lane", CoreConst.Lane.STANDARD))
+		pt.era_introduced = int(d.get("era_introduced", 1))
+		pt.sla_fail_effect = d.get("sla_fail_effect", "")
+		pt.demand_weight = int(d.get("demand_weight", 1))
+		packet_types[pt.id] = pt
+
+
+func _load_pipe_tiers(path: String) -> void:
+	var data: Variant = _read_json(path)
+	if data == null:
+		load_errors.append("pipe_tiers")
+		return
+	var arr: Array = data["entries"]
+	for entry: Variant in arr:
+		var d: Dictionary = entry
+		var pt := PipeTierData.new()
+		pt.id = StringName(d["id"])
+		pt.display_name = d.get("display_name", String(pt.id))
+		pt.capacity_units = int(d.get("capacity_units", 0))
+		pt.clean_span = int(d.get("clean_span", pt.max_span))
+		pt.max_span = int(d.get("max_span", 0))
+		pt.cost_per_tile = int(d.get("cost_per_tile", 0))
+		pt.era_introduced = int(d.get("era_introduced", 1))
+		pipe_tiers[pt.id] = pt
+
+
+func _load_node_types(path: String) -> void:
+	var data: Variant = _read_json(path)
+	if data == null:
+		load_errors.append("node_types")
+		return
+	var arr: Array = data["entries"]
+	for entry: Variant in arr:
+		var d: Dictionary = entry
+		var nt := NodeTypeData.new()
+		nt.id = StringName(d["id"])
+		nt.display_name = d.get("display_name", String(nt.id))
+		nt.kind = int(d.get("kind", CoreConst.NodeKind.TERMINAL))
+		nt.terminal_role = int(d.get("terminal_role", -1))
+		nt.throughput_units = int(d.get("throughput_units", 0))
+		nt.lb_mode_capable = bool(d.get("lb_mode_capable", false))
+		nt.era_introduced = int(d.get("era_introduced", 1))
+		node_types[nt.id] = nt
+
+
+func _load_eras(path: String) -> void:
+	var data: Variant = _read_json(path)
+	if data == null:
+		load_errors.append("eras")
+		return
+	var arr: Array = data["entries"]
+	for entry: Variant in arr:
+		var d: Dictionary = entry
+		var e := EraData.new()
+		e.id = int(d["id"])
+		e.name = d.get("name", "Era %d" % e.id)
+		for pid: Variant in d.get("packet_type_ids", []):
+			e.packet_type_ids.append(StringName(pid))
+		for nid: Variant in d.get("node_type_ids", []):
+			e.node_type_ids.append(StringName(nid))
+		for tid: Variant in d.get("pipe_tier_ids", []):
+			e.pipe_tier_ids.append(StringName(tid))
+		e.milestone_window_ticks = int(d.get("milestone_window_ticks", 0))
+		e.sla_threshold_pct = int(d.get("sla_threshold_pct", 95))
+		eras[e.id] = e
+
+
+func _load_balance(path: String) -> void:
+	var data: Variant = _read_json(path)
+	if data == null:
+		load_errors.append("balance")
+		balance = BalanceData.new()   # fall back to compiled defaults (never null)
+		return
+	var d: Dictionary = data
+	balance = BalanceData.new()
+	balance.logic_hz = int(d.get("logic_hz", balance.logic_hz))
+	balance.snap_radius = int(d.get("snap_radius", balance.snap_radius))
+	balance.win_uptime_pct = int(d.get("win_uptime_pct", balance.win_uptime_pct))
+	balance.grace_window_ticks = int(d.get("grace_window_ticks", balance.grace_window_ticks))
+	balance.meter_drain_per_tick_max = int(d.get("meter_drain_per_tick_max", balance.meter_drain_per_tick_max))
+	balance.meter_recharge_per_tick = int(d.get("meter_recharge_per_tick", balance.meter_recharge_per_tick))
+	balance.meter_start_pct = int(d.get("meter_start_pct", balance.meter_start_pct))
+	balance.health_strain_threshold_pct = int(d.get("health_strain_threshold_pct", balance.health_strain_threshold_pct))
+	balance.health_critical_threshold_pct = int(d.get("health_critical_threshold_pct", balance.health_critical_threshold_pct))
+	balance.strain_lead_ticks = int(d.get("strain_lead_ticks", balance.strain_lead_ticks))
+	balance.critical_lead_ticks = int(d.get("critical_lead_ticks", balance.critical_lead_ticks))
+	var w: Dictionary = d.get("default_lane_weights", {})
+	balance.default_lane_weights = Vector3i(int(w.get("x", 1)), int(w.get("y", 4)), int(w.get("z", 1)))
+	balance.default_budget = int(d.get("default_budget", balance.default_budget))
+
+
+func packet_type(id: StringName) -> PacketTypeData:
+	return packet_types.get(id)
+
+
+func pipe_tier(id: StringName) -> PipeTierData:
+	return pipe_tiers.get(id)
+
+
+func node_type(id: StringName) -> NodeTypeData:
+	return node_types.get(id)
+
+
+func era(id: int) -> EraData:
+	return eras.get(id)
