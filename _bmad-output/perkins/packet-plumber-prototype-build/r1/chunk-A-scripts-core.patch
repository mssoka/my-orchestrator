diff --git a/game/scripts/core/crisis_report.gd b/game/scripts/core/crisis_report.gd
new file mode 100644
index 0000000..483e469
--- /dev/null
+++ b/game/scripts/core/crisis_report.gd
@@ -0,0 +1,13 @@
+## S4 CrisisEngine report (architecture §6.4). Minimal for S0; E4 (S4) fills the
+## warnings/active/forecast lists. Pure RefCounted (ADR-1).
+class_name CrisisReport
+extends RefCounted
+
+var tick: int = 0
