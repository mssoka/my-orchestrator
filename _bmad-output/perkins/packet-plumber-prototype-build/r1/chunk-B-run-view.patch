diff --git a/game/scripts/run/run_controller.gd b/game/scripts/run/run_controller.gd
new file mode 100644
index 0000000..9043202
--- /dev/null
+++ b/game/scripts/run/run_controller.gd
@@ -0,0 +1,177 @@
+## RunController — Presentation/orchestration layer (ADR-2, architecture §9).
+##
+## Holds the RunState + SimDriver and drives the fixed-timestep accumulator in
+## _process: clamp delta ([FinLT]), step the sim N times to catch up, capped to
+## avoid spiral-of-death. Slow-mo: if it can't keep up it falls behind (never
+## skips ticks, AC-E21). Player commands queue for the next step (validate-all-
+## then-apply happens in the Core, AC-E23). Emits snapshot_ready each step.
+##
+## This is a Godot Node (Presentation) — the ONLY Node that touches the Core's
+## RunState. Pause freezes stepping (E7.4); resume continues deterministically.
+class_name RunController
+extends Node
+
+const MAX_STEPS_PER_FRAME: int = 5      # catch-up cap; excess carries (slow-mo, AC-E21)
+
+var seed_value: int = 1337
+var state: RunState = null
+var driver: SimDriver = null
+var catalogs: GameCatalogs = null
+var balance: BalanceData = null
+var director: ScriptedDirector = null
+
+var accumulator: float = 0.0
+var tick_len: float = 0.05            # seconds per logic tick (1/logic_hz)
+var paused: bool = false
+var _cmd_queue: Array = []            # Array[Command] for the next step
+var _logic_tick: int = 0
+var demo_mode: bool = false
+var time_scale: float = 1.0          # demo: compress real-time so the surge hits sooner
+
+var latest_snapshot: SimSnapshot = null
+
+signal snapshot_ready(snap: SimSnapshot)
+signal run_ended(won: bool)
+
+
+func _ready() -> void:
+	if _has_arg("demo"):
+		demo_mode = true
+		time_scale = 4.0   # ~4x: surge at 60s sim -> ~15s real
+	boot()
+
+
+static func _has_arg(name: String) -> bool:
+	for a: String in OS.get_cmdline_args():
+		if a == name:
+			return true
+	for a: String in OS.get_cmdline_user_args():
+		if a == name:
+			return true
+	return false
+
+
+func boot() -> void:
+	catalogs = GameCatalogs.load_default()
+	balance = catalogs.balance
+	director = ScriptedDirector.load_from("res://data/demand.json")
+	if catalogs.has_errors() or not director.load_ok:
+		push_error("[RunController] catalog/director load failed — running with partial data")
+	state = RunState.bootstrap(seed_value, catalogs, balance, director)
+	driver = SimDriver.new()
+	tick_len = 1.0 / float(balance.logic_hz) if balance.logic_hz > 0 else 0.05
+	accumulator = 0.0
+	_logic_tick = 0
+	paused = false
+	_cmd_queue.clear()
+	if demo_mode:
+		_apply_demo_network()
+	# emit an initial snapshot so the View can render before the first step
+	latest_snapshot = _snapshot_now()
+	snapshot_ready.emit(latest_snapshot)
+
+
+# Demo: auto-build a survivable starter network so a capture run shows flow + the
+# surge without human input. Manual play (no --demo arg) starts with NO pipes.
+func _apply_demo_network() -> void:
+	var ids: Array = state.topology.all_node_ids()
+	var content_id: int = -1
+	var router_id: int = -1
+	var residentials: Array[int] = []
+	for nid: int in ids:
+		var n: NetNode = state.topology.get_node(nid)
+		if n == null:
+			continue
+		if n.terminal_role == CoreConst.TerminalRole.CONTENT_HOST:
+			content_id = nid
+		elif n.is_junction():
+			router_id = nid
+		elif n.terminal_role == CoreConst.TerminalRole.RESIDENTIAL:
+			residentials.append(nid)
+	if content_id >= 0 and router_id >= 0:
+		# 2 parallel wide pipes content->router (redundancy + round-robin, E1.5) so the
+		# single link isn't the surge bottleneck (the lesson the player must learn).
+		state.topology.apply_edit(Command.DrawPipeCmd.new(0, content_id, router_id, &"wide"))
+		state.topology.apply_edit(Command.DrawPipeCmd.new(0, content_id, router_id, &"wide"))
+	for rid: int in residentials:
+		if router_id >= 0:
+			state.topology.apply_edit(Command.DrawPipeCmd.new(0, router_id, rid, &"wide"))
+	# set one content->router pipe to STREAMING priority so a capture shows the label
+	if content_id >= 0 and router_id >= 0:
+		var snap := state.topology.snapshot()
+		var pair: Array = snap.pipes_between(content_id, router_id)
+		if not pair.is_empty():
+			state.topology.apply_edit(Command.SetPipePriorityCmd.new(0, (pair[0] as NetPipe).id, &"streaming"))
+
+
+func _process(delta: float) -> void:
+	if paused or state == null:
+		return
+	delta = minf(delta, CoreConst.MAX_FRAME_DELTA) * time_scale   # [FinLT] clamp
+	accumulator += delta
+	var steps: int = 0
+	while accumulator >= tick_len and steps < MAX_STEPS_PER_FRAME:
+		_do_step()
+		accumulator -= tick_len
+		steps += 1
+	# slow-mo: if still behind after the cap, drop excess so accumulator can't
+	# grow unbounded (the sim simply runs slow — AC-E21: never skips ticks).
+	if accumulator > tick_len * float(MAX_STEPS_PER_FRAME):
+		accumulator = tick_len * float(MAX_STEPS_PER_FRAME)
+
+
+func _do_step() -> void:
+	_logic_tick += 1
+	var cmds: Array = _cmd_queue
+	_cmd_queue = []
+	latest_snapshot = driver.step(state, _logic_tick, cmds)
+	snapshot_ready.emit(latest_snapshot)
+	if state.health.is_terminal():
+		run_ended.emit(state.health.won)
+		paused = true
+
+
+func _snapshot_now() -> SimSnapshot:
+	# build a snapshot without advancing (for boot + paused redraws)
+	var plan: PressurePlan = director.plan_pressure(state.topology.snapshot(),
+		state.era.era_id, _logic_tick, state.rng)
+	var report: FlowReport = FlowReport.new()
+	report.sla = state.flow.sla
+	var cr: CrisisReport = state.crisis.evaluate(_logic_tick, state.topology.snapshot(),
+		state.flow, state.era.era_id, director)
+	return state.snapshot(cr, report, plan)
+
+
+## Apply a player command IMMEDIATELY (paused or running) and emit a fresh
+## snapshot so the edit is visible at once — pause-and-plan must feel responsive
+## (E7.4: edits apply instantly, never tick-gated). Returns the EditResult so the
+## caller can surface a rejection reason (span/budget/etc.) instead of failing silently.
+func submit_command(cmd: Command) -> EditResult:
+	if state == null:
+		return EditResult.rejected(&"no_state")
+	cmd.tick = _logic_tick
+	var r: EditResult = state.topology.apply_all([cmd])
+	if r.ok:
+		state.action_log.append(cmd)
+	latest_snapshot = _snapshot_now()
+	snapshot_ready.emit(latest_snapshot)
+	return r
+
+
+## Queue a player command for the next logic step (legacy; submit_command is preferred).
+func queue_command(cmd: Command) -> void:
+	_cmd_queue.append(cmd)
+
+
+func set_paused(p: bool) -> void:
+	paused = p
+
+
+func toggle_pause() -> void:
+	paused = not paused
+
+
+func restart(new_seed: int = -1) -> void:
+	if new_seed >= 0:
+		seed_value = new_seed
+	boot()
