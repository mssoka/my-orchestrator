@@ -0,0 +1,190 @@
+## Hud — Network Health meter, surge forecast, budget, per-class SLA, win/lose
+## overlay (architecture §9.2). Reads ONLY the snapshot. CanvasLayer-sibling of
+## the World; mouse_filter IGNORE so input passes through to RunView.
+class_name Hud
+extends Control
+
+@onready var controller: RunController = get_node("%Controller")
+var _snapshot: SimSnapshot = null
+var _ended: bool = false
+var _won: bool = false
+var _show_onboard: bool = true     # first-run briefing (Dispatcher voice); skipped in demo
+# LIGHT canvas canon (look-book-v1.md §2)
+const INK: Color = Color("#33414F")
+const INK_SOFT: Color = Color("#6A7078")
+const CARD: Color = Color("#F5EFDF")
+const CARD_EDGE: Color = Color("#C2B694")
+const WARM: Color = Color("#F2B544")
+const RED: Color = Color("#E84545")
+const GREEN: Color = Color("#37D67A")
+
+
+func _ready() -> void:
+	mouse_filter = Control.MOUSE_FILTER_IGNORE
+	if controller == null:
+		var p := get_parent()
+		if p != null and p.get_parent() != null and p.get_parent().has_node("Controller"):
+			controller = p.get_parent().get_node("Controller")
+	if controller != null:
+		controller.snapshot_ready.connect(_on_snapshot)
+		controller.run_ended.connect(_on_run_ended)
+		# pause the sim while the first-run briefing is up (skip in demo/capture runs)
+		if controller.demo_mode:
+			_show_onboard = false
+		else:
+			controller.set_paused(true)
+	queue_redraw()
+
+
+func _on_snapshot(snap: SimSnapshot) -> void:
+	_snapshot = snap
+	queue_redraw()
+
+
+func _on_run_ended(won: bool) -> void:
+	_ended = true
+	_won = won
+	queue_redraw()
+
+
+func _unhandled_input(event: InputEvent) -> void:
+	if _show_onboard and event is InputEvent and event.is_pressed() and (event is InputEventKey or event is InputEventMouseButton):
+		_show_onboard = false
+		if controller != null:
+			controller.set_paused(false)
+		queue_redraw()
+		return
+	if _ended and event is InputEventKey and event.pressed and event.keycode == KEY_R:
+		controller.restart()
+		_ended = false
+		_won = false
+
+
+func _draw() -> void:
+	if _snapshot != null:
+		_draw_health_meter()
+		_draw_forecast()
+		_draw_stats()
+	if _ended:
+		_draw_end_overlay()
+	if _show_onboard:
+		_draw_onboarding()
+
+
+func _draw_health_meter() -> void:
+	var pct: int = _snapshot.health_pct
+	var bar_w: float = 240.0
+	var bar_h: float = 18.0
+	var origin := Vector2(22, 84)   # below the GOAL/controls strip (no overlap)
+	# translucent backdrop for legibility over the map
+	draw_rect(Rect2(12, 66, bar_w + 22, 46), Color(1, 1, 1, 0.62), true)
+	draw_rect(Rect2(12, 66, bar_w + 22, 46), CARD_EDGE, false, 1.0)
+	# frame
+	draw_rect(Rect2(origin - Vector2(2, 2), Vector2(bar_w + 4, bar_h + 4)),
+		CARD_EDGE, false, 1.0)
+	# fill (green->yellow->red as it drains)
+	var fill_frac: float = clampf(float(pct) / 100.0, 0.0, 1.0)
+	var col: Color = GREEN if pct > 60 else (WARM if pct > 30 else RED)
+	draw_rect(Rect2(origin, Vector2(bar_w * fill_frac, bar_h)), col, true)
+	draw_string(_font(), origin + Vector2(0, -8), "NETWORK HEALTH  %d%%" % pct,
+		HORIZONTAL_ALIGNMENT_LEFT, -1, 14, INK)
+
+
+func _draw_forecast() -> void:
+	var y: float = 56.0
+	var has_forecast: bool = not _snapshot.forecast_ids.is_empty()
+	var has_active: bool = not _snapshot.active_set_piece_ids.is_empty()
+	if has_active:
+		draw_string(_font(), Vector2(1040, y), "⚡ SURGE ACTIVE",
+			HORIZONTAL_ALIGNMENT_LEFT, -1, 22, RED)
+		y += 28.0
+	elif has_forecast:
+		draw_string(_font(), Vector2(1040, y), "⚠ SURGE INCOMING",
+			HORIZONTAL_ALIGNMENT_LEFT, -1, 22, WARM)
+		y += 28.0
+	# SLA per class
+	var sx: float = 1040.0
+	for cls: StringName in _snapshot.sla_summary:
+		var s: Dictionary = _snapshot.sla_summary[cls]
+		var up: int = int(s["uptime"])
+		var label: String = "%s: %s" % [String(cls), "idle" if up < 0 else "%d%%" % up]
+		var lcol: Color = INK_SOFT if up < 0 else (GREEN if up >= 85 else RED)
+		draw_string(_font(), Vector2(sx, y), label, HORIZONTAL_ALIGNMENT_LEFT, -1, 16, lcol)
+		y += 22.0
+
+
+func _draw_stats() -> void:
+	draw_string(_font(), Vector2(20, 700), "tick %d   budget %d   in-flight %d" %
+		[_snapshot.tick, _snapshot.budget_remaining, _snapshot.in_flight],
+		HORIZONTAL_ALIGNMENT_LEFT, -1, 14, INK_SOFT)
+	var era_name: String = "era %d" % _snapshot.era_id
+	if _snapshot.forecast_ids.is_empty() and _snapshot.active_set_piece_ids.is_empty():
+		draw_string(_font(), Vector2(560, 30), "PACKET PLUMBER — %s" % era_name,
+			HORIZONTAL_ALIGNMENT_CENTER, -1, 18, INK_SOFT)
+
+
+func _draw_end_overlay() -> void:
+	draw_rect(Rect2(Vector2.ZERO, Vector2(1280, 720)), Color(0, 0, 0, 0.6), true)
+	var msg: String = "ERROR 404 — THE INTERNET IS DOWN" if not _won else "INTERNET SAVED! 🛠"
+	var col: Color = Color(1, 0.4, 0.4) if not _won else Color(0.5, 0.95, 0.6)
+	draw_string(_font(), Vector2(640, 340), msg, HORIZONTAL_ALIGNMENT_CENTER, -1, 40, col)
+	draw_string(_font(), Vector2(640, 390), "press [R] to retry",
+		HORIZONTAL_ALIGNMENT_CENTER, -1, 18, Color(0.8, 0.85, 0.9))
+
+
+func _draw_onboarding() -> void:
+	# First-run briefing in the Dispatcher's voice (narrative-v1 §2.2): urgent,
+	# wry, warm — a veteran coaching a rookie. Plain language, not a lecture.
+	draw_rect(Rect2(Vector2.ZERO, Vector2(1280, 720)), Color(0.02, 0.03, 0.06, 0.78), true)
+	var px: float = 290.0
+	var pw: float = 700.0
+	draw_rect(Rect2(Vector2(px, 70), Vector2(pw, 580)), CARD, true)
+	draw_rect(Rect2(Vector2(px, 70), Vector2(pw, 580)), CARD_EDGE, false, 2.0)
+	var ink: Color = INK
+	var soft: Color = INK_SOFT
+	var warm: Color = WARM
+	var blue: Color = Color("#1E4A98")
+	var x: float = px + 28.0
+	var y: float = 104.0
+	draw_string(_font(), Vector2(x, y), "PACKET PLUMBER — night shift", HORIZONTAL_ALIGNMENT_LEFT, 0, 26, ink)
+	y += 30
+	draw_string(_font(), Vector2(x, y), "The Dispatcher, in your ear:", HORIZONTAL_ALIGNMENT_LEFT, 0, 15, warm)
+	y += 30
+	var lines: Array = [
+		["You're on the internet tonight. One job: keep it alive.", ink],
+		["", ink],
+		["THE MAP", warm],
+		["Content Host — streams video OUT to everyone.", soft],
+		["Residentials — your users. They want that stream, AND they", soft],
+		["swap email with each other, peer-to-peer.", soft],
+		["Router — the junction you wire everything through.", soft],
+		["", ink],
+		["YOUR MOVE", warm],
+		["DRAG node-to-node to lay a pipe. Connect Content Host ->", soft],
+		["Router -> Residentials so the stream reaches everyone.", soft],
+		["(Email finds its own way through whatever you build.)", soft],
+		["", ink],
+		["THE CATCH", warm],
+		["A streaming surge is coming — watch the forecast. One pipe", soft],
+		["jams fast: lay PARALLEL pipes or upgrade to WIDE [3].", soft],
+		["RIGHT-CLICK a pipe to prioritize streaming when it's choking.", soft],
+		["", ink],
+		["WIN: hold the network alive (>=90%) through the surge.", blue],
+		["LOSE: the Network Health meter empties -> Error 404.", Color("#E84545")],
+	]
+	for ln: Array in lines:
+		draw_string(_font(), Vector2(x, y), String(ln[0]), HORIZONTAL_ALIGNMENT_LEFT, 0, 15, ln[1])
+		y += 22
+	y += 12
+	draw_string(_font(), Vector2(x, y), "drag = draw  ·  [1/2/3] tier  ·  right-click pipe = priority  ·  [SPACE] pause", HORIZONTAL_ALIGNMENT_LEFT, 0, 13, soft)
+	y += 28
+	draw_string(_font(), Vector2(x + 220, y), "press any key to clock in ▶", HORIZONTAL_ALIGNMENT_LEFT, 0, 18, warm)
+
+
+func _font() -> Font:
+	var win: Window = get_window()
+	if win != null:
+		var f: Font = win.get_theme_default_font()
+		if f != null:
+			return f
+	return ThemeDB.get_default_theme().default_font
