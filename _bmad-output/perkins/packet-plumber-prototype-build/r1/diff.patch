+## A PressurePlan (sprint-plan §3.1) — the CrisisDirector's per-tick output.
+##
+## Carries a tick + the base per-era DemandSpecs (always active) + the active
+## SetPieces (the Surge) for that tick. Consumed by PacketFlow.step. Every
+## random choice in its production is seeded -> the whole spawn sequence
+## reproduces from (seed, era, tick) (ADR-7/9/10, AC-E10).
+class_name PressurePlan
+extends RefCounted
+
+var tick: int = 0
+var entries: Array[DemandSpec] = []
+var set_pieces: Array[SetPiece] = []
+
+
+func _init(p_tick: int = 0,
+		   p_entries: Array[DemandSpec] = [],
+		   p_set_pieces: Array[SetPiece] = []) -> void:
+	tick = p_tick
+	entries = p_entries
+	set_pieces = p_set_pieces
+
+
+## Returns the effective volume for a class this tick, applying any active
+## set-piece multiplier. Integer math (ADR-10).
+func effective_volume(class_id: StringName, base_volume: int) -> int:
+	var v: int = base_volume
+	for sp: SetPiece in set_pieces:
+		if sp.class_id == class_id and sp.is_active(tick):
+			v *= sp.multiplier
+	return v
