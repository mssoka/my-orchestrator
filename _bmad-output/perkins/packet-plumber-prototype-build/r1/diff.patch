+## PacketFlow step report (architecture §6.2). Carries SLA accumulators + counts
+## consumed downstream by CrisisEngine + NetworkHealth. Pure RefCounted (ADR-1).
+class_name FlowReport
+extends RefCounted
+
+var tick: int = 0
+var spawned: int = 0
+var delivered: int = 0
+var dropped: int = 0
+var unmet_demand: int = 0           # demand with no valid source/sink (visible, E1.4)
+var sla: Dictionary = {}            # StringName class_id -> SlaAccumulator
+
+
+func sla_for(class_id: StringName) -> SlaAccumulator:
+	return sla.get(class_id)
+
+
+## Overall uptime across active classes (zero-demand classes neutral, AC-E24).
+## Returns -1 if NO class had any demand (the whole window was idle).
+func overall_uptime_pct() -> int:
+	var sum_delivered: int = 0
+	var sum_total: int = 0
+	for class_id: StringName in sla:
+		var acc: SlaAccumulator = sla[class_id]
+		if acc.demand_seen <= 0:
+			continue   # neutral
+		sum_delivered += acc.delivered
+		sum_total += acc.delivered + acc.dropped
+	if sum_total <= 0:
+		return -1
+	return (sum_delivered * 100) / sum_total
