+## A pipe / link between two nodes (S1.1, GDD § M1).
+##
+## Carries a tier (capacity/span/cost), 3 QoS lanes (Express/Standard/Best via
+## lane_weights Vector3i), a load-balance mode, and legacy/wear flags (era
+## lifecycle, E5). `span` is the integer tile-length of the link (used for the
+## tier max-span check + draw cost).
+##
+## Pure data (RefCounted) — not a Node (ADR-1).
+class_name NetPipe
+extends RefCounted
+
+var id: int = -1
+var a_id: int = -1
+var b_id: int = -1
+var tier_id: StringName = &""
+var capacity_units: int = 0
+var span_tiles: int = 0                       # integer length (ADR-10)
+var lane_weights: Vector3i = Vector3i(1, 4, 1)  # x=Express, y=Standard, z=Best (ADR-3)
+var lb_mode: int = 0                          # 0 = round-robin (MVP default)
+var priority_class: StringName = &""        # "" balanced | "streaming" | "email" (QoS dial, S3)
+var legacy: bool = false                      # era lifecycle (E5)
+var wear: int = 0                             # 0..N wear units (full-game depth)
+var spawn_tick: int = 0
+
+
+func connects(node_a: int, node_b: int) -> bool:
+	return (a_id == node_a and b_id == node_b) or (a_id == node_b and b_id == node_a)
+
+
+func other_end(node_id: int) -> int:
+	if node_id == a_id:
+		return b_id
+	if node_id == b_id:
+		return a_id
+	return -1
+
+
+func _to_string() -> String:
+	return "Pipe#%d(%d<-%s->%d)" % [id, a_id, tier_id, b_id]
