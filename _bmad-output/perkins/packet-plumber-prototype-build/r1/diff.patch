@@ -0,0 +1,53 @@
+## A packet entity (architecture §6.2, ADR-8).
+##
+## POOLED DATA, never a Node — the View renders via a PacketDot node pool. Fields
+## per the architecture. Latency is tracked in integer MILLISECONDS, not ticks
+## (a 20 Hz tick is too coarse for Gaming's <80ms SLA; ms stays deterministic
+## under ADR-10). Pure RefCounted (ADR-1).
+class_name Packet
+extends RefCounted
+
+var id: int = -1
+var class_id: StringName = &""
+var src: int = -1
+var dst: int = -1
+var route: Array[int] = []                # pipe ids along the chosen path (E1.4)
+var edge_idx: int = 0                     # current edge index in route
+var progress_units: int = 0               # bandwidth units traversed on current edge
+var lane: int = CoreConst.Lane.STANDARD
+var spawn_tick: int = 0
+var bandwidth_demand: int = 1     # cached from the catalog at spawn (hot-loop)
+var accrued_latency_ms: int = 0
+var vis_dist: float = 0.0        # visual distance along the route (edge-fractions); cosmetic, decoupled from bandwidth (ADR-9 exception — deterministic fixed rate)
+var dropped: bool = false
+var drop_reason: StringName = &""
+var delivered: bool = false
+
+
+func _init(p_id: int = -1, p_class: StringName = &"", p_src: int = -1, p_dst: int = -1,
+		   p_lane: int = CoreConst.Lane.STANDARD, p_tick: int = 0) -> void:
+	id = p_id
+	class_id = p_class
+	src = p_src
+	dst = p_dst
+	lane = p_lane
+	spawn_tick = p_tick
+
+
+func reset() -> void:
+	# Return to the pool in a clean state (ADR-8 pooling).
+	id = -1
+	class_id = &""
+	src = -1
+	dst = -1
+	route.clear()
+	edge_idx = 0
+	progress_units = 0
+	lane = CoreConst.Lane.STANDARD
+	spawn_tick = 0
+	bandwidth_demand = 1
+	accrued_latency_ms = 0
+	vis_dist = 0.0
+	dropped = false
+	drop_reason = &""
+	delivered = false
