+var tick: int = 0
+var warnings: Array = []        # WarningSign refs (E4.1, S4)
+var active: Array = []          # active CrisisEvent refs (E4.2/E4.3, S4)
+var forecast: Array = []        # incoming set-pieces (from the director, sprint-plan §3.4)
+
+
+func warning_count() -> int:
