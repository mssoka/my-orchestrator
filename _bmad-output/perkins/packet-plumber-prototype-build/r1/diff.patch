+## Economy / budget (S7 MVP scope: action/capacity budget only — no currency).
+##
+## Draw/upgrade cost = span_tiles × tier.cost_per_tile (FR1); upgrades cost the
+## tier-delta. The CommandBus consults can_afford before applying. Full-game
+## score + SLA contracts/currency is E10 (content swap on the same seam).
+##
+## Pure RefCounted (ADR-1). All amounts are int (ADR-10).
+class_name Economy
+extends RefCounted
+
+var budget_remaining: int = 0
+
+
+func _init(start_budget: int = 0) -> void:
+	budget_remaining = start_budget
+
+
+func can_afford(cost: int) -> bool:
+	return cost <= budget_remaining
+
+
+func spend(cost: int) -> void:
+	budget_remaining -= cost
+
+
+func refund(cost: int) -> void:
+	budget_remaining += cost
+
+
+## Draw cost = integer span (tiles) × tier cost-per-tile (FR1).
+static func draw_cost(span_tiles: int, cost_per_tile: int) -> int:
+	return span_tiles * cost_per_tile
