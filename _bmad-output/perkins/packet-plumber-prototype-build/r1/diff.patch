+## S0.5 — ScriptedDirector determinism + surge scheduling (ADR-7, NFR1).
+extends TestSuite
+
+
+func run() -> Array:
+	_test_loads_era3()
+	_test_plan_pressure_determinism()
+	_test_surge_schedule()
+	return results
+
+
+func _director() -> ScriptedDirector:
+	return ScriptedDirector.load_from("res://data/demand.json")
+
+
+func _test_loads_era3() -> void:
+	_start("director: era 3 has email + streaming + surge set-piece")
+	var d := _director()
+	check(d.load_ok, "director loaded")
+	var entries: Array[DemandSpec] = d.entries_for_era(3)
+	var classes: Array[StringName] = []
+	for e: DemandSpec in entries:
+		classes.append(e.class_id)
+	check(classes.has(&"email") and classes.has(&"streaming"), "era 3 demand classes")
+	var sp: Array[SetPiece] = d.set_pieces_for_era(3)
+	check(sp.size() >= 1, "era 3 has set-pieces")
+	if not sp.is_empty():
+		eq(sp[0].multiplier, 10, "surge multiplier")
+
+
+func _test_plan_pressure_determinism() -> void:
+	_start("director: plan_pressure deterministic for (era, tick) (S0.5)")
+	var d := _director()
+	var rng := RandomNumberGenerator.new()
+	rng.seed = 1
+	# an empty topology is fine — plan_pressure selects by era/tick only (MVP)
+	var topo := TopologySnapshot.new()
+	var p1: PressurePlan = d.plan_pressure(topo, 3, 1200, rng)
+	var p2: PressurePlan = d.plan_pressure(topo, 3, 1200, rng)
+	eq(p1.entries.size(), p2.entries.size(), "entry count")
+	var ids1: Array = []
+	var ids2: Array = []
+	for e: DemandSpec in p1.entries:
+		ids1.append(String(e.class_id))
+	for e: DemandSpec in p2.entries:
+		ids2.append(String(e.class_id))
+	eq(ids1, ids2, "entry class ids")
+	# surge active at tick 1200 -> set_pieces non-empty
+	check(not p1.set_pieces.is_empty(), "surge active at 1200")
+
+
+func _test_surge_schedule() -> void:
+	_start("director: surge forecasted before, active during, gone after")
+	var d := _director()
+	var topo := TopologySnapshot.new()
+	var rng := RandomNumberGenerator.new()
+	rng.seed = 1
+	# start_tick 1200, forecast_lead 600 -> forecasted at 600..1199, active 1200..2999
+	eq(d.plan_pressure(topo, 3, 0, rng).set_pieces.size(), 0, "no surge at tick 0")
+	check(d.forecast_for_era(3, 700).size() >= 1, "forecast at 700")
+	eq(d.plan_pressure(topo, 3, 1200, rng).set_pieces.size(), 1, "active at 1200")
+	eq(d.plan_pressure(topo, 3, 2999, rng).set_pieces.size(), 1, "active at 2999")
+	eq(d.plan_pressure(topo, 3, 3000, rng).set_pieces.size(), 0, "gone at 3000")
