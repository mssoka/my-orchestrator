+++ b/game/scripts/core/set_piece.gd
@@ -0,0 +1,32 @@
+## A forecast event / set-piece (sprint-plan §3.1) — e.g. the Streaming Surge.
+##
+## Amplifies a DemandSpec's class by `multiplier` for a time window, with a
+## forecast lead so the player can prepare (the P3 fairness contract, FORGE #3).
+class_name SetPiece
+extends RefCounted
+
+var id: StringName = &""              # e.g. &"streaming_surge"
+var class_id: StringName = &""        # the class it amplifies
+var multiplier: int = 1               # 10× for the Surge
+var start_tick: int = 0
+var duration_ticks: int = 0
+var forecast_lead_ticks: int = 0      # how far ahead the forecast warns (GDD M5)
+
+
+func is_active(tick: int) -> bool:
+	return tick >= start_tick and tick < start_tick + duration_ticks
+
+
+func is_forecasted(tick: int) -> bool:
+	# Visible in the forecast panel before it fires (GDD M5 lead time).
+	return tick >= start_tick - forecast_lead_ticks and tick < start_tick
+
+
+func _init(p_id: StringName = &"", p_class: StringName = &"", p_mult: int = 1,
+		   p_start: int = 0, p_dur: int = 0, p_lead: int = 0) -> void:
+	id = p_id
+	class_id = p_class
+	multiplier = p_mult
+	start_tick = p_start
+	duration_ticks = p_dur
+	forecast_lead_ticks = p_lead
