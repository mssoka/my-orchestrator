+## S0/QoS foundation — integer lane partition (E8 no-vanish; E5 all-zero fallback).
+extends TestSuite
+
+
+func run() -> Array:
+	_test_even_split_no_vanish()
+	_test_default_weights_split()
+	_test_all_zero_fallback()
+	_test_zero_capacity()
+	return results
+
+
+func _test_even_split_no_vanish() -> void:
+	_start("qos: 25 capacity / (1,1,1) -> no bandwidth vanishes (E8)")
+	var w: Vector3i = QoSEngine.allocate(25, Vector3i(1, 1, 1), Vector3i(1, 4, 1))
+	eq(w.x + w.y + w.z, 25, "sum == capacity")
+	# remainder 1 -> tie among equal fracs -> Express first -> (9,8,8)
+	eq(w, Vector3i(9, 8, 8), "even split remainder to Express")
+
+
+func _test_default_weights_split() -> void:
+	_start("qos: 15 capacity / (1,4,1) -> (3,10,2)")
+	var w: Vector3i = QoSEngine.allocate(15, Vector3i(1, 4, 1), Vector3i(1, 4, 1))
+	eq(w.x + w.y + w.z, 15, "sum == capacity")
+	eq(w, Vector3i(3, 10, 2), "default-weight split")
+
+
+func _test_all_zero_fallback() -> void:
+	_start("qos: all-zero weights -> fallback to defaults (E5)")
+	var w: Vector3i = QoSEngine.allocate(15, Vector3i(0, 0, 0), Vector3i(1, 4, 1))
+	eq(w, Vector3i(3, 10, 2), "all-zero fallback")
+
+
+func _test_zero_capacity() -> void:
+	_start("qos: zero capacity -> zero allocation")
+	var w: Vector3i = QoSEngine.allocate(0, Vector3i(1, 4, 1), Vector3i(1, 4, 1))
+	eq(w, Vector3i.ZERO, "zero capacity")
