diff --git a/game/scripts/core/sim_driver.gd b/game/scripts/core/sim_driver.gd
new file mode 100644
index 0000000..4cc72bd
--- /dev/null
+++ b/game/scripts/core/sim_driver.gd
@@ -0,0 +1,54 @@
+## SimDriver — the fixed-tick stepper (ADR-2, architecture §10.1.1).
+##
+## Runs ONE logic step: apply commands (atomic batch) -> director plans pressure
+## -> flow steps -> crisis evaluates -> health updates -> era steps -> snapshot.
+## The fixed-timestep ACCUMULATOR lives in RunController (Presentation); SimDriver
+## is stateless over ticks (pure RefCounted, ADR-1). Deterministic given
+## (state, tick, cmds) — the rng is held by RunState and consumed identically
+## across runs (AC-E10).
+class_name SimDriver
+extends RefCounted
+
+
+## Advance `state` one tick with a batch of commands. Returns the immutable
+## SimSnapshot for this tick. Commands are validate-all-then-apply (AC-E23); a
+## rejected batch leaves state untouched and the tick still steps (the rejection
+## is surfaced separately).
+func step(state: RunState, tick: int, cmds: Array) -> SimSnapshot:
+	state.tick = tick
+
+	# 1. Apply the player's edits (atomic batch). Append VALID cmds to the action
+	#    log (the canonical save form, ADR-11). A rejected batch still steps the
+	#    sim (demand flows) but records nothing.
+	var apply_result: EditResult = state.topology.apply_all(cmds)
+	if apply_result.ok:
+		for cmd: Command in cmds:
+			state.action_log.append(cmd)
+
+	# 2. Director plans pressure (deterministic from era + tick).
+	var topo_snap: TopologySnapshot = state.topology.snapshot()
+	var plan: PressurePlan = state.director.plan_pressure(
+		topo_snap, state.era.era_id, tick, state.rng)
+
+	# 3. Flow steps (spawn from demand; routing/delivery is E1.4/S1).
+	var report: FlowReport = state.flow.step(
+		tick, state.rng, topo_snap, state.era.era_id, plan)
+
+	# 4. Crisis evaluates (downstream of the flow).
+	var crisis_report: CrisisReport = state.crisis.evaluate(
+		tick, topo_snap, state.flow, state.era.era_id, state.director)
+
+	# 5. Health updates (downstream of SLA; win/lose, S4 E6.2/E6.3). Breach uses
+	#    the ROLLING recent uptime so the build phase is forgiven.
+	state.health.update(tick, report, plan, state.flow.recent_overall_uptime_pct())
+
+	# 6. Era steps (no-op in S0; advance is S5/post-gate).
+	state.era.step(tick, report.overall_uptime_pct(), state.topology)
+
+	# accumulate run counters (deterministic)
+	state.spawned_total += report.spawned
+	state.delivered_total += report.delivered
+	state.dropped_total += report.dropped
+	state.unmet_total += report.unmet_demand
+
+	return state.snapshot(crisis_report, report, plan)
