+## A topology node (S1.1, GDD § M3).
+##
+## TERMINAL nodes are sources/sinks (Residential, Content host); JUNCTION nodes
+## are routers that forward (never themselves a source/sink) and double as
+## repeaters (routing through a junction resets the span budget). Health state
+## is the warning surface (GDD M5). Positions are Vector2i (integer grid ->
+## determinism, ADR-10). Ids are monotonic — never recycled within a run (AC-E11).
+##
+## Pure data (RefCounted) — not a Node (ADR-1).
+class_name NetNode
+extends RefCounted
+
+var id: int = -1
+var kind: int = CoreConst.NodeKind.TERMINAL
+var type_id: StringName = &""              # catalog node_type id
+var terminal_role: int = -1                # CoreConst.TerminalRole (-1 for junctions)
+var pos: Vector2i = Vector2i.ZERO
+var throughput_units: int = 0
+var health_state: int = CoreConst.HealthState.HEALTHY
+var utilization_units: int = 0             # current load (updated by PacketFlow)
+var demand_weight: int = 1                  # relative demand attraction (sprint-plan §3.3)
+var spawn_tick: int = 0
+
+
+func is_terminal() -> bool:
+	return kind == CoreConst.NodeKind.TERMINAL
+
+
+func is_junction() -> bool:
+	return kind == CoreConst.NodeKind.JUNCTION
+
+
+func utilization_pct() -> int:
+	# Integer percent (ADR-10); throughput 0 -> 0 (guards division).
+	if throughput_units <= 0:
+		return 0
+	return (utilization_units * 100) / throughput_units
+
+
+func _to_string() -> String:
+	return "Node#%d(%s@%s)" % [id, type_id, pos]
