+## S1.1/S0.1 — topology edits: batch atomicity (E23), ids (E11), span, E2/E3.
+extends TestSuite
+
+
+func _new_graph() -> TopologyGraph:
+	var c := GameCatalogs.load_default()
+	var b := BalanceData.new()   # compiled defaults suffice for these checks
+	var e := Economy.new(10000)
+	return TopologyGraph.new(c, e, b)
+
+
+func _two_node_graph() -> TopologyGraph:
+	var g := _new_graph()
+	g.spawn_node(CoreConst.NodeKind.TERMINAL, &"residential",
+		CoreConst.TerminalRole.RESIDENTIAL, Vector2i(0, 0), 5, 0)   # id 1
+	g.spawn_node(CoreConst.NodeKind.TERMINAL, &"residential",
+		CoreConst.TerminalRole.RESIDENTIAL, Vector2i(3, 0), 5, 0)   # id 2
+	return g
+
+
+func run() -> Array:
+	_test_ids_monotonic()
+	_test_self_loop_rejected()
+	_test_span_limit_rejected()
+	_test_batch_atomicity()
+	_test_batch_all_valid_applies()
+	_test_terminal_demolish_forbidden()
+	return results
+
+
+func _test_ids_monotonic() -> void:
+	_start("topology: ids monotonic, never recycled (AC-E11)")
+	var g := _new_graph()
+	var ids: Array[int] = []
+	for i: int in 3:
+		ids.append(g.spawn_node(CoreConst.NodeKind.JUNCTION, &"router", -1,
+			Vector2i(i, 0), 60, 0).id)
+	eq(ids, [1, 2, 3], "monotonic ids")
+
+
+func _test_self_loop_rejected() -> void:
+	_start("topology: self-loop pipe rejected (AC-E3)")
+	var g := _two_node_graph()
+	var r: EditResult = g.apply_edit(Command.DrawPipeCmd.new(0, 1, 1, &"narrow"))
+	check(not r.ok, "should reject")
+	eq(r.reason, &"self_loop", "reason")
+
+
+func _test_span_limit_rejected() -> void:
+	_start("topology: span > tier.max_span rejected (E1.1)")
+	var g := _new_graph()
+	g.spawn_node(CoreConst.NodeKind.TERMINAL, &"residential",
+		CoreConst.TerminalRole.RESIDENTIAL, Vector2i(0, 0), 5, 0)   # id 1
+	g.spawn_node(CoreConst.NodeKind.TERMINAL, &"residential",
+		CoreConst.TerminalRole.RESIDENTIAL, Vector2i(40, 0), 5, 0)  # id 2 (span 40 >> narrow.max_span 8)
+	var r: EditResult = g.apply_edit(Command.DrawPipeCmd.new(0, 1, 2, &"narrow"))
+	check(not r.ok, "should reject")
+	eq(r.reason, &"span_exceeds_tier", "reason")
+
+
+func _test_batch_atomicity() -> void:
+	_start("topology: one bad cmd rejects the WHOLE batch (AC-E23)")
+	var g := _two_node_graph()
+	var batch: Array = [
+		Command.DrawPipeCmd.new(0, 1, 2, &"narrow"),   # valid
+		Command.DrawPipeCmd.new(0, 1, 1, &"narrow"),   # INVALID self-loop
+	]
+	var r: EditResult = g.apply_all(batch)
+	check(not r.ok, "batch rejected")
+	eq(g.pipe_count(), 0, "no partial mutation — graph unchanged")
+
+
+func _test_batch_all_valid_applies() -> void:
+	_start("topology: all-valid batch applies")
+	var g := _two_node_graph()
+	var r: EditResult = g.apply_edit(Command.DrawPipeCmd.new(0, 1, 2, &"narrow"))
+	check(r.ok, "draw applied")
+	eq(g.pipe_count(), 1, "one pipe")
+
+
+func _test_terminal_demolish_forbidden() -> void:
+	_start("topology: demolishing a terminal node forbidden (AC-E2)")
+	var g := _two_node_graph()
+	var r: EditResult = g.apply_edit(Command.DemolishCmd.new(0, 1, true))   # node 1 is residential (terminal)
+	check(not r.ok, "should reject")
+	eq(r.reason, &"terminal_forbidden", "reason")
