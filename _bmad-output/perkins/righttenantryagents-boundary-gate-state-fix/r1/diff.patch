+# ──────────────────────────────────────────────────────────────────────────
+# Final gate — analogous coverage (same state-view bug, parallel reads)
+# ──────────────────────────────────────────────────────────────────────────
+
+
+def _ctx_with_clean_final_reviewer(live_state: dict | None = None) -> _DivergentCtx:
+    live = live_state if live_state is not None else {}
+
+    async def write_clean(_ctx, _node) -> None:
+        live[STATE_FINAL_COMPLIANCE_REVIEW] = _CLEAN_REVIEW
+
+    return _DivergentCtx(live, write_clean)
+
+
+class TestFinalGateCleanVerdictProceeds:
+    def test_clean_verdict_does_not_fail_close(self, monkeypatch):
+        monkeypatch.setattr(
+            agent_mod, "final_compliance_reviewer_agent", lambda: object()
+        )
+        ctx = _ctx_with_clean_final_reviewer()
+
+        asyncio.run(agent_mod._run_final_compliance_gate(ctx))
+
+        assert ctx.state.get(STATE_PIPELINE_ERROR) is None
+        assert ctx.session.state.get(STATE_PIPELINE_ERROR) is None
+
+    def test_final_output_read_uses_session_state(self, monkeypatch):
+        # STATE_FINAL_OUTPUT is assembled by the v4 callback during this
+        # node's run (a cross-node write); the gate must read it off the live
+        # session dict. A dirty review that names a span NOT in the payload
+        # short-circuits via the scrub=0 path — but the read itself must not
+        # crash on None from the stale ctx.state. Here the reviewer returns a
+        # dirty review whose field is outside the audited allowlist, so scrub
+        # yields 0 and the gate escalates non-retryable — proving the review
+        # AND final_output reads succeeded via ctx.session.state.
+        live = {
+            STATE_FINAL_COMPLIANCE_REVIEW: {
+                "passed": False,
+                "violations": [
+                    {
+                        "field": "nonexistent_path",
+                        "ground": "gender",
+                        "span": "x",
+                        "why": "stub",
+                    }
+                ],
+            },
+            STATE_FINAL_OUTPUT: {"schema_version": "v4"},
+        }
+
+        async def write_review(_ctx, _node) -> None:
+            # Review already seeded; nothing to do (the slot persists across
+            # the re-judge in this no-LLM model).
+            pass
+
+        ctx = _DivergentCtx(live, write_review)
+        monkeypatch.setattr(
+            agent_mod, "final_compliance_reviewer_agent", lambda: object()
+        )
+
+        asyncio.run(agent_mod._run_final_compliance_gate(ctx))
+
+        err = ctx.session.state.get(STATE_PIPELINE_ERROR)
+        # The gate reached finalize (read both review + final_output off the
+        # live dict) and escalated non-retryable — the reads worked.
+        assert err is not None
+        assert err["code"] == ERROR_COMPLIANCE_VIOLATION
+        assert err["retryable"] is False
+
