diff --git a/tests/unit/test_gate_state_marshalling.py b/tests/unit/test_gate_state_marshalling.py
new file mode 100644
index 0000000..14caf05
--- /dev/null
+++ b/tests/unit/test_gate_state_marshalling.py
@@ -0,0 +1,376 @@
+"""Regression tests for the compliance-gate state-marshalling bug (issue #172).
+
+The bug: a child agent's ``output_key`` write (e.g. the boundary judge's
+``verification_compliance_review``) is committed to the LIVE
+``ctx.session.state`` but is ABSENT from the pipeline node's ``ctx.state``
+snapshot (a ``State`` whose ``_value`` was captured at node construction).
+So ``ctx.state.get(STATE_VERIFICATION_COMPLIANCE_REVIEW)`` returns ``None``
+one call after ``ctx.run_node(judge)`` even when the judge ruled CLEAN, and
+the gate fail-closes to a non-retryable ``COMPLIANCE_VIOLATION`` — dropping
+every clean vetting (no analysis, no score).
+
+The fix: the gates read cross-node state (the judge's output_key +
+``STATE_FINAL_OUTPUT``) off ``ctx.session.state`` (the live dict), mirroring
+the existing repair-key template; the finalize guards are handed
+``ctx.session.state`` too.
+
+These tests drive the REAL ``_run_boundary_compliance_gate`` /
+``_run_final_compliance_gate`` through ``ctx.run_node`` with a fake Context
+that FORCES the production divergence: ``ctx.state`` is a stale ``State``
+snapshot that cannot see the child's write, while ``ctx.session.state`` is
+the live dict the write lands on. They fail if any gate read reverts to
+``ctx.state`` — the regression guard the InMemory recorder harness cannot
+provide (InMemory shares the live dict, so the divergence never appears
+there).
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+
+from google.adk.sessions.state import State
+
+import tenant_scorer.agent as agent_mod
+from tenant_scorer.callbacks.boundary_compliance_remediation import (
+    finalize_boundary_gate,
+)
+from tenant_scorer.callbacks.final_compliance_remediation import finalize_final_gate
+from tenant_scorer.constants import (
+    ERROR_COMPLIANCE_VIOLATION,
+    STATE_COMPLIANCE_REVIEW_VERDICT,
+    STATE_FINAL_COMPLIANCE_REVIEW,
+    STATE_FINAL_OUTPUT,
+    STATE_PIPELINE_ERROR,
+    STATE_VERIFICATION_COMPLIANCE_REVIEW,
+)
+
+_CLEAN_REVIEW = {"passed": True, "violations": []}
+
+
+class _FakeSession:
+    """``ctx.session`` stand-in exposing the LIVE state dict."""
+
+    def __init__(self, state: dict) -> None:
+        self.state = state
+
+
+class _DivergentCtx:
+    """A Context that reproduces the production state-view divergence.
+
+    ``ctx.state`` is a ``State`` built on an EMPTY stale snapshot (separate
+    from the live dict), so ``ctx.state.get(<child output_key>)`` returns
+    ``None`` exactly as it does in production one call after ``run_node``.
+    ``ctx.session.state`` is the LIVE dict that ``run_node``'s child writes
+    land on — the view the FIXED gates read.
+    """
+
+    def __init__(self, live_state: dict, run_node) -> None:
+        self._run_node = run_node
+        # Stale snapshot: a distinct empty dict + empty delta, so any key the
+        # child writes to the LIVE dict is invisible here (the bug).
+        self.state = State({}, {})
+        self.session = _FakeSession(live_state)
+
+    async def run_node(self, node, *args, **kwargs):
+        # The child's output_key write is modelled as a direct write to the
+        # LIVE session dict (the production commit target). The stale
+        # `ctx.state` snapshot is deliberately NOT updated.
+        await self._run_node(self, node)
+        return None
+
+
+def _ctx_with_clean_judge(live_state: dict | None = None) -> _DivergentCtx:
+    """A divergent ctx whose run_node writes a CLEAN boundary review to the
+    live session dict (mirroring the judge committing its output_key)."""
+    live = live_state if live_state is not None else {}
+
+    async def write_clean(_ctx, _node) -> None:
+        live[STATE_VERIFICATION_COMPLIANCE_REVIEW] = _CLEAN_REVIEW
+
+    return _DivergentCtx(live, write_clean)
+
+
+def _ctx_with_missing_judge(live_state: dict | None = None) -> _DivergentCtx:
+    """A divergent ctx whose run_node writes NOTHING — a genuinely missing
+    judge run (no output_key landed)."""
+    live = live_state if live_state is not None else {}
+
+    async def write_nothing(_ctx, _node) -> None:
+        pass
+
+    return _DivergentCtx(live, write_nothing)
+
+
+# ──────────────────────────────────────────────────────────────────────────
+# Boundary gate — clean verdict proceeds (the bug: it fail-closed)
+# ──────────────────────────────────────────────────────────────────────────
+
+
+class TestBoundaryGateCleanVerdictProceeds:
+    def test_clean_verdict_does_not_fail_close(self, monkeypatch):
+        # The judge ruled clean; the gate MUST return without setting
+        # STATE_PIPELINE_ERROR. Pre-fix the gate read ctx.state -> None ->
+        # finalize fail-closed; post-fix it reads ctx.session.state -> clean.
+        monkeypatch.setattr(
+            agent_mod, "verification_compliance_judge_agent", lambda: object()
+        )
+        ctx = _ctx_with_clean_judge()
+
+        asyncio.run(agent_mod._run_boundary_compliance_gate(ctx))
+
+        # No pipeline error on EITHER view — the production envelope reads
+        # ctx.state, so a fail-close written there is the observable bug.
+        assert ctx.state.get(STATE_PIPELINE_ERROR) is None
+        assert ctx.session.state.get(STATE_PIPELINE_ERROR) is None
+        # The clean review reached the live session dict (what a re-judge /
+        # telemetry would read), while the stale ctx.state snapshot never
+        # saw it — the exact divergence the fix routes around by reading
+        # ctx.session.state.
+        assert (
+            ctx.session.state.get(STATE_VERIFICATION_COMPLIANCE_REVIEW) == _CLEAN_REVIEW
+        )
+        assert ctx.state.get(STATE_VERIFICATION_COMPLIANCE_REVIEW) is None
+
+
+class TestBoundaryGateGenuinelyMissingFailCloses:
+    def test_missing_judge_fail_closes_non_retryable(self, monkeypatch):
+        # Inverse of the clean case: a judge that genuinely produced nothing
+        # MUST still fail-close non-retryable (never ship unaudited prose).
+        monkeypatch.setattr(
+            agent_mod, "verification_compliance_judge_agent", lambda: object()
+        )
+        ctx = _ctx_with_missing_judge()
+
+        asyncio.run(agent_mod._run_boundary_compliance_gate(ctx))
+
+        err = ctx.session.state.get(STATE_PIPELINE_ERROR)
+        assert err is not None
+        assert err["code"] == ERROR_COMPLIANCE_VIOLATION
+        assert err["retryable"] is False
+
+
+class TestBoundaryGateDefensiveCrossCheck:
+    def test_clean_verdict_stamp_prevents_abort_on_none_review(self, monkeypatch):
+        # Defense-in-depth (issue #172): even if the review slot reads None at
+        # finalize time (a deeper state-prop failure), a telemetry verdict
+        # stamp recording the judge ruled CLEAN must keep scoring alive. The
+        # stamp is the independent witness (read off the judge's own ctx).
+        monkeypatch.setattr(
+            agent_mod, "verification_compliance_judge_agent", lambda: object()
+        )
+        # No review slot, but the telemetry stamped a clean verdict.
+        live = {
+            STATE_COMPLIANCE_REVIEW_VERDICT: {"judge_kind": "boundary", "passed": True}
+        }
+        ctx = _ctx_with_missing_judge(live_state=live)
+
+        asyncio.run(agent_mod._run_boundary_compliance_gate(ctx))
+
+        assert ctx.session.state.get(STATE_PIPELINE_ERROR) is None
+
+    def test_dirty_stamp_does_not_prevent_abort(self, monkeypatch):
+        # A stamp recording a DIRTY verdict (passed=False) must NOT mask the
+        # fail-close — only a clean stamp is the state-prop signal.
+        monkeypatch.setattr(
+            agent_mod, "verification_compliance_judge_agent", lambda: object()
+        )
+        live = {
+            STATE_COMPLIANCE_REVIEW_VERDICT: {"judge_kind": "boundary", "passed": False}
+        }
+        ctx = _ctx_with_missing_judge(live_state=live)
+
+        asyncio.run(agent_mod._run_boundary_compliance_gate(ctx))
+
+        err = ctx.session.state.get(STATE_PIPELINE_ERROR)
+        assert err is not None
+        assert err["retryable"] is False
+
+    def test_wrong_judge_stamp_does_not_prevent_abort(self, monkeypatch):
+        # A clean stamp for the OTHER gate (final) must not satisfy the
+        # boundary guard — judge_kind is checked.
+        monkeypatch.setattr(
+            agent_mod, "verification_compliance_judge_agent", lambda: object()
+        )
+        live = {
+            STATE_COMPLIANCE_REVIEW_VERDICT: {"judge_kind": "final", "passed": True}
+        }
+        ctx = _ctx_with_missing_judge(live_state=live)
