+
+// sla_focus_click — filter/focus (§8.4): a press on a class row toggles that
+// class's focus (every other class's packets ghost-dim). Iterates the SAME
+// visibility predicate + row math as draw_sla_gauges (single source).
+sla_focus_click :: proc(app: ^App, mouse: rl.Vector2) -> bool {
+	f := &app.state.flow
+	line := 0
+	for c in 0..<len(f.sla) {
+		if line >= 3 {
+			break
+		}
+		if !sla_row_visible(f, &app.cat, c) {
+			continue
+		}
+		if rl.CheckCollisionPointRec(mouse, sla_row_rect(&app.view, line)) {
+			if app.focus_class == i32(c) {
+				app.focus_class = -1
+			} else {
+				app.focus_class = i32(c)
+			}
+			return true
+		}
+		line += 1
+	}
+	return false
+}
