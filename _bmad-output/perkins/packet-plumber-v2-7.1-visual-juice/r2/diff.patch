new file mode 100644
index 0000000..5f8f425
--- /dev/null
+++ b/app/render/sprites.odin
@@ -0,0 +1,182 @@
+package render
+
+// sprites.odin — the 7.1 building sprite pipeline (the lavish-approved
+// top-down direction, 2026-08-17). Terminals + router pucks draw as
+// Blender-rendered sprites (tools/gen_sprites.py -> assets/sprites/*.png):
+// flat emissive, canon hexes (sRGB->linear corrected at render), our own
+// designs. The sidecar sprites.json carries each sprite's alpha content bbox
+// (the render pads to a 256px canvas; the draw trims to the content) — it is
+// EMBEDDED via #load like the palette, so regenerated sprites carry their
+// own geometry with zero code churn.
+//
+// The contact shadow (the user's depth ruling) is drawn HERE, not baked:
+// Blender's hashed alpha dithers at sprite size — a flat translucent ink
+// ellipse under the building is the MM soft-shadow read, deterministic and
+// cheap.
+//
+// Loaded at init by BOTH the app and the harness (same files, same raylib
+// path = the same pixels in T2 goldens — the FONT_ASSET precedent). A missing
+// asset set falls back to the old primitive draws (belt-and-braces like the
+// font fallback; in practice unreachable — the sprites are committed).
+
+import "core:encoding/json"
+import "core:strings"
+import pp "../../core"
+import rl "vendor:raylib"
+
+SPRITES_DIR :: "assets/sprites/"
+SPRITES_JSON :: #load("../../assets/sprites/sprites.json")
+
+// SPRITE_COUNT — the sheet size (order in sprites.json).
+SPRITE_COUNT :: 9
+
+// sprite order (the sprites.json `order` array):
+//   0-3 house_{0..3} (coral/gold/sage/sky), 4 host, 5 dc, 6-8 puck_{1,2,3}
+Sprite_Sheet :: struct {
+	textures: [SPRITE_COUNT]rl.Texture2D,
+	bboxes:   [SPRITE_COUNT][4]f32, // x, y, w, h (px in the 256 canvas)
+	ok:       bool,
+}
+
+// sprites_load — load the 9 sprites + parse the embedded bbox sidecar.
+// Called once at init (app + harness), after the raylib window exists.
+// Returns false on ANY failure and unloads the partial set (a half-loaded
+// sheet must never leave leaked GPU textures behind — Perkins r1 note).
+sprites_load :: proc(sh: ^Sprite_Sheet) -> bool {
+	ok := true
+	files := [SPRITE_COUNT]string{
+		"house_0", "house_1", "house_2", "house_3", "host", "dc",
+		"puck_1", "puck_2", "puck_3",
+	}
+	for f, i in files {
+		path := strings.concatenate({SPRITES_DIR, f, ".png"}, context.temp_allocator)
+		tex := rl.LoadTexture(strings.clone_to_cstring(path, context.temp_allocator))
+		if !rl.IsTextureValid(tex) {
+			ok = false
+			break
+		}
+		rl.SetTextureFilter(tex, .BILINEAR)
+		sh.textures[i] = tex
+	}
+	if !ok {
+		sprites_unload(sh)
+		return false
+	}
+	if !sprites_parse_boxes(sh) {
+		sprites_unload(sh)
+		return false
+	}
+	sh.ok = true
+	return true
+}
+
+// sprites_unload — free whatever the sheet holds (safe on a zero/partial sheet).
+sprites_unload :: proc(sh: ^Sprite_Sheet) {
+	for &tex in sh.textures {
+		if rl.IsTextureValid(tex) {
+			rl.UnloadTexture(tex)
+		}
+		tex = {}
+	}
+	sh.ok = false
+}
+
+// sprites_parse_boxes — the embedded sprites.json: content_bbox[order[i]] =
+// [x, y, w, h]. Any malformation fails the sheet (the caller falls back to
+// primitives — never draw a sprite with a guessed bbox).
+sprites_parse_boxes :: proc(sh: ^Sprite_Sheet) -> bool {
+	v, err := json.parse(transmute([]u8)SPRITES_JSON, parse_integers = true)
+	if err != nil {
+		return false
+	}
+	obj, okm := v.(json.Object)
+	if !okm {
+		return false
+	}
+	order, oko := obj["order"].(json.Array)
+	boxes, okb := obj["content_bbox"].(json.Object)
+	if !oko || !okb || len(order) != SPRITE_COUNT {
+		return false
+	}
+	for i in 0..<SPRITE_COUNT {
+		name, okn := order[i].(json.String)
+		if !okn {
+			return false
+		}
+		arr, oka := boxes[string(name)].(json.Array)
+		if !oka || len(arr) != 4 {
+			return false
+		}
+		for k in 0..<4 {
+			n, oknum := arr[k].(json.Integer)
+			if !oknum {
+				return false
+			}
+			sh.bboxes[i][k] = f32(n)
+		}
+		// VALUE-RANGE checks, not just structure (Perkins r1 note): the bbox
+		// must be inside the 256px canvas and non-degenerate — a corrupt
+		// sidecar would otherwise draw a garbage src window.
+		x, y, w, h := sh.bboxes[i][0], sh.bboxes[i][1], sh.bboxes[i][2], sh.bboxes[i][3]
+		if x < 0 || y < 0 || w <= 0 || h <= 0 || x + w > 256 || y + h > 256 {
+			return false
+		}
+	}
+	return true
+}
+
+// sprite_index_building — the sprite index for a terminal: the house variant
+// (id % 4) or the host. The dc sprite exists for the roster's future; the
+// two live terminal roles map to house/host.
+sprite_index_building :: proc(id: u32, role: pp.Terminal_Role) -> int {
+	if role == .Content_Host {
+		return 4
+	}
+	return int(id % 4)
+}
+
+// sprite_index_puck — the puck tier index (basic/mid/high by port count).
+sprite_index_puck :: proc(port_capacity: i32) -> int {
+	if port_capacity >= 16 {
+		return 8
+	}
+	if port_capacity >= 8 {
+		return 7
+	}
+	return 6
+}
+
+// SPRITE_SHADOW — the flat contact shadow (the user's depth ruling): ink at
+// ~33%, an ellipse offset down-right of the footprint. Drawn UNDER the sprite.
+sprite_shadow :: proc(c: rl.Vector2, target_w: f32) {
+	col := rl.Color{51, 65, 79, 84}
+	rl.DrawEllipse(i32(c.x + target_w * 0.10), i32(c.y + target_w * 0.24), target_w * 0.56, target_w * 0.33, col)
+}
+
+// sprite_blit — draw sprite `idx` with its CONTENT centered at the node
+// screen pos, `target_w` px wide (the aspect comes from the bbox).
+sprite_blit :: proc(sh: ^Sprite_Sheet, idx: int, c: rl.Vector2, target_w: f32) {
+	cb := sh.bboxes[idx]
+	if cb[2] <= 0 || cb[3] <= 0 {
+		return
+	}
+	sprite_shadow(c, target_w)
+	src := rl.Rectangle{cb[0], cb[1], cb[2], cb[3]}
+	dh := target_w * cb[3] / cb[2]
+	dst := rl.Rectangle{c.x - target_w / 2, c.y - dh / 2, target_w, dh}
+	rl.DrawTexturePro(sh.textures[idx], src, dst, {0, 0}, 0, rl.WHITE)
+}
+
+// sprite_target_w — the in-game footprint widths (tiles * tile_px * scale).
+sprite_house_target :: proc(v: ^View) -> f32 { return 1.50 * v.tile_px * v.scale }
+sprite_host_target :: proc(v: ^View) -> f32  { return 1.75 * v.tile_px * v.scale }
+sprite_puck_target :: proc(v: ^View, port_capacity: i32) -> f32 {
+	sh := v.sprites
+	idx := sprite_index_puck(port_capacity)
+	base := sh.bboxes[6][2]
+	if base <= 0 {
+		base = 110 // the committed default (defensive — bboxes parsed at load)
+	}
+	// preserve the canon tier scale: sizes relative to the basic puck's content
+	return 1.30 * v.tile_px * v.scale * (sh.bboxes[idx][2] / base)
+}
