+// --- 7.1 focus-zoom camera (presentation only — the view's scale/off are
+// recomputed each frame; the sim never sees the camera, ODN-1) --------------
+
+// camera_set_fit — the bird's-eye target: the camera-fit's world center, 1.0x.
+camera_set_fit :: proc(app: ^App) {
+	app.cam_wx_to = app.view.world_w / 2
+	app.cam_wy_to = app.view.world_h / 2
+	app.cam_zoom_to = 1.0
+}
+
+// camera_set_selection — the focus-zoom target from the current selection:
+// a node zooms in 2.3x, a link 2.6x (the lanes + queues reveal at the full
+// read), nothing selected returns to the bird's-eye fit.
+camera_set_selection :: proc(app: ^App) {
+	app.last_sel_node = app.input.sel_node
+	app.last_sel_pipe = app.input.sel_pipe
+	if app.input.sel_node >= 0 {
+		if slot, ok := pp.node_slot(&app.state.topology, u32(app.input.sel_node)); ok {
+			app.cam_wx_to = f32(app.state.topology.node_pos[slot][0]) * app.view.tile_px
+			app.cam_wy_to = f32(app.state.topology.node_pos[slot][1]) * app.view.tile_px
+			app.cam_zoom_to = 2.3
+			return
+		}
+	}
+	if app.input.sel_pipe >= 0 {
+		if ps, ok := pp.pipe_slot(&app.state.topology, u32(app.input.sel_pipe)); ok {
+			sa, oka := pp.node_slot(&app.state.topology, app.state.topology.pipe_a[ps])
+			sb, okb := pp.node_slot(&app.state.topology, app.state.topology.pipe_b[ps])
+			if oka && okb {
+				ax := f32(app.state.topology.node_pos[sa][0]) * app.view.tile_px
+				ay := f32(app.state.topology.node_pos[sa][1]) * app.view.tile_px
+				bx := f32(app.state.topology.node_pos[sb][0]) * app.view.tile_px
+				by := f32(app.state.topology.node_pos[sb][1]) * app.view.tile_px
+				app.cam_wx_to = (ax + bx) / 2
+				app.cam_wy_to = (ay + by) / 2
+				app.cam_zoom_to = 2.6
+				return
+			}
+		}
+	}
+	camera_set_fit(app)
+}
+
+// camera_focus_pair — alerts-as-nav: focus-zoom the (lo, hi) node pair's
+// midpoint (the crisis banner click's bottleneck bundle).
+camera_focus_pair :: proc(app: ^App, lo, hi: u32) {
+	sl, ok1 := pp.node_slot(&app.state.topology, lo)
+	sh, ok2 := pp.node_slot(&app.state.topology, hi)
+	if !ok1 || !ok2 {
+		return
+	}
+	ax := f32(app.state.topology.node_pos[sl][0]) * app.view.tile_px
+	ay := f32(app.state.topology.node_pos[sl][1]) * app.view.tile_px
+	bx := f32(app.state.topology.node_pos[sh][0]) * app.view.tile_px
+	by := f32(app.state.topology.node_pos[sh][1]) * app.view.tile_px
+	app.cam_wx_to = (ax + bx) / 2
+	app.cam_wy_to = (ay + by) / 2
+	app.cam_zoom_to = 2.6
+}
+
+// camera_update — the per-frame eased approach (a simple exponential ease; the
+// rasterized-path no-transcendentals rule is satisfied — no sin/cos). The view
+// scale/off derive from the animated camera; lane_detail flips at the 1.5x
+// threshold (the lanes reveal ON zoom-in — the user's camera model).
+camera_update :: proc(app: ^App) {
+	v := &app.view
+	app.cam_zoom += (app.cam_zoom_to - app.cam_zoom) * 0.14
+	app.cam_wx += (app.cam_wx_to - app.cam_wx) * 0.14
+	app.cam_wy += (app.cam_wy_to - app.cam_wy) * 0.14
+	if abs(app.cam_zoom - app.cam_zoom_to) < 0.005 {
+		app.cam_zoom = app.cam_zoom_to
+	}
+	if abs(app.cam_wx - app.cam_wx_to) < 0.5 {
+		app.cam_wx = app.cam_wx_to
+	}
+	if abs(app.cam_wy - app.cam_wy_to) < 0.5 {
+		app.cam_wy = app.cam_wy_to
+	}
+	fit := min(f32(v.win_w)/v.world_w, f32(v.win_h)/v.world_h)
+	v.scale = fit * app.cam_zoom
+	v.off_x = f32(v.win_w)/2 - app.cam_wx * v.scale
+	v.off_y = f32(v.win_h)/2 - app.cam_wy * v.scale
+	v.lane_detail = app.cam_zoom > 1.5
+}
+
+// banner_y — the crisis banner's top edge (below the health meter card when
+// the meter is live). Shared by the HUD draw + the alerts-as-nav hit-test.
+banner_y :: proc(app: ^App) -> i32 {
+	if app.state.health_enabled {
+		return 10 + rnd.HEALTH_CARD_H + 6
+	}
+	return 10
+}
+
+// crisis_banner_click — alerts-as-nav (art-direction §8.2): a press inside the
+// crisis banner focus-zooms the first named bottleneck bundle. The rect is the
+// RENDER package's (crisis_banner_rect — the popover single-source rule).
+crisis_banner_click :: proc(app: ^App, mouse: rl.Vector2) -> bool {
+	if len(app.state.crisis.active) == 0 {
+		return false
+	}
+	rect, ok := rnd.crisis_banner_rect(&app.view, &app.state.crisis, banner_y(app))
+	if !ok || !rl.CheckCollisionPointRec(mouse, rect) {
+		return false
+	}
+	for ac in app.state.crisis.active {
+		if ac.kind == .Saturated_Bundle {
+			camera_focus_pair(app, ac.bundle_lo, ac.bundle_hi)
+			return true
+		}
+	}
