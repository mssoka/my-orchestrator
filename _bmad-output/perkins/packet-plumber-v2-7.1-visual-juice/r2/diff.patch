+
+// sla_row_visible — a class has a gauge row when it has seen traffic. ONE
+// predicate — draw_sla_gauges and sla_focus_click both iterate with it (the
+// hit-test must hit what the draw drew — a divergent copy misclicks).
+sla_row_visible :: proc(f: ^pp.Flow_State, cat: ^pp.Catalogs, c: int) -> bool {
+	if c >= len(cat.packet_types) {
+		return false
+	}
+	acc := &f.sla[c]
+	return !(acc.demand_seen == 0 && acc.delivered == 0 && acc.dropped == 0)
