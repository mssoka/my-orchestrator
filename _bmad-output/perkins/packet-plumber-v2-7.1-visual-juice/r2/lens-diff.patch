diff --git a/tools/gen_sprites.py b/tools/gen_sprites.py
new file mode 100644
index 0000000..f164a01
--- /dev/null
+++ b/tools/gen_sprites.py
@@ -0,0 +1,283 @@
+"""gen_sprites.py — Packet Plumber building sprite generator (Blender 5.2).
+
+The 7.1 canon (user verdicts, lavish gate 2026-08-17): TRUE TOP-DOWN buildings
+(the Mini Motorways view — a steep tilt where the ROOF carries the read),
+flat solid colors (no gradients/bevels/bloom), our own designs, rendered to
+game sprites the renderer draws as textures. Contact shadows are NOT baked —
+Blender's hashed alpha dithers at sprite size; the game draws a flat
+translucent ink ellipse under each building instead (app/render/sprites.odin).
+
+Usage (needs no display):
+  blender -b -P tools/gen_sprites.py            # -> assets/sprites/*.png + sprites.json
+or via the Blender MCP addon:  exec(open("tools/gen_sprites.py").read())
+
+Output: assets/sprites/{house_0..3, host, dc, puck_1..3}.png + sprites.json
+(the per-sprite content bounding boxes — the renderer trims the transparent
+padding by these, so regenerated sprites carry their own geometry).
+
+Palette: the look-book §2 hexes, converted sRGB->linear so the rendered pixels
+land ON the canon hex (raw assignment lightens — Blender color sockets are
+linear). Flat emissive materials (no lights), Standard color management.
+"""
+
+import bpy
+import bmesh
+import math
+import os
+import json
+from math import radians
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+OUT = os.path.join(ROOT, "assets", "sprites")
+os.makedirs(OUT, exist_ok=True)
+RES = 256  # sprite canvas px (rendered ~4x the in-game size; downscales clean)
+
+# --- the look-book §2 canon hexes -------------------------------------------
+HOUSE_COLORS = [("#E85A4A", "#7A2E26"), ("#F2C94C", "#7A5418"), ("#5ECB6B", "#2C6A34"), ("#4A9BE2", "#26507E")]
+HOST_BODY, HOST_ROOF = "#3E78D0", "#264C8E"
+DC_BODY, DC_ROOF = "#4E8AA0", "#2E5E70"
+ROUTER_BODY, ROUTER_DARK, ROUTER_LED = "#5E6E80", "#3E4A5C", "#2E8B57"
+CREAM = "#FFF6E6"
+HOST_MARK = "#D8E8FF"
+DC_VENT = "#BFE0EA"
+
+
+def _lin(c):
+    c = c / 255.0
+    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
+
+
+def mat_hex(name, hex_color, shade=1.0):
+    """Flat emissive material on the canon hex (shade<1 paints the darker
+    wall/tone — emissive ignores light, so shading is painted, not lit)."""
+    h = hex_color.lstrip("#")
+    rgba = (_lin(int(h[0:2], 16) * shade), _lin(int(h[2:4], 16) * shade), _lin(int(h[4:6], 16) * shade), 1.0)
+    mat = bpy.data.materials.new(name)
+    mat.use_nodes = True
+    nt = mat.node_tree
+    for n in list(nt.nodes):
+        nt.nodes.remove(n)
+    out = nt.nodes.new("ShaderNodeOutputMaterial")
+    em = nt.nodes.new("ShaderNodeEmission")
+    em.inputs["Color"].default_value = rgba
+    em.inputs["Strength"].default_value = 1.0
+    nt.links.new(em.outputs["Emission"], out.inputs["Surface"])
+    return mat
+
+
+def clear_scene():
+    for o in list(bpy.context.scene.objects):
+        bpy.data.objects.remove(o, do_unlink=True)
+    for coll in (bpy.data.meshes, bpy.data.lights, bpy.data.cameras, bpy.data.materials, bpy.data.curves):
+        for it in list(coll):
+            if it.users == 0:
+                coll.remove(it)
+
+
+def setup():
+    sc = bpy.context.scene
+    clear_scene()
+    sc.render.engine = "BLENDER_EEVEE"
+    sc.render.resolution_x = RES
+    sc.render.resolution_y = RES
+    sc.render.resolution_percentage = 100
+    sc.render.film_transparent = True
+    sc.render.image_settings.file_format = "PNG"
+    sc.render.image_settings.color_mode = "RGBA"
+    sc.view_settings.view_transform = "Standard"
+    sc.view_settings.look = "None"
+    sc.view_settings.exposure = 0.0
+    sc.view_settings.gamma = 1.0
+    # orthographic, the MM top-down tilt: steep (~66 deg) — the roof reads AND
+    # a sliver of the south wall gives the flat extruded base
+    cd = bpy.data.cameras.new("Cam")
+    cd.type = "ORTHO"
+    co = bpy.data.objects.new("Cam", cd)
+    sc.collection.objects.link(co)
+    sc.camera = co
+    return sc, cd, co
+
+
+def aim(co, cd, pad):
+    cd.ortho_scale = 1.9 * pad
+    co.location = (0, -4.5 * pad, 10.0)
+    direction = mathutils.Vector((0, 0.35, 0.10)) - mathutils.Vector(co.location)
+    co.rotation_euler = direction.to_track_quat("-Z", "Y").to_euler()
+
