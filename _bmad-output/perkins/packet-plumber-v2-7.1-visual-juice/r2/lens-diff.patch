+
+def add_cube(name, center, size, mat):
+    bpy.ops.mesh.primitive_cube_add(size=1.0, location=center)
+    o = bpy.context.active_object
+    o.name = name
+    o.scale = size
+    bpy.ops.object.transform_apply(scale=True)
+    o.data.materials.append(mat)
+    return o
+
+
+def add_cyl(name, center, radius, depth, mat, verts=64):
+    bpy.ops.mesh.primitive_cylinder_add(vertices=verts, radius=radius, depth=depth, location=center)
+    o = bpy.context.active_object
+    o.name = name
+    o.data.materials.append(mat)
+    return o
+
+
+def add_sphere(name, center, radius, mat):
+    bpy.ops.mesh.primitive_uv_sphere_add(radius=radius, location=center)
+    o = bpy.context.active_object
+    o.name = name
+    o.data.materials.append(mat)
+    return o
+
+
+def add_gable(name, w, d, h, base_z, roof_hex):
+    """Gable roof with the ridge along Y and a per-face tone split (the +X
+    slope painted 10% darker — the two-tone top-down roof read)."""
+    mesh = bpy.data.meshes.new(name + "_mesh")
+    obj = bpy.data.objects.new(name, mesh)
+    bpy.context.scene.collection.objects.link(obj)
+    bm = bmesh.new()
+    hw, hd = w / 2.0, d / 2.0
+    a = bm.verts.new((-hw, -hd, base_z))
+    b = bm.verts.new((hw, -hd, base_z))
+    c = bm.verts.new((hw, hd, base_z))
+    dd = bm.verts.new((-hw, hd, base_z))
+    r1 = bm.verts.new((0, -hd, base_z + h))
+    r2 = bm.verts.new((0, hd, base_z + h))
+    bm.faces.new([a, b, r1])       # -Y gable end
+    bm.faces.new([c, dd, r2])      # +Y gable end
+    bm.faces.new([a, dd, r2, r1])  # -X slope
+    bm.faces.new([b, c, r2, r1])   # +X slope
+    bm.normal_update()
+    bm.to_mesh(mesh)
+    bm.free()
+    obj.data.materials.append(mat_hex(name + "_roofA", roof_hex))
+    obj.data.materials.append(mat_hex(name + "_roofB", roof_hex, shade=0.90))
+    obj.data.polygons[3].material_index = 1
+    return obj
+
+
+def add_flat_triangle(name, verts, hex_color):
+    mesh = bpy.data.meshes.new(name + "_mesh")
+    obj = bpy.data.objects.new(name, mesh)
+    bpy.context.scene.collection.objects.link(obj)
+    bm = bmesh.new()
+    vs = [bm.verts.new(v) for v in verts]
+    bm.faces.new(vs)
+    bm.normal_update()
+    bm.to_mesh(mesh)
+    bm.free()
+    obj.data.materials.append(mat_hex(name + "_m", hex_color))
+    return obj
+
