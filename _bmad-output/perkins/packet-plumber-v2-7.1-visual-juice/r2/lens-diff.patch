+# --------------------------------------------------------------------------- #
+def content_bbox(path):
+    """Alpha content bbox of a rendered sprite (x, y, w, h in px), TOP-DOWN:
+    Blender's image.pixels is BOTTOM-UP (row 0 = the bottom row) while the
+    game's raylib texture coords are TOP-DOWN — the flip is res - y - h.
+    (Perkins r1 B1: emitting the raw bottom-up y mis-cropped every sprite;
+    the house bodies never rendered.)"""
+    img = bpy.data.images.load(path)
+    w, h = img.size
+    px = list(img.pixels)  # flat RGBA floats, bottom-up
+    minx, miny, maxx, maxy = w, h, -1, -1
+    for y in range(h):
+        row = y * w * 4
+        for x in range(w):
+            if px[row + x * 4 + 3] > 0.0:
+                if x < minx: minx = x
+                if x > maxx: maxx = x
+                if y < miny: miny = y
+                if y > maxy: maxy = y
+    bpy.data.images.remove(img)
+    top_y = h - (miny + (maxy - miny + 1))  # bottom-up -> top-down flip
+    return [minx, top_y, maxx - minx + 1, maxy - miny + 1]
+
+
+def main():
+    names = []
+    for i, (body_c, roof_c) in enumerate(HOUSE_COLORS):
+        build_house(body_c, roof_c, "house_%d" % i)
+        names.append("house_%d" % i)
+    build_host("host"); names.append("host")
+    build_dc("dc"); names.append("dc")
+    for ports in (4, 8, 16):
+        build_puck(ports, "puck_%d" % {4: 1, 8: 2, 16: 3}[ports])
+        names.append("puck_%d" % {4: 1, 8: 2, 16: 3}[ports])
+    boxes = {}
+    for n in names:
+        boxes[n] = content_bbox(os.path.join(OUT, n + ".png"))
+    with open(os.path.join(OUT, "sprites.json"), "w") as f:
+        json.dump({"res": RES, "order": names, "content_bbox": boxes}, f, indent=1)
+    print("sprites.json written — %d sprites" % len(names))
+
+
+main()
