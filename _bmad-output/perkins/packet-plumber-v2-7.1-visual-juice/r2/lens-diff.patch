+import mathutils
+
+
+def shot(sc, name, pad):
+    aim(sc.camera, sc.camera.data, pad)
+    sc.render.filepath = os.path.join(OUT, name + ".png")
+    bpy.ops.render.render(write_still=True)
+    print("sprite", name)
