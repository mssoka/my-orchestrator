+def build_puck(ports, name):
+    sc = setup()[0]
+    scale = {4: 1.0, 8: 1.15, 16: 1.30}.get(ports, 1.0)
+    r = 0.52 * scale
+    add_cyl(name + "_disc", (0, 0, 0.08), r, 0.16, mat_hex(name + "_dark", ROUTER_DARK))
+    add_cyl(name + "_face", (0, 0, 0.17), r * 0.88, 0.04, mat_hex(name + "_face", ROUTER_BODY))
+    add_cyl(name + "_core", (0, 0, 0.195), r * 0.42, 0.03, mat_hex(name + "_corem", ROUTER_DARK))
+    led_m = mat_hex(name + "_led", ROUTER_LED)
+    leds = max(4, min(16, ports))
+    for i in range(leds):
+        a = radians(90 + i * 360.0 / leds)
+        add_sphere(name + "_led", (0.70 * r * math.cos(a), 0.70 * r * math.sin(a), 0.20), 0.075 * r, led_m)
+    if ports >= 16:
+        for i in range(leds):
+            a = radians(90 + 11.25 + i * 360.0 / leds)
+            add_sphere(name + "_led2", (0.90 * r * math.cos(a), 0.90 * r * math.sin(a), 0.11), 0.05 * r, led_m)
+    shot(sc, name, 1.30)
