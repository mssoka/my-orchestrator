diff --git a/harness/palcheck.odin b/harness/palcheck.odin
new file mode 100644
index 0000000..c279860
--- /dev/null
+++ b/harness/palcheck.odin
@@ -0,0 +1,233 @@
+package main
+
+// palcheck.odin — Story 7.1's PALETTE-PRESENCE gate (Perkins r1 W2): a
+// committed, mechanical scan that the §2 look-book palette is OBJECTIVELY
+// present in what ships. The pre-PR scratch pixel-scan was disposable and it
+// MISSED the B1 sprite-crop bug (house bodies absent while roofs rendered) —
+// this gate would have caught it: it scans the BLESSED juice goldens for the
+// exact canon hexes (house bodies AND roofs, the host, the LED green, the
+// play-marking) + renders a zoomed frame to pin the full-alpha lane read +
+// checks the crisis banner's drawn border sits ON the crisis_banner_rect the
+// alerts-as-nav hit-test uses (the single-source rule, mechanically).
+//
+// Everything is exact-color counting over the rlsw readback (normalized:
+// flip + the R/B swizzle) — no vision, no tolerance except the marking (the
+// sprite blit bilinear-resamples it).
+//
+// Usage: harness palcheck   (exit 0 = green, 1 = a check failed, 2 = setup)
+
+import "core:fmt"
+import "core:os"
+import "core:strings"
+import rl "vendor:raylib"
+import pp "../core"
+import rnd "../app/render"
+
+// the canon §2 hexes (the objective oracle)
+HOUSE_BODIES := [4]rl.Color{{232, 90, 74, 255}, {242, 201, 76, 255}, {94, 203, 107, 255}, {74, 155, 226, 255}}
+HOUSE_ROOFS := [4]rl.Color{{122, 46, 38, 255}, {122, 84, 24, 255}, {44, 106, 52, 255}, {38, 80, 126, 255}}
+HOST_BODY := rl.Color{62, 120, 208, 255}
+HOST_ROOF := rl.Color{38, 76, 142, 255}
+LED_GREEN := rl.Color{46, 139, 87, 255}
+LANE_AMBER := rl.Color{224, 138, 46, 255}
+STATE_CRITICAL := rl.Color{232, 69, 69, 255}
+
+fails := 0
+
+check :: proc(ok: bool, name: string, n: int) {
+	if ok {
+		fmt.printfln("  PASS %-34s (%d px)", name, n)
+	} else {
+		fmt.printfln("  FAIL %-34s (%d px)", name, n)
+		fails += 1
+	}
+}
+
+// count_exact — exact-color pixels in an rl.Image (normalized: the caller
+// flips + swizzles before passing).
+count_exact :: proc(img: rl.Image, col: rl.Color) -> int {
+	px := rl.LoadImageColors(img)
+	defer rl.UnloadImageColors(px)
+	n := 0
+	for i in 0..<int(img.width) * int(img.height) {
+		c := px[i]
+		if c.r == col.r && c.g == col.g && c.b == col.b && c.a == col.a {
+			n += 1
+		}
+	}
+	return n
+}
+
+// count_near — tolerance match (the play-marking survives bilinear only
+// approximately).
+count_near :: proc(img: rl.Image, col: rl.Color, tol: i32) -> int {
+	px := rl.LoadImageColors(img)
+	defer rl.UnloadImageColors(px)
+	n := 0
+	for i in 0..<int(img.width) * int(img.height) {
+		c := px[i]
+		if abs(i32(c.r) - i32(col.r)) <= tol && abs(i32(c.g) - i32(col.g)) <= tol && abs(i32(c.b) - i32(col.b)) <= tol {
+			n += 1
+		}
+	}
+	return n
+}
+
+// normalize — vertical flip + the BGRA->RGBA swizzle, REBUILT around the
+// swapped pixel copy (a plain LoadImageColors copy swap does NOT touch the
+// image's own buffer — the harness's swizzle_rb pattern).
+normalize :: proc(img: ^rl.Image) {
+	rl.ImageFlipVertical(img)
+	px := rl.LoadImageColors(img^)
+	n := int(img.width) * int(img.height)
+	for i in 0..<n {
+		px[i].r, px[i].b = px[i].b, px[i].r
+	}
+	new_img: rl.Image
+	new_img.data = raw_data(px)
+	new_img.width = img.width
+	new_img.height = img.height
+	new_img.mipmaps = 1
+	new_img.format = .UNCOMPRESSED_R8G8B8A8
+	rl.UnloadImage(img^)
+	img^ = new_img
+}
+
+// load_frame — load a blessed golden PNG AS-IS: the harness exports NORMALIZED
+// (flipped + swizzled) images, so the files are true RGBA top-down — applying
+// the framebuffer normalize again would corrupt them (r1 self-review catch).
+load_frame :: proc(path: string) -> (rl.Image, bool) {
+	img := rl.LoadImage(strings.clone_to_cstring(path, context.temp_allocator))
+	if img.width <= 0 {
+		return {}, false
+	}
+	return img, true
+}
+
+run_palcheck :: proc(cat: ^pp.Catalogs) -> int {
+	rl.SetTraceLogLevel(.ERROR)
+	rl.InitWindow(1280, 720, "pp-palcheck")
+	defer rl.CloseWindow()
+
+	palette := rnd.palette_load()
+	view: rnd.View
+	view.palette = &palette
+	view.catalogs = cat
+	view.font = rnd.load_hud_font()
+	if !rnd.sprites_load(&view.sprites) {
+		fmt.eprintln("palcheck: sprite sheet failed to load — aborting")
+		return 2
+	}
+	rnd.view_compute(&view, 1280, 720, &cat.balance)
+
+	fmt.println("7.1 palette-presence gate:")
+
+	// --- 1. the blessed juice goldens (what ships — the oracle) ------------
+	calm, ok1 := load_frame("goldens/juice/30000ms.png")
+	surge, ok2 := load_frame("goldens/juice/65000ms.png")
+	if !ok1 || !ok2 {
+		fmt.eprintln("palcheck: cannot load the blessed juice goldens (re-bless first)")
+		return 2
+	}
+	defer rl.UnloadImage(calm)
+	defer rl.UnloadImage(surge)
+
+	// 1a. the canon surfaces the sprite family EMITS (the top-down render shows
+	// the ROOFS + the host roof + the marking + the puck hardware — the steep
+	// camera occludes the wall band, so the wall tones never enter the sprite).
+	// The play-marking check is the B1 canary: the mis-crop cut exactly the
+	// sprite's bottom content, where the marking lives.
+	roof_names := [4]string{"house roof coral", "house roof gold", "house roof sage", "house roof sky"}
+	for i in 0..<4 {
+		check(count_exact(calm, HOUSE_ROOFS[i]) > 100, roof_names[i], count_exact(calm, HOUSE_ROOFS[i]))
+	}
+	// 1b. the host roof + the play-marking (bilinear — tolerance) + LEDs + the
+	// puck's dark hardware tone.
+	check(count_exact(calm, HOST_ROOF) > 200, "host roof", count_exact(calm, HOST_ROOF))
+	check(count_near(calm, rl.Color{216, 232, 255, 255}, 20) > 40, "host play-marking (B1 canary)", count_near(calm, rl.Color{216, 232, 255, 255}, 20))
+	check(count_exact(calm, LED_GREEN) > 10, "puck LEDs", count_exact(calm, LED_GREEN))
+	check(count_near(calm, rl.Color{62, 74, 92, 255}, 12) > 200, "puck hardware tone", count_near(calm, rl.Color{62, 74, 92, 255}, 12))
+
+	// 1c. the banner-rect agreement: the drawn critical-red hairline must sit
+	// ON the crisis_banner_rect the alerts-as-nav hit-test uses (a divergent
+	// rect would fail here — the single-source rule, mechanically pinned).
+	{
+		cr: pp.Crisis_State
+		append(&cr.active, pp.Active_Crisis{}) // one row -> the rect math
+		// the blessed frame's banner y_base: the juice demo runs with the
+		// health meter OFF (health on drains the meter to terminal mid-surge —
+		// see the demo comment); parse the demo's health line so the rect
+		// expectation can never drift from the demo.
+		y_base: i32 = 10
+		dem, derr := os.read_entire_file_from_path("demos/juice.dem", context.temp_allocator)
+		if derr == nil && strings.contains(string(dem), "health on") {
+			y_base = 10 + rnd.HEALTH_CARD_H + 6
+		}
+		rect, rok := rnd.crisis_banner_rect(&view, &cr, y_base)
+		if !rok {
+			check(false, "banner rect resolves", 0)
+		} else {
+			px := rl.LoadImageColors(surge)
+			defer rl.UnloadImageColors(px)
+			on_perim := 0
+			total := 0
+			for i in 0..<int(surge.width) * int(surge.height) {
+				c := px[i]
+				if c.r == STATE_CRITICAL.r && c.g == STATE_CRITICAL.g && c.b == STATE_CRITICAL.b {
+					total += 1
+					x := f32(i % int(surge.width))
+					y := f32(i / int(surge.width))
+					edge := abs(x - rect.x) < 2.5 || abs(x - (rect.x + rect.width)) < 2.5 ||
+						abs(y - rect.y) < 2.5 || abs(y - (rect.y + rect.height)) < 2.5
+					if edge {
+						on_perim += 1
+					}
+				}
+			}
+			check(total > 300 && on_perim > 300, "banner border == crisis_banner_rect", on_perim)
+		}
+		delete(cr.active)
+	}
+
+	// --- 2. the zoomed lane read (the app-layer lane_detail reveal) ---------
+	{
+		state: pp.Run_State
+		pp.run_init(&state, 7, cat.hash, cat.balance.logic_hz)
+		res, _ := pp.node_type_index(cat, "residential")
+		host, _ := pp.node_type_index(cat, "content_host")
+		rtm, _ := pp.node_type_index(cat, "router_mid")
+		pp.topology_spawn_node(&state.topology, res, {4, 15}, cat)
+		pp.topology_spawn_node(&state.topology, rtm, {12, 15}, cat)
+		pp.topology_spawn_node(&state.topology, host, {20, 15}, cat)
+		narrow, _ := pp.pipe_tier_index(cat, "narrow")
+		wide, _ := pp.pipe_tier_index(cat, "wide")
+		re1, _ := pp.topology_apply_edit(&state.topology, pp.Command{kind = pp.Cmd_Draw_Pipe{a = 0, b = 1, tier = narrow}}, cat)
+		pp.topology_apply_edit(&state.topology, pp.Command{kind = pp.Cmd_Draw_Pipe{a = 1, b = 2, tier = wide}}, cat)
+		pp.topology_apply_edit(&state.topology, pp.Command{kind = pp.Cmd_Set_Weights{pipe = re1.id, weights = {4, 2, 1}}}, cat)
+		for t in u64(1)..=120 {
+			pp.step(&state, t, {}, cat)
+			clear(&state.events)
+		}
+		// zoom into the narrow pipe (lane_detail on — the full lane read)
+		view.scale *= 2.6
+		view.off_x = f32(view.win_w) / 2 - f32(8) * view.tile_px * view.scale
+		view.off_y = f32(view.win_h) / 2 - f32(15) * view.tile_px * view.scale
+		view.lane_detail = true
+		rl.BeginDrawing()
+		rnd.draw_world(&view, &state.topology, &state.bundles, &state.flow, &state.crisis, 120, {}, -1)
+		rl.EndDrawing()
+		img := rl.LoadImageFromScreen()
+		normalize(&img)
+		n := count_exact(img, LANE_AMBER)
+		rl.UnloadImage(img)
+		check(n > 1000, "zoomed lane stripes (full alpha)", n)
+		pp.run_destroy(&state)
+	}
+
+	if fails > 0 {
+		fmt.printfln("palcheck: %d check(s) FAILED", fails)
+		return 1
+	}
+	fmt.println("palcheck: all green")
+	return 0
+}
