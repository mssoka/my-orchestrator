diff --git a/tools/gen_sprites.py b/tools/gen_sprites.py
new file mode 100644
index 0000000..f164a01
--- /dev/null
+++ b/tools/gen_sprites.py
@@ -0,0 +1,283 @@
+"""gen_sprites.py — Packet Plumber building sprite generator (Blender 5.2).
+
+The 7.1 canon (user verdicts, lavish gate 2026-08-17): TRUE TOP-DOWN buildings
+(the Mini Motorways view — a steep tilt where the ROOF carries the read),
+flat solid colors (no gradients/bevels/bloom), our own designs, rendered to
+game sprites the renderer draws as textures. Contact shadows are NOT baked —
+Blender's hashed alpha dithers at sprite size; the game draws a flat
+translucent ink ellipse under each building instead (app/render/sprites.odin).
+
+Usage (needs no display):
+  blender -b -P tools/gen_sprites.py            # -> assets/sprites/*.png + sprites.json
+or via the Blender MCP addon:  exec(open("tools/gen_sprites.py").read())
+
+Output: assets/sprites/{house_0..3, host, dc, puck_1..3}.png + sprites.json
+(the per-sprite content bounding boxes — the renderer trims the transparent
+padding by these, so regenerated sprites carry their own geometry).
+
+Palette: the look-book §2 hexes, converted sRGB->linear so the rendered pixels
+land ON the canon hex (raw assignment lightens — Blender color sockets are
+linear). Flat emissive materials (no lights), Standard color management.
+"""
+
+import bpy
+import bmesh
+import math
+import os
+import json
+from math import radians
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+OUT = os.path.join(ROOT, "assets", "sprites")
+os.makedirs(OUT, exist_ok=True)
+RES = 256  # sprite canvas px (rendered ~4x the in-game size; downscales clean)
+
+# --- the look-book §2 canon hexes -------------------------------------------
+HOUSE_COLORS = [("#E85A4A", "#7A2E26"), ("#F2C94C", "#7A5418"), ("#5ECB6B", "#2C6A34"), ("#4A9BE2", "#26507E")]
+HOST_BODY, HOST_ROOF = "#3E78D0", "#264C8E"
+DC_BODY, DC_ROOF = "#4E8AA0", "#2E5E70"
+ROUTER_BODY, ROUTER_DARK, ROUTER_LED = "#5E6E80", "#3E4A5C", "#2E8B57"
+CREAM = "#FFF6E6"
+HOST_MARK = "#D8E8FF"
+DC_VENT = "#BFE0EA"
+
+
+def _lin(c):
+    c = c / 255.0
+    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
+
+
+def mat_hex(name, hex_color, shade=1.0):
+    """Flat emissive material on the canon hex (shade<1 paints the darker
+    wall/tone — emissive ignores light, so shading is painted, not lit)."""
+    h = hex_color.lstrip("#")
+    rgba = (_lin(int(h[0:2], 16) * shade), _lin(int(h[2:4], 16) * shade), _lin(int(h[4:6], 16) * shade), 1.0)
+    mat = bpy.data.materials.new(name)
+    mat.use_nodes = True
+    nt = mat.node_tree
+    for n in list(nt.nodes):
+        nt.nodes.remove(n)
+    out = nt.nodes.new("ShaderNodeOutputMaterial")
+    em = nt.nodes.new("ShaderNodeEmission")
+    em.inputs["Color"].default_value = rgba
+    em.inputs["Strength"].default_value = 1.0
+    nt.links.new(em.outputs["Emission"], out.inputs["Surface"])
+    return mat
+
+
+def clear_scene():
+    for o in list(bpy.context.scene.objects):
+        bpy.data.objects.remove(o, do_unlink=True)
+    for coll in (bpy.data.meshes, bpy.data.lights, bpy.data.cameras, bpy.data.materials, bpy.data.curves):
+        for it in list(coll):
+            if it.users == 0:
+                coll.remove(it)
+
+
+def setup():
+    sc = bpy.context.scene
+    clear_scene()
+    sc.render.engine = "BLENDER_EEVEE"
+    sc.render.resolution_x = RES
+    sc.render.resolution_y = RES
+    sc.render.resolution_percentage = 100
+    sc.render.film_transparent = True
+    sc.render.image_settings.file_format = "PNG"
+    sc.render.image_settings.color_mode = "RGBA"
+    sc.view_settings.view_transform = "Standard"
+    sc.view_settings.look = "None"
+    sc.view_settings.exposure = 0.0
+    sc.view_settings.gamma = 1.0
+    # orthographic, the MM top-down tilt: steep (~66 deg) — the roof reads AND
+    # a sliver of the south wall gives the flat extruded base
+    cd = bpy.data.cameras.new("Cam")
+    cd.type = "ORTHO"
+    co = bpy.data.objects.new("Cam", cd)
+    sc.collection.objects.link(co)
+    sc.camera = co
+    return sc, cd, co
+
+
+def aim(co, cd, pad):
+    cd.ortho_scale = 1.9 * pad
+    co.location = (0, -4.5 * pad, 10.0)
+    direction = mathutils.Vector((0, 0.35, 0.10)) - mathutils.Vector(co.location)
+    co.rotation_euler = direction.to_track_quat("-Z", "Y").to_euler()
+
+
+import mathutils
+
+
+def shot(sc, name, pad):
+    aim(sc.camera, sc.camera.data, pad)
+    sc.render.filepath = os.path.join(OUT, name + ".png")
+    bpy.ops.render.render(write_still=True)
+    print("sprite", name)
+
+
+def add_cube(name, center, size, mat):
+    bpy.ops.mesh.primitive_cube_add(size=1.0, location=center)
+    o = bpy.context.active_object
+    o.name = name
+    o.scale = size
+    bpy.ops.object.transform_apply(scale=True)
+    o.data.materials.append(mat)
+    return o
+
+
+def add_cyl(name, center, radius, depth, mat, verts=64):
+    bpy.ops.mesh.primitive_cylinder_add(vertices=verts, radius=radius, depth=depth, location=center)
+    o = bpy.context.active_object
+    o.name = name
+    o.data.materials.append(mat)
+    return o
+
+
+def add_sphere(name, center, radius, mat):
+    bpy.ops.mesh.primitive_uv_sphere_add(radius=radius, location=center)
+    o = bpy.context.active_object
+    o.name = name
+    o.data.materials.append(mat)
+    return o
+
+
+def add_gable(name, w, d, h, base_z, roof_hex):
+    """Gable roof with the ridge along Y and a per-face tone split (the +X
+    slope painted 10% darker — the two-tone top-down roof read)."""
+    mesh = bpy.data.meshes.new(name + "_mesh")
+    obj = bpy.data.objects.new(name, mesh)
+    bpy.context.scene.collection.objects.link(obj)
+    bm = bmesh.new()
+    hw, hd = w / 2.0, d / 2.0
+    a = bm.verts.new((-hw, -hd, base_z))
+    b = bm.verts.new((hw, -hd, base_z))
+    c = bm.verts.new((hw, hd, base_z))
+    dd = bm.verts.new((-hw, hd, base_z))
+    r1 = bm.verts.new((0, -hd, base_z + h))
+    r2 = bm.verts.new((0, hd, base_z + h))
+    bm.faces.new([a, b, r1])       # -Y gable end
+    bm.faces.new([c, dd, r2])      # +Y gable end
+    bm.faces.new([a, dd, r2, r1])  # -X slope
+    bm.faces.new([b, c, r2, r1])   # +X slope
+    bm.normal_update()
+    bm.to_mesh(mesh)
+    bm.free()
+    obj.data.materials.append(mat_hex(name + "_roofA", roof_hex))
+    obj.data.materials.append(mat_hex(name + "_roofB", roof_hex, shade=0.90))
+    obj.data.polygons[3].material_index = 1
+    return obj
+
+
+def add_flat_triangle(name, verts, hex_color):
+    mesh = bpy.data.meshes.new(name + "_mesh")
+    obj = bpy.data.objects.new(name, mesh)
+    bpy.context.scene.collection.objects.link(obj)
+    bm = bmesh.new()
+    vs = [bm.verts.new(v) for v in verts]
+    bm.faces.new(vs)
+    bm.normal_update()
+    bm.to_mesh(mesh)
+    bm.free()
+    obj.data.materials.append(mat_hex(name + "_m", hex_color))
+    return obj
+
+
+# --------------------------------------------------------------------------- #
+# the building designs (7.1 canon — the lavish-approved top-down family)
+# --------------------------------------------------------------------------- #
+def build_house(body_hex, roof_hex, name):
+    sc = setup()[0]
+    bw, bd = 0.62, 0.56
+    add_cube(name + "_walls", (0, 0, 0.08), (bw, bd, 0.16), mat_hex(name + "_body", body_hex, shade=0.62))
+    add_gable(name + "_roof", bw * 1.14, bd * 1.14, 0.24, 0.16, roof_hex)
+    add_cube(name + "_chim", (0.17, 0.16, 0.30), (0.11, 0.11, 0.18), mat_hex(name + "_chim", roof_hex, shade=0.85))
+    shot(sc, name, 1.12)
+
+
+def build_host(name):
+    sc = setup()[0]
+    bw, bd = 1.14, 0.88
+    add_cube(name + "_walls", (0, 0, 0.08), (bw, bd, 0.16), mat_hex(name + "_body", HOST_BODY, shade=0.62))
+    add_cube(name + "_roof", (0, 0, 0.19), (bw * 1.08, bd * 1.08, 0.07), mat_hex(name + "_roof", HOST_ROOF))
+    # the play-button roof marking (the destination roof sign)
+    add_flat_triangle(name + "_play", [(-0.20, -0.26, 0.228), (-0.20, 0.02, 0.228), (0.14, -0.12, 0.228)], HOST_MARK)
+    add_cube(name + "_vent", (0.34, 0.26, 0.26), (0.16, 0.14, 0.08), mat_hex(name + "_vent", HOST_ROOF, shade=1.25))
+    add_cyl(name + "_mast", (0.34, -0.26, 0.34), 0.018, 0.30, mat_hex(name + "_mastm", HOST_ROOF, shade=1.25), verts=12)
+    add_sphere(name + "_tip", (0.34, -0.26, 0.50), 0.035, mat_hex(name + "_tip", HOST_MARK))
+    shot(sc, name, 1.35)
+
+
+def build_dc(name):
+    sc = setup()[0]
+    bw, bd = 1.55, 1.00
+    add_cube(name + "_walls", (0, 0, 0.05), (bw, bd, 0.10), mat_hex(name + "_body", DC_BODY, shade=0.62))
+    add_cube(name + "_roof", (0, 0, 0.13), (bw * 1.06, bd * 1.06, 0.06), mat_hex(name + "_roof", DC_ROOF))
+    cu_m = mat_hex(name + "_cu", DC_ROOF, shade=1.25)
+    for gx in (-0.45, 0.0, 0.45):
+        for gy in (-0.20, 0.20):
+            add_cube(name + "_cu", (gx, gy, 0.19), (0.22, 0.18, 0.06), cu_m)
+    shot(sc, name, 1.55)
+
+
+def build_puck(ports, name):
+    sc = setup()[0]
+    scale = {4: 1.0, 8: 1.15, 16: 1.30}.get(ports, 1.0)
+    r = 0.52 * scale
+    add_cyl(name + "_disc", (0, 0, 0.08), r, 0.16, mat_hex(name + "_dark", ROUTER_DARK))
+    add_cyl(name + "_face", (0, 0, 0.17), r * 0.88, 0.04, mat_hex(name + "_face", ROUTER_BODY))
+    add_cyl(name + "_core", (0, 0, 0.195), r * 0.42, 0.03, mat_hex(name + "_corem", ROUTER_DARK))
+    led_m = mat_hex(name + "_led", ROUTER_LED)
+    leds = max(4, min(16, ports))
+    for i in range(leds):
+        a = radians(90 + i * 360.0 / leds)
+        add_sphere(name + "_led", (0.70 * r * math.cos(a), 0.70 * r * math.sin(a), 0.20), 0.075 * r, led_m)
+    if ports >= 16:
+        for i in range(leds):
+            a = radians(90 + 11.25 + i * 360.0 / leds)
+            add_sphere(name + "_led2", (0.90 * r * math.cos(a), 0.90 * r * math.sin(a), 0.11), 0.05 * r, led_m)
+    shot(sc, name, 1.30)
+
+
+# --------------------------------------------------------------------------- #
+def content_bbox(path):
+    """Alpha content bbox of a rendered sprite (x, y, w, h in px), TOP-DOWN:
+    Blender's image.pixels is BOTTOM-UP (row 0 = the bottom row) while the
+    game's raylib texture coords are TOP-DOWN — the flip is res - y - h.
+    (Perkins r1 B1: emitting the raw bottom-up y mis-cropped every sprite;
+    the house bodies never rendered.)"""
+    img = bpy.data.images.load(path)
+    w, h = img.size
+    px = list(img.pixels)  # flat RGBA floats, bottom-up
+    minx, miny, maxx, maxy = w, h, -1, -1
+    for y in range(h):
+        row = y * w * 4
+        for x in range(w):
+            if px[row + x * 4 + 3] > 0.0:
+                if x < minx: minx = x
+                if x > maxx: maxx = x
+                if y < miny: miny = y
+                if y > maxy: maxy = y
+    bpy.data.images.remove(img)
+    top_y = h - (miny + (maxy - miny + 1))  # bottom-up -> top-down flip
+    return [minx, top_y, maxx - minx + 1, maxy - miny + 1]
+
+
+def main():
+    names = []
+    for i, (body_c, roof_c) in enumerate(HOUSE_COLORS):
+        build_house(body_c, roof_c, "house_%d" % i)
+        names.append("house_%d" % i)
+    build_host("host"); names.append("host")
+    build_dc("dc"); names.append("dc")
+    for ports in (4, 8, 16):
+        build_puck(ports, "puck_%d" % {4: 1, 8: 2, 16: 3}[ports])
+        names.append("puck_%d" % {4: 1, 8: 2, 16: 3}[ports])
+    boxes = {}
+    for n in names:
+        boxes[n] = content_bbox(os.path.join(OUT, n + ".png"))
+    with open(os.path.join(OUT, "sprites.json"), "w") as f:
+        json.dump({"res": RES, "order": names, "content_bbox": boxes}, f, indent=1)
+    print("sprites.json written — %d sprites" % len(names))
+
+
+main()
