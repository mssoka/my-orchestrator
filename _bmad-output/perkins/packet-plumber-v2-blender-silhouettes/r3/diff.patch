+#!/usr/bin/env python3
+"""test_sprite_order.py — the P0 pipeline pin: the sprite order emitted by
+tools/gen_sprites.py MUST equal the order pinned in app/render/sprites.odin
+(`files[]`), because sprites_load binds texture[i] to files[i] and bbox[i] to
+order[i] POSITIONALLY. A silent drift mis-crops sprites on the next re-render
+and would bless corrupted crops into the T2 goldens (Perkins r1 B1).
+
+Pure-text check (no Blender needed — CI has none): parses `SPRITE_ORDER` out
+of gen_sprites.py (AST) and `files[]` out of sprites.odin (regex), compares.
+
+Wired as lint gate 7 (tools/lint.sh) — the CI-enforced consistency rules.
+"""
+
+import ast
+import re
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+GEN = ROOT / "tools" / "gen_sprites.py"
+ODIN = ROOT / "app" / "render" / "sprites.odin"
+
+
+def script_order() -> list:
+    """SPRITE_ORDER = [...] from gen_sprites.py, via AST (literal list)."""
+    tree = ast.parse(GEN.read_text())
+    for node in tree.body:
+        if isinstance(node, ast.Assign):
+            for t in node.targets:
+                if isinstance(t, ast.Name) and t.id == "SPRITE_ORDER":
+                    return list(ast.literal_eval(node.value))
+    raise SystemExit(f"FAIL: {GEN} has no SPRITE_ORDER literal")
+
+
+def odin_files() -> list:
+    """The files[] string block in sprites.odin."""
+    src = ODIN.read_text()
+    m = re.search(r"files\s*:=\s*\[SPRITE_COUNT\]string\s*\{(.*?)\}", src, re.S)
+    if not m:
+        raise SystemExit(f"FAIL: {ODIN} has no files[] block")
+    return re.findall(r'"([^"]+)"', m.group(1))
+
+
+def main() -> int:
+    so = script_order()
+    of = odin_files()
+    if so == of:
+        print(f"sprite order pin OK — {len(so)} names, gen_sprites.py == sprites.odin files[]")
+        return 0
+    print("FAIL: sprite order drift (Perkins r1 B1 — positional texture/bbox binding)")
+    print(f"  gen_sprites.py SPRITE_ORDER: {so}")
+    print(f"  sprites.odin files[]:        {of}")
+    return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
