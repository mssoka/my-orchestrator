+            '[data-testid="documents-section-error"]'
+          ) ||
+          sections[i].el.querySelector(
+            '.field-error[data-preflight-error="true"]'
+          );
+        if (messageEl && messageEl.scrollIntoView) {
+          messageEl.scrollIntoView({ block: "center" });
+        }
+        return;
+      }
