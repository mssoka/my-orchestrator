+// -- Optional address cluster (F4) ---------------------------------------------
+
+/// The current-address quartet is optional but feeds the scorer
+/// (`eircode` → location checks), so it stays on the form — collapsed behind
+/// a native `<details>` (F4 field diet) to take four controls off the first
+/// render. Works without JS; renders `open` when a re-render carries values
+/// so the applicant always sees their own input.
+fn view_address_cluster(values: List(#(String, String))) -> element.Element(a) {
+  let prefilled =
+    list.any(
+      ["current_address", "current_city", "current_county", "eircode"],
+      fn(key) { common.get_val(values, key) != "" },
+    )
+  let open_attrs = case prefilled {
+    True -> [attribute("open", "")]
+    False -> []
+  }
+  element.element(
+    "details",
+    [
+      attribute.class("optional-cluster"),
+      attribute("data-testid", "address-cluster"),
+      ..open_attrs
+    ],
+    [
+      element.element("summary", [], [
+        html.text(copy.address_cluster_summary()),
+      ]),
+      form_fields.view_text_field(
+        name: "current_address",
+        label: "Current address",
+        input_type: "text",
+        required: False,
+        min_val: "",
+        value: common.get_val(values, "current_address"),
+        error: "",
+      ),
+      html.div([attribute.class("field-row")], [
+        form_fields.view_text_field(
+          name: "current_city",
+          label: "City",
+          input_type: "text",
+          required: False,
+          min_val: "",
+          value: common.get_val(values, "current_city"),
