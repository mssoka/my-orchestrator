+// -- F1 stepper: progressive enhancement contract -------------------------------
+
+pub fn form_sections_render_in_funnel_dom_order_test() {
+  // The stepper and the analytics funnel both walk [data-section-id] in DOM
+  // order — "Step N of 8" and section_index must agree. Pin the order.
+  let vacancy = test_helpers.test_vacancy_row()
+  let html = form_view.view_application_page(vacancy, "")
+  let ids = [
+    "about_you", "your_situation", "work_income", "references", "guarantor",
+    "tell_us_more", "documents", "review_consent",
+  ]
+  let positions =
+    list.map(ids, fn(id) {
+      let assert Ok(#(before, _)) =
+        string.split_once(html, "data-section-id=\"" <> id <> "\"")
+      string.length(before)
+    })
+  positions
+  |> list.fold(-1, fn(prev, pos) {
+    should.be_true(pos > prev)
+    pos
+  })
+  |> fn(_) { Nil }
+}
+
+pub fn no_js_fallback_all_fieldsets_render_without_hidden_test() {
+  // The no-JS fallback IS the long form: every section fieldset must render
+  // visible (the stepper hides them client-side only). A hidden attribute
+  // sneaking into a fieldset's SSR would strand no-JS applicants. Inner
+  // conditional divs legitimately carry hidden, so we only inspect each
+  // fieldset's own tag — everything up to its closing ">".
+  let vacancy = test_helpers.test_vacancy_row()
+  let html = form_view.view_application_page(vacancy, "")
+  let chunks = string.split(html, "<fieldset") |> list.drop(1)
+  list.length(chunks) |> should.equal(8)
+  list.each(chunks, fn(chunk) {
+    let tag = case string.split_once(chunk, ">") {
+      Ok(#(head, _)) -> head
+      Error(_) -> chunk
+    }
+    tag
+    |> string.contains("hidden")
+    |> should.be_false
+  })
+}
