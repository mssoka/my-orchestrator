+// Unit tests for server/priv/static/form_stepper.js — run with
+// `node --test scripts/js-tests/` (wired into `make test` as test-js).
+//
+// Covers the F1 acceptance surface: the step model (bounds, jumps), the
+// Continue-gating rules (visible-required only — radio groups, checkboxes,
+// file inputs, hidden conditionals, disabled controls), and the error
+// re-render start-step rule. The DOM-free internals are required directly;
+// browser wiring (progress chrome, nav injection, anchor routing) is
+// covered by the bug-hunt/manual E2E pass.
+
+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+
+const stepper = require("../../server/priv/static/form_stepper.js");
+
+// ---------- Minimal DOM (mirrors apply_analytics.test.js) ----------
+
+let idSeq = 0;
+function el(tag, attrs = {}, children = []) {
+  const node = {
+    _id: ++idSeq,
+    tag,
+    children: [],
+    parentElement: null,
+    hidden: false,
+    disabled: false,
+    ...attrs,
+  };
+  children.forEach((c) => {
+    c.parentElement = node;
+    node.children.push(c);
+  });
+  node.querySelectorAll = (selector) => {
+    const out = [];
+    const walk = (n) => {
+      n.children.forEach((c) => {
+        if (matches(c, selector)) out.push(c);
+        walk(c);
+      });
+    };
+    walk(node);
+    return out;
+  };
+  node.querySelector = (selector) => node.querySelectorAll(selector)[0] || null;
+  node.contains = (target) => {
+    let n = target;
+    while (n) {
+      if (n === node) return true;
+      n = n.parentElement;
+    }
+    return false;
+  };
+  return node;
+}
+
+function matches(node, selector) {
+  if (selector === "[required]") return !!node.required;
+  if (selector === ".has-error") {
+    return (node.className || "").split(" ").indexOf("has-error") !== -1;
+  }
+  if (selector === ".field-error") {
+    return (node.className || "").split(" ").indexOf("field-error") !== -1;
+  }
+  let m = selector.match(/^input\[type="radio"\]\[name="(.*)"\]$/);
+  if (m)
+    return node.tag === "input" && node.type === "radio" && node.name === m[1];
+  m = selector.match(/^\[data-testid="(.*)"\]$/);
+  if (m) return node.testid === m[1];
+  return false;
+}
+
+// Fake document for resolveFieldElement / firstErrorIndex(opts.doc).
+function fakeDoc(roots) {
+  const walkAll = (pred) => {
+    const out = [];
+    const walk = (n) => {
+      if (pred(n)) out.push(n);
+      n.children.forEach(walk);
+    };
+    roots.forEach(walk);
+    return out;
+  };
+  return {
+    getElementById: (id) => walkAll((n) => n.id === id)[0] || null,
+    querySelector: (sel) => walkAll((n) => matches(n, sel))[0] || null,
+  };
+}
+
+function section(children) {
+  return el("fieldset", {}, children);
+}
+
+function textInput(value, extra = {}) {
+  return el("input", { type: "text", value, required: true, ...extra });
+}
+
+// ---------- Step model ----------
+
+test("step model starts at the given step and clamps navigation at bounds", () => {
+  const m = stepper.createStepModel({ count: 8, start: 0 });
+  assert.equal(m.current(), 0);
+  assert.equal(m.canBack(), false);
+  assert.equal(m.canNext(), true);
+  m.back(); // clamped at 0
+  assert.equal(m.current(), 0);
+  for (let i = 0; i < 20; i++) m.next();
+  assert.equal(m.current(), 7, "next clamps at the last step");
+  assert.equal(m.canNext(), false);
+  assert.equal(m.canBack(), true);
+  m.back();
+  assert.equal(m.current(), 6);
+});
+
+test("step model jump clamps out-of-range indices", () => {
+  const m = stepper.createStepModel({ count: 8, start: 2 });
+  assert.equal(m.jump(99), 7);
+  assert.equal(m.jump(-4), 0);
+  assert.equal(m.jump(5), 5);
+});
+
+test("step model honours a non-zero start (error re-render)", () => {
+  const m = stepper.createStepModel({ count: 8, start: 4 });
+  assert.equal(m.current(), 4);
+});
+
+// ---------- Gating: basic satisfaction ----------
+
+test("no invalid controls when every visible required control is filled", () => {
+  const s = section([textInput("Jane"), textInput("Doe")]);
+  assert.deepEqual(stepper.findInvalidControls(s), []);
+});
+
+test("empty visible required control blocks and is returned in order", () => {
+  const a = textInput("Jane");
+  const b = textInput("");
+  const c = textInput("");
+  const s = section([a, b, c]);
+  const invalid = stepper.findInvalidControls(s);
+  assert.deepEqual(invalid, [b, c]);
+});
+
+test("whitespace-only values block advance", () => {
+  const s = section([textInput("   ")]);
+  assert.equal(stepper.findInvalidControls(s).length, 1);
+});
+
+test("optional (non-required) empty controls never block", () => {
+  const optional = el("input", { type: "text", value: "" });
+  const s = section([textInput("Jane"), optional]);
+  assert.deepEqual(stepper.findInvalidControls(s), []);
+});
+
+// ---------- Gating: visibility rules ----------
+
+test("required controls inside a hidden conditional wrapper are skipped", () => {
+  const hiddenWrap = el("div", { hidden: true }, [textInput("")]);
+  const s = section([textInput("Jane"), hiddenWrap]);
+  assert.deepEqual(stepper.findInvalidControls(s), []);
+});
+
+test("disabled required controls are skipped", () => {
+  const s = section([textInput("", { disabled: true })]);
+  assert.deepEqual(stepper.findInvalidControls(s), []);
+});
+
+test("a required control in a visible wrapper still blocks", () => {
+  const visibleWrap = el("div", { hidden: false }, [textInput("")]);
+  const s = section([visibleWrap]);
+  assert.equal(stepper.findInvalidControls(s).length, 1);
+});
+
+// ---------- Gating: control kinds ----------
+
+test("radio group blocks until any visible member is checked", () => {
+  const group = el("div", { className: "radio-options" }, [
+    el("input", { type: "radio", name: "has_pets", value: "no", required: true }),
+    el("input", { type: "radio", name: "has_pets", value: "yes", required: true }),
+  ]);
+  const s = section([group]);
+  const invalid = stepper.findInvalidControls(s);
+  assert.equal(invalid.length, 1, "unsatisfied group yields ONE representative");
+  assert.equal(invalid[0].name, "has_pets");
+});
+
+test("radio group is satisfied by any checked visible member", () => {
+  const group = el("div", {}, [
+    el("input", { type: "radio", name: "has_pets", value: "no", required: true }),
+    el("input", {
+      type: "radio",
+      name: "has_pets",
+      value: "yes",
+      required: true,
+      checked: true,
+    }),
+  ]);
+  const s = section([group]);
+  assert.deepEqual(stepper.findInvalidControls(s), []);
+});
+
+test("a checked but hidden radio does not satisfy the group", () => {
+  const hiddenWrap = el("div", { hidden: true }, [
+    el("input", {
+      type: "radio",
+      name: "has_pets",
+      value: "yes",
+      required: true,
+      checked: true,
+    }),
+  ]);
+  const visible = el("input", {
+    type: "radio",
+    name: "has_pets",
+    value: "no",
+    required: true,
+  });
+  const s = section([hiddenWrap, visible]);
+  assert.equal(stepper.findInvalidControls(s).length, 1);
+});
+
+test("required checkbox blocks until ticked", () => {
+  const box = el("input", { type: "checkbox", required: true, checked: false });
+  const s = section([box]);
+  assert.equal(stepper.findInvalidControls(s).length, 1);
+  box.checked = true;
+  assert.deepEqual(stepper.findInvalidControls(s), []);
+});
+
+test("required file input blocks until a file is staged", () => {
+  const file = el("input", { type: "file", required: true, files: [] });
+  const s = section([file]);
+  assert.equal(stepper.findInvalidControls(s).length, 1);
+  file.files = [{ name: "payslip.pdf" }];
+  assert.deepEqual(stepper.findInvalidControls(s), []);
+});
+
+test("required select with the placeholder option selected blocks", () => {
+  const select = el("select", { value: "", required: true });
+  const s = section([select]);
+  assert.equal(stepper.findInvalidControls(s).length, 1);
+  select.value = "employed";
+  assert.deepEqual(stepper.findInvalidControls(s), []);
+});
+
+// ---------- Error re-render start step ----------
+
+test("firstErrorIndex finds the first section carrying a server error", () => {
+  const clean = section([textInput("")]);
+  const withError = section([
+    el("div", { className: "form-field has-error" }, [textInput("")]),
+  ]);
+  assert.equal(stepper.firstErrorIndex([clean, withError, clean]), 1);
+  assert.equal(
+    stepper.firstErrorIndex([clean, clean]),
+    0,
+    "no server errors → start at step 1",
+  );
+});
+
+test("firstErrorIndex prefers the server's data-first-error-field resolution", () => {
+  // Upload-slot errors never carry .has-error (container class is static),
+  // so only the server-driven key lands on the right section.
+  const upload = el("input", {
+    type: "file",
+    id: "field-landlord_ref_primary",
+  });
+  const aboutYou = section([textInput("Jane")]);
+  const documents = section([el("div", { className: "form-field" }, [upload])]);
+  const doc = fakeDoc([aboutYou, documents]);
+  assert.equal(
+    stepper.firstErrorIndex([aboutYou, documents], {
+      firstErrorField: "landlord_ref_primary",
+      doc,
+    }),
+    1,
+  );
+});
+
+test("firstErrorIndex falls back to non-empty .field-error (upload slots)", () => {
+  const noKey = section([textInput("")]);
+  const slotWithMessage = section([
+    el("div", { className: "form-field" }, [
+      el("span", { className: "field-error", textContent: "Required." }),
+    ]),
+  ]);
+  assert.equal(stepper.firstErrorIndex([noKey, slotWithMessage]), 1);
+});
+
+test("resolveFieldElement falls back to the wrapper testid for radio groups", () => {
+  // Radio inputs are field-<name>-<value>; only the wrapper carries
+  // data-testid="field-<name>" — the anchor target for radio errors.
+  const wrapper = el("div", {
+    className: "form-field radio-group",
+    testid: "field-has_pets",
+  });
+  const doc = fakeDoc([section([wrapper])]);
+  assert.equal(stepper.resolveFieldElement(doc, "has_pets"), wrapper);
+  assert.equal(
+    stepper.resolveFieldElement(doc, "missing_field"),
+    null,
+    "unknown keys resolve to null so the browser default can try",
+  );
+});
+
+// ---------- Exported constants ----------
+
+test("step-changed event name and gating copy are stable for the F3 seam", () => {
+  assert.equal(stepper.EVENT_STEP_CHANGED, "rt:form-step-changed");
+  assert.ok(stepper.GATING_MESSAGE.length > 0);
+  assert.ok(stepper.REVIEW_HINT_STEPPER.indexOf("Back") !== -1);
+});
+
+// ---------- Activation gate + event payload ----------
+
+test("shouldActivate enhances only the two form renders", () => {
+  assert.equal(stepper.shouldActivate("form"), true);
+  assert.equal(stepper.shouldActivate("form-errors"), true);
+  // Outcome pages (confirmation/duplicate/spam) and missing markers get no
+  // chrome — the no-JS/no-enhancement guarantee.
+  assert.equal(stepper.shouldActivate("confirmation"), false);
+  assert.equal(stepper.shouldActivate("duplicate"), false);
+  assert.equal(stepper.shouldActivate("spam-confirmation"), false);
+  assert.equal(stepper.shouldActivate(null), false);
+  assert.equal(stepper.shouldActivate(""), false);
+});
+
+test("stepChangeDetail pins the rt:form-step-changed payload shape", () => {
+  assert.deepEqual(stepper.stepChangeDetail(2, "work_income", 8), {
+    step_index: 3,
+    section_id: "work_income",
+    total: 8,
+  });
+});
+
+// ---------- Anchor routing (real error-summary href shapes) ----------
+
+test("resolveAnchorTarget resolves #field-<key> hrefs end to end", () => {
+  const input = el("input", { id: "field-email", name: "email" });
+  const doc = fakeDoc([section([input])]);
+  assert.equal(stepper.resolveAnchorTarget(doc, "#field-email"), input);
+});
+
+test("resolveAnchorTarget percent-decodes co-applicant hrefs", () => {
+  const input = el("input", { id: "field-co_applicant[0][first_name]" });
+  const doc = fakeDoc([section([input])]);
+  assert.equal(
+    stepper.resolveAnchorTarget(doc, "#field-co_applicant%5B0%5D%5Bfirst_name%5D"),
+    input,
+  );
+});
+
+test("resolveAnchorTarget maps the consent key to the compliance-pinned id", () => {
+  const box = el("input", { id: "gdpr-consent", type: "checkbox" });
+  const doc = fakeDoc([section([box])]);
+  assert.equal(stepper.resolveAnchorTarget(doc, "#field-gdpr_consent"), box);
+});
+
+test("resolveAnchorTarget returns null for unknown anchors (browser default)", () => {
+  const doc = fakeDoc([section([textInput("x")])]);
+  assert.equal(stepper.resolveAnchorTarget(doc, "#field-nope"), null);
+  assert.equal(stepper.resolveAnchorTarget(doc, ""), null);
+  assert.equal(stepper.resolveAnchorTarget(doc, null), null);
+});
