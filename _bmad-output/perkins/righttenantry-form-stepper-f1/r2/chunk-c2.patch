+  // Server-rendered upload-slot errors must carry inline display:flex —
+  // .field-error is display:none by default and upload containers never get
+  // .has-error, so without it the routed-to message is invisible (Perkins r1
+  // W2: named regression, previously reverted silently).
+  let vacancy = test_helpers.test_vacancy_row()
+  let html =
+    form_pages.view_form_with_errors(
+      vacancy,
+      [#("landlord_ref_primary", "Upload your landlord reference.")],
+      [],
+      "",
+    )
+  // The upload slot's own error span (id field-<name>-error) is the one
+  // that must be visible — other error surfaces are irrelevant here.
+  let assert Ok(#(_, after)) =
+    string.split_once(html, "id=\"field-landlord_ref_primary-error\"")
+  after
+  |> string.slice(0, 200)
+  |> string.contains("display:flex")
+  |> should.be_true
+}
+
+pub fn document_slots_carry_what_counts_helper_copy_test() {
+  let vacancy = test_helpers.test_vacancy_row()
+  let html = form_view.view_application_page(vacancy, "")
+  // Proof of income (previously no helper at all).
+  html
+  |> string.contains("A recent payslip works best")
+  |> should.be_true
+  // Landlord reference — what counts, and that a phone photo is fine.
+  html
+  |> string.contains(
+    "A signed letter or email from your current or previous landlord",
+  )
+  |> should.be_true
+  // Character reference (first-time renters).
+  html
+  |> string.contains("A coworker, mentor, coach or family friend works")
+  |> should.be_true
+  // Employer reference.
+  html
+  |> string.contains("confirming you work there")
+  |> should.be_true
+  // Supporting documents.
+  html
+  |> string.contains("Photos from your phone are fine")
+  |> should.be_true
+}
