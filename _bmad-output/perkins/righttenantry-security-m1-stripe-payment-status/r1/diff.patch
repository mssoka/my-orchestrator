+// -- checkout_session_form_body (M-1 card-only restriction) -------------------
+
+/// Pins remediation arm 2 of security finding M-1: every checkout session
+/// we create must restrict `payment_method_types` to card so
+/// `checkout.session.completed` ⇒ `payment_status: "paid"`. A future
+/// refactor that drops the restriction silently re-opens the
+/// async-settlement gap the webhook gate defends — this test is the tripwire.
+pub fn checkout_form_body_restricts_payment_methods_to_card_test() {
+  let body =
+    stripe_client.checkout_session_form_body(
+      price_id: "price_abc",
+      success_url: "https://example.com/success",
+      cancel_url: "https://example.com/cancel",
+      vacancy_id: "vac-123",
+      user_id: "user-123",
+      customer_id: "cus_123",
+      sku_label: "vacancy_unlock",
+    )
+  // The card-only restriction must be present, and only once (split on the
+  // key prefix: 2 parts = exactly 1 occurrence).
+  string.contains(body, "payment_method_types%5B0%5D=card")
+  |> should.be_true
+  string.split(body, "payment_method_types%5B")
+  |> list.length
+  |> should.equal(2)
+  // Mode stays one-time payment and the SKU metadata survives the move.
+  string.contains(body, "mode=payment") |> should.be_true
+  string.contains(body, "metadata%5Bsku_type%5D=vacancy_unlock")
+  |> should.be_true
+}
