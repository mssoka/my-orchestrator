+// ============================================================================
+// M-1 GATE — payment_status must be "paid" before any unlock (audit fix-now)
+// ============================================================================
+
+/// A checkout.session.completed event with payment_status="processing"
+/// (async payment method in flight) must NOT unlock the vacancy, must NOT
+/// touch the payment row (stays pending), must NOT fire audit/burst, and
+/// must still ack 200 so Stripe doesn't retry-storm. The event IS claimed
+/// so a replay short-circuits — deterministic.
+fn run_pending_completed_assertions(
+  db: pog.Connection,
+  cfg: config.ServerConfig,
+  event_id: String,
+  session_id: String,
+  vacancy_id: String,
+  payment_status: String,
+) -> Nil {
+  let body =
+    build_event_body_full(
+      event_id,
+      "checkout.session.completed",
+      session_id,
+      vacancy_id,
+      "vacancy_unlock",
+      29_900,
+      payment_status,
+    )
+  let resp = post_webhook(cfg, body, sign_body(body, test_webhook_secret))
+  resp.status |> should.equal(200)
+
+  // Vacancy stays locked.
+  let assert Ok(is_paid) =
+    test_db.query_int(
+      db,
+      "SELECT is_paid::int FROM vacancy WHERE id = '" <> vacancy_id <> "'::uuid",
+    )
+  is_paid |> should.equal(0)
+
+  // Payment row stays in the deterministic waiting state.
+  let assert Ok(row_status) =
+    test_db.query_text(
+      db,
+      "SELECT status::text FROM payment WHERE stripe_session_id = '"
+        <> session_id
+        <> "'",
+    )
+  row_status |> should.equal("pending")
+
+  // Event claimed (idempotency) but nothing else happened.
+  count_processed_event(db, event_id) |> should.equal(1)
+  let assert Ok(audit_count) =
+    test_db.query_int(
+      db,
+      "SELECT count(*)::int FROM audit_log
+       WHERE event_type = 'payment_completed'",
+    )
+  audit_count |> should.equal(0)
+  count_payment_notifications(db, vacancy_id) |> should.equal(0)
+
+  // No burst scoring: an unscored application stays un-analysed.
+  let assert Ok(analysis_count) =
+    test_db.query_int(db, "SELECT count(*)::int FROM ai_analysis aa
+       JOIN application a ON a.id = aa.application_id
+       WHERE a.vacancy_id = '" <> vacancy_id <> "'::uuid")
+  analysis_count |> should.equal(0)
+}
