+/// Build the form-encoded body for `POST /v1/checkout/sessions`. Extracted
+/// from `create_checkout_session` so the M-1 card-only restriction
+/// (`payment_method_types[0]=card`) is pinned by a unit test — a future
+/// refactor that drops the restriction would silently re-open the
+/// async-settlement gap the webhook gate defends.
+///
+/// M-1 rationale (security audit fix-now): without the restriction Stripe
+/// shows every payment method enabled on the account (SEPA direct debit,
+/// Boleto, Klarna), and async methods fire `checkout.session.completed`
+/// with `payment_status: "processing"`/`"unpaid"` — funds settle later or
+/// fail entirely (SEPA chargebacks). Card-only makes `completed` ⇒ `paid`
+/// for every session we create. Apple Pay / Google Pay / Link remain
+/// available (card-based, settle instantly) — only genuine async methods
+/// are excluded.
+@internal
+pub fn checkout_session_form_body(
+  price_id price_id: String,
+  success_url success_url: String,
+  cancel_url cancel_url: String,
+  vacancy_id vacancy_id: String,
+  user_id user_id: String,
+  customer_id customer_id: String,
+  sku_label sku_label: String,
+) -> String {
+  [
+    #("mode", "payment"),
+    #("customer", customer_id),
+    #("invoice_creation[enabled]", "true"),
+    #("line_items[0][price]", price_id),
+    #("line_items[0][quantity]", "1"),
+    #("success_url", success_url),
+    #("cancel_url", cancel_url),
+    #("metadata[vacancy_id]", vacancy_id),
+    #("metadata[sku_type]", sku_label),
+    #("client_reference_id", user_id),
+    #("automatic_tax[enabled]", "true"),
+    #("customer_update[address]", "auto"),
+    #("allow_promotion_codes", "true"),
+    // M-1: card-only restriction — see function doc.
+    #("payment_method_types[0]", "card"),
+    // Refund-policy consent backstop (Article 16(m) defence-in-depth).
+    // Primary consent record lives in `payment_terms_acceptance`; this
+    // is corroborating Stripe-side evidence captured on the
+    // checkout.session.completed webhook as `session.consent.terms_of_service`.
+    //
+    // DASHBOARD DEPENDENCY: the URL the Stripe-rendered Terms-of-Service
+    // checkbox points to is set in the Stripe Dashboard under
+    // Branding → Public details → "Terms of service" (NOT a per-session
+    // API parameter). It must be set to https://righttenantry.ie/terms#refunds
+    // for the live and test accounts. See `deployment/deferred-work.md`
+    // for the deployment-checklist entry.
+    #("consent_collection[terms_of_service]", "required"),
+    #(
+      "custom_text[terms_of_service_acceptance][message]",
+      checkout_consent_message,
+    ),
+  ]
+  |> form_encode
+}
