+/// Fail-closed on a structurally missing payment_status field: Stripe always
+/// sends it on Session events, so an absent field means malformed data — the
+/// gate must refuse to unlock rather than assume paid.
+pub fn checkout_completed_missing_payment_status_keeps_vacancy_locked_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let cfg = webhook_config(db)
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, False)
+  let session_id = "cs_m1_missing_001"
+  let assert Ok(_) = test_db.seed_payment(db, vacancy_id, session_id, "pending")
+
+  let event_id = "evt_m1_missing_001"
+  // Hand-built body with NO payment_status key.
+  let body =
+    json.object([
+      #("id", json.string(event_id)),
+      #("type", json.string("checkout.session.completed")),
+      #(
+        "data",
+        json.object([
+          #(
+            "object",
+            json.object([
+              #("id", json.string(session_id)),
+              #("payment_intent", json.string("pi_test_" <> session_id)),
+              #(
+                "metadata",
+                json.object([#("vacancy_id", json.string(vacancy_id))]),
+              ),
+              #("amount_total", json.int(29_900)),
+            ]),
+          ),
+        ]),
+      ),
+    ])
+    |> json.to_string
+  let resp = post_webhook(cfg, body, sign_body(body, test_webhook_secret))
+  resp.status |> should.equal(200)
+
+  let assert Ok(is_paid) =
+    test_db.query_int(
+      db,
+      "SELECT is_paid::int FROM vacancy WHERE id = '" <> vacancy_id <> "'::uuid",
+    )
+  is_paid |> should.equal(0)
+  let assert Ok(row_status) =
+    test_db.query_text(
+      db,
+      "SELECT status::text FROM payment WHERE stripe_session_id = '"
+        <> session_id
+        <> "'",
+    )
+  row_status |> should.equal("pending")
+  count_processed_event(db, event_id) |> should.equal(1)
+}
+
+/// The full pending-state machine: a `processing` completed event leaves the
+/// vacancy locked and the row pending; the succeed path
+/// (`checkout.session.async_payment_succeeded` — Stripe's session-shaped
+/// settle event for delayed methods, carrying payment_status="paid") then
+/// completes the payment, unlocks the vacancy, audits, notifies, and fires
+/// burst scoring. Replays of the settle event short-circuit.
+pub fn async_payment_succeeded_settles_pending_payment_test() {
+  use <- unitest.tag("integration")
+  let db = setup()
+  let cfg = webhook_config(db)
+  let assert Ok(landlord_id) = test_db.seed_landlord(db, 3)
+  let assert Ok(vacancy_id) = test_db.seed_vacancy(db, landlord_id, False)
+  let assert Ok(_) =
+    test_db.seed_application(db, vacancy_id, "settle@example.com")
+  let session_id = "cs_m1_settle_001"
+  let assert Ok(_) = test_db.seed_payment(db, vacancy_id, session_id, "pending")
+  let pending_event_id = "evt_m1_settle_pending"
+
+  // Phase 1: pending completed event — vacancy stays locked.
+  run_pending_completed_assertions(
+    db,
+    cfg,
+    pending_event_id,
+    session_id,
+    vacancy_id,
+    "processing",
+  )
+
+  // Phase 2: async settle event — funds landed, unlock proceeds.
+  let settle_event_id = "evt_m1_settle_success"
+  let body =
+    build_event_body_full(
+      settle_event_id,
+      "checkout.session.async_payment_succeeded",
+      session_id,
+      vacancy_id,
+      "vacancy_unlock",
+      29_900,
+      "paid",
+    )
+  let resp = post_webhook(cfg, body, sign_body(body, test_webhook_secret))
+  resp.status |> should.equal(200)
+
+  let assert Ok(is_paid) =
+    test_db.query_int(
+      db,
+      "SELECT is_paid::int FROM vacancy WHERE id = '" <> vacancy_id <> "'::uuid",
+    )
+  is_paid |> should.equal(1)
+  let assert Ok(row_status) =
+    test_db.query_text(
+      db,
+      "SELECT status::text FROM payment WHERE stripe_session_id = '"
+        <> session_id
+        <> "'",
+    )
+  row_status |> should.equal("completed")
+  // Audit + notification fired on the settle path, keyed to the settle event.
+  count_audit_for_event(db, settle_event_id) |> should.equal(1)
+  count_payment_notifications(db, vacancy_id) |> should.equal(1)
+  count_processed_event(db, settle_event_id) |> should.equal(1)
+  // The pending completed event remains claimed (it was NOT reprocessed).
+  count_processed_event(db, pending_event_id) |> should.equal(1)
+
+  // Burst scoring fired: the seeded application now has an ai_analysis row.
+  let assert Ok(analysis_count) =
+    test_db.query_int(db, "SELECT count(*)::int FROM ai_analysis aa
+       JOIN application a ON a.id = aa.application_id
+       WHERE a.vacancy_id = '" <> vacancy_id <> "'::uuid")
+  analysis_count |> should.equal(1)
+
+  // Phase 3: replay of the settle event short-circuits (idempotent).
+  let resp2 = post_webhook(cfg, body, sign_body(body, test_webhook_secret))
+  resp2.status |> should.equal(200)
+  count_processed_event(db, settle_event_id) |> should.equal(1)
+  count_audit_for_event(db, settle_event_id) |> should.equal(1)
+  count_payment_notifications(db, vacancy_id) |> should.equal(1)
+}
