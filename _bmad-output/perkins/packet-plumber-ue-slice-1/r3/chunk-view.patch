diff --git a/Source/PacketPlumber/PPCommandBus.cpp b/Source/PacketPlumber/PPCommandBus.cpp
new file mode 100644
index 0000000..63a26aa
--- /dev/null
+++ b/Source/PacketPlumber/PPCommandBus.cpp
@@ -0,0 +1,71 @@
+// PPCommandBus.cpp — the UAD-12 command bus (slice-1 drag-draw).
+#include "PPCommandBus.h"
+
+PP::FEditResult FPPCommandBus::DrawPipe(PP::FSimState &State, const FDrawIntent &Intent)
+{
+	// Both endpoints must snap to a node (the E4 inclusive snap was applied
+	// upstream by SnapToNode); a missing snap means the drag did not land on
+	// a valid pair — report MissingNode so the UI can give feedback.
+	if (!Intent.bStartOnNode || !Intent.bEndOnNode)
+	{
+		PP::FEditResult R;
+		R.Error = PP::FEditError::MissingNode;
+		return R;
+	}
+	PP::FCommand Cmd;
+	Cmd.Kind = PP::FCommandKind::DrawPipe;
+	Cmd.A = Intent.StartNode;
+	Cmd.B = Intent.EndNode;
+	Cmd.Tier = PP::TIER_STANDARD;	  // slice-1 draws the standard tier (canon 1.2)
+	return PP::ApplyEdit(State, Cmd); // live fast-path + log apply_tick = next
+}
+
+bool FPPCommandBus::SnapToNode(const PP::FTopology &Topology, const FVector2D &ScreenPos, const FVector2D &ViewportSize,
+							   uint32_t &OutNodeId)
+{
+	// E4 snap: inclusive at radius, measured in WORLD PX from the node
+	// position. The snap runs in SCREEN space (no tile quantization — the
+	// r1 warning): each node's screen position comes from the SAME camera-fit
+	// the view + ScreenToGrid use, and the true px distance is compared.
+	// (The fit is presentation math — the sim never sees it.)
+	const FPPScreenFit Fit = MakeScreenFit(ViewportSize);
+	// E4: the radius is in WORLD px (kSnapRadius — the map's coordinate
+	// space); the snap compares in SCREEN px, so the radius scales with the
+	// camera fit (r2 warning: the canon was compared unscaled — at the DPI
+	// 1.386 fit the effective snap was ~49 screen px instead of ~50; at the
+	// design fit it was ~33 instead of ~36 — small but a contract drift).
+	const float RadiusPx = static_cast<float>(PP::kSnapRadius) * Fit.Scale;
+
+	uint32_t Best = 0;
+	float BestD2 = TNumericLimits<float>::Max();
+	bool Found = false;
+	for (uint32_t Slot = 0; Slot < Topology.NodeAlive.size(); ++Slot)
+	{
+		if (!Topology.NodeAlive[Slot])
+		{
+			continue;
+		}
+		const FVector2D NodeScreen = Fit.GridToScreen(PP::FIntPoint{Topology.NodePosX[Slot], Topology.NodePosY[Slot]});
+		const float Dx = NodeScreen.X - ScreenPos.X;
+		const float Dy = NodeScreen.Y - ScreenPos.Y;
+		const float D2 = Dx * Dx + Dy * Dy;
+		if (D2 <= RadiusPx * RadiusPx && D2 < BestD2) // inclusive (E4)
+		{
+			BestD2 = D2;
+			Best = Topology.NodeId[Slot];
+			Found = true;
+		}
+	}
+	if (Found)
+	{
+		OutNodeId = Best;
+	}
+	return Found;
+}
+
+PP::FIntPoint FPPScreenFit::ScreenToGrid(const FVector2D &ScreenPos) const
+{
+	const int32 TileX = static_cast<int32>(FMath::FloorToDouble((ScreenPos.X - Offset.X) / (Scale * PP::kTilePx)));
+	const int32 TileY = static_cast<int32>(FMath::FloorToDouble((ScreenPos.Y - Offset.Y) / (Scale * PP::kTilePx)));
+	return PP::FIntPoint{TileX, TileY};
+}
diff --git a/Source/PacketPlumber/PPRunGameMode.cpp b/Source/PacketPlumber/PPRunGameMode.cpp
new file mode 100644
index 0000000..c963d24
--- /dev/null
+++ b/Source/PacketPlumber/PPRunGameMode.cpp
@@ -0,0 +1,202 @@
+// PPRunGameMode.cpp — the run GameMode (slice 1.2/1.3).
+#include "PPRunGameMode.h"
+
+#include "Blueprint/UserWidget.h"
+#include "Logging/LogMacros.h"
+
+DEFINE_LOG_CATEGORY_STATIC(LogPPRun, Log, All);
+#include "Engine/World.h"
+#include "GameFramework/PlayerController.h"
+#include "PPRunPlayerController.h"
+#include "PPRunView.h"
+
+APPRunGameMode::APPRunGameMode()
+{
+	PrimaryActorTick.bCanEverTick = true;
+	// C++-first view: no BP pawn/controller needed for slice 1 — the widget
+	// reads snapshots and input routes through the bus.
+	DefaultPawnClass = nullptr;
+	PlayerControllerClass = APPRunPlayerController::StaticClass();
+}
+
+void APPRunGameMode::StartRun()
+{
+	// Fresh run arena (ODN-13). The static fixture is the SHARED
+	// PP::SpawnFixture (UAD-17 — the SAME builder the golden scenario uses,
+	// so PIE and the goldens cannot drift; the r1 fixture hand-copy is
+	// gone). NO pipes pre-drawn: story 1.2's player draws
+	// source->router->sink through the validated command bus. Demand: one
+	// packet every 10 ticks (0.5 s) source->sink once a path exists (1.3).
+	SimState.Initialize(42);
+	PP::SpawnFixture(SimState);
+	for (uint64_t T = 10; T <= 100000; T += 10)
+	{
+		PP::FlowSeedDemand(SimState.Flow, T, PP::SCENARIO_SOURCE, PP::SCENARIO_SINK, 0);
+	}
+	Driver.Reset();
+	BuildSnapshot();
+	PrevSnapshot = Snapshot;
+}
+
+void APPRunGameMode::BeginPlay()
+{
+	Super::BeginPlay();
+	StartRun();
+
+	// Create the C++ view widget (no asset — built entirely in code).
+	if (UClass *ViewClass = UPPRunView::StaticClass())
+	{
+		RunView = CreateWidget<UPPRunView>(GetWorld(), ViewClass);
+		if (RunView)
+		{
+			UE_LOG(LogPPRun, Display, TEXT("RunView created (class %s)"), *ViewClass->GetName());
+			RunView->AddToViewport(0);
+			RunView->BindRun(this);
+			UE_LOG(LogPPRun, Display, TEXT("RunView bound + added to viewport"));
+		}
+		else
+		{
+			UE_LOG(LogPPRun, Error, TEXT("RunView creation FAILED"));
+		}
+	}
+}
+
+void APPRunGameMode::EndPlay(const EEndPlayReason::Type EndPlayReason)
+{
+	RunView = nullptr;
+	Super::EndPlay(EndPlayReason);
+}
+
+void APPRunGameMode::Tick(float DeltaSeconds)
+{
+	Super::Tick(DeltaSeconds);
+	StepSim(DeltaSeconds);
+}
+
+void APPRunGameMode::StepSim(float DeltaSeconds)
+{
+	const int32 Stepped = Driver.Advance(SimState, DeltaSeconds);
+	if (Stepped > 0)
+	{
+		PrevSnapshot = Snapshot;
+		BuildSnapshot();
+	}
+}
+
+void APPRunGameMode::BuildSnapshot()
+{
+	// View reads ONLY snapshots (U-E9): copy what the view needs, nothing else.
+	Snapshot = PPView::FSnapshot{};
+	Snapshot.Tick = SimState.Tick;
+	Snapshot.TopologyGen = SimState.Topology.Gen;
+	Snapshot.Score = SimState.Score;
+	for (uint32_t Slot = 0; Slot < SimState.Topology.NodeAlive.size(); ++Slot)
+	{
+		if (!SimState.Topology.NodeAlive[Slot])
+		{
+			continue;
+		}
+		PPView::FNodeView N;
+		N.Id = SimState.Topology.NodeId[Slot];
+		N.Kind = static_cast<PP::FNodeKind>(SimState.Topology.NodeKind[Slot]);
+		N.Pos = PP::FIntPoint{SimState.Topology.NodePosX[Slot], SimState.Topology.NodePosY[Slot]};
+		Snapshot.Nodes.Add(N);
+	}
+	for (uint32_t Slot = 0; Slot < SimState.Topology.PipeAlive.size(); ++Slot)
+	{
+		if (!SimState.Topology.PipeAlive[Slot])
+		{
+			continue;
+		}
+		PPView::FPipeView P;
+		P.Id = SimState.Topology.PipeId[Slot];
+		P.A = SimState.Topology.PipeA[Slot];
+		P.B = SimState.Topology.PipeB[Slot];
+		Snapshot.Pipes.Add(P);
+	}
+	for (const PP::FPacket &Packet : SimState.Flow.Packets)
+	{
+		PPView::FPacketView PV;
+		PV.Id = Packet.Id;
+		PV.bOnEdge = Packet.OnEdge;
+		if (Packet.OnEdge)
+		{
+			// FromNode = the pipe's departure endpoint (AtNode — the departure
+			// node is kept while on edge, E29), ToNode = Heading. Progress:
+			// bandwidth units / packet bandwidth -> 0..1 across the edge.
+			PV.FromNode = Packet.AtNode;
+			PV.ToNode = Packet.Heading;
+			PV.Progress = FMath::Clamp(static_cast<float>(Packet.ProgressUnits) / PP::kPacketBandwidth, 0.0f, 1.0f);
+		}
+		else
+		{
+			PV.FromNode = Packet.AtNode;
+			PV.ToNode = Packet.AtNode;
+			PV.Progress = 0.0f;
+		}
+		Snapshot.Packets.Add(PV);
+	}
+}
+
+void APPRunGameMode::BeginDraw(const FVector2D &ScreenPos)
+{
+	// The viewport size is refreshed from the player controller when a real
+	// world exists; a bare/headless GM (the automation test) falls back to
+	// the design reference via MakeScreenFit. The snap math never depends on
+	// the world — only the size refresh does.
+	if (APlayerController *PC = GetWorld() ? GetWorld()->GetFirstPlayerController() : nullptr)
+	{
+		int32 VW = 1280, VH = 720;
+		PC->GetViewportSize(VW, VH);
+		ViewportSize = FVector2D(static_cast<float>(VW), static_cast<float>(VH));
+	}
+	DragStartScreen = ScreenPos;
+	bDragging = true;
+}
+
+void APPRunGameMode::EndDraw(const FVector2D &ScreenPos)
+{
+	if (!bDragging)
+	{
+		return;
+	}
+	bDragging = false;
+	if (APlayerController *PC = GetWorld() ? GetWorld()->GetFirstPlayerController() : nullptr)
+	{
+		int32 VW = 1280, VH = 720;
+		PC->GetViewportSize(VW, VH);
+		ViewportSize = FVector2D(static_cast<float>(VW), static_cast<float>(VH));
+	}
+	{
+		const PP::FIntPoint EndGrid = MakeScreenFit(ViewportSize).ScreenToGrid(ScreenPos);
+
+		FDrawIntent Intent;
+		uint32_t StartNode = 0, EndNode = 0;
+		// snap in SCREEN space (E4 — world px radius, no tile quantization);
+		// the drag-start screen pos is kept alongside the grid pos
+		Intent.bStartOnNode = FPPCommandBus::SnapToNode(SimState.Topology, DragStartScreen, ViewportSize, StartNode);
+		Intent.bEndOnNode = FPPCommandBus::SnapToNode(SimState.Topology, ScreenPos, ViewportSize, EndNode);
+		UE_LOG(LogPPRun, Display, TEXT("EndDraw: viewport=(%.0f,%.0f) start=%s(%u) end=%s(%u) pipes=%d"),
+			   ViewportSize.X, ViewportSize.Y, Intent.bStartOnNode ? TEXT("node") : TEXT("miss"), StartNode,
+			   Intent.bEndOnNode ? TEXT("node") : TEXT("miss"), EndNode, PP::PipeCount(SimState.Topology));
+		if (Intent.bStartOnNode)
+		{
+			Intent.StartNode = StartNode;
+		}
+		if (Intent.bEndOnNode)
+		{
+			Intent.EndNode = EndNode;
+		}
+		// apply via the live fast-path (validate-then-apply + log apply_tick=next)
+		const PP::FEditResult Result = CommandBus.DrawPipe(SimState, Intent);
+		LastEditError = Result.Error;
+		// The edit lands in the topology immediately; the next Step picks it
+		// up (rebuild on gen change). The view refreshes on the next step.
+		if (Result.Error == PP::FEditError::None)
+		{
+			// immediate refresh so the drawn pipe appears THIS frame (1.2:
+			// "two pipes are created and appear instantly")
+			BuildSnapshot();
+		}
+	}
+}
diff --git a/Source/PacketPlumber/PPRunPlayerController.cpp b/Source/PacketPlumber/PPRunPlayerController.cpp
new file mode 100644
index 0000000..02024a8
--- /dev/null
+++ b/Source/PacketPlumber/PPRunPlayerController.cpp
@@ -0,0 +1,126 @@
+// PPRunPlayerController.cpp — Enhanced Input mouse draw (UAD-12).
+#include "PPRunPlayerController.h"
+
+#include "EnhancedInputComponent.h"
+#include "EnhancedInputSubsystems.h"
+#include "InputAction.h"
+#include "InputMappingContext.h"
+#include "PPRunGameMode.h"
+
+APPRunPlayerController::APPRunPlayerController()
+{
+	// The draw cursor must be visible (map-as-UI pointer).
+	bShowMouseCursor = true;
+	DefaultMouseCursor = EMouseCursor::Crosshairs;
+
+	// Create the runtime input assets in the CONSTRUCTOR, not BeginPlay:
+	// UE calls SetupInputComponent (via SetPlayer -> InitInputSystem) BEFORE
+	// BeginPlay (PlayerController.cpp), so BindAction there would capture
+	// null action pointers and the mouse could never reach the draw bus
+	// (Perkins r1 blocker 1 — engine-source verified). These are plain
+	// UObjects (no components), so NewObject-with-outer is safe at
+	// construction; the CDO carries the same assets.
+	DrawMappingContext = NewObject<UInputMappingContext>(this, TEXT("PP_DrawContext"));
+	DrawStartAction = NewObject<UInputAction>(this, TEXT("PP_DrawStart"));
+	DrawStartAction->ValueType = EInputActionValueType::Boolean;
+	DrawEndAction = NewObject<UInputAction>(this, TEXT("PP_DrawEnd"));
+	DrawEndAction->ValueType = EInputActionValueType::Boolean;
+
+	DrawMappingContext->MapKey(DrawStartAction, EKeys::LeftMouseButton);
+	DrawMappingContext->MapKey(DrawEndAction, EKeys::LeftMouseButton);
+}
+
+void APPRunPlayerController::BeginPlay()
+{
+	Super::BeginPlay();
+
+	// Register the mapping context with the local player (needs the LocalPlayer,
+	// which only exists post-possession — hence BeginPlay, not the ctor).
+	if (UEnhancedInputLocalPlayerSubsystem *Subsystem =
+			ULocalPlayer::GetSubsystem<UEnhancedInputLocalPlayerSubsystem>(GetLocalPlayer()))
+	{
+		Subsystem->AddMappingContext(DrawMappingContext, 0);
+	}
+}
+
+void APPRunPlayerController::SetupInputComponent()
+{
+	Super::SetupInputComponent();
+
+	// The actions were created in the constructor — they are ALWAYS non-null
+	// here (the r1 null-capture bug). Bind unconditionally.
+	if (UEnhancedInputComponent *EIC = Cast<UEnhancedInputComponent>(InputComponent))
+	{
+		EIC->BindAction(DrawStartAction, ETriggerEvent::Started, this, &APPRunPlayerController::OnDrawStart);
+		EIC->BindAction(DrawEndAction, ETriggerEvent::Completed, this, &APPRunPlayerController::OnDrawEnd);
+	}
+}
+
+// Expose the input assets for the headless trigger test (PacketPlumber.Input.*).
+UInputMappingContext *APPRunPlayerController::GetDrawMappingContext() const
+{
+	return DrawMappingContext;
+}
+
+UInputAction *APPRunPlayerController::GetDrawStartAction() const
+{
+	return DrawStartAction;
+}
+
+UInputAction *APPRunPlayerController::GetDrawEndAction() const
+{
+	return DrawEndAction;
+}
+
+void APPRunPlayerController::OnDrawStart()
+{
+	if (APPRunGameMode *GM = ResolveGameMode())
+	{
+		float X = 0.0f, Y = 0.0f;
+		if (!GetMousePosition(X, Y))
+		{
+			return; // no cursor position this frame (r2 note: unchecked before)
+		}
+		GM->BeginDraw(FVector2D(X, Y));
+	}
+}
+
+void APPRunPlayerController::OnDrawEnd()
+{
+	if (APPRunGameMode *GM = ResolveGameMode())
+	{
+		float X = 0.0f, Y = 0.0f;
+		if (!GetMousePosition(X, Y))
+		{
+			return; // no cursor position this frame
+		}
+		GM->EndDraw(FVector2D(X, Y));
+	}
+}
+
+APPRunGameMode *APPRunPlayerController::ResolveGameMode() const
+{
+	if (TestGameMode)
+	{
+		return TestGameMode; // headless test injection
+	}
+	return GetWorld() ? GetWorld()->GetAuthGameMode<APPRunGameMode>() : nullptr;
+}
+
+void APPRunPlayerController::FireDrawStartForTest(const FInputActionInstance &ActionData)
+{
+	++FireCount;
+	if (APPRunGameMode *GM = ResolveGameMode())
+	{
+		GM->BeginDraw(TestScreenPos);
+	}
+}
+
+void APPRunPlayerController::FireDrawEndForTest(const FInputActionInstance &ActionData)
+{
+	++FireCount;
+	if (APPRunGameMode *GM = ResolveGameMode())
+	{
+		GM->EndDraw(TestScreenPos);
+	}
+}
diff --git a/Source/PacketPlumber/PPRunView.cpp b/Source/PacketPlumber/PPRunView.cpp
