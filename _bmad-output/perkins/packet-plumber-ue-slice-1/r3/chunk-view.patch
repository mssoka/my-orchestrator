@@ -0,0 +1,393 @@
+// PPRunView.cpp — the MM-look view (UAD-22): flat vector, warm cream,
+// ribbon roads with rounded casing, soft blob shadows, eased packet motion.
+#include "PPRunView.h"
+
+#include "Blueprint/WidgetTree.h"
+#include "Components/Border.h"
+#include "Components/CanvasPanel.h"
+#include "Components/CanvasPanelSlot.h"
+#include "Components/Image.h"
+#include "Components/TextBlock.h"
+#include "Engine/GameViewportClient.h"
+#include "PPRunGameMode.h"
+#include "PPViewGeometry.h"
+#include "Styling/SlateBrush.h"
+
+// FSlateRoundedBoxBrush (SlateCore) — rounded corners at any radius; with
+// radius = half the size it renders a true circle. UMG Border/Image take it
+// via SetBrush (it IS a FSlateBrush).
+#include "Brushes/SlateRoundedBoxBrush.h"
+
+// --- palette tokens (the slice-1 MM look-parity baseline; UAD-22) ---
+namespace
+{
+const FLinearColor kCanvas(0.960f, 0.941f, 0.894f, 1.0f);	  // #F5F0E4 warm cream
+const FLinearColor kRoadFill(1.0f, 1.0f, 1.0f, 1.0f);		  // white ribbon
+const FLinearColor kRoadCasing(0.847f, 0.812f, 0.733f, 1.0f); // #D8CFBB
+const FLinearColor kSourceNode(0.910f, 0.639f, 0.239f, 1.0f); // #E8A33D
+const FLinearColor kRouterNode(0.659f, 0.635f, 0.604f, 1.0f); // #A8A29A
+const FLinearColor kSinkNode(0.498f, 0.651f, 0.788f, 1.0f);	  // #7FA6C9
+const FLinearColor kPacketDot(0.243f, 0.486f, 0.694f, 1.0f);  // #3E7CB1
+const FLinearColor kShadowTint(0.0f, 0.0f, 0.0f, 0.14f);	  // soft blob
+constexpr float kNodeDiameter = 34.0f;
+constexpr float kRoadWidth = 14.0f;
+constexpr float kPacketDiameter = 10.0f;
+constexpr float kTickInterval = 1.0f / PP::kLogicHz;
+constexpr int32 kMaxPacketDots = 16; // UAD-8 dot pool cap (slice-1 scale)
+
+} // namespace
+
+UPPRunView::UPPRunView(const FObjectInitializer &ObjectInitializer) : Super(ObjectInitializer)
+{
+}
+
+TSharedRef<SWidget> UPPRunView::RebuildWidget()
+{
+	// Background canvas: the warm-cream world (map-as-UI, arch §9.1). The
+	// tree is built here — the C++-only widget pattern (no designer asset).
+	UCanvasPanel *Root = WidgetTree->ConstructWidget<UCanvasPanel>(UCanvasPanel::StaticClass(), TEXT("WorldRoot"));
+	WidgetTree->RootWidget = Root;
+	WorldCanvas = Root;
+
+	// Full-screen cream backdrop so the world reads as a flat canvas.
+	UImage *Backdrop = WidgetTree->ConstructWidget<UImage>(UImage::StaticClass(), TEXT("Backdrop"));
+	FSlateRoundedBoxBrush BackdropBrush(kCanvas, 0.0f);
+	Backdrop->SetBrush(BackdropBrush);
+	UCanvasPanelSlot *BackdropSlot = Root->AddChildToCanvas(Backdrop);
+	BackdropSlot->SetAnchors(FAnchors(0.0f, 0.0f, 1.0f, 1.0f));
+	BackdropSlot->SetOffsets(FMargin(0.0f));
+
+	// Status line (top-left): tick + live packets + score.
+	StatusText = WidgetTree->ConstructWidget<UTextBlock>(UTextBlock::StaticClass(), TEXT("Status"));
+	StatusText->SetText(FText::FromString(TEXT("")));
+	StatusText->SetColorAndOpacity(FSlateColor(FLinearColor(0.30f, 0.28f, 0.24f, 1.0f)));
+	UCanvasPanelSlot *StatusSlot = Root->AddChildToCanvas(StatusText);
+	StatusSlot->SetAnchors(FAnchors(0.0f, 0.0f));
+	StatusSlot->SetPosition(FVector2D(12.0f, 8.0f));
+	StatusSlot->SetAutoSize(true);
+
+	// The root is the canvas panel itself.
+	return Root->TakeWidget();
+}
+
+void UPPRunView::BindRun(APPRunGameMode *InGameMode)
+{
+	GameMode = InGameMode;
+	RebuildWorld();
+}
+
+void UPPRunView::ClearWorld()
+{
+	if (!WorldCanvas)
+	{
+		return;
+	}
+	// Remove every world child except the backdrop (0) + status (1).
+	while (WorldCanvas->GetChildrenCount() > 2)
+	{
+		WorldCanvas->RemoveChildAt(WorldCanvas->GetChildrenCount() - 1);
+	}
+	// The pool children were removed too — rebuild it (the caller re-adds).
+	DotPool.Reset();
+	PacketDots.Reset();
+}
+
+FVector2D UPPRunView::GridToScreen(const PP::FIntPoint &GridPos) const
+{
+	return Fit.GridToScreen(GridPos);
+}
+
+FVector2D UPPRunView::GridToScreenV(const FVector2D &GridPos) const
+{
+	return Fit.GridToScreenV(GridPos);
+}
+
+UImage *UPPRunView::MakeCircle(float Diameter, const FLinearColor &Color)
+{
+	UImage *Circle = WidgetTree->ConstructWidget<UImage>(UImage::StaticClass());
+	FSlateRoundedBoxBrush Brush(Color, Diameter * 0.5f);
+	Brush.SetImageSize(FVector2f(Diameter, Diameter)); // explicit — zero default
+	Circle->SetBrush(Brush);
+	Circle->SetDesiredSizeOverride(FVector2D(Diameter, Diameter));
+	return Circle;
+}
+
+UBorder *UPPRunView::MakeRoad(const FVector2D &FromScreen, const FVector2D &ToScreen, float Width,
+							  const FLinearColor &Fill, const FLinearColor &Casing)
+{
+	// Ribbon road: a casing border (wider, rounded) + a fill border on top,
+	// rotated to the pipe angle. Rounded caps = rounded-box radius half-W.
+	const FVector2D Delta = ToScreen - FromScreen;
+	const float Length = Delta.Size();
+	const float Angle = FMath::RadiansToDegrees(FMath::Atan2(Delta.Y, Delta.X));
+
+	auto MakeRibbon = [this](float W, const FLinearColor &Color)
+	{
+		UBorder *Ribbon = WidgetTree->ConstructWidget<UBorder>(UBorder::StaticClass());
+		FSlateRoundedBoxBrush Brush(Color, W * 0.5f);
+		Ribbon->SetBrush(Brush);
+		return Ribbon;
+	};
+
+	UBorder *CasingBorder = MakeRibbon(Width + 4.0f, Casing);
+	UBorder *FillBorder = MakeRibbon(Width, Fill);
+
+	const FVector2D Center = (FromScreen + ToScreen) * 0.5f;
+	// The slot position is the TOP-LEFT of the widget's layout box. To place
+	// the box so its CENTER (the pivot the rotation uses) sits on the road
+	// midpoint, the anchor must be Center - (Length/2, boxHeight/2) — the r2
+	// blocker: it was Center - (Width/2, Width/2), which put the box center
+	// at Center + ((Length-Width)/2, 0) — every road shifted ~41px along its
+	// axis, disconnecting the roads from the node centers (pixel-proven in
+	// every committed frame).
+	UCanvasPanelSlot *CasingSlot = WorldCanvas->AddChildToCanvas(CasingBorder);
+	CasingSlot->SetPosition(PPViewGeometry::RoadSlotTopLeft(Center, Length, Width + 4.0f));
+	CasingSlot->SetSize(FVector2D(Length, Width + 4.0f));
+	FWidgetTransform CasingT;
+	CasingT.Angle = Angle;
+	CasingBorder->SetRenderTransform(CasingT);
+	// UMG rotates about the render-transform PIVOT (defaults to the widget's
+	// top-left = (0,0)); pin it to the ribbon center so a DIAGONAL road
+	// rotates about its midpoint, not its corner (r1 warning).
+	CasingBorder->SetRenderTransformPivot(FVector2D(0.5f, 0.5f));
+
+	UCanvasPanelSlot *FillSlot = WorldCanvas->AddChildToCanvas(FillBorder);
+	FillSlot->SetPosition(PPViewGeometry::RoadSlotTopLeft(Center, Length, Width));
+	FillSlot->SetSize(FVector2D(Length, Width));
+	FWidgetTransform FillT;
+	FillT.Angle = Angle;
+	FillBorder->SetRenderTransform(FillT);
+	FillBorder->SetRenderTransformPivot(FVector2D(0.5f, 0.5f));
+
+	return FillBorder;
+}
+
+UImage *UPPRunView::MakePacketDot(float Diameter)
+{
+	UImage *Dot = WidgetTree->ConstructWidget<UImage>(UImage::StaticClass());
+	// The brush's ImageSize must be explicit — UImage renders at the brush
+	// size, and the default FSlateRoundedBoxBrush ImageSize is ZERO (the
+	// r2 invisible-dot bug: the dot was created + positioned but never
+	// painted). NO AutoSize: the nodes render with an explicit slot size,
+	// and AutoSize + runtime SetPosition fights the layout (the dot stayed
+	// 10x10 at (0,0)-ish — invisible under the panel's origin).
+	FSlateRoundedBoxBrush Brush(kPacketDot, Diameter * 0.5f);
+	Brush.SetImageSize(FVector2f(Diameter, Diameter));
+	Dot->SetBrush(Brush);
+	Dot->SetDesiredSizeOverride(FVector2D(Diameter, Diameter));
+	UCanvasPanelSlot *Slot = WorldCanvas->AddChildToCanvas(Dot);
+	Slot->SetSize(FVector2D(Diameter, Diameter));
+	Slot->SetPosition(FVector2D(0.0f, 0.0f)); // NativeTick sets the real position
+	return Dot;
+}
+
+void UPPRunView::RebuildWorld()
+{
+	if (!GameMode || !WorldCanvas)
+	{
+		return;
+	}
+	PrevSnapshot = GameMode->GetPrevSnapshot();
+	CurSnapshot = GameMode->GetSnapshot();
+
+	// camera fit — ONE source of truth (FPPScreenFit, shared with the
+	// command bus). The widget's cached geometry IS the canvas size (a
+	// freshly-constructed widget reports zero — [FinLT] — MakeScreenFit
+	// falls back to the design reference; NativeTick re-fits when the size
+	// lands and rebuilds the world).
+	Fit = MakeScreenFit(GetCachedGeometry().GetLocalSize());
+
+	ClearWorld();
+	RefreshPipes(); // roads UNDER nodes (they run center-to-center)
+	RefreshNodes(); // node discs cover the road ends (r2 z-order fix)
+	RebuildDotPool();
+	ElapsedSinceSnapshot = 0.0f;
+}
+
+void UPPRunView::RefreshNodes()
+{
+	for (const PPView::FNodeView &Node : CurSnapshot.Nodes)
+	{
+		const FVector2D Screen = GridToScreen(Node.Pos);
+
+		// soft blob shadow under the node (offset, low alpha, oversized)
+		UImage *Shadow = WidgetTree->ConstructWidget<UImage>(UImage::StaticClass());
+		const float ShadowSize = kNodeDiameter + 12.0f;
+		FSlateRoundedBoxBrush ShadowBrush(kShadowTint, ShadowSize * 0.5f);
+		ShadowBrush.SetImageSize(FVector2f(ShadowSize, ShadowSize));
+		Shadow->SetBrush(ShadowBrush);
+		UCanvasPanelSlot *ShadowSlot = WorldCanvas->AddChildToCanvas(Shadow);
+		ShadowSlot->SetPosition(Screen - FVector2D(ShadowSize * 0.5f - 2.0f, ShadowSize * 0.5f - 3.0f));
+		ShadowSlot->SetSize(FVector2D(ShadowSize, ShadowSize));
+
+		const FLinearColor Color = Node.Kind == PP::FNodeKind::Terminal
+									   ? (Node.Id == PP::SCENARIO_SOURCE ? kSourceNode : kSinkNode)
+									   : kRouterNode;
+		UImage *NodeImg = MakeCircle(kNodeDiameter, Color);
+		UCanvasPanelSlot *NodeSlot = WorldCanvas->AddChildToCanvas(NodeImg);
+		NodeSlot->SetPosition(Screen - FVector2D(kNodeDiameter * 0.5f, kNodeDiameter * 0.5f));
+		NodeSlot->SetSize(FVector2D(kNodeDiameter, kNodeDiameter));
+	}
+}
+
+void UPPRunView::RefreshPipes()
+{
+	TMap<uint32_t, FVector2D> NodeScreen;
+	for (const PPView::FNodeView &Node : CurSnapshot.Nodes)
+	{
+		NodeScreen.Add(Node.Id, GridToScreen(Node.Pos));
+	}
+	for (const PPView::FPipeView &Pipe : CurSnapshot.Pipes)
+	{
+		const FVector2D *A = NodeScreen.Find(Pipe.A);
+		const FVector2D *B = NodeScreen.Find(Pipe.B);
+		if (A && B)
+		{
+			MakeRoad(*A, *B, kRoadWidth, kRoadFill, kRoadCasing);
+		}
+	}
+}
+
+void UPPRunView::RebuildDotPool()
+{
+	// Pre-create the packet-dot POOL (UAD-8): runtime-added canvas children
+	// added from NativeTick never painted (r2 saga — the pool=0 bug: the
+	// fit-change rebuild cleared the pool but never re-created it); children
+	// added during a layout pass (this call) render. NativeTick only
+	// repositions them. MUST run after ClearWorld (the pool children are
+	// removed with the rest).
+	for (int32 I = 0; I < kMaxPacketDots; ++I)
+	{
+		UImage *Dot = MakePacketDot(kPacketDiameter);
+		Dot->SetVisibility(ESlateVisibility::Hidden);
+		DotPool.Add(Dot);
+	}
+}
+
+void UPPRunView::NativeTick(const FGeometry &MyGeometry, float InDeltaTime)
+{
+	Super::NativeTick(MyGeometry, InDeltaTime);
+	if (!GameMode || !WorldCanvas)
+	{
+		return;
+	}
+
+	// re-fit when the WIDGET's layout size lands/changes. The canvas renders
+	// in the widget's local space (DPI-scaled — r2 debug: geo=1896x1081 for
+	// a 1280x730 window), so the fit MUST use the widget's geometry. A fit
+	// CHANGE rebuilds the static world + the dot pool (the r2 pool=0 bug:
+	// ClearWorld wiped the pool and the rebuild never re-created it).
+	const FVector2D LocalSize = MyGeometry.GetLocalSize();
+	if (!LocalSize.IsNearlyZero() && LocalSize != Fit.ViewportSize)
+	{
+		Fit = MakeScreenFit(LocalSize);
+		CurSnapshot = GameMode->GetSnapshot();
+		PrevSnapshot = CurSnapshot;
+		ClearWorld();
+		RefreshPipes();
+		RefreshNodes();
+		RebuildDotPool();
+	}
+
+	const PPView::FSnapshot &Next = GameMode->GetSnapshot();
+	// Change detection keys on BOTH the tick AND the topology Gen — a draw
+	// applied via the live fast-path bumps Gen at the SAME tick (the r2
+	// warning: the view was Tick-keyed only, so the "appears this frame"
+	// promise was really ≤50 ms). A same-tick Gen change rebuilds the world
+	// without sliding the snapshot pair (the interp pair stays valid).
+	if (Next.Tick != CurSnapshot.Tick || Next.TopologyGen != CurSnapshot.TopologyGen)
+	{
+		const bool bTopologyChanged = Next.TopologyGen != CurSnapshot.TopologyGen;
+		const bool bNewTick = Next.Tick != CurSnapshot.Tick;
+		if (bNewTick)
+		{
+			PrevSnapshot = CurSnapshot;
+			ElapsedSinceSnapshot = 0.0f;
+		}
+		CurSnapshot = Next;
+		if (bTopologyChanged)
+		{
+			ClearWorld();
+			RefreshPipes(); // roads UNDER nodes (r2 z-order fix)
+			RefreshNodes();
+			RebuildDotPool(); // ClearWorld wiped it (the pool=0 bug)
+		}
+		if (bNewTick)
+		{
+			return; // the packet interp runs on same-tick frames only
+		}
+	}
+	ElapsedSinceSnapshot += InDeltaTime;
+
+	// eased inter-snapshot fraction (20 Hz sim -> 60 fps view)
+	const float Frac = FMath::Clamp(ElapsedSinceSnapshot / kTickInterval, 0.0f, 1.0f);
+	const float Eased = PPViewGeometry::EaseInOut(Frac);
+
+	// packet dots: pool (UAD-8) keyed by packet id; position = lerp between
+	// the packet's position in the prev snapshot and the cur snapshot.
+	TSet<uint64_t> Live;
+	for (const PPView::FPacketView &Packet : CurSnapshot.Packets)
+	{
+		Live.Add(Packet.Id);
+		TObjectPtr<UImage> *Found = PacketDots.Find(Packet.Id);
+		UImage *Dot = nullptr;
+		if (!Found)
+		{
+			// acquire from the pre-created pool (UAD-8 — the pool exists in
+			// the tree from RebuildWorld, so no runtime AddChildToCanvas)
+			for (TObjectPtr<UImage> &Pooled : DotPool)
+			{
+				if (Pooled && Pooled->GetVisibility() == ESlateVisibility::Hidden)
+				{
+					Dot = Pooled.Get();
+					Dot->SetVisibility(ESlateVisibility::Visible);
+					Dot->InvalidateLayoutAndVolatility();
+					PacketDots.Add(Packet.Id, Dot);
+					break;
+				}
+			}
+			if (!Dot)
+			{
+				continue; // pool exhausted — drop the visual (sim unaffected)
+			}
+		}
+		else
+		{
+			Dot = Found->Get();
+		}
+		UCanvasPanelSlot *Slot = Cast<UCanvasPanelSlot>(Dot->Slot);
+		if (Slot)
+		{
+			// The packet's position at the PREV tick vs the CURRENT tick (its
+			// own progress per snapshot — the eased motion is real). A packet
+			// absent from the prev snapshot (just spawned) starts at its cur
+			// position — no glide from the canvas corner.
+			const FVector2D ToGrid = PPViewGeometry::PacketGridPos(CurSnapshot, Packet.Id);
+			const bool bInPrev = PPViewGeometry::PacketGridPos(PrevSnapshot, Packet.Id) != FVector2D::ZeroVector;
+			const FVector2D FromGrid = bInPrev ? PPViewGeometry::PacketGridPos(PrevSnapshot, Packet.Id) : ToGrid;
+			// ease across BOTH the inter-snapshot fraction AND the edge
+			// progress (MM-style ease-in-out; arrival settle = the ease-out
+			// half of the edge interpolation)
+			const FVector2D Target = FMath::Lerp(FromGrid, ToGrid, Eased);
+			const FVector2D ScreenPos =
+				GridToScreenV(Target) - FVector2D(kPacketDiameter * 0.5f, kPacketDiameter * 0.5f);
+			Slot->SetPosition(ScreenPos);
+		}
+	}
+	// release dots for packets that left the sim (delivered/culled)
+	for (auto It = PacketDots.CreateIterator(); It; ++It)
+	{
+		if (!Live.Contains(It.Key()))
+		{
+			It.Value()->SetVisibility(ESlateVisibility::Hidden); // return to the pool
+			It.RemoveCurrent();
+		}
+	}
+
+	if (StatusText)
+	{
+		StatusText->SetText(
+			FText::FromString(FString::Printf(TEXT("tick %llu  ·  packets %d  ·  score %d  ·  20 Hz"), CurSnapshot.Tick,
+											  CurSnapshot.Packets.Num(), CurSnapshot.Score)));
+	}
+}
