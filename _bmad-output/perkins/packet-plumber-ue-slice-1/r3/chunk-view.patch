diff --git a/Source/PacketPlumber/Public/PPCommandBus.h b/Source/PacketPlumber/Public/PPCommandBus.h
new file mode 100644
index 0000000..4764021
--- /dev/null
+++ b/Source/PacketPlumber/Public/PPCommandBus.h
@@ -0,0 +1,93 @@
+// PPCommandBus.h — the UAD-12 command bus: mouse intent -> FIntent ->
+// validated FCommand -> sim apply (live fast-path + action log).
+//
+// Slice-1 scope (story 1.2): drag-draw a pipe. The bus resolves the pointer
+// to a node id (snap-to-node, inclusive at radius [E4]), builds a
+// FCommand::DrawPipe, and applies it via PP::ApplyEdit — the SAME
+// validate-then-apply the replay path uses (one legality path, so live and
+// replay can never diverge). The edit fast-path (ODN-2): applied this frame,
+// logged with apply_tick = next; replay re-applies the log entry at that
+// tick before stepping.
+//
+// Engine-side (UE types allowed); the SIM stays pure (PP headers only).
+#pragma once
+
+#include "CoreMinimal.h"
+
+#include "PacketPlumberCore/PP_Sim.h"
+
+class APPRunGameMode;
+
+// The camera-fit mapping — ONE source of truth for the screen<->grid math
+// (r1 warning: the bus and the view each computed their own fit). The
+// 40x30-tile map at 26px/tile is fit into the viewport with a uniform scale,
+// centered; a zero viewport falls back to the 1280x720 design reference
+// (headless / pre-first-frame — never a degenerate divide).
+struct FPPScreenFit
+{
+	FVector2D ViewportSize = FVector2D(1280.0f, 720.0f);
+	float Scale = 1.0f;
+	FVector2D Offset = FVector2D::ZeroVector;
+
+	float GridToScreenX(float GridX) const
+	{
+		return Offset.X + (GridX + 0.5f) * PP::kTilePx * Scale;
+	}
+	float GridToScreenY(float GridY) const
+	{
+		return Offset.Y + (GridY + 0.5f) * PP::kTilePx * Scale;
+	}
+	FVector2D GridToScreen(const PP::FIntPoint &GridPos) const
+	{
+		return FVector2D(GridToScreenX(static_cast<float>(GridPos.X)), GridToScreenY(static_cast<float>(GridPos.Y)));
+	}
+	FVector2D GridToScreenV(const FVector2D &GridPos) const
+	{
+		return FVector2D(GridToScreenX(GridPos.X), GridToScreenY(GridPos.Y));
+	}
+	PP::FIntPoint ScreenToGrid(const FVector2D &ScreenPos) const;
+};
+
+inline FPPScreenFit MakeScreenFit(const FVector2D &ViewportSize)
+{
+	FPPScreenFit Fit;
+	if (ViewportSize.X > 0.0f && ViewportSize.Y > 0.0f)
+	{
+		Fit.ViewportSize = ViewportSize;
+	}
+	const float WorldW = static_cast<float>(PP::kMapTilesX * PP::kTilePx);
+	const float WorldH = static_cast<float>(PP::kMapTilesY * PP::kTilePx);
+	Fit.Scale = FMath::Min(Fit.ViewportSize.X / WorldW, Fit.ViewportSize.Y / WorldH);
+	Fit.Offset =
+		FVector2D((Fit.ViewportSize.X - WorldW * Fit.Scale) * 0.5f, (Fit.ViewportSize.Y - WorldH * Fit.Scale) * 0.5f);
+	return Fit;
+}
+
+// A drag intent in SCREEN space (the snap runs on px — E4) + the snapped
+// node ids. The bus resolves screen positions to nodes before building the
+// command; the grid position is derived for the sim (integer grid).
+struct FDrawIntent
+{
+	bool bStartOnNode = false;
+	uint32_t StartNode = 0; // snapped node id (valid when bStartOnNode)
+	bool bEndOnNode = false;
+	uint32_t EndNode = 0; // snapped node id (valid when bEndOnNode)
+};
+
+class PACKETPLUMBER_API FPPCommandBus
+{
+  public:
+	// Build + apply a draw command from a drag intent. Returns the edit
+	// result (ok + reason — self_loop [E3], terminal_pair [E26],
+	// span_exceeds, ...). The apply is the live fast-path: the edit lands
+	// immediately in the topology + is logged with apply_tick = next.
+	PP::FEditResult DrawPipe(PP::FSimState &State, const FDrawIntent &Intent);
+
+	// Snap a SCREEN position to a node id within the E4 snap radius. The
+	// radius is INCLUSIVE (E4) and measured in world px (kSnapRadius) — the
+	// compare runs in screen space (no tile quantization; the camera-fit is
+	// shared with ScreenToGrid and the view). Returns false when no node is
+	// in range.
+	static bool SnapToNode(const PP::FTopology &Topology, const FVector2D &ScreenPos, const FVector2D &ViewportSize,
+						   uint32_t &OutNodeId);
+};
diff --git a/Source/PacketPlumber/Public/PPRunGameMode.h b/Source/PacketPlumber/Public/PPRunGameMode.h
new file mode 100644
index 0000000..d660d8a
--- /dev/null
+++ b/Source/PacketPlumber/Public/PPRunGameMode.h
@@ -0,0 +1,101 @@
+// PPRunGameMode.h — the APPRunGameMode: owns the sim state + fixed-tick
+// driver + command bus, seeds the slice-1 static fixture, and emits the view
+// snapshot every step (U-E9: the view reads only snapshots).
+//
+// Story 1.2/1.3 scope (UAD-13 minimal): Boot -> Run. The fixture is the
+// golden scenario's (1 source terminal, 1 router junction, 1 sink terminal —
+// PP_Scenario.h constants) so PIE shows the SAME topology the golden pins;
+// the demand plan spawns a packet every N ticks so the player SEES the
+// packet travel once pipes are drawn (1.3).
+//
+// C++-first: no Blueprints, no content assets — the whole view is a UMG
+// widget tree built in code (UPPRunView).
+#pragma once
+
+#include "CoreMinimal.h"
+#include "GameFramework/GameModeBase.h"
+
+#include "PacketPlumberCore/PP_Scenario.h"
+#include "PacketPlumberCore/PP_Sim.h"
+
+#include "PPCommandBus.h"
+#include "PPSimDriver.h"
+#include "PPViewSnapshot.h"
+
+#include "PPRunGameMode.generated.h"
+
+class UPPRunView;
+
+UCLASS()
+class PACKETPLUMBER_API APPRunGameMode : public AGameModeBase
+{
+	GENERATED_BODY()
+
+  public:
+	APPRunGameMode();
+
+	// --- the run ---
+	// Fresh run arena (ODN-13): a new FSimState + fixture + demand. Retry
+	// (story 1.4 stub) calls this again — no state leakage.
+	void StartRun();
+
+	// --- snapshots (the view's only window into the sim, U-E9) ---
+	const PPView::FSnapshot &GetSnapshot() const
+	{
+		return Snapshot;
+	}
+	// Interpolation source: the view eases between the last two snapshots.
+	const PPView::FSnapshot &GetPrevSnapshot() const
+	{
+		return PrevSnapshot;
+	}
+
+	// Test seam (PacketPlumber.Input.*): the sim state + the last edit
+	// result, read-only.
+	const PP::FSimState &GetSimStateForTest() const
+	{
+		return SimState;
+	}
+	PP::FEditError GetLastEditErrorForTest() const
+	{
+		return LastEditError;
+	}
+
+	// Called by input: start/end a drag draw. ScreenPos in viewport pixels.
+	// BlueprintCallable so the MCP bridge (and any future input surface) can
+	// drive the SAME validated command-bus path the Enhanced Input actions
+	// use — one legality path for every device (UAD-12).
+	UFUNCTION(BlueprintCallable, Category = "Run")
+	void BeginDraw(const FVector2D &ScreenPos);
+
+	UFUNCTION(BlueprintCallable, Category = "Run")
+	void EndDraw(const FVector2D &ScreenPos);
+
+  protected:
+	virtual void BeginPlay() override;
+	virtual void EndPlay(const EEndPlayReason::Type EndPlayReason) override;
+	virtual void Tick(float DeltaSeconds) override;
+
+  private:
+	void BuildSnapshot();
+	void StepSim(float DeltaSeconds);
+
+	// the sim (plain data — no UPROPERTY, U-E4: no UObject points into sim memory)
+	PP::FSimState SimState;
+	FPPSimDriver Driver;
+	FPPCommandBus CommandBus;
+
+	// view snapshots (last two ticks — the 20 Hz -> 60 fps interp pair)
+	PPView::FSnapshot Snapshot;
+	PPView::FSnapshot PrevSnapshot;
+
+	// pending drag
+	bool bDragging = false;
+	FVector2D DragStartScreen = FVector2D::ZeroVector;	 // E4 snap is screen-space
+	FVector2D ViewportSize = FVector2D(1280.0f, 720.0f); // refreshed from the PC; design-ref default
+	// the last edit result (the input test reads it; rejection UI is [LATER])
+	PP::FEditError LastEditError = PP::FEditError::None;
+
+	UPROPERTY()
+	TObjectPtr<UPPRunView> RunView = nullptr;
+};
diff --git a/Source/PacketPlumber/Public/PPRunPlayerController.h b/Source/PacketPlumber/Public/PPRunPlayerController.h
new file mode 100644
index 0000000..c643a88
--- /dev/null
+++ b/Source/PacketPlumber/Public/PPRunPlayerController.h
@@ -0,0 +1,76 @@
+// PPRunPlayerController.h — the slice-1 input surface (UAD-12).
+//
+// Enhanced Input (mouse) -> FIntent -> FPPCommandBus. Two actions created
+// entirely in C++ (no assets): DrawStart (LMB press) + DrawEnd (LMB
+// release); the pointer position comes from the controller. The SAME
+// FCommand shapes any future device maps to (mouse/touch/gamepad parity by
+// construction, FORGE #6).
+#pragma once
+
+#include "CoreMinimal.h"
+#include "GameFramework/PlayerController.h"
+#include "InputAction.h" // FInputActionInstance (the trigger-seam signature)
+
+#include "PPRunPlayerController.generated.h"
+
+class UInputAction;
