index 0000000..9e09de5
--- /dev/null
+++ b/Source/PacketPlumber/Public/PPSimDriver.h
@@ -0,0 +1,71 @@
+// PPSimDriver.h — the UAD-2 fixed-timestep driver (engine-side).
+//
+// The sim advances only by explicit integer ticks (PP::Step); the driver is
+// the UE-side accumulator that decides WHEN to step. It keeps a clamped
+// float accumulator (Delta = Min(Delta, 0.25) — the [FinLT] trap honored:
+// float lives in orchestration, never sim state) and derives
+// TargetTick = floor(AccumulatedSeconds * kLogicHz); it calls PP::Step 0..N
+// times per frame. Pause = stop calling Advance. The sim never reads a
+// clock (ODN-1).
+//
+// Testable: the accumulator math is pure (Advance returns how many ticks
+// elapsed); the automation test drives it with synthetic deltas.
+#pragma once
+
+#include "PacketPlumberCore/PP_Sim.h"
+
+// FPPSimDriver — a fixed-rate accumulator over a PP::FSimState.
+//
+// Usage (per frame):
+//   Driver.Advance(State, DeltaSeconds);   // steps 0..N times internally
+//   ... read State ...                     // the sim is at its fresh tick
+class FPPSimDriver
+{
+  public:
+	FPPSimDriver() = default;
+
+	// Advance the accumulator by DeltaSeconds (clamped to 0.25s/frame) and
+	// step the sim to the resulting TargetTick. Returns the number of ticks
+	// executed this call. Sim-safe: no floats enter the sim (PP::Step takes
+	// integer ticks only).
+	int32 Advance(PP::FSimState &State, float DeltaSeconds)
+	{
+		DeltaSeconds = FMath::Min(DeltaSeconds, MaxFrameDelta);
+		AccumulatedSeconds += DeltaSeconds;
+		const uint64_t TargetTick =
+			static_cast<uint64_t>(FMath::FloorToDouble(static_cast<double>(AccumulatedSeconds) * SimHz));
+		int32 Stepped = 0;
+		while (State.Tick < TargetTick && !State.bTerminal)
+		{
+			// the terminal barrier (E17) freezes the run — Step returns
+			// without advancing, so the loop MUST also stop (r2 warning: a
+			// terminal run infinite-looped here; story 1.4's game-over will
+			// hit it).
+			const uint64_t Before = State.Tick;
+			PP::Step(State, State.Tick + 1);
+			if (State.Tick == Before)
+			{
+				break; // defensive: a step that didn't advance must not spin
+			}
+			++Stepped;
+		}
+		return Stepped;
+	}
+
+	// Reset the accumulator (a fresh run / retry arena — ODN-13).
+	void Reset()
+	{
+		AccumulatedSeconds = 0.0f;
+	}
+
+  private:
+	// The fixed sim rate (ODN-2, pinned in Config/DefaultEngine.ini + PP_Balance.h).
+	static constexpr float SimHz = static_cast<float>(PP::kLogicHz);
+	// Per-frame delta clamp — the [FinLT] trap: a hitch (e.g. a shader
+	// stall) must never dump a giant delta into the accumulator (which would
+	// burn a huge catch-up step batch); the sim is 20 Hz, so 0.25 s = 5
+	// steps/frame is already generous.
+	static constexpr float MaxFrameDelta = 0.25f;
+
+	float AccumulatedSeconds = 0.0f;
+};
diff --git a/Source/PacketPlumber/Public/PPViewGeometry.h b/Source/PacketPlumber/Public/PPViewGeometry.h
new file mode 100644
index 0000000..7ae0f08
--- /dev/null
+++ b/Source/PacketPlumber/Public/PPViewGeometry.h
@@ -0,0 +1,101 @@
+// PPViewGeometry.h — the view's pure geometry math, extracted for tests
+// (r2 warning: UPPRunView had zero automation coverage — the road-anchor and
+// dot-offset regressions shipped because the math was inline in the widget).
+//
+// Everything here is a pure function of its inputs (no widget state): the
+// fit mapping, the road ribbon's slot anchor, and the packet's grid
+// position. The view calls these; the PacketPlumber.View.Geometry test
+// pins them — a regression in any of the r2 geometry bugs (road anchor,
+// dot +0.5 double-shift) fails the suite before a single frame is captured.
+#pragma once
+
+#include "CoreMinimal.h"
+
+#include "PPCommandBus.h" // FPPScreenFit
+#include "PPViewSnapshot.h"
+
+namespace PPViewGeometry
+{
+
+// MM-style cubic ease-in-out (presentation-only, never sim state).
+inline float EaseInOut(float T)
+{
+	T = FMath::Clamp(T, 0.0f, 1.0f);
+	return T < 0.5f ? 4.0f * T * T * T : 1.0f - FMath::Pow(-2.0f * T + 2.0f, 3.0f) / 2.0f;
+}
+
+// The road ribbon's CanvasPanelSlot top-left anchor. The slot position is
+// the TOP-LEFT of the widget's layout box; the box must be placed so its
+// CENTER (the pivot the UMG rotation uses) sits on the road midpoint. For a
+// box of (Length, BoxHeight) that is Center - (Length/2, BoxHeight/2).
+// (r2 blocker: the view anchored with Width/2 on the length axis, shifting
+// every road ~(Length-Width)/2 along its axis, disconnecting roads from
+// nodes.)
+inline FVector2D RoadSlotTopLeft(const FVector2D &Center, float Length, float BoxHeight)
+{
+	return Center - FVector2D(Length * 0.5f, BoxHeight * 0.5f);
+}
+
+// The fill ribbon's box height for a road of the given width (the casing is
+// BoxHeight = Width + 2*CasingThickness; the fill is the width itself).
+inline float RoadFillHeight(float Width)
+{
+	return Width;
+}
+
+inline float RoadCasingHeight(float Width, float CasingThickness)
+{
+	return Width + 2.0f * CasingThickness;
+}
+
+// The packet's display position in GRID coordinates (raw — the +0.5
+// tile-center offset belongs to the fit mapping, applied exactly ONCE by
+// GridToScreenV; r2 warning: the view baked +0.5 in here AND the fit added
+// it again, so the dot rode half a tile off the road). Pure function of the
+// snapshot — the sim is never read.
+inline FVector2D PacketGridPos(const PPView::FSnapshot &Snap, uint64_t PacketId)
+{
+	const PPView::FPacketView *Found = nullptr;
+	for (const PPView::FPacketView &P : Snap.Packets)
+	{
+		if (P.Id == PacketId)
+		{
+			Found = &P;
+			break;
+		}
+	}
+	if (!Found)
+	{
+		return FVector2D::ZeroVector; // not in this snapshot (spawned/culled)
+	}
+	const PPView::FPacketView &P = *Found;
+	FVector2D From = FVector2D::ZeroVector;
+	FVector2D To = FVector2D::ZeroVector;
+	bool bFrom = false, bTo = false;
+	for (const PPView::FNodeView &Node : Snap.Nodes)
+	{
+		if (Node.Id == P.FromNode)
+		{
+			From = FVector2D(static_cast<float>(Node.Pos.X), static_cast<float>(Node.Pos.Y));
+			bFrom = true;
+		}
+		if (Node.Id == P.ToNode)
+		{
+			To = FVector2D(static_cast<float>(Node.Pos.X), static_cast<float>(Node.Pos.Y));
+			bTo = true;
+		}
+	}
+	if (!bFrom)
+	{
+		return FVector2D::ZeroVector;
+	}
+	if (!bTo || P.FromNode == P.ToNode)
+	{
+		return From;
+	}
+	// EASE the edge progress (the MM arrival-settle feel) — the caller
+	// composes this with the inter-snapshot fraction.
+	return FMath::Lerp(From, To, EaseInOut(P.Progress));
+}
+
+} // namespace PPViewGeometry
diff --git a/Source/PacketPlumber/Public/PPViewSnapshot.h b/Source/PacketPlumber/Public/PPViewSnapshot.h
new file mode 100644
index 0000000..da2cd2e
--- /dev/null
+++ b/Source/PacketPlumber/Public/PPViewSnapshot.h
@@ -0,0 +1,58 @@
+// PPViewSnapshot.h — the immutable view snapshot (U-E9 / UAD-1).
+//
+// The View layer reads ONLY this struct — it never touches the sim state
+// directly (view-reads-snapshot, ODN-1). The GameMode builds one per step
+// from PP::FSimState; widgets interpolate between the last two snapshots for
+// 60 fps (sim is 20 Hz — UAD-2) with presentation-only easing (UAD-22).
+//
+// This is engine-side (UE types allowed) — the sim set stays pure.
+#pragma once
+
+#include "CoreMinimal.h"
+
+#include "PacketPlumberCore/PP_Topology.h"
+
+namespace PPView
+{
+
+// One node as the view sees it: grid position + kind (palette comes from the
+// view layer, never from the sim).
+struct FNodeView
+{
+	uint32_t Id = 0;
+	PP::FNodeKind Kind = PP::FNodeKind::Terminal;
+	PP::FIntPoint Pos; // integer grid position (1 tile = 26 px, PP::kTilePx)
+};
+
+// One pipe as the view sees it (endpoint node ids).
+struct FPipeView
+{
+	uint32_t Id = 0;
+	uint32_t A = 0;
+	uint32_t B = 0;
+};
+
+// One packet as the view sees it: its current node (or the edge it rides)
+// + progress along that edge, so the view can place + ease the dot.
+struct FPacketView
+{
+	uint64_t Id = 0;
+	uint32_t FromNode = 0; // the node it departed (or sits at)
+	uint32_t ToNode = 0;   // the node it heads to (== FromNode when at a node)
+	float Progress = 0.0f; // 0..1 across the edge (presentation-only derived)
+	bool bOnEdge = false;
+};
+
+// The snapshot: everything the view needs for one sim tick. Plain data,
+// built fresh per step, copied (never referenced) by the view.
+struct FSnapshot
+{
+	uint64_t Tick = 0;
+	uint32_t TopologyGen = 0; // the sim's Topology.Gen — the rebuild trigger
+	int32 Score = 0;
+	TArray<FNodeView> Nodes;
+	TArray<FPipeView> Pipes;
+	TArray<FPacketView> Packets;
+};
+
+} // namespace PPView
