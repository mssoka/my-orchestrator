@@ -0,0 +1,109 @@
+#!/usr/bin/env python3
+"""scripts/verify-capture-geometry.py — the capture-pipeline geometry gate.
+
+Verifies a committed T2 frame's geometry (Perkins r2: "add an
+endpoint-vs-node-center geometric check to the capture pipeline"). For the
+slice-1 fixture (3 nodes in a row), the check proves the RENDERED roads
+connect the RENDERED node centers:
+
+  1. locate the amber source + blue sink discs (the terminal colors),
+  2. locate the white road runs on the node row,
+  3. assert the roads' outer caps emerge from the node disc edges (the discs
+     are drawn OVER the road ends, so the road must appear within
+     disc_radius + road_cap of each node center — NOT offset by ~41px as in
+     the r2 road-anchor bug),
+  4. assert the dot (packet-blue) rides the road row (the r2 +0.5 bug made
+     it ride half a tile below).
+
+Exit 0 = the frame's geometry is connected; nonzero = a defect (a regression
+like the r2 road anchor fails here before any human eye is needed).
+"""
+import sys
+from pathlib import Path
+
+from PIL import Image
+
+# Canon palette (view-layer tokens — the capture renders them near-exact)
+AMBER = (245, 208, 133)
+BLUE = (185, 210, 229)
+DOT = (134, 183, 216)
+WHITE = (255, 255, 255)
+# the road-anchor bug shifted roads by ~(Length-Width)/2 ≈ 41px; the
+# connected-geometry tolerance is a small fraction of that.
+TOL_PX = 12
+
+
+def near(p, t, tol=22):
+    return all(abs(p[i] - t[i]) <= tol for i in range(3))
+
+
+def find_disc(img, color, y0, y1, x0, x1):
+    pts = [(x, y) for y in range(y0, y1) for x in range(x0, x1) if near(img.getpixel((x, y)), color)]
+    if not pts:
+        return None
+    xs = [p[0] for p in pts]
+    ys = [p[1] for p in pts]
+    return (min(xs) + max(xs)) // 2, (min(ys) + max(ys)) // 2, (max(xs) - min(xs)) // 2
+
+
+def main() -> int:
+    if len(sys.argv) != 2:
+        print("usage: verify-capture-geometry.py <frame.png>", file=sys.stderr)
+        return 2
+    img = Image.open(sys.argv[1]).convert("RGB")
+    W, H = img.size
+    fails = []
+
+    src = find_disc(img, AMBER, 0, H, 0, W)
+    snk = find_disc(img, BLUE, 0, H, 0, W)
+    if not src or not snk:
+        print("FAIL: source/sink discs not found (is this the fixture frame?)")
+        return 1
+    sx, sy, sr = src
+    kx, ky, kr = snk
+    print(f"source disc center=({sx},{sy}) r={sr}; sink disc center=({kx},{ky}) r={kr}")
+
+    # road row: the row(s) with a long white run between the nodes
+    road_row = None
+    for y in range(max(0, sy - 15), min(H, sy + 15)):
+        xs = [x for x in range(sx - 20, kx + 20) if img.getpixel((x, y)) == WHITE]
+        if len(xs) > (kx - sx) * 0.4:
+            road_row = y
+            left_run = min(xs)
+            right_run = max(xs)
+            break
+    if road_row is None:
+        print("FAIL: no road row found between the nodes")
+        return 1
+    print(f"road row y={road_row}: white run x[{left_run}-{right_run}]")
+
+    # the roads must emerge from the node discs (road cap within TOL of the
+    # disc edge). The r2 bug left the roads ~41px short.
+    if left_run > sx + sr + TOL_PX:
+        fails.append(f"left road cap at {left_run} is {left_run - (sx + sr)}px past the source disc edge (r={sr})")
+    if right_run < kx - kr - TOL_PX:
+        fails.append(f"right road cap at {right_run} is {(kx - kr) - right_run}px short of the sink disc edge (r={kr})")
+
+    # the packet dot (if present) must ride the road row (the r2 +0.5 bug put
+    # it half a tile below). A frame without a dot passes this leg.
+    dot = [(x, y) for y in range(0, H) for x in range(0, W) if near(img.getpixel((x, y)), DOT, tol=30)]
+    if dot:
+        ys = [p[1] for p in dot]
+        cy = (min(ys) + max(ys)) // 2
+        if abs(cy - road_row) > 8:
+            fails.append(f"packet dot rides y={cy}, {abs(cy - road_row)}px off the road row y={road_row}")
+        print(f"dot: n={len(dot)} center y={cy} (road row y={road_row})")
+    else:
+        print("dot: absent this frame (leg skipped)")
+
+    if fails:
+        print("GEOMETRY FAIL:")
+        for f in fails:
+            print(f"  - {f}")
+        return 1
+    print("GEOMETRY OK: roads connect the node centers; the dot rides the road.")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
