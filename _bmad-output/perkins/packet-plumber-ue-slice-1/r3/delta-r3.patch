+// PPViewGeometryTests.cpp — the view's pure geometry math, pinned (r2 warning
+// 9: UPPRunView had zero automation coverage — the road-anchor and dot-offset
+// regressions shipped because the math was inline in the widget).
+//
+// Covers the r2 blocker + warnings at the math layer:
+//  - the road ribbon's slot anchor places the box center on the road midpoint
+//    (the r2 blocker: anchored with Width/2 on the length axis, every road
+//    shifted ~(Length-Width)/2 along its axis, disconnecting roads from nodes)
+//  - the fit mapping adds the +0.5 tile-center offset EXACTLY ONCE (the r2
+//    warning: PacketPosIn baked +0.5 in AND the fit added it again — the dot
+//    rode half a tile off the road)
+//  - the packet's grid position rides the edge at eased progress
+//  - the E4 snap radius scales with the camera fit (world-px canon)
+#include "Misc/AutomationTest.h"
+
+#include "PacketPlumberCore/PP_Sim.h"
+#include "PPCommandBus.h"
+#include "PPViewGeometry.h"
+
+#if WITH_DEV_AUTOMATION_TESTS
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPViewRoadAnchor, "PacketPlumber.View.RoadAnchor",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPViewRoadAnchor::RunTest(const FString &Parameters)
+{
+	// The r2 blocker: a road from A to B must have its rendered center at the
+	// midpoint AND its endpoints at the node centers. The slot anchor is the
+	// box top-left; Center - (Length/2, Height/2) places the box center on
+	// the midpoint.
+	const FVector2D A(100.f, 100.f);
+	const FVector2D B(300.f, 100.f); // horizontal road, length 200
+	const FVector2D Center = (A + B) * 0.5f;
+	const float Width = 14.f;
+
+	// fill box: size (Length, Width) anchored at Center - (L/2, W/2) -> box
+	// center at Center (the rotation pivot sits on the road midpoint).
+	const FVector2D FillTopLeft = PPViewGeometry::RoadSlotTopLeft(Center, 200.f, Width);
+	TestTrue(TEXT("fill anchor x = Center.X - Length/2"), FMath::IsNearlyEqual(FillTopLeft.X, Center.X - 100.f));
+	TestTrue(TEXT("fill anchor y = Center.Y - Width/2"), FMath::IsNearlyEqual(FillTopLeft.Y, Center.Y - 7.f));
+	const FVector2D FillBoxCenter = FillTopLeft + FVector2D(100.f, 7.f);
+	TestTrue(TEXT("fill box center must sit on the road midpoint"), FillBoxCenter.Equals(Center, 0.01f));
+	// the box spans A..B -> the road's rendered endpoints ARE the node centers
+	TestTrue(TEXT("fill box left edge = node A"), FMath::IsNearlyEqual(FillTopLeft.X, A.X));
+	TestTrue(TEXT("fill box right edge = node B"), FMath::IsNearlyEqual(FillTopLeft.X + 200.f, B.X));
+
+	// casing box: (Length, Width+4) anchored the same way
+	const float CasingH = PPViewGeometry::RoadCasingHeight(Width, 2.f);
+	TestTrue(TEXT("casing height = width + 2*casing"), FMath::IsNearlyEqual(CasingH, 18.f));
+	const FVector2D CasingTopLeft = PPViewGeometry::RoadSlotTopLeft(Center, 200.f, CasingH);
+	TestTrue(TEXT("casing box center must sit on the road midpoint"),
+			 (CasingTopLeft + FVector2D(100.f, CasingH * 0.5f)).Equals(Center, 0.01f));
+
+	// a DIAGONAL road (the pivot rotation case): the box center must be the
+	// midpoint regardless of the angle.
+	const FVector2D C(0.f, 0.f);
+	const FVector2D D(80.f, 60.f); // length 100
+	const FVector2D DiagCenter = (C + D) * 0.5f;
+	const FVector2D DiagTopLeft = PPViewGeometry::RoadSlotTopLeft(DiagCenter, 100.f, Width);
+	TestTrue(TEXT("diagonal road: box center on the midpoint"),
+			 (DiagTopLeft + FVector2D(50.f, Width * 0.5f)).Equals(DiagCenter, 0.01f));
+	return true;
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPViewDotOnRoad, "PacketPlumber.View.DotOnRoad",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPViewDotOnRoad::RunTest(const FString &Parameters)
+{
+	// The r2 warning: the dot rode half a tile off the road because the
+	// position math added the +0.5 tile-center offset twice (once in the
+	// packet position, once in the fit mapping). The fit mapping adds it
+	// EXACTLY ONCE — a packet mid-edge must land ON the road between the two
+	// node centers.
+	const FPPScreenFit Fit = MakeScreenFit(FVector2D(1280.f, 720.f)); // scale 0.9231, offset (160,0)
+
+	// a snapshot: nodes at grid (2,2) and (6,2), a packet half-way along
+	PPView::FSnapshot Snap;
+	Snap.Tick = 1;
+	PPView::FNodeView N0;
+	N0.Id = 0;
+	N0.Pos = PP::FIntPoint{2, 2};
+	Snap.Nodes.Add(N0);
+	PPView::FNodeView N1;
+	N1.Id = 1;
+	N1.Pos = PP::FIntPoint{6, 2};
+	Snap.Nodes.Add(N1);
+	PPView::FPacketView P;
+	P.Id = 7;
+	P.FromNode = 0;
+	P.ToNode = 1;
+	P.Progress = 0.5f;
+	P.bOnEdge = true;
+	Snap.Packets.Add(P);
+
+	const FVector2D GridPos = PPViewGeometry::PacketGridPos(Snap, 7);
+	TestTrue(TEXT("packet grid pos must be the edge midpoint (4,2)"), GridPos.Equals(FVector2D(4.f, 2.f), 0.001f));
+
+	// screen space: the dot must sit ON the road segment between the nodes
+	const FVector2D DotScreen = Fit.GridToScreenV(GridPos);
+	const FVector2D N0Screen = Fit.GridToScreen(N0.Pos);
+	const FVector2D N1Screen = Fit.GridToScreen(N1.Pos);
+	TestTrue(TEXT("dot screen x must be between the nodes"), DotScreen.X > N0Screen.X && DotScreen.X < N1Screen.X);
+	TestTrue(TEXT("dot screen x must be the midpoint of the node centers"),
+			 FMath::IsNearlyEqual(DotScreen.X, (N0Screen.X + N1Screen.X) * 0.5f, 0.5f));
+	TestTrue(TEXT("dot screen y must equal the road row (both nodes at y=2)"),
+			 FMath::IsNearlyEqual(DotScreen.Y, N0Screen.Y, 0.5f));
+
+	// a packet absent from the snapshot -> zero (the caller falls back)
+	TestTrue(TEXT("absent packet must yield zero"), PPViewGeometry::PacketGridPos(Snap, 999) == FVector2D::ZeroVector);
+	return true;
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPViewSnapScale, "PacketPlumber.View.SnapRadiusScale",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPViewSnapScale::RunTest(const FString &Parameters)
+{
+	// E4: the snap radius is in WORLD px (kSnapRadius); the snap compares in
+	// SCREEN px, so the radius scales with the camera fit (r2 warning 3).
+	// At the 1280x720 design fit (scale 0.9231) the screen radius is ~33 px.
+	const FPPScreenFit Fit = MakeScreenFit(FVector2D(1280.f, 720.f));
+	TestTrue(TEXT("design-fit snap radius must scale to ~33 screen px"),
+			 FMath::IsNearlyEqual(static_cast<float>(PP::kSnapRadius) * Fit.Scale, 33.23f, 0.1f));
+
+	// A node at grid (2,2): its screen center; a point 30 screen px away is
+	// INSIDE the scaled radius; 40 px away is OUTSIDE.
+	PP::FTopology Topo;
+	PP::SpawnNode(Topo, PP::FNodeKind::Terminal, 2, 2);
+	const FVector2D NodeScreen = Fit.GridToScreen(PP::FIntPoint{2, 2});
+
+	uint32_t Hit = 0;
+	const bool bIn = FPPCommandBus::SnapToNode(Topo, NodeScreen + FVector2D(30.f, 0.f), FVector2D(1280.f, 720.f), Hit);
+	TestTrue(TEXT("30 px from the node center must snap (inside the scaled radius)"), bIn);
+	TestEqual(TEXT("the snapped node must be the terminal"), Hit, 0u);
+
+	uint32_t Hit2 = 0;
+	const bool bOut =
+		FPPCommandBus::SnapToNode(Topo, NodeScreen + FVector2D(40.f, 0.f), FVector2D(1280.f, 720.f), Hit2);
+	TestTrue(TEXT("40 px from the node center must NOT snap (outside the scaled radius)"), !bOut);
+	return true;
+}
+
+#endif // WITH_DEV_AUTOMATION_TESTS
