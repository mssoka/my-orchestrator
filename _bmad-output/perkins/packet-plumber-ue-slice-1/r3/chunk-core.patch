 namespace PP
 {
 
+// ApplyEdit — the LIVE edit fast-path (the app's command bus calls this):
+// validate-then-apply against the current topology, then log the command
+// with apply_tick = next tick (ODN-2). The topology mutates immediately
+// (the edit is visible this frame); the derived views rebuild at the next
+// Step (rule 1). Replay re-applies the logged command at its tick via the
+// SAME validate-then-apply — live and replay cannot diverge on legality.
+inline FEditResult ApplyEdit(FSimState &State, const FCommand &Cmd)
+{
