@@ -0,0 +1,101 @@
+// PP_Scenario.h — the shared slice-1 GOLDEN SCENARIO (dual-runner).
+//
+// One deterministic scenario builder used by ALL THREE golden surfaces:
+//   (a) tests/spine_check.cpp (standalone g++),
+//   (b) the PacketPlumber.* automation tests (engine),
+//   (c) the PPProbe commandlet (engine, -seed=42 -ticks=100).
+// Because the fixture, the draw commands, and the demand plan are built by
+// THIS header on every surface, identical numbers are guaranteed by
+// construction (UAD-17) — the routing-table dump and the extended golden
+// JSON (topology/forwarding summary + catalog_hash) cannot drift between
+// the runners.
+//
+// Scenario (deterministic, seed-independent):
+//   - fixture: source terminal (2,2), router junction (6,2), sink terminal
+//     (10,2) — spawned via SpawnNode (run setup, NOT in the action log, like
+//     the seed; re-created identically on every replay)
+//   - draw commands: source->router + router->sink (standard tier), logged
+//     with apply_tick=1 and applied by Step's replay path at tick 1
+//   - demand: class-0 packets source->sink every 10 ticks (5..95), plus one
+//     at tick 98 (in-flight at the 100-tick boundary — the golden covers a
+//     live packet's serialized bytes, not just an empty flow)
+// The 100-tick run delivers 10 packets (score 10) and leaves 1 packet at
+// the router at the final tick.
+#pragma once
+
+#include <cstdint>
+
+#include "PacketPlumberCore/PP_Sim.h"
+
+namespace PP
+{
+
+// Fixture node ids (spawn order: 0,1,2).
+inline constexpr uint32_t SCENARIO_SOURCE = 0;
+inline constexpr uint32_t SCENARIO_ROUTER = 1;
+inline constexpr uint32_t SCENARIO_SINK = 2;
+
+// BuildProbeScenario — construct the golden scenario's RUN SETUP: the
+// fixture (spawned nodes) + the logged draw commands + the demand plan.
+// The action log is populated with apply_tick=1 draws; the runner feeds the
+// log entries to Step at their tick (the replay path — the same one replay
+// uses, so the golden proves command application, not just the heartbeat).
+// SpawnFixture — the SHARED static fixture (UAD-17; r1 warning: PIE
+// hand-copied these positions): 1 source terminal, 1 router junction, 1
+// sink terminal at the golden scenario's grid positions. Run setup — never
+// in the action log (like the seed, re-created identically on every replay).
+inline void SpawnFixture(FSimState &State)
+{
+	SpawnNode(State.Topology, FNodeKind::Terminal, 2, 2);  // SCENARIO_SOURCE
+	SpawnNode(State.Topology, FNodeKind::Junction, 6, 2);  // SCENARIO_ROUTER
+	SpawnNode(State.Topology, FNodeKind::Terminal, 10, 2); // SCENARIO_SINK
+}
+
+inline void BuildProbeScenario(FSimState &State, uint64_t Seed = 42)
+{
+	State.Initialize(Seed);
+	SpawnFixture(State);
+
+	// draw commands — logged (apply_tick=1), applied by Step at tick 1
+	State.ActionLog.push_back(
+		FLoggedCommand{1, FCommand{FCommandKind::DrawPipe, SCENARIO_SOURCE, SCENARIO_ROUTER, TIER_STANDARD}});
+	State.ActionLog.push_back(
+		FLoggedCommand{1, FCommand{FCommandKind::DrawPipe, SCENARIO_ROUTER, SCENARIO_SINK, TIER_STANDARD}});
+
+	// demand — run setup (never in the action log): 1 packet/10 ticks from
+	// tick 5..95, +1 at 98 (in-flight at the 100-tick boundary).
+	for (uint64_t T = 5; T <= 95; T += 10)
+	{
+		FlowSeedDemand(State.Flow, T, SCENARIO_SOURCE, SCENARIO_SINK, 0);
+	}
+	FlowSeedDemand(State.Flow, 98, SCENARIO_SOURCE, SCENARIO_SINK, 0);
+}
+
+// StepScenario — run the scenario's action log + ticks through the replay
+// path: for each tick (State.Tick + 1)..Ticks, feed Step every log entry
+// with apply_tick == Tick (the replay convention, ODN-2). This is the exact
+// path a recorded run re-sims through. Resumes from the state's current
+// tick, so callers may step incrementally (StepScenario(S, 5) then
+// StepScenario(S, 10)).
+inline void StepScenario(FSimState &State, uint64_t Ticks)
+{
+	for (uint64_t Tick = State.Tick + 1; Tick <= Ticks; ++Tick)
+	{
+		// gather this tick's commands from the log (array scan — the log is
+		// small; a per-tick index is [LATER] if a run ever has huge logs).
+		// DYNAMIC: the r1 warning flagged a fixed 16-command cap that would
+		// silently DROP log entries beyond it (a replay divergence exactly
+		// ReplayError exists to catch). The vector grows — no cap.
+		std::vector<FCommand> Cmds;
+		for (const FLoggedCommand &E : State.ActionLog)
+		{
+			if (E.ApplyTick == Tick)
+			{
+				Cmds.push_back(E.Cmd);
+			}
+		}
+		Step(State, Tick, Cmds.data(), static_cast<int32_t>(Cmds.size()));
+	}
+}
+
+} // namespace PP
