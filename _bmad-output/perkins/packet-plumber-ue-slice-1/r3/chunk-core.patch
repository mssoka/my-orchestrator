+// PP_Topology.h — S1 Topology Graph (ODN-1, architecture §6.1), slice-1
+// scope: nodes (terminal/junction) + pipes, the edit authority
+// (validate-then-apply), and the pinned integer distance metric. Ported from
+// the Odin canon core/topology.odin (read-only reference), re-expressed
+// UE-native.
+//
+// Data layout: parallel arrays indexed by slot (insertion-ordered — the sim
+// iterates ARRAYS only, ODN-10); there are NO maps. Ids are monotonic per
+// run, never recycled (E11): next_node_id/next_pipe_id only climb; a dead
+// entity's slot is tombstoned (alive=false), its id never reused. (Demolish
+// lands in story 2.3; the tombstone flags are in place now so the serialized
+// slot layout is stable from slice 1.)
+//
+// The terminals-via-routers canon (E26): terminals connect via routers only —
+// never terminal-to-terminal. validate_draw rejects a terminal↔terminal drag
+// with TerminalToTerminal. Self-loops reject (E3); spans beyond the tier's
+// max_span reject (the E3-family span rule).
+//
+// UE-header-free (no UE include, no UObject, no clock/IO) — the standalone
+// g++ build is the parse gate (ODN-1). Integer-only (ODN-10).
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+#include "PacketPlumberCore/PP_Balance.h"
+
+namespace PP
+{
+
+// Integer grid point (ODN-10 — the view converts to world space, 1 tile = 26 UU).
+struct FIntPoint
+{
+	int32_t X = 0;
+	int32_t Y = 0;
+};
+
+enum class FNodeKind : uint8_t
+{
+	Terminal = 0,
+	Junction = 1, // router
+};
+
+enum class FEditError : uint8_t
+{
+	None = 0,
+	SelfLoop,			// E3
+	TerminalToTerminal, // E26
+	MissingNode,
+	SpanExceedsTier, // E3-family span rule
+	UnknownTier,
+	RouterPortsFull, // (5.6; reserved — port ceilings land with router tiers)
+};
+
+struct FEditResult
+{
+	FEditError Error = FEditError::None;
+	uint32_t PipeId = 0;
+};
+
+// S1 Topology — nodes + pipes as parallel arrays (slot = index).
+struct FTopology
+{
+	// nodes
+	std::vector<uint8_t> NodeAlive; // 0/1
+	std::vector<uint32_t> NodeId;
+	std::vector<uint8_t> NodeKind; // FNodeKind
+	std::vector<int32_t> NodePosX;
+	std::vector<int32_t> NodePosY;
+	uint32_t NextNodeId = 0;
+
+	// pipes
+	std::vector<uint8_t> PipeAlive; // 0/1
+	std::vector<uint32_t> PipeId;
+	std::vector<uint32_t> PipeA; // node ids (resolved, post-snap)
+	std::vector<uint32_t> PipeB;
+	std::vector<uint16_t> PipeTier; // TIER_* index
+	std::vector<int32_t> PipeSpan;	// cached integer Euclidean (rounded)
+	uint32_t NextPipeId = 0;
+
+	// gen — increments on EVERY mutation (spawn/draw; future demolish). The
+	// routing-table rebuild trigger (4-rule spine rule 1): step rebuilds the
+	// derived views only when this moves.
+	uint32_t Gen = 0;
+};
+
+inline int32_t NodeCount(const FTopology &T)
+{
+	int32_t N = 0;
+	for (uint8_t A : T.NodeAlive)
+	{
+		if (A)
+		{
+			++N;
+		}
+	}
+	return N;
+}
+
+inline int32_t PipeCount(const FTopology &T)
+{
+	int32_t N = 0;
+	for (uint8_t A : T.PipeAlive)
+	{
+		if (A)
+		{
+			++N;
+		}
+	}
+	return N;
+}
+
+// id -> slot, only for LIVE nodes (linear; the core is map-free — ODN-10).
+inline bool NodeSlot(const FTopology &T, uint32_t Id, uint32_t &OutSlot)
+{
+	for (uint32_t I = 0; I < T.NodeId.size(); ++I)
+	{
+		if (T.NodeAlive[I] && T.NodeId[I] == Id)
+		{
+			OutSlot = I;
+			return true;
+		}
+	}
+	return false;
+}
+
+// id -> slot, only for LIVE pipes (linear; map-free).
+inline bool PipeSlot(const FTopology &T, uint32_t Id, uint32_t &OutSlot)
+{
+	for (uint32_t I = 0; I < T.PipeId.size(); ++I)
+	{
+		if (T.PipeAlive[I] && T.PipeId[I] == Id)
+		{
+			OutSlot = I;
+			return true;
+		}
+	}
+	return false;
+}
+
+inline bool IsTerminal(const FTopology &T, uint32_t Slot)
+{
+	return T.NodeKind[Slot] == static_cast<uint8_t>(FNodeKind::Terminal);
+}
+
+// --- the pinned integer distance metric (arch §6.1) -------------------------
+// All span/cost/snap math uses integer Euclidean; no sqrt in the comparison
+// path (compare squares), and an integer Newton isqrt for the length. Exact,
+// cheap, identical on every target (ODN-10).
+
+inline int64_t Dist2(const FIntPoint &A, const FIntPoint &B)
+{
+	const int64_t Dx = static_cast<int64_t>(A.X) - B.X;
+	const int64_t Dy = static_cast<int64_t>(A.Y) - B.Y;
+	return Dx * Dx + Dy * Dy;
+}
+
+inline int64_t ISqrt(int64_t X)
+{
+	if (X <= 0)
+	{
+		return 0;
+	}
+	int64_t R = X;
+	int64_t Y = (R + 1) / 2;
+	while (Y < R)
+	{
+		R = Y;
+		Y = (R + X / R) / 2;
+	}
+	return R;
+}
+
+// Rounded Euclidean distance between two grid points (round half up),
+// computed integer-only. One metric serves span validation and the snap
+// radius (E4).
+inline int32_t SpanBetween(const FIntPoint &A, const FIntPoint &B)
+{
+	const int64_t D2 = Dist2(A, B);
+	int64_t R = ISqrt(D2);
+	if (D2 - R * R > R) // round half up
+	{
+		R += 1;
+	}
+	return static_cast<int32_t>(R);
+}
+
+// --- node spawning (the harness/app seed the fixture; core is the authority)
+// topology_spawn_node — append a node. Returns the new monotonic id. The
+// fixture is deterministic by construction (the caller passes fixed
+// positions); it is NOT part of the action log — like the seed, it is run
+// setup, re-created identically on every replay.
+inline uint32_t SpawnNode(FTopology &T, FNodeKind Kind, int32_t X, int32_t Y)
+{
+	const uint32_t Id = T.NextNodeId;
+	T.NextNodeId += 1;
+	T.NodeAlive.push_back(1);
+	T.NodeId.push_back(Id);
+	T.NodeKind.push_back(static_cast<uint8_t>(Kind));
+	T.NodePosX.push_back(X);
+	T.NodePosY.push_back(Y);
+	T.Gen += 1; // a new node can open new paths -> rebuild the forwarding table
+	return Id;
+}
+
+// --- the edit authority: validate-then-apply (single source of truth) ------
+// The command bus merely resolves a pointer to a node id (snap, E4); the
+// core's ValidateDraw is the ONLY legality check, so live edits and replay
+// can never diverge on legality (the action log stores post-snap,
+// post-validation truth).
+
+inline FEditError ValidateDraw(const FTopology &T, uint32_t A, uint32_t B, uint16_t Tier)
+{
+	if (A == B)
+	{
+		return FEditError::SelfLoop; // E3
+	}
+	uint32_t Sa = 0, Sb = 0;
+	if (!NodeSlot(T, A, Sa) || !NodeSlot(T, B, Sb))
+	{
+		return FEditError::MissingNode;
+	}
+	if (IsTerminal(T, Sa) && IsTerminal(T, Sb))
+	{
+		return FEditError::TerminalToTerminal; // E26
+	}
+	if (Tier >= TIER_COUNT)
+	{
+		return FEditError::UnknownTier;
+	}
+	const int32_t Span =
+		SpanBetween(FIntPoint{T.NodePosX[Sa], T.NodePosY[Sa]}, FIntPoint{T.NodePosX[Sb], T.NodePosY[Sb]});
+	if (Span > kTierMaxSpan[Tier])
+	{
+		return FEditError::SpanExceedsTier;
+	}
+	return FEditError::None;
+}
+
+// ApplyDraw — assumes ValidateDraw returned None. Appends a pipe, caching its
+// integer span. The new pipe is live this tick (edit fast-path) and recorded
+// in the action log with apply_tick = next (ODN-2); replay re-applies it at
+// that tick before stepping. A new pipe can open/change paths -> bump gen so
+// the forwarding table rebuilds at the next step (rule 1).
+inline FEditResult ApplyDraw(FTopology &T, uint32_t A, uint32_t B, uint16_t Tier)
+{
+	FEditResult Result;
+	Result.Error = ValidateDraw(T, A, B, Tier);
+	if (Result.Error != FEditError::None)
+	{
+		return Result;
+	}
+	uint32_t Sa = 0, Sb = 0;
+	NodeSlot(T, A, Sa);
+	NodeSlot(T, B, Sb);
+	const int32_t Span =
+		SpanBetween(FIntPoint{T.NodePosX[Sa], T.NodePosY[Sa]}, FIntPoint{T.NodePosX[Sb], T.NodePosY[Sb]});
+	const uint32_t Id = T.NextPipeId;
+	T.NextPipeId += 1;
+	T.PipeAlive.push_back(1);
+	T.PipeId.push_back(Id);
+	T.PipeA.push_back(A);
+	T.PipeB.push_back(B);
+	T.PipeTier.push_back(Tier);
+	T.PipeSpan.push_back(Span);
+	T.Gen += 1; // a new pipe can open / change paths -> rebuild (rule 1)
+	Result.PipeId = Id;
+	return Result;
+}
+
+// pipe endpoint lookup: given a live pipe slot and one endpoint node id,
+// return the far endpoint id (+ ok). Map-free linear scan (ODN-10).
+inline bool PipeOther(const FTopology &T, uint32_t PipeSlot, uint32_t EndpointId, uint32_t &OutOther)
+{
+	const uint32_t A = T.PipeA[PipeSlot];
+	const uint32_t B = T.PipeB[PipeSlot];
+	if (A == EndpointId)
+	{
+		OutOther = B;
+		return true;
+	}
+	if (B == EndpointId)
+	{
+		OutOther = A;
+		return true;
+	}
+	return false;
+}
