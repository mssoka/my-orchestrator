diff --git a/Source/PacketPlumberCore/Public/PacketPlumberCore/PP_Balance.h b/Source/PacketPlumberCore/Public/PacketPlumberCore/PP_Balance.h
new file mode 100644
index 0000000..36cc98f
--- /dev/null
+++ b/Source/PacketPlumberCore/Public/PacketPlumberCore/PP_Balance.h
@@ -0,0 +1,56 @@
+// PP_Balance.h — slice-1 constexpr balance defaults (the pre-catalog seam).
+//
+// Slice-1 stand-in for the Content/Data/*.json catalogs (ODN-5, UAD-5 — the
+// JSON loader + fail-fast validation land with story 3.1). The values here
+// mirror the canon data files EXACTLY (pipe_tiers.json entries + the
+// balance.json keys slice 1 reads) so the sim is canon-true from the first
+// build; 3.1 replaces these constants with loaded catalogs + a real
+// CatalogHash without changing any sim signature that consumes them.
+//
+// Canon sources (Odin build, read-only):
+//   data/pipe_tiers.json: narrow {capacity 10, cost 20, max_span 10},
+//     standard {capacity 15, cost 10, max_span 14},
+//     wide {capacity 40, cost 5, max_span 18}; cost = the per-hop routing
+//     cost (capacity-cost ladder, user ruling 2026-08-13 — lower cost = the
+//     fatter pipe wins); max_span = the hard span cap at edit (E3 family).
+//   data/balance.json: snap_radius 36 (E4, world px), packet_bandwidth 30
+//     (bandwidth units a packet must accumulate to cross one edge — 1.3
+//     flow; transit ticks = ceil(packet_bandwidth / capacity_units)),
+//     logic_hz 20 (ODN-2), map 40x30 tiles at 26 px.
+//
+// All values integer (ODN-10). No floats, no engine types — compiles in the
+// engine module AND the standalone spine-check runner (UAD-17).
+#pragma once
+
+#include <cstdint>
+
+namespace PP
+{
+
+// Pipe-tier indices (mirror the pipe_tiers.json entry order).
+inline constexpr int32_t TIER_NARROW = 0;
+inline constexpr int32_t TIER_STANDARD = 1;
+inline constexpr int32_t TIER_WIDE = 2;
+inline constexpr int32_t TIER_COUNT = 3;
+
+// Per-tier routing cost (the capacity-cost ladder) — used by the forwarding
+// table rebuild (RoutingRebuild).
+inline constexpr int32_t kTierCost[TIER_COUNT] = {20, 10, 5};
+
+// Per-tier capacity in bandwidth-units/tick — used by bundles (static sum,
+// rule 3) and the flow's serve pass.
+inline constexpr int32_t kTierCapacity[TIER_COUNT] = {10, 15, 40};
+
+// Per-tier hard span cap (grid units, integer Euclidean) — enforced at edit
+// (the E3 family span rule; story 1.2 rejects a span-exceeding drag).
+inline constexpr int32_t kTierMaxSpan[TIER_COUNT] = {10, 14, 18};
+
+// balance.json keys slice 1 reads.
+inline constexpr int32_t kSnapRadius = 36;		// world px, inclusive (E4)
+inline constexpr int32_t kPacketBandwidth = 30; // units to cross one edge (1.3)
+inline constexpr int32_t kLogicHz = 20;			// fixed tick rate (ODN-2)
+inline constexpr int32_t kMapTilesX = 40;		// view world (tiles)
+inline constexpr int32_t kMapTilesY = 30;
+inline constexpr int32_t kTilePx = 26; // world px per grid tile
+
+} // namespace PP
diff --git a/Source/PacketPlumberCore/Public/PacketPlumberCore/PP_Bundles.h b/Source/PacketPlumberCore/Public/PacketPlumberCore/PP_Bundles.h
new file mode 100644
index 0000000..c022978
--- /dev/null
+++ b/Source/PacketPlumberCore/Public/PacketPlumberCore/PP_Bundles.h
@@ -0,0 +1,120 @@
+// PP_Bundles.h — the parallel-pipe bundle model (story 2.1 / architecture
+// §6.1 + §6.2, ODN-10, the routing ruling lavish 2026-08-10). Parallel pipes
+// between a node pair BUNDLE into one pooled-capacity link whose capacity is
+// the SUM of its members — "redundancy becomes active capacity the moment a
+// second pipe is drawn." The routing sees ONE fat edge per pair (no load
+// balancing — round-robin/weighted LB are absent; ECMP, in 2.2, is a hash).
+// Ported from the Odin canon core/bundles.odin.
+//
+// This is a DERIVED view over the Topology (a pure function of it), exactly
+// like the routing table: rebuilt only when the topology changes (4-rule
+// spine rule 1 — synchronous inside the tick), and NOT serialized into the
+// T1 hash (the Topology's pipes ARE serialized, so a parallel-pipe draw
+// replays byte-identically without binding replay to the bundle-build
+// algorithm — the same reasoning routing.odin uses).
+//
+// Determinism: array-only (no map iteration — ODN-10); insertion-order build
+// (scan pipes in slot order, assign a new bundle slot on a new canonical
+// pair); integer-only (rule 3 — the static sum is computed once at
+// table-build time from the tier capacities, never per-packet, never
+// mid-flow). Mixed-tier bundles sum each member's own tier capacity (a
+// standard + a wide = 15 + 40 = 55); the bundle's render tier is its highest
+// member tier.
+//
+// UE-header-free (ODN-1); integer-only (ODN-10); std containers only.
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+#include "PacketPlumberCore/PP_Balance.h"
+#include "PacketPlumberCore/PP_Topology.h"
+
+namespace PP
+{
+
+// NO_BUNDLE — the pipe->bundle sentinel for a dead/unset slot. Live pipes are
+// always assigned a real bundle slot by BundlesRebuild (which runs before the
+// flow every step), so a live pipe's pipe_bundle is never NO_BUNDLE.
+inline constexpr uint32_t NO_BUNDLE = 0xFFFFFFFFu;
+
+// FBundles — the derived parallel-pipe bundle view. One row per unordered
+// node pair that has >=1 live pipe between it.
+struct FBundles
+{
+	// pipe slot -> the bundle slot that pipe belongs to (NO_BUNDLE for dead/
+	// unset slots). Sized to PipeAlive.size() at rebuild time.
+	std::vector<uint32_t> PipeBundle;
+	// per bundle slot: the canonical pooled edge (min/max endpoint node ids)
+	std::vector<uint32_t> BundleLo;	   // canonical min-endpoint node id
+	std::vector<uint32_t> BundleHi;	   // canonical max-endpoint node id
+	std::vector<uint32_t> BundleCap;   // STATIC SUM of member tier capacities (rule 3)
+	std::vector<uint32_t> BundleCount; // live member count (the render-width proxy)
+	std::vector<uint16_t> BundleTier;  // highest tier index among members
+	uint32_t N = 0;					   // live bundle count
+};
+
+inline uint32_t BundleOfPipe(const FBundles &B, uint32_t PipeSlot)
+{
+	return PipeSlot < B.PipeBundle.size() ? B.PipeBundle[PipeSlot] : NO_BUNDLE;
+}
+
+// BundlesRebuild — rebuild the bundle view from the current Topology. Called
+// by step on the SAME topology-change trigger as the routing table (rule 1 —
+// one gen, one rebuild pair). The STATIC summed capacity (cap = sum of
+// members) is folded once here from the tier capacities, so the flow
+// consumes the pooled capacity without any per-packet math.
+inline void BundlesRebuild(FBundles &B, const FTopology &T)
+{
+	B.PipeBundle.assign(T.PipeAlive.size(), NO_BUNDLE);
+	B.BundleLo.clear();
+	B.BundleHi.clear();
+	B.BundleCap.clear();
+	B.BundleCount.clear();
+	B.BundleTier.clear();
+	B.N = 0;
+
+	for (uint32_t Pi = 0; Pi < T.PipeAlive.size(); ++Pi)
+	{
+		if (!T.PipeAlive[Pi])
+		{
+			continue;
+		}
+		const uint32_t A = T.PipeA[Pi];
+		const uint32_t BId = T.PipeB[Pi];
+		const uint32_t Lo = A < BId ? A : BId;
+		const uint32_t Hi = A < BId ? BId : A;
+		// find the bundle slot for this canonical pair (linear — arrays only).
+		uint32_t Found = NO_BUNDLE;
+		for (uint32_t Bi = 0; Bi < B.N; ++Bi)
+		{
+			if (B.BundleLo[Bi] == Lo && B.BundleHi[Bi] == Hi)
+			{
+				Found = Bi;
+				break;
+			}
+		}
+		if (Found == NO_BUNDLE)
+		{
+			Found = B.N;
+			B.N += 1;
+			B.BundleLo.push_back(Lo);
+			B.BundleHi.push_back(Hi);
+			B.BundleCap.push_back(static_cast<uint32_t>(kTierCapacity[T.PipeTier[Pi]]));
+			B.BundleCount.push_back(1);
+			B.BundleTier.push_back(T.PipeTier[Pi]);
+		}
+		else
+		{
+			B.BundleCap[Found] += static_cast<uint32_t>(kTierCapacity[T.PipeTier[Pi]]);
+			B.BundleCount[Found] += 1;
+			if (T.PipeTier[Pi] > B.BundleTier[Found])
+			{
+				B.BundleTier[Found] = T.PipeTier[Pi];
+			}
+		}
+		B.PipeBundle[Pi] = Found;
+	}
+}
+
+} // namespace PP
diff --git a/Source/PacketPlumberCore/Public/PacketPlumberCore/PP_Flow.h b/Source/PacketPlumberCore/Public/PacketPlumberCore/PP_Flow.h
new file mode 100644
index 0000000..9e22b47
--- /dev/null
+++ b/Source/PacketPlumberCore/Public/PacketPlumberCore/PP_Flow.h
@@ -0,0 +1,280 @@
+// PP_Flow.h — S2 Packet-Flow Simulation (architecture §6.2), slice-1 scope
+// (story 1.3): a packet spawns from a trivial hardcoded demand, advances by
+// bandwidth-units per tick along the drawn graph, and delivers at the sink.
+// The forwarding is PER-HOP (PP_Routing.h): the packet carries NO cached
+// route — at each node it reaches it consults the fresh forwarding table for
+// the next hop. This is the locked routing model in its trivial single-path
+// form: no BFS route cache, no LB, ever (ECMP is 2.2; bundles 2.1; QoS 3.x).
+// Ported from the Odin canon core/flow.odin (the 1.3-scope path — spawn from
+// legacy demand, forward at-node, serve on-edge, deliver at sink).
+//
+// The packet's in-flight state rides the T1 hash -> replay-equality over the
+// flow (E10). Integer-only (ODN-10); arrays only (no map iteration — ODN-10);
+// no file/clock reads (ODN-1). No events stream yet (ODN-14 lands with the
+// slice that needs it); the delivered count (score) is the win metric (1.4).
+//
+// UE-header-free (ODN-1); integer-only (ODN-10); std containers only.
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+#include "PacketPlumberCore/PP_Balance.h"
+#include "PacketPlumberCore/PP_Bundles.h"
+#include "PacketPlumberCore/PP_Routing.h"
+#include "PacketPlumberCore/PP_Topology.h"
+
+namespace PP
+{
+
+// FPacket — in-flight packet state. NO route[] field (per-hop forwarding).
+// The packet's location is either ON an edge (OnEdge = true; `Edge` is the
+// representative pipe of the BUNDLE being traversed — a live member whose
+// endpoints are the pair, so the pooled capacity resolves via Bundles;
+// `Heading` its far endpoint) or AT a node (OnEdge = false; `AtNode` is where
+// it sits, ready to forward). Node/pipe ids are 0-based, so an explicit
+// `OnEdge` flag carries the on-edge/at-node distinction (0 is a valid id, not
+// a sentinel). ProgressUnits accumulates the bundle's bandwidth service; when
+// it reaches the packet's bandwidth demand the packet arrives at `Heading`
+// and (if not dst) forwards again from there next tick. `AtNode` is kept
+// while on-edge (the departure node — the E29 severed-edge pass drops back
+// to it).
+struct FPacket
+{
+	uint64_t Id = 0;
+	uint16_t Class = 0; // slice-3 packet_types index; 1.3 always 0
+	uint32_t Src = 0;
+	uint32_t Dst = 0;
+	bool OnEdge = false;		// true = traversing `Edge` toward `Heading`
+	uint32_t AtNode = 0;		// the node the packet sits at (always valid: departure node while on-edge)
+	uint32_t Edge = 0;			// pipe id being traversed (valid when OnEdge)
+	uint32_t Heading = 0;		// far-endpoint node id of `Edge` (valid when OnEdge)
+	uint32_t ProgressUnits = 0; // bandwidth units served on the current edge
+	uint32_t WaitingTicks =
+		0; // consecutive forward attempts FAILED at the current node (no route); 0 for on-edge/fresh packets
+	uint64_t SpawnTick = 0;
+	bool Delivered = false;
+};
+
+// FSpawnReq — a trivial hardcoded demand entry (1.3: run setup, like the
+// fixture; NOT part of the action log). The flow spawns a packet at `Tick`
+// from `Src` to `Dst` of class `Class`. The congestion-plan director
+// (weighted src/dst picks) is the real demand model (3.1); this is the
+// legacy slice-1 path (no rng draw).
+struct FSpawnReq
+{
+	uint64_t Tick = 0;
+	uint16_t Class = 0;
+	uint32_t Src = 0;
+	uint32_t Dst = 0;
+};
+
+struct FFlowState
+{
+	std::vector<FPacket> Packets;
+	std::vector<FSpawnReq> Demand;
+	uint64_t NextPacketId = 0;
+};
+
+// FlowSeedDemand — append a trivial legacy demand entry (run setup; re-created
+// identically on every replay — NOT in the action log, like the fixture +
+// seed). class defaults to 0 for back-compat with slice-1 callers.
+inline void FlowSeedDemand(FFlowState &F, uint64_t Tick, uint32_t Src, uint32_t Dst, uint16_t Class = 0)
+{
+	F.Demand.push_back(FSpawnReq{Tick, Class, Src, Dst});
+}
+
+// FlowSpawn — the single packet-construction path. A freshly-spawned packet
+// is resident at its source, ready to forward next tick (the forward pass
+// runs after the spawn pass in FlowStep — a spawn at tick T joins the graph
+// and the forward pass of the SAME tick puts it on edge; the serve pass
+// skips joiners, so it consumes bandwidth from the NEXT tick — the 1.3
+// one-hop-of-progress-per-tick convention).
+inline void FlowSpawn(FFlowState &F, uint16_t Class, uint32_t Src, uint32_t Dst, uint64_t Tick)
+{
+	F.NextPacketId += 1;
+	FPacket P;
+	P.Id = F.NextPacketId;
+	P.Class = Class;
+	P.Src = Src;
+	P.Dst = Dst;
+	P.OnEdge = false;
+	P.AtNode = Src;
+	P.SpawnTick = Tick;
+	F.Packets.push_back(P);
+}
+
+// FlowStep — the per-tick flow pass (slice-1 scope): spawn from the legacy
+// demand, forward at-node packets one hop via the fresh forwarding table,
+// drop severed-edge packets back to their departure node (E29), serve the
+// on-edge packets (progress += bundle capacity until the packet's bandwidth
+// demand), cull delivered packets. Returns the number of packets DELIVERED
+// this tick (the caller adds it to the run score — the 1.4 win metric).
+//
+// The serve pass is the trivial pre-QoS form: per bundle, FIFO in array
+// order, each packet entitled to min(need, remaining) capacity; a lone
+// packet gets the FULL bundle capacity (transit ticks =
+// ceil(packet_bandwidth / capacity_units), so a standard pipe (cap 15) takes
+// 2 ticks per hop with packet_bandwidth 30 — the balance.json contract).
+// QoS lane serialization + contention ladders land in 3.2/3.3.
+inline int32_t FlowStep(FFlowState &F, uint64_t Tick, const FTopology &Topo, const FRoutingTable &Routing,
+						const FBundles &Bundles)
+{
+	int32_t Delivered = 0;
+
+	// 1. SPAWN — the legacy demand path (fixed src/dst, NO rng draw — the
+	// rng stream stays at its post-seed value; the T1 hash changes via the
+	// packet bytes, not rng draws).
+	for (const FSpawnReq &Req : F.Demand)
+	{
+		if (Req.Tick != Tick)
+		{
+			continue;
+		}
+		FlowSpawn(F, Req.Class, Req.Src, Req.Dst, Tick);
+	}
+
+	// 2. FORWARD at-node packets one hop (per-hop — the fresh table is the
+	// only route authority; a topology change propagates at the next
+	// junction, E29). The packet ids forwarded THIS tick (joiners) are
+	// excluded from the serve pass below — a packet that forwards this tick
+	// starts consuming bandwidth NEXT tick.
+	std::vector<uint64_t> Forwarded;
+	Forwarded.reserve(8);
+	for (uint32_t I = 0; I < F.Packets.size(); ++I)
+	{
+		FPacket &P = F.Packets[I];
+		if (P.Delivered || P.OnEdge)
+		{
+			continue;
+		}
+		if (P.AtNode == P.Dst)
+		{
+			// spawned at its own dst (degenerate); count as delivered.
+			P.Delivered = true;
+			Delivered += 1;
+			continue;
+		}
+		uint32_t Offset = 0, Count = 0;
+		if (!EqualCostHops(Routing, Topo, P.AtNode, P.Dst, Offset, Count) || Count == 0)
+		{
+			// no route yet (incomplete graph) — wait here; re-tries next tick
+			// once a topology change rebuilds the table.
+			P.WaitingTicks += 1;
+			continue;
+		}
+		const uint32_t Pick = EcmpPick(P.Src, P.Dst, static_cast<uint8_t>(P.Class), P.Id, Count);
+		const FHop Hop = Routing.Hops[Offset + Pick];
+		P.OnEdge = true;
+		P.Edge = Hop.Pipe;
+		P.Heading = Hop.Node;
+		P.ProgressUnits = 0;
+		P.WaitingTicks = 0; // a successful forward clears the stuck counter
+		Forwarded.push_back(P.Id);
+	}
+
+	// 3. E29 severed-edge pass: a packet whose current pipe vanished
+	// mid-traversal drops off the lost edge back to its departure node
+	// (`AtNode` still holds it) and re-forwards NEXT tick against the rebuilt
+	// table. Only live pipes are served below.
+	for (uint32_t I = 0; I < F.Packets.size(); ++I)
+	{
+		FPacket &P = F.Packets[I];
+		if (P.Delivered || !P.OnEdge)
+		{
+			continue;
+		}
+		uint32_t Slot = 0;
+		if (PipeSlot(Topo, P.Edge, Slot))
+		{
+			continue;
+		}
+		P.OnEdge = false;
+		P.ProgressUnits = 0;
+		P.WaitingTicks = 0; // a severed drop-back re-tries fresh next tick
+	}
+
+	// 4. SERVE — per bundle, serve the on-edge packets FIFO in array order
+	// (the trivial pre-QoS form; work-conserving — a lone packet gets the
+	// full bundle capacity). Windows repeat until the bundle's capacity is
+	// consumed or nothing is ready.
+	for (uint32_t Bi = 0; Bi < Bundles.N; ++Bi)
+	{
+		int32_t Remaining = static_cast<int32_t>(Bundles.BundleCap[Bi]);
+		if (Remaining <= 0)
+		{
+			continue;
+		}
+		for (uint32_t I = 0; I < F.Packets.size() && Remaining > 0; ++I)
+		{
+			FPacket &P = F.Packets[I];
+			if (P.Delivered || !P.OnEdge)
+			{
+				continue;
+			}
+			// skip joiners (forwarded this tick)
+			bool Joined = false;
+			for (uint64_t FwdId : Forwarded)
+			{
+				if (FwdId == P.Id)
+				{
+					Joined = true;
+					break;
+				}
+			}
+			if (Joined)
+			{
+				continue;
+			}
+			uint32_t PipeSlotIdx = 0;
+			if (!PipeSlot(Topo, P.Edge, PipeSlotIdx))
+			{
+				continue; // severed this tick — handled above; defensive
+			}
+			if (BundleOfPipe(Bundles, PipeSlotIdx) != Bi)
+			{
+				continue;
+			}
+			const int32_t Need = kPacketBandwidth - static_cast<int32_t>(P.ProgressUnits);
+			if (Need <= 0)
+			{
+				continue; // defensive — arrived packets are flagged, never served
+			}
+			const int32_t Give = Need < Remaining ? Need : Remaining;
+			P.ProgressUnits += static_cast<uint32_t>(Give);
+			Remaining -= Give;
+			if (P.ProgressUnits >= static_cast<uint32_t>(kPacketBandwidth))
+			{
+				// arrived at the far endpoint
+				P.AtNode = P.Heading;
+				P.OnEdge = false;
+				P.ProgressUnits = 0;
+				if (P.AtNode == P.Dst)
+				{
+					P.Delivered = true;
+					Delivered += 1;
+				}
+			}
+		}
+	}
+
+	// 5. CULL delivered packets, preserving insertion order (determinism —
+	// the in-flight set is what the hash carries forward).
+	if (Delivered > 0)
+	{
+		std::vector<FPacket> Survivors;
+		Survivors.reserve(F.Packets.size());
+		for (const FPacket &P : F.Packets)
+		{
+			if (!P.Delivered)
+			{
+				Survivors.push_back(P);
+			}
+		}
+		F.Packets.swap(Survivors);
+	}
+
+	return Delivered;
+}
+
+} // namespace PP
diff --git a/Source/PacketPlumberCore/Public/PacketPlumberCore/PP_Routing.h b/Source/PacketPlumberCore/Public/PacketPlumberCore/PP_Routing.h
new file mode 100644
index 0000000..dcdf4e4
--- /dev/null
+++ b/Source/PacketPlumberCore/Public/PacketPlumberCore/PP_Routing.h
@@ -0,0 +1,342 @@
+// PP_Routing.h — the per-hop forwarding table + ECMP (architecture §6.2, the
+// locked routing model — canon #18 / routing ruling, lavish 2026-08-10).
+// Ported from the Odin canon core/routing.odin, re-expressed UE-native.
+//
+// Each node holds, per destination, the SET of equal-cost next hops; among N
+// such hops the pick is a PURE hash `splitmix64(src, dst, class, pkt_id)
+// mod N` (ODN-9) — deterministic per packet (flow affinity, no intra-flow
+// reordering), NOT a draw from the sim rng, and resolved over an ARRAY (no
+// map iteration in the hot path — ODN-10). The table is REBUILT ONLY WHEN
+// THE TOPOLOGY CHANGES, SYNCHRONOUSLY INSIDE THE TICK (4-rule spine rule 1,
+// ODN-10) — never per-packet, never async. A packet carries NO cached route;
+// at each junction it consults the fresh table — so a topology change
+// propagates at the next junction (E29: automatic migration).
+//
+// The prototype's compute_route BFS + cached packet.route[] is explicitly NOT
+// the model — do not port it. The Dijkstra HERE builds the FORWARDING TABLE
+// (the equal-cost next-hop SET per (junction, dst)), not a per-packet route;
+// the per-packet pick is a table lookup + the pure hash. Edge weights are the
+// STATIC per-tier costs (capacity-cost ladder, user ruling 2026-08-13: flows
+// prefer fat pipes) — never dynamic utilization.
+//
+// Determinism: array-only (no map iteration — ODN-10); insertion-order
+// tie-breaks (stable across targets); integer-only. The table is DERIVED
+// from the Topology (a pure function of it) — so it is NOT serialized into
+// the T1 hash (the Topology IS serialized; hashing derived state would bind
+// replay to the table-build algorithm, an implementation detail). Rule 2 of
+// the 4-rule spine: the ECMP tie-break is a pure hash of packet identity —
+// no sim-rng draw, no map iteration; the equal-cost set is array-indexed so
+// `mod N` is stable.
+//
+// UE-header-free (ODN-1); integer-only (ODN-10); std containers only.
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+#include "PacketPlumberCore/PP_Balance.h"
+#include "PacketPlumberCore/PP_Rng.h" // SplitMix64 (seed expansion primitive)
+#include "PacketPlumberCore/PP_Topology.h"
+
+namespace PP
+{
+
+// Hop — one equal-cost next hop: the neighbor NODE id + the representative
+// PIPE id of the bundle toward it. Parallel pipes between the same pair
+// BUNDLE into one fat edge (story 2.1), so a next hop is a NODE (the bundle),
+// not a per-pipe choice — the representative pipe is the lowest-slot member
+// (insertion order, matching the single-path representative 2.1 resolves).
+struct FHop
+{
+	uint32_t Node = 0; // next-hop NODE id
+	uint32_t Pipe = 0; // representative pipe id toward `Node` (lowest-slot member)
+};
+
+// Routing_Table — per (from_node, dst) the equal-cost next-hop SET. Flat
+// slot map [from*n + dst] -> (offset, count) into a packed `hops` array.
+// Array-indexed throughout (no map — ODN-10): the hot-path lookup
+// (EqualCostHops) returns a (offset, count) pair and the flow indexes
+// `hops[offset + hash % count]` — deterministic + stable across targets.
+// count == 0 means no route (the node can't currently reach dst); count >= 1
+// is the ECMP set (count == 1 is the ordinary single-path case — backward-
+// identical to slice 1's single next hop, since hash % 1 == 0).
+struct FRoutingTable
+{
+	std::vector<uint32_t> HopOffset; // [from*n + dst] -> start index into Hops
+	std::vector<uint32_t> HopCount;	 // [from*n + dst] -> # equal-cost next hops (0 = no route)
+	std::vector<FHop> Hops;			 // flat packed array of equal-cost next hops, insertion-ordered
+	uint32_t N = 0;					 // node slot count the table was built for (== NodeAlive.size())
+};
+
+// RoutingRebuild — recompute every node's equal-cost next-hop sets from the
+// current Topology. Called by step ONLY when the topology changed
+// (Topology.Gen moved — 4-rule spine rule 1). Pure w.r.t. the Topology:
+// identical Topology -> identical table on every target (ODN-10).
+//
+// Method: one DIJKSTRA PER DESTINATION (the graph is undirected — pipes have
+// no direction) over INTEGER pipe costs — the capacity-cost ladder, user
+// ruling 2026-08-13: each pipe's cost is its tier's `cost` (20/10/5 for
+// narrow/standard/wide), NEVER dynamic utilization. The edge cost toward a
+// neighbor is the MINIMUM tier cost among the live pipes between the pair (a
+// mixed-tier bundle is one fat edge — it prices at its fattest member). Then
+// for each node `u` the equal-cost next hops toward `d` are exactly the
+// neighbors `v` with dist(v) + cost(u,v) == dist(u) — the textbook SPF/ECMP
+// next-hop condition. N Dijkstras (one per dst); small graphs make it cheap
+// and the rebuild is rare (topology-change only).
+//
+// Determinism: cheapest-first extraction is an ARRAY min-scan with
+// insertion-order (slot-order) tie-breaks; neighbors are scanned in
+// PIPE-INSERTION (slot) order, so the equal-cost set is built in a stable
+// order; a neighbor NODE appears once (parallel pipes to the same node are
+// one bundle — the lowest-slot pipe is the representative). ECMP's `hash
+// mod N` then indexes this stable array. No rng, no map iteration (ODN-10);
+// integer-only (ODN-10).
+inline void RoutingRebuild(FRoutingTable &R, const FTopology &T)
+{
+	const uint32_t N = static_cast<uint32_t>(T.NodeAlive.size());
+	const uint64_t Need = static_cast<uint64_t>(N) * N;
+	if (N == 0)
+	{
+		R.HopOffset.clear();
+		R.HopCount.clear();
+		R.Hops.clear();
+		R.N = 0;
+		return;
+	}
+	R.HopOffset.assign(Need, 0);
+	R.HopCount.assign(Need, 0);
+	R.Hops.clear();
+	R.N = N;
+
+	constexpr int32_t UNREACHABLE = -1;
+	std::vector<int32_t> Dist(N, UNREACHABLE);
+	std::vector<uint8_t> Settled(N, 0);
+	std::vector<uint8_t> Seen(N, 0);
+	std::vector<int32_t> MinCost(N, UNREACHABLE);
+
+	for (uint32_t D = 0; D < N; ++D)
+	{
+		if (!T.NodeAlive[D])
+		{
+			continue;
+		}
+		// Dijkstra from `D` over undirected live pipes -> Dist[*] = min cost to D.
+		std::fill(Dist.begin(), Dist.end(), UNREACHABLE);
+		std::fill(Settled.begin(), Settled.end(), 0);
+		Dist[D] = 0;
+		for (;;)
+		{
+			// cheapest-first extraction: the unsettled node with the SMALLEST
+			// dist (array min-scan; ties -> lowest slot = insertion order).
+			int32_t Cur = -1;
+			for (uint32_t I = 0; I < N; ++I)
+			{
+				if (Settled[I] || Dist[I] == UNREACHABLE)
+				{
+					continue;
+				}
+				if (Cur == -1 || Dist[I] < Dist[Cur])
+				{
+					Cur = static_cast<int32_t>(I);
+				}
+			}
+			if (Cur == -1)
+			{
+				break;
+			}
+			Settled[Cur] = 1;
+			const uint32_t CurId = T.NodeId[Cur];
+			// relax Cur's neighbors via pipes in insertion order (stable).
+			// Per-pipe relaxation with strict `<` lets the CHEAPEST member of a
+			// mixed-tier bundle win the edge cost (min semantics).
+			for (uint32_t Pi = 0; Pi < T.PipeAlive.size(); ++Pi)
+			{
+				if (!T.PipeAlive[Pi])
+				{
+					continue;
+				}
+				uint32_t Nb = 0;
+				if (!PipeOther(T, Pi, CurId, Nb))
+				{
+					continue;
+				}
+				uint32_t Ns = 0;
+				if (!NodeSlot(T, Nb, Ns) || Settled[Ns])
+				{
+					continue;
+				}
+				const int32_t Nd = Dist[Cur] + kTierCost[T.PipeTier[Pi]];
+				if (Dist[Ns] == UNREACHABLE || Nd < Dist[Ns])
+				{
+					Dist[Ns] = Nd;
+				}
+			}
+		}
+		// for each reachable node u (u != d), collect its equal-cost next hops
+		// toward d: the neighbors v with dist(v) + cost(u,v) == dist(u). The
+		// edge cost is the MINIMUM tier cost among live pipes between u and v.
+		// Pack into Hops; record the (offset, count) for slot (u, d).
+		for (uint32_t U = 0; U < N; ++U)
+		{
+			if (U == D || !T.NodeAlive[U] || Dist[U] == UNREACHABLE)
+			{
+				continue;
+			}
+			std::fill(Seen.begin(), Seen.end(), 0);
+			const uint32_t SetStart = static_cast<uint32_t>(R.Hops.size());
+			const uint32_t UId = T.NodeId[U];
+			// pass 1: per-neighbor MIN edge cost (slot-order scan; first-seen
+			// lowest-slot pipe is the representative).
+			std::fill(MinCost.begin(), MinCost.end(), UNREACHABLE);
+			for (uint32_t Pi = 0; Pi < T.PipeAlive.size(); ++Pi)
+			{
+				if (!T.PipeAlive[Pi])
+				{
+					continue;
+				}
+				uint32_t Nb = 0;
+				if (!PipeOther(T, Pi, UId, Nb))
+				{
+					continue;
+				}
+				uint32_t Ns = 0;
+				if (!NodeSlot(T, Nb, Ns) || Dist[Ns] == UNREACHABLE)
+				{
+					continue;
+				}
+				const int32_t C = kTierCost[T.PipeTier[Pi]];
+				if (!Seen[Ns])
+				{
+					Seen[Ns] = 1; // first (lowest-slot) pipe to this neighbor wins the representative slot
+					MinCost[Ns] = C;
+				}
+				else if (C < MinCost[Ns])
+				{
+					MinCost[Ns] = C; // a fatter (cheaper) member re-prices the edge
+				}
+			}
+			// pass 2: the equal-cost test with the settled min edge cost. Seen
+			// still holds pass-1's neighbor marks; claiming flips it off so only
+			// the first (lowest-slot) pipe to the neighbor is appended.
+			for (uint32_t Pi = 0; Pi < T.PipeAlive.size(); ++Pi)
+			{
+				if (!T.PipeAlive[Pi])
+				{
+					continue;
+				}
+				uint32_t Nb = 0;
+				if (!PipeOther(T, Pi, UId, Nb))
+				{
+					continue;
+				}
+				uint32_t Ns = 0;
+				if (!NodeSlot(T, Nb, Ns) || !Seen[Ns] || MinCost[Ns] == UNREACHABLE)
+				{
+					continue;
+				}
+				if (Dist[Ns] + MinCost[Ns] != Dist[U])
+				{
+					continue;
+				}
+				Seen[Ns] = 0; // claimed by its first (lowest-slot) pipe
+				R.Hops.push_back(FHop{Nb, T.PipeId[Pi]});
+			}
+			const uint64_t Idx = static_cast<uint64_t>(U) * N + D;
+			R.HopOffset[Idx] = SetStart;
+			R.HopCount[Idx] = static_cast<uint32_t>(R.Hops.size()) - SetStart;
+		}
+	}
+}
+
+// EqualCostHops — THE hot-path lookup: at `from_node` toward `dst_node`, the
+// (offset, count) of the equal-cost next-hop set in Hops. ok=false if the
+// table is stale/not built; count == 0 means no route (the packet waits).
+// The caller takes `hops[offset + ecmp_pick(...) % count]`; count == 1
+// yields the single next hop. Array-indexed — no map iteration in the hot
+// path (ODN-10, rule 2).
+inline bool EqualCostHops(const FRoutingTable &R, const FTopology &T, uint32_t FromNode, uint32_t DstNode,
+						  uint32_t &OutOffset, uint32_t &OutCount)
+{
+	if (R.N == 0 || R.HopOffset.size() != static_cast<uint64_t>(R.N) * R.N)
+	{
+		return false; // table not built / stale shape — no route
+	}
+	uint32_t Fs = 0, Ds = 0;
+	if (!NodeSlot(T, FromNode, Fs) || !NodeSlot(T, DstNode, Ds))
+	{
+		return false;
+	}
+	// STALE-TABLE guard (r1 warning): the table's slot count (R.N) comes from
+	// the topology it was BUILT for; the caller's topology may have grown a
+	// node since (the flow always rebuilds first, but a direct caller could
+	// index OOB). Bounds-check the slot against the table's own shape —
+	// stale = no route, never an OOB read.
+	if (Fs >= R.N || Ds >= R.N)
+	{
+		return false;
+	}
+	const uint64_t Idx = static_cast<uint64_t>(Fs) * R.N + Ds;
+	OutOffset = R.HopOffset[Idx];
+	OutCount = R.HopCount[Idx];
+	return true;
+}
+
+// NextHop — the FIRST (representative) equal-cost next hop at `from_node`
+// toward `dst_node`. A convenience for callers that want a single
+// deterministic hop (tests, HasPath). For a single-path slot this is the sole
+// hop; for an ECMP slot it is the first member (insertion order) — NOT the
+// hashed pick (the flow uses EcmpPick for that). ok=false if no route.
+inline bool NextHop(const FRoutingTable &R, const FTopology &T, uint32_t FromNode, uint32_t DstNode, uint32_t &OutNode,
+					uint32_t &OutPipe)
+{
+	uint32_t Offset = 0, Count = 0;
+	if (!EqualCostHops(R, T, FromNode, DstNode, Offset, Count) || Count == 0)
+	{
+		return false;
+	}
+	OutNode = R.Hops[Offset].Node;
+	OutPipe = R.Hops[Offset].Pipe;
+	return true;
+}
+
+// HasPath — true iff `from_node` can currently reach `dst_node` per the
+// (fresh) table.
+inline bool HasPath(const FRoutingTable &R, const FTopology &T, uint32_t FromNode, uint32_t DstNode)
+{
+	uint32_t Offset = 0, Count = 0;
+	return EqualCostHops(R, T, FromNode, DstNode, Offset, Count) && Count > 0;
+}
+
+// EcmpHash — the locked-model PURE hash over packet identity (ODN-9, routing
+// ruling lavish 2026-08-10; rule 2 of the 4-rule spine). splitmix64 (the same
+// primitive rng.odin uses for seed expansion) is folded over (src, dst,
+// class, pkt_id) as a *deterministic finalizer* — NOT a draw from the sim
+// rng: this function never touches state.rng and is a pure function of its
+// arguments. Same identity -> same hash on every target + every replay (flow
+// affinity, no intra-flow reordering). Returns a well-mixed u32; EcmpPick
+// takes it mod N. (class is a forward parameter — slice 3 packet types; 2.2
+// passes 0 for every packet.)
+inline uint32_t EcmpHash(uint32_t Src, uint32_t Dst, uint8_t Class, uint64_t PktId)
+{
+	uint64_t S = PktId;
+	S = SplitMix64(S) ^ static_cast<uint64_t>(Src);
+	S = SplitMix64(S) ^ static_cast<uint64_t>(Dst);
+	S = SplitMix64(S) ^ static_cast<uint64_t>(Class);
+	S = SplitMix64(S);
+	return static_cast<uint32_t>(S ^ (S >> 32));
+}
+
+// EcmpPick — among N equal-cost next hops, the deterministic index
+// splitmix64(src, dst, class, pkt_id) mod N (ODN-9). n >= 1; n == 1 -> 0 (the
+// sole hop, so a single-path slot is backward-identical to slice 1). Pure:
+// the same packet always picks the same index, every replay.
+inline uint32_t EcmpPick(uint32_t Src, uint32_t Dst, uint8_t Class, uint64_t PktId, uint32_t N)
+{
+	if (N <= 1)
+	{
+		return 0;
+	}
+	return EcmpHash(Src, Dst, Class, PktId) % N;
+}
+
+} // namespace PP
