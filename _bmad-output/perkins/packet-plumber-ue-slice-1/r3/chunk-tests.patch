+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPRoutingECMP, "PacketPlumber.Routing.ECMP",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPRoutingECMP::RunTest(const FString &Parameters)
+{
+	// The symmetric diamond: two equal-cost paths source->sink (cost 20 each).
+	PP::FTopology T;
+	const uint32_t S4 = PP::SpawnNode(T, PP::FNodeKind::Terminal, 0, 0);
+	const uint32_t RA = PP::SpawnNode(T, PP::FNodeKind::Junction, 4, 0);
+	const uint32_t RB = PP::SpawnNode(T, PP::FNodeKind::Junction, 0, 4);
+	const uint32_t DK = PP::SpawnNode(T, PP::FNodeKind::Terminal, 4, 4);
+	PP::ApplyDraw(T, S4, RA, PP::TIER_STANDARD);
+	PP::ApplyDraw(T, S4, RB, PP::TIER_STANDARD);
+	PP::ApplyDraw(T, RA, DK, PP::TIER_STANDARD);
+	PP::ApplyDraw(T, RB, DK, PP::TIER_STANDARD);
+
+	PP::FRoutingTable Rt;
+	PP::RoutingRebuild(Rt, T);
+
+	uint32_t Off = 0, Cnt = 0;
+	TestTrue(TEXT("equal-cost ECMP set must have two hops"), PP::EqualCostHops(Rt, T, S4, DK, Off, Cnt) && Cnt == 2);
+	const uint32_t Pick1 = PP::EcmpPick(S4, DK, 0, 7, Cnt);
+	TestTrue(TEXT("ECMP pick must be stable per packet (flow affinity)"), Pick1 == PP::EcmpPick(S4, DK, 0, 7, Cnt));
+	TestTrue(TEXT("ECMP pick must index the set"), Pick1 < Cnt);
+	bool Spread = false;
+	for (uint64_t Id = 1; Id <= 16; ++Id)
+	{
+		if (PP::EcmpPick(S4, DK, 0, Id, Cnt) != Pick1)
+		{
+			Spread = true;
+		}
+	}
+	TestTrue(TEXT("ECMP picks must spread across the equal-cost set"), Spread);
+
+	// identical topology -> byte-identical table (pure function)
+	PP::FRoutingTable RtB;
+	PP::RoutingRebuild(RtB, T);
+	TestTrue(TEXT("identical topology must rebuild an identical table"), Rt.Hops.size() == RtB.Hops.size());
+	TestTrue(TEXT("identical topology must rebuild byte-identical hops"),
+			 FMemory::Memcmp(Rt.Hops.data(), RtB.Hops.data(), Rt.Hops.size() * sizeof(PP::FHop)) == 0);
+	return true;
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPBundleCapSum, "PacketPlumber.Bundles.CapIsSum",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPBundleCapSum::RunTest(const FString &Parameters)
+{
+	// Rule 3: bundled cap = STATIC SUM at table-build (15+15, and 15+40 mixed).
+	PP::FTopology T;
+	const uint32_t A = PP::SpawnNode(T, PP::FNodeKind::Junction, 0, 0);
+	const uint32_t B = PP::SpawnNode(T, PP::FNodeKind::Junction, 4, 0);
+	PP::ApplyDraw(T, A, B, PP::TIER_STANDARD);
+	PP::ApplyDraw(T, A, B, PP::TIER_STANDARD);
+	PP::FBundles Bu;
+	PP::BundlesRebuild(Bu, T);
+	TestEqual(TEXT("two parallel pipes must bundle into one pooled link"), Bu.N, 1u);
+	TestEqual(TEXT("bundled cap must be the static sum (15+15)"), Bu.BundleCap[0], 30u);
+	TestEqual(TEXT("bundle member count must be 2"), Bu.BundleCount[0], 2u);
+
+	PP::FTopology T2;
+	const uint32_t C = PP::SpawnNode(T2, PP::FNodeKind::Junction, 0, 0);
+	const uint32_t D = PP::SpawnNode(T2, PP::FNodeKind::Junction, 4, 0);
+	PP::ApplyDraw(T2, C, D, PP::TIER_STANDARD);
+	PP::ApplyDraw(T2, C, D, PP::TIER_WIDE);
+	PP::FBundles Bu2;
+	PP::BundlesRebuild(Bu2, T2);
+	TestEqual(TEXT("mixed-tier bundle cap must sum member capacities (15+40)"), Bu2.BundleCap[0], 55u);
+	return true;
+}
