+
+	TestEqual(TEXT("golden run must end at tick 100"), State.Tick, static_cast<uint64_t>(100));
+	TestEqual(TEXT("golden tick_nonce must match the committed golden"), State.TickNonce, 2381141952u);
+	TestEqual(TEXT("golden state_hash must match the committed golden"), Hash, 0x5e440f9c5a28892aull);
+	TestTrue(TEXT("golden catalog_hash must be the empty-set hash (no catalogs in slice 1)"),
+			 State.CatalogHash == PP::FNV64_OFFSET);
+	TestEqual(TEXT("golden score must be 10 delivered"), State.Score, 10);
+	TestEqual(TEXT("golden must carry one in-flight packet at tick 100"), State.Flow.Packets.size(),
+			  static_cast<size_t>(1));
+	TestEqual(TEXT("golden topology gen must be 5 (3 spawns + 2 draws)"), State.Topology.Gen, 5u);
+	return true;
+}
