+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPApplyEditLiveFastPath, "PacketPlumber.Sim.ApplyEditLiveFastPath",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPApplyEditLiveFastPath::RunTest(const FString &Parameters)
+{
+	// The LIVE fast-path (r1 warning: zero coverage before): ApplyEdit
+	// validates + applies immediately + logs apply_tick = next; a rejected
+	// edit logs nothing; replay from the recorded log converges byte-
+	// identically at the step boundary (ODN-2).
+	PP::FSimState Live, Replay;
+	PP::BuildProbeScenario(Live);
+	PP::BuildProbeScenario(Replay);
+	Live.ActionLog.clear();
+	Replay.ActionLog.clear();
+
+	PP::FCommand Draw;
+	Draw.Kind = PP::FCommandKind::DrawPipe;
+	Draw.A = PP::SCENARIO_SOURCE;
+	Draw.B = PP::SCENARIO_ROUTER;
+	Draw.Tier = PP::TIER_STANDARD;
+	const PP::FEditResult Res = PP::ApplyEdit(Live, Draw);
+	TestTrue(TEXT("ApplyEdit must accept a valid draw"), Res.Error == PP::FEditError::None);
+	TestEqual(TEXT("ApplyEdit must apply the pipe immediately"), PP::PipeCount(Live.Topology), 1);
+	TestTrue(TEXT("ApplyEdit must log with apply_tick = next (ODN-2)"),
+			 Live.ActionLog.size() == 1 && Live.ActionLog[0].ApplyTick == 1);
+
+	PP::FCommand Bad;
+	Bad.Kind = PP::FCommandKind::DrawPipe;
+	Bad.A = PP::SCENARIO_SOURCE;
+	Bad.B = PP::SCENARIO_SOURCE; // self-loop (E3)
+	Bad.Tier = PP::TIER_STANDARD;
+	TestTrue(TEXT("ApplyEdit must reject a self-loop"), PP::ApplyEdit(Live, Bad).Error == PP::FEditError::SelfLoop);
+	TestEqual(TEXT("a rejected edit must not log"), Live.ActionLog.size(), static_cast<size_t>(1));
+
+	PP::Step(Live, 1);
+	Replay.ActionLog = Live.ActionLog; // the recorded log IS the replay input
+	PP::StepScenario(Replay, 1);
+	TestEqual(TEXT("live ApplyEdit path and the replay path must converge at the step boundary"), PP::StateHash(Live),
+			  PP::StateHash(Replay));
+	return true;
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPE29Recovery, "PacketPlumber.Flow.E29Recovery",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPE29Recovery::RunTest(const FString &Parameters)
+{
+	// E29 recovery — the full loop (r1 warning: drop-back was asserted,
+	// re-route + redelivery never tested): sever the first edge, the packet
+	// drops back, THEN repair the path and the packet delivers.
+	PP::FSimState S;
+	PP::BuildProbeScenario(S);
+	PP::StepScenario(S, 5); // packet on edge source->router
+	uint32_t Slot = 0;
+	PP::PipeSlot(S.Topology, 0, Slot);
+	S.Topology.PipeAlive[Slot] = 0;
+	S.Topology.Gen += 1;
+	PP::Step(S, 6); // E29 drop-back
+	TestEqual(TEXT("E29: the packet must survive the severance"), S.Flow.Packets.size(), static_cast<size_t>(1));
+	TestTrue(TEXT("E29: the packet must drop back to its departure node"),
+			 !S.Flow.Packets[0].OnEdge && S.Flow.Packets[0].AtNode == PP::SCENARIO_SOURCE);
+	S.Topology.PipeAlive[Slot] = 1; // repair the path
+	S.Topology.Gen += 1;
+	PP::StepScenario(S, 12);
+	TestEqual(TEXT("E29 recovery: the re-routed packet must deliver"), S.Score, 1);
+	TestTrue(TEXT("E29 recovery: delivered packets must be culled"), S.Flow.Packets.empty());
+	return true;
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPMixedTierSteering, "PacketPlumber.Routing.MixedTierSteering",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPMixedTierSteering::RunTest(const FString &Parameters)
+{
+	// The capacity-cost ladder (user ruling 2026-08-13): a fat wide pipe
+	// (cost 5) must win over a narrow one (cost 20) between the same pair.
+	PP::FTopology T;
+	const uint32_t Src = PP::SpawnNode(T, PP::FNodeKind::Terminal, 0, 0);
+	const uint32_t A = PP::SpawnNode(T, PP::FNodeKind::Junction, 4, 0);
+	const uint32_t B = PP::SpawnNode(T, PP::FNodeKind::Junction, 0, 4);
+	const uint32_t Snk = PP::SpawnNode(T, PP::FNodeKind::Terminal, 4, 4);
+	PP::ApplyDraw(T, Src, A, PP::TIER_NARROW);
+	PP::ApplyDraw(T, A, Snk, PP::TIER_NARROW);
+	PP::ApplyDraw(T, Src, B, PP::TIER_WIDE);
+	PP::ApplyDraw(T, B, Snk, PP::TIER_WIDE);
+	PP::FRoutingTable Rt;
+	PP::RoutingRebuild(Rt, T);
+	uint32_t Off = 0, Cnt = 0;
+	TestTrue(TEXT("mixed tiers: only the fat path may be equal-cost"),
+			 PP::EqualCostHops(Rt, T, Src, Snk, Off, Cnt) && Cnt == 1);
+	if (Cnt == 1)
+	{
+		TestTrue(TEXT("mixed tiers: the wide (cost 5) path must win the ladder"), Rt.Hops[Off].Node == B);
+	}
+	return true;
+}
+
+#endif // WITH_DEV_AUTOMATION_TESTS
