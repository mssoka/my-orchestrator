diff --git a/Source/PacketPlumberCoreTests/PPInputTests.cpp b/Source/PacketPlumberCoreTests/PPInputTests.cpp
new file mode 100644
index 0000000..59efdf4
--- /dev/null
+++ b/Source/PacketPlumberCoreTests/PPInputTests.cpp
@@ -0,0 +1,126 @@
+// PPInputTests.cpp — the UAD-12 input surface, headless (Perkins r1 blocker 1).
+//
+// Regression pin for the null-action bug: UE calls SetupInputComponent BEFORE
+// BeginPlay, so runtime-created actions must exist from the CONSTRUCTOR — a
+// BindAction(nullptr) can never match an action instance, and the mouse
+// never reaches the draw bus. This test:
+//   1. constructs the controller and asserts the input assets exist (the r1
+//      regression — they were created in BeginPlay, so SetupInputComponent
+//      captured null),
+//   2. asserts the mapping context maps LMB to both draw actions,
+//   3. synthesizes the action trigger: constructs the action instance and
+//      executes the bound delegate (the same Execute path Enhanced Input
+//      fires), asserting the GameMode's BeginDraw/EndDraw receive the drag,
+//   4. drives a full draw through the controller seam and asserts the pipe
+//      lands in the sim (the end-to-end mouse path, minus the OS mouse).
+#include "Misc/AutomationTest.h"
+
+#include "PacketPlumberCore/PP_Sim.h"
+#include "EnhancedInputComponent.h"
+#include "InputAction.h"
+#include "InputMappingContext.h"
+#include "PPRunGameMode.h"
+#include "PPRunPlayerController.h"
+
+#if WITH_DEV_AUTOMATION_TESTS
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPInputAssetsExistAtBind, "PacketPlumber.Input.AssetsExistAtBind",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPInputAssetsExistAtBind::RunTest(const FString &Parameters)
+{
+	// The r1 regression: assets were created in BeginPlay, but
+	// SetupInputComponent runs BEFORE BeginPlay (SetPlayer -> InitInputSystem),
+	// so BindAction captured null. Constructing the controller must yield
+	// non-null assets immediately.
+	APPRunPlayerController *PC = NewObject<APPRunPlayerController>(GetTransientPackage());
+	TestNotNull(TEXT("draw mapping context must exist at construction"), PC->GetDrawMappingContext());
+	TestNotNull(TEXT("draw start action must exist at construction"), PC->GetDrawStartAction());
+	TestNotNull(TEXT("draw end action must exist at construction"), PC->GetDrawEndAction());
+
+	// LMB must map to BOTH actions (press starts the drag, release ends it).
+	const UInputMappingContext *IMC = PC->GetDrawMappingContext();
+	int32 StartMaps = 0, EndMaps = 0;
+	for (const FEnhancedActionKeyMapping &Mapping : IMC->GetMappings())
+	{
+		if (Mapping.Action == PC->GetDrawStartAction() && Mapping.Key == EKeys::LeftMouseButton)
+		{
+			++StartMaps;
+		}
+		if (Mapping.Action == PC->GetDrawEndAction() && Mapping.Key == EKeys::LeftMouseButton)
+		{
+			++EndMaps;
+		}
+	}
+	TestEqual(TEXT("LMB must map to DrawStart"), StartMaps, 1);
+	TestEqual(TEXT("LMB must map to DrawEnd"), EndMaps, 1);
+	return true;
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPInputTriggerSynthesized, "PacketPlumber.Input.TriggerSynthesized",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPInputTriggerSynthesized::RunTest(const FString &Parameters)
+{
+	// A GameMode owning a fresh run arena (BeginPlay does not fire for a
+	// bare NewObject — seed the sim explicitly).
+	APPRunGameMode *GM = NewObject<APPRunGameMode>(GetTransientPackage());
+	GM->StartRun();
+
+	APPRunPlayerController *PC = NewObject<APPRunPlayerController>(GetTransientPackage());
+	PC->TestGameMode = GM;
+
+	// Wire the EnhancedInputComponent + bind like the controller does (the
+	// assets exist — the r1 fix). Execute() on the returned binding is the
+	// same path the engine fires.
+	UEnhancedInputComponent *EIC = NewObject<UEnhancedInputComponent>(PC);
+	FEnhancedInputActionEventBinding &StartBinding = EIC->BindAction(PC->GetDrawStartAction(), ETriggerEvent::Started,
+																	 PC, &APPRunPlayerController::FireDrawStartForTest);
+	FEnhancedInputActionEventBinding &EndBinding = EIC->BindAction(PC->GetDrawEndAction(), ETriggerEvent::Completed, PC,
+																   &APPRunPlayerController::FireDrawEndForTest);
+
+	TestTrue(TEXT("start binding must reference the action"), StartBinding.GetAction() == PC->GetDrawStartAction());
+	TestTrue(TEXT("end binding must reference the action"), EndBinding.GetAction() == PC->GetDrawEndAction());
+
+	// Synthesize the drag: press at the source node's screen area, release at
+	// the router's (design-reference 1280x720 fit: source grid(2,2) ->
+	// x=160+2.5*26*0.9231=220, router grid(6,2) -> x=160+6.5*26*0.9231=316).
+	// BeginDraw/EndDraw snap + validate + apply through the command bus; a
+	// valid draw lands a pipe in the sim.
+	const FVector2D SourceScreen(220.f, 62.f);
+	const FVector2D RouterScreen(316.f, 62.f);
+	FInputActionInstance StartInstance(PC->GetDrawStartAction());
+	FInputActionInstance EndInstance(PC->GetDrawEndAction());
+
+	// DIRECT seam call first (isolates the routing from the binding layer):
+	// if this fails, the ResolveGameMode/GM path is broken; if it passes but
+	// the binding path fails, the binding layer is broken.
+	TestTrue(TEXT("the injected GameMode must resolve through the seam"), PC->ResolveGameMode() == GM);
+	PC->TestScreenPos = SourceScreen;
+	PC->FireDrawStartForTest(StartInstance);
+	PC->TestScreenPos = RouterScreen;
+	PC->FireDrawEndForTest(EndInstance);
+	TestEqual(TEXT("direct seam calls must create one pipe"), PP::PipeCount(GM->GetSimStateForTest().Topology), 1);
+	TestEqual(TEXT("direct seam calls must log the draw"), GM->GetSimStateForTest().ActionLog.size(),
+			  static_cast<size_t>(1));
+
+	// BINDING leg on a FRESH run (the direct leg already consumed the pipe):
+	// Execute() on the returned binding is the same path the engine fires.
+	GM->StartRun();
+	PC->TestScreenPos = SourceScreen;
+	StartBinding.Execute(StartInstance);
+	PC->TestScreenPos = RouterScreen;
+	EndBinding.Execute(EndInstance);
+
+	TestEqual(TEXT("both trigger bindings must have fired"), PC->FireCount, 4);
+	// the snap + validate result is visible on the GM (rejection feedback)
+	TestEqual(TEXT("the binding leg must have been accepted (no rejection)"), GM->GetLastEditErrorForTest(),
+			  PP::FEditError::None);
+	TestEqual(TEXT("the binding leg must create one pipe in the sim"), PP::PipeCount(GM->GetSimStateForTest().Topology),
+			  1);
+	TestEqual(TEXT("the action log must carry the draw (apply_tick = next)"), GM->GetSimStateForTest().ActionLog.size(),
+			  static_cast<size_t>(1));
+	return true;
+}
+
+#endif // WITH_DEV_AUTOMATION_TESTS
diff --git a/Source/PacketPlumberCoreTests/PPSimDriverTests.cpp b/Source/PacketPlumberCoreTests/PPSimDriverTests.cpp
new file mode 100644
index 0000000..fe943be
--- /dev/null
+++ b/Source/PacketPlumberCoreTests/PPSimDriverTests.cpp
@@ -0,0 +1,62 @@
+// PPSimDriverTests.cpp — the UAD-2 fixed-tick driver, engine-side.
+// The accumulator math is pure: Advance(Delta) returns the tick count and
+// the sim lands exactly on TargetTick = floor(Accum * 20). The [FinLT]
+// clamp (0.25 s/frame) caps catch-up steps. Mirrors the story-1.1 exit
+// criteria ("the accumulator driver unit-tested").
+#include "Misc/AutomationTest.h"
+
+#include "PacketPlumberCore/PP_Sim.h"
+#include "PPSimDriver.h"
+
+#if WITH_DEV_AUTOMATION_TESTS
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPDriverAccumulator, "PacketPlumber.Driver.Accumulator",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPDriverAccumulator::RunTest(const FString &Parameters)
+{
+	PP::FSimState State;
+	State.Initialize(42);
+	FPPSimDriver Driver;
+
+	// 0.05 s at 20 Hz -> exactly 1 tick.
+	const int32 S1 = Driver.Advance(State, 0.05f);
+	TestEqual(TEXT("0.05s must step exactly 1 tick"), S1, 1);
+	TestEqual(TEXT("sim tick must land on 1"), State.Tick, static_cast<uint64_t>(1));
+
+	// 1.0 s in 0.25s chunks (the clamp) -> 5 steps each, 20 total.
+	State.Initialize(42);
+	Driver.Reset();
+	int32 Total = 0;
+	for (int32 I = 0; I < 4; ++I)
+	{
+		Total += Driver.Advance(State, 1.0f); // clamped to 0.25 -> 5 ticks each
+	}
+	TestEqual(TEXT("4 x 1.0s (clamped) must step 20 ticks"), Total, 20);
+	TestEqual(TEXT("sim tick must land on 20"), State.Tick, static_cast<uint64_t>(20));
+
+	// A tiny delta below one tick steps NOTHING (the accumulator holds it).
+	State.Initialize(42);
+	Driver.Reset();
+	const int32 S2 = Driver.Advance(State, 0.01f);
+	TestEqual(TEXT("0.01s must not step yet"), S2, 0);
+	TestEqual(TEXT("accumulator must hold sub-tick time"), State.Tick, static_cast<uint64_t>(0));
+	// 0.05 total would sit exactly on the tick boundary — float rounding makes
+	// that brittle (0.01f+0.04f = 0.0499999...); use a value safely past it.
+	const int32 S3 = Driver.Advance(State, 0.045f); // 0.055 total -> 1.1 ticks
+	TestEqual(TEXT("0.045s more must complete tick 1"), S3, 1);
+	TestEqual(TEXT("sim tick must land on 1 after accumulation"), State.Tick, static_cast<uint64_t>(1));
+
+	// The float never enters the sim: two drivers stepping the same tick
+	// sequence produce identical hashes (ODN-10/UAD-2).
+	PP::FSimState A, B;
+	A.Initialize(7);
+	B.Initialize(7);
+	FPPSimDriver DA, DB;
+	DA.Advance(A, 0.05f);
+	DB.Advance(B, 0.05f);
+	TestEqual(TEXT("same tick sequence must hash identically"), PP::StateHash(A), PP::StateHash(B));
+	return true;
+}
+
+#endif // WITH_DEV_AUTOMATION_TESTS
diff --git a/Source/PacketPlumberCoreTests/PPViewGeometryTests.cpp b/Source/PacketPlumberCoreTests/PPViewGeometryTests.cpp
new file mode 100644
index 0000000..54bec4a
--- /dev/null
+++ b/Source/PacketPlumberCoreTests/PPViewGeometryTests.cpp
@@ -0,0 +1,144 @@
+// PPViewGeometryTests.cpp — the view's pure geometry math, pinned (r2 warning
+// 9: UPPRunView had zero automation coverage — the road-anchor and dot-offset
+// regressions shipped because the math was inline in the widget).
+//
+// Covers the r2 blocker + warnings at the math layer:
+//  - the road ribbon's slot anchor places the box center on the road midpoint
+//    (the r2 blocker: anchored with Width/2 on the length axis, every road
+//    shifted ~(Length-Width)/2 along its axis, disconnecting roads from nodes)
+//  - the fit mapping adds the +0.5 tile-center offset EXACTLY ONCE (the r2
+//    warning: PacketPosIn baked +0.5 in AND the fit added it again — the dot
+//    rode half a tile off the road)
+//  - the packet's grid position rides the edge at eased progress
+//  - the E4 snap radius scales with the camera fit (world-px canon)
+#include "Misc/AutomationTest.h"
+
+#include "PacketPlumberCore/PP_Sim.h"
+#include "PPCommandBus.h"
+#include "PPViewGeometry.h"
+
+#if WITH_DEV_AUTOMATION_TESTS
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPViewRoadAnchor, "PacketPlumber.View.RoadAnchor",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPViewRoadAnchor::RunTest(const FString &Parameters)
+{
+	// The r2 blocker: a road from A to B must have its rendered center at the
+	// midpoint AND its endpoints at the node centers. The slot anchor is the
+	// box top-left; Center - (Length/2, Height/2) places the box center on
+	// the midpoint.
+	const FVector2D A(100.f, 100.f);
+	const FVector2D B(300.f, 100.f); // horizontal road, length 200
+	const FVector2D Center = (A + B) * 0.5f;
+	const float Width = 14.f;
+
+	// fill box: size (Length, Width) anchored at Center - (L/2, W/2) -> box
+	// center at Center (the rotation pivot sits on the road midpoint).
+	const FVector2D FillTopLeft = PPViewGeometry::RoadSlotTopLeft(Center, 200.f, Width);
+	TestTrue(TEXT("fill anchor x = Center.X - Length/2"), FMath::IsNearlyEqual(FillTopLeft.X, Center.X - 100.f));
+	TestTrue(TEXT("fill anchor y = Center.Y - Width/2"), FMath::IsNearlyEqual(FillTopLeft.Y, Center.Y - 7.f));
+	const FVector2D FillBoxCenter = FillTopLeft + FVector2D(100.f, 7.f);
+	TestTrue(TEXT("fill box center must sit on the road midpoint"), FillBoxCenter.Equals(Center, 0.01f));
+	// the box spans A..B -> the road's rendered endpoints ARE the node centers
+	TestTrue(TEXT("fill box left edge = node A"), FMath::IsNearlyEqual(FillTopLeft.X, A.X));
+	TestTrue(TEXT("fill box right edge = node B"), FMath::IsNearlyEqual(FillTopLeft.X + 200.f, B.X));
+
+	// casing box: (Length, Width+4) anchored the same way
+	const float CasingH = PPViewGeometry::RoadCasingHeight(Width, 2.f);
+	TestTrue(TEXT("casing height = width + 2*casing"), FMath::IsNearlyEqual(CasingH, 18.f));
+	const FVector2D CasingTopLeft = PPViewGeometry::RoadSlotTopLeft(Center, 200.f, CasingH);
+	TestTrue(TEXT("casing box center must sit on the road midpoint"),
+			 (CasingTopLeft + FVector2D(100.f, CasingH * 0.5f)).Equals(Center, 0.01f));
+
+	// a DIAGONAL road (the pivot rotation case): the box center must be the
+	// midpoint regardless of the angle.
+	const FVector2D C(0.f, 0.f);
+	const FVector2D D(80.f, 60.f); // length 100
+	const FVector2D DiagCenter = (C + D) * 0.5f;
+	const FVector2D DiagTopLeft = PPViewGeometry::RoadSlotTopLeft(DiagCenter, 100.f, Width);
+	TestTrue(TEXT("diagonal road: box center on the midpoint"),
+			 (DiagTopLeft + FVector2D(50.f, Width * 0.5f)).Equals(DiagCenter, 0.01f));
+	return true;
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPViewDotOnRoad, "PacketPlumber.View.DotOnRoad",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPViewDotOnRoad::RunTest(const FString &Parameters)
+{
+	// The r2 warning: the dot rode half a tile off the road because the
+	// position math added the +0.5 tile-center offset twice (once in the
+	// packet position, once in the fit mapping). The fit mapping adds it
+	// EXACTLY ONCE — a packet mid-edge must land ON the road between the two
+	// node centers.
+	const FPPScreenFit Fit = MakeScreenFit(FVector2D(1280.f, 720.f)); // scale 0.9231, offset (160,0)
+
+	// a snapshot: nodes at grid (2,2) and (6,2), a packet half-way along
+	PPView::FSnapshot Snap;
+	Snap.Tick = 1;
+	PPView::FNodeView N0;
+	N0.Id = 0;
+	N0.Pos = PP::FIntPoint{2, 2};
+	Snap.Nodes.Add(N0);
+	PPView::FNodeView N1;
+	N1.Id = 1;
+	N1.Pos = PP::FIntPoint{6, 2};
+	Snap.Nodes.Add(N1);
+	PPView::FPacketView P;
+	P.Id = 7;
+	P.FromNode = 0;
+	P.ToNode = 1;
+	P.Progress = 0.5f;
+	P.bOnEdge = true;
+	Snap.Packets.Add(P);
+
+	const FVector2D GridPos = PPViewGeometry::PacketGridPos(Snap, 7);
+	TestTrue(TEXT("packet grid pos must be the edge midpoint (4,2)"), GridPos.Equals(FVector2D(4.f, 2.f), 0.001f));
+
+	// screen space: the dot must sit ON the road segment between the nodes
+	const FVector2D DotScreen = Fit.GridToScreenV(GridPos);
+	const FVector2D N0Screen = Fit.GridToScreen(N0.Pos);
+	const FVector2D N1Screen = Fit.GridToScreen(N1.Pos);
+	TestTrue(TEXT("dot screen x must be between the nodes"), DotScreen.X > N0Screen.X && DotScreen.X < N1Screen.X);
+	TestTrue(TEXT("dot screen x must be the midpoint of the node centers"),
+			 FMath::IsNearlyEqual(DotScreen.X, (N0Screen.X + N1Screen.X) * 0.5f, 0.5f));
+	TestTrue(TEXT("dot screen y must equal the road row (both nodes at y=2)"),
+			 FMath::IsNearlyEqual(DotScreen.Y, N0Screen.Y, 0.5f));
+
+	// a packet absent from the snapshot -> zero (the caller falls back)
+	TestTrue(TEXT("absent packet must yield zero"), PPViewGeometry::PacketGridPos(Snap, 999) == FVector2D::ZeroVector);
+	return true;
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPViewSnapScale, "PacketPlumber.View.SnapRadiusScale",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPViewSnapScale::RunTest(const FString &Parameters)
+{
+	// E4: the snap radius is in WORLD px (kSnapRadius); the snap compares in
+	// SCREEN px, so the radius scales with the camera fit (r2 warning 3).
+	// At the 1280x720 design fit (scale 0.9231) the screen radius is ~33 px.
+	const FPPScreenFit Fit = MakeScreenFit(FVector2D(1280.f, 720.f));
+	TestTrue(TEXT("design-fit snap radius must scale to ~33 screen px"),
+			 FMath::IsNearlyEqual(static_cast<float>(PP::kSnapRadius) * Fit.Scale, 33.23f, 0.1f));
+
+	// A node at grid (2,2): its screen center; a point 30 screen px away is
+	// INSIDE the scaled radius; 40 px away is OUTSIDE.
+	PP::FTopology Topo;
+	PP::SpawnNode(Topo, PP::FNodeKind::Terminal, 2, 2);
+	const FVector2D NodeScreen = Fit.GridToScreen(PP::FIntPoint{2, 2});
+
+	uint32_t Hit = 0;
+	const bool bIn = FPPCommandBus::SnapToNode(Topo, NodeScreen + FVector2D(30.f, 0.f), FVector2D(1280.f, 720.f), Hit);
+	TestTrue(TEXT("30 px from the node center must snap (inside the scaled radius)"), bIn);
+	TestEqual(TEXT("the snapped node must be the terminal"), Hit, 0u);
+
+	uint32_t Hit2 = 0;
+	const bool bOut =
+		FPPCommandBus::SnapToNode(Topo, NodeScreen + FVector2D(40.f, 0.f), FVector2D(1280.f, 720.f), Hit2);
+	TestTrue(TEXT("40 px from the node center must NOT snap (outside the scaled radius)"), !bOut);
+	return true;
+}
+
+#endif // WITH_DEV_AUTOMATION_TESTS
