diff --git a/Source/PacketPlumberCoreTests/PP_Slice1SimTests.cpp b/Source/PacketPlumberCoreTests/PP_Slice1SimTests.cpp
new file mode 100644
index 0000000..cdca7ae
--- /dev/null
+++ b/Source/PacketPlumberCoreTests/PP_Slice1SimTests.cpp
@@ -0,0 +1,282 @@
+// PP_Slice1SimTests.cpp — the slice-1 dual-runner assertions, UE side.
+// Mirrors tests/spine_check.cpp CHECKs (story 1.1: the extended dual-runner
+// suite — topology / routing / bundles / flow / golden scenario). Same
+// headers, same numbers on both surfaces (UAD-17); the golden scenario is
+// built by PP_Scenario.h — the SAME builder the standalone runner and the
+// PPProbe commandlet use, so the three surfaces cannot drift.
+#include "Misc/AutomationTest.h"
+
+#include "PacketPlumberCore/PP_Scenario.h"
+#include "PacketPlumberCore/PP_Sim.h"
+
+#if WITH_DEV_AUTOMATION_TESTS
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPTopologyRules, "PacketPlumber.Topology.Rules",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPTopologyRules::RunTest(const FString &Parameters)
+{
+	// E3 self-loop, E26 terminal-pair, span rule, monotonic ids (E11).
+	PP::FTopology T;
+	const uint32_t Src = PP::SpawnNode(T, PP::FNodeKind::Terminal, 2, 2);
+	const uint32_t Rtr = PP::SpawnNode(T, PP::FNodeKind::Junction, 6, 2);
+	const uint32_t Snk = PP::SpawnNode(T, PP::FNodeKind::Terminal, 10, 2);
+	TestEqual(TEXT("node ids must be monotonic from 0 (E11)"), Src, 0u);
+	TestEqual(TEXT("node ids must be monotonic (1)"), Rtr, 1u);
+	TestEqual(TEXT("node ids must be monotonic (2)"), Snk, 2u);
+
+	TestTrue(TEXT("span metric 4 tiles horizontal"), PP::SpanBetween(PP::FIntPoint{2, 2}, PP::FIntPoint{6, 2}) == 4);
+	TestTrue(TEXT("span metric 3-4-5 triangle"), PP::SpanBetween(PP::FIntPoint{0, 0}, PP::FIntPoint{3, 4}) == 5);
+
+	TestTrue(TEXT("self-loop must reject (E3)"),
+			 PP::ApplyDraw(T, Src, Src, PP::TIER_STANDARD).Error == PP::FEditError::SelfLoop);
+	TestTrue(TEXT("terminal pair must reject (E26)"),
+			 PP::ApplyDraw(T, Src, Snk, PP::TIER_STANDARD).Error == PP::FEditError::TerminalToTerminal);
+	TestTrue(TEXT("missing node must reject"),
+			 PP::ApplyDraw(T, Src, 99, PP::TIER_STANDARD).Error == PP::FEditError::MissingNode);
+
+	PP::FTopology T2;
+	const uint32_t N0 = PP::SpawnNode(T2, PP::FNodeKind::Terminal, 0, 0);
+	const uint32_t N1 = PP::SpawnNode(T2, PP::FNodeKind::Junction, 20, 0);
+	TestTrue(TEXT("20-tile span must reject on standard (max 14)"),
+			 PP::ApplyDraw(T2, N0, N1, PP::TIER_STANDARD).Error == PP::FEditError::SpanExceedsTier);
+
+	const uint32_t GenBefore = T.Gen;
+	const PP::FEditResult R = PP::ApplyDraw(T, Src, Rtr, PP::TIER_STANDARD);
+	TestTrue(TEXT("source->router draw must apply"), R.Error == PP::FEditError::None && R.PipeId == 0);
+	TestTrue(TEXT("a draw must bump gen (rule-1 rebuild trigger)"), T.Gen == GenBefore + 1);
+	TestTrue(TEXT("cached pipe span must be the integer distance"), T.PipeSpan[0] == 4);
+	return true;
+}
