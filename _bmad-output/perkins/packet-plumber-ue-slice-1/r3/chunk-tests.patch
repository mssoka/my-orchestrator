+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPFlowDeliverE29, "PacketPlumber.Flow.DeliverAndE29",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPFlowDeliverE29::RunTest(const FString &Parameters)
+{
+	// Story 1.3: a packet spawns at tick 5, forwards per-hop, delivers at 10.
+	PP::FSimState S;
+	PP::BuildProbeScenario(S);
+	PP::StepScenario(S, 5);
+	TestEqual(TEXT("one packet must spawn at tick 5"), S.Flow.Packets.size(), static_cast<size_t>(1));
+	TestTrue(TEXT("the spawned packet must be on the first edge after the forward pass"), S.Flow.Packets[0].OnEdge);
+	TestTrue(TEXT("packet must head for the router"), S.Flow.Packets[0].Heading == PP::SCENARIO_ROUTER);
+	TestTrue(TEXT("a joiner must not consume bandwidth the tick it forwards"), S.Flow.Packets[0].ProgressUnits == 0);
+	PP::StepScenario(S, 7);
+	TestTrue(TEXT("packet must arrive at the router after 2 serve ticks"),
+			 !S.Flow.Packets[0].OnEdge && S.Flow.Packets[0].AtNode == PP::SCENARIO_ROUTER);
+	PP::StepScenario(S, 10);
+	TestEqual(TEXT("the packet must deliver at tick 10 (score 1)"), S.Score, 1);
+	TestTrue(TEXT("delivered packets must be culled"), S.Flow.Packets.empty());
+
+	// E29: a severed edge drops the packet back to its departure node; it
+	// re-forwards against the rebuilt table (no stale spawn-time route).
+	PP::FSimState S2;
+	PP::BuildProbeScenario(S2);
+	PP::StepScenario(S2, 5);
+	uint32_t Slot = 0;
+	PP::PipeSlot(S2.Topology, 0, Slot);
+	S2.Topology.PipeAlive[Slot] = 0;
+	S2.Topology.Gen += 1;
+	PP::Step(S2, 6);
+	TestEqual(TEXT("the packet must survive the severance"), S2.Flow.Packets.size(), static_cast<size_t>(1));
+	TestTrue(TEXT("E29: a severed-edge packet must drop back to its departure node"),
+			 !S2.Flow.Packets[0].OnEdge && S2.Flow.Packets[0].AtNode == PP::SCENARIO_SOURCE);
+	TestTrue(TEXT("a severed drop-back re-tries fresh"), S2.Flow.Packets[0].WaitingTicks == 0);
+	return true;
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPPGoldenScenario, "PacketPlumber.Determinism.GoldenScenario",
+								 EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FPPGoldenScenario::RunTest(const FString &Parameters)
+{
+	// The committed golden asserted engine-side (same numbers as
+	// docs/goldens/probe-seed42-ticks100.json + the spine-check inline CHECKs
+	// — re-bless updates BOTH + the engine probe via PPProbe).
