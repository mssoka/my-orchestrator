+	const TCHAR* Key2,
+	FString& OutValue)
+{
+	if (Params->TryGetStringField(Key1, OutValue) && !OutValue.IsEmpty())
+		return nullptr;
+	if (Params->TryGetStringField(Key2, OutValue) && !OutValue.IsEmpty())
+		return nullptr;
+	return MCPError(FString::Printf(TEXT("Missing required parameter '%s' (or '%s')"), Key1, Key2));
+}
