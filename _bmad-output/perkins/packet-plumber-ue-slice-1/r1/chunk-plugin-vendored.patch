diff --git a/Plugins/UE_MCP_Bridge/Source/UE_MCP_Bridge/Private/Handlers/AssetHandlers_Struct.cpp b/Plugins/UE_MCP_Bridge/Source/UE_MCP_Bridge/Private/Handlers/AssetHandlers_Struct.cpp
