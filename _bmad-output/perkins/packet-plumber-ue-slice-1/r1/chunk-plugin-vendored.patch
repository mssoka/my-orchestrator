+void FNetworkingHandlers::SaveBlueprint(UBlueprint* Blueprint)
+{
+	if (!Blueprint) return;
+	FKismetEditorUtilities::CompileBlueprint(Blueprint);
+	SaveAssetPackage(Blueprint);
+}
