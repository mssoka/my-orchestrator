+	// MetaSound graph authoring (AudioHandlers_MetaSound.cpp)
+	Registry.RegisterHandler(TEXT("metasound_author"), &MetaSoundAuthor);
+	Registry.RegisterHandler(TEXT("metasound_list_node_classes"), &MetaSoundListNodeClasses);
