+	if (!Ok(Result)) return MCPError(FString::Printf(TEXT("Failed to add graph output '%s' (%s)."), *Name, *DataType));
+
+	auto Res = MCPSuccess();
+	MCPSetCreated(Res);
+	Res->SetStringField(TEXT("output"), Name);
+	Res->SetStringField(TEXT("dataType"), DataType);
+	return MCPResult(Res);
+}
