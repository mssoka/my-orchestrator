+// PPRunView.h — the MM-look view layer (UAD-22, story 1.2/1.3).
+//
+// A UMG widget tree built ENTIRELY in C++ (no Blueprints, no content
+// assets): warm-cream canvas, ribbon roads with rounded casing, soft blob
+// shadows, clean flat vector look, and MM-style eased packet motion (1.3).
+// The view reads ONLY the PPView::FSnapshot pair (U-E9, ODN-1) — it never
+// touches the sim.
+//
+// Palette tokens (slice-1 look-parity baseline — the warm-cream MM palette;
+// these are view-layer constants, never sim state; catalog palettes land
+// with 3.1):
+//   Canvas        #F5F0E4  warm cream
+//   Road fill     #FFFFFF  white ribbon
+//   Road casing   #D8CFBB  warm tan casing (rounded)
+//   Source node   #E8A33D  warm amber
+//   Router node   #A8A29A  warm gray
+//   Sink node     #7FA6C9  muted blue
+//   Packet dot    #3E7CB1  blue dot
+//   Shadow        black @ 12% alpha, soft blob
+#pragma once
+
+#include "Blueprint/UserWidget.h"
+
+#include "PPViewSnapshot.h"
+
+#include "PPRunView.generated.h"
+
+class APPRunGameMode;
+class UCanvasPanel;
+class UImage;
+class UBorder;
+class UTextBlock;
+
+UCLASS()
+class UPPRunView : public UUserWidget
+{
+	GENERATED_BODY()
+
+  public:
+	UPPRunView(const FObjectInitializer &ObjectInitializer);
+
+	// Attach to the run GameMode: from here the view reads snapshots only.
+	void BindRun(APPRunGameMode *InGameMode);
+
+	// Rebuild the static widget tree from the current snapshot (nodes +
+	// pipes). Called on BindRun and whenever the topology changes.
+	void RebuildWorld();
+
+	// Tick the eased view (packet dots interpolate between the snapshot pair).
+	virtual void NativeTick(const FGeometry &MyGeometry, float InDeltaTime) override;
+
+  protected:
+	// C++-only widget: the tree is built HERE (NativeConstruct runs after the
+	// Slate widget exists — too late to set the root).
+	virtual TSharedRef<SWidget> RebuildWidget() override;
+
+  private:
+	FVector2D GridToScreen(const PP::FIntPoint &GridPos) const;
+	FVector2D GridToScreenV(const FVector2D &GridPos) const;
+
+	// --- widget helpers (all built in code) ---
+	UImage *MakeCircle(float Diameter, const FLinearColor &Color);
+	UBorder *MakeRoad(const FVector2D &FromScreen, const FVector2D &ToScreen, float Width, const FLinearColor &Fill,
+					  const FLinearColor &Casing);
+	UImage *MakePacketDot(float Diameter);
+
+	void ClearWorld();
+	void RefreshNodes();
+	void RefreshPipes();
+
+	UPROPERTY()
+	TObjectPtr<APPRunGameMode> GameMode = nullptr;
+
+	UPROPERTY()
+	TObjectPtr<UCanvasPanel> WorldCanvas = nullptr;
+
+	UPROPERTY()
+	TObjectPtr<UTextBlock> StatusText = nullptr;
+
+	// cached snapshot pair (the view copies what it needs — U-E9)
+	PPView::FSnapshot CurSnapshot;
+	PPView::FSnapshot PrevSnapshot;
+	bool bHasPrev = false;
+
+	// packet dot cache: packet id -> widget (pooled — UAD-8)
+	TMap<uint64_t, TObjectPtr<UImage>> PacketDots;
+	TMap<uint64_t, FVector2D> PacketPrevPos; // for eased interp
+
+	float ElapsedSinceSnapshot = 0.0f;
+
+	// screen mapping (camera-fit, shared with the command bus)
+	float FitScale = 1.0f;
+	FVector2D FitOffset = FVector2D::ZeroVector;
+};
diff --git a/Source/PacketPlumber/PPViewSnapshot.h b/Source/PacketPlumber/PPViewSnapshot.h
new file mode 100644
index 0000000..53b4b4e
--- /dev/null
+++ b/Source/PacketPlumber/PPViewSnapshot.h
@@ -0,0 +1,57 @@
+// PPViewSnapshot.h — the immutable view snapshot (U-E9 / UAD-1).
+//
+// The View layer reads ONLY this struct — it never touches the sim state
+// directly (view-reads-snapshot, ODN-1). The GameMode builds one per step
+// from PP::FSimState; widgets interpolate between the last two snapshots for
+// 60 fps (sim is 20 Hz — UAD-2) with presentation-only easing (UAD-22).
+//
+// This is engine-side (UE types allowed) — the sim set stays pure.
+#pragma once
+
+#include "CoreMinimal.h"
+
+#include "PacketPlumberCore/PP_Topology.h"
+
+namespace PPView
+{
+
+// One node as the view sees it: grid position + kind (palette comes from the
+// view layer, never from the sim).
+struct FNodeView
+{
+	uint32_t Id = 0;
+	PP::FNodeKind Kind = PP::FNodeKind::Terminal;
+	PP::FIntPoint Pos; // integer grid position (1 tile = 26 px, PP::kTilePx)
+};
+
+// One pipe as the view sees it (endpoint node ids).
+struct FPipeView
+{
+	uint32_t Id = 0;
+	uint32_t A = 0;
+	uint32_t B = 0;
+};
+
+// One packet as the view sees it: its current node (or the edge it rides)
+// + progress along that edge, so the view can place + ease the dot.
+struct FPacketView
+{
+	uint64_t Id = 0;
+	uint32_t FromNode = 0; // the node it departed (or sits at)
+	uint32_t ToNode = 0;   // the node it heads to (== FromNode when at a node)
+	float Progress = 0.0f; // 0..1 across the edge (presentation-only derived)
+	bool bOnEdge = false;
+};
+
+// The snapshot: everything the view needs for one sim tick. Plain data,
+// built fresh per step, copied (never referenced) by the view.
+struct FSnapshot
+{
+	uint64_t Tick = 0;
+	int32 Score = 0;
+	TArray<FNodeView> Nodes;
+	TArray<FPipeView> Pipes;
+	TArray<FPacketView> Packets;
+};
+
+} // namespace PPView
