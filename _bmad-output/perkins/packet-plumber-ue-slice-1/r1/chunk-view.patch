diff --git a/Source/PacketPlumber/PPCommandBus.cpp b/Source/PacketPlumber/PPCommandBus.cpp
new file mode 100644
index 0000000..541903f
--- /dev/null
+++ b/Source/PacketPlumber/PPCommandBus.cpp
@@ -0,0 +1,68 @@
+// PPCommandBus.cpp — the UAD-12 command bus (slice-1 drag-draw).
+#include "PPCommandBus.h"
+
+PP::FEditResult FPPCommandBus::DrawPipe(PP::FSimState &State, const FDrawIntent &Intent)
+{
+	// Both endpoints must snap to a node (the E4 inclusive snap was applied
+	// upstream by SnapToNode); a missing snap means the drag did not land on
+	// a valid pair — report MissingNode so the UI can give feedback.
+	if (!Intent.bStartOnNode || !Intent.bEndOnNode)
+	{
+		PP::FEditResult R;
+		R.Error = PP::FEditError::MissingNode;
+		return R;
+	}
+	PP::FCommand Cmd;
+	Cmd.Kind = PP::FCommandKind::DrawPipe;
+	Cmd.A = Intent.StartNode;
+	Cmd.B = Intent.EndNode;
+	Cmd.Tier = PP::TIER_STANDARD;	  // slice-1 draws the standard tier (canon 1.2)
+	return PP::ApplyEdit(State, Cmd); // live fast-path + log apply_tick = next
+}
+
+bool FPPCommandBus::SnapToNode(const PP::FTopology &Topology, const PP::FIntPoint &GridPos, uint32_t &OutNodeId)
+{
+	// E4 snap: inclusive at radius, measured in WORLD PX. The integer compare
+	// is exact: dist2 (grid) × tile_px² ≤ radius² (ODN-10 — no floats, no
+	// sqrt; the same metric family span validation uses).
+	const int64_t RadiusPx2 = static_cast<int64_t>(PP::kSnapRadius) * PP::kSnapRadius;
+	const int64_t TilePx2 = static_cast<int64_t>(PP::kTilePx) * PP::kTilePx;
+	uint32_t Best = 0;
+	int64_t BestD2 = INT64_MAX;
+	bool Found = false;
+	for (uint32_t Slot = 0; Slot < Topology.NodeAlive.size(); ++Slot)
+	{
+		if (!Topology.NodeAlive[Slot])
+		{
+			continue;
+		}
+		const PP::FIntPoint Pos{Topology.NodePosX[Slot], Topology.NodePosY[Slot]};
+		const int64_t D2 = PP::Dist2(Pos, GridPos);
+		if (D2 * TilePx2 <= RadiusPx2 && D2 < BestD2)
+		{
+			BestD2 = D2;
+			Best = Topology.NodeId[Slot];
+			Found = true;
+		}
+	}
+	if (Found)
+	{
+		OutNodeId = Best;
+	}
+	return Found;
+}
+
+PP::FIntPoint FPPCommandBus::ScreenToGrid(const FVector2D &ScreenPos, const FVector2D &ViewportSize)
+{
+	// Camera-fit: the map (PP::kMapTilesX × kMapTilesY tiles at kTilePx) is
+	// fit into the viewport with a uniform scale, centered. Screen -> grid:
+	// invert the fit. (The view layer owns the same mapping for rendering.)
+	const float WorldW = static_cast<float>(PP::kMapTilesX * PP::kTilePx);
+	const float WorldH = static_cast<float>(PP::kMapTilesY * PP::kTilePx);
+	const float Scale = FMath::Min(ViewportSize.X / WorldW, ViewportSize.Y / WorldH);
+	const float OffsetX = (ViewportSize.X - WorldW * Scale) * 0.5f;
+	const float OffsetY = (ViewportSize.Y - WorldH * Scale) * 0.5f;
+	const int32 TileX = static_cast<int32>(FMath::FloorToDouble((ScreenPos.X - OffsetX) / (Scale * PP::kTilePx)));
+	const int32 TileY = static_cast<int32>(FMath::FloorToDouble((ScreenPos.Y - OffsetY) / (Scale * PP::kTilePx)));
+	return PP::FIntPoint{TileX, TileY};
+}
diff --git a/Source/PacketPlumber/PPCommandBus.h b/Source/PacketPlumber/PPCommandBus.h
new file mode 100644
index 0000000..7ee17c5
--- /dev/null
+++ b/Source/PacketPlumber/PPCommandBus.h
@@ -0,0 +1,50 @@
+// PPCommandBus.h — the UAD-12 command bus: mouse intent -> FIntent ->
+// validated FCommand -> sim apply (live fast-path + action log).
+//
+// Slice-1 scope (story 1.2): drag-draw a pipe. The bus resolves the pointer
+// to a node id (snap-to-node, inclusive at radius [E4]), builds a
+// FCommand::DrawPipe, and applies it via PP::ApplyEdit — the SAME
+// validate-then-apply the replay path uses (one legality path, so live and
+// replay can never diverge). The edit fast-path (ODN-2): applied this frame,
+// logged with apply_tick = next; replay re-applies the log entry at that
+// tick before stepping.
+//
+// Engine-side (UE types allowed); the SIM stays pure (PP headers only).
+#pragma once
+
+#include "CoreMinimal.h"
+
+#include "PacketPlumberCore/PP_Sim.h"
+
+class APPRunGameMode;
+
+// A drag intent in GRID coordinates (tile space, integer). The bus snaps
+// screen positions to the nearest node within the E4 radius before building
+// the command.
+struct FDrawIntent
+{
+	bool bStartOnNode = false;
+	uint32_t StartNode = 0; // snapped node id (valid when bStartOnNode)
+	bool bEndOnNode = false;
+	uint32_t EndNode = 0; // snapped node id (valid when bEndOnNode)
+};
+
+class FPPCommandBus
+{
+  public:
+	// Build + apply a draw command from a drag intent. Returns the edit
+	// result (ok + reason — self_loop [E3], terminal_pair [E26],
+	// span_exceeds, ...). The apply is the live fast-path: the edit lands
+	// immediately in the topology + is logged with apply_tick = next.
+	PP::FEditResult DrawPipe(PP::FSimState &State, const FDrawIntent &Intent);
+
+	// Snap a GRID position to a node id within the E4 snap radius. The
+	// radius is INCLUSIVE (E4) and measured in world px (kSnapRadius) — the
+	// integer compare uses dist2 × tile_px² ≤ radius² (exact, ODN-10).
+	// Returns false when no node is in range.
+	static bool SnapToNode(const PP::FTopology &Topology, const PP::FIntPoint &GridPos, uint32_t &OutNodeId);
+
+	// Convert a SCREEN position to GRID (tile) coordinates. The view owns the
+	// screen->world mapping (camera-fit); the bus receives tile space.
+	static PP::FIntPoint ScreenToGrid(const FVector2D &ScreenPos, const FVector2D &ViewportSize);
+};
diff --git a/Source/PacketPlumber/PPRunGameMode.cpp b/Source/PacketPlumber/PPRunGameMode.cpp
new file mode 100644
index 0000000..1df3616
--- /dev/null
+++ b/Source/PacketPlumber/PPRunGameMode.cpp
@@ -0,0 +1,193 @@
+// PPRunGameMode.cpp — the run GameMode (slice 1.2/1.3).
+#include "PPRunGameMode.h"
+
+#include "Blueprint/UserWidget.h"
+#include "Logging/LogMacros.h"
+
+DEFINE_LOG_CATEGORY_STATIC(LogPPRun, Log, All);
+#include "Engine/World.h"
+#include "GameFramework/PlayerController.h"
+#include "PPRunPlayerController.h"
+#include "PPRunView.h"
+
+APPRunGameMode::APPRunGameMode()
+{
+	PrimaryActorTick.bCanEverTick = true;
+	// C++-first view: no BP pawn/controller needed for slice 1 — the widget
+	// reads snapshots and input routes through the bus.
+	DefaultPawnClass = nullptr;
+	PlayerControllerClass = APPRunPlayerController::StaticClass();
+}
+
+void APPRunGameMode::StartRun()
+{
+	// Fresh run arena (ODN-13). The static fixture: 1 source terminal, 1
+	// router junction, 1 sink terminal at the golden scenario's positions
+	// (PP_Scenario.h constants) — spawned as run setup (NOT in the action
+	// log, like the seed). NO pipes pre-drawn: story 1.2's player draws
+	// source->router->sink through the validated command bus. Demand: one
+	// packet every 20 ticks (1 s) source->sink once a path exists (1.3).
+	SimState.Initialize(42);
+	PP::SpawnNode(SimState.Topology, PP::FNodeKind::Terminal, 2, 2);  // SCENARIO_SOURCE
+	PP::SpawnNode(SimState.Topology, PP::FNodeKind::Junction, 6, 2);  // SCENARIO_ROUTER
+	PP::SpawnNode(SimState.Topology, PP::FNodeKind::Terminal, 10, 2); // SCENARIO_SINK
+	for (uint64_t T = 10; T <= 100000; T += 10)
+	{
+		PP::FlowSeedDemand(SimState.Flow, T, PP::SCENARIO_SOURCE, PP::SCENARIO_SINK, 0);
+	}
+	Driver.Reset();
+	BuildSnapshot();
+	PrevSnapshot = Snapshot;
+}
+
+void APPRunGameMode::BeginPlay()
+{
+	Super::BeginPlay();
+	StartRun();
+
+	// Create the C++ view widget (no asset — built entirely in code).
+	if (UClass *ViewClass = UPPRunView::StaticClass())
+	{
+		RunView = CreateWidget<UPPRunView>(GetWorld(), ViewClass);
+		if (RunView)
+		{
+			UE_LOG(LogPPRun, Display, TEXT("RunView created (class %s)"), *ViewClass->GetName());
+			RunView->AddToViewport(0);
+			RunView->BindRun(this);
+			UE_LOG(LogPPRun, Display, TEXT("RunView bound + added to viewport"));
+		}
+		else
+		{
+			UE_LOG(LogPPRun, Error, TEXT("RunView creation FAILED"));
+		}
+	}
+}
+
+void APPRunGameMode::EndPlay(const EEndPlayReason::Type EndPlayReason)
+{
+	RunView = nullptr;
+	Super::EndPlay(EndPlayReason);
+}
+
+void APPRunGameMode::Tick(float DeltaSeconds)
+{
+	Super::Tick(DeltaSeconds);
+	StepSim(DeltaSeconds);
+}
+
+void APPRunGameMode::StepSim(float DeltaSeconds)
+{
+	const int32 Stepped = Driver.Advance(SimState, DeltaSeconds);
+	if (Stepped > 0)
+	{
+		PrevSnapshot = Snapshot;
+		BuildSnapshot();
+	}
+}
+
+void APPRunGameMode::BuildSnapshot()
+{
+	// View reads ONLY snapshots (U-E9): copy what the view needs, nothing else.
+	Snapshot = PPView::FSnapshot{};
+	Snapshot.Tick = SimState.Tick;
+	Snapshot.Score = SimState.Score;
+	for (uint32_t Slot = 0; Slot < SimState.Topology.NodeAlive.size(); ++Slot)
+	{
+		if (!SimState.Topology.NodeAlive[Slot])
+		{
+			continue;
+		}
+		PPView::FNodeView N;
+		N.Id = SimState.Topology.NodeId[Slot];
+		N.Kind = static_cast<PP::FNodeKind>(SimState.Topology.NodeKind[Slot]);
+		N.Pos = PP::FIntPoint{SimState.Topology.NodePosX[Slot], SimState.Topology.NodePosY[Slot]};
+		Snapshot.Nodes.Add(N);
+	}
+	for (uint32_t Slot = 0; Slot < SimState.Topology.PipeAlive.size(); ++Slot)
+	{
+		if (!SimState.Topology.PipeAlive[Slot])
+		{
+			continue;
+		}
+		PPView::FPipeView P;
+		P.Id = SimState.Topology.PipeId[Slot];
+		P.A = SimState.Topology.PipeA[Slot];
+		P.B = SimState.Topology.PipeB[Slot];
+		Snapshot.Pipes.Add(P);
+	}
+	for (const PP::FPacket &Packet : SimState.Flow.Packets)
+	{
+		PPView::FPacketView PV;
+		PV.Id = Packet.Id;
+		PV.bOnEdge = Packet.OnEdge;
+		if (Packet.OnEdge)
+		{
+			// FromNode = the pipe's departure endpoint (AtNode — the departure
+			// node is kept while on edge, E29), ToNode = Heading. Progress:
+			// bandwidth units / packet bandwidth -> 0..1 across the edge.
+			PV.FromNode = Packet.AtNode;
+			PV.ToNode = Packet.Heading;
+			PV.Progress = FMath::Clamp(static_cast<float>(Packet.ProgressUnits) / PP::kPacketBandwidth, 0.0f, 1.0f);
+		}
+		else
+		{
+			PV.FromNode = Packet.AtNode;
+			PV.ToNode = Packet.AtNode;
+			PV.Progress = 0.0f;
+		}
+		Snapshot.Packets.Add(PV);
+	}
+}
+
+void APPRunGameMode::BeginDraw(const FVector2D &ScreenPos)
+{
+	if (APlayerController *PC = GetWorld()->GetFirstPlayerController())
+	{
+		int32 VW = 1280, VH = 720;
+		PC->GetViewportSize(VW, VH);
+		const FVector2D ViewportSize(static_cast<float>(VW), static_cast<float>(VH));
+		DragStartGrid = FPPCommandBus::ScreenToGrid(ScreenPos, ViewportSize);
+		bDragging = true;
+	}
+}
+
+void APPRunGameMode::EndDraw(const FVector2D &ScreenPos)
+{
+	if (!bDragging)
+	{
+		return;
+	}
+	bDragging = false;
+	if (APlayerController *PC = GetWorld()->GetFirstPlayerController())
+	{
+		int32 VW = 1280, VH = 720;
+		PC->GetViewportSize(VW, VH);
+		const FVector2D ViewportSize(static_cast<float>(VW), static_cast<float>(VH));
+		const PP::FIntPoint EndGrid = FPPCommandBus::ScreenToGrid(ScreenPos, ViewportSize);
+
+		FDrawIntent Intent;
+		uint32_t StartNode = 0, EndNode = 0;
+		Intent.bStartOnNode = FPPCommandBus::SnapToNode(SimState.Topology, DragStartGrid, StartNode);
+		Intent.bEndOnNode = FPPCommandBus::SnapToNode(SimState.Topology, EndGrid, EndNode);
+		if (Intent.bStartOnNode)
+		{
+			Intent.StartNode = StartNode;
+		}
+		if (Intent.bEndOnNode)
+		{
+			Intent.EndNode = EndNode;
+		}
+		// apply via the live fast-path (validate-then-apply + log apply_tick=next)
+		const PP::FEditResult Result = CommandBus.DrawPipe(SimState, Intent);
+		LastEditError = Result.Error;
+		bHasLastEditError = true;
+		// The edit lands in the topology immediately; the next Step picks it
+		// up (rebuild on gen change). The view refreshes on the next step.
+		if (Result.Error == PP::FEditError::None)
+		{
+			// immediate refresh so the drawn pipe appears THIS frame (1.2:
+			// "two pipes are created and appear instantly")
+			BuildSnapshot();
+		}
+	}
+}
diff --git a/Source/PacketPlumber/PPRunGameMode.h b/Source/PacketPlumber/PPRunGameMode.h
new file mode 100644
index 0000000..fdcaf39
--- /dev/null
+++ b/Source/PacketPlumber/PPRunGameMode.h
@@ -0,0 +1,96 @@
+// PPRunGameMode.h — the APPRunGameMode: owns the sim state + fixed-tick
+// driver + command bus, seeds the slice-1 static fixture, and emits the view
+// snapshot every step (U-E9: the view reads only snapshots).
+//
+// Story 1.2/1.3 scope (UAD-13 minimal): Boot -> Run. The fixture is the
+// golden scenario's (1 source terminal, 1 router junction, 1 sink terminal —
+// PP_Scenario.h constants) so PIE shows the SAME topology the golden pins;
+// the demand plan spawns a packet every N ticks so the player SEES the
+// packet travel once pipes are drawn (1.3).
+//
+// C++-first: no Blueprints, no content assets — the whole view is a UMG
+// widget tree built in code (UPPRunView).
+#pragma once
+
+#include "CoreMinimal.h"
+#include "GameFramework/GameModeBase.h"
+
+#include "PacketPlumberCore/PP_Scenario.h"
+#include "PacketPlumberCore/PP_Sim.h"
+
+#include "PPCommandBus.h"
+#include "PPSimDriver.h"
+#include "PPViewSnapshot.h"
+
+#include "PPRunGameMode.generated.h"
+
+class UPPRunView;
+
+UCLASS()
+class APPRunGameMode : public AGameModeBase
+{
+	GENERATED_BODY()
+
+  public:
+	APPRunGameMode();
+
+	// --- the run ---
+	// Fresh run arena (ODN-13): a new FSimState + fixture + demand. Retry
+	// (story 1.4 stub) calls this again — no state leakage.
+	void StartRun();
+
+	// --- snapshots (the view's only window into the sim, U-E9) ---
+	const PPView::FSnapshot &GetSnapshot() const
+	{
+		return Snapshot;
+	}
+	// Interpolation source: the view eases between the last two snapshots.
+	const PPView::FSnapshot &GetPrevSnapshot() const
+	{
+		return PrevSnapshot;
+	}
+
+	// --- the command bus (Enhanced Input routes drags here) ---
+	FPPCommandBus &GetCommandBus()
+	{
+		return CommandBus;
+	}
+
+	// Called by input: start/end a drag draw. ScreenPos in viewport pixels.
+	// BlueprintCallable so the MCP bridge (and any future input surface) can
+	// drive the SAME validated command-bus path the Enhanced Input actions
+	// use — one legality path for every device (UAD-12).
+	UFUNCTION(BlueprintCallable, Category = "Run")
+	void BeginDraw(const FVector2D &ScreenPos);
+
+	UFUNCTION(BlueprintCallable, Category = "Run")
+	void EndDraw(const FVector2D &ScreenPos);
+
+  protected:
+	virtual void BeginPlay() override;
+	virtual void EndPlay(const EEndPlayReason::Type EndPlayReason) override;
+	virtual void Tick(float DeltaSeconds) override;
+
+  private:
+	void BuildSnapshot();
+	void StepSim(float DeltaSeconds);
+
+	// the sim (plain data — no UPROPERTY, U-E4: no UObject points into sim memory)
+	PP::FSimState SimState;
+	FPPSimDriver Driver;
+	FPPCommandBus CommandBus;
+
+	// view snapshots (last two ticks — the 20 Hz -> 60 fps interp pair)
+	PPView::FSnapshot Snapshot;
+	PPView::FSnapshot PrevSnapshot;
+
+	// pending drag
+	bool bDragging = false;
+	PP::FIntPoint DragStartGrid;
+	// the last edit result, for the status line (rejection feedback)
+	PP::FEditError LastEditError = PP::FEditError::None;
+	bool bHasLastEditError = false;
+
+	UPROPERTY()
+	TObjectPtr<UPPRunView> RunView = nullptr;
+};
diff --git a/Source/PacketPlumber/PPRunPlayerController.cpp b/Source/PacketPlumber/PPRunPlayerController.cpp
