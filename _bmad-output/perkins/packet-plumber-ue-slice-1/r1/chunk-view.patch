@@ -0,0 +1,67 @@
+// PPRunPlayerController.cpp — Enhanced Input mouse draw (UAD-12).
+#include "PPRunPlayerController.h"
+
+#include "EnhancedInputComponent.h"
+#include "EnhancedInputSubsystems.h"
+#include "InputAction.h"
+#include "InputMappingContext.h"
+#include "PPRunGameMode.h"
+
+APPRunPlayerController::APPRunPlayerController()
+{
+	// The draw cursor must be visible (map-as-UI pointer).
+	bShowMouseCursor = true;
+	DefaultMouseCursor = EMouseCursor::Crosshairs;
+}
+
+void APPRunPlayerController::BeginPlay()
+{
+	Super::BeginPlay();
+
+	// Build the runtime input assets (C++-first — no Blueprint assets).
+	DrawMappingContext = NewObject<UInputMappingContext>(this, TEXT("PP_DrawContext"));
+	DrawStartAction = NewObject<UInputAction>(this, TEXT("PP_DrawStart"));
+	DrawStartAction->ValueType = EInputActionValueType::Boolean;
+	DrawEndAction = NewObject<UInputAction>(this, TEXT("PP_DrawEnd"));
+	DrawEndAction->ValueType = EInputActionValueType::Boolean;
+
+	DrawMappingContext->MapKey(DrawStartAction, EKeys::LeftMouseButton);
+	DrawMappingContext->MapKey(DrawEndAction, EKeys::LeftMouseButton);
+
+	if (UEnhancedInputLocalPlayerSubsystem *Subsystem =
+			ULocalPlayer::GetSubsystem<UEnhancedInputLocalPlayerSubsystem>(GetLocalPlayer()))
+	{
+		Subsystem->AddMappingContext(DrawMappingContext, 0);
+	}
+}
+
+void APPRunPlayerController::SetupInputComponent()
+{
+	Super::SetupInputComponent();
+
+	if (UEnhancedInputComponent *EIC = Cast<UEnhancedInputComponent>(InputComponent))
+	{
+		EIC->BindAction(DrawStartAction, ETriggerEvent::Started, this, &APPRunPlayerController::OnDrawStart);
+		EIC->BindAction(DrawEndAction, ETriggerEvent::Completed, this, &APPRunPlayerController::OnDrawEnd);
+	}
+}
+
+void APPRunPlayerController::OnDrawStart()
+{
+	if (APPRunGameMode *GM = GetWorld()->GetAuthGameMode<APPRunGameMode>())
+	{
+		float X = 0.0f, Y = 0.0f;
+		GetMousePosition(X, Y);
+		GM->BeginDraw(FVector2D(X, Y));
+	}
+}
+
+void APPRunPlayerController::OnDrawEnd()
+{
+	if (APPRunGameMode *GM = GetWorld()->GetAuthGameMode<APPRunGameMode>())
+	{
+		float X = 0.0f, Y = 0.0f;
+		GetMousePosition(X, Y);
+		GM->EndDraw(FVector2D(X, Y));
+	}
+}
diff --git a/Source/PacketPlumber/PPRunPlayerController.h b/Source/PacketPlumber/PPRunPlayerController.h
