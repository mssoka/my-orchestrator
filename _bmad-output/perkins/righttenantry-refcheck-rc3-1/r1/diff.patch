diff --git a/server/src/notification/sms_client.gleam b/server/src/notification/sms_client.gleam
new file mode 100644
index 00000000..5861505a
--- /dev/null
+++ b/server/src/notification/sms_client.gleam
@@ -0,0 +1,316 @@
+//// Twilio SMS Client
+//// Minimal Twilio REST helper for sending SMS via the Messages resource.
+////
+//// Mirrors `notification/email_client.gleam`'s REST-helper structure: a thin
+//// HTTP envelope over pure, tested builders. The sender is a Registered
+//// Alphanumeric Sender ID (`TWILIO_ALPHA_SENDER`, "RTenantry") — there is no
+//// from-number, because Irish numbers are voice-only and the Alpha Sender ID
+//// IS the sender (architecture AD-5, corrected 2026-08-08 / PR #592).
+////
+//// Without Twilio keys configured the client no-ops (returns `Skipped`) — it
+//// never crashes a caller. Real Twilio API failures are captured to Sentry
+//// with context; the no-op path is not (it is expected config state).
+
+import envoy
+import gleam/bit_array
+import gleam/dynamic/decode
+import gleam/http
+import gleam/http/request
+import gleam/httpc
+import gleam/int
+import gleam/json
+import gleam/list
+import gleam/option.{type Option, None, Some}
+import gleam/string
+import gleam/uri
+import sentry/sentry_client
+import wisp
+
+/// The route rc3-6 owns for `X-Twilio-Signature`-verified delivery-status
+/// callbacks (architecture §7.2). Fixed here so the `StatusCallback` URL sent
+/// with every message resolves to that route once rc3-6 wires it. rc3-6 must
+/// not rename it without a redirect — it is a live contract the messages
+/// already in flight depend on.
+const status_callback_path = "/webhooks/twilio-sms"
+
+/// Twilio send timeout. Matches the established Resend/Stripe-client pattern
+/// (`notification/email_client.gleam`, `payment/stripe_client.gleam`): bounds
+/// how long a stalled Twilio hop can run on the dispatching thread. Sends are
+/// spawned by the cadence sweep (rc3-5), so a stalled request must not pin the
+/// sweep indefinitely.
+const send_timeout_ms = 10_000
+
+/// The configured Twilio credentials + sender. Constructed once at startup by
+/// `init` from env vars and threaded through `ServerConfig` (mirrors
+/// `sentry_client.{Enabled,Disabled}`).
+pub type TwilioConfig {
+  TwilioConfig(
+    account_sid: String,
+    auth_token: String,
+    alpha_sender: String,
+    status_callback_base_url: String,
+  )
+}
+
+/// A Twilio handle. `Disabled` (no keys) makes every send a no-op. The caller
+/// never has to guard — the client owns the no-op.
+pub type Twilio {
+  Enabled(TwilioConfig)
+  Disabled
+}
+
+/// The outcome of a send attempt. `Skipped` is the no-op result (no keys
+/// configured) — it is NOT an error.
+pub type SendOutcome {
+  Sent(message_sid: String)
+  Skipped
+}
+
+/// Read Twilio config from env. Returns `Disabled` when any of the account SID,
+/// auth token, or Alpha Sender ID is unset/empty (the three values a send
+/// cannot proceed without). A missing status-callback base URL does not
+/// disable the client — sends then omit the `StatusCallback` parameter (the
+/// Twilio API treats it as optional). Mirrors `sentry_client.init`.
+pub fn init() -> Twilio {
+  let sid = read_env("TWILIO_ACCOUNT_SID")
+  let token = read_env("TWILIO_AUTH_TOKEN")
+  let alpha_sender = read_env("TWILIO_ALPHA_SENDER")
+  let base_url = read_env("TWILIO_STATUS_CALLBACK_BASE_URL")
+
+  case sid, token, alpha_sender {
+    Some(sid), Some(token), Some(alpha_sender) ->
+      Enabled(TwilioConfig(
+        account_sid: sid,
+        auth_token: token,
+        alpha_sender:,
+        status_callback_base_url: base_url |> option.unwrap(""),
+      ))
+    _, _, _ -> {
+      wisp.log_warning(
+        "Twilio SMS disabled — TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_ALPHA_SENDER not all set. SMS sends will no-op.",
+      )
+      Disabled
+    }
+  }
+}
+
+fn read_env(name: String) -> Option(String) {
+  case envoy.get(name) {
+    Ok("") -> None
+    Ok(value) -> Some(value)
+    Error(_) -> None
+  }
+}
+
+/// Send an SMS via the Twilio Messages resource. No-ops (returns `Skipped`)
+/// when Twilio is `Disabled`. On a real Twilio API failure, captures the
+/// failure to Sentry with context and returns `Error(reason)` — the no-op path
+/// never captures (it is expected, not a failure).
+pub fn send_sms(
+  twilio twilio: Twilio,
+  sentry sentry: sentry_client.Sentry,
+  to to: String,
+  body body: String,
+) -> Result(SendOutcome, String) {
+  case twilio {
+    Disabled -> {
+      wisp.log_info("SMS skipped — Twilio not configured")
+      Ok(Skipped)
+    }
+    Enabled(cfg) -> do_send(cfg, sentry, to, body)
+  }
+}
+
+fn do_send(
+  cfg: TwilioConfig,
+  sentry: sentry_client.Sentry,
+  to: String,
+  body: String,
+) -> Result(SendOutcome, String) {
+  case build_send_request(cfg, to:, body:) {
+    Error(reason) -> {
+      capture_failure(sentry, endpoint: "messages", message: reason, tags: [
+        #("phase", "build_request"),
+      ])
+      Error(reason)
+    }
+    Ok(req) -> {
+      let http_cfg = httpc.configure() |> httpc.timeout(send_timeout_ms)
+      case httpc.dispatch(http_cfg, req) {
+        Ok(resp) ->
+          case resp.status {
+            200 | 201 ->
+              case parse_send_response(resp.body) {
+                Ok(sid) -> Ok(Sent(message_sid: sid))
+                Error(reason) -> {
+                  capture_failure(
+                    sentry,
+                    endpoint: "messages",
+                    message: reason <> " body=" <> truncate(resp.body),
+                    tags: [#("http_status", int.to_string(resp.status))],
+                  )
+                  Error(reason)
+                }
+              }
+            status -> {
+              let reason = "Twilio API error: HTTP " <> int.to_string(status)
+              capture_failure(
+                sentry,
+                endpoint: "messages",
+                message: reason <> " body=" <> truncate(resp.body),
+                tags: [#("http_status", int.to_string(status))],
+              )
+              wisp.log_error(reason <> " body=" <> truncate(resp.body))
+              Error(reason)
+            }
+          }
+        Error(_) -> {
+          capture_failure(
+            sentry,
+            endpoint: "messages",
+            message: "HTTP request to Twilio failed",
+            tags: [#("error_kind", "connection")],
+          )
+          wisp.log_error("Connection failed to Twilio API")
+          Error("HTTP request to Twilio failed")
+        }
+      }
+    }
+  }
+}
+
+/// The Twilio Messages resource URL for an account. Pure for tests.
+pub fn build_messages_url(account_sid account_sid: String) -> String {
+  "https://api.twilio.com/2010-04-01/Accounts/"
+  <> account_sid
+  <> "/Messages.json"
+}
+
+/// The delivery-status callback URL for a given base. `base` is the public
+/// origin (e.g. `https://righttenantry.ie`); the path is the rc3-6 route.
+pub fn status_callback_url(base base: String) -> String {
+  base <> status_callback_path
+}
+
+/// The Basic-auth header value (`base64(SID:AuthToken)`) for the
+/// `Authorization: Basic ...` header. Twilio authenticates with HTTP Basic
+/// using AccountSID as the username and AuthToken as the password.
+pub fn basic_auth_header(
+  account_sid account_sid: String,
+  auth_token auth_token: String,
+) -> String {
+  let credentials = account_sid <> ":" <> auth_token
+  <<credentials:utf8>> |> bit_array.base64_encode(True)
+}
+
+/// The `application/x-www-form-urlencoded` body for a send. `callback` is
+/// included only when `Some` (a missing base URL sends without a callback).
+/// Pure for tests — verifies `From` carries the Alpha Sender ID (no
+/// from-number) and `StatusCallback` rides the request.
+pub fn build_send_form_body(
+  from from: String,
+  to to: String,
+  body body: String,
+  callback callback: Option(String),
+) -> String {
+  let params = [#("From", from), #("To", to), #("Body", body)]
+  let with_callback = case callback {
+    Some(url) -> list.append(params, [#("StatusCallback", url)])
+    None -> params
+  }
+  form_encode(with_callback)
+}
+
+/// Assemble the full Twilio Messages POST request. Exposed `@internal` for
+/// unit tests (asserts the URL, Basic auth header, content type, and body).
+@internal
+pub fn build_send_request(
+  cfg: TwilioConfig,
+  to to: String,
+  body body: String,
+) -> Result(request.Request(String), String) {
+  let url = build_messages_url(cfg.account_sid)
+  let callback = case cfg.status_callback_base_url {
+    "" -> option.None
+    base -> Some(status_callback_url(base))
+  }
+  case request.to(url) {
+    Ok(req) ->
+      req
+      |> request.set_method(http.Post)
+      |> request.set_header(
+        "authorization",
+        "Basic " <> basic_auth_header(cfg.account_sid, cfg.auth_token),
+      )
+      |> request.set_header("content-type", "application/x-www-form-urlencoded")
+      |> request.set_body(build_send_form_body(
+        from: cfg.alpha_sender,
+        to:,
+        body:,
+        callback:,
+      ))
+      |> Ok
+    Error(_) -> Error("Invalid Twilio Messages URL")
+  }
+}
+
+/// Decode the `sid` from a Twilio Messages response (`SM...`). Pure for tests.
+pub fn parse_send_response(body: String) -> Result(String, String) {
+  let decoder = {
+    use sid <- decode.field("sid", decode.string)
+    decode.success(sid)
+  }
+  case json.parse(body, decoder) {
+    Ok(sid) -> Ok(sid)
+    Error(_) -> Error("Couldn't parse Twilio send response")
+  }
+}
+
+// -- internals ---------------------------------------------------------------
+
+fn capture_failure(
+  sentry: sentry_client.Sentry,
+  endpoint endpoint: String,
+  message message: String,
+  tags tags: List(#(String, String)),
+) -> Nil {
+  sentry_client.capture(
+    sentry,
+    sentry_client.BackgroundEvent(
+      event_type: "TwilioSmsFailed",
+      message: sentry_client.truncate_message(message),
+      level: sentry_client.LevelError,
+      tags: [#("endpoint", endpoint), ..tags],
+    ),
+  )
+}
+
+/// Cap a Twilio response body for logging. Twilio error bodies echo the
+/// request `To`/`Body`; truncating bounds the PII footprint while still
+/// capturing the `error_code`/`message` envelope (mirrors stripe_client).
+fn truncate(body: String) -> String {
+  let max = 512
+  case string.length(body) > max {
+    True -> string.slice(body, 0, max) <> "…(truncated)"
+    False -> body
+  }
+}
+
+/// URL-encode form parameters for `application/x-www-form-urlencoded`.
+/// gleam's `uri.percent_encode` is a URI-component encoder and leaves `+`
+/// unencoded (a valid URI sub-delimiter) — but in a form body `+` means a
+/// space, so an E.164 `+353...` `To` value would arrive as ` 353...` with
+/// a leading space. We percent-encode, then re-encode any `+` as `%2B`.
+/// (Space is already `%20`, which form decoders accept.) Mirrors
+/// `payment/stripe_client.form_encode` with the `+` fix.
+fn form_encode(params: List(#(String, String))) -> String {
+  params
+  |> list.map(fn(pair) {
+    encode_form_value(pair.0) <> "=" <> encode_form_value(pair.1)
+  })
+  |> string.join("&")
+}
+
+fn encode_form_value(value: String) -> String {
+  uri.percent_encode(value) |> string.replace("+", "%2B")
+}
diff --git a/server/src/reference_checks/lookup.gleam b/server/src/reference_checks/lookup.gleam
new file mode 100644
index 00000000..695d9f11
--- /dev/null
+++ b/server/src/reference_checks/lookup.gleam
@@ -0,0 +1,205 @@
+//// Twilio Lookup v2 — line-type intelligence at capture (AD-10).
+////
+//// Queries the Twilio Lookup API for a phone number's line type (mobile /
+//// landline / VoIP) to populate the fraud-signal `line_type` /
+//// `voip_or_burner` fields. Reuses the SAME Twilio credentials as
+//// `notification/sms_client` (Account SID + Auth Token, AD-5) — there is no
+//// separate provisioning.
+////
+//// Without Twilio keys configured the lookup no-ops to `Unknown`. On a real
+//// Twilio API failure, captures to Sentry and returns `Unknown` — it NEVER
+//// blocks the caller. Per AD-10, line type is display / confidence content
+//// only; it never auto-rejects ("not verified" is not "fraudulent").
+
+import gleam/dynamic/decode
+import gleam/http
+import gleam/http/request
+import gleam/httpc
+import gleam/int
+import gleam/json
+import gleam/option
+import gleam/string
+import gleam/uri
+import notification/sms_client
+import sentry/sentry_client
+import wisp
+
+/// Lookup timeout. A stalled Lookup hop must not pin the row-creation path;
+/// on timeout the caller proceeds with `Unknown` (a missing fraud signal is
+/// always preferable to a blocked write).
+const lookup_timeout_ms = 10_000
+
+/// The line type of a phone number, mapped from Twilio Lookup's
+/// `line_type_intelligence.type` (which itself returns `mobile`, `landline`,
+/// `fixedVoIP`, `nonFixedVoIP`, `tollFree`, `premium`, `unknown`, ...). The
+/// `voip` helper derives the `voip_or_burner` signal from this.
+pub type LineType {
+  Mobile
+  Landline
+  VoIP
+  Unknown
+}
+
+/// Look up the line type for a phone number (E.164, e.g. `"+35386..."`).
+/// No-ops to `Unknown` when Twilio is `Disabled`; on any API failure captures
+/// to Sentry and returns `Unknown`. The caller is never blocked.
+pub fn lookup_line_type(
+  twilio twilio: sms_client.Twilio,
+  sentry sentry: sentry_client.Sentry,
+  phone phone: String,
+) -> LineType {
+  case twilio {
+    sms_client.Disabled -> {
+      wisp.log_info("Twilio Lookup skipped — not configured")
+      Unknown
+    }
+    sms_client.Enabled(cfg) -> do_lookup(cfg, sentry, phone)
+  }
+}
+
+fn do_lookup(
+  cfg: sms_client.TwilioConfig,
+  sentry: sentry_client.Sentry,
+  phone: String,
+) -> LineType {
+  case build_lookup_request(cfg, phone) {
+    Error(_) -> {
+      capture_failure(
+        sentry,
+        message: "Invalid Twilio Lookup URL for phone " <> phone,
+        tags: [#("phase", "build_request")],
+      )
+      Unknown
+    }
+    Ok(req) -> {
+      let http_cfg = httpc.configure() |> httpc.timeout(lookup_timeout_ms)
+      case httpc.dispatch(http_cfg, req) {
+        Ok(resp) ->
+          case resp.status {
+            200 -> parse_line_type(resp.body)
+            status -> {
+              capture_failure(
+                sentry,
+                message: "Twilio Lookup HTTP "
+                  <> int.to_string(status)
+                  <> " for phone "
+                  <> phone,
+                tags: [#("http_status", int.to_string(status))],
+              )
+              wisp.log_warning(
+                "Twilio Lookup failed: HTTP "
+                <> int.to_string(status)
+                <> " for phone "
+                <> phone,
+              )
+              Unknown
+            }
+          }
+        Error(_) -> {
+          capture_failure(
+            sentry,
+            message: "HTTP request to Twilio Lookup failed for phone " <> phone,
+            tags: [#("error_kind", "connection")],
+          )
+          wisp.log_warning("Connection failed to Twilio Lookup API")
+          Unknown
+        }
+      }
+    }
+  }
+}
+
+/// The Twilio Lookup v2 URL for a phone number. The `+` of an E.164 number is
+/// percent-encoded (`%2B`) for the path segment — gleam's `uri.percent_encode`
+/// leaves `+` unencoded (a valid URI sub-delimiter), so we re-encode it; the
+/// Twilio docs' curl examples use `%2B`. `Fields=line_type_intelligence`
+/// selects the paid line-type data package. Pure for tests.
+pub fn build_lookup_url(phone phone: String) -> String {
+  let encoded = uri.percent_encode(phone) |> string.replace("+", "%2B")
+  "https://lookups.twilio.com/v2/PhoneNumbers/"
+  <> encoded
+  <> "?Fields=line_type_intelligence"
+}
+
+/// Assemble the full Twilio Lookup GET request (HTTP Basic auth, same creds as
+/// SMS). Exposed `@internal` for unit tests.
+@internal
+pub fn build_lookup_request(
+  cfg: sms_client.TwilioConfig,
+  phone: String,
+) -> Result(request.Request(String), Nil) {
+  case request.to(build_lookup_url(phone:)) {
+    Ok(req) ->
+      req
+      |> request.set_method(http.Get)
+      |> request.set_header(
+        "authorization",
+        "Basic "
+          <> sms_client.basic_auth_header(
+          account_sid: cfg.account_sid,
+          auth_token: cfg.auth_token,
+        ),
+      )
+      |> Ok
+    Error(_) -> Error(Nil)
+  }
+}
+
+/// Decode a Twilio Lookup response into a `LineType`. Maps
+/// `line_type_intelligence.type`: `mobile`→Mobile, `landline`→Landline,
+/// `fixedVoIP`/`nonFixedVoIP`→VoIP; an absent/null `line_type_intelligence`,
+/// `valid:false`, or any parse failure → `Unknown`. Pure for tests.
+pub fn parse_line_type(body: String) -> LineType {
+  let lti_decoder = {
+    use typ <- decode.field("type", decode.string)
+    decode.success(typ)
+  }
+  let decoder = {
+    use valid <- decode.optional_field("valid", True, decode.bool)
+    use lti <- decode.optional_field(
+      "line_type_intelligence",
+      option.None,
+      decode.optional(lti_decoder),
+    )
+    let type_str = option.unwrap(lti, "")
+    decode.success(#(valid, type_str))
+  }
+  case json.parse(body, decoder) {
+    Ok(#(valid, type_str)) ->
+      case valid, type_str {
+        False, _ -> Unknown
+        True, "mobile" -> Mobile
+        True, "landline" -> Landline
+        True, "fixedVoIP" -> VoIP
+        True, "nonFixedVoIP" -> VoIP
+        True, _ -> Unknown
+      }
+    Error(_) -> Unknown
+  }
+}
+
+/// Whether a line type is VoIP — the `voip_or_burner` fraud signal's honest
+/// v1 value. (Line-type intelligence cannot detect "burner" numbers; that
+/// would need a different Lookup package or vendor. Per AD-10's honesty
+/// principle, v1 reports `voip` only.)
+pub fn voip(line_type line_type: LineType) -> Bool {
+  line_type == VoIP
+}
+
+// -- internals ---------------------------------------------------------------
+
+fn capture_failure(
+  sentry: sentry_client.Sentry,
+  message message: String,
+  tags tags: List(#(String, String)),
+) -> Nil {
+  sentry_client.capture(
+    sentry,
+    sentry_client.BackgroundEvent(
+      event_type: "TwilioLookupFailed",
+      message: sentry_client.truncate_message(message),
+      level: sentry_client.LevelWarning,
+      tags: [#("endpoint", "lookup"), ..tags],
+    ),
+  )
+}
