diff --git a/server/test/notification/sms_client_test.gleam b/server/test/notification/sms_client_test.gleam
new file mode 100644
index 00000000..cce35cc4
--- /dev/null
+++ b/server/test/notification/sms_client_test.gleam
@@ -0,0 +1,165 @@
+//// Unit tests for notification/sms_client — pure builders + the no-op path.
+//// Mirrors email_client_test's approach: the HTTP envelope (do_send) is thin
+//// glue exercised by integration/E2E, not unit-tested against httpc.
+
+import gleam/http
+import gleam/http/request
+import gleam/option.{None, Some}
+import gleam/string
+import gleeunit/should
+import notification/sms_client
+import sentry/sentry_client
+
+// -- build_send_form_body: the Alpha Sender ID is From (no from-number) ----
+
+pub fn form_body_uses_alpha_sender_as_from_test() {
+  let body =
+    sms_client.build_send_form_body(
+      from: "RTenantry",
+      to: "+353861234567",
+      body: "Hi",
+      callback: Some("https://righttenantry.ie/webhooks/twilio-sms"),
+    )
+  // The load-bearing assertion: From carries the Alpha Sender ID, not a number.
+  string.contains(body, "From=RTenantry")
+  |> should.be_true
+}
+
+pub fn form_body_encodes_to_e164_plus_test() {
+  let body =
+    sms_client.build_send_form_body(
+      from: "RTenantry",
+      to: "+353861234567",
+      body: "Hi",
+      callback: None,
+    )
+  string.contains(body, "To=%2B353861234567") |> should.be_true
+}
+
+pub fn form_body_includes_status_callback_when_present_test() {
+  let body =
+    sms_client.build_send_form_body(
+      from: "RTenantry",
+      to: "+353861234567",
+      body: "Hi",
+      callback: Some("https://righttenantry.ie/webhooks/twilio-sms"),
+    )
+  string.contains(body, "StatusCallback=https%3A%2F%2F") |> should.be_true
+}
+
+pub fn form_body_omits_status_callback_when_absent_test() {
+  let body =
+    sms_client.build_send_form_body(
+      from: "RTenantry",
+      to: "+353861234567",
+      body: "Hi",
+      callback: None,
+    )
+  string.contains(body, "StatusCallback") |> should.be_false
+}
+
+pub fn form_body_exact_without_callback_test() {
+  let body =
+    sms_client.build_send_form_body(
+      from: "RTenantry",
+      to: "+353861234567",
+      body: "Hi",
+      callback: None,
+    )
+  body
+  |> should.equal("From=RTenantry&To=%2B353861234567&Body=Hi")
+}
+
+// -- URLs -------------------------------------------------------------------
+
+pub fn build_messages_url_test() {
+  sms_client.build_messages_url(account_sid: "AC123abc")
+  |> should.equal(
+    "https://api.twilio.com/2010-04-01/Accounts/AC123abc/Messages.json",
+  )
+}
+
+pub fn status_callback_url_appends_route_test() {
+  sms_client.status_callback_url(base: "https://righttenantry.ie")
+  |> should.equal("https://righttenantry.ie/webhooks/twilio-sms")
+}
+
+// -- Basic auth -------------------------------------------------------------
+
+pub fn basic_auth_header_base64_encodes_credentials_test() {
+  sms_client.basic_auth_header(
+    account_sid: "ACtestsid",
+    auth_token: "sekrettoken",
+  )
+  |> should.equal("QUN0ZXN0c2lkOnNla3JldHRva2Vu")
+}
+
+// -- parse_send_response ----------------------------------------------------
+
+pub fn parse_send_response_decodes_sid_test() {
+  sms_client.parse_send_response("{\"sid\":\"SM123abc\",\"status\":\"queued\"}")
+  |> should.equal(Ok("SM123abc"))
+}
+
+pub fn parse_send_response_rejects_missing_sid_test() {
+  sms_client.parse_send_response("{\"status\":\"queued\"}")
+  |> should.be_error
+}
+
+pub fn parse_send_response_rejects_malformed_test() {
+  sms_client.parse_send_response("{not json")
+  |> should.be_error
+}
+
+// -- no-op path: Disabled never reaches HTTP (AC2) -------------------------
+
+pub fn send_sms_no_ops_when_disabled_test() {
+  sms_client.send_sms(
+    twilio: sms_client.Disabled,
+    sentry: sentry_client.Disabled,
+    to: "+353861234567",
+    body: "Hi",
+  )
+  |> should.equal(Ok(sms_client.Skipped))
+}
+
+// -- build_send_request: the assembled POST (AC1) --------------------------
+
+pub fn build_send_request_sets_post_basic_auth_and_form_body_test() {
+  let cfg =
+    sms_client.TwilioConfig(
+      account_sid: "ACtestsid",
+      auth_token: "sekrettoken",
+      alpha_sender: "RTenantry",
+      status_callback_base_url: "https://righttenantry.ie",
+    )
+  let req =
+    sms_client.build_send_request(cfg, to: "+353861234567", body: "Hi")
+    |> should.be_ok
+
+  req.method |> should.equal(http.Post)
+  request.get_header(req, "authorization")
+  |> should.equal(Ok("Basic QUN0ZXN0c2lkOnNla3JldHRva2Vu"))
+  request.get_header(req, "content-type")
+  |> should.equal(Ok("application/x-www-form-urlencoded"))
+  string.contains(req.body, "From=RTenantry")
+  |> should.be_true
+  string.contains(req.body, "StatusCallback=")
+  |> should.be_true
+}
+
+pub fn build_send_request_omits_callback_when_base_empty_test() {
+  let cfg =
+    sms_client.TwilioConfig(
+      account_sid: "ACtestsid",
+      auth_token: "sekrettoken",
+      alpha_sender: "RTenantry",
+      status_callback_base_url: "",
+    )
+  let req =
+    sms_client.build_send_request(cfg, to: "+353861234567", body: "Hi")
+    |> should.be_ok
+
+  string.contains(req.body, "StatusCallback")
+  |> should.be_false
+}
diff --git a/server/test/reference_checks/lookup_test.gleam b/server/test/reference_checks/lookup_test.gleam
new file mode 100644
index 00000000..c9239b94
--- /dev/null
+++ b/server/test/reference_checks/lookup_test.gleam
@@ -0,0 +1,101 @@
+//// Unit tests for reference_checks/lookup — line-type parsing, URL
+//// encoding, and the no-op path. The HTTP envelope (do_lookup) is thin glue
+//// exercised by integration, not unit-tested against httpc (mirrors
+//// email_client_test).
+
+import gleeunit/should
+import notification/sms_client
+import reference_checks/lookup
+import sentry/sentry_client
+
+// -- parse_line_type: maps Twilio line_type_intelligence.type (AC3) --------
+
+pub fn parse_line_type_mobile_test() {
+  lookup.parse_line_type(
+    "{\"valid\":true,\"line_type_intelligence\":{\"type\":\"mobile\"}}",
+  )
+  |> should.equal(lookup.Mobile)
+}
+
+pub fn parse_line_type_landline_test() {
+  lookup.parse_line_type(
+    "{\"valid\":true,\"line_type_intelligence\":{\"type\":\"landline\"}}",
+  )
+  |> should.equal(lookup.Landline)
+}
+
+pub fn parse_line_type_fixed_voip_test() {
+  lookup.parse_line_type(
+    "{\"valid\":true,\"line_type_intelligence\":{\"type\":\"fixedVoIP\"}}",
+  )
+  |> should.equal(lookup.VoIP)
+}
+
+pub fn parse_line_type_nonfixed_voip_test() {
+  lookup.parse_line_type(
+    "{\"valid\":true,\"line_type_intelligence\":{\"type\":\"nonFixedVoIP\"}}",
+  )
+  |> should.equal(lookup.VoIP)
+}
+
+pub fn parse_line_type_other_type_is_unknown_test() {
+  lookup.parse_line_type(
+    "{\"valid\":true,\"line_type_intelligence\":{\"type\":\"tollFree\"}}",
+  )
+  |> should.equal(lookup.Unknown)
+}
+
+pub fn parse_line_type_invalid_number_is_unknown_test() {
+  // valid:false wins — an invalid number never reports a line type.
+  lookup.parse_line_type("{\"valid\":false,\"line_type_intelligence\":null}")
+  |> should.equal(lookup.Unknown)
+}
+
+pub fn parse_line_type_null_intelligence_is_unknown_test() {
+  lookup.parse_line_type("{\"valid\":true,\"line_type_intelligence\":null}")
+  |> should.equal(lookup.Unknown)
+}
+
+pub fn parse_line_type_missing_intelligence_is_unknown_test() {
+  // Basic Lookup (no Fields) returns no line_type_intelligence.
+  lookup.parse_line_type("{\"valid\":true,\"phone_number\":\"+353861234567\"}")
+  |> should.equal(lookup.Unknown)
+}
+
+pub fn parse_line_type_malformed_is_unknown_test() {
+  lookup.parse_line_type("{not json") |> should.equal(lookup.Unknown)
+}
+
+// -- build_lookup_url: the + is percent-encoded (AC3) ----------------------
+
+pub fn build_lookup_url_percent_encodes_plus_test() {
+  lookup.build_lookup_url(phone: "+353861234567")
+  |> should.equal(
+    "https://lookups.twilio.com/v2/PhoneNumbers/%2B353861234567?Fields=line_type_intelligence",
+  )
+}
+
+// -- no-op path: Disabled never reaches HTTP (AC2/AC3) ---------------------
+
+pub fn lookup_line_type_no_ops_to_unknown_when_disabled_test() {
+  lookup.lookup_line_type(
+    twilio: sms_client.Disabled,
+    sentry: sentry_client.Disabled,
+    phone: "+353861234567",
+  )
+  |> should.equal(lookup.Unknown)
+}
+
+// -- voip helper (the voip_or_burner signal, honestly scoped) --------------
+
+pub fn voip_true_for_voip_test() {
+  lookup.voip(line_type: lookup.VoIP) |> should.be_true
+}
+
+pub fn voip_false_for_mobile_test() {
+  lookup.voip(line_type: lookup.Mobile) |> should.be_false
+}
+
+pub fn voip_false_for_unknown_test() {
+  lookup.voip(line_type: lookup.Unknown) |> should.be_false
+}
