+class_name ISaveBackend
+extends RefCounted
+## Save seam: the thin Go/Postgres server drops in later as a one-class swap.
+## Implementations must be synchronous and JSON-friendly; state is a plain Dictionary.
+
+func save_game(_state: Dictionary) -> bool:
+	push_error("ISaveBackend.save_game: not implemented")
+	return false
+
+
+## Returns {ok: bool, state: Dictionary, corrupted: bool}.
+## corrupted=true means a save existed but was unreadable (caller keeps the
+## street name via load_street_name() and starts fresh — never crash).
+func load_game() -> Dictionary:
+	push_error("ISaveBackend.load_game: not implemented")
+	return {"ok": false, "state": {}, "corrupted": false}
+
+
+func has_save() -> bool:
+	push_error("ISaveBackend.has_save: not implemented")
+	return false
+
+
+func clear_save() -> void:
+	push_error("ISaveBackend.clear_save: not implemented")
+
+
+## Street name is stored separately so a corrupted main save can still
+## keep the kid's chosen street name (spec edge-case matrix).
+func save_street_name(_street_name: String) -> void:
+	push_error("ISaveBackend.save_street_name: not implemented")
+
+
+func load_street_name() -> String:
+	push_error("ISaveBackend.load_street_name: not implemented")
+	return ""
