+extends SceneTree
+## Unit tests for the pure game logic — run headless:
+##   godot --headless --path game --script res://tests/test_economy.gd
+## Exit code 0 = all green. Covers the spec's I/O & edge-case matrix rows.
+
+var _failures := 0
+var _checks := 0
+
+
+func _initialize() -> void:
+	print("== FinLit prototype: economy/save/tutor tests ==")
+	test_tick_no_assets_zero_income()
+	test_rate_hike_no_debt_is_teach_beat()
+	test_rate_hike_with_debt_charges_interest()
+	test_burst_pipe_damages_and_can_go_negative()
+	test_burst_pipe_ignores_stocks()
+	test_wage_drop_and_first_job()
+	test_buy_upgrade_repair_flow()
+	test_farm_lumpy_and_stocks_volatile()
+	test_life_lottery_frames_and_reroll_stub()
+	test_corrupt_save_keeps_street_name()
+	test_save_roundtrip_and_sanitize()
+	test_leaderboard_ranks_wealth_climbed()
+	test_tutor_brackets_and_options()
+	test_llm_payload_is_pseudonymous_and_capped()
+	print("== %d checks, %d failures ==" % [_checks, _failures])
+	quit(0 if _failures == 0 else 1)
+
+
+func check(condition: bool, label: String) -> void:
+	_checks += 1
+	if condition:
+		print("  ok  %s" % label)
+	else:
+		_failures += 1
+		printerr("FAIL  %s" % label)
+
+
+func make_state(bracket := "8-10") -> Dictionary:
+	var rng := RandomNumberGenerator.new()
+	rng.seed = 42
+	var lottery := FinLitLifeLottery.roll(rng)
+	return FinLitEconomy.new_state("Test Lane", bracket, lottery)
+
+
+func make_rng(seed := 7) -> RandomNumberGenerator:
+	var rng := RandomNumberGenerator.new()
+	rng.seed = seed
+	return rng
+
+
+## I/O matrix: TICK, no assets -> income $0; prompt nudges first purchase.
+func test_tick_no_assets_zero_income() -> void:
+	var state := make_state()
+	FinLitEconomy.take_job(state, "dog_walker")
+	var result := FinLitEconomy.market_tick(state, make_rng())
+	check(result["income"] == 0, "tick with no assets pays $0 income")
+	check(FinLitTutor.teach("savings_ready", state) != "", "nudge line exists for first purchase")
+
+
+## I/O matrix: rate-hike event, no mortgage/debt -> "no effect" teach beat.
+func test_rate_hike_no_debt_is_teach_beat() -> void:
+	var state := make_state()
+	state["balance"] = 50
+	var event := FinLitEconomy._event_rate_hike(state)
+	check(event["effect"] == "no_debt", "rate hike with no debt -> no effect")
+	check(event["cost"] == 0, "rate hike with no debt costs $0")
+	check(state["balance"] == 50, "balance untouched")
+	check(FinLitTutor.teach("rate_hike_no_effect", state) != "", "teach beat exists")
+
+
+func test_rate_hike_with_debt_charges_interest() -> void:
+	var state := make_state()
+	state["balance"] = -30
+	var event := FinLitEconomy._event_rate_hike(state)
+	check(event["effect"] == "interest_charged", "rate hike with debt -> interest")
+	check(event["cost"] >= FinLitEconomy.DEBT_INTEREST_MIN, "interest has a floor")
+	check(state["balance"] < -30, "debt deepened by interest, never game-over")
+
+
+## I/O matrix: disaster on uninsured building -> -$Y, repair visual, debt allowed.
+func test_burst_pipe_damages_and_can_go_negative() -> void:
+	var state := make_state()
+	FinLitEconomy.take_job(state, "lemonade_helper")
+	state["balance"] = 100
+	var bought := FinLitEconomy.buy_asset(state, "rental", "Sunny Duplex")
+	check(bought["ok"], "bought a duplex")
+	state["balance"] = 3 # Almost broke: repair must push into debt.
+	var event := FinLitEconomy._event_burst_pipe(state, make_rng())
+	check(event["effect"] == "damaged", "burst pipe hits the duplex")
+	check(state["balance"] < 0, "balance may go negative (debt indicator)")
+	var asset: Dictionary = state["assets"][0]
+	check(asset["damaged"], "asset flagged damaged (repair visual)")
+	# Damaged assets stop paying.
+	var tick := FinLitEconomy.market_tick(state, make_rng(99))
+	check(tick["per_asset"][0]["note"] == "damaged" or tick["per_asset"][0]["payout"] == 0, "damaged asset pays $0")
+
+
+func test_burst_pipe_ignores_stocks() -> void:
+	var state := make_state()
+	state["balance"] = 1000
+	FinLitEconomy.buy_asset(state, "stocks", "Bold Tower")
+	var event := FinLitEconomy._event_burst_pipe(state, make_rng())
+	check(event["effect"] == "no_target", "stocks can't flood -> no target")
+
+
+## Minute-one: take a starter job, wages land.
+func test_wage_drop_and_first_job() -> void:
+	var state := make_state()
+	state["lottery"]["housing"] = "couch"
+	state["lottery"]["traits"] = []
+	check(FinLitEconomy.job_wage(state) == 0, "no job -> no wage")
+	check(not FinLitEconomy.take_job(state, "astronaut"), "unknown job rejected")
+	check(FinLitEconomy.take_job(state, "dog_walker"), "dog walker taken")
+	check(FinLitEconomy.wage_drop(state) == 2, "dog walker pays $2/drop")
+	check(state["balance"] == 2, "wage lands in the jar")
+	check(state["total_earned"] == 2, "earnings tracked")
+	# Charming trait and parents allowance modify the drop.
+	state["lottery"]["traits"] = ["charming"]
+	state["lottery"]["housing"] = "parents"
+	var before: int = state["balance"]
+	FinLitEconomy.wage_drop(state)
+	check(state["balance"] - before == 4, "charming +$1 and parents allowance +$1 stack")
+
+
+func test_buy_upgrade_repair_flow() -> void:
+	var state := make_state()
+	var too_expensive := FinLitEconomy.buy_asset(state, "rental", "Sunny Duplex")
+	check(not too_expensive["ok"] and too_expensive["reason"] == "too_expensive", "can't buy with $0")
+	state["balance"] = 500
+	var bought := FinLitEconomy.buy_asset(state, "rental", "Sunny Duplex")
+	check(bought["ok"], "bought with enough cash")
+	check(state["balance"] == 440, "price deducted")
+	check(bought["asset"]["name"] == "Sunny Duplex", "asset is NAMED")
+	var asset_id: int = bought["asset"]["id"]
+	var up := FinLitEconomy.upgrade_asset(state, asset_id)
+	check(up["ok"] and up["asset"]["level"] == 2, "upgrade to level 2")
+	check(state["balance"] == 320, "upgrade price deducted")
+	state["assets"][0]["damaged"] = true
+	check(not FinLitEconomy.upgrade_asset(state, asset_id)["ok"], "can't upgrade while damaged")
+	check(FinLitEconomy.repair_cost(state["assets"][0]) == 16, "repair cost scales with level")
+	var fixed := FinLitEconomy.repair_asset(state, asset_id)
+	check(fixed["ok"] and not fixed["asset"]["damaged"], "repair clears damage")
+	FinLitEconomy.upgrade_asset(state, asset_id)
+	check(FinLitEconomy.upgrade_cost(state["assets"][0]) == -1, "level 3 is max")
+	check(not FinLitEconomy.upgrade_asset(state, asset_id)["ok"], "can't upgrade past max")
+	check(FinLitEconomy.net_worth(state) == state["balance"] + 60 + 120 + 240, "net worth = cash + book value")
+	check(FinLitEconomy.wealth_climbed(state) == FinLitEconomy.net_worth(state), "climb = net worth from $0")
+
+
+func test_farm_lumpy_and_stocks_volatile() -> void:
+	var state := make_state()
+	state["balance"] = 1000
+	FinLitEconomy.buy_asset(state, "farm", "Clover Patch")
+	FinLitEconomy.buy_asset(state, "stocks", "Bold Tower")
+	# No events this run: use a seeded rng and tolerate event draws by
+	# checking only the farm payout rhythm directly.
+	var farm: Dictionary = state["assets"][0]
+	var payouts: Array = []
+	for i in range(3):
+		var tick := FinLitEconomy.market_tick(state, make_rng(1000 + i))
+		payouts.append(tick["per_asset"][0]["payout"])
+	check(payouts[2] == 12, "farm pays on the 3rd tick (lumpy)")
+	check(payouts[0] == 0 and payouts[1] == 0, "farm is quiet between harvests")
+	check(farm["ticks_since_payout"] == 0, "harvest counter resets")
+	var stock: Dictionary = state["assets"][1]
+	var stock_tick := FinLitEconomy.market_tick(state, make_rng(5))
+	var stock_payout: int = stock_tick["per_asset"][1]["payout"]
+	check(stock_payout >= 0 and stock_payout <= 7, "stocks pay 0..2x avg (+lucky trait)")
+
+
+## I/O matrix: life lottery roll + no-housing roll gentle framing + reroll stub.
+func test_life_lottery_frames_and_reroll_stub() -> void:
+	var rng := make_rng(1)
+	var saw_couch := false
+	var saw_parents := false
+	var traits_ok := true
+	for i in range(40):
+		var lottery := FinLitLifeLottery.roll(rng)
+		if FinLitLifeLottery.housing_is_couch(lottery):
+			saw_couch = true
+			check(lottery["blurb"].contains("couch"), "couch roll keeps the gentle frame (roll %d)" % i)
+		else:
+			saw_parents = true
+		for t in lottery["traits"]:
+			if not FinLitLifeLottery.TRAITS.has(t):
+				traits_ok = false
+	check(saw_couch and saw_parents, "lottery lands both housing outcomes over 40 rolls")
+	check(traits_ok, "every rolled trait is pre-approved")
+	check(not FinLitLifeLottery.is_reroll_allowed(), "reroll stub: policy OPEN -> not allowed")
+	check(FinLitLifeLottery.reroll(rng).is_empty(), "reroll stub grants nothing")
+
+
+## I/O matrix: corrupt save -> fresh street, keep street name, never crash.
+func test_corrupt_save_keeps_street_name() -> void:
+	var backend := LocalJsonBackend.new()
+	backend.clear_save()
+	backend.save_street_name("Pickle Parade")
+	var file := FileAccess.open("user://finlit_save.json", FileAccess.WRITE)
+	file.store_string("{ not valid json !!!")
+	file.close()
+	var loaded := backend.load_game()
+	check(not loaded["ok"], "corrupt save does not load")
+	check(loaded["corrupted"], "corrupt save is DETECTED, never a crash")
+	check(backend.load_street_name() == "Pickle Parade", "street name survives corruption")
+	backend.clear_save()
+	DirAccess.remove_absolute("user://finlit_street_name.txt")
+
+
+func test_save_roundtrip_and_sanitize() -> void:
+	var backend := LocalJsonBackend.new()
+	var state := make_state()
+	state["balance"] = 123
+	FinLitEconomy.buy_asset(state, "rental", "Sunny Duplex")
+	check(backend.save_game(state), "save writes")
+	check(backend.has_save(), "has_save true after write")
+	var loaded := backend.load_game()
+	check(loaded["ok"], "save loads")
+	var restored: Dictionary = loaded["state"]
+	check(restored["street_name"] == "Test Lane", "street name persists (PERSISTENT)")
+	# JSON floats must be re-cast before use.
+	check(typeof(restored["assets"][0]["level"]) == TYPE_FLOAT, "JSON round-trip makes ints floats (sanity)")
+	FinLitEconomy.sanitize_state(restored)
+	check(restored["assets"][0]["level"] == 1, "sanitize restores int level")
+	check(restored["balance"] == 123 - 60, "balance persists")
+	backend.clear_save()
+
+
+## Leaderboard: rank by wealth CLIMBED, YOU row inserts sorted, bracket label.
+func test_leaderboard_ranks_wealth_climbed() -> void:
+	var data: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/fake_leaderboard.json"))
+	check(data["rows"].size() == 5, "5 fake rows")
+	check(data["brackets"].has("8-10") and data["brackets"].has("13-15"), "age-bracket labels exist")
+	for row in data["rows"]:
+		check(row.has("name") and row.has("climbed"), "row shape ok: %s" % row.get("name", "?"))
+	var state := make_state()
+	state["balance"] = 250
+	var rows: Array = data["rows"].duplicate()
+	rows.append({"name": "YOU", "climbed": FinLitEconomy.wealth_climbed(state)})
+	rows.sort_custom(func(a: Dictionary, b: Dictionary) -> bool: return a["climbed"] > b["climbed"])
+	var you_index := rows.find_custom(func(r: Dictionary) -> bool: return r["name"] == "YOU")
+	check(you_index == 1, "YOU at $250 ranks 2nd (climbed, not worth)")
+	var sorted := true
+	for i in range(rows.size() - 1):
+		if rows[i]["climbed"] < rows[i + 1]["climbed"]:
+			sorted = false
+	check(sorted, "board sorted by climb, descending")
+
+
+## Tutor: every trigger has a line per bracket; "?" explains state + options.
+func test_tutor_brackets_and_options() -> void:
+	for trigger in FinLitTutor.TEACH_LINES:
+		for bracket in FinLitTutor.BRACKETS:
+			var line: String = FinLitTutor.TEACH_LINES[trigger][bracket]
+			check(line.length() > 10, "teach line %s/%s" % [trigger, bracket])
+	check(FinLitTutor.normalize_bracket("45-99") == "8-10", "unknown bracket falls back")
+	var state := make_state("13-15")
+	var explained := FinLitTutor.explain_options(state)
+	check(explained.contains("FIND WORK"), "jobless state -> find work option")
+	FinLitEconomy.take_job(state, "paper_round")
+	state["balance"] = 100
+	explained = FinLitTutor.explain_options(state)
+	check(explained.contains("BUY"), "affordable assets appear as options")
+	check(not explained.contains("Sunny"), "no asset names before ownership")
+	state["balance"] = 100
+	FinLitEconomy.buy_asset(state, "rental", "Sunny Duplex")
+	state["assets"][0]["damaged"] = true
+	state["balance"] = 100
+	var named := FinLitTutor.available_options(state, true)
+	var anon := FinLitTutor.available_options(state, false)
+	check(str(named).contains("Sunny Duplex"), "named options for the kid")
+	check(not str(anon).contains("Sunny Duplex"), "PSEUDONYMOUS options for the LLM")
+
+
+## LLM rig: payload carries zero names/PII; output cap enforced; log writes.
+func test_llm_payload_is_pseudonymous_and_capped() -> void:
+	var state := make_state("11-12")
+	FinLitEconomy.take_job(state, "dog_walker")
+	state["balance"] = 100
+	FinLitEconomy.buy_asset(state, "rental", "Sunny Duplex")
+	var messages := FinLitLlmTutor.build_messages(state)
+	check(messages.size() == 2 and messages[0]["role"] == "system", "system + user messages")
+	var wire := JSON.stringify(messages)
+	check(messages[0]["content"].contains("Mrs. K"), "locked Mrs. K persona")
+	check(messages[0]["content"].contains("80 words"), "word cap in system prompt")
+	check(messages[0]["content"].contains("11-12") or messages[0]["content"].contains("11–12"), "bracket depth guidance")
+	check(not wire.contains("Sunny Duplex"), "no asset names in payload")
+	check(not wire.contains("Test Lane"), "no street name in payload")
+	check(not wire.contains("couch") and not wire.contains("parents"), "no housing detail in payload")
+	var long_text := ""
+	for i in range(120):
+		long_text += "word%d " % i
+	var trimmed := FinLitLlmTutor.trim_to_word_cap(long_text)
+	check(trimmed.split(" ").size() <= FinLitLlmTutor.WORD_CAP + 1, "hard 80-word output cap")
+	check(FinLitLlmTutor.trim_to_word_cap("  short answer ") == "short answer", "short text passes through")
+	var good := {"choices": [{"message": {"content": "Hello kid"}}]}
+	check(FinLitLlmTutor._extract_text(good) == "Hello kid", "response text extracted")
+	check(FinLitLlmTutor._extract_text({"error": {}}) == "", "error payload -> empty (fallback)")
+	if FileAccess.file_exists(FinLitLlmTutor.LOG_PATH):
+		DirAccess.remove_absolute(FinLitLlmTutor.LOG_PATH)
+	FinLitLlmTutor.append_log({"ts": "test", "source": "llm"})
+	FinLitLlmTutor.append_log({"ts": "test2", "source": "scripted_fallback"})
+	var raw := FileAccess.get_file_as_string(FinLitLlmTutor.LOG_PATH)
+	check(raw.split("\n", false).size() == 2, "jsonl log appends one line per call")
+	DirAccess.remove_absolute(FinLitLlmTutor.LOG_PATH)
+	check(FinLitLlmTutor.is_available() == (OS.get_environment("DEEPSEEK_API_KEY").strip_edges() != ""), "availability reads the env var only")
