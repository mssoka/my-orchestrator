+extends SceneTree
+## LIVE integration check for the real LLM tutor path (DeepSeek).
+## NOT part of the offline unit suite — needs DEEPSEEK_API_KEY in the env:
+##   set -a; source ../.env; set +a   # from the game/ dir
+##   godot --headless --path game --script res://tests/test_llm_live.gd
+## Skips green (exit 0) when the key is absent. This is the integrate-vs-drop
+## evaluation rig: it prints the exact payload and the raw answer.
+
+var _done := false
+var _failed := false
+
+
+func _initialize() -> void:
+	print("== LIVE LLM tutor check (DeepSeek %s) ==" % FinLitLlmTutor.MODEL)
+	if not FinLitLlmTutor.is_available():
+		print("SKIP: DEEPSEEK_API_KEY not set — offline path is the default.")
+		quit(0)
+		return
+	var tutor := FinLitLlmTutor.new()
+	root.add_child(tutor)
+	# HTTPRequest needs the tree iterating; _initialize runs before that.
+	await process_frame
+	# Same shaped state a real kid could be in: job, some cash, one asset.
+	var rng := RandomNumberGenerator.new()
+	rng.seed = 7
+	var lottery := FinLitLifeLottery.roll(rng)
+	var state := FinLitEconomy.new_state("Test Lane", "8-10", lottery)
+	FinLitEconomy.take_job(state, "dog_walker")
+	state["balance"] = 100
+	FinLitEconomy.buy_asset(state, "rental", "Sunny Duplex")
+	tutor.explain(state)
+	var started := Time.get_ticks_msec()
+	# Watchdog: the tutor has its own timeout+fallback; this guards the TEST.
+	var watchdog := create_timer(25.0)
+	watchdog.timeout.connect(func() -> void:
+		if not _done:
+			_failed = true
+			printerr("FAIL: no answer within 25s (tutor fallback should have fired)")
+			quit(1)
+	)
+	var result: Array = await tutor.explanation_ready
+	_done = true
+	var text: String = result[0]
+	var source: String = result[1]
+	var latency := Time.get_ticks_msec() - started
+	print("--- source: %s · %d ms ---" % [source, latency])
+	print("--- payload sent (pseudonymous check) ---")
+	print(JSON.stringify(JSON.parse_string(tutor.last_request_json), "  "))
+	print("--- answer ---")
+	print(text)
+	var words := text.split(" ", false).size()
+	print("--- %d words (cap %d) ---" % [words, FinLitLlmTutor.WORD_CAP])
+	if source != "llm":
+		_failed = true
+		printerr("FAIL: expected source=llm with a live key, got %s" % source)
+	elif words > FinLitLlmTutor.WORD_CAP + 5:
+		_failed = true
+		printerr("FAIL: answer exceeds the word cap")
+	var raw := FileAccess.get_file_as_string(FinLitLlmTutor.LOG_PATH)
+	var saw_llm_entry := false
+	for line in raw.split("\n", false):
+		var entry: Variant = JSON.parse_string(line)
+		if typeof(entry) == TYPE_DICTIONARY and entry.get("source", "") == "llm":
+			saw_llm_entry = true
+	if not saw_llm_entry:
+		_failed = true
+		printerr("FAIL: parent-reviewable jsonl log has no llm entry")
+	print("== %s ==" % ("FAIL" if _failed else "LIVE PATH OK"))
+	quit(1 if _failed else 0)
