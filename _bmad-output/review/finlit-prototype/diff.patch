+class_name FinLitTutor
+extends RefCounted
+## Scripted tutor: the AI-tutor stand-in behind the seam (spec task).
+## Two jobs:
+##   1. teach(trigger, state) — event-triggered one-line teach beats,
+##      age-bracketed (one age signal drives league bracket AND tutor depth).
+##   2. explain_options(state) — the child-initiated "?" button (ruled OQ3):
+##      reads player state + the child's available options, explains implications.
+## llm_tutor.gd swaps a real model in behind this exact interface; scripted
+## stays the default/offline path and the fallback on ANY error.
+
+const BRACKETS := ["8-10", "11-12", "13-15"]
+
+## Trigger -> per-bracket one-liners. Fact-card doctrine: the right fact at
+## the moment of consequence; optional flavor, never a quiz gate.
+const TEACH_LINES := {
+	"first_wage": {
+		"8-10": "That's a WAGE — money you earn for doing work. Work is how money starts.",
+		"11-12": "A wage is money traded for your time and effort. Almost everyone's money story starts here.",
+		"13-15": "Wages trade time for money — income you work for. The next level is money that works while you don't.",
+	},
+	"savings_ready": {
+		"8-10": "You saved enough to BUY something for your street! Owning things that pay you is the whole trick.",
+		"11-12": "You can afford your first asset. Assets pay you income every market tick — that's how savings become more money.",
+		"13-15": "Your savings can now become capital: an asset that generates cash flow. Cash stuffed in a jar just sits there.",
+	},
+	"first_asset": {
+		"8-10": "You OWN it! It's named, it's yours, and it pays you money every market tick.",
+		"11-12": "First asset acquired. It has a name, it persists, and it pays income — you're officially an owner, not just a worker.",
+		"13-15": "Asset acquired: you're converting labor income into capital income. Watch the per-tick payouts compound your options.",
+	},
+	"first_upgrade": {
+		"8-10": "Bigger building, bigger pay! Upgrading makes your thing earn MORE.",
+		"11-12": "Upgrade done: you reinvested profits to raise the asset's income. That's how owners grow — money back INTO the asset.",
+		"13-15": "Reinvestment: you spent cash flow to raise the asset's yield. Compounding is just doing that on repeat.",
+	},
+	"rate_hike_no_effect": {
+		"8-10": "Rates went up! It costs you NOTHING — you have no debt. Borrowed money is what rates bite.",
+		"11-12": "Rate hike, no effect — you carry no debt. Interest rates only squeeze people who owe money. Remember that feeling.",
+		"13-15": "The central bank raised rates; with zero debt you're untouched. This is why investors watch the Fed — debt gets expensive fast.",
+	},
+	"rate_hike_interest": {
+		"8-10": "Rates went UP and you owe money — so the bank took a little extra. Debt costs more when rates rise!",
+		"11-12": "Rate hike + your debt = interest charged. When rates rise, owing money gets pricier. That's the risk of borrowing.",
+		"13-15": "Interest charged on your negative balance: debt service just got more expensive. Leverage amplifies both gains AND pain.",
+	},
+	"burst_pipe": {
+		"8-10": "Oh no — a burst pipe! Owning things means paying to fix them. It came out of YOUR balance.",
+		"11-12": "Burst pipe: ownership includes surprise costs. Real investors keep a cash cushion for exactly this.",
+		"13-15": "An uninsured loss hit your asset — repairs and lost income while it's damaged. Risk management (cushion, insurance) is real.",
+	},
+	"repair_done": {
+		"8-10": "Fixed! Your building earns again. Fixing things fast keeps the money coming.",
+		"11-12": "Repaired — the asset is producing again. Downtime is the hidden cost of every breakdown.",
+		"13-15": "Back in service. Notice the double cost of the breakdown: the repair bill plus the income you missed.",
+	},
+	"debt": {
+		"8-10": "Your balance went below zero — that's DEBT. It's not game over! Earn your way back up.",
+		"11-12": "You're in debt: negative balance. No game over here — but debt grows teeth when rates rise. Climb out with wages.",
+		"13-15": "Negative balance = debt position. There's always a path back: wages first, then rebuild. Watch rate hikes while you owe.",
+	},
+	"era_owning": {
+		"8-10": "NEW ERA: Owning! Long ago people worked for coins — then learned to OWN things that earn. Just like you.",
+		"11-12": "Era shift: labor → ownership. For most of history people only earned wages; owners let assets do the earning. You're living it.",
+		"13-15": "You've re-enacted the jump from labor to capital — the move that built every fortune in money's history. Markets and loans come next.",
+	},
+	"era_growing": {
+		"8-10": "NEW ERA: Growing! Your things are getting BIGGER. That's how little streets become big ones.",
+		"11-12": "Era shift: owning → growing. Reinvesting into what you own is how small holdings become real wealth.",
+		"13-15": "You're compounding now — reinvested yield raising future yield. Banking and markets (loans, trading) are the next chapters.",
+	},
+	"max_level": {
+		"8-10": "MAX LEVEL! That building can't grow more — maybe a NEW thing for the street?",
+		"11-12": "Maxed out. One asset fully grown — diversification (owning different kinds) is the next lesson.",
+		"13-15": "Cap reached on this asset. Portfolio thinking starts here: spread across asset classes with different risk shapes.",
+	},
+}
+
+
+static func normalize_bracket(bracket: String) -> String:
+	return bracket if BRACKETS.has(bracket) else "8-10"
+
+
+## Event-triggered teach beat. Returns "" for unknown triggers (UI shows nothing).
+static func teach(trigger: String, state: Dictionary) -> String:
+	if not TEACH_LINES.has(trigger):
+		return ""
+	var bracket := normalize_bracket(state.get("age_bracket", "8-10"))
+	return TEACH_LINES[trigger][bracket]
+
+
+## The child's current options, as short kid-readable descriptions.
+## Shared by the scripted explainer AND the LLM payload (same ruled design:
+## the tutor sees player state + the child's options, nothing else).
+## include_names=false strips asset names for the pseudonymous LLM payload.
+static func available_options(state: Dictionary, include_names := true) -> Array:
+	var options: Array = []
+	var balance: int = state.get("balance", 0)
+	if state.get("job", "") == "":
+		options.append("FIND WORK — pick a starter job so wages begin")
+		return options
+	options.append("WORK SHIFT — earn a wage right now")
+	var cheapest := FinLitEconomy.cheapest_asset_price()
+	if state.get("assets", []).is_empty() and balance < cheapest:
+		options.append("SAVE UP — %d more dollars to your first building" % (cheapest - balance))
+	for type_key in FinLitEconomy.ASSET_ORDER:
+		var spec: Dictionary = FinLitEconomy.ASSET_TYPES[type_key]
+		var price: int = spec["levels"][0]["price"]
+		if balance >= price:
+			options.append("BUY %s %s — costs $%d, then pays you each market tick" % [spec["icon"], spec["title"], price])
+	for asset in state.get("assets", []):
+		var label: String = asset["name"] if include_names else "your %s" % FinLitEconomy.ASSET_TYPES[asset["type"]]["title"]
+		if asset["damaged"]:
+			options.append("FIX %s — $%d, then it earns again" % [label, FinLitEconomy.repair_cost(asset)])
+		else:
+			var cost := FinLitEconomy.upgrade_cost(asset)
+			if cost >= 0 and balance >= cost:
+				options.append("UPGRADE %s — $%d, it earns more every tick" % [label, cost])
+	if balance < 0:
+		options.append("EARN BACK — your balance is below zero; wages first")
+	return options
+
+
+## Scripted "?" answer: where you stand + what your options imply.
+static func explain_options(state: Dictionary) -> String:
+	var bracket := normalize_bracket(state.get("age_bracket", "8-10"))
+	var lines: Array = []
+	var balance: int = state.get("balance", 0)
+	var worth := FinLitEconomy.net_worth(state)
+	if state.get("job", "") == "":
+		lines.append("You have $0 and no job yet. In real life, money starts with work — pick a job you like!")
+		lines.append("Every job pays wages. Better pay, faster street.")
+		lines.append("Right now you could:\n• " + "\n• ".join(available_options(state)))
+		return "\n\n".join(lines)
+	match bracket:
+		"8-10":
+			lines.append("You have $%d in your jar. Your street is worth $%d." % [balance, worth])
+		"11-12":
+			lines.append("Cash on hand: $%d. Net worth (cash + everything you own): $%d." % [balance, worth])
+		_:
+			lines.append("Liquid cash $%d, net worth $%d — the gap is capital you've put to work." % [balance, worth])
+	var options := available_options(state)
+	if not options.is_empty():
+		lines.append("Right now you could:\n• " + "\n• ".join(options))
+	if balance < 0:
+		lines.append("You're below zero — that's debt. Wages will pull you back up; there's always a path forward.")
+	elif state.get("assets", []).is_empty():
+		lines.append("Saving for your first building is the big move — owners get paid every market tick.")
+	return "\n\n".join(lines)
