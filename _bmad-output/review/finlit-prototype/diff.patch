+class_name FinLitLifeLottery
+extends RefCounted
+## Life lottery: randomized starting circumstances, rolled once per new game.
+## Cartoonish luck, hard luck always comes with a visible path forward,
+## no shame states (spec fun guardrails). Everyone starts with $0.
+##
+## REROLL POLICY IS OPEN (canon question): reroll() exists as a stub so the
+## seam is ready, but is_reroll_allowed() returns false until Moses rules.
+
+const HOUSING_PARENTS := "parents"
+const HOUSING_COUCH := "couch"
+
+## Luck-flavored traits. Each is a small, visible mechanic — never a wall.
+const TRAITS := {
+	"lucky": {
+		"title": "Lucky Penny", "icon": "🍀",
+		"blurb": "Your stocks tend to pay a little extra.",
+	},
+	"charming": {
+		"title": "Big Smile", "icon": "😄",
+		"blurb": "People tip you. Every job pays +$1.",
+	},
+	"tough": {
+		"title": "Tough Boots", "icon": "🥾",
+		"blurb": "Repairs cost you less.",
+	},
+}
+
+## Housing odds: most kids land with parents (small allowance, free housing);
+## some land couch-surfing at a friend's — gently framed, same job offers.
+const COUCH_CHANCE := 0.25
+## How many traits a roll gets: 0..2, skewed toward 1.
+const TRAIT_WEIGHTS := [0.30, 0.50, 0.20]
+
+
+static func roll(rng: RandomNumberGenerator) -> Dictionary:
+	var lottery := {"housing": "", "traits": [], "title": "", "blurb": ""}
+	if rng.randf() < COUCH_CHANCE:
+		lottery["housing"] = HOUSING_COUCH
+		lottery["title"] = "A Friend's Couch"
+		# Gentle frame (Mrs. K warm-face pattern): warm, never a dead end.
+		lottery["blurb"] = "You stay on your friend's couch. It's cozy, and Mrs. K makes pancakes. Your job offers are the same as everyone's — your street is waiting."
+	else:
+		lottery["housing"] = HOUSING_PARENTS
+		lottery["title"] = "Home with Parents"
+		lottery["blurb"] = "Free housing and a small allowance that rides along with every wage. Lucky start — make it count!"
+	var roll_value := rng.randf()
+	var trait_count := 0
+	var cumulative := 0.0
+	for i in range(TRAIT_WEIGHTS.size()):
+		cumulative += TRAIT_WEIGHTS[i]
+		if roll_value < cumulative:
+			trait_count = i
+			break
+	var pool := TRAITS.keys()
+	for i in range(trait_count):
+		var pick := rng.randi_range(0, pool.size() - 1)
+		lottery["traits"].append(pool[pick])
+		pool.remove_at(pick)
+	return lottery
+
+
+## REROLL STUB — policy is an OPEN canon question (playtest first, then ruling).
+## The seam exists so a future ruling (free reroll? cost? lesson attached?)
+## drops in without touching call sites.
+static func is_reroll_allowed() -> bool:
+	return false
+
+
+static func reroll(_rng: RandomNumberGenerator) -> Dictionary:
+	push_warning("FinLitLifeLottery.reroll: reroll policy is OPEN — stub, no reroll granted.")
+	return {}
+
+
+static func housing_is_couch(lottery: Dictionary) -> bool:
+	return lottery.get("housing", "") == HOUSING_COUCH
