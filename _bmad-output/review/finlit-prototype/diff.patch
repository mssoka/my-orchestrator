+class_name FinLitSfx
+extends Node
+## Tiny synthesized system sounds (placeholder audio, zero assets on disk).
+## The wage is the juice moment: a bright coin blip for every wage drop.
+
+var _players: Array[AudioStreamPlayer] = []
+var _next := 0
+const POOL_SIZE := 4
+
+
+func _ready() -> void:
+	for i in range(POOL_SIZE):
+		var player := AudioStreamPlayer.new()
+		player.stream = _make_tone()
+		add_child(player)
+		_players.append(player)
+
+
+func coin() -> void:
+	_play(0.0)
+
+
+func thud() -> void:
+	_play(-7.0)
+
+
+func _play(pitch_offset: float) -> void:
+	if _players.is_empty():
+		return
+	var player := _players[_next]
+	_next = (_next + 1) % POOL_SIZE
+	player.pitch_scale = 1.0 + pitch_offset * 0.05
+	player.play()
+
+
+## A short two-tone "coin" chirp generated into an AudioStreamWAV.
+static func _make_tone() -> AudioStreamWAV:
+	var sample_rate := 22050
+	var seconds := 0.18
+	var frames := int(sample_rate * seconds)
+	var data := PackedByteArray()
+	data.resize(frames * 2) # 16-bit mono
+	for i in range(frames):
+		var t := float(i) / sample_rate
+		var freq := 1318.5 if t < seconds * 0.5 else 1760.0 # E6 -> A6
+		var envelope := 1.0 - (t / seconds)
+		var sample := sin(TAU * freq * t) * envelope * 0.35
+		var value := int(clampf(sample, -1.0, 1.0) * 32767.0)
+		data.encode_s16(i * 2, value)
+	var stream := AudioStreamWAV.new()
+	stream.format = AudioStreamWAV.FORMAT_16_BITS
+	stream.mix_rate = sample_rate
+	stream.stereo = false
+	stream.data = data
+	return stream
