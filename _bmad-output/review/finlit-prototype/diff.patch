+class_name FinLitLlmTutor
+extends Node
+## Real LLM tutor behind the tutor.gd seam (scope amendment 2026-07-31, Moses).
+##
+## Vendor: DeepSeek direct, OpenAI-compatible (supersedes the OQ3 OpenRouter
+## note — same cheapest-tier intent, vendor now named).
+##   POST https://api.deepseek.com/chat/completions · model deepseek-v4-flash
+##   Bearer $DEEPSEEK_API_KEY (env only — never committed, never logged).
+##
+## Ruled design (unchanged): child-initiated "?" button ONLY — no free-form
+## chat; locked Mrs. K persona; pseudonymous payload (player state + the
+## child's options, zero names/PII); age-bracketed depth.
+##
+## Guardrails: system-prompt scope lock (game/money topics only) · ~80-word
+## output cap (max_tokens + hard trim) · timeout + scripted-line fallback on
+## ANY error · local parent-reviewable jsonl log of every call.
+##
+## This is the integrate-vs-drop evaluation rig: prompts and responses are
+## fully visible (log + debug toggle in the "?" panel).
+
+signal explanation_ready(text: String, source: String)
+## source: "llm" | "scripted_fallback" | "scripted" (LLM not configured)
+
+const API_URL := "https://api.deepseek.com/chat/completions"
+const MODEL := "deepseek-v4-flash"
+const TIMEOUT_SECONDS := 10.0
+const WORD_CAP := 80
+## ~80 words + safety headroom for the model's own phrasing.
+const MAX_TOKENS := 200
+const TEMPERATURE := 0.4
+const LOG_PATH := "user://tutor_llm_log.jsonl"
+
+## Thinking mode is ON by default for deepseek-v4-flash and burns the token
+## budget on chain-of-thought — an 80-word kid answer needs none of it
+## (cheaper + faster, the cheapest-tier intent). Disabled explicitly.
+const THINKING := {"type": "disabled"}
+
+var _http: HTTPRequest
+var _busy := false
+## Exact payload of the last request, for the debug compare view. No API key.
+var last_request_json := ""
+var last_response_json := ""
+
+
+func _ready() -> void:
+	_ensure_http()
+
+
+func _ensure_http() -> void:
+	if _http != null:
+		return
+	_http = HTTPRequest.new()
+	_http.name = "TutorHttp"
+	add_child(_http)
+	_http.request_completed.connect(_on_request_completed)
+
+
+static func is_available() -> bool:
+	return OS.get_environment("DEEPSEEK_API_KEY").strip_edges() != ""
+
+
+## Child-initiated "?" only: explains player state + current options.
+## Falls back to the scripted line on ANY error — the game never breaks
+## because a network call did.
+func explain(state: Dictionary) -> void:
+	var fallback := FinLitTutor.explain_options(state)
+	if not is_available():
+		# Deferred so the caller's `await` is already in place.
+		explanation_ready.emit.call_deferred(fallback, "scripted")
+		return
+	if _busy:
+		explanation_ready.emit.call_deferred(fallback, "scripted_fallback")
+		return
+	_busy = true
+	_ensure_http()
+	_state_snapshot = state.duplicate()
+	_started_ms = Time.get_ticks_msec()
+	var messages := build_messages(state)
+	_last_messages = messages
+	var body := JSON.stringify({
+		"model": MODEL,
+		"messages": messages,
+		"max_tokens": MAX_TOKENS,
+		"temperature": TEMPERATURE,
+		"thinking": THINKING,
+		"stream": false,
+	})
+	last_request_json = body
+	var headers := [
+		"Content-Type: application/json",
+		"Authorization: Bearer %s" % OS.get_environment("DEEPSEEK_API_KEY"),
+	]
+	var err := _http.request(API_URL, headers, HTTPClient.METHOD_POST, body)
+	if err != OK:
+		_finish(fallback, "scripted_fallback", _started_ms, "request_error_%d" % err, messages, "")
+		return
+	# Manual timeout: HTTPRequest has none built in. On expiry, cancel and fall back.
+	get_tree().create_timer(TIMEOUT_SECONDS).timeout.connect(_on_timeout, CONNECT_ONE_SHOT)
+
+
+## Pseudonymous payload: bracket, era, numbers, asset types/levels, options.
+## NO street name, NO asset names, NO housing detail — zero names/PII.
+static func build_messages(state: Dictionary) -> Array:
+	var bracket := FinLitTutor.normalize_bracket(state.get("age_bracket", "8-10"))
+	var depth: String = {
+		"8-10": "The child is 8–10: concrete story-words, zero jargon, very short sentences.",
+		"11-12": "The child is 11–12: you may use simple terms (asset, income, debt) with a one-line meaning each.",
+		"13-15": "The child is 13–15: real terms are fine (interest, capital, cash flow, risk) with clear context.",
+	}[bracket]
+	var system: String = (
+		"You are Mrs. K, a warm neighbor in the kids' money game FinLit Street. "
+		+ "You explain the child's own game situation and money ideas in plain, kind words.\n"
+		+ "HARD RULES:\n"
+		+ "- Only talk about the game and the money ideas in it (earning, saving, owning, debt, interest, assets). "
+		+ "If the input is about anything else, gently say that's not your thing and point back to the game.\n"
+		+ "- Never ask for or use real names, places, or personal details. The game data below is all you may reference.\n"
+		+ "- 80 words maximum. Warm, encouraging, never scary, never shaming.\n"
+		+ "- One explanation. No questions back. No chat.\n"
+		+ depth
+	)
+	var assets_summary: Array = []
+	for asset in state.get("assets", []):
+		assets_summary.append({
+			"type": FinLitEconomy.ASSET_TYPES[asset["type"]]["title"],
+			"level": asset["level"],
+			"damaged": asset["damaged"],
+		})
+	var payload := {
+		"game_state": {
+			"age_bracket": bracket,
+			"era": FinLitEconomy.current_era(state),
+			"cash": state.get("balance", 0),
+			"net_worth": FinLitEconomy.net_worth(state),
+			"job": state.get("job", ""),
+			"assets": assets_summary,
+			"in_debt": state.get("balance", 0) < 0,
+		},
+		"childs_options_right_now": FinLitTutor.available_options(state, false),
+		"request": "The child tapped the '?' help button. Explain where they stand and what each option would mean for them.",
+	}
+	return [
+		{"role": "system", "content": system},
+		{"role": "user", "content": JSON.stringify(payload)},
+	]
+
+
+## Hard output cap: the system prompt asks for <=WORD_CAP words; this enforces it.
+static func trim_to_word_cap(text: String) -> String:
+	var words := text.strip_edges().split(" ", false)
+	if words.size() <= WORD_CAP:
+		return text.strip_edges()
+	return " ".join(words.slice(0, WORD_CAP)) + "…"
+
+
+## Parent-reviewable log: one JSON line per call — prompt, response, outcome.
+## The API key is NEVER written here.
+static func append_log(entry: Dictionary) -> void:
+	var file := FileAccess.open(LOG_PATH, FileAccess.READ_WRITE)
+	if file == null:
+		file = FileAccess.open(LOG_PATH, FileAccess.WRITE)
+		if file == null:
+			push_error("FinLitLlmTutor: cannot open log %s" % LOG_PATH)
+			return
+	else:
+		file.seek_end()
+	file.store_line(JSON.stringify(entry))
+	file.close()
+
+
+func _on_timeout() -> void:
+	if not _busy:
+		return # Response already arrived.
+	_http.cancel_request()
+	_finish(FinLitTutor.explain_options(_state_snapshot), "scripted_fallback", _started_ms, "timeout", _last_messages, "")
+
+
+func _on_request_completed(result: int, response_code: int, _headers: PackedStringArray, body: PackedByteArray) -> void:
+	# Guard: a stale completion after a timeout cancel.
+	if not _busy:
+		return
+	var started_ms: int = _started_ms
+	var messages: Array = _last_messages
+	last_response_json = body.get_string_from_utf8()
+	if result != HTTPRequest.RESULT_SUCCESS:
+		_finish(FinLitTutor.explain_options(_state_snapshot), "scripted_fallback", started_ms, "http_result_%d" % result, messages, last_response_json)
+		return
+	if response_code != 200:
+		_finish(FinLitTutor.explain_options(_state_snapshot), "scripted_fallback", started_ms, "http_%d" % response_code, messages, last_response_json)
+		return
+	var parsed: Variant = JSON.parse_string(last_response_json)
+	var text := _extract_text(parsed)
+	if text.is_empty():
+		_finish(FinLitTutor.explain_options(_state_snapshot), "scripted_fallback", started_ms, "bad_payload", messages, last_response_json)
+		return
+	_finish(trim_to_word_cap(text), "llm", started_ms, "", messages, last_response_json)
+
+
+static func _extract_text(parsed: Variant) -> String:
+	if typeof(parsed) != TYPE_DICTIONARY:
+		return ""
+	var choices: Variant = parsed.get("choices", [])
+	if typeof(choices) != TYPE_ARRAY or choices.is_empty():
+		return ""
+	var message: Variant = choices[0].get("message", {})
+	if typeof(message) != TYPE_DICTIONARY:
+		return ""
+	return str(message.get("content", "")).strip_edges()
+
+
+# --- Call-scoped bookkeeping (single in-flight call, guarded by _busy) ---
+
+var _started_ms := 0
+var _last_messages: Array = []
+var _state_snapshot: Dictionary = {}
+
+
+func _finish(text: String, source: String, started_ms: int, fallback_reason: String, messages: Array, raw_response: String) -> void:
+	_busy = false
+	append_log({
+		"ts": Time.get_datetime_string_from_system(),
+		"model": MODEL,
+		"source": source,
+		"fallback_reason": fallback_reason,
+		"latency_ms": Time.get_ticks_msec() - started_ms,
+		"request_messages": messages,
+		"response_text": text,
+		"raw_response": raw_response.left(4000),
+	})
+	explanation_ready.emit(text, source)
