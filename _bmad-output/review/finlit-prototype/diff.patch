+class_name LocalJsonBackend
+extends ISaveBackend
+## Local JSON autosave (user://). The server implementation swaps in later
+## behind the same ISaveBackend interface — a one-class change at the call site.
+
+const SAVE_PATH := "user://finlit_save.json"
+const STREET_NAME_PATH := "user://finlit_street_name.txt"
+
+
+func save_game(state: Dictionary) -> bool:
+	var file := FileAccess.open(SAVE_PATH, FileAccess.WRITE)
+	if file == null:
+		push_error("LocalJsonBackend: cannot open %s for writing (error %s)" % [SAVE_PATH, FileAccess.get_open_error()])
+		return false
+	file.store_string(JSON.stringify(state, "  "))
+	file.close()
+	return true
+
+
+func load_game() -> Dictionary:
+	if not FileAccess.file_exists(SAVE_PATH):
+		return {"ok": false, "state": {}, "corrupted": false}
+	var raw := FileAccess.get_file_as_string(SAVE_PATH)
+	if raw.is_empty():
+		# File existed but unreadable/empty -> treat as corrupt, never crash.
+		return {"ok": false, "state": {}, "corrupted": true}
+	var json := JSON.new()
+	if json.parse(raw) != OK or typeof(json.data) != TYPE_DICTIONARY or not json.data.has("street_name"):
+		return {"ok": false, "state": {}, "corrupted": true}
+	return {"ok": true, "state": json.data, "corrupted": false}
+
+
+func has_save() -> bool:
+	return FileAccess.file_exists(SAVE_PATH)
+
+
+func clear_save() -> void:
+	if FileAccess.file_exists(SAVE_PATH):
+		DirAccess.remove_absolute(SAVE_PATH)
+
+
+func save_street_name(street_name: String) -> void:
+	var file := FileAccess.open(STREET_NAME_PATH, FileAccess.WRITE)
+	if file == null:
+		push_error("LocalJsonBackend: cannot open %s for writing" % STREET_NAME_PATH)
+		return
+	file.store_string(street_name)
+	file.close()
+
+
+func load_street_name() -> String:
+	if not FileAccess.file_exists(STREET_NAME_PATH):
+		return ""
+	return FileAccess.get_file_as_string(STREET_NAME_PATH).strip_edges()
