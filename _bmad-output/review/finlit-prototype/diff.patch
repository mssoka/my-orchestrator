+class_name FinLitEconomy
+extends RefCounted
+## Pure-logic tick sim for the FinLit Street prototype slice.
+## No Node/scene dependencies: the UI drives it and unit tests run it headless.
+## All state lives in one JSON-friendly Dictionary (see new_state()).
+
+const TICK_SECONDS := 60
+const WAGE_DROP_SECONDS := 5
+const WORK_SHIFT_COOLDOWN := 5.0
+## Chance that a market tick draws an event card.
+const EVENT_CHANCE := 0.35
+## Debt interest charged by a rate-hike card: 10% of the debt, minimum $2.
+const DEBT_INTEREST_RATE := 0.10
+const DEBT_INTEREST_MIN := 2
+## Burst-pipe repair cost per building level.
+const REPAIR_COST_PER_LEVEL := 8
+
+## --- Static catalog data -------------------------------------------------
+
+## Starter jobs: wages pay per WAGE DROP (every WAGE_DROP_SECONDS).
+const JOBS := {
+	"paper_round": {
+		"title": "Paper Round", "icon": "📰", "wage": 1,
+		"blurb": "Pedal. Toss. Paid.",
+	},
+	"dog_walker": {
+		"title": "Dog Walker", "icon": "🐕", "wage": 2,
+		"blurb": "Dogs pay in cash AND licks.",
+	},
+	"lemonade_helper": {
+		"title": "Lemonade Helper", "icon": "🍋", "wage": 3,
+		"blurb": "Sales pay best.",
+	},
+}
+
+## Four asset classes = four income lessons (canon):
+## rental = steady · business = medium · farm = lumpy (pays every 3rd tick)
+## · stocks = hands-off + volatile (rng 0..2x average).
+## Each has 3 levels; levels[i].price is the cost to REACH level i+1
+## (level 1 = buy price). levels[i].income is that level's payout per tick.
+const ASSET_TYPES := {
+	"rental": {
+		"title": "Duplex", "icon": "🏠",
+		"levels": [
+			{"price": 60, "income": 4},
+			{"price": 120, "income": 9},
+			{"price": 240, "income": 18},
+		],
+		"lesson": "Rent is steady money that lands every market tick.",
+	},
+	"business": {
+		"title": "Snack Cart", "icon": "🌭",
+		"levels": [
+			{"price": 45, "income": 3},
+			{"price": 90, "income": 7},
+			{"price": 180, "income": 14},
+		],
+		"lesson": "A business earns well — and needs fixing when things break.",
+	},
+	"farm": {
+		"title": "Veggie Patch", "icon": "🌾",
+		"levels": [
+			{"price": 50, "income": 12},
+			{"price": 100, "income": 26},
+			{"price": 200, "income": 48},
+		],
+		"pays_every": 3,
+		"lesson": "Harvests are lumpy: big paydays, with gaps between.",
+	},
+	"stocks": {
+		"title": "Stock Tower", "icon": "📈",
+		"levels": [
+			{"price": 40, "income": 3},
+			{"price": 80, "income": 6},
+			{"price": 160, "income": 12},
+		],
+		"volatile": true,
+		"lesson": "Stocks jump around: some ticks big, some ticks zero.",
+	},
+}
+
+const ASSET_ORDER := ["rental", "business", "farm", "stocks"]
+
+## Money-history eras v1 (lightweight): the kid re-enacts labor -> owning -> growing.
+const ERAS := ["EARNING", "OWNING", "GROWING"]
+
+
+## --- State -----------------------------------------------------------------
+
+## JSON round-trips turn ints into floats; cast the known int fields back in
+## place after a load so indices (asset level) and math stay exact.
+static func sanitize_state(state: Dictionary) -> void:
+	for key in ["balance", "total_earned", "total_spent", "next_asset_id", "tick_count"]:
+		state[key] = int(state.get(key, 0))
+	for asset in state.get("assets", []):
+		asset["id"] = int(asset["id"])
+		asset["level"] = int(asset["level"])
+		asset["ticks_since_payout"] = int(asset.get("ticks_since_payout", 0))
+		asset["damaged"] = bool(asset.get("damaged", false))
+
+
+static func new_state(street_name: String, age_bracket: String, lottery: Dictionary) -> Dictionary:
+	return {
+		"version": 1,
+		"street_name": street_name,
+		"age_bracket": age_bracket,
+		"lottery": lottery,
+		"job": "",
+		"balance": 0,
+		"total_earned": 0,
+		"total_spent": 0,
+		"assets": [],
+		"next_asset_id": 1,
+		"tick_count": 0,
+		"events_seen": [],
+	}
+
+
+static func job_wage(state: Dictionary) -> int:
+	if state["job"] == "":
+		return 0
+	var wage: int = JOBS[state["job"]]["wage"]
+	if state["lottery"].get("traits", []).has("charming"):
+		wage += 1
+	return wage
+
+
+static func take_job(state: Dictionary, job_key: String) -> bool:
+	if not JOBS.has(job_key):
+		return false
+	state["job"] = job_key
+	return true
+
+
+## One wage drop lands (every WAGE_DROP_SECONDS while employed). Returns amount.
+static func wage_drop(state: Dictionary) -> int:
+	var amount := job_wage(state)
+	state["balance"] += amount
+	state["total_earned"] += amount
+	# Living with parents: small allowance rides along with each wage drop.
+	if amount > 0 and state["lottery"].get("housing", "") == "parents":
+		state["balance"] += 1
+		state["total_earned"] += 1
+	return amount
+
+
+## --- Assets ------------------------------------------------------------------
+
+static func cheapest_asset_price() -> int:
+	var cheapest := -1
+	for key in ASSET_TYPES:
+		var price: int = ASSET_TYPES[key]["levels"][0]["price"]
+		if cheapest == -1 or price < cheapest:
+			cheapest = price
+	return cheapest
+
+
+static func buy_asset(state: Dictionary, type_key: String, name: String) -> Dictionary:
+	if not ASSET_TYPES.has(type_key):
+		return {"ok": false, "reason": "unknown_type"}
+	var price: int = ASSET_TYPES[type_key]["levels"][0]["price"]
+	if state["balance"] < price:
+		return {"ok": false, "reason": "too_expensive", "price": price}
+	state["balance"] -= price
+	state["total_spent"] += price
+	var asset := {
+		"id": state["next_asset_id"],
+		"type": type_key,
+		"name": name,
+		"level": 1,
+		"damaged": false,
+		"ticks_since_payout": 0,
+	}
+	state["next_asset_id"] += 1
+	state["assets"].append(asset)
+	return {"ok": true, "asset": asset}
+
+
+static func find_asset(state: Dictionary, asset_id: int) -> Dictionary:
+	for asset in state["assets"]:
+		if asset["id"] == asset_id:
+			return asset
+	return {}
+
+
+static func upgrade_cost(asset: Dictionary) -> int:
+	if asset["level"] >= 3:
+		return -1
+	return ASSET_TYPES[asset["type"]]["levels"][asset["level"]]["price"]
+
+
+static func upgrade_asset(state: Dictionary, asset_id: int) -> Dictionary:
+	var asset := find_asset(state, asset_id)
+	if asset.is_empty():
+		return {"ok": false, "reason": "missing"}
+	if asset["damaged"]:
+		return {"ok": false, "reason": "damaged"}
+	var cost := upgrade_cost(asset)
+	if cost < 0:
+		return {"ok": false, "reason": "max_level"}
+	if state["balance"] < cost:
+		return {"ok": false, "reason": "too_expensive", "price": cost}
+	state["balance"] -= cost
+	state["total_spent"] += cost
+	asset["level"] += 1
+	return {"ok": true, "asset": asset}
+
+
+static func repair_cost(asset: Dictionary) -> int:
+	if not asset["damaged"]:
+		return 0
+	var cost: int = REPAIR_COST_PER_LEVEL * asset["level"]
+	if asset.get("tough_owner", false):
+		cost = maxi(1, cost - 3)
+	return cost
+
+
+static func repair_asset(state: Dictionary, asset_id: int) -> Dictionary:
+	var asset := find_asset(state, asset_id)
+	if asset.is_empty():
+		return {"ok": false, "reason": "missing"}
+	if not asset["damaged"]:
+		return {"ok": false, "reason": "not_damaged"}
+	var cost := repair_cost(asset)
+	if state["balance"] < cost:
+		return {"ok": false, "reason": "too_expensive", "price": cost}
+	state["balance"] -= cost
+	state["total_spent"] += cost
+	asset["damaged"] = false
+	return {"ok": true, "asset": asset}
+
+
+## --- Market tick ---------------------------------------------------------------
+
+## Advances the market one tick: asset income, then a chance card.
+## Returns a result the UI narrates; pure logic only.
+static func market_tick(state: Dictionary, rng: RandomNumberGenerator) -> Dictionary:
+	state["tick_count"] += 1
+	var result := {
+		"income": 0,
+		"per_asset": [],
+		"event": {},
+		"era_changed": false,
+		"era": current_era(state),
+	}
+	for asset in state["assets"]:
+		var payout := 0
+		if asset["damaged"]:
+			result["per_asset"].append({"id": asset["id"], "payout": 0, "note": "damaged"})
+			continue
+		var spec: Dictionary = ASSET_TYPES[asset["type"]]
+		var base: int = spec["levels"][asset["level"] - 1]["income"]
+		if spec.get("pays_every", 1) > 1:
+			# Lumpy income: accrues ticks, pays out on the Nth tick.
+			asset["ticks_since_payout"] += 1
+			if asset["ticks_since_payout"] >= spec["pays_every"]:
+				payout = base
+				asset["ticks_since_payout"] = 0
+		elif spec.get("volatile", false):
+			# Volatile income: uniform 0..2x average, integer dollars.
+			payout = rng.randi_range(0, base * 2)
+			if state["lottery"].get("traits", []).has("lucky") and payout > 0:
+				payout += 1
+		else:
+			payout = base
+		state["balance"] += payout
+		state["total_earned"] += payout
+		result["income"] += payout
+		result["per_asset"].append({"id": asset["id"], "payout": payout, "note": ""})
+	result["event"] = _draw_event(state, rng)
+	var new_era := current_era(state)
+	result["era_changed"] = new_era != result["era"]
+	result["era"] = new_era
+	return result
+
+
+static func _draw_event(state: Dictionary, rng: RandomNumberGenerator) -> Dictionary:
+	if rng.randf() >= EVENT_CHANCE:
+		return {}
+	# Two event cards in the slice: rate hike + burst pipe (spec task list).
+	var card := "rate_hike" if rng.randf() < 0.5 else "burst_pipe"
+	if card == "rate_hike":
+		return _event_rate_hike(state)
+	return _event_burst_pipe(state, rng)
+
+
+static func _event_rate_hike(state: Dictionary) -> Dictionary:
+	var event := {"type": "rate_hike", "title": "📈 Rate Hike", "cost": 0, "effect": ""}
+	if state["balance"] >= 0:
+		# No mortgages in the slice; debt only exists if repairs pushed balance negative.
+		event["effect"] = "no_debt"
+		state["events_seen"].append("rate_hike_no_effect")
+		return event
+	var interest: int = maxi(DEBT_INTEREST_MIN, int(ceil(absf(state["balance"]) * DEBT_INTEREST_RATE)))
+	state["balance"] -= interest
+	event["cost"] = interest
+	event["effect"] = "interest_charged"
+	state["events_seen"].append("rate_hike_interest")
+	return event
+
+
+static func _event_burst_pipe(state: Dictionary, rng: RandomNumberGenerator) -> Dictionary:
+	var event := {"type": "burst_pipe", "title": "🔧 Burst Pipe", "cost": 0, "effect": "", "asset_id": -1}
+	var targets: Array = []
+	for asset in state["assets"]:
+		# Stocks can't flood — buildings and businesses can.
+		if asset["type"] != "stocks" and not asset["damaged"]:
+			targets.append(asset)
+	if targets.is_empty():
+		event["effect"] = "no_target"
+		return event
+	var asset: Dictionary = targets[rng.randi_range(0, targets.size() - 1)]
+	var cost: int = REPAIR_COST_PER_LEVEL * asset["level"]
+	if state["lottery"].get("traits", []).has("tough"):
+		cost = maxi(1, cost - 3)
+	state["balance"] -= cost # May go negative -> debt indicator, never game-over.
+	state["total_spent"] += cost
+	asset["damaged"] = true
+	event["cost"] = cost
+	event["asset_id"] = asset["id"]
+	event["asset_name"] = asset["name"]
+	event["effect"] = "damaged"
+	state["events_seen"].append("burst_pipe")
+	return event
+
+
+## --- Derived values ------------------------------------------------------------
+
+static func current_era(state: Dictionary) -> String:
+	for asset in state["assets"]:
+		if asset["level"] >= 2:
+			return "GROWING"
+	if not state["assets"].is_empty():
+		return "OWNING"
+	return "EARNING"
+
+
+## Asset book value = everything ever paid into it (buy price + upgrades).
+static func asset_value(asset: Dictionary) -> int:
+	var spec: Dictionary = ASSET_TYPES[asset["type"]]
+	var value := 0
+	for i in range(asset["level"]):
+		value += spec["levels"][i]["price"]
+	return value
+
+
+static func net_worth(state: Dictionary) -> int:
+	var worth: int = state["balance"]
+	for asset in state["assets"]:
+		worth += asset_value(asset)
+	return worth
+
+
+## Leaderboards rank wealth CLIMBED (rags-to-riches), never absolute worth.
+static func wealth_climbed(state: Dictionary) -> int:
+	return net_worth(state) # Everyone starts at $0 — net worth IS the climb.
