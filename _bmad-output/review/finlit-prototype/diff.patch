@@ -0,0 +1,676 @@
+extends Control
+## Street screen controller: renders the diorama from economy state and drives
+## the minute-one loop (lottery -> first job -> first wage -> own -> grow).
+## All game logic lives in the pure scripts; this file is UI + timers only.
+
+const PLOT_COUNT := 4
+const LEADERBOARD_PATH := "res://data/fake_leaderboard.json"
+const ASSET_COLORS := {
+	"rental": Color("#e8734a"),
+	"business": Color("#e8b64a"),
+	"farm": Color("#7bc043"),
+	"stocks": Color("#4a90d9"),
+}
+
+var _state: Dictionary = {}
+var _rng := RandomNumberGenerator.new()
+var _backend: LocalJsonBackend
+var _llm_tutor: FinLitLlmTutor
+var _sfx: FinLitSfx
+var _debug_compare := false
+
+var _tick_remaining := FinLitEconomy.TICK_SECONDS
+var _wage_timer := 0.0
+var _last_shift_ms := -100000
+var _seen_first_wage := false
+var _savings_nudged := false
+var _was_in_debt := false
+
+@onready var _balance_label: Label = %BalanceLabel
+@onready var _job_chip: Label = %JobChip
+@onready var _tick_chip: Label = %TickChip
+@onready var _era_banner: Label = %EraBanner
+@onready var _plots: VBoxContainer = %Plots
+@onready var _tutor_label: Label = %TutorLabel
+@onready var _dominant: Button = %DominantButton
+@onready var _save_chip: Label = %SaveChip
+@onready var _dim: ColorRect = $PopupLayer/Dim
+@onready var _popup_root: CenterContainer = $PopupLayer/PopupRoot
+
+
+func _ready() -> void:
+	_rng.randomize()
+	_backend = LocalJsonBackend.new()
+	_llm_tutor = FinLitLlmTutor.new()
+	add_child(_llm_tutor)
+	_sfx = FinLitSfx.new()
+	add_child(_sfx)
+	_dominant.pressed.connect(_on_dominant_pressed)
+	_dominant.disabled = true
+	%RankButton.pressed.connect(_show_leaderboard)
+	%HelpButton.pressed.connect(_show_tutor_panel)
+	%DebugButton.pressed.connect(_toggle_debug)
+	_load_or_new_game()
+	_refresh_ui()
+
+
+## --- Boot: load or new game ---------------------------------------------------
+
+func _load_or_new_game() -> void:
+	var loaded := _backend.load_game()
+	if loaded["ok"]:
+		_state = loaded["state"]
+		FinLitEconomy.sanitize_state(_state)
+		_tick_remaining = FinLitEconomy.TICK_SECONDS
+		_show_tutor_beat("Welcome back to %s! Your stuff was right here waiting." % _state["street_name"])
+		return
+	if loaded["corrupted"]:
+		# Corrupt save: fresh street, KEEP the chosen street name, apology toast.
+		var kept_name := _backend.load_street_name()
+		if kept_name.is_empty():
+			kept_name = FinLitNameGenerator.roll_street_name(_rng)
+		_start_new_game(kept_name)
+		_show_tutor_beat("Oops — your save got scrambled, so we're starting fresh. Your street kept its name: %s. Sorry!" % kept_name)
+		return
+	_run_first_launch_flow()
+
+
+func _run_first_launch_flow() -> void:
+	var bracket := await _ask_age_bracket()
+	var street_name := await _ask_street_name()
+	var lottery := await _show_lottery_card()
+	_start_new_game(street_name, bracket, lottery)
+	_save_game()
+
+
+func _start_new_game(street_name: String, bracket := "8-10", lottery := {}) -> void:
+	if lottery.is_empty():
+		lottery = FinLitLifeLottery.roll(_rng)
+	_state = FinLitEconomy.new_state(street_name, bracket, lottery)
+	_backend.save_street_name(street_name)
+	_seen_first_wage = false
+	_savings_nudged = false
+	_was_in_debt = false
+
+
+## --- Timers --------------------------------------------------------------------
+
+func _process(delta: float) -> void:
+	if _state.is_empty():
+		return
+	if _state["job"] != "":
+		_wage_timer += delta
+		if _wage_timer >= FinLitEconomy.WAGE_DROP_SECONDS:
+			_wage_timer = 0.0
+			_pay_wage()
+	_tick_remaining -= delta
+	if _tick_remaining <= 0.0:
+		_tick_remaining += FinLitEconomy.TICK_SECONDS
+		_run_market_tick()
+	_tick_chip.text = "⏱ %d" % int(ceil(_tick_remaining))
+	# Work-shift cooldown expiry must re-enable the dominant button.
+	_refresh_dominant_button()
+
+
+func _pay_wage() -> void:
+	var amount := FinLitEconomy.wage_drop(_state)
+	if amount <= 0:
+		return
+	_sfx.coin()
+	if not _seen_first_wage:
+		_seen_first_wage = true
+		_show_tutor_beat(FinLitTutor.teach("first_wage", _state))
+	_save_game()
+	_refresh_ui()
+
+
+func _run_market_tick() -> void:
+	var result := FinLitEconomy.market_tick(_state, _rng)
+	var event: Dictionary = result["event"]
+	if not event.is_empty():
+		_sfx.thud()
+		match event.get("effect", ""):
+			"no_debt":
+				_show_tutor_beat("%s\n%s" % [event["title"], FinLitTutor.teach("rate_hike_no_effect", _state)])
+			"interest_charged":
+				_show_tutor_beat("%s — the bank took $%d interest.\n%s" % [event["title"], event["cost"], FinLitTutor.teach("rate_hike_interest", _state)])
+			"damaged":
+				_show_tutor_beat("%s at %s! Repairs cost $%d.\n%s" % [event["title"], event.get("asset_name", "your building"), event["cost"], FinLitTutor.teach("burst_pipe", _state)])
+	elif result["income"] > 0:
+		_sfx.coin()
+	if result["era_changed"]:
+		var era_line := FinLitTutor.teach("era_owning" if result["era"] == "OWNING" else "era_growing", _state)
+		if not era_line.is_empty():
+			_show_tutor_beat(era_line)
+	_check_debt_beat()
+	_save_game()
+	_refresh_ui()
+
+
+func _check_debt_beat() -> void:
+	var in_debt: bool = _state["balance"] < 0
+	if in_debt and not _was_in_debt:
+		_show_tutor_beat(FinLitTutor.teach("debt", _state))
+	_was_in_debt = in_debt
+
+
+## --- Rendering -------------------------------------------------------------------
+
+func _refresh_ui() -> void:
+	if _state.is_empty():
+		return
+	_balance_label.text = "💰 $%d" % _state["balance"]
+	if _state["balance"] < 0:
+		_balance_label.add_theme_color_override("font_color", Color("#c0392b"))
+	else:
+		_balance_label.remove_theme_color_override("font_color")
+	if _state["job"] == "":
+		_job_chip.text = "💼 —"
+	else:
+		var job: Dictionary = FinLitEconomy.JOBS[_state["job"]]
+		_job_chip.text = "%s +$%d" % [job["icon"], FinLitEconomy.job_wage(_state)]
+	_era_banner.text = "ERA: %s · %s" % [FinLitEconomy.current_era(_state), _state["street_name"]]
+	_render_plots()
+	_refresh_dominant_button()
+	if not _savings_nudged and _state["job"] != "" and _state["assets"].is_empty() \
+			and _state["balance"] >= FinLitEconomy.cheapest_asset_price():
+		_savings_nudged = true
+		_show_tutor_beat(FinLitTutor.teach("savings_ready", _state))
+
+
+func _render_plots() -> void:
+	for child in _plots.get_children():
+		child.queue_free()
+	for i in range(PLOT_COUNT):
+		if i < _state["assets"].size():
+			_plots.add_child(_make_asset_card(_state["assets"][i]))
+		else:
+			_plots.add_child(_make_empty_plot())
+
+
+func _make_empty_plot() -> Control:
+	var panel := PanelContainer.new()
+	panel.custom_minimum_size = Vector2(0, 170)
+	var box := VBoxContainer.new()
+	box.alignment = BoxContainer.ALIGNMENT_CENTER
+	panel.add_child(box)
+	var ghost := Label.new()
+	ghost.text = "🌱"
+	ghost.add_theme_font_size_override("font_size", 44)
+	ghost.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	ghost.modulate.a = 0.45
+	box.add_child(ghost)
+	var label := Label.new()
+	label.text = "EMPTY PLOT"
+	label.add_theme_font_size_override("font_size", 22)
+	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	label.modulate.a = 0.55
+	box.add_child(label)
+	return panel
+
+
+func _make_asset_card(asset: Dictionary) -> Control:
+	var spec: Dictionary = FinLitEconomy.ASSET_TYPES[asset["type"]]
+	var panel := PanelContainer.new()
+	panel.custom_minimum_size = Vector2(0, 190)
+	var style := StyleBoxFlat.new()
+	style.bg_color = ASSET_COLORS[asset["type"]].lerp(Color.WHITE, 0.55)
+	style.set_corner_radius_all(14)
+	style.set_content_margin_all(10)
+	panel.add_theme_stylebox_override("panel", style)
+	var row := HBoxContainer.new()
+	row.add_theme_constant_override("separation", 14)
+	panel.add_child(row)
+	var icon := Label.new()
+	icon.text = spec["icon"]
+	# Buildings visibly grow per level.
+	icon.add_theme_font_size_override("font_size", 40 + 22 * asset["level"])
+	icon.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
+	row.add_child(icon)
+	var info := VBoxContainer.new()
+	info.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	row.add_child(info)
+	var name_label := Label.new()
+	name_label.text = asset["name"]
+	name_label.add_theme_font_size_override("font_size", 30)
+	info.add_child(name_label)
+	var level_label := Label.new()
+	level_label.text = "★".repeat(asset["level"]) + "☆".repeat(3 - asset["level"])
+	level_label.add_theme_font_size_override("font_size", 26)
+	info.add_child(level_label)
+	var income_label := Label.new()
+	income_label.add_theme_font_size_override("font_size", 22)
+	if asset["damaged"]:
+		income_label.text = "🔧 broken — no pay"
+		income_label.add_theme_color_override("font_color", Color("#c0392b"))
+	elif spec.get("pays_every", 1) > 1:
+		income_label.text = "+$%d every %d ticks" % [spec["levels"][asset["level"] - 1]["income"], spec["pays_every"]]
+	elif spec.get("volatile", false):
+		income_label.text = "$0–$%d / tick" % (spec["levels"][asset["level"] - 1]["income"] * 2)
+	else:
+		income_label.text = "+$%d / tick" % spec["levels"][asset["level"] - 1]["income"]
+	info.add_child(income_label)
+	var open := Button.new()
+	open.text = "🔧 FIX" if asset["damaged"] else "👀 OPEN"
+	open.custom_minimum_size = Vector2(140, 96)
+	open.add_theme_font_size_override("font_size", 26)
+	open.pressed.connect(_show_asset_popup.bind(asset["id"]))
+	row.add_child(open)
+	return panel
+
+
+func _refresh_dominant_button() -> void:
+	if _state.is_empty():
+		return
+	var text := "💼 WORK SHIFT"
+	var enabled := true
+	if _state["job"] == "":
+		text = "🔍 FIND WORK"
+	elif _first_affordable_repair() >= 0:
+		text = "🔧 FIX $%d" % FinLitEconomy.repair_cost(FinLitEconomy.find_asset(_state, _first_affordable_repair()))
+	elif _state["assets"].size() < PLOT_COUNT and _state["balance"] >= FinLitEconomy.cheapest_asset_price():
+		text = "🛒 BUY"
+	elif _first_affordable_upgrade() >= 0:
+		text = "⬆️ UPGRADE $%d" % FinLitEconomy.upgrade_cost(FinLitEconomy.find_asset(_state, _first_affordable_upgrade()))
+	else:
+		enabled = Time.get_ticks_msec() - _last_shift_ms >= int(FinLitEconomy.WORK_SHIFT_COOLDOWN * 1000.0)
+	_dominant.text = text
+	_dominant.disabled = not enabled
+
+
+func _first_affordable_repair() -> int:
+	for asset in _state["assets"]:
+		if asset["damaged"] and _state["balance"] >= FinLitEconomy.repair_cost(asset):
+			return asset["id"]
+	return -1
+
+
+func _first_affordable_upgrade() -> int:
+	for asset in _state["assets"]:
+		if not asset["damaged"]:
+			var cost := FinLitEconomy.upgrade_cost(asset)
+			if cost >= 0 and _state["balance"] >= cost:
+				return asset["id"]
+	return -1
+
+
+## --- Dominant button (exactly one, bottom-center) --------------------------------
+
+func _on_dominant_pressed() -> void:
+	if _state.is_empty():
+		return
+	if _state["job"] == "":
+		_show_job_picker()
+		return
+	var repair_id := _first_affordable_repair()
+	if repair_id >= 0:
+		_do_repair(repair_id)
+		return
+	if _state["assets"].size() < PLOT_COUNT and _state["balance"] >= FinLitEconomy.cheapest_asset_price():
+		_show_buy_sheet()
+		return
+	var upgrade_id := _first_affordable_upgrade()
+	if upgrade_id >= 0:
+		_do_upgrade(upgrade_id)
+		return
+	# WORK SHIFT: a wage drop right now (same rate as the auto drops).
+	if Time.get_ticks_msec() - _last_shift_ms >= int(FinLitEconomy.WORK_SHIFT_COOLDOWN * 1000.0):
+		_last_shift_ms = Time.get_ticks_msec()
+		_pay_wage()
+
+
+## --- Actions ----------------------------------------------------------------------
+
+func _do_buy(type_key: String) -> void:
+	var asset_name := FinLitNameGenerator.roll_asset_name(_rng, type_key)
+	var had_assets: bool = not _state["assets"].is_empty()
+	var result := FinLitEconomy.buy_asset(_state, type_key, asset_name)
+	if not result["ok"]:
+		return
+	_sfx.coin()
+	if not had_assets:
+		_show_tutor_beat("%s joins %s!\n%s" % [asset_name, _state["street_name"], FinLitTutor.teach("first_asset", _state)])
+	else:
+		_show_tutor_beat("%s joins %s!" % [asset_name, _state["street_name"]])
+	_save_game()
+	_refresh_ui()
+
+
+func _do_upgrade(asset_id: int) -> void:
+	var result := FinLitEconomy.upgrade_asset(_state, asset_id)
+	if not result["ok"]:
+		return
+	_sfx.coin()
+	var asset: Dictionary = result["asset"]
+	if asset["level"] >= 3:
+		_show_tutor_beat(FinLitTutor.teach("max_level", _state))
+	elif asset["level"] == 2:
+		_show_tutor_beat(FinLitTutor.teach("first_upgrade", _state))
+	_save_game()
+	_refresh_ui()
+
+
+func _do_repair(asset_id: int) -> void:
+	var result := FinLitEconomy.repair_asset(_state, asset_id)
+	if not result["ok"]:
+		return
+	_sfx.coin()
+	_show_tutor_beat(FinLitTutor.teach("repair_done", _state))
+	_save_game()
+	_refresh_ui()
+
+
+func _save_game() -> void:
+	if _backend.save_game(_state):
+		_save_chip.text = "saved ✓"
+		var tween := create_tween()
+		tween.tween_property(_save_chip, "modulate:a", 0.0, 1.6).from(1.0)
+
+
+func _show_tutor_beat(line: String) -> void:
+	if line.is_empty():
+		return
+	_tutor_label.text = line
+
+
+## --- Popups ------------------------------------------------------------------------
+
+func _open_popup(card: Control, dismissible := true) -> void:
+	_close_popup()
+	_dim.visible = true
+	_popup_root.visible = true
+	card.custom_minimum_size = Vector2(640, 0)
+	_popup_root.add_child(card)
+	if dismissible:
+		if not _dim.gui_input.is_connected(_on_dim_input):
+			_dim.gui_input.connect(_on_dim_input, CONNECT_ONE_SHOT)
+
+
+func _on_dim_input(event: InputEvent) -> void:
+	if event is InputEventMouseButton and event.pressed:
+		_close_popup()
+
+
+func _close_popup() -> void:
+	for child in _popup_root.get_children():
+		child.queue_free()
+	_dim.visible = false
+	_popup_root.visible = false
+
+
+func _make_card(title: String) -> Dictionary:
+	var panel := PanelContainer.new()
+	var style := StyleBoxFlat.new()
+	style.bg_color = Color.WHITE
+	style.set_corner_radius_all(18)
+	style.set_content_margin_all(22)
+	panel.add_theme_stylebox_override("panel", style)
+	var box := VBoxContainer.new()
+	box.add_theme_constant_override("separation", 14)
+	panel.add_child(box)
+	var title_label := Label.new()
+	title_label.text = title
+	title_label.add_theme_font_size_override("font_size", 34)
+	title_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	box.add_child(title_label)
+	return {"panel": panel, "box": box}
+
+
+func _make_big_button(text: String) -> Button:
+	var button := Button.new()
+	button.text = text
+	button.custom_minimum_size = Vector2(0, 100)
+	button.add_theme_font_size_override("font_size", 30)
+	return button
+
+
+func _make_body_label(text: String, size := 24) -> Label:
+	var label := Label.new()
+	label.text = text
+	label.add_theme_font_size_override("font_size", size)
+	label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	return label
+
+
+## First-launch flow: neutral age screen -> street name -> life lottery.
+
+func _ask_age_bracket() -> String:
+	var card := _make_card("How old are you?")
+	for bracket in FinLitTutor.BRACKETS:
+		var button := _make_big_button("🎂 %s" % bracket)
+		button.pressed.connect(_on_age_picked.bind(bracket))
+		card["box"].add_child(button)
+	_open_popup(card["panel"], false)
+	var picked: String = await _age_picked
+	return picked
+
+
+signal _age_picked(bracket: String)
+func _on_age_picked(bracket: String) -> void:
+	_close_popup()
+	_age_picked.emit(bracket)
+
+
+func _ask_street_name() -> String:
+	var card := _make_card("Your street is called…")
+	var name_label := _make_body_label("", 40)
+	name_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	card["box"].add_child(name_label)
+	var reroll := _make_big_button("🎲 NEW NAME")
+	var accept := _make_big_button("✅ THAT'S IT")
+	card["box"].add_child(reroll)
+	card["box"].add_child(accept)
+	var current := {"name": FinLitNameGenerator.roll_street_name(_rng)}
+	name_label.text = current["name"]
+	reroll.pressed.connect(func() -> void:
+		current["name"] = FinLitNameGenerator.roll_street_name(_rng)
+		name_label.text = current["name"]
+	)
+	accept.pressed.connect(func() -> void: _street_name_picked.emit(current["name"]))
+	_open_popup(card["panel"], false)
+	var picked: String = await _street_name_picked
+	_close_popup()
+	return picked
+
+
+signal _street_name_picked(street_name: String)
+
+
+func _show_lottery_card() -> Dictionary:
+	var lottery := FinLitLifeLottery.roll(_rng)
+	var card := _make_card("🎰 LIFE LOTTERY")
+	card["box"].add_child(_make_body_label("Life deals your starting hand:", 24))
+	var housing := _make_body_label("%s\n%s" % [lottery["title"], lottery["blurb"]], 26)
+	card["box"].add_child(housing)
+	if lottery["traits"].is_empty():
+		card["box"].add_child(_make_body_label("No special luck this time — and that's okay. Streets are built, not dealt.", 24))
+	else:
+		for trait_key in lottery["traits"]:
+			var trait_info: Dictionary = FinLitLifeLottery.TRAITS[trait_key]
+			card["box"].add_child(_make_body_label("%s %s — %s" % [trait_info["icon"], trait_info["title"], trait_info["blurb"]], 24))
+	card["box"].add_child(_make_body_label("Everyone starts with $0. Your street rises only from your own work.", 24))
+	var reroll := _make_big_button("🎲 REROLL — soon")
+	# REROLL POLICY OPEN (canon question): stub only, disabled until Moses rules.
+	reroll.disabled = not FinLitLifeLottery.is_reroll_allowed()
+	card["box"].add_child(reroll)
+	var accept := _make_big_button("✅ ACCEPT LIFE")
+	accept.pressed.connect(func() -> void: _lottery_accepted.emit(lottery))
+	card["box"].add_child(accept)
+	_open_popup(card["panel"], false)
+	var accepted: Dictionary = await _lottery_accepted
+	_close_popup()
+	return accepted
+
+
+signal _lottery_accepted(lottery: Dictionary)
+
+
+func _show_job_picker() -> void:
+	var card := _make_card("🔍 Pick a job")
+	card["box"].add_child(_make_body_label("Money starts with work. Which one sounds fun?", 24))
+	for job_key in FinLitEconomy.JOBS:
+		var job: Dictionary = FinLitEconomy.JOBS[job_key]
+		var button := _make_big_button("%s %s · +$%d" % [job["icon"], job["title"], job["wage"]])
+		button.pressed.connect(_on_job_picked.bind(job_key))
+		card["box"].add_child(button)
+		var blurb := _make_body_label(job["blurb"], 20)
+		blurb.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+		card["box"].add_child(blurb)
+	_open_popup(card["panel"])
+
+
+func _on_job_picked(job_key: String) -> void:
+	FinLitEconomy.take_job(_state, job_key)
+	_close_popup()
+	_wage_timer = FinLitEconomy.WAGE_DROP_SECONDS # First wage lands immediately.
+	_show_tutor_beat("You're a %s now! Wages land every few seconds — watch your jar." % FinLitEconomy.JOBS[job_key]["title"])
+	_save_game()
+	_refresh_ui()
+
+
+func _show_buy_sheet() -> void:
+	var card := _make_card("🛒 Buy for your street")
+	for type_key in FinLitEconomy.ASSET_ORDER:
+		var spec: Dictionary = FinLitEconomy.ASSET_TYPES[type_key]
+		var price: int = spec["levels"][0]["price"]
+		var income: int = spec["levels"][0]["income"]
+		var row_text := "%s %s · $%d" % [spec["icon"], spec["title"], price]
+		var button := _make_big_button(row_text)
+		button.disabled = _state["balance"] < price
+		button.pressed.connect(func() -> void:
+			_close_popup()
+			_do_buy(type_key)
+		)
+		card["box"].add_child(button)
+		var income_text := "pays +$%d every market tick" % income
+		if spec.get("pays_every", 1) > 1:
+			income_text = "pays +$%d every %d ticks (lumpy!)" % [income, spec["pays_every"]]
+		elif spec.get("volatile", false):
+			income_text = "pays $0–$%d a tick (jumpy!)" % (income * 2)
+		card["box"].add_child(_make_body_label("%s · %s" % [income_text, spec["lesson"]], 20))
+	_open_popup(card["panel"])
+
+
+func _show_asset_popup(asset_id: int) -> void:
+	var asset := FinLitEconomy.find_asset(_state, asset_id)
+	if asset.is_empty():
+		return
+	var spec: Dictionary = FinLitEconomy.ASSET_TYPES[asset["type"]]
+	var card := _make_card("%s %s" % [spec["icon"], asset["name"]])
+	card["box"].add_child(_make_body_label("Level %d of 3 · %s" % [asset["level"], spec["lesson"]], 24))
+	if asset["damaged"]:
+		var fix := _make_big_button("🔧 FIX $%d" % FinLitEconomy.repair_cost(asset))
+		fix.disabled = _state["balance"] < FinLitEconomy.repair_cost(asset)
+		fix.pressed.connect(func() -> void:
+			_close_popup()
+			_do_repair(asset_id)
+		)
+		card["box"].add_child(fix)
+	else:
+		var cost := FinLitEconomy.upgrade_cost(asset)
+		if cost >= 0:
+			var up := _make_big_button("⬆️ UPGRADE $%d" % cost)
+			up.disabled = _state["balance"] < cost
+			up.pressed.connect(func() -> void:
+				_close_popup()
+				_do_upgrade(asset_id)
+			)
+			card["box"].add_child(up)
+		else:
+			card["box"].add_child(_make_body_label("MAX LEVEL — it can't grow further.", 24))
+	var close := _make_big_button("✖️ CLOSE")
+	close.pressed.connect(_close_popup)
+	card["box"].add_child(close)
+	_open_popup(card["panel"])
+
+
+func _show_leaderboard() -> void:
+	var data: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(LEADERBOARD_PATH))
+	var bracket: String = FinLitTutor.normalize_bracket(_state.get("age_bracket", "8-10"))
+	var league: String = data.get("brackets", {}).get(bracket, "League")
+	var card := _make_card("🏆 %s" % league)
+	card["box"].add_child(_make_body_label("Ranked by wealth CLIMBED — everyone starts at $0.", 20))
+	var rows: Array = data.get("rows", []).duplicate()
+	rows.append({"name": "YOU", "climbed": FinLitEconomy.wealth_climbed(_state)})
+	rows.sort_custom(func(a: Dictionary, b: Dictionary) -> bool: return a["climbed"] > b["climbed"])
+	for i in range(rows.size()):
+		var row: Dictionary = rows[i]
+		var label := _make_body_label("%d. %s — $%d climbed" % [i + 1, row["name"], row["climbed"]], 26)
+		if row["name"] == "YOU":
+			label.add_theme_color_override("font_color", Color("#b3541e"))
+		card["box"].add_child(label)
+	var close := _make_big_button("✖️ CLOSE")
+	close.pressed.connect(_close_popup)
+	card["box"].add_child(close)
+	# Prototype convenience (playtest resets): full local reset, no server involved.
+	var reset := _make_big_button("🔄 NEW GAME")
+	reset.add_theme_font_size_override("font_size", 22)
+	reset.custom_minimum_size = Vector2(0, 64)
+	reset.pressed.connect(func() -> void:
+		_backend.clear_save()
+		_close_popup()
+		_state = {} # Freeze timers/saves until the new-game flow lands.
+		_wage_timer = 0.0
+		_run_first_launch_flow()
+	)
+	card["box"].add_child(reset)
+	_open_popup(card["panel"])
+
+
+## "?" — child-initiated tutor (ruled OQ3). Scripted by default; the real LLM
+## answers when DEEPSEEK_API_KEY is present. Debug toggle compares both.
+func _show_tutor_panel() -> void:
+	var card := _make_card("❓ Mrs. K explains")
+	var scroll := ScrollContainer.new()
+	scroll.custom_minimum_size = Vector2(600, 560)
+	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
+	var box := VBoxContainer.new()
+	box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	box.add_theme_constant_override("separation", 12)
+	scroll.add_child(box)
+	card["box"].add_child(scroll)
+	var close := _make_big_button("✖️ CLOSE")
+	close.pressed.connect(_close_popup)
+	card["box"].add_child(close)
+	var scripted := FinLitTutor.explain_options(_state)
+	if _debug_compare:
+		box.add_child(_make_body_label("— SCRIPTED (offline path) —", 20))
+		box.add_child(_make_body_label(scripted, 24))
+		if FinLitLlmTutor.is_available():
+			box.add_child(_make_body_label("— MRS. K (LLM: %s) —" % FinLitLlmTutor.MODEL, 20))
+			var llm_label := _make_body_label("Mrs. K is thinking…", 24)
+			box.add_child(llm_label)
+			box.add_child(_make_body_label("— PAYLOAD SENT —", 20))
+			var payload_label := _make_body_label("", 16)
+			box.add_child(payload_label)
+			box.add_child(_make_body_label("Parent log: %s" % FinLitLlmTutor.LOG_PATH, 16))
+			_llm_tutor.explain(_state)
+			var result: Array = await _llm_tutor.explanation_ready
+			if is_instance_valid(llm_label):
+				llm_label.text = "%s\n(source: %s)" % [result[0], result[1]]
+			if is_instance_valid(payload_label):
+				payload_label.text = _pretty_json(_llm_tutor.last_request_json)
+		else:
+			box.add_child(_make_body_label("— LLM off: DEEPSEEK_API_KEY not set, scripted path is live —", 20))
+	elif FinLitLlmTutor.is_available():
+		var llm_label := _make_body_label("Mrs. K is thinking…", 24)
+		box.add_child(llm_label)
+		_llm_tutor.explain(_state)
+		var result: Array = await _llm_tutor.explanation_ready
+		if is_instance_valid(llm_label):
+			llm_label.text = result[0]
+	else:
+		box.add_child(_make_body_label(scripted, 24))
+	_open_popup(card["panel"])
+
+
+func _pretty_json(raw: String) -> String:
+	var parsed: Variant = JSON.parse_string(raw)
+	if typeof(parsed) != TYPE_DICTIONARY:
+		return raw
+	return JSON.stringify(parsed, "  ")
+
+
+func _toggle_debug() -> void:
+	_debug_compare = not _debug_compare
+	%DebugButton.text = "🐞✓" if _debug_compare else "🐞"
