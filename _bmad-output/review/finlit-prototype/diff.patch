+class_name FinLitNameGenerator
+extends RefCounted
+## Generator-first fantasy naming (COPPA-safe: pre-approved lists, zero free text).
+## Streets and businesses get NAMED — the first ingredient of the ownership formula.
+
+const STREET_NAMES := [
+	"Pancake Lane", "Rocket Road", "Mango Mews", "Pickle Parade",
+	"Wombat Way", "Zigzag Close", "Bumblebee Bend", "Acorn Avenue",
+	"Marshmallow Row", "Comet Crescent", "Doodle Drive", "Puddle Place",
+]
+
+const ASSET_NAME_PARTS := {
+	"rental": {
+		"first": ["Sunny", "Cozy", "Ivy", "Robin", "Bramble", "Tulip"],
+		"second": ["Duplex", "House", "Cottage"],
+	},
+	"business": {
+		"first": ["Zippy", "Golden", "Giggly", "Rocket", "Cherry", "Magic"],
+		"second": ["Snack Cart", "Treat Stand", "Noodle Cart"],
+	},
+	"farm": {
+		"first": ["Muddy", "Lucky", "Sunny", "Clover", "Pumpkin", "Daisy"],
+		"second": ["Patch", "Plot", "Garden"],
+	},
+	"stocks": {
+		"first": ["Bold", "Swift", "Bright", "Steady", "Spark", "Summit"],
+		"second": ["Tower", "Fund", "Shares"],
+	},
+}
+
+
+static func roll_street_name(rng: RandomNumberGenerator) -> String:
+	return STREET_NAMES[rng.randi_range(0, STREET_NAMES.size() - 1)]
+
+
+static func roll_asset_name(rng: RandomNumberGenerator, type_key: String) -> String:
+	var parts: Dictionary = ASSET_NAME_PARTS.get(type_key, ASSET_NAME_PARTS["rental"])
+	var first: String = parts["first"][rng.randi_range(0, parts["first"].size() - 1)]
+	var second: String = parts["second"][rng.randi_range(0, parts["second"].size() - 1)]
+	return "%s %s" % [first, second]
